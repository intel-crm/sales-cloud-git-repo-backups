earquarter_value\"]).asObject()}}' in {{coalesce(column(FiscalKPIDate_fiscal_10.selection, [\"quarter\"]),'all').asString()}};\n--q = filter q by 'Core_Status__c' in [\"On Hold\", \"Pending\", \"Win Submitted\", \"Production Cancelled\", \"Production Lost\", \"Production Win\", \"Win Approved\",\"Production Win Approved\", \"Production Win Submitted\"];\n--q = filter q by '{{column(static_28.selection,[\"manager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(lens_32.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \nq = filter q by '{{column(static_28.selection,[\"manager_hierarchy\"]).asObject()}}' in {{coalesce(column(lens_32.selection, [\"WWID\"]),'all').asString()}};  \nq = filter q by  '{{column(static_28.selection,[\"rep_hierarchy\"]).asObject()}}'  in {{coalesce(column(lens_31.selection, [\"Name\"]),'all').asString()}};\nq = filter q by 'Opportunity.StageName' in {{coalesce(flatten(column(FiscalKPIDate_fiscal_15.selection, [\"status_values\"])),'all').asString())}};\nq = filter q by 'Opportunity.Core_Opportunity_Type__c' in {{coalesce(flatten(column(FiscalKPIDate_fiscal_20.selection, [\"type_values\"])),'all').asString())}};\nq = filter q by 'Core_At_Risk_Status__c' in {{coalesce(flatten(column(At_Risk_4.selection, [\"display\"])),'all').asString()}};\n--q = filter q by '{{column(static_28.selection,[\"manager_hierarchy\"]).asObject()}}' in {{coalesce(column(lens_32.selection, [\"Name\"]), 'all').asString()}};\n\nq = foreach q generate q.'Opportunity.Account.Name', \ncase when 'Core_Status__c' in [\"On Hold\", \"Pending\", \"Win Submitted\"] then 'Core_KPI_Total_Price__c' else 0 end as 'Open_Opp', \ncase when 'Core_Status__c' in [\"On Hold\", \"Pending\", \"Win Submitted\"] then 'OpportunityId' end as 'Open_Opp_Count',\ncase when 'Opportunity.Core_Opp_Strategic_Opportunity__c' is not null then 'OpportunityId' end as 'Str_opp',\ncase when q.'Core_At_Risk_Status__c' in [\"In-Progress\",\"New\"] then 'OpportunityId' end as 'Risk_opp',\ncase when 'Core_Status__c' in [\"Production Cancelled\",\"Production Lost\",\"Production Win\",\"Win Approved\",\"Production Win Approved\", \"Production Win Submitted\"] then 'Core_KPI_Total_Price__c' else 0 end as 'Won_won', \n'Core_KPI_Total_Price__c' as 'Amount';\n\nq_result = group q by 'Opportunity.Account.Name';\nq_result = foreach q_result generate q.'Opportunity.Account.Name',\nsum('Open_Opp') as 'Open Opp $',\nunique('Open_Opp_Count') as 'Open Opp Count',\nunique('Str_opp') as 'Strategic Opps',\nunique('Risk_opp') as 'At Risk Opps',\nsum('Won_won') as 'Won $',\nsum('Amount') as 'Total $';\n\nq_result = order q_result by 'Total $' desc;\nq_result = limit q_result {{column(staticLimit_1.selection,[\"value_table\"]).asObject()}};","receiveFacetSource":{"mode":"exclude","steps":["lens_3_1","lens_10_1","Chart1_1"]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#E6ECF2","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Opportunity_Core_Opp_2":{"broadcastFacet":true,"datasets":[{"name":"OpportunityProducts"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Opportunity.Core_Opportunity_Coverage_Nm__c\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","start":"[\"Intel-Led Opportunity\"]","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{}},"Pipe_OppProdPartner__2