ue,"groups":[],"label":"lens_10","numbers":[],"query":"q = load \"OpportunityProducts\";\n--q = filter q by '{{column(static_28.selection,[\"manager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(lens_32.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \nq = filter q by '{{column(static_28.selection,[\"manager_hierarchy\"]).asObject()}}' in {{coalesce(column(lens_32.selection, [\"WWID\"]),'all').asString()}};  \nq = filter q by  '{{column(static_28.selection,[\"rep_hierarchy\"]).asObject()}}'  in {{coalesce(column(lens_31.selection, [\"Name\"]),'all').asString()}};\n\nq = filter q by '{{column(FiscalKPIDate_fiscal_9.selection,[\"year_value\"]).asObject()}}' in {{coalesce(column(year_list_2.selection, [\"select_year\"]),'all').asString()}};\nq = filter q by '{{column(FiscalKPIDate_fiscal_9.selection,[\"yearquarter_value\"]).asObject()}}' in {{coalesce(column(FiscalKPIDate_fiscal_10.selection, [\"quarter\"]),'all').asString()}};\n\nq = filter q by 'Opportunity.Core_Opportunity_Type__c' in {{coalesce(flatten(column(FiscalKPIDate_fiscal_20.selection, [\"type_values\"])),'all').asString())}};\nq = filter q by 'Opportunity.StageName' in {{coalesce(flatten(column(FiscalKPIDate_fiscal_15.selection, [\"status_values\"])),'all').asString()}} and 'Core_Status__c' in {{coalesce(flatten(column(FiscalKPIDate_fiscal_15.selection, [\"value_value\"])),'all').asString()}};\n\nq = filter q by 'Core_At_Risk_Status__c' in {{coalesce(flatten(column(At_Risk_4.selection, [\"display\"])),'all').asString()}};\nq = filter q by 'Opportunity.Core_Opportunity_Type__c' in {{coalesce(flatten(column(FiscalKPIDate_fiscal_20.selection, [\"type_values\"])),'all').asString())}};\nq = group q by 'StageSorted';\nq = foreach q generate q.'StageSorted' as 'StageSorted',\ncase when \"{{cell(static_23.selection, 0, \"display\").asString()}}\"== \"Units\" then sum(q.'Quantity') else case when \"{{cell(Opportunity_AccountT_1.selection, 0, \"display\").asString()}}\"== \"Unwtd\" then sum(q.'Core_KPI_Total_Price__c') else sum(q.'WeightedAmount') end end as 'A';\nq = limit q 100;","receiveFacetSource":{"mode":"exclude","steps":["lens_23","lens_22","Chart1_1"]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":false,"tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"origami","title":{"fontSize":14,"subtitleFontSize":11,"label":"Opportunity by Stage","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":false,"valueType":"percent","showTotal":true,"theme":"wave","compactDecimalDigits":-1,"applyConditionalFormatting":true},"type":"chart"}},"lens_31":{"broadcastFacet":false,"groups":[],"label":"lens_31","numbers":[],"query":"\nq = load \"Hierarchy_Dataset\";\n\n-- Filtering by the role selected in the filter\nq = filter q by 'Role_nm' in {{column(static_28.selection, [\"display\"]).asString()}};\n\n-- Filtering by manager selected in the filter\n q = filter q by 'TEAM_MEMBER_MANAGER_ID' like  coalesce(\"%\"+ number_to_string( {{cell(lens_32.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\") ; \n\nq = group q by ('TEAM_MEMBER_NM','TEAM_MEMBER_ID','Role_nm');\nq = foreach q generate 'TEAM_MEMBER_NM' as 'Name', 'TEAM_MEMBER_ID'as 'WWID',Role_nm;\nq = order q by ('Name' asc, 'WWID' asc);\n\n\nq = group q by ('Name','WWID'