 && 'OpportunityProducts.h.HIERARCHY_NM' matches number_to_string({{cell(lens_32.selection, 0,\"WWID\").asString()}},\"########\")) || ('OpportunityProducts.h.TEAM_MEMBER_MANAGER_ID' in {{coalesce(column(lens_32.selection, [\"WWID\"]),'all').asString()}}));\n\n--q = filter q by '{{column(static_28.selection,[\"manager_hierarchy_np\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(lens_32.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \nq = filter q by '{{column(static_28.selection,[\"manager_hierarchy_np\"]).asObject()}}' in {{coalesce(column(lens_32.selection, [\"WWID\"]),'all').asString()}};  \nq = filter q by  '{{column(static_28.selection,[\"rep_hierarchy_np\"]).asObject()}}'  in {{coalesce(column(lens_31.selection, [\"Name\"]),'all').asString()}};\n\n\nq = filter q by 'Core_Opportunity_Type__c' in {{coalesce(flatten(column(FiscalKPIDate_fiscal_20.selection, [\"type_values\"])),'all').asString()}};\nq = filter q by 'op.Core_At_Risk_Status__c' in {{coalesce(flatten(column(At_Risk_4.selection, [\"display\"])),'all').asString()}};\nq = filter q by 'op.Core_Status__c' in {{coalesce(flatten(column(At_Risk_4.selection, [\"status_value\"])),'all').asString()}};\nq = filter q by 'op.Core_Status__c' in [\"Win Approved\", \"Production Win\", \"Production Lost\", \"Production Cancelled\", \"Pending\", \"On Hold\", \"Win Submitted\",\"Production Win Approved\", \"Production Win Submitted\"];\nq = filter q by 'Core_Opp_Strategic_Opportunity__c' in [\"Lighthouse\", \"Regional Strategic\"];\n--q = filter q by ('OpportunityProducts.h.HierachyRole' in {{column(static_28.selection, [\"display\"]).asString()}} && 'OpportunityProducts.h.TEAM_MEMBER_NM' in {{coalesce(column(lens_31.selection, [\"Name\"]),'all').asString()}});\n\nq1 = group q by ('op.CoreKPIDateYearQuarter', '{{column(static_36.selection,[\"op_value\"]).asObject()}}','Id', 'op.Id'); \nq1 = foreach q1 generate '{{column(FiscalKPIDate_fiscal_9.selection,[\"op_yearquarter_value\"]).as