    "FORMULA0_copy0" : {
      "action" : "formula",
      "sources" : [ "JOIN6_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Opportunity_Name",
          "label" : "Opportunity Name",
          "formulaExpression" : "\"Name\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA1_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "StageSorted",
          "label" : "StageSorted",
          "formulaExpression" : "(case when \"Opportunity.StageName\" = 'Qualify' then '1 - Qualify' when \"Opportunity.StageName\" = 'Define' then '2 - Define' when \"Opportunity.StageName\" = 'Develop' then '3 - Develop' when \"Opportunity.StageName\" = 'Design' then '4 - Design' when \"Opportunity.StageName\" = 'Design Win' then '5 - Design Win' when \"Opportunity.StageName\" = 'Production Win' then '6 - Production Win' when \"Opportunity.StageName\" = 'Production Lost' then '7 - Production Lost' when \"Opportunity.StageName\" = 'Production Cancelled' then '8 - Production Cancelled' when \"Opportunity.StageName\" = 'Lost' then '9 - Lost' when \"Opportunity.StageName\" = 'Cancelled' then '91 - Cancelled'  else '99 - No Match' end)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA1_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Status_Name",
          "label" : "Status Name",
          "formulaExpression" : "case \r\n\twhen (Core_Status__c = 'Win Approved') then 'Won'\r\n\twhen (Core_Status__c = 'Production Win') then 'Won' \r\n\twhen (Core_Status__c = 'Production Lost') then 'Won' \r\n\twhen (Core_Status__c = 'Production Cancelled') then 'Won' \r\n\twhen (Core_Status__c = 'Production Win Approved') then 'Won'\r\n\twhen (Core_Status__c = 'Production Win Submitted') then 'Won'\r\n\twhen (Core_Status__c = 'Lost') then 'Lost' \r\n\twhen (Core_Status__c = 'Cancelled') then 'Lost' \r\n\twhen (Core_Status__c = 'Pending') then 'Open' \r\n\twhen (Core_Status__c = 'On Hold') then 'Open' \r\n\twhen (Core_Status__c = 'Win Submitted') then 'Open' \r\n\telse Core_Status__c\r\nend",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA2_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Partner_Name",
          "label" : "Partner Name",
          "formulaExpression" : "\"Parter_Solution_Products.PARTNER_NAME\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA3_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Application_Workload",
          "label" : "Application Workload",
          "formulaExpression" : "\"Solution_OpportunityProducts.CORE_APPLICATION_WORKLOAD_SPLIT_NM\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA4_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Tech_Enable",
          "label" : "Tech Enable",
          "formulaExpression" : "array_join(\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.DIM_SOLUTI.CORE_TECHNOLOGY_ENABLED_C_SPLIT_NM\",',')",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA5_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Industry_Use_Cases",
          "label" : "Industry Use Cases",
          "formulaExpression" : "array_join(\"Solution_OpportunityProducts.Solution_Application_Workload.CORE_INDUSTRY_USE_CASE_C_SPLIT_NM\", ',')",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA7_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA6_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Solution_Name",
          "label" : "Solution Name",
          "formulaExpression" : "array_join(\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.SOLUTION_NM\", ',')",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA7_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "isVBS",
          "label" : "Is VBS",
          "formulaExpression" : "case when \"Opportunity.Core_VBS_Status__c\" in ('Pending', 'SOAR 1 Qualified', 'Approved') then 'VBS' else null end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA9_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA8_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "isAI",
          "label" : "Is AI",
          "formulaExpression" : "case \r\n    when (((\r\n        (contains(\"Product2.Name\", 'Gaudi') or contains(\"Product2.Name\", 'GAUDI') or contains(\"Product2.Name\", 'GPU Flex') or contains(\"Product2.Name\", 'Developer Cloud')) and \"Opp.Core_has_Solution__c\" = 'true'\r\n        )\r\n        \r\n        or ((contains(\"Product2.Name\", 'Xeon') \r\n        or contains(\"Product2.Name\", 'Arc') or contains(\"Product2.Name\", 'Core') \r\n        or contains(\"Product2.Name\", 'OpenVino') \r\n        or contains(\"Product2.Name\", 'oneAPI'))\r\n        and (contains(Application_Workload, 'AI Inference') \r\n        or contains(Application_Workload, 'AI Training') \r\n        or contains(Application_Workload, 'AI on Xeon') \r\n        or contains(\"Tech_Enable\", 'OneAPI') \r\n        or contains(\"Tech_Enable\", 'OpenVino')))\r\n        )\r\n        \r\n        or (contains(\"Product2.Name\", 'Core') and contains(\"Product2.Name\", 'Ultra') and startsWith(Solution_Name, 'AI PC'))\r\n        )\r\n then 'AI' else null end\r\n\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA10_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA9_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "VBS_AI2",
          "label" : "solution VBS/AI",
          "formulaExpression" : "case \r\n    when isAI = 'AI' and isVBS = 'VBS' \r\n    then 'VSB/AI' \r\n    when isAI = 'AI' \r\n    then 'AI' \r\n    when isVBS = 'VBS' \r\n    then 'VBS' \r\nelse '-' end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA12_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA10_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "VBSAIlen",
          "label" : "VBSAI Len",
          "formulaExpression" : "char_length(VBS_AI2)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA13_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA12_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "risk_num",
          "label" : "Risk #",
          "formulaExpression" : "substr(Core_Risk_Priority__c, 1, 1)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "TO_MEASURE0_copy0" : {
      "action" : "typeCast",
      "sources" : [ "FORMULA13_copy0" ],
      "parameters" : {
        "fields" : [ {
          "name" : "risk_num",
          "newProperties" : {
            "label" : "Risk # To Number",
            "name" : "risk_num_to_measure",
            "typeProperties" : {
              "type" : "NUMBER",
              "scale" : 0,
              "precision" : 18
            }
          }
        } ]
      }
    },
    "FORMULA22_copy0" : {
      "action" : "formula",
      "sources" : [ "TO_MEASURE0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "sales_grouping",
          "label" : "Sales Grouping",
          "formulaExpression" : "case \r\n    when contains(\"Opportunity.Core_Sales_Groups__c\", 'Americas')\r\n    then '1-Americas'\r\n    when contains(\"Opportunity.Core_Sales_Groups__c\", 'EMEA')\r\n    then '3-EMEA'\r\n    when contains(\"Opportunity.Core_Sales_Groups__c\", 'APJ')\r\n    then '2-APJ'\r\n    when contains(\"Opportunity.Core_Sales_Groups__c\", 'PRC')\r\n    then '4-PRC'\r\n    when contains(\"Opportunity.Core_Sales_Groups__c\", 'Global')\r\n    then '5-GSS'\r\n    else '6-Other'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FILTER1_copy0" : {
      "action" : "filter",
      "sources" : [ "FORMULA22_copy0" ],
      "parameters" : {
        "filterExpressions" : [ {
          "type" : "TEXT",
          "field" : "VBS_AI2",
          "operator" : "NOT",
          "operands" : [ "-" ]
        } ]
      }
    },
    "FILTER2_copy0" : {
      "action" : "filter",
      "sources" : [ "FORMULA22_copy0" ],
      "parameters" : {
        "filterExpressions" : [ {
          "type" : "TEXT",
