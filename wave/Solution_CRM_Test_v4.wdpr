    },
    "FORMULA14_copy0" : {
      "action" : "formula",
      "sources" : [ "JOIN10_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "VBS_AI",
          "label" : "Opp VBS/AI",
          "formulaExpression" : "case \r\n    when \"Aggregate2.MAX_VBSAIlen\" = 6 then 'VBS/AI'\r\n    when \"Aggregate2.MAX_VBSAIlen\" = 3 then 'VBS'\r\n    when \"Aggregate2.MAX_VBSAIlen\" = 2 then 'AI'\r\n    else 'Other'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA15_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA14_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Status_RYOG",
          "label" : "Status",
          "formulaExpression" : "case \r\n    when \"Opportunity.StageName\" in ('Design Win', 'Production Win', 'Production Lost', 'Production Cancelled')\r\n    then 'Blue'\r\n    when  \"Opportunity.StageName\" in ('Lost','Cancelled')\r\n    then 'Gray'\r\n    when \"Aggregate0.MIN_risk_num_to_measure\" = 1 then 'Red'\r\n    when \"Aggregate0.MIN_risk_num_to_measure\" = 2 \r\n    then 'Orange' \r\n    when \"Aggregate0.MIN_risk_num_to_measure\" = 3 \r\n    then 'Yellow'\r\n    else 'Green' \r\nend ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA16_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA15_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Status_shortened",
          "label" : "Status Shortened",
          "formulaExpression" : "substr(\"Opportunity.Core_Status_Update__c\",1,150)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA17_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA16_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "riskpriority",
          "label" : "Risk Priority",
          "formulaExpression" : "case when Core_Risk_Priority__c is null then '-' else Core_Risk_Priority__c\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA18_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA17_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "RiskReason",
          "label" : "Risk Reason",
          "formulaExpression" : "case when \"product.Core_Risk_Reason1__c\" is null then '-' else \"product.Core_Risk_Reason1__c\" end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA19_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA18_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "riskdetail",
          "label" : "Risk Detail",
          "formulaExpression" : "case when \"product.Core_Risk_Detail__c\" is null then '-' else \"product.Core_Risk_Detail__c\"end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA20_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA19_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "solutiondescription",
          "label" : "Solution Description",
          "formulaExpression" : "case when \"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.CORE_SOLUTION_DESCRIPTION_DSC\" is null then '-' else array_join(\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.CORE_SOLUTION_DESCRIPTION_DSC\", ',') end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA21_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA20_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "StatusSquare",
          "label" : "Status",
          "formulaExpression" : "'■'",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA23" : {
      "action" : "formula",
      "sources" : [ "FORMULA21_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "KPIDateYear",
          "label" : "KPIDateYear",
          "formulaExpression" : "substr(\"Core_KPI_Date__c\", 1,4)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA24" : {
      "action" : "formula",
      "sources" : [ "FORMULA23" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "KPIQuarter",
          "label" : "KPIQuarter",
          "formulaExpression" : "concat(string(year(\"Core_KPI_Date__c\")),string('0'),string(quarter(\"Core_KPI_Date__c\")))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
