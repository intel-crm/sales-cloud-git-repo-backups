{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":true,"groups":[],"label":"HealthyOpportunities","numbers":[],"query":"q = load \"ConfidenceOpportunityProducts\";\nq = filter q by 'Core_Opportunity_Coverage_Nm__c' in [\"Intel-Led Opportunity\"];\nq = filter q by 'Core_Sales_Groups__c' in [\"EMEA Hosted Sales Group\", \"EMEA Partner Holding\", \"EMEA Sales Group\", \"EMEA Sales Territory\"];\nq = filter q by 'oppHierarchy.OWNER_HIERARCHY_TXT' like  coalesce(\"%\"+ number_to_string( null,  \"######\") + \"%\",\"%%\");  \n\nq = filter q by  'OpportunityProducts.Opportunity.Owner.Name'  in all;\nq = filter q by 'op.Core_Status__c' != \"Cancelled\";\n\n--q = filter q by date('op.Core_KPI_Date__c_Year', 'op.Core_KPI_Date__c_Month', 'op.Core_KPI_Date__c_Day') in [\"3 quarters ago\"..\"current quarter\"];\nq = filter q by date('CloseDate_YearNumber', 'CloseDate_MonthNumber', 'CloseDate_DayNumber') in [\"3 quarters ago\"..\"current quarter\"];\nq = filter q by 'OpportunityProducts.Opportunity.Owner.Name'  in all; \n q = filter q by 'strategic_opportunity' in all;\nq = foreach q generate 'OpportunityProducts.Name' as 'OpportunityProducts.Name', \n'Name' as 'Name', \n'Id' as 'Id', 'OpportunityProducts.Product2Id' as 'OpportunityProducts.Product2Id','unhealthy_stage';\n\nq1 = group q by ('Id', 'unhealthy_stage' );\nq1 = foreach q1 generate 'Id'\n, max('unhealthy_stage') as 'unhealthy_stage'\n, count() as 'count';\n\nq2 = group q1 by all;\nq2 = foreach q2 generate sum('unhealthy_stage') as 'unhealthy_stage'\n;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"visualizationType":"comparisontable"}}},"widgets":{"saql_table":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}