{"dataSourceLinksInfo":{"enableAutomaticLinking":false,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"x1 = load \"pipeline_trending\";\nx1 = filter x1 by 'Opportunity.Account.Name' in [\"FEDEX\"];\nx1 = filter x1 by 'ManagerLevels.Opportunity.TeamMembers.User.Manager.Name' in all; x1 = filter x1 by 'ManagerLevels.Opportunity.TeamMembers.User.Name' in [\"Linda Kenworthy\"];  x1 = filter x1 by 'Id' in all; upd_start = filter x1 by date('ValidFromDate_Year', 'ValidFromDate_Month', 'ValidFromDate_Day') in  [..\"6 months ago\"]; upd_start = filter upd_start by date('ValidToDate_Year', 'ValidToDate_Month', 'ValidToDate_Day') in [\"5 months ago\"..\"current day\"]; upd_end = filter x1 by date('ValidFromDate_Year', 'ValidFromDate_Month', 'ValidFromDate_Day') in [\"5 months ago\"..\"current day\"]; upd_end = filter upd_end by date('ValidToDate_Year', 'ValidToDate_Month', 'ValidToDate_Day') in [\"1 day ahead\"..]; upd = group upd_start by OpportunityId right, upd_end by OpportunityId; upd = foreach upd generate upd_end.'OpportunityId' as 'OpportunityId', upd_start.'OpportunityId' is null as 'New', first(upd_start.'Opportunity.Core_Push_Counter__c') as 'Opportunity.Core_Push_Counter__c__cStart',first(upd_start.'Opportunity.WeightedAmount') as 'Opportunity.WeightedAmount_cStart', first(upd_start.'Amount') as 'AmountStart', first(upd_start.'Stage.IsClosed') as 'Stage.IsClosedStart', first(upd_start.'Stage.IsWon') as 'Stage.IsWonStart', first(upd_start.'CloseDate_sec_epoch') as 'CloseDateStart', last(upd_end.'Opportunity.WeightedAmount') as 'Opportunity.WeightedAmount_cEnd',last(upd_end.'Amount') as 'AmountEnd',last(upd_end.'Opportunity.Core_Push_Counter__c') as 'Opportunity.Core_Push_Counter__c__cEnd', last(upd_end.'Stage.IsClosed') as 'Stage.IsClosedEnd', last(upd_end.'Stage.IsWon') as 'Stage.IsWonEnd', last(upd_end.'CloseDate_sec_epoch') as 'CloseDateEnd',last(upd_end.'Opportunity.Account.Name') as 'Opportunity.Account.Name', last(upd_end.'Opportunity.Name') as 'Opportunity.Name', last(upd_end.'Opportunity.Owner.Name') as 'Opportunity.Owner.Name', last(upd_end.'Opportunity.Core_KPI_Date__c') as 'Opportunity.Core_KPI_Date__c',last(upd_end.'Opportunity.CloseDate') as 'Opportunity.CloseDate', last(upd_end.'Opportunity.StageName') as 'Opportunity.StageName'; upd_full_closed = foreach upd generate ( case when ( toDate('CloseDateEnd') in  [\"100 years ago\"..\"100 years ahead\"] and 'Stage.IsClosedEnd' == \"true\" and 'Stage.IsWonEnd' == \"false\" ) then \"8_CLOSED_LOST\" when ( toDate('CloseDateEnd') in [\"100 years ago\"..\"100 years ahead\"] and 'Stage.IsClosedEnd' == \"true\" and 'Stage.IsWonEnd' == \"true\" ) then \"7_CLOSED_WON\" else \"OTHER\" end ) as 'Status', 'OpportunityId',  'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c', 'Opportunity.CloseDate', 'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'AmountStart', 'AmountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_full_closed = filter upd_full_closed by 'Status' != \"OTHER\"; upd_full_closed = foreach upd_full_closed generate 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName',( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'Opportunity.WeightedAmount_cEnd') when \"7_CLOSED_WON\" then (0 - 'Opportunity.WeightedAmount_cEnd') end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'AmountEnd') when \"7_CLOSED_WON\" then (0 - 'AmountEnd') end ) as 'Amount',( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') when \"7_CLOSED_WON\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') end ) as 'Opportunity.Core_Push_Counter__c'; upd_full_notinperiod = foreach upd generate ( case when ( not 'New' and 'Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [\"100 years ago\"..\"100 years ahead\"] and not(toDate('CloseDateEnd') in [\"100 years ago\"..\"100 years ahead\"]) ) then \"5_MOVED_OUT\" when ( 'New' and toDate('CloseDateEnd') in [\"100 years ago\"..\"100 years ahead\"]) then \"1_NEW\" when ( not 'New' and 'Stage.IsClosedStart' == \"true\" and toDate('CloseDateEnd') in [\"100 years ago\"..\"100 years ahead\"] ) then \"2_REOPEN\" when ( not 'New' and toDate('CloseDateEnd') in [\"100 years ago\"..\"100 years ahead\"] and (('Stage.IsClosedStart' == \"false\" and not(toDate('CloseDateStart') in [\"100 years ago\"..\"100 years ahead\"])) or ('Stage.IsClosedStart' == \"true\")) ) then \"4_MOVED_IN\" else \"OTHER\" end ) as 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate', 'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'AmountStart', 'AmountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_full_notinperiod = filter upd_full_notinperiod by 'Status' != \"OTHER\"; upd_full_notinperiod = foreach upd_full_notinperiod generate 'Status',( case 'Status' when \"5_MOVED_OUT\" then (0 - 'Opportunity.WeightedAmount_cEnd') when \"1_NEW\" then 'Opportunity.WeightedAmount_cEnd' when \"2_REOPEN\" then 'Opportunity.WeightedAmount_cEnd' when \"4_MOVED_IN\" then 'Opportunity.WeightedAmount_cEnd' end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"5_MOVED_OUT\" then (0 - 'AmountEnd') when \"1_NEW\" then 'AmountEnd' when \"2_REOPEN\" then 'AmountEnd' when \"4_MOVED_IN\" then 'AmountEnd' end ) as 'Amount',( case 'Status' when \"5_MOVED_OUT\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') when \"1_NEW\" then 'Opportunity.Core_Push_Counter__c__cEnd' when \"2_REOPEN\" then 'Opportunity.Core_Push_Counter__c__cEnd' when \"4_MOVED_IN\" then 'Opportunity.Core_Push_Counter__c__cEnd' end ) as 'Opportunity.Core_Push_Counter__c', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName'; upd_delta = foreach upd generate ( case when ( not 'New' and 'Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [\"100 years ago\"..\"100 years ahead\"] and 'AmountStart' > 'AmountEnd') then \"6_REDUCE\" when ( not 'New' and 'Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [\"100 years ago\"..\"100 years ahead\"] and 'AmountStart' < 'AmountEnd') then \"3_EXPAND\" else \"OTHER\" end ) as 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'AmountStart', 'AmountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_delta = filter upd_delta by 'Status' != \"OTHER\"; upd_delta = foreach upd_delta generate 'Status',( case 'Status' when \"6_REDUCE\" then 'Opportunity.WeightedAmount_cEnd' - 'Opportunity.WeightedAmount_cStart' when \"3_EXPAND\" then 'Opportunity.WeightedAmount_cEnd' - 'Opportunity.WeightedAmount_cStart' end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"6_REDUCE\" then 'AmountEnd' - 'AmountStart' when \"3_EXPAND\" then 'AmountEnd' - 'AmountStart' end ) as 'Amount',( case 'Status' when \"6_REDUCE\" then 'Opportunity.Core_Push_Counter__c__cEnd' - 'Opportunity.Core_Push_Counter__c__cStart' when \"3_EXPAND\" then 'Opportunity.Core_Push_Counter__c__cEnd' - 'Opportunity.Core_Push_Counter__c__cStart' end ) as 'Opportunity.Core_Push_Counter__c', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName'; \nWATERFALL = union upd_full_notinperiod, upd_delta, upd_full_closed;\n--WATERFALL = filter WATERFALL by 'Status' == \"6_REDUCE\"; \nWATERFALL = filter WATERFALL by 'OpportunityId' == \"0061J00000ZeSgDQAV\"; \n--WATERFALL = group WATERFALL by 'OpportunityId'; \n\n--WATERFALL = foreach WATERFALL generate first('OpportunityId') as 'OpportunityId', first('Status') as 'Status';\n\n--WATERFALL = foreach WATERFALL generate last('OpportunityId') as 'OpportunityId', last('Status') as 'Status', last('Opportunity.Account.Name') as 'Opportunity.Account.Name', last('Opportunity.Name') as 'Opportunity.Name', last('Opportunity.Owner.Name') as 'Opportunity Owner', last('Opportunity.Core_KPI_Date__c') as 'KPI Date',last('Opportunity.CloseDate') as 'Opportunity.CloseDate',last('Opportunity.StageName') as 'Opportunity.StageName',last('Opportunity.WeightedAmount') as 'Wtd Amt', last('Amount') as 'Unwtd Amt',abs(last('Amount')) as 'Unwtd Amt_abs',abs(last('Opportunity.Core_Push_Counter__c')) as 'Push Counter';WATERFALL = order WATERFALL by 'Unwtd Amt_abs' desc;WATERFALL = limit WATERFALL 200; ","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"visualizationType":"comparisontable"}}},"widgets":{"saql_table":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"exploreLink":true,"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":0,"numberOfLines":1,"showActionMenu":true,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}