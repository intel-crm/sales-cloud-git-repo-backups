          "name" : "Application_Workload",
          "label" : "Application Workload",
          "formulaExpression" : "\"Solution_OpportunityProducts.CORE_APPLICATION_WORKLOAD_SPLIT_NM\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Tech_Enable",
          "label" : "Tech Enable",
          "formulaExpression" : "\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.CORE_TECHNOLOGY_ENABLED_C_SPLIT_NM\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Industry_Use_Cases",
          "label" : "Industry Use Cases",
          "formulaExpression" : "\"Solution_OpportunityProducts.Solution_Application_Workload.CORE_INDUSTRY_USE_CASE_C_SPLIT_NM\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Solution_Name",
          "label" : "Solution Name",
          "formulaExpression" : "\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.Solution_technology.SOLUTION_NM\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "isVBS",
          "label" : "Is VBS",
          "formulaExpression" : "case when \"Opportunity.Core_VBS_Status__c\" in ('Pending', 'SOAR 1 Qualified', 'Approved') then 'VBS' else null end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA9" : {
      "action" : "formula",
      "sources" : [ "FORMULA8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "isAI",
          "label" : "Is AI",
          "formulaExpression" : "case \r\n    when (((\r\n        (contains(\"Product2.Name\", 'Gaudi') or contains(\"Product2.Name\", 'GAUDI') or contains(\"Product2.Name\", 'GPU Flex') or contains(\"Product2.Name\", 'Developer Cloud')) and \"Opp.Core_has_Solution__c\" = 'true'\r\n        )\r\n        \r\n        or ((contains(\"Product2.Name\", 'Xeon') \r\n        or contains(\"Product2.Name\", 'Arc') or contains(\"Product2.Name\", 'Core') \r\n        or contains(\"Product2.Name\", 'OpenVino') \r\n        or contains(\"Product2.Name\", 'oneAPI'))\r\n        and (contains(Application_Workload, 'AI Inference') \r\n        or contains(Application_Workload, 'AI Training') \r\n        or contains(Application_Workload, 'AI on Xeon') \r\n        or contains(\"Tech_Enable\", 'OneAPI') \r\n        or contains(\"Tech_Enable\", 'OpenVino')))\r\n        )\r\n        \r\n        or (contains(\"Product2.Name\", 'Core') and contains(\"Product2.Name\", 'Ultra') and startsWith(Solution_Name, 'AI PC'))\r\n        )\r\n then 'AI' else null end\r\n\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA10" : {
      "action" : "formula",
      "sources" : [ "FORMULA9" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "VBS_AI2",
          "label" : "solution VBS/AI",
          "formulaExpression" : "case \r\n    when isAI = 'AI' and isVBS = 'VBS' \r\n    then 'VSB/AI' \r\n    when isAI = 'AI' \r\n    then 'AI' \r\n    when isVBS = 'VBS' \r\n    then 'VBS' \r\nelse '-' end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA12" : {
      "action" : "formula",
      "sources" : [ "FORMULA10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "VBSAIlen",
          "label" : "VBSAI Len",
          "formulaExpression" : "char_length(VBS_AI2)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA13" : {
      "action" : "formula",
      "sources" : [ "FORMULA12" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "risk_num",
          "label" : "Risk #",
          "formulaExpression" : "substr(Core_Risk_Priority__c, 1, 1)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "TO_MEASURE0" : {
      "action" : "typeCast",
      "sources" : [ "FORMULA13" ],
      "parameters" : {
        "fields" : [ {
          "name" : "risk_num",
          "newProperties" : {
            "label" : "Risk # To Number",
            "name" : "risk_num_to_measure",
            "typeProperties" : {
              "type" : "NUMBER",
              "scale" : 0,
              "precision" : 18
            }
          }
        } ]
      }
    },
    "FORMULA22" : {
      "action" : "formula",
      "sources" : [ "TO_MEASURE0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "sales_grouping",
          "label" : "Sales Grouping",
          "formulaExpression" : "case \r\n    when contains(\"Opportunity.Account.Core_Sales_Groups__c\", 'Americas')\r\n    then 'Americas'\r\n    when contains(\"Opportunity.Account.Core_Sales_Groups__c\", 'EMEA')\r\n    then 'EMEA'\r\n    when contains(\"Opportunity.Account.Core_Sales_Groups__c\", 'APJ')\r\n    then 'APJ'\r\n    when contains(\"Opportunity.Account.Core_Sales_Groups__c\", 'PRC')\r\n    then 'PRC'\r\n    when contains(\"Opportunity.Account.Core_Sales_Groups__c\", 'Global')\r\n    then 'GSS'\r\n    else 'Other'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FILTER1" : {
      "action" : "filter",
      "sources" : [ "FORMULA22" ],
      "parameters" : {
        "filterExpressions" : [ {
          "type" : "TEXT",
          "field" : "VBS_AI2",
          "operator" : "NOT",
          "operands" : [ "-" ]
        } ]
      }
    },
    "FILTER2" : {
      "action" : "filter",
      "sources" : [ "FORMULA22" ],
      "parameters" : {
        "filterExpressions" : [ {
          "type" : "TEXT",
          "field" : "Core_Risk_Priority__c",
          "operator" : "EQUAL",
          "operands" : [ "1 Red Flag – Mission Critical, SMG Staff Attention", "2 High - Vital to Opportunity, Action Required", "3 Medium – Unusual Risk, Action Required" ]
        } ]
      }
    },
    "EXTRACT0" : {
      "action" : "extractGrains",
      "sources" : [ "FILTER2" ],
      "parameters" : {
