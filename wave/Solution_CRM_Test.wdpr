        "leftKeys" : [ "Id" ],
        "rightQualifier" : "Aggregate2",
        "rightKeys" : [ "Id" ]
      }
    },
    "FORMULA14" : {
      "action" : "formula",
      "sources" : [ "JOIN9" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "VBS_AI",
          "label" : "Opp VBS/AI",
          "formulaExpression" : "case \r\n    when \"Aggregate2.MAX_VBSAIlen\" = 6 then 'VBS/AI'\r\n    when \"Aggregate2.MAX_VBSAIlen\" = 3 then 'VBS'\r\n    when \"Aggregate2.MAX_VBSAIlen\" = 2 then 'AI'\r\n    else 'Other'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA15" : {
      "action" : "formula",
      "sources" : [ "FORMULA14" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Status_RYOG",
          "label" : "Status",
          "formulaExpression" : "case \r\n    when  StageName in ('Lost','Cancelled')\r\n    then 'Gray'\r\n    when \"Aggregate0.MIN_risk_num_to_measure\" = 1 then 'Red'\r\n    when \"Aggregate0.MIN_risk_num_to_measure\" = 2 \r\n    then 'Orange' \r\n    when \"Aggregate0.MIN_risk_num_to_measure\" = 3 \r\n    then 'Yellow'\r\n    else 'Green' \r\nend ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA16" : {
      "action" : "formula",
      "sources" : [ "FORMULA15" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Status_shortened",
          "label" : "Status Shortened",
          "formulaExpression" : "substr(\"Opp_VBS.Core_Status_Update__c\",1,150)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA17" : {
      "action" : "formula",
      "sources" : [ "FORMULA16" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "riskpriority",
          "label" : "Risk Priority",
          "formulaExpression" : "case when \"OpportunityProducts.Core_Risk_Priority__c\" is null then '-' else \"OpportunityProducts.Core_Risk_Priority__c\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA18" : {
      "action" : "formula",
      "sources" : [ "FORMULA17" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "RiskReason",
          "label" : "Risk Reason",
          "formulaExpression" : "case when \"LineItem.Core_Risk_Reason1__c\" is null then '-' else \"LineItem.Core_Risk_Reason1__c\" end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA19" : {
      "action" : "formula",
      "sources" : [ "FORMULA18" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "riskdetail",
          "label" : "Risk Detail",
          "formulaExpression" : "case when \"LineItem.Core_Risk_Detail__c\" is null then '-' else \"LineItem.Core_Risk_Detail__c\" end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA20" : {
      "action" : "formula",
      "sources" : [ "FORMULA19" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "solutiondescription",
          "label" : "Solution Description",
          "formulaExpression" : "case when \"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.Solution_technology.CORE_SOLUTION_DESCRIPTION_DSC\" is null then '-' else \"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.Solution_technology.CORE_SOLUTION_DESCRIPTION_DSC\" end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
