    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Opportunity_Name",
          "label" : "Opportunity Name",
          "formulaExpression" : "\"Name\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "StageSorted",
          "label" : "StageSorted",
          "formulaExpression" : "(case when StageName = 'Qualify' then '1 - Qualify' when StageName = 'Define' then '2 - Define' when StageName = 'Develop' then '3 - Develop' when StageName = 'Design' then '4 - Design' when StageName = 'Design Win' then '5 - Design Win' when StageName = 'Production Win' then '6 - Production Win' when StageName = 'Production Lost' then '7 - Production Lost' when StageName = 'Production Cancelled' then '8 - Production Cancelled' when StageName = 'Lost' then '9 - Lost' when StageName = 'Cancelled' then '91 - Cancelled'  else '99 - No Match' end)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Status_Name",
          "label" : "Status Name",
          "formulaExpression" : "case when \"Opportunit.Core_Status__c\" = 'Production Win' then 'Won' when \"Opportunit.Core_Status__c\" = 'Production Lost' then 'Won' when \"Opportunit.Core_Status__c\" = 'Production Cancelled' then 'Won' when \"Opportunit.Core_Status__c\" = 'Win Approved' then 'Won' when \"Opportunit.Core_Status__c\" = 'Lost' then 'Lost' when \"Opportunit.Core_Status__c\" = 'Cancelled' then 'Lost' when \"Opportunit.Core_Status__c\" = 'Pending' then 'Open' when \"Opportunit.Core_Status__c\" = 'On Hold' then 'Open' when \"Opportunit.Core_Status__c\" = 'Win Submitted' then 'Open' else \"Opportunit.Core_Status__c\" end",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Partner_Name",
          "label" : "Partner Name",
          "formulaExpression" : "\"Parter_Solution_Products.PARTNER_NAME\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Application_Workload",
          "label" : "Application Workload",
          "formulaExpression" : "\"Solution_OpportunityProducts.CORE_APPLICATION_WORKLOAD_SPLIT_NM\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Tech_Enable",
          "label" : "Tech Enable",
          "formulaExpression" : "\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.CORE_TECHNOLOGY_ENABLED_C_SPLIT_NM\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Industry_Use_Cases",
          "label" : "Industry Use Cases",
          "formulaExpression" : "\"Solution_OpportunityProducts.Solution_Application_Workload.CORE_INDUSTRY_USE_CASE_C_SPLIT_NM\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Solution_Name",
          "label" : "Solution Name",
          "formulaExpression" : "\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.Solution_technology.SOLUTION_NM\"",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "isVBS",
          "label" : "Is VBS",
          "formulaExpression" : "case when \"Opp_VBS.Core_VBS_Status__c\" in ('Pending', 'SOAR 1 Qualified', 'Approved') then 'VBS' else null end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA9" : {
      "action" : "formula",
      "sources" : [ "FORMULA8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "isAI",
          "label" : "Is AI",
          "formulaExpression" : "case \r\n    when (((\r\n        (contains(\"Opportunit.Name\", 'Gaudi') or contains(\"Opportunit.Name\", 'GPU Flex') or contains(\"Opportunit.Name\", 'Developer Cloud')) and \"Opp_VBS.Core_has_Solution__c\" = 'true'\r\n        )\r\n        or ((contains(\"Opportunit.Name\", 'Xeon') or contains(\"Opportunit.Name\", 'Arc') or contains(\"Opportunit.Name\", 'Core') or contains(\"Opportunit.Name\", 'OpenVino') or contains(\"Opportunit.Name\", 'oneAPI'))\r\n        and (contains(Application_Workload, 'AI Inference') or contains(Application_Workload, 'AI Training') or contains(Application_Workload, 'AI on Xeon') or contains(\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.CORE_TECHNOLOGY_ENABLED_C_SPLIT_NM\", 'oneAPI') or contains(\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.CORE_TECHNOLOGY_ENABLED_C_SPLIT_NM\", 'OpenVino')))\r\n        )\r\n        or (contains(\"Opportunit.Name\", 'Core') and contains(\"Opportunit.Name\", 'Ultra') and startsWith(Solution_Name, 'AI PC'))\r\n        )\r\n then 'AI' else null end\r\n\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA10" : {
      "action" : "formula",
      "sources" : [ "FORMULA9" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "VBS_AI2",
          "label" : "solution VBS/AI",
          "formulaExpression" : "case \r\n    when isAI = 'AI' and isVBS = 'VBS' \r\n    then 'VSB/AI' \r\n    when isAI = 'AI' \r\n    then 'AI' \r\n    when isVBS = 'VBS' \r\n    then 'VBS' \r\nelse '-' end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA11" : {
      "action" : "formula",
      "sources" : [ "FORMULA10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Status_RYOG_pre",
          "label" : "Status",
          "formulaExpression" : "case \r\n    when  StageName in ('Lost','Cancelled')\r\n    then 'Red'\r\n    when \"Opp_VBS.Core_At_Risk__c\" = 'true' \r\n    then 'Yellow'\r\n    else 'Green' \r\nend ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA12" : {
      "action" : "formula",
      "sources" : [ "FORMULA11" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "VBSAIlen",
          "label" : "VBSAI Len",
          "formulaExpression" : "char_length(VBS_AI2)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA13" : {
      "action" : "formula",
      "sources" : [ "FORMULA12" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "risk_num",
          "label" : "Risk #",
          "formulaExpression" : "substr(\"OpportunityProducts.Core_Risk_Priority__c\", 1, 1)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "TO_MEASURE0" : {
      "action" : "typeCast",
      "sources" : [ "FORMULA13" ],
      "parameters" : {
        "fields" : [ {
          "name" : "risk_num",
          "newProperties" : {
            "label" : "Risk # To Number",
            "name" : "risk_num_to_measure",
            "typeProperties" : {
              "type" : "NUMBER",
              "scale" : 0,
              "precision" : 18
            }
          }
        } ]
      }
    },
    "FORMULA22" : {
      "action" : "formula",
      "sources" : [ "TO_MEASURE0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "sales_grouping",
          "label" : "Sales Grouping",
          "formulaExpression" : "case \r\n    when contains(\"Opp_VBS.Core_Sales_Groups__c\", 'Americas') then 'Americas'\r\n    when contains(\"Opp_VBS.Core_Sales_Groups__c\", 'APJ') then 'APJ'\r\n    when contains(\"Opp_VBS.Core_Sales_Groups__c\", 'EMEA') then 'EMEA'\r\n    when contains(\"Opp_VBS.Core_Sales_Groups__c\", 'PRC') then 'PRC'\r\n    when contains(\"Opp_VBS.Core_Sales_Groups__c\", 'Global') then 'GSS'\r\n    else 'Other'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
