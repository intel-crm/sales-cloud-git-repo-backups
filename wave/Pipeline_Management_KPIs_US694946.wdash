by  '{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' in {{coalesce(column(KPIsMetricsChartStac_2.selection, [\"KPI Name/Account\"]),'all').asString()}};  q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_manager\"]).asObject()}}' in {{coalesce(column(Sales_Manager_Filter_8.selection, [\"Name\"]),'all').asString()}}; q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_rep\"]).asObject()}}' in {{coalesce(column(Sales_Rep_Filter_1.selection, [\"Name\"]),'all').asString()}}; \r\n\r\nresult = group q by ('kpi_name', 'kpi_type', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'o.kpi_fiscal_year_quarter_number' );\r\n\r\nresult = foreach result generate \r\n        result.'kpi_name' as 'KPI Name',\r\n        result.'o.account_name' as 'o.account_name',\r\n        result.'o.opportunity_name' as 'o.opportunity_name', \r\n        result.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result.'o.kpi_fiscal_year_quarter_number' as 'KPI Date',\r\nresult.'kpi_type' as 'kpi_type',\r\nsum(result.'o.pending_dw_amt') as 'pending_dw_amt', \r\nsum(result.'o.pending_core_kpi_qty') as 'pending_core_kpi_qty', \r\nsum(result.'o.won_core_kpi_qty') as 'won_core_kpi_qty', \r\nsum(result.'o.won_dw_amt') as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\nresult1 = group q by ('kpi_name', 'kpi_type', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'o.kpi_fiscal_year_quarter_number' );\r\n\r\nresult1 = foreach result1 generate \r\n        result1.'kpi_name' as 'KPI Name',\r\n        result1.'o.account_name' as 'o.account_name',\r\n        result1.'o.opportunity_name' as 'o.opportunity_name', \r\n        result1.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result1.'o.kpi_fiscal_year_quarter_number' as 'KPI Date',\r\nresult1.'kpi_type' as 'kpi_type',        \r\n0 as 'pending_dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\nunique(result1.'o.pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\n\r\nresult2 = group q by ('kpi_name', 'kpi_type', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'o.kpi_fiscal_year_quarter_number' );\r\n\r\nresult2 = foreach result2 generate \r\n        result2.'kpi_name' as 'KPI Name',\r\n        result2.'o.account_name' as 'o.account_name',\r\n        result2.'o.opportunity_name' as 'o.opportunity_name', \r\n        result2.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result2.'o.kpi_fiscal_year_quarter_number' as 'KPI Date',\r\nresult2.'kpi_type' as 'kpi_type',\r\n0 as 'pending_dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\nunique(result2.'o.win_opportunity_id') as win_opportunity_cnt;\r\n\r\n\r\nresult3 = union result1, result2, result;\r\n\r\n\r\n\r\nresult3 = group result3 by ('KPI Name', 'kpi_type', 'o.opportunity_name',  'o.account_name',  'Opportunity Owner', 'KPI Date' );\r\n\r\nresult3 = foreach result3 generate \r\n        'kpi_type',\r\n        'KPI Name',\r\n        'o.account_name',\r\n        'o.opportunity_name', \r\n        'Opportunity Owner',\r\n        'KPI Date',\r\n\r\n        \r\nmax('pending_dw_amt') as 'pending_dw_amt', \r\nmax(result3.pending_core_kpi_qty) as pending_core_kpi_qty, \r\nmax(result3.won_core_kpi_qty) as won_core_kpi_qty, \r\nmax(result3.won_dw_amt) as won_dw_amt,\r\nmax(result3.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result3.win_opportunity_cnt) as win_opportunity_cnt;\r\n\r\nresult4 = foreach result3 generate \r\n        'KPI Name',\r\n        'o.account_name',\r\n        'o.opportunity_name', \r\n        'Opportunity Owner',\r\n        'KPI Date',\r\ncase result3.'kpi_type' when \"Salesforce Pipeline $\" then result3.won_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result3.won_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result3.win_opportunity_cnt\r\nelse 0 end as 'Won'; ","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"won_pending_kpi_togg_1":{"broadcastFacet":true,"columns":{},"label":"won_pending_kpi_toggle","selectMode":"single","start":"{\"display\":[\"KPI Name\"]}","type":"staticflex","values":["{\"display\":\"KPI Name\",\"value\":\"kpi_name\",\"order_by\":\"'KPI Name/Account'\",\"type\":\"asc\"}","{\"display\":\"Account\",\"value\":\"o.account_name\",\"order_by\":\"'KPI'\",\"type\":\"desc\"}"]},