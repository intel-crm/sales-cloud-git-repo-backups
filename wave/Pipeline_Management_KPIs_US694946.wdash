i_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' in {{coalesce(column(KPIsMetricsChartStac_2.selection, [\"KPI Name/Account\"]),'all').asString()}};; q = filter q by 'o.Opportunity.Owner.Name' in all; \r\nresult = group q by ('kpi_name', 'kpi_type', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'o.kpi_fiscal_year_quarter_number', 'o.stage_name',\r\n'o.pipeline_health', 'o.past_due', 'o.inactive', 'o.low_velocity');\r\n\r\nresult = foreach result generate\r\n        result.'kpi_name' as 'KPI Name',\r\n        result.'o.account_name' as 'Acccount Name',\r\n        result.'o.opportunity_name' as 'o.opportunity_name',\r\n        result.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result.'o.kpi_fiscal_year_quarter_number' as 'KPI Date',\r\n        result.'o.stage_name' as 'Stage',\r\n        result.'o.pipeline_health' as 'Pipeline Health',  \r\n        result.'o.past_due' as 'Past Due', \r\n        result.'o.inactive' as 'Inactive',\r\n        result.'o.low_velocity' as 'Low Velocity',\r\nresult.'kpi_type' as 'kpi_type',\r\nsum(result.'o.pending_dw_amt') as 'pending_dw_amt',\r\nsum(result.'o.pending_core_kpi_qty') as 'pending_core_kpi_qty',\r\nsum(result.'o.won_core_kpi_qty') as 'won_core_kpi_qty',\r\nsum(result.'o.won_dw_amt') as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\nresult1 = group q by ('kpi_name', 'kpi_type', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'o.kpi_fiscal_year_quarter_number', 'o.stage_name',\r\n'o.pipeline_health', 'o.past_due', 'o.inactive', 'o.low_velocity' );\r\n\r\nresult1 = foreach result1 generate\r\n        result1.'kpi_name' as 'KPI Name',\r\n        result1.'o.account_name' as 'Acccount Name',\r\n        result1.'o.opportunity_name' as 'o.opportunity_name',\r\n        result1.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result1.'o.kpi_fiscal_year_quarter_number' as 'KPI Date',\r\n        result1.'o.stage_name' as 'Stage',\r\n        result1.'o.pipeline_health' as 'Pipeline Health', \r\n        result1.'o.past_due' as 'Past Due', \r\n        result1.'o.inactive' as 'Inactive',\r\n        result1.'o.low_velocity' as 'Low Velocity',\r\nresult1.'kpi_type' as 'kpi_type',\r\n0 as 'pending_dw_amt',\r\n0 as 'pending_core_kpi_qty',\r\n0 as 'won_core_kpi_qty',\r\n0 as 'won_dw_amt',\r\nunique(result1.'o.pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\n\r\nresult2 = group q by ('kpi_name', 'kpi_type', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'o.kpi_fiscal_year_quarter_number', 'o.stage_name',\r\n'o.pipeline_health', 'o.past_due', 'o.inactive', 'o.low_velocity' );\r\n\r\nresult2 = foreach result2 generate\r\n        result2.'kpi_name' as 'KPI Name',\r\n        result2.'o.account_name' as 'Acccount Name',\r\n        result2.'o.opportunity_name' as 'o.opportunity_name',\r\n        result2.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result2.'o.kpi_fiscal_year_quarter_number' as 'KPI Date',\r\n        result2.'o.stage_name' as 'Stage',\r\n        result2.'o.pipeline_health' as 'Pipeline Health', \r\n        result2.'o.past_due' as 'Past Due', \r\n        result2.'o.inactive' as 'Inactive',\r\n        result2.'o.low_velocity' as 'Low Velocity',\r\nresult2.'kpi_type' as 'kpi_type',\r\n0 as 'pending_dw_amt',\r\n0 as 'pending_core_kpi_qty',\r\n0 as 'won_core_kpi_qty',\r\n0 as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\nunique(result2.'o.win_opportunity_id') as win_opportunity_cnt;\r\n\r\n\r\nresult3 = union result1, result2, result;\r\n\r\n\r\n\r\nresult3 = group result3 by ('KPI Name', 'kpi_type', 'o.opportunity_name',  'Acccount Name',  'Opportunity Owner', 'KPI Date', 'Stage', 'Pipeline Health',  'Past Due',  'Inactive', 'Low Velocity' );\r\n\r\nresult3 = foreach result3 generate\r\n        'kpi_type',\r\n        'KPI Name',\r\n        'Acccount Name',\r\n        'o.opportunity_name',\r\n        'Opportunity Owner',\r\n        'KPI Date',\r\n        'Stage',\r\n        'Pipeline Health', \r\n        'Past Due', \r\n        'Inactive',\r\n        'Low Velocity',\r\n\r\nmax('pending_dw_amt') as 'pending_dw_amt',\r\nmax(result3.pending_core_kpi_qty) as pending_core_kpi_qty,\r\nmax(result3.won_core_kpi_qty) as won_core_kpi_qty,\r\nmax(result3.won_dw_amt) as won_dw_amt,\r\nmax(result3.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result3.win_opportunity_cnt) as win_opportunity_cnt;\r\n\r\nresult4 = foreach result3 generate\r\n        'KPI Name',\r\n        'Acccount Name',\r\n        'o.opportunity_name',\r\n        'Opportunity Owner',\r\n        'KPI Date',\r\n        'Stage',\r\n        \"■\" as  'Health Status', \r\n        case when 'Pipeline Health'== \"false\" then \"#66CC00\" else \"#CC0000\" end as 'ph_color',\r\n        \"■\" as  'Past Due', \r\n        case when 'Past Due'== \"Not Past Due\" then \"#66CC00\" else \"#CC0000\" end as 'pd_color',\r\n        \"■\" as  'Inactive', \r\n        case when 'Inactive'== \"false\" then \"#66CC00\" else \"#CC0000\" end as 'i_color',\r\n        \"■\" as  'Low Velocity', \r\n        case when 'Low Velocity'== \"false\" then \"#66CC00\" else \"#CC0000\" end as 'lq_color',\r\ncase result3.'kpi_type' when \"Salesforce Pipeline $\" then result3.pending_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result3.pending_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result3.pending_opportunity_cnt\r\nelse 0 end as 'Pending';\r\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","posit