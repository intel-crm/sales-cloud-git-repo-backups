akpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Product_Type_Filter_1":{"broadcastFacet":true,"datasets":[{"name":"KPIProductsOpportunity"}],"isGlobal":false,"label":"Product Type Filter","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"o.opportunity_product_type\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[]","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["o.opportunity_product_type"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"KPIsMetrics_1":{"broadcastFacet":true,"groups":[],"label":"KPIsMetrics","numbers":[],"query":"q = load \"KPIProductsOpportunity\"; q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_manager\"]).asObject()}}' in {{coalesce(column(Sales_Manager_Filter_8.selection, [\"Name\"]),'all').asString()}}; q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_rep\"]).asObject()}}' in {{coalesce(column(Sales_Rep_Filter_1.selection, [\"Name\"]),'all').asString()}}; \r\n\r\n\r\nresult = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type', 'kpi_achieved');\r\n\r\nresult = foreach result generate result.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', 'kpi_achieved', \r\nresult.'kpi_type' as 'kpi_type',\r\nsum(result.'o.pending_dw_amt') as 'pending_dw_amt', \r\nsum(result.'o.pending_core_kpi_qty') as 'pending_core_kpi_qty', \r\nsum(result.'o.won_core_kpi_qty') as 'won_core_kpi_qty', \r\nsum(result.'o.won_dw_amt') as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\nresult1 = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type', 'kpi_achieved');\r\n\r\nresult1 = foreach result1 generate result1.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', \r\nresult1.'kpi_type' as 'kpi_type', 'kpi_achieved', \r\n0 as 'pending_dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\nunique(result1.'o.pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\n\r\nresult2 = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type', 'kpi_achieved');\r\n\r\nresult2 = foreach result2 generate result2.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', 'kpi_achieved', \r\nresult2.'kpi_type' as 'kpi_type',\r\n0 as 'pending_dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\nunique(result2.'o.win_opportunity_id') as win_opportunity_cnt;\r\n\r\n\r\nresult3 = union result1, result2, result;\r\nresult3 = group result3 by ('kpi_name', 'kpi_type', 'kpi_achieved');\r\nresult3 = foreach result3 generate result3.kpi_name as kpi_name, 'kpi_achieved', \r\nresult3.kpi_type as kpi_type,\r\nmax('pending_dw_amt') as 'pending_dw_amt', \r\nmax(result3.pending_core_kpi_qty) as pending_core_kpi_qty, \r\nmax(result3.won_core_kpi_qty) as won_core_kpi_qty, \r\nmax(result3.won_dw_amt) as won_dw_amt,\r\nmax(result3.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result3.win_opportunity_cnt) as win_opportunity_cnt;\r\n\r\n\r\n result4 = filter result3 by 'kpi_achieved' == \"true\"; result4 = foreach result4 generate result4.'kpi_name' as 'KPI Name/Account',\r\ncase result4.'kpi_type' when \"Salesforce Pipeline $\" then result4.won_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result4.won_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result4.win_opportunity_cnt\r\nelse 0 end as 'KPI',\r\n\"Won KPI\" as 'KPI Type';\r\n\r\n\r\n  result5 = filter result3 by 'kpi_achieved' == \"false\"; result5 = foreach result5 generate result5.'kpi_name' as 'KPI Name/Account',\r\ncase result5.'kpi_type' when \"Salesforce Pipeline $\" then result5.pending_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result5.pending_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result5.pending_opportunity_cnt\r\nelse 0 end as 'KPI',\r\n\"Pending KPI\" as 'KPI Type';\r\n\r\nresult6 = union result4, result5; \r\n result7 = group result6 by 'KPI Type'; result7 = foreach result7 generate 'KPI Type', sum('KPI') as 'KPI'; \r\n transposedResult = foreach result7 generate case result7.'KPI Type' when \"Pending KPI\" then result7.'KPI' else 0 end as 'pending_kpi', case result7.'KPI Type' when \"Won KPI\" then result7.'KPI' else 0  end as 'won_kpi'; \r\n transposedResult = group transposedResult by all; transposedResult = foreach transposedResult generate  sum('won_kpi') as 'won_kpi', sum('pending_kpi') as 'pending_kpi';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidt