alse,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"KPIsMetricsChart_1":{"broadcastFacet":true,"groups":[],"label":"KPIsMetricsChart","numbers":[],"query":"q = load \"KPIProductsOpportunity\";\r\n\r\n\r\nresult = group q by ({{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}, 'kpi_type');\r\n\r\nresult = foreach result generate result.{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}} as 'kpi_name',\r\nresult.'kpi_type' as 'kpi_type',\r\nsum(result.'o.pending_dw_amt') as 'pending_dw_amt', \r\nsum(result.'o.pending_core_kpi_qty') as 'pending_core_kpi_qty', \r\nsum(result.'o.won_core_kpi_qty') as 'won_core_kpi_qty', \r\nsum(result.'o.won_dw_amt') as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\nresult1 = group q by ({{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}, 'kpi_type');\r\n\r\nresult1 = foreach result1 generate result1.{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}} as 'kpi_name', \r\nresult1.'kpi_type' as 'kpi_type',\r\n0 as 'pending_dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\nunique(result1.'o.pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\n\r\nresult2 = group q by ({{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}, 'kpi_type');\r\n\r\nresult2 = foreach result2 generate result2.{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}} as 'kpi_name', \r\nresult2.'kpi_type' as 'kpi_type',\r\n0 as 'pending_dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\nunique(result2.'o.win_opportunity_id') as win_opportunity_cnt;\r\n\r\n\r\nresult3 = union result1, result2, result;\r\nresult3 = group result3 by ('kpi_name', 'kpi_type');\r\nresult3 = foreach result3 generate result3.kpi_name as kpi_name, \r\nresult3.kpi_type as kpi_type,\r\nmax('pending_dw_amt') as 'pending_dw_amt', \r\nmax(result3.pending_core_kpi_qty) as pending_core_kpi_qty, \r\nmax(result3.won_core_kpi_qty) as won_core_kpi_qty, \r\nmax(result3.won_dw_amt) as won_dw_amt,\r\nmax(result3.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result3.win_opportunity_cnt) as win_opportunity_cnt;\r\n\r\n\r\nresult4 = foreach result3 generate result3.'kpi_name' as 'KPI Name/Account',\r\ncase result3.'kpi_type' when \"Salesforce Pipeline $\" then result3.won_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result3.won_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result3.win_opportunity_cnt\r\nelse 0 end as 'Won KPI',\r\n\r\ncase result3.'kpi_type' when \"Salesforce Pipeline $\" then result3.pending_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result3.pending_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result3.pending_opportunity_cnt\r\nelse 0 end as 'Pending KPI';\r\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","num