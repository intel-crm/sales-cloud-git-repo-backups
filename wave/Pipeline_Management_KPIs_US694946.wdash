dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\nunique(result1.'o.pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\n\r\nresult2 = group q by ({{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}, 'kpi_type');\r\n\r\nresult2 = foreach result2 generate result2.{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}} as 'kpi_name', \r\nresult2.'kpi_type' as 'kpi_type',\r\n0 as 'pending_dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\nunique(result2.'o.win_opportunity_id') as win_opportunity_cnt;\r\n\r\n\r\nresult3 = union result1, result2, result;\r\nresult3 = group result3 by ('kpi_name', 'kpi_type');\r\nresult3 = foreach result3 generate result3.kpi_name as kpi_name, \r\nresult3.kpi_type as kpi_type,\r\nmax('pending_dw_amt') as 'pending_dw_amt', \r\nmax(result3.pending_core_kpi_qty) as pending_core_kpi_qty, \r\nmax(result3.won_core_kpi_qty) as won_core_kpi_qty, \r\nmax(result3.won_dw_amt) as won_dw_amt,\r\nmax(result3.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result3.win_opportunity_cnt) as win_opportunity_cnt;\r\n\r\n\r\nresult4 = foreach result3 generate result3.'kpi_name' as 'KPI Name/Account',\r\ncase result3.'kpi_type' when \"Salesforce Pipeline $\" then result3.won_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result3.won_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result3.win_opportunity_cnt\r\nelse 0 end as 'KPI',\r\n\"Won KPI\" as 'KPI Type';\r\n\r\n\r\nresult5 = foreach result3 generate result3.'kpi_name' as 'KPI Name/Account',\r\ncase result3.'kpi_type' when \"Salesforce Pipeline $\" then result3.pending_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result3.pending_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result3.pending_opportunity_cnt\r\nelse 0 end as 'KPI',\r\n\"Pending KPI\" as 'KPI Type';\r\n\r\nresult6 = union result4, result5;\r\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","totalSumMode":"none","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"split":["KPI Type"],"trellis":[],"dimensionAxis":["KPI Name/Account"],"plots":["KPI"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"valueType":"compactNumber","theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Fiscal_Year_Filter_1":{"broadcastFacet":true,"datasets":[{"name":"KPIProductsOpportunity"}],"isGlobal":false,"label":"Fiscal Year Filter","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"o.fiscal_year_number\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[\"2020\"]","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"kee