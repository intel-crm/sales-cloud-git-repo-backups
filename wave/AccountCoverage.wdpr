    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "JOIN3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Manager_NM",
          "label" : "Manager NM",
          "formulaExpression" : "(case\r\n      WHEN \"usermanager.MANAGER_NM\" IS NULL THEN 'Unknown'\r\n      ELSE \"usermanager.MANAGER_NM\"\r\nend)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA13" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Owner_NM",
          "label" : "Owner NM",
          "formulaExpression" : "(case\r\n      WHEN \"User.OWNER_NM\" IS NULL THEN 'Unknown'\r\n      ELSE \"User.OWNER_NM\"\r\nend)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA9" : {
      "action" : "formula",
      "sources" : [ "FORMULA8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "account_lvl",
          "label" : "Account Level",
          "formulaExpression" : "(case\r\n      WHEN Core_Account_Level__c IS NULL THEN 'Blank'\r\n      ELSE Core_Account_Level__c\r\nend)\r\n\r\n",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA10" : {
      "action" : "formula",
      "sources" : [ "FORMULA11" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Account_Sales_Grouping",
          "label" : "Account Sales Group",
          "formulaExpression" : "(case\r\n      when contains(upper(\"Core_Sales_Groups__c\"), 'INDIA')\r\n      then 'India'\r\n      when startsWith(\"Core_Sales_Groups__c\", 'EMEA') \r\n      then 'EMEA'\r\n      when \"Core_Sales_Groups__c\" = 'Global Solutions & Services Sales Group' then 'GSS'\r\n      when startsWith(\"Core_Sales_Groups__c\", 'APJ') then 'APJ' \r\n      when startsWith(\"Core_Sales_Groups__c\", 'Americas' ) then 'Americas' \r\n      when startsWith(\"Core_Sales_Groups__c\", 'PRC') then 'PRC'\r\n      when startsWith(\"Core_Sales_Groups__c\", ' ' ) then 'Unknown' \r\n      else 'Other'\r\nend)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA11" : {
      "action" : "formula",
      "sources" : [ "FORMULA14" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Account_Owner_Active_ind",
          "label" : "Account Owner Active",
          "formulaExpression" : "(CASE \r\n    WHEN Core_Account_Owner_Active__c = 'true' THEN 'Yes'\r\n    WHEN Core_Account_Owner_Active__c = 'false' THEN 'No'\r\n    WHEN Core_Account_Owner_Active__c is null THEN 'NA'\r\n    ELSE Core_Account_Owner_Active__c\r\nEND)",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA12" : {
      "action" : "formula",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
