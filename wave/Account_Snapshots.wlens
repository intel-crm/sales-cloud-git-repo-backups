{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"SnapshotDS18\";\nq = filter q by 'Core_Account_Primary_Coverage__c' matches \"Intel\";\nq = filter q by 'Core_Account_Level__c' == \"Level1\";\nq = filter q by 'AccountUser.OWNER_HIERARCHY_TXT' matches \"005o0000001fZM0AAM\";--\"005o0000001fizkAAA\" Ajay;\nq_AccPlan = filter q by 'Account_Plan.Number_of_Attachments__c' >= 1 || ('Account_Plan.Core_Document_Link__c' matches \"onedrive\" || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\" || 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\");\nq = cogroup q by ('Snapshot_Date_Year', 'Snapshot_Date_Month') full, q_AccPlan by ('Snapshot_Date_Year', 'Snapshot_Date_Month');\nq = foreach q generate coalesce(q.'Snapshot_Date_Year', q_AccPlan.'Snapshot_Date_Year') as 'Snapshot_Date_Year', coalesce(q.'Snapshot_Date_Month', q_AccPlan.'Snapshot_Date_Month') as 'Snapshot_Date_Month', unique(q.'Core_Unified_Global_Customer_Name__c') as 'General', unique(q_AccPlan.'Core_Unified_Global_Customer_Name__c') as 'AccPlan';\nq = foreach q generate 'Snapshot_Date_Year', 'Snapshot_Date_Month', 'General', 'AccPlan', sum(AccPlan)/sum(General) as 'Metric';\nq = order q by ('Snapshot_Date_Year' asc, 'Snapshot_Date_Month' asc);\nq = limit q 2000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true}},"widgets":{"saql_chart":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","exploreLink":true,"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","step":"saql","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}}}