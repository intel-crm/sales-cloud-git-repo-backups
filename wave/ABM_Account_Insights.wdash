ay_cnt') as 'form_submit_last_30_day_cnt',  max('page_view_last_60_to_30_day_cnt') as 'page_view_last_60_to_30_day_cnt', max('page_view_last_30_day_cnt') as 'page_view_last_30_day_cnt';\r\nresult = group result by all;\r\n\r\nresult = foreach result generate sum('email_clicks_last_60_to_30_day_cnt') as 'ec_count60', sum('email_clicks_last_30_day_cnt') as 'ec_count30', sum('form_submit_last_30_day_cnt') as 'fs_count30', sum('form_submit_last_60_to_30_day_cnt') as 'fs_count60', sum('page_view_last_30_day_cnt') as 'wv_count30', sum('page_view_last_60_to_30_day_cnt') as 'wv_count60';\r\n\r\nresult = foreach result generate \r\n'ec_count30', \r\n'ec_count60',\r\ncase when 'ec_count60' > 0 then round(((ec_count30-ec_count60)/ec_count60),2)*100 else round(((ec_count30-ec_count60)/1),2)*100 end  as 'email_clicks_change_pct',\r\ncase when (ec_count30 - ec_count60) > 0 then \"#c4d600\" else \"#fc4c02\" end as 'email_clicks_change_color',\r\ncase when (ec_count30 - ec_count60) > 0 then  \"⯅\" else \"⯆\"  end as 'email_clicks_change_nm', \r\n\r\n'fs_count30', \r\n'fs_count60', \r\ncase when 'fs_count60' > 0 then round(((fs_count30-fs_count60)/fs_count60 ),2)*100 else round(((fs_count30-fs_count60)/1),2)*100 end as 'form_submit_change_pct', \r\ncase when (fs_count30 - fs_count60) > 0 then \"⯅\" else  \"⯆\"  end as 'form_submit_change_trend_nm',  \r\ncase when (fs_count30 - fs_count60) > 0 then \"#c4d600\" else \"#fc4c02\" end as 'form_submit_change_trend_color', \r\n\r\n'wv_count30', \r\n'wv_count60', \r\ncase when 'wv_count60' > 0 then round(((wv_count30-wv_count60)/wv_count60),2)*100 else round(((wv_count30-wv_count60)/1),2)*100 end as page_view_change_pct, \r\ncase when (wv_count30 - wv_count60) > 0 then \"⯅\"  else \"⯆\"  end as 'page_view_change_trend_nm', \r\ncase when (wv_count30 - wv_count60) > 0 then \"#c4d600\" else \"#fc4c02\"  end as 'page_view_change_trend_color';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useEx