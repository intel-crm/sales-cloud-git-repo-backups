clicks_last_30_day_cnt') as 'email_clicks_last_30_day_cnt', max(q.'email_clicks_last_60_to_30_day_cnt') as 'email_clicks_last_60_to_30_day_cnt',max('form_submit_last_60_to_30_day_cnt') as 'form_submit_last_60_to_30_day_cnt', max('form_submit_last_30_day_cnt') as 'form_submit_last_30_day_cnt',  max('page_view_last_60_to_30_day_cnt') as 'page_view_last_60_to_30_day_cnt', max('page_view_last_30_day_cnt') as 'page_view_last_30_day_cnt';\r\nresult = group result by all;\r\n\r\nresult = foreach result generate sum('email_clicks_last_60_to_30_day_cnt') as 'ec_count60', sum('email_clicks_last_30_day_cnt') as 'ec_count30', sum('form_submit_last_30_day_cnt') as 'fs_count30', sum('form_submit_last_60_to_30_day_cnt') as 'fs_count60', sum('page_view_last_30_day_cnt') as 'wv_count30', sum('page_view_last_60_to_30_day_cnt') as 'wv_count60';\r\n\r\nresult = foreach result generate \r\n'ec_count30', \r\n'ec_count60',\r\ncase when 'ec_count60' > 0 then round(((ec_count30-ec_count60)/ec_count60),2)*100 else round(((ec_count30-ec_count60)/1),2)*100 end  as 'email_clicks_change_pct',\r\ncase when (ec_count30 - ec_count60) > 0 then \"#c4d600\" else \"#fc4c02\" end as 'email_clicks_change_color',\r\ncase when (ec_count30 - ec_count60) > 0 then  \"⯅\" else \"⯆\"  end as 'email_clicks_change_nm', \r\n\r\n'fs_count30', \r\n'fs_count60', \r\ncase when 'fs_count60' > 0 then round(((fs_count30-fs_count60)/fs_count60 ),2)*100 else round(((fs_count30-fs_count60)/1),2)*100 end as 'form_submit_change_pct', \r\ncase when (fs_count30 - fs_count60) > 0 then \"⯅\" else  \"⯆\"  end as 'form_submit_change_trend_nm',  \r\ncase when (fs_count30 - fs_count60) > 0 then \"#c4d600\" else \"#fc4c02\" end as 'form_submit_change_trend_color', \r\n\r\n'wv_count30', \r\n'wv_count60', \r\ncase when 'wv_count60' > 0 then round(((wv_count30-wv_count60)/wv_count60),2)*100 else round(((wv_count30-wv_count60)/1),2)*100 end as page_view_change_pct, \r\ncase when (wv_count30 - wv_count60) > 0 then \"⯅\"  else \"⯆\"  end as 'page_view_change_trend_nm', \r\ncase when (wv_count30 - wv_count60) > 0 then \"#c4d600\" else \"#fc4c02\"  end as 'page_view_change_trend_color';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"totals":true,"verticalPadding":8},"type":"table"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1},"widgets":{"link_18":{"parameters":{"destinationLink":{"name":"a78045f7-2f33-4095-bc08-0022b98896c4"},"destinationType":"page","fontSize":16,"includeState":false,"text":"▲","textAlignment":"center","textColor":"#FFFFFF"},"type":"link"},"link_19":{"parameters":{"destinationLink":{"name":"93187fe5-13a1-445e-9b5a-5bb4f60b8454"},"destinationType":"page","fontSize":16,"includeState":false,"text":"▼","textAlignment":"center","textColor":"#FFFFFF"},"type":"link"},"link_16":{"parameters":{"destinationLink":{"name":"a78045f7-2f33-4095-bc08-0022b98896c4"},"destinationType":"page","fontSize":16,"includeState":false,"text":"▲","textAlignment":"center","textColor":"#FFFFFF"},"type":"link"},"link_17":{"parameters":{"destinationLink":{"name":"a78045f7-2f33-4095-bc08-0022b98896c4"},"destinationType":"page","fontSize":16,"includeState":false,"text":"▲","textAlignment":"center","textColor":"#FFFFFF"},"type":"link"},"link_14":{"parameters":{"destinationLink":{"name":"d32d104a-663d-48dd-844e-2c247e248011"},"destinationType":"page","fontSize":16,"includeState":false,"text":