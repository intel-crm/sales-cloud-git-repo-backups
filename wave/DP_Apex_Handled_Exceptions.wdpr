    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CreatedDateDifference",
          "label" : "Created Date Difference",
          "formulaExpression" : "datediff(now(), CreatedDate)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "DaysCategory",
          "label" : "Days Category",
          "formulaExpression" : "case \r\n    when \"CreatedDateDifference\" >= 0 and \"CreatedDateDifference\" < 31 \r\n    then '0-30 Days' \r\n when  \"CreatedDateDifference\" > 30 and \"CreatedDateDifference\" < 61 \r\n    then '31-60 Days' \r\n   when  \"CreatedDateDifference\" > 60 and \"CreatedDateDifference\" < 91 \r\n    then '61-90 Days' \r\n  when \"CreatedDateDifference\" > 90 and \"CreatedDateDifference\" < 181 \r\n    then '91-180 Days' \r\n    when  \"CreatedDateDifference\" > 180  \r\n    then 'More than 180 days'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
