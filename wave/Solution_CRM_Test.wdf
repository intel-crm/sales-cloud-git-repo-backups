\"defaultValue\":\"\",\"precision\":255,\"name\":\"Solution_Name\",\"label\":\"Solution Name\",\"type\":\"TEXT\"}]}},\"FORMULA14\":{\"sources\":[\"JOIN9\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n    when \\\"Aggregate2.MAX_VBSAIlen\\\" = 6 then 'VBS/AI'\\r\\n    when \\\"Aggregate2.MAX_VBSAIlen\\\" = 3 then 'VBS'\\r\\n    when \\\"Aggregate2.MAX_VBSAIlen\\\" = 2 then 'AI'\\r\\n    else 'Other'\\r\\nend\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"VBS_AI\",\"label\":\"Opp VBS/AI\",\"type\":\"TEXT\"}]}},\"FORMULA8\":{\"sources\":[\"FORMULA7\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case when \\\"Opp_VBS.Core_VBS_Status__c\\\" in ('Pending', 'SOAR 1 Qualified', 'Approved') then 'VBS' else null end\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"isVBS\",\"label\":\"Is VBS\",\"type\":\"TEXT\"}]}},\"FORMULA15\":{\"sources\":[\"FORMULA14\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n    when  StageName in ('Lost','Cancelled')\\r\\n    then 'Gray'\\r\\n    when \\\"Aggregate0.MIN_risk_num_to_measure\\\" = 1 then 'Red'\\r\\n    when \\\"Aggregate0.MIN_risk_num_to_measure\\\" = 2 \\r\\n    then 'Orange' \\r\\n    when \\\"Aggregate0.MIN_risk_num_to_measure\\\" = 3 \\r\\n    then 'Yellow'\\r\\n    else 'Green' \\r\\nend \",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Status_RYOG\",\"label\":\"Status\",\"type\":\"TEXT\"}]}},\"FORMULA9\":{\"sources\":[\"FORMULA8\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n    when (((\\r\\n        (contains(\\\"Opportunit.Name\\\", 'Gaudi') or contains(\\\"Opportunit.Name\\\", 'GPU Flex') or contains(\\\"Opportunit.Name\\\", 'Developer Cloud')) and \\\"Opp_VBS.Core_has_Solution__c\\\" = 'true'\\r\\n        )\\r\\n        or ((contains(\\\"Opportunit.Name\\\", 'Xeon') or contains(\\\"Opportunit.Name\\\", 'Arc') or contains(\\\"Opportunit.Name\\\", 'Core') or contains(\\\"Opportunit.Name\\\", 'OpenVino') or contains(\\\"Opportunit.Name\\\", 'oneAPI'))\\r\\n        and (contains(Application_Workload, 'AI Inference') or contains(Application_Workload, 'AI Training') or contains(Application_Workload, 'AI on Xeon') or contains(\\\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.CORE_TECHNOLOGY_ENABLED_C_SPLIT_NM\\\", 'oneAPI') or contains(\\\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.CORE_TECHNOLOGY_ENABLED_C_SPLIT_NM\\\", 'OpenVino')))\\r\\n        )\\r\\n        or (contains(\\\"Opportunit.Name\\\", 'Core') and contains(\\\"Opportunit.Name\\\", 'Ultra') and startsWith(Solution_Name, 'AI PC'))\\r\\n        )\\r\\n then 'AI' else null end\\r\\n\\r\\n\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"isAI\",\"label\":\"Is AI\",\"type\":\"TEXT\"}]}},\"FORMULA16\":{\"sources\":[\"FORMULA15\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"substr(\\\"Opp_VBS.Core_Status_Update__c\\\",1,150)\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Status_shortened\",\"label\":\"Status Shortened\",\"type\":\"TEXT\"}]}},\"FORMULA17\":{\"sources\":[\"FORMULA16\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case when \\\"OpportunityProducts.Core_Risk_Priority__c\\\" is null then '-' else \\\"OpportunityProducts.Core_Risk_Priority__c\\\"\\r\\nend\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"riskpriority\",\"label\":\"Risk Priority\",\"type\":\"TEXT\"}]}},\"FORMULA18\":{\"sources\":[\"FORMULA17\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case when \\\"LineItem.Core_Risk_Reason1__c\\\" is null then '-' else \\\"LineItem.Core_Risk_Re