r_Selector.selection,[\"yearquarter_value\"]).asObject()}}' in {{coalesce(column(year_quarter_list_1.selection, [\"quarter\"]), 'all').asString()}};\nq = filter q by 'Opportunity.Name' in {{coalesce(column(Opportunity_Name_1.selection, [\"Opportunity.Name\"]), 'all').asString()}};\nq = filter q by 'Core_Product_Segment__c' in {{coalesce(column(Core_Product_Segment_1.selection, [\"Core_Product_Segment__c\"]), 'all').asString()}};\nq = filter q by 'Opportunity.Account.Name' in {{coalesce(column(Opportunity_Account__1.selection, [\"Opportunity.Account.Name\"]), 'all').asString()}};\nq = filter q by 'StageSorted' in {{coalesce(column(StageSorted_1.selection, [\"StageSorted\"]), 'all').asString()}};\nq = filter q by 'Opportunity.Core_Sales_Groups__c' in {{coalesce(column(Opportunity_Core_Sal_1.selection, [\"Opportunity.Core_Sales_Groups__c\"]), 'all').asString()}};\n \nq = filter q by 'Core_Status__c' in [\"Pending\", \"On Hold\", \"Win Submitted\"];\nq = filter q by 'Core_At_Risk__c' == \"true\";\nq = foreach q generate '{{cell(Calendar_Selector.selection, 0, \"yearquarter_value\").asObject()}}' as '{{cell(Calendar_Selector.selection, 0, \"yearquarter_value\").asObject()}}',\n'Core_Product_Segment__c',\n'Core_At_Risk__c',\ncase when 'Core_Status__c' in [\"Pending\", \"On Hold\", \"Win Submitted\"] then \"Open\" end as 'Status_OppO',\ncase when 'Opportunity.StageName' in [\"Design Win\", \"Production Win\", \"Production Lost\", \"Production Cancelled\", \"Lost\", \"Cancelled\"] then \"Won\" end as 'Status_OppW',\n'Core_KPI_Total_Price__c';\n\nq = filter q by 'Core_Product_Segment__c' is not null;\nq = filter q by 'Status_OppO' in {{coalesce(column(lens_2_9.selection, [\"Status_OppO\"]),'all').asString()}};\nq = filter q by 'Status_OppW' in {{coalesce(column(lens_2_13.selection, [\"Status_OppW\"]),'all').asString()}}; \n\nq = group q by ('{{cell(Calendar_Selector.selection, 0, \"yearquarter_value\").asObject()}}', 'Core_Product_Segment__c', 'Core_At_Risk__c');\nq = foreac