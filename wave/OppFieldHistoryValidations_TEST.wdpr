        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "IsPush",
          "label" : "Is Push",
          "formulaExpression" : "case \r\n    when first_value(oldyear_quarter) < first_value(newyear_quarter)\r\n    then 'Push' \r\n    else null \r\nend",
