    "FORMULA19" : {
      "action" : "formula",
      "sources" : [ "JOIN17" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "old_close_date",
          "label" : "Old Close Date",
          "formulaExpression" : "to_timestamp(\"MaxChange.OldValue\")",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA21" : {
      "action" : "formula",
      "sources" : [ "FORMULA19" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "new_close_date",
          "label" : "New Close Date",
          "formulaExpression" : "to_timestamp(\"MaxChange.NewValue\")",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA22" : {
      "action" : "formula",
      "sources" : [ "FORMULA21" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "num_days_pushed",
          "label" : "Number of Days Changed",
          "formulaExpression" : "datediff(new_close_date, old_close_date)",
          "precision" : 18,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA23" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA22" ],
      "parameters" : {
        "partitionBy" : [ "OpportunityId" ],
        "orderBy" : [ {
          "fieldName" : "MaxChange.CreatedDate",
          "direction" : "DESC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Latest_CloseDate_Change",
          "label" : "Latest CloseDate Change",
          "formulaExpression" : "first_value(num_days_pushed)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
