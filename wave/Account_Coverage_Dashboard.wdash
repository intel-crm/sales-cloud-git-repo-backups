MBER_NM' as 'Name', 'TEAM_MEMBER_ID'as 'WWID',Role_nm;\nq = order q by ('Name' asc, 'WWID' asc);\n\n\nq = group q by ('Name','WWID');\nq = foreach q generate 'Name','WWID';\nq = order q by ('Name' asc, 'WWID' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"static_1":{"broadcastFacet":true,"columns":{"Display":{"type":"string"}},"label":"Calendar_Selector","selectMode":"singlerequired","start":"{\"display\":[\"Calendar\"]}","type":"staticflex","values":["{\"display\":\"Calendar\",\"year_value\":\"Core_AccountCreate_Year\",\"yearmonth_value\":\"CreatedDate_Month\",\"month_value\":\"CreatedDate_Month\",\"yearquarter_value\":\"CreatedDate_Quarter\"}"]},"Account_RecordTypeId_10":{"broadcastFacet":false,"groups":[],"label":"Account_RecordTypeId_9","numbers":[],"query":"q = load \"AccountCoverage\";\nq = group q by 'Name';\nq = foreach q generate 'Name' as 'Name', count() as 'count';\nq = order q by 'Name' asc;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_7":{"broadcastFacet":false,"groups":[],"label":"lens_7","numbers":[],"query":"q = load \"AccountCoverage\";\n\nq = filter q by '{{column(filter_account.selection,[\"sales_manager_manager\"]).asObject()}}' in {{coalesce(column(Role_nm_1.selection, [\"WWID\"]),'all').asString()}};  \nq = filter q by  '{{column(filter_account.selection,[\"rep_hierarchy\"]).asObject()}}'  in {{coalesce(column(User_Employee_Core_M_1.selection, [\"Name\"]),'all').asString()}};\n\nq = filter q by '{{column(static_1.selection,[\"year_value\"]).asObject()}}' in {{coalesce(column(SecurityRegister_Cor_2.selection, [\"select_year\"]),'all').asString()}}; \nq = filter q by 'Owner_NM' in {{coalesce(column(Account_Core_Account_1.selection,  [\"Full Name\"]),'all').asString()}};\n\nq = filter q by !('Name' like \"%uncovered%\" || 'Name' like \"%Uncovered%\" || 'Name' like \"%UNCOVERED%\" || \n                  'Name' like \"%a&e%\" || 'Name' like \"%A&E%\" || \n                  'Name' like \"%consolidation%\" || 'Name' like \"%Consolidation%\" || 'Name' like \"%CONSOLIDATION%\");\n\nq = filter q by !('Account.Department' like \"%psg%\" || 'Account.Department' like \"%PSG%\" || 'Account.Department' like \"%Psg%\");\n\n-- Get unique accounts with their data\nq = group q by ('account_lvl', 'Core_Account_Sales_Grouping', 'Id', 'Owner_NM');\nq = foreach q generate \n    q.'account_lvl' as 'account_lvl',\n    q.'Core_Account_Sales_Grouping' as 'Core_Account_Sales_Grouping',\n    q.'Id' as 'Account_Id',\n    q.'Owner_NM' as 'Owner',\n    sum('Opportunity.Amount') as 'Account_Oppty_Amount';\n\n-- Calculate accounts per seller\nq = group q by ('account_lvl', 'Core_Account_Sales_Grouping', 'Owner');\nq = foreach q generate \n    q.'account_lvl' as 'account_lvl',\n    q.'Core_Account_Sales_Grouping' as 'Core_Account_Sales_Grouping',\n    q.'Owner' as 'Owner',\n    count(q) as 'accounts_per_seller',\n    sum('Account_Oppty_Amount') as 'seller_oppty_amount';\n\nq = group q by ('account_lvl', 'Core_Account_Sales_Grouping');\nq = foreach q generate \n    q.'account_lvl' as 'account_lvl',\n    q.'Core_Account_Sales_Grouping' as 'Core_Account_Sales_Grouping',\n    median('accounts_per_seller') as 'median_accounts',\n    sum('accounts_per_seller') as 'total_accounts',\n    sum('seller_oppty_amount') as 'total_oppty_amount',\n    count(q) as 'total_sellers',\n    round(sum('accounts_per_seller') / count(q), 1) as 'avg_accounts';\n\n--Final output\nq = foreach q generate \n    'account_lvl' as 'Account Level',\n    'Core_Account_Sales_Grouping' as 'Region Name',\n    'total_accounts' as 'Number of Accounts',\n    'total_oppty_amount' as 'Open Opptys Revenue',\n    'total_sellers' as 'Number of Sellers',\n    'avg_accounts' as 'Average Accounts/Sellers',\n    round('median_accounts', 1) as 'Median Accounts/Sellers';\n\nq = order q by ('Account Level' asc, 'Region Name' asc);\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":10,"textWrap":false},"collapsible":false,"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":10,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfFrozenColumns":0,"numberOfLines":1,"pivoted":false,"showActionMenu":false,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"lens_8":{"broadcastFacet":false,"groups":[],"label":"lens_8","numbers":[],"query":"q = load \"AccountCoverage\";\n\nq = filter q by '{{column(filter_account.selection,[\"sales_manager_manager\"]).asObject()}}' in {{coalesce(column(Role_nm_1.selection, [\"WWID\"]),'all').asString()}};  \nq = filter q by  '{{column(filter_account.selection,[\"rep_hierarchy\"]).asObject()}}'  in {{coalesce(column(User_Employee_Core_M_1.selection, [\"Name\"]),'all').asString()}};\n\nq = filter q by '{{column(static_1.selection,[\"year_value\"]).asObject()}}' in {{coalesce(column(SecurityRegister_Cor_2.selection, [\"select_year\"]),'all').asString()}}; \nq = filter q by 'Owner_NM' in {{coalesce(column(Account_Core_Account_1.selection,  [\"Full Name\"]),'all').asString()}};\n\nq = filter q by !('Name' like \"%uncovered%\" || 'Name' like \"%Uncovered%\" || 'Name' like \"%UNCOVERED%\" || \n                  'Name' like \"%a&e%\" || 'Name' like \"%A&E%\" || \n                  'Name' like \"%consolidation%\" || 'Name' like \"%Consolidation%\" || 'Name' like \"%CONSOLIDATION%\");\n\nq = filter q by !('Account.Department' like \"%psg%\" || 'Account.Department' like \"%PSG%\" || 'Account.Department' like \"%Psg%\");\n\n-- First ensure unique accounts per seller per region per level\nq = group q by ('Core_Account_Sales_Grouping', 'level_nm', 'OwnerId', 'Id');\nq = foreach q generate \n    q.'level_nm' as 'level_nm', \n    q.'Core_Account_Sales_Grouping' as 'Core_Account_Sales_Grouping',\n    q.'OwnerId' as 'OwnerId',\n    'Id';\n\n--Count accounts per seller by region and level\nq = group q by ('Core_Account_Sales_Grouping', 'level_nm', 'OwnerId');\nq = foreach q generate \n    q.'level_nm' as 'level_nm', \n    q.'Core_Account_Sales_Grouping' as 'Core_Account_Sales_Grouping',\n    q.'OwnerId' as 'OwnerId',\n    count(q) as 'accounts_per_seller';\n\n-- Calculate totals and averages by region and level\nq = group q by ('Core_Account_Sales_Grouping', 'level_nm');\nq = foreach q generate \n    q.'level_nm' as 'level_nm', \n    q.'Core_Account_Sales_Grouping' as 'Core_Account_Sales_Grouping',\n    count(q) as 'total_sellers',\n    sum('accounts_per_seller') as 'total_accounts',\n    round(sum('accounts_per_seller') / count(q), 1) as 'avg_accounts_per_seller';\n\n-- Final output format\nq = foreach q generate \n    case \n        when 'level_nm' == \"Level1\" then \"LEVEL 1 ACCOUNTS\"\n        when 'level_nm' == \"Level2\" then \"LEVEL 2 ACCOUNTS\" \n        when 'level_nm' == \"Level3\" then \"LEVEL 3 ACCOUNTS\"\n        when 'level_nm' == \"NoLevel\" then \"NO LEVEL ACCOUNTS\"\n        when 'level_nm' == \"Blank\" then \"BLANK\"\n        when 'level_nm' == \"Total\" then \"TOTAL\"\n        else 'level_nm'\n    end as 'level_nm', \n    'Core_Account_Sales_Grouping', \n    'total_accounts' as 'Number of Accounts',\n    'avg_accounts_per_seller' as 'AVG Account per Seller';\n\nq = order q by ('level_nm' asc, 'Core_Account_Sales_Grouping' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"none","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"top-center","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":["Number of Accounts","AVG Account per Seller"],"showNullValues":true,"customizeLegend":true,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":["Core_Account_Sales_Grouping"]}}},"visualizationType":"vbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":true,"type":"y","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":false,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_5":{"broadcastFacet":false,"groups":[],"label":"lens_5","numbers":[],"query":"q = load \"AccountCoverage\";\n\nq = filter q by '{{column(filter_account.selection,[\"sales_manager_manager\"]).asObject()}}' in {{coalesce(column(Role_nm_1.selection, [\"WWID\"]),'all').asString()}};   \nq = filter q by  '{{column(filter_account.selection,[\"rep_hierarchy\"]).asObject()}}'  in {{coalesce(column(User_Employee_Core_M_1.selection, [\"Name\"]),'all').asString()}};\n\nq = filter q by '{{column(static_1.selection,[\"year_value\"]).asObject()}}' in {{coalesce(column(SecurityRegister_Cor_2.selection, [\"select_year\"]),'all').asString()}}; \nq = filter q by 'Owner_NM' in {{coalesce(column(Account_Core_Account_1.selection,  [\"Full Name\"]),'all').asString()}};\n\nq = filter q by !('Name' like \"%uncovered%\" || 'Name' like \"%Uncovered%\" || 'Name' like \"%UNCOVERED%\" || \n                  'Name' like \"%a&e%\" || 'Name' like \"%A&E%\" || \n                  'Name' like \"%consolidation%\" || 'Name' like \"%Consolidation%\" || 'Name' like \"%CONSOLIDATION%\");\n\nq = filter q by !('Account.Department' like \"%psg%\" || 'Account.Department' like \"%PSG%\" || 'Account.Department' like \"%Psg%\");\n\nq = group q by ('Core_Account_Sales_Grouping', 'account_lvl', 'Id');\nq = foreach q generate q.'Core_Account_Sales_Grouping' as 'Core_Account_Sales_Grouping', \n                     q.'account_lvl' as 'account_lvl', \n                     'Id';\n\n-- Ahora cuenta las cuentas únicas por región y account level\nq = group q by ('Core_Account_Sales_Grouping', 'account_lvl');\nq = foreach q generate q.'Core_Account_Sales_Grouping' as 'Core_Account_Sales_Grouping', \n                     q.'account_lvl' as 'account_lvl', \n                     count(q) as 'TotalAccount';\n\nq = order q by ('Core_Account_Sales_Group