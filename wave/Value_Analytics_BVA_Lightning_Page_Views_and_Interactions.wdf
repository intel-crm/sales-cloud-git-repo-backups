) then 'Lightning Homepage'\\r\\n\\twhen contains(PAGE_URL,'/lightning/n/') then substr(PAGE_URL,instr(PAGE_URL,'/' ,1,3)+1)\\r\\n\\twhen contains(PAGE_URL,'/lightning/o/') then substr(PAGE_URL,instr(PAGE_URL,'/' ,1,3)+1,instr(PAGE_URL,'/' ,1,4)-instr(PAGE_URL,'/' ,1,3)-1) \\r\\n\\telse PAGE_ENTITY_TYPE \\r\\nend\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"PageName\",\"label\":\"PageName\",\"type\":\"TEXT\"}]}},\"FORMULA1\":{\"sources\":[\"FORMULA0\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"concat(USER_ID_DERIVED, SESSION_KEY)\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"UserSessionKey\",\"label\":\"UserSessionKey\",\"type\":\"TEXT\"}]}},\"FORMULA2\":{\"sources\":[\"FORMULA1\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\nwhen contains(PAGE_URL,'?ws=%') then substr(PAGE_URL,instr(PAGE_URL,'%2F',1,3)+3,instr(PAGE_URL,'%2F',1,4) - (instr(PAGE_URL,'%2F',1,3)+3))\\r\\nelse PAGE_ENTITY_TYPE\\r\\nend\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"SourceObjectType\",\"label\":\"SourceObjectType\",\"type\":\"TEXT\"}]}},\"FORMULA3\":{\"sources\":[\"FORMULA2\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\nwhen contains(PAGE_URL,'?ws=%') then substr(PAGE_URL,instr(PAGE_URL,'%2F',1,4)+3,18) else null end\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"SourceRecordId\",\"label\":\"SourceRecordId\",\"type\":\"TEXT\"}]}},\"FORMULA4\":{\"sources\":[\"FORMULA3\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"to_timestamp(from_unixtime(substr(UI_EVENT_TIMESTAMP/1000,0,13),'yyyy-MM-dd HH:mm:ss'),'yyyy-MM-dd HH:mm:ss')\",\"defaultValue\":\"\",\"name\":\"InteractionDateTime\",\"format\":\"yyyy-MM-dd HH:mm:ss\",\"label\":\"InteractionDateTime\",\"type\":\"DATETIME\"}]}},\"FORMULA5\":{\"sources\":[\"FORMULA4