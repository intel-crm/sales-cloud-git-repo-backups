ge views and Apex executions.\",\"label\":\"FilterUserClicks\",\"type\":\"FILTER\"},\"JOIN1\":{\"top\":112,\"left\":1512,\"description\":\"\",\"label\":\"JoinInteractionsAndUsers\",\"type\":\"JOIN\"},\"JOIN0\":{\"top\":112,\"left\":812,\"description\":\"Joins the LightningInteractionDataDictionary custom object entries to the event logs so as to label them better.\",\"label\":\"JoinDataDictionary\",\"type\":\"JOIN\"},\"OUTPUT0\":{\"top\":112,\"left\":1652,\"description\":\"\",\"label\":\"RegisterUnionLogs\",\"type\":\"OUTPUT\"},\"LOAD_DATASET3\":{\"top\":251.89999999999998,\"left\":112.1,\"label\":\"LightningPageView\",\"type\":\"LOAD_DATASET\",\"parameters\":{\"sampleSize\":2000}},\"LOAD_DATASET2\":{\"top\":252,\"left\":1512,\"label\":\"BVA_UsersProfilesRoles\",\"type\":\"LOAD_DATASET\",\"parameters\":{\"sampleSize\":2000}},\"LOAD_DATASET1\":{\"top\":252,\"left\":672,\"label\":\"Lightning Interaction Data Dictionary\",\"type\":\"LOAD_DATASET\",\"parameters\":{\"sampleSize\":2000}},\"LOAD_DATASET0\":{\"top\":112,\"left\":112,\"label\":\"LightningInteraction\",\"type\":\"LOAD_DATASET\",\"parameters\":{\"sampleSize\":2000}},\"APPEND0\":{\"top\":112,\"left\":1372,\"description\":\"Bring all the Lightning Interactions back together.\",\"label\":\"JoinClicksAndNonClicks\",\"type\":\"APPEND\"},\"APPEND1\":{\"top\":112,\"left\":252,\"description\":\"Joining the LightningPageView and LightningInteraction log types together.  This is easy, most columns will auto-match.\",\"label\":\"AppendPageViewsAndClicks\",\"type\":\"APPEND\"},\"TRANSFORM0\":{\"connectors\":[{\"source\":\"FORMULA0\",\"target\":\"FORMULA1\"},{\"source\":\"FORMULA1\",\"target\":\"FORMULA2\"},{\"source\":\"FORMULA2\",\"target\":\"FORMULA3\"},{\"source\":\"FORMULA3\",\"target\":\"FORMULA4\"},{\"source\":\"FORMULA4\",\"target\":\"FORMULA5\"}],\"top\":112,\"left\":672,\"description\":\"A series of transformatinos to the LightningInteraction event logs.  Some columns are used directly in the dashboards; some are