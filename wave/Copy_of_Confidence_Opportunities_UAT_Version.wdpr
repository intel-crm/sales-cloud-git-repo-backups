roup.Security.UserOrGroupId", "Opportunity.Security.Id", "Opportunity.Account.TerritoryAndParentTerritoryUsers.FlatTerritoryParent.UserTerritory.UserId", "Opportunity.TeamMembers.User.Manager.Name", "Opportunity.Account.Name", "opportunityDecisionDateQuarter", "Opportunity.AccountTeamMember.Security.Role.Roles", "Push", "Opportunity.Core_At_Risk_Created_Date__c", "Opportunity.Core_Pushes__c", "Opportunity.OpportunityPartner.Name", "Opportunity.Core_Named_Strategic__c", "Opportunity.TeamMembers.User.Manager.Manager.Name", "Opportunity.StageName", "Opportunity.Security.Role.Roles", "Opportunity.TeamMembersNoOwners.User.Manager.Manager.Name", "GroupMemberRoles.Role.Roles", "Opportunity.Account.ParentTerritoryRoles.Role.Roles", "Opportunity.Amount", "Opportunity.Core_Wins_Oppty__c", "Opportunity.Core_Push_Counter__c", "Opportunity.Core_Days_from_Opportunity_Create_to_Su__c", "Core_KPI_Total_Price__c" ],
