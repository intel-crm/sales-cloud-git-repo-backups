ression\":\"case when 'Core_Opp_KPI_Type__c' ==\\\"Salesforce Opp KPI Product Group Count\\\" and 'kpi_is_won' == \\\"true\\\" then 'Core_KPI_Opportunity__c'+\\\"-\\\"+'o.Core_Approved_KPI_Product_Group__c' else null end\",\"type\":\"Text\"},{\"label\":\"kpi_full_date_year_quarter\",\"name\":\"kpi_full_date_year_quarter\",\"saqlExpression\":\"'kpi_full_date_Year'+ \\\"0\\\"+ 'kpi_full_date_Quarter'\",\"type\":\"Text\"}],\"mergeWithSource\":true},\"sources\":[\"KPI Criteria by TypeAZ\"]},\"VBS_OpportunityProducts\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"Id\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"vbs\",\"rightKey\":[\"CRM_VBS_SOAR_Opportunity__c\"],\"rightSelect\":[\"CRM_VBS_SOAR_Opportunity__c\",\"CRM_VBS_Primary_VBS_Offering_Category__c\"]},\"sources\":[\"KPIStrategicOpp\",\"VBS_Opportunity\"]}}}",null]