_KPI_Type__c' in [\\\"Salesforce Production Win $\\\", \\\"Salesforce Production Win Opp Count\\\"] && 'o.Core_Status__c' in [\\\"Production Win\\\"] then toDate('o.Core_Production_Claim_Date__c',\\\"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\\\") when 'Core_Opp_KPI_Type__c' in [\\\"Salesforce Production Win $\\\", \\\"Salesforce Production Win Opp Count\\\"]  && 'o.Core_Status__c' in [\\\"Win Approved\\\", \\\"Win Submitted\\\", \\\"On Hold\\\", \\\"Pending\\\"] then toDate('o.Opportunity.Core_First_Customer_Ship_Date__c',\\\"yyyy-MM-dd\\\") else toDate('o.Core_KPI_Date__c',\\\"yyyy-MM-dd\\\") end\",\"type\":\"Date\"},{\"label\":\"KPI is pending\",\"name\":\"kpi_is_pending\",\"saqlExpression\":\"case when 'Core_Opp_KPI_Type__c' in [\\\"Salesforce Pipeline $\\\",\\\"Salesforce Pipeline Opp Count\\\",\\\"Salesforce Opp KPI Product Group Count\\\",\\\"Salesforce Pipeline Units\\\"] && 'o.Core_Status__c' in [\\\"Win Submitted\\\", \\\"Pending\\\", \\\"On Hold\\\"] then \\\"true\\\" when 'Core_Opp_KPI_Type__c' in [\\\"Salesforce Production Win $\\\",\\\"Salesforce Production Win Opp Count\\\"] && 'o.Core_Status__c' in [\\\"Win Approved\\\", \\\"Win Submitted\\\", \\\"On Hold\\\", \\\"Pending\\\"] then \\\"true\\\" else \\\"false\\\" end\",\"type\":\"Text\"},{\"defaultValue\":\"0\",\"label\":\"kpi won qty Nbr\",\"name\":\"kpi_won_qty_nbr\",\"precision\":15,\"saqlExpression\":\"case when 'Core_Opp_KPI_Type__c' in [\\\"Salesforce Pipeline $\\\",\\\"Salesforce Pipeline Opp Count\\\",\\\"Salesforce Pipeline Units\\\"] && 'o.Core_Status__c' in [\\\"Win Approved\\\", \\\"Production Win\\\", \\\"Production Cancelled\\\", \\\"Production Lost\\\",\\\"Production Win Approved\\\",\\\"Production Win Submitted\\\"] then 'o.Core_KPI_Quantity__c' when 'Core_Opp_KPI_Type__c' in [\\\"Salesforce Production Win $\\\",\\\"Salesforce Production Win Opp Count\\\"] && 'o.Core_Status__c' in [\\\"Production Win\\\",\\\"Production Win Approved\\\",\\\"Production Win Submitted\\\"] then  'o.Core_Approved_Quantity__c' else 0 end\",\"scale\":8,\"type\":\"Numeric\"},{\"defaultValue\":\"0\",\"label\":\"kpi pending qty nbr\",\"name\":\"kpi_pending_qty_nbr\",\"precision\":15,\"saqlExpression\":\"case when 'Core_Opp_KPI_Type__c' in [\\\"Salesforce Pipeline $\\\",\\\"Salesforce Pipeline Opp Count\\\",\\\"Salesforce Pipeline Units\\\"] && 'o.Core_Status__c' in [\\\"Win Submitted\\\", \\\"Pending\\\", \\\"On Hold\\\"] then 'o.Core_KPI_Quantity__c' when 'Core_Opp_KPI_Type__c' in [\\\"Salesforce Production Win $\\\",\\\"Salesforce Production Win Opp Count\\\"] && 'o.Core_Status__c' in [\\\"Win Approved\\\", \\\"Win Submitted\\\", \\\"On Hold\\\", \\\"Pending\\\"] then 'o.Core_Approved_Quantity__c' else 0 end\",\"scale\":8,\"type\":\"Numeric\"},{\"label\":\"KPI Name\",\"name\":\"kpi_name\",\"saqlExpression\":\"'Name'\",\"type\":\"Text\"},{\"label\":\"Product Id\",\"name\":\"product_id\",\"saqlExpression\":\"'Core_Opp_KPI_Product__c'\",\"type\":\"Text\"},{\"label\":\"KPI Achieved?\",\"name\":\"kpi_achieved\",\"saqlExpression\":\"'Core_KPI_Achieved__c'\",\"type\":\"Text\"},{\"label\":\"Opportunity Line Item Name\",\"name\":\"opportunity_line_item_name\",\"saqlExpression\":\"'Core_KPI_Opportunity_Product_Name__c'\",\"type\":\"Text\"},{\"label\":\"KPI BU Owner\",\"name\":\"kpi_bu_owner\",\"saqlExpression\":\"'Core_KPI_BU_Owner__c'\",\"type\":\"Text\"},{\"label\":\"KPI Description\",\"name\":\"kpi_description\",\"saqlExpression\":\"'Core_KPI_Description__c'\",\"type\":\"Text\"},{\"label\":\"Opportunity ID\",\"name\":\"opportunity_id\",\"saqlExpression\":\"'Core_KPI_Opportunity__c'\",\"type\":\"Text\"},{\"label\":\"KPI Opportunity Volume\",\"name\":\"kpi_opportunity_volume\",\"precision\":15,\"saqlExpression\":\"'Core_KPI_Volume__c'\",\"scale\":4,\"type\":\"Numeric\"},{\"defaultValue\":\"0\",\"label\":\"KPI Total Price\",\"name\":\"kpi_total_price\",\"precision\":15,\"saqlExpression\":\"'Core_KPI_Total_Price__c'\",\"scale\":4,\"type\":\"Numeric\"},{\"label\":\"Opportunity Line Item ID\",\"n