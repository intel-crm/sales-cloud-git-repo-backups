{"dataSourceLinksInfo":{"enableAutomaticLinking":true,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"name":"Default","numColumns":12,"pages":[{"label":"Untitled","name":"20a68ca8-e601-44de-8e34-1501c4c12038","navigationHidden":false,"widgets":[{"colspan":10,"column":0,"name":"chart_1","row":1,"rowspan":13,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"normal","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":8,"cellSpacingY":8,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"lens_1":{"broadcastFacet":true,"groups":[],"label":"lens_1","numbers":[],"query":"q = load \"LightningPageViewWithUsers\";\nq = filter q by 'PAGE_ENTITY_TYPE' in [\"Account_Plan__c\", \"Account_Plans1__r\", \"Account_Status__c\", \"Account_Status__r\", \"Executive_Meeting_Brief__c\", \"Executive_Meeting_Briefs__r\"];\nq = group q by ('PAGE_ENTITY_TYPE', 'TIMESTAMP_DERIVED_Year', 'TIMESTAMP_DERIVED_Month');\nq = foreach q generate \ncase when q.'PAGE_ENTITY_TYPE' like \"%Account_Plan%\" then \"Account Plans\" \nwhen q.'PAGE_ENTITY_TYPE' like \"%Account_Status%\" then \"Account Status\" \nwhen q.'PAGE_ENTITY_TYPE' like \"%Executive_Meeting%\" then \"Executive Meeting Briefs\" \nelse q.'PAGE_ENTITY_TYPE'\nend as 'PAGE_ENTITY_TYPE'\n\n, q.'TIMESTAMP_DERIVED_Year' as 'TIMESTAMP_DERIVED_Year', q.'TIMESTAMP_DERIVED_Month' as 'TIMESTAMP_DERIVED_Month', count(q) as 'Total Count', unique(q.'USER_ID') as 'Unique Users';\nq = order q by ('PAGE_ENTITY_TYPE' asc, 'TIMESTAMP_DERIVED_Year' asc, 'TIMESTAMP_DERIVED_Month' asc);\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","showPoints":false,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","