    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "LOAD_DATASET12" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Dashboard_Name",
          "label" : "Dashboard Name",
          "formulaExpression" : "case \r\n    when contains(\"TAB_ID\",'0FK3b000000XoM9GAK') then 'Pipeline Management Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b000000kATVGA2') then 'OBSM'\r\n    when contains(\"TAB_ID\",'0FK3b000000PKkOGAW') then 'Executive SMG Pipeline Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b000000kATaGAM') then 'Solution CRM'\r\n    when contains(\"TAB_ID\",'0FK3b000000kAPOGA2') then 'Tech Resources Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b000000XomWGAS') then 'Pipeline Analysis Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b000000CjT1GAK') then 'Product Analysis Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b000000CjQMGA0') then 'Sales Manager Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b000000CjQHGA0') then 'Seller Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b000000kAPTGA2') then 'VoC Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b000000kAPJGA2') then 'Account Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b00000003xjGAA') then 'Opportunity Analysis Dashboard'\r\n    when contains(\"TAB_ID\",'0FKHo0000009P6AOAU') then 'Lighthouse and Strategic Opportunities'\r\n    when contains(\"TAB_ID\",'0FKHo0000009Pq1OAE') then 'VBS Pipeline Revenue Forecast'\r\n    when contains(\"TAB_ID\",'0FKHo0000009PprOAE') then 'VBS Annual Recurring Revenue'\r\n    when contains(\"TAB_ID\",'0FKHo0000009PpZOAU') then 'VBS Management Dashboard'\r\n    when contains(\"TAB_ID\",'0FK3b000000bo1HGAQ') then '1H24 Bonus Tracking Dashboard'\r\n    when contains(\"TAB_ID\",'0FKHo0000009PpTOAU') then '2H24 Bonus Tracking Dashboard'\r\n    when contains(\"TAB_ID\",'0FKHo0000009Py0OAE') then 'Manager Metrics Dashboard'\r\nEND",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "PAGE_ENTITY_ID",
          "label" : "PAGE_ENTITY_ID",
          "formulaExpression" : "case \r\n    when contains(\"TAB_ID\",'0FK3b000000XoM9GAK') then '0FK3b000000XoM9GAK'\r\n    when contains(\"TAB_ID\",'0FK3b000000kATVGA2') then '0FK3b000000kATVGA2'\r\n    when contains(\"TAB_ID\",'0FK3b000000PKkOGAW') then '0FK3b000000PKkOGAW'\r\n    when contains(\"TAB_ID\",'0FK3b000000kATaGAM') then '0FK3b000000kATaGAM'\r\n    when contains(\"TAB_ID\",'0FK3b000000kAPOGA2') then '0FK3b000000kAPOGA2'\r\n    when contains(\"TAB_ID\",'0FK3b000000XomWGAS') then '0FK3b000000XomWGAS'\r\n    when contains(\"TAB_ID\",'0FK3b000000CjT1GAK') then '0FK3b000000CjT1GAK'\r\n    when contains(\"TAB_ID\",'0FK3b000000CjQMGA0') then '0FK3b000000CjQMGA0'\r\n    when contains(\"TAB_ID\",'0FK3b000000CjQHGA0') then '0FK3b000000CjQHGA0'\r\n    when contains(\"TAB_ID\",'0FK3b000000kAPTGA2') then '0FK3b000000kAPTGA2'\r\n    when contains(\"TAB_ID\",'0FK3b000000kAPJGA2') then '0FK3b000000kAPJGA2'\r\n    when contains(\"TAB_ID\",'0FK3b00000003xjGAA') then '0FK3b00000003xjGAA'\r\n    when contains(\"TAB_ID\",'0FKHo0000009P6AOAU') then '0FKHo0000009P6AOAU'\r\n    when contains(\"TAB_ID\",'0FKHo0000009Pq1OAE') then '0FKHo0000009Pq1OAE'\r\n    when contains(\"TAB_ID\",'0FKHo0000009PprOAE') then '0FKHo0000009PprOAE'\r\n    when contains(\"TAB_ID\",'0FKHo0000009PpZOAU') then '0FKHo0000009PpZOAU'\r\n    when contains(\"TAB_ID\",'0FK3b000000bo1HGAQ') then '0FK3b000000bo1HGAQ'\r\n    when contains(\"TAB_ID\",'0FKHo0000009PpTOAU') then '0FKHo0000009PpTOAU'\r\n    when contains(\"TAB_ID\",'0FKHo0000009Py0OAE') then '0FKHo0000009Py0OAE'\r\nEND",
          "precision" : 40,
          "defaultValue" : ""
        } ]
      }
    },
