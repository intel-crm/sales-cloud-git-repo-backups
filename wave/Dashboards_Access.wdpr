    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "LOAD_DATASET7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Dashboard_Name",
          "label" : "Dashboard Name",
          "formulaExpression" : "case \r\n    when contains(\"PAGE_URL\",'0FK3b000000XoM9GAK') then 'Pipeline Management Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b000000kATVGA2') then 'OBSM'\r\n    when contains(\"PAGE_URL\",'0FK3b000000PKkOGAW') then 'Executive SMG Pipeline Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b000000kATaGAM') then 'Solution CRM'\r\n    when contains(\"PAGE_URL\",'0FK3b000000kAPOGA2') then 'Tech Resources Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b000000XomWGAS') then 'Pipeline Analysis Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b000000CjT1GAK') then 'Product Analysis Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b000000CjQMGA0') then 'Sales Manager Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b000000CjQHGA0') then 'Seller Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b000000kAPTGA2') then 'VoC Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b000000kAPJGA2') then 'Account Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b00000003xjGAA') then 'Opportunity Analysis Dashboard'\r\n    when contains(\"PAGE_URL\",'0FKHo0000009P6AOAU') then 'Lighthouse and Strategic Opportunities'\r\n    when contains(\"PAGE_URL\",'0FKHo0000009Pq1OAE') then 'VBS Pipeline Revenue Forecast'\r\n    when contains(\"PAGE_URL\",'0FKHo0000009PprOAE') then 'VBS Annual Recurring Revenue'\r\n    when contains(\"PAGE_URL\",'0FKHo0000009PpZOAU') then 'VBS Management Dashboard'\r\n    when contains(\"PAGE_URL\",'0FK3b000000bo1HGAQ') then '1H24 Bonus Tracking Dashboard'\r\n    when contains(\"PAGE_URL\",'0FKHo0000009PpTOAU') then '2H24 Bonus Tracking Dashboard'\r\n    when contains(\"PAGE_URL\",'0FKHo0000009Py0OAE') then 'Manager Metrics Dashboard'\r\nEND",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
