"Core_BU_Product_Segment__c_8":{"broadcastFacet":false,"groups":[],"label":"KPIsMetricsChartStackedHorizontal","numbers":[],"query":"q = load \"KPIProductsOpportunity\"; q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_manager\"]).asObject()}}' in {{coalesce(column(Sales_Manager_Filter_8.selection, [\"Name\"]),'all').asString()}}; q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_rep\"]).asObject()}}' in {{coalesce(column(Sales_Rep_Filter_1.selection, [\"Name\"]),'all').asString()}}; \r\n\r\n\r\nresult = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type', 'kpi_achieved');\r\n\r\nresult = foreach result generate result.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', 'kpi_achieved', \r\nresult.'kpi_type' as 'kpi_type',\r\nsum(result.'o.pending_dw_amt') as 'pending_dw_amt', \r\nsum(result.'o.pending_core_kpi_qty') as 'pending_core_kpi_qty', \r\nsum(result.'o.won_core_kpi_qty') as 'won_core_kpi_qty', \r\nsum(result.'o.won_dw_amt') as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\nresult1 = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type', 'kpi_achieved');\r\n\r\nresult1 = foreach result1 generate result1.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', \r\nresult1.'kpi_type' as 'kpi_type', 'kpi_achieved', \r\n0 as 'pending_dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\nunique(result1.'o.pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt;\r\n\r\n\r\nresult2 = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type', 'kpi_achieved');\r\n\r\nresult2 = foreach result2 generate result2.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', 'kpi_achieved', \r\nresult2.'kpi_type' as 'kpi_type',\r\n0 as 'pending_dw_amt', \r\n0 as 'pending_core_kpi_qty', \r\n0 as 'won_core_kpi_qty', \r\n0 as 'won_dw_amt',\r\n0 as pending_opportunity_cnt,\r\nunique(result2.'o.win_opportunity_id') as win_opportunity_cnt;\r\n\r\n\r\nresult3 = union result1, result2, result;\r\nresult3 = group result3 by ('kpi_name', 'kpi_type', 'kpi_achieved');\r\nresult3 = foreach result3 generate result3.kpi_name as kpi_name, 'kpi_achieved', \r\nresult3.kpi_type as kpi_type,\r\nmax('pending_dw_amt') as 'pending_dw_amt', \r\nmax(result3.pending_core_kpi_qty) as pending_core_kpi_qty, \r\nmax(result3.won_core_kpi_qty) as won_core_kpi_qty, \r\nmax(result3.won_dw_amt) as won_dw_amt,\r\nmax(result3.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result3.win_opportunity_cnt) as win_opportunity_cnt;\r\n\r\n\r\n result4 = filter result3 by 'kpi_achieved' == \"true\"; result4 = foreach result4 generate result4.'kpi_name' as 'KPI Name/Account',\r\ncase result4.'kpi_type' when \"Salesforce Pipeline $\" then result4.won_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result4.won_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result4.win_opportunity_cnt\r\nelse 0 end as 'KPI',\r\n\"1 - Won KPI\" as 'kpi_type';\r\n\r\n\r\n  result5 = filter result3 by 'kpi_achieved' == \"false\"; result5 = foreach result5 generate result5.'kpi_name' as 'KPI Name/Account',\r\ncase result5.'kpi_type' when \"Salesforce Pipeline $\" then result5.pending_dw_amt\r\nwhen \"Salesforce Pipeline Units\" then result5.pending_core_kpi_qty\r\nwhen \"Salesforce Pipeline Opp Count\" then result5.pending_opportunity_cnt\r\nelse 0 end as 'KPI',\r\n\"2 - Pending KPI\" as 'kpi_type';\r\n\r\nresult6 = union result4, result5; result6 = order result6 by ({{coalesce(column(won_pending_kpi_togg_1.selection,[\"order_by\"]),\"KPI\").asObject()}} {{coalesce(column(won_pending_kpi_togg_1.select