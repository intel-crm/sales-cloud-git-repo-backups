ggle_weighted_unweighted), 'compact_query')) }}\",\"filters\":[[\"Core_Status__c\",[\"Win Approved\",\"Production Cancelled\",\"Production Lost\",\"Production Win\"],\"in\"],\"{{selection(Partner_Filter_1) }}\"]}","version":-1.0},"selectMode":"single","type":"aggregate","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"visualizationType":"hbar"}},"FiscalKPIChartFormat_1_KPIs":{"broadcastFacet":false,"groups":[],"label":"FiscalKPIChartFormatted","numbers":[],"query":"q = load \"KPIProductsOpportunity\";\r\n q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_manager\"]).asObject()}}' in {{coalesce(column(Sales_Manager_Filter_8.selection, [\"Name\"]),'all').asString()}}; q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_rep\"]).asObject()}}' in {{coalesce(column(Sales_Rep_Filter_1.selection, [\"Name\"]),'all').asString()}};\r\n q = group q by ('o.fiscal_kpi_date', 'o.stage_sorted');\r\nq = foreach q generate 'o.fiscal_kpi_date' as 'Quarter',  \r\n    'o.stage_sorted',\r\n case when \"opportunity_id\" in {{column(pipeline___1.selection, [\"value\"]).asString()}} then unique('opportunity_id') else sum('kpi_total_price') end as 'KPI' ;\r\nq = order q by ('Quarter' asc, 'o.stage_sorted' asc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"totalSumMode":"none","axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showG