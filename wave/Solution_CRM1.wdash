on_Prod_1.selection, [\"year\"]),'all').asString()}}; \nq = filter q by 'KPIQuarter' in {{coalesce(column(Parter_Solution_Prod_2.selection, [\"quarter\"]),'all').asString()}};\nq = filter q by 'OpportunityProducts.Opportunity.TeamMembers.User.Manager.Name'  in all; q = filter q by 'OpportunityProducts.Opportunity.TeamMembers.User.Name'  in all;\nq = filter q by 'OpportunityProducts.Opportunity.Core_Opp_Strategic_Opportunity__c' in all;\nq = group q by all;\nq = foreach q generate unique('Id') as 'unique_OpportunityId';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Prather_Chart__1":{"broadcastFacet":true,"groups":[],"label":"Prather_Chart ","numbers":[],"query":"q = load \"Solution_CRM1\";\nq = filter q by 'KPIDateYear' in {{coalesce(column(Parter_Solution_Prod_1.selection, [\"year\"]),'all').asString()}};\nq = filter q by 'KPIQuarter' in {{coalesce(column(Parter_Solution_Prod_2.selection, [\"quarter\"]),'all').asString()}};\n--q = filter q by 'Partner_Name'== \"VMware INC.\";\n\n--Get won\nq_won = filter q by 'Opportunit.Core_Status__c' in  [\"Win Approved\", \"Production Cancelled\", \"Production Lost\", \"Production Win\"] ;\n--q_won = filter q_won by 'op.Core_Status__c' not in  [\"Cancelled\"] ;\nq_won = group q_won by ('Partner_Name', Status_Name,'Id','Opportunit.Core_Status__c','Opportunit.Id');\nq_won = foreach q_won generate 'Id','Partner_Name' as 'Partner_Name', 'Status_Name',max('Opportunit.Core_KPI_Total_Price__c') as 'Amt';\nq_won = group q_won by ('Partner_Name', 'Status_Name');\nq_won = foreach q_won generate 'Partner_Name','Status_Name', sum('Amt') as 'Amt' ;\nq_won = order q_won by 'Amt'desc;\n\n\n--Get Lost\nq_lost = filter q by 'Opportunit.Core_Status__c' in  [\"Lost\",\"Cancelled\"] ;\nq_lost = group q_lost by ('Partner_Name', Status_Name,'Id','Opportunit.Core_Status__c','Opportunit.Id');\nq_lost = foreach q_lost generate 'Id','Partner_Name' as 'Partner_Name', \"Lost\" as 'Status_Name',max('BU.op.Core_Lost_Total_Price__c') as 'BU.op.Core_Lost_Total_Price__c';\nq_lost = group q_lost by ('Partner_Name', Status_Name,'Id');\nq_lost = foreach q_lost generate 'Id','Partner_Name' as 'Partner_Name', 'Status_Name',max('BU.op.Core_Lost_Total_Price__c') as 'Amt';\nq_lost = group q_lost by ('Partner_Name', 'Status_Name');\nq_lost = foreach q_lost generate 'Partner_Name','Status_Name' as 'Status_Name_lost', sum('Amt') as 'Amt_l',0 as 'Amt'  ;\nq_lost = order q_lost by 'Amt'desc;\n\n--Get Open\nq_open = filter q by 'Opportunit.Core_Status__c' in  [\"On Hold\",\"Pending\",\"Win Submitted\"] ;\n--q_open = filter q_open by 'op.Core_Status__c' not in  [\"Cancelled\"] ;\nq_open = group q_open by ('Partner_Name', Status_Name,'Id','Opportunit.Core_Status__c','Opportunit.Id');\nq_open = foreach q_open generate 'Id','Partner_Name' as 'Partner_Name', \"Open\" as 'Status_Name',max('Opportunit.Core_KPI_Total_Price__c') as 'Amt';\nq_open = group q_open by ('Partner_Name', 'Status_Name');\nq_open = foreach q_open generate 'Partner_Name','Status_Name', sum('Amt') as 'Amt' ;\nq_open = order q_open by 'Amt'desc;\n\n\n---Query to get Open and Won \nq_union_w_o = union q_open,q_won;\n\nq_won_o_w = group q_union_w_o by  ('Partner_Name', 'Status_Name');\nq_won_o_w = foreach q_won_o_w generate 'Partner_Name','Status_Name', sum('Amt') as 'Amt', 0 as 'Amt Total';\n\nq_won_amt = group q_won_o_w by  ('Partner_Name');\nq_won_amt = foreach q_won_amt generate 'Partner_Name',\"Won\" as 'Status_Name',0 as 'Amt', sum('Amt') as 'Amt Total';\n\nq_open_amt = group q_won_o_w by  ('Partner_Name');\nq_open_amt = foreach q_open_amt generate 'Partner_Name',\"Open\" as 'Status_Name',0 as 'Amt', sum('Amt') as 'Amt Total';\n\nq_union_w_o_prc = union q_union_w_o, q_won_amt,q_open_amt;\n\nq_w_o_result = group q_union_w_o_prc by ('Partner_Name', 'Status_Name');\nq_w_o_result = foreach q_w_o_result generate 'Partner_Name','Status_Name',sum('Amt') as 'Amt', max('Amt Total') as 'Amt Total', 0 as 'Amt %';\n\n\n\n---Query to get lost and Won %\nq_union_w_l = union q_lost,q_won;\n\nq_won_l_w = group q_union_w_l by  ('Partner_Name', 'Status_Name','Status_Name_lost');\nq_won_l_w = foreach q_won_l_w generate 'Partner_Name','Status_Name','Status_Name_lost',sum('Amt') as 'Amt', sum('Amt_l') as 'Amt_l' ,0 as 'Amt Total';\n\nq_won_perc = group q_won_l_w by  ('Partner_Name');\nq_won_perc = foreach q_won_perc generate 'Partner_Name',\"Won\" as 'Status_Name',0 as 'Amt', 0 as 'Amt_l' ,sum('Amt') as 'Amt Total';\n\nq_lost_perc = group q_won_l_w by  ('Partner_Name');\nq_lost_perc = foreach q_lost_perc generate 'Partner_Name',\"Lost\" as 'Status_Name_lost',0 as 'Amt',0 as 'Amt_l' , sum('Amt') as 'Amt Total';\n\nq_union_w_l_prc = union q_union_w_l, q_won_perc,q_lost_perc;\n\nq_w_l_result = group q_union_w_l_prc by ('Partner_Name', 'Status_Name','Status_Name_lost');\nq_w_l_result = foreach q_w_l_result generate 'Partner_Name','Status_Name','Status_Name_lost',sum('Amt') as 'Amt', sum('Amt_l') as 'Amt_l' , sum('Amt Total') as 'Amt Total', (sum(Amt)/max('Amt Total'))*100 as 'Amt %',(sum('Amt_l')/max('Amt Total'))*100 as 'Amt_l %';\n\nq_won_pert = group q_w_l_result by  ('Partner_Name');\nq_won_pert = foreach q_won_pert generate 'Partner_Name',\"Won\" as 'Status_Name',0 as 'Amt', 0 as 'Amt Total',0 as 'Amt %', sum('Amt %') as 'Amt % total';\n\nq_lost_perct = group q_w_l_result by  ('Partner_Name');\nq_lost_perc = foreach q_lost_perct generate 'Partner_Name',\"Lost\" as 'Status_Name_lost',0 as 'Amt', 0 as 'Amt Total';\n\n\n--Query to get the union of the all data\n\nq_final_result_w = filter q_w_l_result by 'Status_Name' in  [\"Won\"];\nq_final_result_w = group q_final_result_w by  ('Partner_Name', 'Status_Name','Status_Name_lost');\nq_final_result_w = foreach q_final_result_w generate 'Partner_Name','Status_Name' as 'Status_Name1',\"\" as 'Status_Name2',max('Amt %') as 'Amt', max('Amt Total') as 'Amt Total';\nq_final_result_w = order q_final_result_w by 'Amt Total'  desc;    \nq_final_result_w = limit q_final_result_w 10;  \n\nq_final_result_l = filter q_w_l_result by 'Status_Name_lost' in  [\"Lost\"];\nq_final_result_l = group q_final_result_l by  ('Partner_Name', 'Status_Name','Status_Name_lost');\nq_final_result_l = foreach q_final_result_l generate 'Partner_Name', 'Status_Name_lost' as 'Status_Name1',\"\" as 'Status_Name2',max('Amt_l %')  as 'Amt',  max('Amt Total')  as 'Amt Total';\nq_final_result_l = order q_final_result_l by 'Amt Total'  desc;    \nq_final_result_l = limit q_final_result_l 10;  \n\n\nq_final_result_w_l = union q_final_result_w,q_final_result_l;\n\n\nq_final_result_w_o = filter q_w_o_result by 'Status_Name' in  [\"Open\",\"Won\"];\nq_final_result_w_o = group q_final_result_w_o by  ('Partner_Name', 'Status_Name');\nq_final_result_w_o = foreach q_final_result_w_o generate 'Partner_Name', \"\" as 'Status_Name1','Status_Name' as 'Status_Name2',(case when \"{{cell(static_1.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" then max('Amt %')  else sum('Amt') end) as 'Amt', (case when \"{{cell(static_1.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" then max('Amt Total')  else  sum('Amt Total')  end) as 'Amt Total';\n\nq_final_union = union q_final_result_w_o,q_final_result_w_l;\n\n\nq_final_result = group q_final_union by  ('Partner_Name', 'Status_Name1','Status_Name2');\nq_final_result = foreach q_final_result generate 'Partner_Name', (case when \"{{cell(static_1.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" then 'Status_Name1'  else 'Status_Name2' end) as 'Status_Name', sum('Amt') as 'Amt', (case when  ((\"{{cell(static_1.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" &&  \"{{cell(static_2.selection, 0, \"value\").asString()}}\" == \"desc\") || (\"{{cell(static_1.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" &&  \"{{cell(static_2.selection, 0, \"value\").asString()}}\" == \"asc\")) then max('Amt')  else  max('Amt Total') end) as 'Amt Total';\nq_final_result = filter q_final_result by 'Status_Name' not in [\"\"];\nq_final_result = filter q_final_result by 'Amt Total' is not null;\n\nq_final = order q_final_result by 'Amt Total' desc;\n\nq_final = limit q_final  {{cell(static_1.selection, 0, \"field_n\").asString()}};","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"top-center","inside":false},"axisMode":"multi","totalSumMode":"none","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"stackhbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"split":["Status_Name"],"trellis":[],"dimensionAxis":["Partner_Name"],"plots":["Amt"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"{{column(static_1.selection, [\"title\"]).asObject()}}","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_5":{"broadcastFacet":true,"groups":[],"label":"Opportunity_Table","numbers":[],"query":"q = load \"Solution_CRM1\";\nq = filter q by 'KPIDateYear' in {{coalesce(column(Parter_Solution_Prod_1.selection, [\"year\"]),'all').asString()}}; \nq = filter q by 'KPIQuarter' in {{coalesce(column(Parter_Solution_Prod_2.selection, [\"quarter\"]),'all').asString()}}; \nq = filter q by 'Partner_Name'  in  {{coalesce(column(Prather_Chart__1.selection, [\"Partner_Name\"]),'all').asString()}};\nq = filter q by 'Application_Workload'  in  {{coalesce(column(Workload_Chart_1.selection, [\"Application_Workload\"]),'all').asString()}};\nq = filter q by 'Industry_Use_Cases' in  {{coalesce(column(lens_4.selection, [\"Industry_Use_Cases\"]),'all').asString()}};\nq = filter q by 'Tech_Enable' in {{coalesce(column(Tech_Ebable_Charty_1.selection, [\"Tech_Enable\"]),'all').asString()}};\nq = filter q by 'Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.Solution_technology.SOLUTION_NM' in {{coalesce(column(Top_Solution_Chart_1.selection, [\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.Solution_technology.SOLUTION_NM\"]),'all').asString()}};\nq= group q by ('Opportunity_Name','AccountName','OpportunityProducts.Opportunity.Account.Owner.Name', 'StageName','OpportunityProducts.Opportunity.CloseDate', 'OpportunityProducts.Opportunity.CloseDate_Month', 'OpportunityProducts.Opportunity.CloseDate_Day');\nq = foreach q generate 'Opportunity_Name' , 'AccountName', q.'OpportunityProducts.Opportunity.Account.Owner.Name' as 'Oppty Owner', q.'StageName' as 'Stage', q.'OpportunityProducts.Opportunity.CloseDate' as 'Decision Date', max(q.'Amount') as 'Amount';\nq = order q by ('Amount' desc);\nq = limit q 10;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":151,"minColumnWidth":150,"mode":"variable","numberOfLines":1,"pivoted":false,"showActionMenu":false,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Core_Product_Applica_1":{"broadcastFacet":true,"datasets":[{"name":"Solution_CRM1"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Core_Product_Application__c\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{}},"lens_6":{"broadcastFacet":true,"groups":[],"label":"Win_Rate_Metric","numbers":[],"query":"q = load \"Solution_CRM1\";\nq = filter q by date('KPIDateYear', 'OpportunityProducts.Core_KPI_Date__c_Month', 'OpportunityProducts.Core_KPI_Date__c_Day') in [\"4 quarters ago\"..\"current quarter\"];\nq = filter q by 'StageName' in [\"Design Win\", \"Production Win\", \"Production Cancelled\", \"Production Lost\", \"Cancelled\", \"Lost\"];\nq = filter q by 'KPIDateYear' in {{coalesce(column(Parter_Solution_Prod_1.selection, [\"year\"]),'all').asString()}}; \nq = filter q by 'KPIQuarter' in {{coalesce(column(Parter_Solution_Prod_2.selection, [\"quarter\"]),'all').asString()}}; \nq = group q by all;\nq = foreach q generate avg('OpportunityProducts.Opportunity.Core_Wins_Oppty__c') as 'avg_Opportunity.Core_Wins_Oppty__c';\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["avg_