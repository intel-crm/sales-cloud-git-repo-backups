x('Amt %')  else sum('Amt') end) as 'Amt', (case when \"{{cell(static_3.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" then max('Amt Total')  else  sum('Amt Total')  end) as 'Amt Total';\n\nq_final_union = union q_final_result_w_o,q_final_result_w_l;\n\n\nq_final_result = group q_final_union by  ('Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.Solution_technology.SOLUTION_NM', 'Status_Name1','Status_Name2');\nq_final_result = foreach q_final_result generate 'Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.Solution_technology.SOLUTION_NM', (case when \"{{cell(static_3.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" then 'Status_Name1'  else 'Status_Name2' end) as 'Status_Name', sum('Amt') as 'Amt', (case when  ((\"{{cell(static_3.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" &&  \"{{cell(static_2.selection, 0, \"value\").asString()}}\" == \"desc\") || (\"{{cell(static_3.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" &&  \"{{cell(static_2.selection, 0, \"value\").asString()}}\" == \"asc\")) then max('Amt')  else  max('Amt Total') end) as 'Amt Total';\nq_final_result = filter q_final_result by 'Status_Name' not in [\"\"];\nq_final_result = filter q_final_result by 'Amt Total' is not null;\n\nq_final = order q_final_result by 'Amt Total'  {{cell(static_2.selection, 0, \"value\").asString()}};\n\n\nq_final = limit q_final  {{cell(static_3.selection, 0, \"field_n\").asString()}};\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","totalSumMode":"none","tooltip":{"content":{"legend":{"showBinLabel":true,"meas