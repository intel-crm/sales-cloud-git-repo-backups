olumn(Parter_Solution_Prod_2.selection, [\"quarter\"]),'all').asString()}}; \nq = filter q by 'Opportunit.Core_Status__c' not in [\"Lost\", \"Cancelled\"];\nq = group q by ('KPIQuarter', 'StageSorted',Id,'Opportunit.Id');\nq = foreach q generate 'KPIQuarter' as 'KPIQuarter', 'Id','StageSorted' as 'StageSorted', max('Opportunit.Core_KPI_Total_Price__c') as 'Opportunit.Core_KPI_Total_Price__c',max(Amount) as 'Amount';\nq = group q by ('KPIQuarter', 'StageSorted');\nq = foreach q generate 'KPIQuarter' as 'KPIQuarter', 'StageSorted' as 'StageSorted', sum('Opportunit.Core_KPI_Total_Price__c')  as 'Total Price';\nq = order q by ('KPIQuarter' asc, 'StageSorted' asc);\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"axisMode":"multi","totalSumMode":"none","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"Pipeline $ by Quarter","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Opportunit_Name_1":{"broadcastFacet":true,"datasets":[{"name":"Solution_CRM1"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Opportunit.Name\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{}},"Opportunity_Account__2":{"broadcastFacet":true,"groups":[],"label":"Opportunity_Account__2","numbers":[],"query":"q = load \"Solution_CRM1\";\nq = filter q by 'KPIDateYear' in {{coalesce(column(Parter_Solution_Prod_1.selection, [\"year\"]),'all').asString()}};\nq = filter q by 'KPIQuarter' in {{coalesce(column(Parter_Solution_Prod_2.selection, [\"quarter\"]),'all').asString()}};\nq = group q by 'Core_Sales_Groups__c';\nq = foreach q generate 'Core_Sales_Groups__c' as 'Core_Sales_Groups__c', count() as 'count';\nq = order q by 'Core_Sales_Groups__c' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["Core_Sales_Groups__c"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Parter_Solution_Prod_1":{"broadcastFacet":false,"groups":[],"label":"Date_Filter","numbers":[],"query":"q = load \"Solution_CRM1\";\nq = group q by 'KPIDateYear';\nq = foreach q generate 'KPIDateYear' as 'year';\nq = order q by 'year' asc;\n\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","start":"{{cell(Currents.result, 0, \"CurrentYear\").asString()}}","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":false,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Tech_Ebable_Charty_1":{"broadcastFacet":true,"groups":[],"label":"Tech_Ebable_Charty","numbers":[],"query":"q = load \"Solution_CRM1\";\nq = filter q by 'KPIDateYear' in {{coalesce(column(Parter_Solution_Prod_1.selection, [\"year\"]),'all').asString()}};\nq = filter q by 'KPIQuarter' in {{coalesce(column(Parter_Solution_Prod_2.selection, [\"quarter\"]),'all').asString()}};\n--q = filter q by 'Tech_Enable'== \"VMware INC.\";\n\n--Get won\nq_won = filter q by 'Opportunit.Core_Status__c' in  [\"Win Approved\", \"Production Cancelled\", \"Production Lost\", \"Production Win\"] ;\n--q_won = filter q_won by 'op.Core_Status__c' not in  [\"Cancelled\"] ;\nq_won = group q_won by ('Tech_Enable', Status_Name,'Id','Opportunit.Core_Status__c','Opportunit.Id');\nq_won = foreach q_won generate 'Id','Tech_Enable' as 'Tech_Enable', 'Status_Name',max('Opportunit.Core_KPI_Total_Price__c') as 'Amt';\nq_won = group q_won by ('Tech_Enable', 'Status_Name');\nq_won = foreach q_won generate 'Tech_Enable','Status_Name', sum('Amt') as 'Amt' ;\nq_won = order q_won by 'Amt'desc;\n\n\n--Get Lost\nq_lost = filter q by 'Opportunit.Core_Status__c' in  [\"Lost\",\"Cancelled\"] ;\nq_lost = group q_lost by ('Tech_Enable', Status_Name,'Id','Opportunit.Core_Status__c','Opportunit.Id');\nq_lost = foreach q_lost generate 'Id','Tech_Enable' as 'Tech_Enable', \"Lost\" as 'Status_Name',max('BU.op.Core_Lost_Total_Price__c') as 'BU.op.Core_Lost_Total_Price__c';\nq_lost = group q_lost by ('Tech_Enable', Status_Name,'Id');\nq_lost = foreach q_lost generate 'Id','Tech_Enable' as 'Tech_Enable', 'Status_Name',max('BU.op.Core_Lost_Total_Price__c') as 'Amt';\nq_lost = group q_lost by ('Tech_Enable', 'Status_Name');\nq_lost = foreach q_lost generate 'Tech_Enable','Status_Name' as 'Status_Name_lost', sum('Amt') as 'Amt_l',0 as 'Amt'  ;\nq_lost = order q_lost by 'Amt'desc;\n\n--Get Open\nq_open = filter q by 'Opportunit.Core_Status__c' in  [\"On Hold\",\"Pending\",\"Win Submitted\"] ;\n--q_open = filter q_open by 'op.Core_Status__c' not in  [\"Cancelled\"] ;\nq_open = group q_open by ('Tech_Enable', Status_Name,'Id','Opportunit.Core_Status__c','Opportunit.Id');\nq_open = foreach q_open generate 'Id','Tech_Enable' as 'Tech_Enable', \"Open\" as 'Status_Name',max('Opportunit.Core_KPI_Total_Price__c') as 'Amt';\nq_open = group q_open by ('Tech_Enable', 'Status_Name');\nq_open = foreach q_open generate 'Tech_Enable','Status_Name', sum('Amt') as 'Amt' ;\nq_open = order q_open by 'Amt'desc;\n\n\n---Query to get Open and Won \nq_union_w_o = union q_open,q_won;\n\nq_won_o_w = group q_union_w_o by  ('Tech_Enable', 'Status_Name');\nq_won_o_w = foreach q_won_o_w generate 'Tech_Enable','Status_Name', sum('Amt') as 'Amt', 0 as 'Amt Total';\n\nq_won_amt = group q_won_o_w by  ('Tech_Enable');\nq_won_amt = foreach q_won_amt generate 'Tech_Enable',\"Won\" as 'Status_Name',0 as 'Amt', sum('Amt') as 'Amt Total';\n\nq_open_amt = group q_won_o_w by  ('Tech_Enable');\nq_open_amt = foreach q_open_amt generate 'Tech_Enable',\"Open\" as 'Status_Name',0 as 'Amt', sum('Amt') as 'Amt Total';\n\nq_union_w_o_prc = union q_union_w_o, q_won_amt,q_open_amt;\n\nq_w_o_result = group q_union_w_o_prc by ('Tech_Enable', 'Status_Name');\nq_w_o_result = foreach q_w_o_result generate 'Tech_Enable','Status_Name',sum('Amt') as 'Amt', max('Amt Total') as 'Amt Total', 0 as 'Amt %';\n\n\n\n---Query to get lost and Won %\nq_union_w_l = union q_lost,q_won;\n\nq_won_l_w = group q_union_w_l by  ('Tech_Enable', 'Status_Name','Status_Name_lost');\nq_won_l_w = foreach q_won_l_w generate 'Tech_Enable','Status_Name','Status_Name_lost',sum('Amt') as 'Amt', sum('Amt_l') as 'Amt_l' ,0 as 'Amt Total';\n\nq_won_perc = group q_won_l_w by  ('Tech_Enable');\nq_won_perc = foreach q_won_perc generate 'Tech_Enable',\"Won\" as 'Status_Name',0 as 'Amt', 0 as 'Amt_l' ,sum('Amt') as 'Amt Total';\n\nq_lost_perc = group q_won_l_w by  ('Tech_Enable');\nq_lost_perc = foreach q_lost_perc generate 'Tech_Enable',\"Lost\" as 'Status_Name_lost',0 as 'Amt',0 as 'Amt_l' , sum('Amt') as 'Amt Total';\n\nq_union_w_l_prc = union q_union_w_l, q_won_perc,q_lost_perc;\n\nq_w_l_result = group q_union_w_l_prc by ('Tech_Enable', 'Status_Name','Status_Name_lost');\nq_w_l_result = foreach q_w_l_result generate 'Tech_Enable','Status_Name','Status_Name_lost',sum('Amt') as 'Amt', sum('Amt_l') as 'Amt_l' , sum('Amt Total') as 'Amt Total', (sum(Amt)/max('Amt Total'))*100 as 'Amt %',(sum('Amt_l')/max('Amt Total'))*100 as 'Amt_l %';\n\nq_won_pert = group q_w_l_result by  ('Tech_Enable');\nq_won_pert = foreach q_won_pert generate 'Tech_Enable',\"Won\" as 'Status_Name',0 as 'Amt', 0 as 'Amt Total',0 as 'Amt %', sum('Amt %') as 'Amt % total';\n\nq_lost_perct = group q_w_l_result by  ('Tech_Enable');\nq_lost_perc = foreach q_lost_perct generate 'Tech_Enable',\"Lost\" as 'Status_Name_lost',0 as 'Amt', 0 as 'Amt Total';\n\n\n--Query to get the union of the all data\n\nq_final_result_w = filter q_w_l_result by 'Status_Name' in  [\"Won\"];\nq_final_result_w = group q_final_result_w by  ('Tech_Enable', 'Status_Name','Status_Name_lost');\nq_final_result_w = foreach q_final_result_w generate 'Tech_Enable','Status_Name' as 'Status_Name1',\"\" as 'Status_Name2',max('Amt %') as 'Amt', max('Amt Total') as 'Amt Total';\nq_final_result_w = order q_final_result_w by 'Amt Total'  desc;    \nq_final_result_w = limit q_final_result_w 10;  \n\nq_final_result_l = filter q_w_l_result by 'Status_Name_lost' in  [\"Lost\"];\nq_final_result_l = group q_final_result_l by  ('Tech_Enable', 'Status_Name','Status_Name_lost');\nq_final_result_l = foreach q_final_result_l generate 'Tech_Enable', 'Status_Name_lost' as 'Status_Name1',\"\" as 'Status_Name2',max('Amt_l %')  as 'Amt',  max('Amt Total')  as 'Amt Total';\nq_final_result_l = order q_final_result_l by 'Amt Total'  desc;    \nq_final_result_l = limit q_final_result_l 10;  \n\n\nq_final_result_w_l = union q_final_result_w,q_final_result_l;\n\n\nq_final_result_w_o = filter q_w_o_result by 'Status_Name' in  [\"Open\",\"Won\"];\nq_final_result_w_o = group q_final_result_w_o by  ('Tech_Enable', 'Status_Name');\nq_final_result_w_o = foreach q_final_result_w_o generate 'Tech_Enable', \"\" as 'Status_Name1','Status_Name' as 'Status_Name2',(case when \"{{cell(static_3.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" then max('Amt %')  else sum('Amt') end) as 'Amt', (case when \"{{cell(static_3.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" then max('Amt Total')  else  sum('Amt Total')  end) as 'Amt Total';\n\nq_final_union = union q_final_result_w_o,q_final_result_w_l;\n\n\nq_final_result = group q_final_union by  ('Tech_Enable', 'Status_Name1','Status_Name2');\nq_final_result = foreach q_final_result generate 'Tech_Enable', (case when \"{{cell(static_3.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" then 'Status_Name1'  else 'Status_Name2' end) as 'Status_Name', sum('Amt') as 'Amt', (case when  ((\"{{cell(static_3.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" &&  \"{{cell(static_2.selection, 0, \"value\").asString()}}\" == \"desc\") || (\"{{cell(static_3.selection, 0, \"display\").asString()}}\"  == \"Win vs. Loss\" &&  \"{{cell(static_2.selection, 0, \"value\").asString()}}\" == \"asc\")) then max('Amt')  else  max('Amt Total') end) as 'Amt Total';\nq_final_result = filter q_final_result by 'Status_Name' not in [\"\"];\nq_final_result = filter q_final_result b