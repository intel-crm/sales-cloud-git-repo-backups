          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA25" : {
      "action" : "formula",
      "sources" : [ "FORMULA24" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "YearQuarter",
          "label" : "YearQuarter",
          "formulaExpression" : "concat(year(CloseDate),'0',quarter(CloseDate))",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA26" : {
      "action" : "formula",
      "sources" : [ "FORMULA25" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Year",
          "label" : "Year",
          "formulaExpression" : "string(year(CloseDate))",
          "precision" : 4,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA27" : {
      "action" : "formula",
      "sources" : [ "FORMULA26" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Month_Name",
          "label" : "Month_Name",
          "formulaExpression" : "case when month(CloseDate) = 1 then 'January'\r\nwhen month(CloseDate) = 2 then 'February'\r\nwhen month(CloseDate) = 3 then 'March' \r\nwhen month(CloseDate) = 4 then 'April' \r\nwhen month(CloseDate) = 5 then 'May' \r\nwhen month(CloseDate) = 6 then 'June'\r\nwhen month(CloseDate) = 7 then 'July'\r\nwhen month(CloseDate) = 8 then 'August'\r\nwhen month(CloseDate) = 9 then 'September'\r\nwhen month(CloseDate) = 10 then 'October'\r\nwhen month(CloseDate) = 11 then 'November'\r\nwhen month(CloseDate) = 12 then 'December' end",
          "precision" : 30,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA28" : {
      "action" : "formula",
      "sources" : [ "FORMULA27" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "yearMonthNumber",
          "label" : "yearMonthNumber",
          "formulaExpression" : "case when month(CloseDate) > 9 then concat(year(CloseDate),month(CloseDate)) else concat(year(CloseDate),'0',month(CloseDate)) end",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
