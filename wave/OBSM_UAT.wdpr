          "name" : "Account_Sales_Groups",
          "label" : "Account_Sales_Groups",
          "formulaExpression" : "(case  when contains(upper(\"Account.Core_Sales_Groups__c\"), 'INDIA')\r\n      then 'India'\r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'EMEA') \r\n      then 'EMEA'\r\n      when \"Account.Core_Sales_Groups__c\" = 'Global Accounts Sales Group' then 'GSA' \r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'APJ') then 'APJ' \r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'Americas' ) then 'Americas' \r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'PRC') then 'PRC' \r\n      else 'Other'\r\nend)\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
