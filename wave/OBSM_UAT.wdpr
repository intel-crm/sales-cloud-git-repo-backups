    "FORMULA29" : {
      "action" : "formula",
      "sources" : [ "FORMULA28" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Sales_Group",
          "label" : "Sales_Group",
          "formulaExpression" : "case when \"Account.Core_Sales_Groups__c\" is not null then 'Total' else null end",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA30" : {
      "action" : "formula",
      "sources" : [ "FORMULA28" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Sales_Group",
          "label" : "Sales_Group",
          "formulaExpression" : "(case\r\n      when contains(upper(\"Account.Core_Sales_Groups__c\"), 'INDIA')\r\n      then 'India'\r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'EMEA') \r\n      then 'EMEA'\r\n      when \"Account.Core_Sales_Groups__c\" = 'Global Solutions & Services Sales Group' then 'GSS'\r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'APJ') then 'APJ' \r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'Americas' ) then 'Americas' \r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'PRC') then 'PRC' \r\n      else 'Other'\r\nend)\r\n",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
