    "FORMULA23" : {
      "action" : "formula",
      "sources" : [ "JOIN8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Flag_MonthAccess",
          "label" : "Flag_MonthAccess",
          "formulaExpression" : "case when Snapshot_YearMonth = \"usage.WW_YearMonth\" then 1 else 0 end",
