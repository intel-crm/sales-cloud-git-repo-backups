    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Account_Sales_Group",
          "label" : "Account Sales Group",
          "formulaExpression" : "case \r\n\twhen contains(\"Opportunity.Account.Core_Sales_Groups__c\", 'PRC')\r\n\tthen 'PRC'\r\n\twhen contains(\"Opportunity.Account.Core_Sales_Groups__c\", 'America')\r\n\tthen 'AMR'\r\n    when contains(\"Opportunity.Account.Core_Sales_Groups__c\", 'EMEA')\r\n\tthen 'EMEA'\r\n    when contains(\"Opportunity.Account.Core_Sales_Groups__c\", 'APJ')\r\n\tthen 'APJ'\r\n\telse\r\n\t'GSS' \r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
