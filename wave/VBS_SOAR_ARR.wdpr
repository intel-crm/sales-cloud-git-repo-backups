      }
    },
    "FORMULA13" : {
      "action" : "formula",
      "sources" : [ "FORMULA9" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Primary_VBS_Offering_Category",
          "label" : "Primary VBS Offering Category",
          "formulaExpression" : "case \r\n    when \"CRM_VBS_SO.CRM_VBS_Primary_VBS_Offering_Category__c\" is null\r\n    then 'Unidentified'\r\n    else\r\n    \"CRM_VBS_SO.CRM_VBS_Primary_VBS_Offering_Category__c\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA14" : {
      "action" : "formula",
      "sources" : [ "FORMULA13" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "VBS_Status",
          "label" : "VBS Status",
          "formulaExpression" : "case \r\n    when \"CRM_VBS_SO.CRM_VBS_SOAR_VBS_Decision__c\" is null\r\n    then 'Unidentified'\r\n    else\r\n    \"CRM_VBS_SO.CRM_VBS_SOAR_VBS_Decision__c\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA15" : {
      "action" : "formula",
      "sources" : [ "FORMULA14" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Vertical_Market",
          "label" : "Vertical Market",
          "formulaExpression" : "case \r\n    when \"Opportunity.op.Core_Vertical_Market__c\" is null\r\n    then 'Unidentified'\r\n    else\r\n    \"Opportunity.op.Core_Vertical_Market__c\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA16" : {
      "action" : "formula",
      "sources" : [ "FORMULA15" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Opportunity_Status",
          "label" : "Opportunity_Status",
          "formulaExpression" : "case \r\n    when \"Opportunity.op.Core_Status__c\" is null\r\n    then 'Unidentified'\r\n    else\r\n    \"Opportunity.op.Core_Status__c\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA17" : {
      "action" : "formula",
      "sources" : [ "FORMULA16" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Opportunity_Name_ARR",
          "label" : "Opportunity_Name_ARR",
          "formulaExpression" : "case \r\n    when \"Opportunity_Name\" is null\r\n    then 'Unidentified'\r\n    else\r\n    \"Opportunity_Name\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA18" : {
      "action" : "formula",
      "sources" : [ "FORMULA17" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Account_nm_ARR",
          "label" : "Account_nm_ARR",
          "formulaExpression" : "case \r\n    when \"Opportunity.Account.Name\" is null\r\n    then 'Unidentified'\r\n    else\r\n    \"Opportunity.Account.Name\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA19" : {
      "action" : "formula",
      "sources" : [ "FORMULA18" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Owner_nm_ARR",
          "label" : "Owner_nm_ARR",
          "formulaExpression" : "case \r\n    when \"Owner_nm\" is null\r\n    then 'Unidentified'\r\n    else\r\n    \"Owner_nm\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA20" : {
      "action" : "formula",
      "sources" : [ "FORMULA19" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "StageSorted",
          "label" : "StageSorted",
          "formulaExpression" : "case\r\n    when \"Opportunity.StageName\" = 'Qualify' then '1 - Qualify' \r\n    when \"Opportunity.StageName\" = 'Define' then '2 - Define'\r\n    when \"Opportunity.StageName\" = 'Develop' then '3 - Develop'\r\n    when \"Opportunity.StageName\" = 'Design' then '4 - Design'\r\n    when \"Opportunity.StageName\" = 'Design Win' then '5 - Design Win'\r\n    when \"Opportunity.StageName\" = 'Production Win' then '6 - Production Win'\r\n    when \"Opportunity.StageName\" = 'Production Lost' then '7 - Production Lost'\r\n    when \"Opportunity.StageName\" = 'Production Cancelled' then '8 - Production Cancelled'\r\n    when \"Opportunity.StageName\" = 'Lost' then '9 - Lost'\r\n    when \"Opportunity.StageName\" = 'Cancelled' then '91 - Cancelled'\r\nelse '99 - No Match'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA21" : {
      "action" : "formula",
      "sources" : [ "FORMULA20" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "Contract_Start_Date",
          "label" : "Contract Start Date",
          "formulaExpression" : "VBS_CONTRACT_START_DT",
          "format" : "dd/MM/yyyy",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA22" : {
      "action" : "formula",
      "sources" : [ "FORMULA21" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "stage_mapping",
          "label" : "stage_mapping",
          "formulaExpression" : "case \r\n    when \"Opportunity.StageName\" = 'Design Win'\r\n    then 'Won'\r\n    when \"Opportunity.StageName\" ='Production Win'\r\n    then 'Won'\r\n    when \"Opportunity.StageName\" ='Production Cancelled'\r\n    then 'Won'\r\n    when \"Opportunity.StageName\" = 'Production Lost'\r\n    then 'Won'\r\n    when \"Opportunity.StageName\" ='Qualify' then 'Open'\r\n    when \"Opportunity.StageName\" = 'Define' then 'Open'\r\n    when \"Opportunity.StageName\" = 'Develop' then 'Open'\r\n    when \"Opportunity.StageName\" = 'Design' then 'Open'\r\n    else\r\n    'Lost'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA23" : {
      "action" : "formula",
      "sources" : [ "FORMULA22" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "SOAR_VBS_Renewal",
          "label" : "SOAR_VBS_Renewal",
          "formulaExpression" : "case when VBS_NM like '%Renewal%' then 'Renewal' else VBS_Status end",
          "precision" : 25,
          "defaultValue" : ""
        } ]
      }
    },
