    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Account_Sales_Group",
          "label" : "Account Sales Group",
          "formulaExpression" : "case \r\n\twhen contains(\"Opportunity.Opportunity.Core_Sales_Group__c\", 'PRC')\r\n\tthen 'PRC'\r\n\twhen contains(\"Opportunity.Opportunity.Core_Sales_Group__c\", 'America')\r\n\tthen 'AMR'\r\n    when contains(\"Opportunity.Opportunity.Core_Sales_Group__c\", 'EMEA')\r\n\tthen 'EMEA'\r\n    when contains(\"Opportunity.Opportunity.Core_Sales_Group__c\", 'APJ')\r\n\tthen 'APJ'\r\n\telse\r\n\t'GSS'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
