    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "AGGREGATE7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "PAGE_TYPE",
          "label" : "PAGE_TYPE",
          "formulaExpression" : "CASE\r\n   WHEN UPPER(\"PAGE_ENTITY_TYPE\") = 'ACCOUNT' THEN 'Account'\r\n   ELSE 'Opportunity'\r\nEND",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "SUB_PAGE",
          "label" : "SUB_PAGE",
          "formulaExpression" : "CASE\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'activityTab' THEN 'Activity'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'collaborateTab' THEN 'Chatter'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'customTab' THEN 'Approval & History'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'customTab2' THEN '6QPS'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'customTab3' THEN 'At Risk'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'customTab4' THEN 'Content'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'customTab5' THEN 'Insights'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'detailTab' THEN 'Details'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'flexipage_tab' THEN 'Opportunity Solutions'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'flexipage_tab2' THEN 'Support Status'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'flexipage_tab4' THEN 'PAI'\r\n   WHEN \"PAGE_TYPE\" = 'Opportunity' AND \"COMPONENT_NAME\" = 'flexipage_tab6' THEN 'Activity Timeline'\r\n\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'activityTab' THEN 'Activity'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'chatter' THEN 'chatter'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'collaborateTab' THEN 'Chatter'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'customTab' THEN 'Approval & History'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'customTab2' THEN 'Membership'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'customTab3' THEN 'Legal'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'customTab4' THEN 'History'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'customTab5' THEN 'customTab5'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'detailTab' THEN 'Details'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab' THEN 'Unified Customer'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab1' THEN 'flexipage_tab1'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab2' THEN 'Account360'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab4' THEN 'Pipeline and Opportunity Overview'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = '' THEN 'Revenue'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab6' THEN 'PAI'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab9' THEN 'Brief/Plans'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab10' THEN 'flexipage_tab10'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab11' THEN 'flexipage_tab11'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab12' THEN 'flexipage_tab12'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab13' THEN 'flexipage_tab13'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab14' THEN 'flexipage_tab14'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab15' THEN 'flexipage_tab15'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab16' THEN 'flexipage_tab16'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab17' THEN 'flexipage_tab17'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab20' THEN 'Customer Intelligence'\r\n   WHEN \"PAGE_TYPE\" = 'Account' AND \"COMPONENT_NAME\" = 'flexipage_tab21' THEN 'News'\r\n\r\n   ELSE \"COMPONENT_NAME\"\r\nEND",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
