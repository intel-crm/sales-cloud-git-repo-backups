\" as 'VBS_AI', 0.0000000001 as 'Open Pipeline $', 0 as 'Won Pipeline $';\nq0c = foreach q generate 'sales_grouping' as 'sales_grouping', \"VBS\" as 'VBS_AI', 0.0000000001 as 'Open Pipeline $', 0 as 'Won Pipeline $';\nq0d = foreach q generate 'sales_grouping' as 'sales_grouping', \"VBS/AI\" as 'VBS_AI', 0.0000000001 as 'Open Pipeline $', 0 as 'Won Pipeline $';\n\nq1 = filter q by 'Core_Status__c' in [\"On Hold\", \"Pending\", \"Win Submitted\"];\nq1 = group q1 by ('sales_grouping', 'VBS_AI');\nq1 = foreach q1 generate 'sales_grouping' as 'sales_grouping', 'VBS_AI' as 'VBS_AI', sum('Opportunity.Amount') as 'Open Pipeline $', 0.0000000001 as 'Won Pipeline $';\n\nq2 = filter q by 'Core_Status__c' in [\"Win Approved\", \"Production Win\", \"Production Lost\", \"Production Cancelled\", \"Production Win Approved\", \"Production Win Submitted\"];\nq2 = group q2 by ('sales_grouping', 'VBS_AI');\nq2 = foreach q2 generate 'sales_grouping' as 'sales_grouping', 'VBS_AI' as 'VBS_AI', 0.0000000001 as 'Open Pipeline $', sum('Opportunity.Amount') as 'Won Pipeline $';\n\nqr = union q0a, q0b, q0c, q0d, q1, q2;\nqr = group qr by ('sales_grouping', 'VBS_AI');\nqr = foreach qr generate 'sales_grouping' as 'sales_grouping', 'VBS_AI' as 'VBS_AI', sum('Open Pipeline $') as 'Open Pipeline $', sum('Won Pipeline $') as 'Won Pipeline $', sum('Open Pipeline $') + sum('Won Pipeline $') as '$Total';\nqr = filter qr by '$Total' > 0;\nqr = order qr by 'sales_grouping' asc;\nqr = limit qr 2000;","receiveFacetSource":{"mode":"exclude","steps":["Clone_of_Opps_AMER_1"]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["sales_grouping","VBS_AI","Open Pipeline $","Won Pipeline $"],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c"