    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "LOAD_DATASET1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "FilterFlag",
          "label" : "FilterFlag",
          "formulaExpression" : "case\r\n    when datediff(to_date(now()), CreatedDate) < 32 \r\n    OR datediff(to_date(now()), LastModifiedDate) < 32 \r\n    OR datediff(to_date(now()), LastReferencedDate ) < 32\r\n    OR datediff(to_date(now()), LastViewedDate ) < 32\r\n    OR (datediff(to_date(now()), LastActivityDate ) < 32 AND datediff(to_date(now()), LastActivityDate ) > 0)\r\n    then 1 else 0 end",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "PhoneScore",
          "label" : "PhoneScore",
          "formulaExpression" : "case when \"Phone\" is null then 0 else 0.2 end",
          "precision" : 4,
          "scale" : 1,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "WebsiteScore",
          "label" : "WebsiteScore",
          "formulaExpression" : "case when \"Website\" is null then 0 else 0.2 end",
          "precision" : 4,
          "scale" : 1,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "IndustryScore",
          "label" : "IndustryScore",
          "formulaExpression" : "case when \"Industry\" is null then 0 else 0.2 end",
          "precision" : 4,
          "scale" : 1,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "RatingScore",
          "label" : "RatingScore",
          "formulaExpression" : "case when \"Rating\" is null then 0 else 0.2 end",
          "precision" : 4,
          "scale" : 1,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CountryScore",
          "label" : "CountryScore",
          "formulaExpression" : "case when \"BillingCountry\" is null then 0 else 0.2 end",
          "precision" : 4,
          "scale" : 1,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "DataQualityScore",
          "label" : "DataQualityScore",
          "formulaExpression" : "PhoneScore + WebsiteScore + IndustryScore + RatingScore + CountryScore",
          "precision" : 4,
          "scale" : 1,
          "defaultValue" : ""
        } ]
      }
    },
