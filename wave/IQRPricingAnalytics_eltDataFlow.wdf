eters\":{\"computedFields\":[{\"defaultValue\":\"0\",\"label\":\"First Submission Response Time (Days)\",\"name\":\"FirstSubmissionResponseTimeInDays\",\"precision\":16,\"saqlExpression\":\"Pricing_First_SubmissionToResponse_Time__c / 24\",\"scale\":2,\"type\":\"Numeric\"},{\"defaultValue\":\"0\",\"label\":\"Last Submission Response Time (Days)\",\"name\":\"LastSubmissionResponseTimeInDays\",\"precision\":16,\"saqlExpression\":\"Pricing_Last_Submission_to_Response_Time__c / 24\",\"scale\":2,\"type\":\"Numeric\"},{\"label\":\"Response Time\",\"name\":\"ResponseTime\",\"precision\":100,\"saqlExpression\":\"case when Pricing_First_SubmissionToResponse_Time__c <= 23.99 then \\\"0 Day\\\"\\nwhen Pricing_First_SubmissionToResponse_Time__c > 23.99 and Pricing_First_SubmissionToResponse_Time__c <= 48 then \\\"1 Day\\\"\\nwhen Pricing_First_SubmissionToResponse_Time__c > 48 and Pricing_First_SubmissionToResponse_Time__c <= 72 then \\\"2 Days\\\"\\nwhen Pricing_First_SubmissionToResponse_Time__c > 72 and Pricing_First_SubmissionToResponse_Time__c <= 96 then \\\"3 Days\\\"\\nwhen Pricing_First_SubmissionToResponse_Time__c > 96 and Pricing_First_SubmissionToResponse_Time__c <= 144 then \\\"4-5 Days\\\"\\nwhen Pricing_First_SubmissionToResponse_Time__c > 144 and Pricing_First_SubmissionToResponse_Time__c <= 240 then \\\"6-9 Days\\\"\\nwhen Pricing_First_SubmissionToResponse_Time__c > 240 then \\\"9+ Days\\\"\\nelse \\\"NA\\\"\\nend\",\"type\":\"Text\"},{\"label\":\"LastSubmittedSLA\",\"name\":\"LastSubmittedSLA\",\"precision\":100,\"saqlExpression\":\"case when Pricing_Last_Submission_to_Response_Time__c <= 23.99 then \\\"0 Day\\\"\\nwhen Pricing_Last_Submission_to_Response_Time__c > 23.99 and Pricing_Last_Submission_to_Response_Time__c <= 48 then \\\"1 Day\\\"\\nwhen Pricing_Last_Submission_to_Response_Time__c > 48 and Pricing_Last_Submission_to_Response_Time__c <= 72 then \\\"2 Days\\\"\\nwhen Pricing_Last_Submission_to_Response_Time__c > 72 and Pricing_Last_Submission_to_Resp