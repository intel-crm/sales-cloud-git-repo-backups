        "fields" : [ {
          "type" : "TEXT",
          "name" : "AR_URL_Trimmed",
          "label" : "AR URL Trimmed",
          "formulaExpression" : "case\r\n\twhen startsWith(AR_Tracking__c, 'https://')\r\n\tthen ltrim(AR_Tracking__c, 'https://')\r\n\twhen startsWith(AR_Tracking__c, 'http://')\r\n\tthen ltrim(AR_Tracking__c, 'http://')\r\n\telse AR_Tracking__c\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
