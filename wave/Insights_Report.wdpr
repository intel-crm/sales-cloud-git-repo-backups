          "name" : "CX_URL_Trimmed",
          "label" : "CX URL Trimmed",
          "formulaExpression" : "case\r\n\twhen startsWith(CX_Insight_Report__c, 'https://')\r\n\tthen ltrim(CX_Insight_Report__c, 'https://')\r\n\twhen startsWith(CX_Insight_Report__c, 'http://')\r\n\tthen ltrim(CX_Insight_Report__c, 'http://')\r\n\telse CX_Insight_Report__c\r\nend",
