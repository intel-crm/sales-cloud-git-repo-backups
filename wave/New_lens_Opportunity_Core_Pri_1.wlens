{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":true,"groups":[],"label":"Opportunity_Core_Pri_1","numbers":[],"query":"q = load \"OpportunityProducts\";\nq = filter q by 'Core_Status__c' in [\"Lost\",\"Cancelled\"];q = filter q by 'Core_At_Risk_Status__c' in [\"In-Progress\"]; q = filter q by 'FiscalTransDt.fiscalyearnumber' in [\"2022\"];q = filter q by 'fiscalmonthnumber' in all; q = filter q by 'Opportunity.TeamMembers.User.Manager.Name' in all; q = filter q by 'Opportunity.TeamMembers.User.Name' in all ;\nq = group q by 'PriorStageFunnel';\nq = foreach q generate 'PriorStageFunnel' as 'PriorStageFunnel', case when \"#\"== \"#\" then unique('OpportunityId') else sum('Core_KPI_Total_Price__c') end as 'Metric';\nq = order q by 'PriorStageFunnel' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"visualizationType":"origami"}}},"widgets":{"saql_chart":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":false,"tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"origami","exploreLink":true,"title":{"fontSize":14,"subtitleFontSize":11,"label":"Stage Immediately Prior to Lost/Cancelled","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimension":["PriorStageFunnel"],"plots":["Metric"]},"showActionMenu":true,"valueType":"compactNumber","showTotal":false,"theme":"wave","step":"saql","compactDecimalDigits":-1,"applyConditionalFormatting":true},"type":"chart"}}}