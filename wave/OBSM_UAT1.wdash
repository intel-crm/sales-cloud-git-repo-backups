_17","numbers":[],"query":"q = load \"UsageTrending\";\nq = filter q by 'WRK_Oppty.CORPORATE_EMAIL_TXT' matches \"@intel.com\";\nq = filter q by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"2 month ago\"..\"current month\"];\nq = filter q by 'OpportunityProducts.Opportunity.StageName' in [\"Qualify\", \"Define\", \"Develop\", \"Design\"];\nq = filter  q by 'Account_Plan.Name' is null;\nq = group   q by ('Snapshot_Date_Year', 'Snapshot_Date_Month','AccountId','OpportunityAccount.Name','Account.Core_Sales_Groups__c');\nq = foreach q generate 'AccountId','OpportunityAccount.Name','Account.Core_Sales_Groups__c';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":500,"minColumnWidth":300,"mode":"variable","numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_6":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q = load \"UsageTrending\";\nq = filter q by 'WRK_Oppty.CORPORATE_EMAIL_TXT' matches \"@intel.com\";\nq = filter q by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"3 quarters ago\"..\"current quarter\"];\nq = filter q by 'OpportunityProducts.Opportunity.StageName' in [\"Qualify\", \"Define\", \"Develop\", \"Design\"];\nq1 = group q by ('Snapshot_Date_Year','Snapshot_Date_Month');\nq1 = foreach q1 generate 'Snapshot_Date_Year' as 'Year', 'Snapshot_Date_Month' as 'Month', unique(q.'Id') as 'A', 0 as 'B', unique('AccountId') as 'C';\n\nq2 = group q by ('usage.WW_Year', 'usage.WW_Month');\nq2 = foreach q2 generate 'usage.WW_Year' as 'Year', 'usage.WW_Month' as 'Month', 0 as 'A', unique(q.'Id') as 'B';\nq_Access = union q1, q2;\nq_Access = group q_Access by ('Year', 'Month');\nq_Access = foreach q_Access generate 4 as 'Order', \"Sales Tool/Capabilities Usage\" as 'Objective', \"% Open opptys accessed by owners Monthly\" as 'Key Result', 'Year', 'Month', sum('B')/sum('A') as 'Perc';\n\nq3 = filter q by 'Contact.Role' == \"Business Decision Maker\";\nq3 = group q3 by ('Snapshot_Date_Year', 'Snapshot_Date_Month');\nq3 = foreach q3 generate 'Snapshot_Date_Year' as 'Year', 'Snapshot_Date_Month' as 'Month', 0 as 'A',unique('Id') as 'B';\nq_BusMaker = union q1, q3;\nq_BusMaker = group q_BusMaker by ('Year', 'Month');\nq_BusMaker = foreach q_BusMaker generate 1 as 'Order', \"Opportunity Management\" as 'Objective', \"% Business Decision Maker Defined\" as 'Key Result', 'Year', 'Month', sum('B')/sum('A') as 'Perc';\n\nq4 = filter q by 'Account_Plan.Number_of_Attachments__c' >= 1;\nq4 = group q4 by ('Snapshot_Date_Year', 'Snapshot_Date_Month');\nq4 = foreach q4 generate 'Snapshot_Date_Year' as 'Year', 'Snapshot_Date_Month' as 'Month', 0 as 'A',unique('AccountId') as 'B';\nq_AccountPlan = union q1, q4;\nq_AccountPlan = group q_AccountPlan by ('Year', 'Month');\nq_AccountPlan = foreach q_AccountPlan generate 3 as 'Order', \"Account Management - Intel-Led Account Plans in CRM\" as 'Objective', \"% Account Has Account Plan in CRM (Account ID)\" as 'Key Result', 'Year', 'Month', sum('B')/sum('C') as 'Perc';\n\nq_Updated = group q by ('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Id');\nq_Updated = foreach q_Updated generate 'Snapshot_Date_Year' as 'Year', 'Snapshot_Date_Month' as 'Month', unique(q.'Id') as 'A', max('Update.Update_Flag') as 'B';\nq_Updated = group q_Updated by ('Month');\nq_Updated = foreach q_Updated generate 4 as 'Order', \"Sales Tool/Capabilities Usage\" as 'Objective', \"% Open opptys updated monthly (focus areas)\" as 'Key Result', 'Year', 'Month', sum('B')/sum('A') as 'Perc';\n\nqa = load \"Account_Plan\";\nqb = group qa by ('LastModifiedDate_Year', 'LastModifiedDate_Month');\nqb = foreach qb generate 'LastModifiedDate_Year' as 'Year', 'LastModifiedDate_Month' as 'Month', unique('Account.Id') as 'A', 0 as 'B';\nqc = filter qa by 'Number_of_Attachments__c' >= 1;\nqc = group qc by ('LastModifiedDate_Year', 'LastModifiedDate_Month');\nqc = foreach qc generate 'LastModifiedDate_Year' as 'Year', 'LastModifiedDate_Month' as 'Month', 0 as 'A', unique('Account.Id') as 'B';\nq_Account = union qb, qc;\nq_Account = group q_Account by ('Year', 'Month');\nq_Account = foreach q_Account generate 3 as 'Order', \"Account Management - Intel-Led Account Plans in CRM\" as 'Objective', \"% Plans Updated in last 12 months\" as 'Key Result', 'Year', 'Month' as 'Month', sum('B')/sum('A') as 'Perc';\n\nqpush = filter q by 'Core_Push_Counter__c' > 0 and 'OpportunityProducts.Opportunity.CreatedDate' >= \"2023-01-01\"; \nqpush = foreach qpush generate 'Snapshot_Date_Year' as 'Year', 'Snapshot_Date_Month' as 'Month', unique(q.'Id') as 'A', case when 'Core_Push_Counter__c' > 3 and 'OpportunityProducts.Opportunity.CreatedDate' >= \"2023-01-01\" then unique(q.'Id') else 0 end as 'B';\nq_pushes = group qpush by ('Year', 'Month');\nq_pushes = foreach q_pushes generate 2 as 'Order', \"Opportunity Management\" as 'Objective', \"% Opportunities with more than 3 pushes\" as 'Key Result', 'Year', 'Month', sum('B')/sum('A') as 'Perc';\n\nqpast = foreach q generate 'Snapshot_Date_Year' as 'Year', 'Snapshot_Date_Month' as 'Month', unique(q.'Id') as 'A', case when 'unhealthy_past_due' == 1 then unique(q.'Id') else 0 end as 'B';\nq_pastdue = group qpast by ('Year', 'Month');\nq_pastdue = foreach q_pastdue generate 3 as 'Order', \"Opportunity Management\" as 'Objective', \"% Past Due Opportunities\" as 'Key Result', 'Year', 'Month', sum('B')/sum('A') as 'Perc';\n\n\nq_Final = union q_Access, q_Updated, q_pushes, q_pastdue, q_BusMaker,q_AccountPlan, q_Account;\nq_Final = order q_Final by 'Order';\nq_Final = group q_Final by ('Objective', 'Key Result', 'Year', 'Month');\nq_Final = foreach q_Final generate 'Objective', 'Key Result', 'Year' + \"-\" + 'Month' as 'YearMonth', sum('Perc') as '%';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"fixedColumnWidth":100,"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":false,"showRowIndexColumn":false,"verticalPadding":4},"type":"table"}},"Currents":{"broadcastFacet":true,"groups":[],"label":"Currents","numbers":[],"query":"q = load \"UsageTrending\";\nq = group q by all;\nq = foreach q generate toString(now(),\"yyyy\") as 'CurrentYear',toString(now(),\"MM\") as 'CurrentMonth';\nq = limit q 1;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasure