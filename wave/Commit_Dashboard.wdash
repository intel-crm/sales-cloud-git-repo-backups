 q_2 by 'OppForecastJoin.Core_Forecast__c';\nq_commit = foreach q_commit generate \"Forecast\" as 'Category', 'OppForecastJoin.Core_Forecast__c' as 'Field', sum('Opportunity.Amount') as 'Amount';\n\nresult = union q_won, q_commit;\nresult = group result by ('Category', 'Field');\nresult = foreach result generate result.'Category', result.'Field' as 'Status', sum(result.'Amount') as 'Amount';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"totalSumMode":"none","axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"stackvbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"split":["Status"],"trellis":[],"dimensionAxis":["Category"],"plots":["Amount"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"normalize":false,"valueType":"compactNumber","theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_12":{"broadcastFacet":true,"groups":[],"label":"CommitMetrics","numbers":[],"query":"q = load \"CommitOpportunityProducts\";\nq = filter q by '{{column(Account_Name_8.selection,[\"sales_manager\"]).asObject()}}'  in {{coalesce(column(Account_Name_5.selection, [\"Name\"]),'all').asString()}};\nq = filter q by '{{column(Account_Name_8.selection,[\"sales_rep\"]).asObject()}}'  in {{coalesce(column(Account_Name_6.selection, [\"Name\"]),'all').asString()}};\nq = filter q by '{{column(Account_Name_8.selection,[\"sales_manager\"]).asObject()}}'  in {{coalesce(column(Account_Name_5.selection, [\"Name\"]),'all').asString()}};\nq = filter q by '{{column(Account_Name_8.selection,[\"sales_rep\"]).asObject()}}'  in {{coalesce(column(Account_Name_6.selection, [\"Name\"]),'all').asString()}};\nq = filter q by '{{column(Account_Name_8.selection,[\"sales_manager\"]).asObject()}}'  in {{coalesce(column(Account_Name_5.selection, [\"Name\"]),'all').asString()}};\nq = filter q by '{{column(Account_Name_8.selection,[\"sales_rep\"]).asObject()}}'  in {{coalesce(column(Account_Name_6.selection, [\"Name\"]),'all').asString()}};\n\nwonMetric = filter q by 'Core_Status__c' in [\"Win Approved\", \"Production Win\", \"Production Lost\", \"Production Cancelled\"];\nwonMetric = filter wonMetric by 'KPIDateYear' in {{coalesce(column(KPIDateYear_2.selection, [\"select_year\"]),'all').asString()}};\nwonMetric = filter wonMetric by 'CoreKPIDateYearQuarter' in {{coalesce(column(CoreKPIDateYearQuart_1.selection, [\"quarter\"]),'all').asString()}};\nwonMetric = group wonMetric by ( 'OpportunityLineItem', 'OpportunityId');\nwonMetric = foreach wonMetric generate \"Won\" as 'CategoryStatus'\n, 'OpportunityId'\n, max('Opportunity.Amount') as 'WonAmount',\n0 as 'CommitAmount',\n0 as 'PendingAmount' ;\n\nwonMetric = group wonMetric by ( 'OpportunityId');\nwonMetric = foreach wonMetric generate  'CategoryStatus',\nmax('WonAmount') as 'WonAmount',\n0 as 'CommitAmount',\n0 as 'PendingAmount' ;\n\nwonMetric = group wonMetric by 'CategoryStatus';\nwonMetric = foreach wonMetric generate 'CategoryStatus',\nsum('WonAmount') as 'WonAmount',\n0 as 'CommitAmount',\n0 as 'PendingAmount' ;\n\n\npendingMetric = filter q by 'Opportunity.StageName' in [\"Define\", \"Design\", \"Develop\", \"Qualify\"];\npendingMetric = filter pendingMetric by 'KPIDateYear' in {{coalesce(column(KPIDateYear_2.selection, [\"select_year\"]),'all').asString()}};\npendingMetric = filter pendingMetric by 'CoreKPIDateYearQuarter' in {{coalesce(column(CoreKPIDateYearQuart_1.selection, [\"quarter\"]),'all').asString()}};\npendingMetric = group pendingMetric by ( 'OpportunityLineItem', 'OpportunityId');\npendingMetric = foreach pendingMetric generate \"Pending\" as 'CategoryStatus',\nOpportunityId, \n0 as 'WonAmount',\n0 as 'CommitAmount',\nmax('Opportunity.Amount') as 'PendingAmount' ;\n\npendingMetric = group pendingMetric by ('OpportunityId');\npendingMetric = foreach pendingMetric generate  'CategoryStatus',\n0 as 'WonAmount',\n0 as 'CommitAmount',\nmax('PendingAmount') as 'PendingAmount' ;\n\npendingMetric = group pendingMetric by 'CategoryStatus';\npendingMetric = foreach pendingMetric generate 'CategoryStatus',\n0 as 'WonAmount',\n0 as 'CommitAmount',\nsum('PendingAmount')  as 'PendingAmount' ;\n\n\ncommitMetric = filter q by 'CategoryStatus' in [\"Commit\"];\ncommitMetric = filter commitMetric by 'CategoryYear' in {{coalesce(column(KPIDateYear_2.selection, [\"select_year\"]),'all').asString()}};\ncommitMetric = filter commitMetric by 'CategoryQuarter' in {{coalesce(column(CoreKPIDateYearQuart_1.selection, [\"quarter\"]),'all').asString()}};\ncommitMetric = group commitMetric by ('OpportunityLineItem', 'OpportunityId');\ncommitMetric = foreach commitMetric generate \"Commit\" as 'CategoryStatus',\n'OpportunityId', \n0 as 'WonAmount',\nmax('OppForecastJoin.Core_Forecast_Amount__c')  as 'CommitAmount',\n0 as 'PendingAmount' ;\n\ncommitMetric = group commitMetric by ('OpportunityId');\ncommitMetric = foreach commitMetric generate  'CategoryStatus',\n0 as 'WonAmount',\nmax('CommitAmount')  as 'CommitAmount',\n0 as 'PendingAmount' ;\n\ncommitMetric = group commitMetric by 'CategoryStatus';\ncommitMetric = foreach commitMetric generate 'CategoryStatus',\n0 as 'WonAmount',\nsum('CommitAmount')   as 'CommitAmount',\n0 as 'PendingAmount' ;\n\nresult = union wonMetric, pendingMetric, commitMetric;\n\nresult =  group result by all;\nresult = foreach result generate sum('WonAmount') as 'WonAmount',\n sum('CommitAmount') as 'CommitAmount',\n sum('PendingAmount') as 'PendingAmount' ,\n  (sum('WonAmount')/sum('CommitAmount')) as 'PercantageToCommit',\n ( case when ( sum('WonAmount') >  sum('CommitAmount') ) then \"Achieved\" else  number_to_string(   (sum('PendingAmount') / ( sum('CommitAmount')-sum('WonAmount') ))   , \"#%\" )  end ) as 'Coverage2',\n     (  sum('PendingAmount') / ( sum('CommitAmount')-sum('WonAmount') )   )   as 'Coverage';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"totals":true,"verticalPadding":8},"type":"table"}},"Account_Name_2":{"broadcastFacet":true,"datasets":[{"name":"OpportunityForecastRegister"}],"isGlobal":false,"label":"Sales_Group","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Opportunity.Core_Sales_Group__c\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"b