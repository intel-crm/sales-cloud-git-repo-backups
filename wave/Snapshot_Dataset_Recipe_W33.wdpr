              "type" : "NUMBER",
              "scale" : 0,
              "precision" : 18
            }
          }
        } ]
      }
    },
    "TO_MEASURE3" : {
      "action" : "typeCast",
      "sources" : [ "FORMULA3" ],
      "schema" : {
        "fields" : [ {
          "name" : "first_decision_in_q_to_measure",
          "newProperties" : {
            "name" : "first_decision_in_q"
          }
        } ],
        "slice" : {
          "mode" : "DROP",
          "ignoreMissingFields" : true,
          "fields" : [ "first_decision_in_q" ]
        }
      },
      "parameters" : {
        "fields" : [ {
          "name" : "first_decision_in_q",
          "newProperties" : {
            "label" : "First Decision Date in Quarter",
            "name" : "first_decision_in_q_to_measure",
            "typeProperties" : {
              "type" : "NUMBER",
              "scale" : 0,
              "precision" : 18
            }
          }
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "TO_MEASURE3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "isPushfromQuarter",
          "label" : "Is Push",
          "formulaExpression" : "case \r\nwhen opp_current_decision_quarter > first_decision_in_q then 'Push' else null end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "opp_product_status",
          "label" : "Opportunity Product Status",
          "formulaExpression" : "case \r\n    when \"OpportunityProducts.Core_Status__c\" in ('Group Cancelled','Production Cancelled', 'Group Closed', 'Design Win', 'Production Win','Win Approved') \r\n    then 'Won'\r\n    when \"OpportunityProducts.Core_Status__c\" = 'Lost' \r\n    then 'Lost'\r\n     when \"OpportunityProducts.Core_Status__c\" in ('Cancelled', 'Cancelled ') or contains(\"OpportunityProducts.Core_Status__c\", 'Cancelled')\r\n    then 'Cancelled'\r\n    when isPushfromQuarter = 'Push'\r\n    then 'Push'\r\n    when \"OpportunityProducts.Core_At_Risk__c\" = 'true'\r\n    then 'At Risk'\r\n    else 'Open'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA14" : {
      "action" : "formula",
      "sources" : [ "FORMULA23" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "first_snap_of_quarter",
          "label" : "First Snapshot of Quarter",
          "formulaExpression" : "case when unix_snapshot = \"first_snap_decision.first_snapshot_of_quarter\" then 'First Snapshot of Quarter' else '-' end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA15" : {
      "action" : "formula",
      "sources" : [ "FORMULA14" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "first_snap_of_month",
          "label" : "First Snapshot of Month",
          "formulaExpression" : "case when unix_snapshot = \"first_snap_of_month.MIN_unix_snapshot\" then 'First Snapshot of the Month' else '-' end",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA16" : {
      "action" : "formula",
      "sources" : [ "TO_MEASURE2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "orig_quarter_decisiondate",
          "label" : "Original Decision Date of Quarter",
          "formulaExpression" : "\"PushSnap.MinquarterSnapforPush.KPI_Close_Date\"",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA17" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "calc_opp_status",
          "label" : "Opportunity Status",
          "formulaExpression" : "case \r\n    when StageName in ('Group Cancelled','Production Cancelled', 'Group Closed', 'Design Win', 'Production Win') \r\n    then 'Won'\r\n    when StageName = 'Lost' \r\n    then 'Lost'\r\n    when contains(StageName,'Cancelled')\r\n    then 'Cancelled'\r\n    when isPushfromQuarter = 'Push'\r\n    then 'Push'\r\n    when \"OpportunityProducts.Core_At_Risk__c\" = 'true'\r\n    then 'At Risk'\r\n    else 'Open'\r\nend\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA18" : {
      "action" : "formula",
      "sources" : [ "FORMULA21" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_past_due",
          "label" : "Unhealthy Past Due",
          "formulaExpression" : "case \r\n    when StageName in ('Define', 'Design', 'Develop', 'Group', 'Qualify')\r\n    and \"OpportunityProducts.Core_Status__c\" not in ('Win Submitted')\r\n    and datediff(Snapshot_Date, CloseDate) > 0 \r\n    then 1 \r\n    else 0 \r\nend ",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA19" : {
      "action" : "formula",
      "sources" : [ "FORMULA17" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_pushes",
          "label" : "Unhealthy_Pushes",
          "formulaExpression" : "case \r\n    when Core_Push_Counter__c > 3 \r\n    and year(\"OpportunityProducts.Opportunity.CreatedDate\") >= 2023\r\n    then 1\r\n    else 0\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA20" : {
      "action" : "formula",
      "sources" : [ "FORMULA19" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_no_products",
          "label" : "No Products",
          "formulaExpression" : "case \r\n    when Core_Product_Count__c = 0\r\n    then 1 \r\n    else 0\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA21" : {
      "action" : "formula",
      "sources" : [ "FORMULA20" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_qd",
          "label" : "Unhealthy Q&D",
          "formulaExpression" : "case \r\n    when StageName in ('Qualify','Define')\r\n    then 1 \r\n    else 0 \r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA22" : {
      "action" : "formula",
      "sources" : [ "FORMULA18" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "opportunity_unhealthy",
          "label" : "Opportunity Unhealthy",
          "formulaExpression" : "case \r\n    when unhealthy_past_due = 1\r\n    or unhealthy_pushes = 1\r\n    or unhealthy_qd = 1\r\n    or unhealthy_no_products = 1\r\n    then 1 \r\n    else 0\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA23" : {
      "action" : "formula",
      "sources" : [ "FORMULA22" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "num_unhealthy_attributes",
          "label" : "# Unhealthy Attributes",
          "formulaExpression" : "unhealthy_pushes + unhealthy_no_products + unhealthy_qd + unhealthy_past_due",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA24" : {
      "action" : "formula",
      "sources" : [ "FORMULA15" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "KPI_Decision_date",
          "label" : "KPI Decision Date",
          "formulaExpression" : "case \r\n    when \"OpportunityProducts.Core_KPI_Date__c\" is not null \r\n    then \"OpportunityProducts.Core_KPI_Date__c\"\r\n    else CloseDate\r\nend",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA26" : {
      "action" : "formula",
      "sources" : [ "FORMULA24" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "opp_sales_group_ordered",
          "label" : "Opportunity Sales Group Ordered",
          "formulaExpression" : "case \r\n    when opp_sales_group = 'Americas' \r\n    then '1.Americas'\r\n    when opp_sales_group = 'APJ'\r\n    then '2.APJ'\r\n    when opp_sales_group = 'EMEA'\r\n    then '3.EMEA'\r\n    when opp_sales_group = 'PRC'\r\n    then '4.PRC'\r\n    when opp_sales_group = 'GSA'\r\n    then '5.GSA'\r\n    when opp_sales_group = 'Other'\r\n    then '6.Other'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
