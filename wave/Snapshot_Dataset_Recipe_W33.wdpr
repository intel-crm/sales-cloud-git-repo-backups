    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "JOIN5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "opp_current_decision_quarter",
          "label" : "Current Decision Quarter",
          "formulaExpression" : "concat(year(CloseDate),quarter(CloseDate))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA16" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "first_decision_in_q",
          "label" : "First Decision Date in Quarter",
          "formulaExpression" : "concat(year(\"PushSnap.first_decision_date_of_quarter\"),quarter(\"PushSnap.first_decision_date_of_quarter\"))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "TO_MEASURE2" : {
      "action" : "typeCast",
      "sources" : [ "FORMULA2" ],
      "schema" : {
