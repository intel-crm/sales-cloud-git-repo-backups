{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"Forecast_Snapshot_with_Transforms_Secured\";\nq = filter q by 'Opportunity.Core_Opportunity_Coverage_Nm__c' in [\"Intel-Led Opportunity\"];\n--q = filter q by 'OppProd.OpportunityProductsHierarchy.OWNER_HIERARCHY_TXT_MvHierarchy' like  coalesce(\"%\"+ number_to_string( 10569278,  \"######\") + \"%\",\"%%\");\n q = filter q by 'OppProd.OpportunityProductsHierarchy.OWNER_HIERARCHY_TXT_MvHierarchy' in [\"10101938\"];  \nq = filter q by  'OppProd.Opportunity.Owner.Name'  in all;\n \nq = filter q by ('OpportunityProducts.Core_Status__c' not in [\"Cancelled\",\"Lost\"] || 'opp_status' is null) and ('StageName' not in [\"Cancelled\", \"Design Win\", \"Group\", \"Group Cancelled\", \"Group Closed\", \"Group Open\",\"Lost\", \"Production Cancelled\", \"Production Win\"] || 'StageName' is null) and (date('KPI_Decision_date_Year', 'KPI_Decision_date_Month', 'KPI_Decision_date_Day') in [\"3 quarters ago\"..\"current quarter\"] or (date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"3 quarters ago\"..\"current quarter\"] and 'Core_Product_Count__c' == 0));\nq_opps_unhealthy = filter q by 'opportunity_unhealthy' == 1;\nq = cogroup q by ('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Week', 'Snapshot_Date_Month', 'Snapshot_Date_Day') full, q_opps_unhealthy by ('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Week', 'Snapshot_Date_Month', 'Snapshot_Date_Day');\nq = foreach q generate coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') as 'Snapshot_Date_Year', coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') + \"0\" + coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') as 'YearQuarterDate', coalesce(q.'Snapshot_Date_Week', q_opps_unhealthy.'Snapshot_Date_Week') as 'Snapshot_Date_Week', coalesce(q.'Snapshot_Date_Month', q_opps_unhealthy.'Snapshot_Date_Month') as 'Snapshot_Date_Month', coalesce(q.'Snapshot_Date_Day', q_opps_unhealthy.'Snapshot_Date_Day') as 'Snapshot_Date_Day', coalesce(unique(q.'Id'),0) as 'count_opps', coalesce(unique(q_opps_unhealthy.'Id'),0) as 'opps_unhealthy';\n \nq = filter q by 'YearQuarterDate' in [\"202501\"];\n \nq = group q by ('Snapshot_Date_Year', 'YearQuarterDate', 'Snapshot_Date_Week', 'Snapshot_Date_Month', 'Snapshot_Date_Day');\nq = foreach q generate 'Snapshot_Date_Year' + \"-\" +  'Snapshot_Date_Month' as 'year_month', 'Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day', first(count_opps) as 'count_opps', first(opps_unhealthy) as 'opps_unhealthy', 1-(sum(opps_unhealthy)/sum(count_opps)) as 'confidence', 1-(sum(sum(opps_unhealthy)) over ([..] partition by all)/sum(sum(count_opps)) over ([..] partition by all)) as 'overall_label', (1-(sum(sum(opps_unhealthy)) over ([..] partition by all)/sum(sum(count_opps)) over ([..] partition by all)))*100 as 'overall_line', sum(count_opps)-sum(opps_unhealthy) as opps_healthy;\n \nq = group q by ('year_month');\nq = foreach q generate 'year_month',max('confidence') as 'confidence';\n \nq = order q by ('year_month' asc);\n","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true}},"widgets":{"saql_chart":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","exploreLink":true,"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["year_month"],"plots":["confidence"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","step":"saql","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}}}