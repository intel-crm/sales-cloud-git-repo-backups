Solution_Industry.Solution_technology.SOLUTION_NM\\\"\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Solution_Name\",\"label\":\"Solution Name\",\"type\":\"TEXT\"}]}},\"FORMULA14\":{\"sources\":[\"JOIN10\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n    when \\\"Aggregate2.MAX_VBSAIlen\\\" = 6 then 'VBS/AI'\\r\\n    when \\\"Aggregate2.MAX_VBSAIlen\\\" = 3 then 'VBS'\\r\\n    when \\\"Aggregate2.MAX_VBSAIlen\\\" = 2 then 'AI'\\r\\n    else 'Other'\\r\\nend\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"VBS_AI\",\"label\":\"Opp VBS/AI\",\"type\":\"TEXT\"}]}},\"FORMULA8\":{\"sources\":[\"FORMULA7\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case when Core_VBS_Status__c in ('Pending', 'SOAR 1 Qualified', 'Approved') then 'VBS' else null end\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"isVBS\",\"label\":\"Is VBS\",\"type\":\"TEXT\"}]}},\"FORMULA15\":{\"sources\":[\"FORMULA14\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n    when  StageName in ('Lost','Cancelled')\\r\\n    then 'Gray'\\r\\n    when \\\"Aggregate0.MIN_risk_num_to_measure\\\" = 1 then 'Red'\\r\\n    when \\\"Aggregate0.MIN_risk_num_to_measure\\\" = 2 \\r\\n    then 'Orange' \\r\\n    when \\\"Aggregate0.MIN_risk_num_to_measure\\\" = 3 \\r\\n    then 'Yellow'\\r\\n    else 'Green' \\r\\nend \",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Status_RYOG\",\"label\":\"Status\",\"type\":\"TEXT\"}]}},\"FORMULA9\":{\"sources\":[\"FORMULA8\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n    when (((\\r\\n        (contains(\\\"OpportunityProducts.Product2.Name\\\", 'Gaudi') or contains(\\\"OpportunityProducts.Product2.Name\\\", 'GPU Flex') or contains(\\\"OpportunityProducts.Product2.Name\\\", 'Developer Cloud')) and Core_ha