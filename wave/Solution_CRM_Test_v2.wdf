__c\\\" is null then '-' else array_join(\\\"op.Core_Risk_Reason1__c\\\", ',')end\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"RiskReason\",\"label\":\"Risk Reason\",\"type\":\"TEXT\"}]}},\"FORMULA19\":{\"sources\":[\"FORMULA18\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case when \\\"op.Core_Risk_Detail__c\\\" is null then '-' else array_join(\\\"op.Core_Risk_Detail__c\\\", ',') end\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"riskdetail\",\"label\":\"Risk Detail\",\"type\":\"TEXT\"}]}},\"FORMULA10\":{\"sources\":[\"FORMULA9\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n    when isAI = 'AI' and isVBS = 'VBS' \\r\\n    then 'VSB/AI' \\r\\n    when isAI = 'AI' \\r\\n    then 'AI' \\r\\n    when isVBS = 'VBS' \\r\\n    then 'VBS' \\r\\nelse '-' end\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"VBS_AI2\",\"label\":\"solution VBS/AI\",\"type\":\"TEXT\"}]}},\"FORMULA12\":{\"sources\":[\"FORMULA10\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"char_length(VBS_AI2)\",\"defaultValue\":\"\",\"precision\":10,\"name\":\"VBSAIlen\",\"scale\":0,\"label\":\"VBSAI Len\",\"type\":\"NUMBER\"}]}},\"FORMULA0\":{\"sources\":[\"JOIN6\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"\\\"Name\\\"\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Opportunity_Name\",\"label\":\"Opportunity Name\",\"type\":\"TEXT\"}]}},\"FORMULA1\":{\"sources\":[\"FORMULA0\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"(case when StageName = 'Qualify' then '1 - Qualify' when StageName = 'Define' then '2 - Define' when StageName = 'Develop' then '3 - Develop' when StageName = 'Design' then '4 - Design' when StageName = 'Design Win' then '5 - Design Win' when StageName = 'Production