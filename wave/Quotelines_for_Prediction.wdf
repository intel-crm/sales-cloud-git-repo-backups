["{\"nodes\":{\"augment_productwithquotelines\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"Pricing_Product_Nm__c\"],\"operation\":\"LookupMultiValue\",\"relationship\":\"join_quotelineswithproduct\",\"rightKey\":[\"Id\"],\"rightSelect\":[\"Id\",\"Name\"]},\"sources\":[\"tenderquotelines\",\"extract_product\"]},\"filter_quotelinessubmittedin180days\":{\"action\":\"filter\",\"parameters\":{\"saqlFilter\":\"date('Pricing_Last_Submitted_Date_dt__c_Year', 'Pricing_Last_Submitted_Date_dt__c_Month', 'Pricing_Last_Submitted_Date_dt__c_Day') in [\\\"180 days ago\\\" .. \\\"current day\\\"]\"},\"sources\":[\"filter_quotelinestatuses\"]},\"tenderquotelines\":{\"action\":\"filter\",\"parameters\":{\"filter\":\"Pricing_Quote_Program_Nm__c:EQ:Tender\"},\"sources\":[\"extract_quotelines\"]},\"extract_product\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"Id\"},{\"name\":\"Name\"}],\"object\":\"Product2\"}},\"extract_quotelines\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"Pricing_Approved_End_Date_Dt__c\"},{\"name\":\"Pricing_Approved_Start_Date_Dt__c\"},{\"name\":\"Pricing_ECAP_Price_Amt__c\"},{\"name\":\"Pricing_Project_Nm__c\"},{\"name\":\"Pricing_Status_Nm__c\"},{\"name\":\"Pricing_OEM_Account_Nm__c\"},{\"name\":\"Pricing_Quote_Line_Number__c\"},{\"name\":\"SBQQ__Quote__c\"},{\"name\":\"Pricing_Product_Nm__c\"},{\"name\":\"Pricing_Approved_Unit_Qty__c\"},{\"name\":\"Pricing_Last_Submitted_Date_dt__c\"},{\"name\":\"Pricing_Quote_Program_Nm__c\"},{\"name\":\"Pricing_Other_Product_Nm__c\"},{\"name\":\"Id\"},{\"name\":\"Pricing_EndCustomer_Nm__c\"},{\"name\":\"SBQQ__ProductName__c\"},{\"name\":\"Pricing_Server_Deal_Type_Nm__c\"},{\"name\":\"Pricing_Group_Type_nm__c\"},{\"name\":\"Pricing_End_Date_dt__c\"},{\"name\":\"Pricing_UnifiedEndCustomer__c\"},{\"name\":\"Pricing_Meet_Comp_Price_Amt__c\"},{\"name\":\"Pricing_Program_Type_Nm__c\"},{\"name\":\"Pricing_New_Change_Request_cb__c\"},{\"name\":\"Pricing_Req_Discounted_Unit_Price__c\"},{\"name\":\"Pricing_Request_Discount_Unit_Price_qty__c\"},{\"name\":\"Pricing_Competetor_Product__c\"},{\"name\":\"Pricing_Revised_Pricing_Start_Date_dt__c\"},{\"name\":\"Pricing_Region_Nm__c\"},{\"name\":\"Pricing_End_Customer_Country__c\"},{\"name\":\"Pricing_Billing_End_Date_Dt__c\"},{\"name\":\"Pricing_RegionQL_Nm__c\"},{\"name\":\"Pricing_Billing_Start_Date_Dt__c\"},{\"name\":\"Pricing_Competitor_OEM_Nm__c\"},{\"name\":\"Pricing_New_Quantity_qty__c\"},{\"name\":\"Pricing_CPUs_per_system_qty__c\"},{\"name\":\"Pricing_Comp_CPUs_per_system_Cnt__c\"}],\"object\":\"SBQQ__QuoteLine__c\"}},\"Register_QuoteLineDataforPrediction\":{\"action\":\"register\",\"parameters\":{\"label\":\"Quote Line Records for Model\",\"name\":\"Quote_Line_Records_for_Model\"},\"sources\":[\"compute_increasedEcapField\"]},\"filter_quotelinestatuses\":{\"action\":\"filter\",\"parameters\":{\"filter\":\"Pricing_Status_Nm__c:EQ:Pending Intel Field Review|Pending Further Intel Review|Approved|Won|Lost|Cancelled\"},\"sources\":[\"filterout_writeInProducts\"]},\"compute_increasedEcapField\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"IncreasedECAPPrice\",\"name\":\"IncreasedECAPPrice\",\"precision\":18,\"saqlExpression\":\"Pricing_ECAP_Price_Amt__c + (Pricing_ECAP_Price_Amt__c * 0.02)\",\"scale\":2,\"type\":\"Numeric\"}],\"mergeWithSource\":true},\"sources\":[\"filter_quotelinessubmittedin180days\"]},\"filterout_writeInProducts\":{\"action\":\"filter\",\"parameters\":{\"filter\":\"join_quotelineswithproduct.Name:N:Write In Product\"},\"sources\":[\"augment_productwithquotelines\"]}}}",null]