          "label" : "Manager Formula",
          "formulaExpression" : "'Name' ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA14" : {
      "action" : "formula",
      "sources" : [ "FORMULA13" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Manager__c_formula_formula",
          "label" : "Manager Formula Formula",
          "formulaExpression" : "'Core_Manager__c'",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "JOIN5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula",
          "label" : "Partner Formula",
          "formulaExpression" : "(case  when startsWith('Core_Sales_Groups__c', 'EMEA') \r\n      then 'EMEA'\r\n      when 'Core_Sales_Groups__c' = 'Global Accounts Sales Group' then 'GSA' \r\n      when startsWith('Core_Sales_Groups__c', 'APJ') then 'APJ' \r\n      when startsWith('Core_Sales_Groups__c', 'Americas' ) then 'Americas' \r\n      when startsWith('Core_Sales_Groups__c', 'PRC') then 'PRC' \r\n      else 'Other'\r\nend)\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Core_Partner__c_formula_formula",
          "label" : "Partner Formula Formula",
          "formulaExpression" : "(case \r\n     when 'Core_Product_Count__c' = 0 then 1  \r\nelse 0\r\nend)",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Core_Partner__c_formula1",
          "label" : "Partner Formula",
          "formulaExpression" : "(case \r\n      when 'StageName' = 'Qualify' or  'StageName' = 'Define'  then 1 \r\n else 0\r\nend)",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula2",
          "label" : "Partner Formula",
          "formulaExpression" : "(case \r\n when 'OpportunityProducts.Opportunity.Core_Opp_Strategic_Opportunity__c' = 'true' then 'true'\r\nelse 'false'\r\nend)",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Core_Partner__c_formula2_formula",
          "label" : "Partner Formula Formula",
          "formulaExpression" : "(case\r\n    when 'Core_Push_Counter__c' >3 then 1 \r\n     else 0\r\nend)",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA10" : {
      "action" : "formula",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula3",
          "label" : "Partner Formula",
          "formulaExpression" : "'Name'",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA11" : {
      "action" : "formula",
      "sources" : [ "FORMULA16" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula3_formula",
          "label" : "Partner Formula Formula",
          "formulaExpression" : "'CloseDate_Year'",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA12" : {
      "action" : "formula",
      "sources" : [ "FORMULA11" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula3_formula_formula",
          "label" : "Partner Formula Formula Formula",
          "formulaExpression" : "(case when 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '1' then '01' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '2' then '02' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '3' then '03' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '4' then '04' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '5' then '05' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '6' then '06' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '7' then '07' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '8' then '08' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '9' then '09' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '10' then '10' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '11' then '11' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '12' then '12'\r\nend)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA9" : {
      "action" : "formula",
      "sources" : [ "FORMULA12" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CloseDate_mmddyyyy",
          "label" : "CloseDate_mmddyyyy",
          "formulaExpression" : "concat(substr('CloseDate', 6, 2),'/',substr('CloseDate', 9, 2),'/',substr('CloseDate', 1, 4))",
          "precision" : 40,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA9" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CloseDate_YearQuarter",
          "label" : "CloseDate_YearQuarter",
          "formulaExpression" : "concat('CloseDate_Year','0','CloseDate_Quarter') ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA15" : {
      "action" : "formula",
      "sources" : [ "FORMULA10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_pastdue",
          "label" : "unhealthy_pastdue",
          "formulaExpression" : "(case \r\n      when 'Core_Opportunity_Past_Due__c' = 'Past Due' and 'StageName' in ('Define', 'Design', 'Develop', 'Group', 'Qualify')  then 1  else 0\r\nend)",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA16" : {
      "action" : "formula",
      "sources" : [ "FORMULA15" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy",
          "label" : "unhealthy",
          "formulaExpression" : "( case\r\n     when 'Core_Product_Count__c' = 0 then 1     \r\n      when 'StageName' = 'Qualify' or  'StageName' = 'Define'  then 1 \r\n      when 'Core_Opportunity_Past_Due__c' = 'Past Due' and 'StageName' in ('Define', 'Design', 'Develop', 'Group', 'Qualify')  then 1 \r\n      when 'Core_Push_Counter__c' >3 then 1 \r\n      else 0\r\nend)",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA27" : {
      "action" : "formula",
      "sources" : [ "FORMULA8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "opp_age",
          "label" : "Opportunity Age",
          "formulaExpression" : "datediff(\"OpportunityProducts.Opportunity.CloseDate\", \"OpportunityProducts.Opportunity.CreatedDate\")",
          "precision" : 18,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
