 then \"09\" \nwhen  'current_month' ==  \"06\" then \"10\"\nwhen  'current_month' ==  \"07\" then \"11\"\nwhen  'current_month' ==  \"08\" then \"12\"\nwhen  'current_month' ==  \"09\" then \"01\"\nwhen  'current_month' ==  \"10\" then \"02\"\nwhen  'current_month' ==  \"11\" then \"03\"\nwhen  'current_month' ==  \"12\" then \"04\"end as 'last8_m'\n\n,case when  'current_month' ==  \"01\" then \"04\"\nwhen  'current_month' ==  \"02\" then \"05\"\nwhen  'current_month' ==  \"03\" then \"06\"\nwhen  'current_month' ==  \"04\" then \"07\"\nwhen  'current_month' ==  \"05\" then \"08\" \nwhen  'current_month' ==  \"06\" then \"09\"\nwhen  'current_month' ==  \"07\" then \"10\"\nwhen  'current_month' ==  \"08\" then \"11\"\nwhen  'current_month' ==  \"09\" then \"12\"\nwhen  'current_month' ==  \"10\" then \"01\"\nwhen  'current_month' ==  \"11\" then \"02\"\nwhen  'current_month' ==  \"12\" then \"03\"end as 'last9_m'\n,case when  'current_month' ==  \"01\" then \"03\"\nwhen  'current_month' ==  \"02\" then \"04\"\nwhen  'current_month' ==  \"03\" then \"05\"\nwhen  'current_month' ==  \"04\" then \"06\"\nwhen  'current_month' ==  \"05\" then \"07\" \nwhen  'current_month' ==  \"06\" then \"08\"\nwhen  'current_month' ==  \"07\" then \"09\"\nwhen  'current_month' ==  \"08\" then \"10\"\nwhen  'current_month' ==  \"09\" then \"11\"\nwhen  'current_month' ==  \"10\" then \"12\"\nwhen  'current_month' ==  \"11\" then \"01\"\nwhen  'current_month' ==  \"12\" then \"02\"end as 'last10_m'\n,case when  'current_month' ==  \"01\" then \"02\"\nwhen  'current_month' ==  \"02\" then \"03\"\nwhen  'current_month' ==  \"03\" then \"04\"\nwhen  'current_month' ==  \"04\" then \"05\"\nwhen  'current_month' ==  \"05\" then \"06\" \nwhen  'current_month' ==  \"06\" then \"07\"\nwhen  'current_month' ==  \"07\" then \"08\"\nwhen  'current_month' ==  \"08\" then \"09\"\nwhen  'current_month' ==  \"09\" then \"10\"\nwhen  'current_month' ==  \"10\" then \"11\"\nwhen  'current_month' ==  \"11\" then \"12\"\nwhen  'current_month' ==  \"12\" then \"01\"end as 'last11_m';\n\nmonth1 = foreach months generate  'Manager_nm', 'current_year'  as 'Snapshot_Date_Year', 'current_month' as 'Snapshot_Date_Month' ;\nmonth2 = foreach months generate  'Manager_nm', 'm2_year' as 'Snapshot_Date_Year', 'last_m' as 'Snapshot_Date_Month' ;\nmonth3 = foreach months generate  'Manager_nm', 'm3_year' as 'Snapshot_Date_Year','last2_m' as 'Snapshot_Date_Month' ;\nmonth4 = foreach months generate  'Manager_nm', 'm4_year' as 'Snapshot_Date_Year','last3_m' as 'Snapshot_Date_Month' ;\nmonth5 = foreach months generate  'Manager_nm', 'm5_year' as 'Snapshot_Date_Year','last4_m' as 'Snapshot_Date_Month' ;\nmonth6 = foreach months generate  'Manager_nm', 'm6_year' as 'Snapshot_Date_Year','last5_m'  as 'Snapshot_Date_Month' ;\nmonth7 = foreach months generate  'Manager_nm', 'm7_year' as 'Snapshot_Date_Year','last6_m'  as 'Snapshot_Date_Month' ;\nmonth8 = foreach months generate  'Manager_nm', 'm8_year' as'Snapshot_Date_Year','last7_m' as 'Snapshot_Date_Month' ;\nmonth9 = foreach months generate  'Manager_nm', 'm9_year' as'Snapshot_Date_Year','last8_m' as 'Snapshot_Date_Month' ;\nmonth10= foreach months generate  'Manager_nm', 'm10_year' as 'Snapshot_Date_Year','last9_m' as 'Snapshot_Date_Month' ;\nmonth11 = foreach months generate 'Manager_nm', 'm11_year' as 'Snapshot_Date_Year','last10_m' as 'Snapshot_Date_Month' ;\nmonth12= foreach months generate  'Manager_nm', 'm12_year' as  'Snapshot_Date_Year','last11_m' as 'Snapshot_Date_Month' ;\nmonths = union month1,month2,month3,month4,month5,month6,month7,month8,month9,month10,month11,month12;\nmonths = group months by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Month');\nmonths = foreach months generate  'Manager_nm','Snapshot_Date_Year','Snapshot_Date_Month' ;\n\nq_accountp_Snapshot= filter q_accountp_Snapshot by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n \nq_accountp_Snapshot = filter q_accountp_Snapshot by 'Core_Account_Primary_Coverage__c' matches \"Intel\" ;\nq_accountp_Snapshot = filter q_accountp_Snapshot by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\n\nq_G_Snapshot = foreach q_accountp_Snapshot generate case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then \n 'Id' else \"\" end as 'Id', case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'Id' else \"\" end as 'UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\nq_G_Snapshot = group q_G_Snapshot by ('Id','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_G_Snapshot = foreach q_G_Snapshot generate 'Id' as 'Id', case when  'Id'== \"\" then null else unique('Id')   end  as 'UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\nq_G_Snapshot = group q_G_Snapshot by ('Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_G_Snapshot = foreach q_G_Snapshot generate case when sum('UCD_G') == null then null  else sum('UCD_G')  end as 'UCD_G',0 as 'UCD_A','Snapshot_Date_Year','Snapshot_Date_Month';\n\n\nq_A_Snapshot = filter q_accountp_Snapshot by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_A_Snapshot = foreach q_A_Snapshot generate case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'Id' else \"\" end as 'Id', unique('Id') as 'UCD_A','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\nq_A_Snapshot = group q_A_Snapshot by ('Id','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_A_Snapshot = foreach q_A_Snapshot generate 'Id' as 'Id', case when 'Id' == \"\" then null else unique('Id') end as 'UCD_A','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\nq_A_Snapshot = group q_A_Snapshot by ('Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_A_Snapshot = foreach q_A_Snapshot generate 0 as 'UCD_G',case when sum('UCD_A') == 0 then 0 else sum('UCD_A')  end as 'UCD_A','Snapshot_Date_Year','Snapshot_Date_Month';\n\nq_account_Snapshot = union q_G_Snapshot,q_A_Snapshot;\nq_account_Snapshot = group q_account_Snapshot by ('Snapshot_Date_Year','Snapshot_Date_Month');\nq_account_Snapshot = foreach q_account_Snapshot generate max('UCD_G') as 'UCD_G', max('UCD_A') as 'UCD_A',case when sum('UCD_A')/sum('UCD_G')  is null then null else  sum('UCD_A')/sum('UCD_G') end as 'metric','Snapshot_Date_Year','Snapshot_Date_Month';\n\nq_accplan_Snapshot  = foreach q_account_Snapshot  generate   coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n,'Snapshot_Date_Year'\n, 'Snapshot_Date_Month' \n,max('metric')  as 'Metric'\n, max('UCD_A') as 'UCD_A'\n, max('UCD_G') as 'UCD_G'; \n\nq_accplan_Snapshot = union q_accplan_Snapshot,months;\n\nq_accplan_Snapshot = group q_accplan_Snapshot by ('Manager_nm', 'Snapshot_Date_Year','Snapshot_Date_Month' );\nq_accplan_Snapshot = foreach q_accplan_Snapshot generate  'Manager_nm'\n, case when 'Snapshot_Date_Year' is null then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") + 'Snapshot_Date_Month' else 'Snapshot_Date_Year'  + \"-\" + 'Snapshot_Date_Month' end as 'Month'\n,case when max('Metric') is null then null else max('Metric') end as 'Snapshot'\n,null as 'Actual'\n, max('UCD_A') as 'UCD_A'\n, max('UCD_G') as 'UCD_G'; \n\n\n--Account\nq_accountp = load \"ManagerMetric_AccountPlan\";\nq_accountp= filter q_accountp by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\"  || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n \n\nq_accountp = filter q_accountp by 'Core_Account_Primary_Coverage__c' matches \"Intel\" ;\nq_accountp = filter q_accountp by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\n--q_accountp= filter q_accountp by  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\n\nq_G = foreach q_accountp generate case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then \n 'Id' else \"\" end as 'Id', case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'Id' else \"\" end as 'UCD_G','Core_Account_Level__c';\nq_G = group q_G by ('Id','Core_Account_Level__c');\nq_G = foreach q_G generate 'Id' as 'Id', case when  'Id'== \"\" then null else unique('Id')   end  as 'UCD_G','Core_Account_Level__c';\nq_G = group q_G by all;\nq_G = foreach q_G generate case when sum('UCD_G') == null then null  else sum('UCD_G')  end as 'UCD_G',0 as 'UCD_A';\n\n\nq_A = filter q_accountp by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_A = foreach q_A generate case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'Id' else \"\" end as 'Id', unique('Id') as 'UCD_A','Core_Account_Level__c';\nq_A = group q_A by ('Id','Core_Account_Level__c');\nq_A = foreach q_A generate 'Id' as 'Id', case when 'Id' == \"\" then null else unique('Id') end as 'UCD_A','Core_Account_Level__c';\nq_A = group q_A by all;\nq_A = foreach q_A generate 0 as 'UCD_G',case when sum('UCD_A') == null then null else sum('UCD_A')  end as 'UCD_A';\n\nq_account = union q_G,q_A;\nq_account = group q_account by all;\nq_account = foreach q_account generate max('UCD_G') as 'UCD_G', max('UCD_A') as 'UCD_A',case when sum('UCD_A')/sum('UCD_G')  is null then null else  sum('UCD_A')/sum('UCD_G') end as 'metric';\n\nq_accplan  = foreach q_account  generate   coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n,date_to_string(now(), \"yyyy-MM\") as 'Month'\n,sum('metric') as 'Actual'\n,null as 'Snapshot'\n, max('UCD_A') as 'UCD_A'\n, max('UCD_G') as 'UCD_G'; \n\nq_accplan_Snapshot = union q_accplan_Snapshot,q_accplan;\n\nq_accplan_Snapshot = group q_accplan_Snapshot by ('Manager_nm', 'Month' );\nq_accplan_Snapshot = foreach q_accplan_Snapshot generate  'Manager_nm'\n,  'Month'\n,case when date_to_string(now(), \"yyyy-MM\") == 'Month'  then max('Actual') when max('Snapshot') is null then null   else max('Snapshot') end as 'Metric_n'\n,case  when date_to_string(now(), \"yyyy-MM\") == 'Month' &&  max('Actual') is null then \"No Accounts\" when date_to_string(now(), \"yyyy-MM\") == 'Month'  then  number_to_string( max('Actual') ,\"#%\")  when  substr('Month', 1, 4) == \"2024\" then \"No Historical Data\"  when max('Snapshot') is null  then \"No Accounts\"when max('Snapshot') == 0 || max('Actual') == 0 then \"0%\" else   number_to_string(max('Snapshot'),\"##%\")  end as 'Metric';\n\n\n    \n--q_accplan_Snapshot = group q_accplan_Snapshot by ('Manager_nm', 'Month');\nq_accplan_Snapshot = foreach q_accplan_Snapshot generate  'Manager_nm'\n,  'Month'\n,case when 'Metric' == \"%\" then \"0%\" when 'Metric' is null then \"NA\" else 'Metric' end as 'Metric'\n, case when  sum('Metric_n') < 0.499  then \"#c81326\"\n    when ( sum('Metric_n')> 0.499 && sum('Metric_n') < 0.999) then \"#ffe500\" \n    when (  sum('Metric_n')>= 0.999 ) then \"#9fd541\" end as 'color'\n, case when  sum('Metric_n') < 0.499  then \"#ffffff\"\n    when ( sum('Metric_n')> 0.499 && sum('Metric_n') < 0.999) then \"#000000\" \n    when (  sum('Metric_n')>= 0.999 ) then \"#000000\" end as 'text_color';\n\nq_accplan_Snapshot = order q_accplan_Snapshot by  'Month'  asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager_nm","Month","Metric"],"customBulkActions":[],"fixedColumnWidth":87,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_10":{"broadcastFacet":true,"groups":[],"label":"lens_10","numbers":[],"query":"--Opportunity Weekly Snapshot Updates\nq_UpOpp_Week_Snapshot= load \"SnapshotDS25\";\n\n\nweeks = filter q_UpOpp_Week_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"12 weeks ago\"..\"current day\"];\nweeks = group weeks by ('Snapshot_Date_Year', 'Snapshot_Date_Week');\n\nweeks =  foreach q_UpOpp_Week_Snapshot generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm', 'Snapshot_Date_Year' as 'Snapshot_Date_Year', 'Snapshot_Date_Week' as 'Snapshot_Date_Week';\n\n--Update last week Snapshot\nq_UpOpp_Week_SnapshotW = foreach q_UpOpp_Week_Snapshot generate  \ncase \n    when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"1 quarter ago\"..\"1 quarter ago\"] && 'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'OPPORTUNITYID' end as 'OpptyId_Qrt', \ncase \n    when  date('LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day') in [\"6 days ago\"..\"current day\"] && 'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'OPPORTUNITYID' end as 'OpptyId_Wk'\n,'Snapshot_Date_Year'\n,'Snapshot_Date_Week';\n\nq_UpOpp_Week_SnapshotW = foreach q_UpOpp_Week_SnapshotW generate \n    case \n        when 'OpptyId_Wk' is null then 0 else unique('OpptyId_Wk') end as 'OpptyId_Wk',\n    case \n        when 'OpptyId_Qrt' is null then 0 else unique('OpptyId_Qrt') end as 'OpptyId_Qrt'\n    ,'Snapshot_Date_Year'\n    , 'Snapshot_Date_Week';\n\nq_UpOpp_Week_SnapshotW = union q_UpOpp_Week_SnapshotW,weeks;\n\nq_UpOpp_Week_SnapshotW = group q_UpOpp_Week_SnapshotW by ('Snapshot_Date_Year','Snapshot_Date_Week','OpptyId_Wk' ,'OpptyId_Qrt');\nq_UpOpp_Week_SnapshotW = foreach q_UpOpp_Week_SnapshotW generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  as 'Manager_wwid'\n,'Snapshot_Date_Year'+\"-\"+'Snapshot_Date_Week' as 'Week'\n,case when 'OpptyId_Wk' is null && 'OpptyId_Qrt' is null  then 0 else 'OpptyId_Wk'/'OpptyId_Qrt' end as 'Metric';\n\n\nq_UpOpp_Week_SnapshotW = group q_UpOpp_Week_SnapshotW by ('Manager_nm','Week');\nq_UpOpp_Week_SnapshotW = foreach q_UpOpp_Week_SnapshotW generate 'Manager_nm'\n,'Week' as 'Week'\n,case when max('Metric') is null then 0 else max('Metric') end  as 'Metric'\n, case when ( sum('Metric') < 0.399 ) then \"#c81326\"\n    when ( sum('Metric')> 0.399 && sum('Metric') < 0.799 ) then \"#ffe500\" \n    when ( sum('Metric')>= 0.799 ) then \"#9fd541\"\n    when ( sum('Metric') is null ) then \"#c81326\" end as 'color';\nq_UpOpp_Week_SnapshotW = order q_UpOpp_Week_SnapshotW by 'Week' asc;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager_nm","Week","Metric"],"customBulkActions":[],"fixedColumnWidth":87,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_1":{"broadcastFacet":true,"groups":[],"label":"lens_1","numbers":[],"query":"-- ================\n---Confidence\n-- ================\nq_confidence = load \"ManagerConfidenceMetric\"; \n\nq_confidence= filter q_confidence by 'User.Id' ==  \"$User.Id\" ||  'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'User.MetricsOpe.ID'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID2'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID3'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID4'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID5'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID6'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID7'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID8'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID9' matches \"!{User.Id}\";\nq_confidence = filter q_confidence by 'Core_Opportunity_Coverage_Nm__c' == \"Intel-Led Opportunity\";\nq_confidence= filter q_confidence by  'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) ;--\"!{User.Id}\" ;\nq_confidence = filter q_confidence by 'Confidence.op.Core_Status__c' not in  [\"Cancelled\",\"Lost\"];\nq_confidence = filter q_confidence by (date('Confidence.op.Core_KPI_Date__c_Year', 'Confidence.op.Core_KPI_Date__c_Month', 'Confidence.op.Core_KPI_Date__c_Day') in [\"3 quarters ago\"..\"current quarter\"] or  date('Confidence.CloseDate_Year', 'Confidence.CloseDate_Month', 'Confidence.CloseDate_Day')  in [\"3 quarters ago\"..\"current quarter\"] ) ;\n\n\n\nq_confidence = foreach q_confidence generate    coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',case when 'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  then 'Confidence.OpportunityProducts.Name' else null end as 'Confidence.op.Name', case when 'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  then  'Confidence.Name' else null end as 'Name', case when 'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  then  'Confidence.Id' else null end as 'Confidence.Id' ,case when 'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  then   'Confidence.OpportunityProducts.Product2Id' else null end as 'Confidence.OpportunityProducts.Product2Id', case when 'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  then 'Confidence.unhealthy' else null end as 'Confidence.unhealthy';\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm','Confidence.Id' , 'Confidence.unhealthy');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm','Confidence.Id'  , max('Confidence.unhealthy') as 'unhealthy_total' ;\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm');\nq_confidence = foreach q_confidence generate 'Manager_nm'\n, \"Confidence Score\" as 'Metric Name'\n,case when sum('unhealthy_total') is null then null else (1- (sum('unhealthy_total') / count()) ) end   as 'Actual'\n,null as 'Snapshot';\n\nconfidence_snapshot = load \"Forecast_Snapshot_with_Transforms_Secured\";\nconfidence_snapshot= filter confidence_snapshot by 'OppAccountUser.Id' ==  \"$User.Id\" ||  'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nconfidence_snapshot = filter confidence_snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 quarter ago\"..\"1 quarter ago\"] ;\nconfidence_snapshot = filter confidence_snapshot by  'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nconfidence_snapshot = filter confidence_snapshot by 'Opportunity.Core_Opportunity_Coverage_Nm__c' in [\"Intel-Led Opportunity\"];\nconfidence_snapshot = filter confidence_snapshot by ('OpportunityProducts.Core_Status__c' not in [\"Cancelled\",\"Lost\"] || 'opp_status' is null) and ('StageName' not in [\"Cancelled\", \"Design Win\", \"Group\", \"Group Cancelled\", \"Group Closed\", \"Group Open\",\"Lost\", \"Production Cancelled\", \"Production Win\"] || 'StageName' is null) and (date('KPI_Decision_date_Year', 'KPI_Decision_date_Month', 'KPI_Decision_date_Day') in [\"3 quarters ago\"..\"current quarter\"] or (date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"3 quarters ago\"..\"current quarter\"] and 'Core_Product_Count__c' == 0));\nq_opps_unhealthy = filter confidence_snapshot by 'opportunity_unhealthy' == 1;\nconfidence_snapshot = cogroup confidence_snapshot by ('Snapshot_Date_Year', 'Snapshot_Date_Month','Snapshot_Date_Quarter','Snapshot_Date_Week','Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT') full, q_opps_unhealthy by ('Snapshot_Date_Year', 'Snapshot_Date_Month','Snapshot_Date_Quarter','Snapshot_Date_Week','Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT');\nconfidence_snapshot = foreach confidence_snapshot generate coalesce(confidence_snapshot.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') as 'Snapshot_Date_Year', coalesce(confidence_snapshot.'Snapshot_Date_Month', q_opps_unhealthy.'Snapshot_Date_Month') as 'Snapshot_Date_Month',coalesce(confidence_snapshot.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') as 'Snapshot_Date_Quarter', coalesce(confidence_snapshot.'Snapshot_Date_Week', q_opps_unhealthy.'Snapshot_Date_Week') as 'Snapshot_Date_Week',coalesce(confidence_snapshot.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT', q_opps_unhealthy.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT') as 'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce(unique(confidence_snapshot.'Id'),0) as 'count_opps', coalesce(unique(q_opps_unhealthy.'Id'),0) as 'opps_unhealthy';\n \nconfidence_snapshot = group confidence_snapshot by ('Snapshot_Date_Year',   'Snapshot_Date_Quarter','Snapshot_Date_Week');\nconfidence_snapshot = foreach confidence_snapshot generate 'Snapshot_Date_Year', 'Snapshot_Date_Quarter', 1-(sum(opps_unhealthy)/sum(count_opps))   as 'confidence';\n\nconfidence_snapshot = group confidence_snapshot by ( 'Snapshot_Date_Year',   'Snapshot_Date_Quarter' );\nconfidence_snapshot = foreach confidence_snapshot generate    'Snapshot_Date_Year',  'Snapshot_Date_Quarter',   avg(confidence)   as 'confidence' ;\n\n \nconfidence_snapshot = group confidence_snapshot by ('Snapshot_Date_Year','Snapshot_Date_Quarter' );\n\nconfidence_snapshot = foreach confidence_snapshot generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm'\n, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n, \"Confidence Score\" as 'Metric Name'\n,null  as 'Actual'\n,case when max('confidence') is null then null else  max('confidence') end as 'Snapshot';\n\n-- ========================================\n-- OPPORTUNITY UPDATED - CURRENT MONTH\n-- ========================================\nq_UpOpp= load \"UpdatesMetrictTest\";\nq_UpOpp= filter q_UpOpp by 'OWNER_SYSTEM_ID' ==  \"$User.Id\" ||  'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq_UpOpp= filter q_UpOpp by  'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) ;--\"!{User.Id}\" ;\n\nq_UpOpp = group q_UpOpp by (CLOSE_DT_Quarter, CLOSE_DT_Year, CLOSE_DT_Month, LASTMODIFIED_DT_Quarter, LASTMODIFIED_DT_Year, LASTMODIFIED_DT_Month, OPPORTUNITYID);\n\nq_UpOpp = foreach q_UpOpp generate \n    coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',\n    coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',\n\n    case when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"] \n         then 'OPPORTUNITYID' \n         else null \n    end as 'Total_Opp',\n    case when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"] \n         && date('LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day') in [\"current month\"..\"current month\"]\n         then 'OPPORTUNITYID' \n         else null \n    end as 'Update_Opp';\n\nq_UpOpp = group q_UpOpp by ('Manager_nm', 'Manager_wwid');\n\nq_UpOpp = foreach q_UpOpp generate \n    'Manager_nm', \n    'Manager_wwid', \n    \"% total of current opptys updated current month\" as 'Metric Name',\n    case when unique(Total_Opp) == 0 then null\n         when unique(Update_Opp) == 0 then 0.0\n         else unique(Update_Opp) / unique(Total_Opp)\n    end as 'Actual',\n    \n    null as 'Snapshot';\n\n-- ========================================\n-- OPPORTUNITY UPDATED - SNAPSHOT DATA \n-- ========================================\nq_UpOpp_Month_Snapshot = load \"SnapshotDS13_IDs_Updates_Manager_Metrics_Snapshot\";\n\n------ This code was added to filter a unnecessary snapshot taken in MAY and also taking the snapshot from \"2025-05-30\" as the real snapshot for February ------\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by Snapshot_Date != \"2025-05-02\";\nq_UpOpp_Month_Snapshot = foreach q_UpOpp_Month_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  as 'Manager_wwid',case when Snapshot_Date == \"2025-06-02\" then \"02\" else 'Snapshot_Date_Month' end as 'Snapshot_Date_Month', case when Snapshot_Date == \"2025-06-02\" then \"28\" else 'Snapshot_Date_Day' end as 'Snapshot_Date_Day', 'OWNER_SYSTEM_ID','OWNER_HIERARCHY_TXT','MetricsOpe.ID','MetricsOpe.ID2','MetricsOpe.ID3','MetricsOpe.ID4','MetricsOpe.ID5','MetricsOpe.ID6','MetricsOpe.ID7','MetricsOpe.ID8','MetricsOpe.ID9','Snapshot_Date_Year','CLOSE_DT_Quarter','CLOSE_DT_Year','Snapshot_Date_Quarter','LASTMODIFIED_DT_Quarter','LASTMODIFIED_DT_Year','LASTMODIFIED_DT_Month','CLOSE_DT_Month','OPPORTUNITYID', 'Snapshot_Date';\n\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by 'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\n\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\n\nq_UpOpp_Month_Snapshot = group q_UpOpp_Month_Snapshot by (\n    CLOSE_DT_Quarter, \n    CLOSE_DT_Year, \n    Snapshot_Date_Month, \n    Snapshot_Date_Quarter, \n    Snapshot_Date_Year, \n    LASTMODIFIED_DT_Quarter, \n    LASTMODIFIED_DT_Year, \n    LASTMODIFIED_DT_Month, \n    CLOSE_DT_Month, \n    OPPORTUNITYID\n);\n\nq_UpOpp_Month_Snapshot = foreach q_UpOpp_Month_Snapshot generate \n    coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',\n    coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',\n\n    case when CLOSE_DT_Quarter == Snapshot_Date_Quarter && CLOSE_DT_Year == Snapshot_Date_Year \n         then 'OPPORTUNITYID' \n         else null \n    end as 'Total_Opp',\n\n    case when CLOSE_DT_Quarter == Snapshot_Date_Quarter && CLOSE_DT_Year == Snapshot_Date_Year\n         && LASTMODIFIED_DT_Month == Snapshot_Date_Month \n         && LASTMODIFIED_DT_Year == Snapshot_Date_Year\n         then 'OPPORTUNITYID' \n         else null \n    end as 'Update_Opp';\n\nq_UpOpp_Month_Snapshot = group q_UpOpp_Month_Snapshot by ('Manager_nm', 'Manager_wwid');\n\nq_UpOpp_Month_Snapshot = foreach q_UpOpp_Month_Snapshot generate \n    'Manager_nm', \n    'Manager_wwid', \n    \"% total of current opptys updated current month\" as 'Metric Name',  \n    null as 'Actual',\n    case when unique(Total_Opp) == 0 then null\n         when unique(Update_Opp) == 0 then 0.0\n         else unique(Update_Opp) / unique(Total_Opp)\n    end as 'Snapshot';\n\n\n-- ==============\n--Account\n-- ==============\nq_accountp = load \"ManagerMetric_AccountPlan\";\nq_accountp= filter q_accountp by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\nq_accountp= filter q_accountp by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\"  || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq_accountp = filter q_accountp by 'Core_Account_Primary_Coverage__c' matches \"Intel\";\nq_accountp= filter q_accountp by  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\n\nq_G = foreach q_accountp generate case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then \n 'Id' else \"\" end as 'Id', case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'Id' else \"\" end as 'UCD_G';\nq_G = group q_G by ('Id');\nq_G = foreach q_G generate 'Id' as 'Id', case when  'Id'== \"\" then 0 else unique('Id')   end  as 'UCD_G';\nq_G = group q_G by all;\nq_G = foreach q_G generate case when sum('UCD_G') == 0 then 0  else sum('UCD_G')  end as 'UCD_G',0 as 'UCD_A';\n\n\nq_A = filter q_accountp by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_A = foreach q_A generate case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'Id' else \"\" end as 'Id', unique('Id') as 'UCD_A';\nq_A = group q_A by ('Id');\nq_A = foreach q_A generate 'Id' as 'Id', case when 'Id' == \"\" then 0 else unique('Id') end as 'UCD_A';\nq_A = group q_A by all;\nq_A = foreach q_A generate 0 as 'UCD_G',case when sum('UCD_A') == 0 then 0 else sum('UCD_A')  end as 'UCD_A';\n\nq_account = union q_G,q_A;\nq_account = group q_account by all;\nq_account = foreach q_account generate max('UCD_G') as 'UCD_G', max('UCD_A') as 'UCD_A',case when sum('UCD_A')/sum('UCD_G')  is null then null else  sum('UCD_A')/sum('UCD_G') end as 'metric';\n\nq_accplan  = foreach q_account  generate   coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n, \"Account Plan Completion\" as 'Metric Name'\n,sum('metric') as 'Actual'\n,null as 'Snapshot';\n\n--Account Snapshot IDS \n--Account Snapshot \nq_accountp_Snapshot = load \"Snapshot_Account\";\n\n \nq_accountp_Snapshot= filter q_accountp_Snapshot by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq_accountp_Snapshot = filter q_accountp_Snapshot by  date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_accountp_Snapshot = filter q_accountp_Snapshot by 'Core_Account_Primary_Coverage__c' matches \"Intel\" ;\nq_accountp_Snapshot = filter q_accountp_Snapshot by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\nq_G_Snapshot = foreach q_accountp_Snapshot generate case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then \n 'Id' else \"\" end as 'Id', case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'Id' else \"\" end as 'UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\nq_G_Snapshot = group q_G_Snapshot by ('Id','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_G_Snapshot = foreach q_G_Snapshot generate 'Id' as 'Id', case when  'Id'== \"\" then null else unique('Id')   end  as 'UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\nq_G_Snapshot = group q_G_Snapshot by ('Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_G_Snapshot = foreach q_G_Snapshot generate case when sum('UCD_G') == null then null  else sum('UCD_G')  end as 'UCD_G',0 as 'UCD_A','Snapshot_Date_Year','Snapshot_Date_Month';\n\n\nq_A_Snapshot = filter q_accountp_Snapshot by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_A_Snapshot = foreach q_A_Snapshot generate case when  'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'Id' else \"\" end as 'Id', unique('Id') as 'UCD_A','Snapshot_Date_Year','Snapshot_Date_Month';\nq_A_Snapshot = group q_A_Snapshot by ('Id','Snapshot_Date_Year','Snapshot_Date_Month');\nq_A_Snapshot = foreach q_A_Snapshot generate 'Id' as 'Id', case when 'Id' == \"\" then null else unique('Id') end as 'UCD_A','Snapshot_Date_Year','Snapshot_Date_Month';\nq_A_Snapshot = group q_A_Snapshot by ('Snapshot_Date_Year','Snapshot_Date_Month');\nq_A_Snapshot = foreach q_A_Snapshot generate 0 as 'UCD_G',case when sum('UCD_A') == 0 then 0 else sum('UCD_A')  end as 'UCD_A','Snapshot_Date_Year','Snapshot_Date_Month';\n\n\nq_account_Snapshot = union q_G_Snapshot,q_A_Snapshot;\nq_account_Snapshot = group q_account_Snapshot by all;\nq_account_Snapshot = foreach q_account_Snapshot generate max('UCD_G') as 'UCD_G', max('UCD_A') as 'UCD_A',case when sum('UCD_A')/sum('UCD_G')  is null then null else  sum('UCD_A')/sum('UCD_G') end as 'metric';\n\nq_accplan_Snapshot  = foreach q_account_Snapshot  generate   coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n, \"Account Plan Completion\" as 'Metric Name'\n,null as 'Actual'\n,sum('metric')  as 'Snapshot';\n\n\n--Commited on the same quarter\nManagerOpptiesCommit = load \"ManagerCommitMetric\";\nManagerOpptiesCommit= filter ManagerOpptiesCommit by 'USER_ID' ==  \"$User.Id\" ||  'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\" ;\nManagerOpptiesCommit = filter ManagerOpptiesCommit by PERIOD_TXT == \"Q 2 FY 2025\";\n--ManagerOpptiesCommit = filter ManagerOpptiesCommit by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"current quarter\"..\"current quarter\"];\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\n\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'PERIOD_TXT' else \"\" end as 'PERIOD_TXT',case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'FORECAST_AMT' else 0 end as 'FORECAST_AMT',case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'OPPORTUNITIES_AMT' else 0 end as 'OPPORTUNITIES_AMT',case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'FORECAST_AMT_PERCENTAGE' else 0 end as 'FORECAST_AMT_PERCENTAGE','USER_ID' ;\nManagerOpptiesCommit = group ManagerOpptiesCommit by ('PERIOD_TXT','USER_ID' );\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate 'PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT')) as 'commitMetric','USER_ID' ;\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'USER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") ;\nManagerOpptiesCommit = group ManagerOpptiesCommit by all;\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n, \"% Commited on the Current Quarter\" as 'Metric Name'\n,case when max('commitMetric') is null then null else max('commitMetric') end as 'Actual'\n,null as 'Snapshot'; \n\n\n--Commited IDs Snapshot \n--ManagerOpptiesCommit_Snapshot = load \"SnapshotDS22_CommitSnapshot_Metric_IDs_Snapshot\"; \n\n--ManagerOpptiesCommit_Snapshot= filter ManagerOpptiesCommit_Snapshot by 'USER_ID' ==  \"$User.Id\" ||  'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'ID'  matches \"!{User.Id}\" || 'ID2'  matches \"!{User.Id}\" || 'ID3'  matches \"!{User.Id}\" || 'ID4'  matches \"!{User.Id}\" || 'ID5'  matches \"!{User.Id}\" || 'ID6'  matches \"!{User.Id}\" || 'ID7'  matches \"!{User.Id}\" || 'ID8'  matches \"!{User.Id}\" || 'ID9' matches \"!{User.Id}\";\n\n--Commited on the same quarter Snapshot\nManagerOpptiesCommit_Snapshot = load \"SnapshotDS22\"; \n\n--ManagerOpptiesCommit_Snapshot= filter ManagerOpptiesCommit_Snapshot by 'USER_ID' ==  \"$User.Id\" ||  'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\"  || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");ManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate case when 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'PERIOD_TXT' else \"\" end as 'PERIOD_TXT',case when 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'FORECAST_AMT' else null end as 'FORECAST_AMT',case when 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'OPPORTUNITIES_AMT' else null end as 'OPPORTUNITIES_AMT','USER_ID';\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('PERIOD_TXT','USER_ID');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate 'PERIOD_TXT', sum('FORECAST_AMT') as 'FORECAST_AMT',sum('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(sum('OPPORTUNITIES_AMT')/sum('FORECAST_AMT')) as 'commitMetric','USER_ID',substr('PERIOD_TXT',8,9) as 'Snapshot_Date_Year',case when 'PERIOD_TXT' matches \"Q 1\"   then \"Q1\" when 'PERIOD_TXT' matches \"Q 2\" then \"Q2\" when 'PERIOD_TXT' matches \"Q 3\"  then \"Q3\" when 'PERIOD_TXT' matches \"Q 4\" then \"Q4\" end as  'Snapshot_Date_Quarter' ;\n\n--ManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'USER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") ;\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Snapshot_Date_Year','Snapshot_Date_Quarter');\n\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n, 'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Quarter' as 'Snapshot Quarter'\n,case when date_to_string(now(), \"MM\") == \"01\" ||  date_to_string(now(), \"MM\") == \"02\" ||  date_to_string(now(), \"MM\") == \"03\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\")  + \"-\" + \"Q4\" when date_to_string(now(), \"MM\") == \"04\" ||  date_to_string(now(), \"MM\") == \"05\" ||  date_to_string(now(), \"MM\") == \"06\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" when date_to_string(now(), \"MM\") == \"07\" ||  date_to_string(now(), \"MM\") == \"08\" ||  date_to_string(now(), \"MM\") == \"09\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" when date_to_string(now(), \"MM\") == \"10\" ||  date_to_string(now(), \"MM\") == \"11\" ||  date_to_string(now(), \"MM\") == \"12\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" end as 'Last Quarter'\n,max('commitMetric') as 'commitMetric';  \n\n\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'Snapshot Quarter' == 'Last Quarter' ;\n\n--ManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'USER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") ;\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm',  'Manager_wwid');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm',  'Manager_wwid'\n, \"% Commited on the Current Quarter\" as 'Metric Name'\n,null  as 'Actual'\n,case when max('commitMetric') is null then null  else max('commitMetric') end as 'Snapshot'; \n\n\n--Generate hardcoder manager name or user and assign Null values to prevent extrage behaviors when users won't show a result on an specific metric\nq_managers = load \"ManagerUsers\";\n\n--Generate Confidence\nq_final_manager_confidece = group q_managers by all;\nq_final_manager_confidece = foreach q_final_manager_confidece generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',null as 'Actual', null as 'Snapshot',\"Confidence Score\" as 'Metric Name';\n\n--Generate Updates\nq_final_manager_updates = group q_managers by all;\nq_final_manager_updates = foreach q_final_manager_updates generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',null as 'Actual', null as 'Snapshot',\"% total of current opptys updated current month\" as 'Metric Name';\n\n\n--Generate Account\nq_final_manager_Account = group q_managers by all;\nq_final_manager_Account = foreach q_final_manager_Account generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',null as 'Actual', null as 'Snapshot',\"Account Plan Completion\" as 'Metric Name';\n\n--Generate Commit\nq_final_manager_Commit= group q_managers by all;\nq_final_manager_Commit = foreach q_final_manager_Commit generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',null as 'Actual', null as 'Snapshot',\"% Commited on the Current Quarter\" as 'Metric Name';\n\n--Final Query:\nq_final = union q_confidence,q_UpOpp,q_accplan,ManagerOpptiesCommit,confidence_snapshot,q_accplan_Snapshot,ManagerOpptiesCommit_Snapshot,q_UpOpp_Month_Snapshot,q_final_manager_confidece,q_final_manager_updates,q_final_manager_Account,q_final_manager_Commit;\nq_final = filter q_final by 'Manager_nm' != \"\";\nq_final = group q_final by ( 'Manager_nm','Metric Name');\nq_final = foreach q_final generate  'Manager_nm' as 'Manager Name'\n,'Metric Name'\n,case when sum('Actual') is null && 'Metric Name' == \"% Commited on the Current Quarter\"  then \"No Commit\"  when sum('Actual') is null  && 'Metric Name' == \"% total of current opptys updated current month\"   then \"No Open Opps\"   when sum('Actual') is null  && 'Metric Name' == \"Account Plan Completion\"  then \"No Accounts\"  when sum('Actual') is null && 'Metric Name' == \"Confidence Score\"  then \"No Open Opps\" when number_to_string( (sum('Actual')),\"#%\")  == \"%\" then \"0%\"  when sum('Actual')==0 then \"0%\" else number_to_string(sum('Actual'),\"#%\") end as 'Actual'\n,case when (sum('Actual')-sum('Snapshot')) is null && 'Metric Name' == \"% Commited on the Current Quarter\"  then \"No Commit\" when (sum('Actual')-sum('Snapshot')) is null && 'Metric Name' == \"% total of current opptys updated current month\"   then \"No Open Opps\" when (sum('Actual')-sum('Snapshot')) is null && 'Metric Name' == \"Account Plan Completion\"  then \"No Accounts\" when (sum('Actual')-sum('Snapshot')) is null && 'Metric Name' == \"Confidence Score\"  then \"No Open Opps\" when sum('Actual') is null then  number_to_string( (sum('Snapshot')),\"#%\")  when number_to_string( (sum('Actual')-sum('Snapshot')),\"#%\") == \"%\" then \"0%\"  else number_to_string( (sum('Actual')-sum('Snapshot')),\"#%\") end as 'Delta'\n, case when ('Metric Name' == \"Confidence Score\" &&  sum('Actual') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')>= 0.799 )) then \"#9fd541\"  \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  sum('Actual') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')>= 0.799 )) then \"#9fd541\" \n    when ('Metric Name' ==  \"Account Plan Completion\" &&  sum('Actual') < 0.499 ) then \"#c81326\"\n    when ('Metric Name' ==  \"Account Plan Completion\"  &&  ( sum('Actual')> 0.499 && sum('Actual') < 0.999 )) then \"#ffe500\" \n    when ('Metric Name' ==  \"Account Plan Completion\"   &&  ( sum('Actual')>= 0.999 )) then \"#9fd541\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') >= 1 && sum('Actual') <=  1.25)  || ( sum('Actual') <= 1 && sum('Actual') >=  0.75))) then \"#9fd541\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') > 1.25 && sum('Actual') <=  1.5)  || ( sum('Actual') <= 0.75 && sum('Actual') >=  0.5))) then \"#ffe500\" \n    when ('Metric Name' ==\"% Commited on the Current Quarter\" && (sum('Actual') > 1.5   ||  sum('Actual') < 0.5) ) then \"#c81326\"  end as 'actual_color'\n\n, case when ('Metric Name' == \"Confidence Score\" &&  sum('Actual') < 0.399 ) then \"#FFFFFF\"\n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#000000\" \n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')>= 0.799 )) then \"#000000\"  \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  sum('Actual') < 0.399 ) then \"#FFFFFF\"\n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#000000\" \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')>= 0.799 )) then \"#000000\" \n    when ('Metric Name' ==  \"Account Plan Completion\" &&  sum('Actual') < 0.499 ) then \"#FFFFFF\"\n    when ('Metric Name' ==  \"Account Plan Completion\"  &&  ( sum('Actual')> 0.499 && sum('Actual') < 0.999 )) then \"#000000\" \n    when ('Metric Name' ==  \"Account Plan Completion\"   &&  ( sum('Actual')>= 0.999 )) then \"#000000\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') >= 1 && sum('Actual') <=  1.25)  || ( sum('Actual') <= 1 && sum('Actual') >=  0.75))) then \"#000000\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') > 1.25 && sum('Actual') <=  1.5)  || ( sum('Actual') <= 0.75 && sum('Actual') >=  0.5))) then \"#000000\" \n    when ('Metric Name' ==\"% Commited on the Current Quarter\" && (sum('Actual') > 1.5   ||  sum('Actual') < 0.5) ) then \"#FFFFFF\" end as 'text_color'\n\n, case when ('Metric Name' == \"Confidence Score\" &&  sum('Snapshot') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Snapshot')> 0.399 && sum('Snapshot') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Snapshot')>= 0.799 )) then \"#9fd541\"    \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  sum('Snapshot') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Snapshot')> 0.399 && sum('Snapshot') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Snapshot')>= 0.799 )) then \"#9fd541\"  \n     when ('Metric Name' ==  \"Account Plan Completion\" &&  sum('Snapshot') < 0.499 ) then \"#c81326\"\n    when ('Metric Name' ==  \"Account Plan Completion\"  &&  ( sum('Snapshot')> 0.499 && sum('Snapshot') < 0.999 )) then \"#ffe500\" \n    when ('Metric Name' ==  \"Account Plan Completion\"   &&  ( sum('Snapshot')>= 0.999 )) then \"#9fd541\" \n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  sum('Snapshot') < -1.5 ) then \"#c81326\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ( sum('Snapshot')> -1.5 && sum('Snapshot') < -1.25 )) then \"#ffe500\" \n    when ('Metric Name' ==\"% Commited on the Current Quarter\" &&  ( sum('Snapshot')> -1.25 && sum('Snapshot') < 1.25 )) then \"#9fd541\"  \n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ( sum('Snapshot')> 1.25 && sum('Snapshot') < 1.5 )) then \"#ffe500\" \n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  sum('Snapshot') >= 1.5 ) then \"#c81326\"  end as 'MoM_color';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columnTotals":false,"columns":["Manager Name","Metric Name","Actual","Delta"],"customBulkActions":[],"fixedColumnWidth":126,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"rowTotals":false,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"commit_quarter_selec_1":{"broadcastFacet":false,"groups":[],"label":"commit_quarter_selection","numbers":[],"query":"q_snapshot = load \"SnapshotDS22\";\nManagerCommitMetrict = load \"ManagerCommitMetrict\";\nq_snapshot = group q_snapshot by (Snapshot_Date_Year,Snapshot_Date_Quarter);\nq_snapshot = foreach q_snapshot generate Snapshot_Date_Year + \"-\" + \ncase\n    when Snapshot_Date_Quarter == \"1\" then \"Q1\"\n    when Snapshot_Date_Quarter == \"2\" then \"Q2\"\n    when Snapshot_Date_Quarter == \"3\" then \"Q3\"\n    when Snapshot_Date_Quarter == \"4\" then \"Q4\"\nend as 'Quarter';\nq_snapshot = order q_snapshot by 'Quarter' asc;\n\nq_actual = load \"ManagerCommitMetrict\";\nq_actual = foreach q_actual generate case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" then  date_to_string(now(), \"yyyy\") + \"-Q1\" \n when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\"  || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-Q2\"  \n when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\"  || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-Q3\"  \n else date_to_string(now(), \"yyyy\") + \"Q4\" end as 'Quarter';\nq_actual = order q_actual by 'Quarter' asc;\n\n\nq_final = union q_snapshot,q_actual;\nq_final = group q_final by ('Quarter');\nq_final = foreach q_final generate 'Quarter';\nq_final = order q_final by 'Quarter' desc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"singlerequired","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":false,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_11":{"broadcastFacet":true,"groups":[],"label":"lens_11","numbers":[],"query":"q_managers = load \"ManagerUsers\";\nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_managers_snapshot1 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"52\" else number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot2 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"51\" else number_to_string(string_to_number('Snapshot_Dates_Week') -2, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot3 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"50\" else number_to_string(string_to_number('Snapshot_Dates_Week') -3, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot4 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"49\" else number_to_string(string_to_number('Snapshot_Dates_Week') -4, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot5 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"48\" else number_to_string(string_to_number('Snapshot_Dates_Week') -5, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot6 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"47\" else number_to_string(string_to_number('Snapshot_Dates_Week') -6, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot7 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"46\" else number_to_string(string_to_number('Snapshot_Dates_Week') -7, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot8 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"45\" else number_to_string(string_to_number('Snapshot_Dates_Week') -8, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot9 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"44\" else number_to_string(string_to_number('Snapshot_Dates_Week') -9, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot10 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"43\" else number_to_string(string_to_number('Snapshot_Dates_Week') -10, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot11 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"42\" else number_to_string(string_to_number('Snapshot_Dates_Week') -11, \"#\") end  as 'Snapshot_Date_Week' ;\nq_managers_snapshot12 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when number_to_string(string_to_number('Snapshot_Dates_Week') -1, \"#\") == \"\" then \"41\" else number_to_string(string_to_number('Snapshot_Dates_Week') -12, \"#\") end  as 'Snapshot_Date_Week' ;\n\n\n\n--Opportunity Weekly Snapshot Updates\nq_UpOpp_Week_Snapshot= load \"SnapshotDS25\";\n\n--Update last week Snapshot\nq_UpOpp_Week_SnapshotW = foreach q_UpOpp_Week_Snapshot generate \"\" as 'Manager_nm',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid', case when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"1 quarter ago\"..\"1 quarter ago\"] then 'OPPORTUNITYID' end as 'OpptyId_Qrt', case when date('LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day') in [\"6 days ago\"..\"current day\"] then 'OPPORTUNITYID' end as 'OpptyId_Wk','Snapshot_Date_Week';\nq_UpOpp_Week_SnapshotW = group q_UpOpp_Week_SnapshotW by ('Manager_wwid', 'Manager_nm','Snapshot_Date_Week');\nq_UpOpp_Week_SnapshotW = foreach q_UpOpp_Week_SnapshotW generate 'Manager_wwid', 'Manager_nm', unique('OpptyId_Wk')/unique('OpptyId_Qrt') as '% of total current opptys updated last week','Snapshot_Date_Week'; \n\nq_UpOppW_managers_Snapshot = union q_UpOpp_Week_SnapshotW,q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4,q_managers_snapshot5,q_managers_snapshot6,q_managers_snapshot7,q_managers_snapshot8,q_managers_snapshot9,q_managers_snapshot10,q_managers_snapshot12;\