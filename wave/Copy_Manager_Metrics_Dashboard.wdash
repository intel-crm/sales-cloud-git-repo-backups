.asString()}}, \"!{User.Id}\"))-19,18)) as 'Manager_wwid',coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') as 'Snapshot_Date_Year', coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') as 'Snapshot_Date_Quarter', coalesce(q.'Snapshot_Date_Week', q_opps_unhealthy.'Snapshot_Date_Week') as 'Snapshot_Date_Week', coalesce(q.'Snapshot_Date_Month', q_opps_unhealthy.'Snapshot_Date_Month') as 'Snapshot_Date_Month',coalesce(unique(q.'Id'),0) as 'count_opps', coalesce(unique(q_opps_unhealthy.'Id'),0) as 'opps_unhealthy';\n \nq = group q by ('Manager_nm','Manager_wwid','Snapshot_Date_Year',  'Snapshot_Date_Quarter','Snapshot_Date_Week');\nq = foreach q generate  'Manager_nm','Manager_wwid','Snapshot_Date_Year',  'Snapshot_Date_Quarter',  1-(sum(opps_unhealthy)/sum(count_opps))   as 'confidence';\n \n\n q = group q by ( 'Manager_nm','Manager_wwid','Snapshot_Date_Year',   'Snapshot_Date_Quarter' );\nq = foreach q generate   'Manager_nm','Manager_wwid', 'Snapshot_Date_Year',  'Snapshot_Date_Quarter',   avg(confidence)   as 'confidence' ;\n\n\nq = group q by ('Manager_nm','Manager_wwid' );\n\nq = foreach q generate  'Manager_nm','Manager_wwid',max('confidence') as 'confidence';\n \nq_confidence_managers_snapshot = union q,q_managers;\nq_confidence_managers_snapshot = group q_confidence_managers_snapshot by ('Manager_wwid');\nq_confidence_managers_snapshot = foreach q_confidence_managers_snapshot generate   max('Manager_nm') as 'Manager_nm'\n, \"Confidence Score\" as 'Metric Name'\n,null as 'Actual'\n,case when max('confidence') is null then null else max('confidence') end  as 'Snapshot'; \n\n\n\n\n-- ==============\n-- UPDATED OPPORTUNITIES\n-- ==============\nq_UpOpp = load \"UpdatesMetric\";\n\nq_UpOpp= filter q_UpOpp by 'OWNER_SYSTEM_ID' ==  \"$User.Id\" ||  'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\" ;\nq_UpOpp= filter q_UpOpp by  'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) ;\n\n--Update current month\nq_UpOpp_Processed = foreach q_UpOpp generate \n    \"\" as 'Manager_nm',\n    substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid',\n    'OPPORTUNITYID',\n    'CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day',\n    'LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day',\n    case when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"] \n         then 1 else 0 end as 'Is_Current_Quarter',\n    case when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"] && \n              date('LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day') in [\"current month\"..\"current month\"]\n         then 1 else 0 end as 'Is_Updated_Current_Month';\n         \nq_UpOpp_Dedup = group q_UpOpp_Processed by ('OPPORTUNITYID', 'Manager_wwid');\nq_UpOpp_Dedup = foreach q_UpOpp_Dedup generate \n    'OPPORTUNITYID',\n    'Manager_wwid',\n    max('Manager_nm') as 'Manager_nm',\n    max('Is_Current_Quarter') as 'Is_Current_Quarter',\n    max('Is_Updated_Current_Month') as 'Is_Updated_Current_Month';\n\nq_UpOpp_Aggregated = group q_UpOpp_Dedup by ('Manager_wwid', 'Manager_nm');\nq_UpOpp_Aggregated = foreach q_UpOpp_Aggregated generate \n    'Manager_wwid', \n    'Manager_nm',\n    sum('Is_Current_Quarter') as 'Total_Opp_Count',\n    sum('Is_Updated_Current_Month') as 'Update_Opp_Count',\n    case when sum('Is_Current_Quarter') > 0 \n         then sum('Is_Updated_Current_Month') / sum('Is_Current_Quarter')\n         else null \n    end as '% total of current opptys updated current month';\n\nq_UpOppM_managers = union q_UpOpp_Aggregated,q_managers;\nq_UpOppM_managers = group q_UpOppM_managers by ('Manager_wwid');\nq_UpOppM_managers = foreach q_UpOppM_managers generate max('Manager_nm') as 'Manager_nm'\n, \"% total of current opptys updated current month\" as 'Metric Name' \n,case when max('% total of current opptys updated current month') is null then null else max('% total of current opptys updated current month') end as 'Actual'\n,null as 'Snapshot';  \n\n--========================================\n--SNAPSHOT\n--========================================\nq_UpOpp_Month_Snapshot = load \"SnapshotDS13_IDs_Updates_Manager_Metrics_Snapshot\";\n\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by Snapshot_Date != \"2025-02-02\";\n\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by \n    date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\n\nq_UpOpp_Month_Snapshot = foreach q_UpOpp_Month_Snapshot generate  \n    coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',\n    coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',\n    case when Snapshot_Date == \"2025-03-02\" then \"02\" else 'Snapshot_Date_Month' end as 'Snapshot_Date_Month', \n    case when Snapshot_Date == \"2025-03-02\" then \"28\" else 'Snapshot_Date_Day' end as 'Snapshot_Date_Day', \n    'OWNER_SYSTEM_ID','OWNER_HIERARCHY_TXT',\n    'MetricsOpe.ID','MetricsOpe.ID2','MetricsOpe.ID3','MetricsOpe.ID4','MetricsOpe.ID5','MetricsOpe.ID6','MetricsOpe.ID7','MetricsOpe.ID8','MetricsOpe.ID9',\n    'Snapshot_Date_Year','CLOSE_DT_Quarter','CLOSE_DT_Year','Snapshot_Date_Quarter',\n    'LASTMODIFIED_DT_Quarter','LASTMODIFIED_DT_Year','LASTMODIFIED_DT_Month','CLOSE_DT_Month',\n    'OPPORTUNITYID', 'Snapshot_Date';\n\nq_UpOpp_Month_Snapshot= filter q_UpOpp_Month_Snapshot by \n    'OWNER_SYSTEM_ID' == \"$User.Id\" ||  \n    'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || \n    'MetricsOpe.ID' matches \"!{User.Id}\" || 'MetricsOpe.ID2' matches \"!{User.Id}\" || 'MetricsOpe.ID3' matches \"!{User.Id}\" || \n    'MetricsOpe.ID4' matches \"!{User.Id}\" || 'MetricsOpe.ID5' matches \"!{User.Id}\" || 'MetricsOpe.ID6' matches \"!{User.Id}\" || \n    'MetricsOpe.ID7' matches \"!{User.Id}\" || 'MetricsOpe.ID8' matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n\nq_UpOpp_Month_Snapshot= filter q_UpOpp_Month_Snapshot by   \n    'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\n\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by 'CLOSE_DT_Quarter' == 'Snapshot_Date_Quarter' && 'CLOSE_DT_Year' == 'Snapshot_Date_Year';\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_Snapshot generate \n    \"\" as 'Manager_nm',\n    substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid',\n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month',\n    'CLOSE_DT_Quarter',\n    'CLOSE_DT_Year',\n    'Snapshot_Date_Quarter',\n    'LASTMODIFIED_DT_Month',\n    'LASTMODIFIED_DT_Year',\n    'OPPORTUNITYID';\n\nq_UpOpp_Month_SnapshotM_Dedup = group q_UpOpp_Month_SnapshotM by (\n    'OPPORTUNITYID',        \n    'Manager_wwid',         \n    'Snapshot_Date_Year',   \n    'Snapshot_Date_Month'   \n);\n\nq_UpOpp_Month_SnapshotM_Dedup = foreach q_UpOpp_Month_SnapshotM_Dedup generate \n    'OPPORTUNITYID',\n    'Manager_wwid',\n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month',\n    max('CLOSE_DT_Quarter') as 'CLOSE_DT_Quarter',\n    max('CLOSE_DT_Year') as 'CLOSE_DT_Year',\n    max('Snapshot_Date_Quarter') as 'Snapshot_Date_Quarter',\n    max('LASTMODIFIED_DT_Month') as 'LASTMODIFIED_DT_Month',\n    max('LASTMODIFIED_DT_Year') as 'LASTMODIFIED_DT_Year',\n    max('Manager_nm') as 'Manager_nm';\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM_Dedup generate \n    'Manager_nm',\n    'Manager_wwid',\n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month',\n    1 as 'Total_Opp',\n    case when 'Snapshot_Date_Month' == 'LASTMODIFIED_DT_Month' && 'Snapshot_Date_Year' == 'LASTMODIFIED_DT_Year' \n         then 1 else 0 end as 'Update_Opp';\n\nq_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Manager_wwid', 'Manager_nm','Snapshot_Date_Year','Snapshot_Date_Month');\n\nq_UpOppM_managers_Snapshot = foreach q_UpOpp_Month_SnapshotM generate \n    'Manager_wwid',\n    'Manager_nm',\n    sum(Total_Opp) as 'Total_Opp',                    \n    coalesce(sum(Update_Opp),0) as 'Update_Opp',      \n    coalesce(sum(Update_Opp) / sum(Total_Opp),0) as 'result_prev_month',  \n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month'; \n\nq_UpOppM_managers_Snapshot = union q_UpOppM_managers_Snapshot,q_managers;\nq_UpOppM_managers_Snapshot = group q_UpOppM_managers_Snapshot by ('Manager_wwid');\nq_UpOppM_managers_Snapshot = foreach q_UpOppM_managers_Snapshot generate  max('Manager_nm') as 'Manager_nm'\n, \"% total of current opptys updated current month\" as 'Metric Name'\n,null as 'Actual'\n,case when max('result_prev_month') is null then null else  max('result_prev_month') end as 'Snapshot'; \n\n--Account\nq_accountp = load \"ManagerMetric_AccountPlan\";\nq_accountp= filter q_accountp by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq_accountp = filter q_accountp by 'Core_Account_Primary_Coverage__c' matches \"Intel\";\nq_accountp= filter q_accountp by  'AccountUser.OWNER_HIERARCHY_TXT'  matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );--\"!{User.Id}\" ;\nq_accountp1 = group q_accountp by ('Id','AccountUser.OWNER_HIERARCHY_TXT');\nq_accountp1 = foreach q_accountp1 generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Id', unique('Id') as 'UCD_G', 0 as 'UCD_Attach';\n\n\nq_accountp2 = filter q_accountp by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_accountp2 = group q_accountp2 by ('Id','AccountUser.OWNER_HIERARCHY_TXT');\nq_accountp2 = foreach q_accountp2 generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Id',   0 as 'UCD_G', unique('Id') as 'UCD_Attach';\n\nq_accplan = union q_accountp1, q_accountp2;\nq_accplan = group q_accplan by ('Id', 'Manager_nm','Manager_wwid','UCD_Attach','UCD_G');\nq_accplan = foreach q_accplan generate 'Manager_nm','Manager_wwid','Id','UCD_Attach','UCD_G';\n\n\nq_accplan = group q_accplan by ('Manager_nm','Manager_wwid');\nq_accplan = foreach q_accplan generate 'Manager_nm','Manager_wwid',sum('UCD_Attach') as 'ucd_attach',sum('UCD_G') as 'ucd_g',sum('UCD_Attach')/sum('UCD_G') as 'result';\n\nq_accplan = union q_accplan,q_managers;\n\nq_accplan  = group q_accplan  by ('Manager_wwid');\nq_accplan  = foreach q_accplan  generate  max('Manager_nm') as 'Manager_nm'\n, \"Account Plan Completion\" as 'Metric Name'\n,case when max('result') is null then null else  max('result') end as 'Actual'\n,null as 'Snapshot';  \n\n-- IDs updated Snapshot\n \n\n--Account Snapshot\n--q_accountp_snapshot = load \"Snapshot_Account\";\n\nq_accountp_snapshot = load \"Snapshot_Account\";\n\nq_accountp_Snapshot= filter q_accountp_snapshot by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq_accountp_snapshot = filter q_accountp_snapshot by 'Core_Account_Primary_Coverage__c' matches  \"Intel\" ;\nq_accountp_snapshot = filter q_accountp_snapshot by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\nq_accountp_snapshot = filter q_accountp_snapshot by  date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_accountp_snapshot= filter q_accountp_snapshot by  'AccountUser.OWNER_HIERARCHY_TXT'  matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );--\"!{User.Id}\" ;\nq_accountp1_snapshot = group q_accountp_snapshot by ('Id','AccountUser.OWNER_HIERARCHY_TXT','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accountp1_snapshot = foreach q_accountp1_snapshot generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Id', unique('Id') as 'UCD_G', 0 as 'UCD_Attach','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\n\n\nq_accountp2_snapshot = filter q_accountp_snapshot by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_accountp2_snapshot = group q_accountp2_snapshot by ('Id','AccountUser.OWNER_HIERARCHY_TXT','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accountp2_snapshot = foreach q_accountp2_snapshot generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Id',   0 as 'UCD_G', unique('Id') as 'UCD_Attach','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\n\n\n\nq_accplan_snapshot = union q_accountp1_snapshot, q_accountp2_snapshot;\nq_accplan_snapshot = group q_accplan_snapshot by ('Id', 'Manager_nm','Manager_wwid','UCD_Attach','UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accplan_snapshot = foreach q_accplan_snapshot generate 'Manager_nm','Manager_wwid','Id','UCD_Attach','UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\n\n\nq_accplan_snapshot = group q_accplan_snapshot by ('Manager_nm','Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accplan_snapshot = foreach q_accplan_snapshot generate 'Manager_nm','Manager_wwid',sum('UCD_Attach') as 'ucd_attach',sum('UCD_G') as 'ucd_g',sum('UCD_Attach')/sum('UCD_G') as 'result','Snapshot_Date_Year','Snapshot_Date_Month';\n\nq_accplan_snapshot = union q_accplan_snapshot,q_managers;\n\nq_accplan_snapshot  = group q_accplan_snapshot  by ('Manager_wwid');\nq_accplan_snapshot  = foreach q_accplan_snapshot  generate  max('Manager_nm') as 'Manager_nm'\n, \"Account Plan Completion\" as 'Metric Name'\n,null as 'Actual'\n,case when max('result') is null then null else  max('result') end as 'Snapshot'; \n\n--Commited on the same quarter\nManagerOpptiesCommit = load \"ManagerCommitMetric\";\n\nManagerOpptiesCommit= filter ManagerOpptiesCommit by 'USER_ID' ==  \"$User.Id\" ||  'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nManagerOpptiesCommit = filter ManagerOpptiesCommit by PERIOD_TXT == \"Q 2 FY 2025\";\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate \"\" as 'Manager_nm',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid', 'PERIOD_TXT','FORECAST_AMT' as 'FORECAST_AMT','OPPORTUNITIES_AMT' as 'OPPORTUNITIES_AMT','USER_ID' ;\nManagerOpptiesCommit = group ManagerOpptiesCommit by ('Manager_wwid', 'Manager_nm','PERIOD_TXT','USER_ID' );\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate 'Manager_wwid', 'Manager_nm','PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT')) as 'commitMetric','USER_ID' ;\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'USER_ID' == 'Manager_wwid';\n\nq_ManagerOppties = union ManagerOpptiesCommit, q_managers;\nq_ManagerOppties = group q_ManagerOppties by ('Manager_wwid');\nq_ManagerOppties = foreach q_ManagerOppties generate max('Manager_nm') as 'Manager_nm'\n,\"% Commited on the Current Quarter\" as 'Metric Name'\n,case when max('commitMetric') is null then null else max('commitMetric') end  as 'Actual'\n,null as 'Snapshot';   \n\n--Commited on the same quarter Snapshot\nManagerOpptiesCommit_Snapshot = load \"SnapshotDS22\";\n\n--ManagerOpptiesCommit_Snapshot= filter ManagerOpptiesCommit_Snapshot by 'USER_ID' ==  \"$User.Id\" ||  'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 quarter ago\"..\"1 quarter ago\"];\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"1 quarter ago\"..\"current quarter\"];\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate \"\" as 'Manager_nm',substr('DIM_MANAGER.OWNER_HIERARCHY_TXT', index_of('DIM_MANAGER.OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid', 'PERIOD_TXT','FORECAST_AMT' as 'FORECAST_AMT','OPPORTUNITIES_AMT' as 'OPPORTUNITIES_AMT','USER_ID';\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_wwid', 'Manager_nm','PERIOD_TXT','USER_ID');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate 'Manager_wwid', 'Manager_nm','PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT')) as 'commitMetric','USER_ID';\n\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'USER_ID' == 'Manager_wwid';\nq_ManagerOppties_Snapshot = union ManagerOpptiesCommit_Snapshot, q_managers;\nq_ManagerOppties_Snapshot = group q_ManagerOppties_Snapshot by ('Manager_wwid');\nq_ManagerOppties_Snapshot = foreach q_ManagerOppties_Snapshot generate max('Manager_nm') as 'Manager_nm'\n,\"% Commited on the Current Quarter\" as 'Metric Name'\n,null as 'Actual'\n,case when max('commitMetric') is null then null else max('commitMetric')  end as 'Snapshot';  \n\n--Final Query:\nq_final = union q_confidence_managers,q_confidence_managers_snapshot,q_UpOppM_managers,q_UpOppM_managers_Snapshot,q_accplan,q_accplan_snapshot,q_ManagerOppties,q_ManagerOppties_Snapshot;\nq_final = filter q_final by 'Manager_nm' != \"\" && 'Manager_nm' != \"!{User.Name}\"  ;\nq_final = group q_final by ( 'Manager_nm','Metric Name');\nq_final = foreach q_final generate  'Manager_nm' as 'Manager Name'\n,'Metric Name'\n,case when sum('Actual') is null && 'Metric Name' == \"% Commited on the Current Quarter\"  then \"No Commit\"  when sum('Actual') is null  && 'Metric Name' == \"% total of current opptys updated current month\"   then \"No Open Opps\"   when sum('Actual') is null  && 'Metric Name' == \"Account Plan Completion\"  then \"No Accounts\"  when sum('Actual') is null && 'Metric Name' == \"Confidence Score\"  then \"No Open Opps\" when number_to_string( (sum('Actual')),\"#%\")  == \"%\" then \"0%\"  when sum('Actual')==0 then \"0%\" else number_to_string(sum('Actual'),\"#%\") end as 'Actual'\n,case when (sum('Actual')-sum('Snapshot')) is null && 'Metric Name' == \"% Commited on the Current Quarter\"  then \"No Commit\" when (sum('Actual')-sum('Snapshot')) is null && 'Metric Name' == \"% total of current opptys updated current month\"   then \"No Open Opps\" when (sum('Actual')-sum('Snapshot')) is null && 'Metric Name' == \"Account Plan Completion\"  then \"No Accounts\" when (sum('Actual')-sum('Snapshot')) is null && 'Metric Name' == \"Confidence Score\"  then \"No Open Opps\" when sum('Actual') is null then  number_to_string( (sum('Snapshot')),\"#%\")  when number_to_string( (sum('Actual')-sum('Snapshot')),\"#%\") == \"%\" then \"0%\"  else number_to_string( (sum('Actual')-sum('Snapshot')),\"#%\") end as 'Delta'\n, case when ('Metric Name' == \"Confidence Score\" &&  sum('Actual') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')>= 0.799 )) then \"#9fd541\"   \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  sum('Actual') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')>= 0.799 )) then \"#9fd541\"\n     when ('Metric Name' ==  \"Account Plan Completion\" &&  sum('Actual') < 0.499 ) then \"#c81326\"\n    when ('Metric Name' ==  \"Account Plan Completion\"  &&  ( sum('Actual')> 0.499 && sum('Actual') < 0.999 )) then \"#ffe500\" \n    when ('Metric Name' ==  \"Account Plan Completion\"   &&  ( sum('Actual')>= 0.999 )) then \"#9fd541\"when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') >= 1 && sum('Actual') <=  1.25)  || ( sum('Actual') <= 1 && sum('Actual') >=  0.75))) then \"#9fd541\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') > 1.25 && sum('Actual') <=  1.5)  || ( sum('Actual') <= 0.75 && sum('Actual') >=  0.5))) then \"#ffe500\" \n    when ('Metric Name' ==\"% Commited on the Current Quarter\" && (sum('Actual') > 1.5   ||  sum('Actual') < 0.5) ) then \"#c81326\"  end as 'actual_color'\n, case when ('Metric Name' == \"Confidence Score\" &&  sum('Actual') < 0.399 ) then \"#FFFFFF\"\n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#000000\" \n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')>= 0.799 )) then \"#000000\"  \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  sum('Actual') < 0.399 ) then \"#FFFFFF\"\n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#000000\" \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')>= 0.799 )) then \"#000000\" \n    when ('Metric Name' ==  \"Account Plan Completion\" &&  sum('Actual') < 0.499 ) then \"#FFFFFF\"\n    when ('Metric Name' ==  \"Account Plan Completion\"  &&  ( sum('Actual')> 0.499 && sum('Actual') < 0.999 )) then \"#000000\" \n    when ('Metric Name' ==  \"Account Plan Completion\"   &&  ( sum('Actual')>= 0.999 )) then \"#000000\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') >= 1 && sum('Actual') <=  1.25)  || ( sum('Actual') <= 1 && sum('Actual') >=  0.75))) then \"#000000\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') > 1.25 && sum('Actual') <=  1.5)  || ( sum('Actual') <= 0.75 && sum('Actual') >=  0.5))) then \"#000000\" \n    when ('Metric Name' ==\"% Commited on the Current Quarter\" && (sum('Actual') > 1.5   ||  sum('Actual') < 0.5) ) then \"#FFFFFF\" end as 'text_color'\n, case when ('Metric Name' == \"Confidence Score\" &&  sum('Snapshot') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Snapshot')> 0.399 && sum('Snapshot') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Snapshot')>= 0.799 )) then \"#9fd541\"  \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  sum('Snapshot') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Snapshot')> 0.399 && sum('Snapshot') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Snapshot')>= 0.799 )) then \"#9fd541\"\n     when ('Metric Name' ==  \"Account Plan Completion\" &&  sum('Snapshot') < 0.499 ) then \"#c81326\"\n    when ('Metric Name' ==  \"Account Plan Completion\"  &&  ( sum('Snapshot')> 0.499 && sum('Snapshot') < 0.999 )) then \"#ffe500\" \n    when ('Metric Name' ==  \"Account Plan Completion\"   &&  ( sum('Snapshot')>= 0.999 )) then \"#9fd541\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  sum('Snapshot') < -0.5 ) then \"#c81326\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ( sum('Snapshot')> -0.5 && sum('Snapshot') < -0.25 )) then \"#ffe500\" \n    when ('Metric Name' ==\"% Commited on the Current Quarter\" &&  ( sum('Snapshot')> -0.25 && sum('Snapshot') < 0.25 )) then \"#9fd541\"  \n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ( sum('Snapshot')> 0.25 && sum('Snapshot') < 0.5 )) then \"#ffe500\" \n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  sum('Snapshot') >= 0.5 ) then \"#c81326\"  end as 'MoM_color';\n    ","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager Name","Metric Name","Actual","Delta"],"customBulkActions":[],"fixedColumnWidth":124,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":4},"type":"table"}},"lens_21":{"broadcastFacet":true,"groups":[],"label":"lens_21","numbers":[],"query":"q = load \"ManagerCommitMetric\";\nq = filter q by 'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq = filter q by 'OWNER_HIERARCHY_TXT' matches    coalesce({{cell(USER_NM_2_1.selection, 0, \"User_Ids\").asString()}}, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ));\nq = foreach q generate q.'USER_NM' as 'Manager_nm', (case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" then  date_to_string(now(), \"yyyy\") + \"-Q1\"\nwhen date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\"  || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-Q2\"  \n when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\"  || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-Q3\"  \n else date_to_string(now(), \"yyyy\") + \"Q4\" end) as 'Quarter', max(q.'FORECAST_AMT') as 'Commit', max(q.'OPPORTUNITIES_AMT') as 'Baseline', case when max('FORECAST_AMT') == 0 || max('FORECAST_AMT') is null then null when max('FORECAST_AMT') == 0 && max('OPPORTUNITIES_AMT') == 0 then 0 else max('FORECAST_AMT_PERCENTAGE')/100 end  as 'Percentage','USER_ID',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'manager_hierarchy';\n\nq_snap = load \"SnapshotDS22_CommitSnapshot_Metric_IDs_Snapshot\";\nq_snap = filter q_snap by date('Snapshot_Date_Year','Snapshot_Date_Month','Snapshot_Date_Day') in [\"1 quarter ago\"..\"1 quarter ago\"];\nq_snap = filter q_snap by 'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_snap = filter q_snap by 'OWNER_HIERARCHY_TXT' matches    coalesce({{cell(USER_NM_2_1.selection, 0, \"User_Ids\").asString()}}, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ));\nq_snap = foreach q_snap generate q_snap.'user_nm.USER_NM' as 'Manager_nm', (q_snap.'Snapshot_Date_Year' + \"-Q\" + q_snap.'Snapshot_Date_Quarter') as 'Quarter', (case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" then  date_to_string(now(), \"yyyy\") + \"-Q1\"\nwhen date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\"  || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-Q2\"  \n when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\"  || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-Q3\"  \n else date_to_string(now(), \"yyyy\") + \"Q4\" end) as 'Current Quarter', max(q_snap.'FORECAST_AMT') as 'Commit', max(q_snap.'OPPORTUNITIES_AMT') as 'Baseline',case when max('FORECAST_AMT') == 0 || max('FORECAST_AMT') is null then null when max('FORECAST_AMT') == 0 && max('OPPORTUNITIES_AMT') == 0 then 0 else max('FORECAST_AMT_PERCENTAGE')/100 end as 'Percentage', 'USER_ID',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'manager_hierarchy';\n\nq_result = union q, q_snap;\nq_result = filter q_result by 'Quarter' in {{coalesce(column(commit_quarter_selec_1.selection, [\"Quarter\"]),\"all\").asString()}};\nq_result = filter q_result by 'USER_ID' == 'manager_hierarchy' || 'USER_ID'   matches coalesce({{cell(USER_NM_2_1.selection, 0, \"User_Ids\").asString()}}, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ));\nq_result = filter q_result by 'Manager_nm' is not null;\nq_result = group q_result by ('Manager_nm','USER_ID', 'Quarter');\nq_result = foreach q_result generate 'Manager_nm' as 'Manager/Seller Name'\n,'USER_ID'\n, 'Quarter'\n, case when max('Commit') is null then \"NA\" when number_to_string(max('Commit'),\"#%\") == \"%\" then \"$0\" else number_to_string(max('Commit'),\"$#\") end as 'Commit Baseline'\n, case when max('Baseline') is null then \"NA\" when number_to_string(max('Baseline'),\"#%\") == \"%\" then \"$0\" else number_to_string(max('Baseline'),\"$#\") end as 'Won Amount'\n, (case when ((max('Commit') == 0 || max('Commit') is null) && max('Percentage') is not null ) then \"No Commited\" when max('Percentage') is null then \"NA\" when max('Percentage') == 0 then \"0%\" when number_to_string(max('Percentage'),\"#%\") == \"%\" then \"0%\" else number_to_string(round(max('Percentage'),3),\"#%\") end) as 'Percentage';\nq_result = order q_result by 'Quarter' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager/Seller Name","Quarter","Commit Baseline","Won Amount","Percentage"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Account_Fields_Name__2":{"broadcastFacet":false,"groups":[],"label":"Account_Fields_Name_1","numbers":[],"query":"q_snapshot = load \"Forecast_Snapshot_with_Transforms_Secured\"; \nq_snapshot = filter q_snapshot by date(Snapshot_Date_Year,Snapshot_Date_Month,Snapshot_Date_Day) in [\"3 quarters ago\"..\"1 quarter ago\"];\nq_snapshot = group q_snapshot by (Snapshot_Date_Year,Snapshot_Date_Quarter);\nq_snapshot = foreach q_snapshot generate Snapshot_Date_Year + \"-\" + \ncase\n    when Snapshot_Date_Quarter == \"1\" then \"Q1\"\n    when Snapshot_Date_Quarter == \"2\" then \"Q2\"\n    when Snapshot_Date_Quarter == \"3\" then \"Q3\"\n    when Snapshot_Date_Quarter == \"4\" then \"Q4\"\nend as 'Quarter';\nq_snapshot = order q_snapshot by 'Quarter' asc;\n\nq_actual = load \"ManagerConfidenceMetric\";\nq_actual = foreach q_actual generate case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"02\" then  date_to_string(now(), \"yyyy\") + \"-Q1\" \n when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\"  || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-Q2\"  \n when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\"  || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-Q3\"  \n else date_to_string(now(), \"yyyy\") + \"Q4\" end as 'Quarter';\nq_actual = order q_actual by 'Quarter' asc;\n\n\nq_final = union q_snapshot,q_actual;\nq_final = group q_final by ('Quarter');\nq_final = foreach q_final generate 'Quarter';\nq_final = order q_final by 'Quarter' desc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"singlerequired","sortable":true,"start":"[\"2025-Q2\"]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_9_1":{"broadcastFacet":true,"groups":[],"label":"lens_9","numbers":[],"query":"-- ========================================\n-- OPPORTUNITY DETAILS REPORT\n-- ========================================\n-- Purpose: Show detailed breakdown of individual opportunities and their update status\n-- Functionality: Lists each opportunity with update status (Yes/No) for selected month\n-- Output: Detailed table showing which specific opportunities were updated\n-- Complements Code 1 by providing granular detail behind the aggregated metrics\n-- ========================================\n\nq_managers = load \"ManagerUsers\"; \nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\n\n-- ========================================\n-- MONTH STRUCTURE GENERATION\n-- ========================================\n-- January: If we're in January OR it's a valid year, use current year; otherwise use previous year\nq_managers_snapshot1 = foreach q_managers generate    'USER_NM' as 'Manager_nm', 'USER_ID' as 'Manager_wwid', 0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\"  || (string_to_number((date_to_string(now(), \"yyyy\")))) > 1  then date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year', \"01\" as 'Snapshot_Date_Month';\n\n-- February: If we're in January, use previous year; otherwise current year\nq_managers_snapshot2 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid', 0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year', \"02\" as 'Snapshot_Date_Month';\n\n-- March: If we're in January or February, use previous year; otherwise current year\nq_managers_snapshot3 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid', 0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year', \"03\" as 'Snapshot_Date_Month';\n\n-- April: Continue pattern for remaining months\nq_managers_snapshot4 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid', 0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',   \"04\" as 'Snapshot_Date_Month';\n\n-- May through December: Continue same pattern\nq_managers_snapshot5 = foreach q_managers generate  'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"05\" as 'Snapshot_Date_Month';\n\nq_managers_snapshot6 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\")  else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"06\" as 'Snapshot_Date_Month';\n\nq_managers_snapshot7 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"07\" as 'Snapshot_Date_Month';\n\nq_managers_snapshot8 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"08\" as 'Snapshot_Date_Month';\n\nq_managers_snapshot9= foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"09\" as 'Snapshot_Date_Month';\n\nq_managers_snapshot10= foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \nelse date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"10\" as 'Snapshot_Date_Month';\n\nq_managers_snapshot11 = foreach q_managers generate \n    'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\"11\" as 'Snapshot_Date_Month';\n\nq_managers_snapshot12= foreach q_managers generate \n    'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" || date_to_string(now(), \"MM\") == \"11\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\"12\" as 'Snapshot_Date_Month';\n\n-- Combine all months into single structure\nmonths = union q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4,q_managers_snapshot5,q_managers_snapshot6,q_managers_snapshot7,q_managers_snapshot8,q_managers_snapshot9,q_managers_snapshot10,q_managers_snapshot11,q_managers_snapshot12;\n\n-- Format final month structure\nmonths = foreach months generate \n    'Manager_nm','Manager_wwid', 'manager_cnt','Snapshot_Date_Year','Snapshot_Date_Month';\n\n-- ========================================\n-- SNAPSHOT OPPORTUNITIES PROCESSING (HISTORICAL MONTHS)\n-- ========================================\n-- Process historical opportunity data from snapshots\n-- This section handles opportunities for all months except current month\n\nq_UpOpp_Month_Snapshot = load \"SnapshotDS13_IDs_Updates_Manager_Metrics_Snapshot\";\n\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by Snapshot_Date != \"2025-02-02\";\n\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by \n 'Snapshot_Date_Year' != date_to_string(now(), \"yyyy\") || 'Snapshot_Date_Month' != date_to_string(now(), \"MM\");\n\nq_UpOpp_Month_Snapshot = foreach q_UpOpp_Month_Snapshot generate  \n    coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',\n    coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',\n    case when Snapshot_Date == \"2025-03-02\" then \"02\" else 'Snapshot_Date_Month' end as 'Snapshot_Date_Month', \n    case when Snapshot_Date == \"2025-03-02\" then \"28\" else 'Snapshot_Date_Day' end as 'Snapshot_Date_Day', \n    'OWNER_SYSTEM_ID','OWNER_HIERARCHY_TXT',\n    'MetricsOpe.ID','MetricsOpe.ID2','MetricsOpe.ID3','MetricsOpe.ID4','MetricsOpe.ID5','MetricsOpe.ID6','MetricsOpe.ID7','MetricsOpe.ID8','MetricsOpe.ID9',\n    'Snapshot_Date_Year','CLOSE_DT_Quarter','CLOSE_DT_Year','Snapshot_Date_Quarter',\n    'LASTMODIFIED_DT_Quarter','LASTMODIFIED_DT_Year','LASTMODIFIED_DT_Month',\n    'CLOSE_DT_Month',\n    'OPPORTUNITYID', \n    'Snapshot_Date',\n    'OPPORTUNITY_NM' as 'OPPORTUNITYNAME',                   \n    'USER_NM' as 'Opportunity_Owner_Name',\n    'USER_ID';     \n\n-- Uses MetricsOpe.ID structure (different from Code 1's role.ID structure)\nq_UpOpp_Month_Snapshot= filter q_UpOpp_Month_Snapshot by \n    'OWNER_SYSTEM_ID' == \"$User.Id\" ||  \n    'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || \n    'MetricsOpe.ID' matches \"!{User.Id}\" || 'MetricsOpe.ID2' matches \"!{User.Id}\" || 'MetricsOpe.ID3' matches \"!{User.Id}\" || \n    'MetricsOpe.ID4' matches \"!{User.Id}\" || 'MetricsOpe.ID5' matches \"!{User.Id}\" || 'MetricsOpe.ID6' matches \"!{User.Id}\" || \n    'MetricsOpe.ID7' matches \"!{User.Id}\" || 'MetricsOpe.ID8' matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n\n-- Supports both USER_NM_1 selection and lens_2 selection for flexibility\nq_UpOpp_Month_Snapshot= filter q_UpOpp_Month_Snapshot by   \n  'OWNER_HIERARCHY_TXT' matches coalesce({{cell(USER_NM_1.selection, 0, \"User_Ids\").asString()}}, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ));\n\n-- Date range filter using string concatenation format\n-- Different format from Code 1 but achieving same result\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by \n    'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Month' + \"-\" + 'Snapshot_Date_Day' in [\"1 year ago\"..\"current year\"];\n\n--  Data quality - Only opportunities with valid Manager Name\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by 'Opportunity_Owner_Name' is not null;\n\n-- Data quality - Only opportunities with valid opportunity name\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by 'OPPORTUNITYNAME' is not null;\n\n-- MAIN BUSINESS RULE - Only opportunities closing in snapshot quarter\n-- This is the core business logic: we only analyze opportunities that close in the same quarter as the snapshot\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by 'CLOSE_DT_Quarter' == 'Snapshot_Date_Quarter' && 'CLOSE_DT_Year' == 'Snapshot_Date_Year';\n\nq_AllOpportunities_Grouped = group q_UpOpp_Month_Snapshot by (\n    'OPPORTUNITYID',         \n    'OPPORTUNITYNAME',         \n    'Opportunity_Owner_Name',  \n    'USER_ID',\n    'Snapshot_Date_Year',     \n    'Snapshot_Date_Month',     \n    'Snapshot_Date_Quarter',   \n    'CLOSE_DT_Quarter',       \n    'Snapshot_Date',           \n    'Manager_nm'               \n);\n\n-- Generate detailed results with business logic for update determination\nq_UpOpp_Month_SnapshotM_Details = foreach q_AllOpportunities_Grouped generate \n    'OPPORTUNITYID' as 'Opportunity_ID',\n    'OPPORTUNITYNAME' as 'Opportunity_Name',\n    'USER_ID' as  'Owner_Id',\n    'Opportunity_Owner_Name' as 'Opportunity_Owner_Name',\n    max('LASTMODIFIED_DT_Year') + \"-\" + max('LASTMODIFIED_DT_Month') + \"-01\" as 'Updates_Date',\n    case \n        when max('LASTMODIFIED_DT_Year') == 'Snapshot_Date_Year' && \n             max('LASTMODIFIED_DT_Month') == 'Snapshot_Date_Month'\n        then \"Yes\"\n        else \"No\"\n    end as 'Updated_in_Snapshot_Month',\n    case \n        when max('LASTMODIFIED_DT_Year') == 'Snapshot_Date_Year' && \n             max('LASTMODIFIED_DT_Quarter') == 'Snapshot_Date_Quarter'\n        then \"Yes\"\n        else \"No\"\n    end as 'Updated_in_Snapshot_Quarter',\n    'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Month' as 'Snapshot_Month',\n    'Snapshot_Date_Year' + \"-Q\" + 'Snapshot_Date_Quarter' as 'Snapshot_Quarter',\n    'Snapshot_Date' as 'Snapshot_Date_Used',\n    'Manager_nm' as 'Manager_Name',\n    'CLOSE_DT_Quarter' as 'Close_Quarter',\n    'Snapshot_Date_Quarter' as 'Snapshot_Quarter_Number',\n    max('LASTMODIFIED_DT_Quarter') as 'Last_Update_Quarter',\n    max('LASTMODIFIED_DT_Year') as 'Last_Update_Year',\n    max('LASTMODIFIED_DT_Month') as 'Last_Update_Month';\n\n-- Remove duplicates in historical data while maintaining original structure\n-- Second level of deduplication to ensure clean final dataset\nq_UpOpp_Month_SnapshotM_Details_Clean = group q_UpOpp_Month_SnapshotM_Details by ('Opportunity_ID', 'Snapshot_Month');\nq_UpOpp_Month_SnapshotM_Details_Clean = foreach q_UpOpp_Month_SnapshotM_Details_Clean generate \n    'Opportunity_ID',\n    max('Opportunity_Name') as 'Opportunity_Name',\n    max('Owner_Id') as 'Owner_Id',\n    max('Opportunity_Owner_Name') as 'Opportunity_Owner_Name',\n    max('Updates_Date') as 'Updates_Date',\n    max('Updated_in_Snapshot_Month') as 'Updated_in_Snapshot_Month',\n    max('Updated_in_Snapshot_Quarter') as 'Updated_in_Snapshot_Quarter',\n    max('Snapshot_Month') as 'Snapshot_Month',\n    max('Snapshot_Quarter') as 'Snapshot_Quarter',\n    max('Snapshot_Date_Used') as 'Snapshot_Date_Used',\n    max('Manager_Name') as 'Manager_Name',\n    max('Close_Quarter') as 'Close_Quarter',\n    max('Last_Update_Quarter') as 'Last_Update_Quarter';\n\n-- ========================================\n-- CURRENT MONTH OPPORTUNITIES PROCESSING\n-- ========================================\nq_AllOpp = load \"UpdatesMetric\";\n\n-- Apply same security filters as historical data\nq_AllOpp= filter q_AllOpp by \n   'OWNER_SYSTEM_ID' == \"$User.Id\" ||  \n   'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || \n    'MetricsOpe.ID' matches \"!{User.Id}\" || 'MetricsOpe.ID2' matches \"!{User.Id}\" || 'MetricsOpe.ID3' matches \"!{User.Id}\" || \n    'MetricsOpe.ID4' matches \"!{User.Id}\" || 'MetricsOpe.ID5' matches \"!{User.Id}\" || 'MetricsOpe.ID6' matches \"!{User.Id}\" || \n   'MetricsOpe.ID7' matches \"!{User.Id}\" || 'MetricsOpe.ID8' matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n\n-- Apply same manager hierarchy filter as historical data\nq_AllOpp= filter q_AllOpp by 'OWNER_HIERARCHY_TXT' matches coalesce({{cell(USER_NM_1.selection, 0, \"User_Ids\").asString()}}, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ));\n\n-- Data quality filters for current month opportunities\nq_AllOpp = filter q_AllOpp by 'USER_NM' is not null;                   \nq_AllOpp = filter q_AllOpp by 'OPPORTUNITY_NM' is not null;            \n\n-- MAIN BUSINESS RULE: All opportunities closing in current quarter\n-- This matches the quarter logic from historical snapshots\nq_AllOpp = filter q_AllOpp by date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"];\n\n-- Group current opportunities to eliminate duplicates and prepare for analysis\nq_AllOpp_Grouped = group q_AllOpp by (\n    'OPPORTUNITYID',       \n    'OPPORTUNITY_NM',      \n    'USER_NM',    \n    'USER_ID',          \n    'OWNER_HIERARCHY_TXT',  \n    'CLOSE_DT_Year',        \n    'CLOSE_DT_Month',\n    'CLOSE_DT_Day'\n);\n\n-- Generate current month opportunity status with same business logic as snapshots\nq_OpportunityStatus = foreach q_AllOpp_Grouped generate \n    'OPPORTUNITYID' as 'Opportunity_ID',\n    'OPPORTUNITY_NM' as 'Opportunity_Name',\n    'USER_NM' as 'Opportunity_Owner_Name',\n    'USER_ID' as 'Owner_Id',\n    case \n        when max('LASTMODIFIED_DT_Year') == date_to_string(now(), \"yyyy\") && \n             max('LASTMODIFIED_DT_Month') == date_to_string(now(), \"MM\")\n        then \"Yes\"\n        else \"No\"\n    end as 'Updated_in_Snapshot_Month',\n    max('LASTMODIFIED_DT_Year') + \"-\" + max('LASTMODIFIED_DT_Month') + \"-\" + max('LASTMODIFIED_DT_Day') as 'Last_Modified_Date',\n    case \n        when max('LASTMODIFIED_DT_Year') == date_to_string(now(), \"yyyy\") && \n             max('LASTMODIFIED_DT_Month') == date_to_string(now(), \"MM\")\n        then max('LASTMODIFIED_DT_Year') + \"-\" + max('LASTMODIFIED_DT_Month') + \"-\" + max('LASTMODIFIED_DT_Day')\n        else \"Not updated this month\"\n    end as 'Updates_Date',\n    \n    -- Current period information for consistency with historical data\n    date_to_string(now(), \"yyyy-MM\") as 'Snapshot_Month',\n    date_to_string(now(), \"yyyy-MM-dd\") as 'Snapshot_Date_Used',\n    \"\" as 'Manager_Name',                                      \n    -- Additional useful information for analysis\n    'CLOSE_DT_Year' + \"-\" + 'CLOSE_DT_Month' + \"-\" + 'CLOSE_DT_Day' as 'Close_Date',\n    'CLOSE_DT_Year' + \"-\" + 'CLOSE_DT_Month' as 'Close_Month';\n\n-- ========================================\n-- FINAL METRIC COMBINATION AND FILTERING\n-- ========================================\n-- Combine historical and current data into unified result\nq_OppUnion = union q_UpOpp_Month_SnapshotM_Details_Clean, q_OpportunityStatus;\nq_OppUnion = filter q_OppUnion by 'Snapshot_Month' in {{coalesce(column(Account_Fields_Name_1.selection, [\"Month\"]),\"all\").asString()}};\n\n-- Final data quality filter - only opportunities with valid owner names\nq_OppUnion = filter q_OppUnion by 'Opportunity_Owner_Name' is not null;\n\n-- ========================================\n-- FINAL RESULT GENERATION\n-- ========================================\n\nq_Final_Result = group q_OppUnion by('Opportunity_ID',                                       \n    'Opportunity_Name',                                     \n    'Opportunity_Owner_Name', \n    'Owner_Id',\n    'Updated_in_Snapshot_Month');\n\nq_Final_Result = foreach q_Final_Result generate \n    'Opportunity_ID' as 'Opportunity_ID' ,                                       \n    'Opportunity_Name' as 'Opportunity Name',                                     \n    'Opportunity_Owner_Name' as 'Opportunity Owner Name',\n    'Owner_Id',   \n    case when 'Updated_in_Snapshot_Month' == \"Yes\" then \"#9fd541\" else \"#c81326\" end as 'color',\n    \"■\" as 'Opportunity Updated';  \n-- ========================================\n-- SUMMARY OF OUTPUT\n-- ========================================\n-- Final result shows:\n-- 1. Opportunity_ID: Unique identifier for each opportunity\n-- 2. Opportunity_Name: User-friendly name of the opportunity  \n-- 3. Opportunity Owner Name: Person responsible for the opportunity\n-- 4. Updated in Snapshot Month: \"Yes\" if updated in selected month, \"No\" if not\n-- This detailed view complements Code 1's aggregated percentages by showing\n-- exactly which opportunities contribute to the calculated metrics.\n-- ========================================","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Opportunity Name","Opportunity Owner Name","Opportunity Updated"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Core_Account_Level___1":{"broadcastFacet":true,"datasets":[{"name":"ManagerMetric_AccountPlan"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Core_Account_Level__c\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[\"Level1\"]","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{}},"lens_20_4":{"broadcastFacet":true,"groups":[],"label":"lens_20","numbers":[],"query":"q_managers = load \"ManagerUsers\"; \nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ); \nq_managers = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt', number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\")  as 'last_year',date_to_string(now(), \"yyyy\") as 'current_year', date_to_string(now(), \"MM\") as 'current_month';\n\nquarters = foreach q_managers generate   'Manager_nm', 'Manager_wwid', 'manager_cnt','current_year','current_month','last_year' , case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  then 'last_year' else 'current_year'  end as 'q2_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\" || 'current_month' == \"06\" then 'last_year' else 'current_year'   end as 'q3_year', case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\" || 'current_month' == \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"  || 'current_month' == \"07\" ||  'current_month' == \"08\"  || 'current_month' == \"09\" then 'last_year' else 'current_year'   end  as 'q4_year' \n,case when  'current_month' ==  \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"   then \"04\"\nwhen   'current_month' ==  \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"   then \"01\"\nwhen  'current_month' ==  \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"   then \"02\"\nwhen  'current_month' ==  \"10\" || 'current_month' == \"11\" || 'current_month' == \"12\"   then \"03\"  end as 'last_Q'\n,case when    'current_month' ==  \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"   then \"03\"\nwhen   'current_month' ==  \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"   then \"04\"\nwhen  'current_month' ==  \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"   then \"01\"\nwhen  'current_month' ==  \"10\" || 'current_month' == \"11\" || 'current_month' == \"12\"   then \"02\"  end as 'last2_Q'\n,case when    'current_month' ==  \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"   then \"02\"\nwhen   'current_month' ==  \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"   then \"03\"\nwhen  'current_month' ==  \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"   then \"04\"\nwhen  'current_month' ==  \"10\" || 'current_month' == \"11\" || 'current_month' == \"12\"   then \"01\"  end as 'last3_Q'\n,case when    'current_month' ==  \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"   then \"01\"\nwhen   'current_month' ==  \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"   then \"02\"\nwhen  'current_month' ==  \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"   then \"03\"\nwhen  'current_month' ==  \"10\" || 'current_month' == \"11\" || 'current_month' == \"12\"   then \"04\"  end as 'Current_q';\n\nquarter1 = foreach quarters generate  'Manager_nm', 'Manager_wwid','manager_cnt','current_year'  as 'Snapshot_Date_Year', 'Current_q' as 'Snapshot_Date_Quarter' ;\nquarter2 = foreach quarters generate  'Manager_nm','Manager_wwid', 'manager_cnt','q2_year' as 'Snapshot_Date_Year', 'last_Q' as 'Snapshot_Date_Quarter' ;\nquarter3 = foreach quarters generate  'Manager_nm','Manager_wwid', 'manager_cnt','q3_year' as 'Snapshot_Date_Year','last2_Q' as 'Snapshot_Date_Quarter' ;\nquarter4 = foreach quarters generate  'Manager_nm', 'Manager_wwid','manager_cnt','q4_year' as 'Snapshot_Date_Year','last3_Q' as 'Snapshot_Date_Quarter' ; \nquarters = union quarter1,quarter2,quarter3,quarter4 ;\nquarters = group quarters by ('Manager_nm','Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Quarter');\nquarters = foreach quarters generate  'Manager_nm','Manager_wwid',  'Snapshot_Date_Year','Snapshot_Date_Quarter';\n\nq = load \"Forecast_Snapshot_with_Transforms_Secured\";\n\n\nq = filter q  by 'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches coalesce({{cell(Sales_Rep_1.selection, 0, \"User_Ids\").asString()}}, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ));\nq = filter q by 'OppAccountUser.Id' ==  \"$User.Id\" ||  'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq = filter q by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in  [\"3 quarters ago\"..\"1 quarter ago\"] ;\nq = filter q by 'Opportunity.Core_Opportunity_Coverage_Nm__c' in [\"Intel-Led Opportunity\"];\nq = filter q by  'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nq = filter q by ('OpportunityProducts.Core_Status__c' not in [\"Cancelled\",\"Lost\"] || 'opp_status' is null) and ('StageName' not in [\"Cancelled\", \"Design Win\", \"Group\", \"Group Cancelled\", \"Group Closed\", \"Group Open\",\"Lost\", \"Production Cancelled\", \"Production Win\"] || 'StageName' is null) and (date('KPI_Decision_date_Year', 'KPI_Decision_date_Month', 'KPI_Decision_date_Day') in [\"3 quarters ago\"..\"current quarter\"] or (date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"3 quarters ago\"..\"current quarter\"] and 'Core_Product_Count__c' == 0));\nq_opps_unhealthy = filter q by 'opportunity_unhealthy' == 1;\n\nq = cogroup q by ('Snapshot_Date_Year','Snapshot_Date_Quarter','Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT','Opportunity.DIM_MANAGE.OWNER_NM','Id','Name','StageName','OwnerId') full, q_opps_unhealthy by ('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT','Opportunity.DIM_MANAGE.OWNER_NM','Id','Name','StageName','OwnerId');\n\nq = foreach q generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm', coalesce(substr(q.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT', index_of(q.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18),substr(q_opps_unhealthy.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT', index_of(q_opps_unhealthy.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18))as 'Manager_wwid', coalesce(q.'Id',q_opps_unhealthy.'Id') as 'Opportunity id', coalesce(q.'Name',q_opps_unhealthy.'Name') as 'Opportunity Name', coalesce(q.'Opportunity.DIM_MANAGE.OWNER_NM',q_opps_unhealthy.'Opportunity.DIM_MANAGE.OWNER_NM') as 'Opportunity Owner Name',  coalesce(q.'StageName',q_opps_unhealthy.'StageName') as 'Stage Name', coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') as 'Snapshot_Date_Year',  coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') + \"0\" + coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') as 'YearQuarterDate', coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') as 'Snapshot_Date_Quarter',\ncase \n    when coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') == \"1\" then coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') + \"-Q1\"\n    when coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') == \"2\" then coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') + \"-Q2\"\n    when coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') == \"3\" then coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') + \"-Q3\"\n    when coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') == \"4\" then coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') + \"-Q4\"\nend as 'Quarter', max(q.'Snapshot_Date_Month') as 'Snapshot_Date_Month', max(q.'Snapshot_Date_Day') as 'Snapshot_Date_Day',coalesce(unique(q.'Id'),0) as 'count_opps', coalesce(unique(q_opps_unhealthy.'Id'),0) as 'opps_unhealthy', coalesce(q.'OwnerId', q_opps_unhealthy.'OwnerId') as  'OwnerId' ;\n\nq = group q by ('Manager_nm','Manager_wwid','Opportunity id', 'Opportunity Name', 'Opportunity Owner Name', 'Snapshot_Date_Year',   'Snapshot_Date_Quarter','OwnerId');\nq = foreach q generate  'Manager_nm','Manager_wwid', 'Opportunity id', 'Opportunity Name', 'Opportunity Owner Name', max('Snapshot_Date_Year') as 'Snapshot_Date_Year',max('Snapshot_Date_Month') as 'Snapshot_Date_Month', max('Snapshot_Date_Day') as 'Snapshot_Date_Day',  'Snapshot_Date_Quarter',    1-(sum(opps_unhealthy)/sum(count_opps))   as 'confidence' ,'OwnerId';\n\nq = group q by ('Manager_nm','Manager_wwid','Opportunity id', 'Opportunity Name', 'Opportunity Owner Name', 'Snapshot_Date_Year',   'Snapshot_Date_Quarter','Snapshot_Date_Month', 'Snapshot_Date_Day','OwnerId' );\nq = foreach q generate  'Manager_nm','Manager_wwid', 'Opportunity id', 'Opportunity Name', 'Opportunity Owner Name','OwnerId', 'Snapshot_Date_Year',   'Snapshot_Date_Quarter', 'Snapshot_Date_Month', 'Snapshot_Date_Day',  avg(confidence)   as 'confidence' ;\n \nq = group q by ('Manager_nm','Manager_wwid','Opportunity id', 'Opportunity Name','OwnerId', 'Opportunity Owner Name', 'Snapshot_Date_Year', 'Snapshot_Date_Quarter','Snapshot_Date_Month', 'Snapshot_Date_Day' );\n\nconfidence_snapshot = foreach q generate  'Manager_nm','Manager_wwid','Opportunity id', 'OwnerId','Opportunity Name', 'Opportunity Owner Name', 'Snapshot_Date_Year',\"0\" + 'Snapshot_Date_Quarter' as 'Snapshot_Date_Quarter'  ,max('confidence') as 'Snapshot',case when 'Snapshot_Date_Year' is null then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") + 'Snapshot_Date_Quarter' when  'Snapshot_Date_Quarter' == \"1\" then 'Snapshot_Date_Year' + \"-Q1\"  when  'Snapshot_Date_Quarter' == \"2\" then 'Snapshot_Date_Year' + \"-Q2\"  when  'Snapshot_Date_Quarter' == \"3\" then 'Snapshot_Date_Year' + \"-Q3\" else 'Snapshot_Date_Year' + \"-Q4\" end as 'Quarter','Snapshot_Date_Year'+\"-\"+'Snapshot_Date_Month'+ \"-\"+'Snapshot_Date_Day' as 'Date';\n \n\n---Confidence\nq_confidence = load \"ManagerConfidenceMetric\";\n\nq_confidence = filter q_confidence  by 'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches coalesce({{cell(Sales_Rep_1.selection, 0, \"User_Ids\").asString()}}, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ));\nq_confidence= filter q_confidence by 'User.Id' ==  \"$User.Id\" ||  'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'User.MetricsOpe.ID'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID2'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID3'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID4'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID5'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID6'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID7'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID8'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID9' matches \"!{User.Id}\";\nq_confidence = filter q_confidence by 'Core_Opportunity_Coverage_Nm__c' == \"Intel-Led Opportunity\";\nq_confidence= filter q_confidence by  'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  ;\nq_confidence = filter q_confidence by 'Confidence.op.Core_Status__c' not in  [\"Cancelled\",\"Lost\"];\nq_confidence = filter q_confidence by (date('Confidence.op.Core_KPI_Date__c_Year', 'Confidence.op.Core_KPI_Date__c_Month', 'Confidence.op.Core_KPI_Date__c_Day') in [\"3 quarters ago\"..\"current quarter\"] or  date('Confidence.CloseDate_Year', 'Confidence.CloseDate_Month', 'Confidence.CloseDate_Day')  in [\"3 quarters ago\"..\"current quarter\"] );\n\nq_confidence = foreach q_confidence generate \"\" as 'Manager_nm',substr('DIM_MANAGE.OWNER_HIERARCHY_TXT', index_of('DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Confidence.OpportunityProducts.Name' as 'Confidence.op.Name',  'Confidence.Name' as 'Opportunity Name',  'Confidence.Id' as 'Opportunity id' ,  'Confidence.OpportunityProducts.Product2Id' as 'Confidence.OpportunityProducts.Product2Id', 'Confidence.unhealthy', 'OwnerId' as 'OwnerId','DIM_MANAGE.OWNER_NM' as 'Opportunity Owner Name','Confidence.op.Core_KPI_Date__c_Quarter';\n\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm','Opportunity id','Opportunity Name','OwnerId','Confidence.unhealthy','OwnerId','Opportunity Owner Name','Confidence.op.Core_KPI_Date__c_Quarter');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm','Opportunity id','Opportunity Name','OwnerId','Opportunity Owner Name', max('Confidence.unhealthy') as 'unhealthy_total','Confidence.op.Core_KPI_Date__c_Quarter';\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm','Opportunity id','Opportunity Name','OwnerId','Opportunity Owner Name','Confidence.op.Core_KPI_Date__c_Quarter');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm','Opportunity id','Opportunity Name','OwnerId','Opportunity Owner Name',(1- (sum('unhealthy_total') / count()) )  as 'Actual','Confidence.op.Core_KPI_Date__c_Quarter'\n,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"02\" then  date_to_string(now(), \"yyyy\") + \"-Q1\" \n when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\"  || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-Q2\"  \n when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\"  || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-Q3\"  \n else date_to_string(now(), \"yyyy\") + \"Q4\" end as 'Quarter'\n ,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"02\" then  date_to_string(now(), \"yyyy\") + \"-Q1\" \n when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\"  || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-Q2\"  \n when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\"  || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-Q3\"  \n else date_to_string(now(), \"yyyy\") + \"-Q4\" end as 'Current_Quarter', date_to_string(now(), \"yyyy-MM-dd\") as 'Date';\n\n\n\n\nq_confidence_managers_snapshot = union confidence_snapshot,q_confidence;\n\nq_confidence_managers_snapshot = filter q_confidence_managers_snapshot by   'Manager_nm' != \"!{User.Name}\"  && 'Quarter' is not null;\nq_confidence_managers_snapshot = filter q_confidence_managers_snapshot by  'Quarter' in {{coalesce(column(Account_Fields_Name__2.selection, [\"Quarter\"]),\"all\").asString()}}  ; \nq_confidence_managers_snapshot = filter q_confidence_managers_snapshot by 'Opportunity id' is not null;\nq_confidence_managers_snapshot = filter q_confidence_managers_snapshot by 'Date'  in {{coalesce(column(first_snap_of_month__1.result, [\"SnapshotDate\"]),\"all\").asString()}};\nq_confidence_managers_snapshot = group q_confidence_managers_snapshot by ( 'Manager_nm','Opportunity id', 'Opportunity Owner Name','OwnerId','Quarter','Date' );\nq_confidence_managers_snapshot = foreach q_confidence_managers_snapshot generate  'Manager_nm'\n, 'Opportunity id', max('Opportunity Name') as 'Opportunity Name', 'OwnerId', 'Opportunity Owner Name'\n,'Quarter'\n,'Date' \n,case   when max('Current_Quarter') == 'Quarter'  then max('Actual') when max('Snapshot') is null then null else max('Snapshot') end as 'Metric_n'\n,case when max('Current_Quarter') == 'Quarter'  then  number_to_string( max('Actual') ,\"#%\") when max('Snapshot') is null then \"NA\"  else   number_to_string(max('Snapshot'),\"#%\")  end as 'Metric'\n,case when (case when max('Current_Quarter') == 'Quarter' then max('Actual') when max('Snapshot') is null then null  else   max('Snapshot')  end) > 0 then \"Yes\" else \"No\" end as 'Healthy';\n\nq_confidence_managers_snapshot =  group q_confidence_managers_snapshot by ('Opportunity id', 'Opportunity Name', 'OwnerId','Opportunity Owner Name', 'Quarter', 'Healthy');\nq_confidence_managers_snapshot = foreach q_confidence_managers_snapshot generate 'Opportunity id','Opportunity Name', 'OwnerId','Opportunity Owner Name',  max('Date') as 'Date', \"■\" as 'Confidence', case when  'Healthy' ==  \"Yes\" then  \"#9fd541\" else \"#c81326\" end as 'mark_color';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Opportunity Name","Opportunity Owner Name","Date","Confidence"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Account_Fields_Name_1":{"broadcastFacet":false,"groups":[],"label":"Account_Fields_Name_1","numbers":[],"query":"q_snapshot = load \"Snapshot_Account\"; \nq_snapshot = group q_snapshot by (Snapshot_Date_Year,Snapshot_Date_Month);\nq_snapshot = foreach q_snapshot generate Snapshot_Date_Year + \"-\" + Snapshot_Date_Month as 'Month';\nq_snapshot = order q_snapshot by 'Month' asc;\n\nq_actual = load \"ManagerMetric_AccountPlan\";\nq_actual = foreach q_actual generate date_to_string(now(), \"yyyy\") + \"-\" + date_to_string(now(), \"MM\") as 'Month';\nq_actual = order q_actual by 'Month' asc;\n\nq_final = union q_snapshot,q_actual;\nq_final = group q_final by ('Month');\nq_final = foreach q_final generate 'Month';\nq_final = order q_final by 'Month' desc;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"singlerequired","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":