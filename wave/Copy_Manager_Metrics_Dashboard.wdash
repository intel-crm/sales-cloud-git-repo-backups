 'current_month' == \"02\"  || 'current_month' == \"03\" || 'current_month' == \"04\" then 'last_year' else 'current_year'   end  as 'm5_year' ,case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  || 'current_month' == \"04\" || 'current_month' == \"05\" then 'last_year' else 'current_year'  end as 'm6_year', case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  || 'current_month' == \"04\"  || 'current_month' == \"05\" || 'current_month' == \"06\" then 'last_year' else 'current_year'   end as 'm7_year' ,case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  || 'current_month' == \"04\" || 'current_month' == \"05\"  || 'current_month' == \"06\" || 'current_month' == \"07\" then 'last_year' else 'current_year'  end as 'm8_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"  || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\" || 'current_month' == \"07\" || 'current_month' == \"08\" then 'last_year' else 'current_year' end as 'm9_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\"  || 'current_month' == \"07\" || 'current_month' == \"08\"  || 'current_month' == \"09\" then 'last_year' else 'current_year'   end  as 'm10_year',case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\"  || 'current_month' == \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"  || 'current_month' == \"10\" then 'last_year' else 'current_year' end  as 'm11_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\"  || 'current_month' == \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"  || 'current_month' == \"10\"  || 'current_month' == \"11\" then 'last_year' else 'current_year' end as 'm12_year'\n,case when  'current_month' ==  \"01\" then \"12\"\nwhen  'current_month' ==  \"02\" then \"01\"\nwhen  'current_month' ==  \"03\" then \"02\"\nwhen  'current_month' ==  \"04\" then \"03\"\nwhen  'current_month' ==  \"05\" then \"04\" \nwhen  'current_month' ==  \"06\" then \"05\"\nwhen  'current_month' ==  \"07\" then \"06\"\nwhen  'current_month' ==  \"08\" then \"07\"\nwhen  'current_month' ==  \"09\" then \"08\"\nwhen  'current_month' ==  \"10\" then \"09\"\nwhen  'current_month' ==  \"11\" then \"10\"\nwhen  'current_month' ==  \"12\" then \"11\"end as 'last_m'\n,case when  'current_month' ==  \"01\" then \"11\"\nwhen  'current_month' ==  \"02\" then \"12\"\nwhen  'current_month' ==  \"03\" then \"01\"\nwhen  'current_month' ==  \"04\" then \"02\"\nwhen  'current_month' ==  \"05\" then \"03\" \nwhen  'current_month' ==  \"06\" then \"04\"\nwhen  'current_month' ==  \"07\" then \"05\"\nwhen  'current_month' ==  \"08\" then \"06\"\nwhen  'current_month' ==  \"09\" then \"07\"\nwhen  'current_month' ==  \"10\" then \"08\"\nwhen  'current_month' ==  \"11\" then \"09\"\nwhen  'current_month' ==  \"12\" then \"10\"end as 'last2_m'\n,case when  'current_month' ==  \"01\" then \"10\"\nwhen  'current_month' ==  \"02\" then \"11\"\nwhen  'current_month' ==  \"03\" then \"12\"\nwhen  'current_month' ==  \"04\" then \"01\"\nwhen  'current_month' ==  \"05\" then \"02\" \nwhen  'current_month' ==  \"06\" then \"03\"\nwhen  'current_month' ==  \"07\" then \"04\"\nwhen  'current_month' ==  \"08\" then \"05\"\nwhen  'current_month' ==  \"09\" then \"06\"\nwhen  'current_month' ==  \"10\" then \"07\"\nwhen  'current_month' ==  \"11\" then \"08\"\nwhen  'current_month' ==  \"12\" then \"09\"end as 'last3_m'\n,case when  'current_month' ==  \"01\" then \"09\"\nwhen  'current_month' ==  \"02\" then \"10\"\nwhen  'current_month' ==  \"03\" then \"11\"\nwhen  'current_month' ==  \"04\" then \"12\"\nwhen  'current_month' ==  \"05\" then \"01\" \nwhen  'current_month' ==  \"06\" then \"02\"\nwhen  'current_month' ==  \"07\" then \"03\"\nwhen  'current_month' ==  \"08\" then \"04\"\nwhen  'current_month' ==  \"09\" then \"05\"\nwhen  'current_month' ==  \"10\" then \"06\"\nwhen  'current_month' ==  \"11\" then \"07\"\nwhen  'current_month' ==  \"12\" then \"08\"end as 'last4_m'\n\n,case when  'current_month' ==  \"01\" then \"08\"\nwhen  'current_month' ==  \"02\" then \"09\"\nwhen  'current_month' ==  \"03\" then \"10\"\nwhen  'current_month' ==  \"04\" then \"11\"\nwhen  'current_month' ==  \"05\" then \"12\" \nwhen  'current_month' ==  \"06\" then \"01\"\nwhen  'current_month' ==  \"07\" then \"02\"\nwhen  'current_month' ==  \"08\" then \"03\"\nwhen  'current_month' ==  \"09\" then \"04\"\nwhen  'current_month' ==  \"10\" then \"05\"\nwhen  'current_month' ==  \"11\" then \"06\"\nwhen  'current_month' ==  \"12\" then \"07\"end as 'last5_m'\n,case when  'current_month' ==  \"01\" then \"07\"\nwhen  'current_month' ==  \"02\" then \"08\"\nwhen  'current_month' ==  \"03\" then \"09\"\nwhen  'current_month' ==  \"04\" then \"10\"\nwhen  'current_month' ==  \"05\" then \"11\" \nwhen  'current_month' ==  \"06\" then \"12\"\nwhen  'current_month' ==  \"07\" then \"01\"\nwhen  'current_month' ==  \"08\" then \"02\"\nwhen  'current_month' ==  \"09\" then \"03\"\nwhen  'current_month' ==  \"10\" then \"04\"\nwhen  'current_month' ==  \"11\" then \"05\"\nwhen  'current_month' ==  \"12\" then \"06\"end as 'last6_m'\n,case when  'current_month' ==  \"01\" then \"06\"\nwhen  'current_month' ==  \"02\" then \"07\"\nwhen  'current_month' ==  \"03\" then \"08\"\nwhen  'current_month' ==  \"04\" then \"09\"\nwhen  'current_month' ==  \"05\" then \"10\" \nwhen  'current_month' ==  \"06\" then \"11\"\nwhen  'current_month' ==  \"07\" then \"12\"\nwhen  'current_month' ==  \"08\" then \"01\"\nwhen  'current_month' ==  \"09\" then \"02\"\nwhen  'current_month' ==  \"10\" then \"03\"\nwhen  'current_month' ==  \"11\" then \"04\"\nwhen  'current_month' ==  \"12\" then \"05\"end as 'last7_m'\n,case when  'current_month' ==  \"01\" then \"05\"\nwhen  'current_month' ==  \"02\" then \"06\"\nwhen  'current_month' ==  \"03\" then \"07\"\nwhen  'current_month' ==  \"04\" then \"08\"\nwhen  'current_month' ==  \"05\" then \"09\" \nwhen  'current_month' ==  \"06\" then \"10\"\nwhen  'current_month' ==  \"07\" then \"11\"\nwhen  'current_month' ==  \"08\" then \"12\"\nwhen  'current_month' ==  \"09\" then \"01\"\nwhen  'current_month' ==  \"10\" then \"02\"\nwhen  'current_month' ==  \"11\" then \"03\"\nwhen  'current_month' ==  \"12\" then \"04\"end as 'last8_m'\n\n,case when  'current_month' ==  \"01\" then \"04\"\nwhen  'current_month' ==  \"02\" then \"05\"\nwhen  'current_month' ==  \"03\" then \"06\"\nwhen  'current_month' ==  \"04\" then \"07\"\nwhen  'current_month' ==  \"05\" then \"08\" \nwhen  'current_month' ==  \"06\" then \"09\"\nwhen  'current_month' ==  \"07\" then \"10\"\nwhen  'current_month' ==  \"08\" then \"11\"\nwhen  'current_month' ==  \"09\" then \"12\"\nwhen  'current_month' ==  \"10\" then \"01\"\nwhen  'current_month' ==  \"11\" then \"02\"\nwhen  'current_month' ==  \"12\" then \"03\"end as 'last9_m'\n,case when  'current_month' ==  \"01\" then \"03\"\nwhen  'current_month' ==  \"02\" then \"04\"\nwhen  'current_month' ==  \"03\" then \"05\"\nwhen  'current_month' ==  \"04\" then \"06\"\nwhen  'current_month' ==  \"05\" then \"07\" \nwhen  'current_month' ==  \"06\" then \"08\"\nwhen  'current_month' ==  \"07\" then \"09\"\nwhen  'current_month' ==  \"08\" then \"10\"\nwhen  'current_month' ==  \"09\" then \"11\"\nwhen  'current_month' ==  \"10\" then \"12\"\nwhen  'current_month' ==  \"11\" then \"01\"\nwhen  'current_month' ==  \"12\" then \"02\"end as 'last10_m'\n,case when  'current_month' ==  \"01\" then \"02\"\nwhen  'current_month' ==  \"02\" then \"03\"\nwhen  'current_month' ==  \"03\" then \"04\"\nwhen  'current_month' ==  \"04\" then \"05\"\nwhen  'current_month' ==  \"05\" then \"06\" \nwhen  'current_month' ==  \"06\" then \"07\"\nwhen  'current_month' ==  \"07\" then \"08\"\nwhen  'current_month' ==  \"08\" then \"09\"\nwhen  'current_month' ==  \"09\" then \"10\"\nwhen  'current_month' ==  \"10\" then \"11\"\nwhen  'current_month' ==  \"11\" then \"12\"\nwhen  'current_month' ==  \"12\" then \"01\"end as 'last11_m';\n\nmonth1 = foreach months generate  'Manager_nm', 'current_year'  as 'Snapshot_Date_Year', 'current_month' as 'Snapshot_Date_Month' ;\nmonth2 = foreach months generate  'Manager_nm', 'm2_year' as 'Snapshot_Date_Year', 'last_m' as 'Snapshot_Date_Month' ;\nmonth3 = foreach months generate  'Manager_nm', 'm3_year' as 'Snapshot_Date_Year','last2_m' as 'Snapshot_Date_Month' ;\nmonth4 = foreach months generate  'Manager_nm', 'm4_year' as 'Snapshot_Date_Year','last3_m' as 'Snapshot_Date_Month' ;\nmonth5 = foreach months generate  'Manager_nm', 'm5_year' as 'Snapshot_Date_Year','last4_m' as 'Snapshot_Date_Month' ;\nmonth6 = foreach months generate  'Manager_nm', 'm6_year' as 'Snapshot_Date_Year','last5_m'  as 'Snapshot_Date_Month' ;\nmonth7 = foreach months generate  'Manager_nm', 'm7_year' as 'Snapshot_Date_Year','last6_m'  as 'Snapshot_Date_Month' ;\nmonth8 = foreach months generate  'Manager_nm', 'm8_year' as'Snapshot_Date_Year','last7_m' as 'Snapshot_Date_Month' ;\nmonth9 = foreach months generate  'Manager_nm', 'm9_year' as'Snapshot_Date_Year','last8_m' as 'Snapshot_Date_Month' ;\nmonth10= foreach months generate  'Manager_nm', 'm10_year' as 'Snapshot_Date_Year','last9_m' as 'Snapshot_Date_Month' ;\nmonth11 = foreach months generate 'Manager_nm', 'm11_year' as 'Snapshot_Date_Year','last10_m' as 'Snapshot_Date_Month' ;\nmonth12= foreach months generate  'Manager_nm', 'm12_year' as  'Snapshot_Date_Year','last11_m' as 'Snapshot_Date_Month' ;\nmonths = union month1,month2,month3,month4,month5,month6,month7,month8,month9,month10,month11,month12;\nmonths = group months by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Month');\nmonths = foreach months generate  'Manager_nm','Snapshot_Date_Year','Snapshot_Date_Month' ;\n\n\n\n-- ========================================\n-- SNAPSHOT DATA PROCESSING\n-- ========================================\n-- Apply security filters\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by \n    'OWNER_SYSTEM_ID' == \"$User.Id\" ||  \n    'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || \n    'MetricsOpe.ID' matches \"!{User.Id}\" || 'MetricsOpe.ID2' matches \"!{User.Id}\" || 'MetricsOpe.ID3' matches \"!{User.Id}\" || \n    'MetricsOpe.ID4' matches \"!{User.Id}\" || 'MetricsOpe.ID5' matches \"!{User.Id}\" || 'MetricsOpe.ID6' matches \"!{User.Id}\" || \n    'MetricsOpe.ID7' matches \"!{User.Id}\" || 'MetricsOpe.ID8' matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by  \n    'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\n\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by \n    date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 year ago\"..\"current year\"];\n\n\n-- ========================================\n-- PROCESS BEFORE GROUPING\n-- ========================================\n-- Apply business logic to individual records BEFORE grouping\n\nq_UpOpp_Month_Snapshot_Processed = foreach q_UpOpp_Month_Snapshot generate \n    coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',\n    coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',\n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month',\n    'OPPORTUNITYID',\n    'CLOSE_DT_Quarter',\n    'CLOSE_DT_Year',\n    'Snapshot_Date_Quarter',\n    'LASTMODIFIED_DT_Quarter',\n    'LASTMODIFIED_DT_Year',\n    'LASTMODIFIED_DT_Month',\n    \n    -- Business logic flags\n    case when 'CLOSE_DT_Quarter' == 'Snapshot_Date_Quarter' && 'CLOSE_DT_Year' == 'Snapshot_Date_Year' \n         then 1 else 0 end as 'Is_Total_Opp',\n    \n    case when ('CLOSE_DT_Quarter' == 'Snapshot_Date_Quarter' && 'CLOSE_DT_Year' == 'Snapshot_Date_Year') && \n              ('Snapshot_Date_Month' == 'LASTMODIFIED_DT_Month' && 'Snapshot_Date_Year' == 'LASTMODIFIED_DT_Year') \n         then 1 else 0 end as 'Is_Update_Opp';\n\n-- ========================================\n-- DEDUPLICATION AT OPPORTUNITY LEVEL\n-- ========================================\n-- Remove duplicates at opportunity level first\nq_UpOpp_Month_Snapshot_Dedup = group q_UpOpp_Month_Snapshot_Processed by (\n    'OPPORTUNITYID', \n    'Manager_wwid', \n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month'\n);\n\nq_UpOpp_Month_Snapshot_Dedup = foreach q_UpOpp_Month_Snapshot_Dedup generate \n    'OPPORTUNITYID',\n    'Manager_wwid',\n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month',\n    max('Manager_nm') as 'Manager_nm',\n    max('Is_Total_Opp') as 'Is_Total_Opp',\n    max('Is_Update_Opp') as 'Is_Update_Opp';\n\n-- ========================================\n-- PROPER AGGREGATION BY MANAGER AND MONTH\n-- ========================================\nq_UpOpp_Month_Snapshot_Agg = group q_UpOpp_Month_Snapshot_Dedup by (\n    'Manager_wwid', \n    'Manager_nm', \n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month'\n);\n\nq_Metric = foreach q_UpOpp_Month_Snapshot_Agg generate \n    'Manager_wwid',\n    'Manager_nm',\n    \"% total of current opptys updated last month\" as 'Metric Name',\n    'Snapshot_Date_Year',\n    'Snapshot_Date_Month',\n    \n    -- Count totals (not sum of unique which causes problems)\n    sum('Is_Total_Opp') as 'Total_Opp',\n    sum('Is_Update_Opp') as 'Update_Opp',\n    \n    -- Calculate percentage with proper null handling\n    case when sum('Is_Total_Opp') > 0 \n         then sum('Is_Update_Opp') / sum('Is_Total_Opp')\n         else null \n    end as 'Snapshot';\n\n-- ========================================\n-- UNION WITH MONTHS AND FINAL PROCESSING\n-- ========================================\nq_UpOpp_Month_SnapshotM = union q_Metric, months;\n\nq_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Manager_nm');\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate \n    'Manager_nm',\n    case when 'Snapshot_Date_Year' is null \n         then number_to_string((string_to_number(date_to_string(now(), \"yyyy\")) - 1), \"#\") + \"-\" + 'Snapshot_Date_Month' \n         else 'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Month' \n    end as 'Month',\n    case when max('Snapshot') is null then null else max('Snapshot') end as 'Snapshot',\n    null as 'Actual';\n\n-- ========================================\n-- CURRENT MONTH PROCESSING\n-- ========================================\nq_UpOpp = load \"UpdatesMetric\";\n\n-- Apply security filters\nq_UpOpp = filter q_UpOpp by \n    'OWNER_SYSTEM_ID' == \"$User.Id\" ||  \n    'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || \n    'MetricsOpe.ID' matches \"!{User.Id}\" || 'MetricsOpe.ID2' matches \"!{User.Id}\" || 'MetricsOpe.ID3' matches \"!{User.Id}\" || \n    'MetricsOpe.ID4' matches \"!{User.Id}\" || 'MetricsOpe.ID5' matches \"!{User.Id}\" || 'MetricsOpe.ID6' matches \"!{User.Id}\" || \n    'MetricsOpe.ID7' matches \"!{User.Id}\" || 'MetricsOpe.ID8' matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n\nq_UpOpp = filter q_UpOpp by  \n    'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\n\n-- ========================================\n-- CURRENT MONTH LOGIC\n-- ========================================\n-- Process individual records first\nq_UpOpp_Processed = foreach q_UpOpp generate \n    coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',\n    coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',\n    'OPPORTUNITYID',\n    'CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day',\n    'LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day',\n    \n    -- Business logic flags\n    case when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"] \n         then 1 else 0 end as 'Is_Current_Quarter',\n    \n    case when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"] && \n              date('LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day') in [\"current month\"..\"current month\"]\n         then 1 else 0 end as 'Is_Updated_Current_Month';\n\nq_UpOpp_Dedup = group q_UpOpp_Processed by ('OPPORTUNITYID', 'Manager_wwid', 'Manager_nm');\n\nq_UpOpp_Dedup = foreach q_UpOpp_Dedup generate \n    'OPPORTUNITYID',\n    'Manager_wwid',\n    'Manager_nm',\n    max('Is_Current_Quarter') as 'Is_Current_Quarter',\n    max('Is_Updated_Current_Month') as 'Is_Updated_Current_Month';\n\n-- Final aggregation\nq_UpOpp_Final = group q_UpOpp_Dedup by ('Manager_nm', 'Manager_wwid');\n\nq_UpOpp_Final = foreach q_UpOpp_Final generate \n    'Manager_nm', \n    'Manager_wwid', \n    \"% total of current opptys updated current month\" as 'Metric Name',\n    date_to_string(now(), \"yyyy-MM\") as 'Month',\n    case when sum('Is_Current_Quarter') > 0 \n         then sum('Is_Updated_Current_Month') / sum('Is_Current_Quarter')\n         else null \n    end as 'Actual',\n    null as 'Snapshot'\n    \n    ,sum('Is_Updated_Current_Month') as 'Is_Updated_Current_Month'\n    ,sum('Is_Current_Quarter') as 'Is_Current_Quarter';\n\n-- ========================================\n-- FINAL UNION AND FORMATTING\n-- ========================================\nq_UpOpp_Month_SnapshotM = union q_UpOpp_Month_SnapshotM, q_UpOpp_Final;\n\nq_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Month', 'Manager_nm');\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate \n    'Manager_nm',\n    'Month',\n    case when date_to_string(now(), \"yyyy-MM\") == 'Month' \n         then max('Actual') \n         when max('Snapshot') is null \n         then null \n         else max('Snapshot') \n    end as 'Metric_n',\n    case when date_to_string(now(), \"yyyy-MM\") == 'Month' \n        && max('Actual') is null \n        then \"No Opportunities Updates\"\n        when date_to_string(now(), \"yyyy-MM\") == 'Month' \n         then number_to_string(max('Actual'), \"#%\") \n         when substr('Month', 1, 4) == \"2024\" && string_to_number(substr('Month', 6, 7)) < 10\n         then \"No Historical Data\"  \n         when max('Snapshot') is null \n         then \"No Open Opps\"\n         when max('Snapshot') == 0 || max('Actual') == 0 \n         then \"0%\" \n         else number_to_string(max('Snapshot'), \"#%\") \n    end as 'Metric';\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate \n    'Manager_nm',\n    'Month',\n    case when 'Metric' is null then \"NA\" \n         when 'Metric' == \"%\" then \"0%\" \n         else 'Metric' \n    end as 'Metric',\n    case when (sum('Metric_n') < 0.399) then \"#FFFFFF\"\n         when (sum('Metric_n') > 0.399 && sum('Metric_n') < 0.799) then \"#000000\"\n         when (sum('Metric_n') >= 0.799) then \"#000000\" \n    end as 'text_color',\n    case when (sum('Metric_n') < 0.399) then \"#c81326\"\n         when (sum('Metric_n') > 0.399 && sum('Metric_n') < 0.799) then \"#ffe500\"\n         when (sum('Metric_n') >= 0.799) then \"#9fd541\" \n    end as 'color';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager_nm","Month","Metric"],"customBulkActions":[],"fixedColumnWidth":87,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_9":{"broadcastFacet":true,"groups":[],"label":"lens_9","numbers":[],"query":"-- ========================================\n-- OPPORTUNITY UPDATE METRICS \n-- ========================================\n-- Purpose: Calculate percentage of opportunities updated by month\n-- Functionality: Combines historical snapshot data with current actual data\n-- Output: Monthly metrics table with percentages\n-- ========================================\n\nq_managers = load \"ManagerUsers\";  \n\n\nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\n\n-- ========================================\n-- MONTH STRUCTURE GENERATION\n-- ========================================\n-- Create base records for each month of the year with year logic\n-- This ensures all months appear in final result, even without data\n\n-- January: If we're in January OR it's a valid year, use current year; otherwise use previous year\nq_managers_snapshot1 = foreach q_managers generate 'USER_NM' as 'Manager_nm', 'USER_ID' as 'Manager_wwid', 0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" || (string_to_number((date_to_string(now(), \"yyyy\")))) > 1 then date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year', \"01\" as 'Snapshot_Date_Month';\n\n-- February: If we're in January, use previous year; otherwise current year\nq_managers_snapshot2 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid', 0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year', \"02\" as 'Snapshot_Date_Month';\n\n-- March: If we're in January or February, use previous year; otherwise current year\nq_managers_snapshot3 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid', 0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year', \"03\" as 'Snapshot_Date_Month';\n\n-- April: If we're in January, February or March, use previous year; otherwise current year\nq_managers_snapshot4 = foreach q_managers generate 'USER_NM' as 'Manager_nm', 'USER_ID' as 'Manager_wwid', 0 as 'manager_cnt', case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year', \"04\" as 'Snapshot_Date_Month';\n\n-- May: Continue year logic pattern\nq_managers_snapshot5 = foreach q_managers generate \n    'USER_NM' as 'Manager_nm',\n    'USER_ID' as 'Manager_wwid',\n    0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\n    \"05\" as 'Snapshot_Date_Month';\n\n-- June: Continue pattern\nq_managers_snapshot6 = foreach q_managers generate \n    'USER_NM' as 'Manager_nm',\n    'USER_ID' as 'Manager_wwid',\n    0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\n    \"06\" as 'Snapshot_Date_Month';\n\n-- July: Continue pattern\nq_managers_snapshot7 = foreach q_managers generate \n    'USER_NM' as 'Manager_nm',\n    'USER_ID' as 'Manager_wwid',\n    0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\n    \"07\" as 'Snapshot_Date_Month';\n\n-- August: Continue pattern\nq_managers_snapshot8 = foreach q_managers generate \n    'USER_NM' as 'Manager_nm',\n    'USER_ID' as 'Manager_wwid',\n    0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\n    \"08\" as 'Snapshot_Date_Month';\n\n-- September: Continue pattern\nq_managers_snapshot9= foreach q_managers generate \n    'USER_NM' as 'Manager_nm',\n    'USER_ID' as 'Manager_wwid',\n    0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\n    \"09\" as 'Snapshot_Date_Month';\n\n-- October: Continue pattern\nq_managers_snapshot10= foreach q_managers generate \n    'USER_NM' as 'Manager_nm',\n    'USER_ID' as 'Manager_wwid',\n    0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\n    \"10\" as 'Snapshot_Date_Month';\n\n-- November: Continue pattern\nq_managers_snapshot11 = foreach q_managers generate \n    'USER_NM' as 'Manager_nm',\n    'USER_ID' as 'Manager_wwid',\n    0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\n    \"11\" as 'Snapshot_Date_Month';\n\n-- December: Continue pattern\nq_managers_snapshot12= foreach q_managers generate \n    'USER_NM' as 'Manager_nm',\n    'USER_ID' as 'Manager_wwid',\n    0 as 'manager_cnt',\n    case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" || date_to_string(now(), \"MM\") == \"11\" \n         then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") \n         else date_to_string(now(), \"yyyy\") \n    end as 'Snapshot_Date_Year',\n    \"12\" as 'Snapshot_Date_Month';\n\n-- Combine all months into single structure\nmonths = union q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4,q_managers_snapshot5,q_managers_snapshot6,q_managers_snapshot7,q_managers_snapshot8,q_managers_snapshot9,q_managers_snapshot10,q_managers_snapshot11,q_managers_snapshot12;\n\n-- Format final month structure\nmonths = foreach months generate \n    'Manager_nm',\n    'Manager_wwid', \n    'manager_cnt',\n    'Snapshot_Date_Year',\n    'Snapshot_Date_Month';\n\n-- ========================================\n-- SNAPSHOT DATA PROCESSING (HISTORICAL MONTHS)\n-- ========================================\n-- Snapshots contain historical opportunity data\n-- Only used for past months, NOT for current month\n\nq_UpOpp_Month_Snapshot = load \"SnapshotDS13_IDs_Updates_Manager_Metrics_Snapshot\";\n\n-- Exclude specific problematic date\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by Snapshot_Date != \"2025-02-02\";\n\n-- Current month data is obtained from \"actual data\" section\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by \n    'Snapshot_Date_Year' != date_to_string(now(), \"yyyy\") || 'Snapshot_Date_Month' != date_to_string(now(), \"MM\");\n\n-- Extract and transform necessary fields from snapshot\nq_UpOpp_Month_Snapshot = foreach q_UpOpp_Month_Snapshot generate  \n    coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',\n    coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid',\n    case when Snapshot_Date == \"2025-03-02\" then \"02\" else 'Snapshot_Date_Month' end as 'Snapshot_Date_Month', \n    case when Snapshot_Date == \"2025-03-02\" then \"28\" else 'Snapshot_Date_Day' end as 'Snapshot_Date_Day', \n    'OWNER_SYSTEM_ID','OWNER_HIERARCHY_TXT',\n    'MetricsOpe.ID','MetricsOpe.ID2','MetricsOpe.ID3','MetricsOpe.ID4','MetricsOpe.ID5','MetricsOpe.ID6','MetricsOpe.ID7','MetricsOpe.ID8','MetricsOpe.ID9',\n    'Snapshot_Date_Year','CLOSE_DT_Quarter','CLOSE_DT_Year','Snapshot_Date_Quarter',\n    'LASTMODIFIED_DT_Quarter','LASTMODIFIED_DT_Year','LASTMODIFIED_DT_Month','CLOSE_DT_Month',\n    'OPPORTUNITYID', 'Snapshot_Date';\n\n-- Security - Only opportunities accessible by current user\n-- Checks multiple role and hierarchy fields to ensure permissions\nq_UpOpp_Month_Snapshot= filter q_UpOpp_Month_Snapshot by \n    'OWNER_SYSTEM_ID' == \"$User.Id\" ||  \n    'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || \n    'MetricsOpe.ID' matches \"!{User.Id}\" || 'MetricsOpe.ID2' matches \"!{User.Id}\" || 'MetricsOpe.ID3' matches \"!{User.Id}\" || \n    'MetricsOpe.ID4' matches \"!{User.Id}\" || 'MetricsOpe.ID5' matches \"!{User.Id}\" || 'MetricsOpe.ID6' matches \"!{User.Id}\" || \n    'MetricsOpe.ID7' matches \"!{User.Id}\" || 'MetricsOpe.ID8' matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n\n-- Specific manager - Only opportunities from selected manager\nq_UpOpp_Month_Snapshot= filter q_UpOpp_Month_Snapshot by   \n    'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\n\n-- Date range - Only data within last year to current year\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by \n    date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 year ago\"..\"current year\"];\n\n-- Only opportunities closing in snapshot quarter\n-- This is the main business rule: we only care about opportunities that close in the same quarter as the snapshot\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by 'CLOSE_DT_Quarter' == 'Snapshot_Date_Quarter' && 'CLOSE_DT_Year' == 'Snapshot_Date_Year';\n\n-- The snapshot dataset contains multiple records per opportunity, causing inflated counts\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_Snapshot generate \n    \"\" as 'Manager_nm',\n    substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid',\n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month',\n    'CLOSE_DT_Quarter',\n    'CLOSE_DT_Year',\n    'Snapshot_Date_Quarter',\n    'LASTMODIFIED_DT_Month',\n    'LASTMODIFIED_DT_Year',\n    'OPPORTUNITYID';\n\nq_UpOpp_Month_SnapshotM_Dedup = group q_UpOpp_Month_SnapshotM by (\n    'OPPORTUNITYID',        \n    'Manager_wwid',         \n    'Snapshot_Date_Year',   \n    'Snapshot_Date_Month'   \n);\n\nq_UpOpp_Month_SnapshotM_Dedup = foreach q_UpOpp_Month_SnapshotM_Dedup generate \n    'OPPORTUNITYID',\n    'Manager_wwid',\n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month',\n    max('CLOSE_DT_Quarter') as 'CLOSE_DT_Quarter',\n    max('CLOSE_DT_Year') as 'CLOSE_DT_Year',\n    max('Snapshot_Date_Quarter') as 'Snapshot_Date_Quarter',\n    max('LASTMODIFIED_DT_Month') as 'LASTMODIFIED_DT_Month',\n    max('LASTMODIFIED_DT_Year') as 'LASTMODIFIED_DT_Year',\n    max('Manager_nm') as 'Manager_nm';\n\n-- Apply update logic to deduplicated and filtered data\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM_Dedup generate \n    'Manager_nm',\n    'Manager_wwid',\n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month',\n    -- ALL opportunities reaching here already qualify as Total_Opp (1 point each)\n    -- Since we already filtered by quarter, every opportunity counts\n    1 as 'Total_Opp',\n    -- Only opportunities updated in the snapshot month get 1 point, others get 0\n    case when 'Snapshot_Date_Month' == 'LASTMODIFIED_DT_Month' && 'Snapshot_Date_Year' == 'LASTMODIFIED_DT_Year' \n         then 1 else 0 end as 'Update_Opp';\n\n-- ========================================\n-- AGGREGATION AND PERCENTAGE CALCULATION\n-- ========================================\n-- Group by manager and time period for aggregation\nq_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Manager_wwid', 'Manager_nm','Snapshot_Date_Year','Snapshot_Date_Month');\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate \n    'Manager_wwid',\n    'Manager_nm',\n    sum(Total_Opp) as 'Total_Opp',                    \n    coalesce(sum(Update_Opp),0) as 'Update_Opp',      \n    coalesce(sum(Update_Opp) / sum(Total_Opp),0) as '% total of current opptys updated last month',  \n    'Snapshot_Date_Year', \n    'Snapshot_Date_Month'; \n\nq_UpOppM_managers_Snapshot = union q_UpOpp_Month_SnapshotM,months;\n\nq_UpOppM_managers_Snapshot = group q_UpOppM_managers_Snapshot by ('Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month');\n\nq_UpOppM_managers_Snapshot = foreach q_UpOppM_managers_Snapshot generate \n    max('Manager_nm') as 'Manager_nm',\n    \"% total of current opptys updated last month\" as 'Metric Name',\n    null as 'Actual',                               \n    case when max('% total of current opptys updated last month') is null \n         then null \n         else max('% total of current opptys updated last month') \n    end as 'Snapshot',                            \n    'Snapshot_Date_Year' + \"-\"+ 'Snapshot_Date_Month' as 'Month';  \n\n-- ========================================\n-- CURRENT MONTH DATA PROCESSING\n-- ========================================\nq_UpOpp = load \"UpdatesMetric\";\n\nq_UpOpp= filter q_UpOpp by \n    'OWNER_SYSTEM_ID' == \"$User.Id\" ||  \n    'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || \n    'MetricsOpe.ID' matches \"!{User.Id}\" || 'MetricsOpe.ID2' matches \"!{User.Id}\" || 'MetricsOpe.ID3' matches \"!{User.Id}\" || \n    'MetricsOpe.ID4' matches \"!{User.Id}\" || 'MetricsOpe.ID5' matches \"!{User.Id}\" || 'MetricsOpe.ID6' matches \"!{User.Id}\" || \n    'MetricsOpe.ID7' matches \"!{User.Id}\" || 'MetricsOpe.ID8' matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n\nq_UpOpp= filter q_UpOpp by  \n    'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\n\nq_UpOpp_Processed = foreach q_UpOpp generate \n    \"\" as 'Manager_nm',\n    substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid',\n    'OPPORTUNITYID',\n    'CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day',\n    'LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day',\n    case when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"] \n         then 1 else 0 end as 'Is_Current_Quarter',\n    case when date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"] && \n              date('LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day') in [\"current month\"..\"current month\"]\n         then 1 else 0 end as 'Is_Updated_Current_Month';\n         \nq_UpOpp_Dedup = group q_UpOpp_Processed by ('OPPORTUNITYID', 'Manager_wwid');\n\nq_UpOpp_Dedup = foreach q_UpOpp_Dedup generate \n    'OPPORTUNITYID',\n    'Manager_wwid',\n    max('Manager_nm') as 'Manager_nm',\n    max('Is_Current_Quarter') as 'Is_Current_Quarter',\n    max('Is_Updated_Current_Month') as 'Is_Updated_Current_Month';\n\n-- Group by manager and calculate metrics properly\nq_UpOpp_Aggregated = group q_UpOpp_Dedup by ('Manager_wwid', 'Manager_nm');\n\nq_UpOpp_Aggregated = foreach q_UpOpp_Aggregated generate \n    'Manager_wwid', \n    'Manager_nm',\n    \n    -- Count total opportunities in current quarter\n    sum('Is_Current_Quarter') as 'Total_Opp_Count',\n    \n    -- Count updated opportunities  \n    sum('Is_Updated_Current_Month') as 'Update_Opp_Count',\n    \n    -- Calculate percentage with proper null handling\n    case when sum('Is_Current_Quarter') > 0 \n         then sum('Is_Updated_Current_Month') / sum('Is_Current_Quarter')\n         else null \n    end as '% total of current opptys updated last month'\n    ,sum('Is_Updated_Current_Month') as 'Is_Updated_Current_Month'\n    ,sum('Is_Current_Quarter') as 'Is_Current_Quarter';\n\n-- Only union if we have actual data\nq_UpOppM_managers = union q_UpOpp_Aggregated, months;\n\n-- Group by manager properly\nq_UpOppM_managers = group q_UpOppM_managers by ('Manager_wwid');\n\nq_UpOppM_managers = foreach q_UpOppM_managers generate \n    max('Manager_nm') as 'Manager_nm',\n    \"% total of current opptys updated last month\" as 'Metric Name',\n    date_to_string(now(), \"yyyy-MM\") as 'Month',\n    case when max('% total of current opptys updated last month') is null \n         then null\n         when max('Total_Opp_Count') == 0\n         then null\n         else max('% total of current opptys updated last month') \n    end as 'Actual'\n    ,max('Is_Updated_Current_Month') as 'Is_Updated_Current_Month'\n    ,max('Is_Current_Quarter') as 'Is_Current_Quarter',\n    \n    null as 'Snapshot';                     \n\n-- ========================================\n-- FINAL RESULT COMBINATION AND FORMATTING\n-- ========================================\n\nq_UpOppM_managers_Snapshot = union q_UpOppM_managers,q_UpOppM_managers_Snapshot;\n\nq_UpOppM_managers_Snapshot = filter q_UpOppM_managers_Snapshot by Manager_nm != \"\";\n\nq_UpOppM_managers_Snapshot = group q_UpOppM_managers_Snapshot by (Manager_nm, 'Month');\n\nq_UpOppM_managers_Snapshot = foreach q_UpOppM_managers_Snapshot generate  \n    Manager_nm,\n    'Month',\n    case when date_to_string(now(), \"yyyy-MM\") == 'Month' \n         then max('Actual')          \n         when max('Snapshot') is null \n         then null \n         else max('Snapshot')      \n    end as 'Metric_n',\n    case when date_to_string(now(), \"yyyy-MM\") == 'Month' \n        && max('Actual') is null \n        then \"No Open Opps\"\n        when date_to_string(now(), \"yyyy-MM\") == 'Month' \n         then number_to_string(max('Actual'), \"#%\") \n         when substr('Month', 1, 4) == \"2024\" && string_to_number(substr('Month', 6, 7)) < 10\n         then \"No Historical Data\"  \n         when max('Snapshot') is null \n         then \"No Open Opps\"\n         when max('Snapshot') == 0 || max('Actual') == 0 \n         then \"0%\" \n         else number_to_string(max('Snapshot'), \"#%\") \n    end as 'Metric';\n\nq_UpOppM_managers_Snapshot = foreach q_UpOppM_managers_Snapshot generate  \n    Manager_nm as 'Manager Name',\n    'Month',\n    case when 'Metric' is null then \"NA\"       \n         when 'Metric' == \"%\" then \"0%\"            \n         else 'Metric' \n    end as 'Metric',\n    case when (sum('Metric_n') < 0.399) then \"#FFFFFF\"        \n         when (sum('Metric_n') > 0.399 && sum('Metric_n') < 0.799) then \"#000000\"  \n         when (sum('Metric_n') >= 0.799) then \"#000000\"        \n    end as 'text_color',\n    case when (sum('Metric_n') < 0.399) then \"#c81326\"          \n         when (sum('Metric_n') > 0.399 && sum('Metric_n') < 0.799) then \"#ffe500\"   \n         when (sum('Metric_n') >= 0.799) then \"#9fd541\"       \n    end as 'color';\n\nq_UpOppM_managers_Snapshot = order q_UpOppM_managers_Snapshot by 'Month' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager Name","Month","Metric"],"customBulkActions":[],"fixedColumnWidth":86,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"Sales_Rep_1":{"broadcastFacet":false,"groups":[],"label":"Sales Rep","numbers":[],"query":"q_manager = load \"ManagerUsers\";\nq_managers= filter q_manager by 'USER_ID' ==  \"!{User.Id}\" ||  'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_managers = group q_managers by ('USER_NM' , 'USER_ID' );\nq_managers = foreach q_managers generate 'USER_NM' as 'Sales Rep','USER_ID' as 'USER_ID',\"\\\"\"+'USER_ID'+\"\\\"\"  as 'User_Ids' ;\n\n\nq_managers_nm= filter q_manager by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_managers_nm = group q_managers_nm by (MANAGER_NM, 'MANAGER_ID' );\nq_managers_nm = foreach q_managers_nm generate MANAGER_NM as 'Sales Rep','MANAGER_ID' as 'USER_ID',\"\\\"\"+'MANAGER_ID'+\"\\\"\"  as 'User_Ids' ;\n\nq_final = union q_managers,q_managers_nm;\nq_final = group q_final by ('Sales Rep', 'USER_ID','User_Ids'  );\nq_final = foreach q_final generate  'Sales Rep',  'USER_ID', 'User_Ids' ;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":false,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_19":{"broadcastFacet":false,"groups":[],"label":"lens_19","numbers":[],"query":"q_account_actual = load \"ManagerMetric_AccountPlan\"; \n\nq_account_Snapshot = load \"Snapshot_Account\";\nq_account_actual= filter q_account_actual by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\" ;\n\nq_account_actual = filter q_account_actual by 'Core_Account_Primary_Coverage__c' matches \"Intel\" ; \nq_account_actual = filter q_account_actual by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\n\nq_account_actual = filter q_account_actual  by 'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_account_actual = filter q_account_actual  by 'AccountUser.OWNER_HIERARCHY_TXT' matches   coalesce({{cell(USER_NM_1.selection, 0, \"User_Ids\").asString()}}, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ));\n\nq_account_actual = foreach q_account_actual generate Name, q_account_actual.'Id' as 'Id', q_account_actual.'Core_Account_Level__c' as 'Account Level', case when  'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\" || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\" || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\")  then 1 else 0 end as 'Has Plan',q_account_actual.'AccountUser.OWNER_NM' as 'Owner',date_to_string(now(), \"yyyy\") + \"-\" + date_to_string(now(), \"MM\") as 'Month',date_to_string(now(), \"dd\") as 'Day','OwnerId'; \n\n\n\n\nq_account_Snapshot= filter q_account_Snapshot by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\" ;\n\nq_account_Snapshot = filter q_account_Snapshot by 'Core_Account_Primary_Coverage__c' matches \"Intel\" ;\nq_account_Snapshot = filter q_account_Snapshot by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\n\nq_account_Snapshot = filter q_account_Snapshot  by 'AccountUser.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_account_Snapshot = filter q_account_Snapshot  by 'AccountUser.OWNER_HIERARCHY_TXT' matches   coalesce({{cell(USER_NM_1.selection, 0, \"User_Ids\").asString()}}, coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ));\n\nq_account_Snapshot = foreach q_account_Snapshot generate  'Account_Fields.Name' as 'Name' , q_account_Snapshot.'Id' as 'Id', q_account_Snapshot.'Core_Account_Level__c' as 'Account Level', case when 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\" || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\" || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\") then 1 else 0 end as 'Has Plan',q_account_Snapshot.'AccountUser.OWNER_NM' as 'Owner',Snapshot_Date_Year + \"-\" + Snapshot_Date_Month as 'Month',Snapshot_Date_Day as 'Day','OwnerId'; \n\nq_final = union q_account_Snapshot,q_account_actual;\nq_final = filter q_final by  'Month' in {{coalesce(column(Account_Fields_Name_1.selection, [\"Month\"]),\"all\").asString()}};\nq_final = group q_final by (Name,'Id','Account Level','Owner','OwnerId');\nq_final = foreach q_final generate Name, 'Owner' as 'Account Owner Name','OwnerId','Account Level',case when max('Has Plan') == 1 then  \"#9fd541\" else \"#c81326\" end as 'color', \"■\" as 'Account Plan Available';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Name","Account Owner Name","Account Level","Account Plan Available"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"lens_16":{"broadcastFacet":true,"groups":[],"label":"lens_16","numbers":[],"query":"q = load \"ManagerMetricsDescription\";\n--q = group q by ('Metric', 'Definition',  'Definition1','Objective', 'Color', 'Ranges', Color_System);\nq = foreach q generate q.'Metric' as 'Metric',case when 'Definition1' is null && 'Definition2' is null then 'Definition' when  'Definition2' is null then 'Definition' + \" \" + 'Definition1' else  'Definition' + \" \" + 'Definition1' + \" \" + 'Definition2' end as 'Definition', q.'Objective' as 'Objective', q.'Color' as 'Color', q.'Ranges' as 'Ranges', 'Color_System','Order' as 'Order'; \nq = group q by ('Metric', 'Definition', 'Objective', 'Color', 'Ranges', 'Color_System', 'Order');\nq = foreach q generate  'Metric',  'Definition',  'Objective', 'Color',  'Ranges', 'Color_System', 'Order'; \nq = order q by ( 'Order' asc);\nq = limit q 2000;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Metric","Definition","Objective","Color","Ranges","Order"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_14":{"broadcastFacet":true,"groups":[],"label":"lens_14","numbers":[],"query":"q_managers = load \"ManagerUsers\";\nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_managers_snapshot1 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || (string_to_number((date_to_string(now(), \"yyyy\")))) > 1 then date_to_string(now(), \"yyyy\") end  as 'Snapshot_Date_Year',\"01\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot2 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"02\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot3 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"03\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot4 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"04\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot5 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"05\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot6 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"06\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot7 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"07\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot8 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"08\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot9= foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"09\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot10= foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"10\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot11 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"11\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot12= foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" || date_to_string(now(), \"MM\") == \"11\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"12\" as 'Snapshot_Date_Month' ;\n\nmonths = union q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4,q_managers_snapshot5,q_managers_snapshot6,q_managers_snapshot7,q_managers_snapshot8,q_managers_snapshot9,q_managers_snapshot10,q_managers_snapshot11,q_managers_snapshot12;\nmonths = foreach months generate  'Manager_nm','Manager_wwid', 'manager_cnt','Snapshot_Date_Year','Snapshot_Date_Month', null as 'ucd_attach', null as 'ucd_g' ;\n\n\n --Account Snapshot\nq_accountp_snapshot = load \"Snapshot_Account\"; \nq_accountp_snapshot= filter q_accountp_snapshot by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq_accountp_snapshot = filter q_accountp_snapshot by 'Core_Account_Primary_Coverage__c' matches  \"Intel\" ;\nq_accountp_snapshot = filter q_accountp_snapshot by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\n--q_accountp_snapshot = filter q_accountp_snapshot by  date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_accountp_snapshot= filter q_accountp_snapshot by  'AccountUser.OWNER_HIERARCHY_TXT'  matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );--\"!{User.Id}\" ;\nq_accountp1_snapshot = group q_accountp_snapshot by ('Id','AccountUser.OWNER_HIERARCHY_TXT','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accountp1_snapshot = foreach q_accountp1_snapshot generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Id', unique('Id') as 'UCD_G', 0 as 'UCD_Attach','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\n\n\nq_accountp2_snapshot = filter q_accountp_snapshot by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_accountp2_snapshot = group q_accountp2_snapshot by ('Id','AccountUser.OWNER_HIERARCHY_TXT','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accountp2_snapshot = foreach q_accountp2_snapshot generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Id',   0 as 'UCD_G', unique('Id') as 'UCD_Attach','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\n\n\n\nq_accplan_snapshot = union q_accountp1_snapshot, q_accountp2_snapshot;\nq_accplan_snapshot = group q_accplan_snapshot by ('Id', 'Manager_nm','Manager_wwid','UCD_Attach','UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accplan_snapshot = foreach q_accplan_snapshot generate 'Manager_nm','Manager_wwid','Id','UCD_Attach','UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\n\n\nq_accplan_snapshot = group q_accplan_snapshot by ('Manager_nm','Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accplan_snapshot = foreach q_accplan_snapshot generate 'Manager_nm','Manager_wwid',coalesce(sum('UCD_Attach'),0) as 'ucd_attach',coalesce(sum('UCD_G'),0) as 'ucd_g',sum('UCD_Attach')/sum('UCD_G') as 'result','Snapshot_Date_Year','Snapshot_Date_Month';\n\nq_accplan_snapshot = union q_accplan_snapshot,months;\n\nq_accplan_snapshot  = group q_accplan_snapshot  by ('Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month');\nq_accplan_snapshot  = foreach q_accplan_snapshot  generate  max('Manager_nm') as 'Manager_nm'\n,'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Month' as 'Month'\n,case when max('result') is null then null else  max('result') end as 'Snapshot'\n,null as 'Actual'\n, max('ucd_attach') as 'UCD_A'\n, max('ucd_g') as 'UCD_G';   \n\n\n--Account\nq_accountp = load \"ManagerMetric_AccountPlan\"; \nq_accountp= filter q_accountp by 'AccountUser.AccountUsersJoin.Id' ==  \"$User.Id\" ||  'AccountUser.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\"  || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq_accountp = filter q_accountp by 'Core_Account_Primary_Coverage__c' matches  \"Intel\" ;\nq_accountp = filter q_accountp by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\n\nq_accountp= filter q_accountp by  'AccountUser.OWNER_HIERARCHY_TXT'  matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );--\"!{User.Id}\" ;\nq_accountp1 = group q_accountp by ('Id','AccountUser.OWNER_HIERARCHY_TXT','Core_Account_Level__c');\nq_accountp1 = foreach q_accountp1 generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Id', unique('Id') as 'UCD_G', 0 as 'UCD_Attach','Core_Account_Level__c';\n\n\nq_accountp2 = filter q_accountp by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_accountp2 = group q_accountp2 by ('Id','AccountUser.OWNER_HIERARCHY_TXT','Core_Account_Level__c');\nq_accountp2 = foreach q_accountp2 generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Id',   0 as 'UCD_G', unique('Id') as 'UCD_Attach','Core_Account_Level__c';\n\nq_accplan = union q_accountp1, q_accountp2;\nq_accplan = group q_accplan by ('Id', 'Manager_nm','Manager_wwid','UCD_Attach','UCD_G','Core_Account_Level__c');\nq_accplan = foreach q_accplan generate 'Manager_nm','Manager_wwid','Id','UCD_Attach','UCD_G','Core_Account_Level__c';\n\n\nq_accplan = group q_accplan by ('Manager_nm','Manager_wwid');\nq_accplan = foreach q_accplan generate 'Manager_nm','Manager_wwid',sum('UCD_Attach') as 'ucd_attach',sum('UCD_G') as 'ucd_g',sum('UCD_Attach')/sum('UCD_G') as 'result';\n\n\nq_accplan = union q_accplan,months;\n\nq_accplan  = group q_accplan  by ('Manager_wwid');\nq_accplan  = foreach q_accplan  generate  max('Manager_nm') as 'Manager_nm'\n,date_to_string(now(), \"yyyy-MM\") as 'Month'\n,case when max('result') is null then null else  max('result') end as 'Actual'\n,null as 'Snapshot'\n, coalesce(max('ucd_attach'),0) as 'UCD_A'\n,coalesce(max('ucd_g'),0) as 'UCD_G';  \n\nq_accplan_snapshot = union q_accplan,q_accplan_snapshot;\n\nq_accplan_snapshot = filter q_accplan_snapshot by 'Manager_nm' != \"\" && 'Manager_nm' != \"!{User.Name}\" && 'Month' is not null ;\nq_accplan_snapshot = group q_accplan_snapshot by ( 'Manager_nm','Month');\nq_accplan_snapshot = foreach q_accplan_snapshot generate  'Manager_nm'\n,'Month'\n,case  when date_to_string(now(), \"yyyy-MM\") == 'Month'  then max('Actual') when max('Snapshot') is null then null   else max('Snapshot') end as 'Metric_n'\n,max('UCD_G') as 'UCD_G'\n,max('UCD_A')  as 'UCD_A'\n,case  when date_to_string(now(), \"yyyy-MM\") == 'Month' &&   max('Actual') is null then \"No Accounts\" when date_to_string(now(), \"yyyy-MM\") == 'Month'  then  number_to_string( max('Actual') ,\"#%\") when substr('Month', 1, 4) == \"2024\" then \"No Historical Data\"  when max('Snapshot') is null  then \"No Accounts\" when max('Snapshot') == 0 || max('Actual') == 0 then \"0%\" else   number_to_string(max('Snapshot'),\"##%\")  end as 'Metric';\n\n\n\t\n--q_accplan_snapshot = group q_accplan_snapshot by ( 'Manager_nm','Month');\nq_accplan_snapshot = foreach q_accplan_snapshot generate  'Manager_nm' as 'Manager Name'\n,'Month'\n,case when 'Metric' == \"%\" then \"0%\" when 'Metric' is null then \"NA\" else 'Metric' end as 'Metric'\n, case when  sum('Metric_n') < 0.499 then \"#c81326\"\n    when ( sum('Metric_n')> 0.499 && sum('Metric_n') < 0.999) then \"#ffe500\" \n    when (  sum('Metric_n')>= 0.999 ) then \"#9fd541\" end as 'color'\n, case when  sum('Metric_n') < 0.499 then \"#ffffff\"\n    when ( sum('Metric_n')> 0.499 && sum('Metric_n') < 0.999) then \"#000000\" \n    when (  sum('Metric_n')>= 0.999 ) then \"#000000\" end as 'text_color';\n\t\nq_accplan_snapshot = order q_accplan_snapshot by 'Month' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager Name","Month","Metric"],"customBulkActions":[],"fixedColumnWidth":86,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_15":{"broadcastFacet":true,"groups":[],"label":"lens_15","numbers":[],"query":"--Commited on the same quarter Snapshot\nManagerOpptiesCommit_Snapshot = load \"SnapshotDS22_CommitSnapshot_Metric_IDs_Snapshot\";\n \n\nmonth1 = foreach ManagerOpptiesCommit_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',case when string_to_number(date_to_string(now(), \"MM\")) >= 1 || string_to_number(date_to_string(now(), \"MM\")) <= 3 then date_to_string(now(), \"yyyy\") end  as 'Snapshot_Date_Year',\"Q1\" as 'Snapshot_Date_Quarter' ;\nmonth2 = foreach ManagerOpptiesCommit_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',case when string_to_number(date_to_string(now(), \"MM\")) >= 4 || string_to_number(date_to_string(now(), \"MM\")) <= 6 then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"Q2\" as 'Snapshot_Date_Quarter' ;\nmonth3 = foreach ManagerOpptiesCommit_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',case when string_to_number(date_to_string(now(), \"MM\")) >= 7 || string_to_number(date_to_string(now(), \"MM\")) <= 9 then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"Q3\" as 'Snapshot_Date_Quarter' ;\nmonth4 = foreach ManagerOpptiesCommit_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',case when string_to_number(date_to_string(now(), \"MM\")) >= 10 || string_to_number(date_to_string(now(), \"MM\")) <= 12 then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"Q4\" as 'Snapshot_Date_Quarter' ;\nquarters = union month1,month2,month3,month4;\nquarters = group quarters by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter' );\nquarters =  foreach quarters generate 'Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter' ;\n\n\n--ManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");ManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'PERIOD_TXT' else \"\" end as 'PERIOD_TXT',case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'FORECAST_AMT' else null end as 'FORECAST_AMT',case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'OPPORTUNITIES_AMT' else null end as 'OPPORTUNITIES_AMT','USER_ID';\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('PERIOD_TXT','USER_ID');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate 'PERIOD_TXT', sum('FORECAST_AMT') as 'FORECAST_AMT',sum('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(sum('OPPORTUNITIES_AMT')/sum('FORECAST_AMT')) as 'commitMetric','USER_ID',substr('PERIOD_TXT',8,9) as 'Snapshot_Date_Year',case when 'PERIOD_TXT' matches \"Q 1\"   then \"Q1\" when 'PERIOD_TXT' matches \"Q 2\" then \"Q2\" when 'PERIOD_TXT' matches \"Q 3\"  then \"Q3\" when 'PERIOD_TXT' matches \"Q 4\" then \"Q4\" end as  'Snapshot_Date_Quarter' ;\n\n--ManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'USER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") ;\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Snapshot_Date_Year','Snapshot_Date_Quarter');\n\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n, 'Snapshot_Date_Year'\n, 'Snapshot_Date_Quarter'\n,max('commitMetric') as 'Metric'\n,max('FORECAST_AMT') as 'FORECAST_AMT'\n,max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT'; ; \n\nManagerOpptiesCommit_Snapshot = union ManagerOpptiesCommit_Snapshot,quarters;\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, case when 'Snapshot_Date_Year' is null then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") + 'Snapshot_Date_Quarter' else 'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Quarter' end as 'Quarter'\n,case when max('Metric') is null then null else max('Metric') end as 'Snapshot'\n, null as 'Actual'\n,max('FORECAST_AMT') as 'FORECAST_AMT'\n,max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT'; ;\n\n--Commited on the same quarter\nManagerOpptiesCommit = load \"ManagerCommitMetric\";\n--ManagerOpptiesCommit = filter ManagerOpptiesCommit by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"current quarter\"..\"current quarter\"];\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'PERIOD_TXT' else \"\" end as 'PERIOD_TXT',case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'FORECAST_AMT' else null end as 'FORECAST_AMT',case when 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'OPPORTUNITIES_AMT' else null end as 'OPPORTUNITIES_AMT','USER_ID';\nManagerOpptiesCommit = group ManagerOpptiesCommit by ('PERIOD_TXT','USER_ID');\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate 'PERIOD_TXT', sum('FORECAST_AMT') as 'FORECAST_AMT',sum('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(sum('OPPORTUNITIES_AMT')/sum('FORECAST_AMT')) as 'commitMetric','USER_ID';\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'USER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") ;\nManagerOpptiesCommit = group ManagerOpptiesCommit by all;\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n,case when date_to_string(now(), \"MM\") == \"01\" ||  date_to_string(now(), \"MM\") == \"02\" ||  date_to_string(now(), \"MM\") == \"03\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" when date_to_string(now(), \"MM\") == \"04\" ||  date_to_string(now(), \"MM\") == \"05\" ||  date_to_string(now(), \"MM\") == \"06\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" when date_to_string(now(), \"MM\") == \"07\" ||  date_to_string(now(), \"MM\") == \"08\" ||  date_to_string(now(), \"MM\") == \"09\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" when date_to_string(now(), \"MM\") == \"10\" ||  date_to_string(now(), \"MM\") == \"11\" ||  date_to_string(now(), \"MM\") == \"12\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q4\" end as 'Quarter'\n, max('commitMetric')  as 'Actual'\n,null as 'Snapshot'\n,max('FORECAST_AMT') as 'FORECAST_AMT'\n,max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT'; \n\nManagerOpptiesCommit = union ManagerOpptiesCommit,quarters;\n\nManagerOpptiesCommit = group ManagerOpptiesCommit by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter');\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate  'Manager_nm'\n, case when date_to_string(now(), \"MM\") == \"01\" ||  date_to_string(now(), \"MM\") == \"02\" ||  date_to_string(now(), \"MM\") == \"03\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" when date_to_string(now(), \"MM\") == \"04\" ||  date_to_string(now(), \"MM\") == \"05\" ||  date_to_string(now(), \"MM\") == \"06\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" when date_to_string(now(), \"MM\") == \"07\" ||  date_to_string(now(), \"MM\") == \"08\" ||  date_to_string(now(), \"MM\") == \"09\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" when date_to_string(now(), \"MM\") == \"10\" ||  date_to_string(now(), \"MM\") == \"11\" ||  date_to_string(now(), \"MM\") == \"12\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q4\" end as 'Quarter'\n,null as 'Snapshot'\n, case when max('Actual') is null then null else max('Actual') end as 'Actual'\n,max('FORECAST_AMT') as 'FORECAST_AMT'\n,max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT';\n\nManagerOpptiesCommit_Snapshot = union ManagerOpptiesCommit_Snapshot,ManagerOpptiesCommit;\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" \n    when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" \n    when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" \n    else  date_to_string(now(), \"yyyy\") + \"-\" + \"Q4\"  end as 'current_Quarter'\n,  max('Actual')  as 'Actual'\n, max('Snapshot')  as 'Snapshot'\n,max('FORECAST_AMT') as 'FORECAST_AMT'\n,max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT';\n\n\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','current_Quarter','Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n,'current_Quarter'\n,case   when 'current_Quarter' == 'Quarter'  then max('Actual')  when max('Snapshot') is null then null else max('Snapshot') end as 'Metric_n'\n,case  when  'current_Quarter' == 'Quarter'  &&  number_to_string( max('Actual') ,\"#%\") is null  then \"No Commit\" when 'current_Quarter' == 'Quarter' then  number_to_string( round(max('Actual'),2) ,\"#%\") when 'Quarter' == \"2024-Q3\"  then  \"No Historical Data\" when  'Quarter' == \"2024-Q4\"  then  \"No Historical Data\" when 'Quarter' == \"2025-Q1\" then  \"No Historical Data\"  when max('Snapshot') is null then \"No Commit\" else   number_to_string(round(max('Snapshot'),2),\"#%\")  end as 'Metric';\n\n--ManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','Quarter');\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'Quarter' is not null;\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n, case \n    when (sum('Metric_n') >= 1 && sum('Metric_n') <=  1.25)  || ( sum('Metric_n') <= 1 && sum('Metric_n') >=  0.75) then \"#9fd541\"  \n    when (sum('Metric_n') > 1.25 && sum('Metric_n') <=  1.5)  || ( sum('Metric_n') <= 0.75 && sum('Metric_n') >=  0.5)  then \"#ffe500\" \n    when   sum('Metric_n') > 1.5   ||  sum('Metric_n') < 0.5  then \"#c81326\" end as 'color'\n\n, case when (sum('Metric_n') >= 1 && sum('Metric_n') <=  1.25)  || ( sum('Metric_n') <= 1 && sum('Metric_n') >=  0.75) then \"#000000\"  \n    when (sum('Metric_n') > 1.25 && sum('Metric_n') <=  1.5)  || ( sum('Metric_n') <= 0.75 && sum('Metric_n') >=  0.5)  then \"#000000\" \n    when   sum('Metric_n') > 1.5   ||  sum('Metric_n') < 0.5  then \"#FFFFFF\" end as 'text_color'\n,case when 'Metric' == \"%\" then \"0%\" else 'Metric' end as 'Metric';\n\nManagerOpptiesCommit_Snapshot =  order ManagerOpptiesCommit_Snapshot by 'Quarter' desc;\nManagerOpptiesCommit_Snapshot = limit ManagerOpptiesCommit_Snapshot 4 ;\nManagerOpptiesCommit_Snapshot =  foreach ManagerOpptiesCommit_Snapshot generate 'Manager_nm' as 'Manager/Seller Name','Quarter','Metric','color','text_color';\nManagerOpptiesCommit_Snapshot =  order ManagerOpptiesCommit_Snapshot by 'Quarter' asc;\nManagerOpptiesCommit_Snapshot = limit ManagerOpptiesCommit_Snapshot 4 ;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager/Seller Name","Quarter","Metric"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_12":{"broadcastFacet":true,"groups":[],"label":"lens_12","numbers":[],"query":"--Confidence Snapshot\nq = load \"Forecast_Snapshot_with_Transforms_Secured\"; \nquarters = foreach q generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as  'Manager_nm' , number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\")  as 'last_year',date_to_string(now(), \"yyyy\") as 'current_year', date_to_string(now(), \"MM\") as 'current_month';\nquarters = foreach quarters generate  'Manager_nm','current_year','current_month','last_year' , case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  then 'last_year' else 'current_year'  end as 'q2_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\" || 'current_month' == \"06\" then 'last_year' else 'current_year'   end as 'q3_year', case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\" || 'current_month' == \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"  || 'current_month' == \"07\" ||  'current_month' == \"08\"  || 'current_month' == \"09\" then 'last_year' else 'current_year'   end  as 'q4_year' \n,case when  'current_month' ==  \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"   then \"04\"\nwhen   'current_month' ==  \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"   then \"01\"\nwhen  'current_month' ==  \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"   then \"02\"\nwhen  'current_month' ==  \"10\" || 'current_month' == \"11\" || 'current_month' == \"12\"   then \"03\"  end as 'last_Q'\n,case when    'current_month' ==  \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"   then \"03\"\nwhen   'current_month' ==  \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"   then \"04\"\nwhen  'current_month' ==  \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"   then \"01\"\nwhen  'current_month' ==  \"10\" || 'current_month' == \"11\" || 'current_month' == \"12\"   then \"02\"  end as 'last2_Q'\n,case when    'current_month' ==  \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"   then \"02\"\nwhen   'current_month' ==  \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"   then \"03\"\nwhen  'current_month' ==  \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"   then \"04\"\nwhen  'current_month' ==  \"10\" || 'current_month' == \"11\" || 'current_month' == \"12\"   then \"01\"  end as 'last3_Q'\n,case when    'current_month' ==  \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"   then \"01\"\nwhen   'current_month' ==  \"04\" || 'current_month' == \"05\" || 'current_month' == \"06\"   then \"02\"\nwhen  'current_month' ==  \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"   then \"03\"\nwhen  'current_month' ==  \"10\" || 'current_month' == \"11\" || 'current_month' == \"12\"   then \"04\"  end as 'Current_q';\n\nquarter1 = foreach quarters generate  'Manager_nm', 'current_year'  as 'Snapshot_Date_Year', 'Current_q' as 'Snapshot_Date_Quarter' ;\nquarter2 = foreach quarters generate  'Manager_nm', 'q2_year' as 'Snapshot_Date_Year', 'last_Q' as 'Snapshot_Date_Quarter' ;\nquarter3 = foreach quarters generate  'Manager_nm', 'q3_year' as 'Snapshot_Date_Year','last2_Q' as 'Snapshot_Date_Quarter' ;\nquarter4 = foreach quarters generate  'Manager_nm', 'q4_year' as 'Snapshot_Date_Year','last3_Q' as 'Snapshot_Date_Quarter' ; \nquarters = union quarter1,quarter2,quarter3,quarter4 ;\nquarters = group quarters by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter');\nquarters = foreach quarters generate  'Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter';\n\nq= filter q by 'OppAccountUser.Id' ==  \"$User.Id\" ||  'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\n\nq = filter q by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in  [\"3 quarters ago\"..\"current month\"] ;\n \nq = filter q by  'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nq = filter q by 'Opportunity.Core_Opportunity_Coverage_Nm__c' in [\"Intel-Led Opportunity\"];\nq = filter q by ('OpportunityProducts.Core_Status__c' not in [\"Cancelled\",\"Lost\"] || 'opp_status' is null) and ('StageName' not in [\"Cancelled\", \"Design Win\", \"Group\", \"Group Cancelled\", \"Group Closed\", \"Group Open\",\"Lost\", \"Production Cancelled\", \"Production Win\"] || 'StageName' is null) and (date('KPI_Decision_date_Year', 'KPI_Decision_date_Month', 'KPI_Decision_date_Day') in [\"3 quarters ago\"..\"current quarter\"] or (date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"3 quarters ago\"..\"current quarter\"] and 'Core_Product_Count__c' == 0));\nq_opps_unhealthy = filter q by 'opportunity_unhealthy' == 1;\nq = cogroup q by ('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Week', 'Snapshot_Date_Month', 'Snapshot_Date_Day','Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT') full, q_opps_unhealthy by ('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Week', 'Snapshot_Date_Month', 'Snapshot_Date_Day','Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT');\nq = foreach q generate coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') as 'Snapshot_Date_Year',  coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') + \"0\" + coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') as 'YearQuarterDate', coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') as 'Snapshot_Date_Quarter',coalesce(q.'Snapshot_Date_Week', q_opps_unhealthy.'Snapshot_Date_Week') as 'Snapshot_Date_Week',coalesce(q.'Snapshot_Date_Month', q_opps_unhealthy.'Snapshot_Date_Month') as 'Snapshot_Date_Month', coalesce(q.'Snapshot_Date_Day', q_opps_unhealthy.'Snapshot_Date_Day') as 'Snapshot_Date_Day',coalesce(q.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT', q_opps_unhealthy.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT') as 'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce(unique(q.'Id'),0) as 'count_opps', coalesce(unique(q_opps_unhealthy.'Id'),0) as 'opps_unhealthy';\n \nq = group q by ('Snapshot_Date_Year',   'Snapshot_Date_Quarter','Snapshot_Date_Week');\nq = foreach q generate 'Snapshot_Date_Year', 'Snapshot_Date_Quarter', 1-(sum(opps_unhealthy)/sum(count_opps))   as 'confidence';\n\nq = group q by ( 'Snapshot_Date_Year',   'Snapshot_Date_Quarter' );\nq = foreach q generate    'Snapshot_Date_Year',  'Snapshot_Date_Quarter',   avg(confidence)   as 'confidence' ;\n\nq = group q by ('Snapshot_Date_Year','Snapshot_Date_Quarter' );\n\nq = foreach q generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid','Snapshot_Date_Year',\"0\" + 'Snapshot_Date_Quarter' as 'Snapshot_Date_Quarter'  ,max('confidence') as 'confidence';\n \nconfidence_snapshot = union q,quarters;\nconfidence_snapshot = group confidence_snapshot by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter');\nconfidence_snapshot = foreach confidence_snapshot generate  'Manager_nm'\n,case when 'Snapshot_Date_Year' is null then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") + 'Snapshot_Date_Quarter' when  'Snapshot_Date_Quarter' == \"01\" then 'Snapshot_Date_Year' + \"-Q1\"  when  'Snapshot_Date_Quarter' == \"02\" then 'Snapshot_Date_Year' + \"-Q2\"  when  'Snapshot_Date_Quarter' == \"03\" then 'Snapshot_Date_Year' + \"-Q3\" else 'Snapshot_Date_Year' + \"-Q4\" end as 'Quarter'\n,case when max('confidence') is null then null else max('confidence') end as 'Snapshot'\n,null as 'Actual';\n\nq_confidence = load \"ManagerConfidenceMetric\";\nq_confidence= filter q_confidence by 'User.Id' ==  \"$User.Id\" ||  'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'User.MetricsOpe.ID'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID2'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID3'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID4'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID5'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID6'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID7'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID8'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID9' matches \"!{User.Id}\";\n\nq_confidence = filter q_confidence by 'Core_Opportunity_Coverage_Nm__c' == \"Intel-Led Opportunity\";\nq_confidence= filter q_confidence by  'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) ;--\"!{User.Id}\" ;\nq_confidence = filter q_confidence by 'Confidence.op.Core_Status__c' not in  [\"Cancelled\",\"Lost\"];\nq_confidence = filter q_confidence by (date('Confidence.op.Core_KPI_Date__c_Year', 'Confidence.op.Core_KPI_Date__c_Month', 'Confidence.op.Core_KPI_Date__c_Day') in [\"3 quarters ago\"..\"current quarter\"] or  date('Confidence.CloseDate_Year', 'Confidence.CloseDate_Month', 'Confidence.CloseDate_Day')  in [\"3 quarters ago\"..\"current quarter\"] ) ;\n\nq_confidence = foreach q_confidence generate    coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid','Confidence.OpportunityProducts.Name' as 'Confidence.op.Name',  'Confidence.Name' as 'Name',  'Confidence.Id' ,  'Confidence.OpportunityProducts.Product2Id' as 'Confidence.OpportunityProducts.Product2Id', 'Confidence.unhealthy';\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm','Confidence.Id' , 'Confidence.unhealthy');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm','Confidence.Id'  , max('Confidence.unhealthy') as 'unhealthy_total' ;\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm');\nq_confidence = foreach q_confidence generate 'Manager_nm'\n,(1- (sum('unhealthy_total') / count()) )  as 'Actual'\n,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"02\" then  date_to_string(now(), \"yyyy\") + \"-Q1\" \n when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\"  || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-Q2\"  \n when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\"  || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-Q3\"  \n else date_to_string(now(), \"yyyy\") + \"Q4\" end as 'Quarter'\n ,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"02\" then  date_to_string(now(), \"yyyy\") + \"-Q1\" \n when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\"  || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-Q2\"  \n when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\"  || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-Q3\"  \n else date_to_string(now(), \"yyyy\") + \"Q4\" end as 'Current_Quarter'\n,null as 'Snapshot';\n\n\nconfidence_snapshot = union confidence_snapshot,q_confidence;\nconfidence_snapshot = filter confidence_snapshot by  'Quarter' != \" \";\nconfidence_snapshot = group confidence_snapshot by ('Manager_nm','Quarter' );\nconfidence_snapshot = foreach confidence_snapshot generate  'Manager_nm'\n, 'Quarter'\n,case   when max('Current_Quarter') == 'Quarter'  then max('Actual') when max('Snapshot') is null then null else max('Snapshot') end as 'Metric_n'\n,case when max('Current_Quarter') == 'Quarter'  then  number_to_string( max('Actual') ,\"#%\") when max('Snapshot') is null then \"No Open Opps\"  else   number_to_string(max('Snapshot'),\"#%\")  end as 'Metric';\n\n\n\nconfidence_snapshot = foreach confidence_snapshot generate  'Manager_nm'\n, 'Quarter'\n, case when 'Metric' is null then \"NA\" when 'Metric' == \"%\" then \"0%\" else 'Metric' end as 'Metric'\n, case when  sum('Metric_n') < 0.399 then \"#c81326\"\n    when ( sum('Metric_n')> 0.399 && sum('Metric_n') < 0.799) then \"#ffe500\" \n    when (   sum('Metric_n')>= 0.799) then \"#9fd541\" end as 'color'\n, case when  sum('Metric_n') < 0.399 then \"#ffffff\"\n    when ( sum('Metric_n')> 0.399 && sum('Metric_n') < 0.799) then \"#000000\" \n    when (   sum('Metric_n')>= 0.799) then \"#000000\" end as 'text_color';\nconfidence_snapshot = order confidence_snapshot by  'Quarter' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager_nm","Quarter","Metric"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_13":{"broadcastFacet":true,"groups":[],"label":"lens_13","numbers":[],"query":"--Account Snapshot \nq_accountp_Snapshot = load \"Snapshot_Account\";\nManagerMetric_AccountPlan = load \"ManagerMetric_AccountPlan\";\nmonths = foreach q_accountp_Snapshot generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as  'Manager_nm' , number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\")  as 'last_year',date_to_string(now(), \"yyyy\") as 'current_year', date_to_string(now(), \"MM\") as 'current_month';\nmonths = group months by ('Manager_nm','last_year', 'current_year','current_month');\nmonths = foreach months generate  'Manager_nm','current_year','current_month','last_year' , case when 'current_month' == \"01\"  then 'last_year' else 'current_year'  end as 'm2_year',case when 'current_month' == \"01\" || 'current_month' == \"02\" then'last_year' else 'current_year'  end  as 'm3_year',case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" then 'last_year' else 'current_year'   end as 'm4_year', case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\" || 'current_month' == \"04\" then 'last_year' else 'current_year'   end  as 'm5_year' ,case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  || 'current_month' == \"04\" || 'current_month' == \"05\" then 'last_year' else 'current_year'  end as 'm6_year', case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  || 'current_month' == \"04\"  || 'current_month' == \"05\" || 'current_month' == \"06\" then 'last_year' else 'current_year'   end as 'm7_year' ,case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  || 'current_month' == \"04\" || 'current_month' == \"05\"  || 'current_month' == \"06\" || 'current_month' == \"07\" then 'last_year' else 'current_year'  end as 'm8_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"  || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\" || 'current_month' == \"07\" || 'current_month' == \"08\" then 'last_year' else 'current_year' end as 'm9_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\"  || 'current_month' == \"07\" || 'current_month' == \"08\"  || 'current_month' == \"09\" then 'last_year' else 'current_year'   end  as 'm10_year',case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\"  || 'current_month' == \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"  || 'current_month' == \"10\" then 'last_year' else 'current_year' end  as 'm11_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\"  || 'current_month' == \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"  || 'current_month' == \"10\"  || 'current_month' == \"11\" then 'last_year' else 'current_year' end as 'm12_year'\n,case when  'current_month' ==  \"01\" then \"12\"\nwhen  'current_month' ==  \"02\" then \"01\"\nwhen  'current_month' ==  \"03\" then \"02\"\nwhen  'current_month' ==  \"04\" then \"03\"\nwhen  'current_month' ==  \"05\" then \"04\" \nwhen  'curr