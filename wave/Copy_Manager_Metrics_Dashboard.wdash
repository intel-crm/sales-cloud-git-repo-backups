,\"Target\":\"100%\",\"Measured by\":\"Team\"}","{\"Metric\":\"Confidence\",\"Definition\":null,\"Ranges\":\"0% 39.9%- Red 40% - 79.9% - Yellow 80%+ Green\",\"Target\":\"80%\",\"Measured by\":\"Team\"}","{\"Metric\":\"% Commited on the Current Quarter\",\"Definition\":null,\"Ranges\":\"+/- 25% Green +/- 25%-50% Yellow +/- 50%+ Red\",\"Target\":\"+/- 25%\",\"Measured by\":\"Team\"}"]},"Last_Month_Metric_1":{"broadcastFacet":true,"groups":[],"label":"Last Month Metric","numbers":[],"query":"\n--Opportunity Monthly Snapshot Updates\nq_UpOpp_Month_Snapshot= load \"SnapshotDS13_IDs_Updates_Manager_Metrics_Snapshot\"; \nUpdatesMetric = load \"UpdatesMetric\";\n\n\n-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\n------ This code was added to filter a unnecessary snapshot taken in February and also taking the snapshot from \"2025-03-02\" as the real snapshot for February ------\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by Snapshot_Date != \"2025-02-02\";\nq_UpOpp_Month_Snapshot = foreach q_UpOpp_Month_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  as 'Manager_wwid',case when Snapshot_Date == \"2025-03-02\" then \"02\" else 'Snapshot_Date_Month' end as 'Snapshot_Date_Month', case when Snapshot_Date == \"2025-03-02\" then \"28\" else 'Snapshot_Date_Day' end as 'Snapshot_Date_Day', 'OWNER_SYSTEM_ID','OWNER_HIERARCHY_TXT','MetricsOpe.ID','MetricsOpe.ID2','MetricsOpe.ID3','MetricsOpe.ID4','MetricsOpe.ID5','MetricsOpe.ID6','MetricsOpe.ID7','MetricsOpe.ID8','MetricsOpe.ID9','Snapshot_Date_Year','CLOSE_DT_Quarter','CLOSE_DT_Year','Snapshot_Date_Quarter','LASTMODIFIED_DT_Quarter','LASTMODIFIED_DT_Year','LASTMODIFIED_DT_Month','CLOSE_DT_Month','OPPORTUNITYID', 'Snapshot_Date';\n-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\n-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\n------ This code was added to filter a unnecessary snapshot taken in April and also taking the snapshot from \"2025-04-30\" as the real snapshot for February ------\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by Snapshot_Date != \"2025-04-02\";\nq_UpOpp_Month_Snapshot = foreach q_UpOpp_Month_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  as 'Manager_wwid',case when Snapshot_Date == \"2025-05-02\" then \"02\" else 'Snapshot_Date_Month' end as 'Snapshot_Date_Month', case when Snapshot_Date == \"2025-05-02\" then \"28\" else 'Snapshot_Date_Day' end as 'Snapshot_Date_Day', 'OWNER_SYSTEM_ID','OWNER_HIERARCHY_TXT','MetricsOpe.ID','MetricsOpe.ID2','MetricsOpe.ID3','MetricsOpe.ID4','MetricsOpe.ID5','MetricsOpe.ID6','MetricsOpe.ID7','MetricsOpe.ID8','MetricsOpe.ID9','Snapshot_Date_Year','CLOSE_DT_Quarter','CLOSE_DT_Year','Snapshot_Date_Quarter','LASTMODIFIED_DT_Quarter','LASTMODIFIED_DT_Year','LASTMODIFIED_DT_Month','CLOSE_DT_Month','OPPORTUNITYID', 'Snapshot_Date';\n-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\n------ This code was added to filter a unnecessary snapshot taken in MAY and also taking the snapshot from \"2025-05-30\" as the real snapshot for February ------\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by Snapshot_Date != \"2025-05-02\";\nq_UpOpp_Month_