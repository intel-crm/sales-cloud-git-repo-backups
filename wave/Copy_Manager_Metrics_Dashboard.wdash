"column":1,"name":"table_6","row":11,"rowspan":20,"widgetStyle":{"borderEdges":[]}},{"colspan":36,"column":1,"name":"table_7","row":39,"rowspan":25,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"first_snap_of_month__1":{"broadcastFacet":false,"groups":[],"label":"first_snap_of_month__1","numbers":[],"query":"q = load \"Forecast_Snapshot_with_Transforms_Secured\";\nq= filter q by date('Snapshot_Date_Year','Snapshot_Date_Month','Snapshot_Date_Day') in [\"3 quarters ago\"..\"current quarter\"];\nq = group q by ('Snapshot_Date_Year','Snapshot_Date_Quarter');\nq = foreach q generate   \"{{cell(Account_Fields_Name__2.selection, 0,\"Quarter\").asString()}}\" as 'Quarter_Selected','Snapshot_Date_Year',\"Q\"+'Snapshot_Date_Quarter' as 'Snapshot_Date_Quarter',max('Snapshot_Date_Year')+\"-\"+max('Snapshot_Date_Month')+\"-\"+max('Snapshot_Date_Day')  as 'Snapshot_Date',max('Snapshot_Date_Year') + max('Snapshot_Date_Quarter') as 'current_quarter',max('Snapshot_Date_Month') as 'Snapshot_Date_Month',max('Snapshot_Date_Day') as 'Snapshot_Date_Day'; \nq =  foreach q generate  substr('Quarter_Selected', 1, 4) as 'Year_Selected',substr('Quarter_Selected', 6, 2) as 'Quarter_Selected','Snapshot_Date_Year','Snapshot_Date_Quarter','Snapshot_Date','Snapshot_Date_Month','Snapshot_Date_Day','current_quarter';\n\nq_snapshot= filter q by date('Snapshot_Date_Year','Snapshot_Date_Month','Snapshot_Date_Day') in [\"3 quarters ago\"..\"1 quarters ago\"];\nq_snapshot= filter q_snapshot by 'Year_Selected' == 'Snapshot_Date_Year' && 'Quarter_Selected' == 'Snapshot_Date_Quarter' ;\nq_snapshot = group q_snapshot by 'Snapshot_Date';\nq_snapshot = foreach q_snapshot generate 'Snapshot_Date';\n\nq_actual = group q by ('Year_Selected', 'Quarter_Selected');\nq_actual= foreach q_actual generate 'Year_Selected', 'Quarter_Selected', max('current_quarter') as 'current_quarter';\nq_actual= foreach q_actual generate 'Year_Selected', 'Quarter_Selected', substr('current_quarter', 1, 4) as 'current_year',\"Q\"+ substr('current_quarter', 5,1) as 'current_quarter';\n\nq_actual= filter q_actual by 'Year_Selected' == 'current_year' && 'Quarter_Selected' == 'current_quarter' ;\nq_actual = foreach q_actual generate date_to_string(now(), \"yyyy-MM-dd\") as  'Snapshot_Date';\n\nq_final = union q_actual, q_snapshot;\nq_final = foreach q_final generate max('Snapshot_Date') as 'SnapshotDate';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"singlerequired","sortable":true,"strings":[],"type":"saql","useExternalFilters":false,"useGlobal":false,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"Commit_Snapshot_Deta_1":{"broadcastFacet":true,"groups":[],"label":"Commit Snapshot Details","numbers":[],"query":"q_managers = load \"ManagerUsers\"; \nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\n\nq_managers_snapshot1 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when string_to_number(date_to_string(now(), \"MM\")) >= 1 && string_to_number(date_to_string(now(), \"MM\")) <= 3 || string_to_number(date_to_string(now(), \"MM\")) >= 4 && string_to_number(date_to_string(now(), \"MM\")) <= 6 || string_to_number(date_to_string(now(), \"MM\")) >= 7 && string_to_number(date_to_string(now(), \"MM\")) <= 9 || string_to_number(date_to_string(now(), \"MM\")) >= 10 && string_to_number(date_to_string(now(), \"MM\")) <= 12 then date_to_string(now(), \"yyyy\") else number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") end as 'Snapshot_Date_Year',\"Q1\" as 'Snapshot_Date_Quarter' ;\n\nq_managers_snapshot2 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when string_to_number(date_to_string(now(), \"MM\")) >= 4 && string_to_number(date_to_string(now(), \"MM\")) <= 6 || string_to_number(date_to_string(now(), \"MM\")) >= 7 && string_to_number(date_to_string(now(), \"MM\")) <= 9 || string_to_number(date_to_string(now(), \"MM\")) >= 10 && string_to_number(date_to_string(now(), \"MM\")) <= 12 then date_to_string(now(), \"yyyy\") else number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") end  as 'Snapshot_Date_Year',\"Q2\" as 'Snapshot_Date_Quarter' ;\n\nq_managers_snapshot3 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when string_to_number(date_to_string(now(), \"MM\")) >= 7 && string_to_number(date_to_string(now(), \"MM\")) <= 9 || string_to_number(date_to_string(now(), \"MM\")) >= 10 && string_to_number(date_to_string(now(), \"MM\")) <= 12 then date_to_string(now(), \"yyyy\") else number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") end as 'Snapshot_Date_Year',\"Q3\" as 'Snapshot_Date_Quarter' ;\n\nq_managers_snapshot4 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when string_to_number(date_to_string(now(), \"MM\")) >= 10 && string_to_number(date_to_string(now(), \"MM\")) <= 12 then date_to_string(now(), \"yyyy\") else number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") end as 'Snapshot_Date_Year',\"Q4\" as 'Snapshot_Date_Quarter' ;\n\n--quarters = union q_managers_snapshot1, q_managers_snapshot2, q_managers_snapshot3, q_managers_snapshot4;\n--quarters = foreach quarters generate  'Manager_nm','Manager_wwid', 'manager_cnt','Snapshot_Date_Year','Snapshot_Date_Quarter' ;\n\n--Commited on the same quarter Snapshot\nManagerOpptiesCommit_Snapshot = load \"SnapshotDS22_CommitSnapshot_Metric_IDs_Snapshot\";\n--ManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\n--ManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"3 quarters ago\"..\"current quarter\"];\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate \"\" as 'Manager_nm',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid', 'PERIOD_TXT','FORECAST_AMT' as 'FORECAST_AMT','OPPORTUNITIES_AMT' as 'OPPORTUNITIES_AMT','USER_ID';\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_wwid', 'Manager_nm','PERIOD_TXT','USER_ID');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate 'Manager_wwid', 'Manager_nm','PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT'))  as 'commitMetric', 'USER_ID', substr('PERIOD_TXT',8,9) as 'Snapshot_Date_Year',case when 'PERIOD_TXT' matches \"Q 1\"   then \"Q1\" when 'PERIOD_TXT' matches \"Q 2\" then \"Q2\" when 'PERIOD_TXT' matches \"Q 3\"  then \"Q3\" when 'PERIOD_TXT' matches \"Q 4\" then \"Q4\" end as  'Snapshot_Date_Quarter' ;\n\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'USER_ID' == 'Manager_wwid';\n\nq_ManagerOppties_Snapshot = union ManagerOpptiesCommit_Snapshot, q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4;\nq_ManagerOppties_Snapshot = group q_ManagerOppties_Snapshot by ('Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Quarter');\nq_ManagerOppties_Snapshot = foreach q_ManagerOppties_Snapshot generate max('Manager_nm') as 'Manager_nm'\n,'Snapshot_Date_Year' + \"-\" +'Snapshot_Date_Quarter' as 'Quarter'\n, max('commitMetric')   as 'Snapshot'\n,null as 'Actual'\n,max('FORECAST_AMT') as 'FORECAST_AMT'\n,max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT';   \n\n\n\n--Commited on the same quarter\nManagerOpptiesCommit = load \"ManagerCommitMetric\";\n--ManagerOpptiesCommit = filter ManagerOpptiesCommit by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"current quarter\"..\"current quarter\"];\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate \"\" as 'Manager_nm',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid', 'PERIOD_TXT','FORECAST_AMT' as 'FORECAST_AMT','OPPORTUNITIES_AMT' as 'OPPORTUNITIES_AMT','USER_ID';\n\n\nManagerOpptiesCommit = group ManagerOpptiesCommit by ('Manager_wwid', 'Manager_nm','PERIOD_TXT','USER_ID');\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate 'Manager_wwid', 'Manager_nm','PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT')) as 'commitMetric','USER_ID';\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'USER_ID' == 'Manager_wwid';\nq_ManagerOppties = union ManagerOpptiesCommit,q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4;\nq_ManagerOppties = group q_ManagerOppties by ('Manager_wwid');\nq_ManagerOppties = foreach q_ManagerOppties generate max('Manager_nm') as 'Manager_nm'\n,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" when date_to_string(now(), \"MM\") == \"10\" || date_to_string(now(), \"MM\") == \"11\" || date_to_string(now(), \"MM\") == \"12\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q4\" end as 'Quarter'\n, max('commitMetric')   as 'Actual'\n,null as 'Snapshot'\n,max('FORECAST_AMT') as 'FORECAST_AMT'\n,max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT'; \n\nq_ManagerOppties_Snapshot = union q_ManagerOppties,q_ManagerOppties_Snapshot;\n\n\nq_ManagerOppties_Snapshot = filter q_ManagerOppties_Snapshot by 'Manager_nm' != \"\" && 'Manager_nm' != \"!{User.Name}\"  &&  'Quarter' is not null ;\nManagerOpptiesCommit_Snapshot = group q_ManagerOppties_Snapshot by ('Manager_nm','Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" \n    when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" \n    when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" \n    else  date_to_string(now(), \"yyyy\") + \"-\" + \"Q4\"  end as 'current_Quarter'\n, max('Actual')  as 'Actual'\n, max('Snapshot')   as 'Snapshot'\n,max('FORECAST_AMT') as 'FORECAST_AMT'\n,max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT'; \n\n\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','current_Quarter','Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n,'current_Quarter'\n,case   when 'current_Quarter' == 'Quarter'  then max('Actual')  when max('Snapshot') is null then null else max('Snapshot') end as 'Metric_n'\n,case  when 'current_Quarter' == 'Quarter'  &&  max('Actual') is null  then \"No Commit\"   when 'current_Quarter' == 'Quarter' then  number_to_string( round(max('Actual'),2) ,\"#%\") when 'Quarter' == \"2024-Q3\"  then  \"No Historical Data\" when  'Quarter' == \"2024-Q4\"  then  \"No Historical Data\" when 'Quarter' == \"2025-Q1\" then  \"No Historical Data\"  when max('Snapshot') is null then \"No Commit\" else   number_to_string(round(max('Snapshot'),2),\"#%\")  end as 'Metric';\n\n--q_ManagerOppties_Snapshot = group q_ManagerOppties_Snapshot by ( 'Manager_nm','Quarter');\nq_ManagerOppties_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm' as 'Manager Name'\n,'Quarter' \n, case \n    when (sum('Metric_n') >= 1 && sum('Metric_n') <=  1.25)  || ( sum('Metric_n') <= 1 && sum('Metric_n') >=  0.75) then \"#9fd541\"  \n    when (sum('Metric_n') > 1.25 && sum('Metric_n') <=  1.5)  || ( sum('Metric_n') <= 0.75 && sum('Metric_n') >=  0.5)  then \"#ffe500\" \n    when   sum('Metric_n') > 1.5   ||  sum('Metric_n') < 0.5  then \"#c81326\" end as 'color'\n\n, case when (sum('Metric_n') >= 1 && sum('Metric_n') <=  1.25)  || ( sum('Metric_n') <= 1 && sum('Metric_n') >=  0.75) then \"#000000\"  \n    when (sum('Metric_n') > 1.25 && sum('Metric_n') <=  1.5)  || ( sum('Metric_n') <= 0.75 && sum('Metric_n') >=  0.5)  then \"#000000\" \n    when   sum('Metric_n') > 1.5   ||  sum('Metric_n') < 0.5  then \"#FFFFFF\" end as 'text_color'\n,case when 'Metric' == \"%\" then \"0%\" else 'Metric' end as 'Metric';\nq_ManagerOppties_Snapshot = order q_ManagerOppties_Snapshot by 'Quarter' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager Name","Quarter","Metric"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"USER_NM_2_1":{"broadcastFacet":false,"groups":[],"label":"USER_NM_2","numbers":[],"query":"q_manager = load \"ManagerUsers\";\nq_managers= filter q_manager by 'USER_ID' ==  \"!{User.Id}\" ||  'OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  matches \"!{User.Id}\" || 'MetricsOpe.ID4'  matches \"!{User.Id}\" || 'MetricsOpe.ID5'  matches \"!{User.Id}\" || 'MetricsOpe.ID6'  matches \"!{User.Id}\" || 'MetricsOpe.ID7'  matches \"!{User.Id}\" || 'MetricsOpe.ID8'  matches \"!{User.Id}\" || 'MetricsOpe.ID9' matches \"!{User.Id}\";\nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_managers = group q_managers by ('USER_NM' , 'USER_ID' );\nq_managers = foreach q_managers generate 'USER_NM' as 'Sales Rep','USER_ID' as 'USER_ID',\"\\\"\"+'USER_ID'+\"\\\"\"  as 'User_Ids' ;\n\n\nq_managers_nm= filter q_manager by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_managers_nm = group q_managers_nm by (MANAGER_NM, 'MANAGER_ID' );\nq_managers_nm = foreach q_managers_nm generate MANAGER_NM as 'Sales Rep','MANAGER_ID' as 'USER_ID',\"\\\"\"+'MANAGER_ID'+\"\\\"\"  as 'User_Ids' ;\n\nq_final = union q_managers,q_managers_nm;\nq_final = group q_final by ('Sales Rep', 'USER_ID','User_Ids'  );\nq_final = foreach q_final generate  'Sales Rep',  'USER_ID', 'User_Ids' ;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","sortable":true,"strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder"