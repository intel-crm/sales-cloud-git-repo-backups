\"];\nq_confidence = filter q_confidence by (date('Confidence.op.Core_KPI_Date__c_Year', 'Confidence.op.Core_KPI_Date__c_Month', 'Confidence.op.Core_KPI_Date__c_Day') in [\"3 quarters ago\"..\"current quarter\"] or  date('Confidence.CloseDate_Year', 'Confidence.CloseDate_Month', 'Confidence.CloseDate_Day')  in [\"3 quarters ago\"..\"current quarter\"] );\n\nq_confidence = foreach q_confidence generate \"\" as 'Manager_nm',substr('DIM_MANAGE.OWNER_HIERARCHY_TXT', index_of('DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Confidence.OpportunityProducts.Name' as 'Confidence.op.Name',  'Confidence.Name' as 'Name',  'Confidence.Id' ,  'Confidence.OpportunityProducts.Product2Id' as 'Confidence.OpportunityProducts.Product2Id', 'Confidence.unhealthy';\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm','Confidence.Id' , 'Confidence.unhealthy');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm','Confidence.Id'  , max('Confidence.unhealthy') as 'unhealthy_total' ;\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm',(1- (sum('unhealthy_total') / count()) )  as 'Confidence score';\n\nq_confidence_managers = union q_confidence,q_managers;\nq_confidence_managers = group q_confidence_managers by ('Manager_wwid');\nq_confidence_managers = foreach q_confidence_managers generate max('Manager_nm') as 'Manager_nm'\n, \"Confidence Score\" as 'Metric Name'\n,case when max('Confidence score') is null then null else max('Confidence score') end as 'Actual'\n,null as 'Snapshot'; \n\nq = load \"Forecast_Snapshot_with_Transforms_Secured\";\n\nq= filter q by 'OppAccountUser.Id' ==  \"$User.Id\" ||  'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'MetricsOpe.ID'  matches \"!{User.Id}\" || 'MetricsOpe.ID2'  matches \"!{User.Id}\" || 'MetricsOpe.ID3'  