number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") end  as 'Snapshot_Date_Year',\"Q2\" as 'Snapshot_Date_Quarter' ;\nq_managers_snapshot3 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when string_to_number(date_to_string(now(), \"MM\")) >= 7 && string_to_number(date_to_string(now(), \"MM\")) <= 9 then date_to_string(now(), \"yyyy\") else number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") end as 'Snapshot_Date_Year',\"Q3\" as 'Snapshot_Date_Quarter' ;\nq_managers_snapshot4 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when string_to_number(date_to_string(now(), \"MM\")) >= 10 && string_to_number(date_to_string(now(), \"MM\")) <= 12 then date_to_string(now(), \"yyyy\") else number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") end as 'Snapshot_Date_Year',\"Q4\" as 'Snapshot_Date_Quarter' ;\n\n--Commited on the same quarter Snapshot\nManagerOpptiesCommit_Snapshot = load \"SnapshotDS22\";\n--ManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\n--ManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"3 quarters ago\"..\"current quarter\"];\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate \"\" as 'Manager_nm',substr('DIM_MANAGER.OWNER_HIERARCHY_TXT', index_of('DIM_MANAGER.OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid', 'PERIOD_TXT','FORECAST_AMT' as 'FORECAST_AMT','OPPORTUNITIES_AMT' as 'OPPORTUNITIES_AMT';\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_wwid', 'Manager_nm','PERIOD_TXT');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate 'Manager_wwid', 'Manager_nm','PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT'))  as 'commitMetric',substr('PERIOD_TXT',8,9) as 'Snapshot_Date_Year',case when 'PERIOD_TXT' matches \"Q 1\"   then \"Q1\" when 'PERIOD_TXT' matches \"Q 2\" then \"Q2\" when 'PERIOD_TXT' matches \"Q 3\"  then \"Q3\" when 'PERIOD_TXT' matches \"Q 4\" then \"Q4\" end as  'Snapshot_Date_Quarter' ;\n\nq_ManagerOppties_Snapshot = union ManagerOpptiesCommit_Snapshot, q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4;\nq_ManagerOppties_Snapshot = group q_ManagerOppties_Snapshot by ('Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Quarter');\nq_ManagerOppties_Snapshot = foreach q_ManagerOppties_Snapshot generate max('Manager_nm') as 'Manager_nm'\n,'Snapshot_Date_Year' + \"-\" +'Snapshot_Date_Quarter' as 'Quarter'\n,case when max('commitMetric') is null then null when max('commitMetric') > 1 then 1 when max('commitMetric') < -1 then -1  else max('commitMetric')  end as 'Snapshot'\n,null as 'Actual';  \n\n\n\n--Commited on the same quarter\nManagerOpptiesCommit = load \"ManagerCommitMetric\";\nManagerOpptiesCommit = filter ManagerOpptiesCommit by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"current quarter\"..\"current quarter\"];\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate \"\" as 'Manager_nm',substr('DIM_MANAGER.OWNER_HIERARCHY_TXT', index_of('DIM_MANAGER.OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid', 'PERIOD_TXT','FORECAST_AMT' as 'FORECAST_AMT','OPPORTUNITIES_AMT' as 'OPPORTUNITIES_AMT';\nManagerOpptiesCommit = group ManagerOpptiesCommit by ('Manager_wwid', 'Manager_nm','PERIOD_TXT');\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate 'Manager_wwid', 'Manager_nm','PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT')) as 'commitMetric';\n\nq_ManagerOppties = union ManagerOpptiesCommit,q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4;\nq_ManagerOppties = group q_ManagerOppties by ('Manager_wwid');\nq_ManagerOppties = foreach q_ManagerOppties generate max('Manager_nm') as 'Manager_nm'\n,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" when date_to_string(now(), \"MM\") == \"10\" || date_to_string(now(), \"MM\") == \"11\" || date_to_string(now(), \"MM\") == \"12\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q4\" end as 'Quarter'\n,case when max('commitMetric') is null then null when max('commitMetric') > 1 then 1 when max('commitMetric') < -1 then -1  else max('commitMetric')  end as 'Actual'\n,null as 'Snapshot';   \n\nq_ManagerOppties_Snapshot = union q_ManagerOppties,q_ManagerOppties_Snapshot;\n\n\nq_ManagerOppties_Snapshot = filter q_ManagerOppties_Snapshot by 'Manager_nm' != \"\" && 'Manager_nm' != \"!{User.Name}\"  &&  'Quarter' is not null ;\nManagerOpptiesCommit_Snapshot = group q_ManagerOppties_Snapshot by ('Manager_nm','Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" \n    when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" \n    when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" \n    else  date_to_string(now(), \"yyyy\") + \"-\" + \"Q4\"  end as 'current_Quarter'\n, max('Actual')  as 'Actual'\n, max('Snapshot')   as 'Snapshot';\n\n\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','current_Quarter','Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n,'current_Quarter'\n,case   when 'current_Quarter' == 'Quarter'  then max('Actual')  when max('Snapshot') is null then null else max('Snapshot') end as 'Metric_n'\n,case  when 'current_Quarter' == 'Quarter'  &&  max('Actual') is null then \"NA\"   when 'current_Quarter' == 'Quarter' then  number_to_string( max('Actual') ,\"#%\") when max('Snapshot') is null then \"NA\" else   number_to_string(max('Snapshot'),\"#%\")  end as 'Metric';\n\n--q_ManagerOppties_Snapshot = group q_ManagerOppties_Snapshot by ( 'Manager_nm','Quarter');\nq_ManagerOppties_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm' as 'Manager Name'\n,'Quarter' \n, case \n    when (sum('Metric_n') >= 1 && sum('Metric_n') <=  1.25)  || ( sum('Metric_n') <= 1 && sum('Metric_n') >=  0.75) then \"#9fd541\"  \n    when (sum('Metric_n') > 1.25 && sum('Metric_n') <=  1.5)  || ( sum('Metric_n') <= 0.75 && sum('Metric_n') >=  0.5)  then \"#ffe500\" \n    when   sum('Metric_n') > 1.5   ||  sum('Metric_n') < 0.5  then \"#c81326\" end as 'color'\n\n, case when (sum('Metric_n') >= 1 && sum('Metric_n') <=  1.25)  || ( sum('Metric_n') <= 1 && sum('Metric_n') >=  0.75) then \"#000000\"  \n    when (sum('Metric_n') > 1.25 && sum('Metric_n') <=  1.5)  || ( sum('Metric_n') <= 0.75 && sum('Metric_n') >=  0.5)  then \"#000000\" \n    when   sum('Metric_n') > 1.5   ||  sum('Metric_n') < 0.5  then \"#FFFFFF\" end as 'text_color'\n,case when 'Metric' == \"%\" then \"0%\" else 'Metric' end as 'Metric';\nq_ManagerOppties_Snapshot = order q_ManagerOppties_Snapshot by 'Quarter' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager Name","Quarter","Metric"],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"Confidence_Snapshot__1":{"broadcastFacet":true,"groups":[],"label":"Confidence Snapshot Details","numbers":[],"query":"q_managers = load \"ManagerUsers\";\nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_managers_snapshot1 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \