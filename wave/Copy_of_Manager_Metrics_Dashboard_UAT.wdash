er_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"11\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot12= foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" || date_to_string(now(), \"MM\") == \"11\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"12\" as 'Snapshot_Date_Month' ;\n\nmonths = union q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4,q_managers_snapshot5,q_managers_snapshot6,q_managers_snapshot7,q_managers_snapshot8,q_managers_snapshot9,q_managers_snapshot10,q_managers_snapshot11,q_managers_snapshot12;\nmonths = foreach months generate  'Manager_nm','Manager_wwid', 'manager_cnt','Snapshot_Date_Year','Snapshot_Date_Month' ;\n\n\n --Account Snapshot\nq_accountp_snapshot = load \"SnapshotDS18\";\nq_accountp_snapshot = filter q_accountp_snapshot by 'Core_Account_Primary_Coverage__c' matches  \"Intel\" ;\nq_accountp_snapshot = filter q_accountp_snapshot by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\n--q_accountp_snapshot = filter q_accountp_snapshot by  date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_accountp_snapshot= filter q_accountp_snapshot by  'AccountUser.OWNER_HIERARCHY_TXT'  matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );--\"!{User.Id}\" ;\nq_accountp1_snapshot = group q_accountp_snapshot by ('Core_Unified_Global_Customer_Name__c','AccountUser.OWNER_HIERARCHY_TXT','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accountp1_snapshot = foreach q_accountp1_snapshot generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Core_Unified_Global_Customer_Name__c', unique('Core_Unified_Global_Customer_Name__c') as 'UCD_G', 0 as 'UCD_Attach','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\n\n\nq_accountp2_snapshot = filter q_accountp_snapshot by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_accountp2_snapshot = group q_accountp2_snapshot by ('Core_Unified_Global_Customer_Name__c','AccountUser.OWNER_HIERARCHY_TXT','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accountp2_snapshot = foreach q_accountp2_snapshot generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Core_Unified_Global_Customer_Name__c',   0 as 'UCD_G', unique('Core_Unified_Global_Customer_Name__c') as 'UCD_Attach','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\n\n\n\nq_accplan_snapshot = union q_accountp1_snapshot, q_accountp2_snapshot;\nq_accplan_snapshot = group q_accplan_snapshot by ('Core_Unified_Global_Customer_Name__c', 'Manager_nm','Manager_wwid','UCD_Attach','UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accplan_snapshot = foreach q_accplan_snapshot generate 'Manager_nm','Manager_wwid','Core_Unified_Global_Customer_Name__c','UCD_Attach','UCD_G','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c';\n\n\nq_accplan_snapshot = group q_accplan_snapshot by ('Manager_nm','Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month','Core_Account_Level__c');\nq_accplan_snapshot = foreach q_accplan_snapshot generate 'Manager_nm','Manager_wwid',sum('UCD_Attach') as 'ucd_attach',sum('UCD_G') as 'ucd_g',sum('UCD_Attach')/sum('UCD_G') as 'result','Snapshot_Date_Year','Snapshot_Date_Month';\n\nq_accplan_snapshot = union q_accplan_snapshot,months;\n\nq_accplan_snapshot  = group q_accplan_snapshot  by ('Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month');\nq_accplan_snapshot  = foreach q_accplan_snapshot  generate  max('Manager_nm') as 'Manager_nm'\n,'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Month' as 'Month'\n,case when max('result') is null then null else  max('result') end as 'Snapshot'\n,null as 'Actual'; \n\n\n--Account\nq_accountp = load \"ManagerMetric_AccountPlan\";\nq_accountp = filter q_accountp by 'Core_Account_Primary_Coverage__c' matches  \"Intel\" ;\nq_accountp = filter q_accountp by 'Core_Account_Level__c' in {{coalesce(column(Core_Account_Level___1.selection, [\"Core_Account_Level__c\"]),\"all\").asString()}};\n\nq_accountp= filter q_accountp by  'AccountUser.OWNER_HIERARCHY_TXT'  matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );--\"!{User.Id}\" ;\nq_accountp1 = group q_accountp by ('Core_Unified_Global_Customer_Name__c','AccountUser.OWNER_HIERARCHY_TXT','Core_Account_Level__c');\nq_accountp1 = foreach q_accountp1 generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Core_Unified_Global_Customer_Name__c', unique('Core_Unified_Global_Customer_Name__c') as 'UCD_G', 0 as 'UCD_Attach','Core_Account_Level__c';\n\n\nq_accountp2 = filter q_accountp by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_accountp2 = group q_accountp2 by ('Core_Unified_Global_Customer_Name__c','AccountUser.OWNER_HIERARCHY_TXT','Core_Account_Level__c');\nq_accountp2 = foreach q_accountp2 generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Core_Unified_Global_Customer_Name__c',   0 as 'UCD_G', unique('Core_Unified_Global_Customer_Name__c') as 'UCD_Attach','Core_Account_Level__c';\n\nq_accplan = union q_accountp1, q_accountp2;\nq_accplan = group q_accplan by ('Core_Unified_Global_Customer_Name__c', 'Manager_nm','Manager_wwid','UCD_Attach','UCD_G','Core_Account_Level__c');\nq_accplan = foreach q_accplan generate 'Manager_nm','Manager_wwid','Core_Unified_Global_Customer_Name__c','UCD_Attach','UCD_G','Core_Account_Level__c';\n\n\nq_accplan = group q_accplan by ('Manager_nm','Manager_wwid');\nq_accplan = foreach q_accplan generate 'Manager_nm','Manager_wwid',sum('UCD_Attach') as 'ucd_attach',sum('UCD_G') as 'ucd_g',sum('UCD_Attach')/sum('UCD_G') as 'result';\n\nq_accplan = union q_accplan,months;\n\nq_accplan  = group q_accplan  by ('Manager_wwid');\nq_accplan  = foreach q_accplan  generate  max('Manager_nm') as 'Manager_nm'\n,date_to_string(now(), \"yyyy-MM\") as 'Month'\n,case when max('result') is null then null else  max('result') end as 'Actual'\n,null as 'Snapshot'; \n\nq_accplan_snapshot = union q_accplan,q_accplan_snapshot;\n\nq_accplan_snapshot = filter q_accplan_snapshot by 'Manager_nm' != \"\" && 'Manager_nm' != \"!{User.Name}\" && 'Month' is not null ;\nq_accplan_snapshot = group q_accplan_snapshot by ( 'Manager_nm','Month');\nq_accplan_snapshot = foreach q_accplan_snapshot generate  'Manager_nm'\n,'Month'\n,case  when date_to_string(now(), \"yyyy-MM\") == 'Month'  then max('Actual') when max('Snapshot') is null then null   else max('Snapshot') end as 'Metric_n'\n,case  when date_to_string(now(), \"yyyy-MM\") == 'Month'  then  number_to_string( max('Actual') ,\"#%\") when max('Snapshot') is null then \"NA\" when max('Snapshot') == 0 || max('Actual') == 0 then \"0%\" else   number_to_string(max('Snapshot'),\"##%\")  end as 'Metric';\n\n\n\t\n--q_accplan_snapshot = group q_accplan_snapshot by ( 'Manager_nm','Month');\nq_accplan_snapshot = foreach q_accplan_snapshot generate  'Manager_nm' as 'Manager Name'\n,'Month'\n,case when 'Metric' == \"%\" then \"0%\" when 'Metric' is null then \"NA\" else 'Metric' end as 'Metric'\n, case when  sum('Metric_n') < 0.499 then \"#c81326\"\n    when ( sum('Metric_n')> 0.499 && sum('Metric_n') < 0.999) then \"#ffe500\" \n    when (  sum('Metric_n')>= 0.999 ) then \"#9fd541\" end as 'color'\n, case when  sum('Metric_n') < 0.499 then \"#ffffff\"\n    when ( sum('Metric_n')> 0.499 && sum('Metric_n') < 0.999) then \"#000000\" \n    when (  sum('Metric_n')>= 0.999 ) then \"#000000\" end as 'text_color';\n\t\nq_accplan_snapshot = order q_accplan_snapshot by 'Month' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager Name","Month","Metric"],"customBulkActions":[],"fixedColumnWidth":86,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_6":{"broadcastFacet":true,"datasets":[{"name":"UpdatesMetrict"}],"isGlobal":false,"query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["all"],"joins":[],"name":"UpdatesMetrict"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":[],"plots":["A"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_15":{"broadcastFacet":true,"groups":[],"label":"lens_15","numbers":[],"query":"--Commited on the same quarter Snapshot\nManagerOpptiesCommit_Snapshot = load \"SnapshotDS22\";\n \n\nmonth1 = foreach ManagerOpptiesCommit_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',case when string_to_number(date_to_string(now(), \"MM\")) >= 1 || string_to_number(date_to_string(now(), \"MM\")) <= 3 then date_to_string(now(), \"yyyy\") end  as 'Snapshot_Date_Year',\"Q1\" as 'Snapshot_Date_Quarter' ;\nmonth2 = foreach ManagerOpptiesCommit_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',case when string_to_number(date_to_string(now(), \"MM\")) >= 4 || string_to_number(date_to_string(now(), \"MM\")) <= 6 then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"Q2\" as 'Snapshot_Date_Quarter' ;\nmonth3 = foreach ManagerOpptiesCommit_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',case when string_to_number(date_to_string(now(), \"MM\")) >= 7 || string_to_number(date_to_string(now(), \"MM\")) <= 9 then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"Q3\" as 'Snapshot_Date_Quarter' ;\nmonth4 = foreach ManagerOpptiesCommit_Snapshot generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',case when string_to_number(date_to_string(now(), \"MM\")) >= 10 || string_to_number(date_to_string(now(), \"MM\")) <= 12 then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"Q4\" as 'Snapshot_Date_Quarter' ;\nquarters = union month1,month2,month3,month4;\nquarters = group quarters by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter' );\nquarters =  foreach quarters generate 'Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter' ;\n\n\n--ManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");ManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate case when 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'PERIOD_TXT' else \"\" end as 'PERIOD_TXT',case when 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'FORECAST_AMT' else 0 end as 'FORECAST_AMT',case when 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'OPPORTUNITIES_AMT' else 0 end as 'OPPORTUNITIES_AMT';\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('PERIOD_TXT');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate 'PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT')) as 'commitMetric',substr('PERIOD_TXT',8,9) as 'Snapshot_Date_Year',case when 'PERIOD_TXT' matches \"Q 1\"   then \"Q1\" when 'PERIOD_TXT' matches \"Q 2\" then \"Q2\" when 'PERIOD_TXT' matches \"Q 3\"  then \"Q3\" when 'PERIOD_TXT' matches \"Q 4\" then \"Q4\" end as  'Snapshot_Date_Quarter' ;\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n, 'Snapshot_Date_Year'\n, 'Snapshot_Date_Quarter'\n,case when min('commitMetric') is null then null when min('commitMetric') > 1 then 1 when min('commitMetric') < -1 then -1  else min('commitMetric') end as 'Metric'; \n\nManagerOpptiesCommit_Snapshot = union ManagerOpptiesCommit_Snapshot,quarters;\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, case when 'Snapshot_Date_Year' is null then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") + 'Snapshot_Date_Quarter' else 'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Quarter' end as 'Quarter'\n,case when min('Metric') is null then null else min('Metric') end as 'Snapshot'\n, null as 'Actual';\n\n--Commited on the same quarter\nManagerOpptiesCommit = load \"ManagerCommitMetric\";\nManagerOpptiesCommit = filter ManagerOpptiesCommit by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"current quarter\"..\"current quarter\"];\n--ManagerOpptiesCommit = filter ManagerOpptiesCommit by 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate case when 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'PERIOD_TXT' else \"\" end as 'PERIOD_TXT',case when 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'FORECAST_AMT' else 0 end as 'FORECAST_AMT',case when 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\") then 'OPPORTUNITIES_AMT' else 0 end as 'OPPORTUNITIES_AMT';\nManagerOpptiesCommit = group ManagerOpptiesCommit by ('PERIOD_TXT');\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate 'PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT')) as 'commitMetric';\nManagerOpptiesCommit = group ManagerOpptiesCommit by all;\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) as 'Manager_wwid'\n,case when date_to_string(now(), \"MM\") == \"01\" ||  date_to_string(now(), \"MM\") == \"02\" ||  date_to_string(now(), \"MM\") == \"03\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" when date_to_string(now(), \"MM\") == \"04\" ||  date_to_string(now(), \"MM\") == \"05\" ||  date_to_string(now(), \"MM\") == \"06\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" when date_to_string(now(), \"MM\") == \"07\" ||  date_to_string(now(), \"MM\") == \"08\" ||  date_to_string(now(), \"MM\") == \"09\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" when date_to_string(now(), \"MM\") == \"10\" ||  date_to_string(now(), \"MM\") == \"11\" ||  date_to_string(now(), \"MM\") == \"12\" then date_to_string(now(), \"yyyy\") + \"-\" + \"Q4\" end as 'Quarter'\n,case when max('commitMetric') is null then 0 when max('commitMetric') > 1 then 1 when max('commitMetric') < -1 then -1  else max('commitMetric') end as 'Actual'\n,null as 'Snapshot'; \n\nManagerOpptiesCommit_Snapshot = union ManagerOpptiesCommit_Snapshot,ManagerOpptiesCommit;\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n,case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" || date_to_string(now(), \"MM\") == \"03\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q1\" \n    when date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q2\" \n    when date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" then  date_to_string(now(), \"yyyy\") + \"-\" + \"Q3\" \n    else  date_to_string(now(), \"yyyy\") + \"-\" + \"Q4\"  end as 'current_Quarter'\n,  max('Actual')  as 'Actual'\n, max('Snapshot')  as 'Snapshot';\n\n\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','current_Quarter','Quarter');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n,'current_Quarter'\n,case   when 'current_Quarter' == 'Quarter'  then max('Actual')  when max('Snapshot') is null then null else max('Snapshot') end as 'Metric_n'\n,case  when 'current_Quarter' == 'Quarter'  then  number_to_string( max('Actual') ,\"#%\") when max('Snapshot') is null then \"NA\" else   number_to_string(max('Snapshot'),\"#%\")  end as 'Metric';\n\n--ManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_nm','Quarter');\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'Quarter' is not null;\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate  'Manager_nm'\n, 'Quarter'\n, case \n    when (sum('Metric_n') >= 1 && sum('Metric_n') <=  1.25)  || ( sum('Metric_n') <= 1 && sum('Metric_n') >=  0.75) then \"#9fd541\"  \n    when (sum('Metric_n') > 1.25 && sum('Metric_n') <=  1.5)  || ( sum('Metric_n') <= 0.75 && sum('Metric_n') >=  0.5)  then \"#ffe500\" \n    when   sum('Metric_n') > 1.5   ||  sum('Metric_n') < 0.5  then \"#c81326\" end as 'color'\n\n, case when (sum('Metric_n') >= 1 && sum('Metric_n') <=  1.25)  || ( sum('Metric_n') <= 1 && sum('Metric_n') >=  0.75) then \"#000000\"  \n    when (sum('Metric_n') > 1.25 && sum('Metric_n') <=  1.5)  || ( sum('Metric_n') <= 0.75 && sum('Metric_n') >=  0.5)  then \"#000000\" \n    when   sum('Metric_n') > 1.5   ||  sum('Metric_n') < 0.5  then \"#FFFFFF\" end as 'text_color'\n,case when 'Metric' == \"%\" then \"0%\" else 'Metric' end as 'Metric';\n\nManagerOpptiesCommit_Snapshot =  order ManagerOpptiesCommit_Snapshot by 'Quarter' asc;\nManagerOpptiesCommit_Snapshot = limit ManagerOpptiesCommit_Snapshot 5 ;\nManagerOpptiesCommit_Snapshot =  foreach ManagerOpptiesCommit_Snapshot generate 'Manager_nm','Quarter','Metric','color','text_color';\nManagerOpptiesCommit_Snapshot =  order ManagerOpptiesCommit_Snapshot by 'Quarter' desc;\nManagerOpptiesCommit_Snapshot = limit ManagerOpptiesCommit_Snapshot 4 ;\n\nManagerOpptiesCommit_Snapshot =  foreach ManagerOpptiesCommit_Snapshot generate 'Manager_nm','Quarter','Metric','color','text_color';\nManagerOpptiesCommit_Snapshot =  order ManagerOpptiesCommit_Snapshot by 'Quarter' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor