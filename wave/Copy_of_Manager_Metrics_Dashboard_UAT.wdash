rs ago\"..\"current quarter\"] and 'Core_Product_Count__c' == 0));\nq_opps_unhealthy = filter q by 'opportunity_unhealthy' == 1;\nq = cogroup q by ('Snapshot_Date_Year', 'Snapshot_Date_Month','Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT') full, q_opps_unhealthy by ('Snapshot_Date_Year', 'Snapshot_Date_Month','Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT');\nq = foreach q generate coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') as 'Snapshot_Date_Year', coalesce(q.'Snapshot_Date_Month', q_opps_unhealthy.'Snapshot_Date_Month') as 'Snapshot_Date_Month', coalesce(q.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT', q_opps_unhealthy.'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT') as 'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce(unique(q.'Id'),0) as 'count_opps', coalesce(unique(q_opps_unhealthy.'Id'),0) as 'opps_unhealthy';\n \nq = group q by ('Snapshot_Date_Year',   'Snapshot_Date_Month','Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT');\nq = foreach q generate  \"\" as 'Manager_nm',substr('Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT', index_of('Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid',case when 'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  then   'Snapshot_Date_Year' else null end  as 'Snapshot_Date_Year',case when 'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  then   'Snapshot_Date_Month' else null end as 'Snapshot_Date_Month', case when 'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  then  1-(sum(opps_unhealthy)/sum(count_opps))  else null end  as 'confidence';\n \nq = group q by ('Manager_nm','Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month' );\n\nq = foreach q generate  'Manager_nm','Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month' ,max('confidence') as 'confidence';\n \nconfidence_snapshot = union q,months;\nconfidence_snapshot = group confidence_snapshot by ('Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month');\nconfidence_snapshot = foreach confidence_snapshot generate  max('Manager_nm') as 'Manager_nm'\n,case when 'Snapshot_Date_Year' is null then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") + 'Snapshot_Date_Month' else 'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Month' end as 'Month'\n,case when max('confidence') is null then null else max('confidence') end as 'Snapshot'\n,null as 'Actual';\n\n\n---Confidence\nq_confidence = load \"ManagerConfidenceMetrict\";\nq_confidence = filter q_confidence by 'Core_Opportunity_Coverage_Nm__c' == \"Intel-Led Opportunity\";\nq_confidence= filter q_confidence by  'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  ;\nq_confidence = filter q_confidence by 'Confidence.op.Core_Status__c' not in  [\"Cancelled\",\"Lost\"];\nq_confidence = filter q_confidence by (date('Confidence.op.Core_KPI_Date__c_Year', 'Confidence.op.Core_KPI_Date__c_Month', 'Confidence.op.Core_KPI_Date__c_Day') in [\"3 quarters ago\"..\"current quarter\"] or  date('Confidence.CloseDate_Year', 'Confidence.CloseDate_Month', 'Confidence.CloseDate_Day')  in [\"3 quarters ago\"..\"current quarter\"] );\n\nq_confidence = foreach q_confidence generate \"\" as 'Manager_nm',substr('DIM_MANAGE.OWNER_HIERARCHY_TXT', index_of('DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Confidence.OpportunityProducts.Name' as 'Confidence.op.Name',  'Confidence.Name' as 'Name',  'Confidence.Id' ,  'Confidence.OpportunityProducts.Product2Id' as 'Confidence.OpportunityProducts.Product2Id', 'Confidence.unhealthy';\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm','Confidence.Id' , 'Confidence.unhealthy');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm','Confidence.Id'  , max('Confidence.unhealthy') as 'unhealthy_total' ;\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm',(1- (sum('unhealthy_total') / count()) )  as 'Confidence score';\n\nq_confidence_managers = union q_confidence,q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4,q_managers_snapshot5,q_managers_snapshot6,q_managers_snapshot7,q_managers_snapshot8,q_managers_snapshot9,q_managers_snapshot10,q_managers_snapshot11,q_managers_snapshot12;\nq_confidence_managers = group q_confidence_managers by ('Manager_wwid');\nq_confidence_managers = foreach q_confidence_managers generate max('Manager_nm') as 'Manager_nm'\n,date_to_string(now(), \"yyyy-MM\") as 'Month'\n,case when max('Confidence score') is null then null else max('Confidence score') end as 'Actual'\n,null as 'Snapshot'; \n\nq_confidence_managers_snapshot = union confidence_snapshot,q_confidence_managers;\n\nq_confidence_managers_snapshot = filter q_confidence_managers_snapshot by 'Manager_nm' != \"\" && 'Manager_nm' != \"!{User.Name}\"  && 'Month' is not null;\n\nq_confidence_managers_snapshot = group q_confidence_managers_snapshot by ( 'Manager_nm', 'Month');\nq_confidence_managers_snapshot = foreach q_confidence_managers_snapshot generate  'Manager_nm'\n, 'Month' \n,case   when date_to_string(now(), \"yyyy-MM\") == 'Month'  then max('Actual') when max('Snapshot') is null then null else max('Snapshot') end as 'Metric_n'\n,case when date_to_string(now(), \"yyyy-MM\") == 'Month'  then  number_to_string( max('Actual') ,\"#%\") when max('Snapshot') is null then \"NA\"  else   number_to_string(max('Snapshot'),\"#%\")  end as 'Metric';\n\n\nq_confidence_managers_snapshot = foreach q_confidence_managers_snapshot