{User.Id}\"))-19,18) as 'Manager_wwid', case when 'Opportunity.DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  then  1-(sum(opps_unhealthy)/sum(count_opps))  else null end  as 'confidence';\n \nq = group q by ('Manager_nm','Manager_wwid' );\n\nq = foreach q generate  'Manager_nm','Manager_wwid',max('confidence') as 'confidence';\n \nq_confidence_managers_snapshot = union q,q_managers;\nq_confidence_managers_snapshot = group q_confidence_managers_snapshot by ('Manager_wwid');\nq_confidence_managers_snapshot = foreach q_confidence_managers_snapshot generate   max('Manager_nm') as 'Manager_nm'\n, \"Confidence Score\" as 'Metric Name'\n,null as 'Actual'\n,case when max('confidence') is null then null else max('confidence') end  as 'Snapshot'; \n\n\n\n\n---Updates Opportunities\nq_UpOpp = load \"UpdatesMetric\";\nq_UpOpp= filter q_UpOpp by  'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) ;\nq_UpOpp = filter q_UpOpp by date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"];\n\n\n--Update last 30 days\nq_UpOppM = foreach q_UpOpp generate \"\" as 'Manager_nm',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','OPPORTUNITYID' as 'OpptyId_Qrt', case when date('LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day') in [\"current month\"..\"current day\"] then 'OPPORTUNITYID' end as 'OpptyId_Mth';\nq_UpOppM = group q_UpOppM by ('Manager_wwid', 'Manager_nm');\nq_UpOppM = foreach q_UpOppM generate 'Manager_wwid', 'Manager_nm',unique('OpptyId_Mth')/unique('OpptyId_Qrt') as '% total of current opptys updated current month'; \n\nq_UpOppM_managers = union q_UpOppM,q_managers;\nq_UpOppM_managers = group q_UpOppM_managers by ('Manager_wwid');\nq_UpOppM_managers = foreach q_UpOppM_managers generate max('Manager_nm') as 'Manager_nm'\n, \"% total of current opptys updated current month\" as 'Metric Name' \n,case when max('% total of current opptys updated current month') is null then null else max('% total of current opptys updated current month') end as 'Actual'\n,null as 'Snapshot';  \n\n--Opportunity Monthly Snapshot Updates\nq_UpOpp_Month_Snapshot = load \"SnapshotDS13\";\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"current quarter\"..\"current quarter\"];\nq_UpOpp_Month_Snapshot= filter q_UpOpp_Month_Snapshot by  'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) ;\n\n\n--Update last 30 days Snapshot\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_Snapshot generate \"\" as 'Manager_nm',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','OPPORTUNITYID' as 'OpptyId_Qrt', \ncase when date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"] then 'OPPORTUNITYID' end as 'OpptyId_Mth';\nq_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Manager_wwid', 'Manager_nm');\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate 'Manager_wwid', 'Manager_nm',unique('OpptyId_Mth')/unique('OpptyId_Qrt') as '% total of current opptys updated current month'; \n\nq_UpOppM_managers_Snapshot = union q_UpOpp_Month_SnapshotM,q_managers;\nq_UpOppM_managers_Snapshot = group q_UpOppM_managers_Snapshot by ('Manager_wwid');\nq_UpOppM_managers_Snapshot = foreach q_UpOppM_managers_Snapshot generate max('Manager_nm') as 'Manager_nm'\n, \"% total of current opptys updated current month\" as 'Metric Name'\n,null as 'Actual'\n,case when max('% total of current opptys updated current month') is null then null else max('% total of current opptys updated current month') end  as 'Snapshot';  \n\n\n--Account\nq_accountp = load \"ManagerMetric_AccountPlan\";\nq_accountp = filter q_accountp by 'Core_Account_Primary_Coverage__c' matches \"Intel\";\nq_accountp= filter q_accountp by  'AccountUser.OWNER_HIERARCHY_TXT'  matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );--\"!{User.Id}\" ;\nq_accountp1 = group q_accountp by ('Core_Unified_Global_Customer_Name__c','AccountUser.OWNER_HIERARCHY_TXT');\nq_accountp1 = foreach q_accountp1 generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Core_Unified_Global_Customer_Name__c', unique('Core_Unified_Global_Customer_Name__c') as 'UCD_G', 0 as 'UCD_Attach';\n\n\nq_accountp2 = filter q_accountp by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_accountp2 = group q_accountp2 by ('Core_Unified_Global_Customer_Name__c','AccountUser.OWNER_HIERARCHY_TXT');\nq_accountp2 = foreach q_accountp2 generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Core_Unified_Global_Customer_Name__c',   0 as 'UCD_G', unique('Core_Unified_Global_Customer_Name__c') as 'UCD_Attach';\n\nq_accplan = union q_accountp1, q_accountp2;\nq_accplan = group q_accplan by ('Core_Unified_Global_Customer_Name__c', 'Manager_nm','Manager_wwid','UCD_Attach','UCD_G');\nq_accplan = foreach q_accplan generate 'Manager_nm','Manager_wwid','Core_Unified_Global_Customer_Name__c','UCD_Attach','UCD_G';\n\n\nq_accplan = group q_accplan by ('Manager_nm','Manager_wwid');\nq_accplan = foreach q_accplan generate 'Manager_nm','Manager_wwid',sum('UCD_Attach') as 'ucd_attach',sum('UCD_G') as 'ucd_g',sum('UCD_Attach')/sum('UCD_G') as 'result';\n\nq_accplan = union q_accplan,q_managers;\n\nq_accplan  = group q_accplan  by ('Manager_wwid');\nq_accplan  = foreach q_accplan  generate  max('Manager_nm') as 'Manager_nm'\n, \"Account Plans (UCD Global)\" as 'Metric Name'\n,case when max('result') is null then null else  max('result') end as 'Actual'\n,null as 'Snapshot';  \n\n --Account Snapshot\nq_accountp_snapshot = load \"SnapshotDS18\";\nq_accountp_snapshot = filter q_accountp_snapshot by 'Core_Account_Primary_Coverage__c' matches \"Intel\";\nq_accountp_snapshot = filter q_accountp_snapshot by  date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_accountp_snapshot= filter q_accountp_snapshot by  'AccountUser.OWNER_HIERARCHY_TXT'  matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );--\"!{User.Id}\" ;\nq_accountp1_snapshot = group q_accountp_snapshot by ('Core_Unified_Global_Customer_Name__c','AccountUser.OWNER_HIERARCHY_TXT');\nq_accountp1_snapshot = foreach q_accountp1_snapshot generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Core_Unified_Global_Customer_Name__c', unique('Core_Unified_Global_Customer_Name__c') as 'UCD_G', 0 as 'UCD_Attach';\n\n\nq_accountp2_snapshot = filter q_accountp by 'Account_Plan.Number_of_Attachments__c' >= 1 ||  ( 'Account_Plan.Core_Document_Link__c' matches \"intel.lightning\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"sharepoint.com\"\n                        || 'Account_Plan.Core_Document_Link__c' matches \"onedrive\");\nq_accountp2_snapshot = group q_accountp2_snapshot by ('Core_Unified_Global_Customer_Name__c','AccountUser.OWNER_HIERARCHY_TXT');\nq_accountp2_snapshot = foreach q_accountp2_snapshot generate \"\" as 'Manager_nm',substr('AccountUser.OWNER_HIERARCHY_TXT', index_of('AccountUser.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Core_Unified_Global_Customer_Name__c',   0 as 'UCD_G', unique('Core_Unified_Global_Customer_Name__c') as 'UCD_Attach';\n\n\n\nq_accplan_snapshot = union q_accountp1_snapshot, q_accountp2_snapshot;\nq_accplan_snapshot = group q_accplan_snapshot by ('Core_Unified_Global_Customer_Name__c', 'Manager_nm','Manager_wwid','UCD_Attach','UCD_G');\nq_accplan_snapshot = foreach q_accplan_snapshot generate 'Manager_nm','Manager_wwid','Core_Unified_Global_Customer_Name__c','UCD_Attach','UCD_G';\n\n\nq_accplan_snapshot = group q_accplan_snapshot by ('Manager_nm','Manager_wwid');\nq_accplan_snapshot = foreach q_accplan_snapshot generate 'Manager_nm','Manager_wwid',sum('UCD_Attach') as 'ucd_attach',sum('UCD_G') as 'ucd_g',sum('UCD_Attach')/sum('UCD_G') as 'result';\n\nq_accplan_snapshot = union q_accplan_snapshot,q_managers;\n\nq_accplan_snapshot  = group q_accplan_snapshot  by ('Manager_wwid');\nq_accplan_snapshot  = foreach q_accplan_snapshot  generate  max('Manager_nm') as 'Manager_nm'\n, \"Account Plans (UCD Global)\" as 'Metric Name'\n,null as 'Actual'\n,case when max('result') is null then null else  max('result') end as 'Snapshot'; \n\n--Commited on the same quarter\nManagerOpptiesCommit = load \"ManagerCommitMetric\";\nManagerOpptiesCommit = filter ManagerOpptiesCommit by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"current quarter\"..\"current quarter\"];\nManagerOpptiesCommit = filter ManagerOpptiesCommit by 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate \"\" as 'Manager_nm',substr('DIM_MANAGER.OWNER_HIERARCHY_TXT', index_of('DIM_MANAGER.OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid', 'PERIOD_TXT','FORECAST_AMT' as 'FORECAST_AMT','OPPORTUNITIES_AMT' as 'OPPORTUNITIES_AMT';\nManagerOpptiesCommit = group ManagerOpptiesCommit by ('Manager_wwid', 'Manager_nm','PERIOD_TXT');\nManagerOpptiesCommit = foreach ManagerOpptiesCommit generate 'Manager_wwid', 'Manager_nm','PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT')) as 'commitMetric';\n\nq_ManagerOppties = union ManagerOpptiesCommit, q_managers;\nq_ManagerOppties = group q_ManagerOppties by ('Manager_wwid');\nq_ManagerOppties = foreach q_ManagerOppties generate max('Manager_nm') as 'Manager_nm'\n,\"% Commited on the Current Quarter\" as 'Metric Name'\n,case when max('commitMetric') is null then null else max('commitMetric') end  as 'Actual'\n,null as 'Snapshot';   \n\n--Commited on the same quarter Snapshot\nManagerOpptiesCommit_Snapshot = load \"SnapshotDS22\";\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 quarter ago\"..\"1 quarter ago\"];\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by date('DECISION_DATE__C_Year', 'DECISION_DATE__C_Month', 'DECISION_DATE__C_Day') in [\"1 quarter ago\"..\"current quarter\"];\nManagerOpptiesCommit_Snapshot = filter ManagerOpptiesCommit_Snapshot by 'DIM_MANAGER.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate \"\" as 'Manager_nm',substr('DIM_MANAGER.OWNER_HIERARCHY_TXT', index_of('DIM_MANAGER.OWNER_HIERARCHY_TXT', coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid', 'PERIOD_TXT','FORECAST_AMT' as 'FORECAST_AMT','OPPORTUNITIES_AMT' as 'OPPORTUNITIES_AMT';\nManagerOpptiesCommit_Snapshot = group ManagerOpptiesCommit_Snapshot by ('Manager_wwid', 'Manager_nm','PERIOD_TXT');\nManagerOpptiesCommit_Snapshot = foreach ManagerOpptiesCommit_Snapshot generate 'Manager_wwid', 'Manager_nm','PERIOD_TXT', max('FORECAST_AMT') as 'FORECAST_AMT',max('OPPORTUNITIES_AMT') as 'OPPORTUNITIES_AMT',(max('OPPORTUNITIES_AMT')/max('FORECAST_AMT')) as 'commitMetric';\n\nq_ManagerOppties_Snapshot = union ManagerOpptiesCommit_Snapshot, q_managers;\nq_ManagerOppties_Snapshot = group q_ManagerOppties_Snapshot by ('Manager_wwid');\nq_ManagerOppties_Snapshot = foreach q_ManagerOppties_Snapshot generate max('Manager_nm') as 'Manager_nm'\n,\"% Commited on the Current Quarter\" as 'Metric Name'\n,null as 'Actual'\n,case when max('commitMetric') is null then null else max('commitMetric')  end as 'Snapshot';  \n\n--Final Query:\nq_final = union q_confidence_managers,q_confidence_managers_snapshot,q_UpOppM_managers,q_UpOppM_managers_Snapshot,q_accplan,q_accplan_snapshot,q_ManagerOppties,q_ManagerOppties_Snapshot;\nq_final = filter q_final by 'Manager_nm' != \"\" && 'Manager_nm' != \"!{User.Name}\"  ;\nq_final = group q_final by ( 'Manager_nm','Metric Name');\nq_final = foreach q_final generate  'Manager_nm' as 'Manager Name'\n,'Metric Name'\n,case when sum('Actual') is null then \"NA\"  when sum('Actual')==0 then \"0%\" when number_to_string(sum('Actual'),\"#%\") == \"%\" then \"0%\" else number_to_string(sum('Actual'),\"#%\") end as 'Actual'\n,case when  (sum('Actual')-sum('Snapshot')) is null then \"NA\" when sum('Actual') is null then number_to_string( (sum('Snapshot')),\"#%\") when  (sum('Actual')-sum('Snapshot'))==0 then \"0%\" when number_to_string( (sum('Actual')-sum('Snapshot')),\"#%\") == \"%\" then \"0%\"  else number_to_string( (sum('Actual')-sum('Snapshot')),\"#%\") end as 'Delta'\n, case when ('Metric Name' == \"Confidence Score\" &&  sum('Actual') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')>= 0.799 )) then \"#9fd541\"   \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  sum('Actual') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')>= 0.799 )) then \"#9fd541\"\n     when ('Metric Name' ==  \"Account Plans (UCD Global)\" &&  sum('Actual') < 0.499 ) then \"#c81326\"\n    when ('Metric Name' ==  \"Account Plans (UCD Global)\"  &&  ( sum('Actual')> 0.499 && sum('Actual') < 0.999 )) then \"#ffe500\" \n    when ('Metric Name' ==  \"Account Plans (UCD Global)\"   &&  ( sum('Actual')>= 0.999 )) then \"#9fd541\"when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') >= 1 && sum('Actual') <=  1.25)  || ( sum('Actual') <= 1 && sum('Actual') >=  0.75))) then \"#9fd541\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') > 1.25 && sum('Actual') <=  1.5)  || ( sum('Actual') <= 0.75 && sum('Actual') >=  0.5))) then \"#ffe500\" \n    when ('Metric Name' ==\"% Commited on the Current Quarter\" && (sum('Actual') > 1.5   ||  sum('Actual') < 0.5) ) then \"#c81326\"  end as 'actual_color'\n, case when ('Metric Name' == \"Confidence Score\" &&  sum('Actual') < 0.399 ) then \"#FFFFFF\"\n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#000000\" \n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Actual')>= 0.799 )) then \"#000000\"  \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  sum('Actual') < 0.399 ) then \"#FFFFFF\"\n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')> 0.399 && sum('Actual') < 0.799 )) then \"#000000\" \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Actual')>= 0.799 )) then \"#000000\" \n    when ('Metric Name' ==  \"Account Plans (UCD Global)\" &&  sum('Actual') < 0.499 ) then \"#FFFFFF\"\n    when ('Metric Name' ==  \"Account Plans (UCD Global)\"  &&  ( sum('Actual')> 0.499 && sum('Actual') < 0.999 )) then \"#000000\" \n    when ('Metric Name' ==  \"Account Plans (UCD Global)\"   &&  ( sum('Actual')>= 0.999 )) then \"#000000\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') >= 1 && sum('Actual') <=  1.25)  || ( sum('Actual') <= 1 && sum('Actual') >=  0.75))) then \"#000000\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ((sum('Actual') > 1.25 && sum('Actual') <=  1.5)  || ( sum('Actual') <= 0.75 && sum('Actual') >=  0.5))) then \"#000000\" \n    when ('Metric Name' ==\"% Commited on the Current Quarter\" && (sum('Actual') > 1.5   ||  sum('Actual') < 0.5) ) then \"#FFFFFF\" end as 'text_color'\n, case when ('Metric Name' == \"Confidence Score\" &&  sum('Snapshot') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Snapshot')> 0.399 && sum('Snapshot') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"Confidence Score\" &&  ( sum('Snapshot')>= 0.799 )) then \"#9fd541\"  \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  sum('Snapshot') < 0.399 ) then \"#c81326\"\n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Snapshot')> 0.399 && sum('Snapshot') < 0.799 )) then \"#ffe500\" \n    when ('Metric Name' == \"% total of current opptys updated current month\"  &&  ( sum('Snapshot')>= 0.799 )) then \"#9fd541\"\n     when ('Metric Name' ==  \"Account Plans (UCD Global)\" &&  sum('Snapshot') < 0.499 ) then \"#c81326\"\n    when ('Metric Name' ==  \"Account Plans (UCD Global)\"  &&  ( sum('Snapshot')> 0.499 && sum('Snapshot') < 0.999 )) then \"#ffe500\" \n    when ('Metric Name' ==  \"Account Plans (UCD Global)\"   &&  ( sum('Snapshot')>= 0.999 )) then \"#9fd541\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  sum('Snapshot') < -0.5 ) then \"#c81326\"\n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ( sum('Snapshot')> -0.5 && sum('Snapshot') < -0.25 )) then \"#ffe500\" \n    when ('Metric Name' ==\"% Commited on the Current Quarter\" &&  ( sum('Snapshot')> -0.25 && sum('Snapshot') < 0.25 )) then \"#9fd541\"  \n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  ( sum('Snapshot')> 0.25 && sum('Snapshot') < 0.5 )) then \"#ffe500\" \n    when ('Metric Name' == \"% Commited on the Current Quarter\" &&  sum('Snapshot') >= 0.5 ) then \"#c81326\"  end as 'MoM_color';\n    ","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager Name","Metric Name","Actual","Delta"],"customBulkActions":[],"fixedColumnWidth":124,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":4},"type":"table"}},"Core_Account_Level___1":{"broadcastFacet":true,"datasets":[{"name":"ManagerMetric_AccountPlan"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Core_Account_Level__c\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[\"Level1\"]","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{}},"static_4":{"broadcastFacet":true,"columns":{"Display":{"type":"string"}},"label":"","selectMode":"single","start":"{\"Display\":[\"Delta\"]}","type":"staticflex","values":["{\"Display\":\"Delta\"}"]},"static_3":{"broadcastFacet":true,"columns":{"Display":{"type":"string"}},"label":"","selectMode":"single","start":"{\"Display\":[\"Actual\"]}","type":"staticflex","values":["{\"Display\":\"Actual\"}"]},"static_2":{"broadcastFacet":true,"columns":{"Ranges":{"type":"string"},"Measured":{"type":"string"},"Definition":{"type":"string"},"Metric":{"type":"string"}},"label":"","selectMode":"single","start":"{\"Metric\":[]}","type":"staticflex","values":["{\"Metric\":\"% Commited on the Current Quarter\",\"Ranges\":\"+/- 25% Green +/- 25%-50% Yellow +/- 50%+ Red\",\"Definition\":\"Within +/- 25% to committed value at end of the quarter\",\"Measured\":\"Systems checks the committed value vs. actual and calculates the difference. +/- 25% is considered a healthy gap. \"}","{\"Metric\":\"% total of current opptys updated current month\",\"Ranges\":\"0% 39.9%- Red 40% - 79.9% - Yellow 80%+ Green\",\"Definition\":\"% of Current-Quarter Opportunities updated weekly\",\"Measured\":\"\"}","{\"Metric\":\"Account Plan Completion\",\"Ranges\":\"0% 49.9% Red 50% - 99.9% Yellow 100% Green\",\"Definition\":\"100% of Tier 1 Accounts have Account Plans (at Global level)\",\"Measured\":\"System checks for a link or document present at the Account Plan object, either at the global lever or intermediate level. \"}","{\"Metric\":\"Confidence\",\"Ranges\":\"0% 39.9%- Red 40% - 79.9% - Yellow 80%+ Green\",\"Definition\":\">80% Forecast Confidence score \",\"Measured\":\"Looks for the following 4 attributes 1. opptys with no products, 2. opptys with more than 3 pushes, 3. opttys in qualify & define and 4. opportunities with past due decision dates to come up with a confidence score.\"}"]},"static_1":{"broadcastFacet":true,"columns":{"Ranges":{"type":"string"},"Target":{"type":"string"},"Measured by":{"type":"string"},"Definition":{"type":"string"},"Metric":{"type":"string"}},"label":"","selectMode":"single","type":"staticflex","values":["{\"Metric\":\"% of current quarter opportunities updated monthly\",\"Definition\":null,\"Ranges\":\"0% 39.9%- Red 40% - 79.9% - Yellow 80%+ Green\",\"Target\":\"80%\",\"Measured by\":\"Team\"}","{\"Metric\":\"Account Plan Completion\",\"Definition\":null,\"Ranges\":\"0% 49.9% Red 50% - 99.9% Yellow 100% Green\",\"Target\":\"100%\",\"Measured by\":\"Team\"}","{\"Metric\":\"Confidence\",\"Definition\":null,\"Ranges\":\"0% 39.9%- Red 40% - 79.9% - Yellow 80%+ Green\",\"Target\":\"80%\",\"Measured by\":\"Team\"}","{\"Metric\":\"% Commited on the Current Quarter\",\"Definition\":null,\"Ranges\":\"+/- 25% Green +/- 25%-50% Yellow +/- 50%+ Red\",\"Target\":\"+/- 25%\",\"Measured by\":\"Team\"}"]},"Last_Month_Metric_1":{"broadcastFacet":true,"groups":[],"label":"Last Month Metric","numbers":[],"query":"\n--Opportunity Monthly Snapshot Updates\nq_UpOpp_Month_Snapshot= load \"SnapshotDS13\";\nUpdatesMetric = load \"UpdatesMetric\";\n\nmonths = foreach q_UpOpp_Month_Snapshot generate coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as  'Manager_nm' , number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\")  as 'last_year',date_to_string(now(), \"yyyy\") as 'current_year', date_to_string(now(), \"MM\") as 'current_month';\nmonths = group months by ('Manager_nm','last_year', 'current_year','current_month');\nmonths = foreach months generate  'Manager_nm','current_year','current_month','last_year' , case when 'current_month' == \"01\"  then 'last_year' else 'current_year'  end as 'm2_year',case when 'current_month' == \"01\" || 'current_month' == \"02\" then'last_year' else 'current_year'  end  as 'm3_year',case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" then 'last_year' else 'current_year'   end as 'm4_year', case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\" || 'current_month' == \"04\" then 'last_year' else 'current_year'   end  as 'm5_year' ,case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  || 'current_month' == \"04\" || 'current_month' == \"05\" then 'last_year' else 'current_year'  end as 'm6_year', case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  || 'current_month' == \"04\"  || 'current_month' == \"05\" || 'current_month' == \"06\" then 'last_year' else 'current_year'   end as 'm7_year' ,case when 'current_month' == \"01\" || 'current_month' == \"02\"  || 'current_month' == \"03\"  || 'current_month' == \"04\" || 'current_month' == \"05\"  || 'current_month' == \"06\" || 'current_month' == \"07\" then 'last_year' else 'current_year'  end as 'm8_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\"  || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\" || 'current_month' == \"07\" || 'current_month' == \"08\" then 'last_year' else 'current_year' end as 'm9_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\"  || 'current_month' == \"07\" || 'current_month' == \"08\"  || 'current_month' == \"09\" then 'last_year' else 'current_year'   end  as 'm10_year',case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\"  || 'current_month' == \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"  || 'current_month' == \"10\" then 'last_year' else 'current_year' end  as 'm11_year', case when 'current_month' == \"01\" || 'current_month' == \"02\" || 'current_month' == \"03\" || 'current_month' == \"04\"  || 'current_month' == \"05\"  || 'current_month' == \"06\"  || 'current_month' == \"07\" || 'current_month' == \"08\" || 'current_month' == \"09\"  || 'current_month' == \"10\"  || 'current_month' == \"11\" then 'last_year' else 'current_year' end as 'm12_year'\n,case when  'current_month' ==  \"01\" then \"12\"\nwhen  'current_month' ==  \"02\" then \"01\"\nwhen  'current_month' ==  \"03\" then \"02\"\nwhen  'current_month' ==  \"04\" then \"03\"\nwhen  'current_month' ==  \"05\" then \"04\" \nwhen  'current_month' ==  \"06\" then \"05\"\nwhen  'current_month' ==  \"07\" then \"06\"\nwhen  'current_month' ==  \"08\" then \"07\"\nwhen  'current_month' ==  \"09\" then \"08\"\nwhen  'current_month' ==  \"10\" then \"09\"\nwhen  'current_month' ==  \"11\" then \"10\"\nwhen  'current_month' ==  \"12\" then \"11\"end as 'last_m'\n,case when  'current_month' ==  \"01\" then \"11\"\nwhen  'current_month' ==  \"02\" then \"12\"\nwhen  'current_month' ==  \"03\" then \"01\"\nwhen  'current_month' ==  \"04\" then \"02\"\nwhen  'current_month' ==  \"05\" then \"03\" \nwhen  'current_month' ==  \"06\" then \"04\"\nwhen  'current_month' ==  \"07\" then \"05\"\nwhen  'current_month' ==  \"08\" then \"06\"\nwhen  'current_month' ==  \"09\" then \"07\"\nwhen  'current_month' ==  \"10\" then \"08\"\nwhen  'current_month' ==  \"11\" then \"09\"\nwhen  'current_month' ==  \"12\" then \"10\"end as 'last2_m'\n,case when  'current_month' ==  \"01\" then \"10\"\nwhen  'current_month' ==  \"02\" then \"11\"\nwhen  'current_month' ==  \"03\" then \"12\"\nwhen  'current_month' ==  \"04\" then \"01\"\nwhen  'current_month' ==  \"05\" then \"02\" \nwhen  'current_month' ==  \"06\" then \"03\"\nwhen  'current_month' ==  \"07\" then \"04\"\nwhen  'current_month' ==  \"08\" then \"05\"\nwhen  'current_month' ==  \"09\" then \"06\"\nwhen  'current_month' ==  \"10\" then \"07\"\nwhen  'current_month' ==  \"11\" then \"08\"\nwhen  'current_month' ==  \"12\" then \"09\"end as 'last3_m'\n,case when  'current_month' ==  \"01\" then \"09\"\nwhen  'current_month' ==  \"02\" then \"10\"\nwhen  'current_month' ==  \"03\" then \"11\"\nwhen  'current_month' ==  \"04\" then \"12\"\nwhen  'current_month' ==  \"05\" then \"01\" \nwhen  'current_month' ==  \"06\" then \"02\"\nwhen  'current_month' ==  \"07\" then \"03\"\nwhen  'current_month' ==  \"08\" then \"04\"\nwhen  'current_month' ==  \"09\" then \"05\"\nwhen  'current_month' ==  \"10\" then \"06\"\nwhen  'current_month' ==  \"11\" then \"07\"\nwhen  'current_month' ==  \"12\" then \"08\"end as 'last4_m'\n\n,case when  'current_month' ==  \"01\" then \"08\"\nwhen  'current_month' ==  \"02\" then \"09\"\nwhen  'current_month' ==  \"03\" then \"10\"\nwhen  'current_month' ==  \"04\" then \"11\"\nwhen  'current_month' ==  \"05\" then \"12\" \nwhen  'current_month' ==  \"06\" then \"01\"\nwhen  'current_month' ==  \"07\" then \"02\"\nwhen  'current_month' ==  \"08\" then \"03\"\nwhen  'current_month' ==  \"09\" then \"04\"\nwhen  'current_month' ==  \"10\" then \"05\"\nwhen  'current_month' ==  \"11\" then \"06\"\nwhen  'current_month' ==  \"12\" then \"07\"end as 'last5_m'\n,case when  'current_month' ==  \"01\" then \"07\"\nwhen  'current_month' ==  \"02\" then \"08\"\nwhen  'current_month' ==  \"03\" then \"09\"\nwhen  'current_month' ==  \"04\" then \"10\"\nwhen  'current_month' ==  \"05\" then \"11\" \nwhen  'current_month' ==  \"06\" then \"12\"\nwhen  'current_month' ==  \"07\" then \"01\"\nwhen  'current_month' ==  \"08\" then \"02\"\nwhen  'current_month' ==  \"09\" then \"03\"\nwhen  'current_month' ==  \"10\" then \"04\"\nwhen  'current_month' ==  \"11\" then \"05\"\nwhen  'current_month' ==  \"12\" then \"06\"end as 'last6_m'\n,case when  'current_month' ==  \"01\" then \"06\"\nwhen  'current_month' ==  \"02\" then \"07\"\nwhen  'current_month' ==  \"03\" then \"08\"\nwhen  'current_month' ==  \"04\" then \"09\"\nwhen  'current_month' ==  \"05\" then \"10\" \nwhen  'current_month' ==  \"06\" then \"11\"\nwhen  'current_month' ==  \"07\" then \"12\"\nwhen  'current_month' ==  \"08\" then \"01\"\nwhen  'current_month' ==  \"09\" then \"02\"\nwhen  'current_month' ==  \"10\" then \"03\"\nwhen  'current_month' ==  \"11\" then \"04\"\nwhen  'current_month' ==  \"12\" then \"05\"end as 'last7_m'\n,case when  'current_month' ==  \"01\" then \"05\"\nwhen  'current_month' ==  \"02\" then \"06\"\nwhen  'current_month' ==  \"03\" then \"07\"\nwhen  'current_month' ==  \"04\" then \"08\"\nwhen  'current_month' ==  \"05\" then \"09\" \nwhen  'current_month' ==  \"06\" then \"10\"\nwhen  'current_month' ==  \"07\" then \"11\"\nwhen  'current_month' ==  \"08\" then \"12\"\nwhen  'current_month' ==  \"09\" then \"01\"\nwhen  'current_month' ==  \"10\" then \"02\"\nwhen  'current_month' ==  \"11\" then \"03\"\nwhen  'current_month' ==  \"12\" then \"04\"end as 'last8_m'\n\n,case when  'current_month' ==  \"01\" then \"04\"\nwhen  'current_month' ==  \"02\" then \"05\"\nwhen  'current_month' ==  \"03\" then \"06\"\nwhen  'current_month' ==  \"04\" then \"07\"\nwhen  'current_month' ==  \"05\" then \"08\" \nwhen  'current_month' ==  \"06\" then \"09\"\nwhen  'current_month' ==  \"07\" then \"10\"\nwhen  'current_month' ==  \"08\" then \"11\"\nwhen  'current_month' ==  \"09\" then \"12\"\nwhen  'current_month' ==  \"10\" then \"01\"\nwhen  'current_month' ==  \"11\" then \"02\"\nwhen  'current_month' ==  \"12\" then \"03\"end as 'last9_m'\n,case when  'current_month' ==  \"01\" then \"03\"\nwhen  'current_month' ==  \"02\" then \"04\"\nwhen  'current_month' ==  \"03\" then \"05\"\nwhen  'current_month' ==  \"04\" then \"06\"\nwhen  'current_month' ==  \"05\" then \"07\" \nwhen  'current_month' ==  \"06\" then \"08\"\nwhen  'current_month' ==  \"07\" then \"09\"\nwhen  'current_month' ==  \"08\" then \"10\"\nwhen  'current_month' ==  \"09\" then \"11\"\nwhen  'current_month' ==  \"10\" then \"12\"\nwhen  'current_month' ==  \"11\" then \"01\"\nwhen  'current_month' ==  \"12\" then \"02\"end as 'last10_m'\n,case when  'current_month' ==  \"01\" then \"02\"\nwhen  'current_month' ==  \"02\" then \"03\"\nwhen  'current_month' ==  \"03\" then \"04\"\nwhen  'current_month' ==  \"04\" then \"05\"\nwhen  'current_month' ==  \"05\" then \"06\" \nwhen  'current_month' ==  \"06\" then \"07\"\nwhen  'current_month' ==  \"07\" then \"08\"\nwhen  'current_month' ==  \"08\" then \"09\"\nwhen  'current_month' ==  \"09\" then \"10\"\nwhen  'current_month' ==  \"10\" then \"11\"\nwhen  'current_month' ==  \"11\" then \"12\"\nwhen  'current_month' ==  \"12\" then \"01\"end as 'last11_m';\n\nmonth1 = foreach months generate  'Manager_nm', 'current_year'  as 'Snapshot_Date_Year', 'current_month' as 'Snapshot_Date_Month' ;\nmonth2 = foreach months generate  'Manager_nm', 'm2_year' as 'Snapshot_Date_Year', 'last_m' as 'Snapshot_Date_Month' ;\nmonth3 = foreach months generate  'Manager_nm', 'm3_year' as 'Snapshot_Date_Year','last2_m' as 'Snapshot_Date_Month' ;\nmonth4 = foreach months generate  'Manager_nm', 'm4_year' as 'Snapshot_Date_Year','last3_m' as 'Snapshot_Date_Month' ;\nmonth5 = foreach months generate  'Manager_nm', 'm5_year' as 'Snapshot_Date_Year','last4_m' as 'Snapshot_Date_Month' ;\nmonth6 = foreach months generate  'Manager_nm', 'm6_year' as 'Snapshot_Date_Year','last5_m'  as 'Snapshot_Date_Month' ;\nmonth7 = foreach months generate  'Manager_nm', 'm7_year' as 'Snapshot_Date_Year','last6_m'  as 'Snapshot_Date_Month' ;\nmonth8 = foreach months generate  'Manager_nm', 'm8_year' as'Snapshot_Date_Year','last7_m' as 'Snapshot_Date_Month' ;\nmonth9 = foreach months generate  'Manager_nm', 'm9_year' as'Snapshot_Date_Year','last8_m' as 'Snapshot_Date_Month' ;\nmonth10= foreach months generate  'Manager_nm', 'm10_year' as 'Snapshot_Date_Year','last9_m' as 'Snapshot_Date_Month' ;\nmonth11 = foreach months generate 'Manager_nm', 'm11_year' as 'Snapshot_Date_Year','last10_m' as 'Snapshot_Date_Month' ;\nmonth12= foreach months generate  'Manager_nm', 'm12_year' as  'Snapshot_Date_Year','last11_m' as 'Snapshot_Date_Month' ;\nmonths = union month1,month2,month3,month4,month5,month6,month7,month8,month9,month10,month11,month12;\nmonths = group months by ('Manager_nm','Snapshot_Date_Year','Snapshot_Date_Month');\nmonths = foreach months generate  'Manager_nm','Snapshot_Date_Year','Snapshot_Date_Month' ;\n\n\n\n--Update last 30 days\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by  'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\");\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day')  in [\"current quarter\"..\"current quarter\"];\nq_UpOpp_Month_SnapshotQ = group q_UpOpp_Month_Snapshot by ('Snapshot_Date_Year', 'Snapshot_Date_Month');\nq_UpOpp_Month_SnapshotQ = foreach q_UpOpp_Month_SnapshotQ generate \n     unique('OPPORTUNITYID') as 'OpptyId_Qrt', 0 as 'OpptyId_Mth','Snapshot_Date_Year','Snapshot_Date_Month';\n\nq_UpOpp_Month_SnapshotM = filter q_UpOpp_Month_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"1 month ago\"..\"1 month ago\"];\nq_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Snapshot_Date_Year', 'Snapshot_Date_Month');\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate \n     0 as 'OpptyId_Qrt', unique('OPPORTUNITYID') as 'OpptyId_Mth','Snapshot_Date_Year','Snapshot_Date_Month';\n\nq_Metric = union q_UpOpp_Month_SnapshotQ,q_UpOpp_Month_SnapshotM;\nq_Metric = group q_Metric by  ('Snapshot_Date_Year', 'Snapshot_Date_Month');\nq_Metric = foreach q_Metric generate \ncoalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" )  as 'Manager_nm'\n,coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\")  as 'Manager_wwid'\n,\"% total of current opptys updated last month\" as 'Metric Name'\n,max('OpptyId_Qrt') as 'OpptyId_Qrt'\n,max( 'OpptyId_Mth') as  'OpptyId_Mth'\n,max( 'OpptyId_Mth')/max('OpptyId_Qrt') as 'Snapshot'\n,'Snapshot_Date_Year'\n, 'Snapshot_Date_Month';\n\n\n-- Group and calculate final metrics\nq_UpOpp_Month_SnapshotM = union q_Metric,months;\n\nq_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Snapshot_Date_Year','Snapshot_Date_Month', 'Manager_nm');\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate \n    'Manager_nm',\n    case when 'Snapshot_Date_Year' is null then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") + 'Snapshot_Date_Month' else 'Snapshot_Date_Year' + \"-\" + 'Snapshot_Date_Month' end as 'Month',\n    case when max('Snapshot') is null then null else max('Snapshot') end as 'Snapshot',\n    null as 'Actual';\n\nq_UpOpp= load \"UpdatesMetric\";\n--q_UpOpp= filter q_UpOpp by  'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) ;--\"!{User.Id}\" ;\nq_UpOpp= filter q_UpOpp by date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"];\n\n--Update last 30 days\nq_UpOppM = foreach q_UpOpp generate case when 'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'OPPORTUNITYID' end as 'OpptyId_Qrt', case when date('LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day') in [\"current month\"..\"current day\"] &&  'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) then 'OPPORTUNITYID' end as 'OpptyId_Mth';\nq_UpOppM = group q_UpOppM by all;\nq_UpOppM = foreach q_UpOppM generate  coalesce({{cell(lens_2.selection, 0, \"Manager_nm\").asString()}}, \"!{User.Name}\" ) as 'Manager_nm',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  as 'Manager_wwid'\n, \"% total of current opptys updated last month\" as 'Metric Name'\n,date_to_string(now(), \"yyyy-MM\") as 'Month'\n,case when  unique('OpptyId_Mth') is null && unique('OpptyId_Qrt') is null then null when unique('OpptyId_Qrt') == 0 then 0 else unique('OpptyId_Mth')/unique('OpptyId_Qrt') end as 'Actual'\n,null as 'Snapshot';\n\nq_UpOpp_Month_SnapshotM = union q_UpOpp_Month_SnapshotM,q_UpOppM;\n\nq_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Month', 'Manager_nm');\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate \n    'Manager_nm',\n     'Month'\n     ,case   when date_to_string(now(), \"yyyy-MM\") == 'Month'  then max('Actual') when max('Snapshot') is null then null else max('Snapshot') end as 'Metric_n'\n     ,case when date_to_string(now(), \"yyyy-MM\") == 'Month'  then  number_to_string( max('Actual') ,\"#%\") when max('Snapshot') is null then \"NA\" when max('Snapshot') == 0 || max('Actual') == 0 then \"0%\"  else   number_to_string(max('Snapshot'),\"#%\")  end as 'Metric';\n\n\n\n--q_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Month', 'Manager_nm');\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate \n    'Manager_nm',\n     'Month'\n    ,case when 'Metric' is null then \"NA\" when 'Metric' == \"%\"  then \"0%\" else 'Metric' end as 'Metric'\n    ,case when (sum('Metric_n') < 0.399)  then \"#FFFFFF\"\n         when (sum('Metric_n') > 0.399 && sum('Metric_n') < 0.799) then \"#000000\"\n         when (sum('Metric_n') >= 0.799) then \"#000000\" end as 'text_color',\n    case when (sum('Metric_n') < 0.399) then \"#c81326\"\n         when (sum('Metric_n') > 0.399 && sum('Metric_n') < 0.799) then \"#ffe500\"\n         when (sum('Metric_n') >= 0.799) then \"#9fd541\" end as 'color';\n         \n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager_nm","Month","Metric"],"customBulkActions":[],"fixedColumnWidth":87,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_9":{"broadcastFacet":true,"groups":[],"label":"lens_9","numbers":[],"query":"q_managers = load \"ManagerUsers\";\nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_managers_snapshot1 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" \n || (string_to_number((date_to_string(now(), \"yyyy\")))) > 1 then date_to_string(now(), \"yyyy\") end  as 'Snapshot_Date_Year',\"01\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot2 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"02\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot3 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"03\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot4 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"04\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot5 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"05\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot6 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"06\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot7 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"07\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot8 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"08\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot9= foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"09\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot10= foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"10\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot11 = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"11\" as 'Snapshot_Date_Month' ;\nq_managers_snapshot12= foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt',case when date_to_string(now(), \"MM\") == \"01\" || date_to_string(now(), \"MM\") == \"02\"  || date_to_string(now(), \"MM\") == \"03\" || date_to_string(now(), \"MM\") == \"04\" || date_to_string(now(), \"MM\") == \"05\" || date_to_string(now(), \"MM\") == \"06\"  || date_to_string(now(), \"MM\") == \"07\" || date_to_string(now(), \"MM\") == \"08\" || date_to_string(now(), \"MM\") == \"09\" || date_to_string(now(), \"MM\") == \"10\" || date_to_string(now(), \"MM\") == \"11\" then number_to_string((string_to_number((date_to_string(now(), \"yyyy\")))) - 1,\"#\") else  date_to_string(now(), \"yyyy\") end as 'Snapshot_Date_Year',\"12\" as 'Snapshot_Date_Month' ;\n\nmonths = union q_managers_snapshot1,q_managers_snapshot2,q_managers_snapshot3,q_managers_snapshot4,q_managers_snapshot5,q_managers_snapshot6,q_managers_snapshot7,q_managers_snapshot8,q_managers_snapshot9,q_managers_snapshot10,q_managers_snapshot11,q_managers_snapshot12;\nmonths = foreach months generate  'Manager_nm','Manager_wwid', 'manager_cnt','Snapshot_Date_Year','Snapshot_Date_Month' ;\n\n--Update last 30 days\nq_UpOpp_Month_Snapshot = load \"SnapshotDS13\";\nq_UpOpp_Month_Snapshot = filter q_UpOpp_Month_Snapshot by date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day') in [\"current quarter\"..\"current quarter\"];\nq_UpOpp_Month_Snapshot= filter q_UpOpp_Month_Snapshot by   'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) ;\n\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_Snapshot generate \"\" as 'Manager_nm',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','OPPORTUNITYID' as 'OpptyId_Qrt', \ncase when date('Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day')  in [\"1 month ago\"..\"1 month ago\"] then 'OPPORTUNITYID' end as 'OpptyId_Mth','Snapshot_Date_Year', 'Snapshot_Date_Month';\nq_UpOpp_Month_SnapshotM = group q_UpOpp_Month_SnapshotM by ('Manager_wwid', 'Manager_nm',\n 'Snapshot_Date_Year','Snapshot_Date_Month');\nq_UpOpp_Month_SnapshotM = foreach q_UpOpp_Month_SnapshotM generate 'Manager_wwid', 'Manager_nm',unique('OpptyId_Mth')/unique('OpptyId_Qrt') as '% total of current opptys updated last month','Snapshot_Date_Year', 'Snapshot_Date_Month'; \n\nq_UpOppM_managers_Snapshot = union q_UpOpp_Month_SnapshotM,months;\nq_UpOppM_managers_Snapshot = group q_UpOppM_managers_Snapshot by ('Manager_wwid','Snapshot_Date_Year','Snapshot_Date_Month');\nq_UpOppM_managers_Snapshot = foreach q_UpOppM_managers_Snapshot generate max('Manager_nm') as 'Manager_nm'\n, \"% total of current opptys updated last month\" as 'Metric Name'\n,0 as 'Actual'\n,case when max('% total of current opptys updated last month') is null then null else max('% total of current opptys updated last month') end  as 'Snapshot'\n,'Snapshot_Date_Year' + \"-\"+ 'Snapshot_Date_Month'as 'Month';  \n\n---Updates Opportunities\nq_UpOpp = load \"UpdatesMetric\";\nq_UpOpp= filter q_UpOpp by  'OWNER_HIERARCHY_TXT' matches coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" ) ;\nq_UpOpp = filter q_UpOpp by date('CLOSE_DT_Year', 'CLOSE_DT_Month', 'CLOSE_DT_Day') in [\"current quarter\"..\"current quarter\"];\n\n\n--Update last 30 days\nq_UpOppM = foreach q_UpOpp generate \"\" as 'Manager_nm',substr('OWNER_HIERARCHY_TXT', index_of('OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','OPPORTUNITYID' as 'OpptyId_Qrt', case when date('LASTMODIFIED_DT_Year', 'LASTMODIFIED_DT_Month', 'LASTMODIFIED_DT_Day') in [\"current month\"..\"current day\"] then 'OPPORTUNITYID' end as 'OpptyId_Mth';\nq_UpOppM = group q_UpOppM by ('Manager_wwid', 'Manager_nm');\nq_UpOppM = foreach q_UpOppM generate 'Manager_wwid', 'Manager_nm',unique('OpptyId_Mth')/unique('OpptyId_Qrt') as '% total of current opptys updated last month'; \n\nq_UpOppM_managers = union q_UpOppM,months;\nq_UpOppM_managers = group q_UpOppM_managers by ('Manager_wwid');\nq_UpOppM_managers = foreach q_UpOppM_managers generate max('Manager_nm') as 'Manager_nm'\n, \"% total of current opptys updated last month\" as 'Metric Name'\n,date_to_string(now(), \"yyyy-MM\") as 'Month'\n,case when max('% total of current opptys updated last month') is null then null else max('% total of current opptys updated last month') end as 'Actual'\n,0 as 'Snapshot';  \n\nq_UpOppM_managers_Snapshot = union q_UpOppM_managers,q_UpOppM_managers_Snapshot;\nq_UpOppM_managers_Snapshot = group q_UpOppM_managers_Snapshot by (Manager_nm, 'Month');\n\nq_UpOppM_managers_Snapshot = filter q_UpOppM_managers_Snapshot by 'Manager_nm' != \"\" && 'Manager_nm' != \"Maria Fernanda Alvarado Vargas\" ;\nq_UpOppM_managers_Snapshot = group q_UpOppM_managers_Snapshot by ( 'Manager_nm','Month');\nq_UpOppM_managers_Snapshot = foreach q_UpOppM_managers_Snapshot generate  'Manager_nm' \n,'Month'\n,case   when date_to_string(now(), \"yyyy-MM\") == 'Month'  then max('Actual') when max('Snapshot') is null then null else max('Snapshot') end as 'Metric_n'\n,case when date_to_string(now(), \"yyyy-MM\") == 'Month'  then  number_to_string( max('Actual') ,\"#%\") when max('Snapshot') is null then \"NA\"  else   number_to_string(max('Snapshot'),\"#%\")  end as 'Metric';\n\n--q_UpOppM_managers_Snapshot = group q_UpOppM_managers_Snapshot by ( 'Manager_nm','Month');\nq_UpOppM_managers_Snapshot = foreach q_UpOppM_managers_Snapshot generate  'Manager_nm' as 'Manager Name'\n,'Month'\n, case when 'Metric' is null then \"NA\" when 'Metric' == \"%\" then \"0%\" else 'Metric' end as 'Metric'\n,case when (sum('Metric_n') < 0.399)  then \"#FFFFFF\"\n         when (sum('Metric_n') > 0.399 && sum('Metric_n') < 0.799) then \"#000000\"\n         when (sum('Metric_n') >= 0.799) then \"#000000\" end as 'text_color'\n, case when ( sum('Metric_n') < 0.399 ) then \"#c81326\"\n    when ( sum('Metric_n')> 0.399 && sum('Metric_n') < 0.799 ) then \"#ffe500\" \n    when ( sum('Metric_n')>= 0.799 ) then \"#9fd541\" end as 'color';\nq_UpOppM_managers_Snapshot = order q_UpOppM_managers_Snapshot by 'Month' asc;\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Manager Name","Month","Metric"],"customBulkActions":[],"fixedColumnWidth":86,"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":true,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fixed","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"lens_7":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q_managers = load \"ManagerUsers\";\nForecast_Snapshot_with_Transforms_Secured = load \"Forecast_Snapshot_with_Transforms_Secured\";\n\n\nq_managers= filter q_managers by 'MANAGER_ID' == coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" );\nq_managers = foreach q_managers generate 'USER_NM' as 'Manager_nm','USER_ID' as 'Manager_wwid',0 as 'manager_cnt'; \n\n\nq_confidence = load \"ManagerConfidenceMetrict\";\nq_confidence= filter q_confidence by 'User.Id' ==  \"$User.Id\" ||  'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches \"!{User.Id}\" || 'User.MetricsOpe.ID'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID2'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID3'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID4'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID5'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID6'  matches \"!{User.Id}\" || 'User.MetricsOpe.ID7'  matches \"!{User.Id}\";\n\nq_confidence = filter q_confidence by 'Core_Opportunity_Coverage_Nm__c' == \"Intel-Led Opportunity\";\nq_confidence= filter q_confidence by  'DIM_MANAGE.OWNER_HIERARCHY_TXT' matches  coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\" )  ;\nq_confidence = filter q_confidence by 'Confidence.op.Core_Status__c' not in  [\"Cancelled\",\"Lost\"];\nq_confidence = filter q_confidence by (date('Confidence.op.Core_KPI_Date__c_Year', 'Confidence.op.Core_KPI_Date__c_Month', 'Confidence.op.Core_KPI_Date__c_Day') in [\"3 quarters ago\"..\"current quarter\"] or  date('Confidence.CloseDate_Year', 'Confidence.CloseDate_Month', 'Confidence.CloseDate_Day')  in [\"3 quarters ago\"..\"current quarter\"] );\n\nq_confidence = foreach q_confidence generate \"\" as 'Manager_nm',substr('DIM_MANAGE.OWNER_HIERARCHY_TXT', index_of('DIM_MANAGE.OWNER_HIERARCHY_TXT',coalesce({{cell(lens_2.selection, 0, \"Manager_id\").asString()}}, \"!{User.Id}\"))-19,18) as 'Manager_wwid','Confidence.OpportunityProducts.Name' as 'Confidence.op.Name',  'Confidence.Name' as 'Name',  'Confidence.Id' ,  'Confidence.OpportunityProducts.Product2Id' as 'Confidence.OpportunityProducts.Product2Id', 'Confidence.unhealthy';\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm','Confidence.Id' , 'Confidence.unhealthy');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm','Confidence.Id'  , max('Confidence.unhealthy') as 'unhealthy_total' ;\nq_confidence = group q_confidence by ('Manager_wwid', 'Manager_nm');\nq_confidence = foreach q_confidence generate 'Manager_wwid', 'Manager_nm',(1- (sum('unhealthy_total') / count()) )  as 'Confidence score';\n\nq_confidence_managers = union q_confidence,q_managers;\nq_confidence_managers = group q_confidence_managers by ('Manager_wwid');\nq_confidence_managers = foreach q_confidence_managers generate max('Manager_nm') as 'Manager_nm'\n, \"Confidence Score\" as 'Metric Name'\n,case when max('Confidence score') is null then 0 else max('Confidence score') end as 'Actual'\n,0 as 'Snapshot'; ","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":f