x","color":"#54698d"},"insert":"Data as of [LatestDate]"},{"attributes":{"align":"right"},"insert":"\n"}],"values":{"LatestDate":{"field":"LatestDate","sourceType":"result","step":"LatestDate_1"}}},"interactions":[],"showActionMenu":true},"type":"text"},"container_13":{"parameters":{"alignmentX":"left","alignmentY":"top","fit":"original","interactions":[]},"type":"container"},"text_14":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"Popular Page Components & Functions"},{"attributes":{"align":"center"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_13":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"12px","color":"#e6ecf2"},"insert":"This is the distribution of page views by app. In this case, \"app\" is the Salesforce app that a user selects from the app-selector icon (9 dots) on the top-left of the Salesforce UI.  This view is important to understand if users are defaulting to standard apps that may not have the rich, customised view that you've built for them."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"number_19":{"parameters":{"compact":false,"exploreLink":true,"interactions":[],"measureField":"E","numberBold":false,"numberColor":"#FFFFFF","numberItalic":false,"numberSize":24,"showActionMenu":true,"step":"RecordStats_1","textAlignment":"left","title":"","titleBold":false,"titleColor":"#FFFFFF","titleItalic":false,"titleSize":16,"tooltip":{"customizeTooltip":false,"showTitleTooltip":true}},"type":"number"},"text_16":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"12px","color":"#e6ecf2"},"insert":"The vast majority of users will perform the same interactions on every page. On Cases, they will view the case feed, click on specific notes to read the details, or add new notes to the case. Components like FeedPosts and FeedTabTitle makes sense."},{"attributes":{"align":"left"},"insert":"\n"},{"attributes":{"size":"12px","color":"#e6ecf2"},"insert":"Any component that is high on the list suggests that it is useful to users, and so it should be positioned more prominently on the page."},{"attributes":{"align":"left"},"insert":"\n"},{"attributes":{"size":"12px","color":"#e6ecf2"},"insert":"However, if users are interacting with components too frequently or unnecessarily, it suggests additional training or coaching is needed."},{"attributes":{"align":"left"},"insert":"\n"},{"attributes":{"size":"12px","color":"#e6ecf2"},"insert":"Click on the chart headers (Clicks, Related Cases, Clicks Per Case) to change the sorting."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"number_18":{"parameters":{"compact":false,"exploreLink":true,"interactions":[],"measureField":"E","numberBold":false,"numberColor":"#FFFFFF","numberItalic":false,"numberSize":10,"showActionMenu":false,"step":"UniqueClicksTrending_1","textAlignment":"left","title":"30DayΔ","titleBold":false,"titleColor":"#FFFFFF","titleItalic":false,"titleSize":10,"tooltip":{"customizeTooltip":false,"showTitleTooltip":true}},"type":"number"},"text_15":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"12px","color":"#cd96ff"},"insert":"Want to know more about what each component is? Visit the:"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"number_17":{"parameters":{"compact":false,"exploreLink":true,"interactions":[],"measureField":"B","numberBold":false,"numberColor":"#FFFFFF","numberItalic":false,"numberSize":10,"showActionMenu":false,"step":"UniqueClicksTrending_1","textAlignment":"left","title":"Daily Δ","titleBold":false,"titleColor":"#FFFFFF","titleItalic":false,"titleSize":10,"tooltip":{"customizeTooltip":false,"showTitleTooltip":true}},"type":"number"},"text_10":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"inse