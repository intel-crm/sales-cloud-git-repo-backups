          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA20_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA19_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "LiveAgentUser",
          "label" : "LiveAgentUser",
          "formulaExpression" : "case \r\n    when UserPermissionsLiveAgentUser = true\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA21_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA20_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "OfflineUser",
          "label" : "Offline User",
          "formulaExpression" : "case \r\n    when UserPermissionsOfflineUser= true\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA22_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA21_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "SFContentUser",
          "label" : "SFContentUser",
          "formulaExpression" : "case \r\n    when UserPermissionsSFContentUser = true\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA23_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA22_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "SupportUser",
          "label" : "SupportUser",
          "formulaExpression" : "case \r\n    when UserPermissionsSupportUser = true\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA24_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA74" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Days_0_30",
          "label" : "0-30 Days",
          "formulaExpression" : "case \r\n    when  LastLoginDate_formula >= 0  and  LastLoginDate_formula < 31 and \"UserLogin.IsFrozen\" = false and IsActive = true and Formula_Last_Login_Date != 'null'\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA25_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA24_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Days_31_60",
          "label" : "31-60 Days",
          "formulaExpression" : "case \r\n    when  LastLoginDate_formula > 30  and  LastLoginDate_formula < 61 and \"UserLogin.IsFrozen\" = false and IsActive = true\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA26_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA25_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Days_61_90",
          "label" : "61-90 Days",
          "formulaExpression" : "case \r\n    when  LastLoginDate_formula > 60  and  LastLoginDate_formula < 91 and \"UserLogin.IsFrozen\" = false and IsActive = true\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA27_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA26_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Days_91_180",
          "label" : "91-180 Days",
          "formulaExpression" : "case \r\n    when  LastLoginDate_formula > 90  and  LastLoginDate_formula < 181 and \"UserLogin.IsFrozen\" = false and IsActive = true\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA28_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA27_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "NeverLogin",
          "label" : "Never Login",
          "formulaExpression" : "case \r\n    when  LastLoginDate_formula = 0 and  datediff(now(), CreatedDate)>30\r\n    and \"UserLogin.IsFrozen\" = false and IsActive = true and Formula_Last_Login_Date = 'null'\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA29_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA28_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "userCreatedInLast30DaysAndNeverLogin",
          "label" : "User Created in last 30 days and never login",
          "formulaExpression" : "case \r\n    when  LastLoginDate_formula = 0 and  datediff(now(), CreatedDate)<31 and \"UserLogin.IsFrozen\" = false and IsActive = true and Formula_Last_Login_Date = 'null'\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA30_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA29_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "FrozenUser",
          "label" : "Frozen User",
          "formulaExpression" : "case \r\n    when \"UserLogin.IsFrozen\" = true and IsActive = true\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA31_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA30_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "GreaterThan180Days",
          "label" : "Greater than 180 Days",
          "formulaExpression" : "case \r\n    when  LastLoginDate_formula > 180 and \"UserLogin.IsFrozen\" = false and IsActive = true\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA34_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA31_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "UserCategory",
          "label" : "User Category",
          "formulaExpression" : "case \r\n    when LastLoginDate_formula >= 0 and LastLoginDate_formula < 31 and \"UserLogin.IsFrozen\" = false and IsActive = true and Formula_Last_Login_Date != 'null'\r\n    then '0-30 Days' \r\n    when  LastLoginDate_formula > 30 and LastLoginDate_formula < 61 and \"UserLogin.IsFrozen\" = false and IsActive = true\r\n    then '31-60 Days' \r\n    when  LastLoginDate_formula > 60 and LastLoginDate_formula < 91 and \"UserLogin.IsFrozen\" = false and IsActive = true\r\n    then '61-90 Days' \r\n    when LastLoginDate_formula > 90 and LastLoginDate_formula < 181 and \"UserLogin.IsFrozen\" = false and IsActive = true\r\n    then '91-180 Days' \r\n     when  LastLoginDate_formula = 0 and  datediff(now(), CreatedDate)>30\r\n    and \"UserLogin.IsFrozen\" = false and IsActive = true and Formula_Last_Login_Date = 'null'\r\n    then 'Never logged in and user not created in last 30 days'\r\n     when  LastLoginDate_formula = 0 and  datediff(now(), CreatedDate)<31 and IsActive = true\r\n    and \"UserLogin.IsFrozen\" = false and Formula_Last_Login_Date = 'null'\r\n    then 'User created in last 30 days and never login'\r\n    when \"UserLogin.IsFrozen\" = true and IsActive = true\r\n    then 'Frozen User'\r\n    when  LastLoginDate_formula> 180  and \"UserLogin.IsFrozen\" = false and IsActive = true\r\n    then 'Potential Licenses that can be repurposed- Users not logged in last 180 days (excluding frozen,never login and recently created user)'\r\nend\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA68" : {
      "action" : "formula",
      "sources" : [ "FORMULA16_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "FeatureLicense",
          "label" : "Feature License",
          "formulaExpression" : "case \r\n    when UserPermissionsMarketingUser= true \r\n    then  'Marketing User'\r\n    when UserPermissionsOfflineUser= true \r\n    then 'Offline User'\r\n    when UserPermissionsSFContentUser= true \r\n    then  'Salesforce CRM Content User'\r\n    when UserPermissionsKnowledgeUser= true \r\n    then 'Knowledge User'\r\n    when UserPermissionsInteractionUser= true \r\n    then 'Flow User'\r\n    when UserPermissionsSupportUser= true \r\n    then 'Service Cloud User'\r\n    when UserPermissionsLiveAgentUser= true \r\n    then 'Chat User'\r\n     when UserPermissionsChatterAnswersUser= true \r\n    then 'Chatter Answers User'\r\n\r\nend ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA74" : {
      "action" : "formula",
      "sources" : [ "FORMULA18_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Formula_Last_Login_Date",
          "label" : "Last Login Date",
          "formulaExpression" : "case \r\n    when LastLoginDate is null\r\n    then 'null'   \r\n    else LastLoginDate  \r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "OUTPUT5" : {
      "action" : "save",
      "sources" : [ "FORMULA34_copy0" ],
      "parameters" : {
        "fields" : [ ],
        "dataset" : {
          "type" : "analyticsDataset",
          "label" : "DP_Feature_License_User_details_dataset",
          "name" : "FeatureLicenseUser_details",
          "folderName" : "UIOLI_License"
        },
        "measuresToCurrencies" : [ ]
      }
    }
  },
