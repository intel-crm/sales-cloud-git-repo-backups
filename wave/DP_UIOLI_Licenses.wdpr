    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "LOAD_DATASET0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Available_Licenses",
          "label" : "Available Licenses",
          "formulaExpression" : "case \r\n    when AllowedLicenses = -1\r\n    then 'NA'\r\n    else\r\n    AllowedLicenses - UsedLicenses\r\nend\r\n\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "JOIN0" : {
      "action" : "join",
      "sources" : [ "LOAD_DATASET1", "FORMULA0" ],
      "schema" : {
        "fields" : [ ],
