          "formulaExpression" : "case \r\n    when  \"UserPackageWithUser.InActive_Days\" >= 0  and \"UserPackageWithUser.InActive_Days\" < 31 and \"UserLogin.IsFrozen\" = false  and Formula_Last_Login_Date != 'null'\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
