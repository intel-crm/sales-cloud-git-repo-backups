          "mode" : "DROP",
          "ignoreMissingFields" : true,
          "fields" : [ ]
        }
      },
      "parameters" : {
        "joinType" : "LOOKUP",
        "leftKeys" : [ "PackageLicenseId" ],
        "rightQualifier" : "Transform0",
        "rightKeys" : [ "Id" ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA76" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Days_31_60",
          "label" : "31-60 Days",
          "formulaExpression" : "case \r\n    when  \"UserPackageWithUser.InActive_Days\" > 30  and \"UserPackageWithUser.InActive_Days\" < 61 and \"UserLogin.IsFrozen\" = false \r\n    then 1\r\nend\r\n",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Days_61_90",
          "label" : "61-90 Days",
          "formulaExpression" : "case \r\n    when  \"UserPackageWithUser.InActive_Days\" > 60  and \"UserPackageWithUser.InActive_Days\" < 91 and \"UserLogin.IsFrozen\" = false \r\n    then 1\r\nend\r\n",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Days_91_180",
          "label" : "91-180 Days",
          "formulaExpression" : "case \r\n    when  \"UserPackageWithUser.InActive_Days\" > 90  and \"UserPackageWithUser.InActive_Days\" < 181 and \"UserLogin.IsFrozen\" = false \r\n    then 1\r\nend\r\n",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Greater_Than_180_Days",
          "label" : "Greater Than 180 Days",
          "formulaExpression" : "case \r\n    when  \"UserPackageWithUser.InActive_Days\" > 180  and \"UserLogin.IsFrozen\" = false \r\n    then 1\r\nend\r\n",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "FORMULA12" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "NeverLogin",
          "label" : "Never Login",
          "formulaExpression" : "\r\ncase \r\n    when  \"UserPackageWithUser.InActive_Days\" = 0 and  datediff(now(), \"UserPackageWithUser.CreatedDate\") > 30 and \"UserLogin.IsFrozen\" = false and Formula_Last_Login_Date = 'null'\r\n    then 1\r\nend\r\n\r\n",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "UserCreatedinLast30DaysandNeverLogin",
          "label" : "User Created in Last 30 Days and Never Login",
          "formulaExpression" : "case \r\n    when  \"UserPackageWithUser.InActive_Days\" = 0  and datediff(now(), \"UserPackageWithUser.CreatedDate\") < 31 and \"UserLogin.IsFrozen\" = false and Formula_Last_Login_Date = 'null'\r\n    then 1\r\nend\r\n",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA10" : {
      "action" : "formula",
      "sources" : [ "FORMULA8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "FrozenUser",
          "label" : "Frozen User",
          "formulaExpression" : "case \r\n    when \"UserLogin.IsFrozen\" = true\r\n    then 1    \r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA11" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "UserCategory",
          "label" : " User Category",
          "formulaExpression" : "case \r\n    when \"UserPackageWithUser.InActive_Days\" >= 0 and \"UserPackageWithUser.InActive_Days\" < 31 and \"UserLogin.IsFrozen\" = false and Formula_Last_Login_Date != 'null'\r\n    then '0-30 Days' \r\n when  \"UserPackageWithUser.InActive_Days\" > 30 and \"UserPackageWithUser.InActive_Days\" < 61 and \"UserLogin.IsFrozen\" = false\r\n    then '31-60 Days' \r\n   when  \"UserPackageWithUser.InActive_Days\" > 60 and \"UserPackageWithUser.InActive_Days\" < 91 and \"UserLogin.IsFrozen\" = false\r\n    then '61-90 Days' \r\n  when \"UserPackageWithUser.InActive_Days\" > 90 and \"UserPackageWithUser.InActive_Days\" < 181 and \"UserLogin.IsFrozen\" = false\r\n    then '91-180 Days' \r\n   when  \"UserPackageWithUser.InActive_Days\" = 0 and  datediff(now(), \"UserPackageWithUser.CreatedDate\") > 30 and \"UserLogin.IsFrozen\" = false and Formula_Last_Login_Date = 'null' \r\n    then 'Never logged in and user not created in last 30 days'\r\n    when  \"UserPackageWithUser.InActive_Days\" = 0 and  datediff(now(), \"UserPackageWithUser.CreatedDate\") < 31 and \"UserLogin.IsFrozen\" = false and Formula_Last_Login_Date = 'null'\r\n    then 'User created in last 30 days and never login' \r\n    when \"UserLogin.IsFrozen\" = true\r\n    then 'Frozen user'\r\n    when  \"UserPackageWithUser.InActive_Days\" > 180  and \"UserLogin.IsFrozen\" = false \r\n    then 'Potential Licenses that can be repurposed'\r\nend\r\n\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA12" : {
      "action" : "formula",
      "sources" : [ "FORMULA11" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "InactiveUsers",
          "label" : "Inactive Users",
          "formulaExpression" : "case \r\n    when \"UserPackageWithUser.IsActive\" = false and \"UserLogin.IsFrozen\" = false \r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA56" : {
      "action" : "formula",
      "sources" : [ "FORMULA71" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "LicensesUsedinLast180Days",
          "label" : "Licenses Used In Last  180 Days",
          "formulaExpression" : "case \r\n    when Days_0_30 = 1 \r\n    then 1\r\n    when Days_31_60 = 1 \r\n    then 1\r\n    when  Days_61_90 = 1\r\n    then 1 \r\n    when Days_91_180 = 1\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA57" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA56" ],
      "parameters" : {
        "partitionBy" : [ "PackageLicense_NamespacePrefix" ],
        "orderBy" : [ {
          "fieldName" : "PackageLicense_NamespacePrefix",
          "direction" : "ASC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "LicensesCanBeReleased",
          "label" : "Licenses Can Be Released",
          "formulaExpression" : "PackageLicense_UsedLicenses - sum(LicensesUsedinLast180Days)-sum(FrozenUser)- sum(UserCreatedinLast30DaysandNeverLogin)-sum(NeverLogin)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "EDIT_ATTRIBUTES2" : {
      "action" : "schema",
      "sources" : [ "FORMULA57" ],
      "parameters" : {
        "fields" : [ {
