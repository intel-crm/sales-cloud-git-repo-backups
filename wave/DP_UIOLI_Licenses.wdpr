          "label" : "Inactive Users",
          "formulaExpression" : "case \r\n    when \"UserPackageWithUser.IsActive\" = false\r\n    then 1    \r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA75" : {
      "action" : "formula",
      "sources" : [ "JOIN2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Formula_Last_Login_Date",
          "label" : "Last Login Date",
          "formulaExpression" : "case \r\n    when \"UserPackageWithUser.LastLoginDate\" is null\r\n    then 'null'   \r\n    else \"UserPackageWithUser.LastLoginDate\"  \r\nend",
