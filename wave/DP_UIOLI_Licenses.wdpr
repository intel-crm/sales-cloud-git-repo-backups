        "fields" : [ {
          "type" : "TEXT",
          "name" : "UserCategory",
          "label" : "User Category",
          "formulaExpression" : "case \r\n    when InactiveDays >= 0 and InactiveDays < 31 and \"UserwithUs.UserLogin.IsFrozen\" = false and \"UserwithUs.IsActive\" = true and Formula_Last_Login_Date != 'null'\r\n    then '0-30 Days' \r\n    when  InactiveDays > 30 and InactiveDays < 61 and \"UserwithUs.UserLogin.IsFrozen\" = false and \"UserwithUs.IsActive\" = true\r\n    then '31-60 Days' \r\n    when  InactiveDays> 60 and InactiveDays < 91 and \"UserwithUs.UserLogin.IsFrozen\" = false\r\n    and \"UserwithUs.IsActive\" = true \r\n    then '61-90 Days' \r\n    when InactiveDays > 90 and InactiveDays < 181 and \"UserwithUs.UserLogin.IsFrozen\" = false\r\n       and \"UserwithUs.IsActive\" = true \r\n then '91-180 Days'\r\n    when  InactiveDays = 0  and datediff(now(), \"UserwithUs.CreatedDate\") >30 and \"UserwithUs.UserLogin.IsFrozen\" = false \r\n       and \"UserwithUs.IsActive\" = true and Formula_Last_Login_Date = 'null'\r\n then 'Never logged in and user not created in last 30 days'\r\n    when  InactiveDays = 0  and datediff(now(), \"UserwithUs.CreatedDate\") < 31 and \"UserwithUs.UserLogin.IsFrozen\" = false \r\n        and \"UserwithUs.IsActive\" = true and Formula_Last_Login_Date = 'null' \r\nthen 'User created in last 30 days and never login'\r\n    when \"UserwithUs.UserLogin.IsFrozen\" = true\r\n        and \"UserwithUs.IsActive\" = true \r\nthen 'Frozen user'\r\n    when  InactiveDays >  180 and \"UserwithUs.UserLogin.IsFrozen\" = false \r\n        and \"UserwithUs.IsActive\" = true \r\n    then 'Potential Licenses that can be repurposed'\r\nend\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
