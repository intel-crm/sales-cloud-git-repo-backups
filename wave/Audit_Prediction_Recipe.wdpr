          "name" : "Core_MDF_Activity_Start_Date__c_formula",
          "label" : "Activity Duration",
          "formulaExpression" : "datediff(Core_MDF_Activity_End_Date__c, Core_MDF_Activity_Start_Date__c)",
          "precision" : 18,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
