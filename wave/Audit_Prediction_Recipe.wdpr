    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Core_MDF_Ad_Run_Start_Date__c_formula",
          "label" : "Ad Run Duration",
          "formulaExpression" : "datediff(Core_MDF_Ad_Run_End_Date__c, Core_MDF_Ad_Run_Start_Date__c)",
          "precision" : 18,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_MDF_AccountCompany__c_formula",
          "label" : "Modified Case Status",
          "formulaExpression" : "case 'Core_MDF_Claim_Review_Case__c.Core_MDF_Review_Case_Status__c'\r\n\twhen 'Compliant'\r\n\tthen \r\ncase Core_MDF_Audit_Adjustment_Amount__c\r\n\twhen 0\r\n\tthen 'Core_MDF_Claim_Review_Case__c.Core_MDF_Review_Case_Status__c'\r\n\telse\r\n\t'Non-compliant'\r\nend\r\n\telse\r\n'Core_MDF_Claim_Review_Case__c.Core_MDF_Review_Case_Status__c'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_MDF_AccountCompany__c_formula1",
          "label" : "Account Bucket",
          "formulaExpression" : "case \r\nCore_MDF_AccountCompany__c\r\n\twhen 'DELL INC.'\r\n\tthen \r\n    'BIG' \r\nelse\r\ncase\r\nCore_MDF_AccountCompany__c\r\n\twhen 'HP INC.'\r\n\tthen \r\n    'BIG' \r\nelse\r\ncase\r\nCore_MDF_AccountCompany__c\r\n\twhen 'Lenovo (Beijing) Limited'\r\n\tthen \r\n    'BIG' \r\n\telse\r\ncase\r\nCore_MDF_AccountCompany__c\r\n\twhen 'ACER INCORPORATED'\r\n\tthen \r\n    'MEDIUM'\r\nelse\r\ncase\r\nCore_MDF_AccountCompany__c\r\n\twhen 'ASUSTEK COMPUTER INCORPORATION'\r\n\tthen \r\n    'MEDIUM'\r\nELSE\r\ncase\r\nCore_MDF_AccountCompany__c\r\n\twhen 'Hewlett Packard Enterprise Company'\r\n\tthen \r\n    'MEDIUM'\r\nelse\r\n'LOW'\r\nEND\r\nend\r\nend\r\nend\r\nend\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_MDF_AccountCompany__c_formula2",
          "label" : "CountryYearKey",
          "formulaExpression" : "concat(Core_MDF_Country_Location_nm__c, substr(Core_MDF_Ad_Run_Start_Date__c, 0, 4))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_MDF_Media_Vehicle__c_formula",
          "label" : "Modified Media Vehicle",
          "formulaExpression" : "case Core_MDF_Media_Vehicle__c\r\n    when coalesce(Core_MDF_Media_Vehicle__c, NULL)\r\n    then Core_MDF_Media_Vehicle__c\r\n    else\r\n    'na'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
