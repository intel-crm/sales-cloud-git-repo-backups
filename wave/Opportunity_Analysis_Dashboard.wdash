{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"valid_todate_year\").asString()}}','{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"valid_todate_month\").asString()}}', 'ValidToDate_Day') in [\"{{cell(Intermediate.result, 0, \"Start_ValidTo\").asString()}}\"..\"{{cell(Intermediate.result, 0, \"End_ValidFrom\").asString()}}\"]; upd_end = filter x1 by date('{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"valid_fromdate_year\").asString()}}','{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"valid_fromdate_month\").asString()}}', 'ValidFromDate_Day') in [\"{{cell(Intermediate.result, 0, \"Start_ValidTo\").asString()}}\"..\"{{cell(Intermediate.result, 0, \"End_ValidFrom\").asString()}}\"]; upd_end = filter upd_end by date('{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"valid_todate_year\").asString()}}','{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"valid_todate_month\").asString()}}', 'ValidToDate_Day') in [\"{{cell(Intermediate.result, 0, \"Update_End_ValidTo\").asString()}}\"..]; upd = group upd_start by OpportunityId right, upd_end by OpportunityId; upd = foreach upd generate upd_end.'OpportunityId' as 'OpportunityId', upd_start.'OpportunityId' is null as 'New', first(upd_start.'Opportunity.Core_Push_Counter__c') as 'Opportunity.Core_Push_Counter__c__cStart',first(upd_start.'Opportunity.WeightedAmount') as 'Opportunity.WeightedAmount_cStart', first(upd_start.'amount_1') as 'amountStart', first(upd_start.'Stage.IsClosed') as 'Stage.IsClosedStart', first(upd_start.'Stage.IsWon') as 'Stage.IsWonStart', first(upd_start.'{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"close_date_epoch\").asString()}}') as 'CloseDateStart', last(upd_end.'Opportunity.WeightedAmount') as 'Opportunity.WeightedAmount_cEnd',last(upd_end.'amount_1') as 'amountEnd',last(upd_end.'Opportunity.Core_Push_Counter__c') as 'Opportunity.Core_Push_Counter__c__cEnd', last(upd_end.'Stage.IsClosed') as 'Stage.IsClosedEnd', last(upd_end.'Stage.IsWon') as 'Stage.IsWonEnd', last(upd_end.'{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"close_date_epoch\").asString()}}') as 'CloseDateEnd',last(upd_end.'Opportunity.Account.AccountName') as 'Opportunity.Account.Name', last(upd_end.'Opportunity.Name') as 'Opportunity.Name', last(upd_end.'Opportunity.Owner.Name') as 'Opportunity.Owner.Name', last(upd_end.'Opportunity.Core_KPI_Date__c') as 'Opportunity.Core_KPI_Date__c',last(upd_end.'Opportunity.CloseDate') as 'Opportunity.CloseDate', last(upd_end.'Opportunity.StageName') as 'Opportunity.StageName'; upd_full_closed = foreach upd generate ( case when ( toDate('CloseDateEnd') in  [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] and 'Stage.IsClosedEnd' == \"true\" and 'Stage.IsWonEnd' == \"false\" ) then \"8_CLOSED_LOST\" when ( toDate('CloseDateEnd') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] and 'Stage.IsClosedEnd' == \"true\" and 'Stage.IsWonEnd' == \"true\" ) then \"5_CLOSED_WON\" else \"OTHER\" end ) as 'Status', 'OpportunityId',  'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c', 'Opportunity.CloseDate', 'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'amountStart', 'amountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_full_closed = filter upd_full_closed by 'Status' != \"OTHER\"; upd_full_closed = foreach upd_full_closed generate 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName',( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'Opportunity.WeightedAmount_cEnd') when \"5_CLOSED_WON\" then (0 - 'Opportunity.WeightedAmount_cEnd') end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'amountEnd') when \"5_CLOSED_WON\" then (0 - 'amountEnd') end ) as 'Amount',( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') when \"5_CLOSED_WON\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') end ) as 'Opportunity.Core_Push_Counter__c'; upd_full_notinperiod = foreach upd generate ( case when ( not 'New' and 'Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] and not(toDate('CloseDateEnd') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}]) ) then \"6_MOVED_OUT\" when ( 'New' and toDate('CloseDateEnd') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}]) then \"1_NEW\" when ( not 'New' and 'Stage.IsClosedStart' == \"true\" and toDate('CloseDateEnd') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] ) then \"2_REOPEN\" when ( not 'New' and toDate('CloseDateEnd') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] and (('Stage.IsClosedStart' == \"false\" and not(toDate('CloseDateStart') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}])) or ('Stage.IsClosedStart' == \"true\")) ) then \"4_MOVED_IN\" else \"OTHER\" end ) as 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate', 'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'amountStart', 'amountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_full_notinperiod = filter upd_full_notinperiod by 'Status' != \"OTHER\"; upd_full_notinperiod = foreach upd_full_notinperiod generate 'Status',( case 'Status' when \"6_MOVED_OUT\" then (0 - 'Opportunity.WeightedAmount_cEnd') when \"1_NEW\" then 'Opportunity.WeightedAmount_cEnd' when \"2_REOPEN\" then 'Opportunity.WeightedAmount_cEnd' when \"4_MOVED_IN\" then 'Opportunity.WeightedAmount_cEnd' end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"6_MOVED_OUT\" then (0 - 'amountEnd') when \"1_NEW\" then 'amountEnd' when \"2_REOPEN\" then 'amountEnd' when \"4_MOVED_IN\" then 'amountEnd' end ) as 'Amount',( case 'Status' when \"6_MOVED_OUT\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') when \"1_NEW\" then 'Opportunity.Core_Push_Counter__c__cEnd' when \"2_REOPEN\" then 'Opportunity.Core_Push_Counter__c__cEnd' when \"4_MOVED_IN\" then 'Opportunity.Core_Push_Counter__c__cEnd' end ) as 'Opportunity.Core_Push_Counter__c', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName'; upd_delta = foreach upd generate ( case when ( not 'New' and 'Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] and 'amountStart' > 'amountEnd') then \"7_REDUCE\" when ( not 'New' and 'Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] and 'amountStart' < 'amountEnd') then \"3_EXPAND\" else \"OTHER\" end ) as 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'amountStart', 'amountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_delta = filter upd_delta by 'Status' != \"OTHER\"; upd_delta = foreach upd_delta generate 'Status',( case 'Status' when \"7_REDUCE\" then 'Opportunity.WeightedAmount_cEnd' - 'Opportunity.WeightedAmount_cStart' when \"3_EXPAND\" then 'Opportunity.WeightedAmount_cEnd' - 'Opportunity.WeightedAmount_cStart' end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"7_REDUCE\" then 'amountEnd' - 'amountStart' when \"3_EXPAND\" then 'amountEnd' - 'amountStart' end ) as 'Amount',( case 'Status' when \"7_REDUCE\" then 'Opportunity.Core_Push_Counter__c__cEnd' - 'Opportunity.Core_Push_Counter__c__cStart' when \"3_EXPAND\" then 'Opportunity.Core_Push_Counter__c__cEnd' - 'Opportunity.Core_Push_Counter__c__cStart' end ) as 'Opportunity.Core_Push_Counter__c', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Opportunity.Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName'; WATERFALL = union upd_full_notinperiod, upd_delta, upd_full_closed; WATERFALL = filter WATERFALL by {{column(waterfall_test_1.selection, [\"Status\"]).asEquality(\"Status\")}}; WATERFALL = group WATERFALL by 'OpportunityId'; WATERFALL = foreach WATERFALL generate last('OpportunityId') as 'OpportunityId', last('Status') as 'Status', last('Opportunity.Account.Name') as 'Opportunity.Account.Name', last('Opportunity.Name') as 'Opportunity.Name', last('Opportunity.Owner.Name') as 'Opportunity Owner', last('Opportunity.Core_KPI_Date__c') as 'KPI Date',last('Opportunity.CloseDate') as 'Opportunity.CloseDate',last('Opportunity.StageName') as 'Opportunity.StageName',(case when last('Opportunity.WeightedAmount') ==0 then \"$0\" else number_to_string(last('Opportunity.WeightedAmount'),\"$#,###\")end) as 'Wtd Amt',abs(last('Opportunity.Core_Push_Counter__c')) as 'Push Counter',abs(last('Opportunity.WeightedAmount')) as 'Wtd Amt_abs';WATERFALL = order WATERFALL by 'Wtd Amt_abs' desc;WATERFALL = limit WATERFALL 200; ","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":["OpportunityId","Status","Opportunity.Account.Name","Opportunity.Name","Opportunity Owner","KPI Date","Opportunity.StageName","Wtd Amt","Push Counter"],"customBulkActions":[],"fixedColumnWidth":100,"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":false},"headerProperties":{},"in