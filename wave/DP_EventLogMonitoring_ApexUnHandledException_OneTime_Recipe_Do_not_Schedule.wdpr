    },
    "FORMULA4_copy0_copy0_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA3_copy0_copy0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "TIMESTAMP_formula1",
          "label" : "TIMESTAMP Formula",
          "formulaExpression" : "substr(TIMESTAMP, 5, 2)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5_copy0_copy0_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA4_copy0_copy0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "TIMESTAMP_formula2",
          "label" : "TIMESTAMP Formula",
          "formulaExpression" : "substr(TIMESTAMP, 7, 2)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6_copy0_copy0_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA5_copy0_copy0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "TimeStamptoDate",
          "label" : "TimeStamptoDate",
          "formulaExpression" : "concat(concat(TIMESTAMP_formula, '-'),\r\nconcat(TIMESTAMP_formula1, '-')\r\n,TIMESTAMP_formula2)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "TO_DATE0_copy0_copy0_copy0" : {
      "action" : "typeCast",
      "sources" : [ "FORMULA6_copy0_copy0_copy0" ],
      "parameters" : {
        "fields" : [ {
          "name" : "TimeStamptoDate",
