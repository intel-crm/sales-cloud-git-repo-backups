    "FORMULA2_copy0_copy0_copy0" : {
      "action" : "formula",
      "sources" : [ "DROP_FIELDS0_copy0_copy0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Project_Info_formula",
          "label" : "Project Info",
          "formulaExpression" : "case\r\n when startsWith(Class_Name, 'epum') then 'A&E'\r\n when startsWith(Class_Name, 'UCD_') then 'UCD'\r\n    when startsWith(Class_Name, 'Core_KPI') then 'Unicorn'\r\n    when startsWith(Class_Name,'Core_Contact') then 'DRACO'\r\n    when startsWith(Class_Name,'Pricing') then 'Gravity'\r\n    when startsWith(Class_Name,'SEL_') then 'Gravity'\r\n    when startsWith(Class_Name,'QuoteBusinessLogic') then 'Gravity'\r\n    when startsWith(Class_Name,'PRM') then 'IPA'\r\n    when startsWith(Class_Name,'Sales_') then 'Concord'\r\n    when startsWith(Class_Name,'PSS') then 'PSS'\r\n    when startsWith(Class_Name,'Core_IPS') then 'Hercules'\r\n    when startsWith(Class_Name,'IPS') then 'Hercules'\r\n    when startsWith(Class_Name,'PSG_') then 'PSG Ventures'\r\n    when startsWith(Class_Name,'PSG') then 'PSG Ventures'\r\n    when startsWith(Class_Name,'Core_PSG') then 'PSG Ventures'\r\n    when startsWith(Class_Name,'Core_MDF') then 'CCP'\r\n    when startsWith(Class_Name,'Core_User') then 'DRACO'\r\n    when startsWith(Class_Name,'Core_Opp') then 'Unicorn'\r\n    when startsWith(Class_Name,'Core_Lead') then 'Unicorn' \r\n    when startsWith(Class_Name,'Core_PartnerLead') then 'Unicorn' \r\n    when startsWith(Class_Name,'Core_Batch_Opportunity') then 'Unicorn' \r\n    when startsWith(Class_Name,'Core_UpdateOptyRiskStatusFromQuote') then 'Unicorn' \r\n    when startsWith(Class_Name,'Core_Solution') then 'Unicorn'\t\r\n    when startsWith(Class_Name,'Core_Batch_DeleteInactiveKP') then 'Unicorn'\r\n    when startsWith(Class_Name,'Core_SA_') then 'Unicorn'\r\n    when startsWith(Class_Name,'PMP') then 'Marketplace'\r\n    when startsWith(Class_Name,'Intel_') then 'Generic'\r\n    when startsWith(Class_Name,'QuoteTrigger') then 'Generic'\r\n    when startsWith(Class_Name,'Queueable') then 'Salesforce CPQ'\r\n    when startsWith(Class_Name,'Product') then 'Salesforce CPQ'\r\n    when startsWith(Class_Name,'Quote') then 'Salesforce CPQ'\r\n    when startsWith(Class_Name,'Core_IQR') then 'IQR-Intel Quote Request'\r\n    when startsWith(Class_Name,'Core_ERPM') then 'ERPM(Quest)'\t\r\n    when startsWith(Class_Name,'Core_Integration') then 'Others'\r\n    when startsWith(Class_Name,'Contact') then 'Others'\t\r\n    when startsWith(Class_Name,'Abstract') then 'Others'\r\n    when startsWith(Class_Name,'Access') then 'Others'\r\n    when startsWith(Class_Name,'Account') then 'Others'\r\n    when startsWith(Class_Name,'Approval') then 'Others'\r\n    when startsWith(Class_Name,'Approve') then 'Others'\r\n    when startsWith(Class_Name,'Asset') then 'Others'\r\n    when startsWith(Class_Name,'Async') then 'Others'\r\n    when startsWith(Class_Name,'ATF') then 'Others'\r\nwhen startsWith(Class_Name,'Attend') then 'Others'\r\nwhen startsWith(Class_Name,'Batch') then 'Others'\r\nwhen startsWith(Class_Name,'BvD') then 'Others'\r\nwhen startsWith(Class_Name,'Calc') then 'Others'\r\nwhen startsWith(Class_Name,'Campaign') then 'Others'\r\nwhen startsWith(Class_Name,'Case') then 'Others'\r\nwhen startsWith(Class_Name,'Coach') then 'Others'\r\nwhen startsWith(Class_Name,'Column') then 'Others'\r\nwhen startsWith(Class_Name,'Comm') then 'Others'\r\nwhen startsWith(Class_Name,'Comp') then 'Others'\r\nwhen startsWith(Class_Name,'Config') then 'Others'\r\nwhen startsWith(Class_Name,'Connect') then 'Others'\r\nwhen startsWith(Class_Name,'Cons') then 'Others'\r\nwhen startsWith(Class_Name,'Content') then 'Others'\r\nwhen startsWith(Class_Name,'Contract') then 'Others'\r\nwhen startsWith(Class_Name,'Core_AAQC') then 'Others'\r\nwhen startsWith(Class_Name,'Core_Account') then 'Vega'\r\nwhen startsWith(Class_Name,'Core_Batch_Account') then 'Others'\r\nwhen startsWith(Class_Name,'Core_Batch_DDR') then 'Others'\r\nwhen startsWith(Class_Name,'Core_Batch_DeleteInactiveKP') then 'Others'\r\nwhen startsWith(Class_Name,'Core_Integration') then 'Others'\r\nwhen startsWith(Class_Name,'Core_Product') then 'Others'\r\nwhen startsWith(Class_Name,'Core_RestAPI') then 'Others'\r\nwhen startsWith(Class_Name,'Create') then 'Others'\r\nwhen startsWith(Class_Name,'Cs') then 'Others'\r\nwhen startsWith(Class_Name,'Cvent') then 'Others'\r\nwhen startsWith(Class_Name,'DaScoop') then 'Others'\r\nwhen startsWith(Class_Name,'Custom') then 'Others'\r\nwhen startsWith(Class_Name,'Data') then 'Others'\r\nwhen startsWith(Class_Name,'Delete') then 'Others'\r\nwhen startsWith(Class_Name,'Discount') then 'Others'\r\nwhen startsWith(Class_Name,'Doc') then 'Others'\r\nwhen startsWith(Class_Name,'Event') then 'Others'\r\nwhen startsWith(Class_Name,'Email') then 'Others'\r\nwhen startsWith(Class_Name,'Error') then 'Others'\r\nwhen startsWith(Class_Name,'fflib_') then 'Others'\r\nwhen startsWith(Class_Name,'Field') then 'Others'\r\nwhen startsWith(Class_Name,'Install') then 'Others'\r\nwhen startsWith(Class_Name,'JS') then 'Others'\r\nwhen startsWith(Class_Name,'NMT') then 'Others'\r\nwhen startsWith(Class_Name,'Nomination') then 'Others'\r\nwhen startsWith(Class_Name,'Opportunity') then 'Others'\r\nwhen startsWith(Class_Name,'Orbis') then 'Others'\r\nwhen startsWith(Class_Name,'Order') then 'Others'\r\nwhen startsWith(Class_Name,'Page') then 'Others'\r\nwhen startsWith(Class_Name,'Record') then 'Others'\r\nwhen startsWith(Class_Name,'Relat') then 'Others'\r\nwhen startsWith(Class_Name,'Reltio') then 'Others'\r\nwhen startsWith(Class_Name,'Remote') then 'Others'\r\nwhen startsWith(Class_Name,'REST') then 'Others'\r\nwhen startsWith(Class_Name,'Seismic') then 'Others'\r\nwhen startsWith(Class_Name,'Page') then 'Others'\r\nwhen startsWith(Class_Name,'Survey') then 'Others'\r\nwhen startsWith(Class_Name,'Sync') then 'Others'\r\nwhen startsWith(Class_Name,'Task') then 'Others'\r\nwhen startsWith(Class_Name,'Temp') then 'Others'\r\nwhen startsWith(Class_Name,'Trail') then 'Others'\r\nwhen startsWith(Class_Name,'Update') then 'Others'\r\nwhen startsWith(Class_Name,'User') then 'Others'\r\n    when contains(Class_Name, 'ERPM') then 'ERPM (Quest)'\r\n    when contains(Class_Name, 'CIM') then 'Vega'\r\n    when contains(Class_Name, 'CIM') then 'Quest'\r\n    when contains(Class_Name, 'CIM') then 'IPA'\r\n    when contains(Class_Name, 'SBQQ') then 'Salesforce CPQ'\t\r\n    when contains(Class_Name, 'ACM') then 'UCD'\r\n    when contains(Class_Name, 'LeadShare') then 'Unicorn'\r\n    when contains(Class_Name, 'KPI') then 'Unicorn'\t\t\r\nend ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3_copy0_copy0_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA2_copy0_copy0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
