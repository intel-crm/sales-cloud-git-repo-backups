    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN19" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "OppMediumRiskRecordCount",
          "label" : "OppMediumRiskRecordCount",
          "formulaExpression" : "case when size(\"EventExceptions.Id\") = -1 then 0 else size(\"EventExceptions.Id\") end\r\n + \r\ncase when size(\"TaskExceptions.Id\") = -1 then 0 else size(\"TaskExceptions.Id\") end \r\n+ \r\ncase when size(\"OppContExceptions.Id\") = -1 then 0 else size(\"OppContExceptions.Id\") end",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "OppMediumRiskErrorCount",
          "label" : "OppMediumRiskErrorCount",
          "formulaExpression" : "\"EventExceptions.Exceptions.SUM_RecordException\" + \"TaskExceptions.Exceptions.SUM_RecordException\" + \"OppContExceptions.Exceptions.SUM_RecordException\"",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "OppHighRiskRecordCount",
          "label" : "OppHighRiskRecordCount",
          "formulaExpression" : "1 + case when size(\"OLIExceptions.Id\")=-1 then 0 else size(\"OLIExceptions.Id\") end",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "OppHighRiskErrorCount",
          "label" : "OppHighRiskErrorCount",
          "formulaExpression" : "\"Exceptions.SUM_RecordException\" + \"OLIExceptions.Exceptions.SUM_RecordException\"",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "GeneralGrouping",
          "label" : "GeneralGrouping",
          "formulaExpression" : "'Opportunities'",
          "precision" : 50,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA14" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "HighRiskAmount",
          "label" : "HighRiskAmount",
          "formulaExpression" : "case \r\n    when \"OLIExceptions.Exceptions.SUM_RecordException\" = 0 AND \"Exceptions.SUM_RecordException\" = 0 then 0 \r\n    when \"OLIExceptions.Exceptions.SUM_RecordException\" != 0 AND \"Exceptions.SUM_RecordException\" = 0 then \"OLIExceptions.TotalPrice\" \r\n    when \"OLIExceptions.Exceptions.SUM_RecordException\" = 0 AND \"Exceptions.SUM_RecordException\" != 0 then Amount \r\n    when \"OLIExceptions.Exceptions.SUM_RecordException\" != 0 AND \"Exceptions.SUM_RecordException\" != 0 then Amount \r\n    else 0\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
