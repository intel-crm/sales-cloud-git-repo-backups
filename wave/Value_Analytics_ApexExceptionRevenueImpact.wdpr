        "fields" : [ {
          "type" : "NUMBER",
          "name" : "AccountLowRiskImpactedUsers",
          "label" : "AccountLowRiskImpactedUsers",
          "formulaExpression" : "case when size(\"ContactExceptions.OwnerId\") = -1 then 0 else size(\"ContactExceptions.OwnerId\") end +\r\ncase when size(\"CaseExceptions.OwnerId\") = -1 then 0 else size(\"CaseExceptions.OwnerId\") end + \r\ncase when size(\"EventExceptions.OwnerId\") = -1 then 0 else size(\"EventExceptions.OwnerId\") end + \r\ncase when size(\"TaskExceptions.OwnerId\") = -1 then 0 else size(\"TaskExceptions.OwnerId\") end \r\n+ 1",
