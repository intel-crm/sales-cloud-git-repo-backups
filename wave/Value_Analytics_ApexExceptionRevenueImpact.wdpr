    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "JOIN25" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "AccLowRiskRecordCount",
          "label" : "AccLowRiskRecordCount",
          "formulaExpression" : "case when size(\"ContactExceptions.Id\") = -1 then 0 else size(\"ContactExceptions.Id\") end \r\n    + \r\ncase when size(\"CaseExceptions.Id\") = -1 then 0 else size(\"CaseExceptions.Id\") end \r\n    +\r\ncase when size(\"EventExceptions.Id\") = -1 then 0 else size(\"EventExceptions.Id\") end\r\n    + \r\ncase when size(\"TaskExceptions.Id\") = -1 then 0 else size(\"TaskExceptions.Id\") end",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
