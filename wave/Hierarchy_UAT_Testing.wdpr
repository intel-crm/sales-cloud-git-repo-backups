    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Role_nm",
          "label" : "Role",
          "formulaExpression" : "case\r\n\twhen TEAM_MEMBER_ID != TEAM_MEMBER_MANAGER_ID and TEAM_MEMBER_ROLE_NM = 'Owner'\r\n\tthen 'Owner'\r\n\twhen TEAM_MEMBER_ID != TEAM_MEMBER_MANAGER_ID and TEAM_MEMBER_ROLE_NM = 'Team Member'\r\n\tthen 'Team Member'\r\n    when TEAM_MEMBER_ID != TEAM_MEMBER_MANAGER_ID and TEAM_MEMBER_ROLE_NM = 'Technical Owner'\r\n\tthen 'Technical Owner'\r\n\telse\r\n\tnull\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "JOIN0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Role_nm",
          "label" : "Role",
          "formulaExpression" : "case\r\n\twhen TEAM_MEMBER_ID != TEAM_MEMBER_MANAGER_ID and TEAM_MEMBER_ROLE_NM in ('Owner','Team Member', 'Technical Owner')\r\n\tthen 'Any of the Above'\r\n\telse\r\n\tnull\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
