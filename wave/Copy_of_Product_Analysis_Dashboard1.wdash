.asString())}};\nq = filter q by 'Core_At_Risk_Status__c' in {{coalesce(flatten(column(At_Risk_4.selection, [\"display\"])),'all').asString()}};\n--q = filter q by '{{column(static_28.selection,[\"manager_hierarchy\"]).asObject()}}' in {{coalesce(column(lens_32.selection, [\"Name\"]), 'all').asString()}};\n\n\nq = foreach q generate q.'Opportunity.Account.Name', \ncase when 'Core_Status__c' in [\"On Hold\", \"Pending\", \"Win Submitted\"] then q.'Core_KPI_Total_Price__c' else 0 end as 'Open_Opp', \ncount(q)*case when q.'Opportunity.Core_Opp_Strategic_Opportunity__c' in [\"false\"] then 0 else 1 end as 'Str_opp',\ncase when 'Core_Status__c' in [\"Production Cancelled\",\"Production Lost\",\"Production Win\",\"Win Approved\",\"Production Win Approved\", \"Production Win Submitted\"] then q.'Core_KPI_Total_Price__c' else 0 end as 'Won_won', \ncase when 'Core_Status__c' in [\"On Hold\", \"Pending\", \"Win Submitted\"] then q.'OpportunityId' end as 'Open_Opp_Count',\ncount(q)*case when q.'Core_At_Risk__c' in [\"false\"] then 0 else 1 end as 'Risk_opp', 'Core_KPI_Total_Price__c', q.'Opportunity.Name',q.'Opportunity.StageName',q.'Opportunity.CloseDate',q.'WeightedAmount';\n\n\nq_result = group q by ('Opportunity.Name','Opportunity.Account.Name','Opportunity.StageName','Opportunity.CloseDate');\nq_result = foreach q_result generate q.'Opportunity.Name',q.'Opportunity.Account.Name',q.'Opportunity.StageName',q.'Opportunity.CloseDate',\n--sum('Open_Opp') as 'Open Opp',\n--unique('Open_Opp_Count') as 'Open Opp Count',\n--sum('Str_opp') as 'Strategic Opps',\n--sum('Risk_opp') as 'At Risk Opps',\n--sum('Won_won') as 'Won'; \nsum('{{cell(Opportunity_AccountT_1.selection, 0, \"fieldname\").asObject()}}') as '{{cell(Opportunity_AccountT_1.selection, 0, \"amount_type\").asString()}}';\nq_result = order q_result by '{{cell(Opportunity_AccountT_1.selection, 0, \"amount_type\").asString()}}' desc;\nq_result = limit q_result {{column(staticLimit_1.selection,[\"value_table\"]).asObject()}