election, 0, \"CloseDate_1\").asString()}}] and 'Opportunity.Stage.IsClosedEnd' == \"true\" and 'Opportunity.Stage.IsWonEnd' == \"true\" ) then \"5_CLOSED_WON\" else \"OTHER\" end ) as 'Status', 'OpportunityId',  'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Core_KPI_Date__c', 'Opportunity.CloseDate', 'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'amountStart', 'amountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_full_closed = filter upd_full_closed by 'Status' != \"OTHER\"; upd_full_closed = foreach upd_full_closed generate 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName',( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'Opportunity.WeightedAmount_cEnd') when \"5_CLOSED_WON\" then (0 - 'Opportunity.WeightedAmount_cEnd') end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'amountEnd') when \"5_CLOSED_WON\" then (0 - 'amountEnd') end ) as 'Amount',( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') when \"5_CLOSED_WON\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') end ) as 'Opportunity.Core_Push_Counter__c'; upd_full_notinperiod = foreach upd generate ( case when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and not(toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}]) ) then \"6_MOVED_OUT\" when ( 'New' and toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}]) then \"1_NEW\" when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"true\" and toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] ) then \"2_REOPEN\" when ( not 'New' and toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and (('Opportunity.Stage.IsClosedStart' == \"false\" and not(toDate('CloseDateStart') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}])) or ('Opportunity.Stage.IsClosedStart' == \"true\")) ) then \"4_MOVED_IN\" else \"OTHER\" end ) as 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Core_KPI_Date__c','Opportunity.CloseDate', 'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'amountStart', 'amountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_full_notinperiod = filter upd_full_notinperiod by 'Status' != \"OTHER\"; upd_full_notinperiod = foreach upd_full_notinperiod generate 'Status',( case 'Status' when \"6_MOVED_OUT\" then (0 - 'Opportunity.WeightedAmount_cEnd') when \"1_NEW\" then 'Opportunity.WeightedAmount_cEnd' when \"2_REOPEN\" then 'Opportunity.WeightedAmount_cEnd' when \"4_MOVED_IN\" then 'Opportunity.WeightedAmount_cEnd' end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"6_MOVED_OUT\" then (0 - 'amountEnd') when \"1_NEW\" then 'amountEnd' when \"2_REOPEN\" then 'amountEnd' when \"4_MOVED_IN\" then 'amountEnd' end ) as 'Amount',( case 'Status' when \"6_MOVED_OUT\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') when \"1_NEW\" then 'Opportunity.Core_Push_Counter__c__cEnd' when \"2_REOPEN\" then 'Opportunity.Core_Push_Counter__c__cEnd' when \"4_MOVED_IN\" then 'Opportunity.Core_Push_Counter__c__cEnd' end ) as 'Opportunity.Core_Push_Counter__c', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName'; upd_delta = foreach upd generate ( case when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and 'amountStart' > 'amountEnd') then \"7_REDUCE\" when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and 'amountStart' < 'amountEnd') then \"3_EXPAND\" else \"OTHER\" end ) as 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'amountStart', 'amountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_delta = filter upd_delta by 'Status' != \"OTHER\"; upd_delta = foreach upd_delta generate 'Status',( case 'Status' when \"7_REDUCE\" then 'Opportunity.WeightedAmount_cEnd' - 'Opportunity.WeightedAmount_cStart' when \"3_EXPAND\" then 'Opportunity.WeightedAmount_cEnd' - 'Opportunity.WeightedAmount_cStart' end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"7_REDUCE\" then 'amountEnd' - 'amountStart' when \"3_EXPAND\" then 'amountEnd' - 'amountStart' end ) as 'Amount',( case 'Status' when \"7_REDUCE\" then 'Opportunity.Core_Push_Counter__c__cEnd' - 'Opportunity.Core_Push_Counter__c__cStart' when \"3_EXPAND\" then 'Opportunity.Core_Push_Counter__c__cEnd' - 'Opportunity.Core_Push_Counter__c__cStart' end ) as 'Opportunity.Core_Push_Counter__c', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName'; WATERFALL = union upd_full_notinperiod, upd_delta, upd_full_closed; WATERFALL = filter WATERFALL by {{column(lens_7.selection, [\"Status\"]).asEquality(\"Status\")}}; WATERFALL = group WATERFALL by 'OpportunityId'; WATERFALL = foreach WATERFALL generate last('OpportunityId') as 'OpportunityId', last('Status') as 'Status', last('Opportunity.Account.Name') as 'Opportunity Account Name', last('Opportunity.Name') as 'Opportunity.Name', last('Opportunity.Owner.Name') as 'Opportunity Owner', last('Core_KPI_Date__c') as 'KPI Date',last('Opportunity.CloseDate') as 'Opportunity Close Date',last('Opportunity.StageName') as 'Opportunity.StageName',(case when last('Opportunity.WeightedAmount') ==0 then \"$0\" else number_to_string(last('Opportunity.WeightedAmount'),\"$#,###\")end) as 'Wtd Amt',abs(last('Opportunity.Core_Push_Counter__c')) as 'Push Counter',abs(last('Opportunity.WeightedAmount')) as 'Wtd Amt_abs';WATERFALL = order WATERFALL by 'Wtd Amt_abs' desc;WATERFALL = limit WATERFALL 200; ","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"alignment":"left","backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"italic":false,"textWrap":false,"underline":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfFrozenColumns":0,"numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"lens_13":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"OpportunityProducts\";\nq = filter q by '{{column(FiscalKPIDate_fiscal_9.selection,[\"year_value\"]).asObject()}}' in {{coalesce(column(year_list_2.selection, [\"select_year\"]),'all').asString()}};\nq = filter q by '{{column(FiscalKPIDate_fiscal_9.selection,[\"yearquarter_value\"]).asObject()}}' in {{coalesce(column(FiscalKPIDate_fiscal_10.selection, [\"quarter\"]),'all').asString()}};\nq = filter q by {{column(static_6.selection,[\"sales_manager\"]).asGrouping()}}  in {{ coalesce( column(lens_12.selection, [\"Name\"]) , \"all\" ).asString()  }} ;\nq = group q by {{c