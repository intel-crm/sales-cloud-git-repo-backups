, 0, \"Update_End_ValidTo\").asString()}}\"..]; upd = group upd_start by OpportunityId right, upd_end by OpportunityId; upd = foreach upd generate upd_end.'OpportunityId' as 'OpportunityId', upd_start.'OpportunityId' is null as 'New', first(upd_start.'Opportunity.Core_Push_Counter__c') as 'Opportunity.Core_Push_Counter__c__cStart',first(upd_start.'WeightedAmount') as 'Opportunity.WeightedAmount_cStart', first(upd_start.'Core_KPI_Total_Price__c') as 'amountStart', first(upd_start.'Opportunity.Stage.IsClosed') as 'Opportunity.Stage.IsClosedStart', first(upd_start.'Opportunity.Stage.IsWon') as 'Opportunity.Stage.IsWonStart', first(upd_start.'{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"close_date_epoch\").asString()}}') as 'CloseDateStart', last(upd_end.'WeightedAmount') as 'Opportunity.WeightedAmount_cEnd',last(upd_end.'Core_KPI_Total_Price__c') as 'amountEnd',last(upd_end.'Opportunity.Core_Push_Counter__c') as 'Opportunity.Core_Push_Counter__c__cEnd', last(upd_end.'Opportunity.Stage.IsClosed') as 'Opportunity.Stage.IsClosedEnd', last(upd_end.'Opportunity.Stage.IsWon') as 'Opportunity.Stage.IsWonEnd', last(upd_end.'{{cell(FiscalKPIDate_fiscal_3.selection, 0, \"close_date_epoch\").asString()}}') as 'CloseDateEnd',last(upd_end.'Opportunity.Account.AccountName') as 'Opportunity.Account.Name', last(upd_end.'Opportunity.Name') as 'Opportunity.Name', last(upd_end.'Opportunity.Owner.Name') as 'Opportunity.Owner.Name', last(upd_end.'Core_KPI_Date__c') as 'Core_KPI_Date__c',last(upd_end.'Opportunity.CloseDate') as 'Opportunity.CloseDate', last(upd_end.'Opportunity.StageName') as 'Opportunity.StageName'; upd_full_closed = foreach upd generate ( case when ( toDate('CloseDateEnd') in  [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] and 'Opportunity.Stage.IsClosedEnd' == \"true\" and 'Opportunity.Stage.IsWonEnd' == \"false\" ) then \"8_CLOSED_LOST\" when ( toDate('CloseDateEnd') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] and 'Opportunity.Stage.IsClosedEnd' == \"true\" and 'Opportunity.Stage.IsWonEnd' == \"true\" ) then \"5_CLOSED_WON\" else \"OTHER\" end ) as 'Status', 'OpportunityId',  'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Core_KPI_Date__c', 'Opportunity.CloseDate', 'Opportunity.StageName','Opportunity.WeightedAmount_cStart','Opportunity.WeightedAmount_cEnd', 'amountStart', 'amountEnd','Opportunity.Core_Push_Counter__c__cStart','Opportunity.Core_Push_Counter__c__cEnd'; upd_full_closed = filter upd_full_closed by 'Status' != \"OTHER\"; upd_full_closed = foreach upd_full_closed generate 'Status', 'OpportunityId', 'Opportunity.Account.Name', 'Opportunity.Name', 'Opportunity.Owner.Name', 'Core_KPI_Date__c','Opportunity.CloseDate',  'Opportunity.StageName',( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'Opportunity.WeightedAmount_cEnd') when \"5_CLOSED_WON\" then (0 - 'Opportunity.WeightedAmount_cEnd') end ) as 'Opportunity.WeightedAmount', ( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'amountEnd') when \"5_CLOSED_WON\" then (0 - 'amountEnd') end ) as 'Amount',( case 'Status' when \"8_CLOSED_LOST\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') when \"5_CLOSED_WON\" then (0 - 'Opportunity.Core_Push_Counter__c__cEnd') end ) as 'Opportunity.Core_Push_Counter__c'; upd_full_notinperiod = foreach upd generate ( case when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] and not(toDate('CloseDateEnd') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}]) ) then \"6_MOVED_OUT\" when ( 'New' and toDate('CloseDateEnd') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}]) then \"1_NEW\" when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"true\" and toDate('CloseDateEnd') in [{{cell(step_time.selection, 0, \"CloseDate_1\").asString()}}] ) then \"2_REOPEN\" when ( not 'New' and toDate('CloseDateEnd') in [{{cell(step_time.selection, 