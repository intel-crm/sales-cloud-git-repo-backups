 - Production Win\"];\nq = filter q by 'Opportunity.Core_Support_Completed__c' == \"false\";\nq = filter q by 'Core_At_Risk__c' == \"true\"; \nq = filter q by 'Core_At_Risk_Status__c' in [\"In-Progress\",\"New\"];\nq = filter q by 'Core_Status__c' in [\"On Hold\",\"Pending\",\"Win Submitted\"];\n\nq = filter q by '{{column(static_28.selection,[\"manager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(lens_32.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \nq = filter q by  '{{column(static_28.selection,[\"rep_hierarchy\"]).asObject()}}'  in {{coalesce(column(lens_31.selection, [\"Name\"]),'all').asString()}};\n\nq = filter q by '{{column(FiscalKPIDate_fiscal_9.selection,[\"year_value\"]).asObject()}}' in {{coalesce(column(year_list_2.selection, [\"select_year\"]),'all').asString()}};\nq = filter q by '{{column(FiscalKPIDate_fiscal_9.selection,[\"yearquarter_value\"]).asObject()}}' in {{coalesce(column(FiscalKPIDate_fiscal_10.selection, [\"quarter\"]),'all').asString()}};\n\nq = filter q by 'Opportunity.Core_Opportunity_Type__c' in {{coalesce(flatten(column(FiscalKPIDate_fiscal_20.selection, [\"type_values\"])),'all').asString())}};\nq = group q by all;\nq = foreach q generate unique('OpportunityId') as 'Total oppty count';\n","receiveFacetSource":{"mode":"exclude","steps":["Chart1_1"]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","showValues":true,"bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMe