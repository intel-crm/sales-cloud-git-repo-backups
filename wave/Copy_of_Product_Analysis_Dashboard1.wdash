Quantity' as 'Value' ;\nres_amount = foreach result generate \"Amount\" as 'Type', result.'Amount' as 'Value' ;\nres_average = foreach result generate \"Average\" as 'Type', result.'Average' as 'Value' ;\nres_win = foreach result generate \"Win Rate\" as 'Type', result.'Win' as 'Value' ;\nres_fin = union res_quantity,res_amount,res_average,res_win;\nres_header = foreach res_fin generate res_fin.'Type' as ' ' , res_fin.'Value' as '';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#E6ECF2","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#FFFFFF","fontColor":"#16325c","fontSize":10},"headerProperties":{},"innerMajorBorderColor":"#7D98B3","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"Opportunity_Core_Opp_7":{"broadcastFacet":true,"groups":[],"label":"Opportunity_Core_Opp_6","numbers":[],"query":"q = load \"OpportunityProducts\";\nq = group q by 'Opportunity.Core_Opportunity_Coverage_Nm__c';\nq = foreach q generate 'Opportunity.Core_Opportunity_Coverage_Nm__c' as 'Opportunity.Core_Opportunity_Coverage_Nm__c', count() as 'count';\nq = order q by 'Opportunity.Core_Opportunity_Coverage_Nm__c' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","start":"[\"Intel-Led Opportunity\"]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}