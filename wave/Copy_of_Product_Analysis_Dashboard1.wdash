generate \"0_START\" as 'Status', (count() - count()) as 'sum_Amount'; \r\nSTART = union START_FAKE, START_REAL; START = group START by all; START = foreach START generate last('Status') as 'Status', last('sum_Amount') as 'sum_Amount'; \r\nEND_REAL = filter x1 by date('{{cell(Calendar_Selector_1.selection, 0, \"valid_fromdate_year\").asString()}}', '{{cell(Calendar_Selector_1.selection, 0, \"valid_fromdate_month\").asString()}}', 'Opportunity.ValidFromDate_Day') in [..\"{{cell(Intermediate_1.result, 0, \"End_ValidFrom\").asString()}}\"]; \r\nEND_REAL = filter END_REAL by date('{{cell(Calendar_Selector_1.selection, 0, \"valid_todate_year\").asString()}}','{{cell(Calendar_Selector_1.selection, 0, \"valid_todate_month\").asString()}}', 'Opportunity.ValidToDate_Day') in [\"{{cell(Intermediate_1.result, 0, \"End_ValidTo\").asString()}}\"..]; END_REAL = filter END_REAL by 'Opportunity.Stage.IsClosed' == \"false\"; END_REAL = filter END_REAL by date('{{cell(Calendar_Selector_1.selection, 0, \"close_date_year\").asString()}}','{{cell(Calendar_Selector_1.selection, 0, \"close_date_month\").asString()}}', 'Opportunity.CloseDate_Day') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}]; END_REAL = group END_REAL by all; END_REAL = foreach END_REAL generate \"9_END\" as 'Status', sum('Core_KPI_Total_Price__c') as 'sum_Amount'; END_FAKE = group x1 by all; END_FAKE = foreach END_FAKE generate \"9_END\" as 'Status', (count() - count()) as 'sum_Amount'; END = union END_FAKE, END_REAL; END = group END by all; END = foreach END generate last('Status') as 'Status', last('sum_Amount') as 'sum_Amount';\r\n upd_start = filter x1 by date('{{cell(Calendar_Selector_1.selection, 0, \"valid_fromdate_year\").asString()}}', '{{cell(Calendar_Selector_1.selection, 0, \"valid_fromdate_month\").asString()}}', 'Opportunity.ValidFromDate_Day') in [..\"{{cell(Intermediate_1.result, 0, \"Update_ValidFrom\").asString()}}\"]; upd_start = filter upd_start by date('{{cell(Calendar_Selector_1.selection, 0, \"valid_todate_year\").asString()}}','{{cell(Calendar_Selector_1.selection, 0, \"valid_todate_month\").asString()}}', 'Opportunity.ValidToDate_Day') in [\"{{cell(Intermediate_1.result, 0, \"Start_ValidTo\").asString()}}\"..\"{{cell(Intermediate_1.result, 0, \"End_ValidFrom\").asString()}}\"]; upd_end = filter x1 by date('{{cell(Calendar_Selector_1.selection, 0, \"valid_fromdate_year\").asString()}}', '{{cell(Calendar_Selector_1.selection, 0, \"valid_fromdate_month\").asString()}}', 'Opportunity.ValidFromDate_Day') in [\"{{cell(Intermediate_1.result, 0, \"Start_ValidTo\").asString()}}\"..\"{{cell(Intermediate_1.result, 0, \"End_ValidFrom\").asString()}}\"]; upd_end = filter upd_end by date('{{cell(Calendar_Selector_1.selection, 0, \"valid_todate_year\").asString()}}','{{cell(Calendar_Selector_1.selection, 0, \"valid_todate_month\").asString()}}', 'Opportunity.ValidToDate_Day') in [\"{{cell(Intermediate_1.result, 0, \"Update_End_ValidTo\").asString()}}\"..]; upd = group upd_start by OpportunityId right, upd_end by OpportunityId; upd = foreach upd generate upd_end.'OpportunityId' as OpportunityId, upd_start.'OpportunityId' is null as 'New', first(upd_start.'Core_KPI_Total_Price__c') as 'AmountStart', first(upd_start.'Opportunity.Stage.IsClosed') as 'Opportunity.Stage.IsClosedStart', first(upd_start.'Opportunity.Stage.IsWon') as 'Opportunity.Stage.IsWonStart', first(upd_start.'{{cell(Calendar_Selector_1.selection, 0, \"close_date_epoch\").asString()}}') as 'CloseDateStart', last(upd_end.'Core_KPI_Total_Price__c') as 'AmountEnd', last(upd_end.'Opportunity.Stage.IsClosed') as 'Opportunity.Stage.IsClosedEnd', last(upd_end.'Opportunity.Stage.IsWon') as 'Opportunity.Stage.IsWonEnd', last(upd_end.'{{cell(Calendar_Selector_1.selection, 0, \"close_date_epoch\").asString()}}') as 'CloseDateEnd', last(upd_end.'Opportunity.Owner.UniqueUserName') as 'Opportunity.Owner.UniqueUserName', last(upd_end.'Opportunity.Account.AccountPartner.Industry') as 'Opportunity.Account.Industry', last(upd_end.'Opportunity.Account.AccountPartner.BillingCountry') as 'Opportunity.Account.BillingCountry'; upd_full_closed = foreach upd generate ( case when ( toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and 'Opportunity.Stage.IsClosedEnd' == \"true\" and 'Opportunity.Stage.IsWonEnd' == \"false\" ) then \"8_CLOSED_LOST\" when ( toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and 'Opportunity.Stage.IsClosedEnd' == \"true\" and 'Opportunity.Stage.IsWonEnd' == \"true\" ) then \"5_CLOSED_WON\" else \"OTHER\" end ) as 'Status', 'AmountStart', 'AmountEnd';\r\n \r\n  upd_full_closed = filter upd_full_closed by 'Status' != \"OTHER\"; upd_full_closed = group upd_full_closed by 'Status'; upd_full_closed = foreach upd_full_closed generate 'Status', ( case 'Status' when \"8_CLOSED_LOST\" then - sum('AmountEnd') when \"5_CLOSED_WON\" then - sum('AmountEnd') end ) as 'sum_Amount';\r\n  \r\n   upd_full_notinperiod = foreach upd generate ( case when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and not(toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}]) ) then \"6_MOVED_OUT\" when ( 'New' and toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] ) then \"1_NEW\" when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"true\" and toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] ) then \"2_REOPEN\" when ( not 'New' and toDate('CloseDateEnd') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and (('Opportunity.Stage.IsClosedStart' == \"false\" and not(toDate('CloseDateStart') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}])) or ('Opportunity.Stage.IsClosedStart' == \"true\")) ) then \"4_MOVED_IN\" else \"OTHER\" end ) as 'Status', 'AmountStart', 'AmountEnd'; upd_full_notinperiod = filter upd_full_notinperiod by 'Status' != \"OTHER\"; \r\n   \r\n   upd_full_notinperiod = group upd_full_notinperiod by 'Status'; upd_full_notinperiod = foreach upd_full_notinperiod generate 'Status', ( case 'Status' when \"6_MOVED_OUT\" then - sum('AmountEnd') when \"1_NEW\" then sum('AmountEnd') when \"2_REOPEN\" then sum('AmountEnd') when \"4_MOVED_IN\" then sum('AmountEnd') end ) as 'sum_Amount'; upd_delta = foreach upd generate ( case when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and 'AmountStart' > 'AmountEnd' ) then \"7_REDUCE\" when ( not 'New' and 'Opportunity.Stage.IsClosedStart' == \"false\" and toDate('CloseDateStart') in [{{cell(static_1.selection, 0, \"CloseDate_1\").asString()}}] and 'AmountStart' < 'AmountEnd' ) then \"3_EXPAND\" else \"OTHER\" end ) as 'Status', 'AmountStart', 'AmountEnd'; upd_delta = filter upd_delta by 'Status' != \"OTHER\"; upd_delta = group upd_delta by 'Status'; upd_delta = foreach upd_delta generate 'Status', ( case 'Status' when \"7_REDUCE\" then sum('AmountEnd') - sum('AmountStart') when \"3_EXPAND\" then sum('AmountEnd') - sum('AmountStart') end ) as 'sum_Amount'; \r\n   WATERFALL = union START, upd_full_notinperiod, upd_delta, upd_full_closed, END; WATERFALL = order WATERFALL by 'Status' asc;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":["Status"],"type":"saql","useExternalFilters":true,"useGlobal":true},"lens_5":{"broadcastFacet":true,"datasets":[{"name":"OpportunityProducts"}],"isGlobal":false,"query":{"aggregateFilters":[],"columnGroups":[],"columnTotals":[],"limit":2000,"orders":[],"rowTotals":[],"sourceFilters":{},"sources":[{"columns":[{"field":["count","*"],"name":"A"}],"filters":[],"groups":["all"],"joins":[],"name":"OpportunityProducts"}]},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","type":"aggregate