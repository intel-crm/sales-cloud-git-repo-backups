["{\"nodes\":{\"Compute_Additional_Flags\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"Snapshot Text Date\",\"name\":\"Snapshot_Text_Date\",\"saqlExpression\":\"toString(toDate('Snapshot_Date_sec_epoch'),\\\"yyyy-MM-dd\\\")\",\"type\":\"Text\"},{\"label\":\"CustomSnapshotFilter\",\"name\":\"CustomSnapshotFilter\",\"saqlExpression\":\"\\\"true\\\"\",\"type\":\"Text\"}],\"mergeWithSource\":true},\"sources\":[\"Compute_Snapshot_Date\"]},\"OpportunityTeamMember\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"OpportunityId\"},{\"name\":\"TeamMemberRole\"},{\"name\":\"UserId\"}],\"object\":\"OpportunityTeamMember\"}},\"Extract_Dataset\":{\"action\":\"dataset\",\"parameters\":{\"name\":\"SMGOpportunityWithNoProdCommits_UAT\"}},\"Compute_Snapshot_Filter_Flag\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"Snapshot Filter Flag\",\"name\":\"SnapshotFilterFlag\",\"saqlExpression\":\"case when date_diff(\\\"day\\\", toDate(Snapshot_Date_sec_epoch), now()) > 365 then \\\"false\\\" else \\\"true\\\" end\",\"type\":\"Text\"}],\"mergeWithSource\":true},\"sources\":[\"Append_LatestSnapshot\"]},\"ManagerHierarchy\":{\"action\":\"digest\",\"parameters\":{\"connectionName\":\"SNOWFLAKE_SMG_CONNECTION\",\"fields\":[{\"name\":\"ANYOFABOVE_HIERARCHY_NM\"},{\"name\":\"ID\"},{\"name\":\"OWNER_HIERARCHY_TXT\"},{\"name\":\"OWNER_ID\"},{\"name\":\"OWNER_NM\"},{\"name\":\"TEAMMEMBER_HIERARCHY_TXT\"},{\"name\":\"TEAMMEMBER_ID\"},{\"name\":\"TEAMMEMBER_NM\"},{\"name\":\"TECHICALOWNER_HIERARCHY_TXT\"}],\"object\":\"DIM_MANAGER_HIERARCHY_CRMA\"}},\"Remove_De_Dupe_Flag\":{\"action\":\"sliceDataset\",\"parameters\":{\"fields\":[{\"name\":\"RemoveDataFlag\"},{\"name\":\"SnapshotFilterFlag\"}],\"mode\":\"drop\"},\"sources\":[\"Filter_Snapshot_Data\"]},\"Extract_Existing_SnapshotDataset\":{\"action\":\"dataset\",\"parameters\":{\"name\":\"SnapshotDS\"}},\"Filter_Duplicate_Snapshot_Dates\":{\"action\":\"fi