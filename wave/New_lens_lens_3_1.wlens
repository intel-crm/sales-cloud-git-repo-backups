{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":true,"groups":[],"label":"lens_3","numbers":[],"query":"q = load \"OpportunityProducts\";\nq = filter q by 'FiscalKPIDate.fiscalyearnumber' in [\"2023\"];\nq = filter q by 'FiscalKPIDate.fiscalyearquarternumber' in all;\nq = filter q by 'Opportunity.StageName' in [\"Design\",\"Develop\",\"Qualify\",\"Group\",\"Define\",\"Production Cancelled\",\"Production Lost\",\"Production Win\",\"Design Win\"] and 'Core_Status__c' in [\"Pending\",\"On Hold\",\"Win Submitted\",\"Win Approved\",\"Production Win\",\"Production Lost\",\"Production Cancelled\"];\nq = filter q by 'Core_At_Risk_Status__c' in all;\nq = filter q by 'Opportunity.Core_Opportunity_Type__c' in [\"Deal: Partner Scale-enable\",\"Deal: Sell-through\",\"Deal: Sell-to\",\"Design: Original\",\"Design: Secondary\",\"Design: Software-enable\"];\nq = filter q by 'Opportunity.TeamMembers.User.Manager.Name' in all;\nq = filter q by 'Opportunity.TeamMembers.User.Name' in all;\nq = group q by ('CoreKPIDateYearQuarter', 'StageSorted', 'Opportunity.StageName',Product2Id);\nq = foreach q generate q.'CoreKPIDateYearQuarter' as 'CoreKPIDateYearQuarter', q.'Opportunity.StageName' as 'Opportunity.StageName', case when \"$\"== \"Units\" then max(Quantity) else case when \"Unwtd\"== \"Unwtd\" then max(q.'Core_KPI_Total_Price__c') else sum(q.'WeightedAmount') end end as 'B', 'StageSorted' ;\nq = group q by ('CoreKPIDateYearQuarter', 'StageSorted', 'Opportunity.StageName');\nq = foreach q generate q.'CoreKPIDateYearQuarter' as 'CoreKPIDateYearQuarter', q.'Opportunity.StageName' as 'Opportunity.StageName', sum(B) as 'B', 'StageSorted' ;\nq = order q by ('CoreKPIDateYearQuarter' asc, 'StageSorted' desc);\nq = limit q 2000;","receiveFacetSource":{"mode":"exclude","steps":["lens_22","lens_23"]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"visualizationType":"stackvbar"}}},"widgets":{"saql_chart":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","totalSumMode":"none","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"stackvbar","exploreLink":true,"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"interactions":[],"columnMap":{"split":["Opportunity.StageName"],"trellis":[],"dimensionAxis":["CoreKPIDateYearQuarter"],"plots":["B"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Total Pipeline","customDomain":{"showDomain":false}},"normalize":false,"theme":"wave","step":"saql","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}}}