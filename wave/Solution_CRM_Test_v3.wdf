nType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n\\twhen (Core_Status__c = 'Win Approved') then 'Won'\\r\\n\\twhen (Core_Status__c = 'Production Win') then 'Won' \\r\\n\\twhen (Core_Status__c = 'Production Lost') then 'Won' \\r\\n\\twhen (Core_Status__c = 'Production Cancelled') then 'Won' \\r\\n\\twhen (Core_Status__c = 'Production Win Approved') then 'Won'\\r\\n\\twhen (Core_Status__c = 'Production Win Submitted') then 'Won'\\r\\n\\twhen (Core_Status__c = 'Lost') then 'Lost' \\r\\n\\twhen (Core_Status__c = 'Cancelled') then 'Lost' \\r\\n\\twhen (Core_Status__c = 'Pending') then 'Open' \\r\\n\\twhen (Core_Status__c = 'On Hold') then 'Open' \\r\\n\\twhen (Core_Status__c = 'Win Submitted') then 'Open' \\r\\n\\telse Core_Status__c\\r\\nend\",\"defaultValue\":\"\",\"precision\":10,\"name\":\"Status_Name\",\"label\":\"Status Name\",\"type\":\"TEXT\"}]}},\"FORMULA3\":{\"sources\":[\"FORMULA2\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"\\\"Parter_Solution_Products.PARTNER_NAME\\\"\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Partner_Name\",\"label\":\"Partner Name\",\"type\":\"TEXT\"}]}},\"FORMULA4\":{\"sources\":[\"FORMULA3\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"\\\"Solution_OpportunityProducts.CORE_APPLICATION_WORKLOAD_SPLIT_NM\\\"\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Application_Workload\",\"label\":\"Application Workload\",\"type\":\"TEXT\"}]}},\"FORMULA5\":{\"sources\":[\"FORMULA4\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"\\\"Solution_OpportunityProducts.Solution_Application_Workload.Solution_Industry_Use_Case.Solution_Industry.CORE_TECHNOLOGY_ENABLED_C_SPLIT_NM\\\"\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Tech_Enable\",\"label\":\"Tech Enable\",\"type\":\"TEXT\"}]}},\"FILTER1\":{\"sources\":[\"FORMULA22\"],\"action\":\"filter\