ULA7\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case when \\\"Opportunity.Core_VBS_Status__c\\\" in ('Pending', 'SOAR 1 Qualified', 'Approved') then 'VBS' else null end\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"isVBS\",\"label\":\"Is VBS\",\"type\":\"TEXT\"}]}},\"FORMULA15\":{\"sources\":[\"FORMULA14\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n    when \\\"Opportunity.StageName\\\" in ('Design Win', 'Production Win', 'Production Lost', 'Production Cancelled')\\r\\n    then 'Blue'\\r\\n    when  \\\"Opportunity.StageName\\\" in ('Lost','Cancelled')\\r\\n    then 'Gray'\\r\\n    when \\\"Aggregate0.MIN_risk_num_to_measure\\\" = 1 then 'Red'\\r\\n    when \\\"Aggregate0.MIN_risk_num_to_measure\\\" = 2 \\r\\n    then 'Orange' \\r\\n    when \\\"Aggregate0.MIN_risk_num_to_measure\\\" = 3 \\r\\n    then 'Yellow'\\r\\n    else 'Green' \\r\\nend \",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Status_RYOG\",\"label\":\"Status\",\"type\":\"TEXT\"}]}},\"FORMULA9\":{\"sources\":[\"FORMULA8\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case \\r\\n    when (((\\r\\n        (contains(\\\"Product2.Name\\\", 'Gaudi') or contains(\\\"Product2.Name\\\", 'GAUDI') or contains(\\\"Product2.Name\\\", 'GPU Flex') or contains(\\\"Product2.Name\\\", 'Developer Cloud')) and \\\"Opp.Core_has_Solution__c\\\" = 'true'\\r\\n        )\\r\\n        \\r\\n        or ((contains(\\\"Product2.Name\\\", 'Xeon') \\r\\n        or contains(\\\"Product2.Name\\\", 'Arc') or contains(\\\"Product2.Name\\\", 'Core') \\r\\n        or contains(\\\"Product2.Name\\\", 'OpenVino') \\r\\n        or contains(\\\"Product2.Name\\\", 'oneAPI'))\\r\\n        and (contains(Application_Workload, 'AI Inference') \\r\\n        or contains(Application_Workload, 'AI Training') \\r\\n        or contains(Application_Workload, 'AI on Xeon') \\r\\n        or contains(\\\"Tech_Enable\\\", 'OneAPI') \\r\\n        or contains(\\\"Tech_Enable\\\", 'OpenVino')))\\r\\n        )\\r\\n        \\r\\n        or (contains(\\\"Product2.Name\\\", 'Core') and contains(\\\"Product2.Name\\\", 'Ultra') and startsWith(Solution_Name, 'AI PC'))\\r\\n        )\\r\\n then 'AI' else null end\\r\\n\\r\\n\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"isAI\",\"label\":\"Is AI\",\"type\":\"TEXT\"}]}},\"FORMULA16\":{\"sources\":[\"FORMULA15\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"substr(\\\"Opportunity.Core_Status_Update__c\\\",1,150)\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"Status_shortened\",\"label\":\"Status Shortened\",\"type\":\"TEXT\"}]}},\"FORMULA17\":{\"sources\":[\"FORMULA16\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case when Core_Risk_Priority__c is null then '-' else Core_Risk_Priority__c\\r\\nend\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"riskpriority\",\"label\":\"Risk Priority\",\"type\":\"TEXT\"}]}},\"FORMULA18\":{\"sources\":[\"FORMULA17\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case when \\\"product.Core_Risk_Reason1__c\\\" is null then '-' else \\\"product.Core_Risk_Reason1__c\\\" end\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"RiskReason\",\"label\":\"Risk Reason\",\"type\":\"TEXT\"}]}},\"FORMULA19\":{\"sources\":[\"FORMULA18\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":[{\"formulaExpression\":\"case when \\\"product.Core_Risk_Detail__c\\\" is null then '-' else \\\"product.Core_Risk_Detail__c\\\"end\",\"defaultValue\":\"\",\"precision\":255,\"name\":\"riskdetail\",\"label\":\"Risk Detail\",\"type\":\"TEXT\"}]}},\"FORMULA10\":{\"sources\":[\"FORMULA9\"],\"action\":\"formula\",\"parameters\":{\"expressionType\":\"SQL\",\"fields\":