healthy' == 1;\nq = cogroup q by ('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Week', 'Snapshot_Date_Month', 'Snapshot_Date_Day') full, q_opps_unhealthy by ('Snapshot_Date_Year', 'Snapshot_Date_Quarter', 'Snapshot_Date_Week', 'Snapshot_Date_Month', 'Snapshot_Date_Day');\nq = foreach q generate coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') as 'Snapshot_Date_Year', coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') + \"0\" + coalesce(q.'Snapshot_Date_Quarter', q_opps_unhealthy.'Snapshot_Date_Quarter') as 'YearQuarterDate', coalesce(q.'Snapshot_Date_Week', q_opps_unhealthy.'Snapshot_Date_Week') as 'Snapshot_Date_Week', coalesce(q.'Snapshot_Date_Month', q_opps_unhealthy.'Snapshot_Date_Month') as 'Snapshot_Date_Month', coalesce(q.'Snapshot_Date_Day', q_opps_unhealthy.'Snapshot_Date_Day') as 'Snapshot_Date_Day', coalesce(unique(q.'Id'),0) as 'count_opps', coalesce(unique(q_opps_unhealthy.'Id'),0) as 'opps_unhealthy';\n\nq = filter q by 'YearQuarterDate' in {{coalesce(column(YearQuarterDate.selection, [\"YearQuarterDate\"]),'all').asString()}};\n\nq = group q by ('Snapshot_Date_Year', 'YearQuarterDate', 'Snapshot_Date_Week', 'Snapshot_Date_Month', 'Snapshot_Date_Day');\nq = foreach q generate 'Snapshot_Date_Year' + \"-\" +  'Snapshot_Date_Week' as 'year_week', 'Snapshot_Date_Year', 'Snapshot_Date_Month', 'Snapshot_Date_Day', first(count_opps) as 'count_opps', first(opps_unhealthy) as 'opps_unhealthy', 1-(sum(opps_unhealthy)/sum(count_opps)) as 'confidence', 1-(sum(sum(opps_unhealthy)) over ([..] partition by all)/sum(sum(count_opps)) over ([..] partition by all)) as 'overall_label', (1-(sum(sum(opps_unhealthy)) over ([..] partition by all)/sum(sum(count_opps)) over ([..] partition by all)))*100 as 'overall_line', sum(count_opps)-sum(opps_unhealthy) as opps_healthy;\nq = order q by ('year_week' asc, 'Snapshot_Date_Year' asc, 'Snapshot_Date_Month' asc, 'Snapshot_Date_Day' asc);\nq = limit q 2000;\n\n\n","receive