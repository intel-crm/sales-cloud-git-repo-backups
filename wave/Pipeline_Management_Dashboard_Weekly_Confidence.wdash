ales_group');\nq = foreach q generate coalesce(q.'Snapshot_Date_Year', q_opps_unhealthy.'Snapshot_Date_Year') as 'Snapshot_Date_Year', coalesce(q.'Snapshot_Date_Week', q_opps_unhealthy.'Snapshot_Date_Week') as 'Snapshot_Date_Week', coalesce(q.'opp_sales_group', q_opps_unhealthy.'opp_sales_group') as 'opp_sales_group', coalesce(unique(q.'Id'),0) as 'count_opps', coalesce(unique(q_opps_unhealthy.'Id'),0) as 'opps_unhealthy';\nq = group q by ('Snapshot_Date_Year', 'Snapshot_Date_Week', 'opp_sales_group');\nq = foreach q generate 'Snapshot_Date_Year', 'Snapshot_Date_Week', 'opp_sales_group', first(count_opps) as 'count_opps', first(opps_unhealthy) as 'opps_unhealthy', 1-(sum(opps_unhealthy)/sum(count_opps)) as 'confidence', 1-(sum(sum(opps_unhealthy)) over ([..] partition by all)/sum(sum(count_opps)) over ([..] partition by all)) as 'overall_label', (1-(sum(sum(opps_unhealthy)) over ([..] partition by all)/sum(sum(count_opps)) over ([..] partition by all)))*100 as 'overall_line';\nq = order q by ('Snapshot_Date_Year' asc, 'Snapshot_Date_Week' asc, 'opp_sales_group' asc);\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"vbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"s