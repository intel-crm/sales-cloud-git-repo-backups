tunity__c' in {{coalesce(column(Opportunity_Core_Opp_2.selection, [\"val\"]), 'all').asString()}};\r\nq = filter q by 'Core_Status__c' in {{coalesce(column(status_type.result, [\"Core_Status__c\"]),'all').asString()}};\r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"create_year_value\"]).asObject()}}' in {{coalesce(column(year_list_1.selection, [\"select_year\"]),'all').asString()}}; \r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"create_year_quarter_value\"]).asObject()}}' in {{coalesce(column(FicalCreatedDate_ord_1.selection, [\"quarter\"]),'all').asString()}}; \r\nq = filter q by 'StageDuration'>= {{cell(static_22.selection, 0, \"value\").asString()}};\r\nq = group q by ('Opportunity.Name', 'Opportunity.Owner.Name','Opportunity.Account.Name', 'core_kpi_date_short','Opportunity.StageName','StageDurationString','Push');\r\nq = foreach q generate 'Opportunity.Name'\r\n, 'Opportunity.Account.Name'\r\n, 'Opportunity.Owner.Name'\r\n, 'Opportunity.StageName'\r\n, sum('Core_KPI_Total_Price__c') as 'Unwtd Amt'\r\n, 'core_kpi_date_short','StageDurationString','Push';\r\nq = order q by ('Unwtd Amt' desc);\r\n\r\nq = group q by ('Opportunity.Name', 'Opportunity.Owner.Name','Opportunity.Account.Name', 'core_kpi_date_short','Opportunity.StageName','StageDurationString','Push');\r\nq = foreach q generate 'Opportunity.Name'\r\n, 'Opportunity.Account.Name'\r\n, 'Opportunity.Owner.Name'\r\n, 'Opportunity.StageName' as 'Stage'\r\n, max('Unwtd Amt') as 'Unwtd Amt'\r\n, 'core_kpi_date_short' as 'Decision Date','StageDurationString' as 'Days on Stage','Push' as 'Pushes' ;\r\nq = order q by ('Unwtd Amt' desc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":[],"custom