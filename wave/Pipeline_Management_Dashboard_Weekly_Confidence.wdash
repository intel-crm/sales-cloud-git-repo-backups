lters":true,"useGlobal":true,"visualizationParameters":{"options":{"legendWidth":95,"sqrt":true},"visualizationType":"stackvbar"}},"lens_8":{"broadcastFacet":true,"groups":[],"label":"lens_8","numbers":[],"query":"q = load \"OpportunityProductsManagerDataset\";\r\n\r\nq = filter q by '{{column(filter_oppty_roles.selection,[\"manager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(Manager_1.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \r\nq = filter q by  '{{column(filter_oppty_roles.selection,[\"rep_hierarchy\"]).asObject()}}'  in {{coalesce(column(filter_sales_reps.selection, [\"Name\"]),'all').asString()}};\r\n\r\n\r\n\r\nq = filter q by 'Core_At_Risk_Status__c' in {{coalesce(column(static_9.selection,  [\"display\"]),'all').asString()}};\r\n\r\n\r\nq = filter q by 'Core_At_Risk_Status__c' in {{coalesce(column(static_9.selection,  [\"display\"]),'all').asString()}};\r\nq= filter q by 'Core_Status__c' in {{coalesce(column(status_type.result, [\"Core_Status__c\"]),'all').asString()}};\r\nq = group q by ('Opportunity.Name', 'Opportunity.Owner.Name','Opportunity.Account.Name', 'core_kpi_date_short','Product2.Name','Opportunity.StageName','Core_Status__c');\r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"year_value\"]).asObject()}}' in {{coalesce(column(year_list_1.selection, [\"select_year\"]),'all').asString()}};\r\nq = filter q by 'Opportunity.Core_Opp_Strategic_Opportunity__c' in {{coalesce(column(Opportunity_Core_Opp_2.selection, [\"val\"]), 'all').asString()}};\r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"yearquarter_value\"]).asObject()}}' in {{coalesce(column(FicalCreatedDate_ord_1.selection, [\"quarter\"]),'all').asString()}};\r\nq = group q by ('Opportunity.Name', 'Opportunity.Owner.Name','Opportunity.Account.Name', 'core_kpi_date_short','Product2.Name','Opportunity.StageName','Core_Status__c');\r\n\r\nq = foreach q generate 'Opportunity.Name', 'Opportunity.Account.Name','Opportunity.Owner.Name' , 'Opportunity.StageName' as 'Stage','Core_Status__c' as 'Product Status','core_kpi_date_short' as 'Decision Date','Product2.Name' as 'Product', number_to_string(sum('Core_KPI_Total_Price__c'),\"$#,###\") as 'Unwtd Amt',sum('Core_KPI_Total_Price__c') as 'TotalAmt',sum('Quantity') as 'Qty';\r\n\r\nq = group q by ('Opportunity.Name', 'Opportunity.Owner.Name','Opportunity.Account.Name', 'Decision Date','Product','Stage','Product Status');\r\n\r\nq = foreach q generate 'Opportunity.Name', 'Opportunity.Account.Name','Opportunity.Owner.Name' , 'Stage','Product Status','Decision Date','Product', max('Unwtd Amt') as 'Unwtd Amt',max('TotalAmt') as 'TotalAmt',max('Qty') as 'Qty';\r\nq = order q by ('TotalAmt' desc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"mode":"fittocontainer","numberOfFrozenColumns":0,"numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":12},"type":"table"}},"static_9":{"broadcastFacet":true,"columns":{"display":{"type":"string"},"label":{"type":"string"}},"label":"At Risk","selectMode":"single","start":"{\"display\":[]}","type":"staticflex","values":["{\"display\":\"In-Progress\",\"label\":\"At Risk\"}"]},"lens_6":{"broadcastFacet":true,"groups":[],"label":"lens_6","numbers":[],"query":"q = load \"OpportunityProductsManagerDataset\";\r\n\r\n q = filter q by '{{column(filter_oppty_roles.selection,[\"manager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(Manager_1.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \r\n q = filter q by  '{{column(filter_oppty_roles.selection,[\"rep_hierarchy\"]).asObject()}}'  in {{coalesce(column(filter_sales_reps.selection, [\"Name\"]),'all').asString()}};\r\n\r\n\r\nq = filter q by 'Core_At_Risk_Status__c' in {{coalesce(column(static_9.selection,  [\"display\"]),'all').asString()}};\r\n\r\n\r\nq = filter q by 'Core_At_Risk_Status__c' in {{coalesce(column(static_9.selection,  [\"display\"]),'all').asString()}};\r\nq = filter q by 'Opportunity.StageFunnel' in [\"2 - Qualify\", \"3 - Define\", \"4 - Develop\", \"5 - Design\", \"6 - Design Win\", \"7 - Production Win\"];q = filter q by 'Opportunity.Core_Opp_Strategic_Opportunity__c' in {{coalesce(column(Opportunity_Core_Opp_2.selection, [\"val\"]), 'all').asString()}};q = filter q by 'Opportunity.Core_Support_Completed__c' == \"false\"; q = filter q by 'Core_At_Risk__c' == \"true\"; q = filter q by 'Core_At_Risk_Status__c' in [\"In-Progress\",\"New\"];q = filter q by 'Core_Status__c' in [\"On Hold\",\"Pending\",\"Win Submitted\"];q = filter q by '{{column(Calendar_Selector_1.selection,[\"year_value\"]).asObject()}}' in {{coalesce(column(year_list_1.selection, [\"select_year\"]),'all').asString()}}; q = filter q by '{{column(Calendar_Selector_1.selection,[\"yearquarter_value\"]).asObject()}}' in {{coalesce(column(FicalCreatedDate_ord_1.selection, [\"quarter\"]),'all').asString()}}; \r\n\r\nq = group q by all;\r\nq = foreach q generate unique('OpportunityId') as 'Total oppty count';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_3":{"broadcastFacet":true,"groups":[],"label":"lens_3","numbers":[],"query":"q = load \"KPIProdOpportunitiesAZManagerDataSet\";\r\n\r\n\r\n\r\nq = filter q by '{{column(filter_oppty_roles.selection,[\"kpimanager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(Manager_1.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \r\nq = filter q by  '{{column(filter_oppty_roles.selection,[\"kpirep_hierarchy\"]).asObject()}}'  in {{coalesce(column(filter_sales_reps.selection, [\"Name\"]),'all').asString()}};\r\nq = filter q by 'Core_IsActive__c' == \"true\";\r\nq = filter q by 'strategickey.Core_Opp_Strategic_Opportunity__c' in {{coalesce(column(Opportunity_Core_Opp_2.selection, [\"val\"]), 'all').asString()}};\r\nq = filter q by 'kpi_type_group' in {{coalesce(column(kpi_type_2.selection, [\"kpi_type_group\"]),'all').asString()}};\r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"kpi_year_value\"]).asObject()}}' in {{coalesce(column(year_list_1.selection, [\"select_year\"]),'all').asString()}}; \r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"kpi_year_quarter_value\"]).asObject()}}' in {{coalesce(column(FicalCreatedDate_ord_1.selection, [\"quarter\"]),'all').asString()}};\r\nq = filter q by 'kpi_name' in {{coalesce(column(kpi_name_2.selection, [\"kpi_name\"]),'all').asString()}};\r\n  \r\nq = filter q by 'kpi_is_pending' == \"true\";  \r\n\r\nq = filter q by  '{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' in {{coalesce(column(KPIsMetricsChartStac_2.selection, [\"KPI Name/Account\"]),'all').asString()}}; \r\nq = filter q by 'o.Opportunity.Owner.Name' in all;\r\n\r\nresult = group q by ('kpi_name', 'kpi_type', 'kpi_type_group','o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'kpi_date','o.stage_name',\r\n'o.pipeline_health', 'o.past_due', 'o.inactive', 'o.low_velocity');\r\n\r\nresult = foreach result generate \r\n        result.'kpi_name',\r\n        result.'o.account_name',\r\n        result.'o.opportunity_name',\r\n        result.'o.Opportunity.Owner.Name',\r\n        result.'kpi_date',\r\n        result.'o.stage_name',\r\n        result.'o.pipeline_health',\r\n        result.'o.past_due',\r\n        result.'o.inactive',\r\n        result.'o.low_velocity',\r\nresult.'kpi_type', result.'kpi_type_group',\r\nsum(result.'kpi_pending_amt') as 'kpi_pending_amt',\r\nsum(result.'kpi_won_amt') as 'kpi_won_amt';\r\n\r\nresult = group result by ('kpi_name', 'kpi_type', 'kpi_type_group', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'kpi_date','o.stage_name',\r\n'o.pipeline_health', 'o.past_due', 'o.inactive', 'o.low_velocity');\r\n\r\nresult = foreach result generate \r\n        result.'kpi_name' as 'KPI Name',\r\n        result.'o.account_name' as 'Account Name',\r\n        result.'o.opportunity_name' as 'o.opportunity_name', \r\n        result.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result.'kpi_date' as 'Decision Date',\r\n        result.'o.stage_name' as 'Stage',\r\n        result.'o.pipeline_health' as 'Pipeline Health',  \r\n        result.'o.past_due' as 'Past Due', \r\n        result.'o.inactive' as 'Inactive',\r\n        result.'o.low_velocity' as 'Low Velocity',\r\nresult.'kpi_type' as 'kpi_type', result.'kpi_type_group' as 'kpi_type_group',\r\nmax(result.'kpi_pending_amt') as 'kpi_pending_amt',0 as 'pending_product_g_kpi_qty', 0 as 'won_product_g_kpi_qty',\r\nmax(result.'kpi_won_amt') as 'kpi_won_amt',\r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt,0 as 'pending_weight';\r\n\r\nresult1 = group q by ('kpi_name', 'kpi_type', 'kpi_type_group','o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'kpi_date', 'o.stage_name',\r\n'o.pipeline_health', 'o.past_due', 'o.inactive', 'o.low_velocity' );\r\n\r\nresult1 = foreach result1 generate \r\n        result1.'kpi_name' as 'KPI Name',\r\n        result1.'o.account_name' as 'Account Name',\r\n        result1.'o.opportunity_name' as 'o.opportunity_name', \r\n        result1.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result1.'kpi_date' as 'Decision Date',\r\n        result1.'o.stage_name' as 'Stage',\r\n        result1.'o.pipeline_health' as 'Pipeline Health', \r\n        result1.'o.past_due' as 'Past Due', \r\n        result1.'o.inactive' as 'Inactive',\r\n        result1.'o.low_velocity' as 'Low Velocity',\r\nresult1.'kpi_type' as 'kpi_type', result1.'kpi_type_group' as 'kpi_type_group',\r\n0 as 'kpi_pending_amt',\r\n0 as 'won_product_g_kpi_qty',unique(kpi_pending_oppid_product_g) as 'pending_product_g_kpi_qty',\r\n0 as 'kpi_won_amt',\r\nunique(result1.'pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt,0 as 'pending_weight';\r\n\r\n\r\nresult2 = group q by ('kpi_name', 'kpi_type', 'kpi_type_group','o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'kpi_date','o.stage_name',\r\n'o.pipeline_health', 'o.past_due', 'o.inactive', 'o.low_velocity' );\r\n\r\nresult2 = foreach result2 generate \r\n        result2.'kpi_name' as 'KPI Name',\r\n        result2.'o.account_name' as 'Account Name',\r\n        result2.'o.opportunity_name' as 'o.opportunity_name', \r\n        result2.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result2.'kpi_date' as 'Decision Date',\r\n        result2.'o.stage_name' as 'Stage',\r\n        result2.'o.pipeline_health' as 'Pipeline Health', \r\n        result2.'o.past_due' as 'Past Due', \r\n        result2.'o.inactive' as 'Inactive',\r\n        result2.'o.low_velocity' as 'Low Velocity',\r\nresult2.'kpi_type' as 'kpi_type', result2.'kpi_type_group' as 'kpi_type_group',\r\n0 as 'kpi_pending_amt',unique(kpi_won_oppid_product_g) as 'won_product_g_kpi_qty',\r\n0 as 'pending_product_g_kpi_qty',\r\n0 as 'kpi_won_amt',\r\n0 as pending_opportunity_cnt,\r\nunique(result2.'won_opportunity_id') as win_opportunity_cnt;result3 =  foreach q generate q.'kpi_name' as 'kpi_name', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name','kpi_date',q.'o.stage_name' as 'stage_name',\r\n        q.'o.pipeline_health' as 'pipeline_health', \r\n        q.'o.past_due' as 'past_due', \r\n        q.'o.inactive' as 'inactive',\r\n        q.'o.low_velocity' as 'low_velocity',q.'kpi_type' as 'kpi_type', q.'kpi_type_group' as 'kpi_type_group', ('kpi_pending_amt'*'o.Opportunity.Probability'/100) as 'pending_weight';result4 = group result3 by ('kpi_name', 'kpi_type', 'kpi_type_group','o.opportunity_name',  'o.account_name', 'o.Opportunity.Owner.Name','kpi_date','stage_name',\r\n'pipeline_health', 'past_due', 'inactive', 'low_velocity');result4= foreach result4 generate result4.'kpi_name' as 'KPI Name', 'o.account_name'  as 'Account Name','o.opportunity_name' as 'o.opportunity_name', 'o.Opportunity.Owner.Name' as 'Opportunity Owner','kpi_date' as 'Decision Date',\r\n        result4.'stage_name' as 'Stage',\r\n        result4.'past_due' as 'Past Due', result4.'pipeline_health' as 'Pipeline Health',\r\n        result4.'inactive' as 'Inactive',\r\n        result4.'low_velocity' as 'Low Velocity',result4.'kpi_type' as 'kpi_type', result4.'kpi_type_group' as 'kpi_type_group', 0 as 'kpi_pending_amt', 0 as 'pending_product_g_kpi_qty',0 as 'won_product_g_kpi_qty', 0 as 'kpi_won_amt',0 as pending_opportunity_cnt,0 as win_opportunity_cnt ,sum('pending_weight') as 'pending_weight';\r\n\r\n\r\nresult5 = union result1, result2,result4, result;\r\n\r\n\r\n\r\nresult5 = group result5 by ('KPI Name', 'kpi_type','kpi_type_group','o.opportunity_name',  'Account Name',  'Opportunity Owner', 'Decision Date', 'Stage', 'Pipeline Health',  'Past Due',  'Inactive', 'Low Velocity' );\r\n\r\nresult5 = foreach result5 generate\r\n        'kpi_type', 'kpi_type_group',\r\n        'KPI Name',\r\n        'Account Name',\r\n        'o.opportunity_name',\r\n        'Opportunity Owner',\r\n        'Decision Date',\r\n        'Stage',\r\n        'Pipeline Health', \r\n        'Past Due', \r\n        'Inactive',\r\n        'Low Velocity',\r\n\r\nmax('kpi_pending_amt') as 'kpi_pending_amt',\r\nmax(result5.pending_product_g_kpi_qty) as pending_product_g_kpi_qty,\r\nmax(result5.won_product_g_kpi_qty) as won_product_g_kpi_qty,\r\nmax(result5.kpi_won_amt) as kpi_won_amt,\r\nmax(result5.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result5.win_opportunity_cnt) as win_opportunity_cnt,max(pending_weight) as 'pending_weight';\r\n\r\nresult6 = foreach result5 generate\r\n        'o.opportunity_name',\r\n        'KPI Name',\r\n        'Account Name',\r\n        'Opportunity Owner',\r\n        'Decision Date',\r\n        'Stage', (case when result5.'kpi_type_group' == \"Pipeline $\" &&  \"Unwtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then number_to_string(result5.kpi_pending_amt,\"#,###\") when result5.'kpi_type_group' == \"Pipeline $\" &&  \"Wtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then number_to_string(result5.pending_weight,\"#,###\") when result5.'kpi_type' == \"Salesforce Opp KPI Product Group Count\" then number_to_string(result5.pending_product_g_kpi_qty,\"#,###\") when result5.'kpi_type_group' ==\"Pipeline Count (#)\" then number_to_string(result5.pending_opportunity_cnt,\"#,###\")  end) as 'Pending',\r\n        \"■\" as  'Health Status', \r\n        case when 'Pipeline Health'== \"false\" then \"#66CC00\" else \"#CC0000\" end as 'ph_color',\r\n        \"■\" as  'Past Due', \r\n        case when 'Past Due'== \"Not Past Due\" then \"#66CC00\" else \"#CC0000\" end as 'pd_color',\r\n        \"■\" as  'Inactive', \r\n        case when 'Inactive'== \"false\" then \"#66CC00\" else \"#CC0000\" end as 'i_color',\r\n        \"■\" as  'Low Velocity', \r\n        case when 'Low Velocity'== \"false\" then \"#66CC00\" else \"#CC0000\" end as 'lq_color',\r\n(case when result5.'kpi_type_group' == \"Pipeline $\" &&  \"Unwtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result5.kpi_pending_amt when result5.'kpi_type_group' == \"Pipeline $\" &&  \"Wtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result5.pending_weight when result5.'kpi_type' == \"Salesforce Opp KPI Product Group Count\" then result5.pending_product_g_kpi_qty  when result5.'kpi_type_group' ==\"Pipeline Count (#)\" then result5.pending_opportunity_cnt\r\nelse 0 end) as 'Pending_formmated';result7 = group result6 by ('o.opportunity_name','KPI Name','Account Name','Opportunity Owner','Decision Date','Stage', 'Pending', 'Health Status','Past Due', 'Inactive', 'Low Velocity', 'Pending_formmated','ph_color','pd_color','i_color','lq_color');result7 = foreach result7 generate 'o.opportunity_name','KPI Name','Account Name','Opportunity Owner','Decision Date','Stage', 'Pending','Health Status', 'Past Due', 