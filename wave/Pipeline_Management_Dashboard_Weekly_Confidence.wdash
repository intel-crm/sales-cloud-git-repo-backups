ts":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}}},"type":"chart"}},"KPIsMetricsChartStac_2":{"broadcastFacet":false,"groups":[],"label":"KPIsMetricsChartStackedHorizontal","numbers":[],"query":"q = load \"KPIProdOpportunitiesAZManagerDataSet\"; \r\n\r\n\r\nq = filter q by '{{column(filter_oppty_roles.selection,[\"kpimanager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(Manager_1.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \r\nq = filter q by  '{{column(filter_oppty_roles.selection,[\"kpirep_hierarchy\"]).asObject()}}'  in {{coalesce(column(filter_sales_reps.selection, [\"Name\"]),'all').asString()}};\r\nq = filter q by 'Core_IsActive__c' == \"true\"; \r\nq = filter q by 'strategickey.Core_Opp_Strategic_Opportunity__c' in {{coalesce(column(Opportunity_Core_Opp_2.selection, [\"val\"]), 'all').asString()}};\r\nq = filter q by 'kpi_name' in {{coalesce(column(kpi_name_2.selection, [\"kpi_name\"]),'all').asString()}};q = filter q by '{{column(Calendar_Selector_1.selection,[\"kpi_year_value\"]).asObject()}}' in {{coalesce(column(year_list_1.selection, [\"select_year\"]),'all').asString()}}; q = filter q by '{{column(Calendar_Selector_1.selection,[\"kpi_year_quarter_value\"]).asObject()}}' in {{coalesce(column(FicalCreatedDate_ord_1.selection, [\"quarter\"]),'all').asString()}};  \r\n\r\n\r\nresult = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type','kpi_type_group', 'kpi_is_won'); \r\n\r\nresult = foreach result generate result.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', 'kpi_is_won', \r\nresult.'kpi_type' as 'kpi_type', result.'kpi_type_group' as 'kpi_type_group',\r\nsum(result.'kpi_pending_amt') as 'kpi_pending_amt',\r\nsum(result.'kpi_won_amt') as 'kpi_won_amt', 0  as won_product_g_kpi_qty, 0 as pending_product_g_kpi_qty, \r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt, 0 as 'won_weight',0 as 'pending_weight';\r\n\r\nresult1 = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type', 'kpi_type_group','kpi_is_won');\r\n\r\nresult1 = foreach result1 generate result1.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', \r\nresult1.'kpi_type' as 'kpi_type', result1.'kpi_type_group' as 'kpi_type_group', 'kpi_is_won', \r\n0 as 'kpi_pending_amt', \r\n0 as 'kpi_won_amt', 0 as 'won_product_g_kpi_qty', unique(result1.'kpi_pending_oppid_product_g') as 'pending_product_g_kpi_qty', \r\nunique(result1.'pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt, 0 as 'won_weight', 0 as 'pending_weight'; \r\n\r\n\r\nresult2 = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type', 'kpi_type_group','kpi_is_won');\r\n\r\nresult2 = foreach result2 generate result2.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', 'kpi_is_won', \r\nresult2.'kpi_type' as 'kpi_type', result2.'kpi_type_group' as 'kpi_type_group',\r\n0 as 'kpi_pending_amt', \r\n0 as 'kpi_won_amt',0 as 'pending_product_g_kpi_qty', unique(kpi_won_oppid_product_g) as 'won_product_g_kpi_qty', \r\n0 as pending_opportunity_cnt,\r\nunique(result2.'won_opportunity_id') as win_opportunity_cnt, 0 as 'won_weight',0 as 'pending_weight'; result3 = foreach q generate q.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', \r\nq.'kpi_type' as 'kpi_type', q.'kpi_type_group' as 'kpi_type_group','kpi_is_won',('kpi_won_amt'*'o.Opportunity.Probability'/100) as 'won_weight',('kpi_pending_amt'*'o.Opportunity.Probability'/100) as 'pending_weight';result4 = group result3 by ('kpi_name', 'kpi_type', 'kpi_type_group','kpi_is_won');result4 = foreach result4 generate result4.'kpi_name' as 'kpi_name', \r\nresult4.'kpi_type' as 'kpi_type', result4.'kpi_type_group' as 'kpi_type_group','kpi_is_won', 0 as 'kpi_pending_amt', 0 as 'kpi_won_amt',0 as 'won_product_g_kpi_qty', 0 as 'pending_product_g_kpi_qty',0 as pending_opportunity_cnt,0 as win_opportunity_cnt ,sum('won_weight') as 'won_weight',sum(pending_weight)as 'pending_weight';\r\n\r\n\r\nresult5 = union result1, result2,result4, result;\r\nresult5 = group result5 by ('kpi_name', 'kpi_type', 'kpi_type_group', 'kpi_is_won');\r\nresult5 = foreach result5 generate result5.kpi_name as kpi_name, 'kpi_is_won', \r\nresult5.kpi_type as kpi_type, result5.'kpi_type_group' as 'kpi_type_group',\r\nmax('kpi_pending_amt') as 'kpi_pending_amt', \r\nmax(result5.kpi_won_amt) as kpi_won_amt, max(result5.won_product_g_kpi_qty) as 'won_product_g_kpi_qty', max(result5.pending_product_g_kpi_qty) as 'pending_product_g_kpi_qty', \r\nmax(result5.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result5.win_opportunity_cnt) as win_opportunity_cnt, max('won_weight') as 'won_weight',max('pending_weight') as 'pending_weight';\r\n\r\n\r\n result6 = filter result5 by 'kpi_is_won' == \"true\";   result6 = foreach result6 generate result6.'kpi_name' as 'KPI Name/Account',(case when result6.'kpi_type_group' == \"Pipeline $\" &&  \"Unwtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result6.kpi_won_amt when result6.'kpi_type_group' == \"Pipeline $\" &&  \"Wtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result6.'won_weight' when result6.'kpi_type' == \"Salesforce Opp KPI Product Group Count\" then result6.won_product_g_kpi_qty  when result6.'kpi_type_group' == \"Pipeline Count (#)\" then result6.win_opportunity_cnt else 0 end) as 'KPI',\r\n\"1 - Won KPI\" as 'kpi_type'; result7 = filter result5 by 'kpi_is_won' == \"false\"; result7 = f