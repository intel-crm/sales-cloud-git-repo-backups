n\r\n\r\nq = filter q by 'Core_At_Risk_Status__c' in {{coalesce(column(static_9.selection,  [\"display\"]),'all').asString()}};\r\nq = filter q by 'Opportunity.Core_Opp_Strategic_Opportunity__c' in {{coalesce(column(Opportunity_Core_Opp_2.selection, [\"val\"]), 'all').asString()}};\r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"year_value\"]).asObject()}}' in {{coalesce(column(year_list_1.selection, [\"select_year\"]),'all').asString()}};\r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"yearquarter_value\"]).asObject()}}' in {{coalesce(column(FicalCreatedDate_ord_1.selection, [\"quarter\"]),'all').asString()}};  \r\nq = filter q by 'Core_At_Risk_Status__c' in [\"In-Progress\",\"New\"] && 'Opportunity.StageName' in [\"Define\", \"Design\", \"Design Win\", \"Develop\", \"Production Win\", \"Qualify\"] && 'Opportunity.Core_Support_Completed__c' != \"true\" && 'Core_At_Risk__c' == \"true\" && 'Core_Status__c' in [\"On Hold\", \"Pending\", \"Win Submitted\"];\r\nq = group q by ('Opportunity.Name', 'Opportunity.Owner.Name','Opportunity.Account.Name', 'core_kpi_date_short','Core_Risk_Create_Date__c','Opportunity.Core_Opportunity_Products__c','Core_Risk_Priority__c','Core_At_Risk_Status__c','Core_Risk_Create_Date__c_Year', 'Core_Risk_Create_Date__c_Month', 'Core_Risk_Create_Date__c_Day');\r\nq = group q by ('Opportunity.Name', 'Opportunity.Owner.Name','Opportunity.Account.Name', 'core_kpi_date_short','Core_Risk_Create_Date__c','Opportunity.Core_Opportunity_Products__c','Core_Risk_Priority__c','Core_At_Risk_Status__c','Core_Risk_Create_Date__c_Year', 'Core_Risk_Create_Date__c_Month', 'Core_Risk_Create_Date__c_Day');\r\nq = foreach q generate 'Opportunity.Name', 'Opportunity.Account.Name','Opportunity.Owner.Name', 'core_kpi_date_short','Core_Risk_Create_Date__c_Month'+\"/\"+'Core_Risk_Create_Date__c_Day'+\"/\"+'Core_Risk_Create_Date__c_Year' as 'Risk Created Date','Opportunity.Core_Opportunity_Products__c',sum('Quantity') as 'Qty','Core_Risk_Priority__c','Core_At_Risk_Status__c',number_to_string(sum('Core_KPI_Total_Price__c'),\"$#,###\") as 'Unwtd Amt',sum('Core_KPI_Total_Price__c') as 'TotalAmt';\r\n\r\nq = group q by ('Opportunity.Name', 'Opportunity.Owner.Name','Opportunity.Account.Name', 'core_kpi_date_short','Risk Created Date','Opportunity.Core_Opportunity_Products__c','Core_Risk_Priority__c','Core_At_Risk_Status__c');\r\nq = foreach q generate 'Opportunity.Name', 'Opportunity.Account.Name','Opportunity.Owner.Name', 'core_kpi_date_short' as 'Decision Date','Risk Created Date','Opportunity.Core_Opportunity_Products__c' as 'Product',max('Qty') as 'Qty','Core_Risk_Priority__c' as 'Risk Priority','Core_At_Risk_Status__c' as 'Risk Status',max('Unwtd Amt') as 'Unwtd Amt',max('TotalAmt') as 'TotalAmt';\r\nq = order q by ('TotalAmt' desc);","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":150,"minColumnWidth":50,"mode":"variable","numberOfFrozenColumns":0,"numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"HealthyOpportunities_19":{"broadcastFacet":true,"groups":[],"label":"HealthyOpportunities","numbers":[],"query":"q = load \"ConfidenceOpportunityProductsManagerDataSet\";\nq = filter q by '{{column(filter_oppty_roles.selection,[\"confidencemanager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(Manager_1.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \nq = filter q by  '{{column(filter_oppty_roles.selection,[\"confidencerep_hierarchy\"]).asObject()}}'  in {{coalesce(column(filter_sales_reps.selection, [\"Name\"]),'all').asString()}};\n\nq = filter q by 'op.Core_Status__c' != \"Cancelled\";\nq = filter q by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"3 quarters ago\"..\"current quarter\"];\n q = filter q by 'strategic_opportunity' in {{coalesce(column(Opportunity_Core_Opp_2.selection, [\"val\"]), 'all').asString()}};\nq = foreach q generate 'OpportunityProducts.Name' as 'OpportunityProducts.Name', \n'Name' as 'Name', \n'Id' as 'Id', 'OpportunityProducts.Product2Id' as 'Product2Id'\n, 'unhealthy_pushes'\n\n, 'sales_group';\n\nq1 = group q by ('Id', 'unhealthy_pushes', 'sales_group' );\nq1 = foreach q1 generate 'Id'\n, max('unhealthy_pushes') as 'unhealthy_pushes'\n, 'sales_group' ;\n\n\n\nq1 = group q1 by all;\nq2 = foreach q1 generate \n  sum('unhealthy_pushes')  as 'unhealthy_pushes';\n\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"HealthyOpportunities_16":{"broadcastFacet":true,"groups":[],"label":"HealthyOpportunities_SalesGroups","numbers":[],"query":"q = load \"ConfidenceOpportunityProductsManagerDataSet\";\nq = filter q by '{{column(filter_oppty_roles.selection,[\"confidencemanager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(Manager_1.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \nq = filter q by  '{{column(filter_oppty_roles.selection,[\"confidencerep_hierarchy\"]).asObject()}}'  in {{coalesce(column(filter_sales_reps.selection, [\"Name\"]),'all').asString()}};\n\nq = filter q by 'op.Core_Status__c' != \"Cancelled\";\nq = filter q by date('op.Core_KPI_Date__c_Year', 'op.Core_KPI_Date__c_Month', 'op.Core_KPI_Date__c_Day') in [\"3 quarters ago\"..\"current quarter\"];\n q = filter q by 'strategic_opportunity' in {{coalesce(column(Opportunity_Core_Opp_2.selection, [\"val\"]), 'all').asString()}};\nq = foreach q generate 'OpportunityProducts.Name' as 'OpportunityProducts.Name', \n'Name' as 'Name', \n'Id' as 'OpportunityProducts.OpportunityId', 'OpportunityProducts.Product2Id' as 'OpportunityProducts.Product2Id'\n, 'unhealthy_pastdue'\n, 'sales_group';\nq1 = group q by ('OpportunityProducts.OpportunityId', 'unhealthy_pastdue', 'sales_group');\nq1 = foreach q1 generate 'OpportunityProducts.OpportunityId'\n, max('unhealthy_pastdue') as 'unhealthy_pastdue', 'sales_group' as 'sales_group';\nq2 = group q1 by 'sales_group';\nq3 = foreach q2 generate \n 'sales_group' \n , sum('unhealthy_pastdue') as 'unhealthy_pastdue';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[]","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"fit","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"vbar