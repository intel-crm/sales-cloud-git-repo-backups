tion, [\"select_year\"]),'all').asString()}}; \r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"kpi_year_quarter_value\"]).asObject()}}' in {{coalesce(column(FicalCreatedDate_ord_1.selection, [\"quarter\"]),'all').asString()}}; \r\nq = filter q by 'kpi_name' in {{coalesce(column(kpi_name_2.selection, [\"kpi_name\"]),'all').asString()}};  \r\n  \r\nq = filter q by 'kpi_name' in {{coalesce(column(kpi_name_2.selection, [\"kpi_name\"]),'all').asString()}};  \r\nq = filter q by 'kpi_is_won' == \"true\"; \r\nq = filter q by  '{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' in {{coalesce(column(KPIsMetricsChartStac_2.selection, [\"KPI Name/Account\"]),'all').asString()}};  q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_manager\"]).asObject()}}' in {{coalesce(column(Sales_Manager_Filter_8.selection, [\"Name\"]),'all').asString()}}; q = filter q by '{{column(Opportunity_Role_1.selection,[\"sales_rep\"]).asObject()}}' in {{coalesce(column(Sales_Rep_Filter_1.selection, [\"Name\"]),'all').asString()}}; \r\n\r\nresult = group q by ('kpi_name', 'kpi_type', 'kpi_type_group', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'kpi_date' );\r\n\r\nresult = foreach result generate \r\n        result.'kpi_name' as 'KPI Name',\r\n        result.'o.account_name' as 'o.account_name',\r\n        result.'o.opportunity_name' as 'o.opportunity_name', \r\n        result.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result.'kpi_date' as 'KPI Date',\r\nresult.'kpi_type' as 'kpi_type', result.'kpi_type_group' as 'kpi_type_group', \r\nsum(result.'kpi_pending_amt') as 'kpi_pending_amt', \r\n0 as 'pending_product_g_kpi_qty', 0 as 'won_product_g_kpi_qty', \r\nsum(result.'kpi_won_amt') as 'kpi_won_amt',\r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt,0 as won_weight;\r\n\r\nresult = group q by ('kpi_name', 'kpi_type', 'kpi_type_group', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'kpi_date' );\r\n\r\nresult = foreach result generate \r\n        result.'kpi_name' as 'KPI Name',\r\n        result.'o.account_name' as 'o.account_name',\r\n        result.'o.opportunity_name' as 'o.opportunity_name', \r\n        result.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result.'kpi_date' as 'KPI Date',\r\nresult.'kpi_type' as 'kpi_type', result.'kpi_type_group' as 'kpi_type_group', \r\nmax(result.'kpi_pending_amt') as 'kpi_pending_amt', \r\n0 as 'pending_product_g_kpi_qty', 0 as 'won_product_g_kpi_qty', \r\nmax(result.'kpi_won_amt') as 'kpi_won_amt',\r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt,0 as won_weight;\r\n\r\nresult1 = group q by ('kpi_name', 'kpi_type', 'kpi_type_group', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'kpi_date' );\r\n\r\nresult1 = foreach result1 generate \r\n        result1.'kpi_name' as 'KPI Name',\r\n        result1.'o.account_name' as 'o.account_name',\r\n        result1.'o.opportunity_name' as 'o.opportunity_name', \r\n        result1.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result1.'kpi_date' as 'KPI Date',\r\nresult1.'kpi_type' as 'kpi_type', result1.'kpi_type_group' as 'kpi_type_group', \r\n0 as 'kpi_pending_amt', \r\n0 as 'pending_product_g_kpi_qty', unique(kpi_won_oppid_product_g) as 'won_product_g_kpi_qty', \r\n0 as 'kpi_won_amt',\r\nunique(result1.'pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt,0 as won_weight;\r\n\r\n\r\nresult2 = group q by ('kpi_name', 'kpi_type', 'kpi_type_group', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name', 'kpi_date');\r\n\r\nresult2 = foreach result2 generate \r\nresult2.'kpi_name' as 'KPI Name',\r\n        result2.'o.account_name' as 'o.account_name',\r\n        result2.'o.opportunity_name' as 'o.opportunity_name', \r\n        result2.'o.Opportunity.Owner.Name' as 'Opportunity Owner',\r\n        result2.'kpi_date' as 'KPI Date',\r\nresult2.'kpi_type' as 'kpi_type', result2.'kpi_type_group' as 'kpi_type_group',\r\n0 as 'kpi_pending_amt', unique(kpi_pending_oppid_product_g) as 'pending_product_g_kpi_qty', \r\n0 as 'won_product_g_kpi_qty', \r\n0 as 'kpi_won_amt',\r\n0 as pending_opportunity_cnt,\r\nunique(result2.'won_opportunity_id') as win_opportunity_cnt;result3 =  foreach q generate q.'kpi_name' as 'kpi_name', 'o.opportunity_name',  'o.account_name',  'o.Opportunity.Owner.Name','kpi_date',q.'kpi_type' as 'kpi_type', q.'kpi_type_group' as 'kpi_type_group', ('kpi_won_amt'*'o.Opportunity.Probability'/100) as 'won_weight';result4 = group result3 by ('kpi_name', 'kpi_type', 'kpi_type_group','o.opportunity_name',  'o.account_name', 'o.Opportunity.Owner.Name','kpi_date');result4= foreach result4 generate result4.'kpi_name' as 'KPI Name', 'o.account_name'  as 'o.account_name','o.opportunity_name' as 'o.opportunity_name', 'o.Opportunity.Owner.Name' as 'Opportunity Owner','kpi_date' as 'KPI Date',result4.'kpi_type' as 'kpi_type', result4.'kpi_type_group' as 'kpi_type_group', 0 as 'kpi_pending_amt', 0 as 'pending_product_g_kpi_qty',0 as 'won_product_g_kpi_qty', 0 as 'kpi_won_amt',0 as pending_opportunity_cnt,0 as win_opportunity_cnt ,sum('won_weight') as 'won_weight';\r\n\r\n\r\nresult5 = union result1, result2,result4, result;\r\n\r\n\r\n\r\nresult5 = group result5 by ('KPI Name', 'kpi_type', 'kpi_type_group','o.opportunity_name',  'o.account_name',  'Opportunity Owner', 'KPI Date' );\r\n\r\nresult5 = foreach result5 generate \r\n        'kpi_type','kpi_type_group',\r\n        'KPI Name',\r\n        'o.account_name',\r\n        'o.opportunity_name', \r\n        'Opportunity Owner',\r\n        'KPI Date',\r\n\r\n        \r\nmax('kpi_pending_amt') as 'kpi_pending_amt', \r\nmax(result5.pending_product_g_kpi_qty) as pending_product_g_kpi_qty, \r\nmax(result5.won_product_g_kpi_qty) as won_product_g_kpi_qty, \r\nmax(result5.kpi_won_amt) as kpi_won_amt,\r\nmax(result5.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result5.win_opportunity_cnt) as win_opportunity_cnt, max(result5.won_weight) as 'won_weight';\r\n\r\nresult6 = foreach result5 generate \r\n        'o.opportunity_name',  \r\n        'o.account_name',\r\n        'Opportunity Owner',\r\n        'KPI Date' as 'Decision Date',\r\n        'KPI Name',(case when result5.'kpi_type_group' == \"Pipeline $\" &&  \"Unwtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result5.kpi_won_amt when result5.'kpi_type_group' == \"Pipeline $\" &&  \"Wtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result5.won_weight when result5.'kpi_type' == \"Salesforce Opp KPI Product Group Count\" then result5.won_product_g_kpi_qty when result5.'kpi_type_group'== \"Pipeline Count (#)\" then result5.win_opportunity_cnt  else 0 end) as 'Won_formmated',(case when result5.'kpi_type_group' == \"Pipeline $\" &&  \"Unwtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then number_to_string(result5.kpi_won_amt,\"#,###\") when result5.'kpi_type_group' == \"Pipeline $\" &&  \"Wtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then number_to_string(result5.won_weight,\"#,###\") when result5.'kpi_type' == \"Salesforce Opp KPI Product Group Count\" then number_to_string(result5.won_product_g_kpi_qty,\"#,###\")  when result5.'kpi_type_group'== \"Pipeline Count (#)\" then number_to_string(result5.win_opportunity_cnt,\"#,###\") else number_to_string(0,\"#,###\") end) as 'Won'; result6 = order result6 by 'Won_formmated' desc","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":[],"customBulkActions":[],"hea