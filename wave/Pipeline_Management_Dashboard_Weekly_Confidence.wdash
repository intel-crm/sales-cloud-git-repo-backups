reatedD_2":{"broadcastFacet":true,"datasets":[{"name":"OpportunityProducts_UAT"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Opportunity.CreatedDate\"],\"filters\":[[\"Opportunity.CloseDate\",[[1388534400000,1483142400000]],\">=<=\"]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","start":"[[[\"year\",-6],[\"year\",6]]]","type":"aggregateflex","useExternalFilters":true,"useGlobal":false,"visualizationParameters":{}},"KPIsMetrics_1":{"broadcastFacet":true,"groups":[],"label":"KPIsMetrics","numbers":[],"query":"\r\nq = load \"KPIProdOpportunitiesAZManagerDataSet\"; \r\n\r\n\r\nq = filter q by '{{column(filter_oppty_roles.selection,[\"kpimanager_hierarchy\"]).asObject()}}' like  coalesce(\"%\"+ number_to_string( {{cell(Manager_1.selection, 0,\"WWID\").asString()}},  \"######\") + \"%\",\"%%\");  \r\nq = filter q by  '{{column(filter_oppty_roles.selection,[\"kpirep_hierarchy\"]).asObject()}}'  in {{coalesce(column(filter_sales_reps.selection, [\"Name\"]),'all').asString()}};\r\nq = filter q by 'strategickey.Core_Opportunity_Coverage_Nm__c' in [\"Intel-Led Opportunity\"];\r\nq = filter q by 'Core_IsActive__c' == \"true\"; q = filter q by 'strategickey.Core_Opp_Strategic_Opportunity__c' in {{coalesce(column(Opportunity_Core_Opp_2.selection, [\"val\"]), 'all').asString()}}; \r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"kpi_year_value\"]).asObject()}}' in {{coalesce(column(year_list_1.selection, [\"select_year\"]),'all').asString()}}; \r\nq = filter q by '{{column(Calendar_Selector_1.selection,[\"kpi_year_quarter_value\"]).asObject()}}' in {{coalesce(column(FicalCreatedDate_ord_1.selection, [\"quarter\"]),'all').asString()}};  \r\n\r\n\r\n\r\nresult = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type','kpi_type_group', 'kpi_is_won');\r\n\r\nresult = foreach result generate result.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', 'kpi_is_won', \r\nresult.'kpi_type' as 'kpi_type',result.'kpi_type_group' as 'kpi_type_group',\r\nsum(result.'kpi_pending_amt') as 'kpi_pending_amt', 0 as 'pending_product_g_kpi_qty', 0 as 'won_product_g_kpi_qty', \r\nsum(result.'kpi_won_amt') as 'kpi_won_amt',\r\n0 as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt,0 as 'won_weight',0 as 'pending_weight';\r\n\r\nresult1 = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type','kpi_type_group', 'kpi_is_won');\r\n\r\nresult1 = foreach result1 generate result1.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', \r\nresult1.'kpi_type' as 'kpi_type', result1.'kpi_type_group' as 'kpi_type_group','kpi_is_won', \r\n0 as 'kpi_pending_amt', unique(result1.kpi_pending_oppid_product_g) as 'pending_product_g_kpi_qty', \r\n0 as 'won_product_g_kpi_qty', \r\n0 as 'kpi_won_amt',\r\nunique(result1.'pending_opportunity_id')as pending_opportunity_cnt,\r\n0 as win_opportunity_cnt,0 as 'won_weight',0 as 'pending_weight';\r\n\r\n\r\nresult2 = group q by ('{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}', 'kpi_type', 'kpi_type_group','kpi_is_won');\r\n\r\nresult2 = foreach result2 generate result2.'{{coalesce(column(won_pending_kpi_togg_1.selection, [\"value\"]), \"kpi_name\").asObject()}}' as 'kpi_name', 'kpi_is_won', \r\nresult2.'kpi_type' as 'kpi_type', result2.'kpi_type_group' as 'kpi_type_group',\r\n0 as 'kpi_pending_amt', \r\n0 as 'pending_product_g_kpi_qty',  unique(result2.kpi_won_oppid_product_g) as 'won_product_g_kpi_qty', \r\n0 as 'kpi_won_amt',\r\n0 as pending_opportunity_cnt,\r\nunique(result2.'won_opportunity_id') as win_opportunity_cnt,0 as 'won_weight',0 as 'pending_weight';result3 =  foreach q generate q.'kpi_name' as 'kpi_name', q.'kpi_type' as 'kpi_type',q.'kpi_type_group' as 'kpi_type_group', 'kpi_is_won',('kpi_pending_amt'*'o.Opportunity.Probability'/100) as 'pending_weight',('kpi_won_amt'*'o.Opportunity.Probability'/100) as 'won_weight';result4 = group result3 by ('kpi_name', 'kpi_type','kpi_type_group','kpi_is_won');result4= foreach result4 generate result4.'kpi_name' as 'kpi_name','kpi_is_won', result4.'kpi_type' as 'kpi_type',result4.'kpi_type_group' as 'kpi_type_group', 0 as 'kpi_pending_amt', 0 as 'pending_product_g_kpi_qty',0 as 'won_product_g_kpi_qty', 0 as 'kpi_won_amt',0 as pending_opportunity_cnt,0 as win_opportunity_cnt ,sum('pending_weight') as 'pending_weight',sum('won_weight') as 'won_weight';\r\n\r\n\r\nresult5 = union result1, result2, result4,result;\r\nresult5 = group result5 by ('kpi_name', 'kpi_type','kpi_type_group', 'kpi_is_won');\r\nresult5 = foreach result5 generate result5.kpi_name as kpi_name, 'kpi_is_won', \r\nresult5.kpi_type as kpi_type,result5.'kpi_type_group' as 'kpi_type_group',\r\nmax('kpi_pending_amt') as 'kpi_pending_amt', \r\nmax(result5.pending_product_g_kpi_qty) as pending_product_g_kpi_qty, \r\nmax(result5.won_product_g_kpi_qty) as won_product_g_kpi_qty, \r\nmax(result5.kpi_won_amt) as kpi_won_amt,\r\nmax(result5.pending_opportunity_cnt) as pending_opportunity_cnt,\r\nmax(result5.win_opportunity_cnt) as win_opportunity_cnt,max(pending_weight) as 'pending_weight',max('won_weight') as 'won_weight';\r\n\r\n\r\n result6 = filter result5 by 'kpi_is_won' == \"true\"; result6 = foreach result6 generate result6.'kpi_name' as 'KPI Name/Account',(case when result6.'kpi_type_group' == \"Pipeline $\" &&  \"Unwtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result6.kpi_won_amt when result6.'kpi_type_group' == \"Pipeline $\" &&  \"Wtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result6.'won_weight' when result6.'kpi_type' == \"Salesforce Opp KPI Product Group Count\" then result6.won_product_g_kpi_qty  when result6.'kpi_type_group' == \"Pipeline Count (#)\" then result6.win_opportunity_cnt else 0 end) as 'KPI',\r\n\"Won KPI\" as 'KPI Type';\r\n\r\n\r\n  result7 = filter result5 by 'kpi_is_won' == \"false\"; result7 = foreach result7 generate result7.'kpi_name' as 'KPI Name/Account',\r\n(case  when result7.'kpi_type_group' == \"Pipeline $\" &&  \"Unwtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result7.kpi_pending_amt when result7.'kpi_type_group' == \"Pipeline $\" &&  \"Wtd\" in {{column(toggle_weighted_unweighted_amt.selection, [\"display\"]).asString()}} then result7.'pending_weight' when result7.'kpi_type' == \"Salesforce Opp KPI Product Group Count\" then result7.pending_product_g_kpi_qty  when result7.'kpi_type_group' == \"Pipeline Count (#)\" then result7.pending_opportunity_cnt\r\n  else 0 end) as 'KPI',\r\n\"Pending KPI\" as 'KPI Type';\r\n\r\nresult8 = union result6, result7;\r\n result9 = group result8 by 'KPI Type';result9 = foreach result9 generate 'KPI Type', sum('KPI') as 'KPI'; \r\n transposedResult = foreach result9 generate case result9.'KPI Type' when \"Pending KPI\" then result9.'KPI' else 0 end as 'pending_kpi', case result9.'KPI Type' when \"Won KPI\" then result9.'KPI' else 0  end as 'won_kpi';\r\n transposedResult = group transposedResult by all;transposedResult = foreach transposedResult generate  sum('won_kpi') as 'won_kpi', sum('pending_kpi') as 'pending_kpi';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions"