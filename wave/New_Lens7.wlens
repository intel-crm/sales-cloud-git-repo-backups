{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"LightningInteractionWithUsers\";\nq = filter q by date('TIMESTAMP_DERIVED_Year', 'TIMESTAMP_DERIVED_Month', 'TIMESTAMP_DERIVED_Day') in [\"6 weeks ago\"..\"1 week ago\"];\nq = filter q by 'PAGE_URL' matches \"006\";\nq = group q by ('USER_ID' , 'USER_ID_DERIVED', 'User.Name', 'PAGE_ENTITY_ID', 'TIMESTAMP_DERIVED_Week' );\nq = foreach q generate 'USER_ID_DERIVED' as 'USER_ID', 'User.Name' as 'User.Name', 'PAGE_ENTITY_ID' as 'PAGE_ENTITY_ID', 'TIMESTAMP_DERIVED_Week' as 'Workweek';\nq = limit q 250000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":false},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","verticalPadding":8},"type":"table"}}}