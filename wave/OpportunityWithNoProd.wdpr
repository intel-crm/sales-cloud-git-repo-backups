    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "sales_group",
          "label" : "sales_group",
          "formulaExpression" : "(case\r\n      when contains(upper(\"Account.Core_Sales_Groups__c\"), 'INDIA')\r\n      then 'India'\r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'EMEA') \r\n      then 'EMEA'\r\n      when \"Account.Core_Sales_Groups__c\" = 'Global Solutions & Services Sales Group' then 'GSS'\r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'APJ') then 'APJ' \r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'Americas' ) then 'Americas' \r\n      when startsWith(\"Account.Core_Sales_Groups__c\", 'PRC') then 'PRC' \r\n      else 'Other'\r\nend)\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ProductCodeName",
          "label" : "ProductCodeName",
          "formulaExpression" : "upper(\"Product2.Core_Code_Name__c\")",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Opportunity_Focus",
          "label" : "Opportunity_Focus",
          "formulaExpression" : "case \r\n    when Opportunity_Focus__c is null\r\n    then 'Other'\r\n    else\r\n    Opportunity_Focus__c\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA9" : {
      "action" : "formula",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "strategic_opportunity",
          "label" : "strategic_opportunity",
          "formulaExpression" : "case \r\n    when Core_Opp_Strategic_Opportunity__c = 'true'\r\n    then 'true'\r\n    else\r\n    'false'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA10" : {
      "action" : "formula",
      "sources" : [ "FORMULA11" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy",
          "label" : "unhealthy",
          "formulaExpression" : "case \r\n    when Core_Product_Count__c = 0\r\n    then 1\r\n    when StageName = 'Qualify' || StageName = 'Define' then 1\r\n    when Core_Past_Due__c = 'true' and StageName in ('Define','Design','Develop','Group','Qualify') then 1 \r\n    when Core_Push_Counter__c > 3 and \"OpportunityProducts.Opportunity.CreatedDate\" >= '2023-01-01' then 1\r\n    else\r\n    0\r\nend",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA11" : {
      "action" : "formula",
      "sources" : [ "FORMULA9" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_noproducts",
          "label" : "unhealthy_noproducts",
          "formulaExpression" : "case \r\n    when Core_Product_Count__c = 0 \r\n    then 1\r\n    else\r\n    0\r\nend",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA12" : {
      "action" : "formula",
      "sources" : [ "FORMULA10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_stage",
          "label" : "unhealthy_stage",
          "formulaExpression" : "case \r\n    when StageName = 'Qualify' or StageName = 'Define' then 1 \r\n    else\r\n    0\r\nend",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA13" : {
      "action" : "formula",
      "sources" : [ "FORMULA12" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_pastdue",
          "label" : "unhealthy_pastdue",
          "formulaExpression" : "case \r\n    when Core_Past_Due__c = 'true' and StageName in ('Define','Design','Develop','Group','Qualify')\r\n    then 1\r\n    else\r\n    0\r\nend",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA14" : {
      "action" : "formula",
      "sources" : [ "FORMULA13" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_pushes",
          "label" : "unhealthy_pushes",
          "formulaExpression" : "case \r\n    when Core_Push_Counter__c > 3 and \"OpportunityProducts.Opportunity.CreatedDate\" >= '2023-01-01'\r\n    then 1\r\n    else\r\n    0\r\nend",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA15" : {
      "action" : "formula",
      "sources" : [ "FORMULA14" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CloseDate_mmddyyyy",
          "label" : "CloseDate_mmddyyyy",
          "formulaExpression" : "concat(string(substr(CloseDate, 6, 2)), '/',string(substr(CloseDate, 9, 2)), '/' ,string(substr(CloseDate, 1, 4)))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "LOAD_DATASET1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_KPI_Date__c_Quarte",
          "label" : "Core_KPI_Date__c_Quarter",
          "formulaExpression" : "string(quarter(Core_KPI_Date__c))",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
