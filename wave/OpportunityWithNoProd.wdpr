    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CloseDate_YearQuarter",
          "label" : "CloseDate_YearQuarter",
          "formulaExpression" : "concat(string(year(CloseDate)), string('0'), string(quarter(CloseDate)))\r\n",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA16" : {
