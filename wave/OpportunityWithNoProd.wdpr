          "name" : "Core_KPI_Date__c_Yea",
          "label" : "Core_KPI_Date__c_Year",
          "formulaExpression" : "string(year(Core_KPI_Date__c))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
