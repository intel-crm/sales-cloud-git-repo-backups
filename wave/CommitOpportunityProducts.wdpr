          "name" : "CategoryAmount",
          "label" : "CategoryAmount",
          "formulaExpression" : "\"Opportunit.Core_KPI_Total_Price__c\"",
          "precision" : 16,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CategoryYear",
          "label" : "CategoryYear",
          "formulaExpression" : "string(year(\"Opportunit.Core_KPI_Date__c\"))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA9" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CategoryQuarter",
          "label" : "CategoryQuarter",
          "formulaExpression" : "concat(string(year(\"Opportunit.Core_KPI_Date__c\")),string('0'),string(quarter(\"Opportunit.Core_KPI_Date__c\")))",
          "precision" : 255,
