    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CategoryQuarter",
          "label" : "CategoryQuarter",
          "formulaExpression" : "(case when substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 1,2)= 'Q1' then concat(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4),'01') when substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 1,2)= 'Q2' then concat(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4),'02')  when substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 1,2)= 'Q3' then concat(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4),'03') else concat(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4),'04')\r\nend)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
