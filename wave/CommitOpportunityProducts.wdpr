      "sources" : [ "FORMULA14" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Decision_Quarter_Conversion",
          "label" : "Decision_Quarter_Conversion",
          "formulaExpression" : "(case when substr(\"OpportunityProducts.FiscalDecisionDate.fiscalyearquarternumber\", 5,6) = string('01') then string('Q1 '+ substr(\"OpportunityProducts.FiscalDecisionDate.fiscalyearquarternumber\", 1,4)) when substr(\"OpportunityProducts.FiscalDecisionDate.fiscalyearquarternumber\", 5,6)= string('02') then string('Q2 '+ substr(\"OpportunityProducts.FiscalDecisionDate.fiscalyearquarternumber\", 1,4)) when substr(\"OpportunityProducts.FiscalDecisionDate.fiscalyearquarternumber\", 5,6)= string('03') then string('Q3 '+ substr(\"OpportunityProducts.FiscalDecisionDate.fiscalyearquarternumber\", 1,4)) else string('Q4 '+ substr(\"OpportunityProducts.FiscalDecisionDate.fiscalyearquarternumber\", 1,4)) end)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA16" : {
      "action" : "formula",
      "sources" : [ "FORMULA15" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "QuarterTransformation",
          "label" : "QuarterTransformation",
          "formulaExpression" : "(case when substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 1,2)= 'Q1' then concat(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4),'01') when substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 1,2)= 'Q2' then concat(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4),'02')  when substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 1,2)= 'Q3' then concat(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4),'03') else concat(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4),'04')\r\nend)",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA17" : {
