        "fields" : [ {
          "type" : "DATETIME",
          "name" : "Quarter",
          "label" : "Quarter",
          "formulaExpression" : "(case when substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 1,2) = 'Q1' then to_timestamp(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4)+'-02-16 00:00:00') when substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 1,2)= 'Q2' then to_timestamp(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4)+'-05-16 00:00:00') when substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 1,2)= 'Q3' then to_timestamp(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4)+'-08-16 00:00:00') else to_timestamp(substr(\"OppForecastJoin.Core_Forecast_Quarter__c\", 4)+'-11-16 00:00:00') end)",
