    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CategoryStatus",
          "label" : "CategoryStatus",
          "formulaExpression" : "(case when \"Opportunit.Core_Status__c\"= 'Win Approved' then 'Won' \r\nwhen \"Opportunit.Core_Status__c\"= 'Production Win' then 'Won' \r\nwhen \"Opportunit.Core_Status__c\"= 'Production Lost' then 'Won'\r\nwhen \"Opportunit.Core_Status__c\" = 'Production Cancelled' then 'Won' \r\nwhen  \"Opportunit.Core_Status__c\"= 'Lost'  then 'Lost' \r\nwhen \"Opportunit.Core_Status__c\"= 'Cancelled' then 'Lost' \r\nwhen \"StageName\" = 'Design' then 'Design'\r\n when \"StageName\" =  'Develop' then 'Develop' \r\n when \"StageName\" = 'Qualify' then 'Qualify' \r\n when \"StageName\" = 'Define'  then 'Define'\r\n else 'Other' end)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
