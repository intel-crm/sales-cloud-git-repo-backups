      "sources" : [ "FORMULA16" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "categorySorted",
          "label" : "Category Status",
          "formulaExpression" : "(case when CategoryStatus = 'Best Case Forecast' then '1 - Best Case' when CategoryStatus = 'Commit Forecast' then '2 - Commit' when CategoryStatus = 'Qualify' then '3 - Qualify' when CategoryStatus = 'Define' then '4 - Define' when CategoryStatus = 'Develop' then '5 - Develop' when CategoryStatus = 'Design' then '6 - Design' when CategoryStatus = 'Won' then '7 - Won' when CategoryStatus = 'Lost' then '8 - Lost' when CategoryStatus = 'Cancelled' then '8 - Lost' else CategoryStatus end)",
