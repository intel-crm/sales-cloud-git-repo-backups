          "type" : "TEXT",
          "name" : "opp_sales_group_ordered",
          "label" : "Opportunity Sales Group Ordered",
          "formulaExpression" : "case \r\n    when opp_sales_group = 'Americas' \r\n    then '1.Americas'\r\n    when opp_sales_group = 'APJ'\r\n    then '2.APJ'\r\n    when opp_sales_group = 'EMEA'\r\n    then '3.EMEA'\r\n    when opp_sales_group = 'PRC'\r\n    then '4.PRC'\r\n    when opp_sales_group = 'GSA'\r\n    then '5.GSA'\r\n    when opp_sales_group = 'India'\r\n    then '6.India'\r\n    when opp_sales_group = 'Other'\r\n    then '7.Other'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
