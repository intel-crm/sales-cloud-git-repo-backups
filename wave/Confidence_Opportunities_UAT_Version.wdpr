    "FORMULA13" : {
      "action" : "formula",
      "sources" : [ "LOAD_DATASET1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Manager__c_formula",
          "label" : "Manager Formula",
          "formulaExpression" : "'Name' ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA14" : {
      "action" : "formula",
      "sources" : [ "FORMULA13" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Manager__c_formula_formula",
          "label" : "Manager Formula Formula",
          "formulaExpression" : "'Core_Manager__c'",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FILTER5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula",
          "label" : "Partner Formula",
          "formulaExpression" : "(case  \r\n      when contains(upper(\"Core_Sales_Groups__c\"), 'INDIA')\r\n      then 'India'\r\n      when startsWith('Core_Sales_Groups__c', 'EMEA') \r\n      then 'EMEA'\r\n      when 'Core_Sales_Groups__c' in ('Global Strategic Account Sales Group','Global Accounts Sales Group', 'Global Solutions & Services Sales Group') then 'GSA' \r\n      when startsWith('Core_Sales_Groups__c', 'APJ') then 'APJ' \r\n      when startsWith('Core_Sales_Groups__c', 'Americas' ) then 'Americas' \r\n      when startsWith('Core_Sales_Groups__c', 'PRC') then 'PRC' \r\n      else 'Other'\r\nend)\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_noproducts",
          "label" : "unhealthy_noproducts",
          "formulaExpression" : "(case \r\n     when Core_Product_Count__c = 0 then 1  \r\nelse 0\r\nend)",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_stage",
          "label" : "unhealthy_stage",
          "formulaExpression" : "(case \r\n      when StageName = 'Qualify' or  StageName = 'Define'  then 1 \r\n else 0\r\nend)",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula2",
          "label" : "Partner Formula",
          "formulaExpression" : "(case \r\n when Core_Opp_Strategic_Opportunity__c = 'true' then 'true'\r\nelse 'false'\r\nend)",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "FORMULA6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_pushes",
          "label" : "unhealthy_pushes",
          "formulaExpression" : "(case\r\n    when Core_Push_Counter__c >3 and year(\"OpportunityProducts.Opportunity.CreatedDate\") >= 2023 then 1 \r\n     else 0\r\nend)",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA10" : {
      "action" : "formula",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula3",
          "label" : "Partner Formula",
          "formulaExpression" : "'Name'",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA11" : {
      "action" : "formula",
      "sources" : [ "FORMULA16" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula3_formula",
          "label" : "Partner Formula Formula",
          "formulaExpression" : "'CloseDate_Year'",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA12" : {
      "action" : "formula",
      "sources" : [ "FORMULA11" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Core_Partner__c_formula3_formula_formula",
          "label" : "Partner Formula Formula Formula",
          "formulaExpression" : "(case when 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '1' then '01' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '2' then '02' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '3' then '03' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '4' then '04' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '5' then '05' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '6' then '06' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '7' then '07' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '8' then '08' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '9' then '09' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '10' then '10' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '11' then '11' \r\nwhen 'OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber' = '12' then '12'\r\nend)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA9" : {
      "action" : "formula",
      "sources" : [ "FORMULA12" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CloseDate_mmddyyyy",
          "label" : "CloseDate_mmddyyyy",
          "formulaExpression" : "concat(substr('CloseDate', 6, 2),'/',substr('CloseDate', 9, 2),'/',substr('CloseDate', 1, 4))",
          "precision" : 40,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA9" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CloseDate_YearQuarter",
          "label" : "CloseDate_YearQuarter",
          "formulaExpression" : "concat('CloseDate_Year','0','CloseDate_Quarter') ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA15" : {
      "action" : "formula",
      "sources" : [ "FORMULA10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy_pastdue",
          "label" : "unhealthy_pastdue",
          "formulaExpression" : "(case \r\n      when datediff(now(), CloseDate) > 0 and StageName in ('Define', 'Design', 'Develop', 'Group', 'Qualify')  then 1  else 0\r\nend)",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA16" : {
      "action" : "formula",
      "sources" : [ "FORMULA15" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "unhealthy",
          "label" : "unhealthy",
          "formulaExpression" : "case\r\n     when Core_Product_Count__c = 0 then 1     \r\n     when StageName = 'Qualify' or  StageName = 'Define'  then 1 \r\n     when datediff(now(), CloseDate) > 0 and StageName in ('Define', 'Design', 'Develop', 'Group', 'Qualify')\r\n     then 1 \r\n     when Core_Push_Counter__c >3 and year(\"OpportunityProducts.Opportunity.CreatedDate\") >=2023\r\n     then 1 \r\n     else 0\r\nend\r\n",
          "precision" : 1,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA17" : {
      "action" : "formula",
      "sources" : [ "FORMULA8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "opp_sales_group",
          "label" : "Opportunity Sales Group",
          "formulaExpression" : "case \r\n      when contains(upper(\"UltimateParent.Core_Sales_Groups__c\"), 'INDIA')\r\n      then 'India'\r\n      when startsWith(\"UltimateParent.Core_Sales_Groups__c\", 'EMEA') then 'EMEA' \r\n      when \"UltimateParent.Core_Sales_Groups__c\" in ('Global Strategic Account Sales Group','Global Accounts Sales Group','Global Solutions & Services Sales Group') then 'GSA' \r\n      when startsWith(\"UltimateParent.Core_Sales_Groups__c\", 'APJ')then 'APJ' \r\n      when startsWith(\"UltimateParent.Core_Sales_Groups__c\", 'Americas' )then 'Americas' \r\n      when startsWith(\"UltimateParent.Core_Sales_Groups__c\", 'PRC' )then 'PRC' \r\n      else 'Other'\r\nend\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA26" : {
      "action" : "formula",
      "sources" : [ "FORMULA46" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "cancel_push_lost_date",
          "label" : "Cancel, Push, Lost Date",
          "formulaExpression" : "case \r\n    when StageName in('Cancelled', 'Lost') \r\n    then CloseDate\r\n    when \"PushDate.IsPush\" = 'Push' \r\n    then \"PushDate.push_date\"\r\n    else null \r\nend",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA27" : {
      "action" : "formula",
      "sources" : [ "FORMULA26" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "opp_age",
          "label" : "Opportunity Age",
          "formulaExpression" : "datediff(\"OpportunityProducts.Opportunity.CloseDate\", \"OpportunityProducts.Opportunity.CreatedDate\")",
          "precision" : 18,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA28" : {
      "action" : "formula",
      "sources" : [ "FORMULA27" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "opp_status",
          "label" : "Opportunity Status",
          "formulaExpression" : "case \r\n    when StageName in ('Group Cancelled','Production Cancelled', 'Group Closed', 'Design Win', 'Production Win') \r\n    then 'Won'\r\n    when StageName = 'Lost' \r\n    then 'Lost'\r\n    when contains(StageName,'Cancelled')\r\n    then 'Cancelled'\r\n    when Core_At_Risk__c = 'true'\r\n    then 'At Risk'\r\n    else 'Open'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA34" : {
      "action" : "formula",
      "sources" : [ "FORMULA36" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "loss_cancel_push",
          "label" : "Win/Loss/Cancel/Push",
          "formulaExpression" : "case \r\n    \r\n    when opp_status in ('Lost','Cancelled','Won')\r\n    then opp_status\r\n    when \"PushDate.IsPush\" = 'Push' \r\n    then 'Push'\r\n    when \"OpportunityProducts.Core_At_Risk__c\" = 'true' or opp_status = 'At Risk'\r\n    then 'At Risk'\r\n    else null \r\nend ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA35" : {
      "action" : "formula",
      "sources" : [ "FORMULA49" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "opfiscalkpimonthnumber",
          "label" : "opfiscalkpimonthnumber",
          "formulaExpression" : "case when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '1' then '01' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '2' then '02' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '3' then '03' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '4' then '04' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '5' then '05' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '6' then '06' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '7' then '07' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '8' then '08' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '9' then '09' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '10' then '10' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '11' then '11' when \"OpportunityProducts.FiscalDecisionDate.fiscalmonthnumber\" = '12' then '12' end",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA36" : {
      "action" : "formula",
      "sources" : [ "FORMULA28" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "oppprod_status_formula",
          "label" : "Opportunity Product Stage",
          "formulaExpression" : "case \r\n    when \"OpportunityProducts.Core_Status__c\" in ('Group Cancelled','Production Cancelled', 'Group Closed', 'Design Win', 'Production Win','Win Approved') \r\n    then 'Won'\r\n    when \"OpportunityProducts.Core_Status__c\" = 'Lost' \r\n    then 'Lost'\r\n    when contains(\"OpportunityProducts.Core_Status__c\", 'Cancelled')\r\n    then 'Cancelled'\r\n    when Core_At_Risk__c = 'true'\r\n    then 'At Risk'\r\n    else 'Open'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "BUCKET0" : {
      "action" : "bucket",
      "sources" : [ "FORMULA35" ],
      "parameters" : {
        "fields" : [ {
          "name" : "Core_Opportunity_Type__c_bucket",
          "label" : "Opportunity Type Bucket",
          "type" : "TEXT",
          "bucketsSetup" : {
            "defaultBucketValue" : "Other",
            "nullBucketValue" : "Other",
            "isPassthroughEnabled" : false,
            "sourceField" : {
              "name" : "Core_Opportunity_Type__c",
              "type" : "TEXT"
            },
            "buckets" : [ {
              "value" : "Sell-through",
              "sourceValues" : [ "Deal: Sell-through" ]
            }, {
              "value" : "Design Win",
              "sourceValues" : [ "Deal: Sell-with", "Design: Original", "Design: Secondary", "Design: Software-enable" ]
            }, {
              "value" : "Sell-to",
              "sourceValues" : [ "Deal: Sell-to" ]
            } ]
          }
        } ]
      }
    },
    "FORMULA42" : {
      "action" : "formula",
