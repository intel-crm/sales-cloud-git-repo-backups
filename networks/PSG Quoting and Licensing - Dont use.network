    <networkMemberGroups>
        <permissionSet>PSG_Internal_Biz_Ops</permissionSet>
        <permissionSet>PSG_Internal_Customer_Ops</permissionSet>
        <permissionSet>PSG_Internal_PMS</permissionSet>
