    <validationRules>
        <fullName>espy__Batch_Size_Validation</fullName>
        <active>true</active>
        <description>Batch scope size cannot be more than 200</description>
        <errorConditionFormula>OR(espy__Scope_Size__c &gt;200,espy__Scope_Size__c &lt;0)</errorConditionFormula>
        <errorDisplayField>espy__Scope_Size__c</errorDisplayField>
        <errorMessage>Please enter scope size less than 200</errorMessage>
    </validationRules>
