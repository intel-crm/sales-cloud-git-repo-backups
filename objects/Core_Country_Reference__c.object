<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Stores the list of countries</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Core_Geo__c</fullName>
        <description>Used to store the Geography to which the country belongs</description>
        <externalId>false</externalId>
        <label>Geo</label>
        <length>10</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Has_States__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Denotes if the country has valid states</description>
        <label>Has States</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_ISO_Code__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>ISO code of the country</description>
        <externalId>true</externalId>
        <label>ISO Code</label>
        <length>3</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_Sub_Geo__c</fullName>
        <description>Used to store the Sub-Geography to which the country belongs</description>
        <externalId>false</externalId>
        <label>Sub Geo</label>
        <length>25</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Country Reference</label>
    <listViews>
        <fullName>All</fullName>
        <columns>Core_ISO_Code__c</columns>
        <columns>NAME</columns>
        <columns>Core_Geo__c</columns>
        <columns>Core_Sub_Geo__c</columns>
        <columns>Core_Has_States__c</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <visibility>Public</visibility>
</CustomObject>
