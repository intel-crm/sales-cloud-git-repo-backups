    <label>Security Dashboard Metric</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>Core_Security_Dashboard_Metric__c.Core_Permissions_Security_Dashboard</value>
        </filters>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>A-{0000}</displayFormat>
        <label>Dashboard</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Security Dashboard Metrices</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
