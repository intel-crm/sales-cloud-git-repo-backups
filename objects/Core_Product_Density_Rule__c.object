    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores the Product Density Rules which is used to calculate the Density based on the Product Code Name and OPN Values</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_Code_Name__c</fullName>
        <description>Store the List of Product Code Names</description>
        <externalId>false</externalId>
        <inlineHelpText>Specifiy the Product Code Names If Multiple separate it with comma</inlineHelpText>
        <label>Code Name</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Density_End_Char__c</fullName>
        <description>This will store the End Character(s) number of OPN Field to extract the value for Density</description>
        <externalId>false</externalId>
        <label>Density End Char</label>
        <length>10</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Density_Output_Suffix__c</fullName>
        <description>This will store the value to be added as part of a suffix to the determined Density Value</description>
        <externalId>false</externalId>
        <label>Density Output Suffix</label>
        <length>10</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Density_Start_Char__c</fullName>
        <description>This will store the Start Character(s) number of OPN Field to extract the value for Density</description>
        <externalId>false</externalId>
        <label>Density Start Char</label>
        <length>10</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IsActive__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This will store if the Rule is Active or Not</description>
        <label>IsActive</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_OPN_Char_Contain__c</fullName>
        <defaultValue>&quot;0&quot;</defaultValue>
        <description>This will store the list of OPN Substring Text which needs to cross checked to determine the Density Rule</description>
        <externalId>false</externalId>
        <label>OPN Char Contain</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_OPN_End_Char__c</fullName>
        <defaultValue>&quot;0&quot;</defaultValue>
        <description>This will store the End Character number of OPN Field for the text needs to be extracted</description>
        <externalId>false</externalId>
        <label>OPN End Char</label>
        <length>10</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_OPN_Start_Char__c</fullName>
        <defaultValue>&quot;0&quot;</defaultValue>
        <description>This will store the Start Character number of OPN Field for the text needs to be extracted</description>
        <externalId>false</externalId>
        <label>OPN Start Char</label>
        <length>10</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Sequence_Number__c</fullName>
        <description>Stores the Sequence number for the Density Rules Listed</description>
        <externalId>false</externalId>
        <inlineHelpText>Specify the Sequence number for rules to be picked up during the processing.</inlineHelpText>
        <label>Sequence Number</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>true</unique>
    </fields>
    <label>Product Density Rule</label>
    <nameField>
        <displayFormat>Rule-{00}</displayFormat>
        <label>Product Density Rules Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Product Density Rules</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
