    <validationRules>
        <fullName>Claim_Submission_Window_Rule</fullName>
        <active>true</active>
        <description>Both claim submission window in months and days cant be &gt; 0 at same time.</description>
        <errorConditionFormula>IF( Core_MDF_Claim_Submission_Window_days__c &gt; 0 &amp;&amp; Core_MDF_Claim_Submission_Window_mnth__c &gt; 0, true, false)</errorConditionFormula>
        <errorMessage>Both claim submission window in months and days cant be &gt; 0 at same time.</errorMessage>
    </validationRules>
