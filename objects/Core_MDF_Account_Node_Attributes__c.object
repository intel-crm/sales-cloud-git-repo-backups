    <label>Account Node Attribute</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Account_id__c</columns>
        <columns>Core_MDF_NonPO_GL_Account_nbr__c</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Account_id__c</field>
            <operation>equals</operation>
            <value>IPA - TD Synnex</value>
        </filters>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Core_MDF_GL_Account_Mapping</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Account_id__c</columns>
        <columns>Core_MDF_Program_id__c</columns>
        <columns>Core_MDF_CSAR_GL_Account_nbr__c</columns>
        <columns>Core_MDF_NonPO_GL_Account_nbr__c</columns>
        <columns>Core_MDF_Final_CSAR_GL_Account_nbr__c</columns>
        <columns>Core_MDF_Default_CSAR_GL_Account_nbr__c</columns>
        <columns>Core_MDF_Final_NonPO_GL_Account_nbr__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Account_id__c</field>
            <operation>contains</operation>
            <value>IPA - Elo Touch Solutions</value>
        </filters>
        <filters>
            <field>Core_MDF_Program_id__c</field>
            <operation>equals</operation>
            <value>Intel Partner Alliance</value>
        </filters>
        <label>GL Account Mapping</label>
        <sharedTo>
            <group>Core_MDF_CCP_IPA_INTERNAL_ALL</group>
            <group>Core_MDF_CCP_Internal_IPA_Geo_Groups</group>
            <group>Core_MDF_IPA_Internal_All_Geo_Read_Only</group>
        </sharedTo>
    </listViews>
