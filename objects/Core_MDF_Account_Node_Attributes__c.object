        <description>Record type created to store GL Account Mappings</description>
        <label>GL Account Mapping</label>
    </recordTypes>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_MDF_AccountID_and_Program_match</fullName>
        <active>true</active>
        <errorConditionFormula>(Core_MDF_Program_id__c != Core_MDF_Account_id__r.Core_MDF_Channel_Program__c)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Program_id__c</errorDisplayField>
        <errorMessage>The account is not associated with the selected program. Please select a valid Program</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_CSAR_nbr_field</fullName>
        <active>true</active>
        <description>Number fields should contain only whole numbers.</description>
        <errorConditionFormula>OR(
Core_MDF_CSAR_GL_Account_nbr__c &lt; 0,
MOD(Core_MDF_CSAR_GL_Account_nbr__c, 1) &lt;&gt; 0
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_CSAR_GL_Account_nbr__c</errorDisplayField>
        <errorMessage>Only positive whole numbers allowed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_CustNonPO_nbr_field</fullName>
        <active>true</active>
        <description>Number fields should contain only whole numbers.</description>
        <errorConditionFormula>OR(
				Core_MDF_Customer_NonPO_GL_Account_nbr__c &lt; 0,
				MOD(Core_MDF_Customer_NonPO_GL_Account_nbr__c, 1) &lt;&gt; 0
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Customer_NonPO_GL_Account_nbr__c</errorDisplayField>
        <errorMessage>Only positive whole numbers allowed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_NonPO_nbr_field</fullName>
        <active>true</active>
        <description>Number fields should contain only whole numbers.</description>
        <errorConditionFormula>OR(
				Core_MDF_NonPO_GL_Account_nbr__c &lt; 0,
				MOD(Core_MDF_NonPO_GL_Account_nbr__c, 1) &lt;&gt; 0
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_NonPO_GL_Account_nbr__c</errorDisplayField>
        <errorMessage>Only positive whole numbers allowed</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
