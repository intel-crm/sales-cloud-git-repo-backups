    <fields>
        <fullName>Core_MDF_Account_id__c</fullName>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>&apos;Core_MDF_Co_Marketing&apos;</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Account Node Attributes</relationshipLabel>
        <relationshipName>Account_Node_Attributes</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_CSAR_GL_Account_nbr__c</fullName>
        <externalId>false</externalId>
        <label>Contra Revenue GL# Override</label>
        <precision>10</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Customer_NonPO_GL_Account_nbr__c</fullName>
        <externalId>false</externalId>
        <label>Customer NonPO GL# Override</label>
        <precision>10</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Default_CSAR_GL_Account_nbr__c</fullName>
        <externalId>false</externalId>
        <formula>VALUE(
CASE(
TEXT( Core_MDF_Program_id__r.Core_MDF_Technical_Program_Name__c ),
&quot;Intel Partner Alliance&quot;,  $CustomMetadata.Core_MDF_CCP_Payment_File_Particulars__mdt.Intel_Partner_Alliance_MDF.Core_MDF_GL_Account_CSAR__c,
&quot;Retail Marketing Funds&quot;,  $CustomMetadata.Core_MDF_CCP_Payment_File_Particulars__mdt.Retail_Marketing_Funds.Core_MDF_GL_Account_CSAR__c,
null
)
)</formula>
        <label>Default Contra Revenue GL#</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Default_Cust_NonPO_GL_Acc_nbr__c</fullName>
        <externalId>false</externalId>
        <formula>VALUE(
CASE(
TEXT( Core_MDF_Program_id__r.Core_MDF_Technical_Program_Name__c ),
&quot;Intel Partner Alliance&quot;,  $CustomMetadata.Core_MDF_CCP_Payment_File_Particulars__mdt.Intel_Partner_Alliance_MDF.Core_MDF_GL_Account_Customer_NonPO__c,
null
)
)</formula>
        <label>Default Customer NonPO GL#</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Default_NonPO_GL_Account_nbr__c</fullName>
        <externalId>false</externalId>
        <formula>VALUE(
CASE(
TEXT( Core_MDF_Program_id__r.Core_MDF_Technical_Program_Name__c ),
&quot;Client CoMarketing Fund&quot;, $CustomMetadata.Core_MDF_CCP_Payment_File_Particulars__mdt.Client_Co_Marketing_Fund.Core_MDF_GL_Account__c,
&quot;Client CoMarketing Fund Boost&quot;, $CustomMetadata.Core_MDF_CCP_Payment_File_Particulars__mdt.Client_Co_Marketing_Fund_Boost.Core_MDF_GL_Account__c,
&quot;Data Center CoMarketing Fund&quot;, $CustomMetadata.Core_MDF_CCP_Payment_File_Particulars__mdt.Data_Center_Co_Marketing_Fund.Core_MDF_GL_Account__c,
&quot;Intel Partner Alliance&quot;,  $CustomMetadata.Core_MDF_CCP_Payment_File_Particulars__mdt.Intel_Partner_Alliance_MDF.Core_MDF_GL_Account__c,
&quot;Service Provider CoMarketing Fund&quot;,  $CustomMetadata.Core_MDF_CCP_Payment_File_Particulars__mdt.Service_Provider_Co_Marketing_Fund.Core_MDF_GL_Account__c,
null
)
)</formula>
        <label>Default Expense GL#</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_External_ID__c</fullName>
        <caseSensitive>true</caseSensitive>
        <description>Combination of Recordtype Id, Program Id and Comarketing Account Id.</description>
        <externalId>true</externalId>
        <label>External ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Final_CSAR_GL_Account_nbr__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
ISBLANK(Core_MDF_CSAR_GL_Account_nbr__c),
Core_MDF_Default_CSAR_GL_Account_nbr__c,
Core_MDF_CSAR_GL_Account_nbr__c
)</formula>
        <label>Contra Revenue GL#</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Final_Cust_NonPO_GL_Acc_nbr__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  ISBLANK(Core_MDF_Customer_NonPO_GL_Account_nbr__c),
  Core_MDF_Default_Cust_NonPO_GL_Acc_nbr__c,
  Core_MDF_Customer_NonPO_GL_Account_nbr__c
)</formula>
        <label>Customer NonPO GL#</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Final_NonPO_GL_Account_nbr__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
ISBLANK(Core_MDF_NonPO_GL_Account_nbr__c),
Core_MDF_Default_NonPO_GL_Account_nbr__c,
Core_MDF_NonPO_GL_Account_nbr__c
)</formula>
        <label>Expense GL#</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_NonPO_GL_Account_nbr__c</fullName>
        <description>To store Expense GL Account Number.</description>
        <externalId>false</externalId>
        <label>Expense GL# Override</label>
        <precision>10</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Program_id__c</fullName>
        <label>Program</label>
        <referenceTo>ChannelProgram</referenceTo>
        <relationshipLabel>Account Node Attributes</relationshipLabel>
        <relationshipName>Account_Node_Attributes</relationshipName>
        <relationshipOrder>1</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
