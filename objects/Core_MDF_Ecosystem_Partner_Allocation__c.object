    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores percentage allocation data for ecosystem partners associated with MDF (Market Development Fund) activities.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Active_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether this ecosystem partner allocation is currently active. When unchecked, the allocation is considered inactive/removed but maintained for historical tracking purposes.</description>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Id__c</fullName>
        <description>Reference to the parent MDF activity record. Links the ecosystem partner allocation to a specific marketing activity or campaign.</description>
        <label>Co-Marketing Activity</label>
        <referenceTo>PartnerFundRequest</referenceTo>
        <relationshipLabel>Ecosystem Partner Allocations</relationshipLabel>
        <relationshipName>Ecosystem_Partner_Allocations</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Ecosystem_Partner_txt__c</fullName>
        <description>Name or identifier of the ecosystem partner receiving the allocation. Represents the partner organization that will receive a portion of the MDF budget or resources.</description>
        <label>Ecosystem Partner</label>
        <length>131072</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Percentage_pct__c</fullName>
        <description>Percentage allocation assigned to the ecosystem partner for this activity. Must be between 0-100%. The total of all active allocations for an activity should equal either 0% or 100%.</description>
        <label>Percentage</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <label>Ecosystem Partner Allocation</label>
    <nameField>
        <displayFormat>PartnerAllocation-{0000}</displayFormat>
        <label>Ecosystem Partner Allocation Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Ecosystem Partner Allocations</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
