    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>List of Accounts that are associated to this MAP/PAR record.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>Account to include in this MAP/PAR record.</description>
        <inlineHelpText>Select an Account</inlineHelpText>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.Core_IPS_Active__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_CNDA_Number__c</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <infoMessage>Only NDA &amp; IPS-enabled Accounts will be available for selection</infoMessage>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Product Access: Accounts</relationshipLabel>
        <relationshipName>MAP_Accounts</relationshipName>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Submitter_Comments__c</fullName>
        <label>Submitter Comments</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MAP_PAR__c</fullName>
        <description>Reference to the MAP/PAR header record</description>
        <inlineHelpText>MAP/PAR header record</inlineHelpText>
        <label>MAP/PAR</label>
        <referenceTo>Core_IPS_MAP_PAR__c</referenceTo>
        <relationshipLabel>Product Access: Accounts</relationshipLabel>
        <relationshipName>MAP_Accounts</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <label>Product Access: Accounts</label>
    <nameField>
        <displayFormat>IAA-{0000000000}</displayFormat>
        <label>ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Product Access: Accounts</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_IPS_Prevent_Account_JO_Edit</fullName>
        <active>true</active>
        <description>Prevent user from changing the account in an existing Product Access: Accounts JO record.</description>
        <errorConditionFormula>IF(ISCHANGED(Core_Account__c),NOT ISNULL(PRIORVALUE(Core_Account__c)),FALSE)</errorConditionFormula>
        <errorMessage>You cannot change an existing Account record.  You can only Add a new Account or Delete an existing Account.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
