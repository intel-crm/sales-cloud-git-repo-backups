    <validationRules>
        <fullName>Email_Addresses_required</fullName>
        <active>true</active>
        <description>If Send Email is checked, fill Email Addresses to receive Email notification with Test Run Results Report.</description>
        <errorConditionFormula>AND
(
DP_EAT_Send_Email__c  = TRUE,
OR(
ISNULL( DP_EAT_Email_Addresses__c ),
ISBLANK( DP_EAT_Email_Addresses__c ) 
) 
)</errorConditionFormula>
        <errorDisplayField>DP_EAT_Email_Addresses__c</errorDisplayField>
        <errorMessage>If Send Email is checked, fill Email Addresses to receive Email notification with Test Run Results Report.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_space_in_Email_Addresses_field</fullName>
        <active>true</active>
        <description>Email Addresses field should contain comma separated Email IDs without any space.</description>
        <errorConditionFormula>CONTAINS( DP_EAT_Email_Addresses__c , &quot; &quot;)</errorConditionFormula>
        <errorDisplayField>DP_EAT_Email_Addresses__c</errorDisplayField>
        <errorMessage>Email Addresses field should contain comma separated Email IDs without any space.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_space_in_Prefixes_field</fullName>
        <active>true</active>
        <description>Prefixes field should contain comma separated Prefix strings without any space.</description>
        <errorConditionFormula>CONTAINS( DP_EAT_Prefixes__c , &quot; &quot;)</errorConditionFormula>
        <errorDisplayField>DP_EAT_Prefixes__c</errorDisplayField>
        <errorMessage>Prefixes field should contain comma separated Prefix strings without any space.</errorMessage>
    </validationRules>
