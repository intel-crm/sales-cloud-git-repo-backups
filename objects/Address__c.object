        <externalId>false</externalId>
        <formula>Core_Street__c + &apos;,&apos;+ City__c + &apos;,&apos; + TEXT(Core_State_Province__c) + &apos;,&apos;+TEXT(Core_Zip_Postal_Code__c) +&apos;,&apos;+ TEXT(Country__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
