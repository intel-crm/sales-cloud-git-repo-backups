    <sharingModel>Read</sharingModel>
    <validationRules>
        <fullName>Core_IPS_Backend_Supported_Prod_NameRule</fullName>
        <active>true</active>
        <description>This Validation will enforce users to append associated Backend system name as &apos;prefix&apos; while naming the &apos;Supported Product&apos; record.</description>
        <errorConditionFormula>NOT(BEGINS(Name ,  Core_IPS_Backend_System__r.Name ))</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Please add Backend System Name as prefix for the Backend Supported Product Map ID.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Backend_Validate_Supported_Prod</fullName>
        <active>true</active>
        <description>This rule ensures the Supported product associated to the backend system is defined for the Support Org of the backend system.</description>
        <errorConditionFormula>AND(( ISPICKVAL(Core_IPS_Backend_System__r.Core_IPS_Routing_Technique__c,&apos;Product&apos;)),( Core_IPS_Backend_System__r.Core_IPS_Support_Org__c != &apos;&apos;),(Core_IPS_Backend_System__r.Core_IPS_Support_Org__c &lt;&gt;  Core_IPS_Supported_Product__r.Core_Product_Organization__c))</errorConditionFormula>
        <errorDisplayField>Core_IPS_Supported_Product__c</errorDisplayField>
        <errorMessage>Select Supported Product defined for the Support Org associated with the Backend System</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Queue_Prod_Field_NullCheck</fullName>
        <active>true</active>
        <description>According to the routing technique defined in the backend system check the corresponding queue/product field is null or not in product map</description>
        <errorConditionFormula>OR(IF(AND( ( ISPICKVAL(Core_IPS_Backend_System__r.Core_IPS_Routing_Technique__c, &apos;Queue&apos;)), Core_IPS_Queue__c ==&apos;&apos;) , True, False),IF(AND( ISPICKVAL(Core_IPS_Backend_System__r.Core_IPS_Routing_Technique__c, &apos;Product&apos;), (Core_IPS_Product__c ==&apos;&apos;),( Core_IPS_Backend_System__r.Core_IPS_Support_Org__c !=null)) , True, False))</errorConditionFormula>
        <errorMessage>Both product and Queue field can not be empty.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
