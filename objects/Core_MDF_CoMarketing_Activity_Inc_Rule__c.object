    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object to store the variable reimbursement incentive critera rules</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Active_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Category_Nm__c</fullName>
        <label>Activity Category</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Activity_Category</valueSetName>
        </valueSet>
        <visibleLines>6</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Type_Nm__c</fullName>
        <label>Activity Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Activity_Type</valueSetName>
        </valueSet>
        <visibleLines>6</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Brand_Nm__c</fullName>
        <label>Brand</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Brand</valueSetName>
        </valueSet>
        <visibleLines>6</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Channel_Program_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Channel Program</label>
        <referenceTo>ChannelProgram</referenceTo>
        <relationshipName>CoMarketing_Activity_Incentive_Criterias</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Effective_Dt__c</fullName>
        <label>Effective Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Incentive_Pct__c</fullName>
        <externalId>false</externalId>
        <label>Incentive</label>
        <precision>5</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Ineffective_Dt__c</fullName>
        <label>Ineffective Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Product_Type_Txt__c</fullName>
        <label>Product Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Product_Type</valueSetName>
        </valueSet>
        <visibleLines>6</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Technology_Nm__c</fullName>
        <label>Technology</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Technology</valueSetName>
        </valueSet>
        <visibleLines>6</visibleLines>
    </fields>
    <label>CoMarketing Activity Incentive Rule</label>
    <nameField>
        <displayFormat>{00000000}</displayFormat>
        <label>Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>CoMarketing Activity Incentive Rules</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Core_MDF_Channel_Program_Id__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CREATEDBY_USER</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CREATED_DATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Active_Ind__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Validate_Criteria</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(Core_MDF_Activity_Category_Nm__c) &amp;&amp;
ISBLANK(Core_MDF_Activity_Type_Nm__c) &amp;&amp;
ISBLANK(Core_MDF_Brand_Nm__c) &amp;&amp;
ISBLANK(Core_MDF_Product_Type_Txt__c) &amp;&amp;
ISBLANK(Core_MDF_Technology_Nm__c) &amp;&amp;
Core_MDF_Channel_Program_Id__c == null</errorConditionFormula>
        <errorMessage>Please select at least one criteria to create the rule</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Dates</fullName>
        <active>true</active>
        <description>Verify the ineffective date is greater than the effective date</description>
        <errorConditionFormula>Core_MDF_Ineffective_Dt__c &lt;  Core_MDF_Effective_Dt__c</errorConditionFormula>
        <errorMessage>Ineffective date cant be lesser than effective date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Incentive</fullName>
        <active>true</active>
        <description>Verify the incentive percentage is greater than 0</description>
        <errorConditionFormula>Core_MDF_Incentive_Pct__c &lt;= 0 ||
Core_MDF_Incentive_Pct__c &gt; 100</errorConditionFormula>
        <errorMessage>Please enter incentive percentage between 0 to100</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
