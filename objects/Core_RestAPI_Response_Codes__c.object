        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>RestAPI Response codes</label>
    <listViews>
        <fullName>All_RestApi</fullName>
