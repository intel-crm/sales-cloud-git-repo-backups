    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object stores the list of integration results for further displaying them in the report and dashboard</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_Error_Category__c</fullName>
        <externalId>false</externalId>
        <label>Error Category</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Error_Detail__c</fullName>
        <label>Error Detail</label>
        <length>10000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Error_Group__c</fullName>
        <description>This will store the broad error group that error is categorized</description>
        <externalId>false</externalId>
        <label>Error Group</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Integration_Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Integration Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>A&amp;E Integration Logs</relationshipLabel>
        <relationshipName>A_E_Integration_Logs</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Integration_Duration__c</fullName>
        <description>This stores the time that have lapsed since the integration started.</description>
        <externalId>false</externalId>
        <label>Integration Duration (Minutes)</label>
        <precision>5</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Integration_IIM__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Integration Inbound Message</label>
        <referenceTo>Core_Integration_Inbound_Message__c</referenceTo>
        <relationshipLabel>A&amp;E Integration Logs</relationshipLabel>
        <relationshipName>A_E_Integration_Logs</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Integration_Log_Tags__c</fullName>
        <externalId>false</externalId>
        <label>Integration Log Tags</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Integration_Source__c</fullName>
        <description>This field displays the integration system for which the log is generated</description>
        <label>Integration Source</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>AGS</fullName>
                    <default>false</default>
                    <label>AGS</label>
                </value>
                <value>
                    <fullName>ERPM</fullName>
                    <default>false</default>
                    <label>ERPM</label>
                </value>
                <value>
                    <fullName>Salesforce</fullName>
                    <default>false</default>
                    <label>Salesforce</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Log_Generation_Date__c</fullName>
        <label>Log Generation Date</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <label>A&amp;E Integration Log</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>A&amp;E_Log-{0}</displayFormat>
        <label>A&amp;E Integration Log Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>A&amp;E Integration Logs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <startsWith>Vowel</startsWith>
    <visibility>Public</visibility>
</CustomObject>
