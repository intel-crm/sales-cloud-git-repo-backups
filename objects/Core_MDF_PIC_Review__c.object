    <fields>
        <fullName>Core_MDF_AI_CycleNumber_nbr__c</fullName>
        <externalId>false</externalId>
        <label>AI Cycle Number</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_AI_PIC_Review_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>AI PIC Review ID</label>
        <referenceTo>Core_MDF_PIC_Review__c</referenceTo>
        <relationshipLabel>AI PIC Reviews</relationshipLabel>
        <relationshipName>PIC_Reviews</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_AI_PIC_Review_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If checked, it indicates the record was created by AI, and if unchecked, it indicates the record was created by a manual reviewer.</description>
        <inlineHelpText>Indicates AI Response or Manual Response.</inlineHelpText>
        <label>Is AI PIC Review?</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_ID_id__c</fullName>
        <label>Claim ID</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>PIC Reviews</relationshipLabel>
        <relationshipName>PIC_Reviews</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_CycleNumber_nbr__c</fullName>
        <externalId>false</externalId>
        <label>Cycle Number</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_EndTime_dtm__c</fullName>
        <label>End Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_MDF_External_Id__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Used for integration purpose. The value will be concatenation of claim Id and Cycle number</description>
        <externalId>true</externalId>
        <label>External Id</label>
        <length>45</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_InternalComments_txt__c</fullName>
        <label>Internal Comments</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Overall_AI_Confidence_Score_Nm__c</fullName>
        <description>To hold the Overall AI Confidence Score</description>
        <label>Overall AI Confidence Score</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>High</fullName>
                    <default>false</default>
                    <label>High</label>
                </value>
                <value>
                    <fullName>Medium</fullName>
                    <default>false</default>
                    <label>Medium</label>
                </value>
                <value>
                    <fullName>Low</fullName>
                    <default>false</default>
                    <label>Low</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Review_Date_dt__c</fullName>
        <formula>CreatedDate</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Review Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Review_Duration_in_Minutes_nbr__c</fullName>
        <externalId>false</externalId>
        <formula>IF((TIMEVALUE(Core_MDF_EndTime_dtm__c) - TIMEVALUE(Core_MDF_StartTime_dtm__c))&lt;60000,1,ROUND(((TIMEVALUE(Core_MDF_EndTime_dtm__c)) - (TIMEVALUE(Core_MDF_StartTime_dtm__c)))/60000,0))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Review Duration in Minutes</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Review_Status_nm__c</fullName>
        <label>Review Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>AI Failed</fullName>
                    <default>false</default>
                    <label>AI Failed</label>
                </value>
                <value>
                    <fullName>AI Passed</fullName>
                    <default>false</default>
                    <label>AI Passed</label>
                </value>
                <value>
                    <fullName>AI Processing Failed</fullName>
                    <default>false</default>
                    <label>AI Processing Failed</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_ReviewedBy_id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Reviewed By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>PIC_Reviews</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_StartTime_dtm__c</fullName>
        <label>Start Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <label>PIC Review</label>
    <nameField>
        <displayFormat>PR-{0000}</displayFormat>
        <label>PIC Review Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>PIC Reviews</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
