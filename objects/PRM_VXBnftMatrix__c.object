    <fields>
        <fullName>PRM_Approval_Type_Nm__c</fullName>
        <label>Approval Type</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Automatic</fullName>
                    <default>false</default>
                    <label>Automatic</label>
                </value>
                <value>
                    <fullName>Manual</fullName>
                    <default>false</default>
                    <label>Manual</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PRM_BenfitMatrix_Combination__c</fullName>
        <externalId>false</externalId>
        <formula>PRM_Channel_Program_Id__c + PRM_Channel_Program_Level_Id__c + PRM_Partner_Type_Id__c + PRM_Partner_Benefit_Id__c + TEXT( PRM_Partner_Role_Nm__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>PRM_BenfitMatrix_Combination</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Channel_Program_Id__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Partner Program</label>
        <referenceTo>ChannelProgram</referenceTo>
        <relationshipLabel>Benefit Matrix</relationshipLabel>
        <relationshipName>Benefit_Matrix_CP</relationshipName>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PRM_Channel_Program_Level_Id__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Partner Tier</label>
