    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>PRM_Restrict_FieldEdit</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.PRM_Skip_Validation_Rule_Ind__c=TRUE,FALSE,OR((ISCHANGED(PRM_Channel_Program_Id__c )), 
(ISCHANGED(PRM_Partner_Benefit_Id__c  )), 
(ISCHANGED(PRM_Partner_Type_Id__c ))))</errorConditionFormula>
        <errorMessage>Partner Benefit, Channel Program and Partner Type are not Editable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_Total_Quantity_Restriction</fullName>
        <active>true</active>
        <errorConditionFormula>AND(IF(ISBLANK(PRM_Total_Quantity_Nbr__c ),False,IF(PRM_Partner_Benefit_Id__r.PRM_Quantitative_Ind__c = false, true, false)) , $Setup.PRM_Execution_Controls__c.PRM_Skip_Validation_Rule_Ind__c = False)</errorConditionFormula>
        <errorDisplayField>PRM_Total_Quantity_Nbr__c</errorDisplayField>
        <errorMessage>Total Quantity does not apply for this Benefit</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
