        <relationshipName>Benefit_Matrix_CPL</relationshipName>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PRM_Covered_Account_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Covered Account</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PRM_IsActive_Ind__c</fullName>
        <defaultValue>true</defaultValue>
