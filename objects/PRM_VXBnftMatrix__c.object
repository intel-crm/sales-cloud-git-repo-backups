        <fullName>PRM_Total_Quantity_Nbr__c</fullName>
        <externalId>false</externalId>
        <label>Total Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Benefit Matrix</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>PRM_Partner_Benefit_Id__c</columns>
        <columns>PRM_Channel_Program_Id__c</columns>
        <columns>PRM_Channel_Program_Level_Id__c</columns>
        <columns>PRM_Partner_Type_Id__c</columns>
        <columns>PRM_Partner_Role_Nm__c</columns>
        <columns>PRM_Approval_Type_Nm__c</columns>
        <columns>PRM_IsActive_Ind__c</columns>
        <columns>PRM_Covered_Account_Ind__c</columns>
        <columns>PRM_Total_Quantity_Nbr__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>PRM_Partner_Benefit_Id__c</field>
            <operation>contains</operation>
            <value>developer</value>
        </filters>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>BX-{000}</displayFormat>
        <label>Benefit Matrix Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Benefit Matrix</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Standard</fullName>
        <active>true</active>
        <label>Standard</label>
        <picklistValues>
            <picklist>PRM_Approval_Type_Nm__c</picklist>
            <values>
                <fullName>Automatic</fullName>
                <default>false</default>
            </values>
