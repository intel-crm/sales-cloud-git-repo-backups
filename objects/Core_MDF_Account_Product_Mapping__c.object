    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>To store Account Product Mapping</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>To capture ultimate account id</description>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Account Product Mappings</relationshipLabel>
        <relationshipName>Account_Product_Mappings</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Active_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_All_Account_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>All Accounts</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Product_Active_ind__c</fullName>
        <formula>Core_MDF_Product__r.IsActive</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Product_Family_nm__c</fullName>
        <externalId>false</externalId>
        <formula>Core_MDF_Product__r.Core_Product_Family__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product Family</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Product_Type_txt__c</fullName>
        <externalId>false</externalId>
        <formula>Core_MDF_Product__r.Core_Product_Type__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>To capture product id</description>
        <label>Product</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Account Product Mappings</relationshipLabel>
        <relationshipName>Account_Product_Mappings</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Program_Account_Map__c</fullName>
        <label>Program</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Technical_Program_Name</valueSetName>
        </valueSet>
    </fields>
    <label>Account Product Mapping</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>APM-{00000}</displayFormat>
        <label>Account Product Mapping Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Product Mappings</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>Core_MDF_Account_Required_Validation</fullName>
        <active>true</active>
        <description>Throws error when All Account checkbox is false and if Account is not entered.</description>
        <errorConditionFormula>AND( Core_MDF_All_Account_Ind__c = false , ISBLANK( Core_MDF_Account__c ))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account__c</errorDisplayField>
        <errorMessage>Please provide an account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Do_Not_Select_Account</fullName>
        <active>true</active>
        <description>Throws error when All Account checkbox is true and if Account is entered.</description>
        <errorConditionFormula>AND( Core_MDF_All_Account_Ind__c = true , NOT(ISBLANK( Core_MDF_Account__c )))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account__c</errorDisplayField>
        <errorMessage>Account should be blank if All Account option is selected.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
