    <fields>
        <fullName>Core_MDF_ManualResp_Equal_AIResp_Ind__c</fullName>
        <description>Stores Boolean based on Manual Response Vs AI Response</description>
        <formula>IF(AND(LOWER(Core_MDF_Response_txt__c) = LOWER(Core_MDF_AI_PIC_Review_Detail_Id__r.Core_MDF_Response_txt__c), Core_MDF_PIC_Review_id__r.Core_MDF_AI_PIC_Review_Ind__c = FALSE),true,false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Manual Response Equal AI Response?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
