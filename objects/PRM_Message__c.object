    <validationRules>
        <fullName>PRM_EndDate_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISNEW(),
ISCHANGED( PRM_End_Date_Dt__c )
),
PRM_End_Date_Dt__c &lt;= TODAY()
)</errorConditionFormula>
        <errorMessage>End Date has to be in future. Please select a future date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_LimitTitleCharacters</fullName>
        <active>true</active>
        <description>Validation rule to limit Title of a message to be within a few characters</description>
        <errorConditionFormula>AND(
OR(
ISNEW(),
ISCHANGED( PRM_Title_Txt__c )
),
LEN( PRM_Title_Txt__c )&gt; 78
)</errorConditionFormula>
        <errorMessage>You have exceeded the Title Character Limit, only 78 characters allowed.</errorMessage>
    </validationRules>
