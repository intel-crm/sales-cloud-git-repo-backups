        <label>Environment Details Edit FieldSet</label>
    </fieldSets>
    <fields>
        <fullName>Core_Agent_Only__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>If checked, the question is shown to Agents only &amp; not shown to customers.</inlineHelpText>
        <label>Agent Only</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Environment_Variable__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Environmental Detail Question</label>
        <referenceTo>Core_IPS_Environment_Variables__c</referenceTo>
        <relationshipLabel>Environment Details Operational</relationshipLabel>
        <relationshipName>Environment_Detail_Operationals</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Order_No__c</fullName>
        <description>Refer&apos;s Core Question Order No</description>
        <externalId>false</externalId>
        <formula>Core_IPS_Question__r.Core_IPS_Order_No__c</formula>
        <label>Order No</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
