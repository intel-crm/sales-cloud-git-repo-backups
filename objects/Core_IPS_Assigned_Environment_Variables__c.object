        <inlineHelpText>Refers Core Question</inlineHelpText>
        <label>Question No</label>
        <referenceTo>Core_IPS_Question__c</referenceTo>
        <relationshipLabel>Environment Details Operational</relationshipLabel>
        <relationshipName>Environment_Details_Operational</relationshipName>
