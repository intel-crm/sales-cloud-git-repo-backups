    <label>Environment Details Operational</label>
    <nameField>
        <displayFormat>AEV-{00000000}</displayFormat>
        <label>Environment Detail ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Environment Details Operational</pluralLabel>
    <searchLayouts>
        <lookupDialogsAdditionalFields>Core_Environment_Variable__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Core_Supported_Product__c</lookupDialogsAdditionalFields>
        <searchFilterFields>NAME</searchFilterFields>
        <searchFilterFields>Core_Product_Issue_Sub_Category__c</searchFilterFields>
        <searchFilterFields>Core_Supported_Product__c</searchFilterFields>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Core_IPS_EDO_Prevent_Reverting_2_Active</fullName>
        <active>true</active>
        <description>Once EDO status is Inactive, it cannot be set to Active again.</description>
        <errorConditionFormula>$Setup.Core_IPS_Run_Rules_Exception_Admin__c.Run_Validation_Rule__c 
&amp;&amp; 
(
AND 
( TEXT(  Core_Status__c ) = &quot;ACTIVE&quot;, 
TEXT (PRIORVALUE ( Core_Status__c )) = &quot;INACTIVE&quot; 
)
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>To prevent discrepancies in Case data, reverting from Inactive to Active has been disabled. If needed, please contact Production Support to have the flag reset to Active.
Press Cancel to exit.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
