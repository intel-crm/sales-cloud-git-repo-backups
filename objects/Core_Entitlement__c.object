    <validationRules>
        <fullName>Validation_for_BT_Name_and_BT_Code</fullName>
        <active>false</active>
        <errorConditionFormula>OR(
AND(ISBLANK(Business_Types_Name__c), NOT(ISBLANK(Business_Types_Code__c))),
 
AND(ISBLANK(Business_Types_Code__c),
NOT(ISBLANK(Business_Types_Name__c)))

)</errorConditionFormula>
        <errorMessage>Business Type Name and Business Type Code should not be empty</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
