    <fields>
        <fullName>Core_Permission_Set_API_Nm__c</fullName>
        <description>Field to store the API Name of the Permission Set. This Permission Set is assigned to the user that gets this Entitlement. Multiple Entitlements can give the same Permission Set. This Permission Set is removed from the user, if the user no longer has any Entitlements tied to this Permission Set.</description>
        <externalId>false</externalId>
        <inlineHelpText>This Permission Set is assigned to the user that gets this Entitlement. Multiple Entitlements can give the same Permission Set. This Permission Set is removed from the user, if the user no longer has any Entitlements tied to this Permission Set.</inlineHelpText>
        <label>Permission Set API Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Public_Group_API_Nm__c</fullName>
        <description>Field to store the API Name of the Public Group. The User who gets this Entitlement is added to the Public Group. Multiple Entitlements can give membership to the same Public Group. The User is removed from the Public Group, if the user no longer has any Entitlements tied to this Public Group.</description>
        <externalId>false</externalId>
        <inlineHelpText>The User who gets this Entitlement is added to the Public Group. Multiple Entitlements can give membership to the same Public Group. The User is removed from the Public Group, if the user no longer has any Entitlements tied to this Public Group.</inlineHelpText>
        <label>Public Group API Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
