<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>To capture configuration values, which can we fetch using utility method defined in Core_MDF_CustomLabelconfig class.</description>
    <fields>
        <fullName>Core_MDF_Category_Txt__c</fullName>
        <description>Category of metadata</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Category</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Org_Specific_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To check specific to org</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Org Specific</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Value2_Txt__c</fullName>
        <description>Stores the value from 256th Character</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Value 2</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Value3_Txt__c</fullName>
        <description>Stores the value from 501th Character</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Value 3</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Value4_Txt__c</fullName>
        <description>Stores the value from 756th Character</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Value 4</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Value5_Txt__c</fullName>
        <description>Stores the value after Value 4</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Value 5</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Value_Txt__c</fullName>
        <description>Stores the first 255 characters of value</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Value 1</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Custom Label Configration</label>
    <pluralLabel>Custom Label Configrations</pluralLabel>
    <validationRules>
        <fullName>Core_MDF_Value_Order_Validation</fullName>
        <active>true</active>
        <description>To validate if user is populating value in right order sequence.</description>
        <errorConditionFormula>OR(AND(ISBLANK(Core_MDF_Value_Txt__c),NOT(ISBLANK(Core_MDF_Value2_Txt__c))),
   AND(ISBLANK(Core_MDF_Value_Txt__c),NOT(ISBLANK(Core_MDF_Value3_Txt__c))),
   AND(ISBLANK(Core_MDF_Value_Txt__c),NOT(ISBLANK(Core_MDF_Value4_Txt__c))),
   AND(ISBLANK(Core_MDF_Value_Txt__c),ISBLANK(Core_MDF_Value2_Txt__c),NOT(ISBLANK(Core_MDF_Value3_Txt__c))),
   AND(ISBLANK(Core_MDF_Value_Txt__c),ISBLANK(Core_MDF_Value2_Txt__c),NOT(ISBLANK(Core_MDF_Value4_Txt__c))),
   AND(ISBLANK(Core_MDF_Value_Txt__c),ISBLANK(Core_MDF_Value2_Txt__c),ISBLANK(Core_MDF_Value3_Txt__c),NOT(ISBLANK(Core_MDF_Value4_Txt__c))),
   AND(NOT(ISBLANK(Core_MDF_Value_Txt__c)),ISBLANK(Core_MDF_Value2_Txt__c),NOT(ISBLANK(Core_MDF_Value3_Txt__c)),NOT(ISBLANK(Core_MDF_Value4_Txt__c))),
   AND(NOT(ISBLANK(Core_MDF_Value_Txt__c)),NOT(ISBLANK(Core_MDF_Value2_Txt__c)),ISBLANK(Core_MDF_Value3_Txt__c),NOT(ISBLANK(Core_MDF_Value4_Txt__c))),
   AND(NOT(ISBLANK(Core_MDF_Value_Txt__c)),ISBLANK(Core_MDF_Value2_Txt__c),ISBLANK(Core_MDF_Value3_Txt__c),NOT(ISBLANK(Core_MDF_Value4_Txt__c))),
   AND(NOT(ISBLANK(Core_MDF_Value_Txt__c)),ISBLANK(Core_MDF_Value2_Txt__c),NOT(ISBLANK(Core_MDF_Value3_Txt__c)),NOT(ISBLANK(Core_MDF_Value4_Txt__c))),
   AND(NOT(ISBLANK(Core_MDF_Value_Txt__c)),ISBLANK(Core_MDF_Value2_Txt__c),NOT(ISBLANK(Core_MDF_Value3_Txt__c)),ISBLANK(Core_MDF_Value4_Txt__c)))</errorConditionFormula>
        <errorMessage>Please populate values in right sequence. Eg. Value 1 should be populated before Value 2/3/4 and likewise.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
