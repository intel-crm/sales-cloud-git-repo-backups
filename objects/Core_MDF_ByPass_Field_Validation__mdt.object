<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This metadata is used to bypass required field validation for any new field created in a release to avoid data scrub.</description>
    <fields>
        <fullName>Core_MDF_Active__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_ByPass_Validation_Date__c</fullName>
        <description>Holds the date beyond which the validation needs to be executed</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>ByPass Validation Date</label>
        <required>true</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_ByPass_for_All_Program__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Make checkbox true to bypass validation for All programs</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>ByPass for All Program</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Field_Api_Name__c</fullName>
        <description>Holds API name of the field which needs to be bypassed</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Field Api Name</label>
        <length>80</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Object__c</fullName>
        <description>Holds Object Name</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Object</label>
        <length>80</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Program__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Program</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Client Co-Marketing Fund</fullName>
                    <default>false</default>
                    <label>Client Co-Marketing Fund</label>
                </value>
                <value>
                    <fullName>Data Center Co-Marketing Fund</fullName>
                    <default>false</default>
                    <label>Data Center Co-Marketing Fund</label>
                </value>
                <value>
                    <fullName>Retail Marketing Funds</fullName>
                    <default>false</default>
                    <label>Retail Marketing Funds</label>
                </value>
                <value>
                    <fullName>Intel Partner Alliance</fullName>
                    <default>false</default>
                    <label>Intel Partner Alliance</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Release__c</fullName>
        <description>Holds release on which the field was made</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Release</label>
        <length>10</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>ByPass Field Validation</label>
    <pluralLabel>ByPass Field Validations</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
