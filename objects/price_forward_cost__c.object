    <label>Forward Cost</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>core_cpq_product_opn_txt__c</columns>
        <columns>core_cpq_fc_start_date_dt__c</columns>
        <columns>core_cpq_fc_end_date_dt__c</columns>
        <columns>price_forward_cost_amt__c</columns>
        <columns>core_cpq_fc_active_cb__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>price_forward_cost__c.PSG_Forward_Cost_Record_Type</value>
        </filters>
        <label>All Forward Cost</label>
    </listViews>
    <listViews>
        <fullName>PSG_Forward_Cost_Next_05_years</fullName>
        <booleanFilter>1 AND 2 AND 3</booleanFilter>
        <columns>NAME</columns>
        <columns>core_cpq_product_opn_txt__c</columns>
        <columns>core_cpq_fc_start_date_dt__c</columns>
        <columns>core_cpq_fc_end_date_dt__c</columns>
        <columns>price_forward_cost_amt__c</columns>
        <columns>core_cpq_fc_active_cb__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>price_forward_cost__c.PSG_Forward_Cost_Record_Type</value>
        </filters>
        <filters>
            <field>core_cpq_fc_active_cb__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>core_cpq_fc_start_date_dt__c</field>
            <operation>lessOrEqual</operation>
            <value>NEXT_N_YEARS:5</value>
        </filters>
        <label>01 - Forward Cost (Next 05 years)</label>
        <sharedTo>
            <group>ags_internal_users</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>PSG_Forward_Cost_Next_10_years</fullName>
        <columns>NAME</columns>
        <columns>core_cpq_product_opn_txt__c</columns>
        <columns>core_cpq_fc_start_date_dt__c</columns>
        <columns>core_cpq_fc_end_date_dt__c</columns>
        <columns>price_forward_cost_amt__c</columns>
        <columns>core_cpq_fc_active_cb__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>price_forward_cost__c.PSG_Forward_Cost_Record_Type</value>
        </filters>
        <filters>
            <field>core_cpq_fc_active_cb__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>core_cpq_fc_start_date_dt__c</field>
            <operation>greaterThan</operation>
            <value>NEXT_N_YEARS:5</value>
        </filters>
        <filters>
            <field>core_cpq_fc_start_date_dt__c</field>
            <operation>lessOrEqual</operation>
            <value>NEXT_N_YEARS:10</value>
        </filters>
        <label>01 - Forward Cost (Next 10 years)</label>
        <sharedTo>
            <group>ags_internal_users</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>PSG_Forward_Cost_Next_15_years</fullName>
        <columns>NAME</columns>
        <columns>core_cpq_product_opn_txt__c</columns>
        <columns>core_cpq_fc_start_date_dt__c</columns>
        <columns>core_cpq_fc_end_date_dt__c</columns>
        <columns>price_forward_cost_amt__c</columns>
        <columns>core_cpq_fc_active_cb__c</columns>
