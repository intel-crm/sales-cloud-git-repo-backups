    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>PSG_Start_Date_Greater_Than_End_Date</fullName>
        <active>true</active>
        <description>This rule is used to validate the forward cost start date greater than end date.</description>
        <errorConditionFormula>AND( RecordType.DeveloperName ==  $Label.PSG_Forward_Cost_Record_Type,
 core_cpq_fc_start_date_dt__c  &gt;  core_cpq_fc_end_date_dt__c
)</errorConditionFormula>
        <errorDisplayField>core_cpq_fc_start_date_dt__c</errorDisplayField>
        <errorMessage>Start Date cannot be greater than End Date</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
