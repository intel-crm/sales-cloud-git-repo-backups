    <searchLayouts>
        <searchResultsAdditionalFields>core_cpq_product_opn_txt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>core_cpq_fc_start_date_dt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>core_cpq_fc_end_date_dt__c</searchResultsAdditionalFields>
