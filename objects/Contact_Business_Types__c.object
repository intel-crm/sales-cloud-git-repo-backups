    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object associate the Contact &amp; the business types. e.g., David Miller is a RDC/PSG/IQR contact</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Business_Types__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Business Types</label>
        <referenceTo>Business_Types__c</referenceTo>
        <relationshipLabel>Contact Business Types</relationshipLabel>
        <relationshipName>Contact_Business_Types</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Contact__c</fullName>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Contact Business Types</relationshipLabel>
        <relationshipName>Contact_Business_Types</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Pending_Registration__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Update with flow builder and used in Validation</description>
        <label>Pending Registration</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Status_Reason__c</fullName>
        <label>Status Reason</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Approval - Pending</fullName>
                    <default>true</default>
                    <label>Approval - Pending</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Inactive</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Inactive</label>
                </value>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Rejection - Pending</fullName>
                    <default>false</default>
                    <label>Removal - Pending</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Removed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Contact Business Types</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>CAT-{00000}</displayFormat>
        <label>Contact Business Types Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Contact Business Types</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>CBT_Validations</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
ISPICKVAL( Status__c , &apos;Approved&apos;) &amp;&amp;
CONTAINS(Business_Types__r.Name, &apos;Developer Zone Premier&apos;) &amp;&amp;
(ISBLANK( Contact__r.Core_English_Only_First_Name__c) &amp;&amp;  
ISBLANK( Contact__r.Core_English_Only_Last_Name__c ))
,true,false
)</errorConditionFormula>
        <errorDisplayField>Status__c</errorDisplayField>
        <errorMessage>CBT cannot be approved due one or more validations errors.
• Contact&apos;s &apos;English Only First Name&apos; is Blank
• Contact&apos;s &apos;English Only Last Name&apos; is Blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Registration_Record_is_still_Pending</fullName>
        <active>true</active>
        <description>validation rule to restrict addition of CBT=Approved for a contact when Registration request for the same contact is pending</description>
        <errorConditionFormula>OR(
Pending_Registration__c = true,
ISPICKVAL(Contact__r.Pending_Registration__c, &apos;Yes&apos;)
)</errorConditionFormula>
        <errorMessage>Registration record is still Pending</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
