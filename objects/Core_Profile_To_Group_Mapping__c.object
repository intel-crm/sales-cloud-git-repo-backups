<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Table to store the list of Profiles and their corresponding Public Groups. A user is added/removed from the Public Group based on user&apos;s Profile.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Core_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Group_Name__c</fullName>
        <externalId>false</externalId>
        <label>Group Name</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Profile_Name__c</fullName>
        <externalId>false</externalId>
        <label>Profile Name</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Profile To Group Mapping</label>
    <listViews>
        <fullName>All_Records</fullName>
        <columns>NAME</columns>
        <columns>Core_Profile_Name__c</columns>
        <columns>Core_Group_Name__c</columns>
        <columns>Core_Active__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>UPDATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <label>All Records</label>
    </listViews>
    <visibility>Public</visibility>
</CustomObject>
