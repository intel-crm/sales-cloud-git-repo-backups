    <fields>
        <fullName>Pricing_Active_cb__c</fullName>
        <defaultValue>true</defaultValue>
        <description>checkbox to identify if the record is active or not</description>
        <label>Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Pricing_Competitor_Product_Provider_Nm__c</fullName>
        <externalId>false</externalId>
        <label>Competitor Product Provider</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Competitor Product</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Pricing_Competitor_Product_Provider_Nm__c</columns>
        <columns>RECORDTYPE</columns>
        <columns>Pricing_Active_cb__c</columns>
        <columns>UPDATEDBY_USER</columns>
        <columns>LAST_UPDATE</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <label>Competitor Product Name</label>
        <trackHistory>true</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Competitor Products</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Pricing_Client</fullName>
        <active>true</active>
        <label>Client</label>
    </recordTypes>
    <recordTypes>
        <fullName>Pricing_Data_Center</fullName>
        <active>true</active>
        <label>Data Center</label>
    </recordTypes>
    <recordTypes>
        <fullName>Pricing_GPU</fullName>
        <active>true</active>
        <description>Represents GPU Competitor Products</description>
        <label>Graphics</label>
    </recordTypes>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Block_Write_In_Product_Rename</fullName>
        <active>true</active>
        <description>Users should not be able to rename the Write In Product</description>
        <errorConditionFormula>AND(ISCHANGED(Name) , PRIORVALUE(Name) = &apos;Write In Product&apos;)</errorConditionFormula>
        <errorMessage>Write In Product cannot be renamed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Inactive_Checkbox_For_DPM</fullName>
        <active>true</active>
        <description>Divisional Pricing Manager should not be able to inactive Write In Competitor Product.</description>
        <errorConditionFormula>AND( $Permission.Pricing_Tender_Divisional_Pricing_Manager ,  NOT( Pricing_Active_cb__c ) , Name  = &apos;Write In Product&apos;)</errorConditionFormula>
        <errorMessage>Write In competitor product cannot be inactivated.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Restrict_RecordType_Change</fullName>
        <active>true</active>
        <description>Record Type cannot be changed for Competitor Product.</description>
        <errorConditionFormula>ISCHANGED( RecordTypeId )</errorConditionFormula>
        <errorMessage>Record Type cannot be changed for Competitor Product.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
