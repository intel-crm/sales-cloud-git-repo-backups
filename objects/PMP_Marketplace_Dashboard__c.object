    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This Object Contains Marketplace Analytics Data populated from IAH View via Mulesoft. The Data will be used to show the Metrics Data for Marketplace Dashboard Requirements</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>PMP_External_ID__c</fullName>
        <externalId>true</externalId>
        <label>External ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_PAG_ID__c</fullName>
        <description>This Field Checks if the User belongs to the same One Partner Group ( used primarily for Dashboard Runtime User)</description>
        <externalId>false</externalId>
        <formula>IF(OR($Profile.Name = &quot;System Administrator&quot;,$Profile.Name = &quot;IT Admin&quot;),&apos;TRUE&apos;, IF ($User.Core_IPA_One_Partner_Id__c  ==  PMP_Rpt_MP_Partner_ID__r.PMP_One_Partner_ID__c , &apos;TRUE&apos;,IF ($User.Core_IPA_One_Partner_Id__c == &quot;&quot;, &apos;TRUE&apos;, &apos;FALSE&apos;)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>PAG ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Rpt_CP_Ask_A_Question_Count__c</fullName>
        <externalId>false</externalId>
