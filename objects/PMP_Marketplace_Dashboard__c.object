        <description>Marketplace Partner ID Lookup to get the Storefront ID</description>
        <label>Marketplace Partner ID</label>
        <referenceTo>PMP_Company__c</referenceTo>
        <relationshipLabel>Marketplace Dashboards</relationshipLabel>
