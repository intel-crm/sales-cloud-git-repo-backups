        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Rpt_Offering_ID__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Look up to Offering but it can be Null when populated from IAH</description>
        <label>Offering ID</label>
        <referenceTo>PMP_Partner_Offering__c</referenceTo>
        <relationshipLabel>Marketplace Dashboards</relationshipLabel>
