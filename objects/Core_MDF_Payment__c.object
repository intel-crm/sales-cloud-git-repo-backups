    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_COGTM_Payment_Edit_Validation</fullName>
        <active>false</active>
        <description>Payment Nature Should be Vistex cash or Credit</description>
        <errorConditionFormula>AND(
  RecordType.DeveloperName = &apos;Core_MDF_Co_GTM&apos;,
  NOT(ISBLANK(Core_MDF_Payment_Run_Id__c)),
  NOT(OR(INCLUDES(Core_MDF_Payment_Run_Id__r.Core_MDF_Payment_Nature_nm__c, &apos;Contra Vistex&apos;),
         INCLUDES(Core_MDF_Payment_Run_Id__r.Core_MDF_Payment_Nature_nm__c, &apos;Contra CSAR&apos;))),
  $Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm,
NOT($Permission.Core_MDF_CCP_Internal_Payment_Admin_Manager),
  OR(
    ISCHANGED(Core_MDF_EFT_Nbr__c),
    ISCHANGED(Core_MDF_Payment_Made_Dt__c),
    ISCHANGED(Core_MDF_Payment_Status_Txt__c),
    ISCHANGED(Core_MDF_RMF_Actual_Payment_Amt__c)
  )
)</errorConditionFormula>
        <errorMessage>Payment status update is only allowed for Vistex Cash and Vistex Credit payments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ActualAmtGreaterThanProposedAmt</fullName>
        <active>true</active>
        <description>Actual Payment Amount Can&apos;t be greater than Proposed Payment Amount.</description>
        <errorConditionFormula>AND(OR(INCLUDES(Core_MDF_Payment_Run_Id__r.Core_MDF_Budget_Type_nm__c,&quot;RSA MD&quot;),INCLUDES(Core_MDF_Payment_Run_Id__r.Core_MDF_Budget_Type_nm__c,&quot;MDF&quot;),INCLUDES(Core_MDF_Payment_Run_Id__r.Core_MDF_Budget_Type_nm__c,&quot;MDF+&quot;)) , Core_MDF_RMF_Actual_Payment_Amt__c &gt; 
Core_MDF_RMF_Proposed_Payment_Amt__c)</errorConditionFormula>
        <errorMessage>Actual Payment Amount Cannot Exceed the Proposed Payment Amount</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Allow_Edit_MDF_Payments</fullName>
        <active>true</active>
        <description>To allow edit access on custom permissions</description>
        <errorConditionFormula>AND( OR(RecordType.DeveloperName=&apos;Core_MDF_Client_Co_Marketing_Fund_MDF&apos;, RecordType.DeveloperName=&apos;Core_MDF_Data_Center_Co_Marketing_Fund_MDF&apos;), NOT( $Permission.Core_MDF_Allow_Edit_for_MDF_Payments ),OR( ISCHANGED( Core_MDF_Payment_Status_Txt__c ),  ISCHANGED( Core_MDF_RMF_Actual_Payment_Amt__c ),  ISCHANGED( Core_MDF_Payment_Made_Dt__c ), ISCHANGED( Core_MDF_EFT_Nbr__c )  ))</errorConditionFormula>
        <errorMessage>This user does not have access to edit the MDF Payment.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_BlockPaidToPendingPayment</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISCHANGED(Core_MDF_Payment_Status_Txt__c),
TEXT(PRIORVALUE(Core_MDF_Payment_Status_Txt__c)) = &quot;Paid&quot;,
TEXT(Core_MDF_Payment_Status_Txt__c) = &quot;Pending Payment&quot;
)</errorConditionFormula>
        <errorMessage>A payment marked as Paid cannot be reverted to Pending Payment.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CheckActualPaymentAmtNotBlank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(INCLUDES(Core_MDF_Payment_Run_Id__r.Core_MDF_Budget_Type_nm__c,&quot;RSA MD&quot;),INCLUDES(Core_MDF_Payment_Run_Id__r.Core_MDF_Budget_Type_nm__c,&quot;MDF&quot;),INCLUDES(Core_MDF_Payment_Run_Id__r.Core_MDF_Budget_Type_nm__c,&quot;MDF+&quot;)),
   ISBLANK(Core_MDF_RMF_Actual_Payment_Amt__c) ,
    ISPICKVAL(Core_MDF_Payment_Status_Txt__c, &apos;Paid&apos;))</errorConditionFormula>
        <errorMessage>Actual Payment Amount is mandatory.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
