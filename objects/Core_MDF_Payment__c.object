        <type>Default</type>
    </actionOverrides>
    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Store the information of all the payments</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_AccountCompany_Txt__c</fullName>
        <description>The company the Payment is related to</description>
        <externalId>false</externalId>
        <label>Account (Company)</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Account (Company)</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Payments</relationshipLabel>
        <relationshipName>Payments2</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Type_Nm__c</fullName>
        <label>Budget Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Budget_Types</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Type_Txt__c</fullName>
        <description>Formula field to populate Budget Type on Payment. It is used in List View.</description>
        <externalId>false</externalId>
        <formula>IF( RecordType.DeveloperName == &apos;Core_MDF_RMF_MDF&apos;, &apos;Retail MDF&apos;, IF(RecordType.DeveloperName == &apos;Core_MDF_RMF_MD&apos;, &apos;RSA MD&apos;, &apos;&apos;) )</formula>
        <label>Budget Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Comments_txt__c</fullName>
        <label>Comments</label>
        <length>5000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Conversion_Rate_Nbr__c</fullName>
        <description>Conversion Rate of USD into local Bank Currency . It is used in Retail MDF payment record and in payment file .</description>
        <externalId>false</externalId>
        <label>Conversion Rate</label>
        <precision>18</precision>
        <required>false</required>
        <scale>12</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Converted_Amt_Nbr__c</fullName>
        <description>Amount after getting converted from USD into Bank&apos;s currency. This field is used in Retail MDF record as well as in file</description>
        <externalId>false</externalId>
        <label>Converted Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>6</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_CreatedBy_Nm__c</fullName>
        <description>Shows the name for external user if created by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF (
ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;),
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Currency_Cd_Txt__c</fullName>
        <description>Currency code of claim&apos;s bank grouped in a single payment record.</description>
        <externalId>false</externalId>
        <label>Currency Code</label>
        <length>25</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_EFT_Nbr__c</fullName>
        <label>EFT Number</label>
        <length>1000</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Geo_Txt__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Core_MDF_Payment_Run_Id__r.Core_MDF_Geo_Txt__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payment Run Geo</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Last_ModifiedBy_Nm__c</fullName>
        <description>Shows the name for external user if last modified by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(LastModifiedBy.Profile.UserType,&apos;PowerPartner&apos;),
LastModifiedBy.FirstName &amp; &apos; &apos; &amp; LastModifiedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Last Modified By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Owner_Nm__c</fullName>
        <description>Shows the name for external user if Owner is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL( Owner:User.Profile.UserType ,&apos;PowerPartner&apos;),
Owner:User.FirstName &amp; &apos; &apos; &amp; Owner:User.LastName ,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Paid_Amt__c</fullName>
        <label>Paid Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Payment_Made_Dt__c</fullName>
        <label>Payment Made On</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Payment_No_Txt__c</fullName>
        <description>Payment reference number used by the loopback batch for updating the payments once payment is done.</description>
        <externalId>false</externalId>
        <formula>IF( Core_MDF_Program_Txt__c = &apos;Client Co-Marketing Fund Boost&apos;, 
Name + &quot;-&quot; + &apos;CCF_BOOST&apos;,

Name + &quot; - &quot; + CASE(Core_MDF_Program_Txt__c,
&apos;Client&apos;, 
&apos;CCF&apos;,
 
&apos;Datacenter&apos;, 
&apos;DCF&apos;,

&apos;Service Provider Co-Marketing Fund&apos;,
&apos;SPCF&apos;,

&apos;Retail Marketing Funds&apos;,
 IF(INCLUDES(Core_MDF_Payment_Run_Id__r.Core_MDF_Budget_Type_nm__c, &apos;Retail MDF&apos;) , &apos;RMF - MDF&apos;, &apos;RMF - MD&apos;) ,

&apos;Intel Partner Alliance&apos;,
&apos;IPA&apos;,

&apos;Co-GTM&apos;,
&apos;COGTM&apos;,
&apos;&apos;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payment Number</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Payment_Run_Id__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Payment Run</label>
        <referenceTo>Core_MDF_Payment_Run__c</referenceTo>
        <relationshipLabel>Payments (Payment Run)</relationshipLabel>
        <relationshipName>Payments1</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Payment_Sent_Dt__c</fullName>
        <defaultValue>TODAY()</defaultValue>
        <label>Payment Sent On</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Payment_Status_Txt__c</fullName>
        <label>Payment Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Paid</fullName>
                    <default>false</default>
                    <label>Paid</label>
                </value>
                <value>
                    <fullName>Pending Payment</fullName>
                    <default>true</default>
                    <label>Pending Payment</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Payment_Sub_Geo_Txt__c</fullName>
        <description>Formula to populate the Sub Geo for ASMO region on Payment .It is used in List View.</description>
        <externalId>false</externalId>
        <formula>IF(AND(ISPICKVAL( Core_MDF_Payment_Run_Id__r.Core_MDF_Geo_Txt__c , &apos;ASMO&apos;),ISPICKVAL( Core_MDF_Payment_Run_Id__r.Core_MDF_Subgeo_Txt__c , &apos;NAR&apos;)), &apos;NAR&apos;, IF(AND(ISPICKVAL( Core_MDF_Payment_Run_Id__r.Core_MDF_Geo_Txt__c , &apos;ASMO&apos;),ISPICKVAL( Core_MDF_Payment_Run_Id__r.Core_MDF_Subgeo_Txt__c , &apos;LAR&apos;)), &apos;LAR&apos;,&apos;&apos;))</formula>
        <label>Payment Sub Geo</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Payment_Type_txt__c</fullName>
        <externalId>false</externalId>
        <label>Payment Type</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Program_Txt__c</fullName>
        <externalId>false</externalId>
        <formula>Core_MDF_Payment_Run_Id__r.Core_MDF_Program_Id__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Program</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_RMF_Actual_Payment_Amt__c</fullName>
        <description>It is a retail field. It is the actual amount paid as part of the payment. Initially this field would be same as Paid Amount field. Retail Payment Admin would update this field with the actual amount PAID after Payment.</description>
        <label>Actual Payment Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_RMF_Proposed_Payment_Amt__c</fullName>
        <description>It is the Retail field .It is the proposed payment amount to be paid  as part of  the payment. This field value would be same as Paid Amount field.</description>
        <formula>Core_MDF_Paid_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Proposed Payment Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <label>Payment</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Payment_Run_Id__c</columns>
        <columns>Core_MDF_Program_Txt__c</columns>
        <columns>Core_MDF_Budget_Type_Nm__c</columns>
        <columns>Core_MDF_Payment_No_Txt__c</columns>
        <columns>Core_MDF_Paid_Amt__c</columns>
        <columns>Core_MDF_Payment_Sent_Dt__c</columns>
        <columns>Core_MDF_Payment_Made_Dt__c</columns>
        <columns>Core_MDF_RMF_Proposed_Payment_Amt__c</columns>
        <columns>Core_MDF_RMF_Actual_Payment_Amt__c</columns>
        <columns>Core_MDF_Payment_Status_Txt__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>CCF_MDF_Payments</fullName>
        <booleanFilter>1 AND 2</booleanFilter>
        <columns>NAME</columns>
        <columns>Core_MDF_Payment_Run_Id__c</columns>
        <columns>Core_MDF_Payment_No_Txt__c</columns>
        <columns>Core_MDF_Account_Id__c</columns>
        <columns>Core_MDF_Payment_Sent_Dt__c</columns>
        <columns>Core_MDF_Payment_Made_Dt__c</columns>
        <columns>Core_MDF_RMF_Proposed_Payment_Amt__c</columns>
        <columns>Core_MDF_RMF_Actual_Payment_Amt__c</columns>
        <columns>Core_MDF_Payment_Status_Txt__c</columns>
        <columns>Core_MDF_Budget_Type_Nm__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Budget_Type_Nm__c</field>
            <operation>includes</operation>
            <value>MDF,MDF+</value>
        </filters>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>Core_MDF_Payment__c.Core_MDF_Client_Co_Marketing_Fund_MDF</value>
        </filters>
        <label>CCF MDF/MDF+ Payments</label>
        <sharedTo>
            <group>CORE_MDF_CCP_CCF_ALL</group>
            <group>Core_MDF_CCP_CCF_INTERNAL_ALL</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Core_MDF_RSA_MD_ASMO_LAR</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Payment_Run_Id__c</columns>
        <columns>Core_MDF_Payment_No_Txt__c</columns>
        <columns>Core_MDF_Account_Id__c</columns>
        <columns>Core_MDF_Payment_Sent_Dt__c</columns>
        <columns>Core_MDF_Payment_Made_Dt__c</columns>
        <columns>Core_MDF_RMF_Proposed_Payment_Amt__c</columns>
        <columns>Core_MDF_RMF_Actual_Payment_Amt__c</columns>
        <columns>Core_MDF_Payment_Status_Txt__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>Core_MDF_Payment__c.Core_MDF_RMF_MD</value>
        </filters>
        <filters>
            <field>Core_MDF_Geo_Txt__c</field>
            <operation>equals</operation>
            <value>ASMO</value>
        </filters>
        <filters>
            <field>Core_MDF_Payment_Sub_Geo_Txt__c</field>
            <operation>equals</operation>
            <value>LAR</value>
        </filters>
        <filters>
            <field>Core_MDF_Budget_Type_Nm__c</field>
            <operation>equals</operation>
            <value>RSA MD</value>
        </filters>
        <label>RSA - MD (ASMO - LAR)</label>
        <sharedTo>
            <group>Core_MDF_CCP_Int_Retail_ASMO_LAR</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Core_MDF_Retail_MDF_ASMO_LAR</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Payment_Run_Id__c</columns>
        <columns>Core_MDF_Payment_No_Txt__c</columns>
        <columns>Core_MDF_Account_Id__c</columns>
        <columns>Core_MDF_Payment_Sent_Dt__c</columns>
        <columns>Core_MDF_Payment_Made_Dt__c</columns>
        <columns>Core_MDF_Currency_Cd_Txt__c</columns>
        <columns>Core_MDF_Conversion_Rate_Nbr__c</columns>
        <columns>Core_MDF_Converted_Amt_Nbr__c</columns>
        <columns>Core_MDF_Payment_Status_Txt__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Geo_Txt__c</field>
            <operation>equals</operation>
            <value>ASMO</value>
        </filters>
        <filters>
            <field>Core_MDF_Payment_Sub_Geo_Txt__c</field>
            <operation>equals</operation>
            <value>LAR</value>
        </filters>
        <filters>
            <field>Core_MDF_Budget_Type_Nm__c</field>
            <operation>equals</operation>
            <value>Retail MDF</value>
        </filters>
        <filters>
            <field>Core_MDF_Program_Txt__c</field>
            <operation>equals</operation>
            <value>Retail Marketing Funds</value>
        </filters>
        <label>Retail - MDF (ASMO - LAR)</label>
        <sharedTo>
            <group>Core_MDF_CCP_Int_Retail_ASMO_LAR</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>DCF_MDF_Payments</fullName>
