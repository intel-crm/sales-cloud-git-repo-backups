        <externalId>false</externalId>
        <formula>IF(Core_Header_Or_Product_Ind__c =&apos;Product&apos;, 
Core_Converted_Design_Or_Product_Nm__c, &apos;&apos;)</formula>
        <inlineHelpText>Align the &quot;Converted Design/Product Name&quot; value to either &quot;Registration Number&quot; or &quot;Design Registration Line ID&quot; based on &quot;Header/Product&quot; value.</inlineHelpText>
