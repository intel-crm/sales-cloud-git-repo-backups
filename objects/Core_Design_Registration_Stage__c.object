        <description>IF( Core_Design_Registration_Header_Prod_ID__c != NULL, 
IF( Core_Header_Or_Product_Ind__c = &apos;Header&apos;, 
&apos;&apos;+ HYPERLINK(&apos;/&apos;+Core_Design_Registration_Header_Prod_ID__c, Core_Design_Registration_Header_Prod_Nm__c, &apos;&apos;) , 
&apos;&apos;+ HYPERLINK(&apos;/&apos;+Core_Design_Registration_Header_Prod_ID__c, Core_Design_Registration_Header_Prod_Nm__c,&apos;&apos;)), 

&apos;No records created&apos;)</description>
        <externalId>false</externalId>
        <formula>IF( Core_Converted_Design_Or_Product_Id__c != NULL, 
HYPERLINK(Left($Api.Enterprise_Server_URL_190,(find(&apos;/services&apos;,$Api.Enterprise_Server_URL_190))) +  Core_Converted_Design_Or_Product_Id__c , Core_Converted_Design_Or_Product_Nm__c,&apos;&apos;), 
&apos;No records created&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Converted Design/Product</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
