        <columns>Core_Header_Or_Product_Ind__c</columns>
        <columns>Core_Processing_Status_Nm__c</columns>
        <columns>Core_Message_Txt__c</columns>
        <columns>Core_Converted_Design_Or_Product_URL_Txt__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <listViews>
        <fullName>Last_Month_Records</fullName>
        <columns>NAME</columns>
        <columns>Core_Group_Id__c</columns>
        <columns>Core_Header_Or_Product_Ind__c</columns>
        <columns>Core_Processing_Status_Nm__c</columns>
        <columns>Core_Message_Txt__c</columns>
        <columns>Core_Converted_Design_Or_Product_URL_Txt__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>equals</operation>
            <value>LAST_N_DAYS:30</value>
        </filters>
        <label>Last Month Records</label>
        <language>en_US</language>
    </listViews>
    <listViews>
        <fullName>Today_s_Record</fullName>
        <columns>NAME</columns>
        <columns>Core_Group_Id__c</columns>
        <columns>Core_Header_Or_Product_Ind__c</columns>
        <columns>Core_Processing_Status_Nm__c</columns>
        <columns>Core_Message_Txt__c</columns>
        <columns>Core_Converted_Design_Or_Product_URL_Txt__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>equals</operation>
            <value>TODAY</value>
        </filters>
        <label>Today&apos;s Record</label>
        <language>en_US</language>
    </listViews>
