<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Custom Setting to Bypass SWS related Validation Rules</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Allow_Creator__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field allow us to include creator in redemption batch.</description>
        <label>Allow Creator</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Bypass__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Bypass</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Last_Batch_Update__c</fullName>
        <description>This field is used to track the last batch run details for coupon redemption details.</description>
        <label>Last Batch Update</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <label>SWS Bypass Validation Rule</label>
    <visibility>Public</visibility>
</CustomObject>
