    <fields>
        <fullName>PRM_Account_Channel_Program_Key__c</fullName>
        <description>This field will be used as an unique key to Identify the duplicate records.</description>
        <externalId>false</externalId>
        <formula>PRM_Account_Id__c +  PRM_Channel_Program_Id__c  +TEXT(PRM_Partner_Role__c) + 
IF(ISPICKVAL(PRM_Partner_Role__c, &quot;Not Applicable&quot;), NULL, &quot;/&quot;) + TEXT(PRM_Partner_Role__c) + IF(ISPICKVAL(PRM_Partner_Role__c,&quot;Distributor&quot;), NULL, &quot;/&quot;) 
+ TEXT(PRM_Partner_Role__c) + IF(ISPICKVAL(PRM_Partner_Role__c,&quot;FPGA Designer&quot;), NULL, &quot;/&quot;)  + TEXT(PRM_Partner_Role__c) + IF(ISPICKVAL(PRM_Partner_Role__c,&quot;Independent Software Vendor&quot;), NULL, &quot;/&quot;) + TEXT(PRM_Partner_Role__c) + IF(ISPICKVAL(PRM_Partner_Role__c,&quot;Manufacturer&quot;), NULL, &quot;/&quot;) + TEXT(PRM_Partner_Role__c) + IF(ISPICKVAL(PRM_Partner_Role__c,&quot;Seller&quot;), NULL, &quot;/&quot;) + TEXT(PRM_Partner_Role__c) + IF(ISPICKVAL(PRM_Partner_Role__c,&quot;Service Provider&quot;), NULL, &quot;/&quot;) + TEXT(PRM_Partner_Role__c) + IF(ISPICKVAL(PRM_Partner_Role__c,&quot;Solution Integrator&quot;), NULL, &quot;/&quot;)</formula>
        <label>Account Channel Program Key</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
