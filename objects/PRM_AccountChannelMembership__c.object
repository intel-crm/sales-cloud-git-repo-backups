    <validationRules>
        <fullName>PRM_Validate_Tier</fullName>
        <active>true</active>
        <errorConditionFormula>AND(PRM_Channel_Program_Level_Id__r.PRM_inactind__c, PRM_Channel_Program_Level_Id__r.Program.Name = &apos;Intel Partner Alliance&apos;, $Label.PRM_IPARefresh =&apos;TRUE&apos;)</errorConditionFormula>
        <errorMessage>Please select either Partner/Prestige tier</errorMessage>
    </validationRules>
