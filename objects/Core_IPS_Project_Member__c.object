    <fields>
        <fullName>Add_as_Case_Interested_Party__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>Adds member as an Interested Party on New or Open Cases</inlineHelpText>
        <label>Add as Case Interested Party</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_ContactName__c</fullName>
        <externalId>false</externalId>
        <formula>Core_IPS_Contact__r.FirstName &amp; &apos; &apos;  &amp; Core_IPS_Contact__r.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contact Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Contact_Account__c</fullName>
        <description>Account related to IPS Contact on Project</description>
        <externalId>false</externalId>
        <formula>Core_IPS_Contact__r.Account.Name</formula>
        <label>Account</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Contact_Email__c</fullName>
        <externalId>false</externalId>
        <formula>IF (ISBLANK(Core_IPS_Contact__r.Id), &quot;&quot;, Core_IPS_Contact__r.Email)</formula>
        <label>Contact Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Contact_IPS_Active__c</fullName>
        <formula>Core_IPS_Contact__r.Core_IPS_Active__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contact IPS Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Contact__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Contact Name</label>
        <lookupFilter>
            <active>false</active>
            <filterItems>
                <field>Contact.Core_IPS_Active__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Premier Support Project Members</relationshipLabel>
        <relationshipName>Project_Members</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Project__c</fullName>
        <label>Premier Support Project</label>
        <referenceTo>Core_IPS_Project__c</referenceTo>
        <relationshipName>Project_Members</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_IPS_Provisioning_Date__c</fullName>
        <label>Provisioning Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_IPS_isFuture_onInsert__c</fullName>
        <defaultValue>false</defaultValue>
        <label>isFutureonInsert</label>
        <trackHistory>false</trackHistory>
