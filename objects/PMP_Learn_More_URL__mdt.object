<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>To save learn more url for different categories</description>
    <fields>
        <fullName>PMP_Learn_More_Chinese_Url__c</fullName>
        <description>Chinese page url</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Learn More URL (Chinese)</label>
        <required>false</required>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>PMP_Learn_More_English_Url__c</fullName>
        <description>English page url</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Learn More URL (English)</label>
        <required>false</required>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>PMP_Learn_More_Japanese_Url__c</fullName>
        <description>Japanese page url</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Learn More URL (Japanese)</label>
        <required>false</required>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>PMP_PIM_Category_Id__c</fullName>
        <description>PIM id of category</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>PIM Category Id</label>
        <length>30</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>isSpecialty__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>isSpecialty</label>
        <type>Checkbox</type>
    </fields>
    <label>PMP Learn More URL Mapping</label>
    <pluralLabel>PMP Learn More URL&apos;s Mappings</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
