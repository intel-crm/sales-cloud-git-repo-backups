    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Used as a junction object to connect Partnership score and score object records based on Program, Account and Quarter.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Active_Ind__c</fullName>
        <description>Used in Reports to filter out the Inacive Recovery Dashboard records</description>
        <formula>IF( OR(AND((ISPICKVAL( Core_MDF_Scorecard_Id__r.Core_MDF_Case_Id__r.Core_MDF_Status__c, &apos;Review Completed&apos;))
, (Core_MDF_Scorecard_Id__r.Core_MDF_Quarter__c  =  TEXT(Core_MDF_Partnership_Score_Id__r.Core_MDF_Quarter_Year_Nm__c)), 
(&quot;Q&quot; + TEXT(CEILING( MONTH(TODAY())/3 )) + &quot; &quot; + TEXT(YEAR(TODAY())) != Core_MDF_Scorecard_Id__r.Core_MDF_Quarter__c)),AND(Core_MDF_Scorecard_Id__c = null, (&quot;Q&quot; + TEXT(CEILING( MONTH(TODAY())/3 )) + &quot; &quot; + TEXT(YEAR(TODAY())) != TEXT(Core_MDF_Partnership_Score_Id__r.Core_MDF_Quarter_Year_Nm__c))))
, true, false)</formula>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_Amt__c</fullName>
        <description>Used to store the Claim amount from the mapped Scorecard record during Case closure</description>
        <label>Claim Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Is_Active_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>True - when the Case is Closed
False - when the case is reopened</description>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Manual_Recovery_Amount_USD_Amt__c</fullName>
        <description>Used to store the Manual Recovery amount from the mapped Scorecard record during Case closure</description>
        <label>Manual Recovery Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Max_Possible_Amt__c</fullName>
        <description>Used to calculate Max Possible Amount for Partial scores.</description>
        <label>Max Possible Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Partnership_Score_Detail_Id__c</fullName>
        <description>Used to rollup the details from Recovery Dashboard to Partnership Score Details record</description>
        <label>Partnership Score Detail</label>
        <referenceTo>Core_MDF_Partnership_Score_Detail__c</referenceTo>
        <relationshipLabel>Recovery Dashboard</relationshipLabel>
        <relationshipName>Recovery_Dashboard</relationshipName>
        <relationshipOrder>1</relationshipOrder>
        <reparentableMasterDetail>true</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Partnership_Score_Id__c</fullName>
        <description>Used to map with Partership score record</description>
        <label>Partnership Score</label>
        <referenceTo>Core_MDF_Partnership_Score__c</referenceTo>
        <relationshipLabel>Recovery Dashboard</relationshipLabel>
        <relationshipName>Recovery_Summary</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>true</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Score_Nbr__c</fullName>
        <description>Used to store the Score from the mapped Scorecard record during Case closure</description>
        <externalId>false</externalId>
        <label>Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Scorecard_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Used to map with the scorecard record</description>
        <label>Scorecard</label>
        <referenceTo>Core_MDF_Scorecard__c</referenceTo>
        <relationshipName>Recovery_Summary</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Weighted_PV_Amt__c</fullName>
        <description>Used to calculate weighted PV amount for Partial score of Attribution, POP, engagement</description>
        <label>Weighted PV Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <label>Recovery Dashboard</label>
    <nameField>
        <displayFormat>RD-{000000}</displayFormat>
        <label>Recovery Summary</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Recovery Dashboard</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
