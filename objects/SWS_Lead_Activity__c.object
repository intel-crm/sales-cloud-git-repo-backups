    <fields>
        <fullName>SWS_Demo_conducted_or_not__c</fullName>
        <externalId>false</externalId>
        <formula>IF( AND(ISPICKVAL( SWS_Status__c , &quot;Completed&quot;), SWS_Lead__r.IsConverted), &quot;Demo Conducted&quot;, &quot;Demo not conducted&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Demo conducted or not(NOT USED)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
