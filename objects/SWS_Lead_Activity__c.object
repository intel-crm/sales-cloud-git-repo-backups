    <fields>
        <fullName>SWS_Lead_product_Interest_fm__c</fullName>
        <externalId>false</externalId>
        <formula>IF ( INCLUDES ( SWS_Lead__r.Core_Product_Interest__c , &quot;Intel® Max Series GPU&quot; ), &quot;Intel® Max Series GPU; &quot;,null ) &amp;
IF ( INCLUDES ( SWS_Lead__r.Core_Product_Interest__c , &quot;4th Generation Intel® Xeon® Scalable processors&quot; ), &quot;4th Generation Intel® Xeon® Scalable processors; &quot;,null ) &amp;
IF ( INCLUDES ( SWS_Lead__r.Core_Product_Interest__c , &quot;Intel® Xeon® CPU Max Series processor with high bandwidth memory (HBM)&quot; ), &quot;Intel® Xeon® CPU Max Series processor with high bandwidth memory (HBM); &quot;,null ) &amp;
IF ( INCLUDES ( SWS_Lead__r.Core_Product_Interest__c , &quot;Intel® Data Center GPU Flex Series on latest Intel® Xeon® processors&quot; ), &quot;Intel® Data Center GPU Flex Series on latest Intel® Xeon® processors; &quot;,null ) &amp;
IF ( INCLUDES ( SWS_Lead__r.Core_Product_Interest__c , &quot;Intel® Gaudi2 Deep Learning Server featuring eight Gaudi2 HL-225H mezzanine cards (SMC)&quot; ), &quot;	Intel® Gaudi2 Deep Learning Server featuring eight Gaudi2 HL-225H mezzanine cards (SMC); &quot;,null ) &amp;
IF ( INCLUDES ( SWS_Lead__r.Core_Product_Interest__c , &quot;Multiple platforms&quot; ), &quot;Multiple platforms; &quot;,null )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Lead product Interest fm(NOT USED)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
