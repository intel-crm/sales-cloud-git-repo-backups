    <validationRules>
        <fullName>Disable_Points</fullName>
        <active>false</active>
        <errorConditionFormula>AND(PRM_Account_Id__r.Core_Account_ID__c!=null,
PRM_Question_Display_Text__c==&apos;Branded Point earning excluded&apos;,(PRIORVALUE(PRM_Response_Txt__c)=&apos;True&apos;),
ISCHANGED(PRM_Response_Txt__c))</errorConditionFormula>
        <errorMessage>You can not edit this flag</errorMessage>
    </validationRules>
