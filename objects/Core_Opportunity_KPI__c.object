    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores the details of the Opportunity KPIs which are sent from IAH through Mulesoft</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_IAH_KPI_Record_ID__c</fullName>
        <description>Stores the IAH Record ID for the KPI. The formatting is such that the initial 2 numbers suggest the year of the KPI.</description>
        <externalId>true</externalId>
        <label>IAH KPI Record ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Achieved__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>Checked if Opportunity Stage = Design Win OR Opportunity Products corresponding to the KPI are WIN APPROVED.  If not checked, confirm at least 24 hours have passed since approval, and if so, log an AAQ.</inlineHelpText>
        <label>KPI Achieved?</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Add_Date__c</fullName>
        <inlineHelpText>Date the KPI was first populated on the opportunity</inlineHelpText>
        <label>KPI Added Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_BU_Owner__c</fullName>
        <description>BU Owner name in text copied form KPI Criteria</description>
        <externalId>false</externalId>
        <inlineHelpText>SMG BU employee managing the KPI</inlineHelpText>
        <label>KPI BU Owner</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_BatchTime__c</fullName>
        <label>KPI Batch Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Description__c</fullName>
        <inlineHelpText>Detailed description of the KPI and KPI criteria</inlineHelpText>
        <label>KPI Description</label>
        <length>131072</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_IntRecord_Id__c</fullName>
        <externalId>false</externalId>
        <label>KPI Integration Record Id</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Last_Update_Date__c</fullName>
        <inlineHelpText>Date the KPI was last updated</inlineHelpText>
        <label>KPI Last Updated Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Opportunity__c</fullName>
        <label>Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Opportunity KPIs</relationshipLabel>
        <relationshipName>Opportunity_KPIs</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>true</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Quantity__c</fullName>
        <externalId>false</externalId>
        <label>KPI Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Threshold_Met__c</fullName>
        <inlineHelpText>This checkbox field indicates if the Opportunity meets the pre-defined minimum to achieve the KPI; checked indicates the threshold is met, unchecked indicates it does not.  If no KPI threshold applies, ‘N/A’ will be displayed</inlineHelpText>
        <label>Threshold Met?</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>N/A</fullName>
                    <default>false</default>
                    <label>N/A</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>Yes*</fullName>
                    <default>false</default>
                    <label>Yes*</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Threshold_Req__c</fullName>
        <externalId>false</externalId>
        <label>Threshold Requirement</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Total_Price__c</fullName>
        <label>KPI Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Type__c</fullName>
        <inlineHelpText>Defines if the KPI tracks revenue ($) or count (#)</inlineHelpText>
        <label>KPI Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Salesforce Pipeline $</fullName>
                    <default>false</default>
                    <label>Salesforce Pipeline $</label>
                </value>
                <value>
                    <fullName>Salesforce Pipeline Opp Count</fullName>
                    <default>false</default>
                    <label>Salesforce Pipeline Opp Count</label>
                </value>
                <value>
                    <fullName>Salesforce Pipeline Units</fullName>
                    <default>false</default>
                    <label>Salesforce Pipeline Units</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Opp_KPI_Volume__c</fullName>
        <externalId>false</externalId>
        <label>Opportunity Volume</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_Threshold_Met__c</fullName>
        <label>Threshold Met?</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>N/A</fullName>
                    <default>false</default>
                    <label>N/A</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Opportunity KPI</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <label>KPI Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Opportunity KPIs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <startsWith>Vowel</startsWith>
    <visibility>Public</visibility>
</CustomObject>
