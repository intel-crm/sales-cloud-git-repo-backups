    <fields>
        <fullName>Core_MDF_App_Document_Types_nm__c</fullName>
        <description>Holds the Applicable Document Types</description>
        <label>App Document Types</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Proof of Branding</fullName>
                    <default>false</default>
                    <label>Proof of Branding</label>
                </value>
                <value>
                    <fullName>Proof of Cost</fullName>
                    <default>false</default>
                    <label>Proof of Cost</label>
                </value>
                <value>
                    <fullName>Proof of Execution</fullName>
                    <default>false</default>
                    <label>Proof of Execution</label>
                </value>
                <value>
                    <fullName>Proof of Attribution</fullName>
                    <default>false</default>
                    <label>Proof of Attribution</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Applicable_Document_Types_txt__c</fullName>
        <description>Displays Applicable Document Types in separate rows</description>
        <externalId>false</externalId>
        <formula>IF(INCLUDES( Core_MDF_App_Document_Types_nm__c, &quot;Proof of Cost&quot;), $Label.Core_MDF_Proof_of_Cost + BR() , NULL) +
IF(INCLUDES( Core_MDF_App_Document_Types_nm__c, &quot;Proof of Branding&quot;), $Label.Core_MDF_Proof_of_Branding + BR() , NULL) +
IF(INCLUDES( Core_MDF_App_Document_Types_nm__c, &quot;Proof of Attribution&quot;), $Label.Core_MDF_Proof_of_Attribution + BR() , NULL) +
IF(INCLUDES( Core_MDF_App_Document_Types_nm__c, &quot;Proof of Execution&quot;), $Label.Core_MDF_Proof_of_Execution , NULL)</formula>
        <label>Applicable Document Types</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
