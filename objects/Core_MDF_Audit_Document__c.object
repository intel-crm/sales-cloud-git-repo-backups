        <defaultValue>false</defaultValue>
        <label>Proof of Execution</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Case Review Document</label>
    <nameField>
        <displayFormat>DOC-{0000}</displayFormat>
        <label>Audit Document Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Case Review Documents</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <validationRules>
        <fullName>Core_MDF_File_Select_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF(ISNEW() , false,  AND(NOT(Core_MDF_Proof_of_Branding__c), NOT(Core_MDF_Proof_of_Cost__c),NOT(Core_MDF_Proof_of_Execution__c)))</errorConditionFormula>
        <errorMessage>At least one file type should must be selected for each file.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
