    <fields>
        <fullName>Core_MDF_Audit__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Audit</label>
        <referenceTo>Case</referenceTo>
        <relationshipName>Core_MDF_Audit</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Claim</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>Claim Review Documents</relationshipLabel>
        <relationshipName>Case_Review_Documents</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Document_Id__c</fullName>
        <externalId>false</externalId>
        <label>Document Id</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Document_Title__c</fullName>
        <externalId>false</externalId>
        <label>Document Title</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Document_Types__c</fullName>
        <label>Document Types</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Proof of Branding</fullName>
                    <default>false</default>
                    <label>Proof of Branding</label>
                </value>
                <value>
                    <fullName>Proof of Execution</fullName>
                    <default>false</default>
                    <label>Proof of Execution</label>
                </value>
                <value>
                    <fullName>Proof of Cost</fullName>
                    <default>false</default>
                    <label>Proof of Cost</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Ext_Document_Name__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK($Label.Core_MDF_PFRCommunityLink+&apos;sfc/servlet.shepherd/document/download/&apos;+ Core_MDF_Document_Id__c +&apos;?operationContext=S1&apos;, Core_MDF_Document_Title__c ,&apos;blank&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Document Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Int_Document_Name__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&apos;/sfc/servlet.shepherd/document/download/&apos;+ Core_MDF_Document_Id__c +&apos;?operationContext=S1&apos;, Core_MDF_Document_Title__c ,&apos;blank&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Document Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Proof_of_Branding__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Proof of Branding</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Proof_of_Cost__c</fullName>
        <defaultValue>false</defaultValue>
