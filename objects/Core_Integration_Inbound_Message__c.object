    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores inbound messages from iPaaS, similar to the Integration Outbound Message object. For example, responses back from AGS or ERPM. Trigger on create will process the message and change the status when done. Messages will stay in the object for a period of time (e.g. 90 days), for troubleshooting issues, and then be cleaned out by a scheduled batch job.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ReadWrite</externalSharingModel>
    <fields>
        <fullName>Core_Created_Date_Time__c</fullName>
        <description>Returns the system field CreatedDate. Shows the full date+time instead of just the date, in list views and reports, unlike the standard system field.</description>
        <formula>CreatedDate</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created Date/Time</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Error_Code__c</fullName>
        <externalId>false</externalId>
        <label>Error Code</label>
        <length>55</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Error_Description__c</fullName>
        <label>Error Description</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_Exception_Message__c</fullName>
        <description>Exception parsing inbound message</description>
        <label>Exception Message</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Hourly__c</fullName>
        <externalId>false</externalId>
        <formula>IF(VALUE(MID(TEXT(CreatedDate),12,2))+7&lt;15,VALUE(MID(TEXT(CreatedDate),12,2))-7+24,VALUE(MID(TEXT(CreatedDate),12,2))-7)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core_Hourly</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Log_Entry__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Log Entry</label>
        <referenceTo>Core_Log_Entry__c</referenceTo>
        <relationshipLabel>Integration Inbound Messages</relationshipLabel>
        <relationshipName>Integration_Inbound_Messages</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Message_Type__c</fullName>
        <label>Message Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Account</fullName>
                    <default>false</default>
                    <label>Account</label>
                </value>
                <value>
                    <fullName>Blackbox</fullName>
                    <default>false</default>
                    <label>Blackbox</label>
                </value>
                <value>
                    <fullName>Contact</fullName>
                    <default>false</default>
                    <label>Contact</label>
                </value>
                <value>
                    <fullName>Quote</fullName>
                    <default>false</default>
                    <label>Quote</label>
                </value>
                <value>
                    <fullName>Role</fullName>
                    <default>false</default>
                    <label>Role</label>
                </value>
                <value>
                    <fullName>SSG Support Request</fullName>
                    <default>false</default>
                    <label>SSG Support Request</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
