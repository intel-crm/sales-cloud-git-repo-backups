        <fullName>Core_Payload__c</fullName>
        <description>Payload of the inbound message, typically JSON</description>
        <label>Payload</label>
        <length>131072</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Processing_Status__c</fullName>
        <description>Status of the message as it is processed by the trigger code</description>
        <label>Processing Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Successful</fullName>
                    <default>false</default>
                    <label>Successful</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Publish_Timestamp__c</fullName>
        <label>Publish Timestamp</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Source_System_Response_Time__c</fullName>
        <externalId>false</externalId>
        <formula>((CreatedDate - Core_Outbound_Message__r.CreatedDate)*24)*60</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Source System Response Time(In Minutes)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Source_System__c</fullName>
        <description>System that sent the message, e.g. &quot;ERPM&quot;, &quot;AGS&quot;.</description>
        <label>Source System</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>AGS</fullName>
                    <default>false</default>
                    <label>AGS</label>
                </value>
                <value>
                    <fullName>CIM</fullName>
                    <default>false</default>
                    <label>CIM</label>
                </value>
                <value>
                    <fullName>DRD</fullName>
                    <default>false</default>
                    <label>DRD</label>
                </value>
                <value>
                    <fullName>ERPM</fullName>
                    <default>false</default>
                    <label>ERPM</label>
                </value>
                <value>
                    <fullName>SIEBEL</fullName>
                    <default>false</default>
                    <label>SIEBEL</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Tags__c</fullName>
        <externalId>false</externalId>
        <label>Tags</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
