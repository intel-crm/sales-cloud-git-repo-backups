    <fields>
        <fullName>Core_Invoice_Quarter_Text__c</fullName>
        <externalId>false</externalId>
        <formula>LEFT( text(Core_Invoice_Quarter__c) , 4) &amp; &apos; &apos; &amp;
(CASE(
RIGHT(text(Core_Invoice_Quarter__c), 2) , 
&quot;01&quot;, &quot;Q1&quot;,
&quot;02&quot;, &quot;Q2&quot;,
&quot;03&quot;, &quot;Q3&quot;, 
&quot;04&quot;, &quot;Q4&quot;, null
))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Invoice Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
