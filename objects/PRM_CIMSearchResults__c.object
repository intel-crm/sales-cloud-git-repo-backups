    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>PRM_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>It stores the Sales Cloud Account Id returned from CIM system</description>
        <label>SLSCLD Record</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>CIM Search Results</relationshipLabel>
        <relationshipName>SLSCLD_Record</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PRM_Account_Nm__c</fullName>
        <description>It stores Account Name returned from CIM system</description>
        <externalId>false</externalId>
        <label>Account Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_AddressLine1_Txt__c</fullName>
        <description>It stores the Address Line returned from CIM system</description>
        <externalId>false</externalId>
        <label>Address Line 1</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_AddressLoc_Nm__c</fullName>
        <description>It stores the Address Location for the returned account from the CIM system</description>
        <label>Address Location</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>BUS</fullName>
                    <default>false</default>
                    <label>BUS</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PRM_AddressType_Nm__c</fullName>
        <description>It stores the Address Type of returned account from CIM system</description>
        <label>Address Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>PHYSICAL</fullName>
                    <default>false</default>
                    <label>PHYSICAL</label>
                </value>
                <value>
                    <fullName>MAIL</fullName>
                    <default>false</default>
                    <label>MAIL</label>
                </value>
                <value>
                    <fullName>ELEC</fullName>
                    <default>false</default>
                    <label>ELEC</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
