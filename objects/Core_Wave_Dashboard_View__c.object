    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Each row represents one &quot;view&quot; of a Wave dashboard, to track user adoption</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>false</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>false</enableSharing>
    <enableStreamingApi>false</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_Dashboard_Page__c</fullName>
        <description>Dashboard Visualforce page that the user viewed</description>
        <externalId>false</externalId>
        <label>Dashboard Page</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>User who viewed the dashboard</description>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Wave_Dashboard_Views</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_View_Date_Time__c</fullName>
        <defaultValue>now()</defaultValue>
        <description>Date/time the dashboard was viewed</description>
        <label>View Date/Time</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <label>Wave Dashboard View</label>
    <nameField>
        <displayFormat>WAVE-{00000000}</displayFormat>
        <label>Wave Dashboard View Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Wave Dashboard Views</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
