    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object holds the comments from the Admin, offering Editor during the Survey life cycle</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ReadWrite</externalSharingModel>
    <fields>
        <fullName>PSS_Internal_Message_Txt__c</fullName>
        <description>This stores the internal conversation between Admin and FAE</description>
        <label>Internal Message</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PSS_Message_By_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Look up user id who posted the Survey message</description>
        <inlineHelpText>User</inlineHelpText>
        <label>Message By User Id</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Survey_Messages</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PSS_Message_By_User_Nm__c</fullName>
        <externalId>false</externalId>
        <formula>PSS_Message_By_Id__r.FirstName + &quot; &quot; + PSS_Message_By_Id__r.LastName</formula>
        <label>Message By User Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PSS_Message_Txt__c</fullName>
        <description>This field will store the survey related Messages</description>
        <inlineHelpText>survey message</inlineHelpText>
        <label>Message</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PSS_Message_Type_Nm__c</fullName>
        <description>This holds the type of the message, either it can be message or status</description>
        <inlineHelpText>Message Type</inlineHelpText>
        <label>Message Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Message</fullName>
                    <default>false</default>
                    <label>Message</label>
                </value>
                <value>
                    <fullName>Status</fullName>
                    <default>false</default>
                    <label>Status</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PSS_Message_dt__c</fullName>
        <description>This holds the date and time the offering message got posted</description>
        <inlineHelpText>Survey Message Date</inlineHelpText>
        <label>Message Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PSS_Survey_Result_Status_Txt__c</fullName>
        <description>This holds the Survey life cycle status against which comments are stored</description>
        <externalId>false</externalId>
        <inlineHelpText>Survey result status</inlineHelpText>
        <label>Survey Result Status</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Solution Message</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>Message-{0000}</displayFormat>
        <label>Survery Message Id</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Solution Messages</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
