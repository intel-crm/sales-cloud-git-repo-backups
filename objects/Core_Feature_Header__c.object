    <fields>
        <fullName>Core_Check_Duplicate__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>This is a Unique field used to store the concatenation of Header Name &amp; Header Type field. This will NOT allow duplicate combination values of   Header Name &amp; Header Type for this object</description>
        <externalId>false</externalId>
        <label>Check Duplicate</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_Header_Name__c</fullName>
        <description>This field is used to capture the Name of feature Header. EX:- Bay Trail</description>
        <externalId>false</externalId>
        <label>Header Name</label>
        <length>200</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Header_Type__c</fullName>
        <description>This field is used to capture the Type of feature Header. EX:- Intel Platform</description>
        <externalId>false</externalId>
        <label>Header Type</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Feature Header</label>
