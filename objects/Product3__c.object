    <fields>
        <fullName>Core_IPS_Visible_Flag_External__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Set by Integration/iPaas. 
Each row must have either Yes or No defined.
Set to True by default for VPH L2 &amp; L3 and VPLCH L2 and L4.</description>
        <label>IPS Visible Flag - External</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Visible_Flag_Internal__c</fullName>
        <description>Set within SFDC by a local IT/Sys Admin, Data Ops/Steward or KTBR. At the time of initial data setup, this is set to BLANK or NULL. If set manually, the value of this field overrides the visibility setting obtained from integration/externally.</description>
        <inlineHelpText>Set within SFDC by a local IT/Sys Admin, Data Ops/Steward or KTBR. At the time of initial data setup, this is set to BLANK or NULL. If set manually, the value of this field overrides the visibility setting obtained from integration/externally.</inlineHelpText>
        <label>IPS Visible Flag - Internal</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_IPS_Visible_Flag__c</fullName>
        <description>Formula evaluates value in IPS Visible Internal flag. If value is Blank, take the value of External flag. Else take the value of the Internal flag.</description>
        <formula>IF (ISBLANK( TEXT( Core_IPS_Visible_Flag_Internal__c )),  Core_IPS_Visible_Flag_External__c, IF( TEXT( Core_IPS_Visible_Flag_Internal__c ) = &quot;YES&quot;, True, False)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IPS Visible Flag</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
