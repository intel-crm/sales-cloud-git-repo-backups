    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Core_IPS_Cannot_Revert_IPS_Visible</fullName>
        <active>true</active>
        <description>Once the IPS Internal Visible flag is set to True, it cannot be set to False.
This is needed to ensure there is no cascading impact to Assets, MAP, PAR and Case that uses a particular Product ID.</description>
        <errorConditionFormula>AND
(
OR 
(
TEXT( Core_IPS_Visible_Flag_Internal__c ) = &quot;NO&quot;, 
TEXT( Core_IPS_Visible_Flag_Internal__c ) = &quot;&quot;
),
TEXT (PRIORVALUE ( Core_IPS_Visible_Flag_Internal__c )) = &quot;YES&quot;
)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Visible_Flag_Internal__c</errorDisplayField>
        <errorMessage>Once set to Yes, IPS Visible Flag (Internal) cannot be reverted. Press Cancel to Exit.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_No_Sales_Product_for_IPS</fullName>
        <active>true</active>
        <description>The Product_Org must be IPS, for the IPS Visible Internal flag to be set to True.</description>
        <errorConditionFormula>IF (
NOT (ISPICKVAL(Core_Product_Org__c, &apos;IPS&apos;)),
IF ( Core_IPS_Visible_Flag__c, TRUE, FALSE), FALSE
)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Visible_Flag_Internal__c</errorDisplayField>
        <errorMessage>Not an IPS product. Cannot be made IPS Visible. Click Cancel to exit.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_IPS_OrgAdm_Name_Edit</fullName>
        <active>true</active>
        <description>Prevent the editing of the Name field for IPS Prod Support Org users</description>
        <errorConditionFormula>$Profile.Name =&apos;IPS Support Org Admin&apos; &amp;&amp; 
(ISCHANGED( Name))</errorConditionFormula>
        <errorMessage>Cannot Edit Name field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Non_PSG_Usr_Product_Fields</fullName>
        <active>false</active>
        <description>Prevent Non PSG users from modifying PSG data</description>
        <errorConditionFormula>IF(($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE || $Profile.Name ==&apos;System Administrator&apos; || $Profile.Name ==&apos;IT Admin&apos;)
,FALSE,
(
NOT(($Permission.PSG_Master_Data_Read_Access || $Permission.PSG_Master_Data_Read_Write_Access ||
$Permission.PSG_Account_Contact_Read_Write_Access || $Permission.PSG_Account_Contact_Super_Admin || $Permission.PSG_Product_Super_Admin || $Permission.PSG_Product_Read_Write_Access)) &amp;&amp;
(   
	ischanged(Core_Item_Price_Authorization_Ind__c) || 
	ischanged(Core_Item_Quotable_Ind__c) || 
	ischanged(Core_Item_Orderable_Ind__c) || 
	ischanged(Core_Item_Shippable_Ind__c) || 
	ischanged(Core_Item_Standard_Cost_Amt__c) || 
	ischanged(Core_Item_Class_Nm__c) || 
	ischanged(Core_Item_Sub_Component_Category_Nm__c) || 
	ischanged(Core_Item_Signal_Cd__c) || 
	ischanged(Core_Item_Id__c) || 
	ischanged(Core_Item_Package_Txt__c) || 
	ischanged(Core_Product_Ext_Attribute_Id__c) || 
	ischanged(Core_Product_Type_Nm__c) || 
	ischanged(Core_SW_Prod_Avail_To_TL_ORD_ENBLMT_Ind__c) || 
	ischanged(Core_Prod_Tool_Type_Nm__c) || 
	ischanged(Core_Class_and_Component_Sub_Category_Nm__c)
)
)
)</errorConditionFormula>
        <errorMessage>You cannot edit PSG data</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_PSGU_Non_PSG_Product_Fields</fullName>
        <active>true</active>
        <description>Prevent PSG Users from editing Non-PSG data</description>
        <errorConditionFormula>IF(($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE || $Profile.Name ==&apos;System Administrator&apos; || $Profile.Name ==&apos;IT Admin&apos;)
,FALSE,
(
($Permission.PSG_Master_Data_Read_Access || $Permission.PSG_Master_Data_Read_Write_Access ||
$Permission.PSG_Account_Contact_Read_Write_Access || $Permission.PSG_Account_Contact_Super_Admin ||
$Permission.PSG_Product_Super_Admin || $Permission.PSG_Product_Read_Write_Access )
&amp;&amp; NOT(CONTAINS($Label.Core_ByPass_ValidationOnProduct,$User.Id)) &amp;&amp;
( Core_Product_Type_Nm__c!=&apos;Tool&apos; &amp;&amp; Core_Product_Type_Nm__c!=&apos;Component&apos;)
)
)</errorConditionFormula>
        <errorMessage>You cannot edit non-PSG records, Please contact the support team for any access related help</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Restrict_edit_on_Product_Active_Name</fullName>
        <active>true</active>
        <description>As PSG Product Marketing User, Active flag and Product Name should not be edittable</description>
        <errorConditionFormula>AND($Permission.PSG_Restrict_edit_on_Active_Product_Name_for_Product_RW,OR(ISCHANGED(IsActive__c), ISCHANGED(Name)))</errorConditionFormula>
        <errorMessage>As Product Marketing User, You do not have sufficient Privileges to edit this field.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
