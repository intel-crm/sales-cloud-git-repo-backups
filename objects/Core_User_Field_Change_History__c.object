    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This Object is used for capturing the field label changes made on User.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_Current_Value__c</fullName>
        <description>This field is to capture the current field value</description>
        <label>Current Value</label>
        <length>1500</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>20</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Impacted_User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field will hold the impacted user detail.</description>
        <label>Impacted User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Core_User_Field_Change_Histories</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Modified_User_Field__c</fullName>
        <description>This field will capture the modified user field</description>
        <externalId>false</externalId>
        <label>Modified User Field</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Previous_Value__c</fullName>
        <description>This field will hold the previous field value i.e. before making the change to the field</description>
        <label>Previous Value</label>
        <length>1500</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>20</visibleLines>
    </fields>
    <label>Core User Field Change History</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>CREATED_DATE</columns>
        <columns>UPDATEDBY_USER</columns>
        <columns>Core_Impacted_User__c</columns>
        <columns>Core_Modified_User_Field__c</columns>
        <columns>Core_Previous_Value__c</columns>
        <columns>Core_Current_Value__c</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <nameField>
        <label>Core_User_Field_Change_History_Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Core User Field Change Histories</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_Restrict_User_To_Edit_Record</fullName>
        <active>true</active>
        <description>Restrict User to edit user field change history record after once a record is created</description>
        <errorConditionFormula>AND(
	NOT(ISNEW()),
	$Profile.Name &lt;&gt; &quot;&quot;
)</errorConditionFormula>
        <errorMessage>System will not allow to modify log details, please contact Security Team for further assistance</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
