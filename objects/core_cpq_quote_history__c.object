    <fields>
        <fullName>core_cpq_approval__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Approval</label>
        <referenceTo>sbaa__Approval__c</referenceTo>
        <relationshipName>PSG_Fields_Histories</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>core_cpq_approval_chain__c</fullName>
        <externalId>false</externalId>
        <label>Approval Chain</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_bm_level__c</fullName>
        <externalId>false</externalId>
        <label>Approval Level</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_check_dpa_aln__c</fullName>
        <formula>IF(ISBLANK(core_cpq_quote__c), true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is DPA/ALN?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>core_cpq_dpa_aln__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>DPA &amp; ALN</label>
        <referenceTo>core_cpq_dpa_aln__c</referenceTo>
        <relationshipName>Quote_Status_History</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>core_cpq_duration_days__c</fullName>
        <externalId>false</externalId>
        <formula>FLOOR( core_cpq_end_date__c -  core_cpq_start_date__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Duration  (Days)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_duration_hours__c</fullName>
        <externalId>false</externalId>
        <formula>core_cpq_duration_minutes__c / 60</formula>
        <label>Duration (Hours)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_duration_minutes__c</fullName>
        <externalId>false</externalId>
        <formula>(ROUND((core_cpq_end_date__c - core_cpq_start_date__c)* 24 * 60 + IF(SECOND(TIMEVALUE(core_cpq_end_date__c)) - SECOND(TIMEVALUE(core_cpq_start_date__c)) &gt; 30 &amp;&amp; SECOND(TIMEVALUE(core_cpq_end_date__c)) - SECOND(TIMEVALUE(core_cpq_start_date__c)) &lt; 50 , 1, 0), 0))</formula>
        <label>Duration (Minutes)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
