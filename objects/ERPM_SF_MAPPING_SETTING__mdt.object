                    <default>false</default>
                    <label>Benefit</label>
                </value>
                <value>
                    <fullName>Address</fullName>
                    <default>false</default>
                    <label>Address</label>
                </value>
                <value>
                    <fullName>Biz Org Type</fullName>
                    <default>false</default>
                    <label>Biz Org Type</label>
                </value>
                <value>
                    <fullName>IPA Partner Specialty</fullName>
                    <default>false</default>
                    <label>IPA Partner Specialty</label>
                </value>
                <value>
                    <fullName>Relationship_Entitlement</fullName>
                    <default>false</default>
                    <label>Relationship_Entitlement</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>SF_KeyValue__c</fullName>
        <description>This is to define the SF key values</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>SF-KeyValue</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>eRPM_EngagementCodes__c</fullName>
        <description>This is define the list of erpm engagements</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>eRPM-EngagementCodes</label>
