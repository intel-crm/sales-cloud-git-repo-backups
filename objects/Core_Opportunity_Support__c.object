    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_OppSupReqRestrict_RecordType_Change</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(ISNEW()),
ISCHANGED(RecordTypeId),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorMessage>Opportunity Support Request Record Type cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opportunity_Region_check</fullName>
        <active>true</active>
        <description>check region of the Opportunity</description>
        <errorConditionFormula>($RecordType.Name &lt;&gt; &apos;Marketing Support&apos;) &amp;&amp; (ISNULL(Core_Region__c) ||  ISBLANK(Core_Region__c))</errorConditionFormula>
        <errorMessage>Opportunity Region cannot be blank</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opportunity_Support_Team_Check</fullName>
        <active>true</active>
        <description>Check if the Opportunity has a Support Team assigned before approval.</description>
        <errorConditionFormula>RecordType.Name &lt;&gt; &apos;Marketing Support&apos; &amp;&amp; ISCHANGED(Core_Status__c) &amp;&amp;  ISPICKVAL(Core_Status__c, &apos;Approved&apos;) &amp;&amp;  Core_Opportunity_Support_Team_Count__c == 0</errorConditionFormula>
        <errorMessage>There should be at least 1 CSA Member assigned to the Opportunity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opportunity_Support_statues_check</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
AND( ISCHANGED( Core_Status__c ),  ISPICKVAL(PRIORVALUE(Core_Status__c), &apos;Approved&apos;),
OR( ISPICKVAL(Core_Status__c, &apos;Pending&apos;) , ISPICKVAL(Core_Status__c, &apos;Submitted&apos;))
  ,RecordType.Name = &apos;Marketing Support&apos; ),
AND(ISCHANGED( Core_Status__c ), ISPICKVAL(PRIORVALUE(Core_Status__c), &apos;Pending&apos;),
 ISPICKVAL(Core_Status__c, &apos;Submitted&apos;),RecordType.Name = &apos;Marketing Support&apos; 
  ) 
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>This Customer Win Nomination is already Approved. Cannot change it back to Pending.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Edit_on_ApprovedOpptSupp</fullName>
        <active>false</active>
        <description>User should not Edit the Approver Opportunity Support Request</description>
        <errorConditionFormula>AND($Profile.Name &lt;&gt; &apos;System Administrator&apos;,
NOT(ISNEW()),
NOT(ISCHANGED(Core_Opportunity_Support_Team_Count__c)), 
ISPICKVAL( Core_Status__c,&quot;Approved&quot;)
)</errorConditionFormula>
        <errorMessage>Cannot Edit the CSA Support Request once approved</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_marketing_support_Status_change</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
RecordType.Name = &apos;Marketing Support&apos; ,
ISCHANGED(Core_Status__c),  
NOT(CONTAINS($User.Email,$Label.Opty_Support_Status_Update )
 )  
)</errorConditionFormula>
        <errorMessage>You are not allowed to change Status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>only_1_team_member_allowed</fullName>
        <active>false</active>
        <errorConditionFormula>Core_Opportunity_Support_Team_Count__c&gt;1</errorConditionFormula>
