    <label>Opportunity Support</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Core_Denied_Opportunity_Support</fullName>
        <columns>NAME</columns>
        <columns>RECORDTYPE</columns>
        <columns>Core_Approval_Comments__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_Status__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </filters>
        <label>Rejected Opportunity Support</label>
    </listViews>
    <listViews>
        <fullName>Pending_for_Approval</fullName>
        <columns>NAME</columns>
        <columns>Core_Account_Name__c</columns>
        <columns>Core_Age__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_Login_User_Id__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operation>equals</operation>
            <value>Submitted</value>
        </filters>
        <label>Pending for Approval</label>
    </listViews>
