    <fields>
        <fullName>Core_Login_User_Id__c</fullName>
        <formula>Core_Approver_1__c = $User.Id ||  Core_Approver_2__c = $User.Id ||  Core_Approver_3__c = $User.Id ||  Core_Approver_4__c = $User.Id ||  Core_Approver_5__c = $User.Id</formula>
