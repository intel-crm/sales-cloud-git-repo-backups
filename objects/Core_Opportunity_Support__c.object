    <fields>
        <fullName>Core_Account_Name__c</fullName>
        <description>Name of the Opportunity Account</description>
        <externalId>false</externalId>
        <formula>HYPERLINK( &apos;/&apos;+Opportunity__r.Account.Id , Opportunity__r.Account.Name ,&quot;_self&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Additional_Support_Needed__c</fullName>
        <description>Please describe the need for  additional support  and how it will enhance the opportunity</description>
        <inlineHelpText>Please describe the need for  additional support  and how it will enhance the opportunity</inlineHelpText>
        <label>Additional Support Needed</label>
        <length>2500</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Age__c</fullName>
        <externalId>false</externalId>
        <formula>IF( RecordType.DeveloperName = &apos;Core_Center_of_Excellence_Request&apos;, IF(ISNULL(Core_End_Date__c) || ISBLANK(Core_End_Date__c),ROUND((DATETIMEVALUE(TODAY()) - DATETIMEVALUE(Core_Start_Date__c)),1), ROUND(( DATETIMEVALUE(Core_End_Date__c) - DATETIMEVALUE(Core_Start_Date__c)),1) ),IF ((ISNULL( Core_Approved_Date__c ) || ISBLANK( Core_Approved_Date__c )),ROUND((TODAY() - DATEVALUE(Core_Submitted_Date__c)),1), ROUND( (DATEVALUE(Core_Approved_Date__c) - DATEVALUE(Core_Submitted_Date__c)),1) ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Age</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Amount__c</fullName>
        <description>Opportunity Amount</description>
        <externalId>false</externalId>
        <formula>Opportunity__r.Amount</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
