    <description>Represents &quot;recommendations&quot; for a specific Account. Initially designed for the SMART Analytics integration, containing &quot;product recommendations&quot; and sales out data.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>true</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
