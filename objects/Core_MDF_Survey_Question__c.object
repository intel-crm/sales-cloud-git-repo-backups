                    <default>false</default>
                    <label>External</label>
                </value>
                <value>
                    <fullName>Both</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Both</label>
                </value>
            </valueSetDefinition>
        </valueSet>
