        <fullName>PRM_Sales_Opportunity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Sales Opportunity</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Please select Intel-Led opportunity</errorMessage>
            <filterItems>
                <field>Opportunity.Core_Opportunity_Coverage_Nm__c</field>
                <operation>equals</operation>
                <value>Intel-Led Opportunity</value>
            </filterItems>
            <infoMessage>Please search for Intel-Led Opportunity</infoMessage>
            <isOptional>false</isOptional>
        </lookupFilter>
