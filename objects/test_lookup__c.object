    <fields>
        <fullName>Balance_Amount__c</fullName>
        <formula>Carry_Over_Amount__c * 1</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Balance Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Carry_Over_Amount__c</fullName>
        <label>Carry Over Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Carry_over_from_Prev_Qtr__c</fullName>
        <formula>test_lookup__r.Balance_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Carry over from Prev Qtr</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>test_lookup__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>test lookup</label>
        <referenceTo>test_lookup__c</referenceTo>
        <relationshipLabel>test lookup</relationshipLabel>
        <relationshipName>test_lookup</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>test lookup</label>
    <listViews>
        <fullName>Dummy_queue_test_lookup</fullName>
        <filterScope>Queue</filterScope>
        <label>Dummy_queue</label>
        <queue>Dummy_queue</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <nameField>
        <displayFormat>TL-{00000}</displayFormat>
        <label>test lookup Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>test lookup</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Dummy_rule_by_DK</fullName>
        <active>true</active>
        <description>Dummy_rule_by_DK</description>
        <errorConditionFormula>Balance_Amount__c  -  Balance_Amount__c +  Balance_Amount__c -  Balance_Amount__c   = 0</errorConditionFormula>
        <errorMessage>Dummy Replaced value This MSG is replaced from Github var</errorMessage>
    </validationRules>
