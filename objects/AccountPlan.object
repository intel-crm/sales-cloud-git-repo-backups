    <fields>
        <fullName>Core_Account_Plan_Score__c</fullName>
        <description>Calculate the score based on the number of fields filled/Total number of fields</description>
        <externalId>false</externalId>
        <formula>( 
  IF(NOT(ISBLANK(Core_Account_Revenue__c)), 1, 0) +
  IF(NOT(ISBLANK(Core_Potential_Revenue_next_5_years__c)), 1, 0) +
  IF(NOT(ISBLANK(Core_Market_Cap__c)), 1, 0) +
  IF(NOT(ISBLANK(Core_Revenue_Customer_Overview__c)), 1, 0) +
  IF(NOT(ISBLANK(Core_Net_Income__c)), 1, 0) +
  IF(NOT(ISBLANK(Core_Cash_Investments__c)), 1, 0) +
  IF(NOT(ISBLANK(Core_Debt_long_term__c)), 1, 0) +
  IF(NOT(ISBLANK(Core_Price_Earnings__c)), 1, 0) +
  IF(NOT(ISBLANK(Core_Gross_Margin__c)), 1, 0) +
  IF(NOT(ISBLANK(Core_Employees__c)), 1, 0) 
) / 10 * 100</formula>
        <label>Account Plan Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
