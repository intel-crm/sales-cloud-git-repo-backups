    <recordTypes>
        <fullName>Sales_NewHost</fullName>
        <active>true</active>
        <label>New Host</label>
        <picklistValues>
            <picklist>Sales_Computer_Type__c</picklist>
            <values>
                <fullName>Disk ID</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>GUARD ID</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>HOST ID</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>NIC ID</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Sales_License_Type__c</picklist>
            <values>
                <fullName>FIXED</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>FLOAT</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts>
        <searchResultsAdditionalFields>Sales_Computer_Name_Txt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Sales_isActiveHost__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Sales_Contact__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Sales_EnterComputerNameOnHostCreation</fullName>
        <active>true</active>
        <description>SSLC Enhancement</description>
        <errorConditionFormula>OR(ISBLANK( Sales_Computer_Name_Txt__c ),ISNULL(Sales_Computer_Name_Txt__c))</errorConditionFormula>
        <errorDisplayField>Sales_Computer_Name_Txt__c</errorDisplayField>
        <errorMessage>Please enter the Computer Name</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Fixed_GUARD_NIC_Allowed</fullName>
        <active>true</active>
        <description>Computer Type can only be Guard Id or NIC ID for Fixed license type computer</description>
        <errorConditionFormula>AND(
NOT($Setup.PRM_Execution_Controls__c.BypassValidationInTransferAdmin__c),
ISPICKVAL( Sales_License_Type__c , &apos;FIXED&apos;) ,
ISPICKVAL( Sales_Computer_Type__c , &quot;HOST ID&quot;)
,NOT(ISCHANGED( Sales_Primary_Admin_Email__c )),
NOT(ISCHANGED( Sales_Primary_Admin_Name__c ))
)</errorConditionFormula>
        <errorDisplayField>Sales_Computer_Type__c</errorDisplayField>
        <errorMessage>Computer Type can either be a Guard Id or a NIC ID for Fixed license type computer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Fixed_Lic_Red_Server_NotAllowed</fullName>
        <active>true</active>
        <description>For FIXED License Type, User Can add either 0, 1 or both companion servers only.</description>
        <errorConditionFormula>AND(
ISPICKVAL( Sales_License_Type__c , &apos;FIXED&apos;) ,
OR(
NOT(ISBLANK(Sales_Redundant_Server1_Txt__c)),
NOT(ISBLANK(Sales_Redundant_Server2_Txt__c))
),NOT(ISCHANGED( Sales_Primary_Admin_Email__c )),
NOT(ISCHANGED( Sales_Primary_Admin_Name__c ))
)</errorConditionFormula>
        <errorMessage>For FIXED License Type computers, you cannot add redundant servers. You can optionally add companion computers</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Float_HOST_NIC_Allowed</fullName>
        <active>true</active>
        <description>Computer Type can either be a NIC ID or a HOST ID for Float license type computer</description>
        <errorConditionFormula>AND(
NOT($Setup.PRM_Execution_Controls__c.BypassValidationInTransferAdmin__c),
ISPICKVAL( Sales_License_Type__c , &apos;FLOAT&apos;),
ISPICKVAL(  Sales_Computer_Type__c , &quot;GUARD ID&quot;)
,NOT(ISCHANGED( Sales_Primary_Admin_Email__c )),
NOT(ISCHANGED( Sales_Primary_Admin_Name__c ))
)</errorConditionFormula>
        <errorDisplayField>Sales_Computer_Type__c</errorDisplayField>
        <errorMessage>Computer Type can only be NIC ID or HOST ID for Float license type computer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Float_Lic_NoneorBoth_RedServer_Req</fullName>
        <active>true</active>
        <description>For FLOAT License Type, User Can add either 0 or both redundant servers only.</description>
        <errorConditionFormula>AND(
ISPICKVAL( Sales_License_Type__c , &apos;FLOAT&apos;),
OR(
 AND( ISBLANK(Sales_Redundant_Server1_Txt__c) , NOT(ISBLANK(Sales_Redundant_Server2_Txt__c)) ),
 AND( NOT(ISBLANK(Sales_Redundant_Server1_Txt__c)) , ISBLANK(Sales_Redundant_Server2_Txt__c) )

),NOT(ISCHANGED( Sales_Primary_Admin_Email__c )),
NOT(ISCHANGED( Sales_Primary_Admin_Name__c ))
)</errorConditionFormula>
        <errorMessage>You must specify both redundant server IDs.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_HostCreation_Validation</fullName>
        <active>true</active>
        <description>This validation rule is created to restrict User in creating Host record from New Button at Lookup field.</description>
        <errorConditionFormula>AND(ISNEW(),NOT(Sales_Host_Is_Created_From_Custom_Page__c),NOT(ISCLONE()))</errorConditionFormula>
        <errorDisplayField>Sales_Account__c</errorDisplayField>
        <errorMessage>You are not authorized to add a New Host from this screen.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Valid_Companion_Server_Id</fullName>
        <active>true</active>
        <description>Server Id should be same as computer type which is Guard Id (T or S followed by 9 digits) for Computer type selected as Guard Id , NIC Id (12 Hexadecimal Characters) for computer selected as NIC Id and 8 hexadecimal for Computer type selected as Host Id</description>
        <errorConditionFormula>AND(OR(

AND(
NOT(ISBLANK( Sales_Companion_Server1_Txt__c )),
OR(
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;NIC ID&apos;),
NOT((REGEX(Sales_Companion_Server1_Txt__c, &quot;[A-Fa-f0-9]{12}&quot;)))
),
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;HOST ID&apos;),
NOT((REGEX(Sales_Companion_Server1_Txt__c, &quot;[A-Fa-f0-9]{8}&quot;)))
),
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;GUARD ID&apos;),
NOT((REGEX(Sales_Companion_Server1_Txt__c, &quot;[T|S]{1}[0-9]{9}&quot;)))
)
)
),

AND(
NOT(ISBLANK( Sales_Companion_Server2_Txt__c )),
OR(
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;NIC ID&apos;),
NOT((REGEX(Sales_Companion_Server2_Txt__c, &quot;[A-Fa-f0-9]{12}&quot;)))
),
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;HOST ID&apos;),
NOT((REGEX(Sales_Companion_Server2_Txt__c, &quot;[A-Fa-f0-9]{8}&quot;)))
),
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;GUARD ID&apos;),
NOT((REGEX(Sales_Companion_Server2_Txt__c, &quot;[T|S]{1}[0-9]{9}&quot;)))
)
)
)

),NOT(ISCHANGED( Sales_Primary_Admin_Email__c )),
NOT(ISCHANGED( Sales_Primary_Admin_Name__c )))</errorConditionFormula>
        <errorMessage>Invalid computer type for companion computer IDs</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Valid_PrimaryComputerID</fullName>
        <active>true</active>
        <description>Primary Computer Id can be Host Id for Computer Type=&apos;Host ID&apos; OR NIC Id for Computer Type=&apos;NIC ID&apos; OR Guard Id for Computer Type=&apos;Guard ID&apos;. [Host Id (8 Hexadecimal) / NIC Id (12 Hexadecimal) / Guard Id (Dongle)(T or S followed by 9 digits) ]</description>
        <errorConditionFormula>AND(NOT($Setup.PRM_Execution_Controls__c.BypassValidationInTransferAdmin__c),OR(
AND( 
ISPICKVAL(  Sales_Computer_Type__c  , &apos;NIC ID&apos;),
NOT((REGEX(Name, &quot;[A-Fa-f0-9]{12}&quot;)))
),
AND( 
ISPICKVAL(  Sales_Computer_Type__c  , &apos;HOST ID&apos;),
NOT((REGEX(Name, &quot;[A-Fa-f0-9]{8}&quot;)))
),
AND( 
ISPICKVAL(  Sales_Computer_Type__c  , &apos;GUARD ID&apos;),
NOT((REGEX(Name, &quot;[T|S]{1}[0-9]{9}&quot;)))
)
),NOT(ISCHANGED( Sales_Primary_Admin_Email__c )),
NOT(ISCHANGED( Sales_Primary_Admin_Name__c )))</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Invalid primary computer ID. HOST ID : Eight digit hexadecimal digits--12345678 / NIC ID : 12 hexadecimal digits--123456789101 / GUARD ID (Dongle) : T or S prefix followed by nine digits --T000000001</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Valid_Redundant_Server_Id</fullName>
        <active>true</active>
        <description>Server Id should be same as computer type which is Guard Id (T or S followed by 9 digits) for Computer type selected as Guard Id , NIC Id (12 Hexadecimal Characters) for computer selected as NIC Id and 8 hexadecimal for Computer type selected as Host Id</description>
        <errorConditionFormula>AND(OR(

AND(
NOT(ISBLANK( Sales_Redundant_Server1_Txt__c )),
OR(
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;NIC ID&apos;),
NOT((REGEX(Sales_Redundant_Server1_Txt__c, &quot;[A-Fa-f0-9]{12}&quot;)))
),
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;HOST ID&apos;),
NOT((REGEX(Sales_Redundant_Server1_Txt__c, &quot;[A-Fa-f0-9]{8}&quot;)))
),
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;GUARD ID&apos;),
NOT((REGEX(Sales_Redundant_Server1_Txt__c, &quot;[T|S]{1}[0-9]{9}&quot;)))
)
)
),

AND(
NOT(ISBLANK( Sales_Redundant_Server2_Txt__c )),
OR(
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;NIC ID&apos;),
NOT((REGEX(Sales_Redundant_Server2_Txt__c, &quot;[A-Fa-f0-9]{12}&quot;)))
),
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;HOST ID&apos;),
NOT((REGEX(Sales_Redundant_Server2_Txt__c, &quot;[A-Fa-f0-9]{8}&quot;)))
),
AND(
ISPICKVAL( Sales_Computer_Type__c , &apos;GUARD ID&apos;),
NOT((REGEX(Sales_Redundant_Server2_Txt__c, &quot;[T|S]{1}[0-9]{9}&quot;)))
)
)
)

),NOT(ISCHANGED( Sales_Primary_Admin_Email__c )),
NOT(ISCHANGED( Sales_Primary_Admin_Name__c )))</errorConditionFormula>
        <errorDisplayField>Sales_Account__c</errorDisplayField>
        <errorMessage>Invalid computer type for redundant server IDs</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Temporary_NIC_ID_Validation_Fixed</fullName>
        <active>true</active>
        <description>Temporary NIC ID cannot be set for Fixed license type computers</description>
        <errorConditionFormula>IF(ISPICKVAL( Sales_License_Type__c , &apos;FIXED&apos;)&amp;&amp; (NOT(ISBLANK(Temporary_NIC_ID__c)) &amp;&amp; NOT(ISCHANGED( Sales_Primary_Admin_Email__c ))),true , false)</errorConditionFormula>
        <errorDisplayField>Temporary_NIC_ID__c</errorDisplayField>
        <errorMessage>Temporary NIC ID is only for Float license type Hosts, to generate temporary license.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Temporary_NIC_ID_Validation_Float</fullName>
        <active>true</active>
        <description>Temporary NIC ID should be of 12 hexadecimal characters</description>
        <errorConditionFormula>AND(
ISPICKVAL(  Sales_License_Type__c  , &apos;FLOAT&apos;),
NOT((REGEX( Temporary_NIC_ID__c , &quot;[A-Fa-f0-9]{12}&quot;))),
NOT(ISBLANK(Temporary_NIC_ID__c)),NOT(ISCHANGED( Sales_Primary_Admin_Email__c )),
NOT(ISCHANGED( Sales_Primary_Admin_Name__c ))
)</errorConditionFormula>
        <errorDisplayField>Temporary_NIC_ID__c</errorDisplayField>
        <errorMessage>Please enter temporary NIC ID (Temporary NIC ID should be of 12 hexadecimal characters).</errorMessage>
    </validationRules>
