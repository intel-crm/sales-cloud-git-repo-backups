    <fields>
        <fullName>Sales_Computer_Type__c</fullName>
        <label>Computer Type</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Sales_License_Type__c</controllingField>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>NIC ID</fullName>
                    <default>false</default>
                    <label>NIC ID</label>
                </value>
                <value>
                    <fullName>HOST ID</fullName>
                    <default>false</default>
                    <label>HOST ID</label>
                </value>
                <value>
                    <fullName>GUARD ID</fullName>
                    <default>false</default>
                    <label>GUARD ID</label>
                </value>
                <value>
                    <fullName>Disk ID</fullName>
                    <default>false</default>
                    <label>Disk ID</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>FIXED</controllingFieldValue>
                <controllingFieldValue>FLOAT</controllingFieldValue>
                <valueName>NIC ID</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>FIXED</controllingFieldValue>
                <valueName>GUARD ID</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>FLOAT</controllingFieldValue>
                <valueName>HOST ID</valueName>
            </valueSettings>
        </valueSet>
    </fields>
