        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>API Key</label>
        <length>35</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Async_Id__c</fullName>
        <description>AsynchronousRequestId to be used in CIM request</description>
