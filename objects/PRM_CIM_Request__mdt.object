<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>It contains static values for CIM input to be used</description>
    <fields>
        <fullName>API_Key__c</fullName>
        <description>API Key for the CIM callout</description>
