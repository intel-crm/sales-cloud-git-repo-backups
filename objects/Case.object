if(&apos;{!Case.Status}&apos; == &apos;Closed&apos; &amp;&amp; &apos;{!LEFT( Case.RecordTypeId , 15)}&apos; == &apos;{!JSENCODE($Label.Core_IPS_GEC_ReadOnly_RT_Id)}&apos;){
alert(&apos;{!JSENCODE($Label.Core_IPS_GEC_ClosedCase_AddComment_Err_Msg)}&apos;);
}
else{
