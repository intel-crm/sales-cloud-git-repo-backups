        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Hot_Issues_qts_2__c</fullName>
        <description>Customer Disposition (CD), Debug Progress (DP), and Intel Disposition (ID)</description>
        <inlineHelpText>Use the drop-down menus to set these stoplight (red/yellow/green) values.</inlineHelpText>
        <label>Customer/Intel Disposition&amp;Debug Progres</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Core_Hot_Issue__c</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Red</fullName>
                    <default>false</default>
                    <label>Red</label>
                </value>
                <value>
                    <fullName>Yellow</fullName>
                    <default>false</default>
                    <label>Yellow</label>
                </value>
                <value>
                    <fullName>Green</fullName>
                    <default>false</default>
                    <label>Green</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>checked</controllingFieldValue>
                <valueName>Red</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>checked</controllingFieldValue>
                <valueName>Yellow</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>checked</controllingFieldValue>
                <valueName>Green</valueName>
            </valueSettings>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_IPSPortal_Check__c</fullName>
        <formula>IF(AND(
NOT(ISBLANK($User.ContactId)),
$User.ContactId = ContactId), TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core_IPSPortal_Check</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Account_Sub_Geo__c</fullName>
        <externalId>false</externalId>
        <formula>IF(RecordType.Name = &apos;Audit&apos;||RecordType.Name = &apos;Audit Closed&apos;, RIGHT(Core_MDF_Region_SubRegion_txt__c ,LEN(Core_MDF_Region_SubRegion_txt__c) -Find(&quot;-&quot;,Core_MDF_Region_SubRegion_txt__c)-1), IF( Core_IPS_Project_Case__c!=null &amp;&amp; TEXT(Core_IPS_Project_Case__r.Sub_Region__c )!=null,TEXT(Core_IPS_Project_Case__r.Sub_Region__c) ,
IF (Core_Partner_Supported_Account__c !=null , TEXT(Core_Partner_Supported_Account__r.Core_Sub_Geo__c ), 
 IF(RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id, CreatedBy.Core_User_Sub_Geo__c, TEXT( Core_IPS_Supported_Contact__r.Account.Core_Sub_Geo__c)))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sub Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Age__c</fullName>
        <description>To Calculate the age of a case created.</description>
        <externalId>false</externalId>
        <formula>IF((ISPICKVAL(Status, &quot;New&quot;) || ( ISPICKVAL(Status, &quot;Open&quot;) &amp;&amp; NOT(ISPICKVAL(Core_Sub_Status__c, &quot;Close-Pending&quot;))) || ( ISPICKVAL(Status, &quot;On Hold&quot;) &amp;&amp; (ISPICKVAL( Core_Sub_Status__c , &quot;GEC Hold&quot;)) &amp;&amp; NOT(ISPICKVAL(Core_Sub_Status__c, &quot;Close-Pending&quot;))) ) , 
   (NOW()-CreatedDate),

    IF( (( (ISPICKVAL(Status, &quot;Open&quot;)) &amp;&amp; (ISPICKVAL(Core_Sub_Status__c, &quot;Close-Pending&quot;))) ||
        ( (ISPICKVAL(Status, &quot;Closed&quot;))  &amp;&amp; (NOT(ISBLANK(Core_IPS_Date_Time_Close_Pending__c))) ) ) , 
        (Core_IPS_Date_Time_Close_Pending__c - CreatedDate),

	IF( ((ISPICKVAL(Status, &quot;Closed&quot;)) &amp;&amp; (ISBLANK(Core_IPS_Date_Time_Close_Pending__c)) ), 
        (ClosedDate - CreatedDate), (ClosedDate - CreatedDate))            
		
	)  
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Age in days</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
