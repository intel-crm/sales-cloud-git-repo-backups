    <fields>
        <fullName>Core_Account_Geo__c</fullName>
        <externalId>false</externalId>
        <formula>IF(RecordType.Name = &apos;Audit&apos;||RecordType.Name = &apos;Audit Closed&apos;, LEFT(Core_MDF_Region_SubRegion_txt__c,Find(&quot;-&quot;,Core_MDF_Region_SubRegion_txt__c)-1), 
IF (Core_IPS_Project_Case__c!=null &amp;&amp; TEXT(Core_IPS_Project_Case__r.Region__c)!=null,TEXT(Core_IPS_Project_Case__r.Region__c), 
	IF (Core_Partner_Supported_Account__c !=null , TEXT(Core_Partner_Supported_Account__r.Core_Geo__c ), 
		IF(RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id, CreatedBy.Core_User_Geo__c, TEXT(Core_IPS_Supported_Contact__r.Account.Core_Geo__c)))))</formula>
        <label>Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
