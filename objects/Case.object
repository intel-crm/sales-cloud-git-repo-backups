        <fullName>Core_IPS_SalesRep_Close_Case_LEX</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>page</linkType>
        <masterLabel>Close Case Test</masterLabel>
        <openType>replace</openType>
        <page>Core_IPS_CloseCase</page>
        <protected>false</protected>
    </webLinks>
    <webLinks>
        <fullName>Core_IPS_Sales_Rep_Close_Case</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Close Case</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/41.0/connection.js&quot;)} 
{!REQUIRESCRIPT(&quot;/soap/ajax/41.0/apex.js&quot;)}
{!REQUIRESCRIPT(&apos;/resource/Core_IPS_Jquery11&apos;)}
{!REQUIRESCRIPT(&apos;/resource/Core_IPS_JqueryUI_10/ui/minified/jquery-ui.min.js&apos;)}
	
try{
	
	
	jQuery(function() {
	
		/*Append the jQuery CSS CDN Link to the Head tag.*/
		jQuery(&apos;head&apos;).append(&apos;&lt;link rel=&quot;stylesheet&quot; href=&quot;//ajax.googleapis.com/ajax/libs/jqueryui/1.10.3/themes/start/jquery-ui.css&quot; type=&quot;text/css&quot; /&gt;&apos;);
		/*Create the HTML(DIV Tag) for the Dialog.*/
		var html = 
		&apos;&lt;div id=&quot;dialog&quot; title=&quot;Close Case&quot;&gt;&lt;p&gt;You have selected to close this case. &lt;br/&gt; Are you sure you want to close the case?&lt;/p&gt;&lt;/div&gt;&apos;;
		
		
		/*Check if the Dialog(DIV Tag) already exists if not then Append the same to the Body tag.*/
		if(!jQuery(&apos;[id=dialog]&apos;).size()){
			jQuery(&apos;body&apos;).append(html);
		} 
		/*Open the jQuery Dialog.*/ 
		jQuery( &quot;#dialog&quot; ).dialog({
			autoOpen: true,
			modal: true,			
			buttons: {
				&quot;Confirm Close Case&quot;: function() {					
					console.log(&apos;----Inside confirm close case part---&apos;);
					var result = updateCase();	
					//console.log(&apos;--result:&apos;+result);
					//console.log(&apos;--result:&apos;+result[0].success);
					if(result[0].success==&apos;true&apos;){ 
                                             location.reload(true);
						//Redirect to survey page 
						window.location=&quot;{!$Label.Core_IPS_Case_Survey_Page_URL}&quot;+&apos;{!Case.Id}&apos;;
                                         jQuery( this ).dialog( &quot;close&quot; );
					}else{
						
						jQuery( this ).dialog( &quot;close&quot; );
						console.log(result[0].errors);
						var exceptionMsg = result[0].errors.message;
						if(exceptionMsg==null || exceptionMsg==&apos;&apos;)
							exceptionMsg = &apos;Something went wrong&apos;;
						var htmlErrMsg = &apos;&lt;div id=&quot;dialogErrMsg&quot; title=&quot;Error Occured&quot;&gt;&lt;p&gt;&apos;+exceptionMsg+&apos;&lt;br/&gt;Please Contact Intel Admin Team.&lt;/p&gt;&lt;/div&gt;&apos;;
		
						/*Check if the Dialog(DIV Tag) already exists if not then Append the same to the Body tag.*/
						if(!jQuery(&apos;[id=dialogErrMsg]&apos;).size()){
							jQuery(&apos;body&apos;).append(htmlErrMsg);
						}	
						jQuery( &quot;#dialogErrMsg&quot; ).dialog({
							autoOpen: true,
							modal: true,
							buttons: {				
								&apos;Ok&apos;: function() {
									jQuery( this ).dialog( &quot;close&quot; );
								}
							}
						});
					}
				},
				Cancel: function() {
					jQuery( this ).dialog( &quot;close&quot; );
				}
			}
		});
	}); 
}

catch(e){
	console.log(&apos;An Error has Occured. Error: &apos; + e);	
	//alertMsg();        
    //Alternate Soln
	console.log(&apos;Alternate soln&apos;);
    closeCase();
}

function updateCase(){	
	var caseUpdate= new sforce.SObject(&quot;case&quot;); 
	caseUpdate.Id=&apos;{!Case.Id}&apos;; 
	caseUpdate.Status = &apos;{!$Label.Core_IPS_Case_Status_Closed}&apos;; 
	caseUpdate.Core_Sub_Status__c = &apos;{!$Label.Core_IPS_Case_Status_Closed}&apos;; 
	return result = sforce.connection.update([caseUpdate]); 
}

function closeCase(){	
	if(confirm(&quot;You have selected to close this case.  Are you sure you want to close the case?&quot;)){	
		var result = updateCase();

                 				
		if(result[0].success==&apos;true&apos;){ 
			//Redirect to survey page 
			window.location=&quot;{!$Label.Core_IPS_Case_Survey_Page_URL}&quot;+&apos;{!Case.Id}&apos;;
                         jQuery( this ).dialog( &quot;close&quot; );
                         
		}else{			
			alertMsg();
		}
	}
}


function alertMsg(){	
	alert(&apos;Something went wrong ,Please Contact Intel Admin Team.&apos;);
}</url>
    </webLinks>
