                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_IPS_Clone__c</fullName>
        <externalId>false</externalId>
        <formula>IF(RecordType.Name = &apos;IPS GEC ReadOnly&apos;,HYPERLINK(&quot;javascript:alert(&apos;You cannot copy this case as it is placed On Hold by Intel. You may submit a new case or contact your Intel Support Owner.&apos;)&quot;,IMAGE(&quot;servlet/servlet.FileDownload?file=015o0000001vY9h&quot;,&quot;Clone&quot;,15,15),&quot;_self&quot;),HYPERLINK(&quot;apex/Core_IPS_CaseClone?id=&quot;&amp;Id,IF(ISPICKVAL($User.UserType,&quot;PowerCustomerSuccess&quot; ),IMAGE(&quot;/IPS/servlet/servlet.FileDownload?file=015o0000001vY9h&quot;,&quot;Clone&quot;,15,15),IMAGE(&quot;servlet/servlet.FileDownload?file=015o0000001vY9h&quot;,&quot;Clone&quot;,15,15))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Copy</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
