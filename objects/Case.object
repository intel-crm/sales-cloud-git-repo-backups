    <fields>
        <fullName>Core_MDF_Excess_Requested_Amt__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Holds the requested claim amount exceeding the activity spending limit</description>
        <inlineHelpText>The amount deducted from the Requested Amount if it exceeds the Activity Spending Limit. This affects the Reimbursement Amount (USD).</inlineHelpText>
        <label>Excess Requested Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
