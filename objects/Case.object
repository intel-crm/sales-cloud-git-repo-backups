        <fullName>Core_IPS_Last_Update__c</fullName>
        <description>To Calculate the number of days when the last update on the record was made.</description>
        <externalId>false</externalId>
        <formula>IF( IsClosed , Null,  NOW()- (LastModifiedDate) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Last Update</label>
