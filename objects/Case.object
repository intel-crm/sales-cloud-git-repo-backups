    <webLinks>
        <fullName>Core_IPS_Accept_Case</fullName>
        <availability>online</availability>
        <description>Accept Case ownership within case</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Accept Case</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT($Site.Prefix+&quot;/soap/ajax/35.0/connection.js&quot;)} 
{!REQUIRESCRIPT($Site.Prefix+&quot;/support/console/35.0/integration.js&quot;)} 

var caseObj = new sforce.SObject(&quot;Case&quot;); 
caseObj.Id = &apos;{!Case.Id}&apos;; 
caseObj.OwnerId = &apos;{!$User.Id}&apos;; 
var result = sforce.connection.update([caseObj]); 

if (result[0].success == &apos;false&apos;) { 
alert(result[0].errors.message); 
} else { 

if ((&quot;{!$Profile.Name}&quot; == &quot;{!$Label.Core_IPS_Partner_AE_ProfileName}&quot;)) { 
location.reload(true); 

} else { 
if (sforce.console.isInConsole()) { 
location.reload(true);
//srcUp(location.reload()); 
} else { 
window.parent.location.href = &quot;/{!Case.Id}&quot;; 
} 
} 
}</url>
    </webLinks>
