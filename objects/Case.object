        <fullName>Core_IPS_External_Close_Case</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Close Case</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/26.0/connection.js&quot;)} 
{!REQUIRESCRIPT(&quot;/soap/ajax/25.0/apex.js&quot;)}
/*{!REQUIRESCRIPT(&apos;//code.jquery.com/jquery-1.12.4.js&apos;)}  
{!REQUIRESCRIPT(&apos;//code.jquery.com/ui/1.12.1/jquery-ui.min.js&apos;)} */
{!REQUIRESCRIPT($Site.Prefix+&quot;/resource/Core_IPS_Jquery11&quot;)} 
{!REQUIRESCRIPT($Site.Prefix+&quot;/resource/Core_IPS_JqueryUI_10/ui/jquery-ui.js&quot;)} 
jQuery(function() {     
    /*Create the HTML(DIV Tag) for the Dialog.*/ 
    var html = &apos;&lt;div id=&quot;dialog&quot; title=&quot;Close Case&quot;&gt;&lt;p&gt;{!$Label.Core_IPS_closeCase_confirm_Message} &lt;/p&gt;&lt;/div&gt;&apos;; 
jQuery(&apos;head&apos;).append(&apos;&lt;link rel=&quot;stylesheet&quot; href=&quot;//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css&quot;&gt;&apos;); 

jQuery(&apos;head&apos;).append(&apos;&lt;style&gt;.ui-widget-overlay {  z-index: 1 !important; } .ui-dialog .ui-dialog-content { min-height: 49px !important;} &lt;/style&gt;&apos;);
    /*Check if the Dialog(DIV Tag) already exists if not then Append the same to the Body tag.*/ 
    if(!jQuery(&apos;[id=dialog]&apos;).size()){ 
        jQuery(&apos;body&apos;).append(html); 
    } 

    /*Open the jQuery Dialog.*/ 
    jQuery( &quot;#dialog&quot; ).dialog({ 
        autoOpen: true, 
        modal: true, 
        buttons: { 
            &quot;Confirm Close Case&quot;: function() { 
                var statusUpdate= new sforce.SObject(&quot;case&quot;); 
                statusUpdate.Id=&apos;{!Case.Id}&apos;; 
                statusUpdate.Status = &apos;{!$Label.Core_IPS_Case_Status_Closed}&apos;; 
                statusUpdate.Core_Sub_Status__c = &apos;{!$Label.Core_IPS_Case_Status_Closed}&apos;; 
statusUpdate.Core_IPS_Partner_status_ReadOnly__c =true;
                var result = sforce.connection.update([statusUpdate]); 
                console.log(&apos;----result :::&apos;+result); 
                console.log(&apos;----result :::&apos;+result[0].success); 
                if(result[0].success==&apos;true&apos;){
                   var statusReadOnly= new sforce.SObject(&quot;case&quot;); 
                statusReadOnly.Id=&apos;{!Case.Id}&apos;; 
                statusReadOnly.Core_IPS_Partner_status_ReadOnly__c =false;
                sforce.connection.update([statusReadOnly]);
                //Redirect to survey page 

if(&apos;{!$Profile.Name}&apos; ==&apos;IPS External Customer&apos; || &apos;{!$Profile.Name}&apos; ==&apos;Partner&apos;){
    window.location=&quot;{!$Label.Core_IPS_Case_Survey_External_Page_URL}&quot;+&apos;{!Case.Id}&apos;;
}

               $( this ).dialog( &quot;close&quot; );
               }
            }, 
            &quot;Cancel&quot;: function() { 
                $( this ).dialog( &quot;close&quot; ); 
            } 
        } 
    }); 
});</url>
    </webLinks>
