        <url>{!REQUIRESCRIPT($Site.Prefix+&quot;/soap/ajax/35.0/connection.js&quot;)} 
{!REQUIRESCRIPT($Site.Prefix+&quot;/support/console/35.0/integration.js&quot;)} 


var querystatus = sforce.connection.query(&quot;SELECT id,Core_IPS_Project__r.Core_Status__c from Asset where id=&apos;{!Asset.Id}&apos;&quot;); 

var records = querystatus.getArray(&quot;records&quot;); 

if(&quot;{!Asset.Status}&quot;==&quot;Inactive&quot; ||((records[0].Core_IPS_Project__r != null) &amp;&amp; (records[0].Core_IPS_Project__r.Core_Status__c == &quot;Inactive&quot;))){ 
alert(&apos;{!$Label.Core_IPS_Inactive_Intel_Product_Message}&apos;); 
}else if((&quot;{!ISPICKVAL($User.UserType,&apos;PowerCustomerSuccess&apos;)}&quot;==&quot;true&quot;) || (&quot;{!ISPICKVAL($User.UserType,&apos;PowerPartner&apos;)}&quot;==&quot;true&quot; ) ){ 
	if((&apos;{!$Label.Core_IPS_MAG_Support_Org}&apos;)==(&quot;{!Asset.Core_Product_OrganizationId__c}&quot;)){
	
window.location = &quot;/IPS/apex/Core_IPS_Customer_Case_Creation?productId={!Asset.Id}&amp;projectId={!Asset.Core_IPS_ProjectId__c}&amp;mode=asset&amp;sbs=scs&amp;retURL=%2F{!Asset.Id}&quot;; 
}else{

window.location = &quot;/IPS/apex/Core_IPS_Customer_Case_Creation?productId={!Asset.Id}&amp;projectId={!Asset.Core_IPS_ProjectId__c}&amp;mode=asset&amp;sbs=ccs&amp;retURL=%2F{!Asset.Id}&quot;; 
}
}else{ 
if (sforce.console.isInConsole()) { 
srcSelf(&apos;/apex/Core_IPS_Internal_Case_Creation?productId={!Asset.Id}&amp;projectId={!Asset.Core_IPS_ProjectId__c}&amp;mode=asset&amp;retURL=%2F{!Asset.Id}&amp;isdtp=vw&apos;); 
} else { 
window.location = &quot;/apex/Core_IPS_Internal_Case_Creation?productId={!Asset.Id}&amp;projectId={!Asset.Core_IPS_ProjectId__c}&amp;mode=asset&amp;retURL=%2F{!Asset.Id}&quot;; 
} 
}</url>
