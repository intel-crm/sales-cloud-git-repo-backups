        <deleteConstraint>SetNull</deleteConstraint>
        <label>Backend System</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Core_IPS_Backend_System2__c.Core_IPS_Backend_System_URL__c</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <filterItems>
                <field>Core_IPS_Backend_System2__c.Core_IPS_Backend_System_URL__c</field>
                <operation>startsWith</operation>
                <value>https</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
