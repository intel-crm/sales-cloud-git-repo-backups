    <webLinks>
        <fullName>Core_IPS_Invalid</fullName>
        <availability>online</availability>
        <description>This is use for Close a Case under a Status.Sub Status value of Closed.Invalid.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Invalid</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT($Site.Prefix+&quot;/soap/ajax/41.0/connection.js&quot;)} 
{!REQUIRESCRIPT($Site.Prefix+&quot;/soap/ajax/41.0/apex.js&quot;)} 
{!REQUIRESCRIPT($Site.Prefix+&apos;/resource/Core_IPS_Jquery11&apos;)} 
{!REQUIRESCRIPT($Site.Prefix+&apos;/resource/Core_IPS_JqueryUI_10/ui/minified/jquery-ui.min.js&apos;)}
try {

    //Validating case status beforehand as per US105464
    var result = sforce.connection.query(&quot;SELECT Status from case where Id =&apos;{!Case.Id}&apos; limit 1&quot;);
    if (result.records.Status == &apos;Closed&apos;) {
        alert(&apos;You cannot update the status on a Closed case.&apos;);
    } else {

        jQuery(function() {
            /*Append the jQuery CSS CDN Link to the Head tag.*/
            jQuery(&apos;head&apos;).append(&apos;&lt;link rel=&quot;stylesheet&quot; href=&quot;//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css&quot;&gt;&apos;);

            /*Create the HTML(DIV Tag) for the Dialog.*/
            var html = &apos;&lt;div id=&quot;dialog&quot; title=&quot;Invalid Case ?&quot;&gt;&lt;p&gt;Are you sure you want to set the Case to Closed.Invalid ?&lt;/p&gt;&lt;/div&gt;&apos;;
            /*Check if the Dialog(DIV Tag) already exists if not then Append the same to the Body tag.*/
            if (!jQuery(&apos;[id=dialog]&apos;).size()) {
                jQuery(&apos;body&apos;).append(html);
            }

            /*Open the jQuery Dialog.*/
            jQuery(&quot;#dialog&quot;).dialog({
                autoOpen: true,
                modal: true,
                show: {
                    //effect: &quot;bounce&quot;, 
                    duration: 1000
                },
                hide: {
                    //effect: &quot;bounce&quot;, 
                    duration: 1000
                },
                buttons: {
                    &quot;Confirm Invalid Case&quot;: function() {
                        var result = updateCase();
                        console.log(&apos;-----------------&gt; 1&apos;);
                        console.log(JSON.stringify(result));
                        if (result[0].success == &apos;true&apos;) {
                            //Refresh page 
                            location.reload();
                        } else {
                            jQuery(this).dialog(&quot;close&quot;);
                            console.log(result[0].errors);
                            var exceptionMsg = result[0].errors.message;
                            if (exceptionMsg == null || exceptionMsg == &apos;&apos;)
                                exceptionMsg = &apos;Something went wrong&apos;;
                            var htmlErrMsg = &apos;&lt;div id=&quot;dialogErrMsg&quot; title=&quot;Error Occured&quot;&gt;&lt;p&gt;&apos; + exceptionMsg + &apos;&lt;br/&gt;Please Contact Intel Admin Team.&lt;/p&gt;&lt;/div&gt;&apos;;

                            /*Check if the Dialog(DIV Tag) already exists if not then Append the same to the Body tag.*/
                            if (!jQuery(&apos;[id=dialogErrMsg]&apos;).size()) {
                                jQuery(&apos;body&apos;).append(htmlErrMsg);
                            }
                            jQuery(&quot;#dialogErrMsg&quot;).dialog({
                                autoOpen: true,
                                modal: true,
                                buttons: {
                                    &apos;Ok&apos;: function() {
                                        jQuery(this).dialog(&quot;close&quot;);
                                    }
                                }
                            });
                        }
                    },
                    Cancel: function() {
                        jQuery(this).dialog(&quot;close&quot;);
                    }
                }
            });
        });


    } //Else close
} catch (e) {
    console.log(&apos;An Error has Occured. Error: &apos; + e);
    console.log(&apos;Alternate soln&apos;);
    alertMsg();
}

function updateCase() {
    var caseUpdate = new sforce.SObject(&quot;case&quot;);
    caseUpdate.Id = &apos;{!Case.Id}&apos;;
    caseUpdate.Status = &apos;Closed&apos;;
    caseUpdate.Core_Sub_Status__c = &apos;Invalid&apos;;
    return result = sforce.connection.update([caseUpdate]);
}

function alertMsg() {
    alert(&apos;Something went wrong ,Please Contact Intel Admin Team.&apos;);
}</url>
    </webLinks>
