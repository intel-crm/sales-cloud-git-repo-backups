        <fullName>Core_IPS_Closed_Case_Migration__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Closed Case Migration</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Comment__c</fullName>
        <label>Comment</label>
        <length>92768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>Core_IPS_Copy_Flag__c</fullName>
        <description>Using this flag to decide whether to copy a case or not.If the value is true Case can be copied or else error message is displayed.</description>
        <formula>IF(NOT(ISPICKVAL(Asset.Status,&apos;Inactive&apos;)) 
&amp;&amp;
((Core_IPS_Project_Case__r.Id!=null 
   &amp;&amp; ISPICKVAL(Core_IPS_Project_Case__r.Core_Status__c,&apos;Active&apos;)) || Core_IPS_Project_Case__r.Id==null) 
,false,true)</formula>
        <label>CopyFlag</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Copy__c</fullName>
        <description>This Field is used for Copying Case Info which is for replacing Core_IPS_Clone as part of Summ-17 JavaScript disablement</description>
        <externalId>false</externalId>
        <formula>IF(RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id , 

&quot;&quot;, 

IF(ISPICKVAL($User.UserType,&quot;PowerCustomerSuccess&quot;), 

HYPERLINK(&quot;/IPS/apex/Core_IPS_CaseClone?Id=&quot;&amp;Id, 
IMAGE(&quot;/IPS/servlet/servlet.FileDownload?file=015o0000001vY9h&quot;,&quot;Clone&quot;,15,15)), 


IF(ISPICKVAL($User.UserType,&quot;PowerPartner&quot;),
HYPERLINK(&quot;/IPS/apex/Core_IPS_CaseClone?Id=&quot;&amp;Id, 
IMAGE(&quot;/IPS/servlet/servlet.FileDownload?file=015o0000001vY9h&quot;,&quot;Clone&quot;,15,15)), 

HYPERLINK(&quot;/apex/Core_IPS_CaseClone?Id=&quot;&amp;Id, 
IMAGE(&quot;/servlet/servlet.FileDownload?file=015o0000001vY9h&quot;,&quot;Clone&quot;,15,15))
)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Copy</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Count_Int_Interested_Parties__c</fullName>
        <label>Count Internal Interested Parties</label>
        <summaryFilterItems>
            <field>Core_IPS_Case_Interested_Party__c.Type__c</field>
            <operation>equals</operation>
            <value>Internal</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Core_IPS_Case_Interested_Party__c.Active__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_IPS_Case_Interested_Party__c.Case__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
