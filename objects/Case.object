    <fields>
        <fullName>Core_Case_Co_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Communication Owner selection</description>
        <inlineHelpText>This is an optional field to be used by the Case Owning Agent/Admin on an as needed basis.</inlineHelpText>
        <label>Case Co-Owner</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>((1 OR 2 OR 3 OR 4 OR 6 OR 7) OR 5)</booleanFilter>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>IPS Agent</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>IPS Support Org Admin</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>Sales Rep-BB-Dual IPS</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>IPS Agent Enhanced</value>
            </filterItems>
            <filterItems>
                <field>$Profile.Name</field>
                <operation>equals</operation>
                <value>IPS Data Migration</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>IPS Agent-Partner</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>Sales Rep-BB</value>
            </filterItems>
            <infoMessage>Case Co-Owner for Case should be an IPS Agent, IPS Agent-Partner or Support Org Admin</infoMessage>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>Cases1</relationshipName>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Case_Issue_Category__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Internally used in Edit Case details VF Page logic</description>
        <label>Case Category ID</label>
        <referenceTo>Core_IPS_Product_Issue_Category__c</referenceTo>
        <relationshipLabel>Cases</relationshipLabel>
        <relationshipName>Cases</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Case_Issue_Sub_Category__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Case Sub Category ID</label>
        <referenceTo>Core_IPS_Product_Issue_Category__c</referenceTo>
        <relationshipLabel>Cases (Issue Sub Category)</relationshipLabel>
        <relationshipName>Cases1</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Case_Owner_CoOwner_is_Log_in_User__c</fullName>
        <description>Checks to see if the logged in user is the Case Owner or the Case Co-Owner.  This is used in custom case list views to show list of cases to DAE&apos;s if they are the owner or co-owner of a case</description>
        <formula>OR( OwnerId = $User.Id, Core_Case_Co_Owner__c = $User.Id)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Case Owner/Co-Owner is Logged in User</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Case_Resolution_Reason__c</fullName>
        <inlineHelpText>Case Closure Details is a Comment visible by anyone with access to the case internally (not visible to Customer) and will be entered during closure of a case</inlineHelpText>
        <label>Case Closure Details</label>
        <length>2000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
