    <fields>
        <fullName>Core_MDF_Claim_Case_Reviewer_Lookup__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Claim Case Reviewer</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR 2 OR 3</booleanFilter>
            <errorMessage>The selected user is not part of Claim Case Reviewer group.</errorMessage>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>CCP - Core Access</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>contains</operation>
                <value>Commissions Office Inquiries Admin,A&amp;E User,A&amp;E User Read Only,Account Brief Team,CIM Hub Admin,Finance Program Team,Global Export Compliance,IT @ Intel,Marketing Development Manager,Program Core Team,Sales Manager,Sales Ops,Sales Rep-BB</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>contains</operation>
                <value>Sales Rep-BB-Dual IPS,Sales Rep-CW,SMG/GMC Read Only,Reporting Admin,Comarketing Support L1</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>Core_MDF_Claim_Case_Reviewer_Lookup</relationshipName>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
