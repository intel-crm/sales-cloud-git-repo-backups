    <fields>
        <fullName>Core_Record_Type_Bucket__c</fullName>
        <description>Used for bucketing record types into IPS, CCP, Ask Commissions, etc. in reports</description>
        <externalId>false</externalId>
        <formula>IF(CONTAINS(RecordType.Name, &apos;IPS&apos;),
   &apos;IPS&apos;,
   IF(CONTAINS(RecordType.Name, &apos;Commissions&apos;),
      &apos;Ask Commissions&apos;,
      IF(CONTAINS(RecordType.Name, &apos;Audit&apos;),
         &apos;CCP&apos;,
         &apos;Other&apos;)
      )
   )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Record Type Bucket</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Report_User__c</fullName>
        <externalId>false</externalId>
        <formula>IF (OwnerId = $User.Id, 1,
IF (Core_Case_Co_Owner__c = $User.Id, 2,
IF (Core_Intel_Sup_Owner__c = $User.Id, 3,
IF ( CreatedById  = $User.Id, 4,
NULL))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Report User</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
