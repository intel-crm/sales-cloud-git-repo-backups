    <fields>
        <fullName>Core_Account_Geo__c</fullName>
        <externalId>false</externalId>
        <formula>IF (Core_IPS_Project_Case__c!=null &amp;&amp; TEXT(Core_IPS_Project_Case__r.Region__c)!=null &amp;&amp; TEXT(Core_IPS_Project_Case__r.Sub_Region__c)!=null,TEXT(Core_IPS_Project_Case__r.Region__c), 
	IF (Core_Partner_Supported_Account__c !=null &amp;&amp;  TEXT(Core_Partner_Supported_Account__r.Core_Geo__c ) != null &amp;&amp; TEXT(Core_Partner_Supported_Account__r.Core_Sub_Geo__c) != null, TEXT(Core_Partner_Supported_Account__r.Core_Geo__c ), 
		IF(RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id, CreatedBy.Core_User_Geo__c, TEXT(Core_IPS_Supported_Contact__r.Account.Core_Geo__c))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
