    <fields>
        <fullName>Core_IPS_Category_and_Subcategory__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    AND(
        NOT(ISBLANK(Core_External_Issue_Category__c)),
        ISBLANK(Core_External_Issue_Subcategory__c)
    ),
    Core_External_Issue_Category__c,
    IF(
        AND(
            NOT(ISBLANK(Core_External_Issue_Category__c)),
            NOT(ISBLANK(Core_External_Issue_Subcategory__c))
        ),
        Core_External_Issue_Category__c &amp; &apos;.&apos; &amp; Core_External_Issue_Subcategory__c,
        NULL
    )
)</formula>
        <label>Category and Subcategory</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
