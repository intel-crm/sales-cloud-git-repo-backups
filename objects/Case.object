    </fields>
    <fields>
        <fullName>Reason</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>Reason_for_not_providing_the_SST_Log__c</fullName>
        <label>Reason for not providing the SST Log</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Unable to collect Intel® SST log</fullName>
                    <default>false</default>
                    <label>Unable to collect Intel® SST log</label>
                </value>
                <value>
                    <fullName>Case Type is not “Debug Request&quot;</fullName>
                    <default>false</default>
                    <label>Case Type is not “Debug Request&quot;</label>
                </value>
                <value>
                    <fullName>Intel® SST file upload failure</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Intel® SST file upload failure</label>
                </value>
                <value>
                    <fullName>Intel® SST not supported on my platform</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Intel® SST not supported on my platform</label>
                </value>
                <value>
                    <fullName>System hangs while collecting the Intel® SST log</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>System hangs while collecting the Intel® SST log</label>
                </value>
                <value>
                    <fullName>Unable to boot to OS</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Unable to boot to OS</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
