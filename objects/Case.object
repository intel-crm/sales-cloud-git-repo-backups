	if(typeof(srcUp) == &apos;function&apos;){ //Checks that it is in console
	    srcSelf(&quot;/apex/Core_IPS_AddComment?isdtp=vw&amp;id={!Case.Id}&amp;retURL=%2F{!Case.Id}&quot;,&apos;_self&apos;);
