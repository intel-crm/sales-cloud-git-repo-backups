    <fields>
        <fullName>Core_MDF_Days_SLA_Remaining__c</fullName>
        <description>Calculates SLA for Auditor to close the Case based on Program and Budget (if applicable)</description>
        <externalId>false</externalId>
        <formula>if( TEXT(Core_MDF_Status__c) == &apos;Under Review&apos; &amp;&amp; NOT(ISPICKVAL(Core_MDF_Budget_Type_nm__c,&apos;RSA MD&apos;)),

IF( HOUR( TIMENOW() ) &gt;= 13 ,
(IF(ISBLANK(Core_MDF_SLA_Days_Nbr__c) || Core_MDF_SLA_Days_Nbr__c==0,22,Core_MDF_SLA_Days_Nbr__c) - (DATEVALUE(LEFT(TEXT(NOW()), 10))-DATEVALUE(LEFT(TEXT(Core_MDF_SLA_Start_Date__c), 10)))) ,
(IF(ISBLANK(Core_MDF_SLA_Days_Nbr__c) || Core_MDF_SLA_Days_Nbr__c==0,23,Core_MDF_SLA_Days_Nbr__c+1) - (DATEVALUE(LEFT(TEXT(NOW()), 10))-DATEVALUE(LEFT(TEXT(Core_MDF_SLA_Start_Date__c), 10)))) ) ,


0)</formula>
        <label>Days SLA Remaining</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
