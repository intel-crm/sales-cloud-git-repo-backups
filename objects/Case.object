    <fields>
        <fullName>Core_IPS_Notif_Case_Comment__c</fullName>
        <externalId>false</externalId>
        <formula>/*Output is a number to indicate which text or comment should be displayed in the email notification */
/*-----------------------*/
/*Restricted Secret: 1*/
/*No Comments Exist: 2*/
/*Show Public Comment: 3*/
/*Show Private Comment: 4*/
/*-----------------------*/

/*if RS*/
if(Core_IPS_Restricted_Secret_Content__c, 1,

      /*else if no comments*/
      if(AND(isblank(Core_Last_Private_Case_Comment_Timestamp__c),(isblank(Core_Last_Case_Comment_Timestamp__c))), 2,

         /*else if both comments exist then check for newest*/
         if(and(not(isblank(Core_Last_Private_Case_Comment_Timestamp__c)),not(isblank(Core_Last_Case_Comment_Timestamp__c))),

            /*check timestamps*/
            if(Core_Last_Case_Comment_Timestamp__c &lt; Core_Last_Private_Case_Comment_Timestamp__c, 4, 3),
         /*end if*/

   /*else if public comment only or private only*/
   if(not(isblank(Core_Last_Case_Comment_Timestamp__c)), 3, 4)
)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Notification Case Comment</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
