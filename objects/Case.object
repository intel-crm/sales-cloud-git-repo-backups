        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Final_Reimbursement_Amount_USD__c</fullName>
        <formula>Core_MDF_Requested_Amount_USD_Amt__c  -  Core_MDF_Excess_Requested_Amt__c  - Core_MDF_Adjustment_Amount_USD_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Requested Amount (USD) - Excess Requested Amount (USD) - Adjustment Amount (USD)</inlineHelpText>
        <label>Reimbursement Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Internal_Case_Closure_Notes__c</fullName>
        <label>Internal Case Closure Note</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
