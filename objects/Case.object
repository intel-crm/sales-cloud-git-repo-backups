    <fields>
        <fullName>Core_IPS_Case_Owner_Email__c</fullName>
        <description>It will stores Case Owner&apos;s Email</description>
        <externalId>false</externalId>
        <formula>IF( 
OR(RecordTypeId = $Label.Core_IPS_Case_Create_RecordType_Id,
RecordTypeId = $Label.Core_IPS_Closed_Case_RT_Id,
RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id,
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id),
IF(BEGINS(OwnerId, &quot;005&quot;), Owner:User.Email , 
IF(OR(AND(BEGINS(OwnerId, &quot;00G&quot;), 
Core_IPS_Backend_System__c!=Null , 
Core_IPS_Backend_ID__c !=Null , 
Core_IPS_Backend_ID__c != &quot;0&quot; , 
Core_IPS_Backend_ID__c != &quot;-1&quot;), AND(BEGINS(OwnerId, &quot;00G&quot;), 
Core_IPS_New_Backend_System__c!=Null , 
Core_IPS_BackendID__c !=Null , 
Core_IPS_BackendID__c != &quot;0&quot; , 
Core_IPS_BackendID__c != &quot;-1&quot;)), Core_IPS_Backend_System_Agent_Email__c,&quot;&quot;)),
&quot;&quot;)</formula>
        <label>Case Owner Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Case_Owner_Groups__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Case Owner Group</label>
        <referenceTo>Core_IPS_Case_Owner_Group__c</referenceTo>
        <relationshipLabel>Cases</relationshipLabel>
        <relationshipName>Cases</relationshipName>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Case_Owner_Name__c</fullName>
        <description>It will store Case Owner&apos;s First Name</description>
        <externalId>false</externalId>
        <formula>IF( 
OR(RecordTypeId = $Label.Core_IPS_Case_Create_RecordType_Id,
RecordTypeId = $Label.Core_IPS_Closed_Case_RT_Id,
RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id,
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id),
IF(BEGINS(OwnerId, &quot;005&quot;), Owner:User.FirstName ,
IF(OR(AND(BEGINS(OwnerId, &quot;00G&quot;),
Core_IPS_Backend_System__c!=Null ,
Core_IPS_Backend_ID__c !=Null ,
Core_IPS_Backend_ID__c != &quot;0&quot; ,
Core_IPS_Backend_ID__c != &quot;-1&quot;), AND(BEGINS(OwnerId, &quot;00G&quot;),
Core_IPS_New_Backend_System__c!=Null ,
Core_IPS_BackendID__c !=Null ,
Core_IPS_BackendID__c != &quot;0&quot; ,
Core_IPS_BackendID__c != &quot;-1&quot;)), Core_IPS_Backend_System_Agent_Name__c,&quot;&quot;)),
&quot;&quot;)</formula>
        <label>Case Owner Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Case_Owner__c</fullName>
        <externalId>false</externalId>
        <formula>Owner:User.FirstName + &apos; &apos; + Owner:User.LastName</formula>
