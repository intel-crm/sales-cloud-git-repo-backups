    <webLinks>
        <fullName>MaritzCX__View_Response</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <linkType>javascript</linkType>
        <masterLabel>View Response</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>var responseId = &apos;{!JSENCODE(TEXT(  Case.MaritzCX__ALG_Response_Id__c ))}&apos;; 
if({!Case.MaritzCX__Response_Deleted_From_MaritzCX__c} === 1){
    alert(&apos;The response that originated this case has been deleted from the MaritzCX platform.&apos;);
}
else if(responseId !== &apos;&apos;){ 
var namespace = &apos;{!JSENCODE($Setup.MaritzCX__AlPublic__c.MaritzCX__NamespacePrefix__c)}&apos;; 
var adjScrWidth = (window.screen.width / 2) - (250); 
var adjScrHeight = (window.screen.height / 2) - (275); 
namespace = namespace === &apos;&apos; ? namespace : namespace + &apos;__&apos; ; 
var url = &apos;/apex/&apos; + namespace + &apos;DisplayResponseView?ResponseId=&apos; + responseId ; 
var options = &apos;status=no,&apos; 
+ &apos;height=550,&apos; 
+ &apos;width=500,&apos; 
+ &apos;resizable=yes,&apos; 
+ &apos;left=&apos; + adjScrWidth + &apos;,&apos; 
+ &apos;top=&apos; + adjScrHeight + &apos;,&apos; 
+ &apos;screenX=&apos; + adjScrWidth + &apos;,&apos; 
+ &apos;screenY=&apos; + adjScrHeight + &apos;,&apos; 
+ &apos;toolbar=no,&apos; 
+ &apos;menubar=no,&apos; 
+ &apos;scrollbars=1,&apos; 
+ &apos;location=no,&apos; 
+ &apos;directories=no,&apos; 
+ &apos;titlebar=no,&apos; 
+ &apos;menubar=no&apos;; 
var win2 = window.open(url ,&apos;Response&apos;, options); 
win2.focus(); 
}
else {
    alert(&apos;No record to display&apos;);
}</url>
    </webLinks>
    <webLinks>
        <fullName>RK_Invalid</fullName>
        <availability>online</availability>
        <description>Test button , will be deleted later</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>RK Invalid</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT($Site.Prefix + &quot;/soap/ajax/41.0/connection.js&quot;)} 
{!REQUIRESCRIPT($Site.Prefix + &quot;/soap/ajax/41.0/apex.js&quot;)} 
{!REQUIRESCRIPT($Site.Prefix + &apos;/resource/Core_IPS_Jquery11&apos;)} 
{!REQUIRESCRIPT($Site.Prefix + &apos;/resource/Core_IPS_JqueryUI_10/ui/minified/jquery-ui.min.js&apos;)}
try {
    jQuery(function() {
        jQuery(&apos;head&apos;).append(&apos;&lt;link rel=&quot;stylesheet&quot; href=&quot;//ajax.googleapis.com/ajax/libs/jqueryui/1.10.3/themes/start/jquery-ui.css&quot; type=&quot;text/css&quot; /&gt;&apos;);

        /*Create the HTML(DIV Tag) for the Dialog.*/
        var html =
            &apos;&lt;div id=&quot;dialog&quot; title=&quot;Invalid Case ?&quot;&gt;&lt;p&gt;Are you sure you want to set the Case to Closed.Invalid ?&lt;/p&gt;&lt;/div&gt;&apos;;

        /*Check if the Dialog(DIV Tag) already exists if not then Append the same to the Body tag.*/
        if (!jQuery(&apos;[id=dialog]&apos;).size()) {
            jQuery(&apos;body&apos;).append(html);
        }

        /*Open the jQuery Dialog.*/
        jQuery(&quot;#dialog&quot;).dialog({
            autoOpen: true,
            modal: true,
            show: {
                //effect: &quot;bounce&quot;, 
                duration: 1000
            },
            hide: {
                //effect: &quot;bounce&quot;, 
                duration: 1000
            },
            buttons: {
                &quot;Confirm Invalid Case&quot;: function() {

                    var newRecords = [];

                    var c = new sforce.SObject(&quot;Case&quot;);

                    c.id = &quot;{!Case.Id}&quot;;
                    c.Status = &apos;Closed&apos;;
                    c.Core_Sub_Status__c = &apos;Invalid&apos;;

                    newRecords.push(c);

                    result = sforce.connection.update(newRecords);

                    jQuery(this).dialog(&quot;close&quot;);
                    location.reload();
                },
                Cancel: function() {
                    jQuery(this).dialog(&quot;close&quot;);
                }
            }
        });
    });
} catch (e) {
    alert(&apos;An Error has Occured. Error: &apos; + e);
}</url>
    </webLinks>
