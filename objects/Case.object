    <webLinks>
        <fullName>Core_IPS_Case_Reopen</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Reopen Case</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&apos;/soap/ajax/33.0/connection.js&apos;)}  

if(&apos;{!Case.IsClosed}&apos; == true){  
var c = new sforce.SObject(&apos;Case&apos;);  
var recordtype= sforce.connection.query(&quot;select name, id from recordtype where name=&apos;IPS Case Create&apos;&quot;);  
var result = recordtype.getArray(&quot;records&quot;); 
console.log(JSON.stringify(recordtype.records)); 
c.Id = &apos;{!Case.Id}&apos;;  
c.Status = &apos;Open&apos;;  
c.Core_Sub_Status__c = &apos;Customer Requesting Reopen&apos;;  
//c.RecordTypeId=result[0].Id; 
var result = sforce.connection.update([c]);

//alert(&apos;Profile: {!$Profile.Id}&apos;); 
var profileid = &apos;{!$Profile.Id}&apos;;
var salesprof  = &apos;{!$Label.Core_IPS_SalesRep_ProfileIds}&apos;;
var partprof   =  &apos;{!$Label.Core_Partner_Profile_Id}&apos;;
var agentprof  =  &apos;{!$Label.Core_IPS_Agent_Profiles}&apos;;
var custprof   =  &apos;{!$Label.Core_IPS_External_Customer_Profile_Id}&apos;;



if (result[0].success == &apos;false&apos;) {  
alert(result[0].errors.message);  
} else {  
var cc = new sforce.SObject(&apos;Core_IPS_Case_Comments__c&apos;);  
cc.Core_IPS_Case__c = &apos;{!Case.Id}&apos;;  
//cc.Core_IPS_BgColor__c = &apos;background-color:#7FFFD4&apos;; 
//cc.Core_IPS_Notetype__c = &apos;Note from Customer&apos;;
cc.Core_IPS_Public__c = &apos;true&apos;;
cc.Core_IPS_Case_Comment_Type__c = &apos;Public to Customers&apos;;

  if( (salesprof+&apos;&apos;).indexOf(profileid.substring(0,15))&gt;-1){
     cc.Core_IPS_Comment_Author_Type__c = &apos;FAE&apos;;
    }
  else if 
 ( (custprof+&apos;&apos;).indexOf(profileid.substring(0,15))&gt;-1){
     cc.Core_IPS_Comment_Author_Type__c = &apos;Customer&apos;;
   }
  else if( (agentprof+&apos;&apos;).indexOf(profileid.substring(0,15))&gt;-1){
     cc.Core_IPS_Comment_Author_Type__c = &apos;Agent&apos;;
   }
   else if( (partprof+&apos;&apos;).indexOf(profileid.substring(0,15))&gt;-1){
     cc.Core_IPS_Comment_Author_Type__c = &apos;Partner&apos;;
   }


 //alert(&apos;Agent Profile:&apos; + agentprof + &apos;Profileid : &apos; + profileid.substring(0,15) );

cc.Core_IPS_Rich_Comment__c = prompt(&quot;Enter a Reason to Reopen Case : &quot;,&quot;&quot;);  
sforce.connection.emailHeader = {triggerUserEmail:true};  
var result = sforce.connection.create([cc]);  

if (result[0].success == &apos;false&apos;) {  
alert(result[0].errors.message);  
} else {  
location.reload(true);  
}  
}  
}</url>
