    <fields>
        <fullName>Core_IPS_CreatedBy_User__c</fullName>
        <description>This formula field is used to filter the My Cases list view for external customers. It returns true when the logged in contact = contact on the Case. The My Cases list view filters by this condition.</description>
        <externalId>false</externalId>
        <formula>IF( CreatedById = $User.Id , 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core_IPS_CreatedBy$User</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
