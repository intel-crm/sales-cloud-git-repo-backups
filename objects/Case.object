var url = &quot;/apex/Core_IPS_Case_ExportPDF?id=&quot; + &quot;{!Case.Id}&quot;; 
newWin = window.open(url, &apos;Popup&apos;, &apos;height=1000,width=1000,left=100,top=100,resizable=no,scrollbars=yes,toolbar=no,status=no&apos;); 
