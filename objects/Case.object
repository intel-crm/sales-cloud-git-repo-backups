        <fullName>Core_AAQC_case_created_by_loggedin_user__c</fullName>
        <description>Ask Commissions- Back end Field to check Created by</description>
        <externalId>false</externalId>
        <formula>IF(CreatedById = $User.Id , 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Case Created by Logged in User</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
