    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Check_BES_Deactivated</fullName>
        <active>false</active>
        <errorConditionFormula>AND( OR(ISCHANGED( Core_IPS_BES_Promote_Status__c ), ISCHANGED( Core_IPS_New_Backend_System__c)) ,Core_IPS_New_Backend_System__r.Core_IPS_Deactivated__c   )</errorConditionFormula>
        <errorDisplayField>Core_IPS_New_Backend_System__c</errorDisplayField>
        <errorMessage>Selected Backend system is deactivated</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_mismatch_on_fld_update</fullName>
        <active>true</active>
        <errorConditionFormula>AND ($Profile.Name  = &apos;IPS Data Migration&apos; ,LEN(Core_Issue_Description__c) &lt;&gt; LEN(PRIORVALUE(Core_Issue_Description__c)))</errorConditionFormula>
        <errorMessage>Error in length</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_AAQC_FAE_Should_Not_Close_Case</fullName>
        <active>true</active>
        <description>Ask Commissions- If FAE tries to change the Status to Closed then showing validation message</description>
        <errorConditionFormula>AND($RecordType.DeveloperName ==&apos;Core_AAQC_Case_recordType&apos;,ISPICKVAL( Status,&apos;Closed&apos;), CONTAINS($Label.Core_AAQC_FAE_PROFILE, $Profile.Name), ISCHANGED(Status))</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Only Admins Can Close the Case</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_AAQC_Mandatory_Field_for_Admin</fullName>
        <active>true</active>
        <errorConditionFormula>AND($RecordType.DeveloperName ==&apos;Core_AAQC_Case_recordType&apos;,IF(!CONTAINS($Label.Core_AAQC_FAE_PROFILE, $Profile.Name ),true,false),ISPICKVAL( Status,&apos;Awaiting Resolution Confirmation&apos;),   ISPICKVAL(Core_AAQC_Resolution_Type__c, &apos;&apos;)  )</errorConditionFormula>
        <errorDisplayField>Core_AAQC_Resolution_Type__c</errorDisplayField>
        <errorMessage>Please Enter Resolution Type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_AAQC_Mandatory_Field_for_FAE</fullName>
        <active>true</active>
        <errorConditionFormula>AND($RecordType.DeveloperName ==&apos;Core_AAQC_Case_recordType&apos;,ISPICKVAL( Status,&apos;Cancelled&apos;), ISPICKVAL(Core_AAQC_Cancellation_Reason__c,&apos;&apos;))</errorConditionFormula>
        <errorDisplayField>Core_AAQC_Cancellation_Reason__c</errorDisplayField>
        <errorMessage>Please Enter Reason For Cancellation</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_AAQC_RootCauseField_Required</fullName>
        <active>true</active>
        <description>When case status is &apos;Awaiting Resolution Confirmation&apos;, Root Cause field is mandatory.</description>
        <errorConditionFormula>AND($RecordType.DeveloperName ==&apos;Core_AAQC_Case_recordType&apos;,ISPICKVAL( Status,&apos;Awaiting Resolution Confirmation&apos;),  ISPICKVAL(Core_AAQC_Root_Cause_Category__c,&apos;&apos;))</errorConditionFormula>
        <errorMessage>Please select some value in &apos;Root Cause Category&apos; field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_AAQC_SalesRepBbDual_NoTransferCases</fullName>
        <active>true</active>
        <description>Sales Rep Bb Dual IPS Profile Users should not be allowed to transfer AAQ Cases</description>
        <errorConditionFormula>AND( RecordType.Name=$Label.Ask_Commissions_Case_RT,$Profile.Name= $Label.Core_IPS_Sales_RepBBDual_Profile_Name,ISCHANGED( OwnerId ) )</errorConditionFormula>
        <errorMessage>Insufficient Privilege to change the Owner</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_AAQC_Status_Cannot_Revert_to_Draft</fullName>
        <active>true</active>
        <description>If the Case status is Changed from &apos;Draft&apos;, it should not go back to New</description>
        <errorConditionFormula>AND(RecordType.DeveloperName==&apos;Core_AAQC_Case_recordType&apos;,ISPICKVAL(Status, &apos;Draft&apos;),NOT(ISNEW()),ISCHANGED(Status), NOT(ISPICKVAL( PRIORVALUE( Status ), &quot;Draft&quot; )) )</errorConditionFormula>
        <errorDisplayField>Core_MDF_AccountCompany_txt__c</errorDisplayField>
        <errorMessage>Case Status Cannot be Changed Back to Draft</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_AAQC_Status_shouldNot_Revert_to_New</fullName>
        <active>true</active>
        <description>If the Case status is Changed from New, it should not go back to New
Updated: We can change the status from &apos;Draft&apos; to &apos;New&apos; but not From any other status</description>
        <errorConditionFormula>AND(RecordType.DeveloperName==&apos;Core_AAQC_Case_recordType&apos;,
ISPICKVAL(Status,&apos;New&apos;),
NOT(ISNEW()),
ISCHANGED(Status),
NOT(ISPICKVAL(PRIORVALUE(Status),&quot;New&quot;)),
NOT(ISPICKVAL(PRIORVALUE(Status),&quot;Draft&quot;))
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Case Status Cannot be Changed Back to New</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Cannot_Open_Closed_Case</fullName>
        <active>true</active>
        <description>Agents and Sales Rep cannot change status and sub status once case is closed</description>
        <errorConditionFormula>AND(OR(
AND(ISCHANGED(Status)  ,
ISPICKVAL(PRIORVALUE(Status), &apos;Closed&apos;)  
),
AND(ISCHANGED( Core_Sub_Status__c)  ,
ISPICKVAL(PRIORVALUE(Status), &apos;Closed&apos;)
)
),
ISPICKVAL($User.UserType, &apos;Standard&apos;),
NOT(CONTAINS($Label.Core_IPS_Sys_Admin_Profile_Ids,LEFT($Profile.Id,15))),
OR(RecordTypeId = $Label.Core_IPS_Case_Create_RecordType_Id, 
RecordTypeId = $Label.Core_IPS_Closed_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id))</errorConditionFormula>
        <errorMessage>Not allowed to change Status and Sub Status of closed case.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Case_Backend_Change</fullName>
        <active>true</active>
        <errorConditionFormula>AND( IF( OR( !CONTAINS(Core_IPS_Backend_Previous_Status__c, &apos;disassociate&apos;),Core_IPS_Backend_Previous_Status__c==&apos;&apos;),true,false),IF(
OR(IF(AND(Core_IPS_Backend_System__c&lt;&gt; Null,PRIORVALUE(Core_IPS_Backend_System__c) &lt;&gt; null,PRIORVALUE(Core_IPS_Backend_System__c)&lt;&gt; Core_IPS_Backend_System__c, Core_IPS_Backend_ID__c &lt;&gt; null, ISPICKVAL(Core_Promote_Status__c, &apos;Done&apos;)),true,false), IF(AND(Core_IPS_Backend_System__c&lt;&gt;Null,PRIORVALUE(Core_IPS_Backend_System__c) &lt;&gt; null,PRIORVALUE( Core_IPS_Backend_System__c)&lt;&gt; Core_IPS_Backend_System__c, Core_IPS_Backend_ID__c = null,OR(ISPICKVAL( PRIORVALUE(Core_Promote_Status__c) , &apos;In Progress&apos;) ,ISPICKVAL(PRIORVALUE(Core_Promote_Status__c),&apos;Done&apos;),ISPICKVAL(PRIORVALUE(Core_Promote_Status__c),&apos;Sent Successfully&apos;),ISPICKVAL(PRIORVALUE(Core_Promote_Status__c),&apos;Failed&apos;))),true,false)),true,false))</errorConditionFormula>
        <errorDisplayField>Core_IPS_Backend_System__c</errorDisplayField>
        <errorMessage>Not allowed to change the existing Backend system</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Case_Backend_Restricted_content</fullName>
        <active>false</active>
        <errorConditionFormula>AND(Core_IPS_Backend_System__c&lt;&gt; Null,Core_IPS_Backend_System__r.Core_IPS_BKSys_No_Restricted_Secret_Cont__c = true, Core_IPS_Restricted_Secret_Content__c =true)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Backend_System__c</errorDisplayField>
        <errorMessage>Backend System does not support restricted Content</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Case_Classification</fullName>
        <active>true</active>
        <description>When the Case Classification value is &apos;Public&apos;, it should be read-only</description>
        <errorConditionFormula>OR(RecordTypeId = $Label.Core_IPS_Case_Create_RecordType_Id, 
RecordTypeId = $Label.Core_IPS_Closed_Case_RT_Id,  
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id)&amp;&amp; ISCHANGED( Core_IPS_Classification__c ) &amp;&amp; ISPICKVAL(PRIORVALUE(Core_IPS_Classification__c ), &quot;Public&quot;)&amp;&amp; ISBLANK( Account.Core_CNDA_Number__c )</errorConditionFormula>
        <errorDisplayField>Core_IPS_Classification__c</errorDisplayField>
        <errorMessage>Classification cannot be changed when Public</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Case_Closure_Details</fullName>
        <active>true</active>
        <description>If select an option with(add Details) in &apos;Case Closure&apos; Field, then the Reason for Case Closure should be entered in 	
&apos;Case Closure Details&apos; Field.</description>
        <errorConditionFormula>OR(RecordTypeId = $Label.Core_IPS_Case_Create_RecordType_Id, 
RecordTypeId = $Label.Core_IPS_Closed_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id)&amp;&amp; 
 CONTAINS(TEXT(Core_Case_Closure__c), &apos;(add Details)&apos;) &amp;&amp;   (ISBLANK(Core_Case_Resolution_Reason__c)) &amp;&amp; OR(ISCHANGED(Core_Case_Closure__c) , ISCHANGED(Core_Case_Resolution_Reason__c))&amp;&amp; $Setup.Core_IPS_Run_Rules_Exception_Admin__c.Run_Validation_Rule__c</errorConditionFormula>
        <errorDisplayField>Core_Case_Resolution_Reason__c</errorDisplayField>
        <errorMessage>Please Enter the Case Closure Details.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Case_GEC_Status</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Profile.Name != &apos;Global Export Compliance&apos;,
ISCHANGED(Core_IPS_GEC_Status__c) , 
PRIORVALUE(RecordTypeId) = $Label.Core_IPS_GEC_ReadOnly_RT_Id
)</errorConditionFormula>
        <errorDisplayField>Core_IPS_GEC_Status__c</errorDisplayField>
        <errorMessage>GEC profile users should only be able to change the GEC Status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Case_Owner_Restriction</fullName>
        <active>true</active>
        <description>partner and customer should not be the Case owner</description>
        <errorConditionFormula>AND(OR(RecordTypeId = $Label.Core_IPS_Case_Create_RecordType_Id, 
RecordTypeId = $Label.Core_IPS_Closed_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id),(ISCHANGED(OwnerId) &amp;&amp; Left(OwnerId,3)&lt;&gt;&quot;00G&quot;)
 ,OR(
 	CONTAINS($Label.Core_IPS_External_Customer_Profile_Ids,LEFT(Owner:User.ProfileId, 15))
 	,CONTAINS($Label.Core_Partner_Profile_Id,LEFT(Owner:User.ProfileId, 15))
 	) 
 )</errorConditionFormula>
        <errorMessage>You have selected an external user. The case owner can only be an internal Intel user or another Partner Agent.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Case_Status_Update_For_GEC</fullName>
        <active>true</active>
        <description>Status field should be read-only on the GEC Record Type. It is changed to New only after GEC Status=Approved and Closed when GEC Status = Not Approved or sub-status is invalid</description>
        <errorConditionFormula>AND( 
$Profile.Name != &apos;System Administrator&apos;, 
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id, 
AND( 
NOT(AND( ISPICKVAL(Core_IPS_GEC_Status__c,&apos;Approved&apos;), 
ISPICKVAL(Status, &apos;New&apos;) 
)
), 
AND(NOT( ISPICKVAL(Core_IPS_GEC_Status__c,&apos;Not Approved&apos;)), 
ISPICKVAL(Status, &apos;Closed&apos;),
NOT(ISPICKVAL(Core_Sub_Status__c,&apos;Invalid&apos;) 
)
),
 
ISCHANGED(Status),
NOT ISCHANGED(Core_IPS_GEC_Case__c)
) 
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Case Status cannot be changed for GEC Cases.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Case_Status_Validation</fullName>
        <active>true</active>
        <description>This Validation rule is used to prevent Partner users from editing case Status</description>
        <errorConditionFormula>AND ( 
(OR(RecordTypeId = $Label.Core_IPS_Case_Create_RecordType_Id, 
RecordTypeId = $Label.Core_IPS_Closed_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id)),($Profile.Name = &apos;Partner&apos;), ISCHANGED(Status),NOT(Core_IPS_Partner_status_ReadOnly__c))</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>You do not have access to modify this field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Check_for_Case_SHNfields_update</fullName>
        <active>true</active>
        <description>DM check for field update mismatch</description>
        <errorConditionFormula>AND( $Profile.Name  = &apos;IPS Data Migration&apos; , Core_Issue_Description__c &lt;&gt; PRIORVALUE(Core_Issue_Description__c))</errorConditionFormula>
        <errorMessage>Error due to mismatch in SHN field update.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Closed_Status_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
(OR(RecordTypeId = $Label.Core_IPS_Case_Create_RecordType_Id, 
RecordTypeId = $Label.Core_IPS_Closed_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id)),ISPICKVAL($User.UserType,&apos;PowerPartner&apos;),
ISPICKVAL(PRIORVALUE(Status), &quot;Closed&quot;) , ISCHANGED(Status))</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>This case has been Closed and cannot be updated. You can select the Copy button to copy the case, or you can create a new case.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Customer_Visible</fullName>
        <active>true</active>
        <description>To restrict the uncheck Customer Visible field if it is already checked.</description>
        <errorConditionFormula>ISCHANGED(Core_IPS_Customer_Visible__c ) &amp;&amp; PRIORVALUE(Core_IPS_Customer_Visible__c)</errorConditionFormula>
        <errorMessage>Cannot hide Case from Customer if already visible</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Customer_Visible_Prevent_Check</fullName>
        <active>true</active>
        <description>Prevent checking Customer Visible checkbox for No Assigned Contact Case</description>
        <errorConditionFormula>RecordTypeId= $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id &amp;&amp;  ISCHANGED(Core_IPS_Customer_Visible__c) &amp;&amp; Core_IPS_Customer_Visible__c</errorConditionFormula>
        <errorMessage>Cannot enable Customer Visible for No Assigned Contact Case</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Escalated_Level_Mandatory</fullName>
        <active>true</active>
        <description>Escalated Level cannot be set to blank</description>
        <errorConditionFormula>AND(
 OR(RecordTypeId = $Label.Core_IPS_Case_Create_RecordType_Id, 
RecordTypeId = $Label.Core_IPS_Closed_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_No_Assigned_Contact_Case_RT_Id, 
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id),
ISBLANK(TEXT(Core_IPS_Escalated_Level__c)),
ISCHANGED(Core_IPS_Escalated_Level__c)
)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Escalated_Level__c</errorDisplayField>
        <errorMessage>Please select Escalated Level</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_External_User_Status_Lock</fullName>
        <active>false</active>
        <description>This Validation rule is used to disable IPS External users from editing Case Status Field.</description>
        <errorConditionFormula>AND( 
$Profile.Name!=&apos;Partner&apos;, 
ISCHANGED(Status), 
NOT(ISPICKVAL(PRIORVALUE(Status), &quot;Closed&quot;)), 
ISPICKVAL(Status, &quot;New&quot;) 
)</errorConditionFormula>
        <errorMessage>IPS External Users Cannot change the case status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_FAE_should_fill_all_fields</fullName>
        <active>true</active>
        <errorConditionFormula>($Profile.Name==&quot;IPS FAE&quot;) &amp;&amp;(ISNULL(Core_Hot_Issue_Qts_6__c)  &amp;&amp; ISNULL(Core_IPS_HC_Latest_Update__c)  &amp;&amp;  ISNULL(Core_IPS_HC_Next_Actions__c)  &amp;&amp; ISNULL(Core_IPS_HC_Help_Needed__c )  &amp;&amp;  ISNULL(Core_IPS_HC_Executive_Summary__c ) &amp;&amp;
(NOT ((ISPICKVAL(Core_Hot_Issues_qts_2__c, &quot;Red&quot;))|| (ISPICKVAL(Core_Hot_Issues_qts_2__c, &quot;Yellow&quot;)) || (ISPICKVAL(Core_Hot_Issues_qts_2__c, &quot;Green&quot;))) ))</errorConditionFormula>
        <errorMessage>Please input all field  values under the Hot Issue Section</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_GEC_Case_Owner_Change</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
RecordType.Name = &apos;IPS GEC ReadOnly&apos;, 
NOT(ISPICKVAL(Core_IPS_GEC_Request_Status__c,&apos;Approved&apos;)), 
ISCHANGED(OwnerId), 
NOT(ISCHANGED(Core_IPS_GEC_Case__c)) 
)</errorConditionFormula>
        <errorDisplayField>OwnerId</errorDisplayField>
        <errorMessage>Case cannot be assigned to another owner as long as GEC status is not Approved.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_GEC_CloseCase_Field_NotEditable</fullName>
        <active>true</active>
        <description>MAG Review Request Status, GEC &amp; Compliance Status are non editable for GEC closed cases.</description>
        <errorConditionFormula>AND(
  PRIORVALUE(RecordTypeId) = 
  LEFT($Label.Core_IPS_GEC_ReadOnly_RT_Id,15),
  AND(ISPICKVAL(PRIORVALUE(Status), &apos;Closed&apos;),
      ISPICKVAL(PRIORVALUE( Core_Sub_Status__c ), &apos;GEC Hold&apos;)) ,
  OR( ISCHANGED(Core_IPS_GEC_Flag__c) ,
      ISCHANGED(Core_IPS_GEC_Request_Status__c),
      ISCHANGED(Core_IPS_GEC_Status__c)) ,
 $Setup.Core_IPS_Run_Rules_Exception_Admin__c.Run_Validation_Rule__c 
  )</errorConditionFormula>
        <errorMessage>MAG Review Request Status, GEC &amp; Compliance Status are non editable for closed cases.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_GEC_Status_ReadOnly</fullName>
        <active>true</active>
        <description>This rule is used to restrict External users from Editing Status field on a Case GEC Record type to New/Open.</description>
        <errorConditionFormula>AND(
$Profile.Name = &apos;IPS Agent-Partner&apos;,
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id, 
OR(ISPICKVAL(Status, &apos;Open&apos;),ISPICKVAL(Status, &apos;New&apos;))
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Case Status cannot be changed for GEC Cases.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_HotCase</fullName>
        <active>true</active>
        <errorConditionFormula>(AND(
    ISCHANGED( Core_IPS_HC_Hot_Issue__c ),
    Core_IPS_HC_Hot_Issue__c = TRUE,
    ISBLANK(Date_and_time_of_hot__c )
))
||(
AND(
ISBLANK(Date_and_time_of_hot__c),
NOT(ISBLANK(PRIORVALUE(Date_and_time_of_hot__c)))
))</errorConditionFormula>
        <errorMessage>Please fill the Date Hot Case Enabled or Once  Date Hot Case Enabled has been provided you cannot remove</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Legacy_Visibility_check</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED( Core_IPS_Issue_source__c ) &amp;&amp; ISPICKVAL(PRIORVALUE(Core_IPS_Issue_source__c), &quot;Legacy PSG&quot;)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Issue_source__c</errorDisplayField>
        <errorMessage>PSG migrated cases legacy source value can not be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_MAG_Questionnaire_incomplete</fullName>
        <active>false</active>
        <description>Show an error message when MAG review status is set to Completed and MAG Questionnaire is incomplete. Only for GEC cases.</description>
        <errorConditionFormula>AND(
RecordTypeId = $Label.Core_IPS_GEC_ReadOnly_RT_Id,
 ISPICKVAL( Core_IPS_GEC_Request_Status__c , &apos;MAG Questionnaire Completed&apos;),  NOT(Core_IPS_MAG_Questionnaire_Completed__c) 
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>MAG Questionnaire must be completed prior MAG Review status is changed to Completed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Migrated_Close_Case</fullName>
        <active>true</active>
        <errorConditionFormula>IF(AND($Profile.Name &lt;&gt; &apos;System Administrator&apos;,$Profile.Name &lt;&gt; &apos;IPS Data Migration&apos;, $Profile.Name &lt;&gt; &apos;Data Ops&apos;, $Profile.Name &lt;&gt; &apos;IT Admin&apos;,Core_IPS_Legacy_IPS_ID__c&lt;&gt;null, Core_IPS_Closed_Case_Migration__c =true,NOT(LastModifiedDate &lt;&gt; LastModifiedDate)), true, false)</errorConditionFormula>
        <errorMessage>Please do not modify the Record as it  is closed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Prevent_Case_Close_Internal</fullName>
        <active>false</active>
        <description>Prevents Sales users from closing IPS Cases</description>
        <errorConditionFormula>AND(OR(RecordType.Name = &quot;IPS Case Create&quot;,RecordType.Name = &quot;IPS No Assigned Contact Case&quot;),ispickval(Status,&quot;Closed&quot;),NOT( OR($Profile.Id = &quot;00eo0000000f7GT&quot;, $Profile.Id = &quot;00eo0000000f7GY&quot;,$Profile.Id = &quot;00eo0000000f7Gd&quot;,$Profile.Id = &quot;00eo0000000f7Gi&quot;,$Profile.Id = &quot;00eo0000000TVUC&quot;,$Profile.Id = &quot;00eo0000000f7PB&quot;,$Profile.Id = &quot;00eo0000000f7Gn&quot;,$Profile.Id = &quot;00eo0000000ui0b&quot;,$Profile.Id = &quot;00eo0000000gvOw&quot;)))</errorConditionFormula>
        <errorMessage>You are not authorized to close IPS Cases</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Restrict_ReOpen_After_30_Days</fullName>
        <active>true</active>
        <description>To restrict Business Users to reopen the Closed Case after 30 days.</description>
        <errorConditionFormula>AND(IsClosed,IF(Now()-VALUE($Label.Core_IPS_N_Days) &gt;= ClosedDate,true,false),ISPICKVAL(Status,&apos;Open&apos;),OR($RecordType.DeveloperName = &apos;IPS_Closed_Case&apos;,$RecordType.DeveloperName = &apos;IPS_Case_Create&apos;))</errorConditionFormula>
        <errorMessage>As this case has been closed for more than 30 days it can no longer be reopened. Please submit a new case if you need further support.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Sub_Status_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(RecordType.DeveloperName==&apos;IPS_Closed_Case&apos;,NOT(ISNEW()),ISPICKVAL(Core_Sub_Status__c,&apos;Investigating&apos;),ISCHANGED(Core_Sub_Status__c),ISPICKVAL(PRIORVALUE(Core_Sub_Status__c),&apos;Closed&apos;), ISPICKVAL( Status , &apos;Closed&apos;) )</errorConditionFormula>
        <errorMessage>Not allowed to change Sub Status of Closed Case.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_ips_Case_status_change</fullName>
        <active>true</active>
        <description>some user cannot change the status from hold to Open/New</description>
        <errorConditionFormula>AND(ISCHANGED(Status) ,RecordType.Name=&apos;IPS GEC ReadOnly&apos; , 
NOT(ISCHANGED(RecordTypeId)), $Profile.Name!=&apos;IT Admin&apos;, $Profile.Name!=&apos;Production Support-IPS&apos; ,$Profile.Name!=&apos;System Admin1&apos;,$Profile.Name!=&apos;Global Export Compliance&apos;)</errorConditionFormula>
        <errorMessage>Status of the cases under GEC review cannot be changed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>GanapatiTest</fullName>
        <active>false</active>
        <errorConditionFormula>CONTAINS(Subject  , &apos;GanapatiShinde&apos;)</errorConditionFormula>
        <errorMessage>should not contain GanapatiShinde</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IPS_Altera_Go_Live_Case_Restriction</fullName>
        <active>true</active>
        <description>Restricting the user to create/edit cases with Altera products during migration</description>
        <errorConditionFormula>AND($Label.IPS_Altera_Go_Live= &apos;True&apos;,Core_IPS_Product_Org_Number__c = &apos;025&apos;,  $User.Id  &lt;&gt;  $Label.Altera_Bypass_UserId )</errorConditionFormula>
        <errorMessage>Not allowed to create or update record related to Org 025</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MaritzCX__Prevent_MaritzCX_Case_Update</fullName>
        <active>true</active>
        <description>This validation rule will prevent all the users to modify the case whose response is deleted from the system.</description>
        <errorConditionFormula>IF(NOT(ISBLANK(MaritzCX__ALG_Response_Id__c)), IF(ISCHANGED(MaritzCX__Response_Deleted_From_MaritzCX__c), NOT(MaritzCX__Response_Deleted_From_MaritzCX__c), MaritzCX__Response_Deleted_From_MaritzCX__c), false)</errorConditionFormula>
        <errorMessage>The response that originated this case has been deleted from the MaritzCX platform. As a result, this case cannot be updated.</errorMessage>
    </validationRules>
