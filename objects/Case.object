        <fullName>Core_IPS_Case_URL__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;https://premiersupport.intel.com/IPS/&quot; &amp; Id, CaseNumber)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Case URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Case__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Parent to child Case Relationship</description>
        <inlineHelpText>Linking Parent to children Case relationships</inlineHelpText>
        <label>Related Case(s)</label>
        <referenceTo>Case</referenceTo>
        <relationshipLabel>Cases (Related Case(s))</relationshipLabel>
        <relationshipName>Cases1</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Category_and_Subcategory__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    AND(
        NOT(ISBLANK(Core_External_Issue_Category__c)),
        ISBLANK(Core_External_Issue_Subcategory__c)
    ),
    Core_External_Issue_Category__c,
    IF(
        AND(
            NOT(ISBLANK(Core_External_Issue_Category__c)),
            NOT(ISBLANK(Core_External_Issue_Subcategory__c))
        ),
        Core_External_Issue_Category__c &amp; &apos;.&apos; &amp; Core_External_Issue_Subcategory__c,
        NULL
    )
)</formula>
        <label>Category and Subcategory</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Classification__c</fullName>
        <label>Classification</label>
        <required>false</required>
