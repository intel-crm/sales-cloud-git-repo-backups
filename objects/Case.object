    <fields>
        <fullName>Core_IPS_MAG_Questionnaire__c</fullName>
        <description>22 Feb 2019 Changed label to  MINDS Questionnaire- US253171</description>
        <externalId>false</externalId>
        <formula>IF((ISPICKVAL(Core_IPS_GEC_Request_Status__c, &apos;MAG Questionnaire Required&apos;) || ISPICKVAL(Core_IPS_GEC_Request_Status__c, &apos;MAG Questionnaire Completed&apos;)),
  IF(($User.UIThemeDisplayed == &apos;Theme4d&apos;||$User.UIThemeDisplayed == &apos;Theme4u&apos;)&amp;&amp;($User.UIThemeDisplayed != &apos;Theme3&apos;),
  HYPERLINK(&quot;/lightning/n/MINDS_Questionnarie?c__recordId=&quot;+Id, &apos;Click Here to Fill Out&apos; ,&apos;_self&apos;) ,
  HYPERLINK(Left($Api.Enterprise_Server_URL_190,(find(&apos;/services&apos;,$Api.Enterprise_Server_URL_190))) + &apos;apex/Core_IPS_MAG_Questionnaire?Id=&apos;+Id , &apos;Click Here to Fill Out&apos; ,&apos;_self&apos;) ), &apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>MINDS Questionnaire</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Minds__c</fullName>
        <defaultValue>false</defaultValue>
