<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Table to store the mapping of location to approver group mapping. This is used by Design Registrations.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Core_Active_Ind__c</fullName>
        <defaultValue>true</defaultValue>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Approver_Group_Nm__c</fullName>
        <externalId>false</externalId>
        <label>Approver Group Name</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Country_Cd__c</fullName>
        <externalId>false</externalId>
        <label>Country Code</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Product_Group_Nm__c</fullName>
        <externalId>false</externalId>
        <label>Product Group</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_State_Cd__c</fullName>
        <externalId>false</externalId>
        <label>State Code</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Location To Approver Group Mapping</label>
    <listViews>
        <fullName>All_Records</fullName>
        <columns>OBJECT_ID</columns>
        <columns>NAME</columns>
        <columns>Core_Product_Group_Nm__c</columns>
        <columns>Core_Country_Cd__c</columns>
        <columns>Core_State_Cd__c</columns>
        <columns>Core_Approver_Group_Nm__c</columns>
        <columns>Core_Active_Ind__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>UPDATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <label>All Records</label>
    </listViews>
    <visibility>Public</visibility>
</CustomObject>
