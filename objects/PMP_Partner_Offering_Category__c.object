    <fields>
        <fullName>PMP_Ancestor_Category_Cd__c</fullName>
        <description>Holds the Ancestor Category Id of the selected Category. Helps in selection up to parent most category on UI.</description>
        <externalId>false</externalId>
        <inlineHelpText>Holds the Ancestor Category Id of the selected Category.</inlineHelpText>
        <label>Ancestor Category Id</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
