    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_PrvntDistinctNameAndTchPrgmName</fullName>
        <active>true</active>
        <description>To prevent distinct values on Name and Technical Program Name</description>
        <errorConditionFormula>AND(

NOT(ISBLANK(TEXT(Core_MDF_Technical_Program_Name__c))),

NOT(ISBLANK(Name)),IF(TEXT(Core_MDF_Technical_Program_Name__c) = &apos;Client CoMarketing Fund&apos;,IF(Name &lt;&gt; &apos;Client&apos;,TRUE,FALSE),

IF(TEXT(Core_MDF_Technical_Program_Name__c) = &apos;Data Center CoMarketing Fund&apos;,IF(Name &lt;&gt; &apos;Datacenter&apos;,TRUE,FALSE),TEXT(Core_MDF_Technical_Program_Name__c) &lt;&gt; SUBSTITUTE(Name,&apos;-&apos;,&apos;&apos;))))</errorConditionFormula>
        <errorDisplayField>IsActive</errorDisplayField>
        <errorMessage>Channel Program Name and Technical Program Name should not be distinct</errorMessage>
    </validationRules>
</CustomObject>
