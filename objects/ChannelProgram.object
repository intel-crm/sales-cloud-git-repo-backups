    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Category</fullName>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Channel_Program_Unique_Id_nm__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Unique Name of Channel Program which is concatenated with Name and Technical Program Name without any white spaces</description>
        <externalId>false</externalId>
        <label>Channel Program Unique Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Project_Platform__c</fullName>
        <externalId>false</externalId>
        <label>Project/Platform</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Technical_Program_Name__c</fullName>
        <label>Technical Program Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Technical_Program_Name</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Description</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsActive</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Name</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>OwnerId</fullName>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Program_External_Id__c</fullName>
        <externalId>true</externalId>
        <label>Program External Id</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <listViews>
        <fullName>All_Channel_Programs</fullName>
        <filterScope>Everything</filterScope>
        <label>All Channel Programs</label>
    </listViews>
    <listViews>
        <fullName>My_Channel_Programs</fullName>
