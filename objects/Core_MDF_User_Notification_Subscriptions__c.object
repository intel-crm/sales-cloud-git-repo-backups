    <fields>
        <fullName>Core_MDF_Change_History_txt__c</fullName>
        <description>To track previously selected Notification types.</description>
        <label>Change History</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_MDF_External_Id__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>To maintain uniqueness, this field will store unique Id for each record.</description>
        <externalId>false</externalId>
        <label>External Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Mandate_Noti_Detected_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To prevent unsubscription for mandatory notifications.</description>
        <label>Mandate Notification Detected</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Object_nm__c</fullName>
        <description>To store object name for which user has unsubscribed notifications.</description>
        <label>Module</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Subscription_Objects_nm</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Unsubscribed_nm__c</fullName>
        <description>This field holds all the notifications which user has unsubscribed to.</description>
        <inlineHelpText>Notification types which user has unsubscribed to.</inlineHelpText>
        <label>Unsubscribed Notifications</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <controllingField>Core_MDF_Object_nm__c</controllingField>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Notification_Type</valueSetName>
            <valueSettings>
                <controllingFieldValue>PFC - PartnerFundClaim</controllingFieldValue>
                <valueName>PFC_PIC_FAIL_RWC</valueName>
            </valueSettings>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_User_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>To store User Id.</description>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>User_Notification_Subscriptions</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>User Notification Subscriptions</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Object_nm__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>A-{0000}</displayFormat>
        <label>User Notification Subscriptions Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>User Notification Subscriptions</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>Accept</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>MassAssignRecordLabel</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Mandatory_Notifications_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF(Core_MDF_Mandate_Noti_Detected_Ind__c,true, false)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Unsubscribed_nm__c</errorDisplayField>
        <errorMessage>Mandatory Notifications can not be Selected.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
