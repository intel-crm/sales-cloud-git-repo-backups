    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>End_Date__c</fullName>
        <description>User populate this field to specify end Date of delegation</description>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Start_Date__c</fullName>
        <description>User populate this field to specify start Date of delegation</description>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>core_cpq_IsActive__c</fullName>
        <formula>AND(Start_Date__c &lt;=TODAY(),End_Date__c &gt;=TODAY())</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IsActive</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>core_cpq_delegated_For__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Delegated For</label>
        <referenceTo>User</referenceTo>
        <relationshipName>User_Delegations</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>core_cpq_delegated_to__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Delegated To</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Search a valid User</errorMessage>
            <filterItems>
                <field>User.IsActive</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>User_Delegations1</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>User Delegation</label>
    <nameField>
        <displayFormat>UD-{0000}</displayFormat>
        <label>User Delegation</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>User Delegations</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
