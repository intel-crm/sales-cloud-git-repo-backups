<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Metadata to store URL for embedding in Salesforce. This contains filters, user info and security aspects.</description>
    <fields>
        <fullName>Core_Access_Level__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Access Level</label>
        <length>10</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Add_User_SessionID__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is to be checked when url needs user session id.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Add User SessionID</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Auto_SSO_Enabled__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If SSO option needs to be shown on the report, then uncheck it else check this box to automatically enable user login</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Auto SSO Enabled</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Client_ID__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Client ID</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Client_Secret__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Client Secret</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Session_Parameter__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Session Parameter</label>
        <length>50</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Tenant_Id__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Tenant Id</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Dynamic_Filter_and_Value__c</fullName>
        <description>Field to store dynamic filter and the corresponding field name for the filter</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Dynamic Filter and Value</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Dynamic_Filter_and_Value_txt__c</fullName>
        <description>Field to store dynamic filter and the corresponding field name for the filter</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Dynamic Filter and Value txt</label>
        <length>140</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Dynamic_filter__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If the URL needs dynamic filter</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Dynamic filter</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Embed_URL_Class__c</fullName>
        <description>Class name for service call</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Embed_URL_Class</label>
        <length>200</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>No_Access_Error__c</fullName>
        <description>Error that needs to be displayed if no access</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>No Access Error</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>No_Access_Error_txt__c</fullName>
        <description>Error that needs to be displayed if no access</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>No Access Error txt</label>
        <length>140</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Object__c</fullName>
        <description>Store the object from where the filter fields need to be retrieved</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Object</label>
        <length>50</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <description>Stores the project name of the URL</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Project</label>
        <length>30</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Security_Query__c</fullName>
        <description>The condition that needs to be check. Output can be True/False</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Security Query</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Security_Query_txt__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Security Query txt</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Security_enforced__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Check box if additional security check is required to view PowerBI report</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Security enforced</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Static_Filter_and_Value__c</fullName>
        <description>Static filter value</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Static Filter and Value</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Static_Filter_and_Value_txt__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Static Filter and Value txt</label>
        <length>140</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Static_filter__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If the URL needs a filter</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Static filter</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>URL__c</fullName>
        <description>Field to store URL</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Field to store URL</inlineHelpText>
        <label>URL</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>User_Filter_and_Value__c</fullName>
        <description>Query the user info to be appended in the URL</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>User Filter and Value</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>User_Filter_and_Value_txt__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>User Filter and Value txt</label>
        <length>70</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>User_Info__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Is User info requierd?</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>User Info</label>
        <type>Checkbox</type>
    </fields>
    <label>Custom URL Embed</label>
    <listViews>
        <fullName>All_Configurations</fullName>
        <columns>MasterLabel</columns>
        <columns>NamespacePrefix</columns>
        <columns>DeveloperName</columns>
        <columns>Project__c</columns>
        <columns>URL__c</columns>
        <columns>Dynamic_filter__c</columns>
        <columns>Object__c</columns>
        <columns>Static_filter__c</columns>
        <columns>Static_Filter_and_Value__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Configurations</label>
        <language>en_US</language>
    </listViews>
    <pluralLabel>Custom URL Embeds</pluralLabel>
    <validationRules>
        <fullName>Dynamic_Filter_Validation</fullName>
        <active>true</active>
        <description>Fill &apos;Filter and Value&apos; and &apos;Object&apos; field for Dynamic filter to work.</description>
        <errorConditionFormula>if(Dynamic_filter__c &amp;&amp;  
(ISBLANK(Dynamic_Filter_and_Value_txt__c)||ISBLANK(Object__c)),
true,false)</errorConditionFormula>
        <errorMessage>Fill &apos;Filter and Value&apos; and &apos;Object&apos; field for Dynamic filter to work.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Security_Validation</fullName>
        <active>true</active>
        <description>Fill &apos;Security Query&apos; &amp; &apos;No Access Error&apos; fields for Security to be enforced.</description>
        <errorConditionFormula>if(Security_enforced__c &amp;&amp; (ISBLANK(Security_Query_txt__c)|| ISBLANK(No_Access_Error_txt__c)),true,false)</errorConditionFormula>
        <errorMessage>Fill &apos;Security Query&apos; field for Security to be enforced.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Static_Filter_Validation</fullName>
        <active>true</active>
        <description>Fill &apos;Static Filter&apos; field for Static filter to work.</description>
        <errorConditionFormula>if(Static_filter__c &amp;&amp; ISBLANK(Static_Filter_and_Value_txt__c),true,false)</errorConditionFormula>
        <errorMessage>Fill &apos;Static Filter&apos; field for Static filter to work.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>User_Info_Validation</fullName>
        <active>true</active>
        <description>If User Info is required and Filter-Value pair field is empty.</description>
        <errorConditionFormula>if( User_Info__c &amp;&amp; ISBLANK( User_Filter_and_Value_txt__c ),true,false)</errorConditionFormula>
        <errorMessage>Fill &apos;User Filter and Value&apos; field for User Info filter to work.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
