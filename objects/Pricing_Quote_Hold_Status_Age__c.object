        <fullName>Pricing_OnHold_Cummulative_Time__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISNULL(Pricing_QuoteOnHold_End_Time__c ) ,   ((DATETIMEVALUE( NOW() ) -  Pricing_QuoteOnHold_Start_Time__c) * 24), ((Pricing_QuoteOnHold_End_Time__c  -  Pricing_QuoteOnHold_Start_Time__c) * 24))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
