        <fullName>Core_MDF_Keywords__c</fullName>
        <description>Comma-separated keywords for role recommendation scoring. Example: budget, approve, reject, mdf, ccf</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Comma-separated keywords. More matches = higher recommendation score.</inlineHelpText>
        <label>Keywords</label>
