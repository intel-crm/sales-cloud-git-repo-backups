    <fields>
        <fullName>CPT_Effective_Start__c</fullName>
        <description>Effective end formula field to derive start date for the setup.[10-Dec-25]</description>
        <formula>CASE( 
LEFT(TEXT(CPT_Effective_Month__c), 3), &quot;Jan&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 1, 1), &quot;Feb&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 2, 1), &quot;Mar&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 3, 1), &quot;Apr&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 4, 1), &quot;May&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 5, 1), &quot;Jun&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 6, 1), &quot;Jul&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 7, 1), &quot;Aug&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 8, 1), &quot;Sep&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 9, 1), &quot;Oct&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 10, 1), &quot;Nov&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 11, 1), &quot;Dec&quot;, 
DATE(VALUE(MID(TEXT(CPT_Effective_Month__c), 5, 4)), 12, 1), DATE(1900, 1, 1) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Effective_Start</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
