    <fields>
        <fullName>CPT_BR_All_Quota__c</fullName>
        <inlineHelpText>Value is in whole dollars.</inlineHelpText>
        <label>BR-All Quota</label>
        <summarizedField>CPT_Territory_Assignment__c.CPT_BR_All_Target__c</summarizedField>
        <summaryFilterItems>
            <field>CPT_Territory_Assignment__c.CPT_BR_All__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>CPT_Territory_Assignment__c.CPT_Quota_Setup__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>CPT_BR_Allocated__c</fullName>
        <formula>(
VALUE( SUBSTITUTE(TEXT( CPT_BR_CCG_Assigned__c ), &apos;%&apos;, &apos;&apos;)) +
VALUE( SUBSTITUTE(TEXT( CPT_BR_DCAI_Assigned__c), &apos;%&apos;, &apos;&apos;))
)/100</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>BR (Allocated)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>CPT_BR_Allocation_Editable__c</fullName>
        <formula>OR(
    ISPICKVAL(CPT_Plan__c, &quot;120&quot;),
    ISPICKVAL(CPT_Plan__c, &quot;121&quot;),
    ISPICKVAL(CPT_Plan__c, &quot;122&quot;),
    ISPICKVAL(CPT_Plan__c, &quot;620&quot;),
    ISPICKVAL(CPT_Plan__c, &quot;621&quot;),
    AND(
        OR(
            ISPICKVAL(CPT_Plan__c, &quot;331&quot;),
            ISPICKVAL(CPT_Plan__c, &quot;631&quot;)
        ),
        CPT_Sales_Group__c = &quot;PRC&quot;
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>BR Allocation Editable</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CPT_BR_Allowed__c</fullName>
        <formula>IF(
    AND(
        OR(
            ISPICKVAL(CPT_Plan__c,&quot;331&quot;),
            ISPICKVAL(CPT_Plan__c,&quot;631&quot;)
        ),
        CPT_Employee__r.CPT_Sales_Group__c &lt;&gt; &quot;PRC&quot;
    ),
    0,

    VALUE(
        SUBSTITUTE(
            TEXT(
                CPT_Employee__r.CPT_Sales_Compensation_Plan__r.CPT_Percent_Billings_Revenue__c
            ),
            &quot;%&quot;,
            &quot;&quot;
        )
    ) / 100
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>BR (Allowed)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>CPT_BR_Assigned__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(CPT_BR_Allocated__c*100) &amp; &quot;/&quot; &amp; TEXT(CPT_BR_Allowed__c*100) &amp; &quot;%&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>BR (% Assigned)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
