    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>CPT_Avoid_AssignPercent_To_None</fullName>
        <active>true</active>
        <description>Please select 0% instead of &quot;none&quot; for all the Assigned % fields.</description>
        <errorConditionFormula>OR(
AND(
  CPT_BR_Allowed__c &gt; 0, 
  OR(
    TEXT(CPT_BR_CCG_Assigned__c)=&apos;&apos;,  
    TEXT(CPT_BR_DCAI_Assigned__c)=&apos;&apos;, 
    TEXT(CPT_BR_All_Assigned__c)=&apos;&apos;
  )
),

AND(
  CPT_CR_Allowed__c &gt; 0, 
  OR(
    TEXT(CPT_CR_OEM_Assigned__c)=&apos;&apos;,
    TEXT(CPT_CR_Partner_Assigned__c)=&apos;&apos;,
    TEXT(CPT_CR_Retail_Assigned__c)=&apos;&apos;
  )
),





AND(
  CPT_Sales_OKR_Allowed__c &gt; 0, 
  OR(
    CPT_Sales_OKR_Assigned__c=&apos;&apos;
  )
),

AND(
  CPT_Sales_Team_Goal_Allowed__c &gt; 0, 
  OR(
    CPT_Sales_Team_Goal_Assigned__c =&apos;&apos;
  )
)

)</errorConditionFormula>
        <errorMessage>Please select 0% instead of &quot;none&quot; for all the Assigned % fields.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Avoid_BR_AssignPercent_WhenNoTarget</fullName>
        <active>true</active>
        <description>Restrict user from giving the percentage assigned when there is no target.</description>
        <errorConditionFormula>AND(ISPICKVAL(CPT_Stage__c, &apos;Completed&apos;),
OR(
IF(Text(CPT_BR_CCG_Assigned__c)=&apos;0%&apos;,false,IF(CPT_BR_CCG_Quota__c=0,true,false)),
IF(Text(CPT_BR_DCAI_Assigned__c )=&apos;0%&apos;,false,IF(CPT_BR_DCAI_Quota__c=0,true,false)))
)</errorConditionFormula>
        <errorMessage>A Territory must be linked to the selected Billings Revenue Business Units (BU) to assign % and Quota. Please select the BR-BU checkbox in Territory Assignments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Avoid_CR_AssignPercent_WhenNoTarget</fullName>
        <active>true</active>
        <description>Restrict user from giving the percentage assigned when there is no target.</description>
        <errorConditionFormula>AND(ISPICKVAL(CPT_Stage__c, &apos;Completed&apos;),
OR(
IF(Text(CPT_CR_OEM_Assigned__c)=&apos;0%&apos;,false,IF(CPT_CR_OEM_Quota__c=0,true,false)),
IF(Text(CPT_CR_Retail_Assigned__c)=&apos;0%&apos;,false,IF(CPT_CR_Retail_Quota__c=0,true,false)),
IF(Text(CPT_CR_Partner_Assigned__c)=&apos;0%&apos;,false,IF(CPT_CR_Partner_Quota__c=0,true,false))
)
)</errorConditionFormula>
        <errorMessage>A Territory must be linked to the selected Consumption Revenue Business Units (BU) to assign % and Quota. Please select the CR-BU checkbox in Territory Assignments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Avoid_DR_AssignPercent_WhenNoTarget</fullName>
        <active>false</active>
        <description>Restrict user from giving the percentage assigned when there is no target.</description>
        <errorConditionFormula>OR(IF(Text(CPT_DR_AXG_Assigned__c)=&apos;0%&apos;,false,IF(CPT_DR_AXG_Quota__c=0,true,false)),
IF(Text(CPT_DR_CCG_Assigned__c)=&apos;0%&apos;,false,IF(CPT_DR_CCG_Quota__c=0,true,false)),
IF(TEXT(CPT_DR_DCAI_Assigned__c) =&apos;0%&apos;,false,IF(CPT_DR_DCAI_Quota__c=0,true,false)),
IF(TEXT(CPT_DR_NEX_Assigned__c) =&apos;0%&apos;,false,IF(CPT_DR_NEX_Quota__c=0,true,false)))</errorConditionFormula>
        <errorMessage>A Territory must be tied to selected Deal Win Rev BU&apos;s to Assign % and Quota. Please add quota for selected DR-BU(s) in Territory Assignments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_BR_Fixed_Plan_Allocation</fullName>
        <active>true</active>
        <description>Enforce fixed BR CCG/DCG allocations for Plans 250, 330, 630 and 650.</description>
        <errorConditionFormula>AND(
    NOT(ISNEW()),
    OR(
        AND(
            ISPICKVAL(CPT_Plan__c, &quot;250&quot;),
            OR(
                NOT(ISPICKVAL(CPT_BR_CCG_Assigned__c, &quot;0%&quot;)),
                NOT(ISPICKVAL(CPT_BR_DCAI_Assigned__c, &quot;40%&quot;))
            )
        ),
        AND(
            OR(
                ISPICKVAL(CPT_Plan__c, &quot;330&quot;),
                ISPICKVAL(CPT_Plan__c, &quot;630&quot;),
                ISPICKVAL(CPT_Plan__c, &quot;650&quot;)
            ),
            OR(
                NOT(ISPICKVAL(CPT_BR_CCG_Assigned__c, &quot;0%&quot;)),
                NOT(ISPICKVAL(CPT_BR_DCAI_Assigned__c, &quot;20%&quot;))
            )
        )
    )
)</errorConditionFormula>
        <errorMessage>BR allocation is fixed. Plan 250 requires CCG 0% and DCG 40%. Plans 330, 630 and 650 require CCG 0% and DCG 20%.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_BR_Prevent_Excess_Allocation</fullName>
        <active>true</active>
        <description>Prevent over allocation of Billing Revenue(BR)</description>
        <errorConditionFormula>CPT_BR_Allocated__c &gt; CPT_BR_Allowed__c</errorConditionFormula>
        <errorMessage>The BR % Assigned exceeds the allowed limit.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_BR_Prevent_Incomplete_Data_Update</fullName>
        <active>true</active>
        <description>Enforce Billing Revenue assignment and quota is complete</description>
        <errorConditionFormula>AND(
ISPICKVAL(CPT_Stage__c, &apos;Completed&apos;),
OR(
AND(OR(ISBLANK(TEXT(CPT_BR_CCG_Assigned__c)), TEXT(CPT_BR_CCG_Assigned__c)=&apos;0%&apos;), CPT_BR_CCG_Quota__c&gt;0),
AND(OR(ISBLANK(TEXT(CPT_BR_DCAI_Assigned__c)), TEXT(CPT_BR_DCAI_Assigned__c)=&apos;0%&apos;), CPT_BR_DCAI_Quota__c&gt;0),
AND(TEXT(CPT_BR_CCG_Assigned__c)&lt;&gt;&apos;0%&apos;, TEXT(CPT_BR_CCG_Assigned__c)&lt;&gt;&apos;&apos;, CPT_BR_CCG_Quota__c&lt;=0),
AND(TEXT(CPT_BR_DCAI_Assigned__c)&lt;&gt;&apos;0%&apos;, TEXT(CPT_BR_DCAI_Assigned__c)&lt;&gt;&apos;&apos;, CPT_BR_DCAI_Quota__c&lt;=0),
CPT_BR_Allocated__c &lt;&gt; CPT_BR_Allowed__c
)
)</errorConditionFormula>
        <errorMessage>Please complete the Billings Revenue Assigned % and Quota fields.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_CR_Prevent_Excess_Allocation</fullName>
        <active>true</active>
        <description>Prevent over allocation of Consumption Revenue(CR)</description>
        <errorConditionFormula>CPT_CR_Allocated__c &gt;  CPT_CR_Allowed__c</errorConditionFormula>
        <errorMessage>The CR % Assigned exceeds the allowed limit.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_CR_Prevent_Incomplete_Data_Update</fullName>
        <active>true</active>
        <description>Enforce Consumption Revenue assignment and quota is complete</description>
        <errorConditionFormula>AND(
  ISPICKVAL(CPT_Stage__c, &apos;Completed&apos;),
  OR(
    AND(OR(ISBLANK(TEXT(CPT_CR_OEM_Assigned__c)), TEXT(CPT_CR_OEM_Assigned__c)=&apos;0%&apos;), CPT_CR_OEM_Quota__c&gt;0),
    AND(OR(ISBLANK(TEXT(CPT_CR_Retail_Assigned__c)), TEXT(CPT_CR_Retail_Assigned__c)=&apos;0%&apos;), CPT_CR_Retail_Quota__c&gt;0),
    AND(OR(ISBLANK(TEXT(CPT_CR_Partner_Assigned__c)), TEXT(CPT_CR_Partner_Assigned__c)=&apos;0%&apos;), CPT_CR_Partner_Quota__c&gt;0),
    AND(TEXT(CPT_CR_OEM_Assigned__c)&lt;&gt;&apos;0%&apos;, TEXT(CPT_CR_OEM_Assigned__c)&lt;&gt;&apos;&apos;, CPT_CR_OEM_Quota__c&lt;=0),
    AND(TEXT(CPT_CR_Retail_Assigned__c)&lt;&gt;&apos;0%&apos;, TEXT(CPT_CR_Retail_Assigned__c)&lt;&gt;&apos;&apos;, CPT_CR_Retail_Quota__c&lt;=0),
    AND(TEXT(CPT_CR_Partner_Assigned__c)&lt;&gt;&apos;0%&apos;, TEXT(CPT_CR_Partner_Assigned__c)&lt;&gt;&apos;&apos;, CPT_CR_Partner_Quota__c&lt;=0),
    CPT_CR_Allocated__c &lt;&gt; CPT_CR_Allowed__c
  )
)</errorConditionFormula>
        <errorMessage>Please complete the Consumption Revenue Assigned % and Quota fields.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Cannot_Edit_Locked_Records</fullName>
        <active>true</active>
        <description>Restrict users from editing the record when the record is locked</description>
        <errorConditionFormula>OR(
    AND(
       CPT_Locked_Status__c = &apos;Soft Lock&apos;, 
       NOT($Permission.CPT_IT_Admin_System_Admin_Permission ),
       NOT($Permission.CPT_Commission_Admin_Permission)
    ),


   AND(
      CPT_Locked_Status__c = &apos;Hard Lock&apos;, 
      NOT($Permission.CPT_IT_Admin_System_Admin_Permission )
   )

)</errorConditionFormula>
        <errorMessage>This record is locked. Please contact the Commissions Admin with any questions.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_DR_Prevent_Excess_Allocation</fullName>
        <active>false</active>
        <description>Prevent over allocation of Deal Win Revenue(DR)</description>
        <errorConditionFormula>CPT_DR_Allocated__c &gt; CPT_DR_Allowed__c</errorConditionFormula>
        <errorMessage>DR % Assigned is greater than allowed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_DR_Prevent_Incomplete_Data_Update</fullName>
        <active>false</active>
        <description>Enforce Deal Win Revenue assignment and quota is complete</description>
        <errorConditionFormula>AND(ISPICKVAL(CPT_Stage__c, &apos;Completed&apos;),

OR(
AND(OR(ISBLANK(TEXT(CPT_DR_CCG_Assigned__c)),Text(CPT_DR_CCG_Assigned__c)=&apos;0%&apos;), CPT_DR_CCG_Quota__c&gt;0),
AND(OR(ISBLANK(TEXT(CPT_DR_DCAI_Assigned__c)),Text(CPT_DR_DCAI_Assigned__c)=&apos;0%&apos;), CPT_DR_DCAI_Quota__c&gt;0),
AND(OR(ISBLANK(TEXT(CPT_DR_AXG_Assigned__c)),Text(CPT_DR_AXG_Assigned__c)=&apos;0%&apos;), CPT_DR_AXG_Quota__c&gt;0),
AND(OR(ISBLANK(TEXT(CPT_DR_NEX_Assigned__c)),Text(CPT_DR_NEX_Assigned__c)=&apos;0%&apos;), CPT_DR_NEX_Quota__c&gt;0),



AND(Text(CPT_DR_CCG_Assigned__c)&lt;&gt;&apos;0%&apos;, TEXT(CPT_DR_CCG_Assigned__c)&lt;&gt;&apos;&apos;, CPT_DR_CCG_Quota__c&lt;=0),
AND(Text(CPT_DR_DCAI_Assigned__c)&lt;&gt;&apos;0%&apos;, TEXT(CPT_DR_DCAI_Assigned__c)&lt;&gt;&apos;&apos;, CPT_DR_DCAI_Quota__c&lt;=0),
AND(Text(CPT_DR_AXG_Assigned__c)&lt;&gt;&apos;0%&apos;, TEXT(CPT_DR_AXG_Assigned__c)&lt;&gt;&apos;&apos;, CPT_DR_AXG_Quota__c&lt;=0),
AND(Text(CPT_DR_NEX_Assigned__c)&lt;&gt;&apos;0%&apos;, TEXT(CPT_DR_NEX_Assigned__c)&lt;&gt;&apos;&apos;, CPT_DR_NEX_Quota__c&lt;=0),


CPT_DR_Allocated__c&lt;&gt;CPT_DR_Allowed__c 
)

)</errorConditionFormula>
        <errorMessage>Please complete Deal Win Revenue Assigned % and Quota.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Ensure_Sales_OKR_Objective2_Filled</fullName>
        <active>true</active>
        <description>Sales OKR Objective 2 cannot be completed until Sales OKR Objective 1 is completed.</description>
        <errorConditionFormula>AND(
  ISBLANK(CPT_Sales_OKR_Objective1__c),
  NOT(ISBLANK(CPT_Sales_OKR_Objective2__c))
)</errorConditionFormula>
        <errorDisplayField>CPT_Sales_OKR_Objective2__c</errorDisplayField>
        <errorMessage>Sales OKR Objective 2 cannot be completed until Sales OKR Objective 1 is completed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Ensure_Sales_OKR_Objective3_Editable</fullName>
        <active>true</active>
        <description>The Sales OKR Objective 3 cannot be completed until Sales OKR Objectives 1 and 2 are completed.</description>
        <errorConditionFormula>AND(
  OR(
    ISBLANK(CPT_Sales_OKR_Objective1__c),
    ISBLANK(CPT_Sales_OKR_Objective2__c)
  ),
  NOT(ISBLANK(CPT_Sales_OKR_Objective3__c))
)</errorConditionFormula>
        <errorDisplayField>CPT_Sales_OKR_Objective3__c</errorDisplayField>
        <errorMessage>The Sales OKR Objective 3 cannot be completed until Sales OKR Objectives 1 and 2 are completed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Ensure_Sales_OKR_Objective_Filled</fullName>
        <active>true</active>
        <description>Ensures that at least one of the Sales OKR Objective field is filled out before marking the stage to completed.</description>
        <errorConditionFormula>AND(
 (CPT_Sales_OKR_Allowed__c&lt;&gt;0),
  ISPICKVAL(CPT_Stage__c, &quot;Completed&quot;),
  ISBLANK(CPT_Sales_OKR_Objective1__c),
  ISBLANK(CPT_Sales_OKR_Objective2__c),
  ISBLANK(CPT_Sales_OKR_Objective3__c)
)</errorConditionFormula>
        <errorDisplayField>CPT_Sales_OKR_Objective1__c</errorDisplayField>
        <errorMessage>You must fill in at least one Sales OKR Objective before marking the stage as Completed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_OKR_Prevent_Excess_Allocation</fullName>
        <active>true</active>
        <description>Prevent over allocation of Sales OKR</description>
        <errorConditionFormula>CPT_Sales_OKR_Allocated__c &gt; CPT_Sales_OKR_Allowed__c</errorConditionFormula>
        <errorMessage>Sales OKR % Assigned is greater than allowed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_OKR_Prevent_Incomplete_Data_Update</fullName>
        <active>true</active>
        <description>Enforce Sales OKR assignment and quota is complete</description>
        <errorConditionFormula>AND(
    ISPICKVAL(CPT_Stage__c, &apos;Completed&apos;),

    OR(
        CPT_Sales_OKR_Allocated__c&lt;&gt;CPT_Sales_OKR_Allowed__c
    )
)</errorConditionFormula>
        <errorMessage>Please complete Sales OKR Selection, Assigned %, and Quota.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Plan_Specific_Field_Restriction</fullName>
        <active>true</active>
        <description>This validation rule ensures that percentage value for selected plans (301, 601 or 801), users can select a restricted percentage value in only one field at a time.</description>
        <errorConditionFormula>OR( 
/* Plan 301 - Prevent any invalid combinations (treat 0% as empty) */ 

AND( ISPICKVAL(CPT_Plan__c, &quot;301&quot;), 
OR( 
/* Both OEM and Partner have non-zero values */ 
AND( NOT(OR(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;&quot;), ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;0%&quot;))), NOT(OR(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;&quot;), ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;0%&quot;))) ), 
/* Retail has any non-zero value */ 
NOT(OR(ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;&quot;), ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;0%&quot;))), 
/* OEM has non-zero value but not 50% */ 
AND( NOT(OR(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;&quot;), ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;0%&quot;))), NOT(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;50%&quot;)) ), 
/* Partner has non-zero value but not 50% */ 
AND( NOT(OR(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;&quot;), ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;0%&quot;))), NOT(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;50%&quot;)) ) ) ), 

/* Plans 601 &amp; 801 - Similar logic for 70% */ 

AND( OR( ISPICKVAL(CPT_Plan__c, &quot;601&quot;), ISPICKVAL(CPT_Plan__c, &quot;801&quot;) ), 
OR( 
/* Multiple fields have 70% */ 
AND(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;70%&quot;), ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;70%&quot;)), AND(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;70%&quot;), ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;70%&quot;)), AND(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;70%&quot;), ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;70%&quot;)), 
/* Any field has non-zero value but not 70% */ 
AND( NOT(OR(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;&quot;), ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;0%&quot;))), NOT(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;70%&quot;)) ), AND( NOT(OR(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;&quot;), ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;0%&quot;))), NOT(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;70%&quot;)) ), AND( NOT(OR(ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;&quot;), ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;0%&quot;))), NOT(ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;70%&quot;)) ) ) ) 
)</errorConditionFormula>
        <errorMessage>Invalid assignment: Check plan-specific percentage restrictions.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_Employee_Lookup_Update</fullName>
        <active>true</active>
        <description>You cannot change the employee here. To add a new employee, please go to Quota Setup and select &quot;New.&quot;</description>
        <errorConditionFormula>ISCHANGED( CPT_Employee__c )</errorConditionFormula>
        <errorDisplayField>CPT_Employee__c</errorDisplayField>
        <errorMessage>You cannot change the employee here. To add a new employee, please go to Quota Setup and select &quot;New.&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_Null_Stage_Update</fullName>
        <active>true</active>
        <description>Enforce Stage field has a value</description>
        <errorConditionFormula>ISPICKVAL(CPT_Stage__c, &apos;&apos;)</errorConditionFormula>
        <errorMessage>Please update the Stage value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_OKR_Changes_When_Completed</fullName>
        <active>true</active>
        <description>This validation rule prevents users from modifying any Objective and KPI Name fields when the stage is set to &quot;Completed&quot;.</description>
        <errorConditionFormula>AND( ISPICKVAL(CPT_Stage__c, &quot;Completed&quot;), OR( ISCHANGED(CPT_Sales_OKR_Objective1__c), ISCHANGED(CPT_Sales_OKR_Objective2__c), ISCHANGED(CPT_Sales_OKR_Objective3__c), ISCHANGED(CPT_KPI_Name1__c), ISCHANGED(CPT_KPI_Name2__c), ISCHANGED(CPT_KPI_Name3__c) ) )</errorConditionFormula>
        <errorMessage>Objective and KPI Name fields cannot be modified when Stage is &quot;Completed&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_more_than_100_for_240</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(CPT_Plan__c, &quot;240&quot;),
    OR(
        
        AND(
            NOT(ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;0%&quot;)),
            NOT(ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;100%&quot;))
        ),
        AND(
            NOT(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;0%&quot;)),
            NOT(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;100%&quot;))
        )
    )
)</errorConditionFormula>
        <errorMessage>For Plan 240, exactly one of Retail, or Partner Assigned % must be 100%, and the remaining one must be 0%.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_more_than_20_for_120</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(CPT_Plan__c, &quot;120&quot;),
    OR(
        AND(
            NOT(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;0%&quot;)),
            NOT(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;20%&quot;))
        ),
        AND(
            NOT(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;0%&quot;)),
            NOT(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;20%&quot;))
        )
    )
)</errorConditionFormula>
        <errorMessage>For Plan 120, exactly one of OEM or Partner Assigned % must be 20%, and the remaining one must be 0%.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_more_than_40_for_122</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(CPT_Plan__c, &quot;122&quot;),
    OR(
        AND(
            NOT(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;0%&quot;)),
            NOT(ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;40%&quot;))
        ),
        AND(
            NOT(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;0%&quot;)),
            NOT(ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;40%&quot;))
        )
    )
)</errorConditionFormula>
        <errorMessage>For Plan 122, exactly one of OEM or Partner Assigned % must be 40%, and the remaining one must be 0%.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_STG_Prevent_Incomplete_Data_Update</fullName>
        <active>true</active>
        <description>Enforce Sales Team Goal assignment</description>
        <errorConditionFormula>AND(
ISPICKVAL(CPT_Stage__c, &apos;Completed&apos;),
CPT_Sales_Team_Goal_Allowed__c &gt; 0,
ISBLANK(TEXT(CPT_Sales_Team_Goal__c))
)</errorConditionFormula>
        <errorMessage>Please complete the Sales Team Goal Selection.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MarVol_Checkbox_And_Quota_Alignment</fullName>
        <active>false</active>
        <description>This validation rule ensures mutual dependency between checkbox fields and their corresponding quota fields. If a quota value &gt; 0 exists, the corresponding checkbox must be selected. If a checkbox is selected, the corresponding quota value must be &gt; 0.</description>
        <errorConditionFormula>AND( ISPICKVAL(CPT_Stage__c, &apos;Completed&apos;), OR( AND(NOT(CPT_MarVol_Margin_CCG__c), CPT_MarVol_Margin_CCG_Quota__c &gt; 0), AND(NOT(CPT_MarVol_Margin_DCG__c), CPT_MarVol_Margin_DCG_Quota__c &gt; 0), AND(NOT(CPT_MarVol_NextGen_CCG_LNL__c), CPT_MarVol_NextGen_CCG_LNL_Quota__c &gt; 0), AND(NOT(CPT_MarVol_NextGen_CCG_PTL__c), CPT_MarVol_NextGen_CCG_PTL_Quota__c &gt; 0), AND(NOT(CPT_MarVol_NextGen_CCG_WCL__c), CPT_MarVol_NextGen_CCG_WCL_Quota__c &gt; 0), AND(NOT(CPT_MarVol_NextGen_DCG_GNR__c), CPT_MarVol_NextGen_DCG_GNR_Quota__c &gt; 0),AND(CPT_MarVol_Margin_CCG__c, CPT_MarVol_Margin_CCG_Quota__c &lt;= 0), AND(CPT_MarVol_Margin_DCG__c, CPT_MarVol_Margin_DCG_Quota__c &lt;= 0), AND(CPT_MarVol_NextGen_CCG_LNL__c, CPT_MarVol_NextGen_CCG_LNL_Quota__c &lt;= 0), AND(CPT_MarVol_NextGen_CCG_PTL__c, CPT_MarVol_NextGen_CCG_PTL_Quota__c &lt;= 0), AND(CPT_MarVol_NextGen_CCG_WCL__c, CPT_MarVol_NextGen_CCG_WCL_Quota__c &lt;= 0), AND(CPT_MarVol_NextGen_DCG_GNR__c, CPT_MarVol_NextGen_DCG_GNR_Quota__c &lt;= 0), CPT_MarVol_Allocated__c &lt;&gt; CPT_MarVol_Allowed__c ) )</errorConditionFormula>
        <errorDisplayField>CPT_Account_Breakout__c</errorDisplayField>
        <errorMessage>MarginVolume sub-element checkbox must be selected when corresponding quota has a value greater than 0. Unselect the MarginVolume sub-element checkbox if respective Quota value is 0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Objective_KPI_Alignment</fullName>
        <active>true</active>
        <description>This rule ensures that the corresponding KPI field is filled when an objective is filled.</description>
        <errorConditionFormula>OR( 
AND(NOT(ISBLANK(CPT_Sales_OKR_Objective1__c)), ISPICKVAL(CPT_KPI_Name1__c, &quot;&quot;)), 
AND(NOT(ISBLANK(CPT_Sales_OKR_Objective2__c)), ISPICKVAL(CPT_KPI_Name2__c, &quot;&quot;)), 
AND(NOT(ISBLANK(CPT_Sales_OKR_Objective3__c)), ISPICKVAL(CPT_KPI_Name3__c, &quot;&quot;)),
AND(NOT(ISPICKVAL(CPT_KPI_Name1__c, &quot;&quot;)), ISBLANK(CPT_Sales_OKR_Objective1__c)),
AND(NOT(ISPICKVAL(CPT_KPI_Name2__c, &quot;&quot;)), ISBLANK(CPT_Sales_OKR_Objective2__c)),
AND(NOT(ISPICKVAL(CPT_KPI_Name3__c, &quot;&quot;)), ISBLANK(CPT_Sales_OKR_Objective3__c))
)</errorConditionFormula>
        <errorMessage>Please fill the corresponding Objective/KPI field.
(Example: Sales OKR Objective 1 &lt;=&gt; KPI Name 1)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pair_CCG_Volume_and_Margin</fullName>
        <active>true</active>
        <description>This validation rule ensures Margin CCG and at least one NextGen CCG field (WCL, PTL, LNL) are selected together - mutual dependency required.</description>
        <errorConditionFormula>OR( 
AND( CPT_MarVol_Margin_CCG__c, NOT(OR( CPT_MarVol_NextGen_CCG_WCL__c, CPT_MarVol_NextGen_CCG_PTL__c, CPT_MarVol_NextGen_CCG_LNL__c )) ), 
AND( OR( CPT_MarVol_NextGen_CCG_WCL__c, CPT_MarVol_NextGen_CCG_PTL__c, CPT_MarVol_NextGen_CCG_LNL__c ), NOT(CPT_MarVol_Margin_CCG__c) ) 
)</errorConditionFormula>
        <errorMessage>Margin CCG and Volume CCG (LNL/PTL/WCL) must be selected together - if one is selected, the other is required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pair_DCG_Volume_and_Margin</fullName>
        <active>true</active>
        <description>This validation rule ensures mutual dependency between CPT_MarVol_NextGen_DCG_GNR and CPT_MarVol_Margin_DCG fields. If one is selected, the other must also be selected, and vice versa.</description>
        <errorConditionFormula>OR( AND(CPT_MarVol_NextGen_DCG_GNR__c, NOT(CPT_MarVol_Margin_DCG__c)), AND(CPT_MarVol_Margin_DCG__c, NOT(CPT_MarVol_NextGen_DCG_GNR__c)) )</errorConditionFormula>
        <errorMessage>Volume DCG and Margin DCG must both be selected together.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_33_for_Plans_other_than_640</fullName>
        <active>true</active>
        <description>33.333 and 33.334 percent can only be selected for Plan 640</description>
        <errorConditionFormula>AND(
NOT(ISPICKVAL(CPT_Plan__c, &quot;640&quot;)),
OR(
ISPICKVAL(CPT_BR_All_Assigned__c, &quot;33.333%&quot;), ISPICKVAL(CPT_BR_CCG_Assigned__c, &quot;33.333%&quot;), ISPICKVAL(CPT_BR_DCAI_Assigned__c, &quot;33.333%&quot;),
ISPICKVAL(CPT_BR_All_Assigned__c, &quot;33.334%&quot;), ISPICKVAL(CPT_BR_CCG_Assigned__c, &quot;33.334%&quot;), ISPICKVAL(CPT_BR_DCAI_Assigned__c, &quot;33.334%&quot;),
ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;33.333%&quot;), ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;33.333%&quot;), ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;33.333%&quot;),
ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;33.334%&quot;), ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;33.334%&quot;), ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;33.334%&quot;), 
ISPICKVAL(CPT_Wins_Deal_Assigned__c, &quot;33.333%&quot;), ISPICKVAL(CPT_Wins_Design_Assigned__c, &quot;33.333%&quot;),
ISPICKVAL(CPT_Wins_Deal_Assigned__c, &quot;33.334%&quot;), ISPICKVAL(CPT_Wins_Design_Assigned__c, &quot;33.334%&quot;)) 
)</errorConditionFormula>
        <errorMessage>33.333 and 33.334 percent can be selected only for 640 Plan</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_5_Percent_For_Plan_602_802</fullName>
        <active>false</active>
        <description>This validation rule prevents users from selecting 5% in the OEM/Retail/Partner % Assigned field under CR when Plan is 602 or 802.</description>
        <errorConditionFormula>AND( 
OR( 
ISPICKVAL(CPT_Plan__c, &quot;602&quot;), ISPICKVAL(CPT_Plan__c, &quot;802&quot;) 
), 
OR(
ISPICKVAL(CPT_CR_Retail_Assigned__c, &quot;5%&quot;), ISPICKVAL(CPT_CR_OEM_Assigned__c, &quot;5%&quot;), ISPICKVAL(CPT_CR_Partner_Assigned__c, &quot;5%&quot;) )
)</errorConditionFormula>
        <errorMessage>Minimum 10% is allowed on CR Subelements for the selected plan.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sequential_KPI_Entry</fullName>
        <active>true</active>
        <description>This rule ensure that the KPI fields are filled in a sequence.</description>
        <errorConditionFormula>OR( 
AND(NOT(ISPICKVAL(CPT_KPI_Name2__c, &quot;&quot;)), ISPICKVAL(CPT_KPI_Name1__c, &quot;&quot;)), 
AND(NOT(ISPICKVAL(CPT_KPI_Name3__c, &quot;&quot;)), ISPICKVAL(CPT_KPI_Name2__c, &quot;&quot;)) 
)</errorConditionFormula>
        <errorMessage>KPIs must be selected sequentially. Please select KPI 1 before KPI 2 and KPI 2 before KPI 3.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
