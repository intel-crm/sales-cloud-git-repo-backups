        <label>CPT Quota Setup Compact Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>A Quota Setup Record is created for each Commissionable Employee for a given Quota Period. This is where the Manager will enter the Assignments and Quota Numbers for their Employees.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>CPT_Account_Breakout__c</fullName>
        <description>It&apos;s used for &quot;DCAI Sapphire Rapids Billings Volume&quot; and &quot;Sapphire Rapids Next Wave &amp; Comms Consumption Volume&quot; Sales OKRs</description>
        <inlineHelpText>List Account(s) assignment for “DCAI Sapphire Rapids Billings Volume #” Sales OKR.</inlineHelpText>
        <label>Account Breakout</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
