    <fields>
        <fullName>CPT_Complete__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Manager will check this box when planning is completed. Validation rule will check for the completeness of the data when this checkbox is selected.</description>
        <inlineHelpText>If checked, system will validate the completeness of the data while updates are saved.</inlineHelpText>
        <label>Complete</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CPT_Effective_End__c</fullName>
        <description>Effective end formula field to derive end date for the setup.[10-Dec-25]</description>
        <formula>CASE(
    LEFT(TEXT(CPT_Effective_Month__c), 3),
    &quot;Jan&quot;, DATE(2027, 12, 31),
    &quot;Feb&quot;, DATE(2027, 12, 31),
    &quot;Mar&quot;, DATE(2027, 12, 31),
    &quot;Apr&quot;, DATE(2027, 12, 31),
    &quot;May&quot;, DATE(2027, 12, 31),
    &quot;Jun&quot;, DATE(2027, 12, 31),
    &quot;Jul&quot;, DATE(2027, 12, 31),
    &quot;Aug&quot;, DATE(2027, 12, 31),
    &quot;Sep&quot;, DATE(2027, 12, 31),
    &quot;Oct&quot;, DATE(2027, 12, 31),
    &quot;Nov&quot;, DATE(2027, 12, 31),
    &quot;Dec&quot;, DATE(2027, 12, 31),
    DATE(2027, 12, 31)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Effective_End</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
