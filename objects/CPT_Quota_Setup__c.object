    <fields>
        <fullName>CPT_Sales_Team__c</fullName>
        <externalId>false</externalId>
        <formula>CPT_Employee__r.CPT_Sales_Team__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sales Team</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Stage__c</fullName>
        <label>Stage</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>In-Progress</fullName>
                    <default>true</default>
                    <label>In-Progress</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>CPT_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF( TEXT(CPT_Stage__c) == &apos;In-Progress&apos;, IMAGE(&quot;/img/samples/color_yellow.gif&quot;, &quot;In-Progress&quot;,20,50),
IF( TEXT(CPT_Stage__c) == &apos;Completed&apos;, IMAGE(&quot;/img/samples/color_green.gif&quot;, &quot;Completed&quot;,20,50),
IMAGE(&quot;/img/samples/color_red.gif&quot;, &quot;Pending&quot;,20,50)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Total_Allocated__c</fullName>
        <formula>CPT_BR_Allocated__c + CPT_CR_Allocated__c + CPT_Wins_Allocated__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total (Allocated)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>CPT_Total_Assigned__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(CPT_Total_Allocated__c*100) &amp; &quot;/100%&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total (% Assigned)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Unique_Identifier__c</fullName>
        <caseSensitive>true</caseSensitive>
        <description>Unique Identifier to prevent duplicates for a given combination of Quota Period and Employee. The format of this field is: Quota Period Id - Employee Id.</description>
        <externalId>false</externalId>
        <label>Unique Identifier</label>
        <length>40</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>CPT_Wins_Allocated__c</fullName>
        <formula>(VALUE( SUBSTITUTE(TEXT( CPT_Wins_Deal_Assigned__c ), &apos;%&apos;, &apos;&apos;)) +
VALUE( SUBSTITUTE(TEXT( CPT_Wins_Design_Assigned__c), &apos;%&apos;, &apos;&apos;)) 
)/100</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>PfR (Allocated)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>CPT_Wins_Allowed__c</fullName>
        <formula>VALUE(SUBSTITUTE(TEXT(CPT_Employee__r.CPT_Sales_Compensation_Plan__r.CPT_Percent_Wins_Revenue__c), &apos;%&apos;, &apos;&apos;))/100</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>PfR (Allowed)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>CPT_Wins_Assigned__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(CPT_Wins_Allocated__c*100) &amp; &quot;/&quot; &amp; TEXT(CPT_Wins_Allowed__c*100) &amp; &quot;%&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>PfR (% Assigned)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Wins_Deal_Assigned__c</fullName>
        <label>PfR - Deal Wins % Assigned</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>CPT_Percentage_Picklist</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>CPT_Wins_Deal_Quota__c</fullName>
        <label>Wins - Deal Quota</label>
        <summarizedField>CPT_Territory_Assignment__c.CPT_Wins_Deal_Target__c</summarizedField>
        <summaryForeignKey>CPT_Territory_Assignment__c.CPT_Quota_Setup__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>CPT_Wins_Design_Assigned__c</fullName>
        <label>PfR - Design Wins % Assigned</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>CPT_Percentage_Picklist</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>CPT_Wins_Design_Quota__c</fullName>
        <label>Wins - Design Quota</label>
        <summarizedField>CPT_Territory_Assignment__c.CPT_Wins_Design_Target__c</summarizedField>
        <summaryForeignKey>CPT_Territory_Assignment__c.CPT_Quota_Setup__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>XX_CPT_Complete__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Manager will check this box when planning is completed. Validation rule will check for the completeness of the data when this checkbox is selected.</description>
        <inlineHelpText>If checked, system will validate the completeness of the data while updates are saved.</inlineHelpText>
        <label>XX_Complete</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
