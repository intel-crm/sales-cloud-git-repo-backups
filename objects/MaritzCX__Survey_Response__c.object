    <webLinks>
        <fullName>MaritzCX__Dashboard</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Dashboard</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>var recordId=&apos;&apos;;
var pageName=&apos;&apos;;
if(&apos;{!JSENCODE(Contact.Id)}&apos;!=&apos;&apos;){
recordId=&apos;{!JSENCODE(Contact.Id)}&apos;;
pageName=&apos;visualizations&apos;;
}else if(&apos;{!JSENCODE(Account.Id)}&apos;!=&apos;&apos;){
recordId=&apos;{!JSENCODE(Account.Id)}&apos;;
pageName=&apos;VisualizationOnAccount&apos;;
}
if(recordId != &apos;&apos; &amp;&amp; pageName != &apos;&apos;){
var screenWidth = window.screen.width;
var screenHeight = window.screen.height;
var windowWidth = screenWidth * (0.825);
var adjScrWidth;
var adjScrHeight;
adjScrWidth = (screenWidth / 2) - (windowWidth / 2);
adjScrHeight = (screenHeight / 2) - (275);
var reportWindow = window.open(&apos;/apex/&apos;+&apos;{!$Setup.MaritzCX__AlPublic__c.MaritzCX__NamespacePrefix__c}&apos;+&apos;__&apos;+pageName+&apos;?id=&apos;+recordId, &apos;Dashboard&apos;, &apos;status=no,height=360,width=&apos;+windowWidth+&apos;,resizable=0,left=&apos; + adjScrWidth + &apos;,top=&apos; + adjScrHeight + &apos;,screenX=&apos; + adjScrWidth + &apos;,screenY=&apos; + adjScrHeight + &apos;,toolbar=no,menubar=no,scrollbars=0,location=no,directories=no,titlebar=no,menubar=no&apos;);
    reportWindow.focus();
}</url>
    </webLinks>
    <webLinks>
        <fullName>MaritzCX__View_Response</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <linkType>javascript</linkType>
        <masterLabel>View Response</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>var responseId = &apos;{!JSENCODE(TEXT( MaritzCX__Survey_Response__c.MaritzCX__ALG_Response_Id__c ))}&apos;;
if(responseId!== &apos;&apos;){
var namespace = &apos;{!JSENCODE($Setup.MaritzCX__AlPublic__c.MaritzCX__NamespacePrefix__c)}&apos;;
var adjScrWidth = (window.screen.width / 2) - (250);
var adjScrHeight = (window.screen.height / 2) - (275);
namespace = namespace === &apos;&apos; ? namespace : namespace + &apos;__&apos; ;
var url = &apos;/apex/&apos; + namespace + &apos;DisplayResponseView?ResponseId=&apos; + responseId ;
var options = &apos;status=no,&apos;
		  + &apos;height=550,&apos;
		  + &apos;width=500,&apos;
		  + &apos;resizable=yes,&apos;
		  + &apos;left=&apos; + adjScrWidth + &apos;,&apos; 
		  + &apos;top=&apos; + adjScrHeight + &apos;,&apos; 
		  + &apos;screenX=&apos; + adjScrWidth + &apos;,&apos;
		  + &apos;screenY=&apos; + adjScrHeight + &apos;,&apos;
		  + &apos;toolbar=no,&apos;
		  + &apos;menubar=no,&apos;
		  + &apos;scrollbars=1,&apos;
		  + &apos;location=no,&apos;
		  + &apos;directories=no,&apos;
		  + &apos;titlebar=no,&apos; 
		  + &apos;menubar=no&apos;;
var win2 = window.open(url ,&apos;Response&apos;, options);
win2.focus();
}
else {
    alert(&apos;No record to display&apos;);
}</url>
    </webLinks>
