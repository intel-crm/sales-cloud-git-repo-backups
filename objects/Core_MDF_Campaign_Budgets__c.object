                    <default>false</default>
                    <label>65%</label>
                </value>
                <value>
                    <fullName>70%</fullName>
                    <default>false</default>
                    <label>70%</label>
                </value>
                <value>
                    <fullName>75%</fullName>
                    <default>false</default>
                    <label>75%</label>
                </value>
                <value>
                    <fullName>80%</fullName>
                    <default>false</default>
                    <label>80%</label>
                </value>
                <value>
                    <fullName>85%</fullName>
                    <default>false</default>
                    <label>85%</label>
                </value>
                <value>
                    <fullName>90%</fullName>
                    <default>false</default>
                    <label>90%</label>
                </value>
                <value>
                    <fullName>95%</fullName>
                    <default>false</default>
                    <label>95%</label>
                </value>
                <value>
                    <fullName>100%</fullName>
                    <default>false</default>
                    <label>100%</label>
                </value>
                <value>
                    <fullName>0%</fullName>
                    <default>false</default>
                    <label>0%</label>
                </value>
                <value>
                    <fullName>82%</fullName>
                    <default>false</default>
                    <label>82%</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Start_Date_Dt__c</fullName>
        <description>Stores the Start Date of the Budget</description>
        <formula>Core_MDF_Budget_Name_Id__r.StartDate</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <label>Campaign Budgets</label>
    <nameField>
        <displayFormat>Campaign Budgets - {00000}</displayFormat>
        <label>Campaign Budgets Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Campaign Budgets</pluralLabel>
    <searchLayouts/>
