    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores available budgets for the Campaign based on Budget type</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Active_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Available_Budget_Amount__c</fullName>
        <formula>Core_MDF_Budget_Name_Id__r.TotalAllocatedAmount  - Core_MDF_Consumed_Budget_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Available Budget Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Amt__c</fullName>
        <description>Stores the Budget Amount planned for the Campaign for the selected Budget</description>
        <label>Campaign Spending Limit (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Name_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup to the Budget record</description>
        <label>Budget Name</label>
        <referenceTo>PartnerMarketingBudget</referenceTo>
        <relationshipLabel>Campaign Budgets</relationshipLabel>
        <relationshipName>Campaign_Budgets</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Type_Nm__c</fullName>
        <description>Stores the Budget Type of the Campaign</description>
        <externalId>false</externalId>
        <formula>TEXT(Core_MDF_Budget_Name_Id__r.Core_MDF_Budget_Type_Txt__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Budget Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Campaign_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup to Campaign</description>
        <label>Campaign</label>
        <referenceTo>Campaign</referenceTo>
        <relationshipLabel>Campaign Budgets</relationshipLabel>
        <relationshipName>Campaign_Budgets</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Consumed_Budget_Amount__c</fullName>
        <formula>Core_MDF_Budget_Name_Id__r.TotalApprovedFrs</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Consumed Budget Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_End_Date_Dt__c</fullName>
        <description>Stores the End Date of the Budget</description>
        <formula>Core_MDF_Budget_Name_Id__r.EndDate</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Reimbursement_Amt__c</fullName>
        <description>Stores the Reimbursement Amount for the Campaign Budget based on the Reimbursement Rate</description>
        <label>Campaign Intel Contribution (USD)</label>
        <precision>18</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Reimbursement_Rate_Pct__c</fullName>
        <description>Stores the Reimbursement rate for the Campaign Budget</description>
        <label>Reimbursement Rate</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>25%</fullName>
                    <default>false</default>
                    <label>25%</label>
                </value>
                <value>
                    <fullName>50%</fullName>
                    <default>false</default>
                    <label>50%</label>
                </value>
                <value>
