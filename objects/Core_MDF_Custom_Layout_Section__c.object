    <label>Custom Layout Section</label>
    <nameField>
        <displayFormat>CLS-{0000}</displayFormat>
        <label>Custom Layout Section Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
