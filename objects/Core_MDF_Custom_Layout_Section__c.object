    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_CompactLayoutHideNotAllowed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  ISPICKVAL(Core_MDF_Field_View_nm__c,&quot;Compact Layout&quot;),
    Core_MDF_Hide_If_No_Value_Ind__c = TRUE

)</errorConditionFormula>
        <errorMessage>You cannot enable &apos;Hide If No Value&apos; when the field view is set to &apos;Compact Layout&apos;. Please choose a different layout or disable &apos;Hide If No Value&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_FieldViewDetailLayoutValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(Core_MDF_ButtonsVisibilityOnStatus_txt__c )), ISPICKVAL( Core_MDF_Field_View_nm__c , &apos;Detail Layout&apos;))</errorConditionFormula>
        <errorMessage>Buttons Visibility Based On Status should be blank for Detail Layout Field View</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
