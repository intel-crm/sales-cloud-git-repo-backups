    <fields>
        <fullName>Core_MDF_ButtonVisibilityByProfile_txt__c</fullName>
        <inlineHelpText>Value should be in JSON format.
Ex: [{&quot;profileName&quot; : &quot;System Administrator&quot;, &quot;controllingFieldValueBasedOnPs&quot;: [{&quot;controllingFieldValue&quot;:&quot;Draft&quot;,&quot;buttons&quot;:[&quot;Edit&quot;, &quot;Clone&quot;, &quot;Cancel Campaign&quot;, &quot;Create Activity&quot;]},{&quot;controllingFieldValue&quot;:&quot;Cancelled&quot;,&quot;buttons&quot;:[&quot;Clone&quot;]},{&quot;controllingFieldValue&quot;:&quot;Revision Required&quot;,&quot;buttons&quot;:[&quot;Edit&quot;, &quot;Clone&quot;, &quot;Cancel Campaign&quot;, &quot;Submit For Approval&quot;, &quot;Create Activity&quot;]}]}]</inlineHelpText>
        <label>Buttons Visibility Based On Profile</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_ButtonsVisibilityOnStatus_txt__c</fullName>
