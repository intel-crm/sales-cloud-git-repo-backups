Ex: [{&quot;prmissionSetName&quot; : &quot;Core_MDF_CCP_Internal_IPA_Acct_Mgr&quot;, &quot;controllingFieldValueBasedOnPs&quot;: [{&quot;controllingFieldValue&quot;:&quot;Draft&quot;,&quot;buttons&quot;:[&quot;Edit&quot;, &quot;Clone&quot;, &quot;Cancel Campaign&quot;, &quot;Submit For Approval&quot;, &quot;Create Activity&quot;]},{&quot;controllingFieldValue&quot;:&quot;Cancelled&quot;,&quot;buttons&quot;:[&quot;Clone&quot;]}]}]</inlineHelpText>
