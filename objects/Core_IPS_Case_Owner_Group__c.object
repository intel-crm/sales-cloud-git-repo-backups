    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_IPS_Case_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Case Owner</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 OR 2) AND 3</booleanFilter>
            <filterItems>
                <field>User.UserType</field>
                <operation>equals</operation>
                <value>Standard</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>IPS Agent-Partner</value>
            </filterItems>
            <filterItems>
                <field>User.IsActive</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>Case_Owner_Groups</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Owner_Group_1__c</fullName>
        <externalId>false</externalId>
        <label>Owner Group 1</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Owner_Group_2__c</fullName>
        <externalId>false</externalId>
        <label>Owner Group 2</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Owner_Group_3__c</fullName>
        <externalId>false</externalId>
        <label>Owner Group 3</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Support_Org__c</fullName>
        <label>Support Org</label>
        <referenceTo>Core_IPS_Product_Organization__c</referenceTo>
        <relationshipLabel>Case Owner Groups</relationshipLabel>
        <relationshipName>Case_Owner_Groups</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_IPS_Unique_Owner_Group__c</fullName>
        <caseSensitive>true</caseSensitive>
        <externalId>false</externalId>
        <label>Unique Owner Group</label>
        <length>36</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <label>Case Owner Group</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>COG-{000000}</displayFormat>
        <label>Case Owner Group No</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Case Owner Groups</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Atleast_One_Owner_group_should_be_added</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISBLANK( Core_IPS_Owner_Group_1__c ),
    ISBLANK( Core_IPS_Owner_Group_2__c),
    ISBLANK( Core_IPS_Owner_Group_3__c )
    )</errorConditionFormula>
        <errorMessage>Atleast one Owner Group should be selected</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Case_Owner_selection_is_mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(Core_IPS_Case_Owner__c)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Case_Owner__c</errorDisplayField>
        <errorMessage>Case owner selection is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_Users_Cannot_be_added</fullName>
        <active>false</active>
        <errorConditionFormula>IF(
ISPICKVAL(Core_IPS_Case_Owner__r.UserType , &quot;PowerCustomerSuccess&quot;),
true,false)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Case_Owner__c</errorDisplayField>
        <errorMessage>Customer users cannot be added as Case Owners</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
