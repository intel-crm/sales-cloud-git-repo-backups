<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This metadata will hold the email settings(permission set names, email template name ,etc) for email alerts triggered via apex</description>
    <fields>
        <fullName>NumberOfDays__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>NumberOfDays</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Allowed_Permission_Set__c</fullName>
        <description>Allowed permission sets are comma separated and stored here</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>PMP_Allowed_Permission_Set</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>PMP_Email_Template_Name__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>PMP Email Template Name</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PMP_Object_Subtype__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>PMP Object Subtype</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>PMP Alert To Email Setting</label>
    <pluralLabel>PMP Alert To Email Settings</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
