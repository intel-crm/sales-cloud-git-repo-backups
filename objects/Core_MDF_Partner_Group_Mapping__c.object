        <fullName>Core_MDF_All_Access_Group_Check</fullName>
        <active>false</active>
        <description>All Access Group is applicable for CCF and DCF Program only</description>
        <errorConditionFormula>IF( 
						AND(!ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c,&apos;Client CoMarketing Fund&apos;),
									!ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c,&apos;Data Center CoMarketing Fund&apos;),
									!ISNULL(Core_MDF_All_Access_Group_Nm__c)) , true, false)</errorConditionFormula>
        <errorMessage>All Access Group Name is applicable for CCF and DCF Programs</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_BudgetTypeAccess_Validation</fullName>
        <active>false</active>
        <description>1. Budget Type Access is only applicable for External type of access, Channel MDF Program and Account&apos;s Co-marketing Active true</description>
        <errorConditionFormula>IF(AND(NOT(ISBLANK( Core_MDF_Budget_Type_Access_nm__c )),OR( TEXT( Core_MDF_Type_of_Access__c ) != &apos;External&apos; , NOT(Core_MDF_Account__r.Core_MDF_CoMarketingActive__c))), TRUE,FALSE )</errorConditionFormula>
        <errorMessage>Budget Type Access is not applicable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_PaymentTypeValidation</fullName>
        <active>false</active>
        <description>Distributor (Cash), Distributor (Credit Memo) and Customer (Pass Through) Payment types are only applicable for IPA program</description>
        <errorConditionFormula>AND(NOT(TEXT(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c)==$Label.Core_MDF_IPA_Program_Name),
OR(TEXT(Core_MDF_Payment_Type_nm__c )== &apos;Distributor (Cash)&apos;,TEXT(Core_MDF_Payment_Type_nm__c )== &apos;Distributor (Credit Memo)&apos;,TEXT(Core_MDF_Payment_Type_nm__c )== &apos;Customer (Pass Through)&apos;))</errorConditionFormula>
        <errorMessage>Selected Payment Type is only applicable for Intel Partner Alliance Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PayTypeVal_ForOtherPrograms</fullName>
        <active>false</active>
        <description>Restrict the Payment type selection for programs which does not belong to CCP.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(TEXT(Core_MDF_Payment_Type_nm__c))),AND(
NOT( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_CCF_Program_Name),NOT( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Non_Localized_DCF_Program_Name),
 NOT( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_CCFB_Program_Name), 
 NOT( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_SPCF_Program_Name), 
 NOT( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Retail_Program_Name), 
NOT( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_IPA_Program_Name)))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account__c</errorDisplayField>
        <errorMessage>Payment Type is not applicable for the Selected Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PaymentTypeValidation</fullName>
        <active>false</active>
        <description>Restrict manual creation of PGM  for Agency accounts i.e when co-Marketing active is false</description>
        <errorConditionFormula>AND((TEXT(Core_MDF_Payment_Type_nm__c) != NULL), (TEXT( Core_MDF_Type_of_Access__c ) == $Label.Core_MDF_External_label_for_PGM),  (Core_MDF_CoMarketingActive_Ind__c == FALSE))</errorConditionFormula>
        <errorMessage>Payment Type is not applicable for the Agency Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RequiredAccountIdGroupName</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(Core_MDF_AccountIdGroupName__c)</errorConditionFormula>
        <errorMessage>AccountIdGroupName cannot be blank</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_PGM_Internal_Creation</fullName>
        <active>true</active>
        <description>Internal PGM record creation should be through IUPGM only.</description>
        <errorConditionFormula>AND( 
ISNEW(),
ISPICKVAL(Core_MDF_Type_of_Access__c , &apos;Internal&apos;),
ISPICKVAL(Core_MDF_Source_Txt__c,&apos;Others&apos;),
NOT(CONTAINS($Label.Core_MDF_UserIdAllowedToUpdatePGM, ($User.FirstName +&apos; &apos;+ $User.LastName)))
)</errorConditionFormula>
        <errorMessage>Please use IUPGM for Internal PGM record creation.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Update_EXT_PGM_Fields</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT(CONTAINS($Label.Core_MDF_UserIdAllowedToUpdatePGM, ($User.FirstName +&apos; &apos;+ $User.LastName))),ISPICKVAL(Core_MDF_Type_of_Access__c, &apos;External&apos;),
OR(ISNEW(),
OR(ISCHANGED( Core_MDF_Region_cd__c),ISCHANGED(Core_MDF_Sub_Region_cd__c),ISCHANGED(Core_MDF_BudgetType_nm__c ))
),OR((Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_ChannelMDF_Program_Name),
( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_CCF_Program_Name),
( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Non_Localized_DCF_Program_Name),
( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_CCFB_Program_Name),
( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_SPCF_Program_Name),
( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Retail_Program_Name),
( Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_IPA_Program_Name)))</errorConditionFormula>
        <errorMessage>The Region, Sub Region and Budget Type fields are not applicable for External PGM records.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Update_PGM</fullName>
        <active>true</active>
        <description>To block update from users other than System Admin and IT Admin</description>
        <errorConditionFormula>AND(
    NOT(CONTAINS($Label.Core_MDF_UserIdAllowedToUpdatePGM, ($User.FirstName +&apos; &apos;+ $User.LastName))),
	OR( 
		Core_MDF_Channel_Program_Name_Txt__c  == $Label.Core_MDF_CCF_Program_Name,
		Core_MDF_Channel_Program_Name_Txt__c  == $Label.Core_MDF_Non_Localized_DCF_Program_Name,
		Core_MDF_Channel_Program_Name_Txt__c  == $Label.Core_MDF_CCFB_Program_Name,
		Core_MDF_Channel_Program_Name_Txt__c  == $Label.Core_MDF_SPCF_Program_Name,
		Core_MDF_Channel_Program_Name_Txt__c  == $Label.Core_MDF_Retail_Program_Name,
		Core_MDF_Channel_Program_Name_Txt__c  == $Label.Core_MDF_IPA_Program_Name
	),
	OR(
		AND(
	       ISPICKVAL(Core_MDF_Type_of_Access__c, &apos;Internal&apos;),
		   NOT(ISNEW())
		  ),
		AND(
		  ISPICKVAL(Core_MDF_Type_of_Access__c, &apos;External&apos;),
		  ISCHANGED(Core_MDF_Type_of_Access__c)
	  )
	)
)</errorConditionFormula>
        <errorMessage>You do not have access to update PGM.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Group_Name</fullName>
        <active>true</active>
        <description>Check if the entered group name exists.</description>
        <errorConditionFormula>if( Core_MDF_Group_Id__c == null,true,false)</errorConditionFormula>
        <errorMessage>The Group Name entered is not valid.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Virtual_Corp</fullName>
        <active>false</active>
        <errorConditionFormula>AND(Contains($Label.Core_MDF_CCP_Program_Names,Core_MDF_Channel_Program__r.Name),
ISBLANK(Core_MDF_Virtual_Corp_nm__c))</errorConditionFormula>
        <errorMessage>Virtual Corp should not be null for CCP programs</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PGM_Account_name_change_not_allowed</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED(  Core_MDF_Account__c  )</errorConditionFormula>
        <errorMessage>Account Name cannot be changed</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
