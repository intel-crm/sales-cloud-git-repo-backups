        <description>Backend field to indicate whether the Account is Co-Marketing active or not.</description>
        <formula>IF( CONTAINS($Label.Core_MDF_TechnicalProgramName,Text(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c)),
IF(Core_MDF_Virtual_Corp_nm__r.Core_MDF_Parent_Fund_Account__c==Core_MDF_Account__c, Core_MDF_Virtual_Corp_nm__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_CoMarketingActive__c,false), null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Co-Marketing Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
