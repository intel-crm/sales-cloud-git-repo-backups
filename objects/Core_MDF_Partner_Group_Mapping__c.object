    <fields>
        <fullName>PSG_SAP_Distributor_for_ALN__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>SAP Distributor for ALN</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Invalid SAP ALN Distributor  has been selected on PGM Record. Please select a valid SAP ALN Distributor</errorMessage>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Direct Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Direct_Account_Type_Nm__c</field>
                <operation>equals</operation>
                <value>Sold To</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Direct_Account_Active_Ind__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Nielsen_ID__c</field>
                <operation>equals</operation>
                <value>Alt Logistics</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Partner Group Mapping (SAP Distributor for ALN)</relationshipLabel>
        <relationshipName>Partner_Group_Mapping_ALN</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
