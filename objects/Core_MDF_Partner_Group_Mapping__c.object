CONTAINS($Label.Core_MDF_TechnicalProgramName,Text(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c) ),
Core_MDF_Virtual_Corp_nm__r.Core_MDF_Parent_Fund_Account__r.Name,
&apos;&apos;
)</formula>
