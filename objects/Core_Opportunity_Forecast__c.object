    <fields>
        <fullName>Core_Days_Remains__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
OR( 
AND(
Core_Opportunity__r.CloseDate &gt;=  Core_Quarter_Start_Date__c , 
Core_Opportunity__r.CloseDate  &lt;=  Core_Quarter_First_Weekend_Date__c
),
 Core_Opportunity__r.CloseDate &gt; Core_Quarter_End_Date__c
),
 Core_Quarter_First_Weekend_Date__c - (TODAY()-1) , 0
)</formula>
        <inlineHelpText>Days remain to complete first week of Quarter</inlineHelpText>
        <label>Days Remains</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
