    <fields>
        <fullName>PRM_InActive_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Inactive Indicator</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Benefit Group</label>
    <listViews>
        <fullName>ALL</fullName>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>ALL</label>
    </listViews>
    <nameField>
        <label>Benefit Group Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Benefit Groups</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>PRM_Restrict_Inactive_BG_Creation</fullName>
        <active>true</active>
        <description>Validation to prevent inactive Benefit group creation</description>
        <errorConditionFormula>AND ( ISNEW(),  PRM_InActive_Ind__c = TRUE )</errorConditionFormula>
        <errorMessage>Inactive Indicator cannot be set while creating the new Benefit Group record</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
