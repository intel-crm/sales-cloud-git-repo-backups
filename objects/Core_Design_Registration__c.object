        <externalId>false</externalId>
        <formula>IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Partner_Alliance_Program__c, &quot;ATE&quot;), &quot;ATE; &quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Partner_Alliance_Program__c, &quot;CTE&quot;), &quot;CTE; &quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Partner_Alliance_Program__c, &quot;DCG Tier 1-2 CSPs&quot;), &quot;DCG Tier 1-2 CSPs; &quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Partner_Alliance_Program__c, &quot;Intel-Badged Cloud SPs (CSPs)&quot;), &quot;Intel-Badged Cloud SPs (CSPs); &quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Partner_Alliance_Program__c, &quot;ISA Co-Selling&quot;), &quot;ISA Co-Selling; &quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Partner_Alliance_Program__c, &quot;ISA Member&quot;), &quot;ISA Member; &quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Partner_Alliance_Program__c, &quot;PSG Demand Creation - Distribution&quot;), &quot;PSG Demand Creation - Distribution; &quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Partner_Alliance_Program__c, &quot;PSG Demand Creation - Hybrid&quot;), &quot;PSG Demand Creation - Hybrid; &quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Partner_Alliance_Program__c, &quot;PSG Demand Creation - PSG&quot;), &quot;PSG Demand Creation - PSG; &quot;, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is the name of the Intel Program the Distributor is participating in.</inlineHelpText>
