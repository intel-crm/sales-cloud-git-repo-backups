                    <fullName>PSG Design Registration</fullName>
                    <default>false</default>
                    <label>PSG Design Registration</label>
                </value>
                <value>
                    <fullName>Device Builder Registration High</fullName>
                    <default>false</default>
                    <label>Device Builder Registration High</label>
                </value>
                <value>
                    <fullName>Device Builder Registration Low</fullName>
                    <default>false</default>
                    <label>Device Builder Registration Low</label>
                </value>
