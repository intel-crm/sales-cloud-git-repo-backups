NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c, &apos;Re-Submitted&apos;)),
NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c, &apos;Approved&apos;)),
PCC_Registration_Type__c = &apos;Design Registration&apos;,
ISPICKVAL(Core_Product_Group_Nm__c, &apos;Embedded/IOT&apos;),
