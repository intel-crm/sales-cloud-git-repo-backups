                ISBLANK(Core_End_Customer_Country_Subdivision_Nm__c),
                ISPICKVAL(PCC_End_Customer_Country__c, &apos;&apos;),
ISBLANK(Core_End_Customer_Postal_Cd__c)
                
            ),
            FALSE
        )
    ),
NOT( $Permission.PCC_Bypass_Automation ),
NOT(ISPICKVAL(Core_Submission_Type__c,&apos;M2M&apos;))
