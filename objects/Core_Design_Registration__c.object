    <fields>
        <fullName>Core_Design_Registration_Status_Nm__c</fullName>
        <description>The status values which drive the Design Registration through the process.  Valid values are: Submitted, Pre-Approved, Re-Submitted, Approved, Rejected, Abandoned.</description>
        <inlineHelpText>The status indicates that the registration is: Submitted, Pre-Approved, Re-Submitted, Approved, Rejected, or Abandoned.</inlineHelpText>
        <label>Registration Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Submitted</fullName>
                    <default>false</default>
                    <label>Submitted</label>
                </value>
                <value>
                    <fullName>Pre-Approved</fullName>
                    <default>false</default>
                    <label>Precheck Completed</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>Re-Submitted</fullName>
                    <default>false</default>
                    <label>Re-Submitted</label>
                </value>
                <value>
                    <fullName>Abandoned</fullName>
                    <default>false</default>
                    <label>Abandoned</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Design accepted</fullName>
                    <default>false</default>
                    <label>Design in Review</label>
                </value>
                <value>
                    <fullName>Draft</fullName>
                    <default>true</default>
                    <label>Draft</label>
                </value>
                <value>
                    <fullName>Precheck Pending</fullName>
                    <default>false</default>
                    <label>Precheck Pending</label>
                </value>
                <value>
                    <fullName>Deal accepted</fullName>
                    <default>false</default>
                    <label>Deal Accepted for Review</label>
                </value>
                <value>
                    <fullName>Pending with Partner</fullName>
                    <default>false</default>
                    <label>Pending with Partner</label>
                </value>
                <value>
                    <fullName>Expired</fullName>
                    <default>false</default>
                    <label>Expired</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
