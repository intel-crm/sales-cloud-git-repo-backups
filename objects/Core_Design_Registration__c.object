    <fields>
        <fullName>Core_Military_Aerospace_Gvrnmt_Use_Ind__c</fullName>
        <description>This is a flag used to indicate whether this Design is used for more sensitive applications.</description>
        <inlineHelpText>Military, intelligence, nuclear/biochemical, defense, or space (MINDS) USE. Select when items for THIS opportunity are exclusively for MINDS use. Do NOT select when items for this opportunity are for commercial use.</inlineHelpText>
        <label>Are Intel items used for MINDS?</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>esgw</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>esgw</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_My_Accepted_Design_Ind__c</fullName>
        <formula>if(Core_Accepted_By_Id__c = $User.Id, true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>My Accepted Design</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Approver_Nm__c</fullName>
        <description>Manager of the Partner Account Owner. This person will receive the Approval if this design is converted to Opportunity and the Opportunity is submitted for Approval.</description>
        <externalId>false</externalId>
        <formula>Core_Partner_Account_Id__r.Owner.Manager.FirstName + &apos; &apos; + Core_Partner_Account_Id__r.Owner.Manager.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Manager of the Partner Account Owner. This person will receive the Approval if this design is converted to Opportunity and the Opportunity is submitted for Approval.</inlineHelpText>
        <label>Opportunity Approver</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Decision_Dt__c</fullName>
        <description>This is the date by which the Disti expects the End-Customer to confirm they are proceeding with this design.  This is the Anticipated Design Win Date.</description>
        <inlineHelpText>The date by which the end customer will decide whether or not to move forward with the project</inlineHelpText>
        <label>Decision Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This is a reference to the Opportunity record created after the Design Registration approval.</description>
        <inlineHelpText>This is a reference to the Opportunity record created after the Design-Deal Registration approval.</inlineHelpText>
        <label>Opportunity Name</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Design-Deal Registrations</relationshipLabel>
