IF( NOT(ISCHANGED(Core_Opportunity_Decision_Dt__c)) &amp;&amp; $Permission.DDR_PreApprover_Permission &amp;&amp; $Permission.DDR_Internal_Users,False ,True),
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorDisplayField>Core_Opportunity_Decision_Dt__c</errorDisplayField>
