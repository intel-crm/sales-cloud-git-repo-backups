        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Intel_Technical_Owner_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This is the Intel Sales Owner.</description>
        <inlineHelpText>This is the Intel Sales Owner of this Design Registration.</inlineHelpText>
        <label>Intel DR Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Design_Registrations</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Internal_Comment_Txt__c</fullName>
        <description>Comments about this design added by an Intel Sales Owner.  Not visible to Distis.</description>
        <inlineHelpText>Comments about this design added by an Intel Sales Owner (Not visible to Distributor)</inlineHelpText>
        <label>Internal Comments</label>
        <length>20000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Is_End_Customer_Account_Blocked_Ind__c</fullName>
        <formula>IF (Core_End_Customer_Account_Id__c != null, Core_End_Customer_Account_Id__r.Core_Export_Compliance_Block__c, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System Is End Customer Account Blocked</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Is_End_Customer_Account_Covered_Ind__c</fullName>
        <formula>IF (Core_End_Customer_Account_Id__c != null, Core_End_Customer_Account_Id__r.Core_Covered_Account__c, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System Is End Customer Account Covered</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Last_Status_Change_Age_Cnt__c</fullName>
        <externalId>false</externalId>
        <formula>Today() -  Core_Last_Status_Change_Dt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Last Status Change Age</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Last_Status_Change_Dt__c</fullName>
        <description>The latest date when the status changed.</description>
        <label>Last Status Change Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MINDS_Message_Txt__c</fullName>
        <defaultValue>UPPER(&quot;It is the Intel Partner&apos;s responsibility to understand the export, customs, and sanction controls applicable to Intel Partner&apos;s company, project, and product and take all actions necessary to ensure compliance.&quot;)</defaultValue>
        <description>Static MINDS message shown on DDR Create, View and Edit pages for both Internal and External users.</description>
        <externalId>false</externalId>
        <inlineHelpText>IT IS THE INTEL PARTNER&apos;S RESPONSIBILITY TO UNDERSTAND THE EXPORT, CUSTOMS, AND SANCTION CONTROLS APPLICABLE TO INTEL PARTNER&apos;S COMPANY, PROJECT, AND PRODUCT AND TAKE ALL ACTIONS NECESSARY TO ENSURE COMPLIANCE.</inlineHelpText>
        <label>MINDS Message</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
