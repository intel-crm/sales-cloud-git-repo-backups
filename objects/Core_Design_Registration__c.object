    <fields>
        <fullName>PCC_Opportunity_Quote_creation_failed__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Opportunity/Quote creation failed?</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PCC_Partner_Reference_ID__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>The partner&apos;s reference number associated to registration</inlineHelpText>
        <label>External ID</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PCC_Pricing_End_Date__c</fullName>
        <inlineHelpText>The requested end date of the quote and the last date consumption can happen. The Pricing End Date must be after the Pricing Start Date.</inlineHelpText>
        <label>Pricing End Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PCC_Pricing_Start_Date__c</fullName>
        <inlineHelpText>The request date on which the quote goes into effect and consumption of the product can begin. The Pricing Start Date must be after the Decision Date.</inlineHelpText>
        <label>Pricing Start Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PCC_Proposal_Due_Date__c</fullName>
        <inlineHelpText>The date the proposal is due to the end customer. Must be before Decision Date</inlineHelpText>
        <label>Proposal Due Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PCC_Record_Type__c</fullName>
        <description>Check the record type make read only field</description>
        <externalId>false</externalId>
        <formula>RecordType.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Record Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PCC_Registration_Type__c</fullName>
        <description>Check the registration type</description>
        <externalId>false</externalId>
        <formula>IF(
    CONTAINS(RecordType.DeveloperName,&quot;Deal&quot;) , &quot;Deal Registration&quot;,  &quot;Design Registration&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Registration Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PCC_Rejected_or_Cancelled_Product__c</fullName>
        <description>Count of Design Products that are Rejected or Cancelled</description>
        <label>System Rejected or Cancelled Product</label>
        <summaryFilterItems>
            <field>Core_Design_Registration_Product__c.Core_Design_Product_Status_Nm__c</field>
            <operation>equals</operation>
            <value>Rejected, Cancelled</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_Design_Registration_Product__c.Core_Design_Registration_Id__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>PCC_StatusChange__c</fullName>
        <formula>ISPICKVAL( Core_Design_Registration_Status_Nm__c , &apos;Approved&apos;)</formula>
        <label>PCC_StatusChange</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
