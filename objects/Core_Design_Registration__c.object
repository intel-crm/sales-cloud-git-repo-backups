    <fields>
        <fullName>PCC_VisiblityForNewApprover__c</fullName>
        <formula>NOT(PCC_Is_Ownership_Transfered__c)||
AND(
PCC_Is_Ownership_Transfered__c,
$User.Username = Core_Accepted_By_Id__r.Username
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>PCC_VisiblityForNewApprover</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PCC_Volume_Linearity__c</fullName>
        <label>Volume Linearity</label>
        <length>131072</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Partner_Account_Region__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Core_Partner_Account_Id__r.Core_Geo__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Partner Account Geo Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Resubmission_mail_design__c</fullName>
        <defaultValue>false</defaultValue>
        <description>checkbox to check if mail is sent on resubmission of design</description>
        <label>Resubmission mail design</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Test_Form_Report__c</fullName>
        <externalId>false</externalId>
        <formula>IF(CreatedBy.Id = OwnerId , 1, Null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Test_Form_Report</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Test_Geo__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Core_Partner_Account_Id__r.Core_Geo__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Test_Geo</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Workflow_Status__c</fullName>
        <defaultValue>&quot;Draft&quot;</defaultValue>
        <label>Workflow Stage</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Draft</fullName>
                    <default>true</default>
                    <label>Draft</label>
                </value>
                <value>
                    <fullName>Submitted</fullName>
                    <default>false</default>
                    <label>Submitted</label>
                </value>
                <value>
                    <fullName>Pre-Approved</fullName>
                    <default>false</default>
                    <label>Precheck Completed</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>core_cpq_approved_date__c</fullName>
        <description>This field gets auto-populated on Approval of the Design Registration.</description>
        <label>Approved Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>test_Geo1__c</fullName>
        <externalId>false</externalId>
        <label>test Geo1</label>
        <length>20</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>test__c</fullName>
        <externalId>false</externalId>
        <isAIPredictionField>true</isAIPredictionField>
        <label>test</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>test_df__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Design_Registration_Nm__c  &amp; &apos;  &apos;&amp;  SUBSTITUTE(SUBSTITUTE( SUBSTITUTE(SUBSTITUTE(TEXT(NOW()), &apos;-&apos;, &apos;&apos;), &apos;:&apos;, &apos;&apos;),&apos;Z&apos;,&apos;&apos; ),&apos; &apos;,&apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>test df</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
