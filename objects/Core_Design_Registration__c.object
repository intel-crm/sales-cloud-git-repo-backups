    <fields>
        <fullName>Core_Accepted_By_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>DX Demo - The Intel user who is working on the DR Approval process</description>
        <label>Accepted By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Design_Registrations1</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Account_Record_Type__c</fullName>
        <externalId>false</externalId>
        <formula>Core_End_Customer_Account_Id__r.RecordType.Name</formula>
        <label>Account Record Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Age_Of_Design_Txt__c</fullName>
        <description>Formula that calculates the age of the design based on creation date. The values are Week 1, Week 2, Week 3, Week 4.</description>
        <externalId>false</externalId>
        <formula>if(Today() - DATEVALUE(CreatedDate) &lt; 7, &apos;Week 1&apos;, 
if(Today() - DATEVALUE(CreatedDate) &lt; 14, &apos;Week 2&apos;,
if(Today() - DATEVALUE(CreatedDate) &lt; 21, &apos;Week 3&apos;, &apos;Week 4&apos;)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Age of Design</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Approve_High_Touch_Button_Visible__c</fullName>
        <formula>(
ISPICKVAL(Core_Design_Registration_Status_Nm__c, &apos;Design Accepted&apos;) ||
ISPICKVAL(Core_Design_Registration_Status_Nm__c, &apos;Re-Submitted&apos;)
)
&amp;&amp;
(
(
NOT(ISPICKVAL(Core_Intel_Support_Status__c, &apos;Disti Design Registration Low&apos;)) &amp;&amp;
NOT(ISPICKVAL(Core_Intel_Support_Status__c, &apos;Device Builder Registration Low&apos;))
)
||
(
ISPICKVAL(Core_Intel_Support_Status__c, &apos;Disti Design Registration High&apos;) ||
ISPICKVAL(Core_Intel_Support_Status__c, &apos;PSG Design Registration&apos;) ||
ISPICKVAL(Core_Intel_Support_Status__c, &apos;Device Builder Registration High&apos;)
)
)
&amp;&amp;
(
CONTAINS($Profile.Name, &apos;System Admin&apos;) ||
CONTAINS($Profile.Name, &apos;IT Admin&apos;) ||$Permission.DDR_Internal_Users 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Approve High Touch Button Visible</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Approve_Low_Touch_Button_Visible__c</fullName>
        <formula>(
ISPICKVAL(Core_Design_Registration_Status_Nm__c, &apos;Design Accepted&apos;) ||
ISPICKVAL(Core_Design_Registration_Status_Nm__c, &apos;Re-Submitted&apos;)
)
&amp;&amp;
(
(
NOT(ISPICKVAL(Core_Intel_Support_Status__c, &apos;Disti Design Registration High&apos;)) &amp;&amp;
NOT(ISPICKVAL(Core_Intel_Support_Status__c, &apos;Device Builder Registration High&apos;))&amp;&amp;
NOT(ISPICKVAL(Core_Intel_Support_Status__c, &apos;PSG Design Registration&apos;))
)
||
(
ISPICKVAL(Core_Intel_Support_Status__c, &apos;Disti Design Registration Low&apos;) ||
ISPICKVAL(Core_Intel_Support_Status__c, &apos;Device Builder Registration Low&apos;)
)
)
&amp;&amp;
(
CONTAINS($Profile.Name, &apos;System Admin&apos;) ||
CONTAINS($Profile.Name, &apos;IT Admin&apos;) ||$Permission.DDR_Internal_Users 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Approve Low Touch Button Visible</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Approved_Product_Cnt__c</fullName>
        <description>Count of Design Products that are Approved since last Approval or since creation.</description>
        <label>System Approved Product Count</label>
        <summaryFilterItems>
            <field>Core_Design_Registration_Product__c.Core_Design_Product_Status_Nm__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Core_Design_Registration_Product__c.Core_Locked_Ind__c</field>
            <operation>equals</operation>
            <value>False</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_Design_Registration_Product__c.Core_Design_Registration_Id__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
