    <fields>
        <fullName>PCC_EndCustomerAcc_Mapping__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <inlineHelpText>Use this to search for Previously selected End Customer</inlineHelpText>
        <label>Search for Previous End Customer Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 AND 2 AND 3 AND 6) OR (1 AND 4 AND 5)</booleanFilter>
            <filterItems>
                <field>PCC_EndCustomerAcc_Mapping__c.PCC_End_Customer_Account_Id__r.RecordTypeId</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <filterItems>
                <field>PCC_EndCustomerAcc_Mapping__c.PCC_End_Customer_Account_Id__r.Core_Covered_Account__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>$Source.RecordTypeId</field>
                <operation>equals</operation>
                <value>Design Registration - Intel, Design Registration - Partner, Design Registration - Locked, Design Registration - Partner Draft</value>
            </filterItems>
            <filterItems>
                <field>$Source.RecordTypeId</field>
                <operation>equals</operation>
                <value>Deal Registration - Partner, Deal Registration - Locked, Deal Registration - Draft</value>
            </filterItems>
            <filterItems>
                <field>PCC_EndCustomerAcc_Mapping__c.PCC_Registration_Type_Nm__c</field>
                <operation>equals</operation>
                <value>Deal Registration</value>
            </filterItems>
            <filterItems>
                <field>PCC_EndCustomerAcc_Mapping__c.PCC_Registration_Type_Nm__c</field>
                <operation>equals</operation>
                <value>Design Registration</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>PCC_EndCustomerAcc_Mapping__c</referenceTo>
        <relationshipLabel>Design-Deal Registrations</relationshipLabel>
