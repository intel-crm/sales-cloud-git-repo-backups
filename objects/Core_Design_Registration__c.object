    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_Accept_Design</fullName>
        <availability>online</availability>
        <description>Updates the Accepted By User to the Current User.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Accept Design</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>// Library
{!REQUIRESCRIPT(&quot;/soap/ajax/37.0/connection.js&quot;)}

// Create Design Registration object
var designReg = new sforce.SObject(&quot;Core_Design_Registration__c&quot;);
designReg.Id = &quot;{!Core_Design_Registration__c.Id}&quot;;

// Update the Accepted By user to the current user
designReg.Core_Accepted_By_Id__c = &quot;{!$User.Id}&quot;;

// Save the Design object
var result = sforce.connection.update([designReg]);
if (result[0].getBoolean(&quot;success&quot;)) {
    window.location.reload();
}
else {
    alert(&quot;An error has occurred! Error: &quot; + result[0].errors.message);
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Approve_Design</fullName>
        <availability>online</availability>
        <description>Approves the Design after data validation.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Approve Design</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>// Library 
{!REQUIRESCRIPT(&quot;/soap/ajax/37.0/connection.js&quot;)}

var result = sforce.connection.query(&quot;SELECT Id FROM Core_Design_Registration_Product__c WHERE Core_Design_Registration_Id__c =&apos;{!Core_Design_Registration__c.Id}&apos; AND Core_Active_Status__c = false AND Core_Locked_Ind__c = false AND Core_Design_Product_Status_Nm__c =&apos;Pending&apos;&quot;); 

var DDRObj = sforce.connection.describeSObject(&quot;Core_Design_Registration__c&quot;);
var Status=&quot;{!Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c}&quot;;
var VerticalMarket=&quot;{!Core_Design_Registration__c.Core_Vertical_Market_Nm__c}&quot;;
var ProductSegment=&quot;{!Core_Design_Registration__c.Core_Product_Segment_Nm__c}&quot;;
var ProductApplication=&quot;{!Core_Design_Registration__c.Core_Product_Application_Nm__c}&quot;;
var IntelPlatform=&quot;{!Core_Design_Registration__c.Core_Intel_Platform_Nm__c}&quot;;
var DDRName=&quot;{!Core_Design_Registration__c.Core_Design_Registration_Nm__c}&quot;;

var Opp = sforce.connection.query(&quot;SELECT Id,Name From Opportunity WHERE Name =&apos;{!Core_Design_Registration__c.Core_Design_Registration_Nm__c}&apos; limit 1&quot;);

var Opprecords = Opp.getArray(&quot;records&quot;);

var VerticalMarketLovs=[];
var ProdSegLOVs=[];
var ProdAppLovs=[];
var IntelPlatformLovs=[];
var InactiveLovFields=&apos;&apos;;


for (var i=0; i&lt;DDRObj.fields.length; i++) {
  var field = DDRObj.fields[i];

  if(field.name == &apos;Core_Vertical_Market_Nm__c&apos;){
      var oPicklistVals = field.picklistValues;
	  var DDRStatus=[];
       for (var b=0; b&lt;oPicklistVals.length; b++) 
       { 
         VerticalMarketLovs[b]=oPicklistVals[b].value;
       }
	   console.log(VerticalMarketLovs);   
  }
  
    if(field.name == &apos;Core_Product_Segment_Nm__c&apos;){
      var oPicklistVals = field.picklistValues;
	  var DDRStatus=[];
       for (var b=0; b&lt;oPicklistVals.length; b++) 
       { 
         ProdSegLOVs[b]=oPicklistVals[b].value;
       }
	   console.log(ProdSegLOVs);   
  }
  
    if(field.name == &apos;Core_Product_Application_Nm__c&apos;){
      var oPicklistVals = field.picklistValues;
	  var DDRStatus=[];
       for (var b=0; b&lt;oPicklistVals.length; b++) 
       { 
         ProdAppLovs[b]=oPicklistVals[b].value;
       }
	   console.log(ProdAppLovs);   
  }
   if(field.name == &apos;Core_Intel_Platform_Nm__c&apos;){
      var oPicklistVals = field.picklistValues;
	  var DDRStatus=[];
       for (var b=0; b&lt;oPicklistVals.length; b++) 
       { 
         IntelPlatformLovs[b]=oPicklistVals[b].value;
       }
	   console.log(IntelPlatformLovs);   
  }
}

function  inactiveValueFields(){
	
if(VerticalMarketLovs.indexOf(VerticalMarket) &lt; 0){
	 
	 InactiveLovFields=&apos;Vertical Market&apos;;
	 console.log(InactiveLovFields);
}
if(IntelPlatformLovs.indexOf(IntelPlatform) &lt; 0){
	if(InactiveLovFields!=&apos;&apos;){
	InactiveLovFields=InactiveLovFields+&apos;&amp;&apos;+&apos;Intel Platform&apos;;
	}
	else{
		InactiveLovFields=&apos;Intel Platform&apos;;
	}
}

if(ProdSegLOVs.indexOf(ProductSegment) &lt; 0){
	console.log(InactiveLovFields);
	if(InactiveLovFields!=&apos;&apos;){
		console.log(&apos;I am insdie&apos;)
	InactiveLovFields=InactiveLovFields+&apos;&amp;&apos;+&apos;Product Segement&apos;;
	}
	else{
      InactiveLovFields=&apos;Product Segement&apos;;
	}
}
if(ProdAppLovs.indexOf(ProductApplication) &lt; 0){
	if(InactiveLovFields!=&apos;&apos;){
	InactiveLovFields=InactiveLovFields+&apos;&amp;&apos;+&apos;Product Application&apos;;
	}
	else{
		InactiveLovFields=&apos;Product Application&apos;;
	}
}
	return InactiveLovFields;
}

var InactiveString=inactiveValueFields();
console.log(InactiveString);

// Check if the Design is already Approved 
if (&apos;{!Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c}&apos; == &apos;Approved&apos;) {
alert(&apos;Design Registration is already Approved.&apos;);
}
else if (Opprecords != null &amp;&amp; Opprecords[0] != null &amp;&amp; &apos;{!Core_Design_Registration__c.Core_Opportunity_Id__c}&apos; == &apos;&apos;){
alert(&apos;{!$Label.Core_Opportunity_Exist_for_Design_Registration_Error_Message}&apos;);
}
// Check if there are any Pending Products 
else if (&apos;{!Core_Design_Registration__c.Core_Pending_Product_Cnt__c}&apos; &gt; 0) {
alert(&apos;There are some Pending Products. Please disposition all of them before Approving the Design Registration.&apos;);
}

// Check if there are any Approved Products. Skip this check for Re-Submitted designs. 
else if (&apos;{!Core_Design_Registration__c.Core_Approved_Product_Cnt__c}&apos; == 0 &amp;&amp; &apos;{!Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c}&apos; != &apos;Re-Submitted&apos;) {
alert(&apos;There are NO Approved Products.&apos;);
}

// Check for Ownership 
else if (&apos;{!Core_Design_Registration__c.Core_Partner_Account_IdId__c}&apos; == null || &apos;{!Core_Design_Registration__c.Core_Partner_Account_IdId__c}&apos; == &apos;&apos;) {
alert(&apos;Please change the Owner to Partner User.&apos;);
}

// Check for End Customer Account 
else if (&apos;{!Core_Design_Registration__c.Core_End_Customer_Account_IdId__c}&apos; == null || &apos;{!Core_Design_Registration__c.Core_End_Customer_Account_IdId__c}&apos; == &apos;&apos;) {
alert(&apos;Please provide End Customer Account.&apos;);
}

// Check if End Customer Account is Blocked 
else if (&apos;{!Core_Design_Registration__c.Core_Is_End_Customer_Account_Blocked_Ind__c}&apos; == true) {
alert(&apos;Please provide End Customer Account that is NOT Export Compliance Blocked.&apos;);
}

// Check if End Customer Account has valid Sales Group
else if (&apos;{!Core_Design_Registration__c.Core_End_Customer_Sales_Group_Nm__c}&apos; == &apos;&apos; || &apos;{!Core_Design_Registration__c.Core_End_Customer_Sales_Group_Nm__c}&apos; == &apos;Undefined&apos;) {
alert(&apos;The Sales Group of the account associated with this Design Registration record is either blank or Undefined. Please change the Sales Group value or change the account to proceed.&apos;);
}

// Check if End Customer Account has valid Industry
else if (&apos;{!Core_Design_Registration__c.Core_End_Customer_Industry_Nm__c}&apos; == &apos;&apos; || &apos;{!Core_Design_Registration__c.Core_End_Customer_Industry_Nm__c}&apos; == &apos;To Be Defined&apos;) {
alert(&apos;The Industry of the account associated with this Design Registration record is either blank or To Be Defined. Please change the Industry value or change the account to proceed.&apos;);
}

// Check if End Customer Account has valid Sub-Industry
else if (&apos;{!Core_Design_Registration__c.Core_End_Customer_Sub_Industry__c}&apos; == &apos;&apos; || &apos;{!Core_Design_Registration__c.Core_End_Customer_Sub_Industry__c}&apos; == &apos;To Be Defined&apos;) {
alert(&apos;The Sub-Industry of the account associated with this Design Registration record is either blank or To Be Defined. Please change the Sub-Industry value or change the account to proceed.&apos;);
}

// Check if End Customer Account Owner is Uncovered or A&amp;E User
else if (&apos;{!Core_Design_Registration__c.Core_End_Customer_Account_Owner__c}&apos;==&apos;A&amp;E Account Owner&apos; || &apos;{!Core_Design_Registration__c.Core_End_Customer_Account_Owner__c}&apos;==&apos;Uncovered Account&apos;){
alert(&apos;The Account Owner of the account associated with this Design Registration record, is Uncovered or A&amp;E User. Please change the account owner or change the account to proceed.&apos;);
}

// Check if any product became inactive
else if (result.size &gt; 0 ){
alert(&apos;There are Inactive Products added on this Design Registration, please remove the inactive products to proceed with Approval.&apos;);
}

// Check if End Customer Account is Covered 
else if (&apos;{!Core_Design_Registration__c.Core_Is_End_Customer_Account_Covered_Ind__c}&apos; == false) {
alert(&apos;Please provide End Customer Account that is Covered.&apos;);
}

// Check the Record type of the End Customer Account
else if (&apos;{!Core_Design_Registration__c.Core_End_Customer_Account_RecordType__c}&apos; == &apos;Intel Ultimate Account&apos; || &apos;{!Core_Design_Registration__c.Core_End_Customer_Account_RecordType__c}&apos; ==&apos;Inactive Account&apos; ||
          &apos;{!Core_Design_Registration__c.Core_End_Customer_Account_RecordType__c}&apos;==&apos;CoMarketing&apos; ) {
alert(&apos;Current selected value of the field&apos;+&apos;&quot;&apos;+ &apos;End Customer Account&apos;+&apos;&quot;&apos;+&apos; on this record is not a valid value anymore. Please select a valid value and retry submission &apos;);
}

// Check if any picklist values are inactive
else if (InactiveString != &apos;&apos;){
alert(&apos;Current selected values of the following fields&apos;+&apos;&quot;&apos;+InactiveString+&apos;&quot;&apos;+&apos;on this record are inactive. Please select a valid value and retry submission &apos;);	
}

// All validations passed, Approve the Design 
else {
	var designReg = new sforce.SObject(&quot;Core_Design_Registration__c&quot;);
	designReg.Id = &quot;{!Core_Design_Registration__c.Id}&quot;;
	designReg.Core_Design_Registration_Status_Nm__c = &apos;Approved&apos;;
	designReg.Core_Rejection_Reason_Nm__c = null;
	designReg.Core_Rejection_Comment_Txt__c = null;
	designReg.Core_Intel_Technical_Owner_Id__c = &quot;{!$User.Id}&quot;;

	// Save the Design object 
	var result = sforce.connection.update([designReg]);
	if (result[0].getBoolean(&quot;success&quot;)) {
		alert(&apos;Design Registration Approved successfully.&apos;);
		window.location.reload();
	}
	else {
		alert(&quot;An error has occurred! Error: &quot; + result[0].errors.message);
	}
}</url>
