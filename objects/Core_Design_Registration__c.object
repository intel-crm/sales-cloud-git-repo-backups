        <formula>IF (Core_End_Customer_Account_Id__c != NULL, TEXT(Core_End_Customer_Account_Id__r.Industry), NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The Industry value of the End Customer Account.</inlineHelpText>
