    <fields>
        <fullName>Core_Design_Registration_Status_Nm__c</fullName>
        <description>The status values which drive the Design Registration through the process.  Valid values are: Submitted, Re-Submitted, Approved, Rejected, Abandoned.</description>
        <inlineHelpText>The status values which drive the Design Registration through the process.  Valid values are: Submitted, Re-Submitted, Approved, Rejected, Abandoned.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Submitted</fullName>
                    <default>true</default>
                    <label>Submitted</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>Re-Submitted</fullName>
                    <default>false</default>
                    <label>Re-Submitted</label>
                </value>
                <value>
                    <fullName>Abandoned</fullName>
                    <default>false</default>
                    <label>Abandoned</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
