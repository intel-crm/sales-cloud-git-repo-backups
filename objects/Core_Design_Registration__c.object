    <fields>
        <fullName>PCC_End_Customer_Country__c</fullName>
        <inlineHelpText>The country where the end customer company is located</inlineHelpText>
        <label>End Customer Country</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_IPS_Country_Region</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>PCC_End_Customer_Quick_Tip__c</fullName>
        <defaultValue>&quot;PLEASE USE END CUSTOMER SEARCH OPTION TO SELECT PREVIOUSLY SELECTED END CUSTOMER. FOR WRITE IN END CUSTOMER, PLEASE PROVIDE STREET1, CITY, STATE, END CUSTOMER COUNTRY, ZIP CODE, DIGITAL IDENTIFIER, DIGITAL IDENTIFIER VALUE, INDUSTRY AND SUB-INDUSTRY.&quot;</defaultValue>
        <label>Quick tip on End Customer selection</label>
        <length>1000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>PCC_End_Customer_Region__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(TEXT(PCC_End_Customer_Country__c),
&quot;India&quot;, &quot;APJ&quot;,
&quot;United States&quot;, &quot;ASMO&quot;,
&quot;Canada&quot;, &quot;CANADA&quot;,
&quot;Other&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>End Customer Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PCC_End_Customer_Sales_Geography__c</fullName>
        <label>End Customer Sales Geography</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Pricing_Region</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>PCC_End_Customer_Selection_Note__c</fullName>
        <defaultValue>&quot;Please search for previously selected end customer accounts below or enter End Customer Name, Street1, City, State/Province, Zip/Postal Code and End Customer Country fields&quot;</defaultValue>
