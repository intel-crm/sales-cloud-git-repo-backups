        <fullName>Core_Intel_Technical_Owner_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This is the Intel Sales Owner.</description>
        <inlineHelpText>This is the Intel Sales Owner of this Design Registration.</inlineHelpText>
        <label>Intel Technical Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Design_Registrations</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Internal_Comment_Txt__c</fullName>
        <description>Comments about this design added by an Intel Sales Owner.  Not visible to Distis.</description>
        <inlineHelpText>Comments about this design added by an Intel Sales Owner (Not visible to Distributor)</inlineHelpText>
        <label>Internal Comments</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Is_End_Customer_Account_Blocked_Ind__c</fullName>
        <formula>IF (Core_End_Customer_Account_Id__c != null, Core_End_Customer_Account_Id__r.Core_Export_Compliance_Block__c, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System Is End Customer Account Blocked</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Is_End_Customer_Account_Covered_Ind__c</fullName>
        <formula>IF (Core_End_Customer_Account_Id__c != null, Core_End_Customer_Account_Id__r.Core_Covered_Account__c, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System Is End Customer Account Covered</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
