ISCHANGED(OwnerId),
OR($Profile.Name = &quot;CCP - Core Access&quot;,
 $Profile.Name = &quot;Sales Ops&quot;),
NOT($Permission.PCC_Bypass_Automation)  
)</errorConditionFormula>
        <errorMessage>You cannot change the owner of this record. If required, please raise an IT support request.</errorMessage>
    </validationRules>
    <validationRules>
