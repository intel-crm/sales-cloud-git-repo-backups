    <validationRules>
        <fullName>Approvers_can_edit_product_application</fullName>
        <active>false</active>
        <errorConditionFormula>AND($CustomMetadata.LabelConfiguration__mdt.inactive_DR_Trigger.Value__c == &apos;false&apos;,
AND(NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Draft&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Submitted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Pre-Approved&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Re-Submitted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Design accepted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Pending with Partner&apos;)),
OR(
$Permission.DDR_Internal_Users,
$Permission.DDR_PreApprover_Permission,
AND ($Profile.Name = &quot;Partner&quot;,NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Approved&apos;)))
),
ISCHANGED(Core_Product_Application_Nm__c)
),
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorMessage>Product Application cannot be changed in the given Design registration status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Approvers_can_edit_product_segment</fullName>
        <active>true</active>
        <errorConditionFormula>AND( PCC_Registration_Type__c  = &apos;Design Registration&apos;,NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Draft&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Submitted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Pre-Approved&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Re-Submitted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Design accepted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Pending with Partner&apos;)),
OR(
$Permission.DDR_Internal_Users,
$Permission.DDR_PreApprover_Permission,
AND ($Profile.Name = &quot;Partner&quot;,NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Approved&apos;)))
),
ISCHANGED(Core_Product_Segment_Nm__c),
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorMessage>Product Segment cannot be changed in the given Design registration status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Approvers_can_edit_vertical_market</fullName>
        <active>true</active>
        <errorConditionFormula>AND(PCC_Registration_Type__c = &apos;Design Registration&apos;,NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Draft&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Submitted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Pre-Approved&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Re-Submitted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Design accepted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Pending with Partner&apos;)),
OR(
$Permission.DDR_Internal_Users,
$Permission.DDR_PreApprover_Permission,
AND ($Profile.Name = &quot;Partner&quot;,NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Approved&apos;)))
),
ISCHANGED(Core_Vertical_Market_Nm__c),
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorMessage>Vertical Market cannot be changed in the given Design registration status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CORE_DDR_ProductGroup</fullName>
        <active>false</active>
        <errorConditionFormula>AND(PCC_Registration_Type__c = &apos;Design Registration&apos;,OR(AND(NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Submitted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Pre-Approved&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Draft&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Design accepted&apos;)),NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c,&apos;Pending with Partner&apos;)),
OR(
$Profile.Name = &quot;Partner&quot;,
$Profile.Name = &apos;B2B API Partner&apos;,$Profile.Name = &apos;PCC B2B API Integration&apos;
),
ISCHANGED(Core_Product_Group_Nm__c)
),AND(ISCHANGED(Core_Product_Group_Nm__c),OR($Permission.DDR_Internal_Users,
$Permission.DDR_PreApprover_Permission),$Profile.Name != &quot;Data Ops&quot;)),
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorMessage>Product group can&apos;t be changed in the given Design registration status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_DDR_Lock_MINDS_Field</fullName>
        <active>true</active>
        <description>Rule to prevent Internal users from editing the field &apos;Are Intel items used for MINDS?&apos; on Design Registrations created by Partner users. The rule does not apply for Admin users.</description>
        <errorConditionFormula>AND
(PCC_Registration_Type__c = &apos;Design Registration&apos;,
ISCHANGED(Core_Military_Aerospace_Gvrnmt_Use_Ind__c) = TRUE,
ISPICKVAL(CreatedBy.UserType, &apos;PowerPartner&apos;),
NOT(ISPICKVAL($User.UserType, &apos;PowerPartner&apos;)),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;IT Admin&apos;,
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorDisplayField>Core_Military_Aerospace_Gvrnmt_Use_Ind__c</errorDisplayField>
        <errorMessage>The Design Registration is created by Partner User and this field is NOT editable.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_cannot_enter_past_cust_ship_dates</fullName>
        <active>true</active>
        <errorConditionFormula>AND(PCC_Registration_Type__c = &apos;Design Registration&apos;,
IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Rejected&apos;),FALSE, TRUE),
IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Expired&apos;),FALSE, TRUE),
OR(AND(ISNEW(),OR( TODAY()&gt;Core_First_Customer_Ship_Dt__c),NOT(OR($Profile.Name = &apos;B2B API Partner&apos;,$Profile.Name = &apos;PCC B2B API Integration&apos;))),

AND(Core_First_Customer_Ship_Dt__c &lt;= Core_Opportunity_Decision_Dt__c ,NOT(OR($Profile.Name = &apos;B2B API Partner&apos;,$Profile.Name = &apos;PCC B2B API Integration&apos;))),

AND( Core_First_Customer_Ship_Dt__c &gt;= Core_Production_End_Dt__c,NOT(OR($Profile.Name = &apos;B2B API Partner&apos;,$Profile.Name = &apos;PCC B2B API Integration&apos;)))

),
IF( ISCHANGED(Core_Design_Registration_Status_Nm__c) , IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Approved&apos;) ,FALSE, TRUE) , IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Approved&apos;), IF(ISCHANGED(Core_First_Customer_Ship_Dt__c), TRUE,FALSE),TRUE)),

NOT( $Permission.PCC_Bypass_Automation ),
NOT( $Permission.DDR_PreApprover_Permission  ),
NOT( $Permission.DDR_Internal_Users )

)</errorConditionFormula>
        <errorDisplayField>Core_First_Customer_Ship_Dt__c</errorDisplayField>
        <errorMessage>Please ensure the following : 
•Date entered cannot be in the past. 
•Date cannot be same or after the production date.
•Date cannot be same or before the decision date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_cannot_enter_past_decision_dates</fullName>
        <active>true</active>
        <errorConditionFormula>AND(PCC_Registration_Type__c = &apos;Design Registration&apos;,
IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Rejected&apos;),FALSE, TRUE),
IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Expired&apos;),FALSE, TRUE),
OR(
AND(ISNEW(), OR(TODAY()&gt;Core_Opportunity_Decision_Dt__c),NOT(OR($Profile.Name = &apos;B2B API Partner&apos;,$Profile.Name = &apos;PCC B2B API Integration&apos;))),
AND(AND(NOT(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Draft&apos;)),ISCHANGED( Core_Opportunity_Decision_Dt__c )),NOT(OR($Profile.Name = &apos;B2B API Partner&apos;,$Profile.Name = &apos;PCC B2B API Integration&apos;))),
AND(AND(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Draft&apos;),ISCHANGED( Core_Opportunity_Decision_Dt__c ),(TODAY()&gt;Core_Opportunity_Decision_Dt__c)),NOT(OR($Profile.Name = &apos;B2B API Partner&apos;,$Profile.Name = &apos;PCC B2B API Integration&apos;)))
),
IF( ISCHANGED(Core_Design_Registration_Status_Nm__c) , IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Approved&apos;) ,FALSE, TRUE) , IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Approved&apos;), IF(ISCHANGED(Core_Opportunity_Decision_Dt__c), TRUE,FALSE),TRUE)),
IF( NOT(ISCHANGED(Core_Opportunity_Decision_Dt__c)) &amp;&amp; $Permission.DDR_PreApprover_Permission &amp;&amp; $Permission.DDR_Internal_Users,False ,True),
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorDisplayField>Core_Opportunity_Decision_Dt__c</errorDisplayField>
        <errorMessage>Please ensure the following :
•Date entered cannot be in the past.
•Date once entered cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_cannot_enter_past_prod_dates</fullName>
        <active>true</active>
        <errorConditionFormula>AND(PCC_Registration_Type__c = &apos;Design Registration&apos;,
IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Rejected&apos;),FALSE, TRUE),
IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Expired&apos;),FALSE, TRUE),
OR(AND(ISNEW(), OR(TODAY()&gt;Core_Production_End_Dt__c),NOT(OR($Profile.Name = &apos;B2B API Partner&apos;,$Profile.Name = &apos;PCC B2B API Integration&apos;)))
,AND(Core_Production_End_Dt__c &lt;= Core_Opportunity_Decision_Dt__c,NOT(OR($Profile.Name = &apos;B2B API Partner&apos;,$Profile.Name = &apos;PCC B2B API Integration&apos;)))
),
IF( ISCHANGED(Core_Design_Registration_Status_Nm__c) , IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Approved&apos;) ,FALSE, TRUE) , IF(ISPICKVAL(Core_Design_Registration_Status_Nm__c ,&apos;Approved&apos;), IF(ISCHANGED(Core_Production_End_Dt__c), TRUE,FALSE),TRUE)),
IF( NOT(ISCHANGED(Core_Production_End_Dt__c)) &amp;&amp;  $Permission.DDR_PreApprover_Permission &amp;&amp;  $Permission.DDR_Internal_Users,False ,True),
NOT( $Permission.PCC_Bypass_Automation ),
NOT( $Permission.DDR_PreApprover_Permission )

)</errorConditionFormula>
        <errorDisplayField>Core_Production_End_Dt__c</errorDisplayField>
        <errorMessage>Please ensure the following :
• Date entered cannot be in the past.
• Date cannot be same or before the decision date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DDR_StatusVal_upon_submission_Approval</fullName>
        <active>true</active>
        <errorConditionFormula>IF(OR($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,
$Permission.PCC_Bypass_Automation, PCC_Registration_Type__c ==&apos;Deal Registration&apos; ),FALSE,
AND
(PCC_Registration_Type__c = &apos;Design Registration&apos;,
OR
(
IF
(
(Core_End_Customer_Account_Id__r.RecordType.Name &lt;&gt; &quot;Intel Account&quot;),true,false
),
IF(
(
AND
(
Core_End_Customer_Account_Id__r.RecordType.Name = &quot;Intel Account&quot;,
Core_End_Customer_Account_Id__r.Core_Covered_Account__c = false
)
),true,false
)
),
OR(
ISPICKVAL(Core_Design_Registration_Status_Nm__c , &apos;Approved&apos;),
ISPICKVAL(Core_Design_Registration_Status_Nm__c , &apos;Submitted&apos;),
ISPICKVAL(Core_Design_Registration_Status_Nm__c , &apos;Re-Submitted&apos;)
),
NOT(IsBlank(Core_End_Customer_Account_Id__c))
)
)</errorConditionFormula>
        <errorMessage>End Customer Account has to be Intel Account and Covered</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DDR_customerURL</fullName>
        <active>false</active>
        <errorConditionFormula>AND
(ISCHANGED(Core_End_Customer_URL__c),
OR(
$Permission.DDR_Internal_Users,
$Permission.DDR_PreApprover_Permission
))</errorConditionFormula>
        <errorMessage>End customer URL cannot be modified.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Internal_User_not_update_DR_Owner</fullName>
        <active>true</active>
