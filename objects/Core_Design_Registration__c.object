    <searchLayouts>
        <customTabListAdditionalFields>Core_Design_Registration_Nm__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Core_Design_Registration_Status_Nm__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>CREATED_DATE</customTabListAdditionalFields>
        <customTabListAdditionalFields>LAST_UPDATE</customTabListAdditionalFields>
        <searchResultsAdditionalFields>Core_Design_Registration_Status_Nm__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_DDR_Decision_Date_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
ISPICKVAL( Core_Design_Registration_Status_Nm__c , &quot;Approved&quot;), 
Core_Opportunity_Decision_Dt__c &lt; Today()
)</errorConditionFormula>
        <errorDisplayField>Core_Opportunity_Decision_Dt__c</errorDisplayField>
        <errorMessage>Past Decision Dates are invalid. Please enter a future Decision Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_DDR_Manufacturing_Region_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
ISPICKVAL( Core_Design_Registration_Status_Nm__c , &quot;Approved&quot;), 
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
ISPICKVAL( Core_Manufacturing_Region_Cd__c , &quot;&quot; ) 
)</errorConditionFormula>
        <errorDisplayField>Core_Manufacturing_Region_Cd__c</errorDisplayField>
        <errorMessage>Please enter a value for Manufacturing Region</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_Accept_Design</fullName>
        <availability>online</availability>
        <description>Updates the Accepted By User to the Current User.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Accept Design</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>// Library
{!REQUIRESCRIPT(&quot;/soap/ajax/37.0/connection.js&quot;)}

// Create Design Registration object
var designReg = new sforce.SObject(&quot;Core_Design_Registration__c&quot;);
designReg.Id = &quot;{!Core_Design_Registration__c.Id}&quot;;

// Update the Accepted By user to the current user
designReg.Core_Accepted_By_Id__c = &quot;{!$User.Id}&quot;;

// Save the Design object
var result = sforce.connection.update([designReg]);
if (result[0].getBoolean(&quot;success&quot;)) {
    window.location.reload();
}
else {
    alert(&quot;An error has occurred! Error: &quot; + result[0].errors.message);
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Approve_Design</fullName>
        <availability>online</availability>
        <description>Approves the Design after data validation.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Approve Design</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>// Library
{!REQUIRESCRIPT(&quot;/soap/ajax/37.0/connection.js&quot;)}

// Check if the Design is already Approved
if (&apos;{!Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c}&apos; == &apos;Approved&apos;) {
    alert(&apos;Design Registration is already Approved.&apos;);
}

// Check if there are any Pending Products
else if (sforce.connection.query(&quot;SELECT Id FROM Core_Design_Registration_Product__c WHERE Core_Design_Registration_Id__c = &apos;{!Core_Design_Registration__c.Id}&apos; AND Core_Design_Product_Status_Nm__c = &apos;Pending&apos; AND Core_Locked_Ind__c = false&quot;).size &gt; 0) {
    alert(&apos;There are some Pending Products. Please disposition all of them before Approving the Design Registration.&apos;);
}

// Check if there are any Approved Products
else if (sforce.connection.query(&quot;SELECT Id FROM Core_Design_Registration_Product__c WHERE Core_Design_Registration_Id__c = &apos;{!Core_Design_Registration__c.Id}&apos; AND Core_Design_Product_Status_Nm__c = &apos;Approved&apos; AND Core_Locked_Ind__c = false&quot;).size == 0) {
    alert(&apos;There are NO Approved Products.&apos;);
}

// Check for Partner Account
else if (&apos;{!Core_Design_Registration__c.Core_Partner_Account_Id__c}&apos; == null || &apos;{!Core_Design_Registration__c.Core_Partner_Account_Id__c}&apos; == &apos;&apos;) {
    alert(&apos;Please provide Partner Account.&apos;);
}

// Check for End Customer Account
else if (&apos;{!Core_Design_Registration__c.Core_End_Customer_Account_Id__c}&apos; == null || &apos;{!Core_Design_Registration__c.Core_End_Customer_Account_Id__c}&apos; == &apos;&apos;) {
    alert(&apos;Please provide End Customer Account.&apos;);
}

// Check if End Customer Account is Covered
else if (sforce.connection.query(&quot;SELECT Id FROM Account WHERE Id = &apos;{!Core_Design_Registration__c.Core_End_Customer_Account_IdId__c}&apos; AND Core_Covered_Account__c = true&quot;).size == 0) {
    alert(&apos;Please provide End Customer Account that is Covered.&apos;);
}

// Check if the status is Re-Submitted. Re-Approve using custom Apex page (since the record is locked)
else if (&apos;{!Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c}&apos; == &apos;Re-Submitted&apos;) {
    window.location.href = &apos;/apex/Core_DDR_Approve_Design?id={!Core_Design_Registration__c.Id}&apos;;
}

// Approve the Design
else {
    var designReg = new sforce.SObject(&quot;Core_Design_Registration__c&quot;);
    designReg.Id = &quot;{!Core_Design_Registration__c.Id}&quot;;
    designReg.Core_Design_Registration_Status_Nm__c = &apos;Approved&apos;;
    designReg.Core_Rejection_Reason_Nm__c = null;
    designReg.Core_Rejection_Comment_Txt__c = null;

    if (&apos;{!Core_Design_Registration__c.Core_Intel_Technical_Owner_Id__c}&apos; == &apos;&apos;) {
        designReg.Core_Intel_Technical_Owner_Id__c = &quot;{!$User.Id}&quot;;
    }

    // Save the Design object
    var result = sforce.connection.update([designReg]);
    if (result[0].getBoolean(&quot;success&quot;)) {
        alert(&apos;Design Registration Approved successfully.&apos;);
        window.location.reload();
    }
    else {
        alert(&quot;An error has occurred! Error: &quot; + result[0].errors.message);
    }
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Reject_Design</fullName>
        <availability>online</availability>
        <description>Rejects the Design after data validation.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Reject Design</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>// Library
{!REQUIRESCRIPT(&quot;/soap/ajax/37.0/connection.js&quot;)}

// Check if the Design is already Rejected
if (&apos;{!Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c}&apos; == &apos;Rejected&apos;) {
    alert(&apos;Design Registration is already Rejected.&apos;);
}

// Check if there are any Pending Products
else if (sforce.connection.query(&quot;SELECT Id FROM Core_Design_Registration_Product__c WHERE Core_Design_Registration_Id__c = &apos;{!Core_Design_Registration__c.Id}&apos; AND Core_Design_Product_Status_Nm__c  = &apos;Pending&apos;&quot;).size &gt; 0) {
    alert(&apos;There are some Pending Products. Please disposition all of them before Rejecting the Design Registration.&apos;);
}

// Check if there are any Approved Products
else if (sforce.connection.query(&quot;SELECT Id FROM Core_Design_Registration_Product__c WHERE Core_Design_Registration_Id__c = &apos;{!Core_Design_Registration__c.Id}&apos; AND Core_Design_Product_Status_Nm__c  = &apos;Approved&apos;&quot;).size &gt; 0) {
    alert(&apos;There are some Approved Products. Please Reject all of them before Rejecting the Design Registration.&apos;);
}

// Call the VF page that Rejects the Design after collecting the Rejection Reason and Rejection Comments
else {
    window.top.location.href = &quot;/apex/Core_DDR_Reject_Design?scontrolCaching=1&amp;id={!Core_Design_Registration__c.Id}&quot;;
}</url>
    </webLinks>
</CustomObject>
