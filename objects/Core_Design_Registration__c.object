    <fields>
        <fullName>Core_Opportunity_Volume_Cnt__c</fullName>
        <description>This is the number of whole units (which will involve all of the components in the design) the End-Customer expects to buy/sell on an annual basis.</description>
        <externalId>false</externalId>
        <inlineHelpText>This is the number of whole units (which will involve all of the components in the design) the End-Customer expects to buy/sell on an annual basis.</inlineHelpText>
        <label>Opportunity Volume</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Owner_Nm__c</fullName>
        <description>This is the representative of the Distributor that is the primary point of Contact with Intel for this Design Registration.</description>
        <externalId>false</externalId>
        <formula>Owner:User.FirstName &amp; &quot; &quot; &amp; Owner:User.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is the representative of the Distributor that is the primary point of Contact with Intel for this Design Registration.</inlineHelpText>
        <label>Owner Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_Country_Cd__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Partner_Account_Id__r.BillingCountry</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Partner Account Country Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Intel Account of the distributor.
This is the name of the Distributor submitting the Design Registration.</description>
        <label>Partner Account Name</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR 2</booleanFilter>
            <filterItems>
                <field>Account.RecordType.Name</field>
                <operation>notEqual</operation>
                <value>Direct Account</value>
            </filterItems>
            <filterItems>
                <field>$Profile.Name</field>
                <operation>equals</operation>
                <value>System Administrator</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipName>Core_Partners</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_Name__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Partner_Account_Id__r.Core_Prime_Account_Name__c</formula>
