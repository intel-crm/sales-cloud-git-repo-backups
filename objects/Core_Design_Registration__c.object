    <fields>
        <fullName>Core_My_Accepted_Design_Ind__c</fullName>
        <formula>if(Core_Accepted_By_Id__c = $User.Id, true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>My Accepted Design</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Approver_Nm__c</fullName>
        <description>Manager of the Partner Account Owner. This person will receive the Approval if this design is converted to Opportunity and the Opportunity is submitted for Approval.</description>
        <externalId>false</externalId>
        <formula>Core_Partner_Account_Id__r.Owner.Manager.FirstName + &apos; &apos; + Core_Partner_Account_Id__r.Owner.Manager.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Manager of the Partner Account Owner. This person will receive the Approval if this design is converted to Opportunity and the Opportunity is submitted for Approval.</inlineHelpText>
        <label>Opportunity Approver</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Decision_Dt__c</fullName>
        <description>This is the date by which the Disti expects the End-Customer to confirm they are proceeding with this design.  This is the Anticipated Design Win Date.</description>
        <inlineHelpText>The date by which the end customer will decide whether or not to move forward with the project</inlineHelpText>
        <label>Decision Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This is a reference to the Opportunity record created after the Design Registration approval.</description>
        <inlineHelpText>This is a reference to the Opportunity record created after the Design-Deal Registration approval.</inlineHelpText>
        <label>Opportunity Name</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Design-Deal Registrations</relationshipLabel>
        <relationshipName>Design_Registrations</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Volume_Cnt__c</fullName>
        <description>This is the number of whole units (which will involve all of the components in the design) the End-Customer expects to buy/sell on an annual basis.</description>
        <externalId>false</externalId>
        <inlineHelpText>This is the number of whole units (which will involve all of the components in the design) the End-Customer expects to buy/sell on an annual basis.</inlineHelpText>
        <label>Opportunity Volume</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Owner_Nm__c</fullName>
        <description>This is the representative of the Distributor that is the primary point of Contact with Intel for this Design Registration.</description>
        <externalId>false</externalId>
        <formula>Owner:User.FirstName &amp; &quot; &quot; &amp; Owner:User.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is the representative of the Distributor that is the primary point of Contact with Intel for this Design Registration.</inlineHelpText>
        <label>Owner Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_Country_Cd__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Partner_Account_Id__r.BillingCountry</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Partner Account Country Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Intel Account of the distributor.
This is the name of the Distributor submitting the Design Registration.</description>
        <label>Partner Account Name</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR 2</booleanFilter>
            <filterItems>
                <field>Account.RecordType.Name</field>
                <operation>notEqual</operation>
                <value>Direct Account</value>
            </filterItems>
            <filterItems>
                <field>$Profile.Name</field>
                <operation>equals</operation>
                <value>System Administrator</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipName>Core_Partners</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_Nm__c</fullName>
        <description>Formula field to show the name of the Partner Account to the Disti user.</description>
        <externalId>false</externalId>
        <formula>Core_Partner_Account_Id__r.Name</formula>
        <inlineHelpText>This is Intel&apos;s Partner Account name submitting the Design-Deal Registration.</inlineHelpText>
        <label>Partner Account</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_Owner_Email_Txt__c</fullName>
        <description>Field to store the Email of the Partner Account Owner. This will be used to send Email notification when the Design has not been processed in 150 days.</description>
        <externalId>false</externalId>
        <label>Partner Account Owner Email</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_Region_Cd__c</fullName>
        <externalId>false</externalId>
        <label>Partner Account Region</label>
        <length>20</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_State_Cd__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Partner_Account_Id__r.BillingState</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Partner Account State Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_FAE_Nm__c</fullName>
        <description>This is the Disti&apos;s technical owner, Field Application Engineer who is responsible for supporting the End-Customer&apos;s design.</description>
        <externalId>false</externalId>
        <inlineHelpText>Partner&apos;s technical owner (field application engineer)</inlineHelpText>
        <label>Partner Contact</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_FSR_Nm__c</fullName>
        <externalId>false</externalId>
        <label>Partner FSR</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
