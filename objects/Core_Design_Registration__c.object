    <fields>
        <fullName>Core_End_Customer_PSG_Tier_Nm__c</fullName>
        <description>This is Intel&apos;s categorization of the End-Customer based on its volume of business.  It is pulled in from the End-Customer (Account) record and displayed on the Design Registration.</description>
        <externalId>false</externalId>
        <formula>IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Account_Tier__c, &quot;PSG-Tier 1&quot;), &quot;PSG-Tier 1&quot;, NULL)+ 
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Account_Tier__c, &quot;PSG-Tier 2&quot;), &quot;PSG-Tier 2&quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Account_Tier__c, &quot;PSG-Tier 3&quot;), &quot;PSG-Tier 3&quot;, NULL)+
IF(INCLUDES(Core_End_Customer_Account_Id__r.Core_Account_Tier__c, &quot;PSG-Tier 4&quot;), &quot;PSG-Tier 4&quot;, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is Intel&apos;s categorization of the End-Customer based on its volume of business.  It is pulled in from the End-Customer (Account) record and displayed on the Design Registration.</inlineHelpText>
        <label>End Customer PSG Tier</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
