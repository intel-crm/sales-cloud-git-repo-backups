    <fields>
        <fullName>Core_Design_Status_Checkbox__c</fullName>
        <description>Check if the registration status is design in review or pending with partner</description>
        <formula>OR(
     ISPICKVAL( Core_Design_Registration_Status_Nm__c , &quot;Design accepted&quot;), ISPICKVAL( Core_Design_Registration_Status_Nm__c , &quot;Pending with Partner&quot;) 
    )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Design Status Checkbox</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_End_Customer_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The name of the company designing a product using Intel&apos;s components.  This is a reference to the Account record.</description>
        <inlineHelpText>Name of End Customer designing a product with Intel components.  This is a reference to the Account record in the Opportunity</inlineHelpText>
        <label>End Customer Account Name</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 AND 2 AND 4) OR (1 AND 5) OR 3</booleanFilter>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Covered_Account__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>$Profile.Name</field>
                <operation>equals</operation>
                <value>System Administrator</value>
            </filterItems>
            <filterItems>
                <field>$Source.RecordTypeId</field>
                <operation>equals</operation>
                <value>Design Registration - Intel, Design Registration - Partner, Design Registration - Locked, Design Registration - Partner Draft</value>
            </filterItems>
            <filterItems>
                <field>$Source.RecordTypeId</field>
                <operation>equals</operation>
                <value>Deal Registration - Partner, Deal Registration - Locked, Deal Registration - Draft</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipName>Core_End_Customer</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
