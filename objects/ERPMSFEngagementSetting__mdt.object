<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Code__c</fullName>
        <description>ERPM Engagement Code</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>ERPM Engagement Code</inlineHelpText>
        <label>Code</label>
        <length>50</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Source__c</fullName>
        <description>This field will signify the ownership of the record. Records with Source as &quot;ERPM&quot; will be owned by Team Quest and Source as &quot;Salesforce&quot; will be owned by Team Draco.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>This field will signify the ownership of the record.</inlineHelpText>
        <label>Source</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>ERPM</fullName>
                    <default>true</default>
                    <label>ERPM</label>
                </value>
                <value>
                    <fullName>Salesforce</fullName>
                    <default>false</default>
                    <label>Salesforce</label>
                </value>
                <value>
                    <fullName>Both</fullName>
                    <default>false</default>
                    <label>Both</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>EntitlementProgName__c</fullName>
        <description>Contains entitlement name or program name</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Entitlement name or Program name</inlineHelpText>
        <label>EntitlementProgName</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Notify__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Specifies if email has to be sent from eRPM while adding engagement</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Mark it as checked if email has to sent for engagement else Unchecked</inlineHelpText>
        <label>Notify</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>core_removalRequired__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Check this box if Engagement is to be removed upon removal of the Entitlement</inlineHelpText>
        <label>Removal Required</label>
        <type>Checkbox</type>
    </fields>
    <label>ERPMSFEngagementSetting</label>
    <pluralLabel>ERPMSFEngagementSettings</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
