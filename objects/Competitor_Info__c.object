        <externalId>false</externalId>
        <label>core_cpq_src_sys_id__c</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpq_core_quantity__c</fullName>
