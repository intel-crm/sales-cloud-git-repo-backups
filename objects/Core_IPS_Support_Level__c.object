        <fullName>Core_IPS_Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>An account is the Parent of Support Level.</description>
        <inlineHelpText>An account is the Parent of Support Level.</inlineHelpText>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.Core_IPS_Active__c</field>
