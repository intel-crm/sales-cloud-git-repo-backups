    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Activity_Category__c</fullName>
        <label>Activity Category</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Activity_Category</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Campaign__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Campaign</label>
        <referenceTo>Campaign</referenceTo>
        <relationshipLabel>Categorywise Campaign Budgets</relationshipLabel>
        <relationshipName>Categorywise_Campaign_Budgets</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_First_Year_Budget__c</fullName>
        <label>First Year Budget</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Second_Year_Budget__c</fullName>
        <label>Second Year Budget</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Show_DCF_Modal__c</fullName>
        <defaultValue>true</defaultValue>
        <label>Show DCF Modal</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Categorywise Campaign Budget</label>
    <nameField>
        <displayFormat>CCN - {0000}</displayFormat>
        <label>Categorywise Campaign Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Categorywise Campaign Budgets</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Validate_Negative_Budget</fullName>
        <active>true</active>
        <description>Budget should not be less than Zero</description>
        <errorConditionFormula>OR(
Core_MDF_First_Year_Budget__c &lt; 0,
Core_MDF_Second_Year_Budget__c &lt; 0
)</errorConditionFormula>
        <errorMessage>Budget should not be less than Zero</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
