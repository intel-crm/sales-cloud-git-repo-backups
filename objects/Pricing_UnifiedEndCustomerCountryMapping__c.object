    <fields>
        <fullName>Pricing_Is_Sanctioned__c</fullName>
        <formula>IF(OR(
INCLUDES(Pricing_Compliance_Watch_List__c ,&apos;EC&apos;),
INCLUDES(Pricing_Compliance_Watch_List__c ,&apos;NOPAYOUT&apos;),
INCLUDES(Pricing_Compliance_Watch_List__c ,&apos;NOPAYIN&apos;),
INCLUDES(Pricing_Compliance_Watch_List__c ,&apos;PAYCOND&apos;),
INCLUDES(Pricing_Compliance_Watch_List__c ,&apos;NOTRDOUT&apos;),
INCLUDES(Pricing_Compliance_Watch_List__c ,&apos;TRDCOND&apos;),
INCLUDES(Pricing_Compliance_Watch_List__c ,&apos;NOTRDIN&apos;),
INCLUDES(Pricing_Compliance_Watch_List__c ,&apos;BLK&apos;)),true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>On Restricted Party List</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
