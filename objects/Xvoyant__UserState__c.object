    <validationRules>
        <fullName>Xvoyant__Validate_ATMOppField</fullName>
        <active>true</active>
        <description>Disallow characters that are invalid in a field name</description>
        <errorConditionFormula>NOT(REGEX(Xvoyant__ATMOppField__c, &quot;[a-zA-Z0-9_-]*&quot;))</errorConditionFormula>
        <errorDisplayField>Xvoyant__ATMOppField__c</errorDisplayField>
        <errorMessage>There are invalid characters in UserState.ATMOppField__c</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Xvoyant__Validate_ATMUserField</fullName>
        <active>true</active>
        <description>Disallow characters which are invalid in a field name</description>
        <errorConditionFormula>NOT(REGEX(Xvoyant__ATMUserField__c, &quot;[a-zA-Z0-9_-]*&quot;))</errorConditionFormula>
        <errorDisplayField>Xvoyant__ATMUserField__c</errorDisplayField>
        <errorMessage>There are invalid characters in UserState.ATMUserField__c</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
