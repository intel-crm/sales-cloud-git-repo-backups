    <deploymentStatus>Deployed</deploymentStatus>
    <description>It holds the claim ids which have been marked as Hold and has been sent for case process generartion.
This object is useful for checking all these audit hold claims which for which no case been created.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
