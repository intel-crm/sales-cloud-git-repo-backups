    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Active__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Core_MDF_Is_Active_Ind__c , IMAGE(&quot;/img/samples/flag_green.gif&quot;, &quot;Green Flag&quot;, 20, 20), &apos;&apos; )</formula>
        <label>Active</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Amount_amt__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Field to store sum of all associated Spending Target Line Item records</description>
        <label>Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_CCF_Top_Accounts_Report__c</fullName>
        <description>Field to provide a hyperlink on Top Accounts Report</description>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/lightning/r/Report/&quot;+$Label.Core_MDF_CCF_Top_Account_Version_Report_Id+&quot;/view?fv2=&quot;+ Id , &quot;Top Accounts Report&quot;, &quot;_blank&quot;)</formula>
        <label>CCF Top Accounts Report</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Comments_txt__c</fullName>
        <description>Field to store comments for Target Setting Versions</description>
        <label>Comments</label>
        <length>1000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_DCF_Top_Accounts_Report__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/lightning/r/Report/&quot;+$Label.Core_MDF_DCF_Top_Account_Version_Report_Id+&quot;/view?fv2=&quot;+ Id , &quot;Top Accounts Report&quot;, &quot;_blank&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>DCF Top Accounts Report</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_IPA_Top_Accounts_Report__c</fullName>
        <description>Field to provide a hyperlink on IPA Top Accounts Report</description>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/lightning/r/Report/&quot;+$Label.Core_MDF_IPA_Top_Account_Version_Report_Id+&quot;/view?fv2=&quot;+ Id , &quot;Top Accounts Report&quot;, &quot;_blank&quot;)</formula>
        <label>IPA Top Accounts Report</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Is_Active_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Is Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Other_Accounts_Report__c</fullName>
        <description>Field to provide a hyperlink on IPA Other Accounts Report</description>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/lightning/r/Report/&quot;+$Label.Core_MDF_IPA_Other_Account_Version_Report_Id+&quot;/view?fv2=&quot;+ Id , &quot;Other Accounts Report&quot;, &quot;_blank&quot;)</formula>
        <label>Other Accounts Report</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Spending_Targets__c</fullName>
        <label>Spending Targets</label>
        <referenceTo>Core_MDF_Target_Setting__c</referenceTo>
        <relationshipName>Spending_Targets_Junctions</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Top_Accounts_Report__c</fullName>
        <description>Field to show different Top Accounts reports based on Record types</description>
        <externalId>false</externalId>
        <formula>If(Core_MDF_Spending_Targets__r.RecordType.DeveloperName = &apos;Core_MDF_Client_Co_Marketing_Fund&apos;,  Core_MDF_CCF_Top_Accounts_Report__c, IF(Core_MDF_Spending_Targets__r.RecordType.DeveloperName = &apos;Core_MDF_Data_Center_Co_Marketing_Fund&apos;,  Core_MDF_DCF_Top_Accounts_Report__c,  IF(Core_MDF_Spending_Targets__r.RecordType.DeveloperName = &apos;Core_MDF_Intel_Partner_Alliance&apos;, Core_MDF_IPA_Top_Accounts_Report__c, &quot;&quot; )))</formula>
        <label>Top Accounts Report</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Version_nbr__c</fullName>
        <description>Field to store version number</description>
        <externalId>false</externalId>
        <label>Version</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Spending Targets Version</label>
    <nameField>
        <displayFormat>SV-{0000}</displayFormat>
        <label>Spending Targets Version Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Spending Targets Versions</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
