    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Core_MDF_Spending_Target_Version_Compact_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Core_MDF_Spending_Target_Version_Compact_Layout</fullName>
        <fields>Name</fields>
        <fields>Core_MDF_Version_nbr__c</fields>
