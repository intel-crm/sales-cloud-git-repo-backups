    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>PRM_Account_Id__c</fullName>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Please select only IPA Accounts</errorMessage>
            <filterItems>
                <field>Account.Core_Intel_Partner_Alliance_PartnerGroup__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Account Specialty Associations</relationshipLabel>
        <relationshipName>Account_Specialty_Associations</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>PRM_End_Date_Dt__c</fullName>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PRM_InActive_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Inactive Indicator</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PRM_Notes_Txt__c</fullName>
        <label>Notes</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PRM_Partner_Role__c</fullName>
        <label>Partner Role</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>PRM_Partner_Role_Nm</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>PRM_Record_Link__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot; &amp; Id, &apos;Record Link&apos;, &quot;_self&quot; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Record Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Specialty_Id__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Specialty/Select Benefit</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>You cannot assign inactive specialty to an account</errorMessage>
            <filterItems>
                <field>PRM_Specialty__c.PRM_Inactive_Ind__c</field>
                <operation>equals</operation>
                <value>False</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>PRM_Specialty__c</referenceTo>
        <relationshipLabel>Account Specialty Associations</relationshipLabel>
        <relationshipName>Account_Specialty_Associations</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PRM_Specialty_Type__c</fullName>
        <description>This is used to identify the type of Specialty/Select Benefit</description>
        <externalId>false</externalId>
        <formula>PRM_Specialty_Id__r.RecordType.Name</formula>
        <label>Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Start_Date_Dt__c</fullName>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PRM_Status_Change_Dt__c</fullName>
        <description>This is used to capture the Status change timestamp of the Specialty/Select benefit</description>
        <label>Status Change Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PRM_Status_Reason_Txt__c</fullName>
        <externalId>false</externalId>
        <label>Status Reason</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Account Specialty Association</label>
    <nameField>
        <displayFormat>ASA-{0000}</displayFormat>
        <label>Account Specialty Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Specialty Associations</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>PRM_specialty_removal</fullName>
        <active>true</active>
        <description>An error message if the user tries to remove the specific specialty benefit association.
Message to be displayed- &quot;Specialty association cannot be deleted, use the inactive indicator to remove the specialty&quot;</description>
        <errorConditionFormula>ISCHANGED( PRM_Specialty_Id__c )</errorConditionFormula>
        <errorMessage>Specialty association cannot be removed, use the inactive indicator to remove the specialty</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
