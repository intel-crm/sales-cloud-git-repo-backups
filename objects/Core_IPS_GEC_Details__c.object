    <validationRules>
        <fullName>Core_IPS_GEC_Answers_Cannot_Be_Modified</fullName>
        <active>true</active>
        <description>The GEC quesitons and answers are available as related list via lookup on the case to both the contact and internal users. They are read-only and the customer’s answers cannot be modified.</description>
        <errorConditionFormula>AND(NOT(ISNEW()),ISCHANGED(Core_IPS_GEC_Question2__c))</errorConditionFormula>
        <errorDisplayField>Core_IPS_GEC_Question2__c</errorDisplayField>
        <errorMessage>Customer’s Answers cannot be modified.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
