    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Captures Marketing Activities. Each Activity has metadata and has a group of related Opportunities.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_ART_Reference_ID__c</fullName>
        <description>Captures the ID of the corresponding Marketing Activity from ART tool.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter id of corresponding marketing activity from ART tool. There is no direct back end connection to ART tool.</inlineHelpText>
        <label>ART Reference ID</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Activity_Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Account tied to the Activity.</description>
        <inlineHelpText>Enter Account for which marketing activity is created. Select the correct account by applying partner account filter.</inlineHelpText>
        <label>Activity Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Marketing Activities</relationshipLabel>
        <relationshipName>Marketing_Activities</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Activity_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates if the Marketing Activity is active/inactive.</description>
        <inlineHelpText>Uncheck the active flag when activity has ended.</inlineHelpText>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
