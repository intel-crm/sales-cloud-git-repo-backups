    <fields>
        <fullName>PCC_L4_L5_Available_For_New_Design__c</fullName>
        <description>This field is used to check if we can bypass the filter criteria condition on MMID/Ordering cd field for approve scenario, even when Available for new design field is false .</description>
        <formula>(L4_Product__c  &lt;&gt; null &amp;&amp; ( L4_Product__r.Core_Sales_Visible_Flag__c &amp;&amp;  L4_Product__r.IsActive &amp;&amp; NOT(L4_Product__r.Core_Avail_for_New_Designs__c)))  || (L5_Product__c  &lt;&gt; null &amp;&amp;  ( L5_Product__r.Core_Sales_Visible_Flag__c &amp;&amp;  L5_Product__r.IsActive &amp;&amp; NOT(L5_Product__r.Core_Avail_for_New_Designs__c)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>L4 &amp; L5 Available For New Design</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
