    <fields>
        <fullName>L4ProductAvailable__c</fullName>
        <formula>IF(L4_Product__r.Core_Sales_Visible_Flag__c, true, false)&amp;&amp;
IF(L4_Product__r.Core_Avail_for_New_Designs__c , true, false)&amp;&amp;
IF(L4_Product__r.IsActive , true, false)&amp;&amp;
IF(L4_Product__r.Core_Avail_for_New_Designs__c , true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>L4 Product Available</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
