    <fields>
        <fullName>PMP_Event_Id__c</fullName>
        <description>Lookup to Marketplace Event.</description>
        <inlineHelpText>Lookup to Marketplace Event.</inlineHelpText>
        <label>Marketplace Event Id</label>
        <referenceTo>PMP_Marketplace_Event__c</referenceTo>
        <relationshipLabel>Marketplace Event Offerings</relationshipLabel>
        <relationshipName>Marketplace_Event_Company_Offerings</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>PMP_Offering_Id__c</fullName>
        <description>Lookup to Partner Offering.</description>
        <inlineHelpText>Lookup to Partner Offering.</inlineHelpText>
        <label>Partner Offering Id</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR 2</booleanFilter>
            <filterItems>
                <field>PMP_Partner_Offering__c.PMP_Partner_Offering_Lifecycle_Status_Nm__c</field>
                <operation>equals</operation>
                <value>Published</value>
            </filterItems>
            <filterItems>
                <field>PMP_Partner_Offering__c.PMP_Partner_Offering_Lifecycle_Status_Nm__c</field>
                <operation>equals</operation>
                <value>Approved</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>PMP_Partner_Offering__c</referenceTo>
        <relationshipLabel>Marketplace Event Offerings</relationshipLabel>
        <relationshipName>Marketplace_Event_Company_Offerings</relationshipName>
        <relationshipOrder>1</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <label>Marketplace Event Offering</label>
    <nameField>
        <displayFormat>{000}</displayFormat>
        <label>Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Marketplace Event Offerings</pluralLabel>
    <searchLayouts>
        <searchFilterFields>NAME</searchFilterFields>
