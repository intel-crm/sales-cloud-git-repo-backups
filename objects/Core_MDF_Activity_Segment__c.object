    <fields>
        <fullName>Core_MDF_Co_Marketing_Activity_Nm__c</fullName>
        <description>MD to PartnerFundRequest Object</description>
        <label>Co-Marketing Activity</label>
        <referenceTo>PartnerFundRequest</referenceTo>
        <relationshipLabel>Activity Segments</relationshipLabel>
        <relationshipName>Activity_Segments</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Estimate_Share_of_SPIF_nbr__c</fullName>
        <label>Estimated Share of SPIF ($/U)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Estimated_Share_of_SPIF_nbr__c</fullName>
        <formula>Core_MDF_Maximum_bundled_Volume_nbr__c  *  Core_MDF_Maximum_Cost_of_Bundle_nbr__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Estimated Share of SPIF (Giveaways) </label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Estimated_Value_of_Prizes_nbr__c</fullName>
