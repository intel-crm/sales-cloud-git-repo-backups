    <fields>
        <fullName>Maintenance_Ended_in_last_365_days__c</fullName>
        <formula>IF( AND((Sales_License_Maintenance_Exp_Dt__c  &gt;=  TODAY() - 365),Sales_License_Maintenance_Exp_Dt__c &lt;= TODAY()) ,true,false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Maintenance Ended in last 365 days</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Maintenance_ending_in_next_90_days__c</fullName>
        <formula>IF( AND(Sales_License_Maintenance_Exp_Dt__c &gt;= TODAY(),Sales_License_Maintenance_Exp_Dt__c &lt;= (TODAY()+90)),true,false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Maintenance ending in next 90 days</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
