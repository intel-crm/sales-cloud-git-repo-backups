    <fields>
        <fullName>Sales_License_Renewal_Stage_Nbr__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(Sales_License_Maintenance_Exp_Dt__c&gt;Today(),Sales_License_Maintenance_Exp_Dt__c-Today()&lt; 30) ,&apos;30 days&apos;,
IF(AND(Sales_License_Maintenance_Exp_Dt__c-Today()&gt;= 30, Sales_License_Maintenance_Exp_Dt__c -Today()&lt;60), &apos;60 days&apos;,
IF(Sales_License_Maintenance_Exp_Dt__c&lt;= Today(),&apos;0 days&apos;,null))
)</formula>
        <label>Renewal Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sales_License_Renewal_Status__c</fullName>
        <description>This field is used to identify if a particular License is getting Renewed</description>
        <label>License Renewal Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>N/A</fullName>
                    <default>true</default>
                    <label>N/A</label>
                </value>
                <value>
                    <fullName>License Renewed</fullName>
                    <default>false</default>
                    <label>License Renewed</label>
                </value>
                <value>
                    <fullName>License Expired</fullName>
                    <default>false</default>
                    <label>License Expired</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Sales_License_Renewed_Date__c</fullName>
