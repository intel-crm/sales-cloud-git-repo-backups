        <label>Parent License Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sales_Parent_License__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This will be populated only for Option License record when linked to existing license record on need basis.</description>
        <label>Parent License</label>
        <referenceTo>Sales_License__c</referenceTo>
        <relationshipLabel>Option Licenses</relationshipLabel>
        <relationshipName>ParentLicenses</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sales_Processed__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Processed</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Sales_Renewal_License__c</fullName>
        <formula>IF(OR(ISPICKVAL(Sales_License_Type__c, &apos;Renewal&apos;),ISPICKVAL( Sales_License_Product__r.Core_Product_Ext_Attribute_Id__r.Core_Prod_Tool_Type_Nm__c ,&apos;Renewal&apos;)),true,false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is a Renewal License. Please apply for renewal.</inlineHelpText>
        <label>Renewal License</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Sales_Renewed_Description__c</fullName>
        <externalId>false</externalId>
        <label>Renewed Description</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sales_SessionId_Bot__c</fullName>
        <externalId>false</externalId>
        <label>SessionId Bot</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sales_Tool_License_Type__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Sales_License_Product__r.Core_Product_Ext_Attribute_Id__r.Core_SW_Lic_Type_Nm__c)</formula>
        <label>Tool License Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sales_Windows_URL__c</fullName>
        <description>Windows Download URL from Product Extended Attributes</description>
        <externalId>false</externalId>
        <formula>Sales_License_Product__r.Core_Product_Ext_Attribute_Id__r.Core_SW_Lic_Windows_Download_URL_Txt__c</formula>
        <label>Windows URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>License</label>
    <listViews>
        <fullName>All_Licenses_Ext</fullName>
        <columns>NAME</columns>
        <columns>Sales_License_Activation_Code__c</columns>
        <columns>Sales_License_Product_Name_Txt__c</columns>
        <columns>Sales_License_Maintenance_Exp_Dt__c</columns>
        <columns>Sales_License_Expiration_Date_Dt__c</columns>
        <columns>Sales_License_Host_Node_Id__c</columns>
        <columns>Sales_License_Quantity__c</columns>
        <columns>Sales_License_Avbl_Qty_Nbr__c</columns>
        <columns>Sales_License_Primary_Admin_Contact_Txt__c</columns>
        <columns>Sales_License_Avbl_Rehost_Nbr__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Sales_License_Web_Display_Flag__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>Sales_License_Type__c</field>
            <operation>notEqual</operation>
            <value>Optional,Evaluation,Employee</value>
        </filters>
        <filters>
            <field>Sales_License_Maintenance_Exp_Dt__c</field>
            <operation>greaterOrEqual</operation>
            <value>1/1/2009</value>
        </filters>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>Sales_License__c.Standard_license</value>
        </filters>
        <filters>
            <field>Sales_License_Status__c</field>
            <operation>notEqual</operation>
            <value>Renewals Applied</value>
        </filters>
        <label>All Licenses</label>
        <sharedTo>
            <group>AGS_PSG_External_License_Users</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>My_Licenses</fullName>
        <columns>NAME</columns>
        <columns>Sales_License_Activation_Code__c</columns>
        <columns>Sales_License_Order__c</columns>
        <columns>Sales_License_Product__c</columns>
        <columns>Sales_License_Contract__c</columns>
        <columns>Sales_License_Maintenance_Exp_Dt__c</columns>
        <columns>Sales_License_Expiration_Date_Dt__c</columns>
        <columns>Sales_License_Type__c</columns>
        <columns>Sales_License_Quantity__c</columns>
        <columns>Sales_License_Avbl_Rehost_Nbr__c</columns>
        <columns>Sales_License_Primary_Admin_Contact__c</columns>
        <columns>Sales_License_Account__c</columns>
        <columns>Sales_License_Avbl_Qty_Nbr__c</columns>
        <columns>Sales_License_Host_Node_Id__c</columns>
        <columns>Sales_License_Lic_User_Contact_ID__c</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>Sales_License_Type__c</field>
            <operation>equals</operation>
            <value>Evaluation</value>
        </filters>
        <label>My Licenses(INTERNAL)</label>
        <sharedTo>
            <group>AGS_PSG_Internal_Users_ReadEdit</group>
            <group>AGS_PSG_Internal_Users_ReadOnly</group>
        </sharedTo>
    </listViews>
    <nameField>
        <displayFormat>L-{00000}</displayFormat>
        <label>License Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Licenses</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Standard_license</fullName>
        <active>true</active>
        <label>Standard license</label>
        <picklistValues>
            <picklist>Sales_License_Renewal_Status__c</picklist>
            <values>
                <fullName>License Expired</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>License Renewed</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>N%2FA</fullName>
                <default>true</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Sales_License_Status__c</picklist>
            <values>
                <fullName>Cancelled</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Licensed</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Merged</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Unlicensed</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Sales_License_Type__c</picklist>
            <values>
                <fullName>Add Seat</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Amend</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Amend Contract - Qty Decrease</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Employee</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Evaluation</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Optional</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Original</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Renew Contract - Qty Decrease</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Renewal</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts>
        <listViewButtons>Generate_License_by_Activation_Code</listViewButtons>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>External_User_Validation_on_License</fullName>
        <active>false</active>
        <errorConditionFormula>$Profile.Name  = &apos;Partner&apos;</errorConditionFormula>
        <errorMessage>License cannot be created by this user</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ActiveComputerAllowed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISCHANGED(Sales_License_Host_Node_Id__c), Sales_License_Host_Node_Id__r.Sales_isActiveHost__c=false,NOT(ISCHANGED( Licensed_User_Email_Address_Txt__c )),
NOT(ISCHANGED( Sales_License_PriAdm_Email__c )),
NOT(ISCHANGED(  Sales_Lic_User_Contact_Txt__c )),
NOT(ISCHANGED( Sales_License_Primary_Admin_Contact_Txt__c)),
NOT(ISCHANGED( Sales_License_Renewal_Status__c)),
NOT(ISCHANGED( Sales_License_Account_Name_Txt__c))
)</errorConditionFormula>
        <errorMessage>You cannot associate a License record to an Inactive Computer.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Avbl_Temp_Lic_Not_Allowed</fullName>
        <active>true</active>
        <errorConditionFormula>IF(AND(NOT($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c),NOT(Sales_License_Product__r.Core_Product_Ext_Attribute_Id__r.Core_SW_Prod_Temporary_Lic_Allowed_Ind__c), ISCHANGED( Sales_License_Available_Temp_Licenses__c ),NOT(ISCHANGED( Licensed_User_Email_Address_Txt__c )),
NOT(ISCHANGED( Sales_License_PriAdm_Email__c )),
NOT(ISCHANGED(  Sales_Lic_User_Contact_Txt__c )),
NOT(ISCHANGED( Sales_License_Primary_Admin_Contact_Txt__c)),
NOT(ISCHANGED( Sales_License_Renewal_Status__c)),NOT(ISCHANGED( Sales_License_Account_Name_Txt__c)) ), true, false)</errorConditionFormula>
        <errorDisplayField>Sales_License_Available_Temp_Licenses__c</errorDisplayField>
        <errorMessage>The OPN is not allowed to have temporary license</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Avlbl_Temp_Lic_Cannot_Be_Greater</fullName>
        <active>true</active>
        <description>The available temporary license on the record cannot b greater than # of seats if OPN is marked available for Temporary Licenses</description>
        <errorConditionFormula>IF(AND(NOT($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c),Sales_License_Product__r.Core_Product_Ext_Attribute_Id__r.Core_SW_Prod_Temporary_Lic_Allowed_Ind__c, Sales_License_Available_Temp_Licenses__c &gt;  Sales_License_Quantity__c,NOT(ISCHANGED( Licensed_User_Email_Address_Txt__c )),
NOT(ISCHANGED( Sales_License_PriAdm_Email__c )),
NOT(ISCHANGED(  Sales_Lic_User_Contact_Txt__c )),
NOT(ISCHANGED( Sales_License_Primary_Admin_Contact_Txt__c)),
NOT(ISCHANGED( Sales_License_Renewal_Status__c)),NOT(ISCHANGED( Sales_License_Account_Name_Txt__c)) ), true, false)</errorConditionFormula>
        <errorDisplayField>Sales_License_Available_Temp_Licenses__c</errorDisplayField>
        <errorMessage>The number of available temporary licenses cannot be greater than the # of seats</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Cannot_Change_Host_As_Diff_Lic_Typ</fullName>
        <active>true</active>
        <description>Primary Computer cannot be updated as the Computer&apos;s License Type is different</description>
        <errorConditionFormula>AND(
NOT(ISBLANK(Sales_License_Host_Node_Id__c)),
ISCHANGED(Sales_License_Host_Node_Id__c),
OR(
AND(
OR(Sales_Tool_License_Type__c=&apos;N-A&apos;, Sales_Tool_License_Type__c=&apos;FLOAT&apos;),
TEXT(Sales_License_Host_Node_Id__r.Sales_License_Type__c)!=&apos;FLOAT&apos;
),
AND(Sales_Tool_License_Type__c=&apos;FIXED&apos;, TEXT(Sales_License_Host_Node_Id__r.Sales_License_Type__c)!=&apos;FIXED&apos;)
),NOT(ISCHANGED( Licensed_User_Email_Address_Txt__c )),
NOT(ISCHANGED( Sales_License_PriAdm_Email__c )),
NOT(ISCHANGED(  Sales_Lic_User_Contact_Txt__c )),
NOT(ISCHANGED( Sales_License_Primary_Admin_Contact_Txt__c)),
NOT(ISCHANGED( Sales_License_Renewal_Status__c)),
NOT(ISCHANGED( Sales_License_Account_Name_Txt__c))
)</errorConditionFormula>
        <errorDisplayField>Sales_License_Host_Node_Id__c</errorDisplayField>
        <errorMessage>For License Tool Type as FIXED, you can select Host with FIXED License Type / For  License Tool Type as FLOAT or N-A, you can select Host with FLOAT License Type &amp; For License Tool Type as NEUTRAL, you can select Host with FIXED/FLOAT License Type.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ExtUsr_Cannot_Update_PrimaryAdmin</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
	ISPICKVAL($User.UserType,&apos;PowerPartner&apos;), 
	NOT(ISBLANK(Priorvalue(Sales_License_Primary_Admin_Contact__c ))),
	ISCHANGED(Sales_License_Primary_Admin_Contact__c)
)</errorConditionFormula>
        <errorMessage>You cannot update this license at the moment. Please reach out to IT Team for support</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Validate_Account</fullName>
        <active>true</active>
        <description>Account should be Intel Account</description>
        <errorConditionFormula>IF(
AND(
NOT(ISBLANK(Sales_License_Account__c)),
NOT($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c),
ISBlank(Sales_Legacy_License_Id__c),(Sales_License_Account__r.RecordType.DeveloperName =&apos;Core_Direct_Account&apos;),NOT(ISCHANGED( Licensed_User_Email_Address_Txt__c )),
NOT(ISCHANGED( Sales_License_PriAdm_Email__c )),
NOT(ISCHANGED(  Sales_Lic_User_Contact_Txt__c )),
NOT(ISCHANGED( Sales_License_Primary_Admin_Contact_Txt__c)),
NOT(ISCHANGED( Sales_License_Renewal_Status__c)),
NOT(ISCHANGED( Sales_License_Account_Name_Txt__c))
),
true,
false
)</errorConditionFormula>
        <errorDisplayField>Sales_License_Account__c</errorDisplayField>
        <errorMessage>Please select a valid Intel Account</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Generate_License_by_Activation_Code</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Find and Generate License by Activation Code</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>&quot;lightning/cmp/&quot;</url>
    </webLinks>
</CustomObject>
