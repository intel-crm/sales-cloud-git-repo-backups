    <fields>
        <fullName>Sales_License_Web_Display_Flag__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Web Display Flag</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Sales_Licensed_User_Email_Address__c</fullName>
        <externalId>false</externalId>
        <formula>Sales_License_Lic_User_Contact_ID__r.Email</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Licensed User Email Address</label>
