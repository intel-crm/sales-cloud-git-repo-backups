        <externalId>false</externalId>
        <formula>Sales_License_Product__r.Core_Product_Ext_Attribute_Id__r.Core_SW_Lic_Linux_Download_URL_Txt__c</formula>
        <label>Linux URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
