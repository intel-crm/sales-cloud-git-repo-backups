        <fullName>Sales_License_Type__c</fullName>
        <inlineHelpText>For License Record Type “Original” mandatorily populate “Order” and “Order Product” fields</inlineHelpText>
        <label>License  Record Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Original</fullName>
                    <default>false</default>
                    <label>Original</label>
                </value>
                <value>
                    <fullName>Renewal</fullName>
                    <default>false</default>
                    <label>Renewal</label>
                </value>
                <value>
                    <fullName>Amend</fullName>
                    <default>false</default>
                    <label>Amend</label>
                </value>
                <value>
                    <fullName>Optional</fullName>
                    <default>false</default>
                    <label>Optional</label>
                </value>
                <value>
                    <fullName>Evaluation</fullName>
                    <default>false</default>
                    <label>Evaluation</label>
                </value>
                <value>
                    <fullName>Add Seat</fullName>
                    <default>false</default>
                    <label>Add Seat</label>
                </value>
                <value>
                    <fullName>Amend Contract - Qty Decrease</fullName>
                    <default>false</default>
                    <label>Amend Contract - Qty Decrease</label>
                </value>
                <value>
                    <fullName>Renew Contract - Qty Decrease</fullName>
                    <default>false</default>
                    <label>Renew Contract - Qty Decrease</label>
                </value>
