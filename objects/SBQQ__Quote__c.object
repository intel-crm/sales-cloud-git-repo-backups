    <validationRules>
        <fullName>Block_AE_to_Edit_For_Submitted_Quotes</fullName>
        <active>true</active>
        <description>Editing is not permitted by Account Executives or ITS&apos;s after quote or quote line is submitted for approval.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Client_Quote_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Client_Quote_ReadOnly&apos;),
OR($Permission.Tender_Account_Executive,
$Permission.Pricing_Tender_IT_Specialist), 
OR(
ISCHANGED( Pricing_Customer_Nm__c),
ISCHANGED( Pricing_Project_Name_Nm__c),
ISCHANGED( Pricing_Server_Deal_Type_Nm__c),
ISCHANGED( Pricing_ShipmentStDate_Dt__c),
ISCHANGED( Pricing_ShipmentEndDate_Dt__c),
ISCHANGED( Pricing_Intel_Sales_Rep_Email_Txt__c )
),
 NOT( ISNEW()) 
)</errorConditionFormula>
        <errorMessage>Editing is not permitted by Account Executives or ITS&apos;s after quote or quote line is submitted for approval.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Email_Validation_Intel_Dot_Com_For_AE</fullName>
        <active>true</active>
        <description>Valid Intel email validation</description>
        <errorConditionFormula>AND(
OR(
ISPICKVAL(Pricing_Quote_Program_Nm__c , &quot;Tender&quot;),
ISPICKVAL(Pricing_Quote_Program_Nm__c , &quot;Financial Incentive&quot;)
),
OR(
ISCHANGED(Pricing_Intel_Account_Exec_Email_Txt__c),
ISNEW()
),
NOT(ISBLANK(Pricing_Intel_Account_Exec_Email_Txt__c)),
NOT(REGEX ( UPPER ( Pricing_Intel_Account_Exec_Email_Txt__c ) ,&quot;.*@INTEL\\.COM&quot;))
)</errorConditionFormula>
        <errorDisplayField>Pricing_Intel_Account_Exec_Email_Txt__c</errorDisplayField>
        <errorMessage>Please enter the email address for the Intel employee who is the Account Executive. If no Account Executive is covering this end customer, please leave this field blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Email_Validation_for_INTEL_COM</fullName>
        <active>true</active>
        <description>Email Validation for INTEL.COM</description>
        <errorConditionFormula>AND(
OR(
ISPICKVAL( Pricing_Quote_Program_Nm__c , &quot;Tender&quot;),
ISPICKVAL( Pricing_Quote_Program_Nm__c , &quot;Financial Incentive&quot;)
),
OR(
  ISCHANGED(Pricing_Intel_Sales_Rep_Email_Txt__c), 
  ISNEW()
),
NOT(ISBLANK(Pricing_Intel_Sales_Rep_Email_Txt__c)),
NOT(REGEX ( UPPER ( Pricing_Intel_Sales_Rep_Email_Txt__c) ,&quot;.*@INTEL\\.COM&quot;))
)</errorConditionFormula>
        <errorDisplayField>Pricing_Intel_Sales_Rep_Email_Txt__c</errorDisplayField>
        <errorMessage>Please enter the email address for the Sales Rep at Intel for your account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_CM_Name_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(ISPICKVAL(SBQQ__Status__c, &apos;Rejected&apos;)),
   (core_cpq_active_cb__c = true),
OR(
          $RecordType.Name = &quot;PSG Quote - New&quot;, 
          $RecordType.Name = &quot;PSG Quote - Read Only&quot;, 
          $RecordType.Name = &quot;PSG Quote - Submitted&quot;,
          $RecordType.Name = &quot;PSG Quote - Inactive&quot;,
          $RecordType.Name = &quot;PSG Quote - Cancelled&quot;,
          $RecordType.Name = &quot;PSG Quote - Contract Pricing&quot;
),
NOT( INCLUDES( core_cpq_cm_name_nm__r.Core_Account_BU_Focus__c , &apos;PSG-CM&apos;) ),
NOT(ISBLANK(core_cpq_cm_name_nm__c)),
NOT(ISNULL(core_cpq_cm_name_nm__c)),
ISPickval(SBQQ__Type__c ,&apos;Quote&apos;)
)</errorConditionFormula>
        <errorDisplayField>core_cpq_cm_name_nm__c</errorDisplayField>
        <errorMessage>Contract Manufacturer Account selected is invalid.
Please verify and re-select the appropriate Contract Manufacturer Account or contact your system admin.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_CP_Quote_Edit_Blocked_For_SOS</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
( $Permission.PSG_Internal_SOS ),
ISPickval(SBQQ__Type__c ,&apos;Quote&apos;),
ISPICKVAL( Pricing_Quote_Program_Nm__c,&apos;PSG&apos;),
ISPICKVAL(  core_cpq_quote_type_nm__c ,&apos;Contract Pricing&apos;)
)</errorConditionFormula>
        <errorMessage>SOS can&apos;t Create/Modify a Contract Pricing Quote.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Distributor_Account_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
	NOT(ISPICKVAL(SBQQ__Status__c, &apos;Rejected&apos;)),
   (core_cpq_active_cb__c = true),
OR(
$RecordType.Name = &quot;PSG Quote - New&quot;,
$RecordType.Name = &quot;PSG Quote - Read Only&quot;,
$RecordType.Name = &quot;PSG Quote - Submitted&quot;,
$RecordType.Name = &quot;PSG Quote - Inactive&quot;,
$RecordType.Name = &quot;PSG Quote - Cancelled&quot;,
$RecordType.Name = &quot;PSG Quote - Contract Pricing&quot;

),
OR(NOT(SBQQ__Distributor__r.RecordType.Name == &apos;Intel Account&apos;),
NOT( INCLUDES( SBQQ__Distributor__r.Core_Account_BU_Focus__c, &apos;PSG-DISTI&apos;) ),
NOT( SBQQ__Distributor__r.Core_PSG_Account__c  == true)
),
NOT(ISBLANK(SBQQ__Distributor__c)),
NOT(ISNULL(SBQQ__Distributor__c)),
ISPickval(SBQQ__Type__c ,&apos;Quote&apos;),
ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;PSG&apos;)
)</errorConditionFormula>
        <errorDisplayField>SBQQ__Distributor__c</errorDisplayField>
        <errorMessage>Distributor Account selected is invalid.
Please verify and re-select the appropriate Distributor Account or contact your system admin.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_End_Customer_Account_Check</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
OR(
$RecordType.Name = &quot;PSG Quote - New&quot;,
$RecordType.Name = &quot;PSG Quote - Read Only&quot;,
$RecordType.Name = &quot;PSG Quote - Submitted&quot;,
$RecordType.Name = &quot;PSG Quote - Inactive&quot;,
$RecordType.Name = &quot;PSG Quote - Cancelled&quot;
),
NOT(ISBLANK(core_cpq_end_customer_nm__c)),
NOT(ISNULL(core_cpq_end_customer_nm__c)),
NOT( INCLUDES( core_cpq_end_customer_nm__r.Core_Account_Type__c , &apos;End Customer&apos;) ),
NOT( $Permission.PSG_External_Disty ),
ISPickval(SBQQ__Type__c ,&apos;Quote&apos;)
)</errorConditionFormula>
        <errorDisplayField>core_cpq_end_customer_nm__c</errorDisplayField>
        <errorMessage>Selected account is not a valid End Customer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Expiry_Date_check</fullName>
        <active>false</active>
        <description>Checks that the Quote expiry date doesn&apos;t falls below the Quote created date.</description>
        <errorConditionFormula>AND(
OR(
$RecordType.Name = &quot;PSG Quote - New&quot;,
$RecordType.Name = &quot;PSG Quote - Read Only&quot;,
$RecordType.Name = &quot;PSG Quote - Submitted&quot;,
$RecordType.Name = &quot;PSG Quote - Inactive&quot;,
$RecordType.Name = &quot;PSG Quote - Cancelled&quot;,
$RecordType.Name = &quot;PSG Quote - Approved&quot;
),
(core_cpq_quote_expiry_dt__c) &lt;  DATEVALUE(CreatedDate),
NOT($Permission.PSG_External_Disty ),
ISPickval(SBQQ__Type__c ,&apos;Quote&apos;),
ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;PSG&apos;)
)</errorConditionFormula>
        <errorDisplayField>core_cpq_quote_expiry_dt__c</errorDisplayField>
        <errorMessage>Expiry date cannot be less than the Quote created date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_In_Progress_Disable_Edit_For_Disty</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPickval(SBQQ__Type__c ,&apos;Quote&apos;),
ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;PSG&apos;),
	$Permission.PSG_External_Disty, 
	ISCHANGED(SBQQ__Status__c),
	OR(
		AND(
			ISPICKVAL(SBQQ__Status__c, &apos;New&apos;),
			ISPICKVAL(PRIORVALUE(SBQQ__Status__c),&quot;In Progress&quot;)
		),
		AND(
			ISPICKVAL(SBQQ__Status__c, &apos;Pending&apos;),
			ISPICKVAL(PRIORVALUE(SBQQ__Status__c),&quot;In Progress&quot;)
		)
	)
)</errorConditionFormula>
        <errorMessage>Quote has been updated. Please refresh.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_In_Review_Blocked_For_SOS</fullName>
        <active>true</active>
        <description>In-Review Quotes Cannot be edited by SOS</description>
        <errorConditionFormula>AND(
( $Permission.PSG_Internal_SOS ),
NOT(ISNEW()),
ISPickval(SBQQ__Type__c ,&apos;Quote&apos;),
ISPICKVAL( Pricing_Quote_Program_Nm__c,&apos;PSG&apos;),
ISPICKVAL( SBQQ__Status__c ,&apos;In Review&apos;),
OR( ISCHANGED( core_cpq_name_nm__c ),
 ISCHANGED( core_cpq_end_customer_nm__c ),
 ISCHANGED( SBQQ__Distributor__c ),
ISCHANGED( core_cpq_price_book_nm__c ) ,
 ISCHANGED( core_cpq_cm_name_nm__c ),
 ISCHANGED( SBQQ__Opportunity2__c ) ,
 ISCHANGED( core_cpq_business_unit_nm__c ),
 ISCHANGED( core_cpq_comments_to_disty_txt__c ),
 ISCHANGED( core_cpq_margin_geo_txt__c ),
 ISCHANGED( SBQQ__StartDate__c ),
 ISCHANGED( SBQQ__EndDate__c ),
 ISCHANGED( SBQQ__ContractingMethod__c ),
 ISCHANGED( SBQQ__Ordered__c ),
 ISCHANGED( SBQQ__OrderByQuoteLineGroup__c ),
ISCHANGED( Sales_Renewed_from_Contract_Id__c )
))</errorConditionFormula>
        <errorMessage>You Don&apos;t Have Edit Permission for Quotes in &apos;In Review&apos; Status. Recall the Quote to proceed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Prevent_Creating_Quote_DistyList</fullName>
        <active>true</active>
        <description>Prevent editing a quote from disty list view if mandatory field in not blank</description>
        <errorConditionFormula>AND(
$Permission.PSG_External_Disty,
ISPickval(SBQQ__Type__c ,&apos;Quote&apos;),
ISPICKVAL( Pricing_Quote_Program_Nm__c,&apos;PSG&apos;),
OR(
$RecordType.Name = &quot;PSG Quote - New&quot;,
$RecordType.Name = &quot;PSG Quote - Read Only&quot;,
$RecordType.Name = &quot;PSG Quote - Submitted&quot;,
$RecordType.Name = &quot;PSG Quote - Inactive Quotes&quot;,
$RecordType.Name = &quot;PSG Quote - Cancelled&quot;,
$RecordType.Name = &quot;PSG Quote - Approved&quot;

),
NOT(ISBLANK(core_cpq_mandatory_field__c))
)</errorConditionFormula>
        <errorMessage>please do not use this screen.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Quote_Type_Equivalent_To_Parent</fullName>
        <active>false</active>
        <description>Quote Types should have equivalent approved Design Win Quotes as Parent Quotes when child Quote type is changed to &quot;Transfer Quote&quot; or &quot;Contract Admin&quot;.</description>
        <errorConditionFormula>AND(
OR(RecordType.DeveloperName = &apos;PSG_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;PSG_Quote_New&apos;),
ISCHANGED(core_cpq_quote_type_nm__c),
OR(ISPICKVAL(core_cpq_quote_type_nm__c, &apos;Transfer Pricing&apos;),
ISPICKVAL(core_cpq_quote_type_nm__c, &apos;Admin&apos;)),
NOT( ISBLANK(core_cpq_original_quote__c) ),
NOT(ISPICKVAL(core_cpq_original_quote__r.core_cpq_quote_type_nm__c , &apos;Transfer Pricing&apos;))
)</errorConditionFormula>
        <errorMessage>Quote Types should have equivalent Design Win Quotes as Parent Quotes.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Restrict_Quote_Edit</fullName>
        <active>false</active>
        <description>It restricts users from creating new record and editing existing records during freeze period.</description>
        <errorConditionFormula>AND(
OR(
 ISNEW() ,
 !ISNULL( PRIORVALUE(Id) ) 
),
 ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;PSG&apos;) 
)</errorConditionFormula>
        <errorDisplayField>core_cpq_years_nbr__c</errorDisplayField>
        <errorMessage>Quote Record cannot be created or edited during Freeze Period!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Start_Date_End_Date_Mandatory</fullName>
        <active>true</active>
        <description>Start date and end date is mandatory for Tools Quote</description>
        <errorConditionFormula>AND
(  NOT( $Permission.PSG_External_Disty ),
   NOT(ISNEW()),
   NOT(ISPICKVAL(SBQQ__Status__c, &apos;Rejected&apos;)),
   core_cpq_corporate_flag__c =true,
   (core_cpq_active_cb__c = true),
NOT(isClone()),
   NOT(ISCHANGED(core_cpq_invalid_opn_ta__c)),
   NOT(ISCHANGED(core_cpq_dup_designwin_opns__c)),
   ISPICKVAL(core_cpq_quote_type_nm__c, &apos;Tools&apos;),
   ISPICKVAL(SBQQ__Type__c, &apos;Quote&apos;),
   ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;PSG&apos;),
   OR(
         ISNULL(SBQQ__StartDate__c),
         ISNULL( SBQQ__EndDate__c),
         ISBLANK(SBQQ__StartDate__c),
         ISBLANK(SBQQ__EndDate__c) 
      )
)</errorConditionFormula>
        <errorMessage>Start Date and End Date is mandatory for Corporate Tools Quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Bid_Date_Check</fullName>
        <active>true</active>
        <description>Proposal Due Date cannot be a date in the past on Quote create</description>
        <errorConditionFormula>AND(
OR(
  RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
  RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
  RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
  RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
  RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
  RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
  RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
OR(
  ISCHANGED(Pricing_Bid_Dt__c), 
  ISNEW()
),
Pricing_Bid_Dt__c &lt; TODAY()
)</errorConditionFormula>
        <errorDisplayField>Pricing_Bid_Dt__c</errorDisplayField>
        <errorMessage>The Proposal Due Date has already passed. Please enter a Proposal Due Date more than one day in the future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_EndCustomerURLEditonReadOnlyPage</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT( $Permission.Pricing_IQR_Business_User_Admin ), ISCHANGED(Pricing_End_Customer_URL__c),OR(RecordType.DeveloperName = &apos;Pricing_Tender_Client_Quote_ReadOnly&apos;,RecordType.DeveloperName = &apos;Pricing_Tender_Quote_ReadOnly&apos;) )</errorConditionFormula>
        <errorMessage>End Customer URL field is not editable when quote is in Won/Lost/Approved Status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ExcludeRes_QuotaExclude_ChgCheck</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
OR(
AND(
!ISCHANGED(Pricing_Exclude_from_Volume_Excep_Quota__c),
Pricing_Exclude_from_Volume_Excep_Quota__c = true,
ISCHANGED(Pricing_Quota_Exclusion_Reason__c),
ISPICKVAL(Pricing_Quota_Exclusion_Reason__c, &apos;&apos;)
),
AND(
!ISCHANGED(Pricing_Quota_Exclusion_Reason__c),
!ISPICKVAL(Pricing_Quota_Exclusion_Reason__c, &apos;&apos;),
ISCHANGED(Pricing_Exclude_from_Volume_Excep_Quota__c),
Pricing_Exclude_from_Volume_Excep_Quota__c = false
)
)
)</errorConditionFormula>
        <errorMessage>Quota Exclusion Reason cannot be blank or changed when Exclude from Volume Exception Quota is checked or Exclude from Volume Exception Quota cannot be unchecked when Quota Exclusion Reason is not blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_HoldStatus_RestrictUpdate</fullName>
        <active>true</active>
        <description>Quote cannot be edited while On Hold.</description>
        <errorConditionFormula>AND( ISPICKVAL(Pricing_Quote_Program_Nm__c , &apos;Tender&apos;),
 OR( $Permission.Tender_User ,
   $Permission.Tender_Account_Executive ,
   $Permission.Pricing_Tender_Regional_Pricing_Manager ,
   $Permission.Pricing_Tender_IT_Specialist) ,
 Pricing_On_Hold_Cb__c = true,
 OR( ISCHANGED(Pricing_Account_Division_Nm__c),
   ISCHANGED(Pricing_Customer_Nm__c) ,
   ISCHANGED(Pricing_End_Customer__c),
   ISCHANGED(Pricing_End_Customer_Country_Nm__c),
   ISCHANGED(Pricing_Region_Nm__c),
   ISCHANGED(Pricing_Market_Segment_values_Nm__c),
   ISCHANGED(Pricing_Server_Deal_Type_Nm__c),
   ISCHANGED(Pricing_Project_Name_Nm__c),
   ISCHANGED(Pricing_Intel_Response_Requested_By_Date__c),
   ISCHANGED(Pricing_Bid_Dt__c),
   ISCHANGED(Pricing_ShipmentStDate_Dt__c),
   ISCHANGED(Pricing_ShipmentEndDate_Dt__c),
   ISCHANGED(SBQQ__PrimaryContact__c),
   ISCHANGED(Pricing_SecondaryContact_Nm__c),
   ISCHANGED(Pricing_Intel_Sales_Rep_Email_Txt__c),
   ISCHANGED(Pricing_Intel_Account_Exec_Email_Txt__c),
   ISCHANGED(Pricing_End_Customer_Opportunity_Txt__c),
   ISCHANGED(SBQQ__Opportunity2__c),
   ISCHANGED(Pricing_My_Deals_Folio_Name_Nm__c)
))</errorConditionFormula>
        <errorMessage>Quote cannot be edited while On Hold.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_IntelResponseDtProposalDt_Check</fullName>
        <active>true</active>
        <description>Intel Response Requested By Date cannot be later than Proposal Due Date.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;
),
OR(
ISCHANGED(Pricing_Intel_Response_Requested_By_Date__c),
ISCHANGED( Pricing_Bid_Dt__c ),
ISNEW()
),
Pricing_Intel_Response_Requested_By_Date__c &gt; Pricing_Bid_Dt__c
)</errorConditionFormula>
        <errorDisplayField>Pricing_Intel_Response_Requested_By_Date__c</errorDisplayField>
        <errorMessage>Intel Response Requested By Date cannot be later than Proposal Due Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_IntelResponseReqByDate_Check</fullName>
        <active>true</active>
        <description>Intel Response Requested By Date cannot be a date in the past on Quote create</description>
        <errorConditionFormula>AND(
OR(
  RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
  RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
  RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
  RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
  RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
  RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
  RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
OR(
  ISCHANGED(Pricing_Intel_Response_Requested_By_Date__c), 
  ISNEW()
),
Pricing_Intel_Response_Requested_By_Date__c &lt; TODAY()
)</errorConditionFormula>
        <errorDisplayField>Pricing_Intel_Response_Requested_By_Date__c</errorDisplayField>
        <errorMessage>The Intel Response Requested By Date has already passed. Please enter a Intel Response Requested By Date more than one day in the future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_MandateReason_OnPricingMgrEdit</fullName>
        <active>true</active>
        <description>This validation rule is to restrict the save of quote when the Pricing Manager is updated without giving the Re-routing Reason and Vice Versa.</description>
        <errorConditionFormula>AND($Permission.Pricing_Tender_Regional_Pricing_Manager,ISCHANGED(Pricing_Pricing_Manager__c), ISBLANK (TEXT(Pricing_ReRouting_Reason_Nm__c)),  NOT( ISCHANGED(Pricing_Route_Rule_Name_Txt__c)))</errorConditionFormula>
        <errorMessage>Please provide a reason for re-routing the quote.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_MarketSegment_Validation</fullName>
        <active>true</active>
        <description>Market Segment cannot be edited after deal is created in My Deals.</description>
        <errorConditionFormula>AND(
OR(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
$Permission.Tender_User
),
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;,
NOT(ISBLANK(Pricing_Folio_ID_Nm__c)),
ISCHANGED(Pricing_Market_Segment_values_Nm__c),
NOT(ISNEW())
)</errorConditionFormula>
        <errorMessage>Market Segment cannot be edited after deal is created in My Deals.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_MultipleEmailCheck</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_ReadOnly&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_ReadOnly&apos;
),
OR(
ISCHANGED(Pricing_AdditionalRecipients__c ),
ISNEW()
),
NOT(ISBLANK(Pricing_AdditionalRecipients__c )),
OR(   
NOT(   
REGEX( Pricing_AdditionalRecipients__c , &quot;(\\s*[a-zA-Z0-9+._-]+@[a-zA-Z0-9+._-]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)(;\\s*[a-zA-Z0-9+._-]+@[a-zA-Z0-9+._-]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)*&quot;)
),   
RIGHT(  Pricing_AdditionalRecipients__c , 1 ) = &quot;;&quot;,
CONTAINS(Pricing_AdditionalRecipients__c , &quot;@intel.com&quot;)  
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_AdditionalRecipients__c</errorDisplayField>
        <errorMessage>Value must be one or multiple email addresses separated by semi-colons. Intel email addresses are not allowed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_PricingMgrEdit_Restriction</fullName>
        <active>true</active>
        <description>This validation rule is to restrict the save of quote when the Pricing Manager is updated by Tender User Instead of Pricing Manager.</description>
        <errorConditionFormula>AND(NOT($Permission.Pricing_Tender_Regional_Pricing_Manager),OR(ISCHANGED (Pricing_Pricing_Manager__c),ISCHANGED( Pricing_ReRouting_Reason_Nm__c)),NOT(ISCHANGED( Pricing_Route_Rule_Name_Txt__c)))</errorConditionFormula>
        <errorMessage>Pricing Manager and Re-Routing Reason is not editable for your role.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_QuotaExclude_ExcludeReason_Check</fullName>
        <active>true</active>
        <description>Quota Exclusion Reason and Exclude from Volume Exception cannot be changed when Volume Exception Quota is false</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
Pricing_Volume_Exception_Quota_Cb__c = false,
OR(
AND(
ISCHANGED(Pricing_Exclude_from_Volume_Excep_Quota__c),
Pricing_Exclude_from_Volume_Excep_Quota__c = true
),
AND(
ISCHANGED(Pricing_Quota_Exclusion_Reason__c),
!ISPICKVAL(Pricing_Quota_Exclusion_Reason__c, &apos;&apos;)
)
)
)</errorConditionFormula>
        <errorMessage>Exclude from Volume Exception Quota cannot be checked and Quota Exclusion Reason cannot have value when Volume Exception Quota is unchecked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_QuoteComments_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(RecordType.DeveloperName =&apos;Pricing_Financial_Incentive_Quote_Submitted&apos;
,RecordType.DeveloperName=&apos;Pricing_Financial_Incentive_Quote_Read_Only&apos;)
,LEN( Pricing_Deal_description__c ) &lt; 10 || LEN( Pricing_Competition_Assumptions__c ) &lt; 10 || LEN( Pricing_Current_EndCustomer_Product_Prvd__c ) &lt; 2 || LEN( Pricing_Consumption_Countries__c ) &lt; 2)</errorConditionFormula>
        <errorMessage>Your entry is too short! Minimum 10 characters required for &quot;Deal description&quot; and &quot;Competition Assumptions&quot; and 2 characters required for &quot;Current End Customer Product Provider&quot; and &quot;Consumption Countries&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_QuoteRestrict_AfterRejection_RPM</fullName>
        <active>true</active>
        <description>Editing is not permitted for Rejected quote once the folio has been created in My Deals.</description>
        <errorConditionFormula>AND(
OR(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
$Permission.Tender_User 
), 
OR( 
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
NOT(ISBLANK(Pricing_Folio_ID_Nm__c)), 
OR(
ISCHANGED( Pricing_Customer_Nm__c),
ISCHANGED( Pricing_Project_Name_Nm__c),
ISCHANGED( Pricing_Server_Deal_Type_Nm__c),
ISCHANGED( Pricing_ShipmentStDate_Dt__c),
ISCHANGED( Pricing_ShipmentEndDate_Dt__c),
ISCHANGED( Pricing_My_Deals_Folio_Name_Nm__c),
ISCHANGED( Pricing_End_Customer__c ),
ISCHANGED( Pricing_End_Customer_URL__c)
),
NOT( ISNEW())
)</errorConditionFormula>
        <errorMessage>Editing is not permitted for Rejected quote once the folio has been created in My Deals.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Restrict_AE_Edit_Primary_Contact</fullName>
        <active>true</active>
        <description>Editing Primary Contact is not permitted by Account Executives at this stage.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_ReadOnly&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_ReadOnly&apos;
),
$Permission.Tender_Account_Executive,
ISCHANGED(SBQQ__PrimaryContact__c ),
NOT( ISNEW()) 
)</errorConditionFormula>
        <errorMessage>You do not have permission to edit at this Quote stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Restrict_New_SVD_Quotes</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISNEW(), CONTAINS(TEXT(Pricing_Program_Type_Nm__c), $Label.Pricing_Tender_Small_Volume_Quote),NOT($CustomMetadata.Trigger_Execution__mdt.Pricing_SVD_Quote_Disabled.Active__c))</errorConditionFormula>
        <errorMessage>Small Volume Quote creation is no longer supported.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Restrict_Reference_Request_ID</fullName>
        <active>true</active>
        <description>Don&apos;t allow Drafter user and Drafter Jr. to edit the Reference Request ID after submission.</description>
        <errorConditionFormula>AND(
ISCHANGED(Pricing_Customer_Reference_Id__c),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_ReadOnly&apos;,
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_ReadOnly&apos;),
OR(
$Permission.Tender_Partner_Drafter_Access,
$Permission.Tender_Partner_Drafter_Limited_Access)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Customer_Reference_Id__c</errorDisplayField>
        <errorMessage>Your role does not allow editing Reference Request ID after the quote has been submitted to Intel.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SVD_EndCustomeRegion_Restrict</fullName>
        <active>true</active>
        <description>For End Customer Region PRC, SVD is not allowed.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
AND(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,   ISPICKVAL(Pricing_Program_Type_Nm__c , &apos;Small Volume Quotes - Data Center Xeon® CPU&apos;)
)
),
OR(
ISNEW(),
ISCHANGED(Pricing_Region_Nm__c),
ISCHANGED( Pricing_End_Customer_Country_Nm__c)
),
AND(
NOT(ISBLANK(TEXT(Pricing_Region_Nm__c))),
ISPICKVAL(Pricing_Region_Nm__c , &apos;PRC&apos;)
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Region_Nm__c</errorDisplayField>
        <errorMessage>Small Volume Quotes - Data Center Xeon® CPU is not allowed for PRC region.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Accepted_but_not_Primary</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(ISCHANGED(SBQQ__Status__c),ISCHANGED(SBQQ__Primary__c)),
NOT(ISNEW()),ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;),
 ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &apos;Approved&apos;),ISPICKVAL(SBQQ__Status__c, &apos;Accepted&apos;), NOT(SBQQ__Primary__c = True))</errorConditionFormula>
        <errorMessage>Please update Primary checkbox as True to change Status as Accepted.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Additional_Discount_0_to_100</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;), ISCHANGED(SBQQ__CustomerDiscount__c),  OR(SBQQ__CustomerDiscount__c  &lt; 0,SBQQ__CustomerDiscount__c  &gt; 1))</errorConditionFormula>
        <errorMessage>Additional Discount % should be in between 0 - 100</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Custom_Product_Flag_Price_0</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;),Pricing_SW_Custom_Product__c = True, ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &apos;Draft&apos;),OR(ISPICKVAL(SBQQ__Status__c, &apos;In Review&apos;),ISPICKVAL(SBQQ__Status__c, &apos;Approved&apos;)))</errorConditionFormula>
        <errorMessage>Price required for Custom workload. Contact SWDealDesk@intel.com for price entry</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Expiry_Date_14_days_or_less</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Pricing_Sw_Validation_Bypass__c.By_Pass_Validation__c==true, False, AND( OR(ISNEW(),
ISCHANGED(Pricing_SW_Expiry_Date__c)),NOT(ISCLONE()),ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;),
 OR(Pricing_SW_Expiry_Date__c &lt; TODAY()+14,Pricing_SW_Expiry_Date__c = TODAY())))</errorConditionFormula>
        <errorDisplayField>Pricing_SW_Expiry_Date__c</errorDisplayField>
        <errorMessage>Expiry Date Should be 14 days greater than today</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_FinalStatus</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISNEW()),ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;),
OR(
AND(ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &apos;Accepted&apos;),ISCHANGED(SBQQ__Status__c)),
AND(ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &apos;Accepted&apos;),ISCHANGED(Pricing_SW_Expiry_Date__c)),
AND(ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &apos;Denied&apos;),ISCHANGED(SBQQ__Primary__c),SBQQ__Primary__c = True),
AND(ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &apos;Rejected&apos;),NOT(ISCHANGED(Pricing_SW_Approval_Comments__c)),ISCHANGED(SBQQ__Primary__c),SBQQ__Primary__c = True),
AND(ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &apos;Denied&apos;),ISCHANGED(SBQQ__Status__c)),
AND(ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &apos;Rejected&apos;),ISCHANGED(SBQQ__Status__c))
)
)</errorConditionFormula>
        <errorMessage>No changes allowed on Quote when Quote Status is Accepted/Denied/Rejected</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Restrict_DirectQuote_creation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISNEW(), ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Software &amp; Services&apos;) , ISBLANK( SBQQ__Opportunity2__c ) )</errorConditionFormula>
        <errorMessage>Cannot create Software &amp; Services Quote directly from Quote tab, Please create Software &amp; Services Quote from Opportunity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Restrict_QuoteSubmission_0QL</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISNEW()),ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;),ISCHANGED(SBQQ__Status__c),
ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &apos;Draft&apos;),OR(ISPICKVAL(SBQQ__Status__c, &apos;In Review&apos;),ISPICKVAL(SBQQ__Status__c, &apos;Approved&apos;)), SBQQ__LineItemCount__c  &lt; 1)</errorConditionFormula>
        <errorMessage>Cannot Submit Quote for Approval, as no Quote Lines are added to Quote.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_StartDate_SubscriptionTerm</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;),
OR(
ISBLANK(SBQQ__StartDate__c),
ISBLANK(SBQQ__SubscriptionTerm__c)
)
)</errorConditionFormula>
        <errorMessage>Start Date and Subscription Term are required to save the quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Start_Date_less_than_Today</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;), SBQQ__StartDate__c  &lt;  TODAY(),OR(ISCHANGED(SBQQ__StartDate__c),ISNEW()),NOT(ISCLONE()))</errorConditionFormula>
        <errorDisplayField>SBQQ__StartDate__c</errorDisplayField>
        <errorMessage>Start Date cannot be less than Today</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Status_Changed_Opportunity</fullName>
        <active>true</active>
        <errorConditionFormula>( ISPICKVAL(SBQQ__Opportunity2__r.Core_Approval_Status__c, &quot;Submitted&quot;) ||
  ISPICKVAL(SBQQ__Opportunity2__r.Core_Approval_Status__c, &quot;Approved&quot;) ) &amp;&amp;
ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;)&amp;&amp;
TEXT(PRIORVALUE(SBQQ__Status__c)) = &apos;Draft&apos; &amp;&amp;
(TEXT(SBQQ__Status__c) = &apos;In Review&apos; || TEXT(SBQQ__Status__c) = &apos;Approved&apos;)</errorConditionFormula>
        <errorMessage>Cannot submit the Quote, as the Opportunity has already been Submitted/Approved.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Status_Transition_Validation</fullName>
        <active>true</active>
        <description>Prevents invalid status changes by enforcing specific, allowable status updates for the Status field on the Quote object.</description>
        <errorConditionFormula>OR(
AND(
ISPICKVAL(Pricing_Quote_Program_Nm__c, &quot;Software &amp; Services&quot;),
ISCHANGED(SBQQ__Status__c),
ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &quot;Draft&quot;),
NOT(OR(
ISPICKVAL(SBQQ__Status__c, &quot;In Review&quot;),
ISPICKVAL(SBQQ__Status__c, &quot;Approved&quot;))
)
),
AND(
ISPICKVAL(Pricing_Quote_Program_Nm__c, &quot;Software &amp; Services&quot;),
ISCHANGED(SBQQ__Status__c),
ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &quot;In Review&quot;),
NOT(
OR(
ISPICKVAL(SBQQ__Status__c, &quot;Approved&quot;),
ISPICKVAL(SBQQ__Status__c, &quot;Rejected&quot;),
ISPICKVAL(SBQQ__Status__c, &quot;Draft&quot;)
)
)
),
AND(
ISPICKVAL(Pricing_Quote_Program_Nm__c, &quot;Software &amp; Services&quot;),
ISCHANGED(SBQQ__Status__c),
ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &quot;Approved&quot;),
NOT(
OR(
ISPICKVAL(SBQQ__Status__c, &quot;Accepted&quot;),
ISPICKVAL(SBQQ__Status__c, &quot;Denied&quot;)
)
)
)
)</errorConditionFormula>
        <errorMessage>Status can be updated only from Approved to Accepted or Denied.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_Submit_For_ApprovalExpiryDate</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Pricing_Sw_Validation_Bypass__c.By_Pass_Validation__c==true, False,
NOT(ISBLANK(Pricing_SW_Expiry_Date__c)) &amp;&amp;
ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;)&amp;&amp;
(Pricing_SW_Expiry_Date__c &lt; TODAY() + 14) &amp;&amp;
ISCHANGED(SBQQ__Status__c) &amp;&amp;
TEXT(PRIORVALUE(SBQQ__Status__c)) = &apos;Draft&apos; &amp;&amp;
(TEXT(SBQQ__Status__c) = &apos;In Review&apos; || TEXT(SBQQ__Status__c) = &apos;Approved&apos;))</errorConditionFormula>
        <errorDisplayField>Pricing_SW_Expiry_Date__c</errorDisplayField>
        <errorMessage>Expiry Date must be more than 14 days in the future before quote can be submitted.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Tender_ContactValidator</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR( ISNEW() , ISCHANGED( SBQQ__PrimaryContact__c ) ),
IF($Profile.Name &lt;&gt; &apos;Partner&apos;, 
IF(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;), 
IF(!ISBLANK(SBQQ__PrimaryContact__c ),IF(!ISBLANK( SBQQ__Account__c),SBQQ__PrimaryContact__r.AccountId &lt;&gt; SBQQ__Account__c , false) , false), false), false) )</errorConditionFormula>
        <errorDisplayField>SBQQ__PrimaryContact__c</errorDisplayField>
        <errorMessage>Please select a contact who belongs to the account and is authorized to use Intel Quote Request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Tender_Write_In_End_Customer</fullName>
        <active>true</active>
        <description>When &apos;Write In End Customer&apos; is selected in the End Customer field, the name of the end customer must be provided.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
OR(
ISNEW(),
ISCHANGED(Pricing_Customer_Nm__c),
ISCHANGED( Pricing_End_Customer__c )
),
AND(
NOT(ISNULL( Pricing_End_Customer__c )),
 Pricing_End_Customer__r.Name  = &apos;Write In End Customer&apos;,
ISBLANK(Pricing_Customer_Nm__c)
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Customer_Nm__c</errorDisplayField>
        <errorMessage>When &apos;Write In End Customer&apos; is selected in the End Customer field, the name of the end customer must be provided.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Tender_Write_In_End_Customer_Any</fullName>
        <active>true</active>
        <description>Any Value Should not be given in Write In End Customer.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
OR(
ISNEW(),
ISCHANGED(Pricing_Customer_Nm__c)
),
AND(
NOT(ISNULL( Pricing_End_Customer__c )),
Pricing_End_Customer__r.Name = &apos;Write In End Customer&apos;,
UPPER(Pricing_Customer_Nm__c) == &apos;ANY&apos;
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Customer_Nm__c</errorDisplayField>
        <errorMessage>&apos;ANY&apos; is not a valid End Customer. Please update the Write In End Customer value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Tender_Write_In_End_Customer_Res</fullName>
        <active>true</active>
        <description>Only when &apos;Write In End Customer&apos; is selected in the End Customer field, the name of the other end customer must be provided in the Write In End Customer field.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
OR(
ISNEW(),
ISCHANGED(Pricing_Customer_Nm__c),
ISCHANGED( Pricing_End_Customer__c )
),
AND(
NOT(ISNULL( Pricing_End_Customer__c )),
  NOT(CONTAINS(Pricing_End_Customer__r.Name, &apos;Write In End Customer&apos;)),
NOT(ISBLANK(Pricing_Customer_Nm__c))
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Customer_Nm__c</errorDisplayField>
        <errorMessage>The Write In End Customer field is used to provide the name of an end customer missing from the End Customer field. It must be blank unless the &apos;Write In End Customer&apos; option is selected in the End Customer field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Volume_Exclude_Reason_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
!ISPICKVAL(Pricing_Program_Type_Nm__c, &apos;Small Volume Quotes - Data Center Xeon® CPU&apos;),
ISCHANGED(Pricing_Exclude_from_Volume_Excep_Quota__c),
Pricing_Exclude_from_Volume_Excep_Quota__c = true,
ISPICKVAL(Pricing_Quota_Exclusion_Reason__c, &apos;&apos;)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Quota_Exclusion_Reason__c</errorDisplayField>
        <errorMessage>Quota Exclusion Reason is required whenever Exclude from Volume Exception Quota is checked.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_WriteInEndCustomer_NoPipeCheck</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;
),
OR(
ISNEW(),
ISCHANGED(Pricing_Customer_Nm__c)
),
AND(
NOT(ISNULL( Pricing_End_Customer__c )),
Pricing_End_Customer__r.Name = &apos;Write In End Customer&apos;,
CONTAINS (Pricing_Customer_Nm__c, &quot;|&quot;)
)
)</errorConditionFormula>
        <errorMessage>The pipe (|) character is not allowed in the Write In End Customer field; Please enter a valid value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_opportunity_Lookup_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Tender&apos;),
ISCHANGED( SBQQ__Opportunity2__c ),
SBQQ__Opportunity2__r.CRM_SW_Flag_Ind__c  = true
)</errorConditionFormula>
        <errorDisplayField>SBQQ__Opportunity2__c</errorDisplayField>
        <errorMessage>Opportunity you are trying to select is software related opportunity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__End_Date_Before_Start_Date</fullName>
        <active>true</active>
        <description>Validates End Date comes after the Start Date</description>
        <errorConditionFormula>IF( AND( NOT(ISNULL(SBQQ__EndDate__c)), SBQQ__EndDate__c &lt; SBQQ__StartDate__c), TRUE, null)</errorConditionFormula>
        <errorMessage>The End Date must come after the Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Invalid_First_Segment_Term_End_Date</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(ISNULL(SBQQ__FirstSegmentTermEndDate__c)) &amp;&amp; NOT(ISNULL(SBQQ__StartDate__c)) &amp;&amp; (NOT(ISNULL(SBQQ__SubscriptionTerm__c)) || NOT(ISNULL(SBQQ__EndDate__c))) &amp;&amp;
            (SBQQ__FirstSegmentTermEndDate__c &lt; SBQQ__StartDate__c || IF(NOT(ISNULL(SBQQ__EndDate__c)),SBQQ__FirstSegmentTermEndDate__c &gt; SBQQ__EndDate__c, IF(LOWER($Setup.SBQQ__GeneralSettings__c.SBQQ__SubscriptionTermUnit__c)=&apos;day&apos;, SBQQ__FirstSegmentTermEndDate__c &gt; SBQQ__StartDate__c + SBQQ__SubscriptionTerm__c-1, SBQQ__FirstSegmentTermEndDate__c &gt; SBQQ__StartDate__c + (SBQQ__SubscriptionTerm__c * 30.4375))))</errorConditionFormula>
        <errorDisplayField>SBQQ__FirstSegmentTermEndDate__c</errorDisplayField>
        <errorMessage>First Segment Term End Date must fall between Quote Start Date and Quote End Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Invalid_Subscription_Term</fullName>
        <active>true</active>
        <description>Validates that subscription term is positive</description>
        <errorConditionFormula>IF( AND( NOT(ISNULL(SBQQ__SubscriptionTerm__c)), SBQQ__SubscriptionTerm__c &lt;= 0), TRUE, null)</errorConditionFormula>
        <errorMessage>The subscription term must be a positive number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Shipment_End_Dt_Before_Shipment_Start_Dt</fullName>
        <active>true</active>
        <description>Validates Shipment End Date comes after the Shipment Start Date</description>
        <errorConditionFormula>IF( 
AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;,RecordType.DeveloperName =&apos;Pricing_Financial_Incentive_Quote_Read_Only&apos;,RecordType.DeveloperName =&apos;Pricing_Financial_Incentive_Quote_Submitted&apos;),
NOT(ISNULL(Pricing_ShipmentEndDate_Dt__c)),
OR(
  ISCHANGED(Pricing_ShipmentStDate_Dt__c), 
  ISCHANGED(Pricing_ShipmentEndDate_Dt__c), 
  ISNEW()
), 
Pricing_ShipmentEndDate_Dt__c &lt; Pricing_ShipmentStDate_Dt__c
), TRUE, null)</errorConditionFormula>
        <errorMessage>Pricing End Date is before Pricing Start Date. Please enter a Pricing End Date that is after the Pricing Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Oppty_Account_with_End_Customer</fullName>
        <active>true</active>
        <errorConditionFormula>IF( OR((ISBLANK(SBQQ__Opportunity2__c)),ISNULL(SBQQ__Opportunity2__c)),false,
AND(
	NOT(ISPICKVAL(SBQQ__Status__c, &apos;Rejected&apos;)),
	(core_cpq_active_cb__c = true),
OR(
$RecordType.Name = &quot;PSG Quote - New&quot;,
$RecordType.Name = &quot;PSG Quote - Read Only&quot;,
$RecordType.Name = &quot;PSG Quote - Submitted&quot;,
$RecordType.Name = &quot;PSG Quote - Inactive&quot;,
$RecordType.Name = &quot;PSG Quote - Cancelled&quot;,
$RecordType.Name = &quot;PSG Quote - Approved&quot;
),

OR(
NOT(SBQQ__Opportunity2__r.Account.Core_Direct_Pricing_Parent_Id__c = core_cpq_end_customer_nm__r.Core_Direct_Pricing_Parent_Id__c ),
ISBLANK(SBQQ__Opportunity2__r.Account.Core_Direct_Pricing_Parent_Id__c) ,
ISNULL(SBQQ__Opportunity2__r.Account.Core_Direct_Pricing_Parent_Id__c)
),
NOT( $Permission.PSG_External_Disty ),
ISPickval(SBQQ__Type__c ,&apos;Quote&apos;)
)
)</errorConditionFormula>
        <errorDisplayField>SBQQ__Opportunity2__c</errorDisplayField>
        <errorMessage>Selected Opportunity is not Valid for this End Customer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>shipment_date_check</fullName>
        <active>true</active>
        <description>shipment date (either start or end) cannot be a date in the past</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Small_Volume_Quote_Create&apos;,
RecordType.DeveloperName=&apos;Pricing_Tender_Quote_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Client_Quote_Submitted&apos;,
RecordType.DeveloperName=&apos;Pricing_Financial_Incentive_Quote_Read_Only&apos;,
RecordType.DeveloperName=&apos;Pricing_Financial_Incentive_Quote_Submitted&apos;
),
OR(
	AND(
		NOT(ISNEW()),
		ISCHANGED(Pricing_ShipmentStDate_Dt__c),
		Pricing_ShipmentStDate_Dt__c &lt; TODAY()
	),
	AND(
		NOT(ISNEW()),
		ISCHANGED(Pricing_ShipmentEndDate_Dt__c),
		Pricing_ShipmentEndDate_Dt__c &lt; TODAY()
	),
	AND(
		ISNEW(),
		OR(
			Pricing_ShipmentStDate_Dt__c &lt; TODAY(),
			Pricing_ShipmentEndDate_Dt__c &lt; TODAY()
		)
	)	
)
)</errorConditionFormula>
        <errorDisplayField>core_cpq_years_nbr__c</errorDisplayField>
        <errorMessage>Either Pricing Start Date or Pricing End Date has already passed. Please ensure both fields are in the future.</errorMessage>
    </validationRules>
