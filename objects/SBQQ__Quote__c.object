    <fields>
        <fullName>core_cpq_inprogress_days__c</fullName>
        <externalId>false</externalId>
        <formula>SubmittedDate__c -  BLANKVALUE(core_cpq_date_submitted_dt__c,DATEVALUE(CreatedDate))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days in InProgress</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_inreview_days__c</fullName>
        <externalId>false</externalId>
        <formula>core_cpq_quote_approved_date_dt__c -  SubmittedDate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days in InReview</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_invalid_opn__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Displays the OPNs which are dropped from the quote, which could be due to Pre-Release product not allowed OR Products are Inactive OR Non orderable. Please check the OPN attributes and add the correct one.</inlineHelpText>
        <label>Invalid OPNs</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_invalid_opn_ta__c</fullName>
        <inlineHelpText>Inactive OPNs with no replacement &amp; OPNs that aren&apos;t Quotable/Orderable.</inlineHelpText>
        <label>Invalid OPNs</label>
        <length>131072</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
