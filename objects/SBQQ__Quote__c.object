    <fields>
        <fullName>core_cpq_latest_account_program__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
 INCLUDES(core_cpq_end_customer_nm__r.Core_Partner_Alliance_Program__c,&quot;PSG Demand Creation - Distribution&quot;),
 &quot;PSG Demand Creation - Distribution&quot;,
 IF(
  INCLUDES(core_cpq_end_customer_nm__r.Core_Partner_Alliance_Program__c,&quot;PSG Demand Creation - Hybrid&quot;),
  &quot;PSG Demand Creation - Hybrid&quot;,
  IF(
   INCLUDES(core_cpq_end_customer_nm__r.Core_Partner_Alliance_Program__c,&quot;PSG Demand Creation - PSG&quot;),
   &quot;PSG Demand Creation - PSG&quot;,
   &quot;&quot;
  )
 )
)</formula>
        <label>Latest Account Program</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_life_time_annual_peak_sum__c</fullName>
        <label>Life Time Annual Peak Sum</label>
        <summarizedField>SBQQ__QuoteLine__c.price_peak_annual_resale_amt__c</summarizedField>
        <summaryForeignKey>SBQQ__QuoteLine__c.SBQQ__Quote__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
