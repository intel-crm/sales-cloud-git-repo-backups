    <fields>
        <fullName>core_cpq_ship_end_date_disty_view__c</fullName>
        <label>Ship End Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>core_cpq_ship_start_date_disty_view__c</fullName>
        <label>Ship Start Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>core_cpq_siebel_quote_no_txt__c</fullName>
        <externalId>false</externalId>
        <formula>TRIM(RIGHT(src_sys_id__c,LEN(src_sys_id__c) - FIND(&quot;|&quot;, src_sys_id__c,FIND(&quot;|&quot;, src_sys_id__c)+1)))</formula>
        <label>Siebel Quote #</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_siebel_rfq_num_txt__c</fullName>
        <externalId>false</externalId>
        <formula>LEFT(RIGHT( src_sys_id__c , LEN(src_sys_id__c ) - FIND (&quot;|&quot;, src_sys_id__c )), FIND(&quot;|&quot; , RIGHT(src_sys_id__c , LEN(src_sys_id__c ) - FIND (&quot;|&quot;, src_sys_id__c )))-1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Siebel RFQ #</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_site_txt__c</fullName>
        <externalId>false</externalId>
        <formula>core_cpq_end_customer_nm__r.Site</formula>
        <label>Site</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_status_change_reason_txt__c</fullName>
