    <fields>
        <fullName>Pricing_Route_Rule_Id_Txt__c</fullName>
        <description>This field holds the Route Rule Record Id</description>
        <externalId>false</externalId>
        <label>Route Rule Id</label>
        <length>18</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Route_Rule_Name_Txt__c</fullName>
        <description>This field holds the Route Rule Name</description>
        <externalId>false</externalId>
        <label>Route Rule Name</label>
        <length>10</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Route_Rule_Name__c</fullName>
        <description>This field holds the Lookup of the Route Rule Record</description>
        <externalId>false</externalId>
        <formula>IF(
  ISBLANK(Pricing_Route_Rule_Id_Txt__c),
  &quot;&quot;,
 HYPERLINK(
    &quot;/&quot; &amp; Pricing_Route_Rule_Id_Txt__c, 
    Pricing_Route_Rule_Name_Txt__c, 
    &quot;_blank&quot;
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Route Rule Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_SW_Account_Name__c</fullName>
        <description>Account Name for Software Quote template</description>
        <externalId>false</externalId>
        <formula>SBQQ__Account__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_SW_Approval_Comments__c</fullName>
        <label>Approval Comments</label>
        <length>4000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Pricing_SW_Approved_Rejected_Date__c</fullName>
        <label>Approved/Rejected Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Pricing_SW_Custom_Action__c</fullName>
        <formula>IF( $Permission.Pricing_SW_Custom_Action, True, False)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Custom Action</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Pricing_SW_Custom_Product__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Custom Product</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Pricing_SW_Days_in_In_Review__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;), NOT(ISNULL(Pricing_SW_Approved_Rejected_Date__c)),NOT(ISNULL(Pricing_SW_Submitted_Date__c ))), Pricing_SW_Approved_Rejected_Date__c - Pricing_SW_Submitted_Date__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days in In Review</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_SW_Description__c</fullName>
        <description>On Creation of New Quote Populating the Description value from Description field in opportunity object.
Logic in Apex Class Pricing_SW_QuoteBusinessLogic</description>
        <label>Description</label>
        <length>32000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Pricing_SW_Expiry_Date__c</fullName>
        <inlineHelpText>Expiry date should be &gt; 14 days from today&apos;s date.</inlineHelpText>
        <label>Expiry Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Pricing_SW_Expiry_Less_Than_14_days__c</fullName>
        <formula>Pricing_SW_Expiry_Date__c &lt; TODAY() + 14</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Expiry Less Than 14 days</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Pricing_SW_Manager_Approver__c</fullName>
        <externalId>false</externalId>
        <formula>Owner:User.ManagerId</formula>
        <label>Manager Approver</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_SW_Opportunity_Submit_Or_Approve__c</fullName>
        <formula>OR(
    ISPICKVAL(SBQQ__Opportunity2__r.Core_Approval_Status__c, &quot;Submitted&quot;),
    ISPICKVAL(SBQQ__Opportunity2__r.Core_Approval_Status__c, &quot;Approved&quot;)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity_Submit_Or_Approved</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Pricing_SW_Submitted_Date__c</fullName>
        <label>Submitted Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Pricing_SecondaryContact_Nm__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Account Manager or sales rep that is involved with this quote at the OEM.</inlineHelpText>
        <label>Secondary Contact</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Server_Deal_Type_Nm__c</fullName>
        <description>Identifies the customer&apos;s product or solution into which the Intel and partner content will be sold or designed to.</description>
        <inlineHelpText>Type of workload into which the products included in the quote will be integrated.</inlineHelpText>
        <label>Application</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Pricing_Program_Type_Nm__c</controllingField>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
