    <fields>
        <fullName>core_cpq_ql_with_prid_deactivation__c</fullName>
        <label>QL With PRID Deactivation</label>
        <summaryFilterItems>
            <field>SBQQ__QuoteLine__c.core_cpq_prid_alert__c</field>
            <operation>contains</operation>
            <value>De-activation, de-activation, de-activate, Revision, revision</value>
        </summaryFilterItems>
        <summaryForeignKey>SBQQ__QuoteLine__c.SBQQ__Quote__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>core_cpq_quote_approved_date_dt__c</fullName>
        <label>Quote Approved Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>core_cpq_quote_created_date__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(MONTH(DATEVALUE(CreatedDate)))+&quot;/&quot; +TEXT(DAY(DATEVALUE(CreatedDate)))+&quot;/&quot; +TEXT(YEAR(DATEVALUE(CreatedDate)))</formula>
        <label>Quote Created date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
