    <fields>
        <fullName>core_cpq_distystatus_txt__c</fullName>
        <description>This field is available for Disty view in portal.</description>
        <externalId>false</externalId>
        <formula>CASE( SBQQ__Status__c ,
&quot;Draft&quot;, &quot;Draft&quot;,
&quot;New&quot;, &quot;New&quot;,
&quot;Pending&quot;, &quot;Pending&quot;,
&quot;Approved&quot;, &quot;Approved&quot;,
&quot;Cancelled&quot;, &quot;Cancelled&quot;,
&quot;Rejected&quot;, &quot;Rejected&quot;,
&quot;In Progress&quot; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
