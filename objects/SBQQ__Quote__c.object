    <fields>
        <fullName>core_cpq_approved_rejected_duration__c</fullName>
        <externalId>false</externalId>
        <formula>IF(	ISPICKVAL( SBQQ__Status__c ,&apos;Approved&apos;),
	TEXT ( 
		ABS ( 
			FLOOR(core_cpq_quote_approved_date_dt__c - 
				IF(ISBLANK(core_cpq_date_submitted_dt__c) || core_cpq_date_submitted_dt__c &lt; DATEVALUE(CreatedDate) ,
					DATEVALUE(CreatedDate), core_cpq_date_submitted_dt__c)
				)
			) 
		)
	 ,
	IF(ISPICKVAL(SBQQ__Status__c,&apos;Rejected&apos;),
	
		TEXT(
		ABS (
			FLOOR(core_cpq_quote_rejected_date__c- 
				IF(ISBLANK(core_cpq_date_submitted_dt__c) || core_cpq_date_submitted_dt__c &lt; DATEVALUE(CreatedDate), 
					DATEVALUE(CreatedDate), core_cpq_date_submitted_dt__c)
				)
			)
		)
		,&quot;&quot;
	)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Approved/Rejected Duration</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
