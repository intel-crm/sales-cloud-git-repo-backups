        <type>Summary</type>
    </fields>
    <fields>
        <fullName>core_cpq_mandatory_field__c</fullName>
        <description>Used in disty portal to prevent saving and creating a new quote on click of edit in list view.</description>
        <externalId>false</externalId>
        <label>Mandatory Field</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_mandatory_fields_check_cb__c</fullName>
        <formula>IF(  
AND(  
NOT(ISBLANK(core_cpq_distributor_disty_view_nm__c )) ,  NOT(ISBLANK(core_cpq_end_customer_disty_view_nm__c )) ,  NOT(ISBLANK(core_cpq_price_book_nm__c )) , 
NOT(ISPICKVAL(core_cpq_business_unit_nm__c,&apos;&apos; ))
), true, false)</formula>
        <label>Mandatory Fields Check</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>core_cpq_mandatory_fields_for_tools_cb__c</fullName>
        <formula>IF(
AND(
OR(AND( core_cpq_corporate_flag__c =true,NOT(ISBLANK( SBQQ__StartDate__c )) , NOT(ISBLANK( SBQQ__EndDate__c ))),core_cpq_corporate_flag__c=false) , NOT(ISBLANK(core_cpq_distributor_disty_view_nm__c )) , NOT(ISBLANK(core_cpq_end_customer_disty_view_nm__c )) , NOT(ISBLANK(core_cpq_price_book_nm__c )), ISPICKVAL(core_cpq_quote_type_nm__c , &apos;Tools&apos;),
NOT(ISPICKVAL(core_cpq_business_unit_nm__c,&apos;&apos; ))
), true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Mandatory Fields For Tools</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
