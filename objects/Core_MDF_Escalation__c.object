            </values>
            <values>
                <fullName>Cancelled</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Denied</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Expired</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Review</fullName>
                <default>true</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Core_MDF_Root_Cause_nm__c</picklist>
            <values>
                <fullName>Intel Awareness of Process</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Partner Awareness of Process</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Tools and Systems</fullName>
                <default>false</default>
            </values>
