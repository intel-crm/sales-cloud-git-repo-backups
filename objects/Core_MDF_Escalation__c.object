    <fields>
        <fullName>Core_MDF_Activity_Name_url__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(
  IF(
    ISPICKVAL(Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Activity_Level_nm__c, &quot;Super Activity&quot;),
    IF(
      $Profile.Name = &quot;Partner&quot;,
								$Label.Core_MDF_PFRCommunityLink &amp; &quot;s/outcome-based-campaign-details?recordId=&quot; &amp; Core_MDF_Co_Marketing_Activity_id__c,
      &quot;/lightning/n/Core_MDF_Outcome_Based_Campaign_Detail?c__recordId=&quot; &amp; Core_MDF_Co_Marketing_Activity_id__c
    ),
    IF(
      $Profile.Name = &quot;Partner&quot;,
								$Label.Core_MDF_PFRCommunityLink &amp; &quot;s/partnerfundrequest/&quot; &amp; Core_MDF_Co_Marketing_Activity_id__c,
      &quot;/lightning/r/PartnerFundRequest/&quot; &amp; Core_MDF_Co_Marketing_Activity_id__c &amp; &quot;/view&quot;
    )
  ),
  Core_MDF_Co_Marketing_Activity_id__r.Title,
  IF(
    ISPICKVAL(Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Activity_Level_nm__c, &quot;Super Activity&quot;),
    &quot;_blank&quot;,
    &quot;_self&quot;
  )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Activity Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
