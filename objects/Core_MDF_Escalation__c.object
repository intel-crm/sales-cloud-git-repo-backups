        <description>Contains group Id of Internal PGM</description>
        <externalId>false</externalId>
        <label>PGM Internal Group Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Program_txt__c</fullName>
        <externalId>false</externalId>
        <label>Program</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Region_txt__c</fullName>
        <externalId>false</externalId>
        <formula>IF(RecordType.DeveloperName =$Label.Core_MDF_ClaimCaseReviewResult_RecordType,
Core_MDF_Case_ID_Number_id__r.Core_Account_Geo__c ,
IF(RecordType.DeveloperName =$Label.Core_MDF_LateClaim_RecordType,
IF ( INCLUDES (Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Region_nm__c , &quot;APJ&quot; ), &quot;APJ&quot;,null ) &amp;
IF ( INCLUDES (Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Region_nm__c , &quot;EMEA&quot; ), &quot;EMEA&quot;,null ) &amp;
IF ( INCLUDES (Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Region_nm__c , &quot;PRC&quot; ), &quot;PRC&quot;,null ) &amp;
IF ( INCLUDES (Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Region_nm__c , &quot;ASMO&quot; ), &quot;ASMO&quot;,null ) ,
&apos;&apos;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
