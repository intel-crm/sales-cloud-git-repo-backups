    <recordTypeTrackHistory>true</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Core_MDF_Budget</fullName>
        <active>true</active>
        <compactLayoutAssignment>Core_MDF_Escalation</compactLayoutAssignment>
        <label>Budget</label>
        <picklistValues>
            <picklist>Core_MDF_Escalation_Status_nm__c</picklist>
            <values>
                <fullName>Approved</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Cancelled</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Denied</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Review</fullName>
                <default>true</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Core_MDF_Root_Cause_nm__c</picklist>
            <values>
                <fullName>Appeal of Budget</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Mergers %26 Acquisitions</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <recordTypes>
        <fullName>Core_MDF_Claim_Case_Review_Result</fullName>
        <active>true</active>
        <compactLayoutAssignment>Core_MDF_Escalation</compactLayoutAssignment>
