    <validationRules>
        <fullName>Core_MDF_Approved_Amount_Check</fullName>
        <active>true</active>
        <description>Approved amount should not be less than 0</description>
        <errorConditionFormula>AND(
    ISCHANGED(Core_MDF_Approved_Amount_amt__c), 
    Core_MDF_Approved_Amount_amt__c&lt;0
)</errorConditionFormula>
        <errorMessage>Approved Amount cannot be negative.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Check_Account_Active</fullName>
        <active>true</active>
        <description>Escalation cannot be created for an inactive Account.</description>
        <errorConditionFormula>AND(
OR(
AND(RecordType.Name  =&apos;Budget&apos;, Core_MDF_Budget_ID_Number_id__r.Core_MDF_Budget_Partner__r.Core_MDF_Active_Ind__c = false),
AND(RecordType.Name  =&apos;Late Claim&apos;, Core_MDF_Co_Marketing_Activity_id__r.ChannelPartner.Core_MDF_Active_Ind__c = false),
AND(RecordType.Name  =&apos;Claim Case Review Result&apos;, Core_MDF_Case_ID_Number_id__r.Account.Core_MDF_Active_Ind__c = false)
),AND(ISCHANGED(Core_MDF_Escalation_Status_nm__c),NOT(OR(ISPICKVAL(Core_MDF_Escalation_Status_nm__c, &quot;Cancelled&quot;),ISPICKVAL(Core_MDF_Escalation_Status_nm__c, &quot;Expired&quot;)))))</errorConditionFormula>
        <errorMessage>Escalation cannot be created for an inactive Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Claim_Case_Required_Fields</fullName>
        <active>true</active>
        <errorConditionFormula>IF( RecordType.Name = &apos;Claim Case Review Result&apos;,  OR(ISNULL( Core_MDF_Claim_Submitter_Id__c ),ISBLANK( Core_MDF_Escalation_Name_txt__c ),ISNULL(Core_MDF_Case_ID_Number_id__c)),false)</errorConditionFormula>
        <errorMessage>Required Fields:	
Escalation Name, Root Cause, Case ID Number, 
Claim Submitter</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ErrorOnEditingAmount</fullName>
        <active>true</active>
        <description>Throws error when escalation is not in Pending Review Status and other fields edited</description>
        <errorConditionFormula>AND(
	OR(
		ISPICKVAL(Core_MDF_Escalation_Status_nm__c, &apos;Approved&apos;),
		ISPICKVAL( Core_MDF_Escalation_Status_nm__c , &apos;Denied&apos;),
		ISPICKVAL( Core_MDF_Escalation_Status_nm__c , &apos;Cancelled&apos;),
		ISPICKVAL( Core_MDF_Escalation_Status_nm__c , &apos;Expired&apos;)
	),
	OR(
		AND(
			OR(ISCHANGED(Core_MDF_Total_Dollar_Impact_amt__c),
				ISCHANGED(Core_MDF_Approved_Amount_amt__c),
				ISCHANGED(Core_MDF_Root_Cause_nm__c),
				ISCHANGED(Core_MDF_Escalation_Name_txt__c)),
			OR(
				AND(ISPICKVAL(Core_MDF_Escalation_Status_nm__c, &apos;Approved&apos;),
				NOT($Permission.Core_MDF_Internal_CSC_User)),
				ISPICKVAL( Core_MDF_Escalation_Status_nm__c , &apos;Denied&apos;),
				ISPICKVAL( Core_MDF_Escalation_Status_nm__c , &apos;Cancelled&apos;),
				ISPICKVAL( Core_MDF_Escalation_Status_nm__c , &apos;Expired&apos;)
				)
			),
		ISCHANGED(Core_MDF_Co_Marketing_Activity_id__c),
		ISCHANGED(Core_MDF_Budget_ID_Number_id__c),
		ISCHANGED(Core_MDF_Case_ID_Number_id__c)
	)
)</errorConditionFormula>
        <errorMessage>Edit is not enabled in this status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ErrorOnEditingApprovedAmount</fullName>
        <active>false</active>
        <description>Throws error when escalation is not in Pending Review &amp; Approved Status and Approved Amount field is edited</description>
        <errorConditionFormula>AND(
OR(
ISPICKVAL(Core_MDF_Escalation_Status_nm__c, &apos;Approved&apos;),
ISPICKVAL( Core_MDF_Escalation_Status_nm__c , &apos;Denied&apos;),
ISPICKVAL( Core_MDF_Escalation_Status_nm__c , &apos;Cancelled&apos;),
ISPICKVAL( Core_MDF_Escalation_Status_nm__c , &apos;Expired&apos;)
),
ISCHANGED(Core_MDF_Approved_Amount_amt__c)
)</errorConditionFormula>
        <errorMessage>Approved amount cannot be edited in this status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_LateClaim_ClaimSubUserCheck</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISPICKVAL(Core_MDF_Escalation_Status_nm__c, &apos;Approved&apos;),
ISPICKVAL(Core_MDF_Escalation_Status_nm__c, &apos;Denied&apos;),
ISPICKVAL(Core_MDF_Escalation_Status_nm__c, &apos;Cancelled&apos;),
ISPICKVAL(Core_MDF_Escalation_Status_nm__c, &apos;Expired&apos;)
),
ISCHANGED(Core_MDF_Claim_Submitter_Id__c),
PRIORVALUE(Core_MDF_Claim_Submitter_Id__c) !=null,
Core_MDF_Claim_Number_id__c != null
)</errorConditionFormula>
        <errorMessage>Claim Submitter cannot be edited when a claim is already created.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Late_Claim_Required_Fields</fullName>
        <active>true</active>
        <errorConditionFormula>IF( RecordType.Name = &apos;Late Claim&apos;,  OR(ISNULL( Core_MDF_Co_Marketing_Activity_id__c ),ISNULL( Core_MDF_Claim_Submitter_Id__c ), ISBLANK( Core_MDF_Escalation_Name_txt__c ),  ISBLANK(text(Core_MDF_Root_Cause_nm__c))),false)</errorConditionFormula>
        <errorMessage>Required Fields:	
Escalation Name,  Activity Name,
Claim Submitter</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Prevent_Sub_Activity</fullName>
        <active>true</active>
        <description>Prevents users from selecting a Co-Marketing Activity where Activity Level is Sub Activity.</description>
        <errorConditionFormula>AND(
    NOT(ISBLANK(Core_MDF_Co_Marketing_Activity_id__c)),
    ISPICKVAL(
        Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Activity_Level_nm__c,
        &quot;Sub Activity&quot;
    )
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Co_Marketing_Activity_id__c</errorDisplayField>
        <errorMessage>Escalations can only be created for Outcome Based Campaign records.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RestrictMissedApprovalActivity</fullName>
        <active>true</active>
        <description>Do not allow to select Activity which are Closed due to Missed Internal/External Approval/Auto - Missed Approval/Auto - Missed In-Progress Approval</description>
        <errorConditionFormula>AND(
	RecordType.DeveloperName = &apos;Core_MDF_Late_Claim&apos;,
	OR(
		!ISPICKVAL(Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Fund_Request_Status__c,&apos;Closed&apos;),  
		TEXT(Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Activity_Closure_Type__c) == $Label.Core_MDF_Activity_Closure_Type_No_Internal_Approval,
TEXT(Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Activity_Closure_Type__c) == $Label.Core_MDF_Activity_Closure_Type_No_External_Approval,
TEXT(Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Activity_Closure_Type__c) == &apos;Auto - Missed Approval&apos;,
TEXT(Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Activity_Closure_Type__c) == &apos;Auto - Missed In-Progress Approval&apos;
	)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Co_Marketing_Activity_id__c</errorDisplayField>
        <errorMessage>Escalation cannot be created on an Activity that is not Approved and Closed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Total_Dollar_Impact_Check</fullName>
        <active>true</active>
        <description>Total dollar impact should not be less than 0</description>
        <errorConditionFormula>AND(OR(ISNEW(), ISCHANGED(Core_MDF_Total_Dollar_Impact_amt__c)), Core_MDF_Total_Dollar_Impact_amt__c &lt;= 0,
Core_MDF_Escalation_Type_nm__c != &apos;Claim Case Review Result&apos;)</errorConditionFormula>
        <errorMessage>Total Dollar Impact cannot be negative or zero.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_MDF_Export_List_View</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Export List View</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/apex/Core_MDF_ExportToExcel?ObjName=Core_MDF_Escalation__c</url>
    </webLinks>
</CustomObject>
