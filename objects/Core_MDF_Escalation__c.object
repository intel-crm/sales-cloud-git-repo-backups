        <formula>IF(RecordType.DeveloperName =$Label.Core_MDF_Budget_RecordType, TEXT(Core_MDF_Budget_ID_Number_id__r.Core_MDF_Budget_Type_Txt__c),
IF(RecordType.DeveloperName =$Label.Core_MDF_ClaimCaseReviewResult_RecordType,TEXT(Core_MDF_Case_ID_Number_id__r.Core_MDF_Budget_Type_nm__c),
IF(RecordType.DeveloperName =$Label.Core_MDF_LateClaim_RecordType,TEXT( Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Budget_Type_nm__c),&apos;&apos;)))</formula>
