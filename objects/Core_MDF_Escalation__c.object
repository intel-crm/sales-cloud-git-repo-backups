    <fields>
        <fullName>Core_MDF_Virtual_Corp_Account_Name_nm__c</fullName>
        <description>Display Virtual Corp Account Name for IPA Escalations</description>
        <externalId>false</externalId>
        <formula>IF(Core_MDF_Channel_Program_id__r.Name =&apos;Intel Partner Alliance&apos;, 
IF(RecordType.DeveloperName =$Label.Core_MDF_Budget_RecordType,(Core_MDF_Budget_ID_Number_id__r.Core_MDF_Budget_Partner__r.Name),  
IF(RecordType.DeveloperName =$Label.Core_MDF_ClaimCaseReviewResult_RecordType, IF( ISBLANK(Core_MDF_Case_ID_Number_id__r.Account.Core_MDF_Virtual_Corp_Account_Id__c), (Core_MDF_Case_ID_Number_id__r.Account.Name), Core_MDF_Case_ID_Number_id__r.Account.Core_MDF_Virtual_Corp_Account_Id__r.Name) ,  
IF(RecordType.DeveloperName =$Label.Core_MDF_LateClaim_RecordType, (IF( ISBLANK(Core_MDF_Co_Marketing_Activity_id__r.ChannelPartner.Core_MDF_Virtual_Corp_Account_Id__c) , Core_MDF_Co_Marketing_Activity_id__r.ChannelPartner.Name, Core_MDF_Co_Marketing_Activity_id__r.ChannelPartner.Core_MDF_Virtual_Corp_Account_Id__r.Name) ), &apos;&apos;) ) ) , &apos;&apos;)</formula>
        <label>Corp Virtual Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
