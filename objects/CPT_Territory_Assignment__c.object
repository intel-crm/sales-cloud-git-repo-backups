    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>CPT_Territory_Assignment_Compact_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>CPT_Territory_Assignment_Compact_Layout</fullName>
        <fields>CPT_Territory_Name__c</fields>
        <fields>CPT_Employee_Name__c</fields>
        <fields>CPT_Quota_Setup__c</fields>
        <label>CPT Territory Assignment Compact Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object that connects Commissionable Employee to Accounts/Territories/Countries. It also stores the revenue streams and the Departments that the Employee is part of. The revenue stream and department assignment is done by the Manager.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>CPT_BR_All_Target__c</fullName>
        <defaultValue>0</defaultValue>
        <inlineHelpText>Value is in whole dollars.</inlineHelpText>
        <label>BR - All Target</label>
        <precision>12</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>CPT_BR_All__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If checked, the Employee is part of BR ALL Division and the corresponding Target Amount is rolled up to the Quota for that Division.</description>
        <label>BR - All</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
