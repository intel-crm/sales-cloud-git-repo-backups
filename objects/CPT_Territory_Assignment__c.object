    <fields>
        <fullName>CPT_CR_CCG_Target_V2__c</fullName>
        <formula>IF(CPT_CR_CCG_Consumer__c, CPT_CR_CCG_Consumer_Target__c, 0) + IF(CPT_CR_CCG_One_Intel_OEM__c, CPT_CR_CCG_One_Intel_OEM_Target__c, 0)</formula>
