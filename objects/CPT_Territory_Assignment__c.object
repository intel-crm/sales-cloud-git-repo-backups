    <nameField>
        <displayFormat>TA-{000000}</displayFormat>
        <label>Assignment ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Territory Assignments</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>OpenListInQuip</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>Accept</excludedStandardButtons>
        <excludedStandardButtons>PrintableListView</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <searchResultsAdditionalFields>CPT_Employee_Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CPT_Territory_Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LAST_UPDATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>UPDATEDBY_USER</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>CPT_Block_TA_Update_When_QS_Completed</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(
    CPT_Quota_Setup__r.CPT_Stage__c,
    &quot;Completed&quot;
)</errorConditionFormula>
        <errorMessage>This Territory Assignment cannot be updated because its Quota Setup is Completed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_BR_Territory_BU_Update</fullName>
        <active>true</active>
        <description>Rule to make sure that the Employee cannot be a part of BU if the corresponding Target Amount is zero.</description>
        <errorConditionFormula>OR
(
  AND(CPT_BR_CCG__c, OR(CPT_BR_CCG_Target__c = 0, ISNULL(CPT_BR_CCG_Target__c))),
  AND(CPT_BR_DCAI__c, OR(CPT_BR_DCAI_Target__c= 0, ISNULL(CPT_BR_DCAI_Target__c)))
)</errorConditionFormula>
        <errorMessage>The Billings Revenue Target for the Business Unit (BU) must exceed $0 to assign the BU to the employee.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_CR_Territory_BU_Update</fullName>
        <active>true</active>
        <description>Rule to make sure that the Employee cannot be a part of BU if the corresponding Target Amount is zero.</description>
        <errorConditionFormula>OR
(
AND(CPT_CR_OEM__c, OR(CPT_CR_OEM_Target__c = 0, ISNULL(CPT_CR_OEM_Target__c))),
AND(CPT_CR_Partner__c, OR(CPT_CR_Partner_Target__c = 0, ISNULL(CPT_CR_Partner_Target__c))),
AND(CPT_CR_Retail__c, OR(CPT_CR_Retail_Target__c= 0, ISNULL(CPT_CR_Retail_Target__c)))
)</errorConditionFormula>
        <errorMessage>To assign a CR-KPI to an employee, the Consumption Revenue Target for the CR-KPI must be greater than $0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_Multiple_TT_CR_120and122</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    OR(
        ISPICKVAL(CPT_Quota_Setup__r.CPT_Plan__c, &quot;120&quot;),
        ISPICKVAL(CPT_Quota_Setup__r.CPT_Plan__c, &quot;122&quot;)
    ),
    (
        IF(CPT_CR_OEM__c, 1, 0) +
        IF(CPT_CR_Partner__c, 1, 0)
    ) &gt; 1
)</errorConditionFormula>
        <errorMessage>For Plans 120 and 122, select either Consumption Revenue OEM or Partner, not both, on this Territory Assignment.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_Multiple_TT_CR_240</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(CPT_Quota_Setup__r.CPT_Plan__c, &quot;240&quot;),
    (
       
        IF(CPT_CR_Retail__c, 1, 0) +
        IF(CPT_CR_Partner__c, 1, 0)
    ) &gt; 1
)</errorConditionFormula>
        <errorMessage>For Plan 240, select either Consumption Revenue Partner or Retail, not both, on this Territory Assignment.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_Territory_Target_Update</fullName>
        <active>true</active>
        <description>Prevent the users from changing the Target value.</description>
        <errorConditionFormula>ISCHANGED(CPT_Territory_Target__c)</errorConditionFormula>
        <errorDisplayField>CPT_Territory_Target__c</errorDisplayField>
        <errorMessage>You do not have permission to make updates to the Target field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Restrict_Update_OnLockedRecord</fullName>
        <active>true</active>
        <description>Prevent update when the quota period is Hard Locked.</description>
        <errorConditionFormula>AND
(
NOT( $Permission.CPT_IT_Admin_System_Admin_Permission ),
TEXT(  CPT_Territory_Target__r.CPT_Quota_Period__r.CPT_Locked_Status__c  ) = &apos;Hard Lock&apos;
)</errorConditionFormula>
        <errorMessage>This record is locked. Please contact the Commissions Admin if you have any questions.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TA_Pair_CCG_Volume_and_Margin</fullName>
        <active>true</active>
        <description>This validation rule ensures Margin CCG and at least one NextGen CCG field (WCL, PTL, LNL) are selected together - mutual dependency required.</description>
        <errorConditionFormula>OR(
AND( CPT_MarVol_Margin_CCG__c, NOT(OR( CPT_MarVol_Next_Gen_CCG_WCL__c, CPT_MarVol_Next_Gen_CCG_PTL__c, CPT_MarVol_Next_Gen_CCG_LNL__c)) ),
AND( OR( CPT_MarVol_Next_Gen_CCG_WCL__c, CPT_MarVol_Next_Gen_CCG_PTL__c, CPT_MarVol_Next_Gen_CCG_LNL__c), NOT(CPT_MarVol_Margin_CCG__c) )
)</errorConditionFormula>
        <errorMessage>Volume CCG (LNL/PTL/WCL) and Margin CCG must be selected together - if one is selected, the other is required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TA_Pair_DCG_Volume_and_Margin</fullName>
        <active>true</active>
        <description>This validation rule ensures mutual dependency between CPT_MarVol_NextGen_DCG_GNR and CPT_MarVol_Margin_DCG fields. If one is selected, the other must also be selected, and vice versa.</description>
        <errorConditionFormula>OR( AND(CPT_MarVol_Next_Gen_DCG_GNR__c, NOT(CPT_MarVol_Margin_DCG__c)), AND(CPT_MarVol_Margin_DCG__c, NOT(CPT_MarVol_Next_Gen_DCG_GNR__c)) )</errorConditionFormula>
        <errorMessage>Volume DCG and Margin DCG must both be selected together.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>xCPT_Prevent_CR_Territory_BU_Update</fullName>
        <active>false</active>
        <description>Rule to make sure that the Employee cannot be a part of BU if the corresponding Target Amount is zero. Also, the Employee cannot have a Target Amount if he is not part of the corresponding BU.</description>
        <errorConditionFormula>OR
(
  AND(xCPT_CR_CCG__c, OR(CPT_CR_CCG_Target__c = 0, ISBLANK(CPT_CR_CCG_Target__c))),
  AND(xCPT_CR_DCAI__c, OR(CPT_CR_DCAI_Target__c = 0, ISBLANK(CPT_CR_DCAI_Target__c))),
  AND(xCPT_CR_NEX__c, OR(CPT_CR_NEX_Target__c = 0, ISBLANK(CPT_CR_NEX_Target__c))),

  AND(CPT_CR_CCG_Target__c &lt;&gt; 0, NOT(ISBLANK(CPT_CR_CCG_Target__c)), NOT(xCPT_CR_CCG__c)),
  AND(CPT_CR_DCAI_Target__c &lt;&gt; 0, NOT(ISBLANK(CPT_CR_DCAI_Target__c)), NOT(xCPT_CR_DCAI__c)),  
  AND(CPT_CR_NEX_Target__c &lt;&gt; 0, NOT(ISBLANK(CPT_CR_NEX_Target__c)), NOT(xCPT_CR_NEX__c))
)</errorConditionFormula>
        <errorMessage>Consumption Revenue Target for BU must be greater than $0 to assign that BU to the employee</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>xCPT_Prevent_DR_Territory_BU_Update</fullName>
        <active>false</active>
        <description>Rule to make sure that the Employee cannot be a part of BU if the corresponding Target Amount is zero. Also, the Employee cannot have a Target Amount if he is not part of the corresponding BU.</description>
        <errorConditionFormula>OR
(
  AND(xCPT_DR_CCG__c, OR(CPT_DR_CCG_Target__c = 0, ISBLANK(CPT_DR_CCG_Target__c))),
  AND(xCPT_DR_DCAI__c, OR(CPT_DR_DCAI_Target__c = 0, ISBLANK(CPT_DR_DCAI_Target__c))),
  AND(xCPT_DR_AXG__c, OR(CPT_DR_AXG_Target__c = 0, ISBLANK(CPT_DR_AXG_Target__c))),
  AND(xCPT_DR_NEX_c__c, OR(CPT_DR_NEX_Target__c = 0, ISBLANK(CPT_DR_NEX_Target__c))),

  AND(CPT_DR_CCG_Target__c &lt;&gt; 0, NOT(ISBLANK(CPT_DR_CCG_Target__c)), NOT(xCPT_DR_CCG__c)),  
  AND(CPT_DR_DCAI_Target__c &lt;&gt; 0, NOT(ISBLANK(CPT_DR_DCAI_Target__c)), NOT(xCPT_DR_DCAI__c)),
  AND(CPT_DR_AXG_Target__c &lt;&gt; 0, NOT(ISBLANK(CPT_DR_AXG_Target__c)), NOT(xCPT_DR_AXG__c)),
  AND(CPT_DR_NEX_Target__c &lt;&gt; 0, NOT(ISBLANK(CPT_DR_NEX_Target__c)), NOT(xCPT_DR_NEX_c__c))
)</errorConditionFormula>
        <errorMessage>Deal Win Revenue Target for BU must be greater than $0 to assign that BU to the employee</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
