    <label>Custom Approval History Config</label>
    <pluralLabel>Custom Approval History Configs</pluralLabel>
    <validationRules>
        <fullName>Core_MDF_Comment_Filer_Reference</fullName>
        <active>true</active>
        <description>to select a single comment field reference value at a time</description>
        <errorConditionFormula>AND(!ISBLANK(Core_MDF_Custom_Label_Configration__c),!ISBLANK( Core_MDF_Comment_Filter_Reference_txt__c))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Custom_Label_Configration__c</errorDisplayField>
        <errorMessage>You can select only one comment field reference at a time</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Masked_label_reqd</fullName>
        <active>true</active>
        <description>Masked Label should not be empty if masked checkbox is selected</description>
        <errorConditionFormula>OR(
AND(Core_MDF_AssignedTo_Masked__c,ISBLANK( Core_MDF_AssignedTo_Masked_Label__c )),
AND( Core_MDF_ActualApprover_Masked__c ,ISBLANK(Core_MDF_ActualApprover_Masked_Label__c)),
AND(  Core_MDF_Comments_Masked__c  ,ISBLANK( Core_MDF_Comments_Masked_Label__c )))</errorConditionFormula>
        <errorMessage>Masked label should not be empty if corresponding masked Checkbox is selected</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
