<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Endpoint__c</fullName>
        <description>Hold Endpoint details</description>
        <label>Endpoint</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>IQR_PIM_Custom_DataLoad_Date__c</fullName>
        <description>This field is used for the date from which PIM service need to pull data</description>
        <inlineHelpText>This field is used for the date from which PIM service need to pull data</inlineHelpText>
        <label>IQR_PIM_Custom_DataLoad_Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>IQR_PIM_Custom_DataLoad__c</fullName>
        <defaultValue>true</defaultValue>
        <description>This flag is used for IQR PIM API data custom load</description>
        <inlineHelpText>This flag is used for IQR PIM API data custom load</inlineHelpText>
        <label>IQR_PIM_Custom_DataLoad</label>
        <trackTrending>false</trackTrending>
