    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>true</enableFeeds>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Amount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
    </fields>
    <fields>
        <fullName>BudgetId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ChannelPartnerId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Available_Allocation_Amount__c</fullName>
        <formula>Amount  -  TotalApprovedFcs</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Available Allocation Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_CreatedBy_Nm__c</fullName>
        <description>Shows the name for external user if created by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF (
ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;),
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <label>Created By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Last_ModifiedBy_Nm__c</fullName>
        <description>Shows the name for external user if last modified by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(LastModifiedBy.Profile.UserType,&apos;PowerPartner&apos;),
LastModifiedBy.FirstName &amp; &apos; &apos; &amp; LastModifiedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <label>Last Modified By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Owner_Nm__c</fullName>
        <description>Shows the name for external user if Owner is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL( Owner:User.Profile.UserType ,&apos;PowerPartner&apos;),
Owner:User.FirstName &amp; &apos; &apos; &amp; Owner:User.LastName ,
$Label.Core_MDF_Intel_System_User
)</formula>
        <label>Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Description</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
    </fields>
    <fields>
        <fullName>OwnerId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Title</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
    </fields>
    <fields>
        <fullName>TotalApprovedFcs</fullName>
    </fields>
    <fields>
        <fullName>TotalApprovedFrs</fullName>
    </fields>
    <fields>
        <fullName>TotalReimbursedFcs</fullName>
    </fields>
    <listViews>
        <fullName>All_Partner_Fund_Allocations</fullName>
        <columns>Name</columns>
        <columns>Budget</columns>
        <columns>ChannelPartner</columns>
        <columns>Description</columns>
        <columns>Amount</columns>
        <filterScope>Everything</filterScope>
        <label>All Partner Fund Allocations</label>
    </listViews>
    <recordTypeTrackFeedHistory>false</recordTypeTrackFeedHistory>
    <recordTypeTrackHistory>true</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Core_MDF_Client_CoMarketing_Fund</fullName>
