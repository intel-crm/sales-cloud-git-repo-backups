    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_AllocAmt_Cannot_be_lesserthan_0</fullName>
        <active>true</active>
        <description>To Validate that Allocation Amount cannot be lesser than 0</description>
        <errorConditionFormula>Amount  &lt; 0</errorConditionFormula>
        <errorMessage>Allocation Amount Cannot be lesser than 0</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Core_MDF_Export_List_View</fullName>
        <availability>online</availability>
