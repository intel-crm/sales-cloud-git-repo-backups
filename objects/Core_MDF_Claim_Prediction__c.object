        <fullName>Core_MDF_Email_Domain_txt__c</fullName>
        <externalId>false</externalId>
        <formula>MID ( Core_MDF_Claim_id__r.Core_MDF_Claim_Submitter_Id__r.Contact.Email ,
FIND( &quot;@&quot;, Core_MDF_Claim_id__r.Core_MDF_Claim_Submitter_Id__r.Contact.Email ) + 1 ,
FIND ( &quot;.&quot;, Core_MDF_Claim_id__r.Core_MDF_Claim_Submitter_Id__r.Contact.Email , FIND( &quot;@&quot;, Core_MDF_Claim_id__r.Core_MDF_Claim_Submitter_Id__r.Contact.Email ) ) - 1 - FIND( &quot;@&quot;, Core_MDF_Claim_id__r.Core_MDF_Claim_Submitter_Id__r.Contact.Email )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Email Domain</label>
