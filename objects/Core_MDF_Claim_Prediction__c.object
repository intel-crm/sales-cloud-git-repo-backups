    <fields>
        <fullName>Core_MDF_Company_Size_Ind__c</fullName>
        <externalId>false</externalId>
        <formula>IF( (Core_MDF_AccountCompany_Nm__c = &apos;DELL INC.&apos;
|| Core_MDF_AccountCompany_Nm__c = &apos;HP INC.&apos;
|| Core_MDF_AccountCompany_Nm__c = &apos;Lenovo (Beijing) Limited&apos; )
,
&apos;BIG&apos;,
IF
(Core_MDF_AccountCompany_Nm__c = &apos;ACER INCORPORATED&apos;|| Core_MDF_AccountCompany_Nm__c = &apos;Hewlett Packard Enterprise Company&apos; || Core_MDF_AccountCompany_Nm__c = &apos;ASUSTEK COMPUTER INCORPORATION&apos; ,
&apos;MEDIUM&apos;,
&apos;LOW&apos;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Company Size</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
