    <validationRules>
        <fullName>PSG_Restrict_DPA_ALN_Edit</fullName>
        <active>false</active>
        <description>It restricts users from creating new record and editing existing records during freeze period.</description>
        <errorConditionFormula>OR(
     ISNEW() ,
     !ISNULL( PRIORVALUE(Id) )
   )</errorConditionFormula>
        <errorMessage>DPA &amp; ALN Record cannot be created or edited during Freeze Period!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Ship_End_Date_Check</fullName>
        <active>true</active>
        <description>Validation will be fired when the Ship End Date is past date.</description>
        <errorConditionFormula>AND(
NOT($Permission.PSG_System_User),
NOT(ISCHANGED( core_cpq_bypass_validation__c)),
ISCHANGED(core_cpq_ship_end_date_dt__c),
core_cpq_ship_end_date_dt__c &lt; TODAY())</errorConditionFormula>
        <errorDisplayField>core_cpq_ship_end_date_dt__c</errorDisplayField>
        <errorMessage>Ship End Date must be a future date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Validate_Quote_CMF_Pricing_Parent</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISNEW(),
 ISPICKVAL(core_cpq_active_quote__r.Pricing_Quote_Program_Nm__c, &apos;PSG&apos;),
OR(
 ISBLANK(core_cpq_active_quote__r.core_cpq_sap_ecp_nm__c),
 core_cpq_sap_end_customer_nm__r.RecordType.Name &lt;&gt; &apos;Direct Account&apos;,
NOT( ISPICKVAL( core_cpq_sap_end_customer_nm__r.Core_Direct_Account_Type_Nm__c , &apos;End Customer Parent&apos;) ),
NOT( core_cpq_sap_end_customer_nm__r.Core_Is_Pricing_Parent_ChkBox__c ), NOT(core_cpq_active_quote__r.core_cpq_pricing_parent_active_cb__c),
 core_cpq_active_quote__r.core_cpq_sap_ecp_nm__c &lt;&gt;  core_cpq_active_quote__r.core_cpq_end_customer_nm__r.Core_Direct_Pricing_Parent_Id__c 
)
)</errorConditionFormula>
        <errorMessage>DPA/ALN cannot be created from Quote having Invalid CMF Pricing Parent</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_validate_SAP_CM</fullName>
        <active>true</active>
        <description>Validates SAP CM</description>
        <errorConditionFormula>AND(
 NOT($Permission.PSG_System_User),
 core_cpq_ship_end_date_dt__c &gt; TODAY(),
 NOT( ISCHANGED( core_cpq_bypass_validation__c )),
 NOT( ISNULL(core_cpq_cm_name_nm__c) ),
 NOT( ISBLANK(core_cpq_cm_name_nm__c) ),
 OR(
   core_cpq_cm_name_nm__r.RecordType.Name &lt;&gt; &apos;Direct Account&apos;,
   NOT(ISPICKVAL(core_cpq_cm_name_nm__r.Core_Direct_Account_Type_Nm__c, &apos;End Customer Parent&apos;)),
ISBLANK( core_cpq_cm_name_nm__r.Core_Direct_Account_Id__c )
 )
)</errorConditionFormula>
        <errorDisplayField>core_cpq_cm_name_nm__c</errorDisplayField>
        <errorMessage>Selected account is not a valid SAP CM. Please select a valid SAP CM</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_validate_SAP_Distributor</fullName>
        <active>true</active>
        <description>Validates SAP Distributor</description>
        <errorConditionFormula>AND(
 NOT($Permission.PSG_System_User),
 core_cpq_ship_end_date_dt__c &gt; TODAY(),
 NOT( ISCHANGED( core_cpq_bypass_validation__c )),
 NOT( ISNULL( core_cpq_sap_distributor_nm__c ) ),
 NOT( ISBLANK(core_cpq_sap_distributor_nm__c) ),
 OR(
    core_cpq_sap_distributor_nm__r.RecordType.Name &lt;&gt; &apos;Direct Account&apos;,
    NOT(ISPICKVAL(core_cpq_sap_distributor_nm__r.Core_Direct_Account_Type_Nm__c, &apos;Sold To&apos;)),  
    NOT(core_cpq_sap_distributor_nm__r.Core_Direct_Account_Active_Ind__c),
    IF( ISPICKVAL(core_cpq_record_type_identifier__c,&apos;DPA&apos;),
     NOT(OR(ISPICKVAL( core_cpq_sap_distributor_nm__r.Core_Nielsen_ID__c ,&apos;P&apos;),ISPICKVAL(core_cpq_sap_distributor_nm__r.Core_Nielsen_ID__c ,&apos;D&apos;))),
     NOT(ISPICKVAL( core_cpq_sap_distributor_nm__r.Core_Nielsen_ID__c ,&apos;L&apos;))
    )  
 ) 
)</errorConditionFormula>
        <errorDisplayField>core_cpq_sap_distributor_nm__c</errorDisplayField>
        <errorMessage>Select a valid SAP Distributor</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_validate_SAP_End_Customer</fullName>
        <active>true</active>
        <description>Validates SAP End Customer</description>
        <errorConditionFormula>AND(
 NOT($Permission.PSG_System_User),
NOT(ISNEW()),
 core_cpq_ship_end_date_dt__c &gt; TODAY(),
 NOT( ISCHANGED( core_cpq_bypass_validation__c )),
 NOT( ISNULL(core_cpq_sap_end_customer_nm__c) ),
 NOT( ISBLANK(core_cpq_sap_end_customer_nm__c) ),
 OR(
   core_cpq_sap_end_customer_nm__r.RecordType.Name &lt;&gt; &apos;Direct Account&apos;,
  NOT( ISPICKVAL( core_cpq_sap_end_customer_nm__r.Core_Direct_Account_Type_Nm__c , &apos;End Customer Parent&apos;) ),
  NOT( core_cpq_sap_end_customer_nm__r.Core_Is_Pricing_Parent_ChkBox__c ),
NOT( core_cpq_sap_end_customer_nm__r.Core_Direct_Account_Active_Ind__c )
  
 )
)</errorConditionFormula>
        <errorDisplayField>core_cpq_sap_end_customer_nm__c</errorDisplayField>
        <errorMessage>Select a valid SAP End Customer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_validate_final_ship_to_customer</fullName>
        <active>true</active>
        <description>Validates final ship to customer</description>
        <errorConditionFormula>AND(
 NOT($Permission.PSG_System_User),
core_cpq_ship_end_date_dt__c &gt; TODAY(),
 NOT( ISCHANGED( core_cpq_bypass_validation__c )),
 NOT( ISNULL(core_cpq_final_ship_to_customer_nm__c) ),
 NOT( ISBLANK(core_cpq_final_ship_to_customer_nm__c) ),
OR(
    core_cpq_final_ship_to_customer_nm__r.RecordType.Name &lt;&gt; &apos;Direct Account&apos;,  NOT(ISPICKVAL(core_cpq_final_ship_to_customer_nm__r.Core_Direct_Account_Type_Nm__c, &apos;End Customer Parent&apos;)),  NOT(core_cpq_final_ship_to_customer_nm__r.Core_Direct_Account_Active_Ind__c) 
 ) 
)</errorConditionFormula>
        <errorDisplayField>core_cpq_final_ship_to_customer_nm__c</errorDisplayField>
        <errorMessage>Select a valid Final Ship-To Customer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_validate_quote_CM</fullName>
        <active>true</active>
        <description>Validates Quote CM</description>
        <errorConditionFormula>AND(
 NOT($Permission.PSG_System_User),
 core_cpq_ship_end_date_dt__c &gt; TODAY(),
 NOT( ISCHANGED( core_cpq_bypass_validation__c )),
 NOT( ISNULL(core_cpq_quote_cm_txt__c) ),
 NOT( ISBLANK(core_cpq_quote_cm_txt__c) ),
 NOT( core_cpq_quote_cm_txt__r.Core_PSG_Account__c ) 
)</errorConditionFormula>
        <errorDisplayField>core_cpq_quote_cm_txt__c</errorDisplayField>
        <errorMessage>Select a valid Quote CM</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
