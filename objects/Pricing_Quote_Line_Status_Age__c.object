    <fields>
        <fullName>Pricing_Approval_Response_Date_Month__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(YEAR (DATEVALUE( Pricing_TPT_Quote_Line_Number__r.Pricing_Last_Approved_Date_dt__c ))) +&apos;-&apos;+ CASE(MONTH(DATEVALUE( Pricing_TPT_Quote_Line_Number__r.Pricing_Last_Approved_Date_dt__c )),
1, &apos;01&apos;,
2, &apos;02&apos;,
3, &apos;03&apos;,
4, &apos;04&apos;,
5, &apos;05&apos;,
6, &apos;06&apos;,
7, &apos;07&apos;,
8, &apos;08&apos;,
9, &apos;09&apos;,
10, &apos;10&apos;,
11, &apos;11&apos;,
12, &apos;12&apos;,
null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Approved/Rejected Month(Gregorian)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
