        <externalId>false</externalId>
        <formula>IF(Pricing_TPT_Status_Time__c &lt; 24.00, &quot;0 Day&quot;,
IF(Pricing_TPT_Status_Time__c &gt;= 24.00 &amp;&amp; Pricing_TPT_Status_Time__c &lt; 48.00, &quot;1 Day&quot;,
IF(Pricing_TPT_Status_Time__c &gt;= 48.00 &amp;&amp; Pricing_TPT_Status_Time__c &lt; 72.00, &quot;2 Days&quot;,
IF(Pricing_TPT_Status_Time__c &gt;= 72.00 &amp;&amp; Pricing_TPT_Status_Time__c &lt; 96.00, &quot;3 Days&quot;,
IF(Pricing_TPT_Status_Time__c &gt;= 96.00 &amp;&amp; Pricing_TPT_Status_Time__c &lt; 144.00, &quot;4-5 Days&quot;,
IF(Pricing_TPT_Status_Time__c &gt;= 144.00 &amp;&amp; Pricing_TPT_Status_Time__c &lt; 240.00, &quot;6-9 Days&quot;,
IF(Pricing_TPT_Status_Time__c &gt; 240.00, &quot;9+ Days&quot;,
NULL)))))))</formula>
        <label>Status Time (days)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_TPT_Status_Time__c</fullName>
        <externalId>false</externalId>
        <label>Status Time (numeric hours)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_TPT_Submitted_By__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Pricing_TPT_User_Role__c == &quot;OEM&quot; &amp;&amp; TEXT(Pricing_TPT_Status_From__c) == &quot;Draft&quot; &amp;&amp; TEXT(Pricing_TPT_Status_Name__c) == &quot;Pending Intel Field Review&quot;, Pricing_TPT_Current_QL_Approver__c,
IF(Pricing_TPT_User_Role__c == &quot;SDM&quot; &amp;&amp; TEXT(Pricing_TPT_Status_From__c) == &quot;Draft&quot; &amp;&amp; TEXT(Pricing_TPT_Status_Name__c) == &quot;Pending Further Intel Review&quot;, Pricing_TPT_Current_QL_Approver__c,
NULL))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Submitted By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_TPT_Submitted_Date__c</fullName>
        <formula>IF(Pricing_TPT_User_Role__c == &quot;OEM&quot; &amp;&amp; TEXT(Pricing_TPT_Status_From__c) == &quot;Draft&quot; &amp;&amp; TEXT(Pricing_TPT_Status_Name__c) == &quot;Pending Intel Field Review&quot;, Pricing_TPT_Set_Time__c,
IF(Pricing_TPT_User_Role__c == &quot;SDM&quot; &amp;&amp; TEXT(Pricing_TPT_Status_From__c) == &quot;Draft&quot; &amp;&amp; TEXT(Pricing_TPT_Status_Name__c) == &quot;Pending Further Intel Review&quot;, Pricing_TPT_Set_Time__c,
NULL))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Submitted Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Pricing_TPT_To_Stage_Actor_Nm__c</fullName>
        <externalId>false</externalId>
        <label>To Stage Actor</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
