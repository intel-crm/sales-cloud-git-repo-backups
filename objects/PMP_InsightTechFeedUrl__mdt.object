<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Insight.Tech RSS Feed URLs for the supported languages</description>
    <fields>
        <fullName>PMP_Feed_URL__c</fullName>
        <description>RSS Feed URL of Insight.Tech</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Feed URL</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Language_Code__c</fullName>
        <description>Language Code related to the URL</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Language Code</label>
        <length>50</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_isActive__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Is the URL active</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>isActive</label>
        <type>Checkbox</type>
    </fields>
    <label>PMP_InsightTechFeedUrl</label>
    <pluralLabel>PMP_InsightTechFeedUrls</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
