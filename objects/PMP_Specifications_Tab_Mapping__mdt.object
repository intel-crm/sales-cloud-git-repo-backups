<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This will hold the configuration information for the specifications that needs to be displayed in create offering component.</description>
    <fields>
        <fullName>Accordion_Type__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Accordion Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>default</fullName>
                    <default>true</default>
                    <label>default</label>
                </value>
                <value>
                    <fullName>accordion</fullName>
                    <default>false</default>
                    <label>accordion</label>
                </value>
                <value>
                    <fullName>search</fullName>
                    <default>false</default>
                    <label>search</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Display_Order__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Display Order</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Interaction_Type__c</fullName>
        <defaultValue>&quot;parent&quot;</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Interaction Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>parent</fullName>
                    <default>true</default>
                    <label>parent</label>
                </value>
                <value>
                    <fullName>recursive</fullName>
                    <default>false</default>
                    <label>recursive</label>
                </value>
                <value>
                    <fullName>default</fullName>
                    <default>false</default>
                    <label>default</label>
                </value>
                <value>
                    <fullName>parent_recursive</fullName>
                    <default>false</default>
                    <label>parent_recursive</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>IsAccordion__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>IsAccordion</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsSearchable__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>IsSearchable</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Field_Label__c</fullName>
        <description>Label to display on UI</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Field Label</label>
        <length>40</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Show_Select_All__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If checked, an extra option will be created as a parent node for the UI checkbox to select all values</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Show Select All</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Tab__c</fullName>
        <description>To which tab the specification belongs</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Tab</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Tab1</fullName>
                    <default>true</default>
                    <label>Tab1</label>
                </value>
                <value>
                    <fullName>Tab2</fullName>
                    <default>false</default>
                    <label>Tab2</label>
                </value>
                <value>
                    <fullName>Tab3</fullName>
                    <default>false</default>
                    <label>Tab3</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>PMP Specifications Tab Mapping</label>
    <pluralLabel>PMP Specifications Tab Mappings</pluralLabel>
    <validationRules>
        <fullName>PMP_Interaction_type_recursive_selectAll</fullName>
        <active>true</active>
        <description>If select all is true, then the interaction type should be recursive</description>
        <errorConditionFormula>AND( Show_Select_All__c  = true,  NOT(ISPICKVAL(Interaction_Type__c, &apos;parent_recursive&apos;)))</errorConditionFormula>
        <errorDisplayField>Interaction_Type__c</errorDisplayField>
        <errorMessage>Interaction type should be recursive when &quot;Show Select All&quot; is set to true</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
