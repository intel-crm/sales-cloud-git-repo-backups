    <fields>
        <fullName>Core_Lost_Sales_Price__c</fullName>
        <description>Sales Price of a product in Lost, Cancelled, or Deleted Status</description>
        <inlineHelpText>Lost Sales Price for a single unit</inlineHelpText>
        <label>Lost Sales Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_Lost_Total_Price__c</fullName>
        <description>Lost Sales Price X Quantity</description>
        <formula>Core_Lost_Sales_Price__c * Quantity</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Lost Sales Price x Quantity</inlineHelpText>
        <label>Lost Total Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_Lost_to_Open_Flag__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Flag this is automatically checked if an Opportunity is moved from a Lost to Open status so that workflow rules can run off of it</description>
        <label>Lost to Open Flag</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Normalized_Product_Name__c</fullName>
        <externalId>false</externalId>
        <formula>SUBSTITUTE(SUBSTITUTE(PricebookEntry.Product2.Name, &quot;®&quot;, &quot;&quot;), &quot;™&quot;, &quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Normalized Product Name</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_OEM_LOEM_Other__c</fullName>
