        <fullName>Core_System_Competitor_Empty_Flag__c</fullName>
        <description>This flag indicates if Competitor OEM OR Competitor OEM Product value is blank.</description>
        <externalId>false</externalId>
        <formula>IF(
AND(
OR(
 ISPICKVAL(Core_Status__c, &apos;Pending&apos;),
 ISPICKVAL(Core_Status__c, &apos;On-Hold&apos;),
 ISPICKVAL(Core_Status__c, &apos;Win Approved&apos;),
 ISPICKVAL(Core_Status__c, &apos;Production Win&apos;),
 ISPICKVAL(Core_Status__c, &apos;Production Win Approved&apos;)
),
OR(
ISPICKVAL(Core_Competitor__c,&quot;&quot;),
ISPICKVAL(Core_Competitor_Product__c,&quot;&quot;)
)
),1,0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System Competitor Empty Flag</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
