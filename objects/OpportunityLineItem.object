    <fields>
        <fullName>Core_IsPCCOpportunity_cb__c</fullName>
        <description>Identifies if the associated opportunity is PCC Deal opportunity or not.</description>
        <formula>AND(
	ISPICKVAL(Opportunity.Core_Coverage_Type_Nm__c, &apos;Deal Registration&apos;),
	ISPICKVAL(Opportunity.Core_Opportunity_Coverage_Nm__c, &apos;Partner-Led Opportunity&apos;)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IsPCCOpportunity?</label>
        <type>Checkbox</type>
    </fields>
