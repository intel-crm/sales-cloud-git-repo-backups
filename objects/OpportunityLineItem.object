    <fields>
        <fullName>Core_At_Risk_Status__c</fullName>
        <description>At risk status picklist on Opportunity Product</description>
        <label>Risk Status</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>New</fullName>
                    <default>false</default>
                    <label>New</label>
                </value>
                <value>
                    <fullName>In-Progress</fullName>
                    <default>false</default>
                    <label>In-Progress</label>
                </value>
                <value>
                    <fullName>Closed: Support Provided</fullName>
                    <default>false</default>
                    <label>Closed: Support Provided</label>
                </value>
                <value>
                    <fullName>Closed: Support Not Provided</fullName>
                    <default>false</default>
                    <label>Closed: Support Not Provided</label>
                </value>
                <value>
                    <fullName>Closed: Customer Not Satisfied </fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Closed: Customer Not Satisfied </label>
                </value>
                <value>
                    <fullName>Closed: Customer Satisfied</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Closed: Customer Satisfied</label>
                </value>
                <value>
                    <fullName>Closed: Unable to Support</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Closed: Unable to Support</label>
                </value>
                <value>
                    <fullName>No Longer At Risk</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>No Longer At Risk</label>
                </value>
                <value>
                    <fullName>Support Granted By HQ</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Support Granted By HQ</label>
                </value>
                <value>
                    <fullName>Support Not Granted By HQ</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Support Not Granted By HQ</label>
                </value>
                <value>
                    <fullName>Support Not Provided</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Support Not Provided</label>
                </value>
                <value>
                    <fullName>Support Not Required</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Support Not Required</label>
                </value>
                <value>
                    <fullName>Support Provided</fullName>
