    <validationRules>
        <fullName>CRM_Restrict_OppAuditorsEdit_OLI</fullName>
        <active>true</active>
        <description>Restricts Opportunity Auditors from editing the opportunity products</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,FALSE,
OR(
AND(
ISNEW(),
$Permission.CRM_Opportunity_Auditor_CustomPermission,
$Profile.Name = &apos;SMG/GMC Read Only&apos;
),
AND(
$Permission.CRM_Opportunity_Auditor_CustomPermission,
$Profile.Name = &apos;SMG/GMC Read Only&apos;,
OR(
ISCHANGED( Quantity ),
ISCHANGED( UnitPrice),
ISCHANGED( Core_Status__c )
)
)
)
)</errorConditionFormula>
        <errorMessage>Auditors do not have permission to add new products OR  delete products OR update any fields other than the Audit Section Fields on opportunity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Status_Change_Restriction</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF((( ISPICKVAL(Opportunity.Core_Opportunity_Coverage_Nm__c, &apos;Intel-Led Opportunity&apos;) &amp;&amp; (OR(ISPICKVAL(Opportunity.Core_VBS_Status__c , &apos;Pending&apos;),ISPICKVAL(Opportunity.Core_VBS_Status__c , &apos;SOAR1 Qualified&apos;)) &amp;&amp; Opportunity.Core_VBS_Potential__c)) &amp;&amp; (ISCHANGED( Core_Status__c ) || ISCHANGED( Quantity ) || ISCHANGED( UnitPrice ) || ISCHANGED( Core_Write_In_Product_Name__c ) || ISCHANGED( Core_Vendor__c ) || ISCHANGED( TotalPrice ))) , TRUE, FALSE)
)</errorConditionFormula>
        <errorMessage>Opportunity Product cannot be updated when there is a SOAR Process Pending/Qualified.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_AtRisk_NewOrInProgress</fullName>
        <active>true</active>
        <description>Users are prevented from changing the Status of a Opportunity Product to Lost, Cancelled, Production Lost, Production Cancelled, Deleted or Production Win if the product is flagged at risk with the Risk Status = &apos;New&apos; or &apos;In Progress&apos;.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, AND(
ISChanged(Core_Status__c),
OR(  ISPICKVAL(Core_Status__c, &apos;Lost&apos;) ,  ISPICKVAL(Core_Status__c, &apos;Cancelled&apos;), ISPICKVAL(Core_Status__c, &apos;Deleted&apos;), ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;),  ISPICKVAL(Core_Status__c, &apos;Production Win&apos;) , ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)) , AND( Core_At_Risk__c = true,  OR(ISPICKVAL(Core_At_Risk_Status__c, &apos;New&apos;),ISPICKVAL(Core_At_Risk_Status__c, &apos;In-Progress&apos;)))))</errorConditionFormula>
        <errorMessage>Product status cannot be updated as specified as the product is flagged at risk. Please navigate to the At Risk tab to either uncheck the At Risk checkbox or disposition the Risk Status to a “Closed” state.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Cannot_Recall_Cancel_Failed_Audit</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_LineItem_Recall_Access__c.Core_Recall_Access__c=TRUE,FALSE,
AND(
ISCHANGED(Core_Loss_Cancel_Reason__c),
ISPICKVAL(PRIORVALUE(Core_Loss_Cancel_Reason__c), &quot;Failed Audit&quot;)
)

)</errorConditionFormula>
        <errorMessage>This product is locked and not available for edit due to POP Audit Failure.  Please contact smg.pop.audit.team@intel.com with any questions.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Cannot_Set_Cancel_Failed_Audit</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_LineItem_Recall_Access__c.Core_Recall_Access__c=TRUE,FALSE,
AND(
OR(
ISCHANGED(Core_Status__c),
ISCHANGED(Core_Loss_Cancel_Reason__c)
),
ISPICKVAL(Core_Status__c, &quot;Cancelled&quot;),
ISPICKVAL(Core_Loss_Cancel_Reason__c, &quot;Failed Audit&quot;)
)
)</errorConditionFormula>
        <errorMessage>You do not have access to do this action. Please contact your system administrator.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_DealOppty_PWStage_OpptyProd</fullName>
        <active>false</active>
        <description>User should not be able to update products of Deal type of opportunities with the &quot;Production Win&quot;, &quot;Production Lost&quot; &amp; &quot;Production Cancelled&quot; picklist values</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Opportunity.RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos;, 
ISCHANGED( Core_Status__c ),
OR(
ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;), 
ISPICKVAL(Core_Status__c, &apos;Production Win Approved&apos;) , 
ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)
)
)
)</errorConditionFormula>
        <errorMessage>Production Win/Lost/Cancelled Stages are not applicable for Deal Opportunity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_DesignFlag_True_For_OppType_Design</fullName>
        <active>true</active>
        <description>if the opportunity type is &quot; Design&quot; and  throw error if the product  &quot;New Available design flag&quot;  is false.</description>
        <errorConditionFormula>AND( 
CONTAINS( TEXT(Opportunity.Core_Opportunity_Type__c) , &quot;Design&quot;), 
NOT( Product2.Core_Avail_for_New_Designs__c ),
Core_Design_Registration_Product_Id__c = &apos;&apos;,
ISNEW()
)</errorConditionFormula>
        <errorMessage>Product not available for new designs.  Please select a product that is marked available for new designs on the selection page.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lock_Field_After_Opp_ApprovalDesign</fullName>
        <active>true</active>
        <description>Throws an error message when a user try to edit some fields of opportunity products after opportunity is approved</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Opportunity.RecordType.DeveloperName =&apos;Core_Design_Opportunity&apos;,
AND(
ISPICKVAL(Opportunity.Core_Approval_Status__c, &apos;Approved&apos;),
 OR(
ISPICKVAL(Core_Status__c, &apos;Win Approved&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Win&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;))),
ISCHANGED( Core_Write_In_Product_Name__c )
)
)</errorConditionFormula>
        <errorMessage>&quot;Write In Product Name&quot; can&apos;t be changed after approval.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lock_Field_After_Opp_Approval_Deal</fullName>
        <active>true</active>
        <description>Throws an error message when a user try to edit some fields of opportunity products after opportunity is approved</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Opportunity.RecordType.DeveloperName = &apos;Core_Deal_Opportunity&apos;,
Core_IsPCCOpportunity_cb__c = false,
AND(
ISPICKVAL(Opportunity.Core_Approval_Status__c, &apos;Approved&apos;),
NOT(ISCHANGED( Core_Status__c) ),
OR(
ISPICKVAL(Core_Status__c, &apos;Win Approved&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Win Approved&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;))
),
NOT(OR(
	ISPICKVAL(PRIORVALUE(Core_Status__c), &quot;Production Lost&quot;),
    ISPICKVAL(PRIORVALUE(Core_Status__c), &quot;Production Cancelled&quot;)
	)
	),
OR(
ISCHANGED( Core_Write_In_Product_Name__c ),
ISCHANGED( Quantity ),
ISCHANGED( UnitPrice ))
)
)</errorConditionFormula>
        <errorMessage>These fields can&apos;t be changed after approval:
1. Write In Product Name
2. Quantity
3. Sales Price</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Loss_Cancel_Details_Mandatory</fullName>
        <active>true</active>
        <description>‘Loss/Cancel Details’ on Opportunity Product level to be made mandatory for Lost, Cancelled, Production Lost, Production Cancelled ‘Opportunity Stage’ or ‘Product Status’.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(CONTAINS($Label.CRM_Bypass_Validation_Profile_Name, $Profile.Name )),
IF(
(Opportunity.RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos; &amp;&amp;
ISCHANGED( Core_Status__c )&amp;&amp;
OR(
ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)
)
)=TRUE, FALSE,
OR(
AND(
ISBLANK( Opportunity.Core_Design_Registration_Id__c ),
OR(
ISPICKVAL(Core_Status__c, &apos;Lost&apos;) ,
ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;) ,
AND(
ISPICKVAL(Core_Status__c, &apos;Cancelled&apos;),
ISPICKVAL(Opportunity.Core_Opportunity_Coverage_Nm__c, &apos;Partner-Led Opportunity&apos;)
),
ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)
),
ISBLANK(Core_Loss_Cancel_Details__c)
),
AND(
NOT(AND(
ISPICKVAL (Core_Status__c, &apos;Win Approved&apos;),
OR(
ISPICKVAL(PRIORVALUE(Core_Status__c), &apos;Production Cancelled&apos;),
ISPICKVAL(PRIORVALUE(Core_Status__c), &apos;Production Lost&apos;)
)
)
),
NOT(ISBLANK(PRIORVALUE(Core_Loss_Cancel_Details__c))),
ISBLANK(Core_Loss_Cancel_Details__c)
,Opportunity.CRM_IsLowTouchAdmin_Chk__c=false
)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Loss_Cancel_Details__c</errorDisplayField>
        <errorMessage>Loss/Cancel Details is required if Stage is set to Lost or Production Lost or Cancelled or Production Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Loss_Cancel_Reason_Mandatory</fullName>
        <active>true</active>
        <description>‘Loss/Cancel Reason’ on Opportunity Product level to be made mandatory for Lost, Cancelled, Production Lost, Production Cancelled ‘Opportunity Stage’ or ‘Product Status’.</description>
        <errorConditionFormula>IF(
(Opportunity.RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos; &amp;&amp;
ISCHANGED( Core_Status__c )&amp;&amp;
OR(
ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Win&apos;) ,
ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)
))=TRUE, FALSE,

IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(CONTAINS($Label.CRM_Bypass_Validation_Profile_Name, $Profile.Name )),
OR(
ISPICKVAL(Core_Status__c, &apos;Lost&apos;) ,
ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;) ,
AND(
ISPICKVAL(Core_Status__c, &apos;Cancelled&apos;),
ISPICKVAL(Opportunity.Core_Opportunity_Coverage_Nm__c, &apos;Partner-Led Opportunity&apos;)
),
ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)
),
ISPICKVAL(Core_Loss_Cancel_Reason__c, &apos;&apos;)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Loss_Cancel_Reason__c</errorDisplayField>
        <errorMessage>Loss/Cancel Reason is required if Stage is set to Lost or Production Lost or Cancelled or Production Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_No_Product_Lost_Cancel_oppty</fullName>
        <active>true</active>
        <description>Do not allow products to Opportunities with a Stage of Lost or Cancelled.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(OR(
ISPICKVAL(Opportunity.StageName,&apos;Lost&apos;),
ISPICKVAL(Opportunity.StageName,&apos;Cancelled&apos;),
ISPICKVAL(Opportunity.StageName,&apos;Production Lost&apos;),
ISPICKVAL(Opportunity.StageName,&apos;Production Cancelled&apos;)
),
ISNEW()
)
)</errorConditionFormula>
        <errorMessage>Product cannot be added to Opportunities with a Stage of Lost or Cancelled.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_No_Product_Post_Approval</fullName>
        <active>true</active>
        <description>Do not allow products addition in Design Win, Lost, Cancelled, Production Win, Production Lost, Product Lost, Production cancelled Except Post Win</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(CONTAINS($Label.CRM_Bypass_Validation_Profile_Name, $Profile.Name )),
OR(
ISPICKVAL(Opportunity.StageName,&apos;Production Win&apos;),
ISPICKVAL(Opportunity.StageName,&apos;Design Win&apos;)
),
ISNEW(),
NOT(ISPICKVAL(Core_Status__c,&apos;Post-Win&apos;))
)
)</errorConditionFormula>
        <errorMessage>In order to add a product after Design Win Stage, you must change the (Product) Status to Post Win</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Not_Allow_Lost_Products_At_Risk</fullName>
        <active>true</active>
        <description>Not allow lost/cancelled products to enter the at risk information</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
 AND(
 OR( ISPICKVAL(Core_Status__c, &apos;Lost&apos;) , ISPICKVAL(Core_Status__c, &apos;Cancelled&apos;), ISPICKVAL(Core_Status__c, &apos;Deleted&apos;), ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;) , ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)) ,
 OR(ISChanged(Core_At_Risk__c))
 
 ))</errorConditionFormula>
        <errorMessage>Product is lost/Cancel/Production Lost/Production Cancelled you can not modify</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProdPrevent_Cancel</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL( Core_Status__c , &apos;Cancelled&apos;) ,
ISCHANGED(Core_Status__c),
ISPICKVAL( Opportunity.Core_Opportunity_Coverage_Nm__c , &apos;Intel-Led Opportunity&apos;) ,
AND (
$Profile.Name &lt;&gt; $Label.Core_Data_Ops_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name
)

)</errorConditionFormula>
        <errorMessage>Cancelled Status cannot be selected on an Opportunity Product , Please select Lost Status instead</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_NoNewPrdOnSubmittedOppty</fullName>
        <active>true</active>
        <description>Should not allow to add Products if Opportunity is in Submitted status</description>
        <errorConditionFormula>AND( 
ISNEW(),  
text(Opportunity.Core_Approval_Status__c)= &quot;Submitted&quot;
)</errorConditionFormula>
        <errorMessage>Please recall submission to add product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_PW_Quantity_SalesPrice</fullName>
        <active>true</active>
        <description>Prevents updating the PW Sales Price, PW Quantity if an Opportunity is in Lost, Cancelled, or Deleted status</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
OR(
AND(ISCHANGED(Core_PW_Sales_Price__c),NOT(Core_PW_Sales_Price__c=0)),
ISCHANGED(Core_PW_Quantity__c)),
OR(
ISPICKVAL(Core_Status__c, &quot;Lost&quot;),
ISPICKVAL(Core_Status__c, &quot;Cancelled&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Lost&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Cancelled&quot;),
ISPICKVAL(Core_Status__c, &quot;Deleted&quot;)
),
CONTAINS( TEXT(Opportunity.Core_Opportunity_Type__c),&apos;Design&apos;),
NOT(ISCHANGED(Core_BypassFlow__c))
)
)</errorConditionFormula>
        <errorMessage>Production Sales Price/Quantity cannot be updated on Lost, Cancelled, Production Lost, Production Cancelled, and Deleted products.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Production_Cancelled</fullName>
        <active>true</active>
        <description>Allows only the person who approved the product win to change to a status which is prior to approval, except admin users.</description>
        <errorConditionFormula>AND(
Opportunity.CRM_IsLowTouchAdmin_Chk__c==false,
NOT($Setup.Core_Opp_LineItem_Recall_Access__c.Core_Recall_Access__c),
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Cancelled&quot;,
ISCHANGED(Core_Status__c),
NOT(Opportunity.Core_PC_PL_Reversal_Backend_Field__c),
IF(Opportunity.Owner.ManagerId &lt;&gt; $User.Id, IF(Opportunity.Core_Technical_Owner__r.ManagerId &lt;&gt; $User.Id, AND(Core_Approved_By__c &lt;&gt; TRIM($User.FirstName + &apos; &apos; + $User.LastName), Core_Approved_User_Id__c &lt;&gt; $User.Id), FALSE), FALSE),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(OR(
TEXT(Core_Status__c) = &apos;Production Win Approved&apos;,
TEXT(Core_Status__c) = &apos;Production Lost&apos;,
TEXT(Core_Status__c) = $Label.Core_LineItem_Status,
AND(TEXT(Core_Status__c) = &apos;Pending&apos;, TEXT(Opportunity.Core_Approval_Status__c) =&apos;Approved&apos;)
))
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Only the person who approved the product win can change to a status which is prior to approval.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Production_Lost</fullName>
        <active>true</active>
        <description>Allows only the person who approved the product win to change to a status which is prior to approval, except admin users.</description>
        <errorConditionFormula>AND(
Opportunity.CRM_IsLowTouchAdmin_Chk__c==false,
NOT($Setup.Core_Opp_LineItem_Recall_Access__c.Core_Recall_Access__c),
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Lost&quot;,
ISCHANGED(Core_Status__c),
NOT(Opportunity.Core_PC_PL_Reversal_Backend_Field__c),
IF(Opportunity.Owner.ManagerId &lt;&gt; $User.Id, IF(Opportunity.Core_Technical_Owner__r.ManagerId &lt;&gt; $User.Id, AND(Core_Approved_By__c &lt;&gt; TRIM($User.FirstName + &apos; &apos; + $User.LastName), Core_Approved_User_Id__c &lt;&gt; $User.Id), FALSE), FALSE),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,

$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(OR(
TEXT(Core_Status__c) = &apos;Production Win Approved&apos;,
TEXT(Core_Status__c) = &apos;Production Cancelled&apos;,
TEXT(Core_Status__c) = $Label.Core_LineItem_Status,
AND(TEXT(Core_Status__c) = &apos;Pending&apos;, TEXT(Opportunity.Core_Approval_Status__c) =&apos;Approved&apos;)

))
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Only the person who approved the product win can change to a status which is prior to approval</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Production_Status</fullName>
        <active>true</active>
        <description>Do not allow status to Production until after the win approval step.</description>
        <errorConditionFormula>OR(
(
(Opportunity.RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos;) &amp;&amp;
ISCHANGED( Core_Status__c )&amp;&amp;
NOT(OR(
Text(PRIORVALUE(Core_Status__c)) = &quot;Win Approved&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Win&quot;,
$Profile.Name = $Label.Core_System_Admin_Profile_Name,
$Profile.Name = $Label.Core_IT_Admin_Profile_Name
)
)&amp;&amp;
OR(
ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Win&apos;) ,
ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)
)
)
,
IF(Opportunity.CRM_IsLowTouchAdmin_Chk__c = true,
FALSE, 
AND(
ISCHANGED(Core_Status__c),
OR(
TEXT(Core_Status__c) = &apos;Production Win Approved&apos;,
TEXT(Core_Status__c) = &apos;Production Lost&apos;,
TEXT(Core_Status__c) = &apos;Production Cancelled&apos;
),
NOT(OR(
Text(PRIORVALUE(Core_Status__c)) = &quot;Win Approved&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Win&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Win Approved&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Win Submitted&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Lost&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Cancelled&quot;,
$Profile.Name = $Label.Core_System_Admin_Profile_Name,
$Profile.Name = $Label.Core_IT_Admin_Profile_Name
))
)))</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Products must be win approved before going to production.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Production_Win</fullName>
        <active>true</active>
        <description>Allows only the person who approved the product win to change to a status which is prior to approval, except admin users.</description>
        <errorConditionFormula>AND(
NOT($Setup.Core_Opp_LineItem_Recall_Access__c.Core_Recall_Access__c),
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Win Approved&quot;,
ISCHANGED(Core_Status__c),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(OR(
TEXT(Core_Status__c) = &apos;Production Lost&apos;,
TEXT(Core_Status__c) = &apos;Production Cancelled&apos;,
TEXT(Core_Status__c) = $Label.Core_LineItem_Status,
TEXT(Core_Status__c) = &apos;Win Approved&apos;,
AND(TEXT(Core_Status__c) = &apos;Pending&apos;, TEXT(Opportunity.Core_Approval_Status__c) =&apos;Approved&apos;),
AND(TEXT(Core_Status__c) = &apos;Pending&apos;, Opportunity.CRM_IsLowTouchAdmin_Chk__c = true))
))</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>When Product Status is Changed from PW Approved to any other before approval Status(i.e OnHold, Pending, Lost, Cancelled) - Production Win stage can be only reversed to Design Win Stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Reason_if_Lost</fullName>
        <active>false</active>
        <description>Require a value in the Reason field if the status is set to Lost, Cancelled, Production Lost, or Production Cancelled</description>
        <errorConditionFormula>AND(
  ISBLANK(TEXT(Core_Loss_Cancel_Reason__c)),
  $Profile.Name &lt;&gt; $Label.Core_Integration_Profile_Name,
  OR( 
    text(Core_Status__c) = &quot;Lost&quot;,
    text(Core_Status__c) = &quot;Cancelled&quot;,
    text(Core_Status__c) = &quot;Production Lost&quot;,
    text(Core_Status__c) = &quot;Production Cancelled&quot;
  )
)</errorConditionFormula>
        <errorDisplayField>Core_Loss_Cancel_Reason__c</errorDisplayField>
        <errorMessage>Required if Stage is Lost, Cancelled, Production Lost, or Production Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Req_Competitor_OEM</fullName>
        <active>true</active>
        <description>Competitor is required if Product Status is Lost.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(CONTAINS($Label.CRM_Bypass_Validation_Profile_Name, $Profile.Name )),
IF((Core_IsPCCOpportunity_cb__c)=TRUE, FALSE,
OR(
AND(
ISCHANGED(Core_Status__c),
OR(
ISPICKVAL(Core_Status__c, &quot;Lost&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Lost&quot;)
),
ISPICKVAL(Core_Competitor__c, &quot;&quot;)
),
(AND(
ISCHANGED(Core_Competitor__c),
OR(
ISPICKVAL(Core_Status__c, &quot;Lost&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Lost&quot;)
),
ISPICKVAL(Core_Competitor__c, &quot;&quot;))
)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Competitor__c</errorDisplayField>
        <errorMessage>Competitor is required if Product Status is Lost/Production Lost.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Req_Competitor_OEM_Product</fullName>
        <active>true</active>
        <description>Competitor Product is required if Product Status is Lost.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(CONTAINS($Label.CRM_Bypass_Validation_Profile_Name, $Profile.Name )),
IF((Core_IsPCCOpportunity_cb__c)=TRUE, FALSE,
OR(
AND(
ISCHANGED(Core_Status__c),
OR(
ISPICKVAL(Core_Status__c, &quot;Lost&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Lost&quot;)
),
ISPICKVAL(Core_Competitor_Product__c, &quot;&quot;)
),
(AND(
ISCHANGED(Core_Competitor_Product__c),
OR(
ISPICKVAL(Core_Status__c, &quot;Lost&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Lost&quot;)
),
ISPICKVAL(Core_Competitor_Product__c, &quot;&quot;))
)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Competitor_Product__c</errorDisplayField>
        <errorMessage>Competitor Product is required if Product Status is Lost/Production Lost.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Req_OEM_Other</fullName>
        <active>true</active>
        <description>Require OEM/LOEM - Other field if you select &apos;Other&apos; in the OEM/LOEM field</description>
        <errorConditionFormula>AND(
ISPICKVAL(Core_OEM_LOEM__c, &quot;Other&quot;) = TRUE,
ISBLANK(Core_OEM_LOEM_Other__c)
)</errorConditionFormula>
        <errorDisplayField>Core_OEM_LOEM_Other__c</errorDisplayField>
        <errorMessage>Required if OEM/LOEM is Other</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Sales_Price</fullName>
        <active>true</active>
        <description>Prevents updating the Sales Price,Quantity if an Opportunity is in Lost, Cancelled, or Deleted status</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
OR(
AND(ISCHANGED(UnitPrice),NOT(UnitPrice=0)),
ISCHANGED(Quantity)),
OR(
ISPICKVAL(Core_Status__c, &quot;Lost&quot;),
ISPICKVAL(Core_Status__c, &quot;Cancelled&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Lost&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Cancelled&quot;),
ISPICKVAL(Core_Status__c, &quot;Deleted&quot;)
)
)
)</errorConditionFormula>
        <errorMessage>Sales price and Quantity cannot be updated on Lost, Cancelled, Production Lost, Production Cancelled, and Deleted products</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_To_Be_Delete</fullName>
        <active>true</active>
        <description>product status (Production Stages + Lost + Win Approved) hard stop when they click on Delete</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
OR(
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Win&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Lost&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Production Cancelled&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Win Approved&quot;,
Text(PRIORVALUE(Core_Status__c)) = &quot;Lost&quot; 
),
ISCHANGED(Core_Status__c),
TEXT(Core_Status__c) = $Label.Core_LineItem_Status
)
)</errorConditionFormula>
        <errorMessage>One or more products is At Risk and/or has an ineligible Status for deletion. Please edit your request and resubmit</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_WinSub_To_Pend</fullName>
        <active>true</active>
        <description>Prevent users from changing product line item Status from &quot;Win Submitted&quot; to &quot;Pending&quot;</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(CONTAINS($Label.CRM_Bypass_Validation_Profile_Name, $Profile.Name )),
ISCHANGED(Core_Status__c),
NOT(Opportunity.Core_Bypass_Field_Validation__c),
text(PRIORVALUE(Core_Status__c)) = &quot;Win Submitted&quot;,
TEXT(Core_Status__c) = &quot;Pending&quot;
))</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>To set the product back to pending, submitter can use the Recall Approval Request button in the Approval History section or the approving manager can reject the approval request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Win_Approved</fullName>
        <active>true</active>
        <description>Allows only the person who approved the product win to change to a status which is prior to approval, except admin users.</description>
        <errorConditionFormula>AND( 
	NOT($Setup.Core_Opp_LineItem_Recall_Access__c.Core_Recall_Access__c),
	Text(PRIORVALUE(Core_Status__c)) = &quot;Win Approved&quot;,
	ISCHANGED(Core_Status__c),
	IF(Opportunity.Owner.ManagerId &lt;&gt; $User.Id, IF(Opportunity.Core_Technical_Owner__r.ManagerId &lt;&gt; $User.Id, AND(Core_Approved_By__c &lt;&gt; TRIM($User.FirstName + &apos; &apos; + $User.LastName), Core_Approved_User_Id__c &lt;&gt; $User.Id), FALSE), FALSE),
	$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name, 
	$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name, 
	NOT(
		OR(
			TEXT(Core_Status__c) = &apos;Production Win Approved&apos;,          TEXT(Core_Status__c) = &apos;Production Win&apos;,
			TEXT(Core_Status__c) = &apos;Production Lost&apos;, 
			TEXT(Core_Status__c) = &apos;Production Cancelled&apos;,
			TEXT(Core_Status__c) = &apos;Production Win Submitted&apos;,
			TEXT(Core_Status__c) = $Label.Core_LineItem_Status,
			AND(TEXT(Core_Status__c) = &apos;Pending&apos;, TEXT(Opportunity.Core_Approval_Status__c) =&apos;Approved&apos;)

		)
		)
	)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Only the person who approved the product win can change to a status which is prior to approval</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProd_Write_In_Name</fullName>
        <active>true</active>
        <description>Require Write in Product Name if a write in product is used</description>
        <errorConditionFormula>AND(
Product2.Name = &quot;Write In Product&quot;,
ISBLANK(Core_Write_In_Product_Name__c) = True
)</errorConditionFormula>
        <errorDisplayField>Core_Write_In_Product_Name__c</errorDisplayField>
        <errorMessage>Required for write in products</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProduct_PreventUpdateToBeDeleted</fullName>
        <active>true</active>
        <description>Once the Opportunity Product is marked for To Be Deleted, users are not allowed to edit it. That product will get deleted by the flow.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
OR(
ISPICKVAL(PRIORVALUE(Core_Status__c),&quot;Delete In Progress (&lt;15 min)&quot;),
AND(
NOT(ISNEW()),
ISPICKVAL(PRIORVALUE(Core_Status__c),&quot;Delete In Progress (&lt;15 min)&quot;)
)
)
)</errorConditionFormula>
        <errorMessage>You are not allowed to edit the Opportunity Product after it is marked for Delete In Progress (&lt;15 min).
Please add a new product.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppProduct_Prevent_Inactive_Account</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Core_Vendor__c != &apos;&apos;,
Core_Vendor__r.RecordType.DeveloperName != &apos;Mastered_Account&apos;,

NOT(
OR (
ISPICKVAL(Core_Status__c,&apos;Delete In Progress (&lt;15 min)&apos;),
ISPICKVAL(Core_Status__c,&apos;Lost&apos;),
ISPICKVAL(Core_Status__c,&apos;Cancelled&apos;),
ISPICKVAL(Core_Status__c,&apos;Production Win&apos;),
ISPICKVAL(Core_Status__c,&apos;Production Lost&apos;),
ISPICKVAL(Core_Status__c,&apos;Production Cancelled&apos;),
ISPICKVAL(Core_Status__c,&apos;Win Approved&apos;),
ISPICKVAL(Core_Status__c,&apos;Win Submitted&apos;)
)
)

)
)</errorConditionFormula>
        <errorMessage>The Vendor that you are attempting to relate this Opportunity Product to is not Intel Account. Please choose an Intel Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Prevent_Product_Add_PCCDealReg</fullName>
        <active>true</active>
        <description>New Products cannot be added directly for PCC Deal Opportunities</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND ( 
ISPICKVAL(Opportunity.Core_Coverage_Type_Nm__c, &apos;Deal Registration&apos;), ISPICKVAL(Opportunity.Core_Opportunity_Coverage_Nm__c , &apos;Partner-Led Opportunity&apos;), 
Core_Design_Registration_Product_Id__c = null,
ISNEW() 
)
)</errorConditionFormula>
        <errorMessage>New products cannot be added to the Opportunity. Please contact your Intel representative to make a change.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Prevent_Product_Del_By_Partner</fullName>
        <active>true</active>
        <description>Restrict deletion of Opportunity Product by Partner user</description>
        <errorConditionFormula>TEXT(Core_Status__c) == $Label.Core_LineItem_Status &amp;&amp; $Profile.Name = $Label.Core_Partner_Profile_Name</errorConditionFormula>
        <errorMessage>Deletion of Opportunity Products is restricted. If this product needs to be deleted, please contact your Intel representative.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Prevent_Product_Del_PCCDealReg</fullName>
        <active>true</active>
        <description>Deletion of Opportunity Products is restricted for partner deal opportunities.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,

AND (   ISPICKVAL(Opportunity.Core_Coverage_Type_Nm__c, &apos;Deal Registration&apos;), ISPICKVAL(Opportunity.Core_Opportunity_Coverage_Nm__c , &apos;Partner-Led Opportunity&apos;)
,  ISPICKVAL( Core_Status__c , &apos;Delete In Progress (&lt;15 min)&apos;),
 ISCHANGED(Core_Status__c) 
  )
)</errorConditionFormula>
        <errorMessage>Deletion of Opportunity Products is restricted. Please contact your Intel representative to make a change.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Restrict_SME_add_edit_products</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,FALSE,
OR(
AND(
ISNEW(),
$Permission.Core_BU_SME_Collaborator_CustomPermission,
$Profile.Name = &apos;CRM - Core Access&apos;  
),
AND(
$Permission.Core_BU_SME_Collaborator_CustomPermission,
$Profile.Name = &apos;CRM - Core Access&apos;,
OR(
ISCHANGED( Quantity ),
ISCHANGED( UnitPrice) 
)  
)
)
)</errorConditionFormula>
        <errorMessage>You can not add opportunity products/can not edit sales price, quantity on product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PCCDealOppty_PWStage_OpptyProd</fullName>
        <active>true</active>
        <description>User should not be able to update products of PCC Deal Reg type of opportunities with the &quot;Production Win&quot;, &quot;Production Lost&quot; , &quot;Production Cancelled&quot; , &quot;On Hold&quot; &amp; &quot; Post-Win&quot; picklist values</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE, FALSE, 
			AND(
						Core_IsPCCOpportunity_cb__c, 
						NOT(ISNEW()),
		    ISCHANGED(Core_Status__c),
							OR(ISPICKVAL(Core_Status__c,&apos;Production Lost&apos;),ISPICKVAL(Core_Status__c,&apos;Post-Win&apos;),ISPICKVAL(Core_Status__c,&apos;On Hold&apos;),ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;),ISPICKVAL(Core_Status__c, &apos;Production Win Approved&apos;)) 
						)
			)</errorConditionFormula>
        <errorMessage>Production Win/Production Cancelled/Production Lost/On Hold/Post-Win are not applicable for Partner Opportunities.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PCCDealOppty_Prevent_Qty_Edit</fullName>
        <active>true</active>
        <description>Throws an error message when a Partner try to edit Quantity of Opportunity Products</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
$Profile.Name = &quot;Partner&quot;,
Opportunity.RecordType.DeveloperName = &apos;Core_Deal_Opportunity&apos;,
Core_IsPCCOpportunity_cb__c = true,
Core_Financial_Incentive_Eligible_cb__c = true, 
ISCHANGED( Quantity ), 
NOT(ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Rejected&apos;)))
)</errorConditionFormula>
        <errorDisplayField>Quantity</errorDisplayField>
        <errorMessage>Cannot modify/update the quantity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PCC_Restrict_Status_Update</fullName>
        <active>true</active>
        <description>Core_PCC_Restrict_Status_Update</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,
FALSE,
AND(
Core_IsPCCOpportunity_cb__c = true,
NOT(ISNEW()),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
ISCHANGED(Core_Status__c),

OR(
ISPICKVAL( PRIORVALUE(Core_Status__c) , &apos;Lost&apos;),
ISPICKVAL( PRIORVALUE(Core_Status__c) , &apos;Cancelled&apos;)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Advanced_Technology__c</errorDisplayField>
        <errorMessage>Opportunity product status cannot be reversed to open stages from Lost/Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Pcc_deal_product_cancel_restrict</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Core_IsPCCOpportunity_cb__c = true,
NOT(ISPICKVAL( Opportunity.StageName, &apos;Cancelled&apos;)),
ISCHANGED(Core_Status__c),
ISPICKVAL(Core_Status__c, &apos;Cancelled&apos;),
NOT(ISNEW()),
$Profile.Name = &apos;Partner&apos;
)
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Product cancellation is restricted. If this product needs to be cancelled, please contact your Intel representative.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Post_Win_Product_Validation</fullName>
        <active>true</active>
        <description>Post-Win  products are allowed only on Design Win &amp; Production Win Opportunities</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
	NOT(CONTAINS($Label.CRM_Bypass_Validation_Profile_Name, $Profile.Name )),
OR(
	AND(
	NOT(OR(
		ISPICKVAL(Opportunity.StageName,&apos;Design Win&apos;),
		ISPICKVAL(Opportunity.StageName,&apos;Production Win&apos;)
		)
	   ),
	   ISPICKVAL(Core_Status__c,&apos;Post-Win&apos;)
	  ),
	 AND(
		NOT(ISNEW()),
		ISCHANGED(Core_Status__c),
		ISPICKVAL(Core_Status__c,&apos;Post-Win&apos;)
	 )
 )
)
)</errorConditionFormula>
        <errorMessage>Post-Win product can be added only on Design Win &amp; Production Win Opportunities</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PreventLine_Edit_BUCollaborator_Usr</fullName>
        <active>true</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
NOT(ISNEW()), 
$Profile.Name = &quot;BU Account Collaborator&quot; 
) 
)</errorConditionFormula>
        <errorMessage>Cannot edit Opportunity Product. Please contact system admin.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Non_Sales_Visible_Flag_Rec</fullName>
        <active>true</active>
        <description>To prevent users from adding records with sales visible flag as false</description>
        <errorConditionFormula>IF(($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE || $Profile.Name ==&apos;System Administrator&apos; || $Profile.Name ==&apos;IT Admin&apos; || Opportunity.CRM_SW_Flag_Ind__c=TRUE)
,FALSE,
(
AND(
NOT(Product2.Core_Sales_Visible_Flag__c),
NOT(OR(
ISPICKVAL(Core_Status__c,&quot;Lost&quot;),
ISPICKVAL(Core_Status__c,&quot;Cancelled&quot;),
ISPICKVAL(Core_Status__c,&quot;Production Lost&quot;),
ISPICKVAL(Core_Status__c,&quot;Production Cancelled&quot;),
ISPICKVAL(Core_Status__c,&quot;Delete In Progress (&lt;15 min)&quot;)
)
)
)
)
)</errorConditionFormula>
        <errorMessage>You cannot add Products with Sales Visible Flag as False</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Manual_Reversal</fullName>
        <active>true</active>
        <description>System to restrict any user from manually updating Opportunity Line Item&apos;s status to &apos;Pending&apos; from &apos;Win Approved&apos;</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
OR(
AND(
ISCHANGED(Core_Status__c),
		AND(
				OR(
				ISPICKVAL(PRIORVALUE(Core_Status__c),&apos;Win Approved&apos;),
				ISPICKVAL(PRIORVALUE(Core_Status__c),&apos;Production Win Approved&apos;),
				ISPICKVAL(PRIORVALUE(Core_Status__c),&apos;Production Win&apos;)
				),
OR(
ISPICKVAL(Core_Status__c,&apos;Lost&apos;),
ISPICKVAL(Core_Status__c,&apos;Cancelled&apos;),
ISPICKVAL(Core_Status__c,&apos;On Hold&apos;),
ISPICKVAL(Core_Status__c,&apos;Delete In Progress (&lt;15 min)&apos;)
				)
),
		ISPICKVAL(Opportunity.Core_Approval_Status__c,&apos;Approved&apos;)
	),
	AND(
		ISCHANGED(Core_Status__c),
		ISPICKVAL(Core_Status__c,&apos;Pending&apos;),
ISPICKVAL(Opportunity.Core_Approval_Status__c,&apos;Approved&apos;),
NOT(ISCHANGED(Core_BypassFlow__c))
	)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>After approval,ONLY “Production Win”, “Production Lost” or “Production Cancelled” status is allowed.For any other change, please use the Reverse button on the Opportunity header.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_SalesPrice_GreaterThanZero_PCC</fullName>
        <active>true</active>
        <description>To throw an error if the sales price is less than 1 for Partner Led Deal opportunity</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
	Core_IsPCCOpportunity_cb__c = true,
	OR(
		ISNEW(),
		ISCHANGED( UnitPrice )		
	),
	UnitPrice &lt;= 0,
	NOT(
		OR(
			TEXT(Core_Status__c) = &apos;Lost&apos;,
			TEXT(Core_Status__c) = &apos;Cancelled&apos;,
			TEXT(Core_Status__c) = &apos;Production Lost&apos;,
			TEXT(Core_Status__c) = &apos;Production Cancelled&apos;
		)
	)
)
)</errorConditionFormula>
        <errorDisplayField>UnitPrice</errorDisplayField>
        <errorMessage>Please input a value greater than $0 for the Sales Price.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_SalesPrice_NonNegative</fullName>
        <active>true</active>
        <description>To throw error if negative value is entered in PW/DW Sales Price</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Core_IsPCCOpportunity_cb__c = false,
OR(
	Core_PW_Sales_Price__c &lt; 0,
UnitPrice &lt; 0
)
)
)</errorConditionFormula>
        <errorMessage>Please input non-negative value for Sales Price</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_SalesPrice_Quantity_CantBe_Update</fullName>
        <active>true</active>
        <description>This validation to restrict Sales Price and Quantity after DW approval.</description>
        <errorConditionFormula>AND(
Opportunity.CRM_IsLowTouchAdmin_Chk__c==false,
OR(
ISPICKVAL(PRIORVALUE(Core_Status__c), &quot;Win Approved&quot;),
ISPICKVAL(PRIORVALUE(Core_Status__c), &quot;Production Win Approved&quot;),
ISPICKVAL(PRIORVALUE(Core_Status__c), &quot;Production Win&quot;),
ISPICKVAL(PRIORVALUE(Core_Status__c), &quot;Production Win Submitted&quot;)
),
NOT(
AND(NOT(ISCHANGED(Core_Status__c)),
OR(
ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)
)
)
),
OR(
ISCHANGED(UnitPrice),
ISCHANGED(Quantity)
)
)</errorConditionFormula>
        <errorMessage>Sales price and Quantity cannot be updated after Design Win Approval.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PW_Approved_Only_LowTouch_Admin</fullName>
        <active>true</active>
        <description>Validation For PW Approved status changes</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF(Opportunity.CRM_IsLowTouchAdmin_Chk__c = true,
FALSE, 
(IF(AND( TEXT(Opportunity.Core_PW_Approval_Status__c) &lt;&gt; &apos;Approved&apos;,
        ISCHANGED(Core_Status__c), 
		TEXT(Core_Status__c) = &apos;Production Win Approved&apos;),TRUE,FALSE))
)
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Production Win Approved on Opportunity Product can be changed by Low Touch Admin Users only.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PW_Quantity_SalesPrice_Cannot_Be_Blank</fullName>
        <active>true</active>
        <description>Validation For PW Approved status changes</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF(Opportunity.CRM_IsLowTouchAdmin_Chk__c = true,False,
AND
(
NOT(CONTAINS($Label.CRM_Bypass_Validation_Profile_Name, $Profile.Name )),
OR(
ISPICKVAL(Core_Status__c, &apos;Production Win Approved&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Win&apos;),
ISPICKVAL(Core_Status__c, &apos;Production Win Submitted&apos;)
),
OR(
ISBLANK(Core_PW_Quantity__c),
ISBLANK(Core_PW_Sales_Price__c)
),
CONTAINS( TEXT(Opportunity.Core_Opportunity_Type__c),&apos;Design&apos;)
) )
)</errorConditionFormula>
        <errorMessage>Production Win Quantity / Production Win Sales Price Cannot be blank</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PW_Quantity_not_editable</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(Core_PW_Quantity__c), Opportunity.CRM_IsLowTouchAdmin_Chk__c==false,
OR(ISPICKVAL(Core_Status__c, &apos;Pending&apos;),ISPICKVAL(Core_Status__c, &apos;Win Submitted&apos;)),
CONTAINS( Opportunity.RecordType.Name,&apos;Design Opportunity&apos;),
NOT(ISCHANGED(Core_BypassFlow__c))
)
)</errorConditionFormula>
        <errorDisplayField>Core_PW_Quantity__c</errorDisplayField>
        <errorMessage>Production Quantity can be updated only after “ Win Approved ” Products.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PW_Sales_Price_not_editable</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(ISCHANGED(Core_BypassFlow__c)),
ISCHANGED(Core_PW_Sales_Price__c),
Opportunity.CRM_IsLowTouchAdmin_Chk__c==false,
OR(ISPICKVAL(Core_Status__c, &apos;Pending&apos;),ISPICKVAL(Core_Status__c, &apos;Win Submitted&apos;)),
CONTAINS( Opportunity.RecordType.Name,&apos;Design Opportunity&apos;)
,NOT(AND( ISPICKVAL( PRIORVALUE( Core_Status__c ) , &apos;Lost&apos;) , ISPICKVAL( Core_Status__c , &apos;Pending&apos;)))
)
)</errorConditionFormula>
        <errorDisplayField>Core_PW_Sales_Price__c</errorDisplayField>
        <errorMessage>Production Sales Price can be updated only after “ Win Approved ” Products.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Quantity_only_supports_whole_numbers</fullName>
        <active>true</active>
        <description>Product Quantity field only supports whole numbers</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(CONTAINS($Label.CRM_Bypass_Validation_Profile_Name, $Profile.Name )),
OR(
AND(ISNEW(),Opportunity.Core_Design_Registration_Id__c =&apos;&apos;),
NOT(ISNEW())),
OR(
AND(
NOT(REGEX(TEXT(Quantity ), &quot;^\\d+$&quot;)),
NOT(Quantity =0)),
AND(
NOT(REGEX(TEXT(Core_PW_Quantity__c ), &quot;^\\d+$&quot;)),
NOT(Core_PW_Quantity__c =0)),
AND(
OR(
ISNEW(),
ISCHANGED(Quantity)),
Quantity = 0
)),
NOT(ISCLONE())
))</errorConditionFormula>
        <errorMessage>Quantity field only supports natural numbers.  Edit Quantity field(s) by removing the decimal/negative/zero value to enable saving.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Partner_and_ISR_field_edit_PW</fullName>
        <active>true</active>
        <description>Restrict Partner and ISR field editing at Production Win</description>
        <errorConditionFormula>AND( OR($Profile.Name=&apos;Partner&apos;),OR(
ISPICKVAL(Opportunity.StageName,&apos;Design Win&apos;),ISPICKVAL(Opportunity.StageName,&apos;Production Win&apos;)),  NOT(ISNULL(Opportunity.Core_Design_Registration_Id__c)),
NOT(ISNEW()) 
)</errorConditionFormula>
        <errorMessage>Cannot edit the fields after Design Win</errorMessage>
    </validationRules>
    <webLinks>
