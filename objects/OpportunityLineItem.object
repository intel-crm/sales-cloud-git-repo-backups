    <fields>
        <fullName>Core_SPG_Planning_Segment_Legacy__c</fullName>
        <description>Reporting KPI  SPG Planning Segment</description>
        <externalId>false</externalId>
        <formula>IF( INCLUDES(Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Client GTM&quot;) &amp;&amp;  (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Notebook&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Desktop&quot; ) ) , &quot;SPG Client-PC/2in1&quot;, 

IF( INCLUDES(Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Client GTM&quot;) &amp;&amp;  ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Tablet&quot; )  , &quot;SPG Client-Tablet&quot;, 

IF( INCLUDES(Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Client GTM&quot;) &amp;&amp;  (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Entry Phone&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Smartphone&quot; ) ) , &quot;SPG Client-Smart Phone&quot;, 

IF(ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Server&quot; ) &amp;&amp; (INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: DC-Cloud&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: DC-Enterprise IT&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: DC-Mission Critical&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: DC-Subscriber Services&quot;)), &quot;SPG Data Center&quot;,

IF(INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Network Blackbox&quot;) &amp;&amp; ISPICKVAL(Opportunity.Core_Product_Segment__c , &quot;Networking&quot;) &amp;&amp;  (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Networking&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Core Network&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Edge Network&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Media Processing&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Network Security &amp; Appliances&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Routing &amp; Switching&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Wireless Access&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Wireless Infrastructure&quot; )) , &quot;SPG Network&quot;,

IF(INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Home CE/IOT&quot;) &amp;&amp; (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Home Gateway&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Set top box&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Media Center&quot;)) , &quot;SPG Smart Home&quot;, 

IF(INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Network Open&quot;) &amp;&amp; ISPICKVAL(Opportunity.Core_Product_Segment__c , &quot;Networking&quot;) &amp;&amp;  (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Networking&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;NFV - NFV Infrastructure&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;NFV - Other&quot; )), &quot;SPG NFV&quot;,

if( Contains(Core_KPI_Business_Industry_Function__c, &quot;SP/Telco&quot;),&quot;SPG: Unassigned&quot;, &quot;&quot;))))))))</formula>
        <label>SPG Planning Segment (Legacy)</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Sales_Price_Note__c</fullName>
        <defaultValue>&quot;Intel will review Sales Price as part of the deal and/or design registration review process in order to accurately calculate the value of the deal and/or design registration.  Intel will not provide input or guidance on the Sales Price, which is input by the Partner registering the deal and/or design.  Submission of the Sales Price does not constitute agreement on or endorsement of that price by Intel, and it will not affect the price offered by Intel to the Partner.&quot;</defaultValue>
        <label>Sales Price Note</label>
        <length>32768</length>
        <type>LongTextArea</type>
        <visibleLines>6</visibleLines>
    </fields>
