                    <label>Production Lost</label>
                </value>
                <value>
                    <fullName>Production Cancelled</fullName>
                    <default>false</default>
                    <label>Production Cancelled</label>
                </value>
                <value>
                    <fullName>Delete In Progress (&lt;15 min)</fullName>
