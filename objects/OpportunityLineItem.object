    <fields>
        <fullName>Core_Vendor_Group__c</fullName>
        <description>Reporting - Vendor Group</description>
        <externalId>false</externalId>
        <formula>if((contains( Core_Vendor__r.Name, &quot;HP&quot;) || contains(Core_Vendor__r.Name, &quot;Hewlett&quot;) || contains(Core_Vendor__r.Name, &quot;HEWLETT&quot;))  &amp;&amp; not(contains( Core_Vendor__r.Name, &quot;HPC&quot;)),&quot;HP&quot;, 
if(contains(Core_Vendor__r.Name, &quot;ZT&quot;), &quot;ZT Systems&quot; ,
if(contains( Core_Vendor__r.Name , &quot;Langchao&quot;) || contains(Core_Vendor__r.Name, &quot;Lang Chao&quot;), &quot;Langchao&quot; ,
if(contains(Core_Vendor__r.Name, &quot;Huawei&quot;) || contains(Core_Vendor__r.Name, &quot;HUAWEI&quot;) || contains(Core_Vendor__r.Name, &quot;Heua Wei&quot;), &quot;Huawei&quot; ,
if(contains(Core_Vendor__r.Name, &quot;Supermicro&quot;) || contains(Core_Vendor__r.Name, &quot;Super Micro&quot;),&quot;Supermicro&quot;,
if(contains(Core_Vendor__r.Name, &quot;Microsoft&quot;) || contains(Core_Vendor__r.Name, &quot;MICROSOFT&quot;) || contains(Core_Vendor__r.Name, &quot;MSFT&quot;)|| contains(Core_Vendor__r.Name, &quot;Msft&quot;), &quot;Microsoft&quot;,
if(contains(Core_Vendor__r.Name, &quot;Dell&quot;) || contains(Core_Vendor__r.Name, &quot;DELL&quot;), &quot;DELL&quot; ,
if(contains(Core_Vendor__r.Name, &quot;Quanta&quot;) || contains(Core_Vendor__r.Name, &quot;QUANTA&quot;), &quot;Quanta&quot; , 
if(contains(Core_Vendor__r.Name, &quot;IBM&quot;), &quot;IBM&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Acer&quot;) || contains(Core_Vendor__r.Name, &quot;ACER&quot;), &quot;Acer&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Cisco&quot;) || contains(Core_Vendor__r.Name, &quot;CISCO&quot;), &quot;Cisco System&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Samsung&quot;) || contains(Core_Vendor__r.Name, &quot;SAMSUNG&quot;), &quot;Samsung&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Cray&quot;) || contains(Core_Vendor__r.Name, &quot;CRAY&quot;), &quot;Cray&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Asus&quot;) || contains(Core_Vendor__r.Name, &quot;ASUS&quot;), &quot;Asus&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Haier&quot;) || contains(Core_Vendor__r.Name, &quot;HAIER&quot;), &quot;Haier&quot; , 
if(contains(Core_Vendor__r.Name, &quot;SGI&quot;), &quot;SGI&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Dawning&quot;) || contains(Core_Vendor__r.Name, &quot;DAWNING&quot;), &quot;Dawning&quot; ,
if((contains(Core_Vendor__r.Name, &quot;Apple&quot;) || contains(Core_Vendor__r.Name, &quot;APPLE&quot;)) &amp;&amp; Not(contains(Core_Vendor__r.Name, &quot;Applewhite&quot;)), &quot;Apple&quot; ,
if(contains(Core_Vendor__r.Name, &quot;Lenovo&quot;) || contains(Core_Vendor__r.Name, &quot;LENOVO&quot;), &quot;Lenovo&quot; , 
if(isblank(Core_Vendor__r.Name), null , &quot;Others&quot;))))))))))))))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Vendor Group</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
