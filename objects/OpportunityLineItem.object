    <fields>
        <fullName>Core_At_Risk_Status__c</fullName>
        <description>At risk status picklist on Opportunity Product</description>
        <label>Risk Status</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Core_Risk_Category__c</controllingField>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>In-Progress</fullName>
                    <default>false</default>
                    <label>In-Progress</label>
                </value>
                <value>
                    <fullName>Support Granted By HQ</fullName>
                    <default>false</default>
                    <label>Support Granted By HQ</label>
                </value>
                <value>
                    <fullName>Support Not Granted By HQ</fullName>
                    <default>false</default>
                    <label>Support Not Granted By HQ</label>
                </value>
                <value>
                    <fullName>Support Provided</fullName>
                    <default>false</default>
                    <label>Support Provided</label>
                </value>
                <value>
                    <fullName>Support Not Provided</fullName>
                    <default>false</default>
                    <label>Support Not Provided</label>
                </value>
                <value>
                    <fullName>Support Not Required</fullName>
                    <default>false</default>
                    <label>Support Not Required</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>FYI Only</controllingFieldValue>
                <valueName>Support Not Required</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Support Requested</controllingFieldValue>
                <valueName>In-Progress</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Support Requested</controllingFieldValue>
                <valueName>Support Granted By HQ</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Support Requested</controllingFieldValue>
                <valueName>Support Not Granted By HQ</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Support Requested</controllingFieldValue>
                <valueName>Support Provided</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Support Requested</controllingFieldValue>
                <valueName>Support Not Provided</valueName>
            </valueSettings>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_At_Risk__c</fullName>
        <defaultValue>false</defaultValue>
        <label>At Risk</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Available_for_New_Designs__c</fullName>
        <description>Show  &quot;available for new deign&quot; flag value  from Product 2  object. The value is being set by EDW.</description>
