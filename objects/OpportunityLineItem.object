    <fields>
        <fullName>Core_Total_Amount__c</fullName>
        <formula>IF(AND(
OR(
ISPICKVAL( Opportunity.StageName ,&quot;Qualify&quot;),
ISPICKVAL( Opportunity.StageName ,&quot;Develop&quot;),
ISPICKVAL( Opportunity.StageName ,&quot;Define&quot;),
ISPICKVAL( Opportunity.StageName ,&quot;Design&quot;),
ISPICKVAL( Opportunity.StageName ,&quot;Design Win&quot;),
ISPICKVAL( Opportunity.StageName ,&quot;Production Win&quot;)
),
OR(
ISPICKVAL(Core_Status__c,&quot;Pending&quot;),
ISPICKVAL(Core_Status__c,&quot;On Hold&quot;),
ISPICKVAL(Core_Status__c,&quot;Win Submitted&quot;),
ISPICKVAL(Core_Status__c,&quot;Win Approved&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Win Submitted&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Win Approved&quot;),
ISPICKVAL(Core_Status__c, &quot;Production Win&quot;)
)
), 
TotalPrice,

IF(
AND(
OR(
ISPICKVAL( Opportunity.StageName ,&quot;Production Cancelled&quot;),
ISPICKVAL( Opportunity.StageName ,&quot;Production Lost&quot;),
ISPICKVAL( Opportunity.StageName ,&quot;Lost&quot;),
ISPICKVAL( Opportunity.StageName ,&quot;Cancelled&quot;)
),
OR(
ISPICKVAL(Core_Status__c,&quot;Production Cancelled&quot;),
ISPICKVAL(Core_Status__c,&quot;Production Lost&quot;),
ISPICKVAL(Core_Status__c,&quot;Lost&quot;),
ISPICKVAL(Core_Status__c, &quot;Cancelled&quot;)
)
), 
Core_Lost_Total_Price__c, 
0) 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This field will be used to calculate Opportunity Revenue ( CRM_Opportunity_Revenue__c ) on Opportunity Object</inlineHelpText>
        <label>Total Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
