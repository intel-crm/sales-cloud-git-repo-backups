    <fields>
        <fullName>Core_KPI_Business_Industry_Function__c</fullName>
        <description>INF KPI Business Industry function</description>
        <externalId>false</externalId>
        <formula>IF(OR(ISPICKVAL(Opportunity.Core_Product_Application__c,&quot;Workstation&quot;),  INCLUDES(Opportunity.Core_Solution_Focus__c , &quot;HPC&quot;)),&quot;HPC;&quot;,&quot;&quot;) &amp;
IF(INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;Big Data/Analytics&quot;), &quot;Big Data;&quot;,&quot;&quot;) &amp;
IF(INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;IoT/Embedded&quot;), &quot;IoT;&quot;,&quot;&quot;)  &amp;
IF(OR(ISPICKVAL(Opportunity.Account.Industry, &quot;Biotechnology&quot;), ISPICKVAL(Opportunity.Account.Industry, &quot;Healthcare&quot;), ISPICKVAL(Opportunity.Core_Consumption_Market__c, &quot;Healthcare&quot;)),&quot;Industry:Healthcare;&quot;,&quot;&quot;)  &amp; 
IF(OR(ISPICKVAL(Opportunity.Account.Industry, &quot;Finance&quot;), ISPICKVAL(Opportunity.Account.Industry, &quot;Insurance&quot;),ISPICKVAL(Opportunity.Core_Consumption_Market__c,&quot;Financial Services&quot;)), &quot;Industry:FSI;&quot;, &quot;&quot;)  &amp; 
IF((ISPICKVAL(Opportunity.Account.Industry, &quot;Retail&quot;) &amp;&amp; NOT(ISPICKVAL(Opportunity.Core_Consumption_Market__c, &quot;Consumer&quot;))) || 
ISPICKVAL(Opportunity.Account.Industry, &quot;Apparel&quot;) || ISPICKVAL(Opportunity.Account.Industry, &quot;Food Beverage&quot;) || ISPICKVAL(Opportunity.Account.Industry, &quot;Hospitality&quot;) || ISPICKVAL(Opportunity.Core_Consumption_Market__c, &quot;Retail&quot;), &quot;Industry:Retail;&quot;, &quot;&quot;) &amp; 
IF(ISPICKVAL(Opportunity.Account.Industry, &quot;Energy&quot;) || ISPICKVAL(Opportunity.Core_Consumption_Market__c, &quot;Energy&quot;), &quot;Industry:Energy;&quot;, &quot;&quot;) &amp; 
IF(ISPICKVAL(Opportunity.Account.Industry, &quot;Utilities&quot;) || ISPICKVAL(Opportunity.Core_Consumption_Market__c, &quot;Utilities&quot;), &quot;Industry:Utilities;&quot;, &quot;&quot;)  &amp; 
IF(INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;Education: Post Secondary&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;Education: K12&quot;) || ISPICKVAL(Opportunity.Core_Consumption_Market__c, &quot;Education&quot;), &quot;Intel Education;&quot;, &quot;&quot;) &amp; 
IF(
(INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;SP/Telco: Client GTM&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;SP/Telco: DC-Cloud&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;SP/Telco: DC-Enterprise IT&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;SP/Telco: DC-Mission Critical&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;SP/Telco: DC-Subscriber Services&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;SP/Telco: Home CE/IOT&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;SP/Telco: Network Blackbox&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c , &quot;SP/Telco: Network Open&quot;)) || ISPICKVAL(Opportunity.Core_Consumption_Market__c, &quot;Service Providers/Telco&quot;), &quot;SP/Telco;&quot;,&quot;&quot;)</formula>
        <label>KPI - Business Industry Function</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_CPU_Price__c</fullName>
        <formula>IF( Core_Product_Type__c = &apos;Processors&apos;, Core_KPI_Total_Price__c, 0 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>KPI - CPU $</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_KPI_CPU_Units__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Core_Product_Type__c = &apos;Processors&apos;,  Core_KPI_Quantity__c, 0 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>KPI - CPU Units</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_Date__c</fullName>
        <description>The KPI Date provides a SINGLE, Unified date field that is used to report the results for any status.  This date combines the Claim Date when there is a Claim Date otherwise for pending products, the Opportunity Decision Date is used.</description>
        <formula>IF(OR(ISPICKVAL(Core_Status__c, &quot;Win Approved&quot;), ISPICKVAL(Core_Status__c, &quot;Production Win&quot;), 
ISPICKVAL(Core_Status__c,&quot;Production Lost&quot;), ISPICKVAL(Core_Status__c,&quot;Production Cancelled&quot;), 
ISPICKVAL(Core_Status__c,&quot;Lost&quot;), ISPICKVAL(Core_Status__c,&quot;Cancelled&quot;), ISPICKVAL(Core_Status__c,&quot;Win Submitted&quot;)),
	DATEVALUE(Core_Claim_Date__c),
	Opportunity.CloseDate)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The KPI Date provides a SINGLE, Unified date field that is used to report the results for any status.  This date combines the Claim Date when there is a Claim Date otherwise for pending products, the Opportunity Decision Date is used.</inlineHelpText>
        <label>KPI - Date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_KPI_Days_DesignWin_to_ProductionWin__c</fullName>
        <description>The number of days between the Claim Date and Production Claim Date, the Claim Date to today, or null when Claim date is null.</description>
        <externalId>false</externalId>
        <formula>IF(ISNULL(Core_Claim_Date__c),
	NULL,
	IF(ISNULL(Core_Production_Claim_Date__c),
		NOW() - Core_Claim_Date__c,
		Core_Production_Claim_Date__c - Core_Claim_Date__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>KPI - Days Design Win to Production Win</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_Non_CPU_Price__c</fullName>
        <formula>IF( Core_Product_Type__c &lt;&gt; &apos;Processors&apos;, Core_KPI_Total_Price__c, 0 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>KPI - Non CPU $</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_KPI_Product_Group__c</fullName>
        <externalId>false</externalId>
        <formula>PricebookEntry.Product2.Core_Inf_KPI_ProdGroup__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>KPI Product Group</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_Production_Date__c</fullName>
        <description>The date the status moved to production or the first customer ship date</description>
        <formula>IF(OR(ISPICKVAL(Core_Status__c, &quot;Production Win&quot;), ISPICKVAL(Core_Status__c,&quot;Production Lost&quot;), ISPICKVAL(Core_Status__c,&quot;Production Cancelled&quot;)),
	Core_Production_Claim_Date__c,
	DATETIMEVALUE(Opportunity.Core_First_Customer_Ship_Date__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>KPI - Production Date</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_KPI_Quantity__c</fullName>
        <description>The KPI Total Quantity contains the product quantity.  For products with a status of Approved, Lost or Cancelled the  Approved Quantity is used.  For products that are Pending or On Hold, the Quantity is used.</description>
        <externalId>false</externalId>
        <formula>IF(OR(ISPICKVAL(Core_Status__c,&quot;Win Approved&quot;), ISPICKVAL(Core_Status__c, &apos;Production Win&apos;), ISPICKVAL(Core_Status__c, &apos;Production Lost&apos;), ISPICKVAL(Core_Status__c, &apos;Production Cancelled&apos;)),
	Core_Approved_Quantity__c, 
	Quantity)</formula>
        <inlineHelpText>The KPI Total Quantity contains the product quantity.  For products with a status of Approved, Lost or Cancelled the  Approved Quantity is used.  For products that are Pending or On Hold, the Quantity is used.</inlineHelpText>
        <label>KPI - Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_SPG_Target_U__c</fullName>
        <description>Reporting KPI - SPG Target U</description>
        <externalId>false</externalId>
        <formula>if((Core_Product_Type__c= &quot;Processors&quot; || Core_Product_Type__c= &quot;Education&quot; || Core_Product_Type__c= &quot;SoFIA&quot; || Core_Product_Type__c= &quot;Cable Modems and Media Gateways&quot; || Core_Product_Type__c= &quot;Mobile Communications Products&quot;), Core_KPI_SPG_U__c, NULL)</formula>
        <label>KPI - SPG Target(U)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_SPG_U__c</fullName>
        <externalId>false</externalId>
        <formula>IF( AND( ISPICKVAL( Opportunity.Core_Consumption_Market__c , &quot;Service Providers (Cloud and Comms)&quot;) , INCLUDES( Opportunity.Core_Sales_Segments__c , &quot;Influencer&quot;)), Core_KPI_Quantity__c , NULL)</formula>
        <label>KPI - SPG(U)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_Total_Price__c</fullName>
        <description>The KPI Total Price contains the product total price.  For products with a status of Approved, Lost or Cancelled the  Approved Total Price is used.  For products that are Pending or On Hold, the Total Price is used.</description>
        <formula>IF(OR(ISPICKVAL(Core_Status__c,&quot;Win Approved&quot;),ISPICKVAL(Core_Status__c,&quot;Production Win&quot;),ISPICKVAL(Core_Status__c,&quot;Production Lost&quot;),ISPICKVAL(Core_Status__c,&quot;Production Cancelled&quot;)),
	Core_Approved_Total_Price__c,
	IF(OR(ISPICKVAL(Core_Status__c,&quot;Deleted&quot;), ISPICKVAL(Core_Status__c,&quot;Lost&quot;),ISPICKVAL(Core_Status__c,&quot;Cancelled&quot;)),
		Core_Lost_Total_Price__c,
		IF(OR(ISPICKVAL(Core_Status__c,&quot;Win Submitted&quot;), ISPICKVAL(Core_Status__c,&quot;Pending&quot;), ISPICKVAL(Core_Status__c,&quot;On Hold&quot;)),
			TotalPrice,
			TotalPrice)))</formula>
        <inlineHelpText>The KPI Total Price contains the product total price.  For products with a status of Approved, Lost or Cancelled the  Approved Total Price is used.  For products that are Pending or On Hold, the Total Price is used.</inlineHelpText>
        <label>KPI - Total Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Currency</type>
    </fields>
    <fields>
