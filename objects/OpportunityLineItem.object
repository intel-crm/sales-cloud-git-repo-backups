        <label>Available for New Designs</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_BU_Mapping_record__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>BU Mapping record</label>
        <referenceTo>Core_BU_Mapping_Table__c</referenceTo>
        <relationshipLabel>Opportunity Product</relationshipLabel>
        <relationshipName>Opportunity_Product</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_BU_ProductSegment__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Core_BU_Mapping_record__c ) ,&apos;Unassigned&apos;,Core_BU_Mapping_record__r.Core_BU_Segment__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>BU is not assigned which could cause an error for commissions. If the problem still exists after 24 hrs, please contact Product Support via AAQ</inlineHelpText>
        <label>New BU Product Segment</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
