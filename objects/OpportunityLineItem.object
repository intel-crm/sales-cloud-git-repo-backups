        <externalId>false</externalId>
        <formula>IF(CONTAINS( Lower( PricebookEntry.Product2.Name ), &apos;write in product&apos;),&apos;Write In Product&apos;,IF( OR(ISBLANK(PricebookEntry.Product2.Core_Division_Code_Short_Name__c), ISNULL(PricebookEntry.Product2.Core_Division_Code_Short_Name__c) ) ,&apos;NA&apos;, PricebookEntry.Product2.Core_Division_Code_Short_Name__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
