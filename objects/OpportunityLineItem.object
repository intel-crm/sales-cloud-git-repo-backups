        <fullName>Core_Production_Win_Total_Price__c</fullName>
        <description>This field is used to calculate PW Total Price from PW Quantity and sale price.</description>
        <formula>Core_PW_Quantity__c  *  Core_PW_Sales_Price__c</formula>
        <inlineHelpText>This price is used to calculate PW Total Price from PW Quantity and sale price.</inlineHelpText>
        <label>Production Total Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_QL_End_Dt__c</fullName>
        <formula>IF( OR(ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Pending Further Intel Review&apos;),ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Rejected&apos;),ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Cancelled&apos;)),
SBQQ__QuoteLine__r.Pricing_End_Date_dt__c,
IF(ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Approved&apos;),
SBQQ__QuoteLine__r.Pricing_Approved_End_Date_Dt__c,
IF( AND(SBQQ__QuoteLine__r.Pricing_Change_Request_cb__c, ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Pending Further Intel Review&apos;) ) ,
SBQQ__QuoteLine__r.Pricing_End_Date_dt__c,
SBQQ__QuoteLine__r.Pricing_End_Date_dt__c
)
)
)</formula>
        <label>Quote Line End Date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_QL_Start_Dt__c</fullName>
        <formula>IF( OR(ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Pending Further Intel Review&apos;),ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Rejected&apos;),ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Cancelled&apos;)),
				SBQQ__QuoteLine__r.Pricing_Start_Date_dt__c,
				 IF(ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Approved&apos;), 
								SBQQ__QuoteLine__r.Pricing_Approved_Start_Date_Dt__c,
				     IF( AND(SBQQ__QuoteLine__r.Pricing_Change_Request_cb__c,  ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Pending Further Intel Review&apos;) ) ,
												SBQQ__QuoteLine__r.Pricing_Start_Date_dt__c, 
												SBQQ__QuoteLine__r.Pricing_Start_Date_dt__c
											) 				
							)
		)</formula>
        <label>Quote Line Start Date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_QL_Unit_Qty__c</fullName>
        <externalId>false</externalId>
        <formula>IF( OR(ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Pending Further Intel Review&apos;),ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Rejected&apos;),ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Cancelled&apos;)),
SBQQ__QuoteLine__r.Pricing_Total_Volume_Qty__c,
IF(ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Approved&apos;),
SBQQ__QuoteLine__r.Pricing_Approved_Unit_Qty__c,
IF( AND(SBQQ__QuoteLine__r.Pricing_New_Change_Request_cb__c, ISPICKVAL(SBQQ__QuoteLine__r.Pricing_Status_Nm__c, &apos;Pending Further Intel Review&apos;) ) ,
SBQQ__QuoteLine__r.Pricing_New_Quantity_qty__c,
SBQQ__QuoteLine__r.Pricing_Total_Volume_Qty__c
)
)
)</formula>
        <label>Quote Line Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Quote_Line_Cancellation_Date__c</fullName>
