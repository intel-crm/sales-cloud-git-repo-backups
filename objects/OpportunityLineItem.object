    <fields>
        <fullName>Core_SPG_Planning_Segment_Legacy__c</fullName>
        <description>Reporting KPI  SPG Planning Segment</description>
        <externalId>false</externalId>
        <formula>IF( INCLUDES(Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Client GTM&quot;) &amp;&amp;  (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Notebook&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Desktop&quot; ) ) , &quot;SPG Client-PC/2in1&quot;, 

IF( INCLUDES(Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Client GTM&quot;) &amp;&amp;  ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Tablet&quot; )  , &quot;SPG Client-Tablet&quot;, 

IF( INCLUDES(Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Client GTM&quot;) &amp;&amp;  (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Entry Phone&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Smartphone&quot; ) ) , &quot;SPG Client-Smart Phone&quot;, 

IF(ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Server&quot; ) &amp;&amp; (INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: DC-Cloud&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: DC-Enterprise IT&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: DC-Mission Critical&quot;) || INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: DC-Subscriber Services&quot;)), &quot;SPG Data Center&quot;,

IF(INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Network Blackbox&quot;) &amp;&amp; ISPICKVAL(Opportunity.Core_Product_Segment__c , &quot;Networking&quot;) &amp;&amp;  (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Networking&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Core Network&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Edge Network&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Media Processing&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Network Security &amp; Appliances&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Routing &amp; Switching&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Wireless Access&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Wireless Infrastructure&quot; )) , &quot;SPG Network&quot;,

IF(INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Home CE/IOT&quot;) &amp;&amp; (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Home Gateway&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Set top box&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Media Center&quot;)) , &quot;SPG Smart Home&quot;, 

IF(INCLUDES( Opportunity.Core_Solution_Focus__c, &quot;SP/Telco: Network Open&quot;) &amp;&amp; ISPICKVAL(Opportunity.Core_Product_Segment__c , &quot;Networking&quot;) &amp;&amp;  (ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;Networking&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;NFV - NFV Infrastructure&quot; ) || ISPICKVAL(Opportunity.Core_Product_Application__c, &quot;NFV - Other&quot; )), &quot;SPG NFV&quot;,

if( Contains(Core_KPI_Business_Industry_Function__c, &quot;SP/Telco&quot;),&quot;SPG: Unassigned&quot;, &quot;&quot;))))))))</formula>
        <label>SPG Planning Segment (Legacy)</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Software_Stack__c</fullName>
        <externalId>false</externalId>
        <formula>Opportunity.Core_Software_Stack__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Software Stack</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Status__c</fullName>
        <description>Status of the Opportunity Product (e.g., open, won, lost)</description>
        <label>Status</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <color>#FFCC66</color>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Lost</fullName>
                    <color>#CC0000</color>
                    <default>false</default>
                    <label>Lost</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <color>#CC0000</color>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Deleted</fullName>
                    <default>false</default>
                    <label>Deleted</label>
                </value>
                <value>
                    <fullName>On Hold</fullName>
                    <color>#FFCC66</color>
                    <default>false</default>
                    <label>On Hold</label>
                </value>
                <value>
                    <fullName>Production Win</fullName>
                    <default>false</default>
                    <label>Production Win</label>
                </value>
                <value>
                    <fullName>Production Lost</fullName>
                    <default>false</default>
                    <label>Production Lost</label>
                </value>
                <value>
                    <fullName>Production Cancelled</fullName>
                    <default>false</default>
                    <label>Production Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Support_Granted_Not_Entrance_Date__c</fullName>
        <description>Time Stamp the field for Core_At_Risk_Status__c(Support Granted/ Not Granted)</description>
        <label>Support Granted Date</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Support_Provided_Not_Entrance_Date__c</fullName>
        <description>Time stamp the field with Core_At_Risk_Status__c(Support Provided/Not Provided)</description>
        <label>Support Provided Date</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_System_Commissionable__c</fullName>
        <description>Formula field to mirror the value from the Opportunity field &apos;Commissionable?&apos;</description>
        <externalId>false</externalId>
        <formula>TEXT(Opportunity.Core_Commissionable__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Commissionable?</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_System_Competitor_Empty_Flag__c</fullName>
        <description>This flag indicates if Competitor OEM OR Competitor OEM Product value is blank.</description>
        <externalId>false</externalId>
        <formula>IF(OR(ISPICKVAL(Core_Competitor__c,&quot;&quot;),ISPICKVAL(Core_Competitor_Product__c,&quot;&quot;)),1,0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System Competitor Empty Flag</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Technical_Owner_Email_Txt__c</fullName>
        <description>Stores the email of the Technical Owner from the Opportunity.</description>
        <externalId>false</externalId>
        <label>Technical Owner Email</label>
        <required>false</required>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Vendor_Group__c</fullName>
        <description>Reporting - Vendor Group</description>
        <externalId>false</externalId>
        <formula>if((contains( Core_Vendor__r.Name, &quot;HP&quot;) || contains(Core_Vendor__r.Name, &quot;Hewlett&quot;) || contains(Core_Vendor__r.Name, &quot;HEWLETT&quot;))  &amp;&amp; not(contains( Core_Vendor__r.Name, &quot;HPC&quot;)),&quot;HP&quot;, 
if(contains(Core_Vendor__r.Name, &quot;ZT&quot;), &quot;ZT Systems&quot; ,
if(contains( Core_Vendor__r.Name , &quot;Langchao&quot;) || contains(Core_Vendor__r.Name, &quot;Lang Chao&quot;), &quot;Langchao&quot; ,
if(contains(Core_Vendor__r.Name, &quot;Huawei&quot;) || contains(Core_Vendor__r.Name, &quot;HUAWEI&quot;) || contains(Core_Vendor__r.Name, &quot;Heua Wei&quot;), &quot;Huawei&quot; ,
if(contains(Core_Vendor__r.Name, &quot;Supermicro&quot;) || contains(Core_Vendor__r.Name, &quot;Super Micro&quot;),&quot;Supermicro&quot;,
if(contains(Core_Vendor__r.Name, &quot;Microsoft&quot;) || contains(Core_Vendor__r.Name, &quot;MICROSOFT&quot;) || contains(Core_Vendor__r.Name, &quot;MSFT&quot;)|| contains(Core_Vendor__r.Name, &quot;Msft&quot;), &quot;Microsoft&quot;,
if(contains(Core_Vendor__r.Name, &quot;Dell&quot;) || contains(Core_Vendor__r.Name, &quot;DELL&quot;), &quot;DELL&quot; ,
if(contains(Core_Vendor__r.Name, &quot;Quanta&quot;) || contains(Core_Vendor__r.Name, &quot;QUANTA&quot;), &quot;Quanta&quot; , 
if(contains(Core_Vendor__r.Name, &quot;IBM&quot;), &quot;IBM&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Acer&quot;) || contains(Core_Vendor__r.Name, &quot;ACER&quot;), &quot;Acer&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Cisco&quot;) || contains(Core_Vendor__r.Name, &quot;CISCO&quot;), &quot;Cisco System&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Samsung&quot;) || contains(Core_Vendor__r.Name, &quot;SAMSUNG&quot;), &quot;Samsung&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Cray&quot;) || contains(Core_Vendor__r.Name, &quot;CRAY&quot;), &quot;Cray&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Asus&quot;) || contains(Core_Vendor__r.Name, &quot;ASUS&quot;), &quot;Asus&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Haier&quot;) || contains(Core_Vendor__r.Name, &quot;HAIER&quot;), &quot;Haier&quot; , 
if(contains(Core_Vendor__r.Name, &quot;SGI&quot;), &quot;SGI&quot; , 
if(contains(Core_Vendor__r.Name, &quot;Dawning&quot;) || contains(Core_Vendor__r.Name, &quot;DAWNING&quot;), &quot;Dawning&quot; ,
if((contains(Core_Vendor__r.Name, &quot;Apple&quot;) || contains(Core_Vendor__r.Name, &quot;APPLE&quot;)) &amp;&amp; Not(contains(Core_Vendor__r.Name, &quot;Applewhite&quot;)), &quot;Apple&quot; ,
if(contains(Core_Vendor__r.Name, &quot;Lenovo&quot;) || contains(Core_Vendor__r.Name, &quot;LENOVO&quot;), &quot;Lenovo&quot; , 
if(isblank(Core_Vendor__r.Name), null , &quot;Others&quot;))))))))))))))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Vendor Group</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Vendor__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>Lookup field to the Account object for Vendor of an Opportunity Product</description>
        <inlineHelpText>Lookup field to the Account object for Vendor of an Opportunity Product</inlineHelpText>
        <label>Vendor</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>notEqual</operation>
                <value>CoMarketing, Intel Ultimate Account, Inactive Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Covered_Account__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <infoMessage>Intel ultimate and Inactive accounts have been excluded from the below-listed accounts as they should not be selected. Please DO NOT OVERRIDE the filter criteria by clicking on &quot;Search All&quot; link below and only select an account from the ones listed below.</infoMessage>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Opportunity Product</relationshipLabel>
        <relationshipName>Opportunity_Product</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Vertical_Market__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Opportunity.Core_Consumption_Market__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Vertical Market</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Write_In_Product_Flag__c</fullName>
        <defaultValue>false</defaultValue>
        <description>if selected Product Name is &quot;Write In Product&quot; update this checkbox to true using workflow</description>
        <label>Write In Product Flag</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Write_In_Product_Name__c</fullName>
