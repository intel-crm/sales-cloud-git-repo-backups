    <fields>
        <fullName>Core_Production_Cancelled_Sales_Price__c</fullName>
        <description>If product status = Production Cancelled, this field should return the Approved Total Price, otherwise NULL</description>
        <formula>IF(ISPICKVAL(Core_Status__c,&quot;Production Cancelled&quot;), Core_Approved_Total_Price__c, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Production Cancelled Sales Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_Production_Claim_Date__c</fullName>
        <description>Stamp set when the status changes to Production Win, Production Lost, or Production Cancelled.</description>
        <label>Production Claim Date</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Production_Lost_Sales_Price__c</fullName>
        <description>If product status = Production Lost, this field should return the Approved Total Price otherwise NULL</description>
        <formula>IF(ISPICKVAL(Core_Status__c,&quot;Production Lost&quot;), Core_Approved_Total_Price__c, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Production Lost Sales Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Currency</type>
    </fields>
