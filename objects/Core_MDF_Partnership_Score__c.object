        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Final_Recovery_Amount_Amt__c</fullName>
        <description>Total Recovery Amount for the Quarter + Carry Over Amount of Previous Quarters</description>
        <formula>Core_MDF_Total_Recovery_Amount_Amt__c + Core_MDF_CarryOver_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Total Recovery Amount for the Quarter + Carry Over Amount of Previous Quarters</inlineHelpText>
        <label>Final Recovery Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Final_Recovery_Amt__c</fullName>
        <description>Total Recovery Amount for the Quarter + Carry Over Amount of Previous Quarters</description>
        <formula>Core_MDF_Total_Recovery_Amt__c + Core_MDF_CarryOver_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Total Recovery Amount for the Quarter + Carry Over Amount of Previous Quarters</inlineHelpText>
        <label>Final Recovery Amount</label>
        <precision>18</precision>
        <required>false</required>
