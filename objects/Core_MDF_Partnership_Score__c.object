    <fields>
        <fullName>Core_MDF_Total_Recovery_Amount_Amt__c</fullName>
        <description>Manual Recovery Amount + PV 0 Amount + Pv1 and PV2 Amount based on Petty Rule Indicator</description>
        <formula>Core_MDF_Total_Manual_Recovery_Amt__c + Core_MDF_Total_PV0_Amt__c + IF( Core_MDF_Petty_Rule_Applied_Ind__c , 0 , (Core_MDF_Total_PV1_Amt__c * Core_MDF_PV1_Percentage_nbr__c /100) + (Core_MDF_Total_PV2_Amt__c * Core_MDF_PV2_Percentage_nbr__c /100))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Recovery Amount for the Quarter + Manual Recovery Amount for the Quarter. Applies Petty Rule logic to reduce nonmaterial recoveries on Partial Value claims.</inlineHelpText>
        <label>Total Recovery Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_Recovery_Amt__c</fullName>
        <description>Recovery Amount for the Quarter + Manual Recovery Amount for the Quarter. Applies Petty Rule logic to reduce nonmaterial recoveries on Partial Value claims.</description>
        <inlineHelpText>Recovery Amount for the Quarter + Manual Recovery Amount for the Quarter. Applies Petty Rule logic to reduce nonmaterial recoveries on Partial Value claims.</inlineHelpText>
        <label>Total Recovery Amount</label>
        <precision>18</precision>
        <required>false</required>
