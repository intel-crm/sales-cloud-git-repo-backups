    <fields>
        <fullName>Core_MDF_Recovered_Amt__c</fullName>
        <description>This is a roll up summanry of the Partnership Score Detail Recovered Amount</description>
        <label>Recovered Amount</label>
        <summarizedField>Core_MDF_Partnership_Score_Detail__c.Core_MDF_Recovered_Amt__c</summarizedField>
        <summaryForeignKey>Core_MDF_Partnership_Score_Detail__c.Core_MDF_Partnership_Score_Id__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
