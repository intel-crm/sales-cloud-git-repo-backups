        <externalId>false</externalId>
        <label>Partnership Score</label>
        <precision>5</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Petty_Rule_Applied_Ind__c</fullName>
        <description>Used to identify the petty rule that is applied to Partnership score record or not</description>
        <formula>(( Core_MDF_Total_PV1_Amt__c *  Core_MDF_PV1_Percentage_nbr__c /100) + ( Core_MDF_Total_PV2_Amt__c *  Core_MDF_PV2_Percentage_nbr__c /100)) &lt;  Core_MDF_Total_Claim_Amt__c / 1000</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Petty Rule Applied?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
