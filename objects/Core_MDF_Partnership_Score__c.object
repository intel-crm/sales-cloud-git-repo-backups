    <searchLayouts>
        <excludedStandardButtons>New</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Non_Editable_Fields_on_Update</fullName>
        <active>false</active>
        <errorConditionFormula>OR(ISCHANGED(  Core_MDF_Quarter_Year_Nm__c  ),ISCHANGED(   Core_MDF_Account_Id__c   ),ISCHANGED(   Core_MDF_Channel_Program_Id__c   )) &amp;&amp; NOT(ISNEW())</errorConditionFormula>
        <errorMessage>Fields cannot be Updated (Account, program, Quarter Year)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Program_cannot_be_updated</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(ISNEW()) &amp;&amp;  OR((!ISBLANK(Core_MDF_Channel_Program_Id__c) &amp;&amp;(ISCHANGED(Core_MDF_Channel_Program_Id__c))), (!ISBLANK( TEXT(Core_MDF_Program_nm__c) ) &amp;&amp; ISCHANGED(Core_MDF_Program_nm__c )))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Channel_Program_Id__c</errorDisplayField>
        <errorMessage>Program cannot be updated</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Quarter_Year_Not_Editable</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(ISNEW()) &amp;&amp; ISCHANGED( Core_MDF_Quarter_Year_Nm__c )</errorConditionFormula>
        <errorMessage>Quarter Year value cannot be updated</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Quarter_value_cannot_be_updated</fullName>
        <active>false</active>
        <errorConditionFormula>ISCHANGED( Core_MDF_Quarter_nm__c )&amp;&amp; NOT(ISNEW())</errorConditionFormula>
        <errorDisplayField>Core_MDF_Quarter_nm__c</errorDisplayField>
        <errorMessage>Quarter value cannot be updated</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Required_Fields</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISNEW(), OR( ISBLANK( Core_MDF_Account_Id__c ) , ISBLANK( Core_MDF_Channel_Program_Id__c ),  ISPICKVAL( Core_MDF_Quarter_Year_Nm__c , &apos;&apos;) ))</errorConditionFormula>
        <errorMessage>Mandatory Fields (Account, Program, Quarter Year )</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Score_value_validation</fullName>
        <active>false</active>
        <errorConditionFormula>Core_MDF_Partnership_Score_Nbr__c &lt;0 || Core_MDF_Partnership_Score_Nbr__c &gt;8</errorConditionFormula>
        <errorDisplayField>Core_MDF_Partnership_Score_Nbr__c</errorDisplayField>
        <errorMessage>Score cannot exceed 8 and should not be less than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_External_Id</fullName>
        <active>false</active>
        <errorConditionFormula>Core_MDF_External_Id__c &lt;&gt; CASESAFEID(Core_MDF_Channel_Program_Id__c) + 
CASESAFEID(Core_MDF_Account_Id__c)  +  
text(Core_MDF_Quarter_Year_Nm__c)</errorConditionFormula>
        <errorDisplayField>Core_MDF_External_Id__c</errorDisplayField>
        <errorMessage>External Id is Invalid</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Year_cannot_be_updated</fullName>
        <active>false</active>
        <errorConditionFormula>ISCHANGED(  Core_MDF_Year_nm__c  )&amp;&amp; NOT(ISNEW())</errorConditionFormula>
        <errorDisplayField>Core_MDF_Year_nm__c</errorDisplayField>
        <errorMessage>Year cannot be updated</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
