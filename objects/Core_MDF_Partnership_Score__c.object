        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_PV1_Percentage_nbr__c</fullName>
        <description>Used to hold the PV1 percentage based on effective quarter from Core_MDF_Partner_Response_Zone__mdt metadata</description>
        <externalId>false</externalId>
        <label>PV1 Percentage</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_PV2_Percentage_nbr__c</fullName>
        <description>Used to hold the PV2 percentage based on effective quarter from Core_MDF_Partner_Response_Zone__mdt metadata</description>
        <externalId>false</externalId>
        <label>PV2 Percentage</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_PartialValueScore_Nbr__c</fullName>
        <description>Used to calculate Partial value score</description>
        <externalId>false</externalId>
        <formula>( Core_MDF_Total_Weighted_PV_Amt__c / Core_MDF_Total_Max_Possible_Amt__c ) * 8</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Partial Value Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Partial_Value_Score_Nbr__c</fullName>
        <externalId>false</externalId>
        <label>Partial Value Score</label>
        <precision>5</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_PartnershipScore_Nbr__c</fullName>
        <description>Used to calculate Partnership score</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Core_MDF_Partnership_Grade_Nbr__c),
((Core_MDF_AggregateClaimScore_Nbr__c * 0.75) + (Core_MDF_PartialValueScore_Nbr__c * 0.25)),
((Core_MDF_Partnership_Grade_Nbr__c * 0.25) + (Core_MDF_AggregateClaimScore_Nbr__c * 0.50) + (Core_MDF_PartialValueScore_Nbr__c * 0.25)))</formula>
        <label>Partnership Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Partnership_Grade_Nbr__c</fullName>
        <externalId>false</externalId>
        <label>Partnership Grade</label>
        <precision>5</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Partnership_Score_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Self lookup on Partnership Score</description>
        <label>Previous Quarter Partnership Score</label>
        <referenceTo>Core_MDF_Partnership_Score__c</referenceTo>
        <relationshipLabel>Partnership Score (Partnership Score)</relationshipLabel>
