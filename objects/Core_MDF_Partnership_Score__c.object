    <fields>
        <fullName>Core_MDF_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Account</label>
        <lookupFilter>
            <active>false</active>
            <filterItems>
                <field>Account.Core_MDF_CoMarketingActive__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Partnership Score</relationshipLabel>
        <relationshipName>Partnership_Grade_Maintenance</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_AggregateClaimScore_Nbr__c</fullName>
        <description>Calculate Aggregate Claim score</description>
        <externalId>false</externalId>
        <formula>(( Core_MDF_Total_PV8_Amt__c / Core_MDF_Total_Claim_Amt__c) * 8) + (( Core_MDF_Total_PV4_Amt__c / Core_MDF_Total_Claim_Amt__c) * 4) + (( Core_MDF_Total_PV2_Amt__c / Core_MDF_Total_Claim_Amt__c) * 2) + (( Core_MDF_Total_PV1_Amt__c / Core_MDF_Total_Claim_Amt__c) * 1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Aggregate Claim Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Aggregate_Claim_Score_Nbr__c</fullName>
        <externalId>false</externalId>
        <label>Aggregate Claim Score</label>
        <precision>5</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Balance_Amount_Amt__c</fullName>
        <description>Final Recovery Amount - Recovered Amount</description>
        <formula>Core_MDF_Final_Recovery_Amount_Amt__c - (Core_MDF_Recovered_Amt__c + Core_MDF_Recovery_Offset_Amt__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Final Recovery Amount - Recovered Amount</inlineHelpText>
        <label>Balance Unrecovered</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Balance_Amt__c</fullName>
        <description>Final Recovery Amount - Recovered Amount</description>
        <formula>Core_MDF_Final_Recovery_Amt__c - (Core_MDF_Recovered_Amt__c + Core_MDF_Recovery_Offset_Amt__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Final Recovery Amount - Recovered Amount</inlineHelpText>
        <label>Balance Unrecovered Old</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
