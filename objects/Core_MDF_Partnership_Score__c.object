        <fullName>All</fullName>
        <columns>Core_MDF_Account_Id__c</columns>
        <columns>Core_MDF_Channel_Program_txt__c</columns>
        <columns>Core_MDF_Partnership_Score_Nbr__c</columns>
        <columns>Core_MDF_Zone_nm__c</columns>
        <columns>Core_MDF_Year_nm__c</columns>
        <columns>Core_MDF_Quarter_nm__c</columns>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
