        <description>Only recovery Amount without the manual Recovery Amount from IAH</description>
        <label>Recovery Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Recovery_Offset_Amt__c</fullName>
        <description>Used to hold Offset amount that&apos;s entered by Payment Admin in Claim Recovery page. Currently allowed only for RMF PRC region</description>
        <inlineHelpText>Payment Admin can set Recovery Offset for PRC RSA MD Recoveries only</inlineHelpText>
        <label>Recovery Offset Amount (USD)</label>
        <summarizedField>Core_MDF_Partnership_Score_Detail__c.Core_MDF_Recovery_Offset_Amt__c</summarizedField>
