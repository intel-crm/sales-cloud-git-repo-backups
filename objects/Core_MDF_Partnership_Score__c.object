    </fields>
    <fields>
        <fullName>Core_MDF_Total_Claim_Amt__c</fullName>
        <description>Sum of Claim Amount  with Active Indicator as TRUE</description>
        <label>Total Claim Amount</label>
        <summarizedField>Core_MDF_Recovery_Dashboard__c.Core_MDF_Claim_Amt__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Is_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_MDF_Recovery_Dashboard__c.Core_MDF_Partnership_Score_Id__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_Manual_Recovery_Amt__c</fullName>
        <description>Sum of Manual Recovery Amount other than Score 0 with Active Indicator as TRUE</description>
        <label>Total Manual Recovery Amount</label>
        <summarizedField>Core_MDF_Recovery_Dashboard__c.Core_MDF_Manual_Recovery_Amount_USD_Amt__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Score_Nbr__c</field>
            <operation>notEqual</operation>
            <value>0</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Is_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_MDF_Recovery_Dashboard__c.Core_MDF_Partnership_Score_Id__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_Max_Possible_Amt__c</fullName>
        <description>Rollup summary field to calculate Max Possible Amount</description>
        <label>Total Max Possible Amount</label>
        <summarizedField>Core_MDF_Recovery_Dashboard__c.Core_MDF_Max_Possible_Amt__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Is_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Max_Possible_Amt__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
