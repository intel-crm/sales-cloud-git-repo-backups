    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_Component_Product_Class__c</fullName>
        <defaultValue>&quot;IC&quot;</defaultValue>
        <description>Defaulting the Product Class from PIR to &apos;IC&apos;</description>
        <externalId>false</externalId>
        <label>Component Product Class</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Error_Description__c</fullName>
        <description>Holds Error Description</description>
        <label>Error Description</label>
        <length>131072</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_OPN_Status_Txt__c</fullName>
