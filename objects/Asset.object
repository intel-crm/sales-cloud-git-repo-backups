        <url>{!REQUIRESCRIPT($Site.Prefix+&quot;/soap/ajax/35.0/connection.js&quot;)} 
{!REQUIRESCRIPT($Site.Prefix+&quot;/support/console/35.0/integration.js&quot;)} 

var querystatus = sforce.connection.query(&quot;SELECT id,Core_Status__c from Core_IPS_Project__c where id=&apos;{!Core_IPS_Project__c.Id}&apos;&quot;); 

var records = querystatus.getArray(&quot;records&quot;); 

if(&quot;{!Core_IPS_Project__c.Core_Status__c}&quot;!=&quot;Active&quot;){
alert(&apos;You cannot add products to an inactive project. If you want to add a new product, please set the project to Active&apos;); 
}
else{
window.location =&quot;/IPS/Core_ExternalUser_IPS_Project?id={!Core_IPS_Project__c.Id}&amp;stepIndex=2&amp;modeStr=add&amp;editProj=true&quot;
}</url>
