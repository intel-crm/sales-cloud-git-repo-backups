    <fields>
        <fullName>Core_IPS_AssetOrganization__c</fullName>
        <externalId>false</externalId>
        <formula>Name + &apos; (&apos; +Core_Product_Organization__r.Core_Organization_Description__c + &apos;) &apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>AssetOrganization</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Asset__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Boolean to indicate if this asset is used by IPS or not.   CHECKED=TRUE=IPS uses this asset</description>
        <inlineHelpText>Does IPS use this asset?</inlineHelpText>
        <label>IPS Asset</label>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Case__c</fullName>
        <description>This Field is used for Creating Case from Asset which is for replacing Core_IPS_New_Case as part of Summ-17 JavaScript disablement</description>
        <externalId>false</externalId>
        <formula>If(NOT(ISPICKVAL(Status,&apos;Inactive&apos;)) &amp;&amp;(Core_IPS_Project__r.Id!=null &amp;&amp; ISPICKVAL(Core_IPS_Project__r.Core_Status__c,&apos;Active&apos;) || Core_IPS_Project__r.Id==null), 
If(ISPICKVAL($User.UserType,&apos;PowerCustomerSuccess&apos;) || ISPICKVAL($User.UserType,&apos;PowerPartner&apos;), 

(if(($Label.Core_IPS_MAG_Support_Org)==(Core_Product_Organization__c),HYPERLINK(&quot;/IPS/apex/Core_IPS_Customer_Case_Creation?productId=&quot;&amp;Id&amp;&quot;&amp;projectId=&quot;&amp;Core_IPS_Project__r.Id&amp;&quot;&amp;mode=asset&amp;sbs=scs&amp;retURL=/02i/o&quot;, 
IMAGE(&quot;/IPS/servlet/servlet.FileDownload?file=015o0000001vY9i&quot;,&quot;New Case&quot;,15,15),&quot;_parent&quot;),HYPERLINK(&quot;/IPS/apex/Core_IPS_Customer_Case_Creation?productId=&quot;&amp;Id&amp;&quot;&amp;projectId=&quot;&amp;Core_IPS_Project__r.Id&amp;&quot;&amp;mode=asset&amp;sbs=ccs&amp;retURL=/02i/o&quot;, 
IMAGE(&quot;/IPS/servlet/servlet.FileDownload?file=015o0000001vY9i&quot;,&quot;New Case&quot;,15,15),&quot;_parent&quot;))),

HYPERLINK(&quot;/apex/Core_IPS_Internal_Case_Creation?productId=&quot;&amp;Id&amp;&quot;&amp;projectId=&quot;&amp;Core_IPS_Project__r.Id&amp;&quot;&amp;mode=asset&amp;retURL=/02i/o&quot;, 
IMAGE(&quot;/servlet/servlet.FileDownload?file=015o0000001vY9i&quot;,&quot;New Case&quot;,15,15),&quot;_parent&quot;) ), 

IF(ISPICKVAL($User.UserType,&apos;PowerCustomerSuccess&apos;) || ISPICKVAL($User.UserType,&apos;PowerPartner&apos;), 

IMAGE(&quot;/IPS/servlet/servlet.FileDownload?file=015o0000001vY4Z&quot;,&quot;New Case&quot;,15,15), 
IMAGE(&quot;/servlet/servlet.FileDownload?file=015o0000001vY4Z&quot;,&quot;New Case&quot;,15,15)) 

)</formula>
        <label>New Case</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Global_Assets__c</fullName>
        <formula>IF( RecordType.DeveloperName = &apos;Core_IPS_Public_Product&apos;, true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Global Assets?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_New_Case__c</fullName>
        <externalId>false</externalId>
        <formula>if(NOT(ISPICKVAL(Status,&apos;Inactive&apos;)),if((ISPICKVAL($User.UserType,&apos;PowerCustomerSuccess&apos;) || ISPICKVAL($User.UserType,&apos;PowerPartner&apos;)),HYPERLINK(&quot;/IPS/apex/Core_IPS_Customer_Case_Creation?productId=&quot;&amp;Id&amp;&quot;&amp;projectId=&quot;&amp;Core_IPS_Project__r.Id&amp;&quot;&amp;mode=asset&amp;retURL=/02i/o&quot;,IMAGE(&quot;/IPS/servlet/servlet.FileDownload?file=015o0000001vY9i&quot;,&quot;New Case&quot;,15,15),&quot;_parent&quot;),HYPERLINK(&quot;/apex/Core_IPS_Internal_Case_Creation?productId=&quot;&amp;Id&amp;&quot;&amp;projectId=&quot;&amp;Core_IPS_Project__r.Id&amp;&quot;&amp;mode=asset&amp;retURL=/02i/o&quot;,IMAGE(&quot;/servlet/servlet.FileDownload?file=015o0000001vY9i&quot;,&quot;New Case&quot;,15,15),&quot;_parent&quot;) ),HYPERLINK(&quot;//javascript:alert(&apos;This product is no longer supported through this channel, due to “End of Interactive Support (EOIS)” or removal of your access. Please contact your Intel representative for more information.&apos;)&quot;,IF((ISPICKVAL($User.UserType,&apos;PowerCustomerSuccess&apos;)|| ISPICKVAL($User.UserType,&apos;PowerPartner&apos;)),IMAGE(&quot;/IPS/servlet/servlet.FileDownload?file=015o0000001vY4Z&quot;,&quot;New Case&quot;,15,15),IMAGE(&quot;/servlet/servlet.FileDownload?file=015o0000001vY4Z&quot;,&quot;New Case&quot;,15,15)),&quot;_parent&quot;) 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>New Case</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Private_Project__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field gives information if the Asset belongs to a Private Project</description>
        <label>Is Private Project</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Project_Id__c</fullName>
        <externalId>false</externalId>
        <formula>Core_IPS_Project__r.Core_IPS_Project_ID__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Project Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Project_Name__c</fullName>
        <description>To show this field on Lookup Window Page with no hyper link for IPS Project(Only For Internal Cases).</description>
        <externalId>false</externalId>
        <formula>Core_IPS_Project__r.Name</formula>
        <label>Premier Support Project Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Project_Status__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Core_IPS_Project__r.Core_Status__c)</formula>
        <label>Project Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Project__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>IPS Project associated with this asset</description>
        <label>Premier Support Project</label>
        <referenceTo>Core_IPS_Project__c</referenceTo>
        <relationshipLabel>Intel® Products</relationshipLabel>
        <relationshipName>Assets</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Search_Reporting_Tag__c</fullName>
        <description>This Field is used for routing purpose in the case using assignment rule.</description>
        <externalId>false</externalId>
        <label>Search/Reporting Tag</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Support_License__c</fullName>
        <description>To display asset&apos;s product is public or private. Asset can be Private for a public supported product</description>
        <externalId>false</externalId>
        <formula>IF(Core_Supported_Product__r.Core_IPS_Public_Product__c, &apos;General&apos;, &apos;Early Access&apos;)</formula>
        <label>Support License</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Supported_Product_EOIS__c</fullName>
        <description>Indicates if the Supported Product is no longer being supported by the Support Org. When EOIS=TRUE, the product is no longer supported.</description>
        <formula>Core_Supported_Product__r.Core_EOIS__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>When EOIS=TRUE it indicates that the Supported Product is no longer supported by the Support Org</inlineHelpText>
        <label>Supported Product EOIS</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Map_List__c</fullName>
        <description>Concatenated list of unique MAP/PAR header records that refer to this asset.</description>
        <inlineHelpText>Related MAP/PAR records</inlineHelpText>
        <label>Map List</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Platform__c</fullName>
        <description>Platform value from the related master data Product</description>
        <externalId>false</externalId>
        <inlineHelpText>Platform value from the related master data Product</inlineHelpText>
        <label>Platform</label>
        <length>255</length>
