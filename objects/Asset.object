    <listViews>
        <fullName>Active_Intel_Products_IPS_Customer</fullName>
        <booleanFilter>1 AND (2 OR 4) AND 3</booleanFilter>
        <columns>Core_IPS_Case__c</columns>
        <columns>ASSET.NAME</columns>
        <columns>core_Product_Application__c</columns>
        <columns>Core_IPS_Support_License__c</columns>
        <columns>Core_IPS_Project_Id__c</columns>
        <columns>Core_IPS_Project__c</columns>
        <columns>ACCOUNT.NAME</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ASSET.STATUS</field>
            <operation>equals</operation>
            <value>Active</value>
        </filters>
        <filters>
            <field>Core_IPS_Project_Status__c</field>
            <operation>equals</operation>
            <value>Active</value>
        </filters>
        <filters>
            <field>Core_IPS_Supported_Product_EOIS__c</field>
            <operation>notEqual</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>Core_IPS_Project_Status__c</field>
            <operation>equals</operation>
        </filters>
        <label>My Active Intel Products</label>
        <sharedTo>
            <group>Core_PG_IPS_External_Customer</group>
            <group>Core_PG_IPS_Partner_AE</group>
            <group>Core_PG_Partner</group>
        </sharedTo>
    </listViews>
