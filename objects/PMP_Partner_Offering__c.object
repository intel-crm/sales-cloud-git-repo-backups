        </picklistValues>
        <picklistValues>
            <picklist>PMP_Partner_Offering_Lifecycle_Status_Nm__c</picklist>
            <values>
                <fullName>Admin Review</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Approved</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Archived</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Draft</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>In Approval</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>New</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Published</fullName>
                <default>false</default>
            </values>
            <values>
