        <label>New Offering Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMP_Offering_Creator_Nm__c</fullName>
        <description>Offering creator name</description>
        <externalId>false</externalId>
        <formula>CreatedBy.FirstName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Creator Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Offering_FAE_Status_Nm__c</fullName>
        <label>Offering FAE Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>PMP_Partner_Offering_Lifecycle_Status_Nm__c</controllingField>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending FAE approval</fullName>
                    <default>false</default>
                    <label>Pending FAE approval</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Accepted by FAE</fullName>
                    <default>false</default>
                    <label>Accepted by FAE</label>
                </value>
                <value>
                    <fullName>Update required</fullName>
                    <default>false</default>
                    <label>Update required</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>Approved</controllingFieldValue>
                <controllingFieldValue>Admin Review</controllingFieldValue>
                <controllingFieldValue>Published</controllingFieldValue>
                <valueName>Pending FAE approval</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Approved</controllingFieldValue>
                <controllingFieldValue>Admin Review</controllingFieldValue>
                <controllingFieldValue>Published</controllingFieldValue>
                <valueName>Approved</valueName>
            </valueSettings>
            <valueSettings>
