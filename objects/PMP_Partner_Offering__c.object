    </fields>
    <fields>
        <fullName>PMP_Business_Segment_Nm__c</fullName>
        <description>Business Segments are auto derived values based on selected category (IoT/Client/Server)</description>
        <inlineHelpText>Business Segments are auto derived values based on selected category (IoT/Client/Server)</inlineHelpText>
        <label>Partner Program Segment</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Field Programmable Gate Array</fullName>
                    <default>false</default>
                    <label>Field Programmable Gate Array</label>
                </value>
                <value>
                    <fullName>Personal Computers</fullName>
                    <default>false</default>
                    <label>Client Computing</label>
                </value>
                <value>
                    <fullName>Server</fullName>
                    <default>false</default>
                    <label>Data Center</label>
                </value>
                <value>
                    <fullName>IoT</fullName>
                    <default>false</default>
                    <label>Internet of Things and Embedded</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>PMP_Category_nm__c</fullName>
        <description>Offering Category Name</description>
        <externalId>false</externalId>
