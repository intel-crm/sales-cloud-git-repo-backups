        <formula>IF( AND(($Profile.Name=&quot;Partner&quot;), NOT(ISPICKVAL(PMP_Partner_Offering_Lifecycle_Status_Nm__c, &quot;Approved&quot;)) ), &quot;ENG, CHN, JPN&quot;,
(IF (AND(ISPICKVAL(PMP_Partner_Offering_Lifecycle_Status_Nm__c,&apos;Approved&apos;),PMP_Pre_Release_Item_Count_Num__c = 0, PMP_Partner_Offering_End_Dt__c &gt;= TODAY() ,INCLUDES(PMP_Translated_Languages__c , &quot;English&quot;)), HYPERLINK($Label.PMP_AEM_Offering_URL&amp;&apos;us/en&apos;&amp;$Label.PMP_AEM_Offering_URL_Part_2&amp;IF(PMP_Published_Copy_Id_Txt__c &lt;&gt; null, PMP_Published_Copy_Id_Txt__c,Id)&amp;&apos;/&apos;&amp;PMP_Partner_Offering_Nm__c&amp;&apos;.html&apos;,&apos;ENG&apos;) , &apos;ENG&apos;)
&amp; &quot;, &quot; &amp;
IF (AND(ISPICKVAL(PMP_Partner_Offering_Lifecycle_Status_Nm__c,&apos;Approved&apos;),PMP_Pre_Release_Item_Count_Num__c = 0, PMP_Partner_Offering_End_Dt__c &gt;= TODAY() ,INCLUDES(PMP_Translated_Languages__c , &quot;Simplified Chinese&quot;)), HYPERLINK($Label.PMP_AEM_Offering_URL&amp;&apos;cn/zh&apos;&amp;$Label.PMP_AEM_Offering_URL_Part_2&amp;IF(PMP_Published_Copy_Id_Txt__c &lt;&gt; null, PMP_Published_Copy_Id_Txt__c,Id)&amp;&apos;/&apos;&amp;PMP_Partner_Offering_Nm__c&amp;&apos;.html&apos;,&apos;CHN&apos;) , &apos;CHN&apos;)
&amp; &quot;, &quot; &amp;
IF (AND(ISPICKVAL(PMP_Partner_Offering_Lifecycle_Status_Nm__c,&apos;Approved&apos;),PMP_Pre_Release_Item_Count_Num__c = 0, PMP_Partner_Offering_End_Dt__c &gt;= TODAY() ,INCLUDES(PMP_Translated_Languages__c , &quot;Japanese&quot;)), HYPERLINK($Label.PMP_AEM_Offering_URL&amp;&apos;jp/ja&apos;&amp;$Label.PMP_AEM_Offering_URL_Part_2&amp;IF(PMP_Published_Copy_Id_Txt__c &lt;&gt; null, PMP_Published_Copy_Id_Txt__c,Id)&amp;&apos;/&apos;&amp;PMP_Partner_Offering_Nm__c&amp;&apos;.html&apos;,&apos;JPN&apos;), &apos;JPN&apos;)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>View Offerings</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Workflow_One_Week_Trigger_Dt__c</fullName>
        <description>Date field to exclude weekends for 1 week SLA reminders workflows</description>
        <formula>DATEVALUE(PMP_Offering_Status_Update_Dt__c) + CASE(MOD(DATEVALUE(PMP_Offering_Status_Update_Dt__c)-DATE(1900,1,7),7), 
0,2, 
1,4, 
2,4, 
3,4, 
4,4, 
5,4, 
6,3,0)</formula>
        <inlineHelpText>Date field to exclude weekends for 1 week SLA reminders workflows</inlineHelpText>
        <label>1 Week SLA Workflow Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMP_Workflow_Three_Day_Trigger_Dt__c</fullName>
        <description>Holds the date relevant to reminder Workflows helping in calculating weekdays</description>
        <formula>DATEVALUE(PMP_Offering_Status_Update_Dt__c) + CASE(MOD(DATEVALUE(PMP_Offering_Status_Update_Dt__c)-DATE(1900,1,7),7),
3,2, 
4,2, 
5,2, 
6,1, 
0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Holds the date relevant to reminder Workflows helping in calculating weekdays</inlineHelpText>
        <label>3 Days SLA WorkFlow Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMP_Working_Copy_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This stores the value of working copy for published offering</description>
        <label>Working Copy Id</label>
        <referenceTo>PMP_Partner_Offering__c</referenceTo>
        <relationshipName>Offerings</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
