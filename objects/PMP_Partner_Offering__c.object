        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Current_User_Offering_Ind__c</fullName>
        <formula>$User.Id  =   PMP_Intel_Admin_Id__r.Id</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Logged in user</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Edit_Clone_Offering__c</fullName>
        <description>This formula displays two hyperlinks for both edit and clone functionality on the list views in marketplace</description>
        <externalId>false</externalId>
        <formula>IF(
OR(
(ISPICKVAL(PMP_Partner_Offering_Lifecycle_Status_Nm__c, &quot;Retired&quot;)),
((ISPICKVAL(PMP_Partner_Offering_Lifecycle_Status_Nm__c, &quot;Admin Review&quot;) &amp;&amp; $Profile.Name = &apos;Partner&apos; )),
(($Permission.PMP_Internal_Intel_Admin) &amp;&amp; INCLUDES(PMP_Business_Segment_Nm__c, &apos;IoT&apos;) &amp;&amp; NOT(INCLUDES(PMP_Translated_Languages__c, &apos;English&apos;))),
(NOT(($Permission.PMP_Internal_Intel_Admin)) &amp;&amp; (ISPICKVAL(PMP_Partner_Offering_Lifecycle_Status_Nm__c, &quot;Admin Review&quot;) || (PMP_Partner_Offering_Start_Dt__c &gt; TODAY())))
),
&apos;Edit&apos;,
HYPERLINK(
IF(
CONTAINS($Api.Partner_Server_URL_260, &apos;marketplace&apos;),LEFT($Api.Partner_Server_URL_260, FIND( &quot;/services&quot;, $Api.Partner_Server_URL_260))+&apos;s/&apos;,
IF(
CONTAINS($Api.Partner_Server_URL_260, &apos;imp&apos;),
LEFT($Api.Partner_Server_URL_260, FIND( &quot;/imp/s&quot;, $Api.Partner_Server_URL_260))
+&apos;imp/s/&apos;,
&quot;/&quot;
)) + &quot;offering-edit?recordId=&quot;+IF(PMP_Working_Copy_Id__r.Id &lt;&gt; null, PMP_Working_Copy_Id__r.Id,Id)+ IF($Permission.PMP_Internal_Intel_Admin, &quot;&amp;Lang=&quot;+TEXT($User.LanguageLocaleKey)+&quot;&amp;action=edit&quot;, &apos;&apos;),
&apos;Edit&apos;
)) &amp;&apos; &apos;&amp;
HYPERLINK(IF(
CONTAINS($Api.Partner_Server_URL_260, &apos;marketplace&apos;),LEFT($Api.Partner_Server_URL_260, FIND( &quot;/services&quot;, $Api.Partner_Server_URL_260))+&apos;s/&apos;,
IF(
CONTAINS($Api.Partner_Server_URL_260, &apos;imp&apos;),
LEFT($Api.Partner_Server_URL_260, FIND( &quot;/imp/s&quot;, $Api.Partner_Server_URL_260))
+&apos;imp/s/&apos;,
&quot;/&quot;
)) + &quot;offering-edit?recordId=&quot;+IF(PMP_Working_Copy_Id__r.Id &lt;&gt; null, PMP_Working_Copy_Id__r.Id,Id)+&quot;&amp;lang=NA&quot;+&quot;&amp;action=clone&quot;,&apos;Clone&apos;)</formula>
        <label>Edit/Clone Offering</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Edit_Language_Cd__c</fullName>
        <description>This field holds the language code in which offering details are Edited</description>
        <externalId>false</externalId>
        <inlineHelpText>This field holds the language code in which offering details are Edited</inlineHelpText>
        <label>Edit Language</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_FAE_Review_Four_Day_Reminder_Dt__c</fullName>
        <formula>DATEVALUE(PMP_Offering_Status_Update_Dt__c) + CASE(MOD(DATEVALUE(PMP_Offering_Status_Update_Dt__c) -DATE(1900,1,7),7), 
0,4, 
1,4, 
6,5, 
6)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>FAE Review Four Day Reminder Dt</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMP_FAE_Review_Two_Day_Reminder_Dt__c</fullName>
        <formula>DATEVALUE(PMP_Offering_Status_Update_Dt__c) + CASE(MOD(DATEVALUE(PMP_Offering_Status_Update_Dt__c)-DATE(1900,1,7),7), 
4,4,  
5,4,  
6,3,  
2)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>FAE Review Two Day Reminder Dt</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMP_Featured_Offering_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is to make the offering promoted or not</description>
        <label>Featured Offering</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Featured__c</fullName>
        <description>To capture whether the offering is featured or not and display in reports</description>
        <externalId>false</externalId>
        <formula>IF(PMP_Featured_Offering_Ind__c ,&apos;Y&apos;,&apos;N&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Featured</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Field_Application_Engineer_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>created to stamp selected FAE user</description>
        <label>Field Application Engineer</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Offerings2</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
