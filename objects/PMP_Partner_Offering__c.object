+$Label.PMP_Marketplace_MessageDetailPage,
&quot;/&quot;
)) &amp; Id &amp;&quot;?Lang=NA&amp;viewChat=true&quot;,IMAGE($Label.PMP_CommunityURLSuffix+&quot;resource/PMP_View_Chat_Messages&quot;,&quot;Offering Messages&quot; , 32, 32)) , IMAGE($Label.PMP_CommunityURLSuffix+&quot;resource/PMP_View_Chat_Messages&quot;,&quot;Offering Messages&quot;)),
 &quot;-&quot;)</formula>
