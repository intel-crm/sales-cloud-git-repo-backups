    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>PMP_Reject_Offering_Validation</fullName>
        <active>true</active>
        <description>Reject an offering only if the previous offering status value is &quot;Admin Review&quot;. Offering previous status should be &quot;Admin Review&quot;</description>
        <errorConditionFormula>AND(OR(ISPICKVAL(PRIORVALUE(PMP_Partner_Offering_Lifecycle_Status_Nm__c) , &quot;Draft&quot;),
ISPICKVAL(PRIORVALUE(PMP_Partner_Offering_Lifecycle_Status_Nm__c),&quot;Update Required&quot;)),
ISPICKVAL(PMP_Partner_Offering_Lifecycle_Status_Nm__c, &quot;Rejected&quot;),
NOT(ISPICKVAL(PRIORVALUE(PMP_Partner_Offering_Lifecycle_Status_Nm__c),&quot;Admin Review&quot;))
)</errorConditionFormula>
        <errorDisplayField>PMP_Partner_Offering_Lifecycle_Status_Nm__c</errorDisplayField>
        <errorMessage>An offering can be Rejected only if it is reviewed by Admin. Offering previous status should be &quot;Admin Review&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMP_Update_Offering_Validation</fullName>
        <active>true</active>
        <description>Update an offering only if the previous offering status value is &quot;Admin Review&quot;</description>
        <errorConditionFormula>AND(OR(ISPICKVAL(PRIORVALUE(PMP_Partner_Offering_Lifecycle_Status_Nm__c) , &quot;Draft&quot;),
ISPICKVAL(PRIORVALUE(PMP_Partner_Offering_Lifecycle_Status_Nm__c),&quot;Update Required	&quot;)),
ISPICKVAL(PMP_Partner_Offering_Lifecycle_Status_Nm__c, &quot;Update Required&quot;),
NOT(ISPICKVAL(PRIORVALUE(PMP_Partner_Offering_Lifecycle_Status_Nm__c),&quot;Admin Review&quot;))
)</errorConditionFormula>
        <errorDisplayField>PMP_Partner_Offering_Lifecycle_Status_Nm__c</errorDisplayField>
        <errorMessage>An offering can be sent for Update only if it is reviewed by Admin. Offering previous status should be &quot;Admin Review&quot;</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
