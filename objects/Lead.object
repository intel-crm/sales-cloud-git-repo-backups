    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Check_Title</fullName>
        <active>false</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
OR(
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;), 
ISPICKVAL(PRIORVALUE(Status), &quot;Tele Accepted Lead&quot;), 
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISBLANK(Title)
),
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;), 
ISPICKVAL(PRIORVALUE(Status), &quot;Tele Qualified Lead&quot;), 
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISBLANK(Title)
),
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;,
ISBLANK(Title),
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;)
)))</errorConditionFormula>
        <errorDisplayField>Title</errorDisplayField>
        <errorMessage>Please enter a value for Title.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_City</fullName>
        <active>false</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
OR(
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
ISPICKVAL(PRIORVALUE(Status), &quot;Tele Accepted Lead&quot;),
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISBLANK(City)
),
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
ISPICKVAL(PRIORVALUE(Status), &quot;Tele Qualified Lead&quot;),
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISBLANK(City)
),
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;,
ISBLANK(City),
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;)
)))</errorConditionFormula>
        <errorDisplayField>City</errorDisplayField>
        <errorMessage>Please enter a value for City.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Company</fullName>
        <active>true</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
OR(
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
OR(ISPICKVAL(PRIORVALUE(Status), &quot;Marketing Qualified Lead&quot;),ISPICKVAL(PRIORVALUE(Status), &quot;Sales Generated Lead&quot;)),
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
