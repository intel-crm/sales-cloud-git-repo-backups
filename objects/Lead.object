    <validationRules>
        <fullName>Core_Lead_Src_Req_If_Spcfic_Ld_Stg_Vlues</fullName>
        <active>true</active>
        <description>Lead Source value is required if field value is blank and Lead not created by a user with the Integration profile.</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISPICKVAL(LeadSource,&quot;&quot;),
$Profile.Name &lt;&gt; &quot;Integration&quot;,
RecordType.DeveloperName &lt;&gt; &quot;Lead&quot;,
NOT(CreatedBy.FirstName = &quot;Integration&quot;)
)
)</errorConditionFormula>
        <errorDisplayField>LeadSource</errorDisplayField>
        <errorMessage>Please enter a value for Lead Source.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Stage_Check_SQL</fullName>
        <active>true</active>
        <description>Validation rule to make sure that &apos;Sales Qualified Lead&apos; (SQL) is not selected before &quot;Sales Accepted Lead&quot;.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,AND(
ISCHANGED(Status),
OR(
ISPICKVAL(Status,&quot;Sales Qualified Lead&quot;),
ISPICKVAL(Status,&quot;Contact - No Opportunity&quot;)
),
NOT(ISPICKVAL(PRIORVALUE(Status), &quot;Sales Accepted Lead&quot;))
))</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Please change status to &quot;Sales Accepted Lead&quot; before converting</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Stage_Check_TQL</fullName>
        <active>false</active>
        <description>Validation rule to make sure that &apos;Tele Qualified Lead&apos; (TQL) is not selected for a new record.</description>
        <errorConditionFormula>AND( 
ISNEW(), 
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;)
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>The Lead Stage &quot;Tele Qualified Lead&quot; cannot be selected for a new record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Stage_Check_UQL</fullName>
        <active>true</active>
        <description>Validation rule to make sure that &apos;Unqualified&apos; (UQL) is not selected for an existing record.</description>
        <errorConditionFormula>AND( 
NOT(ISNEW()), 
ISPICKVAL(Status, &quot;Unqualified&quot;),
NOT(ISPICKVAL(PRIORVALUE(Status), &quot;Unqualified&quot;))
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>The Lead Stage &quot;Unqualified&quot; cannot be selected for an existing record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Validate_Email</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name = &quot;Sales Lead&quot;,
ISCHANGED(IsConverted),
IsConverted = true,
ISBLANK(Email)
)
)</errorConditionFormula>
        <errorMessage>Please provide a Email.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Validate_Phone</fullName>
        <active>true</active>
        <description>This validation rule is created to make the phone field as mandatory field during lead conversion</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
    RecordType.Name &lt;&gt; &quot;Partner Lead&quot;,
    ISCHANGED(IsConverted),
    IsConverted = true,
    ISBLANK(Phone)
)
)</errorConditionFormula>
        <errorMessage>Please provide a Phone number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_No_Convertion_If_Status_Disqualifie</fullName>
        <active>true</active>
        <description>This validation fires when the user tries to convert the disqualified prospect</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
ISPICKVAL(Core_Prospect__r.Core_Status_Pkt__c, &apos;Disqualified&apos;)
)</errorConditionFormula>
        <errorMessage>Disqualified Prospect cannot be converted</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Parner_Lead_Claim_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF( $Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(ISNEW()),
RecordType.Name = &quot;Partner Lead&quot;,
ISBLANK(Core_Partner_Lead_Owner__c),
NOT(ISPICKVAL(Core_Lead_State__c,&quot;Terminated&quot;)),
NOT(OR($Profile.Name = &apos;System Administrator&apos;,
$Permission.Lead_Bypass_Permission,
$Profile.Name = &apos;Core Integration&apos;,
$Profile.Name = &apos;Partner Admin&apos;,
$Profile.Name =&apos;Data Ops&apos;
)
),
NOT(ISCHANGED( OwnerId )),
NOT(ISCHANGED(Core_Is_Lead_Shared__c)),
NOT(ISCHANGED(Core_Lead_Sharing_Error__c)),
NOT(ISCHANGED(Core_Reprocess_Lead_Sharing__c)),
AND(
NOT(ISCHANGED(Core_One_Partner_Id__c)),
NOT(ISNULL(Core_One_Partner_Id__c))
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_1st_Reminder__c</errorDisplayField>
        <errorMessage>Please click the “Claim” button to update this Lead.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Partner_Lead_Reject_Button_Required</fullName>
        <active>true</active>
        <description>Prevents Partner Lead records from being updated to Disqualified, Rejected, or Terminated status without using the Reject button.</description>
        <errorConditionFormula>IF(
    $Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,
    FALSE,
    AND(
        NOT(ISNEW()),
        RecordType.Name = &quot;Partner Lead&quot;,
        $Profile.Name &lt;&gt; &quot;System Administrator&quot;,

        OR(
            AND(
                ISCHANGED(Core_Lead_Status__c),
                ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;)
            ),
            AND(
                ISCHANGED(Status),
                ISPICKVAL(Status, &quot;Rejected&quot;)
            ),
            AND(
                ISCHANGED(Core_Lead_State__c),
                ISPICKVAL(Core_Lead_State__c, &quot;Terminated&quot;)
            )
        ),

        OR(
            ISBLANK(TEXT(Core_Rejection__c)),
            ISBLANK(Core_Rejection_Comments__c)
        )
    )
)</errorConditionFormula>
        <errorMessage>Please use the &apos;Reject&apos; button to Reject or Terminate the lead.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Partner_Lead_Status_Skip</fullName>
        <active>true</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
ISCHANGED(Core_Lead_Status__c), 
RecordType.Name = &quot;Partner Lead&quot;, 
OR( 

AND( 
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;New&quot;), 
ISPICKVAL(Core_Lead_Status__c,&quot;Contacted&quot;) 
), 
AND( 
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;New&quot;), 
ISPICKVAL(Core_Lead_Status__c,&quot;Qualified&quot;) 
),
AND( 
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Accepted&quot;), 
ISPICKVAL(Core_Lead_Status__c,&quot;Qualified&quot;) 
) 

)	

) 
)</errorConditionFormula>
        <errorMessage>Cannot bypass “Contacted” status - please select the next status in the lead path.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Change_SAL_To_SQL_Manually</fullName>
        <active>true</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(IsConverted),
OR(RecordType.DeveloperName = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;),  
OR(
ISPICKVAL(Status, &quot;Sales Qualified Lead&quot;),
ISPICKVAL(Status, &quot;Contact - No Opportunity&quot;)
)
)
)</errorConditionFormula>
        <errorMessage>Can not select stage &quot;Sales Qualified Lead&quot; or &quot;Contact - No Opportunity&quot;. Please convert the lead by clicking &quot;Convert&quot; button and select lead stage as &quot;Sales Qualified Lead&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Lead_Update_IF_Owner_Queue</fullName>
        <active>true</active>
        <description>Validate owner is a Queue</description>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(ISNEW()),
OR(RecordType.DeveloperName = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;),
Core_Flag_on_Queue_or_User__c=&apos;Queue&apos;,
NOT(ISCHANGED(OwnerId)),
$Profile.Name &lt;&gt; &quot;Core Integration&quot;,
NOT($Permission.Lead_Bypass_Permission), 
$Profile.Name &lt;&gt; &quot;Generic API-Integration&quot;,
$Profile.Name &lt;&gt; &quot;System Administrator&quot;
)
)</errorConditionFormula>
        <errorMessage>Please claim the ownership to update the Lead information</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_ProspectLead_Claim_Validation</fullName>
        <active>true</active>
        <description>When the user is trying to convert the prospect to Lead and if the prospect is not claimed,  error should be thrown</description>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISNEW(),
NOT(ISNULL(Core_Prospect__c)),
ISNULL(Core_Prospect__r.Core_Claimed_Date__c),
ISPICKVAL(Core_Prospect__r.Core_Status_Pkt__c, &apos;New&apos;),
$RecordType.DeveloperName = &quot;Sales_Lead&quot;
)
)</errorConditionFormula>
        <errorMessage>Please claim the ownership of prospect before converting it to lead</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_RecordType_Change</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(ISCHANGED(RecordTypeId),
OR(RecordType.DeveloperName = &apos;Lead&apos;,RecordType.Name = &apos;Sales Lead&apos;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot; 

))</errorConditionFormula>
        <errorMessage>You can&apos;t change the Record Type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Controlling_Fields</fullName>
        <active>true</active>
        <description>Lead Status and Lead Sub Status</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
ISPICKVAL(Core_Lead_Status__c , &apos;Disqualified&apos;), 
ISBLANK(TEXT( Core_Lead_Sub_Status__c )), 
RecordType.Name &lt;&gt; &quot;Partner_Lead&quot; 
) 
)</errorConditionFormula>
        <errorMessage>Please select Lead Sub Status value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_CreateOpp_OnConvert</fullName>
        <active>true</active>
        <description>US356477
During lead conversion if a user selects the checkbox “Do not create an Opportunity upon conversion” and does not set Converted Status to “Contact - No Opportunity” then  user should get a error.</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(IsConverted=true,
ConvertedOpportunityId=&quot;&quot;,
ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;),
NOT(ISPICKVAL(Status, &quot;Contact - No Opportunity&quot;)),
OR(RecordType.DeveloperName = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;) 
)
)</errorConditionFormula>
        <errorMessage>Please select Converted status as &quot;Contact - No Opportunity&quot; to proceed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Edit_Lead_Stage</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(Status),
NOT(OR(
$Profile.Name = &quot;System Administrator&quot;,
$Permission.Lead_Bypass_Permission,
$Profile.Name = &quot;Core Integration&quot;,
$Profile.Name = &quot;IT Admin&quot;,
$Profile.Name = &quot;Partner Admin&quot;
)),
RecordType.Name = &apos;Partner Lead&apos;,
NOT($Setup.Core_Validation_Bypass_for_Flow__c.Bypass__c)
))</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Stage is non editable as it is automatically changed as the Lead progresses.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Editing_PartnerLead</fullName>
        <active>true</active>
        <description>Internal Sales profiles can&apos;t claim the partner lead information</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name = &apos;Partner Lead&apos;,
ISCHANGED(Core_Partner_Lead_Owner__c),
NOT(OR($Profile.Name = &apos;System Administrator&apos;,$Profile.Name = &apos;IT Admin&apos;,
$Profile.Name = &apos;Partner&apos;,
$Profile.Name = &apos;Core Integration&apos;,
$Permission.Lead_Bypass_Permission,
$Profile.Name = &apos;Partner Admin&apos;
)
)
)
)</errorConditionFormula>
        <errorMessage>You don&apos;t have access to Edit the partner lead</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_PartnerUser_CreateLead</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 ISNEW(),
 RecordType.Name = &quot;Partner Lead&quot;,
 $Profile.Name = &quot;Partner&quot;
)</errorConditionFormula>
        <errorMessage>New lead creation capability is not available for you.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Prospect_Record_Update</fullName>
        <active>true</active>
        <description>Prospect Records are not functional anymore as part of the new business process. If user try to update any of these fields it wil trigger the below validation</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
RecordType.Name = &quot;Prospect&quot;, 
OR( 
ISCHANGED(FirstName ), 
ISCHANGED(LastName), 
ISCHANGED(Company), 
ISCHANGED(Status), 
ISCHANGED(Salutation), 
ISCHANGED(Email) 
), 
$Profile.Name &lt;&gt; &quot;System Administrator&quot; 
) 
)</errorConditionFormula>
        <errorMessage>Prospect Records are not functional anymore as part of the new business process. Please contact your Leads team for further details</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Sub_Status_LOV_Expired_SLA</fullName>
        <active>false</active>
        <description>Lead Sub Status</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 

AND( 
ISPICKVAL(Core_Lead_Sub_Status__c , &apos;Expired SLA&apos;),
NOT(ISPICKVAL(Status, &apos;Marketing Qualified Lead&apos;)),
ISCHANGED(Core_Lead_Sub_Status__c ), 
OR($Profile.Name = &quot;Data Ops&quot;,
$Profile.Name = &quot;IT Admin&quot;,
$Profile.Name = &quot;System Administrator&quot;),
RecordType.Name &lt;&gt; &quot;Partner_Lead&quot; 
)
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_Sub_Status__c</errorDisplayField>
        <errorMessage>Expired SLA value is applicable only for MAQL stage. Please select the appropriate LOV value for this stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Sub_Status_LOV_Rep_Inactiv</fullName>
        <active>false</active>
        <description>Lead Sub Status = Rep Inactivity</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 

AND( 
ISPICKVAL(Core_Lead_Sub_Status__c , &apos;Rep Inactivity&apos;),
ISPICKVAL(Status, &apos;Marketing Qualified Lead&apos;), 
ISCHANGED(Core_Lead_Sub_Status__c ), 
OR($Profile.Name = &quot;Data Ops&quot;,
$Profile.Name = &quot;IT Admin&quot;,
$Profile.Name = &quot;System Administrator&quot;),
RecordType.Name &lt;&gt; &quot;Partner_Lead&quot; 
)
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_Sub_Status__c</errorDisplayField>
        <errorMessage>Rep Inactivity value is applicable only for SAL stage. Please select the appropriate LOV value for this stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Sub_Status_LOV_Values</fullName>
        <active>false</active>
        <description>Lead Sub Status</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 

AND( 
OR(
ISPICKVAL(Core_Lead_Sub_Status__c , &apos;Expired SLA&apos;),
ISPICKVAL(Core_Lead_Sub_Status__c , &apos;Rep Inactivity&apos;)
),
ISCHANGED(Core_Lead_Sub_Status__c ), 
$Profile.Name &lt;&gt; &quot;Data Ops&quot;,
$Profile.Name &lt;&gt; &quot;IT Admin&quot;,
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
RecordType.Name &lt;&gt; &quot;Partner_Lead&quot; 
)
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_Sub_Status__c</errorDisplayField>
        <errorMessage>This sub status value can only be selected by Data Ops. Please contact your Data Ops representative.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_StatusCannot_change</fullName>
        <active>true</active>
        <description>From Passed to Partner, disqulaified,Rejected we can&apos;t change the status</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c),&apos;Disqualified&apos;),
ISCHANGED(Core_Lead_Status__c),
Core_Rejected_Flag__c = false,
OR(RecordType.DeveloperName = &apos;Lead&apos;,RecordType.Name = &apos;Sales Lead&apos;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Data Ops&quot;,
OR(AND($User.FirstName  &lt;&gt; &quot;Marketo&quot;,
$User.LastName  &lt;&gt; &quot;User&quot;))
)
)</errorConditionFormula>
        <errorDisplayField>Core_1st_Reminder__c</errorDisplayField>
        <errorMessage>Can&apos;t change the Lead status and Lead stage when lead current status is &quot;Disqualified”, Please contact system admin.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Stop_ConvertingFromProspectMoreThan</fullName>
        <active>true</active>
        <description>This validation stops the user from converting the same prospect record more than once</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,Core_Converted_Lead__c = true)</errorConditionFormula>
        <errorMessage>This Prospect is already converted.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Unreachable_Status_change</fullName>
        <active>false</active>
        <description>It won&apos;t allow user to update the Lead Status from Unreachable , from Revive button only it will update the Status</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &apos;Unreachable&apos;) , 
Core_Unreachable_flag__c=true, 
OR(ISCHANGED(Core_Lead_Status__c),ISCHANGED(Status)), 
OR(RecordType.Name = &apos;Lead&apos;,RecordType.Name = &apos;Sales Lead&apos;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;

) 
)</errorConditionFormula>
        <errorDisplayField>Core_1st_Reminder__c</errorDisplayField>
        <errorMessage>Please use the Revive button to change the Status from Unreachable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_LeadSubStatus_for_MQLAtCon</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName = &quot;Lead&quot;,
ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),
OR(ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;New&quot;),
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Accepted&quot;),
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Disqualified&quot;)),
ISPICKVAL(PRIORVALUE(Core_Lead_Sub_Status__c), &quot;Attempting Contact&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Not Target Profile&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Bad Data&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Rep Inactivity&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Banned Company&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Already Engaged with Intel&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Unreachable&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Not Interested&quot;)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_Sub_Status__c</errorDisplayField>
        <errorMessage>&quot;Invalid substatus selection. Allowed substatus for the data condition: Not target profile, Unreachable, Bad Data, Banned Company/Country, Already Engaged with Intel, Not Interested or Rep Inactivity.&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_LeadSubStatus_for_MQLInCon</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName = &quot;Lead&quot;,
ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),
OR(ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;New&quot;),
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Accepted&quot;),
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Disqualified&quot;)),

ISPICKVAL(PRIORVALUE(Core_Lead_Sub_Status__c), &quot;In Contact&quot;),

ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Not Target Profile&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Bad Data&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Already Engaged with Intel&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Rep Inactivity&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Not Interested&quot;)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_Sub_Status__c</errorDisplayField>
        <errorMessage>&quot;Invalid substatus selection. Allowed substatus for the data condition: Not target profile, Bad Data, Already Engaged with Intel, Not Interested or Rep Inactivity.&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_LeadSubStatus_for_SGLAtCon</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name = &quot;Sales Lead&quot;,
ISPICKVAL(Status, &quot;Sales Generated Lead&quot;),
OR(ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Accepted&quot;),
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Disqualified&quot;)),
ISPICKVAL(PRIORVALUE(Core_Lead_Sub_Status__c), &quot;Attempting Contact&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Rep Inactivity&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Already Engaged with Intel&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Unreachable&quot;)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_Sub_Status__c</errorDisplayField>
        <errorMessage>&quot;Invalid substatus selection. Allowed substatus for the data condition: Unreachable, Already Engaged with Intel, or Rep Inactivity.&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_LeadSubStatus_for_SGLInCon</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name = &quot;Sales Lead&quot;,
ISPICKVAL(Status, &quot;Sales Generated Lead&quot;),
OR(ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Accepted&quot;),
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Disqualified&quot;)),
ISPICKVAL(PRIORVALUE(Core_Lead_Sub_Status__c), &quot;In Contact&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Not Target Profile&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Already Engaged with Intel&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Rep Inactivity&quot;)
)
)
) 
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_Sub_Status__c</errorDisplayField>
        <errorMessage>&quot;Invalid substatus selection. Allowed substatus for the data condition: Not target profile, Already Engaged with Intel, or Rep Inactivity.&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_NewLead_For_Eloqua_User</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
ISNEW(),
NOT(ISCLONE()),
RecordType.DeveloperName = &quot;Lead&quot;, 
NOT(ISPICKVAL (Core_Lead_Status__c, &quot;New&quot;)),
NOT(ISPICKVAL (Core_Lead_State__c, &quot;Unclaimed&quot;)), 
NOT(ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;))
)
)</errorConditionFormula>
        <errorMessage>For any lead to be created by Marketo through the integration user profile, we would need Marketo to send the following data. Record type = Lead, Stage (Status) = Marketing Qualified Lead, Lead Status (Core_Lead_Status__c) = New, Core_Lead_State=Unclaimed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_NewLead_for_Internal_User</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCLONE(),
RecordType.DeveloperName=&quot;Lead&quot;,
OR(NOT(ISPICKVAL ( Core_Lead_Status__c ,&quot;New&quot;)),
NOT(ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;))),
NOT($Permission.Lead_Bypass_Permission),
$Profile.Name &lt;&gt; &quot;Core Integration&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;
)
)</errorConditionFormula>
        <errorMessage>To clone a Lead record, ensure that Lead Stage= &quot;Marketing Qualified Lead&quot;, Lead Status= “New”.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_New_SalesLead</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
OR(ISCLONE(),ISNEW()),
RecordType.Name = &quot;Sales Lead&quot;,
OR(NOT(ISPICKVAL ( Core_Lead_Status__c ,&quot;Accepted&quot;)),
NOT(ISPICKVAL(Status, &quot;Sales Generated Lead&quot;)),
NOT(ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Attempting Contact&quot;))),
NOT($Permission.Lead_Bypass_Permission),
$Profile.Name &lt;&gt; &quot;Core Integration&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;
)
)</errorConditionFormula>
        <errorMessage>To create/clone a Sales Lead record, ensure that Lead Stage= &quot;Sales Generated Lead&quot;, Lead Status= “Accepted” and Lead sub status = &quot;Attempting Contact&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_RecordType_For_Eloqua</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISNEW(),
RecordType.Name = &quot;Sales Lead&quot;,
OR(
$Profile.Name = &quot;Integration&quot;,
$Permission.Lead_Bypass_Permission,
$Profile.Name = &quot;Core Integration&quot;
)
)
)</errorConditionFormula>
        <errorMessage>For any lead to be created by Marketo through the integration user profile, we would need Marketo to send Record type = Lead.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_RecordType_For_InternalUsr</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISNEW(),
NOT(ISCLONE()),
RecordType.DeveloperName = &quot;Lead&quot;,
NOT(OR(
$Profile.Name = &quot;Integration&quot;,
$Permission.Lead_Bypass_Permission,
$Profile.Name = &quot;Core Integration&quot;,
$Profile.Name = &quot;System Administrator&quot;,
$Profile.Name = &quot;Sales Rep-CW&quot;,
(ISPICKVAL(LeadSource,&quot;IDC Credit Request&quot;))
))
)
)</errorConditionFormula>
        <errorDisplayField>Core_1st_Reminder__c</errorDisplayField>
        <errorMessage>Record type &quot;Lead &quot; cannot select manually in Salesforce,Please select &quot;Sales Lead&quot; Recordtype .If you are trying to Clone an existing record of &quot;Lead &quot; recordtype please switch back to classic .</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_StatusCheck_OnConvert</fullName>
        <active>false</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
IsConverted, 
OR(RecordType.Name = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;), 
OR( 
ISPICKVAL(Status, &quot;Sales Qualified Lead&quot;), 
ISPICKVAL(Status, &quot;Contact - No Opportunity&quot;) 
), 
NOT(OR 
( 
(ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;)), 
(ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;)) 

)),
NOT(ISPICKVAL(Core_Lead_State__c, &quot;Converted&quot;))

)
)</errorConditionFormula>
        <errorDisplayField>Core_1st_Reminder__c</errorDisplayField>
        <errorMessage>Select stage as &quot;SAL&quot; and status as &quot;Qualified&quot; or &quot;Disqualified&quot; before converting the Lead.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_Status_For_Stage_MAQL</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(Core_Lead_Status__c),
NOT(ISNEW()),
RecordType.DeveloperName = &quot;Lead&quot;,
ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Status__c, &quot;New&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Accepted&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;)
)
)
)
)</errorConditionFormula>
        <errorMessage>Not a valid status for stage &quot;Marketing Qualified Lead&quot;. If you are in SalesForce Lightning, please follow the Guidance for Success mentioned in the Lead path.  Guidance for Success can be found by clicking on the arrow next to the Lead stages.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_Status_For_Stage_SAL</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
NOT(ISNEW()), 
ISCHANGED(Core_Lead_Status__c), 
OR(RecordType.DeveloperName = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;), 
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;), 
NOT( 
		OR(
		ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;), 
		ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;) 
		) 
		)	
) 
)</errorConditionFormula>
        <errorMessage>Not a valid status for stage &quot;Sales Accepted Lead&quot;. If you are in Salesforce Lightning, please follow the Guidance for Success mentioned in the Lead path. Guidance for Success can be found by clicking on the arrow next to the Lead stages.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_Status_For_Stage_SGL</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(Core_Lead_Status__c),
NOT(ISNEW()),
RecordType.Name = &quot;Sales Lead&quot;,
ISPICKVAL(Status, &quot;Sales Generated Lead&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Status__c, &quot;Accepted&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;)
)
)
)
)</errorConditionFormula>
        <errorMessage>Not a valid status for stage &quot;Sales Generated Lead&quot;. If you are in SalesForce Lightning, please follow the Guidance for Success mentioned in the Lead path. Guidance for Success can be found by clicking on the arrow next to the Lead stages.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_Status_For_Stage_TAL</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
NOT(ISNEW()),
ISCHANGED(Core_Lead_Status__c),
OR(RecordType.Name = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;),
ISPICKVAL(Status, &quot;Tele Accepted Lead&quot;),
NOT( 		
		OR(                
			ISPICKVAL(Core_Lead_Status__c, &quot;Accepted&quot;), 
			ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;), 
			ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;),
			ISPICKVAL(Core_Lead_Status__c, &quot;Passed to Partner&quot;),
			ISPICKVAL(Core_Lead_Status__c, &quot;Unreachable&quot;)
		) 
	)			
)
)</errorConditionFormula>
        <errorDisplayField>Core_1st_Reminder__c</errorDisplayField>
        <errorMessage>Not a valid status for stage &quot;Tele Accepted Lead&quot;. If you are in Salesforce Lightning, please follow the Guidance for Success mentioned in the Lead path.  Guidance for Success can be found by clicking on the arrow next to the Lead stages.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_Status_For_Stage_TQL</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
NOT(ISNEW()),
ISCHANGED(Core_Lead_Status__c),
OR(RecordType.Name = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;),
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;),
NOT( 
		OR( 
		ISPICKVAL(Core_Lead_Status__c, &quot;Accepted&quot;), 
		ISPICKVAL(Core_Lead_Status__c, &quot;Rejected&quot;), 
		ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;),
                ISPICKVAL(Core_Lead_Status__c, &quot;Passed to Partner&quot;) 
		) 
	)		
)
)</errorConditionFormula>
        <errorMessage>Not a valid status for stage &quot;Tele Qualified Lead&quot;. If you are in Salesforce Lightning, please follow the Guidance for Success mentioned in the Lead path. Guidance for Success can be found by clicking on the arrow next to the Lead stages.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_To_SAL_Contact_NoOpp</fullName>
        <active>true</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
IsConverted, 
OR(RecordType.DeveloperName = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;),
ISPICKVAL(Status, &quot;Contact - No Opportunity&quot;),
NOT(ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;))
)
)</errorConditionFormula>
        <errorMessage>Lead can be converted with converted status as &quot;Contact - No Opportunity&quot; only when Lead is disqualified.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_To_Select_SAL_Disqualified</fullName>
        <active>true</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
IsConverted, 
OR(RecordType.DeveloperName = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;),
ISPICKVAL(Status, &quot;Sales Qualified Lead&quot;), 
ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;)
)
)</errorConditionFormula>
        <errorMessage>Disqualified Lead can be converted with converted status as &quot;Contact - No Opportunity&quot; only.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_lead_sub_status_for_SAL</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE, FALSE,
AND(
RecordType.DeveloperName = &quot;Lead&quot;,
OR(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;)),
AND(
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Qualified&quot;),
ISPICKVAL(PRIORVALUE(Core_Lead_Sub_Status__c), &quot;In Contact&quot;)),
ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Not Target Profile&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Not accepted by Sales&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Unreachable&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Already Engaged with Intel&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Rep Inactivity&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Not Interested&quot;)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_Sub_Status__c</errorDisplayField>
        <errorMessage>&quot;Invalid substatus selection. Allowed substatus for the data condition: Not target profile, Unreachable, Already Engaged with Intel, Not accepted by Sales, Not Interested or Rep Inactivity.&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_salelead_substatus_for_SAL</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE, FALSE,
AND(
RecordType.Name = &quot;Sales Lead&quot;,
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;), 
AND(
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Qualified&quot;),
ISPICKVAL(PRIORVALUE(Core_Lead_Sub_Status__c), &quot;In Contact&quot;)),
ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Not Target Profile&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Already Engaged with Intel&quot;),
ISPICKVAL(Core_Lead_Sub_Status__c, &quot;Rep Inactivity&quot;)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_Sub_Status__c</errorDisplayField>
        <errorMessage>&quot;Invalid substatus selection. Allowed substatus for the data condition: Not target profile,Already Engaged with Intel, or Rep Inactivity.&quot;</errorMessage>
    </validationRules>
