                    <fullName>Distributor/Channel</fullName>
                    <default>false</default>
                    <label>Distributor/Channel</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Age_of_Lead__c</fullName>
        <description>Field to determine the age of the lead.</description>
        <externalId>false</externalId>
        <formula>IF(IsConverted, ConvertedDate - DATEVALUE(CreatedDate), TODAY()- DATEVALUE(CreatedDate))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Age of Lead</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Alternate_Email__c</fullName>
        <description>Alternate Email</description>
        <externalId>false</externalId>
        <label>Alternate Email</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Ask_Sales_Score__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  Core_Ask_to_talk_to_Sales__c = TRUE, 5, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ask Sales Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Ask_to_talk_to_Sales__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Ask to talk to Engineering Support/Sales</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Cold_Contact_Approved__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>For specific approved lead sources, “cold” contacting is allowable in approaching prospective customers at the start of the sales process.   Refer to [legal.intel.com] privacy link to learn the approved sources before contacting.</inlineHelpText>
        <label>Cold-Contact Approved?</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Company_Size__c</fullName>
        <label>Company Size</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
