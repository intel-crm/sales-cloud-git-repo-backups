IF(Core_Stagnant_Lead_State_Time__c&gt;=2,&quot;More than 2 days&quot;,&quot;Within SLA&quot;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
