    <webLinks>
        <fullName>Core_Revive</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Revive</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT( &quot;/soap/ajax/36.0/connection.js&quot; )}
{!REQUIRESCRIPT(&quot;/soap/ajax/36.0/apex.js&quot;)};


function fixTime(time){
if(time &lt; 10) {time = &quot;0&quot; + time};
return time;
}

function fixDate(date){
var Month = fixTime(date.getMonth() + 1);
var Day = fixTime(date.getDate());
var UTC = date.toUTCString();
var Time = UTC.substring(UTC.indexOf(&apos;:&apos;)-2, UTC.indexOf(&apos;:&apos;)+6);
var Minutes = fixTime(date.getMinutes());
var Seconds = fixTime(date.getSeconds());
return date.getFullYear() + &quot;-&quot; + Month + &quot;-&quot; + Day + &quot;T&quot; + Time;
}
var leadtoUpdate = new sforce.SObject(&quot;Lead&quot;);
leadtoUpdate.Id = &quot;{!Lead.Id}&quot;;

if(&apos;{!Lead.Core_Lead_Status__c}&apos; != &apos;Rejected&apos; &amp;&amp; &apos;{!Lead.Core_Lead_Status__c}&apos; != &apos;Unreachable&apos; &amp;&amp; &apos;{!Lead.Core_Lead_Status__c}&apos; != &apos;Disqualified&apos;){
	alert(&apos;Leads can be revived only when they have the Lead Status as &quot;Rejected&quot;, &quot;Disqualified&quot; or &quot;Unreachable&quot;&apos;);
}

else if(&apos;{!Lead.Status}&apos; == &apos;Tele Accepted Lead&apos; &amp;&amp; &apos;{!Lead.Core_Lead_Status__c}&apos; == &apos;Unreachable&apos;){
leadtoUpdate.Core_Lead_Status__c = &quot;Accepted&quot;;
leadtoUpdate.Core_Unreachable_flag__c=false;
leadtoUpdate.Core_Exit_Date_TAL__c = null;
leadtoUpdate.Core_Lead_State__c = &apos;In Pursuit&apos;;
var today = new Date();
leadtoUpdate.Core_Unreachable_End_Date__c =fixDate(today);;
var result = sforce.connection.update( [leadtoUpdate] );

if ( result[0].getBoolean( &quot;success&quot; ) ) {
alert(&apos;Lead has been Revived Successfully.&apos;);
window.location.reload();
}
else {
alert( &quot;An error has occurred while updating lead &quot; + result[0].errors.message );
}
}
else if(&apos;{!Lead.Status}&apos; == &apos;Sales Accepted Lead&apos; &amp;&amp; &apos;{!Lead.Core_Lead_Status__c}&apos; == &apos;Unreachable&apos;){
leadtoUpdate.Core_Lead_Status__c = &quot;Accepted&quot;;
leadtoUpdate.Core_Unreachable_flag__c=false;
leadtoUpdate.Core_Exit_Date_SAL__c = null;
leadtoUpdate.Core_Lead_State__c = &apos;In Pursuit&apos;;
var today = new Date();
leadtoUpdate.Core_Unreachable_End_Date__c =fixDate(today);;
var result = sforce.connection.update( [leadtoUpdate] );

if ( result[0].getBoolean( &quot;success&quot; ) ) {
alert(&apos;Lead has been Revived Successfully.&apos;);
window.location.reload();
}
else {
alert( &quot;An error has occurred while updating lead &quot; + result[0].errors.message );
}

}
else if(&apos;{!Lead.Status}&apos; == &apos;Marketing Qualified Lead&apos; &amp;&amp; &apos;{!Lead.Core_Lead_Status__c}&apos; == &apos;Rejected&apos;){
leadtoUpdate.OwnerId =&quot;{!$User.Id}&quot;;
leadtoUpdate.Core_Lead_Sub_Status__c = null;
leadtoUpdate.status=&apos;Tele Accepted Lead&apos;;
leadtoUpdate.Core_Rejected_Flag__c = true;
leadtoUpdate.Core_Lead_Status__c = &apos;Accepted&apos;;
leadtoUpdate.Core_Lead_State__c = &apos;In Pursuit&apos;;
var today = new Date();
leadtoUpdate.Core_Exit_Date_MAQL__c=fixDate(today);;
//leadtoUpdate.Core_Lead_Revive_Date_Original__c =fixDate(today);;
 if(leadtoUpdate.Core_Lead_Revive_Date_Original__c == &apos;&apos;){
       leadtoUpdate.Core_Lead_Revive_Date_Original__c =fixDate(today);;
      }else{
       leadtoUpdate.Core_Lead_Revive_Date_Most_Recent__c=fixDate(today);;
     }
var result = sforce.connection.update( [leadtoUpdate] );

if ( result[0].getBoolean( &quot;success&quot; ) ) {
alert(&apos;Lead has been Revived Successfully.&apos;);
window.location.reload();
}
else {
alert( &quot;An error has occurred while updating lead &quot; + result[0].errors.message );
}

}
else if(&apos;{!Lead.Status}&apos; == &apos;Tele Accepted Lead&apos; &amp;&amp; &apos;{!Lead.Core_Lead_Status__c}&apos; == &apos;Disqualified&apos;){
leadtoUpdate.OwnerId =&quot;{!$User.Id}&quot;;
