        <fullName>Core_SQL_Lead_Coverage__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(IsConverted = True,ISPICKVAL(Status,&quot;Sales Qualified Lead&quot;)), Core_Locked_SQL_Coverage__c, 
IF(ISPICKVAL(Status,&quot;Sales Qualified Lead&quot;),(IF(ISBLANK (TEXT(Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT(Owner:User.Core_User_Coverage__c))),&apos;&apos;))</formula>
