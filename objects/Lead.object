    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_Lead_Check_State_On_Create</fullName>
        <active>true</active>
        <description>Validation rule to make sure that the Lead State is &apos;Open&apos; when a new lead is created.</description>
        <errorConditionFormula>AND
(
ISNEW(),
NOT(ISPICKVAL (Core_Lead_State__c, &quot;Open&quot;))
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_State__c</errorDisplayField>
        <errorMessage>Lead State should be &apos;Open&apos; for new lead.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Country_Required</fullName>
        <active>true</active>
        <description>Country required to save a Lead record</description>
        <errorConditionFormula>AND(
Country = &quot;&quot;,
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;
)</errorConditionFormula>
        <errorDisplayField>Country</errorDisplayField>
        <errorMessage>A Country value is required to save the record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Embargo_Country</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
AND($Profile.Name &lt;&gt; &quot;Integration&quot;),
OR(
ISPICKVAL(CountryCode,&quot;CUB&quot;),
ISPICKVAL(CountryCode,&quot;IRN&quot;),
ISPICKVAL(CountryCode,&quot;PRK&quot;),
ISPICKVAL(CountryCode,&quot;SDN&quot;),
ISPICKVAL(CountryCode,&quot;SYR&quot;)
)
)</errorConditionFormula>
        <errorDisplayField>Country</errorDisplayField>
        <errorMessage>If the County value equals an Embargo Country, the lead can not be created.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Rejection_Comment_Check</fullName>
        <active>true</active>
        <description>Rejection Comment is required if the Rejection Reasons are not &apos;Duplicate&apos; and &apos;Test Lead&apos;.</description>
        <errorConditionFormula>AND
(
  ISPICKVAL(Core_Lead_State__c, &quot;Rejected&quot;),
  NOT(ISPICKVAL(Core_Rejection__c, &quot;Duplicate&quot;)),
  NOT(ISPICKVAL(Core_Rejection__c, &quot;Test Lead&quot;)), 
  ISBLANK(Core_Rejection_Comments__c),
  $Profile.Name &lt;&gt; &quot;Integration&quot; 
)</errorConditionFormula>
        <errorDisplayField>Core_Rejection_Comments__c</errorDisplayField>
        <errorMessage>Please enter a value in the field Rejection Comments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND
(
AND(
  ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
  $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
  $Profile.Name &lt;&gt; &quot;Integration&quot; 
),
OR(
  ISBLANK(FirstName),
  ISBLANK(LastName),
  ISBLANK(Phone),
  ISBLANK(Title),
  ISPICKVAL(Core_Job_Function__c, &quot;&quot;),
  ISBLANK(Company),
  ISBLANK(Street),
  ISBLANK(City),
  ISBLANK(PostalCode),
  ISBLANK(Country),
  ISPICKVAL(Core_Current_Architecture__c, &quot;&quot;),
  ISPICKVAL(Core_Project_Timeframe__c, &quot;&quot;),
  ISPICKVAL(Core_Project_Phase__c, &quot;&quot;),
  ISPICKVAL(Core_Job_Function__c, &quot;&quot;),
  ISPICKVAL(Core_Project_Size__c, &quot;&quot;),
  ISNULL(Core_Product_Interest__c)
)
)</errorConditionFormula>
        <errorMessage>Please enter the Full name, Email, Phone, Title, Job Function, Company Name, Full Address and fields in the Lead Detail section prior to updating the Lead Stage field to the value &quot;Sales Accepted Lead&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Check_First_Name</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;,
ISBLANK(FirstName)
)</errorConditionFormula>
        <errorDisplayField>FirstName</errorDisplayField>
        <errorMessage>Please enter a value for First Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Check_Last_Name</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
