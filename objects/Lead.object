        <externalId>false</externalId>
        <formula>IF(( FLOOR(Core_PAL_Entry_Dt__c- CreatedDate) )== 0, (Core_PAL_Entry_Dt__c- CreatedDate)+1, (Core_PAL_Entry_Dt__c- CreatedDate))</formula>
        <label>Lead Response Time(Days)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
