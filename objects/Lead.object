NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
ISPICKVAL(PRIORVALUE(Status), &quot;Tele Qualified Lead&quot;),
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISNULL(Core_Product_Interest__c) 
),
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISNULL(Core_Product_Interest__c)
)))</errorConditionFormula>
        <errorDisplayField>Core_Product_Interest__c</errorDisplayField>
        <errorMessage>Please enter a value for Project Interest.</errorMessage>
