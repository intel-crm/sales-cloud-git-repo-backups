        <fullName>Core_Existing_Covered_Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Covered Account Name</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR 2 OR 3</booleanFilter>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>notEqual</operation>
                <value>CoMarketing, Direct Account, Intel Ultimate Account, Inactive Account</value>
            </filterItems>
            <filterItems>
                <field>$User.FirstName</field>
                <operation>equals</operation>
                <value>Salesforce</value>
            </filterItems>
            <filterItems>
                <field>$User.LastName</field>
                <operation>equals</operation>
                <value>System User</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Leads</relationshipLabel>
        <relationshipName>Leads</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
