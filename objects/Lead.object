    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Current_Architecture</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISPICKVAL(Core_Current_Architecture__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_Current_Architecture__c</errorDisplayField>
        <errorMessage>Please enter a value for Current Architecture.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Job_Function</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISPICKVAL (Core_Job_Function__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_Job_Function__c</errorDisplayField>
        <errorMessage>Please enter a value for Job Function.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Project_Interest</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISNULL(Core_Product_Interest__c) 
)</errorConditionFormula>
        <errorDisplayField>Core_Product_Interest__c</errorDisplayField>
        <errorMessage>Please enter a value for Project Interest.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Project_Phase</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISPICKVAL(Core_Project_Phase__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_Project_Phase__c</errorDisplayField>
        <errorMessage>Please enter a value for Project Phase.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Project_Size</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISPICKVAL(Core_Project_Size__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_Project_Size__c</errorDisplayField>
        <errorMessage>Please enter a value for Project Size.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Project_Timeframe</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISPICKVAL(Core_Project_Timeframe__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_Project_Timeframe__c</errorDisplayField>
        <errorMessage>Please enter a value for Project Timeframe.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_State_Province</fullName>
        <active>true</active>
        <description>Excluded the countries (52 of them) that do not have a State. Need to revisit this in future. There is a similar validation logic in the lead trigger, but is not working as expected (the logic does not work if the State is removed for an existing lead).</description>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;,
Country &lt;&gt; &apos;ABW&apos;,
Country &lt;&gt; &apos;AIA&apos;,
Country &lt;&gt; &apos;ALA&apos;,
Country &lt;&gt; &apos;ANT&apos;,
Country &lt;&gt; &apos;ASM&apos;,
Country &lt;&gt; &apos;ATA&apos;,
Country &lt;&gt; &apos;ATF&apos;,
Country &lt;&gt; &apos;BLM&apos;,
Country &lt;&gt; &apos;BMU&apos;,
Country &lt;&gt; &apos;BVT&apos;,
Country &lt;&gt; &apos;CCK&apos;,
Country &lt;&gt; &apos;COK&apos;,
Country &lt;&gt; &apos;CUW&apos;,
Country &lt;&gt; &apos;CXR&apos;,
Country &lt;&gt; &apos;CYM&apos;,
Country &lt;&gt; &apos;ESH&apos;,
Country &lt;&gt; &apos;FLK&apos;,
Country &lt;&gt; &apos;FRO&apos;,
Country &lt;&gt; &apos;GGY&apos;,
Country &lt;&gt; &apos;GIB&apos;,
Country &lt;&gt; &apos;GLP&apos;,
Country &lt;&gt; &apos;GUF&apos;,
Country &lt;&gt; &apos;GUM&apos;,
Country &lt;&gt; &apos;HKG&apos;,
Country &lt;&gt; &apos;HMD&apos;,
Country &lt;&gt; &apos;IMN&apos;,
Country &lt;&gt; &apos;IOT&apos;,
Country &lt;&gt; &apos;JEY&apos;,
Country &lt;&gt; &apos;MAC&apos;,
Country &lt;&gt; &apos;MAF&apos;,
Country &lt;&gt; &apos;MNP&apos;,
Country &lt;&gt; &apos;MSR&apos;,
Country &lt;&gt; &apos;MTQ&apos;,
Country &lt;&gt; &apos;MYT&apos;,
Country &lt;&gt; &apos;NCL&apos;,
Country &lt;&gt; &apos;NFK&apos;,
Country &lt;&gt; &apos;NIU&apos;,
Country &lt;&gt; &apos;PCN&apos;,
Country &lt;&gt; &apos;PRI&apos;,
Country &lt;&gt; &apos;PYF&apos;,
Country &lt;&gt; &apos;REU&apos;,
Country &lt;&gt; &apos;SCG&apos;,
Country &lt;&gt; &apos;SGS&apos;,
Country &lt;&gt; &apos;SJM&apos;,
Country &lt;&gt; &apos;SPM&apos;,
Country &lt;&gt; &apos;SXM&apos;,
Country &lt;&gt; &apos;TCA&apos;,
Country &lt;&gt; &apos;TKL&apos;,
Country &lt;&gt; &apos;VAT&apos;,
Country &lt;&gt; &apos;VGB&apos;,
Country &lt;&gt; &apos;VIR&apos;,
Country &lt;&gt; &apos;WLF&apos;,
ISBLANK( State )
)</errorConditionFormula>
        <errorMessage>Please  select a value for &quot;State/Province&quot;  from the available list</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Street</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISBLANK(Street)
)</errorConditionFormula>
        <errorDisplayField>Street</errorDisplayField>
        <errorMessage>Please enter a value for Street.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Zip</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_Integration_Profile_Name,
ISBLANK(PostalCode)
)</errorConditionFormula>
        <errorDisplayField>PostalCode</errorDisplayField>
        <errorMessage>Please enter a value for Zip/Postal Code.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Src_Req_If_Spcfic_Ld_Stg_Vlues</fullName>
        <active>true</active>
        <description>Lead Source value is required if field value is blank and Lead not created by a user with the Integration profile.</description>
        <errorConditionFormula>AND(
ISPICKVAL(LeadSource,&quot;&quot;),
$Profile.Name &lt;&gt; &quot;Integration&quot;,
NOT(CreatedBy.FirstName = &quot;Integration&quot;)
)</errorConditionFormula>
        <errorDisplayField>LeadSource</errorDisplayField>
        <errorMessage>Please enter a value for Lead Source.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Stage_Check_SQL</fullName>
        <active>true</active>
        <description>Validation rule to make sure that &apos;Sales Qualified Lead&apos; (SQL) is not selected before &quot;Sales Accepted Lead&quot;.</description>
        <errorConditionFormula>AND( 
ISPICKVAL(Status,&quot;Sales Qualified Lead&quot;), 
NOT(ISPICKVAL(PRIORVALUE(Status), &quot;Sales Accepted Lead&quot;))
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Please change status to &quot;Sales Accepted Lead&quot; before converting</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Stage_Check_TQL</fullName>
        <active>true</active>
        <description>Validation rule to make sure that &apos;Tele Qualified Lead&apos; (TQL) is not selected for a new record.</description>
        <errorConditionFormula>AND( 
ISNEW(), 
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;)
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>The Lead Stage &quot;Tele Qualified Lead&quot; cannot be selected for a new record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Stage_Check_UQL</fullName>
        <active>true</active>
        <description>Validation rule to make sure that &apos;Unqualified&apos; (UQL) is not selected for an existing record.</description>
        <errorConditionFormula>AND( 
NOT(ISNEW()), 
ISPICKVAL(Status, &quot;Unqualified&quot;),
NOT(ISPICKVAL(PRIORVALUE(Status), &quot;Unqualified&quot;))
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>The Lead Stage &quot;Unqualified&quot; cannot be selected for an existing record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LID__Check_CompanyId_Value</fullName>
        <active>true</active>
        <description>Throws an exception message if the company id contains non-numerics</description>
        <errorConditionFormula>AND(
	(LID__LinkedIn_Company_Id__c &lt;&gt; NULL),
	NOT(ISNUMBER(LID__LinkedIn_Company_Id__c))
)</errorConditionFormula>
        <errorDisplayField>LID__LinkedIn_Company_Id__c</errorDisplayField>
        <errorMessage>CompanyId should be a numeric value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>x_Core_Lead_MQL_Check</fullName>
        <active>false</active>
        <description>Cannot Manually change status to &quot;MQL&quot;</description>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),
CreatedBy.LastName &lt;&gt; &quot;Eloqua&quot;,
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
$Profile.Name &lt;&gt; &quot;Eloqua Integrator&quot; 
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>The Lead Stage &quot;Marketing Qualified Lead&quot; cannot be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>x_Core_Lead_SAL_Postal_Code</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISBLANK(PostalCode)
)</errorConditionFormula>
        <errorDisplayField>PostalCode</errorDisplayField>
        <errorMessage>Please enter a value for Postal Code.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>x_Core_Lead_SAL_Sales_Segment</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;, 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
ISPICKVAL(Core_Sales_Segment__c,&quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Segment__c</errorDisplayField>
        <errorMessage>Please enter a value for Sales Segment.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>x_Core_Lead_SQL_Check</fullName>
        <active>false</active>
        <description>Doesn&apos;t allow SQL before SAL and limts conversion on Unqualified and MQL</description>
        <errorConditionFormula>AND( 
ISPICKVAL(Status,&quot;Sales Qualified Lead&quot;), 
OR( 
ISPICKVAL(PRIORVALUE(Status), &quot;Unqualified&quot;), 
ISPICKVAL(PRIORVALUE(Status), &quot;Marketing Qualified Lead&quot;)))</errorConditionFormula>
        <errorMessage>Please change status to &quot;Sales Accepted Lead&quot; before converting</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>x_Core_Lead_Sales_Segment_Sales_SubSgmt</fullName>
        <active>false</active>
        <description>If Sales Segment equals Influencer then a value in Sales Sub-segment is required</description>
        <errorConditionFormula>AND(
ISPICKVAL(Core_Sales_Segment__c,&quot;Influencer&quot;), 
ISPICKVAL(Core_Sales_sub_Segment__c,&quot;&quot;),
$Profile.Name &lt;&gt; &quot;Integration&quot;
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_sub_Segment__c</errorDisplayField>
        <errorMessage>If Sales Segment equals &quot;Influencer&quot;, then a value for the field Sales Sub-segment is required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>x_Core_Lead_State_Check</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &quot;Integration&quot;,
ISCHANGED(Status), 
NOT(ISPICKVAL(PRIORVALUE(Core_Lead_State__c), &quot;Closed&quot;)), 
ISPICKVAL(Status, &quot;Sales Qualified Lead&quot;) 
)</errorConditionFormula>
        <errorDisplayField>Core_Lead_State__c</errorDisplayField>
        <errorMessage>Please ensure Lead State is Closed prior to changing Lead Stage to &quot;Sales Qualified Lead&quot;</errorMessage>
    </validationRules>
