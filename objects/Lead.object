        <customTabListAdditionalFields>Core_Lead_State__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>LEAD.LEAD_SOURCE</customTabListAdditionalFields>
        <customTabListAdditionalFields>LEAD.CREATED_DATE</customTabListAdditionalFields>
