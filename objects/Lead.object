var today = new Date();
//leadtoUpdate.Core_Lead_Revive_Date_Original__c =fixDate(today);;
  if(leadtoUpdate.Core_Lead_Revive_Date_Original__c == &apos;&apos;){
       leadtoUpdate.Core_Lead_Revive_Date_Original__c =fixDate(today);;
      }else{
       leadtoUpdate.Core_Lead_Revive_Date_Most_Recent__c=fixDate(today);;
     }
var result = sforce.connection.update( [leadtoUpdate] );

if ( result[0].getBoolean( &quot;success&quot; ) ) {
alert(&apos;Lead has been Revived Successfully.&apos;);
window.location.reload();
}
else {
alert( &quot;An error has occurred while updating lead &quot; + result[0].errors.message );
}

}
else if(&apos;{!Lead.Status}&apos; == &apos;Tele Qualified Lead&apos; &amp;&amp; &apos;{!Lead.Core_Lead_Status__c}&apos; == &apos;Rejected&apos;){
leadtoUpdate.OwnerId =&quot;{!$User.Id}&quot;;
leadtoUpdate.Core_Lead_Sub_Status__c = null;
leadtoUpdate.Core_Rejected_Flag__c = true;
leadtoUpdate.Core_Lead_Status__c = &apos;Accepted&apos;;
leadtoUpdate.Core_Lead_State__c = &apos;In Pursuit&apos;;
leadtoUpdate.status=&apos;Tele Accepted Lead&apos;;
leadtoUpdate.Core_Entrance_Date_TQL__c = null;
leadtoUpdate.Core_Exit_Date_TQL__c = null;
leadtoUpdate.Core_Exit_Date_TAL__c =null;
var today = new Date();
leadtoUpdate.Core_Entrance_Date_TAL__c=fixDate(today);;
leadtoUpdate.Core_Entrance_Date_TAP__c=fixDate(today);;
//leadtoUpdate.Core_Lead_Revive_Date_Original__c =fixDate(today);;
 if(leadtoUpdate.Core_Lead_Revive_Date_Original__c == &apos;&apos;){
       leadtoUpdate.Core_Lead_Revive_Date_Original__c =fixDate(today);;
      }else{
       leadtoUpdate.Core_Lead_Revive_Date_Most_Recent__c=fixDate(today);;
     }

var result = sforce.connection.update( [leadtoUpdate] );

if ( result[0].getBoolean( &quot;success&quot; ) ) {
alert(&apos;Lead has been Revived Successfully.&apos;);
window.location.reload();
}
else {
alert( &quot;An error has occurred while updating lead &quot; + result[0].errors.message );
}

}
else if(&apos;{!Lead.Status}&apos; == &apos;Sales Accepted Lead&apos; &amp;&amp; &apos;{!Lead.Core_Lead_Status__c}&apos; == &apos;Disqualified&apos;){
leadtoUpdate.OwnerId =&quot;{!$User.Id}&quot;;
leadtoUpdate.Core_Lead_Sub_Status__c = null;
leadtoUpdate.Core_Rejected_Flag__c = true;
leadtoUpdate.Core_Lead_Status__c = &apos;Accepted&apos;;
leadtoUpdate.Core_Lead_State__c = &apos;In Pursuit&apos;;
leadtoUpdate.status=&apos;Tele Accepted Lead&apos;;
leadtoUpdate.Core_Entrance_Date_TQL__c = null;
leadtoUpdate.Core_Exit_Date_TQL__c = null;
leadtoUpdate.Core_Exit_Date_TAL__c =null;
leadtoUpdate.Core_Entrance_Date_SAL__c =null;
leadtoUpdate.Core_Exit_Date_SAL__c= null;
var today = new Date();
leadtoUpdate.Core_Entrance_Date_TAL__c=fixDate(today);;
leadtoUpdate.Core_Entrance_Date_TAP__c=fixDate(today);;
//leadtoUpdate.Core_Lead_Revive_Date_Original__c =fixDate(today);;
 if(leadtoUpdate.Core_Lead_Revive_Date_Original__c == &apos;&apos;){
       leadtoUpdate.Core_Lead_Revive_Date_Original__c =fixDate(today);;
      }else{
       leadtoUpdate.Core_Lead_Revive_Date_Most_Recent__c=fixDate(today);;
     }


var result = sforce.connection.update( [leadtoUpdate] );

if ( result[0].getBoolean( &quot;success&quot; ) ) {
alert(&apos;Lead has been Revived Successfully.&apos;);
window.location.reload();
}
else {
