    <fields>
        <fullName>Core_SAL_Count__c</fullName>
        <description>SAL Count</description>
        <externalId>false</externalId>
        <formula>IF( ISBLANK( Core_Entrance_Date_SAL__c),0,1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>SAL Count</inlineHelpText>
        <label>SAL Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_SAL_Email_Trigger_Date__c</fullName>
        <label>SAL Email Trigger Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_SAL_Four_Weeks_Datetime__c</fullName>
        <formula>IF(
AND(Days__c=true,TEXT(Status) = &quot;Sales Accepted Lead&quot;,TEXT(Core_Lead_Status__c) = &quot;Accepted&quot;,NOT(ISBLANK(Core_Entrance_Date_SAL__c))),
Core_Entrance_Date_SAL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_SAL__c) - DATE(1900,01,07), 7 ), 1,8,2,8,3,8,4,8,5,8, 0,6, 6, 7, 0) + 21 
,null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>SLA 4 business days</inlineHelpText>
        <label>SAL Four Weeks Datetime</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_SAL_Four_Weeks_Weekend_Calculation__c</fullName>
        <formula>IF(AND(Days__c=false,NOT(OR (ISPICKVAL(Core_Lead_Status__c,&quot;Opportunity&quot;),ISPICKVAL(Core_Lead_Status__c,&quot;Disqualified&quot;), 
ISPICKVAL(Core_Lead_Status__c,&quot;Passed to Partner&quot;),ISPICKVAL(Core_Lead_Status__c,&quot;Unreachable&quot;))) , ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_SAL__c))), 
DATETIMEVALUE(TEXT(DATEVALUE(Core_Entrance_Date_SAL__c) + CASE(MOD( DATEVALUE(Core_Entrance_Date_SAL__c ) - DATE(1900,01,07), 7 ), 1,8,2,8,3,8,4,8,5,8, 0,6, 6, 7, 0) + 21)+&quot; 7:59:00&quot;),null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SAL Four Weeks Weekend Calculation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_SAL_Lead_Coverage__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Status,&apos;Sales Accepted Lead&apos;), (IF(ISBLANK (TEXT(Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT(Owner:User.Core_User_Coverage__c))), Core_Locked_SAL_Coverage__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SAL Lead Coverage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
