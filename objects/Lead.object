    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_Backward_Movement_Partner_Lead</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
ISCHANGED(Core_Lead_Status__c), 
OR( 
AND( 
RecordType.Name = &quot;Partner Lead&quot;, 
OR(Text(Core_Lead_Status__c) = &quot;New&quot;, Text(Core_Lead_Status__c) = &quot;Contacted&quot;, Text(Core_Lead_Status__c) =&quot;Accepted&quot;), 
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Qualified&quot;) 
), 
AND( 
RecordType.Name = &quot;Partner Lead&quot;, 
OR(Text(Core_Lead_Status__c) = &quot;New&quot;, Text(Core_Lead_Status__c) = &quot;Accepted&quot;), 
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Contacted&quot;)  
), 

AND( 
RecordType.Name = &quot;Partner Lead&quot;, 
Text(Core_Lead_Status__c) = &quot;New&quot;, 
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Accepted&quot;)  
)
 
), 
$Profile.Name &lt;&gt; &quot;System Administrator&quot; 
) 
)</errorConditionFormula>
        <errorMessage>Cannot move Lead to a previous status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_BulkClaim_Check_Partner_Lead</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name != &quot;Partner Lead&quot;,
ISCHANGED(Core_Partner_Lead_Owner__c)

)
)</errorConditionFormula>
        <errorMessage>This capability is available for Partner Leads only.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Cannot_Change_Accepted_To_New_MAQL</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
ISCHANGED(Core_Lead_Status__c),
NOT(ISNEW()),
RecordType.DeveloperName = &quot;Lead&quot;,
ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;New&quot;), 
OR(
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Accepted&quot;),
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Qualified&quot;)
),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;	
)
)</errorConditionFormula>
        <errorMessage>Cannot change Lead status from “Accepted” or “Qualified” to “New”.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Cannot_Change_On_Reject</fullName>
        <active>true</active>
        <description>Can not change the lead  or claim on Reject.</description>
        <errorConditionFormula>IF(
    $Setup.Core_Opp_Bypass_Validation_Rule__c = TRUE,
    FALSE,
    AND(
        NOT(ISNEW()),
        RecordType.Name = &apos;Partner Lead&apos;,
        ISCHANGED(Core_Lead_State__c),
        TEXT(PRIORVALUE(Core_Lead_State__c)) = &quot;Terminated&quot;,

        OR(
            ISPICKVAL(Core_Lead_State__c, &quot;Unclaimed&quot;),
            ISPICKVAL(Core_Lead_State__c, &quot;In Pursuit&quot;)
        ),

        NOT(ISCHANGED(Core_Lead_Status__c)),
        NOT(ISCHANGED(Core_Lead_State_Change_Date_Time__c)),
        NOT(ISCHANGED(Core_Lead_Stage_Change_Date_Time__c)),

        $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
        NOT($Setup.Core_Validation_Bypass_for_Flow__c.Bypass__c)
    )
)</errorConditionFormula>
        <errorMessage>This Lead has already been marked as “Rejected” and cannot be claimed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Cannot_Move_On_Reject</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
    $Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,
    FALSE,
    AND(
        RecordType.Name = &apos;Partner Lead&apos;,
        NOT(ISNEW()),
        ISCHANGED(Core_Lead_State__c),
        TEXT(PRIORVALUE(Core_Lead_State__c)) = &quot;Terminated&quot;,
        OR(
            ISPICKVAL(Core_Lead_State__c, &quot;Unclaimed&quot;),
            ISPICKVAL(Core_Lead_State__c, &quot;In Pursuit&quot;)
        ),
        $Profile.Name &lt;&gt; &quot;System Administrator&quot;
    )
)</errorConditionFormula>
        <errorDisplayField>Core_1st_Reminder__c</errorDisplayField>
        <errorMessage>This Lead has been “Rejected” and cannot progress further.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Cannot_Skip_Stage_IF_Disqualified</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
	$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
	AND( 
		
		ISCHANGED(Status), 
		RecordType.Name = &quot;Sales Lead&quot;,
ISPICKVAL(PRIORVALUE(Status), &quot;Sales Generated Lead&quot;),
ISPICKVAL(Status,&quot;Sales Qualified Lead&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;)
	)	
)</errorConditionFormula>
        <errorMessage>Cannot bypass stage if the Lead Status is &quot;Disqualified”.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Cannot_Skip_Stage_IF_Rejected</fullName>
        <active>false</active>
        <errorConditionFormula>IF(
	$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
	AND( 
		
		ISCHANGED(Status), 
		RecordType.Name = &quot;Lead&quot;,
		ISPICKVAL(PRIORVALUE(Status), &quot;Marketing Qualified Lead&quot;),
		ISPICKVAL(Status,&quot;Sales Accepted Lead&quot;),
		ISPICKVAL(Core_Lead_Status__c, &quot;Rejected&quot;)
	)	
)</errorConditionFormula>
        <errorDisplayField>Core_1st_Reminder__c</errorDisplayField>
        <errorMessage>Cannot bypass stage if the Lead Status is &quot;Rejected&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Cannot_terminatelead_when_unclaimed</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName = &quot;Lead&quot;,
ISPICKVAL(Core_Lead_State__c ,&quot;Unclaimed&quot;),
OR(
  ISPICKVAL(Core_Lead_Status__c, &quot;Disqualified&quot;)
)
)
)</errorConditionFormula>
        <errorMessage>Lead cannot be disqualified when the Lead Status is New.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Backward_Stage_Movement</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
OR(
AND(
ISCHANGED(Status),
AND(
RecordType.DeveloperName = &quot;Lead&quot;,
Text(Status) = &quot;Marketing Qualified Lead&quot;,
ISPICKVAL(PRIORVALUE(Status), &quot;Sales Accepted Lead&quot;) ,
Core_Rejected_Flag__c = false
),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;
),
AND(
ISCHANGED(Status),
AND(
RecordType.Name = &quot;Sales Lead&quot;,
Text(Status) = &quot;Sales Generated Lead&quot;,
ISPICKVAL(PRIORVALUE(Status), &quot;Sales Accepted Lead&quot;) ,
Core_Rejected_Flag__c = false
),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;
))
)</errorConditionFormula>
        <errorMessage>Cannot move Lead to a previous stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Contact_Est_at_Qualified</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
RecordType.Name = &apos;Partner Lead&apos;, 
ISCHANGED(Core_Lead_Contact_Estb_Dt__c), 
PRIORVALUE(Core_Lead_Contact_Estb_Dt__c)=True, 
Core_Lead_Contact_Estb_Dt__c=False, 
ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;), 
$Profile.Name &lt;&gt; &quot;System Administrator&quot; 
)	
)</errorConditionFormula>
        <errorMessage>“Contact Established” cannot be un-checked since this Lead is marked as “Qualified”.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Contact_Estrablishment_On_PAL</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
RecordType.Name = &apos;Partner Lead&apos;, 
OR(ISCHANGED(Core_Lead_Status__c), 
ISCHANGED(Status)), 
Core_Lead_Contact_Estb_Dt__c = False, 
ISPICKVAL(PRIORVALUE(Core_Lead_Status__c), &quot;Contacted&quot;), 
ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;), 
$Profile.Name &lt;&gt; &quot;System Administrator&quot; 
)	
)</errorConditionFormula>
        <errorMessage>Please click the “Contact Established” checkbox prior to changing status to “Qualified”</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Lead_Stage_Skip</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(Status),
RecordType.DeveloperName = &quot;Lead&quot;,
AND(
ISPICKVAL(PRIORVALUE(Status), &quot;Marketing Qualified Lead&quot;),
ISPICKVAL(Status,&quot;Sales Qualified Lead&quot;)
)
)
)</errorConditionFormula>
        <errorMessage>Cannot bypass stage.  Please select the next stage in the Lead path.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Stage_for_Eloqua_New_Lead</fullName>
        <active>false</active>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND
(
ISNEW(),
RecordType.DeveloperName = &quot;Lead&quot;,
NOT(ISCLONE()),
OR(NOT(ISPICKVAL (Core_Lead_Status__c, &quot;New&quot;)),
AND(
NOT(ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;)),
NOT($Profile.Name = &quot;Sales Rep-CW&quot;))
)))</errorConditionFormula>
        <errorDisplayField>Core_1st_Reminder__c</errorDisplayField>
        <errorMessage>To create a lead with record type “Lead”, please ensure that Lead Stage= &quot;Marketing Qualified Lead&quot; , Lead Status= “New”.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Stage_for_Marketo_New_Lead</fullName>
        <active>true</active>
        <description>Allow only MEL or MQL stage while creating a Marketing Lead.</description>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND
(
ISNEW(),
RecordType.DeveloperName = &quot;Lead&quot;,
NOT(ISCLONE()),
OR(NOT(ISPICKVAL (Core_Lead_Status__c, &quot;New&quot;)),
AND(
NOT(ISPICKVAL(Status, &quot;Marketing Engaged Lead&quot;)),
NOT(ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;)),
NOT($Profile.Name = &quot;Sales Rep-CW&quot;))
)))</errorConditionFormula>
        <errorMessage>To create a lead with record type “Lead”, please ensure that Lead Stage= Marketing Engaged Lead/ Marketing Qualified Lead, Lead Status= “New”.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Status_Accepted_PriorTo_SAL</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name = &quot;Sales Lead&quot;,
ISCHANGED(Status), 
ISPICKVAL(PRIORVALUE(Status), &quot;Sales Generated Lead&quot;),
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
NOT(ISPICKVAL(Core_Lead_Status__c, &quot;Accepted&quot;)),
NOT(ISPICKVAL(Core_Lead_Sub_Status__c , &quot;In Contact&quot;))
))</errorConditionFormula>
        <errorMessage>Please ensure Lead Status is &quot;Accepted&quot; and Lead Sub Status is &quot;In Contact&quot; prior to changing Lead stage to &quot;Sales Accepted Lead”.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Status_Accepted_PriorTo_TAL</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name = &quot;Lead&quot;,
ISCHANGED(Status),
ISPICKVAL(PRIORVALUE(Status), &quot;Marketing Qualified Lead&quot;), 
ISPICKVAL(Status, &quot;Tele Accepted Lead&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Status__c, &quot;New&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Accepted&quot;)
))))</errorConditionFormula>
        <errorMessage>Please ensure Lead status is &quot;New/Accepted&quot; prior to changing Lead stage to &quot;Tele Accepted Lead&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Status_Qualified_PriorTo_SAL</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName = &quot;Lead&quot;,
ISCHANGED(Status),
ISPICKVAL(PRIORVALUE(Status), &quot;Marketing Qualified Lead&quot;),
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
OR(
NOT(ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;)),
NOT(ISPICKVAL(Core_Lead_Sub_Status__c , &quot;In Contact&quot;)))
))</errorConditionFormula>
        <errorMessage>Please ensure Lead Status is &quot;Qualified&quot; and Lead Sub Status is &quot;In Contact&quot; prior to changing Lead stage to &quot;Sales Accepted Lead”.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Status_Qualified_Prior_TQL</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
OR(RecordType.Name = &quot;Lead&quot;, RecordType.Name = &quot;Sales Lead&quot;),
ISCHANGED(Status),
ISPICKVAL(PRIORVALUE(Status), &quot;Tele Accepted Lead&quot;),
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;),
NOT(
OR(
ISPICKVAL(Core_Lead_Status__c, &quot;Accepted&quot;),
ISPICKVAL(Core_Lead_Status__c, &quot;Qualified&quot;)
))))</errorConditionFormula>
        <errorMessage>Please ensure Lead status is &quot;Qualified/Accepted&quot; prior to changing Lead stage to &quot;Tele Qualified Lead&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Contact_Estrablished_Validate</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
RecordType.Name = &apos;Partner Lead&apos;, 
ISCHANGED(Core_Lead_Contact_Estb_Dt__c), 
PRIORVALUE(Core_Lead_Contact_Estb_Dt__c)=False, 
Core_Lead_Contact_Estb_Dt__c=True, 
NOT(ISPICKVAL(Core_Lead_Status__c, &quot;Contacted&quot;)), 
$Profile.Name &lt;&gt; &quot;System Administrator&quot; 
)	
)</errorConditionFormula>
        <errorMessage>Please change Lead Status to “Contacted” prior to clicking the “Contact Established” checkbox.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Disposition_for_PLCL_Status_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF( $Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT (ISNEW()),
(ISPICKVAL(Core_Lead_Status__c, &apos;Dispositioned for Partner Lead Pilot&apos;)),
NOT(OR($Profile.Name = &apos;System Administrator&apos;,
$Permission.Lead_Bypass_Permission,
$Profile.Name = &apos;Core Integration&apos;,
$Profile.Name = &apos;IT Admin&apos;
)
)
)
)</errorConditionFormula>
        <errorMessage>Lead Status is Disposition for PLCL , Not allowed to edit</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Country_Required</fullName>
        <active>true</active>
        <description>Country required to save a Lead record</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Core_Prospect__c = null,
Country = &quot;&quot;,
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;,
NOT(ISPICKVAL(LeadSource,&quot;IDC Credit Request&quot;))
)
)</errorConditionFormula>
        <errorDisplayField>Country</errorDisplayField>
        <errorMessage>A Country value is required to save the record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Embargo_Country</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
AND($Profile.Name &lt;&gt; &quot;Integration&quot;),
OR(
ISPICKVAL(CountryCode,&quot;CUB&quot;),
ISPICKVAL(CountryCode,&quot;IRN&quot;),
ISPICKVAL(CountryCode,&quot;PRK&quot;),
ISPICKVAL(CountryCode,&quot;SDN&quot;),
ISPICKVAL(CountryCode,&quot;SYR&quot;)
)
)</errorConditionFormula>
        <errorDisplayField>Country</errorDisplayField>
        <errorMessage>If the County value equals an Embargo Country, the lead can not be created.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Owner_Edit_Field</fullName>
        <active>true</active>
        <description>Contact Established – Engaged field - Should be editable by the Lead owner only</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(Core_Contact_Established_Engaged__c),
$User.Id &lt;&gt; OwnerId,
$Profile.Name &lt;&gt;&quot;System Administrator&quot;,
$Profile.Name &lt;&gt;&quot;IT Admin&quot;,
$Profile.Name &lt;&gt;&quot;Data Ops&quot;
))</errorConditionFormula>
        <errorDisplayField>Core_Contact_Established_Engaged__c</errorDisplayField>
        <errorMessage>Should be editable by the Lead owner only</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_Rejection_Comment_Check</fullName>
        <active>true</active>
        <description>Rejection Comment is required if the Rejection Reasons are not &apos;Duplicate&apos; and &apos;Test Lead&apos;.</description>
        <errorConditionFormula>AND
(
  ISPICKVAL(Core_Lead_State__c, &quot;Rejected&quot;),
  NOT(ISPICKVAL(Core_Rejection__c, &quot;Duplicate&quot;)),
  NOT(ISPICKVAL(Core_Rejection__c, &quot;Test Lead&quot;)), 
  ISBLANK(Core_Rejection_Comments__c),
  $Profile.Name &lt;&gt; &quot;Integration&quot; 
)</errorConditionFormula>
        <errorDisplayField>Core_Rejection_Comments__c</errorDisplayField>
        <errorMessage>Please enter a value in the field Rejection Comments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Check</fullName>
        <active>false</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND
(
AND(
  ISPICKVAL(PRIORVALUE(Status), &quot;Tele Accepted Lead&quot;), 
  ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;), 
  $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
  $Profile.Name &lt;&gt; &quot;Integration&quot; 
),
OR(
  ISBLANK(FirstName),
  ISBLANK(LastName),
  ISBLANK(Phone),
  ISBLANK(Title),
  ISBLANK(Company),
  ISBLANK(Street),
  ISBLANK(City),
  ISBLANK(PostalCode),
  ISBLANK(Country),
  ISPICKVAL(Core_Current_Architecture__c, &quot;&quot;),
  ISPICKVAL(Core_Project_Timeframe__c, &quot;&quot;),
  ISPICKVAL(Core_Project_Phase__c, &quot;&quot;),
  ISPICKVAL(Core_Project_Size__c, &quot;&quot;),
  ISNULL(Core_Product_Interest__c)
)
)
)</errorConditionFormula>
        <errorMessage>Please enter the Full name, Email, Phone, Title, Company Name, Full Address and fields in the BANT Qualification section prior to updating the Lead Stage field to the value &quot;Tele Qualified Lead&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Check_First_Name</fullName>
        <active>false</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE, FALSE,
OR(
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
ISPICKVAL(PRIORVALUE(Status), &quot;Tele Accepted Lead&quot;),
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;,
ISBLANK(FirstName)
),
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
ISPICKVAL(PRIORVALUE(Status), &quot;Tele Qualified Lead&quot;),
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;,
ISBLANK(FirstName)
),
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;,
ISBLANK(FirstName),
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;)
)))</errorConditionFormula>
        <errorDisplayField>FirstName</errorDisplayField>
        <errorMessage>Please enter a value for First Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Check_Last_Name</fullName>
        <active>false</active>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(RecordType.DeveloperName = &quot;Partner_Lead&quot;),
ISPICKVAL(PRIORVALUE(Status), &quot;Tele Accepted Lead&quot;),
ISPICKVAL(Status, &quot;Tele Qualified Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;,
ISBLANK(LastName)
)
)</errorConditionFormula>
        <errorDisplayField>LastName</errorDisplayField>
        <errorMessage>Please enter a value for Last Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lead_SAL_Check_Phone</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Sales Accepted Lead&quot;),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;,
ISBLANK(Phone)
)</errorConditionFormula>
        <errorDisplayField>Phone</errorDisplayField>
