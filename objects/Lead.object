    <fields>
        <fullName>Core_Project_Phase_Score__c</fullName>
        <externalId>false</externalId>
        <formula>if ( ISPICKVAL(  Core_Project_Phase__c , &quot;Explore&quot;), 1, 
if ( ISPICKVAL( Core_Project_Phase__c, &quot;Planning&quot;), 2, 
if ( ISPICKVAL( Core_Project_Phase__c, &quot;Design&quot;), 3, 
if( ISPICKVAL( Core_Project_Phase__c, &quot;Purchase&quot;), 5, 
0))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Project Phase Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Project_Phase__c</fullName>
        <label>Project Phase</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Explore</fullName>
                    <default>false</default>
                    <label>Explore</label>
                </value>
                <value>
                    <fullName>Planning</fullName>
                    <default>false</default>
                    <label>Planning</label>
                </value>
                <value>
                    <fullName>Design</fullName>
                    <default>false</default>
                    <label>Design</label>
                </value>
                <value>
                    <fullName>Purchase</fullName>
                    <default>false</default>
                    <label>Purchase</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Project_Size_Score__c</fullName>
        <externalId>false</externalId>
        <formula>if ( ISPICKVAL(  Core_Project_Size__c , &quot;&gt;$10,000,000&quot;), 5, 
if ( ISPICKVAL( Core_Project_Size__c, &quot;$10,000,000 - $5,000,000&quot;), 3, 
if ( ISPICKVAL( Core_Project_Size__c, &quot;$5,000,000 - $1,000,0000&quot;), 2, 
if( ISPICKVAL( Core_Project_Size__c, &quot;&lt;$1,000,000&quot;), 1, 
0))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Project Size Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Project_Size__c</fullName>
        <label>Project Size</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>&gt;$10,000,000</fullName>
                    <default>false</default>
                    <label>&gt;$10,000,000</label>
                </value>
                <value>
                    <fullName>$10,000,000 - $5,000,000</fullName>
                    <default>false</default>
                    <label>$10,000,000 - $5,000,000</label>
                </value>
                <value>
                    <fullName>$5,000,000 - $1,000,000</fullName>
                    <default>false</default>
                    <label>$5,000,000 - $1,000,000</label>
                </value>
                <value>
                    <fullName>&lt;$1,000,000</fullName>
                    <default>false</default>
                    <label>&lt;$1,000,000</label>
                </value>
                <value>
                    <fullName>&lt;$100,000</fullName>
                    <default>false</default>
                    <label>&lt;$100,000</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Project_Timeframe_Score__c</fullName>
        <externalId>false</externalId>
        <formula>if ( ISPICKVAL(  Core_Project_Timeframe__c , &quot;0-6 Months&quot;), 5, 
if ( ISPICKVAL( Core_Project_Timeframe__c, &quot;6-12 Months&quot;), 3, 
if ( ISPICKVAL( Core_Project_Timeframe__c, &quot;12-24 Months&quot;), 1, 
if( ISPICKVAL( Core_Project_Timeframe__c, &quot;&gt;24 Months&quot;), 0, 
 0))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Project Timeframe Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Project_Timeframe__c</fullName>
        <label>Project Timeframe</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
