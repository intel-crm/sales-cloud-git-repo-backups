        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Business_Day_Calculation__c</fullName>
        <description>Business day calculation</description>
        <formula>IF( AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Hot&quot;) ,ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_MAQL__c))) , 
Core_Entrance_Date_MAQL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_MAQL__c) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,0,5,2, 0,0, 6, 1, 0) +2, 
IF( AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Warm&quot;) ,ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_MAQL__c))), 
Core_Entrance_Date_MAQL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_MAQL__c) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,2,5,2, 0,0, 6, 1, 0) + 3, 
IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Cold&quot;) ,ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_MAQL__c))), 
Core_Entrance_Date_MAQL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_MAQL__c) - DATE(1900,01,07), 7 ), 1,0,2,2,3,2,4,2,5,2, 0,0, 6, 1, 0) + 5, 
IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Hot&quot;) ,ISPICKVAL(Status,&quot;Tele Accepted Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_TAL__c))), 
Core_Entrance_Date_TAL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_TAL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,0,5,2, 0,0, 6, 1, 0) +2, 
IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Warm&quot;) ,ISPICKVAL(Status,&quot;Tele Accepted Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_TAL__c))), 
Core_Entrance_Date_TAL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_TAL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,2,5,2, 0,0, 6, 1, 0) + 3, 
IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Cold&quot;) ,ISPICKVAL(Status,&quot;Tele Accepted Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_TAL__c))), 
Core_Entrance_Date_TAL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_TAL__c ) - DATE(1900,01,07), 7 ), 1,0,2,2,3,2,4,2,5,2, 0,0, 6, 1, 0) + 5, 
IF(AND(Core_Having_Tasks__c=false, ISPICKVAL(Status,&quot;Tele Qualified Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_TQL__c))),
Core_Entrance_Date_TQL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_TQL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,0,5,2, 0,0, 6, 1, 0) +2, 
IF(AND(ISPICKVAL(Status,&quot;Sales Accepted Lead&quot;),Core_Having_Tasks__c=false,NOT(ISBLANK(Core_Entrance_Date_SAL__c))), 
Core_Entrance_Date_SAL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_SAL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,0,5,2, 0,0, 6, 1, 0) +2, 
null))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Business day calculation</inlineHelpText>
        <label>Business Day Calculation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Cold_Contact_Approved__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>For specific approved lead sources, “cold” contacting is allowable in approaching prospective customers at the start of the sales process.   Refer to [legal.intel.com] privacy link to learn the approved sources before contacting.</inlineHelpText>
        <label>Cold-Contact Approved?</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
