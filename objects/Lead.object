    <fields>
        <fullName>Core_WeekEnd_SLA_Calculation__c</fullName>
        <formula>IF( 
AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Hot&quot;) ,ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_MAQL__c))) , 
DATETIMEVALUE(TEXT(DATEVALUE(Core_Entrance_Date_MAQL__c) + CASE(MOD( DATEVALUE(Core_Entrance_Date_MAQL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,0,5,2, 0,0, 6, 1, 0) +3)+&quot; 7:59:00&quot;), 
IF( AND(ISPICKVAL(Core_Lead_Priority__c, &quot;Warm&quot;) ,ISPICKVAL(Status, &quot;Marketing Qualified Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_MAQL__c))) , 
DATETIMEVALUE(TEXT(DATEVALUE(Core_Entrance_Date_MAQL__c) + CASE(MOD( DATEVALUE(Core_Entrance_Date_MAQL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,2,5,2, 0,0, 6, 1, 0) + 4)+&quot; 7:59:00&quot;), 
IF( AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Cold&quot;) ,ISPICKVAL(Status,&quot;Marketing Qualified Lead&quot;), NOT(ISBLANK(Core_Entrance_Date_MAQL__c))), 
DATETIMEVALUE(TEXT(DATEVALUE(Core_Entrance_Date_MAQL__c) + CASE(MOD( DATEVALUE(Core_Entrance_Date_MAQL__c ) - DATE(1900,01,07), 7 ), 1,0,2,2,3,2,4,2,5,2, 0,0, 6, 1, 0) + 6)+&quot; 7:59:00&quot;), 
IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Hot&quot;) ,ISPICKVAL(Status,&quot;Tele Accepted Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_TAL__c))), 
DATETIMEVALUE(TEXT(DATEVALUE(Core_Entrance_Date_TAL__c) + CASE(MOD( DATEVALUE(Core_Entrance_Date_TAL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,0,5,2, 0,0, 6, 1, 0) +3)+&quot; 7:59:00&quot;), 
IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Warm&quot;) ,ISPICKVAL(Status,&quot;Tele Accepted Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_TAL__c))), 
DATETIMEVALUE(TEXT(DATEVALUE(Core_Entrance_Date_TAL__c) + CASE(MOD( DATEVALUE(Core_Entrance_Date_TAL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,2,5,2, 0,0, 6, 1, 0) + 4)+&quot; 7:59:00&quot;), 
IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Cold&quot;) ,ISPICKVAL(Status,&quot;Tele Accepted Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_TAL__c))), 
DATETIMEVALUE(TEXT(DATEVALUE(Core_Entrance_Date_TAL__c) + CASE(MOD( DATEVALUE(Core_Entrance_Date_TAL__c ) - DATE(1900,01,07), 7 ), 1,0,2,2,3,2,4,2,5,2, 0,0, 6, 1, 0) + 6)+&quot; 7:59:00&quot;), 
IF(AND(Core_Having_Tasks__c=false, ISPICKVAL(Status,&quot;Tele Qualified Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_TQL__c))), 
DATETIMEVALUE(TEXT(DATEVALUE(Core_Entrance_Date_TQL__c) + CASE(MOD( DATEVALUE(Core_Entrance_Date_TQL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,0,5,2, 0,0, 6, 1, 0) +3)+&quot; 7:59:00&quot;), 
IF(AND(ISPICKVAL(Status,&quot;Sales Accepted Lead&quot;),Core_Having_Tasks__c=false,NOT(ISBLANK(Core_Entrance_Date_SAL__c))),
DATETIMEVALUE(TEXT(DATEVALUE(Core_Entrance_Date_SAL__c) + CASE(MOD( DATEVALUE(Core_Entrance_Date_SAL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,0,5,2, 0,0, 6, 1, 0) +3)+&quot; 6:59:00&quot;) 
,null))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>WeekEnd SLA Calculation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
