        <fullName>Core_Meeting_Due_Date__c</fullName>
        <description>Meeting Due Date for SLA enforcement</description>
        <label>Meeting Due Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Meeting_date_Weekday_Calculation__c</fullName>
        <formula>IF( NOT(ISNULL(Core_Meeting_Due_Date__c)), 
Core_Meeting_Due_Date__c + CASE(MOD( Core_Meeting_Due_Date__c- DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,0,5,2, 0,0, 6, 1, 0) +2,
null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Meeting date Weekday Calculation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
