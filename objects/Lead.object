    <webLinks>
        <fullName>Core_Convert_to_Opportunity</fullName>
        <availability>online</availability>
        <description>Custom button that will make sure that the lead has been qualified before calling the default lead conversion page.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Convert</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>if( &quot;{!Lead.Status}&quot; != &quot;Sales Accepted Lead&quot; || &quot;{!Lead.Core_Sales_Group__c}&quot; == &quot;&quot;) {
alert( &quot;Please Qualify the lead before Converting by changing the Lead Stage to Sales Accepted Lead and Assign a value for Sales Group.&quot;);
}
else {
window.top.location.href = &quot;/lead/leadconvert.jsp?retURL=%2F{!Lead.Id}&amp;id={!Lead.Id}&quot;;
}</url>
