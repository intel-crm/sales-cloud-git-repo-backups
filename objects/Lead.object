    <webLinks>
        <fullName>Core_Reject_Lead</fullName>
        <availability>online</availability>
        <description>Used for Intel Lead Management. Calls the Flow (using Visualforce page), updates the Lead State to &apos;Rejected&apos;, Updates Rejection Reason and Comment.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Reject Lead</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>if(&apos;{!Lead.OwnerId}&apos;==&apos;{!User.Id}&apos;) { 
window.top.location.href = &quot;/apex/Core_Reject_Intel_Lead?scontrolCaching=1&amp;id={!Lead.Id}&quot;;
} 
else { 
alert(&apos;Please take the ownership of the Lead before Rejecting.&apos;); 
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Reject_Partner_Lead</fullName>
        <availability>online</availability>
        <description>Used for Partner Lead Management. Calls the Flow (using Visualforce page), updates the Lead State to &apos;Rejected&apos;, Updates Rejection Reason and Comment, Updates the Partner Lead Owner to the current user.</description>
        <displayType>button</displayType>
        <linkType>page</linkType>
        <masterLabel>Reject Lead</masterLabel>
