    <fields>
        <fullName>Core_Lead_Disposition_SLA__c</fullName>
        <description>Field to indicate if the Lead was dispositioned within the SLA of 60 days. Uses Create Date, Current Date, Entrance Date - SQL, State Entrance Date - Rejected, Lead State to calculate the result.</description>
        <externalId>false</externalId>
        <formula>IF (RecordTypeId = &quot;012o0000000Tr9F&quot;, NULL,
IF (DATETIMEVALUE(ConvertedDate) - CreatedDate &lt;= 60, &quot;Meets SLA&quot;,
IF (Core_Entrance_Date_SQL__c - CreatedDate &lt;= 60, &quot;Meets SLA&quot;,
IF (Core_State_Entrance_Date_Rejected__c - CreatedDate &lt;= 60, &quot;Meets SLA&quot;,
IF (ISPICKVAL(Core_Lead_State__c, &quot;On Hold&quot;), &quot;In Progress&quot;,
IF (NOW() - CreatedDate &lt;= 60, &quot;In Progress&quot;,
&quot;Does Not Meet SLA&quot;
))))))</formula>
        <label>Lead Disposition SLA</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Lead_Notes__c</fullName>
