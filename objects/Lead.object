IF(AND(NOT(ISNULL(Core_Entrance_Date_TAL__c)),NOT(OR(WEEKDAY(DATEVALUE(Core_Entrance_Date_TAL__c))=1,WEEKDAY(DATEVALUE(Core_Entrance_Date_TAL__c))=7))),true,
IF(AND(NOT(ISNULL(Core_Entrance_Date_TQL__c)),NOT(OR(WEEKDAY(DATEVALUE(Core_Entrance_Date_TQL__c))=1,WEEKDAY(DATEVALUE(Core_Entrance_Date_TQL__c))=7))),true,
IF(AND(NOT(ISNULL(Core_Entrance_Date_SAL__c)),NOT(OR(WEEKDAY(DATEVALUE(Core_Entrance_Date_SAL__c))=1,WEEKDAY(DATEVALUE(Core_Entrance_Date_SAL__c))=7))),true,false))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
