    <fields>
        <fullName>Core_First_Contact_SLA__c</fullName>
        <description>Field to indicate if the Lead was contacted within the SLA of 7 days. Uses Lead State, Current Date, State Entrance Dates, Lead Conversion Date to calculate the result.</description>
        <externalId>false</externalId>
        <formula>IF (RecordTypeId = &quot;012o0000000Tr9F&quot;, NULL,
IF (ISNULL(Core_State_Entrance_Date_Open__c), &quot;Old Lead - No SLA Calculated&quot;,
IF (Core_State_Entrance_Date_Accepted__c - Core_State_Entrance_Date_Open__c &lt;= 7, &quot;Meets SLA&quot;,
IF (Core_State_Entrance_Date_Engaged__c - Core_State_Entrance_Date_Open__c &lt;= 7, &quot;Meets SLA&quot;,
IF (Core_State_Entrance_Date_OnHold__c - Core_State_Entrance_Date_Open__c &lt;= 7, &quot;Meets SLA&quot;,
IF (Core_State_Entrance_Date_Rejected__c - Core_State_Entrance_Date_Open__c &lt;= 7, &quot;Meets SLA&quot;,
IF (DATETIMEVALUE(ConvertedDate) - Core_State_Entrance_Date_Open__c &lt;= 7, &quot;Meets SLA&quot;,
IF (NOW() - Core_State_Entrance_Date_Open__c &lt;= 7, &quot;In Progress&quot;,
&quot;Does Not Meet SLA&quot;
))))))))</formula>
        <label>First Contact SLA</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
