    <businessProcesses>
        <fullName>Lead</fullName>
        <description>Process to manage Leads.</description>
        <isActive>true</isActive>
        <values>
            <fullName>Sales Accepted Lead</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>Sales Qualified Lead</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>Unqualified</fullName>
            <default>true</default>
        </values>
    </businessProcesses>
    <businessProcesses>
        <fullName>Partner Lead</fullName>
        <description>Process to manage Partner Leads.</description>
        <isActive>true</isActive>
        <values>
            <fullName>Marketing Qualified Lead</fullName>
            <default>true</default>
        </values>
        <values>
            <fullName>Partner Qualified Lead</fullName>
            <default>false</default>
        </values>
    </businessProcesses>
    <businessProcesses>
        <fullName>Prospect</fullName>
        <description>Process to manage Prospects.</description>
        <isActive>true</isActive>
        <values>
            <fullName>Tele Accepted Prospect</fullName>
            <default>true</default>
        </values>
        <values>
            <fullName>Tele Qualified Lead</fullName>
            <default>false</default>
        </values>
    </businessProcesses>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Mobile_Leads</fullName>
        <fields>Name</fields>
        <fields>Company</fields>
        <fields>Email</fields>
        <fields>Status</fields>
        <label>Mobile Leads</label>
    </compactLayouts>
