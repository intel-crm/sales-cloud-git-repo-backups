    <fields>
        <fullName>SWS_MQL_no_task_Calculation__c</fullName>
        <formula>IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Hot&quot;),ISPICKVAL(Status,&quot;Marketing Qualified Lead&quot;),NOT(ISBLANK(SWS_Claimed_Date__c))),
SWS_Claimed_Date__c+CASE(MOD(DATEVALUE(SWS_Claimed_Date__c)-DATE(1900,01,07),7),1,0,2,0,3,0,4,2,5,2,0,0,6,1,0)+2,
IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Warm&quot;),ISPICKVAL(Status,&quot;Marketing Qualified Lead&quot;),NOT(ISBLANK(SWS_Claimed_Date__c))),
SWS_Claimed_Date__c+CASE(MOD(DATEVALUE(SWS_Claimed_Date__c)-DATE(1900,01,07),7),1,0,2,0,3,2,4,2,5,2,0,0,6,1,0)+3,
IF(AND(ISPICKVAL(Core_Lead_Priority__c,&quot;Cold&quot;),ISPICKVAL(Status,&quot;Marketing Qualified Lead&quot;),NOT(ISBLANK(SWS_Claimed_Date__c))),
SWS_Claimed_Date__c+CASE(MOD(DATEVALUE(SWS_Claimed_Date__c)-DATE(1900,01,07),7),1,0,2,2,3,2,4,2,5,2,0,0,6,1,0)+5,
IF(AND(ISPICKVAL(Status,&quot;Sales Accepted Lead&quot;),NOT(ISBLANK(Core_Entrance_Date_SAL__c))),
Core_Entrance_Date_SAL__c + CASE(MOD( DATEVALUE(Core_Entrance_Date_SAL__c ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,2,5,2, 0,0, 6, 1, 0) +2,
NULL))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>MQL no task Calculation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
