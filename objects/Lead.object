                    <fullName>Reseller/Channel</fullName>
                    <default>false</default>
                    <label>Reseller/Channel</label>
                </value>
                <value>
                    <fullName>3SO</fullName>
                    <default>false</default>
                    <label>3SO</label>
                </value>
