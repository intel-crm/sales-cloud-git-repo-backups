    <webLinks>
        <fullName>Core_Accept_Lead</fullName>
        <availability>online</availability>
        <description>Used for Intel Lead Management. Updates the Lead State to &apos;Accepted&apos;, wipes out Rejection Reason, Rejection Comments.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Accept Lead</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>//Add AJAX Toolkit and libraries 

{!REQUIRESCRIPT( &quot;/soap/ajax/36.0/connection.js&quot; )} 
{!REQUIRESCRIPT(&quot;/soap/ajax/36.0/apex.js&quot;)}; 

//Declare variable and match the record 

var leadtoUpdate = new sforce.SObject(&quot;Lead&quot;); 
leadtoUpdate.Id = &quot;{!Lead.Id}&quot;; 

if(&apos;{!Lead.OwnerId}&apos;!=&apos;{!User.Id}&apos;) { 
alert(&apos;Please take the ownership of the Lead before Accepting.&apos;); 
} 
else { 
leadtoUpdate.Core_Lead_State__c = &quot;Accepted&quot;; 
leadtoUpdate.Core_Rejection_Comments__c = null; 
leadtoUpdate.Core_Rejection__c = null; 

var result = sforce.connection.update( [leadtoUpdate] ); 

if ( result[0].getBoolean( &quot;success&quot; ) ) { 
window.location.reload(); 
} 
else { 
alert( &quot;An error has occurred! Error: &quot; + result[0].errors.message ); 
} 
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Accept_Partner_Lead</fullName>
        <availability>online</availability>
        <description>Used for Partner Lead Management. Updates the Lead Stage to &apos;Partner Qualified Lead&apos;, Lead State to &apos;Accepted&apos;, Partner Lead Owner to the current user, wipes out Rejection Reason, Rejection Comments.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Accept Lead</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>//Add AJAX Toolkit and libraries

{!REQUIRESCRIPT( &quot;/soap/ajax/36.0/connection.js&quot; )}
{!REQUIRESCRIPT(&quot;/soap/ajax/36.0/apex.js&quot;)}; 

//Declare variable and match the record

var leadtoUpdate = new sforce.SObject( &quot;Lead&quot; );
leadtoUpdate.Id  = &quot;{!Lead.Id}&quot;;

//Update the field as Accepted
leadtoUpdate.Status = &quot;Partner Qualified Lead&quot;;
leadtoUpdate.Core_Lead_State__c = &quot;Accepted&quot;;
leadtoUpdate.Core_Partner_Lead_Owner__c = &quot;{!$User.Id}&quot;;
leadtoUpdate.Core_Rejection_Comments__c = null;
leadtoUpdate.Core_Rejection__c = null;

var result = sforce.connection.update( [leadtoUpdate] );

//Conditional statement and refresh the page 

if ( result[0].getBoolean( &quot;success&quot; ) ) {
    window.location.reload();
}
else {
    alert( &quot;An error has occurred! Error:&quot; + result[0].errors.message );
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Accept_Partner_Leads</fullName>
        <availability>online</availability>
        <description>Used for Partner Lead Management. Updates the Lead Stage to &apos;Partner Qualified Lead&apos;, Lead State to &apos;Accepted&apos;, Partner Lead Owner to the current user, wipes out Rejection Reason, Rejection Comments for each of the selected Lead.</description>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Accept Leads</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>// Library
{!REQUIRESCRIPT(&quot;/soap/ajax/37.0/connection.js&quot;)}

// Get the list of selected leads
var selectedRecords = {!GETRECORDIDS($ObjectType.Lead)};

// Check if it is Parter user
if (&apos;{!$Profile.Name}&apos; != &apos;Partner&apos;) {
	alert(&quot;This capability is available for Partner Leads only.&quot;);
}

// Check if there are any leads to process
else if (selectedRecords.length == 0) {
	alert(&quot;Please select one or more Leads.&quot;);
}

else {
	// Variable to store the list of leads to be updated 
	var updatedRecords = []; 

	// Process each selected lead
	for (var n = 0; n &lt; selectedRecords.length; n++) { 

		var leadtoUpdate = new sforce.SObject(&quot;Lead&quot;); 
		leadtoUpdate.Id = selectedRecords[n]; 

		// Update the lead fields
		leadtoUpdate.Status = &quot;Partner Qualified Lead&quot;; 
		leadtoUpdate.Core_Lead_State__c = &quot;Accepted&quot;; 
		leadtoUpdate.Core_Partner_Lead_Owner__c = &quot;{!$User.Id}&quot;; 
		leadtoUpdate.Core_Rejection_Comments__c = null; 
		leadtoUpdate.Core_Rejection__c = null; 

		updatedRecords.push(leadtoUpdate); 
	} 

	// Save the lead records
	var result = sforce.connection.update(updatedRecords); 

	if ( result[0].getBoolean(&quot;success&quot;)) {
		alert(updatedRecords.length + &apos; &apos; + &apos;Leads Accepted successfully.&apos;); 
		window.location.reload(); 
	} 
	else { 
		alert(&quot;An error has occurred! Error: &quot; + result[0].errors.message); 
	}
}</url>
    </webLinks>
