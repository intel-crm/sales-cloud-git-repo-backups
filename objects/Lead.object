    <fields>
        <fullName>Core_SAL_Count__c</fullName>
        <description>SAL Count</description>
        <externalId>false</externalId>
        <formula>IF( ISBLANK( Core_Entrance_Date_SAL__c),0,1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>SAL Count</inlineHelpText>
        <label>SAL Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
