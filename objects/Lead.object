    <fields>
        <fullName>SWS_Quarter__c</fullName>
        <description>Calculates the quarter of the year based on created date.</description>
        <externalId>false</externalId>
        <formula>IF(
    MONTH(DATEVALUE(CreatedDate)) &lt;= 3,
    &quot;Q1&quot;,
    IF(
        MONTH(DATEVALUE(CreatedDate)) &lt;= 6,
        &quot;Q2&quot;,
        IF(
            MONTH(DATEVALUE(CreatedDate)) &lt;= 9,
            &quot;Q3&quot;,
            &quot;Q4&quot;
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
