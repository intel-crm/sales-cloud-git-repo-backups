    <fields>
        <fullName>Core_SourceSystem_Id__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>This ID helps track the lead while loading data for HubSpot.</inlineHelpText>
        <label>Source ID</label>
        <length>55</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Stagnant_Lead_Stage_SLA__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Core_Stagnant_Lead_Stage_Time__c&gt;=90,&quot;More than 90 days&quot;,
IF(Core_Stagnant_Lead_Stage_Time__c&gt;=60,&quot;More than 60 days&quot;,
IF(Core_Stagnant_Lead_Stage_Time__c&gt;=5,&quot;More than 5 days&quot;,
IF(Core_Stagnant_Lead_Stage_Time__c&gt;=2,&quot;More than 2 days&quot;,&quot;Within SLA&quot;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Stagnant Lead Stage SLA</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Stagnant_Lead_Stage_Time__c</fullName>
        <description>Measures the difference between current time and the last time a lead stage was changed.</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Core_Lead_Stage_Change_Date_Time__c), 0, NOW() - Core_Lead_Stage_Change_Date_Time__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Measures the difference between current time and the last time a lead stage was changed.</inlineHelpText>
        <label>Stagnant Lead Stage Time</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Stagnant_Lead_State_SLA__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Core_Stagnant_Lead_State_Time__c&gt;=90,&quot;More than 90 days&quot;, 
IF(Core_Stagnant_Lead_State_Time__c&gt;=60,&quot;More than 60 days&quot;, 
IF(Core_Stagnant_Lead_State_Time__c&gt;=5,&quot;More than 5 days&quot;, 
IF(Core_Stagnant_Lead_State_Time__c&gt;=2,&quot;More than 2 days&quot;,&quot;Within SLA&quot;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Stagnant Lead State SLA</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Stagnant_Lead_State_Time__c</fullName>
        <description>Measures the difference between current time and the last time a lead state was changed.</description>
        <externalId>false</externalId>
