    <fields>
        <fullName>Core_Age_of_Lead__c</fullName>
        <description>Field to determine the age (in days) of the lead. The value depends on the number of days since the revival date(s) or create date.</description>
        <externalId>false</externalId>
        <formula>IF (!ISBLANK(Core_Lead_Revive_Date_Most_Recent__c), NOW() - Core_Lead_Revive_Date_Most_Recent__c,
IF (!ISBLANK(Core_Lead_Revive_Date_Original__c), NOW() - Core_Lead_Revive_Date_Original__c,
NOW() - CreatedDate
))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Age of Lead</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
