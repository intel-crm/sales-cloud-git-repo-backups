        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT( &quot;/soap/ajax/36.0/connection.js&quot; )} 
{!REQUIRESCRIPT(&quot;/soap/ajax/36.0/apex.js&quot;)}; 

//fetch the lead details
var leadtoUpdate = new sforce.SObject(&quot;Lead&quot;); 
leadtoUpdate.Id = &quot;{!Lead.Id}&quot;; 
var LeadStatus=&quot;{!Lead.Core_Lead_Status__c}&quot;; 

//If the lead is not Claimed
if(LeadStatus == &apos;New&apos;) { 
leadtoUpdate.Core_Lead_Status__c = &quot;Accepted&quot;; 
var result = sforce.connection.update( [leadtoUpdate] ); 

if ( result[0].getBoolean( &quot;success&quot; ) ) { 
alert(&apos;Lead Status has been updated Successfully.&apos;); 
window.location.reload(); 
} 
else { 
alert(result[0].errors.message ); 
} 
}

//If the LeadStatus is Accepted
else if(LeadStatus == &apos;Accepted&apos;) { 
leadtoUpdate.Core_Lead_Status__c = &quot;Contacted&quot;; 
var result = sforce.connection.update( [leadtoUpdate] ); 

if ( result[0].getBoolean( &quot;success&quot; ) ) { 
alert(&apos;Lead Status has been updated Successfully.&apos;); 
window.location.reload(); 
} 
else { 
alert(result[0].errors.message ); 
} 
} 

//If the LeadStatus is Contacted and ContactEstrablished checkbox is checked
else if(LeadStatus== &apos;Contacted&apos;) { 
leadtoUpdate.Core_Lead_Status__c = &quot;Qualified&quot;; 
var result = sforce.connection.update( [leadtoUpdate] ); 

if ( result[0].getBoolean( &quot;success&quot; ) ) { 
alert(&apos;Lead Status has been updated Successfully.&apos;); 
window.location.reload(); 
} 
else { 
alert( result[0].errors.message ); 
} 
}</url>
