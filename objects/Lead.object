    <fields>
        <fullName>Core_TAL_Lead_Coverage__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(Status,&apos;Tele Accepted Lead&apos;),
(IF(ISBLANK (TEXT(Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT(Owner:User.Core_User_Coverage__c))), 
Core_Locked_TAL_Coverage__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>TAL Lead Coverage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_TAP_Count__c</fullName>
        <description>TAP Count</description>
        <externalId>false</externalId>
        <formula>IF( ISBLANK( Core_Entrance_Date_TAP__c),0,1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>TAP Count</inlineHelpText>
        <label>TAP Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_TQL_Count__c</fullName>
        <description>TQL Count</description>
        <externalId>false</externalId>
        <formula>IF( ISBLANK( Core_Entrance_Date_TQL__c),0,1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>TQL Count</inlineHelpText>
        <label>TQL Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_TQL_Lead_Coverage__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(IsConverted = True,ISPICKVAL(Status,&quot;Tele Qualified Lead&quot;)), Core_Locked_TQL_Coverage__c, 
IF(ISPICKVAL(Status,&quot;Tele Qualified Lead&quot;),(IF(ISBLANK (TEXT(Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT(Owner:User.Core_User_Coverage__c))),Core_Locked_TQL_Coverage__c))</formula>
        <label>TQL Lead Coverage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
