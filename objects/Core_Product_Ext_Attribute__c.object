                    <label>1DES</label>
                </value>
                <value>
                    <fullName>3DES</fullName>
                    <default>false</default>
                    <label>3DES</label>
                </value>
                <value>
                    <fullName>BOTH</fullName>
                    <default>false</default>
                    <label>BOTH</label>
                </value>
                <value>
                    <fullName>N-A</fullName>
                    <default>false</default>
                    <label>N-A</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
