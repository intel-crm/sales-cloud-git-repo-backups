        <columns>Core_SW_Lic_Renewal_Period_Nbr__c</columns>
        <columns>Core_Prod_QTE_Slow_Moving_Inventory_Ind__c</columns>
        <columns>Core_Prod_QTE_Alt_LGSTS_NW_Enabled_Ind__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>PSG-EA-{000000}</displayFormat>
        <label>Product Extended Attribute Number</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Product Extended Attributes</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Core_Prevent_Non_PSG_Usr_ProdExt_Fields</fullName>
        <active>true</active>
        <description>Prevent non PSG users from modifying PSG data</description>
        <errorConditionFormula>IF(($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE || $Profile.Name ==&apos;System Administrator&apos; || $Profile.Name ==&apos;IT Admin&apos;)
,FALSE,
(
NOT(($Permission.PSG_Master_Data_Read_Access || $Permission.PSG_Master_Data_Read_Write_Access ||
$Permission.PSG_Account_Contact_Read_Write_Access || $Permission.PSG_Account_Contact_Super_Admin || $Permission.PSG_Product_Super_Admin || $Permission.PSG_Product_Read_Write_Access)) &amp;&amp;
(   
	ischanged(Core_Product_Id__c) || 
ischanged(Core_SW_Lic_Enforcement_Method_Nm__c) || 
ischanged(Core_Prod_Tool_Type_Nm__c) || 
ischanged(Core_SW_Lic_Type_Nm__c) || 
ischanged(Core_SW_Prod_Additional_Dsc__c) || 
ischanged(Core_SW_Lic_Web_Displayable_Ind__c) || 
ischanged(Core_SW_Prod_Web_Dsc__c) || 
ischanged(Core_SW_Lic_Authorization_Cd__c) || 
ischanged(Core_SW_Lic_Renewal_Period_Nbr__c) || 
ischanged(Core_Foundation_Product_Id__c) ||  
ischanged(Core_SW_Prod_Expiration_Duration_Nbr__c) || 
ischanged(Core_SW_Lic_Rehostable_Ind__c) || 
ischanged(Core_SW_Lic_File_Data_Encryption_Std_Cd__c) || 
ischanged(Core_SW_Prod_Avail_To_TL_ORD_ENBLMT_Ind__c) || 
ischanged(Core_SW_Lic_Linux_Download_URL_Txt__c) || 
ischanged(Core_SW_Lic_Windows_Download_URL_Txt__c) || 
ischanged(Core_SW_Lic_Comment_Txt__c) || 
ischanged(Core_SW_Lic_Companion_Ind__c) || 
ischanged(Core_SW_Lic_Group_Id__c) || 
ischanged(Core_SW_Lic_Generator_Parameter_Txt__c) || 
ischanged(Core_SW_Prod_Non_Commercial_Purpose_Nm__c) || 
ischanged(Core_SW_Prod_Temporary_Lic_Allowed_Ind__c) || 
ischanged(Core_SW_Prod_Avail_In_Opportunities_Ind__c) || 
ischanged(Core_Prod_QTE_Slow_Moving_Inventory_Ind__c) || 
ischanged(Core_Prod_QTE_Alt_LGSTS_NW_Enabled_Ind__c) || 
ischanged(Core_SW_Prod_Max_Rehost_Cnt__c) 
)
)
)</errorConditionFormula>
        <errorMessage>You cannot edit PSG data</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Restrict_Ext_Attr_On_InactiveProduct</fullName>
        <active>true</active>
        <description>Restrict creating Extended attribute records for Inactive Products</description>
        <errorConditionFormula>AND( ISNEW() , Core_Product_Id__r.IsActive = false, Core_Product_Id__r.Core_Hierarchy_ID__c ==&apos;59&apos;)</errorConditionFormula>
        <errorMessage>Creation of Extended Attribute record is restricted for Pre-Release(Inactive) Products.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Validate_Foundation_Product</fullName>
        <active>true</active>
        <description>Foundation Product is applicable if Tool Type is Renewal or Add Seat</description>
        <errorConditionFormula>AND(
ISBLANK(Core_Foundation_Product_Id__c),
Core_Product_Id__r.IsActive = true,
OR(ISPICKVAL(Core_Prod_Tool_Type_Nm__c  , &apos;RENEWAL&apos;) ,ISPICKVAL(Core_Prod_Tool_Type_Nm__c  , &apos;ADD SEAT&apos;))
)</errorConditionFormula>
        <errorDisplayField>Core_Foundation_Product_Id__c</errorDisplayField>
        <errorMessage>Please enter the Foundation Product if Tool Type is Renewal or Add Seat</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Validate_Tool_ExtendedAttributes</fullName>
        <active>true</active>
        <description>Validate attributes related to Tool Products</description>
        <errorConditionFormula>AND(
Core_Product_Id__r.IsActive = true,
OR(ISBLANK(Core_SW_Prod_Web_Dsc__c),
ISPICKVAL(Core_SW_Lic_File_Data_Encryption_Std_Cd__c,&apos;&apos;),
ISPICKVAL(Core_SW_Lic_Enforcement_Method_Nm__c, &apos;&apos; ),
ISPICKVAL(Core_Prod_Tool_Type_Nm__c , &apos;&apos; ),
ISPICKVAL(Core_SW_Lic_Type_Nm__c, &apos;&apos; ) ),
OR(
Core_Product_Id__r.Core_Item_Class_Nm__c=&apos;SV&apos;,Core_Product_Id__r.Core_Item_Class_Nm__c=&apos;BD&apos;)
)</errorConditionFormula>
        <errorMessage>Please enter the Mandatory Fields 
( Tool Type, Tool License Type, Enforcement Method, DES Parameter, Web Description)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_PSG_Restricted_Field_Access</fullName>
        <active>false</active>
        <errorConditionFormula>IF(AND(ischanged( PSG_Restricted_Product__c), $Profile.Name ==&apos;Sales Ops&apos;, NOT($Permission.PSG_Product_Read_Write_Access ||  $Permission.PSG_Internal_PMS)), true, false)</errorConditionFormula>
        <errorMessage>Don&apos;t have access to edit this field</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
