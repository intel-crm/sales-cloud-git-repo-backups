    <fields>
        <fullName>PMP_Storefront_EditAccess_Ind__c</fullName>
        <formula>OR((CONTAINS($User.ProfileId,  $Label.PMP_Partner_Profile_Id )
					&amp;&amp;  NOT(ISBLANK($User.Core_IPA_One_Partner_Id__c))  &amp;&amp;CONTAINS(PMP_Opid_Sfid_Ref_Txt__c,$User.Core_IPA_One_Partner_Id__c)),$Permission.PMP_Manage_Partners )</formula>
        <label>Storefront EditAccess Ind</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Storefront_SiteUrl__c</fullName>
        <description>This field has link to Experience site Storefront Record</description>
        <externalId>false</externalId>
        <formula>HYPERLINK(
$Label.PMP_PartnerURL &amp; PMP_Published_Copy_Id__c,
&quot;Edit/Approve Storefront&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Storefront SiteUrl</label>
        <required>false</required>
