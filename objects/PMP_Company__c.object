    <fields>
        <fullName>PMP_Account_Address_Txt__c</fullName>
        <externalId>false</externalId>
        <formula>/*
PMP_Account_Id__r.Core_Address_Details__c

if(LEN(PMP_Account_Id__r.BillingStreet)&gt;0, PMP_Account_Id__r.BillingStreet&amp; &quot; &quot; , &quot;&quot; ) &amp; BR() &amp;
if(LEN(PMP_Account_Id__r.BillingCity)&gt;0, PMP_Account_Id__r.BillingCity&amp; &quot;, &quot; , &quot;&quot; )&amp;
if(LEN(PMP_Account_Id__r.BillingState)&gt;0, PMP_Account_Id__r.BillingState&amp; &quot; &quot; , &quot;&quot; )&amp;
if(LEN(PMP_Account_Id__r.BillingPostalCode)&gt;0, PMP_Account_Id__r.BillingPostalCode,&quot;&quot;) &amp; BR() &amp;
If(LEN(PMP_Account_Id__r.BillingCountry) &gt;0, PMP_Account_Id__r.BillingCountry,&quot;&quot;)
*/
/* Commented By Subash for US686667
IF(NOT(ISBLANK(PMP_Account_Id__r.BillingStreet)),        PMP_Account_Id__r.BillingStreet      + BR(), NULL) +
IF(NOT(ISBLANK(PMP_Account_Id__r.BillingCity)),          PMP_Account_Id__r.BillingCity        + &quot;, &quot;, NULL) +
IF(NOT(ISBLANK(PMP_Account_Id__r.BillingState)),         PMP_Account_Id__r.BillingState + &quot;, &quot;, NULL) +
IF(NOT(ISBLANK(PMP_Account_Id__r.BillingPostalCode)),    PMP_Account_Id__r.BillingPostalCode + BR(), NULL) +
IF(NOT(ISBLANK(PMP_Account_Id__r.BillingCountry)),       PMP_Account_Id__r.BillingCountry,            NULL)
*/
IF(NOT(ISBLANK(PMP_Partner_Primary_Street_Txt__c)),      PMP_Partner_Primary_Street_Txt__c + BR(), NULL) +
IF(NOT(ISBLANK(PMP_Partner_Secondary_Street_Txt__c)),    PMP_Partner_Secondary_Street_Txt__c + BR(), NULL) +
IF(NOT(ISBLANK(PMP_Partner_City_Txt__c)),                PMP_Partner_City_Txt__c + &quot;, &quot;, NULL) +
IF(NOT(ISBLANK(PMP_Partner_State_Txt__c)),               PMP_Partner_State_Txt__c + &quot;, &quot;, NULL) +
IF(NOT(ISBLANK(PMP_Partner_Zipcode_Txt__c)),             PMP_Partner_Zipcode_Txt__c + BR(), NULL) +
IF(NOT(ISBLANK(PMP_Partner_Country_Txt__c)),             PMP_Partner_Country_Txt__c, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Address</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
