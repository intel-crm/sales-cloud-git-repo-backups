    <fields>
        <fullName>PMP_View_Partners_Txt__c</fullName>
        <description>Checking for translated languages and highlighting the translated ones.</description>
        <externalId>false</externalId>
        <formula>IF(AND(($Profile.Name=&quot;Partner&quot;), NOT(ISPICKVAL( PMP_Company_Lifecycle_Status_Nm__c, &quot;Approved&quot;))), &quot;ENG, CHN, JPN&quot;,
(IF (INCLUDES(PMP_Translated_Languages_Txt__c , &quot;English&quot;), HYPERLINK(&quot;/&quot;&amp; Id &amp;&quot;?language=en_US&quot;, &quot;ENG&quot;) , &quot;ENG&quot;)
&amp; &quot;, &quot; &amp;
IF (INCLUDES(PMP_Translated_Languages_Txt__c , &quot;Simplified Chinese&quot;), HYPERLINK(&quot;/&quot;&amp; Id &amp;&quot;?language=zh_CN&quot;, &quot;CHN&quot;) , &quot;CHN&quot;)
&amp; &quot;, &quot; &amp;
IF (INCLUDES(PMP_Translated_Languages_Txt__c , &quot;Japanese&quot;), HYPERLINK(&quot;/&quot;&amp; Id &amp;&quot;?language=JA&quot;, &quot;JPN&quot;) , &quot;JPN&quot;)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>View Partners</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_View_Partners__c</fullName>
        <description>Checking for translated languages and highlighting the translated ones.</description>
        <externalId>false</externalId>
        <formula>(IF (INCLUDES(PMP_Translated_Languages__c , &quot;English&quot;), HYPERLINK(&quot;&quot;, &quot;ENG&quot;) , &quot;ENG&quot;)
&amp; &quot;, &quot; &amp;
IF (INCLUDES(PMP_Translated_Languages__c , &quot;Simplified Chinese&quot;), HYPERLINK(&quot;&quot;, &quot;CHN&quot;) , &quot;CHN&quot;)
&amp; &quot;, &quot; &amp;
IF (INCLUDES(PMP_Translated_Languages__c , &quot;Japanese&quot;), HYPERLINK(&quot;&quot;, &quot;JPN&quot;) , &quot;JPN&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>View Partners</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Workflow_One_Week_Trigger_Dt__c</fullName>
        <formula>PMP_Company_Status_Update_Dt__c + CASE(PMP_Company_Lifecycle_Status_Nm__c,

&apos;Draft&apos;, CASE(MOD(PMP_Company_Status_Update_Dt__c-DATE(1900,1,7),7),
0,4,
1,4,
6,5,6),
CASE(MOD(PMP_Company_Status_Update_Dt__c-DATE(1900,1,7),7),
0,2,
6,3,4))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Second SLA Workflow Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMP_Workflow_Three_Day_Trigger_Dt__c</fullName>
        <formula>PMP_Company_Status_Update_Dt__c + CASE(PMP_Company_Lifecycle_Status_Nm__c,

&apos;Draft&apos;, CASE(MOD(PMP_Company_Status_Update_Dt__c-DATE(1900,1,7),7),
4,4,
5,4,
6,3,2),
CASE(MOD(PMP_Company_Status_Update_Dt__c-DATE(1900,1,7),7),
3,2,
4,2,
5,2,
6,1,
0))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
