    <fields>
        <fullName>Days_Left_for_EV_Expiry__c</fullName>
        <externalId>false</externalId>
        <formula>IF(( (  TODAY() - DATEVALUE( CreatedDate )  )&lt;=5 ), (5 - (TODAY() - DATEVALUE( CreatedDate ))), 0)</formula>
        <label>Days Left for EV Expiry</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_Left_for_Identity_Deletion__c</fullName>
        <externalId>false</externalId>
        <formula>if( OR(ISBLANK(PRM_EmailVerifiedDateTime__c), ISNULL(PRM_EmailVerifiedDateTime__c) ) , TEXT(45-( Today() -  DATEVALUE(PRM_EV_Token_Renewed_Date__c) )), &apos;&apos; )</formula>
        <label>Days Left for Identity Deletion</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_in_AE_Open_status__c</fullName>
        <description>RR was in Open status for these days - Under AE</description>
        <externalId>false</externalId>
        <formula>IF(AND(ISNULL(AE_PendingTimeStamp__c),NOT(ISNULL(AE_ApprovedRejectedTimeStamp__c))),
FLOOR((5 * ( FLOOR( ( AE_ApprovedRejectedTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( AE_ApprovedRejectedTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )),
IF(AND(ISNULL(AE_PendingTimeStamp__c),(ISNULL(AE_ApprovedRejectedTimeStamp__c))),
FLOOR((5 * ( FLOOR( ( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )),
FLOOR((5 * ( FLOOR( ( AE_PendingTimeStamp__c- DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) ))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days in &apos;AE Open&apos; status</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_in_AE_Pending_status__c</fullName>
        <description>RR&apos;s Current Status was in pending for these many days - Under AE</description>
        <externalId>false</externalId>
        <formula>IF(NOT(ISNULL(AE_ApprovedRejectedTimeStamp__c)),
FLOOR( (5 * ( FLOOR( ( AE_ApprovedRejectedTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( AE_ApprovedRejectedTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) ) ),
IF(ISNULL(Sales_PendingTimeStamp__c),
(FLOOR( (5 * ( FLOOR( ( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) ))),
IF(AND(NOT(ISNULL(Sales_PendingTimeStamp__c)),(DATETIMEVALUE(AE_PendingTimeStamp__c)&lt;= DATETIMEVALUE(Sales_PendingTimeStamp__c))),
ABS((FLOOR( (5 * ( FLOOR( ( Sales_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Sales_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) ) ))),
(FLOOR( (5 * ( FLOOR( ( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )))
)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days in &apos;AE Pending&apos; status</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_in_Open_status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(ISNULL(Pending_TimeStamp__c),(ISNULL(Approved_Timestamp__c))) ,
FLOOR((5 * ( FLOOR( ( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )),
IF(AND(ISNULL(Pending_TimeStamp__c), NOT(ISNULL(Approved_Timestamp__c))),
((5 * ( FLOOR( ( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
),
((5 * ( FLOOR( ( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days in &apos;Open&apos; status</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_in_Pending_status__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISNULL(Approved_Timestamp__c),
FLOOR( (5 * ( FLOOR( ( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( NOW() - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )),
FLOOR( (5 * ( FLOOR( ( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days in &apos;Pending&apos; status</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
