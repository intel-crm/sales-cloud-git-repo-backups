    <fields>
        <fullName>AE_ApprovedRejectedTimeStamp__c</fullName>
        <description>If AE changes current status to Approved or Rejected this filed get updated - stabilization request</description>
        <label>AE_ApprovedRejectedTimeStamp</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>AE_PendingTimeStamp__c</fullName>
        <description>If AE changes current status this filed get updated - stabilization request</description>
        <label>AE_PendingTimeStamp</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>AE_TPT__c</fullName>
        <description>TPT for AE, How long it took for moving from Open to Approved or Rejected by AE</description>
        <externalId>false</externalId>
        <formula>Days_in_AE_Open_status__c + Days_in_AE_Pending_status__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>AE_TPT</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
