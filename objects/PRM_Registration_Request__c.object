    <fields>
        <fullName>TPT__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(
FLOOR(Approved_Timestamp__c - CreatedDate)
) &amp; &quot; Day(s) &quot; &amp;
TEXT(
ROUND(MOD((Approved_Timestamp__c - CreatedDate)*24,24),0)
) &amp;&quot; Hour(s) &quot; &amp;
TEXT(
ROUND(MOD((Approved_Timestamp__c - CreatedDate)*1440,60),0)
) &amp;&quot; Min(s) &quot;</formula>
        <label>Approved/Rejected TPT Duration</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_TPT_AE_and_sales__c</fullName>
        <description>This TPT is for Total throughput for how long the RR take for approve/reject, when both AE and Sales involved.</description>
        <externalId>false</externalId>
        <formula>(5 * ( FLOOR( ( Sales_ApprovedRejectedTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Sales_ApprovedRejectedTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total TPT(AE and sales)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_TPT__c</fullName>
        <externalId>false</externalId>
        <formula>Days_in_Open_status__c + Days_in_Pending_status__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total TPT</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
