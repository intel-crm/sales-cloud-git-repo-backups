    <fields>
        <fullName>Days_Left_for_EV_Expiry__c</fullName>
        <externalId>false</externalId>
        <formula>IF(( (  TODAY() - DATEVALUE( CreatedDate )  )&lt;=5 ), (5 - (TODAY() - DATEVALUE( CreatedDate ))), 0)</formula>
        <label>Days Left for EV Expiry</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_Left_for_Identity_Deletion__c</fullName>
        <externalId>false</externalId>
        <formula>if( OR(ISBLANK(PRM_EmailVerifiedDateTime__c), ISNULL(PRM_EmailVerifiedDateTime__c) ) , TEXT(45-( Today() -  DATEVALUE(PRM_EV_Token_Renewed_Date__c) )), &apos;&apos; )</formula>
        <label>Days Left for Identity Deletion</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_in_AE_Open_status__c</fullName>
        <description>RR was in Open status for these days - Under AE</description>
        <externalId>false</externalId>
        <formula>IF(AND(ISNULL(AE_PendingTimeStamp__c),NOT(ISNULL(Approved_Timestamp__c))),
(ROUND(24*((5*FLOOR((TODAY()-DATE(1996,01,01))/7) + MIN(5, MOD(TODAY()-DATE(1996,01,01), 7) + MIN(1, (MOD(NOW()-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1))))) 
- 
(5*FLOOR((DATEVALUE(CreatedDate)-DATE(1996,01,01))/7) + 
MIN(5, MOD(DATEVALUE(CreatedDate)-DATE(1996,01,01), 7) + 
MIN(1, (MOD(NULLVALUE(CreatedDate, CreatedDate)-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1)))))), 0)),
(ROUND(24*(5*FLOOR((DATEVALUE(AE_PendingTimeStamp__c)-DATE(1996,01,01))/7) +
MIN(5,MOD(DATEVALUE(AE_PendingTimeStamp__c)-DATE(1996,01,01), 7) +
MIN(1, (MOD(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate)-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1))))
-
(5*FLOOR((DATEVALUE(CreatedDate)-DATE(1996,01,01))/7) +
MIN(5,MOD(DATEVALUE(CreatedDate)-DATE(1996,01,01), 7) +
MIN(1, (MOD(NULLVALUE(CreatedDate, CreatedDate)-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1)))))), 0)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Hours in &apos;AE Open&apos; status</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_in_AE_Pending_status__c</fullName>
        <description>RR&apos;s Current Status was in pending for these many days - Under AE</description>
        <externalId>false</externalId>
        <formula>IF(ISNULL(AE_ApprovedRejectedTimeStamp__c),
IF(ISNULL(Sales_PendingTimeStamp__c), 
(ROUND(24*((5*FLOOR((TODAY()-DATE(1996,01,01))/7) +MIN(5,MOD(TODAY()-DATE(1996,01,01), 7) +
MIN(1, (MOD(NOW()-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1)))))
-
(5*FLOOR((DATEVALUE(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate))-DATE(1996,01,01))/7) +
MIN(5,MOD(DATEVALUE(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate))-DATE(1996,01,01), 7) +
MIN(1, (MOD(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate)-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1)))))), 0)),
(ROUND(24*(5*FLOOR((DATEVALUE(NULLVALUE(Sales_PendingTimeStamp__c, CreatedDate))-DATE(1996,01,01))/7) +
MIN(5,MOD(DATEVALUE(NULLVALUE(Sales_PendingTimeStamp__c, CreatedDate))-DATE(1996,01,01), 7) +
MIN(1, (MOD(NULLVALUE(Sales_PendingTimeStamp__c, CreatedDate)-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1))))
-
(5*FLOOR((DATEVALUE(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate))-DATE(1996,01,01))/7) +
MIN(5,MOD(DATEVALUE(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate))-DATE(1996,01,01), 7) +
MIN(1, (MOD(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate)-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1)))))), 0))),
(ROUND(24*(5*FLOOR((DATEVALUE(NULLVALUE(AE_ApprovedRejectedTimeStamp__c, CreatedDate))-DATE(1996,01,01))/7) +
MIN(5,MOD(DATEVALUE(NULLVALUE(AE_ApprovedRejectedTimeStamp__c, CreatedDate))-DATE(1996,01,01), 7) +
MIN(1, (MOD(NULLVALUE(AE_ApprovedRejectedTimeStamp__c, CreatedDate)-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1))))
-
(5*FLOOR((DATEVALUE(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate))-DATE(1996,01,01))/7) +
MIN(5,MOD(DATEVALUE(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate))-DATE(1996,01,01), 7) +
MIN(1, (MOD(NULLVALUE(AE_PendingTimeStamp__c, CreatedDate)-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1)))))), 0)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days in &apos;AE Pending&apos; status</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Days_in_Open_status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISNULL(Pending_TimeStamp__c),
(ROUND(24*((5*FLOOR((TODAY()-DATE(1996,01,01))/7) + MIN(5, MOD(TODAY()-DATE(1996,01,01), 7) + MIN(1, (MOD(NOW()-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1))))) 
- 
(5*FLOOR((DATEVALUE(NULLVALUE(CreatedDate, CreatedDate))-DATE(1996,01,01))/7) + 
