IF(AND(NOT(ISNULL(AE_PendingTimeStamp__c)),NOT(ISNULL(Sales_PendingTimeStamp__c))),
FLOOR((5 * ( FLOOR( ( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( AE_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( Sales_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Sales_PendingTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) ) ),
