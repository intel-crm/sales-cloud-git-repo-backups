        <formula>IF ( INCLUDES ( PRM_Legal_Agreements__c , &quot;IPA_TANDC&quot; ), &quot;IPA_TANDC; &quot;,null ) &amp;
IF ( INCLUDES ( PRM_Legal_Agreements__c , &quot;IQR_TANDC&quot; ), &quot;IQR_TANDC; &quot;,null ) &amp;
IF ( INCLUDES ( PRM_Legal_Agreements__c , &quot;PSG_TANDC&quot; ), &quot;PSG_TANDC; &quot;,null ) &amp;
IF ( INCLUDES ( PRM_Legal_Agreements__c , &quot;DZP_TANDC&quot; ), &quot;DZP_TANDC; &quot;,null )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
