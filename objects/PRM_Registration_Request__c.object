    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Company_NameEng_Should_be_alphanumeric</fullName>
        <active>true</active>
        <description>To allow only English translation in Company Name - English Language field.</description>
        <errorConditionFormula>NOT(ISBLANK(PRM_Company_Nm_Eng__c)) &amp;&amp; NOT(REGEX(PRM_Company_Nm_Eng__c, &quot;^(?=.*?[a-zA-Z0-9])[a-zA-Z0-9()/\\@\\&amp;\\s\\*\\,\\#\\.\\_\\-]+$&quot;))</errorConditionFormula>
        <errorDisplayField>PRM_Company_Nm_Eng__c</errorDisplayField>
        <errorMessage>The field allows only English letters, digits (0-9), and the following special characters: &apos;-&apos;, &apos;(&apos;, &apos;)&apos;, &apos;/&apos;, &apos;&apos;, &apos;@&apos;, &apos;&amp;&apos;, &apos;*&apos;, &apos;,&apos;, &apos;#&apos;, &apos;.&apos;, &apos;_&apos;, and space</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DZP_Registration_Status_Validation</fullName>
        <active>true</active>
        <description>&quot;Ensures if the Registration Request is &apos;DZP registration request,&apos; the Status must be &apos;Others&apos; and the Comment cannot be empty.&quot;</description>
        <errorConditionFormula>AND( 
 ISPICKVAL( PRM_Source__c , &quot;DZP&quot;),
ISPICKVAL (PRM_Status_Reason__c , &quot;Others&quot;), ISBLANK(PRM_Review_Note_txt__c)
)</errorConditionFormula>
        <errorDisplayField>PRM_Review_Note_txt__c</errorDisplayField>
        <errorMessage>Please provide rejection reason.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>GstNumberValidation</fullName>
        <active>true</active>
        <description>GST number should not have any special characters</description>
        <errorConditionFormula>NOT(REGEX( PRM_Tax_Number__c , &quot;^[a-zA-Z0-9 ]*$&quot;))</errorConditionFormula>
        <errorDisplayField>PRM_Tax_Number__c</errorDisplayField>
        <errorMessage>GST Number should not have special characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_AccountChangeOnRegistration</fullName>
        <active>true</active>
        <description>This rule will throw when user tries to select different account than the account that contact is associated</description>
        <errorConditionFormula>AND(PRM_Channel_Program_Level_txt__c=&apos;Intel Partner Alliance&apos;,
$Permission.PRM_Edit_IPA_Request,
NOT(ISBLANK(PRM_Matching_Contact__c)),
ISCHANGED(PRM_Salesforce_ID__c),
PRM_Matching_Contact__r.Account.Id &lt;&gt; PRM_Salesforce_ID__r.Id
)</errorConditionFormula>
        <errorMessage>Please select the account which is associated with contact</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_SF_ID_RecordTypeIntel_Mandatory</fullName>
        <active>true</active>
        <description>SF_ID RecordType Must Be Intel RecordType ,Otherwise we have to populate Error Message</description>
        <errorConditionFormula>IF(
$Setup.PRM_Execution_Controls__c.PRM_Skip_Validation_Rule_Ind__c=TRUE,
	FALSE,
	AND(
		NOT(ISBLANK( PRM_Salesforce_ID__c )),
		PRM_Salesforce_ID__r.RecordType.DeveloperName&lt;&gt; ($Label.PRM_Intel_Account),
			NOT(OR(ISCHANGED(PRM_Reject_Reason__c),
			ISPICKVAL(PRM_Status__c, &apos;Rejected&apos;)))
	)
)</errorConditionFormula>
        <errorDisplayField>Account_ID__c</errorDisplayField>
        <errorMessage>Acount RecordType Must Be Intel Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_StatusOnRegistration</fullName>
        <active>true</active>
        <description>This rule will throw when user tries to change reject status to approved</description>
        <errorConditionFormula>AND(
PRM_Channel_Program_Level_txt__c = &apos;Intel Partner Alliance&apos;,
$Permission.PRM_Edit_IPA_Request,
OR(AND(ISCHANGED(PRM_Status__c),
ISPICKVAL(PRIORVALUE(PRM_Status__c), &apos;Approved&apos;),
OR(ISPICKVAL(PRM_Status__c, &apos;New&apos;), ISPICKVAL(PRM_Status__c, &apos;Pending&apos;),ISPICKVAL(PRM_Status__c, &apos;Rejected&apos;))
),
AND(ISCHANGED(PRM_Status__c),
ISPICKVAL(PRIORVALUE(PRM_Status__c), &apos;Rejected&apos;),
OR(ISPICKVAL(PRM_Status__c, &apos;Approved&apos;), ISPICKVAL(PRM_Status__c, &apos;Pending&apos;))))
)</errorConditionFormula>
        <errorDisplayField>Account_ID__c</errorDisplayField>
        <errorMessage>This action is not allowed. Status cannot be modified</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Status_Reason_Mandatory_for_Rejection</fullName>
        <active>true</active>
        <description>Status Reason Mandatory for Rejection</description>
        <errorConditionFormula>AND(
NOT(ISBLANK(Entitlement_Details__c)),
OR(
ISPICKVAL(Current_Status__c,&quot;A&amp;E Rejected&quot;),
ISPICKVAL(Current_Status__c,&quot;Insides Sales Rejected&quot;),
ISPICKVAL(Current_Status__c,&quot;IPA Admin Rejected&quot;),
ISPICKVAL(Current_Status__c,&quot;RPM Admin Rejected&quot;),
ISPICKVAL(Current_Status__c,&quot;Closed&quot;)
),
ISPICKVAL(PRM_Status_Reason__c,&quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>PRM_Status_Reason__c</errorDisplayField>
        <errorMessage>Select Status Reason, when Current status is Rejected/Closed</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
