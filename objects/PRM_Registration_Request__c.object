        <externalId>false</externalId>
        <formula>IF( ISPICKVAL(PRM_Email_Verification_Criteria__c , &quot;SUCCESS&quot;),
&quot;SUCCESS&quot;,
IF( AND(ISPICKVAL(PRM_Email_Verification_Criteria__c , &quot;PENDING&quot;),(NOW() - PRM_EV_Token_Renewed_Date__c &gt;5),ISBLANK(PRM_EmailVerifiedDateTime__c)) ,
&quot;EXPIRED &quot; + IMAGE(&quot;/resource/EVExpiredStatusExclamationMark&quot;, &quot;alert&quot;, 30, 30), &quot;PENDING&quot;
))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
