    <fields>
        <fullName>Sales_PendingTimeStamp__c</fullName>
        <description>If Sales changes current status this filed get updated - stabilization request</description>
        <label>Sales_PendingTimeStamp</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Sales_TPT__c</fullName>
        <description>TPT for Sales, How long it took for moving from Open to Approved or Rejected by Sales</description>
        <externalId>false</externalId>
        <formula>Days_in_Sales_Open_status__c + Days_in_Sales_Pending_status__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sales_TPT</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Status_Approved_Time__c</fullName>
        <label>Status Approved Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Status_Pending_Time__c</fullName>
        <label>Status Pending Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Sync_Profile_Response__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Sync Profile Response</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TPT_Approved_Rejected_Days__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISNULL(Approved_Timestamp__c),FLOOR( NOW() - CreatedDate),0 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>TPT Approved/Rejected Days</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TPT_Pending_Days_Record_Count__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISNULL(Pending_TimeStamp__c),FLOOR( NOW() - CreatedDate),0 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>TPT Pending Days Record Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TPT_Pending_Days__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  ISNULL(Pending_TimeStamp__c),FLOOR(  NOW() - CreatedDate),0 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>TPT Pending Days</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TPT__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(
FLOOR(Approved_Timestamp__c - CreatedDate)
) &amp; &quot; Day(s) &quot; &amp;
TEXT(
ROUND(MOD((Approved_Timestamp__c - CreatedDate)*24,24),0)
) &amp;&quot; Hour(s) &quot; &amp;
TEXT(
ROUND(MOD((Approved_Timestamp__c - CreatedDate)*1440,60),0)
) &amp;&quot; Min(s) &quot;</formula>
        <label>Approved/Rejected TPT Duration</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Title__c</fullName>
        <externalId>false</externalId>
        <label>Title</label>
        <length>128</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>To_Date__c</fullName>
        <description>For Report Dynamic URL filter</description>
        <label>To Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Total_TPT_AE_and_sales__c</fullName>
        <description>This TPT is for Total throughput for how long the RR take for approve/reject, when both AE and Sales involved.</description>
        <externalId>false</externalId>
        <formula>(5 * ( FLOOR( ( Sales_ApprovedRejectedTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Sales_ApprovedRejectedTimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total TPT(AE and sales)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_TPT__c</fullName>
        <externalId>false</externalId>
        <formula>Days_in_Open_status__c + Days_in_Pending_status__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total TPT</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
