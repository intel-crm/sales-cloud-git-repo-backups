(5*FLOOR((DATEVALUE(Sales_PendingTimeStamp__c)-DATE(1996,01,01))/7) +
MIN(5,MOD(DATEVALUE(Sales_PendingTimeStamp__c)-DATE(1996,01,01), 7) +
MIN(1, (MOD(NULLVALUE(Sales_PendingTimeStamp__c, CreatedDate)-DATETIMEVALUE(&apos;1996-01-01 00:00:00&apos;), 1)))))), 0)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Hours in &apos;Sales Pending&apos; status</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
