    <fields>
        <fullName>PRM_Record_Link__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot; &amp; Id, &apos;Record Link&apos;, &quot;_self&quot; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Record Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Record_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(PRM_Record_Type_Name_rpt_txt__c == &quot;Account Create Request&quot; &amp;&amp; Ispickval(PRM_Status__c,&quot;Approved&quot;) &amp;&amp; PRM_Auto_Approve_rpt_txt__c == &quot;True&quot;,&quot;Request Auto Approved&quot;,
IF(PRM_Record_Type_Name_rpt_txt__c == &quot;Account Create Request&quot; &amp;&amp; Ispickval(PRM_Status__c,&quot;Approved&quot;) &amp;&amp; PRM_Auto_Approve_rpt_txt__c == &quot;False&quot;,&quot;Request Manual Approved&quot;,
IF(PRM_Record_Type_Name_rpt_txt__c == &quot;Account Create Request&quot; &amp;&amp; Ispickval(PRM_Status__c,&quot;New&quot;),&quot;Pending Approval&quot;,
IF(PRM_Record_Type_Name_rpt_txt__c == &quot;Account Create Request&quot; &amp;&amp; Ispickval(PRM_Status__c,&quot;Rejected&quot;),&quot;Rejected Request&quot;,&quot;Rejected Request&quot;))))</formula>
        <label>Record Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
