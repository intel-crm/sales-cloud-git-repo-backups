        <fullName>PRM_Duration__c</fullName>
        <externalId>false</externalId>
        <formula>TODAY() - DATEVALUE(CreatedDate)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_EV_Expired_vs_Pending__c</fullName>
        <description>EV expired --- True or False (current date &gt; 1 days of the requested date and EV is pending and EV DateTime is null)</description>
        <externalId>false</externalId>
        <formula>IF( (DATEVALUE(PRM_EV_Token_Renewed_Date__c) + 1 &gt; TODAY()) &amp;&amp; ISBLANK(PRM_EmailVerifiedDateTime__c)
 &amp;&amp; (ISPICKVAL(PRM_Email_Verification_Criteria__c , &apos;PENDING&apos;)),&apos;Pending&apos;,&apos;Expired&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>EV Expired vs Pending</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
