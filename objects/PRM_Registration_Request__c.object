    <fields>
        <fullName>Open_to_Approved_Rejected_TPT__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(
FLOOR((5 * ( FLOOR( ( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
)
) &amp; &quot; Day(s) &quot; &amp;
TEXT(
ROUND(MOD(((5 * ( FLOOR( ( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
)*24,24),0)
) &amp;&quot; Hour(s) &quot; &amp;
TEXT(
ROUND(MOD(((5 * ( FLOOR( ( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Approved_Timestamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
)*1440,60),0)
) &amp;&quot; Min(s) &quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Open to Approved/Rejected TPT</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Open_to_Pending_TPT__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(
FLOOR( (5 * ( FLOOR( ( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
)
) &amp; &quot; Day(s) &quot; &amp;
TEXT(
ROUND(MOD(((5 * ( FLOOR( ( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
)*24,24),0)
) &amp;&quot; Hour(s) &quot; &amp;
TEXT(
ROUND(MOD(((5 * ( FLOOR( ( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( Pending_TimeStamp__c - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
-
(5 * ( FLOOR( ( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;) ) / 7 ) ) + MIN( 5, MOD( CreatedDate - DATETIMEVALUE( &quot;1900-01-08 00:00:00&quot;), 7 ) ) )
)*1440,60),0)
) &amp;&quot; Min(s) &quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
