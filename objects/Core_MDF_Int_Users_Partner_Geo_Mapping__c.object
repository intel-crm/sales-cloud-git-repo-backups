    <validationRules>
        <fullName>Core_MDF_Check_WW</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_Retail_Account_Manager&quot;),
ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_Price_Reviewer&quot;),
