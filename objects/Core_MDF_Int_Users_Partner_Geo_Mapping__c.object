    <validationRules>
        <fullName>Core_MDF_CCFDCF_Region_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(ISPICKVAL(Core_MDF_Role_nm__c,&apos;Core_MDF_CCP_Internal_CCF_MDF_Budget_Approver&apos;),ISPICKVAL(Core_MDF_Role_nm__c,&apos;Core_MDF_CCP_Internal_CCF_MDF_Budget_Loader&apos;),ISPICKVAL(Core_MDF_Role_nm__c,&apos;Core_MDF_CCP_Internal_DCF_MDF_Budget_Approver&apos;),ISPICKVAL(Core_MDF_Role_nm__c,&apos;Core_MDF_CCP_Internal_DCF_MDF_Budget_Loader&apos;)),NOT(INCLUDES(Core_MDF_Region_Sub_Region_nm__c,&apos;WW&apos;)))</errorConditionFormula>
