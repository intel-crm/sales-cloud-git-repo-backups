    <label>Internal Users Partner Geo Mapping</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Account_id__c</columns>
        <columns>Core_MDF_Program_nm__c</columns>
        <columns>Core_MDF_Role_nm__c</columns>
        <columns>Core_MDF_Region_Sub_Region_nm__c</columns>
        <columns>Core_MDF_User_id__c</columns>
        <columns>Core_MDF_Active_Ind__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <nameField>
        <displayFormat>IUPGM-{000000}</displayFormat>
        <label>Internal Users Partner Geo Mapping Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Internal Users Partner Geo Mappings</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_CannotUpdateIUPGM</fullName>
        <active>true</active>
        <description>Throws error when user tries to update Account,Program or User</description>
        <errorConditionFormula>AND(
    NOT(ISNEW()),
    OR(
       ISCHANGED(Core_MDF_Account_id__c),
       ISCHANGED(Core_MDF_Program_nm__c),
       ISCHANGED(Core_MDF_User_id__c),
       ISCHANGED(Core_MDF_Role_nm__c)
      )
)</errorConditionFormula>
        <errorMessage>Cannot Update Account/Program/Role/User</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Check_Account</fullName>
        <active>true</active>
        <description>Throws error when All Account selected as No and Account is left Blank.</description>
        <errorConditionFormula>AND(ISNEW(), ISPICKVAL(Core_MDF_All_Accounts_cd__c, &apos;No&apos;),  ISBLANK(Core_MDF_Account_id__c))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account_id__c</errorDisplayField>
        <errorMessage>Please select an Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Check_WW</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_Retail_Account_Manager&quot;),
ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_RMF_Activity_Approver&quot;),
ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_RMF_Activity_Reviewer&quot;),
ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_Retail_Marketing_GEO_Approver&quot;)
),
(INCLUDES(Core_MDF_Region_Sub_Region_nm__c ,&apos;WW&apos;))
)</errorConditionFormula>
        <errorMessage>WW not allowed for any role except Read Only role for Retail.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Do_Not_Select_Account</fullName>
        <active>true</active>
        <description>Throws error when All Account selected as Yes and if Account is entered.</description>
        <errorConditionFormula>AND(ISNEW(), ISPICKVAL(Core_MDF_All_Accounts_cd__c, &apos;Yes&apos;), NOT(ISBLANK(Core_MDF_Account_id__c)))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account_id__c</errorDisplayField>
        <errorMessage>Please leave an Account blank if All Account is selected as Yes.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_SelectOnlyWW</fullName>
        <active>true</active>
        <description>Throws error when other geos are selected along with WW</description>
        <errorConditionFormula>AND(
	INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;WW&apos;),
    CONTAINS($Label.Core_MDF_TechnicalProgramName,TEXT( Core_MDF_Program_nm__c )),
	OR(
		INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;APJ&apos;),
		OR(INCLUDES(Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO&apos;),INCLUDES(Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO-LAR&apos;), INCLUDES(Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO-NAR&apos;)),
		INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;EMEA&apos;),
		INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;PRC&apos;)
	),
	OR(
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_CCF_Acct_Mgr&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_CCFB_Account_Manager&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_DCF_Acct_Mgr&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_SPCF_Acct_Mgr&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Int_Read_Only&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Int_SPCF_Read_Only&quot;)
	)
	
)</errorConditionFormula>
        <errorMessage>No other geos allowed when WW is selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_SelectWWInsteadOfAllGeo</fullName>
        <active>true</active>
        <description>Throws error when all the geos are selected instead of selecting WW</description>
        <errorConditionFormula>AND(
	CONTAINS($Label.Core_MDF_TechnicalProgramName,TEXT( Core_MDF_Program_nm__c )),
	INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;APJ&apos;),
	OR(INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO&apos;),AND(INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO-LAR&apos;), INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO-NAR&apos;))),
	INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;EMEA&apos;),
	INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;PRC&apos;),
	NOT(INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;WW&apos;)),
	OR(
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_CCF_Acct_Mgr&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_CCFB_Account_Manager&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_DCF_Acct_Mgr&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_SPCF_Acct_Mgr&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Int_Read_Only&quot;),
	ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Int_SPCF_Read_Only&quot;)
	)
)</errorConditionFormula>
        <errorMessage>All geos are selected, just grant WW instead.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
