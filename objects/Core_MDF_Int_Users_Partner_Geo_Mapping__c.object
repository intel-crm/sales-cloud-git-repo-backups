OR(
ISPICKVAL(Core_MDF_Role_nm__c,&apos;Core_MDF_CCP_Internal_IPA_Budget_Loader&apos;),
ISPICKVAL(Core_MDF_Role_nm__c,&apos;Core_MDF_CCP_Internal_IPA_Budget_Approver&apos;),
