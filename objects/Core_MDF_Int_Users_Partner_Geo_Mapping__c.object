INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;WW&apos;),
CONTAINS($Label.Core_MDF_TechnicalProgramName,TEXT( Core_MDF_Program_nm__c )),
OR(
INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;APJ&apos;),
OR(INCLUDES(Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO&apos;),INCLUDES(Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO-LAR&apos;), INCLUDES(Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO-NAR&apos;)),
INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;EMEA&apos;),
INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;PRC&apos;)
),
TEXT(Core_MDF_Role_nm__c)&lt;&gt; &apos;Core_MDF_CCP_Internal_Retail_Account_Manager&apos;,
TEXT(Core_MDF_Role_nm__c)&lt;&gt; &apos;Core_MDF_CCP_Internal_RMF_Activity_Approver&apos;,
TEXT(Core_MDF_Role_nm__c) &lt;&gt; &apos;Core_MDF_CCP_Internal_RMF_Activity_Reviewer&apos;,
TEXT(Core_MDF_Role_nm__c) &lt;&gt; &apos;Core_MDF_CCP_RMF_PRC_Claim_Operations&apos;,
TEXT(Core_MDF_Role_nm__c) &lt;&gt; &apos;Core_MDF_CCP_Internal_MDF_Budget_Manager&apos;,
TEXT(Core_MDF_Role_nm__c)&lt;&gt;&apos;Core_MDF_CCP_Internal_Retail_Marketing_GEO_Approver&apos;,
NOT(AND(ISPICKVAL( Core_MDF_Role_nm__c ,&apos;Core_MDF_CCP_Internal_Price_Reviewer&apos;),ISPICKVAL(Core_MDF_Program_nm__c ,&apos;Retail Marketing Funds&apos;)))
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account_id__c</errorDisplayField>
        <errorMessage>No other geos allowed when WW is selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_SelectWWInsteadOfAllGeo</fullName>
        <active>true</active>
        <description>Throws error when all the geos are selected instead of selecting WW</description>
        <errorConditionFormula>AND(
CONTAINS($Label.Core_MDF_TechnicalProgramName,TEXT( Core_MDF_Program_nm__c )),
INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;APJ&apos;),
OR(INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO&apos;),AND(INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO-LAR&apos;), INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;ASMO-NAR&apos;))),
INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;EMEA&apos;),
INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;PRC&apos;),
NOT(INCLUDES( Core_MDF_Region_Sub_Region_nm__c ,&apos;WW&apos;)),
ISNULL(Core_MDF_GeoSubGeo_Budget_Type_nm__c),

OR(
CONTAINS($CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IUPGM_Roles.Core_MDF_Value_Txt__c,TEXT( Core_MDF_Role_nm__c)),
CONTAINS($CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IUPGM_Roles.Core_MDF_Value2_Txt__c,TEXT( Core_MDF_Role_nm__c)),
CONTAINS($CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IUPGM_Roles.Core_MDF_Value3_Txt__c,TEXT( Core_MDF_Role_nm__c)),
CONTAINS($CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IUPGM_Roles.Core_MDF_Value4_Txt__c,TEXT( Core_MDF_Role_nm__c)),
CONTAINS($CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IUPGM_Roles.Core_MDF_Value5_Txt__c,TEXT( Core_MDF_Role_nm__c)),
CONTAINS($CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IUPGM_Roles_2.Core_MDF_Value_Txt__c,TEXT( Core_MDF_Role_nm__c)),
CONTAINS($CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IUPGM_Roles_2.Core_MDF_Value2_Txt__c,TEXT( Core_MDF_Role_nm__c)),
CONTAINS($CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IUPGM_Roles_2.Core_MDF_Value3_Txt__c,TEXT(Core_MDF_Role_nm__c)),
CONTAINS($CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IUPGM_Roles_2.Core_MDF_Value4_Txt__c,TEXT(Core_MDF_Role_nm__c))
),
NOT(AND(ISPICKVAL( Core_MDF_Role_nm__c ,&apos;Core_MDF_CCP_Internal_Price_Reviewer&apos;),ISPICKVAL(Core_MDF_Program_nm__c ,&apos;Retail Marketing Funds&apos;)))
)</errorConditionFormula>
        <errorMessage>All geos are selected, just grant WW instead.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_WWInsteadOfAllGeo_AppRegion</fullName>
        <active>true</active>
        <description>Throws error when all the geos are selected instead of selecting WW</description>
        <errorConditionFormula>AND(
INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;APJ&apos;),
OR(INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;ASMO&apos;),AND(INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;ASMO-LAR&apos;), INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;ASMO-NAR&apos;))),
INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;EMEA&apos;),
INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;PRC&apos;),
NOT(INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;WW&apos;))
)</errorConditionFormula>
        <errorMessage>All geos are selected, just grant WW on Approval Region</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
