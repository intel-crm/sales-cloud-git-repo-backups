INCLUDES(Core_MDF_Region_Sub_Region_nm__c,&apos;EMEA&apos;),
INCLUDES(Core_MDF_Region_Sub_Region_nm__c,&apos;PRC&apos;)
)
),AND(ISPICKVAL( Core_MDF_Program_nm__c ,&quot;Intel Partner Alliance&quot; ),ISPICKVAL( Core_MDF_Role_nm__c ,&quot;Core_MDF_CCP_Internal_Price_Reviewer&quot; ), NOT(INCLUDES( Core_MDF_Region_Sub_Region_nm__c , &quot;WW&quot;)) ),AND(OR(AND(ISPICKVAL( Core_MDF_Program_nm__c ,&quot;Ecosystem Extension Fund&quot; ),
