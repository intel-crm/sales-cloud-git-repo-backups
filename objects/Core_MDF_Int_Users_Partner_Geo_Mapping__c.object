    </validationRules>
    <validationRules>
        <fullName>Core_MDF_COINV_Region_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    OR(
        ISPICKVAL(Core_MDF_Role_nm__c, &apos;Core_MDF_CCP_Internal_Co_Inv_Budget_Loader&apos;),
        ISPICKVAL(Core_MDF_Role_nm__c, &apos;Core_MDF_CCP_Internal_Co_Inv_Budget_Approver&apos;)
    ),
    NOT(
        OR(
            INCLUDES(Core_MDF_Region_Sub_Region_nm__c, &apos;WW&apos;),
            INCLUDES(Core_MDF_GeoSubGeo_Budget_Type_nm__c, &apos;WW-&gt;Co-Investment&apos;)
        )
    )
)</errorConditionFormula>
