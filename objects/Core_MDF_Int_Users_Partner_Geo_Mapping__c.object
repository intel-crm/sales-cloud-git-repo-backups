ISPICKVAL( Core_MDF_Role_nm__c ,&quot;Core_MDF_Internal_EEF_Budget_Manager&quot;)
)),AND(ISPICKVAL( Core_MDF_Program_nm__c ,&quot;CoGTM&quot; ),
OR(ISPICKVAL( Core_MDF_Role_nm__c ,&quot;Core_MDF_CCP_Internal_Co_GTM_Budget_Loader&quot;),
ISPICKVAL( Core_MDF_Role_nm__c ,&quot;Core_MDF_CCP_Internal_Co_GTM_Budget_Approver&quot;),
ISPICKVAL( Core_MDF_Role_nm__c ,&quot;Core_MDF_CCP_Internal_Co_GTM_Budget_Manager&quot;),
ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_Co_GTM_Program_Adm&quot;),
