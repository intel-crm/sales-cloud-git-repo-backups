                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>Core_MDF_CCP_Internal_RMF_Activity_Approver</controllingFieldValue>
                <controllingFieldValue>Core_MDF_CCP_Int_Read_Only</controllingFieldValue>
                <controllingFieldValue>Core_MDF_CCP_Internal_RMF_Activity_Reviewer</controllingFieldValue>
                <controllingFieldValue>Core_MDF_CCP_Int_SPCF_Read_Only</controllingFieldValue>
                <controllingFieldValue>Core_MDF_CCP_Internal_Retail_Marketing_GEO_Approver</controllingFieldValue>
                <valueName>Yes</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Core_MDF_CCP_Internal_CCF_Acct_Mgr</controllingFieldValue>
                <controllingFieldValue>Core_MDF_CCP_Internal_CCFB_Account_Manager</controllingFieldValue>
                <controllingFieldValue>Core_MDF_CCP_Internal_DCF_Acct_Mgr</controllingFieldValue>
                <controllingFieldValue>Core_MDF_CCP_Internal_SPCF_Acct_Mgr</controllingFieldValue>
                <controllingFieldValue>Core_MDF_CCP_Internal_Retail_Account_Manager</controllingFieldValue>
                <valueName>No</valueName>
            </valueSettings>
        </valueSet>
    </fields>
