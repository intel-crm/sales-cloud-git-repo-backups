    <fields>
        <fullName>Core_MDF_AccountIdProgramRoleUserId_txt__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Hold the concatenated value of AccountId + Program + Role + UserId</description>
        <externalId>false</externalId>
        <label>AccountIdProgramRoleUserId</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Account_id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Field to store Account to which the User is associated to</description>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Mastered_Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_CoMarketingActive__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Internal Users Partner Geo Mappings</relationshipLabel>
        <relationshipName>Internal_Users_Partner_Geo_Mappings</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Active_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field indicates if the record is active</description>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_All_Accounts_cd__c</fullName>
        <description>Add users to the geo groups when All Account is selected.</description>
        <label>All Accounts</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
