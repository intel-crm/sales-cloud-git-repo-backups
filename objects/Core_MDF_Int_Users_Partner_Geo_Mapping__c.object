    <validationRules>
        <fullName>Core_MDF_Approval_Region_SelectOnlyWW</fullName>
        <active>true</active>
        <description>Throws error when other geos are selected along with WW</description>
        <errorConditionFormula>AND(
NOT(ISBLANK(Core_MDF_Approval_Region_nm__c)),
INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;WW&apos;),
OR(
INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;APJ&apos;),
OR(INCLUDES(Core_MDF_Approval_Region_nm__c ,&apos;ASMO&apos;),INCLUDES(Core_MDF_Approval_Region_nm__c ,&apos;ASMO-LAR&apos;), INCLUDES(Core_MDF_Approval_Region_nm__c ,&apos;ASMO-NAR&apos;)),
INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;EMEA&apos;),
INCLUDES( Core_MDF_Approval_Region_nm__c ,&apos;PRC&apos;)
)
)</errorConditionFormula>
