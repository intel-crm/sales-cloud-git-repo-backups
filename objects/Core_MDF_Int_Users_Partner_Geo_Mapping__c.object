        <fullName>Core_MDF_Account_Name_txt__c</fullName>
        <description>Displays the Account Name from the Account lookup field.</description>
        <externalId>false</externalId>
        <formula>Core_MDF_Account_id__r.Name</formula>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Account_id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Field to store Account to which the User is associated to</description>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 AND 2) OR (3 AND 4 AND 5 AND 6) OR (1 AND 4 AND 7)</booleanFilter>
            <filterItems>
                <field>Account.Core_MDF_CoMarketingActive__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Program_nm__c</field>
                <operation>equals</operation>
                <value>Client, Client Co-Marketing Fund Boost, Intel Partner Alliance, Service Provider Co-Marketing Fund, Ecosystem Extension Fund, Datacenter, Co-GTM, Co-Inv</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Co_Marketing</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Program_nm__c</field>
                <operation>equals</operation>
                <value>Retail Marketing Funds</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</field>
                <operation>equals</operation>
                <value>Retail Marketing Funds</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Role_nm__c</field>
                <operation>notEqual</operation>
                <value>CCP Internal Price Reviewer, CCP Internal Read Only</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Role_nm__c</field>
                <operation>equals</operation>
                <value>CCP Internal Price Reviewer, CCP Internal Read Only</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Internal Users Partner Geo Mappings</relationshipLabel>
        <relationshipName>Internal_Users_Partner_Geo_Mappings</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
