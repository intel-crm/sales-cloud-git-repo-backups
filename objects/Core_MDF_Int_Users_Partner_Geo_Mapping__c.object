ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Internal_Co_GTM_Technical_Approver&quot;)
))),NOT(INCLUDES( Core_MDF_Region_Sub_Region_nm__c , &quot;WW&quot;))))</errorConditionFormula>
        <errorMessage>Region - Sub Region:  Please select only WW for this role.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventBTselectionforIPA</fullName>
        <active>true</active>
        <description>Validation rule to restrict the users to select the Budgettype for IPA price reviewer and Escalation reviewer L1</description>
        <errorConditionFormula>AND(ISPICKVAL( Core_MDF_Program_nm__c ,&quot;Intel Partner Alliance&quot; ),
