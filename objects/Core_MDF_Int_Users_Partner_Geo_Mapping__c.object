    <validationRules>
        <fullName>Core_MDF_CannotUpdateIUPGM</fullName>
        <active>true</active>
        <description>Throws error when user tries to update Account,Program or User</description>
        <errorConditionFormula>AND(
    NOT(ISNEW()),
    OR(
       ISCHANGED(Core_MDF_Account_id__c),
       ISCHANGED(Core_MDF_Program_nm__c),
       ISCHANGED(Core_MDF_User_id__c),
ISCHANGED(Core_MDF_Role_nm__c),
ISCHANGED(Core_MDF_All_Accounts_cd__c )
    )
)</errorConditionFormula>
        <errorMessage>Cannot Update Account/Program/Role/User/All Accounts. Please deactivate and create new.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Check_Account</fullName>
        <active>true</active>
        <description>Throws error when All Account selected as No and Account is left Blank.</description>
        <errorConditionFormula>AND(ISNEW(), ISPICKVAL(Core_MDF_All_Accounts_cd__c, &apos;No&apos;),  ISBLANK(Core_MDF_Account_id__c),
NOT(AND(
ISPICKVAL(Core_MDF_Program_nm__c,&quot;Retail Marketing Funds&quot;),
ISPICKVAL(Core_MDF_Role_nm__c,&quot;Core_MDF_CCP_Int_Read_Only&quot;)
))

)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account_id__c</errorDisplayField>
        <errorMessage>Please select an Account.</errorMessage>
