        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Customer_Value__c</fullName>
        <description>Customer perceived value for the metric</description>
        <inlineHelpText>Customer perceived performance for the metric</inlineHelpText>
        <label>Customer Value</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1 - High</fullName>
                    <default>false</default>
                    <label>1 - High</label>
                </value>
                <value>
                    <fullName>2 - Medium</fullName>
                    <default>false</default>
                    <label>2 - Medium</label>
                </value>
                <value>
                    <fullName>3 - Low</fullName>
                    <default>false</default>
                    <label>3 - Low</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Intel_Performance_HIGH__c</fullName>
        <description>Intel perceived performance HIGH value metric</description>
        <inlineHelpText>Intel perceived performance HIGH value metric (rightmost column in Value Map)</inlineHelpText>
        <label>HIGH - Intel Performance</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_Intel_Performance_LOW__c</fullName>
        <description>Intel perceived performance LOW value metric</description>
        <inlineHelpText>Intel perceived performance LOW value metric (leftmost column in Value Map)</inlineHelpText>
        <label>LOW - Intel Performance</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_Intel_Performance_MED__c</fullName>
        <description>Intel perceived performance MEDIUM value metric</description>
        <inlineHelpText>Intel perceived performance MEDIUM value metric (middle column in Value Map)</inlineHelpText>
        <label>MED - Intel Performance</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Assigned__c</fullName>
        <formula>ISBLANK(Core_CCV__r.Core_Opportunity__c) = FALSE</formula>
        <label>Opportunity Assigned</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
