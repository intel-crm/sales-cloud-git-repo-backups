    <validationRules>
        <fullName>Core_Customer_Value</fullName>
        <active>true</active>
        <description>Non-blank value</description>
        <errorConditionFormula>AND (
ISBLANK(TEXT(Core_Customer_Value__c))
)</errorConditionFormula>
        <errorMessage>Make edits to existing Value Map records:  1 - High; 2 - Medium; 3 - Low.</errorMessage>
    </validationRules>
