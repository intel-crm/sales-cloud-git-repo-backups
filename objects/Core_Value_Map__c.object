        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_CCV__c</fullName>
        <label>CCV</label>
        <referenceTo>Core_CCV__c</referenceTo>
        <relationshipLabel>Value Maps</relationshipLabel>
        <relationshipName>Value_Maps</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
