        <fullName>PSS_Assigned_Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field used to store the assigned contact Name</description>
        <label>Assigned Contact</label>
        <referenceTo>Contact</referenceTo>
