    <fields>
        <fullName>Core_Design_Product_Status_Nm__c</fullName>
        <description>The status values which drive the Design Registration Product through the process.  Valid values are: Pending,Approved, Rejected,Cancelled, Retired.</description>
        <inlineHelpText>The status values which drive the Design Registration Product through the process.  Valid values are: Pending, Approved, Rejected, Cancelled.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>Retired</fullName>
                    <default>false</default>
                    <label>Retired</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Design_Registration_Id__c</fullName>
        <description>This is the line item&apos;s Parent Design Registration Record.</description>
        <inlineHelpText>This is the Design Registration Product&apos;s Parent Design Registration record.</inlineHelpText>
        <label>Design Registration</label>
        <referenceTo>Core_Design_Registration__c</referenceTo>
        <relationshipLabel>Design Registration Products</relationshipLabel>
        <relationshipName>Design_Registration_Line_Items</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Design_Registration_Line_Id__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>false</externalId>
        <label>System Design Registration Line ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_Design_Registration_Stage_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
