    </fields>
    <fields>
        <fullName>Core_Full_Year_Qty__c</fullName>
        <externalId>false</externalId>
        <label>Quantity (Full Production Year)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Full_Year_Value_Amt__c</fullName>
        <formula>Core_Full_Year_Qty__c * Core_Target_Resale_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Value (Full Production Year)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_Intel_Technical_Owner_Email_Txt__c</fullName>
        <description>Captures the email of the DR&apos;s tech owner upon cancellation (workflow updates this field). Used to send email notification to Intel Tech Owner.</description>
        <externalId>false</externalId>
        <label>Intel Technical Owner Mail</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Locked_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Should be set to TRUE once the DR has been converted to Opportunity.</description>
        <label>Locked</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Product_Id__c</fullName>
        <externalId>false</externalId>
        <label>Opportunity Product Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Partner_Tracking_Cd__c</fullName>
        <description>This captures the unique identifier assigned to the registration by the Disti.  It is also used (along with the Intel assigned DR #) to determine whether an incoming DR is a new, update to existing or duplicate record</description>
        <externalId>false</externalId>
        <inlineHelpText>Unique identifier assigned to the registration by the Distributor.</inlineHelpText>
        <label>Partner Tracking Number</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Product_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This is the eligible product that is a part of this DDR.</description>
        <inlineHelpText>This is the eligible product that is a part of this Design Registration.</inlineHelpText>
        <label>Product</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Product2.Core_Design_Registration_Eligible_Ind__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Product2.IsActive</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Product2.Core_Sales_Visible_Flag__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Design Registration Products</relationshipLabel>
        <relationshipName>Design_Registration_Line_Items</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Retired_As_Of_Dt__c</fullName>
        <description>This is the date through which orders placed for the products in this Design are eligible for higher margins.</description>
        <inlineHelpText>This is the date through which orders placed for the products in this Design are eligible for higher margins.</inlineHelpText>
        <label>Retired As Of</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Target_Resale_Amt__c</fullName>
        <description>Same as Sales Price on Oppty Line</description>
        <label>Target Resale Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <label>Design Registration Product</label>
    <nameField>
        <displayFormat>DR-PROD-{YYYY}{MM}{DD}-{0000000}</displayFormat>
        <label>Design Registration Line ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Design Registration Products</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_Approve_Product</fullName>
        <availability>online</availability>
        <description>Approves the Product after data validation.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Approve Product</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>// Library
{!REQUIRESCRIPT(&apos;/soap/ajax/37.0/connection.js&apos;)}

// Check if the Design Registraion Product is already Approved
if (&apos;{!Core_Design_Registration_Product__c.Core_Design_Product_Status_Nm__c}&apos; == &apos;Approved&apos;) {
    alert(&apos;Design Registration Product is already Approved.&apos;);
}

// Check if the Product is locked
else if (&apos;{!Core_Design_Registration_Product__c.Core_Locked_Ind__c}&apos; == true) {
    alert(&apos;This Product is locked and can only be Cancelled.&apos;);
}

// Approve the Design Registraion Product
else {
    var designRegProduct = new sforce.SObject(&quot;Core_Design_Registration_Product__c&quot;);
    designRegProduct.Id = &quot;{!Core_Design_Registration_Product__c.Id}&quot;;
    designRegProduct.Core_Design_Product_Status_Nm__c = &apos;Approved&apos;;

    // Save the Design Registraion Product object
    var result = sforce.connection.update([designRegProduct]);
    if (result[0].getBoolean(&quot;success&quot;)) {
        alert(&apos;Design Registration Product Approved successfully.&apos;);
        window.location.reload();
    }
    else {
        alert(&quot;An error has occurred! Error: &quot; + result[0].errors.message);
    }
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Approve_Products_Pending</fullName>
        <availability>online</availability>
        <description>Approves all the Pending Products after data validation.</description>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Approve All Pending Products</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>// Library 
{!REQUIRESCRIPT(&apos;/soap/ajax/37.0/connection.js&apos;)}

// Get the list of Pending products
var result = sforce.connection.query(&quot;SELECT Id FROM Core_Design_Registration_Product__c WHERE Core_Design_Registration_Id__c =&apos;{!Core_Design_Registration__c.Id}&apos; AND Core_Design_Product_Status_Nm__c = &apos;Pending&apos; AND Core_Locked_Ind__c = false&quot;);

// Check if there are any Pending products
if (result.size == 0) {
    alert(&apos;There are no pending products on this Design Registration to Approve.&apos;);
}

// Approve all Pending Products
else {
    var records = result.getArray(&quot;records&quot;);
    for (var i = 0; i &lt; records.length; i++) {
        records[i].Core_Design_Product_Status_Nm__c = &apos;Approved&apos;;
    }

    // Save the Design Registration Product objects
    var result = sforce.connection.update(records);
    if (result[0].getBoolean(&quot;success&quot;)) {
        alert(records.length + &apos; &apos; + &apos;Pending Design Registration Products Approved successfully.&apos;);
        window.location.reload();
    }
    else {
        alert(&quot;An error has occurred! Error: &quot; + result[0].errors.message);
    }
}</url>
    </webLinks>
