    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_Enter_Comments_for_Rejection</fullName>
        <active>false</active>
        <description>Enter the comments for rejection</description>
        <errorConditionFormula>AND(
  ISPICKVAL(Core_Design_Product_Status_Nm__c, &apos;Rejected&apos;),
  ISBLANK(Core_Comment_Txt__c)
)</errorConditionFormula>
        <errorDisplayField>Core_Comment_Txt__c</errorDisplayField>
        <errorMessage>Please enter the comments for rejection</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DDR_Product_Not_Available_for_New_Design</fullName>
        <active>false</active>
        <description>This rule will be fired when product is not available for new design</description>
        <errorConditionFormula>NOT(Core_Product_Id__r.Core_Avail_for_New_Designs__c)</errorConditionFormula>
        <errorDisplayField>Core_Product_Id__c</errorDisplayField>
        <errorMessage>This Product is not available for Design Submission</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DDR_Product_validation_Message</fullName>
        <active>false</active>
        <errorConditionFormula>AND(NOT(CONTAINS(RecordType.Name, &apos;Deal&apos;)),
OR(ISCHANGED(Core_Product_Id__c),
ISCHANGED( MMID_or_Ordering_code__c)),
NOT(ISNULL( Core_Product_Id__c)),
TEXT(Core_Design_Product_Status_Nm__c) ==&apos;Pending&apos;,
NOT($Permission.PCC_Bypass_Automation),
NOT(AND(ISPICKVAL( Core_Design_Registration_Id__r.Core_Submission_Type__c,&apos;M2M&apos;) ,  ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c,&apos;Draft&apos;)))
)</errorConditionFormula>
        <errorDisplayField>Core_Product_Id__c</errorDisplayField>
        <errorMessage>Editing the product is not allowed. If you want to make changes, please cancel the current product and submit a new one.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Design_Check</fullName>
        <active>false</active>
        <errorConditionFormula>OR(ISPICKVAL(Core_Design_Registration_Id__r.Core_Opportunity_Id__r.StageName,&apos;Design Win&apos;),ISPICKVAL(Core_Design_Registration_Id__r.Core_Opportunity_Id__r.StageName,&apos;Production Win&apos;))</errorConditionFormula>
        <errorMessage>Product cannot be added as opportunity is in the win state. Update for Portal and M2M</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>EmbeddedIOTrule</fullName>
        <active>false</active>
        <errorConditionFormula>AND( Core_Design_Registration_Id__r.PCC_Registration_Type__c = &apos;Design Registration&apos;,
ISPICKVAL( Core_Design_Registration_Id__r.Core_Product_Group_Nm__c ,&apos;Embedded/IOT&apos;),
NOT( OR( ISPICKVAL( Core_Design_Registration_Id__r.Core_Product_Segment_Nm__c ,
&apos;Embedded / IOT&apos;),
ISPICKVAL(Core_Design_Registration_Id__r.Core_Product_Segment_Nm__c,
&apos;Comms Infra. / Networking&apos;))),
NOT(ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c,&apos;Approved&apos;)),
NOT( $Permission.PCC_Bypass_Automation ))</errorConditionFormula>
        <errorMessage>wrong product segment value on DR</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Competitor_System_Model_is_Required</fullName>
        <active>true</active>
        <description>Competitor System Model is Required if it is Deal and product is FIN Eligible</description>
        <errorConditionFormula>AND(Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;,          INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),  ISBLANK(PCC_Competitor_System_Model__c),NOT( $Permission.PCC_Bypass_Automation ))</errorConditionFormula>
        <errorDisplayField>PCC_Competitor_System_Model__c</errorDisplayField>
        <errorMessage>Required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Deal_Product_Edit_Validation_Rule</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISCHANGED(PCC_Product_Additional_Attribute__c),
TEXT(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c) ==&apos;DRAFT&apos;,
NOT(ISBLANK(Core_Design_Registration_Id__r.Core_Accepted_By_Id__c))
)</errorConditionFormula>
        <errorDisplayField>PCC_Product_Additional_Attribute__c</errorDisplayField>
        <errorMessage>Editing the Deal product is not allowed. If you want to make changes, please delete the current product and submit a new one.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Deal_Product_Restriction</fullName>
        <active>true</active>
        <description>Deal Product Restriction when opportunity is submitted for approval and lost/cancelled oppty</description>
        <errorConditionFormula>AND ( 
	ISNEW(),
	NOT($Permission.PCC_Bypass_Automation),
	Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, NOT(ISBLANK(Core_Design_Registration_Id__r.Core_Opportunity_Id__c)),
	OR(
		
		ISPICKVAL(Core_Design_Registration_Id__r.Core_Opportunity_Id__r.StageName,&apos;Lost&apos;), 
		ISPICKVAL(Core_Design_Registration_Id__r.Core_Opportunity_Id__r.StageName,&apos;Cancelled&apos;),
		AND(
			NOT(ISPICKVAL(Core_Design_Registration_Id__r.Core_Opportunity_Id__r.Core_Approval_Status__c,&apos;Not Submitted&apos;)),
			NOT(ISPICKVAL(Core_Design_Registration_Id__r.Core_Opportunity_Id__r.Core_Approval_Status__c,&apos;Recalled&apos;)),
                        NOT(ISPICKVAL(Core_Design_Registration_Id__r.Core_Opportunity_Id__r.Core_Approval_Status__c,&apos;Rejected&apos;))
		)
	)
)</errorConditionFormula>
        <errorMessage>Products cannot be added at this stage, Opportunity is already sent for approval/lost/cancelled.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Deal_Product_is_required</fullName>
        <active>true</active>
        <description>Deal Product is Required if it is Deal</description>
        <errorConditionFormula>AND(Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, ISBLANK( PCC_Product_Additional_Attribute__c ),NOT( $Permission.PCC_Bypass_Automation ))</errorConditionFormula>
        <errorDisplayField>PCC_Product_Additional_Attribute__c</errorDisplayField>
        <errorMessage>Required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Deal_Product_shoud_be_active</fullName>
        <active>false</active>
        <description>Deal Product should be active if deal and Fin Eligible</description>
        <errorConditionFormula>AND(Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;,  NOT(PCC_Product_Additional_Attribute__r.Is_Product_Active__c ),
NOT(ISPICKVAL(Core_Design_Product_Status_Nm__c,&apos;Rejected&apos;)),NOT( $Permission.PCC_Bypass_Automation ))</errorConditionFormula>
        <errorDisplayField>PCC_Product_Additional_Attribute__c</errorDisplayField>
        <errorMessage>Inactive Product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Form_Factor_is_Required</fullName>
        <active>false</active>
        <description>Form Factor is Required if it is deal and Fin Eligible</description>
        <errorConditionFormula>AND(Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;,          INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),  ISBLANK(  TEXT(PCC_Form_Factor__c )),NOT( $Permission.PCC_Bypass_Automation ))</errorConditionFormula>
        <errorDisplayField>PCC_Form_Factor__c</errorDisplayField>
        <errorMessage>Required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Pricing_StartEndDate_Edit_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;,
OR(ISCHANGED(PCC_Quote_Line_Pricing_Start_Date__c),ISCHANGED(PCC_Quote_Line_Pricing_End_Date__c)),
TEXT(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c)==&apos;Draft&apos;,
TEXT(Core_Design_Product_Status_Nm__c)&lt;&gt;&apos;Pending&apos;,
NOT($Permission.PCC_Bypass_Automation))</errorConditionFormula>
        <errorMessage>Updating of Pricing Start / End Date is not allowed for Approved / Rejected / Cancelled Product  Line Item.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Pricng_end_date_future</fullName>
        <active>true</active>
        <description>Quote Line Pricing End Date in the future.</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
PCC_Quote_Line_Pricing_End_Date__c&lt;today(),
NOT( $Permission.PCC_Bypass_Automation ),
NOT(ISPICKVAL(Core_Design_Product_Status_Nm__c,&apos;Rejected&apos;)))</errorConditionFormula>
        <errorDisplayField>PCC_Quote_Line_Pricing_End_Date__c</errorDisplayField>
        <errorMessage>Quote Line Pricing End Date must be on/prior to the current date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Quote_Enddate_Lessthan_Pricing</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(PCC_Change_Requested__c),
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;,
PCC_Quote_Line_Pricing_End_Date__c &gt; Core_Design_Registration_Id__r.PCC_Pricing_End_Date__c ,
NOT( $Permission.PCC_Bypass_Automation ),
NOT(ISPICKVAL(Core_Design_Product_Status_Nm__c,&apos;Rejected&apos;)),
NOT(OR(
ISPICKVAL( Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c ,&apos;Approved&apos;),
ISPICKVAL( Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c,&apos;Re-Submitted&apos;)))
)</errorConditionFormula>
        <errorDisplayField>PCC_Quote_Line_Pricing_End_Date__c</errorDisplayField>
        <errorMessage>Quote Line End Date should be on/before Deal Reg Pricing End Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Quote_Startdate_Greaterthan_Pricing</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(PCC_Change_Requested__c),
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;,
OR(Core_Design_Registration_Id__r.PCC_Pricing_End_Date__c &lt; PCC_Quote_Line_Pricing_Start_Date__c ,
PCC_Quote_Line_Pricing_Start_Date__c &lt;  Core_Design_Registration_Id__r.PCC_Pricing_Start_Date__c ),
NOT( $Permission.PCC_Bypass_Automation ), 
NOT(ISPICKVAL(Core_Design_Product_Status_Nm__c,&apos;Rejected&apos;)),
NOT(OR( 
ISPICKVAL( Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c ,&apos;Approved&apos;),
ISPICKVAL( Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c,&apos;Re-Submitted&apos;)))
)</errorConditionFormula>
        <errorDisplayField>PCC_Quote_Line_Pricing_Start_Date__c</errorDisplayField>
        <errorMessage>Quote Line Pricing Start Date should be between Deal Reg Pricing Start Date/End Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_RestrictDRP_DRIdEdit</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISNEW(),
     ISCHANGED(Core_Design_Registration_Id__c)
)</errorConditionFormula>
        <errorDisplayField>Core_Design_Registration_Id__c</errorDisplayField>
        <errorMessage>This Value is changed. Please do not edit this value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Restrict_Partners_from_Save_New</fullName>
        <active>false</active>
        <description>Restrict the Partners to click on Save &amp; New Button after Submission of DR.</description>
        <errorConditionFormula>AND (
$Profile.Name = &apos;Partner&apos;,
NOT(ISNEW()),
NOT($Permission.PCC_Bypass_Automation),
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;,
NOT(ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c,&apos;Draft&apos;))
)</errorConditionFormula>
        <errorMessage>Partners cannot add/modify DRP at this stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_System_Model_is_Required</fullName>
        <active>true</active>
        <description>System Model	is Required if deal and Fin Eligible</description>
        <errorConditionFormula>AND(Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;), ISBLANK( PCC_System_Model__c ),NOT( $Permission.PCC_Bypass_Automation ))</errorConditionFormula>
        <errorDisplayField>PCC_System_Model__c</errorDisplayField>
        <errorMessage>Required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_Update_Pricing_Start_End_Date_Blank</fullName>
        <active>false</active>
        <errorConditionFormula>AND(Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),OR(ISNULL(PCC_Quote_Line_Pricing_Start_Date__c ) ,ISBLANK(PCC_Quote_Line_Pricing_End_Date__c )))</errorConditionFormula>
        <errorDisplayField>PCC_Additional_Comments__c</errorDisplayField>
        <errorMessage>Quote Line Pricing Start Date/Quote Line Pricing End Date is required for Fin eligible product.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_ValidationOnCompetitorProduct</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISNEW(),OR(PCC_Competitor_Product__r.RecordType.DeveloperName &lt;&gt; &apos;Pricing_Client&apos;,  PCC_Competitor_Product__r.Pricing_Active_cb__c = FALSE),CONTAINS(  RecordType.DeveloperName , &apos;Deal&apos;),NOT( $Permission.PCC_Bypass_Automation ) )</errorConditionFormula>
        <errorDisplayField>PCC_Competitor_Product__c</errorDisplayField>
        <errorMessage>Check the status or record type of the product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_ValidationOnProductEligibility</fullName>
        <active>true</active>
        <description>This validation will fire for M2M and Portal , when when product is not available for new design or not DR eligible or Sales Eligible.</description>
        <errorConditionFormula>IF(
    OR(RecordType.Name == &apos;Design Registration Product - Locked&apos;,$Permission.PCC_Bypass_Automation,Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;),
    false,
	
    IF(
	    ISPICKVAL(Core_Design_Product_Status_Nm__c, &apos;Rejected&apos;),
        false,
		
        IF(
		AND(ISNEW(),	OR(
					NOT(Core_Product_Id__r.Core_Avail_for_New_Designs__c),
					NOT(Core_Product_Id__r.Core_Design_Registration_Eligible_Ind__c),
					NOT(Core_Product_Id__r.Core_Sales_Visible_Flag__c)
				)),
				
            IF(NOT(ISBLANK(Core_Comment_Txt__c)) &amp;&amp; ISCHANGED(Core_Comment_Txt__c),false, true ),
			
            false
            
        )
    )
)</errorConditionFormula>
        <errorDisplayField>Core_Product_Id__c</errorDisplayField>
        <errorMessage>This Product is not eligible for DR submission.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_WriteInComProd_Name_req_if_selected</fullName>
        <active>true</active>
        <description>Write in Competitive Product name needs to be provided when the Competitor Product is Write In Product</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
PCC_Competitor_Product__r.Name= &apos;Write In Product&apos;,
ISBLANK(PCC_Write_In_Competitor_Product__c) ,
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorDisplayField>PCC_Write_In_Competitor_Product__c</errorDisplayField>
        <errorMessage>Write in Competitive Product name needs to be provided when the Competitor Product is Write In Product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_WriteInCom_OEMName_req_if_selected</fullName>
        <active>true</active>
        <description>The Write In Competitor OEM Field is used to provide the name of a 
product missing from the Competitor OEM Name field. It must be blank 
unless the &apos;Competitor Write In OEM Name&apos; option is selected in the OEM Name field.</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
ISPICKVAL( PCC_Competitor_OEM_Name__c , &apos;Write In Competitor OEM Name&apos;),
ISBLANK(   PCC_Competitor_Write_In_OEM_Name__c ) ,
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorDisplayField>PCC_Competitor_Write_In_OEM_Name__c</errorDisplayField>
        <errorMessage>When &apos;Write In Competitor OEM Name&apos; is selected in the Competitor OEM Name field, the name of the unlisted Competitor OEM Name must be provided in the Write In Competitor OEM Name field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_WriteInCom_Product_Restrict</fullName>
        <active>true</active>
        <description>The Write In Competitor OEM Field is used to provide the name of a 
product missing from the Competitor OEM Name field. It must be blank 
unless the &apos;Competitor Write In OEM Name&apos; option is selected in the OEM Name field.</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
NOT(ISPICKVAL( PCC_Competitor_OEM_Name__c , &apos;Write In Competitor OEM Name&apos;)),
NOT(ISBLANK(   PCC_Competitor_Write_In_OEM_Name__c )),
NOT( $Permission.PCC_Bypass_Automation) 
)</errorConditionFormula>
        <errorDisplayField>PCC_Competitor_Write_In_OEM_Name__c</errorDisplayField>
        <errorMessage>The Write In Competitor OEM Name field is used to provide the name of a Competitor OEM missing from the Competitor OEM Name field. It must be blank unless the &apos; Write In Competitor OEM Name&apos; option is selected in the Competitor OEM Name field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_WriteInComp_Prod_Restrict</fullName>
        <active>true</active>
        <description>Write In Competitor Product needs to be provided with a value only when the Competitor Product is set with Write in Product</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
NOT(PCC_Competitor_Product__r.Name = &apos;Write In Product&apos;),
NOT(ISBLANK(  PCC_Write_In_Competitor_Product__c  )),
NOT( $Permission.PCC_Bypass_Automation) 
)</errorConditionFormula>
        <errorDisplayField>PCC_Write_In_Competitor_Product__c</errorDisplayField>
        <errorMessage>The Write In Competitor Product field is used to provide the name of a product missing from the Competitor Product field. It must be blank unless the &apos;Write In Product&apos; option is selected in the Competitor Product field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_WriteInOEM_Name_req_if_selected</fullName>
        <active>true</active>
        <description>When &apos;Write In OEM Name&apos; is selected in the OEM Name field, the name
 of the unlisted OEM Name must be provided in the Write In OEM Name field.</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
ISPICKVAL(PCC_OEM_Name__c , &apos;Write In OEM Name&apos;),
ISBLANK( PCC_Write_In_OEM_Name__c ) ,
NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorDisplayField>PCC_Write_In_OEM_Name__c</errorDisplayField>
        <errorMessage>When &apos;Write In OEM Name&apos; is selected in the OEM Name field, the name of the unlisted OEM Name must be provided in the Write In OEM Name field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_WriteInOEM_Restrict</fullName>
        <active>true</active>
        <description>The Write In OEM Field must be blank unless the &apos;Write In OEM Name&apos; option is selected in the OEM Name field.</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
NOT(ISPICKVAL(PCC_OEM_Name__c , &apos;Write In OEM Name&apos;)),
NOT(ISBLANK( PCC_Write_In_OEM_Name__c )),NOT( $Permission.PCC_Bypass_Automation )
)</errorConditionFormula>
        <errorDisplayField>PCC_Write_In_OEM_Name__c</errorDisplayField>
        <errorMessage>The Write In OEM Name field is used to provide the name of an OEM missing from the OEM Name field. It must be blank unless the &apos;Write In OEM Name&apos; option is selected in the OEM Name field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_end_dt_cant_be_mor_thn_hdr_strt</fullName>
        <active>true</active>
        <description>Quote Line Pricing End Date should not be earlier than the Deal Reg Header Start Date</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
    PCC_Quote_Line_Pricing_End_Date__c &lt;   Core_Design_Registration_Id__r.PCC_Pricing_Start_Date__c ,NOT( $Permission.PCC_Bypass_Automation ),
NOT(ISPICKVAL(Core_Design_Product_Status_Nm__c,&apos;Rejected&apos;)) )</errorConditionFormula>
        <errorDisplayField>PCC_Quote_Line_Pricing_End_Date__c</errorDisplayField>
        <errorMessage>Quote Line Pricing End Date should not be earlier than the Deal Reg Start Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_start_dt_cant_be_mor_thn_hdr_end</fullName>
        <active>false</active>
        <description>Quote Line Pricing Start Date should not be after than the Deal Reg End Date</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;,
INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
Core_Design_Registration_Id__r.PCC_Pricing_End_Date__c &lt;  PCC_Quote_Line_Pricing_Start_Date__c ,
NOT( $Permission.PCC_Bypass_Automation ),
NOT(ISPICKVAL(Core_Design_Product_Status_Nm__c,&apos;Rejected&apos;))
 )</errorConditionFormula>
        <errorDisplayField>PCC_Quote_Line_Pricing_Start_Date__c</errorDisplayField>
        <errorMessage>Quote Line  Pricing Start Date should not be earlier than the Deal Reg Header End Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_strt_Dt_cant_be_mor_thn_end_dt</fullName>
        <active>true</active>
        <description>Quote Line Pricing Start Date cannot be more than Quote Line Pricing End Date</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
    PCC_Quote_Line_Pricing_Start_Date__c &gt;  PCC_Quote_Line_Pricing_End_Date__c,NOT( $Permission.PCC_Bypass_Automation ),
NOT(ISPICKVAL(Core_Design_Product_Status_Nm__c,&apos;Rejected&apos;)) )</errorConditionFormula>
        <errorDisplayField>PCC_Quote_Line_Pricing_Start_Date__c</errorDisplayField>
        <errorMessage>Quote Line Pricing Start Date cannot be more than Quote Line Pricing End Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PCC_strt_Dt_cant_be_mor_thn_today</fullName>
        <active>true</active>
        <description>Quote Line Pricing Start Date must be today or later.</description>
        <errorConditionFormula>AND(
Core_Design_Registration_Id__r.PCC_Registration_Type__c =&apos;Deal Registration&apos;, INCLUDES(PCC_Product_Additional_Attribute__r.Programs_Eligible__c ,&apos;PDI&apos;),
    PCC_Quote_Line_Pricing_Start_Date__c &lt; today(),
NOT( $Permission.PCC_Bypass_Automation ),
NOT(ISPICKVAL(Core_Design_Product_Status_Nm__c,&apos;Rejected&apos;)))</errorConditionFormula>
        <errorDisplayField>PCC_Quote_Line_Pricing_Start_Date__c</errorDisplayField>
        <errorMessage>Quote Line Pricing Start Date must be on/after the current date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Product_selection_error_message</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT($Permission.PCC_Bypass_Automation),
OR(
AND(
NOT(ISBLANK(Core_Product_Id__c)),
NOT(ISBLANK(MMID_or_Ordering_code__c)),
Core_ThrowValidation__c

),
AND(
ISBLANK(Core_Product_Id__c),
ISBLANK(MMID_or_Ordering_code__c),
Core_ThrowValidation__c),
ISCHANGED(Core_Product_Id__c)
),
NOT(  $Permission.DDR_PreApprover_Permission )
)</errorConditionFormula>
        <errorMessage>Please select product from product dropdown or please provide valid MMID or Ordering code</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_new_addition_of_new_product</fullName>
        <active>false</active>
        <description>Restrict create/update product if Design registration status is cancelled or rejected or abandoned</description>
        <errorConditionFormula>AND( NOT(Core_Locked_Ind__c),
NOT(AND(OR( $Permission.DDR_Internal_Users , $Permission.DDR_PreApprover_Permission ),ISCHANGED(Core_Comment_Txt__c),NOT(ISCHANGED(Core_Design_Product_Status_Nm__c)))),
OR(ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c,&apos;Cancelled&apos;),
ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c,&apos;Rejected&apos;),
ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c,&apos;Abandoned&apos;),




AND(OR($Profile.Name = &apos;Partner&apos;),OR(ISCHANGED(Core_Target_Resale_Amt__c),ISCHANGED(Core_Full_Year_Qty__c), ISCHANGED(Core_Partner_Tracking_Cd__c), OR(ISCHANGED(Core_Product_Id__c))),

OR(
ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c, &apos;Design accepted&apos;),
ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c, &apos;Re-Submitted&apos;),
ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c, &apos;Pre-Approved&apos;),
ISPICKVAL(Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c, &apos;Submitted&apos;)
),

OR(
ISPICKVAL(PRIORVALUE(Core_Design_Product_Status_Nm__c), &apos;Approved&apos;),
ISPICKVAL(PRIORVALUE(Core_Design_Product_Status_Nm__c), &apos;Rejected&apos;),
ISPICKVAL(PRIORVALUE(Core_Design_Product_Status_Nm__c), &apos;Cancelled&apos;),
ISPICKVAL(PRIORVALUE(Core_Design_Product_Status_Nm__c), &apos;Retired&apos;)
)
)),
NOT( $Permission.PCC_Bypass_Automation )

)</errorConditionFormula>
        <errorMessage>Products cannot be added or edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_products_with_Zero_Qty</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT( Core_Full_Year_Qty__c &gt;0),NOT( $Permission.PCC_Bypass_Automation ))</errorConditionFormula>
        <errorDisplayField>Core_Full_Year_Qty__c</errorDisplayField>
        <errorMessage>Quantity must be greater than zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>approve_all_test</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL( Core_Design_Product_Status_Nm__c ,&apos;Approved&apos;), $Permission.DDR_Read_Only )</errorConditionFormula>
        <errorMessage>Cannot approve</errorMessage>
    </validationRules>
