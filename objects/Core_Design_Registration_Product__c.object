    <fields>
        <fullName>Core_Partner_Tracking_Cd__c</fullName>
        <description>This captures the unique identifier assigned to the registration by the Disti.  It is also used (along with the Intel assigned DR #) to determine whether an incoming DR is a new, update to existing or duplicate record</description>
        <externalId>false</externalId>
        <inlineHelpText>Unique identifier assigned to the registration by the Distributor.</inlineHelpText>
        <label>Partner Tracking Number</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Product_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This is the eligible product that is a part of this DDR.</description>
        <inlineHelpText>Name of eligible product added to the Design Registration</inlineHelpText>
        <label>Product</label>
        <lookupFilter>
            <active>false</active>
            <booleanFilter>((1 AND 2 AND 3) OR (2 AND 3 AND 7)) OR 4 OR 5 OR 6 OR 8</booleanFilter>
            <filterItems>
                <field>Product2.Core_Design_Registration_Eligible_Ind__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Product2.Core_Sales_Visible_Flag__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Product2.IsActive</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>$Profile.Name</field>
                <operation>equals</operation>
                <value>System Administrator</value>
            </filterItems>
            <filterItems>
                <field>$Profile.Name</field>
                <operation>equals</operation>
                <value>Data Ops</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_Design_Product_Status_Nm__c</field>
                <operation>equals</operation>
                <value>Rejected</value>
            </filterItems>
            <filterItems>
                <field>$Source.PCC_Product_Additional_Attribute__c</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_Design_Product_Status_Nm__c</field>
                <operation>equals</operation>
                <value>Expired</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Design-Deal Registration Products</relationshipLabel>
        <relationshipName>Design_Registration_Line_Items</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
