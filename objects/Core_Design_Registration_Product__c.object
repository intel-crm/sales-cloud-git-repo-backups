    <fields>
        <fullName>Core_Design_Product_Status_Nm__c</fullName>
        <description>The status values which drive the Design Registration Product through the process.  Valid values are: Pending,Approved, Rejected,Cancelled, Retired.</description>
        <inlineHelpText>The status indicates whether the registration product line item is: pending, approved, rejected, or canceled.</inlineHelpText>
        <label>DR Product Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>Retired</fullName>
                    <default>false</default>
                    <label>Retired</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Expired</fullName>
                    <default>false</default>
                    <label>Expired</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
