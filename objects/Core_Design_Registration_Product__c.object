    <fields>
        <fullName>MMID_or_Ordering_code__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <inlineHelpText>Search Product by MMID or Old MMID or Ordering Code</inlineHelpText>
        <label>MMID or Old MMID or Ordering code</label>
        <lookupFilter>
            <active>false</active>
            <booleanFilter>(9 OR ((1 OR 6) AND (2) AND (4) AND ((3 OR 5) OR (7 AND 8)))) OR 10</booleanFilter>
            <filterItems>
                <field>Product_MM_Attribute_Mapping__c.Spec_Code__c</field>
                <operation>startsWith</operation>
                <value>S</value>
            </filterItems>
            <filterItems>
                <field>Product_MM_Attribute_Mapping__c.Custom_Indicator__c</field>
                <operation>notEqual</operation>
                <value>Y, O</value>
            </filterItems>
            <filterItems>
                <field>Product_MM_Attribute_Mapping__c.L4ProductAvailable__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Product_MM_Attribute_Mapping__c.Product_Status__c</field>
                <operation>notEqual</operation>
                <value>RT, OB</value>
            </filterItems>
            <filterItems>
                <field>Product_MM_Attribute_Mapping__c.L5ProductAvailable__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Product_MM_Attribute_Mapping__c.Spec_Code__c</field>
                <operation>equals</operation>
                <value></value>
            </filterItems>
            <filterItems>
                <field>Product_MM_Attribute_Mapping__c.PCC_L4_L5_Available_For_New_Design__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_Design_Product_Status_Nm__c</field>
                <operation>equals</operation>
                <value>Approved</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_Design_Product_Status_Nm__c</field>
                <operation>equals</operation>
                <value>Rejected, Expired</value>
            </filterItems>
            <filterItems>
                <field>$Profile.Name</field>
                <operation>equals</operation>
                <value>System Administrator</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Product_MM_Attribute_Mapping__c</referenceTo>
