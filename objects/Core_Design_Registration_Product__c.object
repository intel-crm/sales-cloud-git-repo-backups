&apos;Product Series&apos; &apos;-&apos; &apos;Product Group&apos; if the OPN in the DRP is VPH (Post-release)</description>
        <externalId>false</externalId>
        <formula>IF(Core_Product_Id__r.Core_Hierarchy_ID__c = &apos;59&apos;,   Core_Product_Id__r.Core_Code_Name__c  + &quot; - &quot; +  Core_Product_Id__r.Core_Product_Density_Value__c , 
IF(Core_Product_Id__r.Core_Hierarchy_ID__c = &apos;43&apos;, Core_Product_Id__r.Core_Product_Series__c +  &quot; - &quot; +  Core_Product_Id__r.Core_Product_Group__c,null))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>OPN Concatenation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_product_hierarchy_txt__c</fullName>
        <description>This field shows the Hierarchy Name of the Product in the DRP Lookup on QL.</description>
        <externalId>false</externalId>
        <formula>Core_Product_Id__r.Core_Hierarchy_Name__c</formula>
        <label>Product Hierarchy</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
