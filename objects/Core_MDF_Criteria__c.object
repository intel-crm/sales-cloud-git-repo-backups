    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Active_Approver_Required</fullName>
        <active>true</active>
        <description>Should have at least one active approver to make criteria active.</description>
        <errorConditionFormula>IF((Core_MDF_Active__c == TRUE &amp;&amp;  Core_MDF_Approvers_Count__c  &lt;= 0),TRUE,FALSE)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Active__c</errorDisplayField>
        <errorMessage>Active Approval Criteria must have at least one active approver. Please uncheck Active checkbox.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Operator_Cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
	(Core_MDF_Field_Name_1__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_1__c , &apos;&apos;)),
	(Core_MDF_Field_Name_2__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_2__c , &apos;&apos;)),
	(Core_MDF_Field_Name_3__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_3__c , &apos;&apos;)),
	(Core_MDF_Field_Name_4__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_4__c , &apos;&apos;)),
	(Core_MDF_Field_Name_5__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_5__c , &apos;&apos;)),
	(Core_MDF_Field_Name_6__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_6__c , &apos;&apos;)),
	(Core_MDF_Field_Name_7__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_7__c , &apos;&apos;)),
	(Core_MDF_Field_Name_8__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_8__c , &apos;&apos;)),
	(Core_MDF_Field_Name_9__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_9__c , &apos;&apos;)),
	(Core_MDF_Field_Name_10__c != NULL &amp;&amp; ISPICKVAL( Core_MDF_Operator_10__c , &apos;&apos;))
 )</errorConditionFormula>
        <errorMessage>Operator cannot be blank.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
