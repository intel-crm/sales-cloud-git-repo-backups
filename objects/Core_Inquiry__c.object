    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_Either_ContactOrLeadField</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
OR(
 RecordType.Name = &quot;Lead&quot;,
 RecordType.Name = &quot;Sales_Lead&quot;,
AND(
 Core_Contact_Inquiries__c &lt;&gt; NULL,
 Core_Lead_Inquiries__c &lt;&gt;null),
AND(
 Core_Contact_Inquiries__c == NULL,
 Core_Lead_Inquiries__c == null)

)
)</errorConditionFormula>
        <errorDisplayField>Core_AcccountName__c</errorDisplayField>
        <errorMessage>Either Contact or Lead value should be populated / Both Contact and Lead values cannot be populated.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Account_on_Inquiry</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Core_AcccountName__c != &apos;&apos;,
Core_AcccountName__r.RecordType.DeveloperName != &apos;Mastered_Account&apos;
)
)</errorConditionFormula>
        <errorMessage>Only Intel Account is permitted on this field. Please select Intel Account and retry again.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_StatusNewReviewedbyRepTrue</fullName>
        <active>false</active>
        <description>A user should not be able to change the status back to new without unchecking the Reviewed by Rep checkbox</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,AND( ISPICKVAL(Core_Inquiry_Status_Pkt__c, &quot;New&quot;), Core_Reviewed_by_Rep_Chk__c = True))</errorConditionFormula>
        <errorDisplayField>Core_AcccountName__c</errorDisplayField>
        <errorMessage>Please uncheck the Reviewed by Rep check box</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_StatusReviewReviewedbyRepFalse</fullName>
        <active>false</active>
        <description>A user should not be able to uncheck the Reviewed by Rep checkbox without changing the Status value back to New</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,AND( ISPICKVAL(Core_Inquiry_Status_Pkt__c, &quot;Reviewed&quot;), Core_Reviewed_by_Rep_Chk__c = False))</errorConditionFormula>
        <errorMessage>Please change the status to New</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_ClaimButton</fullName>
        <availability>online</availability>
        <description>This button is used to claim the ownership of the Inquiry record</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Claim</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/26.0/connection.js&quot;)};
var inq = new sforce.SObject(&quot;Core_Inquiry__c&quot;);
inq.id = &apos;{!Core_Inquiry__c.Id}&apos;;
inq.OwnerId =  &quot;{!$User.Id}&quot;;
var result = sforce.connection.update([inq]);
if(result[0].getBoolean(&quot;success&quot;)) {
alert(&quot;You have successfully claimed the Inquiry&quot;);
}
window.location.reload();</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Review</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Mark as Reviewed</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/26.0/connection.js&quot;)};
var inq = new sforce.SObject(&quot;Core_Inquiry__c&quot;);
inq.id = &apos;{!Core_Inquiry__c.Id}&apos;;
inq.Core_Inquiry_Status_Pkt__c = &apos;Reviewed&apos;;
inq.Core_Reviewed_by_Rep_Chk__c  = true;
var result = sforce.connection.update([inq]);
if (result[0].getBoolean(&quot;success&quot;)) {
    alert(&quot;Inquiry has been successfully reviewed&quot;);
  } 
else
{
    alert(&quot;You have insufficient privileges to review the Inquiry.&quot;);
}
window.location.reload();</url>
    </webLinks>
</CustomObject>
