    <fields>
        <fullName>Core_AcccountName__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field stores the Account name of the Lead after conversion and Contact</description>
        <label>Account Name</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Inquiries</relationshipLabel>
        <relationshipName>Inquiries</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_AccountName__c</fullName>
        <description>This field is used to populate the company field in email template.</description>
        <externalId>false</externalId>
        <formula>IF( Core_Lead_Inquiries__c &lt;&gt; NULL, IF(Core_Company_Txt__c &lt;&gt; NULL,Core_Company_Txt__c, null),IF(Core_Contact_Inquiries__c &lt;&gt; NULL, IF(Core_Contact_Inquiries__r.Account.Name &lt;&gt; NULL, Core_Contact_Inquiries__r.Account.Name ,null),null))</formula>
        <label>AccountName</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Account_Owner__c</fullName>
        <externalId>false</externalId>
        <formula>IF(   Core_Contact_Inquiries__r.Core_Account__c &lt;&gt; NULL,
(  Core_Contact_Inquiries__r.Account.Core_Account_Owner__c ), null)</formula>
        <label>Account Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
