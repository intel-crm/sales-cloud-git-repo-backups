    </fields>
    <fields>
        <fullName>SWS_Conversion_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(SWS_Request_Status__c,&apos;Coupon_Generated&apos;),IF(AND(ISBLANK(SWS_Lead__c)), &apos;Coupon Generated Requests&apos;, 
    IF(SWS_Lead__r.IsConverted, IF(ISPICKVAL(SWS_Opportunity_Related__r.StageName,&apos;Design Win&apos;),&apos;Opportunity - Design Win&apos;,IF(ISPICKVAL(SWS_Opportunity_Related__r.StageName,&apos;Production Win&apos;),&apos;Opportunity - Production Win&apos;,&apos;Opportunity - Converted&apos;)),
        IF(AND(ISPICKVAL(SWS_Request_Status__c, &apos;Coupon_Generated&apos;),NOT(ISBLANK(SWS_Lead__c))), &apos;Lead Converted Requests&apos;, &apos;&apos;))),&apos;All Requests Without Coupon&apos;)</formula>
        <label>Conversion Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
