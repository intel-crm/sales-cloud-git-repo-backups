        <label>Coupon Created On</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>SWS_Coupon_Created_On_fm__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(SWS_Coupon_Created_On__c)),MID(TEXT(SWS_Coupon_Created_On__c),6,2)+&apos;/&apos;+MID(TEXT(SWS_Coupon_Created_On__c),9,2)+&apos;/&apos;+MID(TEXT(SWS_Coupon_Created_On__c),1,4)+&apos;, &apos;+IF(VALUE(MID(TEXT(SWS_Coupon_Created_On__c),12,2))&gt;12,IF((VALUE(MID(TEXT(SWS_Coupon_Created_On__c),12,2))-12)&lt;10,&apos;0&apos;+TEXT(VALUE(MID(TEXT(SWS_Coupon_Created_On__c),12,2))-12),TEXT(VALUE(MID(TEXT(SWS_Coupon_Created_On__c),12,2))-12)),MID(TEXT(SWS_Coupon_Created_On__c),12,2))+&apos;:&apos;+MID(TEXT(SWS_Coupon_Created_On__c),15,2)+&apos; &apos;+IF(VALUE(MID(TEXT(SWS_Coupon_Created_On__c),12,2))&gt;12,&apos;PM&apos;,&apos;AM&apos;), &apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Coupon Created On</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SWS_Coupon_Creator__c</fullName>
