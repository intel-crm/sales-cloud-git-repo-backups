        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SWS_Coupon_Expiration_Date__c</fullName>
        <label>Coupon Expiration Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>SWS_Coupon_Expiration_Date_fm__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(SWS_Coupon_Expiration_Date__c)),MID(TEXT(SWS_Coupon_Expiration_Date__c),6,2)+&apos;/&apos;+MID(TEXT(SWS_Coupon_Expiration_Date__c),9,2)+&apos;/&apos;+MID(TEXT(SWS_Coupon_Expiration_Date__c),1,4)+&apos;, &apos;+IF(VALUE(MID(TEXT(SWS_Coupon_Expiration_Date__c),12,2))&gt;12,IF((VALUE(MID(TEXT(SWS_Coupon_Expiration_Date__c),12,2))-12)&lt;10,&apos;0&apos;+TEXT(VALUE(MID(TEXT(SWS_Coupon_Expiration_Date__c),12,2))-12),TEXT(VALUE(MID(TEXT(SWS_Coupon_Expiration_Date__c),12,2))-12)),MID(TEXT(SWS_Coupon_Expiration_Date__c),12,2))+&apos;:&apos;+MID(TEXT(SWS_Coupon_Expiration_Date__c),15,2)+&apos; &apos;+IF(VALUE(MID(TEXT(SWS_Coupon_Expiration_Date__c),12,2))&gt;12,&apos;PM&apos;,&apos;AM&apos;), &apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Coupon Expiration Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SWS_Coupon_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  NOT(ISBLANK( SWS_Coupon_Code__c )) , IF(  DATEVALUE(SWS_Coupon_Expiration_Date__c) &gt;  TODAY() , &apos;Active&apos;, &apos;Expired&apos;), &apos;&apos; )</formula>
        <label>Coupon Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SWS_Coupon_Type__c</fullName>
        <inlineHelpText>Default credit coupon expiration date is typically 3 months. Credits do not guarantee availability in the Console.</inlineHelpText>
        <label>Cloud Coupon Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Standard – Covers 2 appr. weeks of continuous bare-metal system access</fullName>
                    <default>false</default>
                    <label>Standard – Covers 2 appr. weeks of continuous bare-metal system access</label>
                </value>
                <value>
                    <fullName>Medium – Covers 4 weeks of continuous bare-metal system access</fullName>
                    <default>false</default>
                    <label>Medium – Covers 4 weeks of continuous bare-metal system access</label>
                </value>
                <value>
                    <fullName>Large – Covers 8 weeks of continuous bare-metal system access</fullName>
                    <default>false</default>
                    <label>Large – Covers 8 weeks of continuous bare-metal system access</label>
                </value>
                <value>
                    <fullName>Custom – Request for a more extended period of continuous bare-metal system access (requires approval and SalesForce ID if for external customer)</fullName>
                    <default>false</default>
                    <label>Custom – Request for a more extended period of continuous bare-metal system access (requires approval and SalesForce ID if for external customer)</label>
                </value>
                <value>
                    <fullName>Medium  Covers 4 weeks of continuous bare-metal system access</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Medium  Covers 4 weeks of continuous bare-metal system access</label>
                </value>
                <value>
                    <fullName>N/A</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>N/A</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>SWS_Coupon_Valid_From__c</fullName>
        <label>Coupon Valid From</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>SWS_Coupon_Valid_From_fm__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(SWS_Coupon_Valid_From__c)),MID(TEXT(SWS_Coupon_Valid_From__c),6,2)+&apos;/&apos;+MID(TEXT(SWS_Coupon_Valid_From__c),9,2)+&apos;/&apos;+MID(TEXT(SWS_Coupon_Valid_From__c),1,4)+&apos;, &apos;+IF(VALUE(MID(TEXT(SWS_Coupon_Valid_From__c),12,2))&gt;12,IF((VALUE(MID(TEXT(SWS_Coupon_Valid_From__c),12,2))-12)&lt;10,&apos;0&apos;+TEXT(VALUE(MID(TEXT(SWS_Coupon_Valid_From__c),12,2))-12),TEXT(VALUE(MID(TEXT(SWS_Coupon_Valid_From__c),12,2))-12)),MID(TEXT(SWS_Coupon_Valid_From__c),12,2))+&apos;:&apos;+MID(TEXT(SWS_Coupon_Valid_From__c),15,2)+&apos; &apos;+IF(VALUE(MID(TEXT(SWS_Coupon_Valid_From__c),12,2))&gt;12,&apos;PM&apos;,&apos;AM&apos;), &apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Coupon Valid From</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
