    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Approver_not_blank_for_Gaudi2_product</fullName>
        <active>false</active>
        <errorConditionFormula>AND( SWS_ApprovalRequiredForProduct_fm__c, ISBLANK( SWS_Approver__c ) )</errorConditionFormula>
        <errorDisplayField>SWS_Approver__c</errorDisplayField>
        <errorMessage>Select an approver</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Community_Program_Coupon_cannot_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),
ISBLANK(TEXT(SWS_Community_Program_Coupon_Type__c)), 
NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;Research_and_education&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Community_Program_Coupon_Type__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Company_Name_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Company_Name__c), NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;External_Customer&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Company_Name__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Compute_Service_Requirement_cannot_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Compute_Service_Requirements__c), NOT(ISNEW()))</errorConditionFormula>
        <errorDisplayField>SWS_Compute_Service_Requirements__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cost_Center_cannot_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Cost_Center__c), NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;Intel_Internal_Use&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Cost_Center__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Country_cannot_be_blank</fullName>
        <active>true</active>
        <description>Country_cannot_be_blank</description>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_Country__c)), NOT(ISNEW()), NOT(ISPICKVAL(SWS_Request_Type__c,&apos;Research_and_education&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Country__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Coupon_Value_cannot_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_Coupon_Value__c
)), NOT(ISNEW()))</errorConditionFormula>
        <errorDisplayField>SWS_Coupon_Value__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Coupon_type_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_Coupon_Type__c)), NOT(ISNEW()), OR(ISPICKVAL(SWS_Request_Type__c,&apos;Intel_Internal_Use&apos;),ISPICKVAL(SWS_Request_Type__c,&apos;External_Customer&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Coupon_Type__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Coupon_value_should_be_grater_than_0</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),SWS_Coupon_Value__c &lt;=0)</errorConditionFormula>
        <errorDisplayField>SWS_Coupon_Value__c</errorDisplayField>
        <errorMessage>Coupon value should be greater than 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>End_Date_Greater_than_Current_Date</fullName>
        <active>true</active>
        <description>End date should be greater than current date</description>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),SWS_Expiry_Date__c &lt; TODAY())</errorConditionFormula>
        <errorDisplayField>SWS_Expiry_Date__c</errorDisplayField>
        <errorMessage>End date cannot be less than current date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>End_Date_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_Expiry_Date__c)), NOT(ISNEW()))</errorConditionFormula>
        <errorDisplayField>SWS_Expiry_Date__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>End_date_not_exceeds_more_than_1_year</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),SWS_Expiry_Date__c   &gt;  ADDMONTHS(TODAY(),12)+1)</errorConditionFormula>
        <errorDisplayField>SWS_Expiry_Date__c</errorDisplayField>
        <errorMessage>End date cannot exceed 1 year + 1 day from today.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>End_date_not_less_than_current_date</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),SWS_Event_End_Date__c &lt;  SWS_Event_Start_Date__c)</errorConditionFormula>
        <errorDisplayField>SWS_Event_End_Date__c</errorDisplayField>
        <errorMessage>Event end date should not less than event start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Event_Compute_Environmen_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Event_Compute_Environment_Details__c), NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;One_time_external_event&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Event_Compute_Environment_Details__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Event_End_Date_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Event_Start_Date__c), NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;One_time_external_event&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Event_End_Date__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Event_Start_Date_cannot_be_blank</fullName>
        <active>false</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_Event_Start_Date__c)), NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;One_time_external_event&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Event_Start_Date__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Event_country_name_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_Event_Country_Name__c)), NOT(ISNEW()), ISPICKVAL(SWS_Request_Type__c,&apos;One_time_external_event&apos;))</errorConditionFormula>
        <errorDisplayField>SWS_Event_Country_Name__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FirstName_should_have_atleast_one_letter</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c), NOT(REGEX(SWS_First_Name__c, &quot;.*[a-zA-Z].*&quot;)))</errorConditionFormula>
        <errorDisplayField>SWS_First_Name__c</errorDisplayField>
        <errorMessage>Please enter atleast one alpha numeric character.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>HW_Compute_Platform_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),
ISBLANK(TEXT(SWS_HW_Compute_Platform_PL__c)), NOT(ISNEW()), NOT(ISPICKVAL(SWS_Request_Type__c,&apos;Research_and_education&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_HW_Compute_Platform_PL__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>HW_Compute_Quantity_cannot_be_blank</fullName>
        <active>false</active>
        <description>HW_Compute_Quantity__c cannot be blank</description>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_HW_Compute_Quantity__c), NOT(ISNEW()), NOT(ISPICKVAL(SWS_Request_Type__c,&apos;Research_and_education&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_HW_Compute_Quantity__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Incorrect_value_for_Cloud_Coupon_Type</fullName>
        <active>false</active>
        <errorConditionFormula>(SWS_Is_Giveaway__c=false)&amp;&amp;(ISPICKVAL(SWS_Coupon_Type__c ,&quot;N/A&quot;))&amp;&amp;((ISPICKVAL(SWS_Request_Type__c,&quot;External_Customer&quot;))||(ISPICKVAL(SWS_Request_Type__c,&quot;Intel_Internal_Use&quot;)))</errorConditionFormula>
        <errorDisplayField>SWS_Coupon_Type__c</errorDisplayField>
        <errorMessage>Select a different value, as this is not a Giveaway coupon.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Incorrect_value_for_HW_Compute_Platform</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),(!(SWS_Is_Giveaway__c=true)),(TEXT(SWS_HW_Compute_Platform_PL__c)=&quot;N/A&quot;),(NOT(TEXT(SWS_Request_Type__c)=&quot;Research_and_education&quot;)))</errorConditionFormula>
        <errorDisplayField>SWS_HW_Compute_Platform_PL__c</errorDisplayField>
        <errorMessage>Select a different value, as this is not a Giveaway coupon.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Incorrect_value_for_Use_Case</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),SWS_Is_Giveaway__c == false,ISPICKVAL( SWS_Use_Case__c ,&quot;N/A&quot;),ISPICKVAL(SWS_Request_Type__c,&quot;External_Customer&quot;))</errorConditionFormula>
        <errorDisplayField>SWS_Use_Case__c</errorDisplayField>
        <errorMessage>Select a different value, as this is not a Giveaway coupon.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Intel_BU_Field_Sales_Con_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Intel_BU_Field_Sales_Contact__c), NOT(ISNEW()), OR(ISPICKVAL(SWS_Request_Type__c,&apos;One_time_external_event&apos;),ISPICKVAL(SWS_Request_Type__c,&apos;External_Customer&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Intel_BU_Field_Sales_Contact__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Is_Locked</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),NOT(ISCHANGED(SWS_Locked__c)),SWS_Locked__c,IF(
    ISPICKVAL(SWS_Request_Type__c, &apos;Intel_Internal_Use&apos;),
    OR(
        ISCHANGED(SWS_Request_Type__c),
        ISCHANGED(SWS_First_Name__c),
        ISCHANGED(SWS_Last_Name__c),
        ISCHANGED(SWS_Email__c),
		ISCHANGED(SWS_SameAsSubmitter_fm__c),
		ISCHANGED(SWS_Submitter_Name__c),
		ISCHANGED(SWS_Submitter_Email__c),   
        ISCHANGED(SWS_Country__c),
        ISCHANGED(SWS_Job_Title__c),
        ISCHANGED(SWS_Cost_Center__c),
        ISCHANGED(SWS_HW_Compute_Platform_PL__c),            
        ISCHANGED(SWS_HW_Compute_Quantity__c),
        ISCHANGED(SWS_Compute_Service_Requirements__c),
        ISCHANGED(SWS_Coupon_Type__c)
    ),
    IF(
        ISPICKVAL(SWS_Request_Type__c, &apos;External_Customer&apos;),
        OR(
		    ISCHANGED(SWS_Request_Type__c),
            ISCHANGED(SWS_First_Name__c),
            ISCHANGED(SWS_Last_Name__c),
            ISCHANGED(SWS_Email__c),
			ISCHANGED(SWS_SameAsSubmitter_fm__c),
			ISCHANGED(SWS_Submitter_Name__c),
		    ISCHANGED(SWS_Submitter_Email__c),
            ISCHANGED(SWS_Country__c),
            ISCHANGED(SWS_Job_Title__c),
            ISCHANGED(SWS_Company_Name__c),
			ISCHANGED(SWS_Intel_BU_Field_Sales_Contact__c),
			ISCHANGED(SWS_Use_Case__c),
			ISCHANGED(SWS_Use_Case_Details__c),
			ISCHANGED(SWS_Custom_Coupon_Request__c),
            ISCHANGED(SWS_HW_Compute_Platform_PL__c),
            ISCHANGED(SWS_HW_Compute_Quantity__c),
            ISCHANGED(SWS_Compute_Service_Requirements__c),
            ISCHANGED(SWS_Coupon_Type__c)
        ),
        IF(
            ISPICKVAL(SWS_Request_Type__c, &apos;Research_and_education&apos;),
            OR(
                ISCHANGED(SWS_Request_Type__c),
				ISCHANGED(SWS_First_Name__c),
                ISCHANGED(SWS_Last_Name__c),
                ISCHANGED(SWS_Email__c),
				ISCHANGED(SWS_SameAsSubmitter_fm__c),
				ISCHANGED(SWS_Submitter_Name__c),
				ISCHANGED(SWS_Submitter_Email__c),
				ISCHANGED(SWS_Community_Program_Name__c),
				ISCHANGED(SWS_Community_Program_Coupon_Type__c),
                ISCHANGED(SWS_Compute_Service_Requirements__c)

            ),
            IF(
                ISPICKVAL(SWS_Request_Type__c, &apos;One_time_external_event&apos;),
                OR(
                    ISCHANGED(SWS_Request_Type__c),
					ISCHANGED(SWS_First_Name__c),
                    ISCHANGED(SWS_Last_Name__c),
                    ISCHANGED(SWS_Email__c),
					ISCHANGED(SWS_SameAsSubmitter_fm__c),
					ISCHANGED(SWS_Submitter_Name__c),
					ISCHANGED(SWS_Submitter_Email__c),
                    ISCHANGED(SWS_Country__c),
					ISCHANGED(SWS_Event_Name__c),
					ISCHANGED(SWS_Event_Start_Date__c),
					ISCHANGED(SWS_Event_End_Date__c),
					ISCHANGED(SWS_Number_of_Participants__c),
					ISCHANGED(SWS_Event_Country_Name__c),
					ISCHANGED(SWS_Intel_BU_Field_Sales_Contact__c),
                    ISCHANGED(SWS_HW_Compute_Platform_PL__c),
                    ISCHANGED(SWS_HW_Compute_Quantity__c),
                    ISCHANGED(SWS_Compute_Service_Requirements__c),
                    ISCHANGED(SWS_Event_Compute_Environment_Details__c), ISCHANGED(SWS_Additional_Event_Information__c) 
                ),true
            )
        )
    )
))</errorConditionFormula>
        <errorMessage>Record is locked, you cannot edit Submitted/Coupon Generated record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Job_Title_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Job_Title__c), NOT(ISNEW()), OR(ISPICKVAL(SWS_Request_Type__c,&apos;Intel_Internal_Use&apos;),ISPICKVAL(SWS_Request_Type__c,&apos;External_Customer&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Job_Title__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LoggedInUser_and_approver_be_different</fullName>
        <active>false</active>
        <errorConditionFormula>$User.Username  =  SWS_Approver__r.Username</errorConditionFormula>
        <errorDisplayField>SWS_Approver__c</errorDisplayField>
        <errorMessage>Choose an different approver !</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Of_user_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_No_Of_User__c)), NOT(ISNEW()))</errorConditionFormula>
        <errorDisplayField>SWS_No_Of_User__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Of_user_cannot_be_zero_or_negative</fullName>
        <active>true</active>
        <description>Number of user cannot be less than 0</description>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c), (SWS_No_Of_User__c &lt; 1))</errorConditionFormula>
        <errorDisplayField>SWS_No_Of_User__c</errorDisplayField>
        <errorMessage>Number of Users cannot be negative or zero value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Number_of_Participants_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Number_of_Participants__c), NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;One_time_external_event&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Number_of_Participants__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Number_of_part_accept_only_whole_numbers</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),OR(

AND(

NOT(REGEX((SWS_Number_of_Participants__c),&quot;^-?\\d+$&quot;)),

NOT(VALUE(SWS_Number_of_Participants__c)=0)

),

VALUE(SWS_Number_of_Participants__c) &lt; 1,
VALUE(SWS_Number_of_Participants__c)&gt; 50

))</errorConditionFormula>
        <errorDisplayField>SWS_Number_of_Participants__c</errorDisplayField>
        <errorMessage>Number of users must be a positive whole number, cannot include decimal values and should not exceed 50.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Number_of_user_accept_only_whole_numbers</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),
NOT(REGEX(TEXT(SWS_No_Of_User__c),&quot;^-?\\d+$&quot;)),
NOT(SWS_No_Of_User__c=0)
)</errorConditionFormula>
        <errorDisplayField>SWS_No_Of_User__c</errorDisplayField>
        <errorMessage>Number of users should not contain decimal value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Number_of_user_not_more_than_1000</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c), (SWS_No_Of_User__c &gt; 50))</errorConditionFormula>
        <errorDisplayField>SWS_No_Of_User__c</errorDisplayField>
        <errorMessage>Number cannot exceed 50 per request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Processing_Team_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Processing_Team__c), NOT(ISNEW()))</errorConditionFormula>
        <errorDisplayField>SWS_Processing_Team__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Program_name_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_Community_Program_Name__c)), NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;Research_and_education&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Community_Program_Name__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_field_for_Cloud_Credit_Request</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordType.Name = &apos;Cloud Credit Request&apos;,
    NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),
    OR(
        ISBLANK(RecordTypeId),
        ISBLANK(SWS_First_Name__c),
        ISBLANK(SWS_Last_Name__c),
        ISBLANK(SWS_Email__c),
        ISBLANK(SWS_Submitter_Name__c),
        ISBLANK(SWS_Submitter_Email__c),
        ISBLANK(TEXT(SWS_Request_Type__c))
    )
)</errorConditionFormula>
        <errorMessage>RecordTypeId, Request Type, First Name, Last Name, Customer Email Address, Submitter Name, Submitter Email Address are required fields to create a record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_field_for_Inquiry_record</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
RecordType.Name = &apos;Inquiry&apos;,
NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),
OR(
ISBLANK( SWS_First_Name__c),
ISBLANK( SWS_Last_Name__c ),
ISBLANK( SWS_Email__c ),
ISBLANK(TEXT( SWS_Use_Case__c )),
ISBLANK( SWS_Tell_us_more__c ),
ISBLANK( RecordTypeId),
ISBLANK(TEXT( SWS_Interested_in__c ))
)
)</errorConditionFormula>
        <errorMessage>RecordTypeId, First Name, Last Name, Customer Email Address, Use Case, Interested in, Tell us more are required field to create a record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SWS_Cannot_edit_Credit_with_ITAC</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Permission.SWS_IDC_Business_Ops),
RecordType.Name = &apos;Cloud Credit Request&apos;,
NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c)
)</errorConditionFormula>
        <errorMessage>You don&apos;t have the required permission to edit the Cloud Credit Request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SWS_Cannot_edit_Inquiry_with_IDC</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Permission.SWS_Inquiry_Permission),  
RecordType.Name = &apos;Inquiry&apos;,
NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c)
)</errorConditionFormula>
        <errorMessage>You don&apos;t have the required permission to edit the Inquiry Request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SWS_Choose_any_of_lead</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(SWS_Lead__c)),SWS_Create_Lead__c,IF(ISNEW(),SWS_Create_Lead_fm__c,ISCHANGED(SWS_Create_Lead_fm__c)) ,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c))</errorConditionFormula>
        <errorMessage>You can either choose to create a new lead or select an existing lead for the credit request. Please fill out only one of the fields.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Salesforce_Opportunity_ID_cannot_blank</fullName>
        <active>false</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Salesforce_Opportunity_ID__c), NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;External_Customer&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Salesforce_Opportunity_ID__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Start_date_cannot_be_earlier_than_1month</fullName>
        <active>false</active>
        <errorConditionFormula>SWS_Event_Start_Date__c  &lt;  TODAY()- 30</errorConditionFormula>
        <errorDisplayField>SWS_Event_Start_Date__c</errorDisplayField>
        <errorMessage>Start date cannot be earlier than 1 month from today.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Start_date_is_required</fullName>
        <active>false</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_Start_Date__c)), NOT(ISNEW()))</errorConditionFormula>
        <errorDisplayField>SWS_Start_Date__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Start_date_less_than_current_date</fullName>
        <active>false</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),SWS_Start_Date__c &lt; (TODAY()))</errorConditionFormula>
        <errorDisplayField>SWS_Start_Date__c</errorDisplayField>
        <errorMessage>Start date should not be past date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Start_date_not_less_than_one_month</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),SWS_Event_Start_Date__c &lt; ( TODAY() - 30))</errorConditionFormula>
        <errorDisplayField>SWS_Event_Start_Date__c</errorDisplayField>
        <errorMessage>Start date cannot be earlier than 1 month from today.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Submitter_Email_cannot_be_blank</fullName>
        <active>false</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Submitter_Email__c), NOT(ISNEW()),NOT(SWS_Submitter_Requster_Email__c))</errorConditionFormula>
        <errorDisplayField>SWS_Submitter_Email__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Submitter_Name_cannot_be_blank</fullName>
        <active>false</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(SWS_Submitter_Name__c), NOT(ISNEW()),NOT(SWS_Submitter_Requster_Email__c))</errorConditionFormula>
        <errorDisplayField>SWS_Submitter_Name__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Submitter_details_cannot_be_changed</fullName>
        <active>false</active>
        <errorConditionFormula>If(SWS_Submitter_Requster_Email__c, if(OR(ISCHANGED(SWS_Submitter_Name__c),ISCHANGED(SWS_Submitter_Email__c)),True,false),false)</errorConditionFormula>
        <errorDisplayField>SWS_Submitter_Requster_Email__c</errorDisplayField>
        <errorMessage>Cannot change the submitters details</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Use_Case_cannot_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(SWS_Is_Submitted_For_Coupon__c,NOT($Setup.SWS_Bypass_Validation_Rule__c.Bypass__c),ISBLANK(TEXT(SWS_Use_Case__c)), NOT(ISNEW()), (ISPICKVAL(SWS_Request_Type__c,&apos;External_Customer&apos;)))</errorConditionFormula>
        <errorDisplayField>SWS_Use_Case__c</errorDisplayField>
        <errorMessage>This is required field</errorMessage>
    </validationRules>
