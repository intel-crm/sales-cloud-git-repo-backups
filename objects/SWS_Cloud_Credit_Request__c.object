    <label>Cloud Credit Request</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>SWS_Email__c</columns>
        <columns>SWS_Request_Type__c</columns>
        <columns>SWS_Request_Status__c</columns>
        <columns>RECORDTYPE</columns>
        <columns>SWS_Coupon_Status__c</columns>
        <columns>SWS_Redeemed__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>SWS_Cloud_Credit_Request__c.SWS_Cloud_Credit_Request</value>
        </filters>
        <label>All Cloud Credit Requests</label>
        <sharedTo>
            <group>SWS_Credit_request_listview</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Awaiting_approval</fullName>
        <columns>NAME</columns>
        <columns>SWS_Email__c</columns>
        <columns>SWS_Lead__c</columns>
        <columns>SWS_Request_Status__c</columns>
        <columns>SWS_Request_Type__c</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>SWS_Request_Status__c</field>
            <operation>equals</operation>
            <value>Awaiting_Submission</value>
        </filters>
        <label>Awaiting Coupon Request Approval</label>
        <sharedTo>
            <group>SWS_Credit_request_listview</group>
        </sharedTo>
    </listViews>
