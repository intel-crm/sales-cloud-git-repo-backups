        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>SWS_Duration_For_Awaiting_Submission__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(SWS_Request_Status__c,&apos;Coupon_Generated&apos;),IF(FLOOR(SWS_Coupon_Created_On__c - CreatedDate)&gt;-1,FLOOR(SWS_Coupon_Created_On__c - CreatedDate),IF(ISPICKVAL(SWS_Request_Status__c,&apos;Rejected&apos;),IF(FLOOR(SWS_Rejected_On__c-CreatedDate)&gt;-1,FLOOR(SWS_Rejected_On__c-CreatedDate),IF(AND(NOT(ISBLANK(SWS_Submitted_On__c)),FLOOR(SWS_Submitted_On__c-CreatedDate)&gt;-1),FLOOR(SWS_Submitted_On__c  -  CreatedDate),null))
,null)),null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>No. of Days Awaiting submission</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SWS_Duration_For_Coupon_Generation__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(SWS_Request_Status__c,&apos;Coupon_Generated&apos;),IF(FLOOR(SWS_Coupon_Created_On__c - CreatedDate)&gt;-1,FLOOR(SWS_Coupon_Created_On__c - CreatedDate),null),null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>No. of Days taken For Coupon Generation</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SWS_Duration_For_Coupon_Rejection__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(SWS_Request_Status__c,&apos;Rejected&apos;),IF(FLOOR(SWS_Rejected_On__c-CreatedDate)&gt;-1,FLOOR(SWS_Rejected_On__c-CreatedDate),null)
,null)</formula>
        <label>No. of Days taken For Coupon Rejection</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
