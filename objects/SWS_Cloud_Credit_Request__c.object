        <description>This field is used to show flag for Email Verification</description>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL(SWS_Email_Verification__c, &apos;Not Verified&apos;) , 
IMAGE(&apos;/resource/Checklist_Red&apos;, &apos;Not Verified&apos;,20,20) &amp; &apos; Not Verified&apos;, 
IMAGE(&apos;/resource/Checklist_Green&apos;, &quot;Verified&quot;,20,20) &amp; &apos; Verified&apos;)</formula>
        <label>Email Verification</label>
        <required>false</required>
