    <fields>
        <fullName>SWS_Community_Program_Coupon_Type__c</fullName>
        <inlineHelpText>SATG and Community and Academic Outreach programs may request the following types of cloud coupons.</inlineHelpText>
        <label>Community Program – Coupon Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Researcher coupon – Intended for Intel COEs, can be used by 5 participants and covers approximately 7 days of bare-metal access.</fullName>
                    <default>false</default>
                    <label>Researcher coupon – Intended for Intel COEs, can be used by 5 participants and covers approximately 7 days of bare-metal access.</label>
                </value>
                <value>
                    <fullName>Innovator coupon – Intended for an individual user and covers approximately 7 days of bare-metal access.</fullName>
                    <default>false</default>
                    <label>Innovator coupon – Intended for an individual user and covers approximately 7 days of bare-metal access.</label>
                </value>
                <value>
                    <fullName>Student coupon – Intended for up to 30 students and covers approximately 14 days of virtual-machine access.</fullName>
                    <default>false</default>
                    <label>Student coupon – Intended for up to 30 students and covers approximately 14 days of virtual-machine access.</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
