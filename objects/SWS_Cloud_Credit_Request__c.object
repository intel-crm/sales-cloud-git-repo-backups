        <formula>IF(TEXT(SWS_Request_Type__c) = &quot;Intel_Internal_Use&quot;,
&quot;Intel internal use – one-time or ongoing use for internal development and research projects&quot;,
IF(TEXT(SWS_Request_Type__c) = &quot;External_Customer&quot;,
&quot;External Customer – Intel platform evaluation for external customer(s).&quot;,
IF(TEXT(SWS_Request_Type__c)= &quot;Research_and_education&quot;,
&quot;Research and education – ongoing use by participants of an Intel research and education community outreach program.&quot;,
IF(TEXT(SWS_Request_Type__c) = &quot;One_time_external_event&quot;,
&quot;One-time external event – one-time use by participants attending an Intel community or customer outreach event (e.g., workshop, training, or hackathon).&quot;,&quot;&quot;))))</formula>
