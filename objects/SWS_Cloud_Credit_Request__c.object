IF(VALUE(TEXT(HOUR(TIMEVALUE(SWS_Rejected_On__c))))&gt;12, TEXT(VALUE(TEXT(HOUR(TIMEVALUE(SWS_Rejected_On__c))))-12),TEXT(HOUR(TIMEVALUE(SWS_Rejected_On__c))))+&quot;:&quot;+ IF(VALUE(TEXT(MINUTE(TIMEVALUE(SWS_Rejected_On__c))))&lt;10,&quot;0&quot;+TEXT(MINUTE(TIMEVALUE(SWS_Rejected_On__c))),TEXT(MINUTE(TIMEVALUE(SWS_Rejected_On__c)))) +&quot; &quot;+IF(VALUE(TEXT(HOUR(TIMEVALUE(SWS_Rejected_On__c))))&gt;=12,&quot;PM&quot;,&quot;AM&quot;),&apos;&apos;)</formula>
