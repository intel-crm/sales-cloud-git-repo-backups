    <fields>
        <fullName>SWS_Fields_approval_fm__c</fullName>
        <formula>IF(
    ISPICKVAL(SWS_Request_Type__c, &quot;Intel internal use – one-time or ongoing use for internal development and research projects&quot;),
    AND(
        NOT(ISBLANK(SWS_Job_Title__c)),
        NOT(ISPICKVAL(SWS_Country__c, &quot;&quot;)),
        NOT(ISPICKVAL(SWS_HW_Compute_Platform_PL__c, &quot;&quot;)),
        NOT(ISPICKVAL(SWS_Coupon_Type__c, &quot;&quot;)),
        NOT(ISBLANK(SWS_Processing_Team__c))
    ),
    
    IF(
        ISPICKVAL(SWS_Request_Type__c, &quot;External Customer – Intel platform evaluation for external customer(s).&quot;),
        AND(
            NOT(ISBLANK(SWS_Intel_BU_Field_Sales_Contact__c)),
            NOT(ISPICKVAL(SWS_Use_Case__c, &quot;&quot;)),
            NOT(ISBLANK(SWS_Job_Title__c)),
            NOT(ISBLANK(SWS_Company_Name__c)),
            NOT(ISPICKVAL(SWS_Country__c, &quot;&quot;)),
            NOT(ISPICKVAL(SWS_HW_Compute_Platform_PL__c, &quot;&quot;)),
            NOT(ISPICKVAL(SWS_Coupon_Type__c, &quot;&quot;)),
            NOT(ISBLANK(SWS_Processing_Team__c))
        ),
        
        IF(
            ISPICKVAL(SWS_Request_Type__c, &quot;One-time external event – one-time use by participants attending an Intel community or customer outreach event (e.g., workshop, training, or hackathon).&quot;),
            AND(
                NOT(ISPICKVAL(SWS_Country__c, &quot;&quot;)),
                NOT(ISBLANK(SWS_Event_Start_Date__c)),
                NOT(ISBLANK(SWS_Event_End_Date__c)),
                NOT(ISBLANK(SWS_Number_of_Participants__c)),
                NOT(ISBLANK(SWS_Event_Compute_Environment_Details__c)),
                NOT(ISBLANK(SWS_Intel_BU_Field_Sales_Contact__c)),
                NOT(ISPICKVAL(SWS_HW_Compute_Platform_PL__c, &quot;&quot;)),
                NOT(ISBLANK(SWS_Processing_Team__c))
            ),
            
            FALSE
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Fields present before approval</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
