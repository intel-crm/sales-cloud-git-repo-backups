    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object to store Territory Assignment data from Bulk uploads. The data here is validated and copied over to the main object.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>CPT_Batch_Id__c</fullName>
        <description>The batch identifier. All the records from each upload is given the same unique batch id.</description>
        <externalId>false</externalId>
        <label>Batch Id</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Employee_WWID__c</fullName>
        <description>The WWID of the Commissionable Employee.</description>
        <externalId>false</externalId>
        <label>Employee WWID</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Generic_Field1__c</fullName>
        <description>Generic Field to store any additional info.</description>
        <externalId>false</externalId>
        <label>Generic Field1</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Generic_Field2__c</fullName>
        <description>Generic Field to store any additional info.</description>
        <externalId>false</externalId>
        <label>Generic Field2</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Quota_Setup__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Quota Setup record of the Commissionable Employee. This is calculated using the Employee WWID and the current Quota Period.</description>
        <label>Quota Setup</label>
        <referenceTo>CPT_Quota_Setup__c</referenceTo>
        <relationshipLabel>Territory Assignments - Staging</relationshipLabel>
        <relationshipName>Territory_Assignments_Staging</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CPT_Territory_Name__c</fullName>
        <description>The Name of the Territory connected to the Employee.</description>
        <externalId>false</externalId>
        <label>Territory Name</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Territory_Target__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Territory of the Commissionable Employee. This is calculated using the Territory Name.</description>
        <label>Territory Target</label>
        <referenceTo>CPT_Territory_Target__c</referenceTo>
        <relationshipLabel>Territory Assignments - Staging</relationshipLabel>
        <relationshipName>Territory_Assignments_Staging</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CPT_Validation_Message__c</fullName>
        <description>Error message that is captured after the execution of validation script.</description>
        <externalId>false</externalId>
        <label>Validation Message</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Validation_Status__c</fullName>
        <description>The status of validation. Starts with the value of Pending and moves to Pass or Fail after the execution of validation script.</description>
        <label>Validation Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Pass</fullName>
                    <default>false</default>
                    <label>Pass</label>
                </value>
                <value>
                    <fullName>Fail</fullName>
                    <default>false</default>
                    <label>Fail</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Territory Assignment - Staging</label>
    <listViews>
        <fullName>All_Records</fullName>
        <columns>NAME</columns>
        <columns>CPT_Batch_Id__c</columns>
        <columns>CPT_Employee_WWID__c</columns>
        <columns>CPT_Territory_Name__c</columns>
        <columns>CPT_Validation_Status__c</columns>
        <columns>CPT_Validation_Message__c</columns>
        <columns>CPT_Quota_Setup__c</columns>
        <columns>CPT_Territory_Target__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Records</label>
        <language>en_US</language>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <nameField>
        <displayFormat>TA-STG-{000000}</displayFormat>
        <label>Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Territory Assignments - Staging</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
