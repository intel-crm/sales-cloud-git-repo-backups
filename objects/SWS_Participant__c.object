    <fields>
        <fullName>SWS_Company_participant__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Company participants</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>User.Email</field>
                <operation>notContain</operation>
                <value>intel.com</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>SWS_Company_Participants</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>SWS_Intel_Participants__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
