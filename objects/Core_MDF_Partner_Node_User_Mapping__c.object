    <fields>
        <fullName>Core_MDF_AccountIdUserId__c</fullName>
        <externalId>false</externalId>
        <label>AccountIdUserId</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 AND ((2 AND 3) OR 4)</booleanFilter>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Co_Marketing</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_Active_Ind__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Active_Ind__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Active_Ind__c</field>
                <operation>equals</operation>
                <value>False</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Account Users</relationshipLabel>
        <relationshipName>Partner_Node_User_Mappings</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Action_Needed_nm__c</fullName>
        <description>To specify the actions</description>
        <label>Action Needed</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Owner Update</fullName>
                    <default>false</default>
                    <label>Owner Update</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Active_Ind__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Active/Inactive indicator for PNUM</description>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_CreatedBy_Nm__c</fullName>
        <description>Shows the name for external user if created by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF (
ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;),
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Error_Details_txt__c</fullName>
        <label>Error Details</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Last_ModifiedBy_Nm__c</fullName>
        <description>Shows the name for external user if last modified by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(LastModifiedBy.Profile.UserType,&apos;PowerPartner&apos;),
LastModifiedBy.FirstName &amp; &apos; &apos; &amp; LastModifiedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Last Modified By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Owner_Nm__c</fullName>
        <description>Shows the name for external user if Owner is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL( Owner:User.Profile.UserType ,&apos;PowerPartner&apos;),
Owner:User.FirstName &amp; &apos; &apos; &amp; Owner:User.LastName ,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>User</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>Partner</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>Partner_Node_User_Mappings</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Account User</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Account__c</columns>
        <columns>Core_MDF_User__c</columns>
        <columns>Core_MDF_Active_Ind__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>AU-{0000000000}</displayFormat>
        <label>Account User Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Users</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Core_MDF_Account__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Core_MDF_User__c</customTabListAdditionalFields>
        <listViewButtons>Core_MDF_Export_List_View</listViewButtons>
        <searchResultsAdditionalFields>Core_MDF_Account__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_User__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Active_Ind__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Account_User_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>IF(
AND(

NOT(ISBLANK(Core_MDF_User__r.Contact.Core_Audience_List__c)),

OR(
(
AND( ISPICKVAL(Core_MDF_Account__r.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &apos;Client CoMarketing Fund&apos;) ,
INCLUDES(Core_MDF_User__r.Contact.Core_Audience_List__c, &apos;CCF User&apos;))),

(
AND( ISPICKVAL(Core_MDF_Account__r.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &apos;Client CoMarketing Fund Boost&apos;) ,
INCLUDES(Core_MDF_User__r.Contact.Core_Audience_List__c, &apos;CCF Boost User&apos;))),

(
AND( ISPICKVAL(Core_MDF_Account__r.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &apos;Data Center CoMarketing Fund&apos;) ,
INCLUDES(Core_MDF_User__r.Contact.Core_Audience_List__c, &apos;DCF User&apos;))),

(
AND( ISPICKVAL(Core_MDF_Account__r.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &apos;Service Provider CoMarketing Fund&apos;) ,
INCLUDES(Core_MDF_User__r.Contact.Core_Audience_List__c, &apos;SPCF USER&apos;))),

(
AND( ISPICKVAL(Core_MDF_Account__r.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &apos;Retail Marketing Funds&apos;) ,
INCLUDES(Core_MDF_User__r.Contact.Core_Audience_List__c, &apos;RMF User&apos;))),

(
AND( ISPICKVAL(Core_MDF_Account__r.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &apos;Intel Partner Alliance MDF&apos;) ,
INCLUDES(Core_MDF_User__r.Contact.Core_Audience_List__c, &apos;IPA User&apos;)))
)

)
,FALSE, TRUE)</errorConditionFormula>
        <errorMessage>This user does not have access to the program selected</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CCP_User_Should_not_be_empty</fullName>
        <active>true</active>
        <description>User/Account field cannot be blank.</description>
        <errorConditionFormula>OR(ISBLANK(Core_MDF_User__c),ISBLANK(Core_MDF_Account__c))</errorConditionFormula>
        <errorMessage>The User field or the Account Field should not be empty.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Program_Admin_Check</fullName>
        <active>false</active>
        <description>IPA program admin can create an Account User of only IPA Program</description>
        <errorConditionFormula>AND(TEXT($User.UserType) != $Label.Core_MDF_Partner_User_Type,NOT(TEXT(Core_MDF_Account__r.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c ) = $Label.Core_MDF_IPA_Program_Name),$Permission.Core_MDF_CCP_Internal_IPA_Program_Admin)</errorConditionFormula>
        <errorMessage>You do not have permission to create an Account User for the selected Program1.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_InActiveUserValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(Core_MDF_Active_Ind__c,NOT(Core_MDF_User__r.IsActive),NOT(Core_MDF_User__r.Partner_License_Reclaimed__c))</errorConditionFormula>
        <errorMessage>The user selected has been deactivated. Please select a user that is in active status.</errorMessage>
    </validationRules>
