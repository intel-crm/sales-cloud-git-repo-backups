    <validationRules>
        <fullName>Users_Not_allowed_to_Edit</fullName>
        <active>false</active>
        <errorConditionFormula>AND(OR(ISNEW(),ISCHANGED(User__c)),  
 $Profile.Name &lt;&gt; &apos;System Administrator&apos;,
 NOT(ISBLANK($Label.Bypass_Users)),
(NOT(CONTAINS ($Label.Bypass_Users,$User.FirstName))))</errorConditionFormula>
        <errorMessage>Users not allowed to edit the Object</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
