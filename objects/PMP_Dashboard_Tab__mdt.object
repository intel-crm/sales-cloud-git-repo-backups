    </fields>
    <fields>
        <fullName>PRM_Partner_Role_Txt__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Partner Role</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PRM_Profile_Txt__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Profile</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <label>PMP_Dashboard_Tab</label>
    <pluralLabel>PMP_Dashboard_Tabs</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
