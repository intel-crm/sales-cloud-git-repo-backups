        <label>Permission Set Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Entitlement_Txt__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Entitlement</label>
        <required>false</required>
