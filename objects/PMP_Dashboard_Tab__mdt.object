<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Metadata to store dashboard tabs which will be shown in Marketplace Dashboard Page</description>
    <fields>
