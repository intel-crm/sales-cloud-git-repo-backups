    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object contains all the Integration details of AGS and ERPM. Eg. Integration Status ,error code .error descriptions</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>A_E_Contact_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Gets Contact from Contact Object</description>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Entitlement Integration Status Details</relationshipLabel>
        <relationshipName>Integration_status_Details1</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>A_E_Error_Description_Txt__c</fullName>
        <description>Gives simple description to A&amp;E Error codes</description>
        <externalId>false</externalId>
        <formula>A_E_Error_Mapping_Id__r.A_E_Error_Description_Txt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Error Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>A_E_Error_Mapping_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Gets Error Code from Error Mapping</description>
        <label>Error Code Id</label>
        <referenceTo>A_E_Error_Mapping__c</referenceTo>
        <relationshipLabel>Entitlement Integration Status Details</relationshipLabel>
        <relationshipName>Integration_status_Details</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>A_E_Integration_Error_Description_Txt__c</fullName>
        <description>Gets The error description from ERPM and AGS</description>
        <label>Integration Error Description</label>
        <length>131072</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>7</visibleLines>
    </fields>
    <fields>
        <fullName>A_E_Integration_Error_Txt__c</fullName>
        <description>Gets Error Code from ERPM or AGS depending on the Integration Type</description>
        <externalId>false</externalId>
        <label>Integration Error</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>A_E_Integration_Status_Txt__c</fullName>
        <label>Integration Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Successful</fullName>
                    <default>false</default>
                    <label>Successful</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
                <value>
                    <fullName>In-Progress</fullName>
                    <default>false</default>
                    <label>In-Progress</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>A_E_Integration_Type_Txt__c</fullName>
        <description>This field will Specify the Integration Type (ERPM or AGS)</description>
        <label>Integration Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>ERPM</fullName>
                    <default>false</default>
                    <label>ERPM</label>
                </value>
                <value>
                    <fullName>AGS</fullName>
                    <default>false</default>
                    <label>AGS</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>A_E_Next_Steps_Txt__c</fullName>
        <description>Gets the next steps to resolve integration error from Error mapping Table</description>
        <externalId>false</externalId>
        <formula>A_E_Error_Mapping_Id__r.A_E_Next_Steps_Txt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Next Steps</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Entitlement Integration Status Detail</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>A_E_Integration_Type_Txt__c</columns>
        <columns>A_E_Integration_Error_Txt__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>A-{0000}</displayFormat>
        <label>Integration status Detail Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Entitlement Integration Status Details</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
