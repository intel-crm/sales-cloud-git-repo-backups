<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>IPS - Mapping Business hours based on case supported org and Priority  for SLA Definition</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Active Flag for Case priority to Biz hours mapping</description>
        <inlineHelpText>Active Flag for Case priority to Biz hours mapping</inlineHelpText>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Business_Hours__c</fullName>
        <description>IPS Business Hours for priority of the Supported Org</description>
        <externalId>false</externalId>
        <inlineHelpText>Business Hours to be defined to a Supported Org&apos;s priority level which will define milestone hours</inlineHelpText>
        <label>Business Hours</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Case_Priority_level__c</fullName>
        <description>Sets the case priority level for defining the business hours on the case</description>
        <externalId>false</externalId>
        <label>Case Priority level</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Supported_Org_ID__c</fullName>
        <description>IPS Supported Org ID</description>
        <externalId>false</externalId>
        <label>Supported Org ID</label>
        <length>30</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Supported_Org_Number__c</fullName>
        <description>Supported Org identifier</description>
        <externalId>false</externalId>
        <inlineHelpText>Tells to which supported Org is the business ID tied for.</inlineHelpText>
        <label>Supported Org Number</label>
        <length>30</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Case IPS SupOrg Priority X Biz Hours</label>
    <visibility>Public</visibility>
</CustomObject>
