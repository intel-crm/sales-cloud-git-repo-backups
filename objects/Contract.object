    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Sales_Contract_End_Date_in_Past</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_ContractStatus__c, False,
AND(ISCHANGED( EndDate ),OR(EndDate &lt; StartDate ,ISNULL(EndDate), ISBLANK(EndDate))))</errorConditionFormula>
        <errorDisplayField>EndDate</errorDisplayField>
        <errorMessage>Contract End Date is a required field and must be greater than Contract Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Contract_Status_change</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_ContractStatus__c, False,
AND(ISCHANGED(Status), NOT(Sales_Is_Amendment_Completed__c) ))</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Contract Status cannot be changed.</errorMessage>
    </validationRules>
