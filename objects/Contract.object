            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>EndDate</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <label>Active Contract Lookup</label>
    </fieldSets>
    <fields>
        <fullName>AccountId</fullName>
        <inlineHelpText>This is the Sold To Account.</inlineHelpText>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR 2</booleanFilter>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Inactive Account</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
