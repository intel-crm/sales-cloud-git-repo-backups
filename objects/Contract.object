    <fields>
        <fullName>Contract_Status__c</fullName>
        <label>Renewal Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Renewal Failed</fullName>
                    <default>false</default>
                    <label>Renewal Failed</label>
                </value>
                <value>
                    <fullName>Renewal Completed</fullName>
                    <default>false</default>
                    <label>Renewal Completed</label>
                </value>
                <value>
                    <fullName>InProgress</fullName>
                    <default>false</default>
                    <label>Renewal InProgress</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
