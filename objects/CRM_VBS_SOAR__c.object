                </value>
                <value>
                    <fullName>SOAR2 - Strategize &amp; Build The Bid</fullName>
                    <default>false</default>
                    <label>SOAR2 - Strategize &amp; Build The Bid</label>
                </value>
                <value>
                    <fullName>SOAR3 - Gain Intel Approval</fullName>
                    <default>false</default>
                    <label>SOAR3 - Gain Intel Approval</label>
                </value>
                <value>
                    <fullName>SOAR4 - Present to Customer</fullName>
                    <default>false</default>
                    <label>SOAR4 - Present to Customer</label>
                </value>
                <value>
                    <fullName>SOAR5 - Lessons Learned</fullName>
                    <color>#FFFFFF</color>
                    <default>false</default>
                    <label>SOAR5 - Lessons Learned</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>CRM_VBS_SOAR_VBS_Decision__c</fullName>
        <description>Key Decisions at various SOAR Stages</description>
        <inlineHelpText>Key Decisions at various SOAR Stages</inlineHelpText>
        <label>SOAR VBS Decision</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>SOAR1 Qualified</fullName>
                    <default>false</default>
                    <label>SOAR1 Qualified</label>
                </value>
                <value>
                    <fullName>SOAR1 Un-qualified</fullName>
                    <default>false</default>
                    <label>SOAR1 Un-qualified</label>
                </value>
                <value>
                    <fullName>SOAR3 Denied</fullName>
                    <default>false</default>
                    <label>SOAR3 Denied</label>
                </value>
                <value>
                    <fullName>SOAR4 Contract Signed</fullName>
                    <default>false</default>
                    <label>SOAR4 Contract Signed</label>
                </value>
                <value>
                    <fullName>SOAR4 Contract Not Signed</fullName>
                    <default>false</default>
                    <label>SOAR4 Contract Not Signed</label>
                </value>
                <value>
                    <fullName>SOAR3 Approved</fullName>
                    <default>false</default>
                    <label>SOAR3 Approved</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>CRM_VBS_Total_Contract_Value__c</fullName>
        <description>Intel Committed/guaranteed revenue over the lifetime of contract</description>
        <inlineHelpText>Intel Committed/guaranteed revenue over the lifetime of contract</inlineHelpText>
        <label>Total Contract Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_VBS_Explore_Re_Use__c</fullName>
        <defaultValue>false</defaultValue>
        <description>VBS Offering that could be re-used as a template for future similar VBS Opportunities</description>
        <inlineHelpText>VBS Offering that could be re-used as a template for future similar VBS Opportunities</inlineHelpText>
        <label>VBS Explore Re-Use</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>SOAR</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>CRM_VBS_SOAR_Opportunity__c</columns>
        <columns>CRM_VBS_SOAR_Stage__c</columns>
        <columns>CRM_VBS_QB_Resource__c</columns>
        <columns>CRM_VBS_Primary_VBS_Offering_Category__c</columns>
        <columns>CRM_VBS_SOAR_VBS_Decision__c</columns>
        <columns>CRM_VBS_Contract_Start_Date__c</columns>
        <columns>CRM_VBS_Contract_Lifetime_in_Months__c</columns>
        <columns>CRM_VBS_Total_Contract_Value__c</columns>
        <columns>CRM_VBS_Annual_Recurring_Revenue__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>SOAR-{00000}</displayFormat>
        <label>SOAR Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>SOARs</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>CRM_VBS_SOAR_Stage__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CRM_VBS_SOAR_VBS_Decision__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CRM_VBS_QB_Resource__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CRM_VBS_Primary_VBS_Offering_Category__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CRM_VBS_SOAR_Opportunity__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>CRM_VBS_Annual_Recurring_Revenue</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,CRM_VBS_Annual_Recurring_Revenue__c &gt; CRM_VBS_Total_Contract_Value__c)</errorConditionFormula>
        <errorMessage>Annual Recurring Revenue should be always less than or equal to Total Contract Revenue</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Approved_Stage3_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF( ISCHANGED( CRM_VBS_SOAR_VBS_Decision__c ) &amp;&amp;  ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c , &apos;SOAR3 Approved&apos;) &amp;&amp;  NOT(ISPICKVAL( CRM_VBS_SOAR_Stage__c , &apos;SOAR3 - Gain Intel Approval&apos;)) ,TRUE,FALSE
))</errorConditionFormula>
        <errorMessage>SOAR VBS Decision can be set as SOAR3 Approved only in SOAR3 stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Approved_to_Contract_Change</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF( ISCHANGED( CRM_VBS_SOAR_VBS_Decision__c ) &amp;&amp; ( ISPICKVAL( CRM_VBS_SOAR_VBS_Decision__c , &apos;SOAR4 Contract Signed&apos;) ||  ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c, &apos;SOAR4 Contract Not Signed&apos;)) &amp;&amp;
NOT(ISPICKVAL(PRIORVALUE(CRM_VBS_SOAR_VBS_Decision__c ), &apos;SOAR3 Approved&apos;)) ,TRUE,FALSE)
)</errorConditionFormula>
        <errorMessage>SOAR4 Contract Signed/Not Signed status applicable only for SOAR3 Approved.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Check_Perm_For_Contract_Fields</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,IF(AND(OR(ISCHANGED( CRM_VBS_Annual_Recurring_Revenue__c ), ISCHANGED( CRM_VBS_Contract_Lifetime_in_Months__c), ISCHANGED( CRM_VBS_Contract_Start_Date__c ) , ISCHANGED( CRM_VBS_Total_Contract_Value__c )), $User.Id != CRM_VBS_QB_Resource__c, $Profile.Name != &quot;Data Ops&quot;, NOT($Permission.CRM_SOAR_Committee)) , TRUE, FALSE))</errorConditionFormula>
        <errorDisplayField>CRM_VBS_Annual_Recurring_Revenue__c</errorDisplayField>
        <errorMessage>You do not have access to change the contract information. Only the assigned Quarter Back/SOAR Committee/Data Ops can do it.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Contract_Field_Change</fullName>
        <active>false</active>
        <errorConditionFormula>NOT($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c) || AND(
            OR(
                ISNULL(CRM_VBS_Annual_Recurring_Revenue__c), 
                ISNULL(CRM_VBS_Contract_Lifetime_in_Months__c), 
                ISNULL(CRM_VBS_Contract_Start_Date__c), 
                ISNULL(CRM_VBS_Total_Contract_Value__c)
            ), ISCHANGED(CRM_VBS_SOAR_Stage__c), 
            ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c , &apos;Contract Signed&apos;), 
            ISPICKVAL(PRIORVALUE(CRM_VBS_SOAR_Stage__c), &apos;SOAR4 - Present to Customer&apos;), 
            ISPICKVAL(CRM_VBS_SOAR_Stage__c,&apos;SOAR5 - Lessons Learned&apos;)
        )</errorConditionFormula>
        <errorMessage>Please enter the following mandatory contract information: Annual Recurring Revenue, Contract Lifetime, Contract Start Date, Total Contract Value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Contract_Fields_Check</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, AND(
NOT(ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c,&apos;Contract Signed&apos;)),NOT(ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c,&apos;Contract Not Signed&apos;))
, ISCHANGED(CRM_VBS_SOAR_Stage__c),
OR(
ISPICKVAL(CRM_VBS_SOAR_Stage__c, &apos;SOAR4 - Present to Customer&apos;),
ISPICKVAL(CRM_VBS_SOAR_Stage__c,&apos;SOAR5 - Lessons Learned&apos;))
))</errorConditionFormula>
        <errorDisplayField>CRM_VBS_SOAR_VBS_Decision__c</errorDisplayField>
        <errorMessage>Please select SOAR VBS Decision as either &quot;Contract Signed&quot; or &quot;Contract Not Signed&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Contract_Signed_Not_Signed_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(CRM_VBS_SOAR_VBS_Decision__c),
OR(
ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c,&apos;SOAR4 Contract Signed&apos;),
ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c,&apos;SOAR4 Contract Not Signed&apos;)
),
NOT(ISPICKVAL(CRM_VBS_SOAR_Stage__c, &apos;SOAR4 - Present to Customer&apos;))
)
)</errorConditionFormula>
        <errorMessage>SOAR4 Contract Signed/Not Signed can be set only in SOAR4 stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Contract_Start_Date</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,IF( AND(ISCHANGED( CRM_VBS_Contract_Start_Date__c ), CRM_VBS_Contract_Start_Date__c &lt;=  CRM_VBS_SOAR_Opportunity__r.Decision_Date__c ) , TRUE, FALSE))</errorConditionFormula>
        <errorMessage>Contract Start Date should be greater than opportunity decision date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Contract_Value_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, AND (CRM_VBS_Contract_Lifetime_in_Months__c &gt;12 , CRM_VBS_Total_Contract_Value__c &lt;= CRM_VBS_SOAR_Opportunity__r.Amount))</errorConditionFormula>
        <errorMessage>Total Contract Value should be greater than Design Win Amount for Contracts greater than 12months lifetime.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_QB_Resource_check</fullName>
        <active>false</active>
        <description>Quarter Back must be assigned before setting SOAR VBS Decision as SOAR1 Qualified</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, AND( ISCHANGED( CRM_VBS_SOAR_VBS_Decision__c ), ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c , &apos;SOAR1 Qualified&apos;),
OR(ISNULL(CRM_VBS_QB_Resource__c) , ISBLANK(CRM_VBS_QB_Resource__c) ) ))</errorConditionFormula>
        <errorDisplayField>CRM_VBS_QB_Resource__c</errorDisplayField>
        <errorMessage>Quarter Back must be assigned before setting SOAR VBS Decision as SOAR1 Qualified</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Restrict_Primary_Lawyer_Change</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
	IF( ISCHANGED( CRM_VBS_Primary_Lawyer__c ) &amp;&amp;  
	NOT(OR($User.Id = CRM_VBS_QB_Resource__c,$Permission.CRM_SOAR_Committee,$Profile.Name= &quot;Data Ops&quot;)), TRUE, FALSE))</errorConditionFormula>
        <errorMessage>You do not have access to change the Primary Lawyer. Only the assigned Quarter Back/ SOAR Committee/ Data Ops can do it.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Restrict_Stage_Decision_Change</fullName>
        <active>false</active>
        <description>VBS Stage and Decision can be changed by QB Resource/SOAR Committee/Data Ops when Opportunity is Open.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,IF((ISCHANGED(CRM_VBS_SOAR_Stage__c) || ISCHANGED(CRM_VBS_SOAR_VBS_Decision__c)) &amp;&amp;  NOT(OR($User.Id = CRM_VBS_QB_Resource__c,$Permission.CRM_SOAR_Committee,$Profile.Name= &quot;Data Ops&quot;)) &amp;&amp; (OR(ISPICKVAL(CRM_VBS_SOAR_Opportunity__r.StageName,&apos;Qualify&apos;),ISPICKVAL(CRM_VBS_SOAR_Opportunity__r.StageName,&apos;Define&apos;),ISPICKVAL(CRM_VBS_SOAR_Opportunity__r.StageName,&apos;Develop&apos;),ISPICKVAL(CRM_VBS_SOAR_Opportunity__r.StageName,&apos;Design&apos;))), TRUE, FALSE))</errorConditionFormula>
        <errorMessage>You do not have access to change the Stage or VBS decision. Only the assigned Quarter Back/ SOAR Committee/ Data Ops can do it.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_SOAR1_to_Approved_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,IF(  ISCHANGED(CRM_VBS_SOAR_VBS_Decision__c) &amp;&amp;  ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c, &apos;SOAR3 Approved&apos;) &amp;&amp;
NOT(ISPICKVAL(PRIORVALUE(CRM_VBS_SOAR_VBS_Decision__c ), &apos;SOAR1 Qualified&apos;)), TRUE,FALSE ))</errorConditionFormula>
        <errorMessage>Only SOAR1 Qualified records can be set as SOAR3 Approved.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_StageChange</fullName>
        <active>false</active>
        <description>use not able to update stage if decision is Unqlified</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE ,(ISCHANGED(CRM_VBS_SOAR_Stage__c) &amp;&amp; ISPICKVAL(CRM_VBS_SOAR_VBS_Decision__c , &apos;SOAR1 Un-qualified&apos;)) )</errorConditionFormula>
        <errorDisplayField>CRM_VBS_SOAR_VBS_Decision__c</errorDisplayField>
        <errorMessage>You cannot update stage for Un-qualified record</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Stage_Restriction_Opp_Lost</fullName>
        <active>false</active>
        <description>SOAR Committee/Data Ops can change the Stage when Opportunity is Lost.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF(
ISCHANGED(CRM_VBS_SOAR_Stage__c) &amp;&amp; 
NOT(OR($Permission.CRM_SOAR_Committee,$Profile.Name= &quot;Data Ops&quot;)) &amp;&amp; 
ISPICKVAL(CRM_VBS_SOAR_Opportunity__r.StageName,&apos;Lost&apos;),TRUE,FALSE)
)</errorConditionFormula>
        <errorMessage>You do not have access to modify the Stage. Only SOAR Committee/ Data Ops can do it.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Stage_Updation_Restrcit_For_DW</fullName>
        <active>true</active>
        <description>Can move the VBS Stage to &apos;SOAR5 - Lessons Learned&apos; if the Opportunity is DW/PW/PL/PC.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF(
AND(OR(ISPICKVAL(CRM_VBS_SOAR_Opportunity__r.StageName, &apos;Design Win&apos;),ISPICKVAL(CRM_VBS_SOAR_Opportunity__r.StageName, &apos;Production Win&apos;),ISPICKVAL(CRM_VBS_SOAR_Opportunity__r.StageName, &apos;Production Lost&apos;),ISPICKVAL(CRM_VBS_SOAR_Opportunity__r.StageName, &apos;Production Cancelled&apos;)), NOT(ISPICKVAL( CRM_VBS_SOAR_Stage__c , &apos;SOAR5 - Lessons Learned&apos;)),
ISCHANGED(CRM_VBS_SOAR_Stage__c)),TRUE,FALSE))</errorConditionFormula>
        <errorMessage>This Opportunity is currently in the &apos;Closed&apos; stage. To revert it to a different SOAR stage, please change the status of the opportunity back to an &apos;Open&apos; stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Valid_ARR_Contract_Value</fullName>
        <active>true</active>
        <errorConditionFormula>OR(AND(ISCHANGED(CRM_VBS_Annual_Recurring_Revenue__c ),CRM_VBS_Annual_Recurring_Revenue__c &lt;0),AND(ISCHANGED( CRM_VBS_Total_Contract_Value__c ),CRM_VBS_Total_Contract_Value__c &lt;0))</errorConditionFormula>
        <errorMessage>Please enter a valid amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Valid_Contract_Lifetime</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISCHANGED(CRM_VBS_Contract_Lifetime_in_Months__c),CRM_VBS_Contract_Lifetime_in_Months__c &lt; 0
)</errorConditionFormula>
        <errorDisplayField>CRM_VBS_Contract_Lifetime_in_Months__c</errorDisplayField>
        <errorMessage>Please enter a numeric value.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>CRM_VBS_Refresh</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>CRM_VBS_Refresh</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>/apex/CRM_VBS_refreshSOAR</url>
    </webLinks>
</CustomObject>
