    <fields>
        <fullName>CRM_VBS_Annual_Recurring_Revenue__c</fullName>
        <description>The sum of the highest rolling 12 month period of committed/guaranteed revenue (if there is a convenience clause, only amounts up to convenience clause date are includable). Could it be blank for non-renewal based contracts? Possible, enter zero</description>
        <inlineHelpText>The sum of the highest rolling 12 month period of committed/guaranteed revenue (if there is a convenience clause, only amounts up to convenience clause date are includable).</inlineHelpText>
        <label>Annual Recurring Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
