    <fieldSets>
        <fullName>Core_MDF_IPA_Campaign_Purpose_FieldSet</fullName>
        <description>To be used for IPA Campaign Purpose</description>
        <displayedFields>
            <field>Core_MDF_Outcomes_nm__c</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>Core_MDF_Initial_Baseline_Quantity_nbr__c</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>true</isRequired>
        </displayedFields>
        <displayedFields>
            <field>Core_MDF_Goal_Quantity_nbr__c</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>true</isRequired>
        </displayedFields>
        <displayedFields>
            <field>Core_MDF_Quantity_nbr__c</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>Core_MDF_Outcome_Criteria_txt__c</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <label>IPA Campaign Purpose FieldSet</label>
    </fieldSets>
    <fields>
        <fullName>Core_MDF_Active_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Campaign_Id__c</fullName>
        <label>Campaign</label>
        <referenceTo>Campaign</referenceTo>
        <relationshipName>Campaign_Outcomes</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Goal_Quantity_nbr__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Post-Campaign value of the outcome metric we define as success. Entered prior to execution.</inlineHelpText>
        <label>Goal Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Initial_Baseline_Quantity_nbr__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Expected value of the outcome metric without this Campaign. Entered prior to execution.</inlineHelpText>
        <label>Baseline Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Outcome_Criteria_txt__c</fullName>
        <inlineHelpText>Details that add specificity to the outcome metric (e.g. “compared to the same half last year for server products based on 4th, 5th, and 6th gen Intel Xeon processors”). Entered prior to execution.</inlineHelpText>
        <label>Outcome Criteria</label>
        <length>1000</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Outcomes_nm__c</fullName>
        <label>Outcome Metric</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Outcomes_nm</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Quantity_nbr__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Post-Campaign value of the outcome metric. To be updated once the campaign is Completed.</inlineHelpText>
        <label>Result Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Campaign Purpose</label>
    <nameField>
        <displayFormat>CO-{0000}</displayFormat>
        <label>Campaign Outcome Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Campaign Purposes</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
