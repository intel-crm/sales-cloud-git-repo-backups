    <sharingModel>Read</sharingModel>
    <validationRules>
        <fullName>Core_IPS_BackendSystem_Def_Dup_Check</fullName>
        <active>true</active>
        <description>This validation rule checks whether the backend System definition is duplicate or not by comparing the name field</description>
        <errorConditionFormula>(Name =  VLOOKUP( $ObjectType.Core_IPS_Backend_System__c.Fields.Name , $ObjectType.Core_IPS_Backend_System__c.Fields.Name, Name) ) &amp;&amp;  ISNEW()</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Duplicate Backend System Definition. Please choose another name.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Reprocess_Failed_IPSCasePromotes</fullName>
        <availability>online</availability>
        <description>This button upon click will reprocess the failed promotes/updates case/Comments/attachment related to corresponding Backend System</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Reprocess Failed IPSCasePromotes</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/54.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/54.0/apex.js&quot;)}
var backEndId = &apos;{!Core_IPS_Backend_System__c.Id}&apos;;
var res;

if(backEndId !=null)
{
res=confirm(&quot;Are you sure to continue?&quot;);
}
if(res==true){
var ressrting=sforce.apex.execute(&quot;Core_IPS_Reprocess_Backend_FailedRecords&quot;, &quot;reProcessRecordsFromBackSystem&quot;,{backEndSystemId:backEndId}); alert(&apos;Processing Completed&apos;);
}
sforce.debug.trace=true;</url>
    </webLinks>
</CustomObject>
