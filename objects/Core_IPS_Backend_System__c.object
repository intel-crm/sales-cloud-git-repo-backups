    <listViews>
        <fullName>JIRA_URL_upgrade_System</fullName>
        <columns>NAME</columns>
        <columns>Core_IPS_Backend_Connection_String__c</columns>
        <columns>Core_IPS_Backend_System_Name__c</columns>
        <columns>Core_IPS_Deactivated__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>NAME</field>
            <operation>contains</operation>
            <value>JIRA</value>
        </filters>
        <filters>
            <field>Core_IPS_Deactivated__c</field>
            <operation>equals</operation>
            <value>0</value>
        </filters>
        <filters>
            <field>NAME</field>
            <operation>notContain</operation>
            <value>test</value>
        </filters>
        <label>Active Jira Backends</label>
        <language>en_US</language>
    </listViews>
