    <fields>
        <fullName>PMP_Active_Ind__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Shows if a specification is active or not</description>
        <inlineHelpText>Shows if a specification is active or not</inlineHelpText>
        <label>Is Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Ancestor_Specification_Cd__c</fullName>
        <description>Displays the Specification ancestor Id separated by &quot;|&quot; Symbol</description>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.PMP_Partner_Product_Specification_Id__c)), PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.PMP_Partner_Product_Specification_Id__c + &quot;|&quot; + PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.PMP_Partner_Product_Specification_Id__c + &quot;|&quot; + PMP_Parent_Specification_Id__r.PMP_Partner_Product_Specification_Id__c, 
IF(NOT(ISBLANK(PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.PMP_Partner_Product_Specification_Id__c)), PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.PMP_Partner_Product_Specification_Id__c + &quot;|&quot; + PMP_Parent_Specification_Id__r.PMP_Partner_Product_Specification_Id__c, 
IF(NOT(ISBLANK(PMP_Parent_Specification_Id__r.PMP_Partner_Product_Specification_Id__c)),PMP_Parent_Specification_Id__r.PMP_Partner_Product_Specification_Id__c, 
&quot;&quot;)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Displays the Specification ancestor Id separated by &quot;|&quot; Symbol</inlineHelpText>
        <label>Ancestor Specification Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Ancestor_Specification_Nm__c</fullName>
        <description>Displays the Ancestor Specification Names separated by &apos;|&quot;</description>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.Name)), PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.Name + &quot;|&quot; + PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.Name + &quot;|&quot; + PMP_Parent_Specification_Id__r.Name, 
IF(NOT(ISBLANK(PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.Name)), PMP_Parent_Specification_Id__r.PMP_Parent_Specification_Id__r.Name + &quot;|&quot; + PMP_Parent_Specification_Id__r.Name, 
IF(NOT(ISBLANK(PMP_Parent_Specification_Id__r.Name)),PMP_Parent_Specification_Id__r.Name, 
&quot;&quot;)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Displays the Ancestor Specification Names separated by &quot;|&quot;</inlineHelpText>
        <label>Ancestor Specification Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
