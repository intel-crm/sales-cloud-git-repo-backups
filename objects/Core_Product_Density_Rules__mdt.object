<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Code_Name__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Code Name</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Density_End_Char__c</fullName>
        <description>This will store the End Character(s) number of OPN Field to extract the value for Density</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Density End Char</label>
        <length>5</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Density_Start_Char__c</fullName>
        <description>This will store the Start Character(s) number of OPN Field to extract the value for Density</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Density Start Char</label>
        <length>5</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Density__c</fullName>
        <description>This will store the value to be added as part of a suffix to the determined Density Value</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Density Output Suffix</label>
        <length>10</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <defaultValue>true</defaultValue>
        <description>This will store if the Rule is Active or Not</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>IsActive</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>OPN_Char_Contain__c</fullName>
        <description>This will store the list of OPN Substring Text which needs to cross checked to determine the Density Rule</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>OPN Char Contain</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>OPN_End_Char__c</fullName>
        <description>This will store the End Character number of OPN Field for the text needs to be extracted</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>OPN End Char</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>OPN_Start_Char__c</fullName>
        <description>This will store the Start Character number of OPN Field for the text needs to be extracted</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>OPN Start Char</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Product Density Rule</label>
    <listViews>
        <fullName>ALL_Rules</fullName>
        <columns>DeveloperName</columns>
        <columns>MasterLabel</columns>
        <columns>IsActive__c</columns>
        <columns>Code_Name__c</columns>
        <columns>OPN_Start_Char__c</columns>
        <columns>OPN_End_Char__c</columns>
