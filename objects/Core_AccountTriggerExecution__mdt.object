<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>The metadata stores Class names of Account Trigger functionalities</description>
    <fields>
        <fullName>Apex_Class_Name__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Field to capture the Apex class name holding Trigger functionality logic</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Apex Class Name</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Execution_Order__c</fullName>
        <description>Field to capture execution order of the Trigger apex classes</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Execution Order</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Interface_Name__c</fullName>
        <description>Field to capture Interface Name for the trigger class</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Interface Name</label>
        <length>50</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <defaultValue>true</defaultValue>
        <description>The field to mark apex class as active/inactive</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>IsActive</label>
        <type>Checkbox</type>
    </fields>
    <label>Core_AccountTriggerExecution</label>
    <listViews>
        <fullName>All_Account_Trigger_Executions</fullName>
        <columns>MasterLabel</columns>
        <columns>DeveloperName</columns>
        <columns>NamespacePrefix</columns>
        <columns>Apex_Class_Name__c</columns>
        <columns>Interface_Name__c</columns>
        <columns>IsActive__c</columns>
        <columns>Execution_Order__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Account Trigger Executions</label>
        <language>en_US</language>
    </listViews>
    <listViews>
        <fullName>IAfterInsertAccountTrigger</fullName>
        <columns>Execution_Order__c</columns>
        <columns>MasterLabel</columns>
        <columns>DeveloperName</columns>
        <columns>Apex_Class_Name__c</columns>
        <columns>Interface_Name__c</columns>
        <columns>IsActive__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Interface_Name__c</field>
            <operation>equals</operation>
            <value>IAfterInsertAccountTrigger</value>
        </filters>
        <filters>
            <field>Apex_Class_Name__c</field>
            <operation>notContain</operation>
            <value>Test</value>
        </filters>
        <label>IAfterInsertAccountTrigger</label>
        <language>en_US</language>
    </listViews>
