    <webLinks>
        <fullName>EditCustom</fullName>
        <availability>online</availability>
        <description>Redirects to standard page for internal users and custom page for external users</description>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Edit Custom</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <url>{!IF(AND(($Profile.Name != &apos;IPS External Customer&apos;),($Profile.Name != $Label.Core_IPS_Partner_AE_ProfileName),($Profile.Name != &apos;Partner&apos; )), URLFOR($Action.Core_IPS_Project__c.Edit, Core_IPS_Project__c.Id), URLFOR(&apos;/apex/Core_IPS_Project_Edit_Page?id=&apos; + Core_IPS_Project__c.Id))}</url>
    </webLinks>
    <webLinks>
        <fullName>NewCustomButton</fullName>
        <availability>online</availability>
        <description>For routing different pages for IPS External and internal Users</description>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>New</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>window.location =&quot;apex/Core_ExternalUser_IPS_Project&quot;</url>
    </webLinks>
    <webLinks>
        <fullName>New_Custom</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>New Custom</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!IF(AND(($Profile.Name != &apos;IPS External Customer&apos;),($Profile.Name != $Label.Core_IPS_Partner_AE_ProfileName),($Profile.Name != &apos;Partner&apos; )), URLFOR($Action.Core_IPS_Project__c.New), URLFOR(&apos;/apex/Core_ExternalUser_IPS_Project&apos;))}</url>
    </webLinks>
    <webLinks>
        <fullName>Status_Update</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Status Update</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/31.0/connection.js&quot;)}

var statusUpdate=new sforce.SObject(&quot;Core_IPS_Project__c&quot;);
statusUpdate.Id=&apos;{!Core_IPS_Project__c.Id}&apos;;
statusCheck = &apos;{!Core_IPS_Project__c.Core_Status__c}&apos;;
if(statusCheck==&quot;Active&quot;){
statusUpdate.Core_Status__c=&quot;Inactive&quot;;
}else
{
  statusUpdate.Core_Status__c=&quot;Active&quot;;
}

var result=sforce.connection.update([statusUpdate]);
if (result[0].getBoolean(&quot;success&quot;)){
        alert(&quot;Status updated successfully &quot;);
	window.location.reload();
}else
{
        console.log(result[0]);
	alert(&quot;You are not having permission to update this project Status&quot;);
}</url>
    </webLinks>
    <webLinks>
        <fullName>core_Submit</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Submit</masterLabel>
        <openType>sidebar</openType>
        <page>Core_IPS_submitProject</page>
        <protected>false</protected>
    </webLinks>
</CustomObject>
