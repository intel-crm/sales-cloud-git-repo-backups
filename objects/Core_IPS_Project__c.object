    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>CORE_IPS_INTELSUPPORTTEAM_COUNT</fullName>
        <active>true</active>
        <description>To display error message when intel support team count is exceeded 50</description>
        <errorConditionFormula>AND( 
		ISCHANGED(Core_IPS_Enable_ISTasInterested_Parties__c),
  Core_IPS_Enable_ISTasInterested_Parties__c = TRUE, 
		Intel_Support_Team_Count__c &gt;50
)</errorConditionFormula>
        <errorMessage>Cannot enable more than 50 IST members in bulk. Please enable them individually from related records</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CORE_IPS_PROJECTMEMBER_COUNT</fullName>
        <active>true</active>
        <description>To Display error message when project member count  is exceeded 50</description>
        <errorConditionFormula>AND( 
		ISCHANGED(Core_IPS_EnableMemberasInterestedParties__c),
		Core_IPS_EnableMemberasInterestedParties__c = TRUE, 
		Core_Number_of_Users__c &gt; 50
)</errorConditionFormula>
        <errorMessage>Cannot enable more than 50 Project members in bulk. Please enable them individually from related records</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_Make_Active</fullName>
        <active>false</active>
        <errorConditionFormula>AND( OR(ISPICKVAL( Core_Status__c , &apos;Submitted Pending&apos;), ISPICKVAL( Core_Status__c , &apos;Active&apos;)), OR(Core_Number_of_Products__c==0,Core_Number_of_Accounts__c==0,Core_Number_of_Users__c==0))</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Project cannot be made Active without atleast one Account and one Product and one Project Member</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_OneContactRequired</fullName>
        <active>false</active>
        <description>When creating or editing a project, validation should ensure that at least one contact is associated to the projects</description>
        <errorConditionFormula>Number_of_Active_Users__c&lt;1</errorConditionFormula>
        <errorMessage>At least one contact should be associated to the Project</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_PreventCheckingPrivate</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED( Core_IPS_Private__c ) &amp;&amp; $User.Id !=  OwnerId &amp;&amp;  ISPICKVAL( Core_Status__c , &apos;Draft&apos;) &amp;&amp; $Profile.Name &lt;&gt; $Label.Core_IPS_Data_Migration_Profile_Name &amp;&amp; $Profile.Name &lt;&gt; $Label.Core_IPS_System_Admin_Profile_Name &amp;&amp;  
$Profile.Name &lt;&gt; $Label.Core_IPS_IT_Admin_Profile &amp;&amp; $Setup.Core_IPS_Run_Rules_Exception_Admin__c.Run_Validation_Rule__c</errorConditionFormula>
        <errorMessage>Only an Intel Project Owner may edit the Private setting</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Private_Project_Owner_Check</fullName>
        <active>true</active>
        <description>Core_IPS_Private_Project_Owner_Check</description>
        <errorConditionFormula>AND(Core_IPS_Private__c, 
								NOT(
								    OR(
																CONTAINS($Label.Core_IPS_Agent_Profile_Ids, LEFT( Owner:User.ProfileId , 15)),
											    	CONTAINS($Label.Core_IPS_Agent_Partner_Profile_id, LEFT( Owner:User.ProfileId , 15))
												)
								 ),
				    OR( 
												ISCHANGED( Core_Status__c),
											 ISCHANGED( OwnerId )
								  ),
				    OR( 
												ISPICKVAL( Core_Status__c, &quot;Active&quot;),
											 ISPICKVAL( Core_Status__c, &quot;Submitted Pending&quot;)
								   )
							)</errorConditionFormula>
        <errorMessage>The Owner of a Private Project must be an IPS Agent in order to set the Status to Active.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Project_MPNDA_Mandatory</fullName>
        <active>true</active>
        <description>MPNDA is mandatory on addition of more than one Account</description>
        <errorConditionFormula>AND(Core_Number_of_Accounts__c &gt;1,ISBLANK(Core_MPNDA__c ) )</errorConditionFormula>
        <errorMessage>A valid MPNDA is required prior to adding secondary Accounts to a Premier Support Project</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Project_StatusAtProjCreate</fullName>
        <active>true</active>
        <description>Project Status should not be other than Draft at the time of creation of Project</description>
        <errorConditionFormula>AND (ISNEW(), NOT(ISPICKVAL(PRIORVALUE(Core_Status__c), &quot;Draft&quot;)),TEXT($User.UserType)!=$Label.Core_IPS_Partner_Community_User_Type,TEXT($User.UserType)!= $Label.Core_IPS_CustCommPlus_UserType )</errorConditionFormula>
        <errorMessage>Status must be set to Draft when creating a Project</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Project_Status_field_edit</fullName>
        <active>false</active>
        <description>Project status field can&apos;t be changed to &quot;Draft&quot; value once the project record is active</description>
        <errorConditionFormula>AND(
$Profile.Name!=$Label.Core_IPS_DataMigration_ProfileName,
ISCHANGED(Core_Status__c),
NOT(ISPICKVAL(PRIORVALUE(Core_Status__c), &quot;Draft&quot;)),
ISPICKVAL(Core_Status__c, &quot;Draft&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Project Status value can&apos;t be changed to Draft once the project is active.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Project_cannot_be_activated</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL(Core_Status__c,&apos;New&apos;), 
Core_Number_of_Accounts__c = 0,
Core_Number_of_Products__c = 0
)</errorConditionFormula>
        <errorMessage>Project cannot be submitted without atleast one Account and one Product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Restrict_Changing_Private</fullName>
        <active>true</active>
        <description>This is to Restrict Changing the Private Checkbox When the Project is not in Draft Status</description>
        <errorConditionFormula>ISCHANGED( Core_IPS_Private__c ) &amp;&amp; NOT(  ISPICKVAL(Core_Status__c , &apos;DRAFT&apos;)) &amp;&amp; $Profile.Name &lt;&gt; $Label.Core_IPS_Data_Migration_Profile_Name</errorConditionFormula>
        <errorMessage>Premier Support Projects must be in the Draft state when being set to Private</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SubRegionNotNullIfRegionExistedOnNewProj</fullName>
        <active>true</active>
        <description>Sub-Region is required when creating / Updating the Project with a specified Region</description>
        <errorConditionFormula>AND(
NOT(ISBLANK(TEXT(Region__c))),
ISBLANK(TEXT(Sub_Region__c)),
NOT(ISCHANGED(Core_Number_of_Products__c)),
NOT(ISCHANGED(Core_Number_of_Users__c))
)</errorConditionFormula>
        <errorDisplayField>Sub_Region__c</errorDisplayField>
        <errorMessage>Sub-Region is required when creating / Updating the Project with a specified Region</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
