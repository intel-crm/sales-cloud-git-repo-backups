    <fields>
        <fullName>Core_As_Measured_By__c</fullName>
        <description>Field to capture how the Milestone is measured.</description>
        <label>As Measured By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_Deployment_Quantity__c</fullName>
        <description>Required for ISG client utilization milestone goal tracking. Please specify the deployment/utilization (activation) quantities associated to “AMT, Unite, ProWIdi, Widoc, Authenticate” Milestone Focus</description>
        <externalId>false</externalId>
        <inlineHelpText>Required for ISG client utilization milestone goal tracking. Please specify the deployment/utilization (activation) quantities associated to “AMT, Unite, ProWIdi, Widoc, Authenticate” Milestone Focus</inlineHelpText>
        <label>Deployment Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_Milestone_Date__c</fullName>
        <description>Sets to &apos;Milestone Claim Date&apos; if available, otherwise sets to &apos;Milestone Date&apos;.</description>
        <formula>IF( ISNULL(Core_Milestone_Claim_Date__c) , Core_Milestone_Date__c,  Core_Milestone_Claim_Date__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>KPI - Milestone Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Milestone_Approved_Date__c</fullName>
        <label>Milestone Approved Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Milestone_Area__c</fullName>
        <description>Calculated field to provide the Milestone Area, based on common agreement used for Milestone Focus field.</description>
        <externalId>false</externalId>
        <formula>IF(FIND( &quot;:&quot;, TEXT(Core_Milestone_Focus__c))&gt;0,
   LEFT(TEXT(Core_Milestone_Focus__c), (FIND( &quot;:&quot;, TEXT(Core_Milestone_Focus__c))-1)),
   &quot;Other&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Calculated field to provide the Milestone Area, based on common agreement used for Milestone Focus field.</inlineHelpText>
        <label>Milestone Area (Do Not Use)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Milestone_Claim_Date__c</fullName>
        <label>Milestone Claim Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Milestone_Commissionable__c</fullName>
        <label>Milestone Commissionable?</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Yes</fullName>
                    <default>true</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Milestone_Date__c</fullName>
        <description>Due Date for the milestone</description>
        <inlineHelpText>Date when the Milestone Owner expects the specific milestone focus work to be complete. It should be updated if the forecast changes prior to claiming a win. Upon milestone completion (win claim or cancel), the owner must update the date.</inlineHelpText>
        <label>Milestone Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Milestone_Description__c</fullName>
