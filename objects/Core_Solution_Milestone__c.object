    <fields>
        <fullName>Core_Milestone_Oppty__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>[DO NOT DELETE] This Field is created to fix the Missing Report Type (Opportunity with Milestone and Opportunity.</description>
        <label>Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Milestones (Opportunity)</relationshipLabel>
        <relationshipName>Milestones</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Milestone_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(CONTAINS(TEXT(Core_Milestone__c),&quot;Marketing&quot;),CONTAINS(TEXT(Core_Milestone__c),&quot;Cust Ref Prog&quot;)),&quot;Marketing&quot;,&quot;Solution Adoption&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Milestone Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
