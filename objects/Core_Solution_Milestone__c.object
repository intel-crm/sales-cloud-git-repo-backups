    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_MileStone_SubAppr_To_Pend</fullName>
        <active>true</active>
        <description>Prevent users from changing milestone Status from &quot;Submitted for Approval&quot; to &quot;Pending&quot;</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
ISCHANGED(Core_Status__c), 
text(PRIORVALUE(Core_Status__c)) = &quot;Submitted for Approval&quot;, 
TEXT(Core_Status__c) = &quot;Pending&quot;
)

)</errorConditionFormula>
        <errorMessage>To set the milestone back to pending, submitter can use the Recall Approval Request button in the Approval History section or the approving manager can reject the approval request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Milestone_Deployment_Qty</fullName>
        <active>true</active>
        <description>•[Deployment Quantity] should become required if the [Milestone] = &quot;Deployment / Delivery&quot; AND [Use Case or Key Technology] = one of the following:
◦Client: AMT
◦Client: Prowidi
◦Client: Unite
◦Client: Widock
◦Client: Authenticate</description>
        <errorConditionFormula>And(
 isnull(Core_Deployment_Quantity__c),
AND(
 ISPICKVAL(Core_Milestone__c, &quot;Deployment / Delivery&quot;),
OR(
 ISPICKVAL(Core_Use_Case__c, &quot;Client: AMT Activation&quot;),
 ISPICKVAL(Core_Use_Case__c, &quot;Client: ProWidi&quot;),
 ISPICKVAL(Core_Use_Case__c, &quot;Client: Unite&quot;),
 ISPICKVAL(Core_Use_Case__c, &quot;Client: WiDock&quot;),
 ISPICKVAL(Core_Use_Case__c, &quot;Client: Authenticate&quot;)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Deployment_Quantity__c</errorDisplayField>
        <errorMessage>Deployment Quantity is required for the Milestone and Use Case or Key Technology selected</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Milestone_Prevent_Owner_Change</fullName>
        <active>true</active>
        <description>Prevent the user from changing the owner if the milestone is in &apos;Submitted for Approval&apos; status.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND
(
ISCHANGED(Core_Owner__c),
ISPICKVAL(Core_Status__c , &apos;Submitted for Approval&apos;)
)

)</errorConditionFormula>
        <errorDisplayField>Core_Owner__c</errorDisplayField>
        <errorMessage>The milestone owner cannot be changed while the milestone is in submitted
status. Please recall the approval request to change the owner.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_Milestone_Credit</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Milestone Credit</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/00Oo0000004d1eD?pv0={!Opportunity.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Recall_Approval</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Recall Approval</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/20.0/connection.js&quot;)} 
    {!REQUIRESCRIPT(&quot;/soap/ajax/20.0/apex.js&quot;)} 
    var x;
    if (confirm(&quot;Are you Sure?&quot;) == true) {
        x = &quot;Ok&quot;;
    } else {
        x = &quot;Cancel&quot;;
    }
    if(x == &apos;Cancel&apos;){ 
      window.location.replace(&apos;/{!Core_Solution_Milestone__c.Id}&apos;)
    } 

else { 
window.location.replace(&apos;/apex/Core_Milestone_Unlock_Record?id={!Core_Solution_Milestone__c.Id}&apos;)
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_SM_Submit_for_Approval</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Submit for Approval</masterLabel>
        <openType>sidebar</openType>
        <page>Core_SM_redirectApprovalProcess</page>
        <protected>false</protected>
    </webLinks>
</CustomObject>
