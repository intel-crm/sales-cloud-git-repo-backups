    <fields>
        <fullName>Core_MDF_AccountId__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>Lookup field that references the Account associated with this outcome-based allocation mapping. This field stores the Account ID for partner accounts that are part of the MDF outcome-based campaign distribution.</description>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Outcome-Based Account Mappings</relationshipLabel>
        <relationshipName>Campaign_Account_Mappings</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Active_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Boolean indicator that determines whether this account allocation mapping is currently active. When set to false, it indicates the allocation has been deactivated or removed from the outcome-based campaign without deleting the historical record.</description>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Amount_nbr__c</fullName>
        <description>The amount allocated to the associated account for the outcome-based MDF campaign. This field stores the specific dollar value assigned to this partner account as part of the budget distribution.</description>
        <externalId>false</externalId>
        <label>Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_OutcomeBased_SubAct_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>To store sub activity Id&apos;s</description>
        <label>Outcome-Based Sub Activity</label>
        <referenceTo>PartnerFundRequest</referenceTo>
        <relationshipLabel>Outcome-Based Account Mappings (Core_MDF_Outcome_Based_SubActId__c)</relationshipLabel>
        <relationshipName>Outcome_Based_Account_Mappings1</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Outcome_Based_CampaignId__c</fullName>
        <description>Lookup field that references the parent PartnerFundRequest record representing the outcome-based MDF campaign.</description>
        <label>Outcome-Based Campaign</label>
        <referenceTo>PartnerFundRequest</referenceTo>
        <relationshipLabel>Outcome-Based Account Mappings</relationshipLabel>
        <relationshipName>Outcome_Based_Account_Mappings</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Parent_Account__c</fullName>
        <externalId>false</externalId>
        <formula>Core_MDF_AccountId__r.Name</formula>
        <label>Parent Account</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Percentage_pct__c</fullName>
        <description>The percentage allocation assigned to the associated account for the outcome-based MDF campaign. This field represents what portion of the total campaign budget or outcome is allocated to this specific partner account.</description>
        <label>Percentage</label>
        <precision>5</precision>
        <required>true</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <label>Outcome-Based Account Mapping</label>
    <nameField>
        <displayFormat>OutcomeMapping-{0000}</displayFormat>
        <label>Outcome Account Mapping Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Outcome-Based Account Mappings</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
