        <masterLabel>Grant Access</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>//Added by Geetha on 22/11/17 for US79717
var allEmailDomainCheck = &quot;{!JSENCODE($Label.Core_IPS_Email_Check)}&quot;.split(&apos;,&apos;);
var emailDomain = &apos;{!JSENCODE(Contact.Email)}&apos;.split(&quot;@&quot;)[1];
var isPresent = allEmailDomainCheck.indexOf(emailDomain)&gt;=0;
if(isPresent){
  alert(&quot;{!JSENCODE($Label.Core_IPS_Grant_Access_Error_Message)}&quot;);
}else{
  window.open(&quot;/apex/Core_Contact_Entitlements?id={!Contact.Id}&quot;,&apos;_self&apos;);
}</url>
