    <fields>
        <fullName>Core_Duration__c</fullName>
        <externalId>false</externalId>
        <formula>ROUND((NOW()- DATETimeVALUE(LastModifiedDate))*24*60,0)</formula>
        <label>Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_ERPM_Duration__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Core_IPS_Employee_Customer__c , 
Null, 
IF
(

(ISNULL(ROUND((NOW()- DATETimeVALUE(Core_ERPM_Status_Change_Date_Time__c))*24*60,0))), 


ROUND((NOW()- DATETimeVALUE(LastModifiedDate))*24*60,0),
ROUND((NOW()- DATETimeVALUE(Core_ERPM_Status_Change_Date_Time__c))*24*60,0)



))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ERPM Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_ERPM_Integration_Message__c</fullName>
        <label>ERPM Integration Message</label>
        <length>10000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_ERPM_Integration_Publish_Timestamp__c</fullName>
