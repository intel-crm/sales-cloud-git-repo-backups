        <picklistValues>
            <picklist>Pending_Registration__c</picklist>
            <values>
                <fullName>No</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Yes</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
