    <fields>
        <fullName>AccountId</fullName>
        <inlineHelpText>Any new account request should go through Accounts &gt;&gt; select NEW</inlineHelpText>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>notEqual</operation>
                <value>Direct Account, Rejected Account, Requested Account, End Customer Deal Account</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>AssistantName</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>AssistantPhone</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Birthdate</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>BuyerAttributes</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>ContactSource</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Contact_ID__c</fullName>
        <description>Formula field that displayes the value of the Contact ID in Salesforce</description>
        <externalId>false</externalId>
        <formula>CASESAFEID(Id)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contact ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Contacts_Fields_Merged__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;Email - &quot;+Email+&quot; &amp; Account - &quot;+Account.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contact Details</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_AGS_Duration__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Core_IPS_Employee_Customer__c , Null, 
IF
(
(ISNULL(ROUND((NOW()- DATETimeVALUE(Core_AGS_Status_Change_Date_Time__c))*24*60,0))), 
 ROUND((NOW()- DATETimeVALUE(LastModifiedDate))*24*60,0),
 ROUND((NOW()- DATETimeVALUE(Core_AGS_Status_Change_Date_Time__c))*24*60,0)

))</formula>
        <label>AGS Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_AGS_Inactive__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Today when AGS deletes a user, it updates a field &quot;Inactive&quot; on the User record directly in Salesforce. We can use this update as a trigger point to set the checkbox flag &quot;AGS Inactive&quot; on the associated Contact of the User record.</description>
        <label>AGS Inactive</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_AGS_Integration_Message__c</fullName>
        <inlineHelpText>For next steps on error, refer to Entitlement Integration Status Details</inlineHelpText>
        <label>AGS Integration Message</label>
        <length>10000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_AGS_Integration_Status__c</fullName>
        <label>AGS Integration Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Successful</fullName>
                    <default>false</default>
                    <label>Successful</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_AGS_Pending_Time__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
AND( 
   TEXT( Core_AGS_Integration_Status__c ) = &apos;Pending&apos; 
   ), 
(NOW() -  Core_AGS_Status_Change_Date_Time__c )*24*60, 
0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>AGS Pending Time</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_AGS_Republish_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This flag is set to TRUE when new Entitlements are added while the current AGS outbound message is being processed. If this is set to TRUE, a second message is sent to AGS once the response comes back from the current message.</description>
        <label>AGS Re-publish Ind</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_AGS_Retry_Count__c</fullName>
        <description>This field stores the number of retry attempts made upon failure on AGS Integration.</description>
        <externalId>false</externalId>
        <inlineHelpText>Number of retry attempts made upon failure on AGS Integration.</inlineHelpText>
        <label>AGS Retry Count</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_AGS_Status_Change_Date_Time__c</fullName>
        <label>AGS Status Change Date/Time</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Account_Changeable__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Is Account Changeable</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
