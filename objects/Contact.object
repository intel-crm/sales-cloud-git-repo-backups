    <fields>
        <fullName>Core_Duration__c</fullName>
        <externalId>false</externalId>
        <formula>ROUND((NOW()- DATETimeVALUE(LastModifiedDate))*24*60,0)</formula>
        <label>Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_ERPM_Duration__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Core_IPS_Employee_Customer__c , 
Null, 
IF
(

(ISNULL(ROUND((NOW()- DATETimeVALUE(Core_ERPM_Status_Change_Date_Time__c))*24*60,0))), 


ROUND((NOW()- DATETimeVALUE(LastModifiedDate))*24*60,0),
ROUND((NOW()- DATETimeVALUE(Core_ERPM_Status_Change_Date_Time__c))*24*60,0)



))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ERPM Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_ERPM_Integration_Message__c</fullName>
        <label>ERPM Integration Message</label>
        <length>10000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_ERPM_Integration_Publish_Timestamp__c</fullName>
        <label>ERPM Integration Publish Timestamp</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_ERPM_Integration_Status__c</fullName>
        <label>ERPM Integration Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Successful</fullName>
                    <default>false</default>
                    <label>Successful</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_ERPM_Pending_Time__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
AND( 
TEXT( Core_ERPM_Integration_Status__c ) = &apos;Pending&apos;), 
(NOW() -  Core_ERPM_Status_Change_Date_Time__c )*24*60, 
0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ERPM Pending Time</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_ERPM_Status_Change_Date_Time__c</fullName>
        <label>ERPM Status Change Date/Time</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Email_Domain__c</fullName>
        <description>The domain of the email address. Includes @ sign.</description>
        <externalId>false</externalId>
