IF(INCLUDES(Core_Audience_List__c,&quot;RMF External User Administrator&quot;),&quot;RMF External User Administrator;&quot;,null)&amp;
IF(INCLUDES(Core_Audience_List__c,&quot;RMF External Claim Submitter&quot;),&quot;RMF External Claim Submitter;&quot;,null)&amp;
