    </fields>
    <fields>
        <fullName>Core_Account_Primary_Postal_Code__c</fullName>
        <externalId>false</externalId>
        <formula>Account.BillingPostalCode</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
