    <fields>
        <fullName>Core_Account_Primary_Name__c</fullName>
        <description>Formula field to get the Name of the Account associated to this Contact. Will be originally used by Salesforce-Cvent Integration. But can be used for other uses in future.</description>
        <externalId>false</externalId>
        <formula>Account.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Formula field to get the Name of the Account associated to this Contact. Will be originally used by Salesforce-Cvent Integration. But can be used for other uses in future.</inlineHelpText>
        <label>Account Primary Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
