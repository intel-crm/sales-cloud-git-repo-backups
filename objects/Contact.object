        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Email_Domain__c</fullName>
        <description>The domain of the email address. Includes @ sign.</description>
        <externalId>false</externalId>
        <formula>RIGHT(Email, (LEN(Email) - FIND(&apos;@&apos;, Email)) + 1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Email Domain</label>
        <required>false</required>
