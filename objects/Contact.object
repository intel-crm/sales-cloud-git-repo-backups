    <fields>
        <fullName>Core_Audience__c</fullName>
        <externalId>false</externalId>
        <formula>IF(INCLUDES(Core_Audience_List__c,&quot;CCF Account Budget Administrator&quot;),&quot;CCF Account Budget Administrator;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;CCF Activity Submitter&quot;),&quot;CCF Activity Submitter;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;CCF Claim Submitter&quot;),&quot;CCF Claim Submitter;&quot;,null)&amp; 
