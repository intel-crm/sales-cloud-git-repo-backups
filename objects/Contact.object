    <fields>
        <fullName>Core_IPS_Active__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This flag when checked enables the contact to access IPS, only when the associated an Account is not Export Compliance Block and an Intel Support Owner has been identified. When this flag is unchecked the the contact cannot access IPS.</description>
        <inlineHelpText>Provides access for external customer contacts to submit questions, problems and technical support issues to Intel® Premier Support, as well as monitor previously submitted issues.</inlineHelpText>
        <label>IPS Active</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Alternate_Support_Org__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <inlineHelpText>Support Org or Product Focus Area associated with the Alternate Support Owner</inlineHelpText>
        <label>Alternate&apos;s Support Org</label>
        <referenceTo>Core_IPS_Product_Organization__c</referenceTo>
        <relationshipLabel>Contacts</relationshipLabel>
        <relationshipName>Contacts</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Alternate_Support_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <inlineHelpText>Alternate representative who becomes the support owner if the contact&apos;s case is related to a particular Support Org</inlineHelpText>
        <label>Alternate Support Owner</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Alternate Support Owner should be Internal User</errorMessage>
            <filterItems>
                <field>User.UserType</field>
                <operation>equals</operation>
                <value>Standard</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>Contacts1</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_By_Pass_Validation__c</fullName>
        <defaultValue>false</defaultValue>
        <description>US36728 : This Field  By  the validation Rule Core_IPS_Intel_Support_Owner_Not_Blank	when on account  Export Compliance Block is true</description>
        <label>Core IPS By Pass Validation</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Email_Opt_Out__c</fullName>
        <defaultValue>false</defaultValue>
        <description>The IPS Email Opt Out flag is the mechanism to allow External Contacts the ability to opt out of all emails sent from IPS.</description>
        <label>IPS Email Opt Out</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Employee_Customer__c</fullName>
        <formula>AND (IF(  CONTAINS(UPPER(SUBSTITUTE(Email, LEFT(Email, FIND(&quot;@&quot;, Email)), NULL)),&apos;INTEL.COM&apos;), 
True, 
False), IF(  CONTAINS(UPPER(SUBSTITUTE(Email, LEFT(Email, FIND(&quot;@&quot;, Email)), NULL)),&apos;RETAILEDGEINTEL.COM&apos;), 
False, 
True))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Employee Customer?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Intel_Support_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Intel Support Owner is the Intel Representative that is in charge of all Pre-Sales Support functionality. This person is typically the technical owner and/or sales representative.</description>
        <inlineHelpText>Representative who is the default owner for the contact&apos;s case support</inlineHelpText>
        <label>Intel Support Owner</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Intel Support Owner should be Internal User</errorMessage>
            <filterItems>
                <field>User.UserType</field>
                <operation>equals</operation>
                <value>Standard</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>IPS_Supported_Contacts</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Is_Contact_Check__c</fullName>
        <formula>If($User.Core_IPS_AccountId__c==AccountId,true,false )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core IPS Is Contact Check</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
