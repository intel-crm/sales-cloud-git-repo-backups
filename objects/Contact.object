    <fields>
        <fullName>Core_ERPM_Pending_Time__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
AND( 
TEXT( Core_ERPM_Integration_Status__c ) = &apos;Pending&apos;), 
(NOW() -  Core_ERPM_Status_Change_Date_Time__c )*24*60, 
0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ERPM Pending Time</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
