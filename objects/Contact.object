    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_Account_Name_Cannot_Update</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
IF(AccountId !=null, if( PRIORVALUE(AccountId) != AccountId,true,false ) , false),
NOT(Core_Account_Changeable__c),
$Profile.Name &lt;&gt; &apos;Data Ops&apos;)
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Use  &quot;Change Account&quot; button to Update Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_B2B_English_Only_First_Name</fullName>
        <active>true</active>
        <description>Don&apos;t allow Core English Only First Name to be blanked out when the B2B Indicator field is checked on the Contact.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
NOT(ISBLANK(PRIORVALUE(Core_English_Only_First_Name__c))) &amp;&amp; ISBLANK(Core_English_Only_First_Name__c) &amp;&amp; Core_Contact_B2B_Indicator__c  = true
)</errorConditionFormula>
        <errorMessage>Core English Only First Name data cannot be removed on a B2B contact.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_B2B_English_Only_Last_Name</fullName>
        <active>true</active>
        <description>Don&apos;t allow Core English Only Last Name to be blanked out when the B2B Indicator field is checked on the Contact.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
NOT(ISBLANK(PRIORVALUE(Core_English_Only_Last_Name__c))) &amp;&amp; ISBLANK(Core_English_Only_Last_Name__c) &amp;&amp; Core_Contact_B2B_Indicator__c  = true
)</errorConditionFormula>
        <errorMessage>Core English Only Last Name data cannot be removed on a B2B contact.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Contact_Deactivation_Reason</fullName>
        <active>true</active>
        <description>Deactivation Reason should be mandated when &apos;Deactivation Requested&apos; flipped to True</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
	 Core_Deactivated__c  = True,
	( ISBLANK(TEXT( Core_Deactivation_Reason__c )))
)
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Please select Deactivation Reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Contact_English_Only_First_Name</fullName>
        <active>true</active>
        <description>Only allow English (alphanumeric ASCII) characters in the English Only First Name field</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
NOT(ISBLANK(Core_English_Only_First_Name__c) || 
    REGEX(Core_English_Only_First_Name__c, &quot;[a-zA-Z0-9 \\p{Punct}]+&quot;))
)</errorConditionFormula>
        <errorDisplayField>Core_English_Only_First_Name__c</errorDisplayField>
        <errorMessage>Only English (alphanumeric ASCII) characters are allowed in the English Only First Name field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Contact_English_Only_Last_Name</fullName>
        <active>true</active>
        <description>Only allow English (alphanumeric ASCII) characters in the English Only Last Name field</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
NOT(ISBLANK(Core_English_Only_Last_Name__c) || 
    REGEX(Core_English_Only_Last_Name__c, &quot;[a-zA-Z0-9 \\p{Punct}]+&quot;))
)</errorConditionFormula>
        <errorDisplayField>Core_English_Only_Last_Name__c</errorDisplayField>
        <errorMessage>Only English (alphanumeric ASCII) characters are allowed in the English Only Last Name field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Do_Not_Contact_to_restrict_Users</fullName>
        <active>true</active>
        <description>If contact record type is Do Not Contact, User should not be Edit fields on Contact Layout – Do Not Contact.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND((NOT($Profile.Name=&apos;System Administrator&apos; ||$Profile.Name=&apos;IT Admin&apos; || $Profile.Name=&apos;Data Ops&apos; ||$Profile.Name=&apos;Integration&apos; ||$Profile.Name=&apos;Integration-IAH&apos;)),
       ( ISCHANGED( FirstName )||
	     ISCHANGED( LastName )|| 
	     ISCHANGED(Core_Login_Status__c)||
		 ISCHANGED(Core_eRPM_Person_Id__c)||
		 ISCHANGED(Core_Enterprise_Id__c)||
		 ISCHANGED(Core_English_Only_First_Name__c)||
		 ISCHANGED(Core_English_Only_Last_Name__c) 
		 ),
		 $RecordType.Name=&apos;Contact Layout – Do Not Contact&apos; 
)
)</errorConditionFormula>
        <errorMessage>You don&apos;t have permission to edit the fields on Don&apos;t contact.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Account_Change_Not_Allowed_EC</fullName>
        <active>true</active>
        <description>Not allowed to change Account for Employee Customers.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( Core_IPS_Employee_Customer__c , 
ISCHANGED( AccountId ), LEFT(AccountId,15) &lt;&gt; $Label.Core_IPS_AccountID)&amp;&amp; PRIORVALUE(AccountId) &lt;&gt;$Label.Core_Partner_Agent_Account_ID_15
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Not allowed to change Account for Employee Customer.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Active_Account_Owner_Role_Null</fullName>
        <active>true</active>
        <description>This validation rule ensures that no Contact is made IPS Active without the Associated Account Owner&apos;s Role being setup in the hierarchy.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
ISBLANK( Account.Owner.UserRole.Name ),  
Core_IPS_Active__c =TRUE
)
)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Active__c</errorDisplayField>
        <errorMessage>Please Contact Data Ops to ensure that the Account Owner  for this Contact&apos;s Account has been setup properly in the Role Hierarchy.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Block_Enablement_MAG_Account</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(Account.Core_Export_Compliance_Block__c = TRUE, Core_IPS_Active__c = TRUE)
)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Active__c</errorDisplayField>
        <errorMessage>The Contact&apos;s Account is under Export Compliance Block and can not be enabled for Intel Premier Support.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Cannot_Modify_EC_Email</fullName>
        <active>true</active>
        <description>Employee customer email cannot be modified.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(OR(  
AND(PRIORVALUE(Core_IPS_Employee_Customer__c ),
 ISCHANGED(Email),
 NOT(Core_IPS_Employee_Customer__c) ),
AND(NOT(PRIORVALUE(Core_IPS_Employee_Customer__c )),
 ISCHANGED(Email),
 Core_IPS_Employee_Customer__c
)),
$Profile.Name&lt;&gt;&apos;System Administrator&apos;)
)</errorConditionFormula>
        <errorDisplayField>Email</errorDisplayField>
        <errorMessage>Cannot change Employee Customer Email address.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Intel_Support_Owner_Not_Blank</fullName>
        <active>true</active>
        <description>When a Contact is enabled for IPS Activity they need to have an Intel Support Owner identified.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(Core_IPS_Active__c,Core_IPS_Intel_Support_Owner__c = &quot;&quot;, NOT(Core_IPS_Employee_Customer__c),NOT(OR(ISBLANK(Account.Core_CNDA_Number__c),(CONTAINS($Label.Core_IPS_Invalid_CNDA, Account.Core_CNDA_Number__c)))))
)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Intel_Support_Owner__c</errorDisplayField>
        <errorMessage>IPS Contacts must have an identified Intel Support Owner for accounts with a CNDA.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_PreventCountryforEC</fullName>
        <active>true</active>
        <description>Prevent Mailing Country Change for Employee Customer</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
(ISCHANGED( MailingCountry ) || ISCHANGED(MailingCountryCode))
&amp;&amp;
NOT(ISBLANK(PRIORVALUE(MailingCountry)))
&amp;&amp;
Core_IPS_Employee_Customer__c
)</errorConditionFormula>
        <errorDisplayField>MailingCountry</errorDisplayField>
        <errorMessage>Cannot change Mailing Country for Employee Customer Contact</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Limit_English_First_Name_Length</fullName>
        <active>true</active>
        <description>Limit English First Name length due to ERPM restrictions.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
LEN( Core_English_Only_First_Name__c ) &gt; 60
)</errorConditionFormula>
        <errorMessage>English Only First Name cannot be longer than 60 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Limit_English_Last_Name_Length</fullName>
        <active>true</active>
        <description>Limit English Last Name field due to ERPM restrictions.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
LEN( Core_English_Only_Last_Name__c ) &gt; 70
)</errorConditionFormula>
        <errorMessage>English Last Name cannot be longer than 70 characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Contact_for_Virtual_Accounts</fullName>
        <active>true</active>
        <description>Prevent Contact creation for Virtual Accounts.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
Account.RecordType.Name = &apos;CoMarketing&apos;
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Contact cannot be created for Virtual Accounts.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Mandatory_Field_Check</fullName>
        <active>true</active>
        <description>This validation rule ensures fields that are mandatory are ensured filled in and not blank. This is also applied for the Data loader to prevent data quality issues.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
ISBLANK( FirstName )
|| ISBLANK( LastName )
|| ISBLANK( AccountId )
|| ISBLANK ( Email )
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>One or more of the following fields is blank: First Name, Last Name, Email or Account.
Please ensure that all of these fields are filled in.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_No_New_Contact</fullName>
        <active>true</active>
        <description>If an Account is deactivated, prevent a user from creation a contact</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Core_IPS_By_Pass_Validation__c=false,
OR(
Account.Core_Export_Compliance_Block__c = TRUE,
Account.Core_Deactivated__c = TRUE
),
AND(NOT(ISNEW()),OR(ISNULL(TEXT(Core_IPA_PartnerRole__c)),
isChanged(Core_IPA_PartnerRole__c) &amp;&amp; NOT(ispickval(Core_IPA_PartnerRole__c,&apos;&apos;)))),
NOT(isChanged(PRM_IPA_Integration_Status__c) &amp;&amp; ispickval(PRM_IPA_Integration_Status__c,&apos;Successful&apos;)),
AND(
NOT($Profile.Name = $Label.Core_Integration_Profile_Name),
NOT($Profile.Name = $Label.Core_IT_Admin_Profile_Name),
NOT($Profile.Name = $Label.Core_System_Admin_Profile_Name))
))</errorConditionFormula>
        <errorMessage>The related Account is inactive thus, this action cannot be performed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_AE_User_Contact_Name_Edit</fullName>
        <active>true</active>
        <description>Don&apos;t allow A&amp;E Users to edit First Name and Last Name unless they are an A&amp;E Super User.</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
$Profile.Id = &apos;00eq0000000M6lT&apos; &amp;&amp; $Permission.Allow_Account_Name_Field_Edit = false &amp;&amp; 
(ISCHANGED( FirstName ) || ISCHANGED( LastName ))
)</errorConditionFormula>
        <errorMessage>A&amp;E Users can&apos;t edit First and Last Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Account_on_Contact</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Account.Name !=&apos;&apos;,
OR(
Account.RecordType.DeveloperName = &apos;Core_Direct_Account&apos;,
Account.RecordType.DeveloperName = &apos;Rejected_Account&apos;,
Account.RecordType.DeveloperName = &apos;Requested_Account&apos;,
Account.RecordType.DeveloperName = &apos;End_Customer_Deal_Account&apos;
)
)
))</errorConditionFormula>
        <errorMessage>Direct, Requested, Rejected or End Customer Account Record Types are not permissible on this field. Please choose the Intel Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Deactivation_Request_Unchec</fullName>
        <active>true</active>
        <description>Once deactivation reason is checked, it can&apos;t be unchecked</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
       $Profile.Name  &lt;&gt; &quot;Data Ops&quot;,
       $Profile.Name  &lt;&gt; &quot;IT Admin&quot;,
       $Profile.Name  &lt;&gt; &quot;System Administrator&quot;,
       $Profile.Name &lt;&gt; &quot;Integration&quot;,
				   $Profile.Name &lt;&gt; &apos;IPA A&amp;E User&apos;,
       PRIORVALUE(Core_Deactivated__c)=true,
       ISCHANGED(Core_Deactivated__c)
)
)</errorConditionFormula>
        <errorMessage>You don&apos;t have permission to uncheck the Deactivation flag</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Email_ID_Character_Restriction</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
LEN( Email ) &gt; 64
)</errorConditionFormula>
        <errorDisplayField>Email</errorDisplayField>
        <errorMessage>Email ID length exceeds 64 characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Embargoed_Country</fullName>
        <active>true</active>
        <errorConditionFormula>IF(($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE || $Setup.Core_Account_Bypass_Validation_Rule__c.Bypass_Flow__c=TRUE),False,
Core_Central_Block__c = true)</errorConditionFormula>
        <errorMessage>This registration was denied because the registrant identified their location as an embargoed country or their IP address is from an embargoed country. For more information please visit https://goto.intel.com/gec-sanctioned-country-info</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Mailing_Country_cannot_be_blank</fullName>
        <active>true</active>
        <description>Mailing Country/ Region field cannot be blank</description>
        <errorConditionFormula>IF($Setup.Core_Contact_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,(ISBLANK(MailingCountry)))</errorConditionFormula>
        <errorDisplayField>MailingCountry</errorDisplayField>
        <errorMessage>Mailing Country/Region signifies where the Contact currently resides and is mandatory</errorMessage>
    </validationRules>
