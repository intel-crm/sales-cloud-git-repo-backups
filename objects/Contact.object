IF(INCLUDES(Core_Audience_List__c,&quot;DCF External Content Viewer&quot;),&quot;DCF External Content Viewer;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;DCF External View All&quot;),&quot;DCF External View All;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;DCF User&quot;),&quot;DCF User;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;DCF User Administrator&quot;),&quot;DCF User Administrator;&quot;,null)&amp; 

IF(INCLUDES(Core_Audience_List__c,&quot;Partner Portal - IPS&quot;),&quot;Partner Portal - IPS;&quot;,null)&amp; 

IF(INCLUDES(Core_Audience_List__c,&quot;SPCF USER&quot;),&quot;SPCF USER;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;SPCF External Content Viewer&quot;),&quot;SPCF External Content Viewer;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;SPCF User Administrator&quot;),&quot;SPCF User Administrator;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;SPCF Account Budget Administrator&quot;),&quot;SPCF Account Budget Administrator;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;SPCF Activity Submitter&quot;),&quot;SPCF Activity Submitter;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;SPCF Claim Submitter&quot;),&quot;SPCF Claim Submitter;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;SPCF External View All&quot;),&quot;SPCF External View All;&quot;,null)&amp;

IF(INCLUDES(Core_Audience_List__c,&quot;CCF Boost User&quot;),&quot;CCF Boost User;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;CCF Boost External Content Viewer&quot;),&quot;CCF Boost External Content Viewer;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;CCF Boost User Administrator&quot;),&quot;CCF Boost User Administrator;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;CCF Boost Account Budget Administrator&quot;),&quot;CCF Boost Account Budget Administrator;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;CCF Boost Activity Submitter&quot;),&quot;CCF Boost Activity Submitter;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;CCF Boost Claim Submitter&quot;),&quot;CCF Boost Claim Submitter;&quot;,null)&amp; 
IF(INCLUDES(Core_Audience_List__c,&quot;CCF Boost External View All&quot;),&quot;CCF Boost External View All;&quot;,null)&amp;

IF(INCLUDES(Core_Audience_List__c,&quot;RMF User&quot;),&quot;RMF User;&quot;,null)&amp;
