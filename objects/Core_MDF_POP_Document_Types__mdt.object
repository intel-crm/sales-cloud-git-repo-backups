<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Holds the POP Doc Types Configuration based on Program and Budget Type</description>
    <fields>
        <fullName>Core_MDF_Active_ind__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Displays whether the record is active or not</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Type_txt__c</fullName>
        <description>Holds the Budget Type Value</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Budget Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Retail MDF</fullName>
                    <default>false</default>
                    <label>Retail MDF</label>
                </value>
                <value>
                    <fullName>RSA MD</fullName>
                    <default>false</default>
                    <label>RSA MD</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Document_Type_nm__c</fullName>
        <description>Holds the Document Type of record</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Document Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Proof of Attribution</fullName>
                    <default>false</default>
                    <label>Proof of Attribution</label>
                </value>
                <value>
                    <fullName>Proof of Branding</fullName>
                    <default>false</default>
                    <label>Proof of Branding</label>
                </value>
                <value>
                    <fullName>Proof of Cost</fullName>
                    <default>false</default>
                    <label>Proof of Cost</label>
                </value>
                <value>
                    <fullName>Proof of Execution</fullName>
                    <default>false</default>
                    <label>Proof of Execution</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Order_nbr__c</fullName>
        <description>Holds the Order of Doc Types to be displayed</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Order</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Program_nm__c</fullName>
        <description>Holds the Program Value</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Program</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Client Co-Marketing Fund</fullName>
                    <default>false</default>
                    <label>Client Co-Marketing Fund</label>
                </value>
                <value>
                    <fullName>Client Co-Marketing Fund Boost</fullName>
                    <default>false</default>
                    <label>Client Co-Marketing Fund Boost</label>
                </value>
                <value>
                    <fullName>Data Center Co-Marketing Fund</fullName>
                    <default>false</default>
                    <label>Data Center Co-Marketing Fund</label>
                </value>
                <value>
                    <fullName>Retail Marketing Funds</fullName>
                    <default>false</default>
                    <label>Retail Marketing Funds</label>
                </value>
                <value>
                    <fullName>Service Provider Co-Marketing Fund</fullName>
                    <default>false</default>
                    <label>Service Provider Co-Marketing Fund</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_RecordType_DeveloperName_txt__c</fullName>
        <description>Holds the RecordType DeveloperName Value</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>RecordType DeveloperName</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Req_Doc_Types_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Required During Claim Submission?</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_ReqforPOPSubmission_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Required For POP Submission?</label>
        <type>Checkbox</type>
    </fields>
    <label>POP Document Type</label>
    <listViews>
        <fullName>Core_MDF_All_records</fullName>
        <columns>MasterLabel</columns>
        <columns>Core_MDF_Program_nm__c</columns>
        <columns>Core_MDF_RecordType_DeveloperName_txt__c</columns>
        <columns>Core_MDF_Active_ind__c</columns>
        <columns>Core_MDF_Order_nbr__c</columns>
        <columns>Core_MDF_Document_Type_nm__c</columns>
        <columns>Core_MDF_Budget_Type_txt__c</columns>
        <columns>Core_MDF_Req_Doc_Types_ind__c</columns>
        <columns>Core_MDF_ReqforPOPSubmission_ind__c</columns>
        <columns>DeveloperName</columns>
        <filterScope>Everything</filterScope>
        <label>All records</label>
        <language>en_US</language>
    </listViews>
    <pluralLabel>POP Document Types</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
