<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Publishes Core_MDF_SuperClaim_Status_Sync__e from the PFC trigger when a Sub Claim status changes, to sync the Super Claim status asynchronously</description>
    <eventType>HighVolume</eventType>
    <fields>
        <fullName>Core_MDF_Super_Claim_Id__c</fullName>
        <description>Id of the Super Claim (PartnerFundClaim) whose status must be recalculated</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Super Claim Id</label>
        <length>18</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Super Claim Status Sync</label>
    <pluralLabel>Super Claim Status Sync</pluralLabel>
    <publishBehavior>PublishAfterCommit</publishBehavior>
</CustomObject>
