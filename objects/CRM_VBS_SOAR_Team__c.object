    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>To store Team Members for SOAR</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>CRM_VBS_Date_Added__c</fullName>
        <label>Date Added</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_Description_of_Contribution__c</fullName>
        <label>Description of Contribution</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_Is_Copy_OTM__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If Team User from Opportunity Team member</description>
        <label>Is Copy OTM</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_SOAR__c</fullName>
        <label>SOAR</label>
        <referenceTo>CRM_VBS_SOAR__c</referenceTo>
        <relationshipName>SOAR_Teams</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>CRM_VBS_Team_Member_Region__c</fullName>
        <externalId>false</externalId>
        <formula>CRM_VBS_Team_member__r.Core_User_Geo__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Team Member Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CRM_VBS_Team_Role__c</fullName>
        <label>Team Role</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Contributor (33.3%)</fullName>
                    <default>false</default>
                    <label>Contributor (33.3%)</label>
                </value>
                <value>
                    <fullName>Contributor (50%)</fullName>
                    <default>false</default>
                    <label>Contributor (50%)</label>
                </value>
                <value>
                    <fullName>Team Member (100%)</fullName>
                    <default>false</default>
                    <label>Team Member (100%)</label>
                </value>
                <value>
                    <fullName>Viewer (0%)</fullName>
                    <default>false</default>
                    <label>Viewer (0%)</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>CRM_VBS_Team_member__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Team member</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>$User.Core_User_Type__c</field>
                <operation>equals</operation>
                <value>Internal User</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>SOAR_Team_member</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_User_Type__c</fullName>
        <externalId>false</externalId>
        <formula>$User.Core_User_Type__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>User Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>SOAR Team Member</label>
    <nameField>
        <displayFormat>Soar Team Member-{0000}</displayFormat>
        <label>SOAR Team Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>SOAR Team Members</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>CRM_VBS_Restrict_OO_Change</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass_SOAR_DW_Check__c=TRUE,FALSE,
IF(ISCHANGED(CRM_VBS_Team_Role__c ) &amp;&amp; 
			(ISPICKVAL(PRIORVALUE(CRM_VBS_Team_Role__c ), &apos;Opportunity Owner (100%)&apos;) 
				|| 
				ISPICKVAL(PRIORVALUE(CRM_VBS_Team_Role__c ), &apos;Technical Owner (100%)&apos;)
			),TRUE,FALSE)
	)</errorConditionFormula>
        <errorMessage>Cannot modify Technical Owner (100%) or Opportunity Owner (100%) on SOAR Team.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Restrict_Team_Updation_DW</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,IF( AND(OR(ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Design Win&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Production Win&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_VBS_Decision__c , &apos;SOAR4 Contract Signed&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Production Lost&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Lost&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Production Cancelled&apos;)),  NOT(ISNEW())),TRUE,FALSE))</errorConditionFormula>
        <errorMessage>SOAR Cannot be modified Once Contract is Signed or Opportunity is Closed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_SOAR3_Team_Update_Error</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass_SOAR_DW_Check__c =TRUE,FALSE,IF( AND(ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_VBS_Decision__c , &apos;SOAR3 Approved&apos;), NOT(ISNEW())),TRUE,FALSE))</errorConditionFormula>
        <errorMessage>SOAR Products/Team cannot be modified after SOAR VBS Decision is SOAR3 Approved</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
