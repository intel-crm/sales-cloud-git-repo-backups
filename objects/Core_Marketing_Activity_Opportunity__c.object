    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Junction Object to associate Activities and Opportunities.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_Marketing_Activity__c</fullName>
        <description>Related Marketing Activity.</description>
        <label>Marketing Activity</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Core_Marketing_Activity__c.Core_Activity_Active__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Core_Marketing_Activity__c</referenceTo>
        <relationshipLabel>Marketing Activity Opportunities</relationshipLabel>
        <relationshipName>Activity_Opportunities</relationshipName>
        <relationshipOrder>1</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Account__c</fullName>
        <description>The Account name of the Opportunity.</description>
        <externalId>false</externalId>
        <formula>Core_Opportunity__r.Account.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Account</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Amount__c</fullName>
        <description>The Amount of the Opportunity. The data is initially copied from Opportunity and is updated using the trigger created on the Opportunity. We took this approach so we can roll up the Amount at the Activity level.</description>
        <label>Opportunity Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Decision_Date__c</fullName>
        <description>The Decision/Close Date of the Opportunity.</description>
        <formula>Core_Opportunity__r.CloseDate</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Decision Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Owner_Geo__c</fullName>
        <description>The Geo of the Opportunity owner.</description>
        <externalId>false</externalId>
        <formula>Core_Opportunity__r.Owner.Core_User_Geo__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Owner Geo</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Stage__c</fullName>
        <description>The Stage of the Opportunity.</description>
        <externalId>false</externalId>
        <formula>TEXT(Core_Opportunity__r.StageName)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Volume__c</fullName>
        <description>The Volume of the Opportunity. The data is initially copied from Opportunity and is updated using the trigger created on the Opportunity. We took this approach so we can roll up the Volume at the Activity level.</description>
        <externalId>false</externalId>
        <label>Opportunity Volume</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity__c</fullName>
        <description>Related Opportunity.</description>
        <label>Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Marketing Activity Opportunities</relationshipLabel>
        <relationshipName>Activity_Opportunities</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <label>Marketing Activity Opportunity</label>
    <nameField>
        <displayFormat>MAO-{0000000}</displayFormat>
        <label>Marketing Activity Opportunity ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Marketing Activity Opportunities</pluralLabel>
