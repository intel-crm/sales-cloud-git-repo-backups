<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Stores Coveo token and Endpoint URL</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Core_IPS_CoveoEndpoint__c</fullName>
        <description>To store Coveo Endpoint URL which can used to generate token for Coveo</description>
        <label>Core_IPS_CoveoEndpoint</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Coveo_Token__c</fullName>
        <description>Field is used to store the Coveo token which is used in Apex class</description>
        <externalId>false</externalId>
        <label>Core_IPS_Coveo_Token</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Core IPS Coveo TokenGenerator</label>
    <visibility>Public</visibility>
</CustomObject>
