    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Core_MDF_Adjustment_Request</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Core_MDF_Adjustment_Request</fullName>
        <fields>Name</fields>
        <fields>Core_MDF_Adjustment_Claim_Nbr__c</fields>
        <fields>Core_MDF_Reason_Cd__c</fields>
        <fields>Core_MDF_Reference_Claim_Nbr__c</fields>
        <label>Adjustment Request</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object stores all the Adjustment request</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>true</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Adjustment_Claim_Nbr__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Unique identifier of Claim created based on the Adjustment Request</description>
        <inlineHelpText>Unique identifier of Claim created based on the Adjustment Request</inlineHelpText>
        <label>Adjustment Claim Name</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>Claim Adjustment Requests (Adjustment Claim)</relationshipLabel>
        <relationshipName>Claim_Adjustment_Requests1</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Adjustment_Status_nm__c</fullName>
        <description>This field stores the Adjustment Request status as Approved or Cancelled</description>
        <label>Adjustment Status</label>
        <required>true</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Approved</fullName>
                    <default>true</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Amount_Amt__c</fullName>
        <description>Amount to be offset</description>
        <inlineHelpText>Amount of the Claim Adjustment in US Dollars</inlineHelpText>
        <label>Adjustment Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Bypass_Amt_Val_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If the field value is true, then the system is going to by-pass the amount validation</description>
        <inlineHelpText>If Checked, this Adjustment Request Amount will bypass the Total Adjustment Request Amount Validation for this Reference Claim. Provide justification in the comments section.</inlineHelpText>
        <label>Bypass Amount Validation</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Comments_Txt__c</fullName>
        <description>Free text comments related to the Claim Adjustment Request. This is visible only to internal users and not to external.</description>
        <inlineHelpText>Free text comments related to the Claim Adjustment Request. In case the amount validation is bypassed, need to provide justification for bypassing validation.</inlineHelpText>
        <label>Adjustment Request Comments</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_MDF_CreatedBy_Nm__c</fullName>
        <description>Shows the name for external user if created by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF (
ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;),
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Escalation_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup the Escalation ID related to this Claim if applicable</description>
        <label>Escalation ID</label>
        <referenceTo>Core_MDF_Escalation__c</referenceTo>
        <relationshipLabel>Claim Adjustment Requests</relationshipLabel>
        <relationshipName>Claim_Adjustment_Requests</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Last_ModifiedBy_Nm__c</fullName>
        <description>Shows the name for external user if modified by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(LastModifiedBy.Profile.UserType,&apos;PowerPartner&apos;),
LastModifiedBy.FirstName &amp; &apos; &apos; &amp; LastModifiedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Last Modified By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Owner_Nm__c</fullName>
        <description>Shows the name for external user if owner is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL( Owner:User.Profile.UserType ,&apos;PowerPartner&apos;),
Owner:User.FirstName &amp; &apos; &apos; &amp; Owner:User.LastName ,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Reason_Cd__c</fullName>
        <description>Reason for Adjustment creation</description>
        <inlineHelpText>Reason for Adjustment creation</inlineHelpText>
        <label>Adjustment Reason</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Duplicate Claim</fullName>
                    <default>false</default>
                    <label>Duplicate Claim</label>
                </value>
                <value>
                    <fullName>Overpaid Claim</fullName>
                    <default>false</default>
                    <label>Overpaid Claim</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Ref_Claim_Owner_Email_Txt__c</fullName>
        <description>Reference Claim Email</description>
        <externalId>false</externalId>
        <label>Reference Claim Owner Email</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Reference_Claim_Nbr__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Source Claim from where the Adjustment originated</description>
        <inlineHelpText>Source Claim from where the Adjustment originated</inlineHelpText>
        <label>Reference Claim Name</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>Claim Adjustment Requests</relationshipLabel>
        <relationshipName>Claim_Adjustment_Requests</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Claim Adjustment Request</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>OBJECT_ID</columns>
        <columns>Core_MDF_Reference_Claim_Nbr__c</columns>
        <columns>Core_MDF_Adjustment_Claim_Nbr__c</columns>
        <columns>Core_MDF_Reason_Cd__c</columns>
        <columns>Core_MDF_Adjustment_Status_nm__c</columns>
        <columns>Core_MDF_CreatedBy_Nm__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>{00000}</displayFormat>
        <label>Adjustment Request Number</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Claim Adjustment Requests</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>OBJECT_ID</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Reference_Claim_Nbr__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Adjustment_Claim_Nbr__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Reason_Cd__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CREATEDBY_USER</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_AdjustmentAmount</fullName>
        <active>true</active>
        <description>check if the Claim Adjustment Amount is null</description>
        <errorConditionFormula>IF(ISNULL(Core_MDF_Amount_Amt__c),TRUE,FALSE)</errorConditionFormula>
        <errorMessage>Please enter a value greater than 0 for Adjustment Amount (USD)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_AdjustmentReason</fullName>
        <active>true</active>
        <description>Adjustment Reason can be empty</description>
        <errorConditionFormula>ISPICKVAL( Core_MDF_Reason_Cd__c , &quot;&quot; )</errorConditionFormula>
        <errorMessage>Please select a value for Adjustment Reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Adjustment_Claim_Number</fullName>
        <active>true</active>
        <description>Adjustment claim number cannot be null</description>
        <errorConditionFormula>ISBLANK( Core_MDF_Adjustment_Claim_Nbr__c)</errorConditionFormula>
        <errorMessage>Please enter a value for Adjustment Claim Name</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Amount_Val</fullName>
        <active>true</active>
        <description>To check if the Adjustment Amount is greater than 0</description>
        <errorConditionFormula>Core_MDF_Amount_Amt__c &lt; 0</errorConditionFormula>
        <errorMessage>Please enter a value greater than 0 for Adjustment Amount (USD)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Block_Adjustment_Req_Creation</fullName>
        <active>true</active>
        <description>Receive error when claim adjustment is created for any status other than  Payment Due, PAF or Hold and VAT eligible claims.</description>
        <errorConditionFormula>AND(
ISNEW(),
OR(
NOT(
OR(
ISPICKVAL(Core_MDF_Reference_Claim_Nbr__r.Core_MDF_Status__c, &quot;Payment Due&quot;),
ISPICKVAL(Core_MDF_Reference_Claim_Nbr__r.Core_MDF_Status__c, &quot;Pending Available Fund&quot;),
ISPICKVAL(Core_MDF_Reference_Claim_Nbr__r.Core_MDF_Status__c, &quot;Hold&quot;)
)
),
ISPICKVAL(Core_MDF_Reference_Claim_Nbr__r.Core_MDF_VAT_Opt_In__c, &quot;Service Invoice to Intel (VAT may apply)&quot;)
)
)</errorConditionFormula>
        <errorMessage>Adjustment request can only be created for Non-VAT claims that are in Payment Due/Pending Available Funds/Hold status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Block_On_Cancelled_Status</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISNEW(),
ISPICKVAL(Core_MDF_Adjustment_Status_nm__c, &quot;Cancelled&quot;)
)</errorConditionFormula>
        <errorMessage>Adjustment cannot be created in Cancelled status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EditNotAllowedFor_Adjustment</fullName>
        <active>true</active>
        <description>Edit is not allowed for Adjustment</description>
        <errorConditionFormula>OR(
ISCHANGED( Core_MDF_Reference_Claim_Nbr__c ) ,
ISCHANGED( Core_MDF_Amount_Amt__c) ,
ISCHANGED( Core_MDF_Reason_Cd__c ),
ISCHANGED(Core_MDF_Bypass_Amt_Val_Ind__c),
(AND(TEXT(PRIORVALUE(Core_MDF_Adjustment_Status_nm__c)) == $Label.Core_MDF_Status_Cancelled ,TEXT(Core_MDF_Adjustment_Status_nm__c) == $Label.Core_MDF_Status_Approved))
)</errorConditionFormula>
        <errorMessage>Adjustment request cannot be edited.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventPositiveReasonForNonVat</fullName>
        <active>true</active>
        <description>To Prevent users from selection Claim Review Results (Positive) reason for Non Vat claims</description>
        <errorConditionFormula>AND(ISPICKVAL(Core_MDF_Reason_Cd__c , &quot;Claim Review Results (Positive)&quot;),
OR(Core_MDF_Reference_Claim_Nbr__r.Core_MDF_VAT_Eligibility_Ind__c = false, 
AND(Core_MDF_Reference_Claim_Nbr__r.Core_MDF_VAT_Eligibility_Ind__c = true, NOT(ISPICKVAL( Core_MDF_Reference_Claim_Nbr__r.Core_MDF_Status__c , &quot;Paid&quot;))))
)</errorConditionFormula>
        <errorMessage>The selected Adjustment Reason is not applicable for the Program/Status of the given Reference Claim</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReasonForBypassingAmtValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND( Core_MDF_Bypass_Amt_Val_Ind__c,  
LEN(TRIM(Core_MDF_Comments_Txt__c)) == 0 ,   
TEXT(Core_MDF_Reason_Cd__c) != $Label.Core_MDF_AdjReq_EscalationType)</errorConditionFormula>
        <errorMessage>Please mention the reason for bypassing the amount validation in the &quot;Adjustment Request Comments&quot; section.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Referance_Claim_Number</fullName>
        <active>true</active>
        <description>Reference claim number should not be blank and should be a Claim of type &quot;Claim&quot;.</description>
        <errorConditionFormula>ISBLANK( Core_MDF_Reference_Claim_Nbr__c) || TEXT(Core_MDF_Reference_Claim_Nbr__r.Core_MDF_Type_Txt__c) &lt;&gt; $Label.Core_MDF_Claim_Type</errorConditionFormula>
        <errorMessage>The claim selected is offset claim, please select a valid claim.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
