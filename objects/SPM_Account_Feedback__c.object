    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>CRM_VBS_No_Null_GTM_Model_Field</fullName>
        <active>false</active>
        <description>The GTM Model field cannot be null</description>
        <errorConditionFormula>ISCHANGED(GTM_Model__c) &amp;&amp; (ISBLANK(TEXT(GTM_Model__c)) ||  ISBLANK(TEXT(GTM_Model__c)))</errorConditionFormula>
        <errorDisplayField>Account_ID__c</errorDisplayField>
        <errorMessage>GTM Model cannot be None.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_Modify_Others_Feedback</fullName>
        <active>true</active>
        <description>Should not be able to edit other Account Feedback records.</description>
        <errorConditionFormula>IF(((ISCHANGED(CRM_CST_VP_Feedback__c) || ISCHANGED(CRM_CST_CM_Feedback__c) || ISCHANGED(CRM_CST_GM_Feedback__c) ) &amp;&amp;
((ISPICKVAL(CRM_CST_VP_Feedback__c , &apos;Approved&apos;)||(ISPICKVAL(CRM_CST_VP_Feedback__c , &apos;Rejected&apos;))) ||
(ISPICKVAL(CRM_CST_CM_Feedback__c , &apos;Approved&apos;)||(ISPICKVAL(CRM_CST_CM_Feedback__c , &apos;Rejected&apos;))) ||
(ISPICKVAL(CRM_CST_GM_Feedback__c , &apos;Approved&apos;)||(ISPICKVAL(CRM_CST_GM_Feedback__c , &apos;Rejected&apos;))))),
FALSE,((ISPICKVAL(Feedback_Type__c , &apos;DR&apos;) &amp;&amp; (Account_ID__r.DR__c != $User.Id &amp;&amp; Account_ID__r.DR__c != NULL)&amp;&amp; NOT(OR($Permission.CST_Super_Admin,$Permission.CST_Regional_Admin)))
||
(ISPICKVAL(Feedback_Type__c , &apos;VP&apos;) &amp;&amp; (Account_ID__r.VP__c != $User.Id &amp;&amp; Account_ID__r.VP__c != NULL) &amp;&amp; NOT(OR($Permission.CST_Super_Admin,$Permission.CST_Regional_Admin))))
)</errorConditionFormula>
        <errorMessage>You cannot modify other&apos;s feedback.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
