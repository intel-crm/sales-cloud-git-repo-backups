<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>API_Endpoint__c</fullName>
        <description>The complete API endpoint URL</description>
        <externalId>false</externalId>
        <inlineHelpText>e.g., /services/apexrest/v1.0/activity?action=create</inlineHelpText>
        <label>API Endpoint</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>API_Method__c</fullName>
        <description>HTTP method for the API (GET, POST, PUT, DELETE)</description>
        <externalId>false</externalId>
        <inlineHelpText>GET, POST, PUT, DELETE, PATCH</inlineHelpText>
        <label>API Method</label>
        <length>10</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>API_Name__c</fullName>
        <description>Human-readable name for the API</description>
        <externalId>false</externalId>
        <inlineHelpText>e.g., PFR Activity API, Campaign Creation API</inlineHelpText>
        <label>API Name</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Category__c</fullName>
        <description>Category or grouping of the API</description>
        <externalId>false</externalId>
        <inlineHelpText>e.g., Activity Management, Campaign Management, Metadata, File Management</inlineHelpText>
        <label>Category</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Default__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Marks the default version to display when multiple active versions exist for the same API</description>
        <label>Default</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Detailed description of what the API does</description>
        <inlineHelpText>Describe the functionality and purpose</inlineHelpText>
        <label>Description</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>EOL__c</fullName>
        <description>End-of-life date range for this API version</description>
        <externalId>false</externalId>
        <inlineHelpText>Example: 2026-01-01 - 2026-12-31</inlineHelpText>
        <label>EOL</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this API version is displayed in the documentation viewer</description>
        <label>Is Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Operation_Name__c</fullName>
        <description>Specific operation name (e.g., Create, Retrieve, Update)</description>
        <externalId>false</externalId>
        <inlineHelpText>Create, Read, Update, Delete, Query</inlineHelpText>
        <label>Operation Name</label>
        <length>100</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Request_Body_Example__c</fullName>
        <description>JSON example for request body</description>
        <inlineHelpText>Provide JSON formatted request example</inlineHelpText>
        <label>Request Body Example</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Request_Static_Resource_Name__c</fullName>
        <description>Static Resource API name that contains the request JSON example</description>
        <externalId>false</externalId>
        <inlineHelpText>Example: Core_API_PFR_Activity_Create_Request</inlineHelpText>
        <label>Request Static Resource Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Response_Example__c</fullName>
        <description>JSON example for API response</description>
        <inlineHelpText>Provide JSON formatted response example</inlineHelpText>
        <label>Response Example</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Response_Static_Resource_Name__c</fullName>
        <description>Static Resource API name that contains the response JSON example</description>
        <externalId>false</externalId>
        <inlineHelpText>Example: Core_API_PFR_Activity_Create_Response</inlineHelpText>
        <label>Response Static Resource Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Response_Status_Code__c</fullName>
        <description>Expected HTTP response status code</description>
        <externalId>false</externalId>
        <inlineHelpText>200, 201, 400, 404, 500, etc.</inlineHelpText>
        <label>Response Status Code</label>
        <length>10</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <description>Display order in documentation</description>
        <externalId>false</externalId>
        <label>Sort Order</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Version__c</fullName>
        <description>API version number</description>
        <externalId>false</externalId>
        <inlineHelpText>e.g., 1.0.0</inlineHelpText>
        <label>Version</label>
        <length>20</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Core API Documentation</label>
    <visibility>Public</visibility>
</CustomObject>
