    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>PRM_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Benefits</relationshipLabel>
        <relationshipName>AccountBenefitAssociations</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PRM_Account_Partner_Benefit_Key__c</fullName>
        <description>This field is used to identify the duplicate records</description>
        <externalId>false</externalId>
        <formula>PRM_Account_Id__c +  PRM_Partner_Benefit_Id__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Partner Benefit Key</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Account_RT__c</fullName>
        <externalId>false</externalId>
        <formula>PRM_Account_Id__r.RecordType.DeveloperName</formula>
        <label>Account RT</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Partner_Benefit_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Partner Benefit</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>The selected Partner Benefit is either Inactive or doesn&apos;t belong to &quot;Intel Partner Alliance&quot; program. Please verify your selection.</errorMessage>
            <filterItems>
                <field>PRM_PartnerBenefit__c.PRM_Channel_Program_Id__r.Name</field>
                <operation>equals</operation>
                <value>Intel Partner Alliance</value>
            </filterItems>
            <filterItems>
                <field>PRM_PartnerBenefit__c.PRM_InActive_Ind__c</field>
                <operation>equals</operation>
                <value>False</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>PRM_PartnerBenefit__c</referenceTo>
        <relationshipLabel>Partner Benefit Association</relationshipLabel>
        <relationshipName>AccountBenefitAssociations</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PRM_Record_Link__c</fullName>
        <description>This is used to navigate to the Record page from the Related List</description>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot; &amp; Id, &apos;Record Link&apos;, &quot;_self&quot; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Record Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Source__c</fullName>
        <label>Source</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Tier</fullName>
                    <default>false</default>
                    <label>Tier</label>
                </value>
                <value>
                    <fullName>Select Benefit</fullName>
                    <default>false</default>
                    <label>Select Benefit</label>
                </value>
                <value>
                    <fullName>Program Benefit</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Program Benefit</label>
                </value>
                <value>
                    <fullName>Specialty</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Specialty</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>PRM_Status_Change_Dt__c</fullName>
        <description>It will display the date when the status is changed</description>
        <label>Status Change Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PRM_Status_Nm__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Inactive</fullName>
                    <default>false</default>
                    <label>Inactive</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PRM_Status_Reason_Txt__c</fullName>
        <inlineHelpText>On update of any field, Status Reason should also be updated</inlineHelpText>
        <label>Status Reason</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PRM_Suppress_Email__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Suppress Email</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Account Benefit Association</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>PRM_Account_Id__c</columns>
        <columns>PRM_Partner_Benefit_Id__c</columns>
        <columns>PRM_Status_Nm__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>ABE-{00000}</displayFormat>
        <label>AccountBenefitAssociation Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Benefit Associations</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Standard</fullName>
        <active>true</active>
        <label>Standard</label>
        <picklistValues>
            <picklist>PRM_Source__c</picklist>
            <values>
                <fullName>Select Benefit</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Tier</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>PRM_Status_Nm__c</picklist>
            <values>
                <fullName>Active</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Inactive</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <validationRules>
        <fullName>PRM_Status_Reason_Removal_Mandatory</fullName>
        <active>true</active>
        <description>This is used to restrict user from keeping the Status reason field as Blank when the Status is selected as Inactive.</description>
        <errorConditionFormula>NOT( $Permission.PCC_Bypass_Automation ) &amp;&amp; IF($Setup.PRM_Execution_Controls__c.PRM_Skip_Validation_Rule_Ind__c=TRUE,FALSE,OR(AND(ISCHANGED(PRM_Status_Nm__c),(ISPICKVAL(PRM_Status_Nm__c, &apos;Inactive&apos;)), ISBLANK(PRM_Status_Reason_Txt__c)),AND((ISPICKVAL(PRM_Status_Nm__c, &apos;Inactive&apos;)), ISBLANK(PRM_Status_Reason_Txt__c))))</errorConditionFormula>
        <errorMessage>Please add a reason in the Status reason</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
