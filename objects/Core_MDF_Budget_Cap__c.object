    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_CheckBudgetStatusEqualsRejected</fullName>
        <active>true</active>
        <description>Restrict Budget Cap Creation when the Budget Status is equal to Rejected</description>
        <errorConditionFormula>ISPICKVAL(Core_MDF_Budget_Name_id__r.Core_MDF_Budget_Status__c, &apos;Rejected&apos;)</errorConditionFormula>
        <errorMessage>Budget cap can’t be created on Rejected budget</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPABudgetCaps_ActiveValidation</fullName>
        <active>true</active>
        <description>IPA Budget Type Caps can&apos;t be Inactive during creation</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Core_MDF_IPA_Budget_Type_Cap&apos; , ISNEW(),ISPICKVAL(Core_MDF_Cap_Status_nm__c, &apos;Inactive&apos;))</errorConditionFormula>
        <errorMessage>IPA Budget Caps can&apos;t be Inactive during creation</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_BudgetType_cannotbeEdited</fullName>
        <active>true</active>
        <description>For IPA Budget Caps; Budget Type field cannot be edited.</description>
        <errorConditionFormula>AND( RecordType.DeveloperName = &apos;Core_MDF_IPA_Budget_Type_Cap&apos;, NOT(ISNEW()),ISCHANGED(Core_MDF_Budget_Type_nm__c))</errorConditionFormula>
        <errorMessage>Budget Type cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Geo_cannotbeEdited</fullName>
        <active>true</active>
        <description>For IPA Budget Caps; Geo field cannot be edited.</description>
        <errorConditionFormula>AND( RecordType.DeveloperName = &apos;Core_MDF_IPA_Budget_Type_Cap&apos; , NOT(ISNEW()),ISCHANGED(Core_MDF_Region_nm__c),  TEXT(Core_MDF_Cap_Status_nm__c)=&apos;Active&apos;  )</errorConditionFormula>
        <errorMessage>Geo cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_MandatoryEffectiveStartDate</fullName>
        <active>true</active>
        <errorConditionFormula>AND(RecordType.DeveloperName =&apos;Core_MDF_IPA_Budget_Type_Cap&apos;,
ISBLANK(Core_MDF_Effective_Start_Date_Dt__c))</errorConditionFormula>
        <errorMessage>Effective Start Date is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Mandatory_BudgetType</fullName>
        <active>true</active>
        <errorConditionFormula>AND(RecordType.DeveloperName =&apos;Core_MDF_IPA_Budget_Type_Cap&apos;,
ISBLANK(TEXT( Core_MDF_Budget_Type_nm__c )))</errorConditionFormula>
        <errorMessage>Budget Type is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Mandatory_EffectiveEndDate</fullName>
        <active>true</active>
        <errorConditionFormula>AND(RecordType.DeveloperName =&apos;Core_MDF_IPA_Budget_Type_Cap&apos;,
ISBLANK(Core_MDF_Effective_End_Date_Dt__c))</errorConditionFormula>
        <errorMessage>Effective End Date is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Mandatory_Geo</fullName>
        <active>true</active>
        <description>Geo is mandatory for IPA</description>
        <errorConditionFormula>AND(RecordType.DeveloperName =&apos;Core_MDF_IPA_Budget_Type_Cap&apos;,ISBLANK(TEXT( Core_MDF_Region_nm__c)))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Region_nm__c</errorDisplayField>
        <errorMessage>Geo is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Mandatory_ReqCapAmt</fullName>
        <active>true</active>
        <errorConditionFormula>AND(RecordType.DeveloperName =&apos;Core_MDF_IPA_Budget_Type_Cap&apos;,
ISNULL( Core_MDF_Requested_Cap_amt__c ))</errorConditionFormula>
        <errorMessage>Requested Cap Amount is mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_ReqCapAmt_OnAmtChange</fullName>
        <active>true</active>
        <description>Requested Cap Amount cannot be less than Claimed Cap Amount on requested amount change</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Core_MDF_IPA_Budget_Type_Cap&apos; ,NOT(ISNEW()),ISCHANGED( Core_MDF_Requested_Cap_amt__c ) , Core_MDF_Requested_Cap_amt__c &lt;  Core_MDF_Claimed_Cap_amt__c)</errorConditionFormula>
        <errorMessage>The revised Requested Cap Amount cannot be lesser than Claimed Cap Amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_ReqCapAmt_OnCreation</fullName>
        <active>true</active>
        <description>This rule validates the Budget Cap&apos;s requested amount with claimed amount while creation or activation</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Core_MDF_IPA_Budget_Type_Cap&apos;, Core_MDF_Requested_Cap_amt__c &lt; Core_MDF_Claimed_Cap_amt__c ,OR(ISNEW(), AND(ISCHANGED( Core_MDF_Cap_Status_nm__c ),
ISPICKVAL(Core_MDF_Cap_Status_nm__c, &apos;Active&apos;))
))</errorConditionFormula>
        <errorMessage>The Requested Cap Amount cannot be lesser than Claimed Cap Amount for the given time period.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_ReqCapAmt_OnDateChange</fullName>
        <active>true</active>
        <description>This rule validates budget cap amount with claimed cap amount when time period of budget cap is changed</description>
        <errorConditionFormula>AND( RecordType.DeveloperName = &apos;Core_MDF_IPA_Budget_Type_Cap&apos; , NOT(ISNEW()),OR(ISCHANGED( Core_MDF_Effective_Start_Date_Dt__c  ) , ISCHANGED( Core_MDF_Effective_End_Date_Dt__c )),  Core_MDF_Requested_Cap_amt__c &lt; Core_MDF_Claimed_Cap_amt__c)</errorConditionFormula>
        <errorMessage>The Requested Cap Amount cannot be lesser than Claimed Cap Amount (due to change in the time period).</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_ReqCapAmt_With_BdgtAmt</fullName>
        <active>true</active>
        <description>Requested Cap Amount should be lesser than or equal to Budget Amount.</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Core_MDF_CCP_Budget_Cap&apos;, Core_MDF_Requested_Cap_amt__c &gt; Core_MDF_Budget_Amount_amt__c)</errorConditionFormula>
        <errorMessage>Requested Cap Amount should be lesser than or equal to Budget Amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_StartDate_EndDate</fullName>
        <active>true</active>
        <errorConditionFormula>Core_MDF_Effective_End_Date_Dt__c &lt; Core_MDF_Effective_Start_Date_Dt__c</errorConditionFormula>
        <errorMessage>Effective End Date should be greater than Effective Start Date</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
