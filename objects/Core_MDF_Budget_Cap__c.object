    <nameField>
        <displayFormat>Cap-{0000}</displayFormat>
        <label>Budget Cap Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Budget Caps</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_CheckBudgetStatusEqualsRejected</fullName>
        <active>true</active>
        <description>Restrict Budget Cap Creation when the Budget Status is equal to Rejected</description>
        <errorConditionFormula>ISPICKVAL(Core_MDF_Budget_Name_id__r.Core_MDF_Budget_Status__c, &apos;Rejected&apos;)</errorConditionFormula>
        <errorMessage>Budget cap can’t be created on Rejected budget</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_ReqCapAmt_With_BdgtAmt</fullName>
        <active>true</active>
        <description>Requested Cap Amount should be lesser than or equal to Budget Amount.</description>
        <errorConditionFormula>Core_MDF_Requested_Cap_amt__c &gt; Core_MDF_Budget_Amount_amt__c</errorConditionFormula>
        <errorMessage>Requested Cap Amount should be lesser than or equal to Budget Amount.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
