                    <default>false</default>
                    <label>Inactive</label>
                </value>
                <value>
                    <fullName>Pending Review</fullName>
                    <default>true</default>
                    <label>Pending Review</label>
                </value>
                <value>
                    <fullName>Revision Required</fullName>
                    <default>false</default>
                    <label>Revision Required</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
