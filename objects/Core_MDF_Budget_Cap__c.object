    <fields>
        <fullName>Core_MDF_Campaigns_Link_failed_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is used to indicate whether campaigns linking got failed for the budget cap; If even single campaign didnt get link due to failure then the checkbox will be true otherwise false.</description>
        <label>Campaigns Linking failed?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
