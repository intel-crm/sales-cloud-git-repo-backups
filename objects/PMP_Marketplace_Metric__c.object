    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object to store various matrices related to marketplace security. Initially the list of metrics (Metric Name, Metric Description)
are loaded manually with the correct Metric API Name. A scheduled batch program uses the Metric API Name and populates the numbers. A report and dashboard is built on this object to show the data to the end users. Addition of new Metric requires code change to the batch program.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>PMP_Inactive_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if the record is Inactive. The metric data is calculated by the batch program even if the record is Inactive. But the data for this metric is not shown in the dashboard or report.</description>
        <label>Inactive Indicator</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Metric_API_Nm__c</fullName>
        <description>Stores the API name of the metric. This is used as a key in the batch program to calculate the metric data. PLEASE DO NOT change the API name once it is used. Otherwise it requires code change in the batch program.</description>
        <externalId>false</externalId>
        <label>Metric API Name</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Metric_Dsc__c</fullName>
        <description>The detailed description of each metric and is shown in the dashboard, report.</description>
        <label>Metric Description</label>
        <length>5000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>PMP_Metric_Nm__c</fullName>
        <description>The user friendly name of each metric and is shown in the dashboard, report.</description>
        <externalId>false</externalId>
        <label>Metric Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Mismatch_Cnt__c</fullName>
        <description>Holds the total number of mismatches found in the system for the given metric.</description>
        <externalId>false</externalId>
        <label>Mismatch Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Mismatch_Percent_Nbr__c</fullName>
        <description>Hods the percentage of mismatches found for the given metric.</description>
        <formula>(PMP_Mismatch_Cnt__c  /  PMP_Total_Cnt__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Mismatch Percent</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>PMP_Total_Cnt__c</fullName>
        <description>Holds the total number of records found in the system for the given metric.</description>
        <externalId>false</externalId>
        <label>Total Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Marketplace Metric</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>PMP_Metric_Nm__c</columns>
        <columns>PMP_Metric_API_Nm__c</columns>
        <columns>PMP_Metric_Dsc__c</columns>
        <columns>PMP_Total_Cnt__c</columns>
        <columns>PMP_Mismatch_Cnt__c</columns>
        <columns>PMP_Mismatch_Percent_Nbr__c</columns>
        <columns>PMP_Inactive_Ind__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <nameField>
        <displayFormat>MTRC-{0000}</displayFormat>
        <label>Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Marketplace Metrices</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
