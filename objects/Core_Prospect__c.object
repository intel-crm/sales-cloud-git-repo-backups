    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_Avoid_ConvertOrDisquali_To_Accepted</fullName>
        <active>true</active>
        <description>Dont allow users to get back to accepted status once its converted or disqualified.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
OR(
AND(OR(TEXT(PRIORVALUE(Core_Status_Pkt__c)) = &apos;Converted&apos;, TEXT(PRIORVALUE(Core_Status_Pkt__c)) = &apos;Disqualified&apos;), 
OR(ISPICKVAL(Core_Status_Pkt__c, &apos;Accepted&apos;), ISPICKVAL(Core_Status_Pkt__c, &apos;New&apos;)),Core_Revive_Prospect_Flag__c = false
),
AND(TEXT(PRIORVALUE(Core_Status_Pkt__c)) = &apos;Accepted&apos;, ISPICKVAL(Core_Status_Pkt__c, &apos;New&apos;),Core_Revive_Prospect_Flag__c = false)
)
)</errorConditionFormula>
        <errorMessage>The current status of prospect cannot be changed back to the previous status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Avoid_Converted_To_Disqualified</fullName>
        <active>true</active>
        <description>This validation is fired when the prospect&apos;s status is changed from converted to disqualified</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(TEXT(PRIORVALUE(Core_Status_Pkt__c)) = &apos;Converted&apos;,
ISPICKVAL(Core_Status_Pkt__c, &apos;Disqualified&apos;)
)
)</errorConditionFormula>
        <errorMessage>Converted prospect cannot be disqualified</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_IF_Prosepect_already_Claimed</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Core_Mass_Claim_Flag__c,
Owner:User.Id =$User.Id
)
)</errorConditionFormula>
        <errorMessage>You are already an owner of this Prospect</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_NoEdit_On_Conversion</fullName>
        <active>true</active>
        <description>Dont allow  users to edit the record once it is converted</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(ISNEW()),
NOT(ISCHANGED(Core_Is_Converted_Chk__c)),
ISPICKVAL(Core_Status_Pkt__c, &apos;Converted&apos;)
)
)</errorConditionFormula>
        <errorMessage>Prospect record cannot be edited once it is converted</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_No_Disqualification_Reason</fullName>
        <active>true</active>
        <description>The validation is fired when the disqualification reason is not populated when the status is disqualified</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISPICKVAL(Core_Status_Pkt__c, &apos;Disqualified&apos;),ISPICKVAL(Core_Disqualification_Reason_Pkt__c, &apos;&apos;)
)
)</errorConditionFormula>
        <errorMessage>Disqualification Reason is mandatory to disqualify a Prospect</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Update_IF_Owner_Queue</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(ISNEW()),
LEFT(OwnerId,3) = &apos;00G&apos;,
Core_Mass_Claim_Flag__c = false,
NOT(ISCHANGED(OwnerId)),
NOT(Core_Is_Converted_Chk__c),
$Profile.Name &lt;&gt; &quot;Eloqua Integrator&quot;,
$Profile.Name &lt;&gt; &quot;System Administrator&quot;
)
)</errorConditionFormula>
        <errorMessage>Please claim the ownership to update the Prospect information</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
