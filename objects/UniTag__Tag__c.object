    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>CRM_Tag_Unique_Name</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,FALSE,
AND(
VLOOKUP($ObjectType.UniTag__Tag__c.Fields.Name, $ObjectType.UniTag__Tag__c.Fields.Name, Name) &lt;&gt; null,
OR(ISCHANGED( Name ),ISNEW())
)
)</errorConditionFormula>
        <errorMessage>The Tag Name must be unique.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>UniTag__Check_Unique_Name</fullName>
        <active>false</active>
        <errorConditionFormula>VLOOKUP($ObjectType.UniTag__Tag__c.Fields.Name, $ObjectType.UniTag__Tag__c.Fields.Name, Name) &lt;&gt; null</errorConditionFormula>
        <errorMessage>The Tag Name must be unique.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
