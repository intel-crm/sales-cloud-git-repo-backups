    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Core_Account_Name__c</fullName>
        <externalId>false</externalId>
        <formula>Opportunity.Account.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Date_Added__c</fullName>
        <formula>CreatedDate</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Date Added</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Is_OSC__c</fullName>
        <description>Used to determine if user is part of OSC or not.</description>
        <formula>IF( Core_OSC_Snapshot__c =1,TRUE,IF(Core_OSC_Snapshot__c = 0, FALSE,User.Core_Is_OSC__c))</formula>
        <inlineHelpText>Used to determine if user is part of OSC or not.</inlineHelpText>
        <label>Is OSC?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_OSC_Snapshot__c</fullName>
        <description>Field to capture current snapshot of the OSC value from the user</description>
        <externalId>false</externalId>
        <label>OSC Snapshot</label>
        <precision>1</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Org__c</fullName>
        <description>Value of the role field on the user record for the team member</description>
        <externalId>false</externalId>
        <label>Org</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Team_Member_Department__c</fullName>
        <description>Used to pull the department attribute from the User Object.</description>
        <externalId>false</externalId>
        <formula>User.Department</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Used to pull the department attribute from the User Object.</inlineHelpText>
        <label>Team Member Department</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Team_Member_Geo__c</fullName>
        <description>Team Member GEO for display on Opportunity Team Member related list.</description>
        <externalId>false</externalId>
        <formula>User.Core_User_Geo__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Team Member Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Team_Member_Sub_Geo__c</fullName>
        <description>Team Members Sub Geo</description>
        <externalId>false</externalId>
        <formula>$User.Core_User_Sub_Geo__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Team Member Sub Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>OpportunityAccessLevel</fullName>
    </fields>
    <fields>
        <fullName>OpportunityId</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>TeamMemberRole</fullName>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>UserId</fullName>
        <type>Lookup</type>
    </fields>
</CustomObject>
