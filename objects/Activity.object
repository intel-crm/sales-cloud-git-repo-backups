    <fields>
        <fullName>Core_Source_of_Activity__c</fullName>
        <businessStatus>Active</businessStatus>
        <description>A custom, read-only field on both Activity and Event records which provides a singular reportable field indicating the source of this activity record, when known. If the Activity Source field is populated with a valid source, that value is replicated here. Otherwise, a formula attempts to derive the source.</description>
        <externalId>false</externalId>
        <formula>IF(AND(TEXT(Core_Activity_Source__c) != &apos;Unknown&apos;,TEXT(Core_Activity_Source__c) != &apos;&apos;),TEXT(Core_Activity_Source__c),
IF(BEGINS(UPPER(Subject), &apos;PERFORM ACCOUNT TEAM AUDIT&apos;), &apos;Account Team Audit&apos;,
IF(BEGINS(UPPER(Subject), &apos;6QPS&apos;), &apos;6QPS&apos;,
IF(BEGINS(UPPER(Subject), &apos;ACCOUNT OWNERSHIP CHANGE REQUEST&apos;), &apos;Account Ownership Change Request&apos;,
IF(OR(BEGINS(UPPER(Subject), &apos;EMAIL ALERT SENT TO ADMIN FOR REVIEW (OFFERING EDITOR - UPDATED EXISTING OFFERING)&apos;), BEGINS(UPPER(Subject), &apos;EMAIL SENT ASKING FOR UPDATE REQUIRED ON EXISTING OFFERING TO OFFERING EDITOR&apos;), BEGINS(UPPER(Subject), &apos;EMAIL SENT FOR FUTURE PUBLISHING OFFERING&apos;), BEGINS(UPPER(Subject), &apos;EMAIL SENT FOR PUBLISHED OFFERING&apos;), BEGINS(UPPER(Subject), &apos;EMAIL SENT TO OFFERING PARTNER OFFERING EDITOR&apos;)),&apos;Offering&apos;,
IF(CONTAINS(UPPER(Subject), &apos;SENT VIA LIVESEND TO&apos;), &apos;Seismic&apos;,
IF(TEXT(Core_Activity_Source__c)==&apos;&apos; , &apos;Unknown&apos;,&apos;Unknown&apos;
)))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Source of Activity</label>
        <required>false</required>
        <securityClassification>Internal</securityClassification>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Subtype_of_Activity__c</fullName>
        <businessStatus>Active</businessStatus>
        <description>A custom, read-only field on both Activity and Event records which provides a singular reportable field indicating the specific subtype of activity being recorded.</description>
        <externalId>false</externalId>
        <formula>IF(TEXT(ActivitySubtype) == &apos;Email&apos;,&apos;Email&apos;, 
IF(TEXT(ActivitySubtype) == &apos;Call&apos;,&apos;Voice Call&apos;, 
IF(TEXT(ActivitySubtype) == &apos;Event&apos;,&apos;Meeting&apos;, TEXT(Core_Task_Type__c))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Subtype of Activity</label>
        <required>false</required>
        <securityClassification>Internal</securityClassification>
        <type>Text</type>
        <unique>false</unique>
    </fields>
