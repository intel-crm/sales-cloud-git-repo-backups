    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Store Answers for Core Question</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_IPS_Answer__c</fullName>
        <description>Store the answer value</description>
        <externalId>false</externalId>
        <label>Answer</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Order_No__c</fullName>
        <description>Define the Order in which the list of answer should be displayed</description>
        <externalId>false</externalId>
        <label>Order No</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Parent_Answer__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>If this answer is dependent on selected answer record</description>
        <label>Parent Answer</label>
        <referenceTo>Core_IPS_Answer__c</referenceTo>
        <relationshipLabel>Child Answers</relationshipLabel>
        <relationshipName>Core_Answers</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Question_Text__c</fullName>
        <externalId>false</externalId>
        <formula>Core_IPS_Question__r.Core_IPS_Question__c</formula>
        <label>Question Text</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Question__c</fullName>
        <description>Stores the question this answer belongs</description>
        <label>Question</label>
        <referenceTo>Core_IPS_Question__c</referenceTo>
        <relationshipLabel>Environment Detail Answers</relationshipLabel>
        <relationshipName>Core_Answers</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_IPS_Status__c</fullName>
        <label>Status</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Active</fullName>
                    <default>true</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Inactive</fullName>
                    <default>false</default>
                    <label>Inactive</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Environment Detail Answer</label>
    <nameField>
        <displayFormat>Ans-{0000}</displayFormat>
        <label>Answer No</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Environment Detail Answers</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Core_IPS_Answer__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Core_IPS_Question__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Core_IPS_Question_Text__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Core_IPS_Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Core_IPS_Parent_Answer__c</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>Core_IPS_Answer__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Core_IPS_Question__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Core_IPS_Question_Text__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Core_IPS_Status__c</lookupDialogsAdditionalFields>
        <searchResultsAdditionalFields>Core_IPS_Answer__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_IPS_Question__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_IPS_Question_Text__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_IPS_Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_IPS_Parent_Answer__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_IPS_Validate_Answer_Creation</fullName>
        <active>true</active>
        <errorConditionFormula>Core_IPS_Question__r.Core_IPS_Answer_Count__c &gt;=1  &amp;&amp;     ISPICKVAL(Core_IPS_Question__r.Core_IPS_Datatype__c, &apos;Text&apos;) &amp;&amp;  NOT ( ISCHANGED( Core_IPS_Answer__c ) )</errorConditionFormula>
        <errorMessage>Environment Detail Questions that are Text can only have 1 Answer defined.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Validate_Parent_Answer</fullName>
        <active>true</active>
        <errorConditionFormula>Core_IPS_Parent_Answer__c != null &amp;&amp; 
Core_IPS_Question__r.Core_IPS_Parent_Question__c != Core_IPS_Parent_Answer__r.Core_IPS_Question__c</errorConditionFormula>
        <errorDisplayField>Core_IPS_Parent_Answer__c</errorDisplayField>
        <errorMessage>Parent Answer should belong to the Parent Question identified at Core Question</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Manage_Dependent_Answers_LEX</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Manage Dependent Answers LEX</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>/lightning/n/Manage_Dependent_Answers_LEX?c__recordId={!Core_IPS_Question__c.Id}</url>
    </webLinks>
</CustomObject>
