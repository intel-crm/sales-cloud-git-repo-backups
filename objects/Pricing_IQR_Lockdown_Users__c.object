<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Custom setting to lockdown users from using IQR during Downtime.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Pricing_Restrict_Users_To_Login__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To restrict users from using the IQR application this custom setting should be checked. To allow the users it should be unchecked.</description>
        <label>Pricing Restrict Users To Login</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Pricing IQR Lockdown Users</label>
    <visibility>Public</visibility>
</CustomObject>
