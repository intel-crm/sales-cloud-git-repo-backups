    <fields>
        <fullName>Core_MDF_Job_Frequency__c</fullName>
        <description>Frequency of batch execution</description>
        <label>Job Frequency</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Once</fullName>
                    <default>false</default>
                    <label>Once</label>
                </value>
                <value>
                    <fullName>Every X Minute</fullName>
                    <default>false</default>
                    <label>Every X Minute</label>
                </value>
                <value>
                    <fullName>Every X Hour</fullName>
                    <default>false</default>
                    <label>Every X Hour</label>
                </value>
                <value>
                    <fullName>Daily</fullName>
                    <default>false</default>
                    <label>Daily</label>
                </value>
                <value>
                    <fullName>Days of Week</fullName>
                    <default>false</default>
                    <label>Days of Week</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Days_of_Week__c</fullName>
        <defaultValue>CASE(
  MOD( TODAY() - DATE(1900, 1, 7), 7), 
     0, &quot;Monday&quot;, 
     1, &quot;Tuesday&quot;,  
     2, &quot;Wednesday&quot;, 
     3, &quot;Thursday&quot;, 
     4, &quot;Friday&quot;, 
     5, &quot;Saturday&quot;, 
     6, &quot;Sunday&quot;,
     &quot;Error&quot;
)</defaultValue>
        <description>dependent on &quot;Days of Week&quot; ; to capture days on which job needs to be executed</description>
        <label>Days of Week</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Monday</fullName>
                    <default>false</default>
                    <label>Monday</label>
                </value>
                <value>
                    <fullName>Tuesday</fullName>
                    <default>false</default>
                    <label>Tuesday</label>
                </value>
                <value>
                    <fullName>Wednesday</fullName>
                    <default>false</default>
                    <label>Wednesday</label>
                </value>
                <value>
                    <fullName>Thursday</fullName>
                    <default>false</default>
                    <label>Thursday</label>
                </value>
                <value>
                    <fullName>Friday</fullName>
                    <default>false</default>
                    <label>Friday</label>
                </value>
                <value>
                    <fullName>Saturday</fullName>
                    <default>false</default>
                    <label>Saturday</label>
                </value>
                <value>
                    <fullName>Sunday</fullName>
                    <default>false</default>
                    <label>Sunday</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
