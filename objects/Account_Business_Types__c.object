    <label>Account Business Types</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Account__c</columns>
        <columns>Business_Types__c</columns>
        <columns>Status__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>BAT-{00000}</displayFormat>
        <label>Account Business Types Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Business Types</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>ABT_Validations</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
ISPICKVAL(Status__c, &apos;Approved&apos;) &amp;&amp;
CONTAINS(Business_Types__r.Name, &apos;Developer Zone Premier&apos;) &amp;&amp;
(
AND(IF(CONTAINS(skipValidation__c, &apos;Core_CNDA_Number__c&apos;),false,true),ISBLANK(Account__r.Core_CNDA_Number__c))||
AND(IF(CONTAINS(skipValidation__c, &apos;Core_Covered_Account__c&apos;),false,true),NOT(Account__r.Core_Covered_Account__c)) ||
AND(IF(CONTAINS(skipValidation__c, &apos;Core_English_Only_Name__c&apos;),false,true),ISBLANK(Account__r.Core_English_Only_Name__c)) ||
AND(IF(CONTAINS(skipValidation__c, &apos;Core_B2B_Entitlement__c&apos;),false,true),NOT(Account__r.Core_B2B_Entitlement__c))
),true,false
)</errorConditionFormula>
        <errorDisplayField>Status__c</errorDisplayField>
        <errorMessage>ABT cannot be approved due one or more validations errors.

•	Account&apos;s &apos;CNDA number&apos; should have value.

•	Account&apos;s &apos;Covered Account&apos; should be checked.

•	Account&apos;s &apos;English Only Name&apos; should have a Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ECD_Only_CPE</fullName>
        <active>true</active>
        <description>Direct Price Exception CPE can not be added to Intel Accounts</description>
        <errorConditionFormula>AND(
    Business_Types__r.Business_Type_Code__c = &apos;DIR_PRC_EXCPT&apos;,
    OR(
       Account__r.Core_Account_Record_Type__c = &apos;Intel Account&apos;,
       Account__r.Core_Account_Record_Type__c = &apos;Inactive Account&apos;
    )
)</errorConditionFormula>
        <errorDisplayField>Business_Types__c</errorDisplayField>
        <errorMessage>DPE CPE Can not be added to Intel Accounts</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
