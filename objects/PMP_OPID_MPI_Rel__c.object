    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This is the junction object which connects OPID To MPI Records</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_Marketing_Profile_Id__c</fullName>
        <externalId>false</externalId>
        <formula>PMP_Marketing_Profile_Id__r.PMP_Marketing_Profile_Id__c</formula>
        <label>Marketing Profile Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <label>Is Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Account_MPI_Unique_ID__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>This field is used to store unique value for the Account MPI relation record</description>
        <externalId>false</externalId>
        <label>Account MPI Unique ID</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>PMP_Active_OPID_Associations__c</fullName>
        <description>This field is used to help with number of Active Relations on the MPI(Storefront) Record</description>
        <externalId>false</externalId>
        <formula>CASE(PMP_Marketing_Profile_Id__r.PMP_Active_OPID_Cnt__c, 
1, IMAGE(&quot;/resource/PMP_Association_Warning_img&quot;,&quot;&quot;,36,36)+&quot; Caution: Last active OPID associated to Storefront&quot;,
0,&quot;MP Storefront is not active. Associate OPID to activate Storefront&quot;,
TEXT(PMP_Marketing_Profile_Id__r.PMP_Active_OPID_Cnt__c)+&quot; Active OPID associated&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Active OPID Associations</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Is_PagAccount_Ind__c</fullName>
        <description>Used to fetch account partner record type and check if it is Partner account group</description>
        <formula>IF(PMP_One_Partner_ID__r.RecordType.DeveloperName = &apos;Core_Partner_Account_Group&apos;, TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is PagAccount</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Marketing_Profile_Id__c</fullName>
        <label>Marketing Profile Information ID</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>MPI must be a published copy and have a Benefit</errorMessage>
            <filterItems>
                <field>PMP_Company__c.PMP_Is_Published_Ind__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>PMP_Company__c.PMP_Partner_Benefit_Type__c</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>PMP_Company__c</referenceTo>
        <relationshipLabel>OPID MPI Relationships</relationshipLabel>
        <relationshipName>OPID_MPI_Relationships</relationshipName>
        <relationshipOrder>1</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>PMP_One_Partner_ID__c</fullName>
        <label>Account/OPID</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR 2</booleanFilter>
            <filterItems>
                <field>Account.RecordType.Name</field>
                <operation>equals</operation>
                <value>Partner Account Group</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordType.Name</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>OPID MPI Relationships</relationshipLabel>
        <relationshipName>OPID_MPI_Relationships</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>PMP_RelLastDeactivated__c</fullName>
        <label>Relation Last Deactivated date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMP_Storefront_Published_Copy__c</fullName>
        <description>This field is used to reference storefront published copy directly from junction</description>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot;&amp; PMP_Marketing_Profile_Id__c ,  PMP_Marketing_Profile_Id__r.Name)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Storefront Published Copy</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Storefront_Working_Copy__c</fullName>
        <description>This Field used to reference Storefront Working Copy</description>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot;&amp;  PMP_Marketing_Profile_Id__r.PMP_Working_Copy_Id__c  ,  PMP_Marketing_Profile_Id__r.PMP_Working_Copy_Id__r.Name  )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Storefront Working Copy</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>OPID MPI Relationship</label>
    <nameField>
        <displayFormat>PAG-MPI-{0000000}</displayFormat>
        <label>OPID MPI Relationship Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>OPID MPI Relationships</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
