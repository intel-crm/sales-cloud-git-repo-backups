    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>AGS_Pending_30_Min__c</fullName>
        <description>AGS status pending for more than 30 min</description>
        <formula>IF( AND(
        ((NOW() -  Core_Status_Change_Date_Time__c)*24*60) &gt;  30,
         TEXT(Core_Status__c) = &apos;Pending&apos;,
          Core_Type__c = &apos;Entitlement&apos;
       ),
   TRUE, 
   FALSE)</formula>
        <label>AGS Pending &gt; 30 Min</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_AGS_Pending_Time__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
AND( 
	TEXT(Core_Status__c) = &apos;Pending&apos;, 
	Core_Type__c = &apos;Entitlement&apos; 
	), 
(NOW() - Core_Status_Change_Date_Time__c)*24*60, 
0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>AGS Pending Time</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Category__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Core_Entitlement_Id__r.Core_Category__c)</formula>
        <label>Category</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Contact_Id__c</fullName>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Contact Entitlements</relationshipLabel>
        <relationshipName>Contact_Entitlements</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Data_Loaded__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Used during data loading activities to initiate OBM process.</description>
        <label>Is Data Loaded?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Display_Nm__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Entitlement_Id__r.Core_Display_Name__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Display Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_DontNotify__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Don&apos;t Notify</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_ERPM_Account_Data__c</fullName>
        <description>ERPM account data from the message that created the record</description>
        <label>ERPM Account Data</label>
        <length>1000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Email_Pending_To_Requester_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if Email to the Entitlement requester is pending. This is set to TRUE when the entitlement is first assigned, and later set to FALSE once the email notification is sent to the requester.</description>
        <label>Email Pending To Requester</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Engagement_Tier__c</fullName>
        <description>Stores the Tier, if applicable, for ERPM account engagements stored against the contact</description>
        <externalId>false</externalId>
        <label>Engagement Tier</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_EntitlementDuration__c</fullName>
        <externalId>false</externalId>
        <formula>ROUND((NOW()- DATETimeVALUE(Core_Status_Change_Date_Time__c))*24*60,0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>EntitlementDuration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Entitlement_B2B_B2C_Indicator__c</fullName>
        <description>Contact Entitlement B2B-B2C Indicator Value</description>
        <externalId>false</externalId>
        <formula>TEXT(Core_Entitlement_Id__r.Entitlement_B2B_B2C_Indicator__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Entitlement B2B / B2C Indicator</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Entitlement_Help_Txt__c</fullName>
        <description>Formula field to get the help text from the Entitlement Detail record.</description>
        <externalId>false</externalId>
        <formula>Core_Entitlement_Id__r.Core_Help_Text__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Help text from the Entitlement Detail record.</inlineHelpText>
        <label>Entitlement Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Entitlement_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Entitlement</label>
        <referenceTo>Core_Entitlement__c</referenceTo>
        <relationshipLabel>Contact Entitlements</relationshipLabel>
        <relationshipName>Entitlements</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Entitlement_Nm__c</fullName>
        <description>The name of the Entitlement</description>
        <externalId>false</externalId>
        <formula>Core_Entitlement_Id__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Entitlement Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Entitlement_Requester_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Entitlement RequesterId</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Contact_Entitlements</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Entitlement_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Core_From_Source__c, &apos;Engagement&apos;, IF(ISPICKVAL(Core_Entitlement_Id__r.Core_Entitlement_Type__c, &apos;AGS&apos;), &apos;Entitlement-AGS&apos; , &apos;Entitlement-SFDC&apos;))</formula>
        <label>Entitlement Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_From_Source__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates that a value came from another source system and should not be directly selectable in Salesforce</description>
        <label>From Source</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Ops_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(((Now() - Core_Status_Change_Date_Time__c )*24 )&gt; 6,  NOT(ISPICKVAL(Core_Status__c , &apos;Complete&apos;))),  &apos;Failed&apos;, Text(Core_Status__c ))</formula>
        <label>Ops Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Retrigger_Attempt__c</fullName>
        <defaultValue>0</defaultValue>
        <externalId>false</externalId>
        <inlineHelpText>The number of retrigger attempts made to make the assignment successful</inlineHelpText>
        <label>Retrigger Attempt</label>
        <precision>1</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Selected__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Selected</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Source__c</fullName>
        <externalId>false</externalId>
        <label>Source</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Status_Change_Date_Time__c</fullName>
        <description>This field will capture the date/time whenever there is an update for the status field.</description>
        <label>Status Change Date/Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Status__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Complete</fullName>
                    <default>false</default>
                    <label>Complete</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Status_of_Assignment_Failure__c</fullName>
        <defaultValue>&apos;Pending&apos;</defaultValue>
        <externalId>false</externalId>
        <label>Status of Assignment/Removal</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Core_From_Source__c, &apos;Engagement&apos;, &apos;Entitlement&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Unique_Id__c</fullName>
        <caseSensitive>true</caseSensitive>
        <description>Ensures that the combination of Contact ID and Entitlement Detail ID is unique</description>
        <externalId>false</externalId>
        <label>Unique Id</label>
        <length>36</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_Update_Reason__c</fullName>
        <externalId>false</externalId>
        <label>Update Reason</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Account_Id__c</fullName>
        <externalId>false</externalId>
        <formula>CASESAFEID(Core_Contact_Id__r.AccountId)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Removal_as_part_of_License_Reclaim__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Checked if entitlement is removed as part of partner license reclaim</description>
        <inlineHelpText>Checked if entitlement is removed as part of partner license reclaim</inlineHelpText>
        <label>Removal as part of License Reclaim?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Contact Entitlement</label>
    <listViews>
        <fullName>All</fullName>
        <columns>Core_Contact_Id__c</columns>
        <columns>Core_Entitlement_Id__c</columns>
        <columns>Core_Selected__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>CE-{000000}</displayFormat>
        <label>Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Contact Entitlements</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
