    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>EPUM Logs is to capture search, invite, List view details for EPUM flow. Also this object is user in reports to identify performance of search, List view vs Search usage etc.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>EPUM_Action_Result_Ind__c</fullName>
        <description>This field is to track whether search result for enter email id was found or now.</description>
        <label>Action Result</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>EPUM_Details_Dsc__c</fullName>
        <description>This field is to display the detailed description for the search result or via list view.</description>
        <label>Details</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>EPUM_Message_Txt__c</fullName>
        <description>This field is to display the short description for the search result or via list view.</description>
        <externalId>false</externalId>
        <label>Message</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>EPUM_Origin_Txt__c</fullName>
        <description>This field is to display the origin for the search result, invite or via list view.</description>
        <externalId>false</externalId>
        <label>Origin</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>EPUM_Project_Txt__c</fullName>
        <description>This field is to display the type for which the record is created for the search result or via list view.</description>
        <externalId>false</externalId>
        <label>Project</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>EPUM_Search_Text__c</fullName>
        <description>This field is to display the email id used for the search result.</description>
        <externalId>false</externalId>
        <label>Search Text</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>EPUM_Search_Time_Nbr__c</fullName>
        <description>This field is to display the time taken to search email in SFDC.</description>
        <externalId>false</externalId>
        <formula>(CreatedDate - EPUM_When_Dtm__c)*24*60*60</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Search Time (in sec)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>EPUM_Severity_Txt__c</fullName>
        <description>This field is to display the severity for the search result, invite contact or via list view.</description>
        <externalId>false</externalId>
        <label>Severity</label>
        <length>30</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>EPUM_When_Dtm__c</fullName>
        <description>This field is to display the starting datetime for the search result or via list view.</description>
        <label>When</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>EPUM_isContact_Registered__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is used to process the batch EPUM_LogDataUpdateBatch and stores the information about contact registration completion status</description>
        <label>isContactRegistered</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>EPUM Log</label>
    <nameField>
        <displayFormat>EL-{0000000000}</displayFormat>
        <label>EPUM Log Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>EPUM Logs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
