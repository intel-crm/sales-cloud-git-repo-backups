    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>To store PSG Opportunity Quote information.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_Error_Code__c</fullName>
        <description>This will contain the Siebel Error code of PSG Opportunity Quote integration</description>
        <externalId>false</externalId>
        <label>Error Code</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Error_Message__c</fullName>
        <description>This will contain the Siebel Error Message of PSG Opportunity Quote integration</description>
        <label>Error Message</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Message_Status__c</fullName>
        <description>Stores the Quote creation Success/failed details</description>
        <label>Message Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity__c</fullName>
        <label>Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>PSG Quote Generation History</relationshipLabel>
        <relationshipName>PSG_Quote_Generation_History</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Quote_URL__c</fullName>
        <description>Stores the PSG Siebel Quote URL for that Opportunity</description>
        <label>Quote URL</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>Core_RFQ_ID__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Stores the PSG Quote Unique ID and displayed as hyperlink in Sales support PSG Quote related list UI.</description>
        <externalId>false</externalId>
        <label>RFQ ID</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <label>PSG Quote Generation History</label>
    <nameField>
        <displayFormat>QH-{0000}</displayFormat>
        <label>PSG Quote Generation History Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>PSG Quote Generation History</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
