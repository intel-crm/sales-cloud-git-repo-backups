<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Created for list of Partner programs to show up in Marketplace quick search</description>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To set if Partner program is active or not</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Enable_Translation_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Boolean to enable translation ability for partner of different partner program</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Enable Translation</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Partner_Program_Desc_Chinese__c</fullName>
        <description>Chinese description for Partner Program</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Partner Program Description (Chinese)</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PMP_Partner_Program_Desc_Japanese__c</fullName>
        <description>Japanese description for Partner Programs</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Partner Program Description (Japanese)</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PMP_Partner_Program_Desc__c</fullName>
        <description>Description for the Partner Programs</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Partner Program Description</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PMP_Partner_Program_Name_Chinese__c</fullName>
        <description>Chinese translation for Partner Program name</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Partner Program Name (Chinese)</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Partner_Program_Name_Japanese__c</fullName>
        <description>Japanese translation for partner program name</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Partner Program Name (Japanese)</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Partner_Program_Name__c</fullName>
        <description>Elaborated values of Partner Program.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Partner Program Name</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Partner_Program_Value__c</fullName>
        <description>The value of the partner program</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Partner Program Value</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>PMP_SearchPartnerProgram_Config</label>
    <pluralLabel>PMP_SearchPartnerProgram_Configs</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
