    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Point_Not_Eligible_Reason_Mandatory</fullName>
        <active>true</active>
        <description>Points Not eligible Status Reason is mandatory when Points not eligible is checked</description>
        <errorConditionFormula>if( AND( PRM_Points_Not_Eligible_Ind__c , ISBLANK( PRM_Points_Not_Eligible_Reason_Txt__c ),  ISNULL(PRM_Points_Not_Eligible_Reason_Txt__c )),true, false )</errorConditionFormula>
        <errorDisplayField>PRM_Points_Not_Eligible_Reason_Txt__c</errorDisplayField>
        <errorMessage>Update Reason for setting Points Not Eligible indicator</errorMessage>
    </validationRules>
