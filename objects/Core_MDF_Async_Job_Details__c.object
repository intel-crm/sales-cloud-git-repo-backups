    <fields>
        <fullName>Core_MDF_Job_Id__c</fullName>
        <description>This field stores the Async Job Id.</description>
        <externalId>false</externalId>
        <label>Job Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Job_Type_nm__c</fullName>
        <description>This field indicates the type of the Async process.</description>
        <label>Job Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Bulk API</fullName>
                    <default>false</default>
                    <label>Bulk API</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Message_txt__c</fullName>
        <description>This field stores the response or result of the Async Job.</description>
        <externalId>false</externalId>
        <label>Message</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Object_txt__c</fullName>
        <description>This field stores the object name for which Async Job is performed.</description>
        <externalId>false</externalId>
        <label>Object</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Operation_nm__c</fullName>
        <description>This field indicates the type of database operation performed by Async Job.</description>
        <label>Operation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Delete</fullName>
                    <default>false</default>
                    <label>Delete</label>
                </value>
                <value>
                    <fullName>Insert</fullName>
                    <default>false</default>
                    <label>Insert</label>
                </value>
                <value>
                    <fullName>Update</fullName>
                    <default>false</default>
                    <label>Update</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Status_nm__c</fullName>
        <description>This field stores the status of the Async Job.</description>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
