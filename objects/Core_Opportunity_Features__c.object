    <fields>
        <fullName>Core_Platform_BU__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(Core_Feature_Set__r.Core_Feature__r.Core_Feature_BU__c,
&quot;CCG&quot;, &quot;CCG&quot;,
&quot;CCG ECG&quot;, &quot;CCG ECG&quot;,
&quot;DCG&quot;, &quot;DCAI&quot;,
&quot;PSG&quot;, &quot;PSG&quot;,
&quot;NTG&quot;, &quot;NTG&quot;,
&quot;PBS&quot;,&quot;PBS&quot;,&quot;&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Platform BU</label>
