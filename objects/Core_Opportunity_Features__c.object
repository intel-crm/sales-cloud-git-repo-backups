        <fullName>Opportunity_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Opportunity Product</label>
        <referenceTo>OpportunityLineItem</referenceTo>
        <relationshipLabel>Descriptive Features</relationshipLabel>
        <relationshipName>Descriptive_Features</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <externalId>false</externalId>
        <formula>if(not(isblank(Opportunity_Product__c)),&apos;Product&apos;,&apos;Opportunity&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Descriptive Feature</label>
    <nameField>
        <displayFormat>DF-{00000000}</displayFormat>
        <label>Descriptive Feature ID</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Descriptive Features</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_DesFeature_QuoteSubmittedStatus</fullName>
        <active>true</active>
        <description>Descriptive Feature Quote Submitted Status Lock check</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,

AND ( Core_Opportunity__r.Core_Opportunity_Lock_Status__c = true, ISPICKVAL( Core_Opportunity__r.Core_Coverage_Type_Nm__c, &apos;Deal Registration&apos;), ISPICKVAL(Core_Opportunity__r.Core_Opportunity_Coverage_Nm__c , &apos;Partner-Led Opportunity&apos;) )
)</errorConditionFormula>
        <errorMessage>Quote associated to this Opportunity is Submitted for Review. No Edits allowed on Opportunity during the Review process.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_EditDescriptiveFeatures</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Edit Descriptive Features</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/apex/Core_OppDescriptiveFeatures?sOppid={!Opportunity.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_EditDescriptiveFeaturesForProduct</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Edit Descriptive Features</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>/apex/Core_OppDescriptiveFeatures?sOppProdid={!OpportunityLineItem.Id}</url>
    </webLinks>
