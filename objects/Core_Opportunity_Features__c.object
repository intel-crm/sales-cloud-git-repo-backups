    <fields>
        <fullName>Core_Consumer_Sales_system__c</fullName>
        <externalId>false</externalId>
        <label>Consumer Sales System</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Feature_Name__c</fullName>
        <description>This field is used as a formula reference to the field Feature Value in the Feature Object</description>
        <externalId>false</externalId>
        <formula>Core_Feature_Set__r.Core_Feature__r.Core_Feature_Value__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Feature Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Feature_Set__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>This is a field used to associate a lookup relationship with the Feature Set Object</description>
        <label>Feature Set</label>
        <referenceTo>Core_Feature_Set__c</referenceTo>
        <relationshipLabel>Descriptive Features</relationshipLabel>
        <relationshipName>Descriptive_Features</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Feature_Type__c</fullName>
        <description>This field is used as a formula reference to the field Feature Type in the Core Feature Object</description>
        <externalId>false</externalId>
        <formula>Core_Feature_Set__r.Core_Feature__r.Core_Feature_Type__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Feature Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Multi_Select__c</fullName>
        <formula>Core_Feature_Set__r.Core_Feature__r.Core_Multi_Select__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core Multi Select</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity__c</fullName>
        <description>This is a field used to associate a lookup relationship with the Opportunity Object</description>
        <label>Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Descriptive Features</relationshipLabel>
        <relationshipName>Opportunity_Features</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Platform_BU__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(Core_Feature_Set__r.Core_Feature__r.Core_Feature_BU__c,
&quot;CCG&quot;, &quot;CCG&quot;,
&quot;CCG ECG&quot;, &quot;CCG ECG&quot;,
&quot;DCG&quot;, &quot;DCAI&quot;,
&quot;PSG&quot;, &quot;PSG&quot;,
&quot;NTG&quot;, &quot;NTG&quot;,
&quot;CCG AMS&quot;,&quot;CCG AMS&quot;,&quot;&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Platform BU</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Descriptive Feature</label>
    <nameField>
        <displayFormat>DF-{00000000}</displayFormat>
        <label>Descriptive Feature ID</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Descriptive Features</pluralLabel>
