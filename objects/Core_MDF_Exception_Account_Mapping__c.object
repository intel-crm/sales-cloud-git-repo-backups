    <validationRules>
        <fullName>Core_MDF_Cannot_Update_Account_At_EAM</fullName>
        <active>true</active>
        <description>Once user creates an exception account mapping with an account, user cant update that account</description>
        <errorConditionFormula>ISCHANGED(Core_MDF_Account_id__c)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account_id__c</errorDisplayField>
        <errorMessage>Cannot update account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Cannot_Update_Exception_At_EAM</fullName>
        <active>true</active>
        <description>Once user creates an exception account mapping with an exception, user cant update that exception</description>
        <errorConditionFormula>ISCHANGED(Core_MDF_Exception_id__c)</errorConditionFormula>
        <errorMessage>Cannot update exception</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
