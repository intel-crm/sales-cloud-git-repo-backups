    <fields>
        <fullName>Core_MDF_Account_id__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 AND 2) OR (3 AND 4)</booleanFilter>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Mastered_Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_CoMarketingActive__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Co_Marketing</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_Channel_Program__r.Name</field>
                <operation>equals</operation>
                <value>Retail Marketing Funds</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Exception Account Mappings</relationshipLabel>
        <relationshipName>Exception_Account_Mappings</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Active_ind__c</fullName>
        <defaultValue>true</defaultValue>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
