    <fields>
        <fullName>PRM_Partner_Role_Check__c</fullName>
        <description>Compares Logged in User Partner Role with VX Data Partner Role for Report Purpose</description>
        <externalId>false</externalId>
        <formula>IF(OR($Profile.Name = &quot;System Administrator&quot;,$Profile.Name = &quot;IT Admin&quot;),&apos;TRUE&apos;,IF(TEXT(PRM_Partner_Role_Nm__c) ==  $User.Core_IPA_PartnerRole_Nm__c ,&apos;TRUE&apos;, &apos;FALSE&apos;))</formula>
        <label>Partner Role Check</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
