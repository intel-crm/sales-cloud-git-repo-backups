    <fields>
        <fullName>PRM_IsChanged_Ind__c</fullName>
        <description>This Formula Field will return boolean value if Changed Date is greater than Processed date or if Processed Date Field is blank.</description>
        <formula>IF( (PRM_Change_Date_Dt__c &gt; PRM_Processed_Date_Time_Dt__c )|| ISBLANK(PRM_Processed_Date_Time_Dt__c)  || ISNULL(PRM_Processed_Date_Time_Dt__c)  , true, false)</formula>
        <label>Is Changed Indicator</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
