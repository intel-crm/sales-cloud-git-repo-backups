    <fields>
        <fullName>Core_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates if the record is Active or Not.</description>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Disposition_Reminder_Email_Opt_In__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Field to indicate if the Partner has Opted-In to receive weekly email on the number of open leads &gt; 5 days or 20 days or (30 days AND &lt; 37 days).</description>
        <label>Disposition Reminder Email Opt-In</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
