    <fields>
        <fullName>PMP_Ancestor_Specification_Cd__c</fullName>
        <description>Ancestor Specification Id</description>
        <externalId>false</externalId>
        <inlineHelpText>Ancestor Specification Id</inlineHelpText>
        <label>Ancestor Specification Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Boolean_Ind__c</fullName>
        <formula>If(((PMP_Specification_Value_Cd__c==&apos;Yes&apos; || PMP_Specification_Value_Cd__c==&apos;No&apos;) &amp;&amp;   PMP_Display_Type_Nm__c==&apos;Radiobutton&apos;),true,false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Boolean Indicator</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
