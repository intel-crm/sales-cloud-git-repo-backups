    <fields>
        <fullName>Budget_Amount__c</fullName>
        <defaultValue>100000</defaultValue>
        <description>Has the Budget Amount Mapping For the display of the Upload File for the PFR Record</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Budget Amount controls only file upload</inlineHelpText>
        <label>Budget Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Category__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Category</label>
        <required>false</required>
