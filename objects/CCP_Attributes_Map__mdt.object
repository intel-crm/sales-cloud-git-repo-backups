                    <default>false</default>
                    <label>Paid Social Media</label>
                </value>
                <value>
                    <fullName>Print Media</fullName>
                    <default>false</default>
                    <label>Print Media</label>
                </value>
                <value>
                    <fullName>Search Engine Marketing (SEM)</fullName>
                    <default>false</default>
                    <label>Search Engine Marketing (SEM)</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
