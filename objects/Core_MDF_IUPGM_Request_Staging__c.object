    <fields>
        <fullName>Core_MDF_Overall_Status_txt__c</fullName>
        <description>Formula field displaying the overall status of the request</description>
        <externalId>false</externalId>
        <formula>IF(
  ISPICKVAL(Core_MDF_Request_Status_nm__c, &quot;Completed&quot;),
  &quot;Completed&quot;,
  IF(
    ISPICKVAL(Core_MDF_Request_Status_nm__c, &quot;Failed&quot;),
    &quot;Failed&quot;,
    IF(
      ISPICKVAL(Core_MDF_Request_Status_nm__c, &quot;Pending&quot;),
      &quot;Pending&quot;,
      &quot;New&quot;
    )
  )
)</formula>
        <inlineHelpText>Automatically calculated status based on request conditions</inlineHelpText>
        <label>Overall Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
