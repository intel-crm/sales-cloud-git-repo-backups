    <label>CCP AH Related List Config</label>
    <pluralLabel>CCP AH Related List Configs</pluralLabel>
    <validationRules>
        <fullName>masked_label</fullName>
        <active>true</active>
        <description>masked Label should not be empty if masked checkbox is selected</description>
        <errorConditionFormula>OR(
AND(Core_MDF_OriginalActor_Masked__c,ISBLANK( Core_MDF_OriginalActor_Masked_Label__c )),
AND( Core_MDF_Actor_Masked__c ,ISBLANK(Core_MDF_Actor_Masked_Label__c)),
AND(  Core_MDF_Comments_Masked__c  ,ISBLANK( Core_MDF_Comments_Masked_Label__c )))</errorConditionFormula>
        <errorMessage>Masked label should not be empty if corresponding masked Checkbox is selected</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
