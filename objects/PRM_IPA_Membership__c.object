    <label>ACM Change Request</label>
    <nameField>
        <displayFormat>Mem-{0000}</displayFormat>
        <label>PRM_IPA_Membership Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>ACM Change Requests</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>PRM_IPA_Tier_Selection</fullName>
        <active>true</active>
        <errorConditionFormula>PRM_Partner_Tier__r.Program.Name !=&apos;Intel Partner Alliance&apos;</errorConditionFormula>
        <errorDisplayField>PRM_Partner_Tier__c</errorDisplayField>
        <errorMessage>Please select IPA specific Partner tier</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_PartOf_1PID</fullName>
        <active>true</active>
        <description>If the location account is part of 1PID then there will be validation to disallow admins from submitting a role/tier update through this option.</description>
        <errorConditionFormula>NOT(ISBLANK(PRM_Account_Channel_Membership__r.PRM_Account_Id__r.Core_IPA_One_Partner_Id__c)) &amp;&amp;  PRM_Account_Channel_Membership__r.PRM_Account_Id__r.RecordType.Name  = &apos;Mastered_Account&apos;</errorConditionFormula>
        <errorMessage>The request cannot be submitted as the Location account is a part of 1PID.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_Partner_Role_Tier_Combination</fullName>
        <active>true</active>
        <description>Validation to dis allow and new request with the same role tier combination when the request is not in Rejected state</description>
        <errorConditionFormula>AND(ISNEW(),(TEXT(PRM_Account_Channel_Membership__r.PRM_Partner_Role__c ) = TEXT(PRM_Partner_Role__c ) &amp;&amp; (PRM_Account_Channel_Membership__r.PRM_Channel_Program_Level_Id__r.Name = PRM_Partner_Tier__r.Name )))</errorConditionFormula>
        <errorMessage>Partner Role and Partner tier Combination already exist.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
