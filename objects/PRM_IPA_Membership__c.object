    <fields>
        <fullName>prm_error_summary__c</fullName>
        <description>Populate Errors in transaction as part of this change request</description>
        <label>Error summary</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
