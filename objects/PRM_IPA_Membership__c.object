        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Account_Record_Type__c</fullName>
        <description>Account Record Type</description>
        <externalId>false</externalId>
        <formula>PRM_Account_Channel_Membership__r.PRM_Account_Id__r.RecordType.DeveloperName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Record Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Approve_Reject_Link__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK( &apos;/lightning/r/ProcessInstanceWorkitem/&apos; &amp; PRM_ProcessInstanceWorkItem_Id__c &amp; &apos;/view&apos; ,&apos;Approve/Reject&apos;,&quot;_blank&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Approval/Rejection Link</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
