    <fields>
        <fullName>PRM_Account_Channel_Membership__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Account Channel Membership</label>
        <referenceTo>PRM_AccountChannelMembership__c</referenceTo>
        <relationshipName>PRM_IPA_Membership</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PRM_Account_Id__c</fullName>
        <externalId>false</externalId>
        <formula>CASESAFEID(PRM_Account_Channel_Membership__r.PRM_Account_Id__r.Id)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Id</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Account_Name__c</fullName>
