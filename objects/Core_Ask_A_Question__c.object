    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_Question_Do_Not_Change_Owner</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED( OwnerId )</errorConditionFormula>
        <errorMessage>You cannot change the Submitter. Please change Support Owner for any owner changes.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Support_Request_On_Hold_Reason_Reqd</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Core_Status__c, &quot;On Hold&quot;),
 Core_On_Hold_Reason__c =&quot;&quot;
)</errorConditionFormula>
        <errorMessage>A value for On Hold Reason is required if Status equals On Hold.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Support_Request_Resolution_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Core_Status__c, &quot;Closed&quot;),
Core_Resolution__c=&quot;&quot;
)</errorConditionFormula>
        <errorMessage>A value for Resolution is required if Status equals Closed.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
