    <fields>
        <fullName>Core_Resolution__c</fullName>
        <label>Resolution</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Html</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>Core_SLA_Duration__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Core_Status__c , &quot;New&quot;), NOW() - CreatedDate, Null)</formula>
        <label>SLA Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_SLA_Indicator__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Core_SLA_Status__c = &apos;Good&apos;, IMAGE(&apos;/resource/Icon_Transparent_Green&apos;, &apos;green&apos;, 20, 20), 
 IF( Core_SLA_Status__c = &apos;Warning&apos;, IMAGE(&apos;/resource/Icon_Transparent_Yellow&apos;, &apos;yellow&apos;, 20, 20),
 IF( Core_SLA_Status__c = &apos;Violation&apos;, IMAGE(&apos;/resource/Icon_Transparent_Red&apos;, &apos;red&apos;, 20, 20),
 NULL)))</formula>
        <label>SLA Indicator</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_SLA_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL( Core_Status__c , &apos;New&apos;), 
IF(Core_SLA_Duration__c &lt; 0.5, &apos;Good&apos;, IF(Core_SLA_Duration__c &lt; 1, &apos;Warning&apos;, &quot;Violation&quot;)), &apos;In Progress&apos;)</formula>
        <label>SLA Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Service_Now_Ticket_ID__c</fullName>
        <externalId>false</externalId>
        <label>Service Now Ticket ID</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Severity_Level__c</fullName>
        <inlineHelpText>Critical – affects all users with no workaround.
High – issue affects many users with no workaround.
Medium – bug affects some users and short-term workaround.
Low – regarding a routine issue</inlineHelpText>
        <label>Severity Level</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Low</fullName>
                    <default>false</default>
                    <label>Low</label>
                </value>
                <value>
                    <fullName>Medium</fullName>
                    <default>true</default>
                    <label>Medium</label>
                </value>
                <value>
                    <fullName>High</fullName>
                    <default>false</default>
                    <label>High</label>
                </value>
                <value>
                    <fullName>Critical</fullName>
                    <default>false</default>
                    <label>Critical</label>
                </value>
