        <searchResultsAdditionalFields>VP_Feedback__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CM_Feedback__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>GM_Feedback__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CREATEDBY_USER</searchResultsAdditionalFields>
