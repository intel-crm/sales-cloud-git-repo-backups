    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Approved_as_Starting_Feedback</fullName>
        <active>true</active>
        <errorConditionFormula>IF(TEXT(DR_Feedback__c) == &apos;&apos; &amp;&amp; OR(TEXT(VP_Feedback__c) == &apos;Approved&apos;,TEXT(VP_Feedback__c) == &apos;Rejected&apos;), TRUE,FALSE)</errorConditionFormula>
        <errorMessage>You cannot enter Approved/Rejected as the Starting feedback. Kindly enter a valid feedback.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_No_Null_GTM_Model_Field</fullName>
        <active>false</active>
        <description>The GTM Model field cannot be null</description>
        <errorConditionFormula>ISCHANGED(GTM_Model__c) &amp;&amp; (ISBLANK(TEXT(GTM_Model__c)) || ISBLANK(TEXT(GTM_Model__c)))</errorConditionFormula>
        <errorMessage>GTM Model cannot be None.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_Modify_Others_Feedback</fullName>
        <active>true</active>
        <description>Should not be able to modify other Customer Feedback records.</description>
        <errorConditionFormula>OR(IF(Customer_ID__r.RCStage__c == &apos;DR&apos; &amp;&amp; ISCHANGED(DR_Feedback__c) &amp;&amp; NOT(OR( $Permission.CST_Director ,$Permission.CST_Super_Admin,$Permission.CST_Regional_Admin)),TRUE,FALSE),
IF(Customer_ID__r.RCStage__c == &apos;VP&apos; &amp;&amp; ISCHANGED(VP_Feedback__c) &amp;&amp; NOT(OR($Permission.CST_Vice_President,$Permission.CST_Super_Admin,$Permission.CST_Regional_Admin)),TRUE,FALSE),
IF(Customer_ID__r.RCStage__c == &apos;Country Manager&apos; &amp;&amp; NOT(OR($Permission.CST_Country_Manager,$Permission.CST_Super_Admin,$Permission.CST_Regional_Admin)),TRUE,FALSE),
IF(Customer_ID__r.RCStage__c == &apos;GM&apos; &amp;&amp; NOT(OR($Permission.CST_General_Manager,$Permission.CST_Super_Admin,$Permission.CST_Regional_Admin)),TRUE,FALSE))</errorConditionFormula>
        <errorMessage>You cannot edit other&apos;s feedback.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Feedback_Stage_Different</fullName>
        <active>true</active>
        <errorConditionFormula>IF(Customer_ID__r.RCStage__c !=  TEXT(Feedback_Type__c),TRUE,FALSE)</errorConditionFormula>
        <errorMessage>You are trying to enter feedback for a different stage. Please refresh and try!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>If_DR_trying_to_Approve</fullName>
        <active>true</active>
        <errorConditionFormula>IF( Customer_ID__r.RCStage__c==&apos;DR&apos; &amp;&amp; ( ISCHANGED(VP_Feedback__c) &amp;&amp; (ISPICKVAL(VP_Feedback__c, &apos;Approved&apos;)|| ISPICKVAL(VP_Feedback__c, &apos;Rejected&apos;))),TRUE,FALSE )</errorConditionFormula>
        <errorMessage>You cannot Approve/Reject in DR stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_edit_once_record_locked</fullName>
        <active>true</active>
        <errorConditionFormula>OR(IF( (Lock_Decision__c == true &amp;&amp; NOT(OR( $Permission.CST_Super_Admin , $Permission.CST_Regional_Admin )))&amp;&amp; ISCHANGED( DR_Feedback__c ),true,false),
IF( (Lock_Decision__c == true &amp;&amp; NOT(OR( $Permission.CST_Super_Admin , $Permission.CST_Regional_Admin )))&amp;&amp; (ISCHANGED(VP_Feedback__c) &amp;&amp;  NOT( ISPICKVAL(VP_Feedback__c , &apos;Approved&apos;) || ISPICKVAL(VP_Feedback__c , &apos;Rejected&apos;))),true,false),
IF( (Lock_Decision__c == true &amp;&amp; NOT(OR( $Permission.CST_Super_Admin , $Permission.CST_Regional_Admin )))&amp;&amp; (ISCHANGED(GM_Feedback__c) &amp;&amp;  NOT(ISPICKVAL(GM_Feedback__c , &apos;Approved&apos;) || ISPICKVAL(GM_Feedback__c , &apos;Rejected&apos;))),true,false),
IF( (Lock_Decision__c == true &amp;&amp; NOT(OR( $Permission.CST_Super_Admin , $Permission.CST_Regional_Admin )))&amp;&amp; (ISCHANGED(CM_Feedback__c) &amp;&amp;  NOT(ISPICKVAL(CM_Feedback__c , &apos;Approved&apos;) || ISPICKVAL(CM_Feedback__c , &apos;Rejected&apos;))),true,false))</errorConditionFormula>
        <errorMessage>You can only Approve/Reject the feedbacks once locked. No other action allowed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Feedback_Edit</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
IF( Customer_ID__r.RCStage__c == &apos;DR&apos; &amp;&amp; ((ISNEW()) || ISCHANGED( DR_Feedback__c ) || ISCHANGED(Lock_Decision__c)) &amp;&amp; (NOT(OR($Permission.CST_Super_Admin, $Permission.CST_Regional_Admin))) &amp;&amp; Feedback_By__c != $User.Id,TRUE,FALSE),
IF( Customer_ID__r.RCStage__c == &apos;VP&apos; &amp;&amp; (ISNEW() || ISCHANGED( VP_Feedback__c ) || ISCHANGED(Lock_Decision__c)) &amp;&amp; (NOT(OR($Permission.CST_Super_Admin, $Permission.CST_Regional_Admin))) &amp;&amp; IF(Feedback_By__c != $User.Id,IF(ISCHANGED(CST_Back_Propagation_By_TA__c),false, true),false) &amp;&amp; NOT( ISPICKVAL(VP_Feedback__c , &apos;Approved&apos;) || ISPICKVAL(VP_Feedback__c , &apos;Rejected&apos;)),TRUE,FALSE),
IF( Customer_ID__r.RCStage__c == &apos;Country Manager&apos; &amp;&amp; (ISNEW() || ISCHANGED( CM_Feedback__c ) || ISCHANGED(Lock_Decision__c)) &amp;&amp; (NOT(OR($Permission.CST_Super_Admin, $Permission.CST_Regional_Admin))) &amp;&amp; Feedback_By__c != $User.Id &amp;&amp; NOT( ISPICKVAL(CM_Feedback__c , &apos;Approved&apos;) || ISPICKVAL(CM_Feedback__c , &apos;Rejected&apos;)),TRUE,FALSE),
IF( Customer_ID__r.RCStage__c == &apos;GM&apos; &amp;&amp; (ISNEW() || ISCHANGED( GM_Feedback__c ) || ISCHANGED(Lock_Decision__c)) &amp;&amp; (NOT(OR($Permission.CST_Super_Admin, $Permission.CST_Regional_Admin))) &amp;&amp; Feedback_By__c != $User.Id &amp;&amp; NOT( ISPICKVAL(GM_Feedback__c , &apos;Approved&apos;) || ISPICKVAL(GM_Feedback__c , &apos;Rejected&apos;)),TRUE,FALSE)
)</errorConditionFormula>
        <errorMessage>You are not authorized to edit this feedback.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Group_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>IF(ISCHANGED(  VP_Feedback__c ) &amp;&amp;  (ISPICKVAL(VP_Feedback__c, &apos;Change to Partner&apos;)&amp;&amp; !(ISPICKVAL(New_Sales_Group__c,&apos;Americas Partner Led&apos;) || ISPICKVAL(New_Sales_Group__c,&apos;EMEA Partner Led&apos;) || ISPICKVAL(New_Sales_Group__c,&apos;APJ Partner Led&apos;) || ISPICKVAL(New_Sales_Group__c,&apos;PRC Partner Led&apos;) || ISPICKVAL(New_Sales_Group__c,&apos;India Partner Led&apos;) ) ),
IF(ISCHANGED(  VP_Feedback__c ) &amp;&amp;  (ISPICKVAL(VP_Feedback__c, &apos;Change to Uncovered&apos;)&amp;&amp; !(ISPICKVAL(New_Sales_Group__c,&apos;Undefined&apos;))),true,false),false)</errorConditionFormula>
        <errorDisplayField>New_Sales_Group__c</errorDisplayField>
        <errorMessage>You can only select Americas Partner Led, EMEA Partner Led, APJ Partner Led, PRC Partner Led, India Partner Led for Change to Partner feedback option and you can only select Undefined for Change to Uncovered feedback option.</errorMessage>
    </validationRules>
