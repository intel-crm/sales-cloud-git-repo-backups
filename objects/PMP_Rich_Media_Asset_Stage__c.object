    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This is a parent object for rich media asset category stage object, and it is created for network builder/mulesoft document library to MP purpose.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>PMP_Added_On_Dt__c</fullName>
        <description>Captures the document add date/time</description>
        <label>Document Added On</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMP_Categories_Txt__c</fullName>
        <description>Captures the categories and Sub-Categories from Mulesoft Data</description>
        <label>Categories</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>6</visibleLines>
    </fields>
    <fields>
        <fullName>PMP_Document_Description_Dsc__c</fullName>
        <description>Captures the document description from network builder</description>
        <label>Document Description</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>PMP_Document_Download_Path_url__c</fullName>
        <description>This captures the download path for the documents.</description>
        <label>Document Download Path</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>PMP_Document_Id__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Captures the document Id from network builder</description>
        <externalId>true</externalId>
        <label>Document Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>PMP_Document_Name_Nm__c</fullName>
        <description>Captures the name of the document from network builder</description>
        <externalId>false</externalId>
        <label>Document Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Document_Path_Txt__c</fullName>
        <description>Captures the document path from network builders</description>
        <externalId>false</externalId>
        <label>Document Path</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Document_Type_Txt__c</fullName>
        <description>Captures the type of document from network builder</description>
        <externalId>false</externalId>
        <label>Document Type</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Is_First_Run_Complete_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if the first run to download the pdf file is complete or not ? If it is marked as true, download the pdf only when the pdf updated date field is modified.</description>
        <label>Is First Run Complete</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Is_Retrieved_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This Boolean indicates if a document has been retrieved or not ?</description>
        <label>Is Retrieved</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Old_PDF_Updated_Dt__c</fullName>
        <description>Captures the Old PDF Update Date When Mulesoft does the Delta Load</description>
        <label>Old PDF Updated Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMP_PDF_Updated_Dt__c</fullName>
        <defaultValue>NOW()</defaultValue>
        <description>Captures the PDF update / Date Time</description>
        <label>PDF Updated Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMP_Partner_ID__c</fullName>
        <description>Captures the associate partner id from network builder</description>
        <externalId>false</externalId>
        <label>Partner ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Partner_MPID__c</fullName>
        <description>Captures the associated partner MPID value from network builder</description>
        <externalId>false</externalId>
        <label>Partner MPID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Partner_Name_Nm__c</fullName>
        <description>Captures the associated partner name, id and MPID for the document from network builder</description>
        <label>Partner Name</label>
        <length>32000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>6</visibleLines>
    </fields>
    <fields>
        <fullName>PMP_ReTrigger_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If this is true, the file download class will be called.</description>
        <inlineHelpText>Make this field true from false, and the pdf file download will be triggered.</inlineHelpText>
        <label>ReTrigger</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Updated_On_Dt__c</fullName>
        <description>Captures the update date/time for the document</description>
        <label>Document Updated On</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <label>Rich Media Asset Stage</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>PMP_Is_Retrieved_Ind__c</columns>
        <columns>PMP_Partner_Name_Nm__c</columns>
        <columns>PMP_Document_Name_Nm__c</columns>
        <columns>PMP_Updated_On_Dt__c</columns>
        <columns>PMP_Added_On_Dt__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>MediaAsset-{0000000}</displayFormat>
        <label>Rich Media Asset Auto Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Rich Media Asset Stages</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
