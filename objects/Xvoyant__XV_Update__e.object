<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This event is fired whenever an Xvoyant Object or Settings is created, updated or removed.</description>
    <eventType>HighVolume</eventType>
    <fields>
        <fullName>Xvoyant__Level__c</fullName>
        <deprecated>false</deprecated>
        <description>Indicates level of update, generally this is user, group or org</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Level</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Xvoyant__Which__c</fullName>
        <deprecated>false</deprecated>
        <description>Indicates which set of objects was altered</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Which</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Xvoyant__Who__c</fullName>
        <deprecated>false</deprecated>
        <description>Indicates who (logged user) caused the event</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Who</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>XV_Update</label>
    <pluralLabel>XV_Updates</pluralLabel>
    <publishBehavior>PublishAfterCommit</publishBehavior>
</CustomObject>
