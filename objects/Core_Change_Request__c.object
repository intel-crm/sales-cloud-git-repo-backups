    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Update_Territory_Request_Status_Field</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
RecordType.DeveloperName  == &quot;Request_Territory_Membership&quot;,
$Profile.Name &lt;&gt; $Label.Core_Data_Ops_Profile_Name, 
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
OR(
ISPICKVAL(Core_Status__c, &quot;Rejected&quot;),
ISPICKVAL(Core_Status__c, &quot;Approved&quot;)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Please contact your system administrator or data ops to approve territory</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
