                    <fullName>Deletion Complete</fullName>
                    <default>false</default>
                    <label>Deletion Complete</label>
                </value>
                <value>
                    <fullName>Deletion Error</fullName>
                    <default>false</default>
                    <label>Deletion Error</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
