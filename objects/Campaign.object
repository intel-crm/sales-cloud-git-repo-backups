                <fullName>Completed</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Draft</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>In Progress</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Approval</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Review</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Planned</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Proposal Accepted</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Revision Required</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Submitted</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Type</picklist>
            <values>
                <fullName>Advertisement</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Banner Ads</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Email</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Other</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Partners</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Public Relations</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Referral Program</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Seminar %2F Conference</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Telemarketing</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts>
        <customTabListAdditionalFields>CAMPAIGN.NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>CAMPAIGN.STATUS</customTabListAdditionalFields>
        <customTabListAdditionalFields>CAMPAIGN.START_DATE</customTabListAdditionalFields>
        <listViewButtons>Core_MDF_Export_List_View</listViewButtons>
        <lookupDialogsAdditionalFields>CAMPAIGN.NAME</lookupDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>CAMPAIGN.NAME</lookupPhoneDialogsAdditionalFields>
        <searchResultsAdditionalFields>CAMPAIGN.NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>PARENT_NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CAMPAIGN.CAMPAIGN_TYPE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CAMPAIGN.STATUS</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CAMPAIGN.START_DATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CAMPAIGN.END_DATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CAMPAIGN.NUM_RESPONSES</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CORE.USERS.ALIAS</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_Campaign_Only_Approved_In_Progress</fullName>
        <active>true</active>
        <description>Only allow Sales Campaigns that are approved to be set to status of In Progress</description>
        <errorConditionFormula>(RecordType.DeveloperName = &apos;Core_Sales_Campaign&apos;) &amp;&amp;
(ISCHANGED(Status) || ISNEW()) &amp;&amp;
(ISPICKVAL(Status, &apos;In Progress&apos;)) &amp;&amp;
(NOT(ISPICKVAL(Core_Approval_Status__c, &apos;Approved&apos;)))</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Sales Campaigns must be approved before being set to &quot;In Progress&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CampaignAccountValidation</fullName>
        <active>true</active>
        <description>Block campaign creation without Account.</description>
        <errorConditionFormula>AND(
    ISNEW(),
    ISBLANK(Core_MDF_Account__c),
    CONTAINS(
        &quot;;&quot; &amp; $Label.Core_MDF_CCP_Program_Names &amp; &quot;;&quot;,
        &quot;;&quot; &amp; Core_MDF_Channel_Program__r.Name &amp; &quot;;&quot;
    )
)</errorConditionFormula>
        <errorMessage>An account is required to create a campaign. Please select an account and try again.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CancellingIPACampaignInApproval</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  ISCHANGED(Status),
  ISPICKVAL(PRIORVALUE(Status), &apos;Pending Review&apos;),
  ISPICKVAL(Status, &apos;Cancelled&apos;),
  RecordType.DeveloperName = $Label.Core_MDF_IPA_RecordType
)</errorConditionFormula>
        <errorMessage>Proposal cannot be Cancelled in a Pending Review  or Pending Approval Status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Check_For_Negative_Budget</fullName>
        <active>true</active>
        <description>Check if Budget Amount field for Retail campaigns are not negative</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = $Label.Core_MDF_Retail_Program , 
Core_MDF_Budget_Amount_amt__c &lt;= 0
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Budget_Amount_amt__c</errorDisplayField>
        <errorMessage>Enter only positive numeric values up to 16 digits.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Check_For_Non_Negative_Amount</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
	AND(
		(RecordType.DeveloperName = $Label.Core_MDF_CCF_Program ||
		RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||
		RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program ||
		RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program),
		(Core_MDF_First_Year_Budget_Amount__c &lt; 0 || 
		Core_MDF_Second_Year_Budget_Amount__c &lt; 0
)
	),
	AND(
		RecordType.DeveloperName = $Label.Core_MDF_IPA_RecordType,
		NOT(Core_MDF_Proposal_Based_Ind__c),
		Core_MDF_Total_Campaign_Cost_Amt__c &lt;= 0
	)
)</errorConditionFormula>
        <errorMessage>Enter only positive numeric values up to 16 digits.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Account_Restriction</fullName>
        <active>true</active>
        <description>Restrict change of Account after IPA or CCP Campaign is created</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
AND(
RecordType.DeveloperName =&apos;Core_MDF_Intel_Partner_Alliance&apos;,
!ISNEW(),
ISCHANGED(Core_MDF_Account__c)
)
)</errorConditionFormula>
        <errorMessage>Account cannot be changed once Campaign is created.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Multiple_Region</fullName>
        <active>false</active>
        <description>Throw error if countries belonging to more than one region are selected on IPA Campaign.</description>
        <errorConditionFormula>TEXT(Core_MDF_Program__c)== $Label.Core_MDF_IPA_Program_Name&amp;&amp; PICKLISTCOUNT(Core_MDF_Region_cd__c) &gt; 1</errorConditionFormula>
        <errorMessage>Countries selected must be within the same Geography as defined by Intel</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Proposal_Submission</fullName>
        <active>true</active>
        <description>IPA Proposal can be submitted by IPA Proposal Manager or IPA Account Manager</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
RecordType.DeveloperName = $Label.Core_MDF_IPA_RecordType &amp;&amp;
NOT($Permission.Core_MDF_IPA_Proposal_Submitter) &amp;&amp;
ISCHANGED(Status) &amp;&amp;
ISPICKVAL(Status,&apos;Pending Review&apos;)
)</errorConditionFormula>
        <errorMessage>User is not authorized to submit Proposal for approval.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_RestrictStatusUpdate</fullName>
        <active>true</active>
        <description>This validation rule is to restrict the campaign status update from either Planned or In-Progress to Pending Approval during the customer acceptance approval.</description>
        <errorConditionFormula>AND(ISPICKVAL(Status, &apos;Pending Approval&apos;), NOT(ISPICKVAL(PRIORVALUE(Status),&apos;Pending Review&apos;)), ISPICKVAL( Core_MDF_Completed_Approval_Level_Nm__c, &apos;Customer Acceptance&apos;))</errorConditionFormula>
        <errorMessage>The proposal has been approved already. Please refresh your screen and check</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Restrict_Country_to_US</fullName>
        <active>false</active>
        <description>Deactivating as part of WW33</description>
        <errorConditionFormula>AND(
OR(ISNEW(), ISCHANGED(Core_MDF_Market__c)),  
RecordType.DeveloperName = $Label.Core_MDF_IPA_RecordType,
INCLUDES(Core_MDF_Market__c,&apos;UNITED STATES&apos;),
OR(
INCLUDES(Core_MDF_Market__c,&apos;AMERICAN SOMOA&apos;),
INCLUDES(Core_MDF_Market__c,&apos;CANADA&apos;),
INCLUDES(Core_MDF_Market__c,&apos;GUAM&apos;),
INCLUDES(Core_MDF_Market__c,&apos;PUERTO RICO&apos;),
INCLUDES(Core_MDF_Market__c,&apos;VIRGIN ISLANDS&apos;)
)
)</errorConditionFormula>
        <errorMessage>No other country can be selected if US is selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Restrict_Edit_Approved_Camp</fullName>
        <active>true</active>
        <description>Restrict editing of certain fields after an IPA Campaign is Approved</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
AND(
OR(AND(RecordType.DeveloperName =&apos;Core_MDF_Intel_Partner_Alliance&apos;,Core_MDF_Proposal_Based_Ind__c)),
OR(ISPICKVAL(Status,&apos;Planned&apos;), ISPICKVAL(Status,&apos;In Progress&apos;), AND(ISPICKVAL(Status,&apos;Revision required&apos;),
OR(ISPICKVAL(PRIORVALUE(Status),&apos;Planned&apos;), ISPICKVAL(PRIORVALUE(Status),&apos;In Progress&apos;)))),
OR(  
AND(ISCHANGED(Name),NOT($Permission.Core_MDF_CCP_Internal_Proposal_Activity_L2_Approver)),
ISCHANGED(Core_MDF_Opal_Budget_Type_Txt__c),
ISCHANGED(Core_MDF_Reimbursement_Rate__c)
)
)
)</errorConditionFormula>
        <errorMessage>User cannot edit Campaign Name, Budget Type and Reimbursement Rate when a Proposal is approved.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Restrict_Edit_Campaign_Name</fullName>
        <active>false</active>
        <description>Restrict editing of Campaign Name once claims are created</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
AND(
ISCHANGED(Name),
OR(
RecordType.DeveloperName =&apos;Core_MDF_Intel_Partner_Alliance_Closed&apos;,
Core_MDF_Approval_Step_Counter_nbr__c != 0
)
)
)</errorConditionFormula>
        <errorMessage>User cannot edit Campaign Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Restrict_Fields_In_Approval</fullName>
        <active>true</active>
        <description>Restrict editing fields when IPA Proposal is in Approval</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
AND(
RecordType.DeveloperName =&apos;Core_MDF_Intel_Partner_Alliance&apos;,
ISPICKVAL(Status,&apos;Pending Review&apos;),
OR(
ISCHANGED(Core_MDF_Opal_Budget_Type_Txt__c)
)
)
)</errorConditionFormula>
        <errorMessage>Budget Type cannot be changed when the Proposal is in approval</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Integrated_Campaign_is_Yes</fullName>
        <active>true</active>
        <description>Value is required for Integrated Campaign Detail if Integrated Campaign attribute choice is Yes</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
IF( ISPICKVAL(Core_MDF_Integrated_Campaign__c  , &apos;Yes&apos;),  IF(  OR(ISNULL(Core_MDF_Integrated_Campaign_Details__c), ISBLANK(Core_MDF_Integrated_Campaign_Details__c) ), true, false) , false)

)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Integrated_Campaign_Details__c</errorDisplayField>
        <errorMessage>Enter Integrated Campaign Details or select &quot;No&quot; for Integrated Campaign</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Retail_Campaign_Start_End_Date</fullName>
        <active>true</active>
        <description>Campaign end date should be greater than the campaign start date</description>
        <errorConditionFormula>AND(
RecordType.DeveloperName =$Label.Core_MDF_Retail_Program, 
IF(EndDate = StartDate, true,false)
)</errorConditionFormula>
        <errorDisplayField>EndDate</errorDisplayField>
        <errorMessage>Campaign end date should be greater than the campaign start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Single_Focus_Area_Selection_Val</fullName>
        <active>true</active>
        <description>Restrict user from selecting more than one focus area</description>
        <errorConditionFormula>AND(RecordType.DeveloperName == $Label.Core_MDF_IPA_RecordType,
OR(ISNEW(),ISCHANGED( Core_MDF_Focus_Area_nm__c )),
PICKLISTCOUNT( Core_MDF_Focus_Area_nm__c ) &gt; 1
)</errorConditionFormula>
        <errorMessage>Please select only one Focus Area</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Single_Outcome_Selection_Val</fullName>
        <active>true</active>
        <description>Restrict user from selecting more than one Outcome metric</description>
        <errorConditionFormula>AND(RecordType.DeveloperName == $Label.Core_MDF_IPA_RecordType,
OR(ISNEW(),ISCHANGED( Core_MDF_Outcomes_nm__c)),
PICKLISTCOUNT( Core_MDF_Outcomes_nm__c) &gt; 1
)</errorConditionFormula>
        <errorMessage>Please Select only one Outcome Metric.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Strategic_Marketing_Field_Edit</fullName>
        <active>true</active>
        <description>Restrict editing Strategic Marketing Fund field when Campaign is Cancelled/Completed</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
AND(
RecordType.DeveloperName =&apos;Core_MDF_Service_Provider_CoMarketing_Fund&apos;,
OR(ISPICKVAL(Status,&apos;Completed&apos;), ISPICKVAL(Status,&apos;Cancelled&apos;)),
ISCHANGED(Core_MDF_Strategic_Marketing_Fund_Ind__c)
)
)</errorConditionFormula>
        <errorMessage>Strategic Marketing Fund cannot be edited when Campaign is in a Completed or Cancelled status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ValidateFieldEditInCancelled</fullName>
        <active>true</active>
        <errorConditionFormula>(
    (ISPICKVAL(Core_MDF_Program__c, &quot;Data Center CoMarketing Fund&quot;) || 
    ISPICKVAL(Core_MDF_Program__c, &quot;Client CoMarketing Fund&quot;) ||
    ISPICKVAL(Core_MDF_Program__c, &quot;Service Provider CoMarketing Fund&quot;) ||
    ISPICKVAL(Core_MDF_Program__c, &quot;Client CoMarketing Fund Boost&quot;) ||
    ISPICKVAL(Core_MDF_Program__c, &quot;Retail Marketing Funds&quot;) ||
    ISPICKVAL(Core_MDF_Program__c, &quot;Intel Partner Alliance&quot;)
    ) 
    &amp;&amp; 
    ISPICKVAL(Status, &quot;Cancelled&quot;) &amp;&amp; ISPICKVAL(PRIORVALUE( Status ), &quot;Cancelled&quot;)
) &amp;&amp; ($CustomMetadata.Trigger_Execution__mdt.Core_MDF_ValidateFieldEditInCancelled.Active__c)</errorConditionFormula>
        <errorMessage>Campaign can not be edited or cancelled in Cancelled status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Campaign_Planned_Year</fullName>
        <active>true</active>
        <description>Check whether the campaign planned year spans for two years and validate the second year budgeted amount</description>
        <errorConditionFormula>IF((RecordType.DeveloperName = $Label.Core_MDF_CCF_Program || RecordType.DeveloperName = $Label.Core_MDF_DCF_Program || RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program
||RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program)
 &amp;&amp; (YEAR( EndDate ) - YEAR( StartDate )=0) , IF(NOT(ISBLANK(Core_MDF_Second_Year_Budget_Amount__c )),true, false), false)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Second_Year_Budget_Amount__c</errorDisplayField>
        <errorMessage>Campaign is only planned for 1 calendar year. Kindly remove the second year budgeted amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_EndDate</fullName>
        <active>true</active>
        <description>Campaign date can only span up to 2 budget years.</description>
        <errorConditionFormula>if((RecordType.DeveloperName = $Label.Core_MDF_CCF_Program ||  RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program
||RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program) &amp;&amp; (YEAR(EndDate) - YEAR( StartDate )  &gt;=  2),true,false)</errorConditionFormula>
        <errorDisplayField>EndDate</errorDisplayField>
        <errorMessage>Start date and end date may not span more than two calendar years.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_EndDate_Upto_Three_Yrs</fullName>
        <active>true</active>
        <description>Campaign date can only span up to 2 budget years.</description>
        <errorConditionFormula>if((RecordType.DeveloperName = $Label.Core_MDF_Co_GTM_RecordType) &amp;&amp; (YEAR(EndDate) - YEAR( StartDate )  &gt;=  3),true,false)</errorConditionFormula>
        <errorDisplayField>EndDate</errorDisplayField>
        <errorMessage>Start date and end date may not span more than three calendar years.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Negative_Spending_Cap</fullName>
        <active>true</active>
        <description>Validate the Spending Cap Amount (USD) field is not less than 0</description>
        <errorConditionFormula>if( Core_MDF_Spending_Cap_Amt__c &lt; 0, true,false)</errorConditionFormula>
        <errorMessage>Enter only positive numeric values up to 16 digits.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Priority2</fullName>
        <active>true</active>
        <description>Select a value not already selected for Priority or Priority #3</description>
        <errorConditionFormula>AND( 
	(RecordType.DeveloperName = $Label.Core_MDF_CCF_Program ||
	 RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||
	 RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program ||
	 RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program ||
	 RecordType.DeveloperName = $Label.Core_MDF_CampaignWithoutCountry), 

	(TEXT(Core_MDF_Priority__c)= TEXT(Core_MDF_Priority_2_nm__c) || 
	 TEXT(Core_MDF_Priority_3_nm__c) = Text(Core_MDF_Priority_2_nm__c)),

	NOT(ISBLANK(TEXT(Core_MDF_Priority_2_nm__c))),
	(OR(ISNEW(),ISCHANGED(Core_MDF_Priority_2_nm__c))) 
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Priority_2_nm__c</errorDisplayField>
        <errorMessage>Select a value not already selected for Priority or Priority #3</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Priority3</fullName>
        <active>true</active>
        <description>Select a value not already selected for Priority or Priority #2</description>
        <errorConditionFormula>AND(
(RecordType.DeveloperName = $Label.Core_MDF_CCF_Program
||RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program
||RecordType.DeveloperName = $Label.Core_MDF_CampaignWithoutCountry),

(TEXT( Core_MDF_Priority__c )= TEXT(Core_MDF_Priority_3_nm__c) || TEXT( Core_MDF_Priority_2_nm__c )=Text(Core_MDF_Priority_3_nm__c)) ,

NOT( ISBLANK( TEXT(Core_MDF_Priority_3_nm__c) ) ),

(OR(ISNEW(),ISCHANGED(Core_MDF_Priority_3_nm__c)))

)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Priority_3_nm__c</errorDisplayField>
        <errorMessage>Select a value not already selected for Priority or Priority #2</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Top_Priority</fullName>
        <active>true</active>
        <description>Select a value not already selected for Priority #2 or Priority #3</description>
        <errorConditionFormula>AND(
	(RecordType.DeveloperName = $Label.Core_MDF_CCF_Program || 
	 RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||
	 RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program ||
	 RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program ||
	 RecordType.DeveloperName = $Label.Core_MDF_CampaignWithoutCountry),

	(TEXT(Core_MDF_Priority_2_nm__c )= TEXT(Core_MDF_Priority__c) || 
	 TEXT(Core_MDF_Priority_3_nm__c)=Text(Core_MDF_Priority__c )),
	
	NOT(ISBLANK(TEXT(Core_MDF_Priority__c))),
	(OR(ISNEW(),ISCHANGED(Core_MDF_Priority__c)))
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Priority__c</errorDisplayField>
        <errorMessage>Select a value not already selected for Priority #2 or Priority #3</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Visibility_Start_Date_Limit</fullName>
        <active>true</active>
        <description>Campaign Member Visibility Date must be no later than Campaign Start Date</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
AND(
OR(RecordType.DeveloperName = $Label.Core_MDF_CCF_Program, 
RecordType.DeveloperName = $Label.Core_MDF_DCF_Program, RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program, RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program),
RecordType.DeveloperName  &lt;&gt;  $Label.Core_MDF_CampaignWithoutCountry,
Core_MDF_External_Visibility_Date__c &gt;  StartDate)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_External_Visibility_Date__c</errorDisplayField>
        <errorMessage>Campaign Member Visibility Date must be no later than Campaign Start Date</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Core_Bulk_Upload_Members</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Bulk Upload Members</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>/dataImporter/dataImporter.app?objectSelection=Lead,Account&amp;campaignId={!Campaign.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Create_Campaign_Task</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
