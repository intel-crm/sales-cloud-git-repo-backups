    <fields>
        <fullName>Core_MDF_Budget_Type_Reporting_Only_nm__c</fullName>
        <description>The various funding sources from which the campaign is funded</description>
        <externalId>false</externalId>
        <formula>IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Business Client Acceleration - MDF&quot; ), &quot;Business Client Acceleration - MDF; &quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Client Market Accelerate&quot; ), &quot;Client Market Accelerate+; &quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Client Specialties MDF&quot; ), &quot;Client Specialties MDF; &quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Data Center Market Accelerate&quot; ), &quot;Data Center Market Accelerate; &quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Data Center Specialties MDF&quot; ), &quot;Data Center Specialties MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Data Centric Acceleration - MDF&quot; ), &quot;Data Centric Acceleration - MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;MDF+&quot; ), &quot;MDF+; &quot;,null ) &amp;IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;CCF 1.0&quot; ), &quot;CCF 1.0; &quot;,null ) &amp;IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;DCF 1.0&quot; ), &quot;DCF 1.0; &quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Global Ericsson Acceleration - MDF&quot; ), &quot;Global Ericsson Acceleration - MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Global IBM Acceleration - MDF&quot; ), &quot;Global IBM Acceleration - MDF; &quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Global Microsoft Acceleration - MDF&quot; ), &quot;Global Microsoft Acceleration - MDF; &quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Global Nokia Acceleration - MDF&quot; ), &quot;Global Nokia Acceleration - MDF; &quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Global Red Hat Acceleration - MDF&quot; ), &quot;Global Red Hat Acceleration - MDF; &quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Global SAP Acceleration - MDF&quot; ), &quot;Global SAP Acceleration - MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Global SAS Acceleration - MDF&quot; ), &quot;Global SAS Acceleration - MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Global VMware Acceleration - MDF&quot; ), &quot;Global VMware Acceleration - MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Intel Rise Technology Initiative&quot; ), &quot;Intel Rise Technology Initiative; &quot;,null)&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;IoT Premier - MDF&quot; ), &quot;IoT Premier - MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;IoT Targeted - MDF&quot; ), &quot;IoT Targeted - MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;ODM Growth Plan - Client MDF&quot; ), &quot;ODM Growth Plan - Client MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;ISV Scale Acceleration - MDF&quot; ), &quot;ISV Scale Acceleration - MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;MDF&quot; ), &quot;MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;OEM CMP&quot; ), &quot;OEM CMP; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Optane Specialties MDF&quot; ), &quot;Optane Specialties MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &apos;Red Hat &quot;Amplify&quot; - MDF&apos; ), &apos;Red Hat &quot;Amplify&quot; - MDF; &apos;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Retail MDF&quot; ), &quot;Retail MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;RSA MD&quot; ), &quot;RSA MD; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Scale Acceleration - MDF&quot; ), &quot;Scale Acceleration - MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;Service Provider CMP&quot; ), &quot;Service Provider CMP; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;SOEM Client MDF&quot; ), &quot;SOEM Client MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;SOEM Data Center MDF&quot; ), &quot;SOEM Data Center MDF; &quot;,null )&amp;
IF ( INCLUDES ( Core_MDF_Opal_Budget_Type_Txt__c  , &quot;VMWare Amplify - MDF&quot; ), &quot;VMWare Amplify - MDF; &quot;,null )</formula>
        <label>Budget Type(Reporting Only)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
