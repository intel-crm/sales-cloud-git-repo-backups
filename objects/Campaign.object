        <fullName>Core_MDF_Account_Based_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>A flag that indicates if the IPA Campaign follows an account based flow</description>
        <label>Account Based Indicator</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>User selects the Virtual corp account on which the campaign can be created</description>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 AND 2 AND 3 AND 4) OR (5 AND 6 AND 7)</booleanFilter>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Co_Marketing</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Program__c</field>
                <operation>equals</operation>
                <valueField>Account.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</valueField>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_Parent_Fund_Account__r.RecordTypeId</field>
                <operation>notEqual</operation>
                <value>CoMarketing</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Program__c</field>
                <operation>notEqual</operation>
                <value>Retail Marketing Funds, Intel Partner Alliance</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Co_Marketing</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Program__c</field>
                <operation>equals</operation>
                <valueField>Account.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</valueField>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Program__c</field>
                <operation>equals</operation>
                <value>Retail Marketing Funds, Intel Partner Alliance, Co-GTM</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Campaigns</relationshipLabel>
        <relationshipName>Campaigns</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
