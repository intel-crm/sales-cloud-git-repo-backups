    <fields>
        <fullName>Core_MDF_CampOutcomeOpt_In_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>An flag that users can select if they want to opt in for an Outcome based campaign</description>
        <inlineHelpText>If selected, Outcome-Based Guidebook applies. If unselected, standard Sales and Marketing Guidebook applies. Activities under this campaign must be set up accordingly.</inlineHelpText>
        <label>Make this Campaign Outcome-Based</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
