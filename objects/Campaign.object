    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_Campaign_Only_Approved_In_Progress</fullName>
        <active>true</active>
        <description>Only allow Sales Campaigns that are approved to be set to status of In Progress</description>
        <errorConditionFormula>(RecordType.DeveloperName = &apos;Core_Sales_Campaign&apos;) &amp;&amp;
(ISCHANGED(Status) || ISNEW()) &amp;&amp;
(ISPICKVAL(Status, &apos;In Progress&apos;)) &amp;&amp;
(NOT(ISPICKVAL(Core_Approval_Status__c, &apos;Approved&apos;)))</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Sales Campaigns must be approved before being set to &quot;In Progress&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Check_For_Negative_Budget</fullName>
        <active>true</active>
        <description>Check if Budget Amount field for Retail campaigns are not negative</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = $Label.Core_MDF_Retail_Program , 
Core_MDF_Budget_Amount_amt__c &lt;= 0
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Budget_Amount_amt__c</errorDisplayField>
        <errorMessage>Enter only positive numeric values up to 16 digits.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Check_For_Non_Negative_Amount</fullName>
        <active>true</active>
        <errorConditionFormula>AND((RecordType.DeveloperName = $Label.Core_MDF_CCF_Program || 
RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program
||RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program),
(Core_MDF_First_Year_Budget_Amount__c &lt; 0 || Core_MDF_Second_Year_Budget_Amount__c &lt; 0
))</errorConditionFormula>
        <errorMessage>Enter only positive numeric values up to 16 digits.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Integrated_Campaign_is_Yes</fullName>
        <active>true</active>
        <description>Value is required for Integrated Campaign Detail if Integrated Campaign attribute choice is Yes</description>
        <errorConditionFormula>IF( ISPICKVAL(Core_MDF_Integrated_Campaign__c  , &apos;Yes&apos;),  IF(  OR(ISNULL(Core_MDF_Integrated_Campaign_Details__c), ISBLANK(Core_MDF_Integrated_Campaign_Details__c) ), true, false) , false)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Integrated_Campaign_Details__c</errorDisplayField>
        <errorMessage>Enter Integrated Campaign Details or select &quot;No&quot; for Integrated Campaign</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Retail_Campaign_Start_End_Date</fullName>
        <active>true</active>
        <description>Campaign end date should be greater than the campaign start date</description>
        <errorConditionFormula>AND(
RecordType.DeveloperName =$Label.Core_MDF_Retail_Program, 
IF(EndDate = StartDate, true,false)
)</errorConditionFormula>
        <errorDisplayField>EndDate</errorDisplayField>
        <errorMessage>Campaign end date should be greater than the campaign start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Campaign_Planned_Year</fullName>
        <active>true</active>
        <description>Check whether the campaign planned year spans for two years and validate the second year budgeted amount</description>
        <errorConditionFormula>IF((RecordType.DeveloperName = $Label.Core_MDF_CCF_Program || RecordType.DeveloperName = $Label.Core_MDF_DCF_Program || RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program
||RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program)
 &amp;&amp; (YEAR( EndDate ) - YEAR( StartDate )=0) , IF(NOT(ISBLANK(Core_MDF_Second_Year_Budget_Amount__c )),true, false), false)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Second_Year_Budget_Amount__c</errorDisplayField>
        <errorMessage>Campaign is only planned for 1 calendar year. Kindly remove the second year budgeted amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_EndDate</fullName>
        <active>true</active>
        <description>Campaign date can only span up to 2 budget years.</description>
        <errorConditionFormula>if ( (RecordType.DeveloperName =   $Label.Core_MDF_CCF_Program || RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program
||RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program) &amp;&amp; (YEAR(EndDate) - YEAR( StartDate )  &gt;=  2),true,false)</errorConditionFormula>
        <errorDisplayField>EndDate</errorDisplayField>
        <errorMessage>Start date and end date may not span more than two calendar years.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Priority2</fullName>
        <active>true</active>
        <description>Select a value not already selected for Priority or Priority #3</description>
        <errorConditionFormula>AND( 
(RecordType.DeveloperName = $Label.Core_MDF_CCF_Program 
||RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program
||RecordType.DeveloperName = $Label.Core_MDF_CampaignWithoutCountry), 

(TEXT( Core_MDF_Priority__c )= TEXT(Core_MDF_Priority_2_nm__c) || TEXT( Core_MDF_Priority_3_nm__c )=Text(Core_MDF_Priority_2_nm__c)) ,

NOT( ISBLANK( TEXT(Core_MDF_Priority_2_nm__c) ) ),

(OR(ISNEW(),ISCHANGED(Core_MDF_Priority_2_nm__c))) 

)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Priority_2_nm__c</errorDisplayField>
        <errorMessage>Select a value not already selected for Priority or Priority #3</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Priority3</fullName>
        <active>true</active>
        <description>Select a value not already selected for Priority or Priority #2</description>
        <errorConditionFormula>AND(
(RecordType.DeveloperName = $Label.Core_MDF_CCF_Program
||RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program
||RecordType.DeveloperName = $Label.Core_MDF_CampaignWithoutCountry),

(TEXT( Core_MDF_Priority__c )= TEXT(Core_MDF_Priority_3_nm__c) || TEXT( Core_MDF_Priority_2_nm__c )=Text(Core_MDF_Priority_3_nm__c)) ,

NOT( ISBLANK( TEXT(Core_MDF_Priority_3_nm__c) ) ),

(OR(ISNEW(),ISCHANGED(Core_MDF_Priority_3_nm__c)))

)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Priority_3_nm__c</errorDisplayField>
        <errorMessage>Select a value not already selected for Priority or Priority #2</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Top_Priority</fullName>
        <active>true</active>
        <description>Select a value not already selected for Priority #2 or Priority #3</description>
        <errorConditionFormula>AND(
(RecordType.DeveloperName = $Label.Core_MDF_CCF_Program
||RecordType.DeveloperName = $Label.Core_MDF_DCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program ||RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program
||RecordType.DeveloperName = $Label.Core_MDF_CampaignWithoutCountry),

(TEXT( Core_MDF_Priority_2_nm__c )= TEXT(Core_MDF_Priority__c ) || TEXT( Core_MDF_Priority_3_nm__c )=Text(Core_MDF_Priority__c )) ,

NOT( ISBLANK( TEXT(Core_MDF_Priority__c ) ) ),

(OR(ISNEW(),ISCHANGED(Core_MDF_Priority__c )))

)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Priority__c</errorDisplayField>
        <errorMessage>Select a value not already selected for Priority #2 or Priority #3</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Visibility_Start_Date_Limit</fullName>
        <active>true</active>
        <description>Campaign Member Visibility Date must be no later than Campaign Start Date</description>
        <errorConditionFormula>AND(
OR(RecordType.DeveloperName = $Label.Core_MDF_CCF_Program, RecordType.DeveloperName = $Label.Core_MDF_DCF_Program, RecordType.DeveloperName = $Label.Core_MDF_SPCF_Program, RecordType.DeveloperName = $Label.Core_MDF_CCFB_Program),
RecordType.DeveloperName  &lt;&gt;  $Label.Core_MDF_CampaignWithoutCountry,
Core_MDF_External_Visibility_Date__c &gt;  StartDate)</errorConditionFormula>
        <errorDisplayField>Core_MDF_External_Visibility_Date__c</errorDisplayField>
        <errorMessage>Campaign Member Visibility Date must be no later than Campaign Start Date</errorMessage>
    </validationRules>
