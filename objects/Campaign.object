        <formula>IF(Core_MDF_Proposal_Based_Ind__c = TRUE ,IF(TEXT(Core_MDF_Program__c) = $Label.Core_MDF_IPA_Technical_program_name,$Label.Core_MDF_IPA_Cancel_Campaign_Alert,$Label.Core_MDF_CCP_Cancel_Campaign_Alert),
$Label.Core_MDF_CCP_Cancel_Campaign_Alert)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Cancel Alert</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
