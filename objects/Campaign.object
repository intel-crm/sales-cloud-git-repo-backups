    <fields>
        <fullName>MKT_Campaign_Brief_Details_Formula_Txt__c</fullName>
        <description>Hyperlink of the Campaign Brief Details for Marketing Campaigns.</description>
        <externalId>false</externalId>
        <formula>IF( MKT_Campaign_Brief_Details_Txt__c != NULL, HYPERLINK(MKT_Campaign_Brief_Details_Txt__c, RIGHT(MKT_Campaign_Brief_Details_Txt__c ,LEN(MKT_Campaign_Brief_Details_Txt__c) -(FIND(&quot;attachment&quot;,MKT_Campaign_Brief_Details_Txt__c)+10))), &quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Campaign Brief Details</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
