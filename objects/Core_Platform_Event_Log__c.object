        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Status__c</fullName>
        <description>Holds the status of published message from Platform Event Bus</description>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>success</fullName>
                    <default>false</default>
                    <label>success</label>
                </value>
                <value>
                    <fullName>failed</fullName>
