    </fields>
    <fields>
        <fullName>Core_MDF_RecordType_DeveloperName_txt__c</fullName>
        <description>Recordtype</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>RecordType DeveloperName</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Req_Doc_Types_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Are documents required during claim creation ?</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Docs Required During Claim Creation?</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_ReqforPOPSubmission_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Required For POP Submission?</label>
        <type>Checkbox</type>
    </fields>
    <label>POP Document Type Revamp</label>
    <pluralLabel>POP Document Types Revamp</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
