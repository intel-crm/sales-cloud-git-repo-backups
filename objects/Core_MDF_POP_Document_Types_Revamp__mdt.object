        <description>Holds the Program Value</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Program</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Channel MDF</fullName>
                    <default>true</default>
                    <label>Channel MDF</label>
                </value>
                <value>
                    <fullName>Client</fullName>
                    <default>false</default>
                    <label>Client</label>
                </value>
                <value>
                    <fullName>Client Co-Marketing Fund</fullName>
                    <default>false</default>
                    <label>Client Co-Marketing Fund</label>
