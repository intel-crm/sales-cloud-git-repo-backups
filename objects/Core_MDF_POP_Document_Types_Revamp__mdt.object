<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Holds the POP Doc Types Configuration based on Program and Budget Type</description>
    <fields>
        <fullName>Core_MDF_Active_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Displays whether the record is active or not</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_ApplicableToAll_BudgetTypes_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicator to represent that the document type is applicable to all budget types of a specific program</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Applicable to all Budget types?</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Type_txt__c</fullName>
        <description>Holds the Budget Type Value</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Budget Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>CCF 1.0</fullName>
                    <default>true</default>
                    <label>CCF 1.0</label>
                </value>
                <value>
                    <fullName>DCF 1.0</fullName>
                    <default>false</default>
                    <label>DCF 1.0</label>
                </value>
                <value>
                    <fullName>MDF</fullName>
                    <default>false</default>
                    <label>MDF</label>
                </value>
                <value>
                    <fullName>MDF+</fullName>
                    <default>false</default>
                    <label>MDF+</label>
                </value>
                <value>
                    <fullName>OEM CMP</fullName>
                    <default>false</default>
                    <label>OEM CMP</label>
                </value>
                <value>
                    <fullName>Service Provider CMP</fullName>
                    <default>false</default>
                    <label>Service Provider CMP</label>
                </value>
                <value>
                    <fullName>Cloud</fullName>
                    <default>false</default>
                    <label>Cloud</label>
                </value>
                <value>
                    <fullName>Co-Engineering</fullName>
                    <default>false</default>
                    <label>Co-Engineering</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Document_Type_nm__c</fullName>
        <description>Holds the Document Type of record</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Document Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Proof of Cost</fullName>
                    <default>false</default>
                    <label>Proof of Cost</label>
                </value>
                <value>
                    <fullName>Proof of Attribution</fullName>
                    <default>false</default>
                    <label>Proof of Attribution</label>
                </value>
                <value>
                    <fullName>Proof of Execution</fullName>
                    <default>false</default>
                    <label>Proof of Execution</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Order_nbr__c</fullName>
        <description>Holds the Order of Doc Types to be displayed</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Order</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
