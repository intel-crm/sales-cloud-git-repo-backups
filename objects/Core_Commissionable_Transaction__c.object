    <fields>
        <fullName>Core_Opportunity_Owner_Nm__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    NOT(ISBLANK(Core_Opportunity__r.OwnerId)),
    IF(
        Core_Opportunity__r.Owner.Profile.Name &lt;&gt; &apos;Partner&apos;,
		Core_Opportunity__r.Owner.FirstName  &amp; &quot; &quot; &amp; Core_Opportunity__r.Owner.LastName,
        IF(
            NOT(ISBLANK(Core_Opportunity__r.Core_Technical_Owner__c)),
            IF(
                Core_Opportunity__r.Core_Technical_Owner__r.Profile.Name &lt;&gt; &apos;Partner&apos;,
				Core_Opportunity__r.Core_Technical_Owner__r.FirstName  &amp; &quot; &quot; &amp; Core_Opportunity__r.Core_Technical_Owner__r.LastName,
                &apos;&apos;
            ),
            &apos;&apos;
        )
    ),
    &apos;&apos;
)</formula>
        <label>Opportunity Owner</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Owner_WWID__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    NOT(ISBLANK(Core_Opportunity__r.OwnerId)),
    IF(
        Core_Opportunity__r.Owner.Profile.Name &lt;&gt; &apos;Partner&apos;,
        Core_Opportunity__r.Owner.Core_WWID__c,
        IF(
            NOT(ISBLANK(Core_Opportunity__r.Core_Technical_Owner__c)),
            IF(
                Core_Opportunity__r.Core_Technical_Owner__r.Profile.Name &lt;&gt; &apos;Partner&apos;,
                Core_Opportunity__r.Core_Technical_Owner__r.Core_WWID__c,
                &apos;&apos;
            ),
            &apos;&apos;
        )
    ),
    &apos;&apos;
)</formula>
        <label>Opportunity Owner WWID</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
