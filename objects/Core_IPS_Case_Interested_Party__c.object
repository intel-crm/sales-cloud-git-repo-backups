    <label>Interested Party</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_IPS_Account_Name__c</columns>
        <columns>Active__c</columns>
        <columns>Agent_Name__c</columns>
        <columns>Case__c</columns>
        <columns>Contact__c</columns>
        <columns>Last_Name__c</columns>
        <columns>Type__c</columns>
        <columns>User__c</columns>
        <columns>Email__c</columns>
        <columns>First_Name__c</columns>
        <columns>Test__c</columns>
        <columns>RECORDTYPE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Email__c</field>
            <operation>equals</operation>
            <value>ae@gmail.com</value>
        </filters>
        <label>All</label>
        <language>en_US</language>
    </listViews>
