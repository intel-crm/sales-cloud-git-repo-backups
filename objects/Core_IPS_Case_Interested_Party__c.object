    <webLinks>
        <fullName>Del_Ext_Part_Add</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Del Ext Part-Add</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/34.0/connection.js&quot;)} 
{!REQUIRESCRIPT(&quot;/soap/ajax/34.0/apex.js&quot;)} 

var IPSCaseAtt = new sforce.SObject(&quot;Case&quot;); 
IPSCaseAtt.Id = &apos;{!Case.Id}&apos;; 
var IPSCaseAttID = &apos;{!Case.Id}&apos;; 
console.log(&apos;-------&apos;, IPSCaseAttACCOUNT); 
var IPSCaseAttIPSPROJECT = &quot;{!Case.Core_IPS_Project_Case__c}&quot;; 
var IPSCaseAttACCOUNT = &apos;{!Case.AccountId}&apos;; 
var iserror = false; 
		
		if ((IPSCaseAttIPSPROJECT == &apos;&apos;) &amp;&amp; (IPSCaseAttACCOUNT == &apos;&apos;)) { 
			alert(&apos;This is an IPS No Assigned Contact Case. Cannot assign External Interested Parties.&apos;); 
			iserror = true; 
		} 
		else if (&apos;{!Case.Core_IPS_Customer_Visible__c}&apos; == &apos;0&apos;) { 
			alert(&apos;Case is not visible to customers. Cannot assign External Interested Parties.&apos;); 
			iserror = true; 
		} 
		if (iserror == false) { 
			if ((&quot;{!$Profile.Name}&quot; == &quot;{!$Label.Core_IPS_Partner_AE_ProfileName}&quot;)) 
			{ 
			    window.open(&quot;/IPS/Core_IPS_Interested_Party_External&quot; + &quot;?id=&quot; + IPSCaseAttID, &apos;_self&apos;); 
			}
		 
		}
//Added by Aparna for DE36697-R4.3

		if(typeof(srcUp) == &apos;function&apos; &amp;&amp; (iserror == false) &amp;&amp; (&quot;{$Profile.Name}&quot; != &quot;{$Label.Core_IPS_Partner_AE_ProfileName}&quot;)) 
		{
               alert(&apos;CONSOLE&apos;);
               sforce.console.getEnclosingTabId(function(enclosingResult) {
               sforce.console.getEnclosingPrimaryTabId(function(primaryResult) {
               sforce.console.openPrimaryTab(primaryResult.id, &quot;/apex/Core_IPS_Interested_Party_External&quot; + &quot;?id=&quot; + IPSCaseAttID, true, &apos;Case: {!Case.CaseNumber}&apos;, null);
                  });
              });
            }
          else {
              alert(&apos;NOT IN CONSOLE&apos;);
              window.open(&quot;/apex/Core_IPS_Interested_Party_External&quot; + &quot;?id=&quot; + IPSCaseAttID, &apos;_self&apos;); 
          }</url>
    </webLinks>
