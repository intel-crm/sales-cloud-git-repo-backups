    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Hold Criteria List object holds the rules for the claims which are put on to hold</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>true</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Activity_Category_Txt__c</fullName>
        <description>The activity category on the rule. Select either activity category or activity type(s). Selecting activity category will apply the rule to all activity types that are part of the activity category</description>
        <inlineHelpText>The activity category on the rule. Select either activity category or activity type(s). Selecting activity category will apply the rule to all activity types that are part of the activity category</inlineHelpText>
        <label>Activity Category</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Activity_Category</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Category_Type_Txt__c</fullName>
        <description>The activity type(s) the rule should apply to. Select either activity category or activity type(s)</description>
        <inlineHelpText>The activity type(s) the rule should apply to. Select either activity category or activity type(s)</inlineHelpText>
        <label>Activity Type</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Activity_Category_Type</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Effective_Dt__c</fullName>
        <description>The date when the rule comes into effect</description>
        <inlineHelpText>The date when the rule comes into effect</inlineHelpText>
        <label>Effective Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Geo_Txt__c</fullName>
        <description>The Geo, the rule should apply  to; Select either Geo or Region/Country. Selecting a geo will apply the rule to all countries that are part of the geo.</description>
        <inlineHelpText>The Geo, the rule should apply  to; Select either Geo or Region/Country. Selecting a geo will apply the rule to all countries that are part of the geo.</inlineHelpText>
        <label>Geo</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Geo</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Ineffective_Dt__c</fullName>
        <description>The date when the rule becomes ineffective</description>
        <inlineHelpText>The date when the rule becomes ineffective</inlineHelpText>
        <label>Ineffective Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Program_id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The program, the rule should apply to. (CCF/DCF/SPCF)</description>
        <inlineHelpText>The program, the rule should apply to. (CCF/DCF/SPCF)</inlineHelpText>
        <label>Program</label>
        <referenceTo>ChannelProgram</referenceTo>
        <relationshipLabel>Hold Criteria List</relationshipLabel>
        <relationshipName>Hold_List_Criteria</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Region_Country_txt__c</fullName>
        <description>The country or countries the rule applies to. Select either Geo or Region/Country.</description>
        <inlineHelpText>The country or countries the rule applies to. Select either Geo or Region/Country.</inlineHelpText>
        <label>Country/Region</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Region_Country</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Threshold_Amt__c</fullName>
        <description>The &quot;higher than&quot; claim amount (USD)  that the rule should apply to</description>
        <inlineHelpText>The &quot;higher than&quot; claim amount (USD)  that the rule should apply to</inlineHelpText>
        <label>Threshold Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_UltimateAccount_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The company, the rule should apply to.</description>
        <inlineHelpText>The company, the rule should apply to.</inlineHelpText>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Mastered_Account</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Hold Criteria List (Company)</relationshipLabel>
        <relationshipName>Hold_List_Criteria</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Hold Criteria List</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_UltimateAccount_Id__c</columns>
        <columns>Core_MDF_Geo_Txt__c</columns>
        <columns>Core_MDF_Region_Country_txt__c</columns>
        <columns>Core_MDF_Activity_Category_Txt__c</columns>
        <columns>Core_MDF_Activity_Category_Type_Txt__c</columns>
        <columns>Core_MDF_Effective_Dt__c</columns>
        <columns>Core_MDF_Ineffective_Dt__c</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <sharedTo>
            <group>Core_All_Users_CCP_Internal</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Core_MDF_Active_HoldCriteria_List</fullName>
        <booleanFilter>1 AND 2</booleanFilter>
        <columns>NAME</columns>
        <columns>Core_MDF_UltimateAccount_Id__c</columns>
        <columns>Core_MDF_Geo_Txt__c</columns>
        <columns>Core_MDF_Region_Country_txt__c</columns>
        <columns>Core_MDF_Activity_Category_Txt__c</columns>
        <columns>Core_MDF_Activity_Category_Type_Txt__c</columns>
        <columns>Core_MDF_Effective_Dt__c</columns>
        <columns>Core_MDF_Ineffective_Dt__c</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Effective_Dt__c</field>
            <operation>lessOrEqual</operation>
            <value>TODAY</value>
        </filters>
        <filters>
            <field>Core_MDF_Ineffective_Dt__c</field>
            <operation>greaterThan</operation>
            <value>TODAY</value>
        </filters>
        <label>Active Hold Criteria List</label>
        <language>en_US</language>
        <sharedTo>
            <group>CORE_MDF_CCP_CCFB_All</group>
            <group>CORE_MDF_CCP_CCF_ALL</group>
            <group>CORE_MDF_CCP_DCF_ALL</group>
            <group>Core_MDF_CCP_Claim_Case_Reviewer_Q_Group</group>
            <group>Core_MDF_CCP_Internal_Retail_Geo_Groups</group>
            <group>Core_MDF_CCP_SPCF_All</group>
        </sharedTo>
    </listViews>
    <nameField>
        <displayFormat>{0000}</displayFormat>
        <label>Hold Criteria ID</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Hold Criteria List</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Core_MDF_UltimateAccount_Id__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Geo_Txt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Region_Country_txt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Activity_Category_Txt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Activity_Category_Type_Txt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Effective_Dt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Ineffective_Dt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CREATEDBY_USER</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_EffectiveDate</fullName>
        <active>true</active>
        <description>Effective Date Should be Greater than or equal to Present date.</description>
        <errorConditionFormula>OR(
AND( ISNEW() ,Core_MDF_Effective_Dt__c  &lt;  TODAY()),
AND( ISCHANGED(Core_MDF_Effective_Dt__c), Core_MDF_Effective_Dt__c &lt; TODAY()))</errorConditionFormula>
        <errorMessage>Effective date cannot be earlier than today</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Ineff_dt_Greaterthan_Eff_dt</fullName>
        <active>true</active>
        <description>Ineffective date Should be greater than Effective Start Date</description>
        <errorConditionFormula>Core_MDF_Effective_Dt__c  &gt;  Core_MDF_Ineffective_Dt__c</errorConditionFormula>
        <errorMessage>Ineffective date cannot be earlier than effective date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Negative_Amt_Validation</fullName>
        <active>true</active>
        <description>Threshold amount should be greater than zero</description>
        <errorConditionFormula>IF( Core_MDF_Threshold_Amt__c &lt;=0, TRUE,FALSE)</errorConditionFormula>
        <errorMessage>Threshold amount must be greater than 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventHoldListCriteriaFromEdit</fullName>
        <active>true</active>
        <description>Criteria Rule cannot be edited</description>
        <errorConditionFormula>OR ( 
 AND(
   AND(
      Core_MDF_Effective_Dt__c &lt;= TODAY(), Core_MDF_Ineffective_Dt__c &gt; TODAY()
      ),
   OR( 
      ISCHANGED(Core_MDF_UltimateAccount_Id__c),
      ISCHANGED(Core_MDF_Geo_Txt__c ),
      ISCHANGED(Core_MDF_Activity_Category_Type_Txt__c),
      ISCHANGED(Core_MDF_Program_id__c),
      ISCHANGED(Core_MDF_Region_Country_txt__c),
      ISCHANGED(Core_MDF_Threshold_Amt__c ),
      ISCHANGED(Core_MDF_Activity_Category_Txt__c)
      )),   
  AND( PRIORVALUE(Core_MDF_Effective_Dt__c) &lt;= TODAY(), ISCHANGED(Core_MDF_Effective_Dt__c),Core_MDF_Effective_Dt__c &gt; 
  TODAY()) 
)</errorConditionFormula>
        <errorMessage>Criteria Rule cannot be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_SelectMinOneField_Validation</fullName>
        <active>true</active>
        <description>Need to select minimum one field along with Effective date and Ineffective date</description>
        <errorConditionFormula>AND( 
ISBLANK(Core_MDF_Activity_Category_Type_Txt__c),
ISBLANK(Core_MDF_UltimateAccount_Id__c),
ISBLANK(Core_MDF_Threshold_Amt__c),
ISBLANK(Core_MDF_Program_id__c), 
ISBLANK(Core_MDF_Activity_Category_Txt__c),
ISBLANK(Core_MDF_Geo_Txt__c),
ISBLANK(Core_MDF_Region_Country_txt__c)
)</errorConditionFormula>
        <errorMessage>At least one rule condition must be entered to create a hold criteria</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
