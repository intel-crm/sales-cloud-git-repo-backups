    </fields>
    <fields>
        <fullName>core_cpq_quote_link__c</fullName>
        <externalId>false</externalId>
        <formula>LEFT($Api.Partner_Server_URL_260, FIND( &apos;/services&apos;, $Api.Partner_Server_URL_260)) + &quot;/lightning/r/SBQQ__Quote__c/&quot; &amp;CASESAFEID(core_cpq_quoteId_Id__c) +&quot;/view&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Quote Link</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
