        <deleteConstraint>SetNull</deleteConstraint>
        <label>Quote</label>
        <referenceTo>SBQQ__Quote__c</referenceTo>
        <relationshipLabel>Bulk Upload Batch</relationshipLabel>
        <relationshipName>Bulk_Upload_Batch</relationshipName>
        <required>false</required>
