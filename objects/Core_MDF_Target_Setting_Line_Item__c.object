    <searchLayouts>
        <excludedStandardButtons>New</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>Accept</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_AccountChangeRestriction</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED(Core_MDF_Account__c)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account__c</errorDisplayField>
        <errorMessage>Account cannot be updated</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Do_Not_Select_Account</fullName>
        <active>true</active>
        <description>Throws error when All Account selected as Yes and if Account is entered.</description>
        <errorConditionFormula>AND(ISNEW(), ISPICKVAL( Core_MDF_All_Accounts_nm__c , &apos;Yes&apos;), NOT(ISBLANK( Core_MDF_Account__c )))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account__c</errorDisplayField>
        <errorMessage>Account should be blank if All Account option is selected</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Negative_Amount</fullName>
        <active>true</active>
        <errorConditionFormula>Core_MDF_Amount__c &lt; 0</errorConditionFormula>
        <errorDisplayField>Core_MDF_Amount__c</errorDisplayField>
        <errorMessage>Amount should be greater or equal to 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PriorityPercentValidation</fullName>
        <active>true</active>
        <description>Priority Weightage should be within 0 - 100 range.</description>
        <errorConditionFormula>OR(Core_MDF_Priority_Percentage__c &gt; 1.0, Core_MDF_Priority_Percentage__c &lt; 0.0)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Priority_Percentage__c</errorDisplayField>
        <errorMessage>Priority Weightage should be within 0% - 100%</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Region_Should_Not_Be_Blank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(RecordType.DeveloperName != $Label.Core_MDF_IPA_RecordType, ISBLANK(Core_MDF_Region_Name_nm__c))</errorConditionFormula>
        <errorMessage>Region is Mandatory for CCF and DCF Programs.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
