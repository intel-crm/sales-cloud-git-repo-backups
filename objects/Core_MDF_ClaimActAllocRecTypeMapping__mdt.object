    <fields>
        <fullName>Core_MDF_Region_cd__c</fullName>
        <description>Contains the Regions for program for which sub geo is required</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Region</label>
        <length>50</length>
