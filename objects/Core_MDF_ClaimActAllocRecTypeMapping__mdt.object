        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_Activity_Name_Swap_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field will indicate the sequence of Activity and Claim Title during claim creation.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Claim Activity Name Swap</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_RecordType_txt__c</fullName>
        <description>This field is used to store the Claim&apos;s Record Type Developer Name Based on the Channel Program</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Claim Record Type Developer Name</label>
        <length>50</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Enable_Fund_Reservation_chk__c</fullName>
        <defaultValue>true</defaultValue>
        <description>This field is used to check whether the Fund Reservation Functionality is enabled for the corresponding Channel Program</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Enable Fund Reservation</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_External_Master_Group_Name_Txt__c</fullName>
        <description>Stores the external master group name specific to the program.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>External Master Group Name</label>
        <length>255</length>
        <required>false</required>
