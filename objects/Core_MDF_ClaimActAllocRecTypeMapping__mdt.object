<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This Custom Metadata is used to map the Record Type Names of Claim, Activity and Allocation corresponding to the Channel Program</description>
    <fields>
        <fullName>Core_MDF_Activity_Close_Days__c</fullName>
        <description>Stores the cut off days after when the activity status to be set to closed</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Activity Close Days</label>
        <precision>6</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_RecordType_txt__c</fullName>
        <description>This field is used to store the Activity&apos;s Record Type Developer Name Based on the Channel Program</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Activity Record Type Developer Name</label>
        <length>50</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
