        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Channel Program Name</label>
        <length>50</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Channel_Program_txt__c</fullName>
