    <fields>
        <fullName>Core_MDF_Payment_Types_txt__c</fullName>
        <description>Only for IPA program</description>
        <externalId>false</externalId>
        <formula>IF (ISPICKVAL ( Core_MDF_Program_Txt__c,&quot;Intel Partner Alliance&quot;),
(IF ( INCLUDES ( Core_MDF_Payment_Nature_nm__c  , &quot;Expense&quot; ), &quot;Non-Customer;&quot;,&quot;&quot; )  &amp; 
IF ( INCLUDES ( Core_MDF_Payment_Nature_nm__c  , &quot;Contra Revenue&quot; ), &quot;Customer;Distributor (Cash);Distributor (Credit Memo);Customer (Pass Through);Customer-NonPO&quot;,&quot;&quot; )),
IF (ISPICKVAL ( Core_MDF_Program_Txt__c,&quot;CoGTM&quot;),
(IF ( INCLUDES ( Core_MDF_Payment_Nature_nm__c  , &quot;Expense&quot; ), &quot;Non-Customer;&quot;,&quot;&quot; )  &amp; 
IF ( INCLUDES ( Core_MDF_Payment_Nature_nm__c  , &quot;Contra CSAR&quot; ), &quot;Customer;Customer (Credit Memo)&quot;,&quot;&quot; ) &amp; 
IF ( INCLUDES ( Core_MDF_Payment_Nature_nm__c  , &quot;Contra Vistex&quot; ), &quot;Vistex (Cash);Vistex (Credit Memo)&quot;,&quot;&quot; )),&quot;&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payment Types</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
