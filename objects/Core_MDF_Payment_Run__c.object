    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_PaymentScheduleDate</fullName>
        <active>true</active>
        <description>Payment schedule date/time cannot be in past</description>
        <errorConditionFormula>OR
(
 (
  ISNEW() &amp;&amp; DATETIMEVALUE(Core_MDF_ScheduleRun_Dtm__c ) &lt; NOW()
 ),

 (
  NOT(ISNEW()) 
  &amp;&amp; ISCHANGED(Core_MDF_ScheduleRun_Dtm__c) 
  &amp;&amp; 
  DATETIMEVALUE(Core_MDF_ScheduleRun_Dtm__c ) &lt; NOW()
 )
)</errorConditionFormula>
        <errorMessage>Payment schedule date/time cannot be in past</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Payment_Run_Edit</fullName>
        <active>true</active>
        <description>Record can only be edited in Scheduled status</description>
        <errorConditionFormula>(ISCHANGED(Core_MDF_Program_Id__c)||
ISCHANGED(Core_MDF_Geo_Txt__c)||
ISCHANGED(Core_MDF_ScheduleRun_Dtm__c)) &amp;&amp;
CONTAINS($Label.Core_MDF_PaymentRun_Status, TEXT(Core_MDF_Status_Txt__c) )</errorConditionFormula>
        <errorMessage>Payment Run record cannot be edited in its current status</errorMessage>
    </validationRules>
