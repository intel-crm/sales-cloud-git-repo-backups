    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_AccountsFieldMandatoryCheck</fullName>
        <active>true</active>
        <description>For MDF record types, checking if backend accounts field is populated</description>
        <errorConditionFormula>IF(AND(OR(RecordType.Name  = &apos;Client MDF&apos;,RecordType.Name  = &apos;Datacenter MDF&apos;), OR(Core_MDF_Run_For_All_Accounts__c, NOT(ISBLANK(Core_MDF_Account_Id__c))), Core_MDF_Payment_run_for_Accounts__c = Null) , true, false)</errorConditionFormula>
        <errorMessage>Please select Account(s) to proceed with the payment run</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Accounts_Not_Selected</fullName>
        <active>true</active>
        <description>show error if no account is selected</description>
        <errorConditionFormula>IF( AND(OR(RecordType.Name == &apos;Client MDF&apos;,RecordType.Name == &apos;Datacenter MDF&apos;,RecordType.Name == &apos;Co-Engineering&apos; ), AND(NOT(Core_MDF_Run_For_All_Accounts__c),ISBLANK(Core_MDF_Account_Id__c)))
,
true,false)</errorConditionFormula>
        <errorMessage>Atleast one option needs to be selected, please select either “Run for All Accounts” option or select an account from the “Account” lookup by typing in the account name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Ad_Run_StartDate_EndDate_Check</fullName>
        <active>true</active>
        <description>Execution start date cannot be greater than Execution end date</description>
        <errorConditionFormula>IF(
AND(OR(Core_MDF_Program_Id__r.Name == $Label.Core_MDF_Retail_Channel_Program_Name,Core_MDF_Program_Id__r.Name == $Label.Core_MDF_IPA_Program_Name,Core_MDF_Program_Id__r.Name == $Label.Core_MDF_Co_GTM_program_name),
Core_MDF_Start_Dt__c &gt; Core_MDF_End_Dt__c ) ,
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Execution start date cannot be greater than execution end date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPAValidationOnSendNotification</fullName>
        <active>true</active>
        <description>Send Notification checkbox can be checked only for IPA EMEA/APJ Payment Run records</description>
        <errorConditionFormula>OR(
    AND(
        Core_MDF_Program_Id__r.Name = $Label.Core_MDF_IPA_Program_Name,
TEXT(Core_MDF_Geo_Txt__c) != &apos;EMEA&apos;,
        TEXT(Core_MDF_Geo_Txt__c) != &apos;APJ&apos;,
        Core_MDF_Send_Notification_Ind__c
    ),
AND(
NOT(ISNEW()),
        Core_MDF_Program_Id__r.Name = $Label.Core_MDF_IPA_Program_Name,
        ISCHANGED(Core_MDF_Send_Notification_Ind__c)
)
)</errorConditionFormula>
        <errorMessage>Send Notification can be checked only for EMEA/APJ Payment Run records and it cannot be edited.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Mutually_Exclude_Account_Fields</fullName>
        <active>true</active>
        <description>To select only one of &apos;Account&apos; or &apos;Run for All Accounts&apos; option</description>
        <errorConditionFormula>IF( AND(OR(RecordType.Name == &apos;Client MDF&apos;,RecordType.Name == &apos;Datacenter MDF&apos;,RecordType.Name == &apos;Co-Engineering&apos; ), OR( AND(Core_MDF_Run_For_All_Accounts__c,
NOT(ISBLANK(Core_MDF_Account_Id__c))))
),
true,false)</errorConditionFormula>
        <errorMessage>Only one option can be selected at any time, please select either “Run for All Accounts” option or select an account from the “Account” lookup by typing in the account name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PaymentRun_Geo_Validation</fullName>
        <active>true</active>
        <description>Logged In User Must have Permission to Run the Payment for a Particular Geo.</description>
        <errorConditionFormula>AND(($Permission.Core_MDF_CCP_Internal_RMF_Payment_Admin),(TEXT( Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c ) == $Label.Core_MDF_Retail_Program_Name),
OR(
AND(NOT($Permission.Core_MDF_CCP_Internal_APJ_User) ,
TEXT(Core_MDF_Geo_Txt__c) == &apos;APJ&apos;),
AND(NOT($Permission.Core_MDF_CCP_Internal_INDIA_User) ,
TEXT(Core_MDF_Geo_Txt__c) == &apos;INDIA&apos;),
AND(NOT($Permission.Core_MDF_CCP_Internal_EMEA_User) ,
TEXT(Core_MDF_Geo_Txt__c) == &apos;EMEA&apos;),
AND(NOT($Permission.Core_MDF_CCP_Internal_PRC_User) ,
 TEXT(Core_MDF_Geo_Txt__c) == &apos;PRC&apos;), 
AND(NOT($Permission.Core_MDF_CCP_Internal_LAR_User) ,
 TEXT(Core_MDF_Subgeo_Txt__c ) == &apos;LAR&apos;),
AND(NOT($Permission.Core_MDF_CCP_Internal_NAR_User) ,
 TEXT(Core_MDF_Subgeo_Txt__c ) == &apos;NAR&apos;)))</errorConditionFormula>
        <errorMessage>The User does not have Permission to Create Payment Run for Selected Geo.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PaymentScheduleDate</fullName>
        <active>true</active>
        <description>Payment schedule date/time cannot be in past</description>
        <errorConditionFormula>OR
(
 (
  ISNEW() &amp;&amp; DATETIMEVALUE(Core_MDF_ScheduleRun_Dtm__c ) &lt; NOW()
 ),

 (
  NOT(ISNEW()) 
  &amp;&amp; ISCHANGED(Core_MDF_ScheduleRun_Dtm__c) 
  &amp;&amp; 
  DATETIMEVALUE(Core_MDF_ScheduleRun_Dtm__c ) &lt; NOW()
 )
)</errorConditionFormula>
        <errorMessage>Payment schedule date/time cannot be in past</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Payment_Run_Edit</fullName>
        <active>true</active>
        <description>Record can only be edited in Scheduled status and only 2 fields namely &quot;Error Details&quot; &amp; &quot;Send notification&quot; are by passed in this Validation Rule.</description>
        <errorConditionFormula>(ISCHANGED(Core_MDF_Program_Id__c)||
ISCHANGED(Core_MDF_Geo_Txt__c)||
ISCHANGED(Core_MDF_Subgeo_Txt__c)||
ISCHANGED(Core_MDF_ScheduleRun_Dtm__c)||
ISCHANGED(Core_MDF_Start_Dt__c)||
ISCHANGED(Core_MDF_End_Dt__c) ||
ISCHANGED(Core_MDF_Budget_Type_nm__c) ||
ISCHANGED(Core_MDF_Run_Now_Ind__c)||
ISCHANGED(Core_MDF_Account_Id__c)||
ISCHANGED(Core_MDF_Run_For_All_Accounts__c) ) &amp;&amp;
CONTAINS($Label.Core_MDF_PaymentRun_Status, TEXT(Core_MDF_Status_Txt__c))</errorConditionFormula>
        <errorMessage>Payment Run record cannot be edited in its current status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ProgramFieldNullCheckValidation</fullName>
        <active>true</active>
        <description>Program field(lookup) is mandatory and cannot be blank.</description>
        <errorConditionFormula>OR(AND(ISNEW(),ISBLANK(Core_MDF_Program_Id__c)),
AND(NOT(ISNEW()),ISCHANGED(Core_MDF_Program_Id__c),ISBLANK(Core_MDF_Program_Id__c)))</errorConditionFormula>
        <errorMessage>Program field is mandatory and cannot be blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Program_Permission_Validation</fullName>
        <active>true</active>
        <description>Logged In User Must have Permission to Run the Payment for a Particular Program.</description>
        <errorConditionFormula>AND(OR(ISNEW(),ISCHANGED(Core_MDF_Program_Txt__c)),IF(RecordType.Name = &apos;Co-Marketing&apos;,
IF(AND(TEXT(Core_MDF_Program_Txt__c) = &apos;Client CoMarketing Fund&apos;,NOT($Permission.Core_MDF_CCP_Internal_CCF_Payment_Admin)), true,
IF(AND(TEXT(Core_MDF_Program_Txt__c) = &apos;Client CoMarketing Fund Boost&apos;,NOT($Permission.Core_MDF_CCP_Internal_CCFB_Payment_Admin)), true,
IF(AND(TEXT(Core_MDF_Program_Txt__c) = &apos;Data Center CoMarketing Fund&apos;,NOT($Permission.Core_MDF_CCP_Internal_DCF_Payment_Admin)), true,
IF(AND(TEXT(Core_MDF_Program_Txt__c) = &apos;Service Provider CoMarketing Fund&apos;,NOT($Permission.Core_MDF_CCP_Internal_SPCF_Payment_Admin)), true,
false)))),false))</errorConditionFormula>
        <errorMessage>You do not have permission to create a Payment Run for the selected Program. Contact support for further assistance.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Record_Edit_Restriction</fullName>
        <active>true</active>
        <description>To check if user has the permissions to edit current record</description>
        <errorConditionFormula>AND((ISCHANGED(Core_MDF_Geo_Txt__c)||
ISCHANGED(Core_MDF_Subgeo_Txt__c)||
ISCHANGED(Core_MDF_ScheduleRun_Dtm__c)||
ISCHANGED(Core_MDF_Start_Dt__c)||
ISCHANGED(Core_MDF_End_Dt__c) ||
ISCHANGED(Core_MDF_Budget_Type_nm__c) ||
ISCHANGED(Core_MDF_Run_Now_Ind__c)||
ISCHANGED(Core_MDF_Account_Id__c)||
ISCHANGED(Core_MDF_Run_For_All_Accounts__c)),
OR(
AND(RecordType.DeveloperName  = &apos;Client_Co_Marketing_Fund_CMP&apos;,NOT($Permission.Core_MDF_CCF_CMP_Payment_Admin)),
AND(RecordType.DeveloperName  = &apos;Client_Co_Marketing_Fund_MDF&apos;,NOT( $Permission.Core_MDF_CCF_MDF_Payment_Admin )),
AND(RecordType.DeveloperName  = &apos;Data_Center_Co_Marketing_Fund_CMP&apos;,NOT( $Permission.Core_MDF_DCF_CMP_Payment_Admin )),
AND(RecordType.DeveloperName  = &apos;Data_Center_Co_Marketing_Fund_MDF&apos;,NOT( $Permission.Core_MDF_DCF_MDF_Payment_Admin ))))</errorConditionFormula>
        <errorMessage>You will not be able to edit this Payment Run as you do not have access to the Budget type of the selected payment run.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Multiple_PaymentNature</fullName>
        <active>true</active>
        <description>To Restrict user from selecting more than one Payment Nature</description>
        <errorConditionFormula>PICKLISTCOUNT( Core_MDF_Payment_Nature_nm__c ) &gt; 1</errorConditionFormula>
        <errorMessage>Please select single Payment Nature</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Retail_Schedule_Required_Fields</fullName>
        <active>true</active>
        <description>Select Run Now to run payment run instantly Or Enter a date to schedule the payment Run on specific Date Time</description>
        <errorConditionFormula>IF(
AND(
OR(RecordType.Name == &apos;Client MDF&apos;,RecordType.Name == &apos;Datacenter MDF&apos;,RecordType.Name ==&apos;Intel Partner Alliance MDF&apos;,RecordType.Name ==&apos;Retail Marketing Funds&apos;,RecordType.Name ==&apos;Co-Engineering&apos;),
OR(
AND(
Core_MDF_Run_Now_Ind__c == false,
ISBLANK(Core_MDF_ScheduleRun_Dtm__c)
),
AND(
Core_MDF_Run_Now_Ind__c,
NOT(ISBLANK(Core_MDF_ScheduleRun_Dtm__c))
)
)
),
true,false
)</errorConditionFormula>
        <errorMessage>Select ‘Run Now’ to run payment run instantly or enter a date to schedule a payment run.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ValidateSubGeoForCCPPrograms</fullName>
        <active>true</active>
        <description>Display error when Sub Geo is selected for CCP Programs</description>
        <errorConditionFormula>AND( 
OR(ISPICKVAL(Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c,&apos;Client CoMarketing Fund&apos;), ISPICKVAL(Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c,&apos;Client CoMarketing Fund Boost&apos;),
ISPICKVAL(Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c,&apos;Data Center CoMarketing Fund&apos;),
ISPICKVAL(Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c,&apos;Service Provider CoMarketing Fund&apos;)), 
NOT(ISBLANK(TEXT(Core_MDF_Subgeo_Txt__c))))</errorConditionFormula>
        <errorMessage>Sub Geo is not applicable for selected Program</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ValidationOnSendNotification</fullName>
        <active>true</active>
        <description>Send Notification checkbox can be checked only for Retail EMEA MDF Payment Run records</description>
        <errorConditionFormula>OR(
OR(AND(Core_MDF_Program_Id__r.Name= $Label.Core_MDF_Retail_Channel_Program_Name, NOT(INCLUDES(Core_MDF_Budget_Type_nm__c, &quot;Retail MDF&quot;)),Core_MDF_Send_Notification_Ind__c),
AND(INCLUDES(Core_MDF_Budget_Type_nm__c,&quot;Retail MDF&quot;),
TEXT(Core_MDF_Geo_Txt__c) != &apos;EMEA&apos;,Core_MDF_Send_Notification_Ind__c)),

AND(
NOT(ISNEW()),
AND(Core_MDF_Program_Id__r.Name= $Label.Core_MDF_Retail_Channel_Program_Name,ISCHANGED(Core_MDF_Send_Notification_Ind__c))
)
)</errorConditionFormula>
        <errorMessage>Send Notification can be checked only for Retail EMEA MDF Payment Run records and it cannot be edited.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RMF_Multi_user</fullName>
        <active>true</active>
        <errorConditionFormula>IF(INCLUDES(Core_MDF_Budget_Type_nm__c, &quot;Retail MDF&quot;),1,0) +  IF(INCLUDES( Core_MDF_Budget_Type_nm__c, &quot;RSA MD&quot;),1,0)   &gt; 1</errorConditionFormula>
        <errorMessage>Please select single budget type Value</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_MDF_Export_List_View</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Export List View</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/apex/Core_MDF_ExportToExcel?ObjName=Core_MDF_Payment_Run__c</url>
    </webLinks>
</CustomObject>
