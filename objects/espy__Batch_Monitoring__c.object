    <webLinks>
        <fullName>espy__ReRun</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>ReRun</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/20.0/connection.js&quot;)} 
{!REQUIRESCRIPT(&quot;/soap/ajax/20.0/apex.js&quot;)} 

alert(&quot;The Batch is Running&quot;); 

var nextFireTime = {!espy__Batch_Monitoring__c.espy__CronExpression__c}; 
alert(nextFireTime); 
var scr=&quot;system.schedule(&apos;{!espy__Batch_Monitoring__c.espy__ApexClassName__c}&apos;,&apos;&quot;+nextFireTime+&quot;&apos;, new {!espy__Batch_Monitoring__c.espy__ApexClassName__c}());&quot;; 
alert(scr); 
var result = sforce.apex.executeAnonymous(scr); 
alert(result);</url>
    </webLinks>
</CustomObject>
