    <fields>
        <fullName>Comments__c</fullName>
        <label>Comments</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Design_Product_Status__c</fullName>
        <label>Design Product Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>Retired</fullName>
                    <default>false</default>
                    <label>Retired</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Design_Registration__c</fullName>
        <label>Design Registration</label>
        <referenceTo>Core_Design_Registration__c</referenceTo>
        <relationshipLabel>Design Reg Products</relationshipLabel>
        <relationshipName>Design_Reg_Products</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Product_Additional_Attribute__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Product Additional Attribute</label>
        <referenceTo>Product_Additional_Attribute__c</referenceTo>
        <relationshipLabel>Design Reg Products</relationshipLabel>
        <relationshipName>Design_Reg_Products</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Product</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Design Reg Products</relationshipLabel>
        <relationshipName>Design_Reg_Products</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Retired_As_Of__c</fullName>
        <label>Retired As Of</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Target_Resale_Price__c</fullName>
        <label>Target Resale Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>3</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <label>Design Reg Product</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <label>Design Reg Product Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Design Reg Products</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Product_Eligible_for_Deal_or_Design</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISCHANGED(Product_Additional_Attribute__c),
OR(AND(CONTAINS(Design_Registration__r.RecordType.Name, &apos;Deal&apos;),(Product_Additional_Attribute__r.Eligible_for_Deal_Reg__c = FALSE)),
AND(CONTAINS(Design_Registration__r.RecordType.Name, &apos;Design&apos;),(Product_Additional_Attribute__r.Eligible_for_Design_Reg__c = FALSE))))</errorConditionFormula>
        <errorMessage>Product is not eligible, please select another product.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Selected_Product_chosen_is_Valid_or_Not</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISCHANGED(Product_Additional_Attribute__c),Product_Additional_Attribute__r.Is_Product_Active__c = FALSE,
NOT(ISBLANK(Product_Additional_Attribute__c )),
OR ( Product_Additional_Attribute__r.Start_Date__c &gt; TODAY(), Product_Additional_Attribute__r.End_Date__c &lt;= TODAY()))</errorConditionFormula>
        <errorMessage>Please choose a different Product as it is not available anymore</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
