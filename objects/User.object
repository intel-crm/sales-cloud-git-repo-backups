    <fields>
        <fullName>Core_User_Coverage__c</fullName>
        <description>Field that helps to identify if user is part of OSC, SVC or RSG</description>
        <label>User Coverage</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>OSC</fullName>
                    <default>false</default>
                    <label>OSC</label>
                </value>
                <value>
                    <fullName>Field Sales</fullName>
                    <default>false</default>
                    <label>Field Sales</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
