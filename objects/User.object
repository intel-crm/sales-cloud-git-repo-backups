    <fields>
        <fullName>Core_User_Type_Indicator__c</fullName>
        <description>This field is used to identify the either the user is internal or external based on the color codes.</description>
        <externalId>false</externalId>
        <formula>IF( AND(ContactId != &apos;&apos;, NOT(CONTAINS(Email, &quot;@intel.com&quot;)) ), &quot;   &quot;+IMAGE(&quot;/resource/Core_RedIndicator&quot;, &quot;External User&quot;, 11, 12),IMAGE(&quot;/resource/Core_Blue&quot;, &quot;Internal User&quot;, 11, 12) )</formula>
        <label>User Type Indicator</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_User_Type__c</fullName>
        <description>This field is used to identify the either the user is internal or external.</description>
        <externalId>false</externalId>
        <formula>IF(NOT(CONTAINS(Email, &quot;@intel.com&quot;) ),&quot;External User&quot;,&quot;Internal User&quot; )</formula>
