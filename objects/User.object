    <fields>
        <fullName>Core_Is_FederationId_Valid_Ind__c</fullName>
        <description>Compares the Federation Id on the User Record with the Enterprise Id on the corresponding Contact Record. Returns TRUE if both are same, otherwise returns FALSE.</description>
        <formula>IF(FederationIdentifier == Contact.Core_Enterprise_Id__c, TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Compares the Federation Id on the User Record with the Enterprise Id on the corresponding Contact Record. Returns TRUE if both are same, otherwise returns FALSE.</inlineHelpText>
        <label>Is FederationId Valid</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Is_HQ_User__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Differentiate HQ Users from in-geo users</description>
        <label>Is HQ User</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Is_OSC__c</fullName>
        <description>Field that helps to identify if user is part of OSC or not part of OSC.</description>
        <formula>IF(OR(
CONTAINS( Department, &quot;INSIDE SALES&quot;),
CONTAINS( Department, &quot;OSC&quot;),
CONTAINS( Department, &quot;ONLINE SALES&quot;),
AND (CONTAINS( Department, &quot;OSG&quot;), NOT(CONTAINS(Department,&quot;TSG Client/IOT/OSG FAE Team&quot;)))
),

TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Field that helps to identify if user is part of OSC or not part of OSC.</inlineHelpText>
        <label>Is OSC?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Login_Id__c</fullName>
        <externalId>false</externalId>
        <label>Login Id</label>
        <length>64</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Manager__c</fullName>
        <externalId>false</externalId>
        <formula>Manager.FirstName+&quot; &quot;+Manager.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Manager</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Mask_Email_Id__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Email ID Masking is only applicable for Sandbox, It has no effect in production system, Please  uncheck if you need to receive any notification from sandbox.</description>
        <inlineHelpText>Email ID Masking is only applicable for Sandbox, It has no effect in production system, Please  uncheck if you need to receive any notification from sandbox.</inlineHelpText>
        <label>Mask EmailID (Only For SandBox)</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
