    </fields>
    <fields>
        <fullName>Core_Alternate_Channel_Manager_WWID__c</fullName>
        <description>Alternate Channel  Manager WWID</description>
        <externalId>false</externalId>
        <inlineHelpText>Channel Ops will enter WWID of manager if  reporting manager is different than CDIS manager</inlineHelpText>
        <label>Alternate Channel  Manager WWID</label>
        <length>80</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Email_Count__c</fullName>
        <externalId>false</externalId>
        <label>Email Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Email_Trigger_Date__c</fullName>
        <label>Email Trigger Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Email__c</fullName>
        <description>Formula field that just returns the user&apos;s email address, for situations where we can&apos;t use the standard field, but can use a custom field, like SSO for a Canvas Connected App, where we need to pass Email in the SAML Subject to the app we&apos;re integrating with. Created first for the People.ai pilot.</description>
        <externalId>false</externalId>
        <formula>Email</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Email Custom Field</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Employee_Status_Code__c</fullName>
        <description>Status code for the employee from CDIS</description>
        <externalId>false</externalId>
        <label>Employee Status Code</label>
        <length>25</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Employee_Type_Code__c</fullName>
        <description>Employee Type Code from CDIS</description>
        <label>Employee Type Code</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Non-Badged</fullName>
                    <default>true</default>
                    <label>Non-Badged</label>
                </value>
                <value>
                    <fullName>EMP</fullName>
                    <default>false</default>
                    <label>EMP</label>
                </value>
                <value>
                    <fullName>CTW</fullName>
                    <default>false</default>
                    <label>CTW</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Federation_ID__c</fullName>
        <externalId>false</externalId>
        <formula>FederationIdentifier</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Federation ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPA_One_Partner_Id__c</fullName>
        <description>The One Partner Id (OPID) that this User is part of.</description>
        <externalId>false</externalId>
        <formula>Contact.Account.Core_IPA_One_Partner_Id__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>One Partner Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPA_PartnerRole_Nm__c</fullName>
        <description>Stores the IPA partner role of the contact assigned to the user</description>
        <externalId>false</externalId>
        <formula>TEXT(Contact.Core_IPA_PartnerRole__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IPA Contact Partner Role</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_AccountId__c</fullName>
        <externalId>false</externalId>
        <formula>Contact.AccountId</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core IPS AccountId</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_IsActiveProxy__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Used only for External Users when Contact&apos;s IPS Active Field is enabled or disabled.</description>
        <label>IsActiveProxy</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Intel_Site_Code__c</fullName>
        <description>The site code for the Intel site where the user is based</description>
        <externalId>false</externalId>
        <label>Intel Site Code</label>
        <length>25</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Is_FederationId_Valid_Ind__c</fullName>
        <description>Compares the Federation Id on the User Record with the Enterprise Id on the corresponding Contact Record. Returns TRUE if both are same and Federation Id is not empty, otherwise returns FALSE. Always returns TRUE for internal users.</description>
        <formula>IF (ISPICKVAL(UserType, &apos;Standard&apos;), TRUE,
IF (ISBLANK(FederationIdentifier), FALSE,
IF (FederationIdentifier = Contact.Core_Enterprise_Id__c, TRUE, 
FALSE
)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Compares the Federation Id on the User Record with the Enterprise Id on the corresponding Contact Record. Returns TRUE if both are same and Federation Id is not empty, otherwise returns FALSE. Always returns TRUE for internal users.</inlineHelpText>
        <label>Is FederationId Valid</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Is_HQ_User__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Differentiate HQ Users from in-geo users</description>
        <label>Is HQ User</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Is_OSC__c</fullName>
        <description>Field that helps to identify if user is part of OSC or not part of OSC.</description>
        <formula>IF(OR(
CONTAINS( Department, &quot;INSIDE SALES&quot;),
CONTAINS( Department, &quot;OSC&quot;),
CONTAINS( Department, &quot;ONLINE SALES&quot;),
AND (CONTAINS( Department, &quot;OSG&quot;), NOT(CONTAINS(Department,&quot;TSG Client/IOT/OSG FAE Team&quot;)))
),

TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Field that helps to identify if user is part of OSC or not part of OSC.</inlineHelpText>
        <label>Is OSC?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
