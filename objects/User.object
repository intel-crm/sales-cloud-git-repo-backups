    <fields>
        <fullName>Core_Account_Owner__c</fullName>
        <label>Account Owner</label>
        <relationshipName>Users</relationshipName>
        <restrictedAdminField>false</restrictedAdminField>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Hierarchy</type>
    </fields>
    <fields>
        <fullName>Core_Alternate_Channel_Manager_WWID__c</fullName>
        <description>Alternate Channel  Manager WWID</description>
        <externalId>false</externalId>
        <inlineHelpText>Channel Ops will enter WWID of manager if  reporting manager is different than CDIS manager</inlineHelpText>
        <label>Alternate Channel  Manager WWID</label>
        <length>80</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Employee_Status_Code__c</fullName>
        <description>Status code for the employee from CDIS</description>
        <externalId>false</externalId>
        <label>Employee Status Code</label>
        <length>25</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Employee_Type_Code__c</fullName>
        <description>Employee Type Code from CDIS</description>
        <label>Employee Type Code</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Non-Badged</fullName>
                    <default>true</default>
                    <label>Non-Badged</label>
                </value>
                <value>
                    <fullName>EMP</fullName>
                    <default>false</default>
                    <label>EMP</label>
                </value>
                <value>
                    <fullName>CTW</fullName>
                    <default>false</default>
                    <label>CTW</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Federation_ID__c</fullName>
        <externalId>false</externalId>
        <formula>FederationIdentifier</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Federation ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_AccountId__c</fullName>
        <externalId>false</externalId>
        <formula>Contact.AccountId</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core IPS AccountId</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_IsActiveProxy__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Used only for External Users when Contact&apos;s IPS Active Field is enabled or disabled.</description>
        <label>IsActiveProxy</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Intel_Site_Code__c</fullName>
        <description>The site code for the Intel site where the user is based</description>
        <externalId>false</externalId>
        <label>Intel Site Code</label>
        <length>25</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Is_HQ_User__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Differentiate HQ Users from in-geo users</description>
        <label>Is HQ User</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Is_OSC__c</fullName>
        <description>Field that helps to identify if user is part of OSC or not part of OSC.</description>
        <formula>IF(OR(
CONTAINS( Department, &quot;INSIDE SALES&quot;),
CONTAINS( Department, &quot;OSC&quot;),
CONTAINS( Department, &quot;ONLINE SALES&quot;),
AND (CONTAINS( Department, &quot;OSG&quot;), NOT(CONTAINS(Department,&quot;TSG Client/IOT/OSG FAE Team&quot;)))
),

TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Field that helps to identify if user is part of OSC or not part of OSC.</inlineHelpText>
        <label>Is OSC?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Login_Id__c</fullName>
        <externalId>false</externalId>
        <label>Login Id</label>
        <length>64</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Mask_Email_Id__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Email ID Masking is only applicable for Sandbox, It has no effect in production system, Please  uncheck if you need to receive any notification from sandbox.</description>
        <inlineHelpText>Email ID Masking is only applicable for Sandbox, It has no effect in production system, Please  uncheck if you need to receive any notification from sandbox.</inlineHelpText>
        <label>Mask EmailID (Only For SandBox)</label>
