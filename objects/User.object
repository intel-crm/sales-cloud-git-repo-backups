            <field>Core_User_Geo__c</field>
            <operation>equals</operation>
            <value>APJ</value>
        </filters>
        <filters>
            <field>IS_FROZEN</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>CORE.USERS.LAST_LOGIN</field>
            <operation>equals</operation>
            <value>THIS_YEAR</value>
        </filters>
