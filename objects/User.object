        <fullName>User_loggedIN__c</fullName>
        <description>This field will check if the logged in user is same as that of user in the org.</description>
        <formula>IF( Email = $User.Email, true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>User_loggedIN</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
