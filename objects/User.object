        <fullName>Core_Account_Owner__c</fullName>
        <label>Account Owner</label>
        <relationshipName>Users</relationshipName>
        <restrictedAdminField>false</restrictedAdminField>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Hierarchy</type>
    </fields>
    <fields>
        <fullName>Core_Alternate_Channel_Manager_WWID__c</fullName>
        <description>Alternate Channel  Manager WWID</description>
        <externalId>false</externalId>
        <inlineHelpText>Channel Ops will enter WWID of manager if  reporting manager is different than CDIS manager</inlineHelpText>
        <label>Alternate Channel  Manager WWID</label>
        <length>80</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Email_Count__c</fullName>
        <externalId>false</externalId>
        <label>Email Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Email_Trigger_Date__c</fullName>
        <label>Email Trigger Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Employee_Status_Code__c</fullName>
        <description>Status code for the employee from CDIS</description>
        <externalId>false</externalId>
        <label>Employee Status Code</label>
        <length>25</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Employee_Type_Code__c</fullName>
        <description>Employee Type Code from CDIS</description>
        <label>Employee Type Code</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Non-Badged</fullName>
                    <default>true</default>
                    <label>Non-Badged</label>
                </value>
                <value>
                    <fullName>EMP</fullName>
                    <default>false</default>
                    <label>EMP</label>
                </value>
                <value>
                    <fullName>CTW</fullName>
                    <default>false</default>
                    <label>CTW</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Enable_Sales_Navigator_App__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is created for enabling Sales Navigator App in Accounts, Contacts, Opportunities and Leads Lightning  Page Layouts</description>
        <inlineHelpText>Enable to access Sales Navigator App</inlineHelpText>
        <label>Enable Sales Navigator App</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPA_One_Partner_Id__c</fullName>
        <description>The One Partner Id (OPID) that this User is part of.</description>
        <externalId>false</externalId>
        <formula>Contact.Account.Core_IPA_One_Partner_Id__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>One Partner Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPA_PartnerRole_Nm__c</fullName>
        <description>Stores the IPA partner role of the contact assigned to the user</description>
        <externalId>false</externalId>
        <formula>TEXT(Contact.Core_IPA_PartnerRole__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IPA Contact Partner Role</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_AccountId__c</fullName>
        <externalId>false</externalId>
        <formula>Contact.AccountId</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core IPS AccountId</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
