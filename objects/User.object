    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_IPS_Prevent_Update_Customer_User</fullName>
        <active>true</active>
        <errorConditionFormula>$Setup.Core_IPS_Run_Rules_Exception_Cust_Partne__c.Run_Validation_Rule__c
&amp;&amp; 
(
  ISPICKVAL( UserType , &quot;PowerCustomerSuccess&quot; )   &amp;&amp; 

   NOT ( Id =  $User.Id )
)</errorConditionFormula>
        <errorMessage>you can&apos;t update this User</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Prevent_Update_User_by_OrgAdmin</fullName>
        <active>true</active>
        <description>This is for preventing Org Admin from changing any user record in the system. The Org Admin has &quot;Delegated Admin&quot; in order to be able to edit &quot;Public Group&quot; , but delegated admin also allow change in user record, which should be prevented.</description>
        <errorConditionFormula>$Profile.Id = $Label.Core_IPS_OrgAdmin_Profile_ID  &amp;&amp;
NOT ( Id = $User.Id )</errorConditionFormula>
        <errorMessage>As a IPS Support Org Admin you don&apos;t have access to create/change any User Record</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Lock_CDIS_Fields</fullName>
        <active>false</active>
        <description>Prevents updates to CDIS fields by non-Integration, non-System Administrator users</description>
        <errorConditionFormula>AND(
  OR(ISCHANGED(Email),
     ISCHANGED(Alias),
     ISCHANGED(FirstName),
     ISCHANGED(LastName),
     ISCHANGED(Phone),
     ISCHANGED(MobilePhone),
     ISCHANGED(ManagerId),
     ISCHANGED(Department),
     ISCHANGED(Core_Intel_Site_Code__c),
     ISCHANGED(Core_User_Country_Code__c),
     ISCHANGED(Core_Employee_Type_Code__c),
     ISCHANGED(Core_Employee_Status_Code__c),
     ISCHANGED(CountryCode)
    ),
  ($Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name),
  ($User.Core_WWID__c &lt;&gt; &apos;10642423&apos;),
  ($Profile.Name &lt;&gt; $Label.Core_Integration_Profile_Name),
  ($Profile.Name &lt;&gt; $Label.Core_Okta_Admin_Profile_Name)
)</errorConditionFormula>
        <errorMessage>The following fields are sourced from CDIS and cannot be updated: Email Address, Alias (IDSID), First Name, Last Name, Phone, Mobile Phone, Manager, Department, Intel Site Code, User Country Code, Employee Type Code,Employee Status Code and Country.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Update_Partner_User</fullName>
        <active>true</active>
        <errorConditionFormula>$Setup.Core_IPS_Run_Rules_Exception_Cust_Partne__c.Run_Validation_Rule__c 
&amp;&amp; 
( 
 ISPICKVAL( UserType , &quot;PowerPartner&quot; ) &amp;&amp; 
 not ( Id = $User.Id ) 
)</errorConditionFormula>
        <errorMessage>you can&apos;t update this User</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_User_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
 AND(  
  OR(ISNEW(),

ISCHANGED(City),
ISCHANGED(CommunityNickname),
ISCHANGED(CompanyName),
ISCHANGED(ContactId),
ISCHANGED(Core_Account_Owner__c),
ISCHANGED(Core_Alternate_Channel_Manager_WWID__c),
ISCHANGED(Core_Is_HQ_User__c),
ISCHANGED(Core_Login_Id__c),
ISCHANGED(Core_User_Coverage__c),
ISCHANGED(Core_User_Geo__c),
ISCHANGED(Core_User_Sub_Geo__c),
ISCHANGED(Core_WWID__c),
ISCHANGED(Country),
ISCHANGED(Division),
ISCHANGED(EmployeeNumber),
ISCHANGED(Extension),
ISCHANGED(Fax),
ISCHANGED(FederationIdentifier),
ISCHANGED(IsActive),
ISCHANGED(PostalCode),
ISCHANGED(ProfileId),
ISCHANGED(State),
ISCHANGED(Street),
ISCHANGED(Title),
ISCHANGED(Username),
ISCHANGED(UserType)

),
($Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name),
($User.Core_WWID__c &lt;&gt; &apos;10642423&apos;),
($Profile.Name &lt;&gt; $Label.Core_Integration_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_Okta_Admin_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name),
Id&lt;&gt;$User.Id

),
AND(
 ISCHANGED(UserRoleId),
 
 ($Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_Data_Ops_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_Production_Support_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_Integration_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_Okta_Admin_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name),
Id&lt;&gt;$User.Id
)
)</errorConditionFormula>
        <errorMessage>The User fields are sourced from CDIS and cannot be updated.Please contact your administrator for further help.</errorMessage>
    </validationRules>
