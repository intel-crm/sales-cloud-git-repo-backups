        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Signal_Code__c</fullName>
        <description>Will hold 2 digit values. Based on this values Orderable, Shippable and Quotable flag will be set.</description>
