                    <default>true</default>
                    <label>Client</label>
                </value>
                <value>
                    <fullName>Data Center</fullName>
                    <default>false</default>
                    <label>Data Center</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Pricing Systematic Tender Limitation</label>
    <listViews>
