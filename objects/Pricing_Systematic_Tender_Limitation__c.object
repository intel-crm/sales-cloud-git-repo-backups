    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Pricing_OwnerChange_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISCHANGED(OwnerId),
PRIORVALUE(OwnerId) != OwnerId
)</errorConditionFormula>
        <errorMessage>Owner cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_VolumeExceptionQuota_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
 ISNEW(),
 ISCHANGED(Pricing_Exception_Quota__c) 
),
Pricing_Exception_Quota__c &lt;= 0
)</errorConditionFormula>
        <errorMessage>Exception Quota must be greater than zero.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
