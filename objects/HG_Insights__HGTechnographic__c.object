    <validationRules>
        <fullName>HG_Insights__Account_or_Lead_is_required</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
HG_Insights__Account__c == null &amp;&amp; HG_Insights__Lead__c == null,
HG_Insights__Account__c != null &amp;&amp; HG_Insights__Lead__c != null
)</errorConditionFormula>
        <errorMessage>Account or Lead information is required.</errorMessage>
    </validationRules>
