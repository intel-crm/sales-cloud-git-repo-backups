    <fields>
        <fullName>PSG_Temporary_License_Allowed_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To indicate whether a product can be included in a temporary license</description>
        <label>PSG Temporary License Allowed</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PSG_Tool_License_Type__c</fullName>
        <description>Defines the license type for a licensed product
•	Fixed: Supports a single user on a single machine
•	Float: Supports multiple users on multiple machines or in a server environment
•	Neutral: Supports both Single/Multi machines&quot;</description>
        <label>PSG Tool License Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>FIXED</fullName>
                    <default>false</default>
                    <label>FIXED</label>
                </value>
                <value>
                    <fullName>FLOAT</fullName>
                    <default>false</default>
                    <label>FLOAT</label>
                </value>
                <value>
                    <fullName>NEUTRAL</fullName>
                    <default>false</default>
                    <label>NEUTRAL</label>
                </value>
                <value>
                    <fullName>N-A</fullName>
                    <default>false</default>
                    <label>N-A</label>
                </value>
                <value>
                    <fullName>TRAINING CREDIT</fullName>
                    <default>false</default>
                    <label>TRAINING CREDIT</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PSG_Tool_Type__c</fullName>
        <description>Defines how products are licensed together
•	Base: Used for base or foundation product
•	IP: Used for IP Products
•	Software: Used for Software Products
•	Renewal: Used for ordering Base Product Renewal as part of Base Product maintenance.&quot;</description>
        <label>PSG Tool Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>BASE</fullName>
                    <default>false</default>
                    <label>BASE</label>
                </value>
                <value>
                    <fullName>IP</fullName>
                    <default>false</default>
                    <label>IP</label>
                </value>
                <value>
                    <fullName>SOFTWARE</fullName>
                    <default>false</default>
                    <label>SOFTWARE</label>
                </value>
                <value>
                    <fullName>RENEWAL</fullName>
                    <default>false</default>
                    <label>RENEWAL</label>
                </value>
                <value>
                    <fullName>ADD SEAT</fullName>
                    <default>false</default>
                    <label>ADD SEAT</label>
                </value>
                <value>
                    <fullName>BUNDLE</fullName>
                    <default>false</default>
                    <label>BUNDLE</label>
                </value>
                <value>
                    <fullName>CORPORATE</fullName>
                    <default>false</default>
                    <label>CORPORATE</label>
                </value>
                <value>
                    <fullName>PACKAGE</fullName>
                    <default>false</default>
                    <label>PACKAGE</label>
                </value>
                <value>
                    <fullName>N-A</fullName>
                    <default>false</default>
                    <label>N-A</label>
                </value>
                <value>
                    <fullName>TRAINING CREDIT</fullName>
                    <default>false</default>
                    <label>TRAINING CREDIT</label>
                </value>
                <value>
                    <fullName>SOC</fullName>
                    <default>false</default>
                    <label>SOC</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PSG_Web_Description__c</fullName>
        <description>•&quot;Web friendly” name for every product.
•The web description is used in all customer-facing views (SSLC/SRs) to identify the product associated with an entitlement, as opposed to Part #&quot;</description>
        <label>PSG Web Description</label>
        <length>4000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
