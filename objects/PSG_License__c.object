                <value>
                    <fullName>University</fullName>
                    <default>false</default>
                    <label>University</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PSG_ProductId__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>PSG Product</label>
