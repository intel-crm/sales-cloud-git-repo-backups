    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>To Store the extended/Licensing atrributes for PSG Products</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>PSG_ALN_Enabled_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Licensing-ALN Enable is the same as &apos;License Additional Switch&apos; which is used in license generation.</description>
        <label>PSG ALN Enabled</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PSG_Additional_Description__c</fullName>
        <description>To be Update Manualy by Product marketing team in SFDC</description>
        <label>PSG Additional Description</label>
        <length>4000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>PSG_AuthCode_Product_Txt__c</fullName>
        <description>A string passed to the license server which determines a number of the attributes that are sent to the license generator.</description>
        <externalId>false</externalId>
        <label>PSG AuthCode Product</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PSG_Available_In_Opportunities_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If this is meant for opportunity tracking.</description>
        <label>PSG Available In Opportunities</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PSG_Available_to_TOE_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>&quot;Used to control whether a product may be ordered or not
If the product is unavailable to TOE it is not visible in Tools Order Entry&quot;</description>
        <label>PSG Available to TOE</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PSG_Companion_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To indicate whether a product can be issued a companion license</description>
        <label>PSG Companion</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PSG_DES_Parameter__c</fullName>
        <description>Specifies level of security (single/triple DES) for license file encryption.</description>
        <label>PSG DES Parameter</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1DES</fullName>
                    <default>false</default>
                    <label>1DES</label>
                </value>
                <value>
                    <fullName>3DES</fullName>
                    <default>false</default>
                    <label>3DES</label>
                </value>
                <value>
                    <fullName>BOTH</fullName>
                    <default>false</default>
                    <label>BOTH</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PSG_Enforcement_Method__c</fullName>
        <description>&quot;Specifies whether the license will be enforced via license file or download or not enforced (products unavailable to TOE)
• If the Enforcement Method is &quot;&quot;FILE&quot;&quot;, it is a licensed product, and it will generate license file.
• Product with [Enforcement Method] = ’FILE’ MUST have a [AuthCode Product] value&quot;</description>
        <label>PSG Enforcement Method</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>File</fullName>
                    <default>false</default>
                    <label>File</label>
                </value>
                <value>
                    <fullName>Download</fullName>
                    <default>false</default>
                    <label>Download</label>
                </value>
                <value>
                    <fullName>N-A</fullName>
                    <default>false</default>
                    <label>N-A</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PSG_Foundation_Product_Nm__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Base Product</description>
        <label>PSG Foundation Product</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>PSG Licenses (PSG Foundation Product)</relationshipLabel>
        <relationshipName>PSG_Licenses1</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PSG_License_Comments_Txt__c</fullName>
        <description>This value is displayed on top of feature line in the license file.</description>
        <label>PSG License Comments</label>
        <length>4000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>PSG_License_Group_Nm__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>This field is requires to associate the product to a specific license group.</description>
        <label>PSG License Group</label>
        <referenceTo>License_Group__c</referenceTo>
        <relationshipLabel>PSG Licenses</relationshipLabel>
        <relationshipName>PSG_Licenses</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PSG_License_Parameter_Txt__c</fullName>
        <description>•	License parameters associated with the License Group
•	License parameters are applied to the product during license generation.</description>
        <externalId>false</externalId>
        <label>PSG License Parameter</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PSG_Linux_Download_URL__c</fullName>
        <description>URL text to show the Linux installer icons at SSLC (Self-Service Licensing Center) for customer to download</description>
        <label>PSG Linux Download URL</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>PSG_Maintenance_Duration_Nbr__c</fullName>
        <description>Value stored as Number of months.
Drives Renewal availability (Product is available for renewal if the Maintenance date is &gt;= Current Date - Renewal Grace Period</description>
        <externalId>false</externalId>
        <label>PSG Maintenance Duration</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PSG_Max_Rehost_Nbr__c</fullName>
        <defaultValue>0</defaultValue>
        <description>• To define the default number of times that a product can be rehosted.
• This is set for each entitlement at order entry.</description>
        <externalId>false</externalId>
        <label>PSG Max Rehost</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PSG_Non_Commercial_Purpose__c</fullName>
        <description>Used to identify Non Commercial Products</description>
        <label>PSG Non-Commercial Purpose</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
