    </listViews>
    <nameField>
        <displayFormat>CAG - {0000000}</displayFormat>
        <label>ContactGroupAssociation Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Contact Associations</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>ER_Contact_Fields_Merged__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ER_Contact__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ER_Account__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ER_Contact_Email__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ER_Customer_Master_File_Group__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>ER_Allow_only_active_contacts</fullName>
        <active>true</active>
        <description>Only active contacts can be added in the CMF Group</description>
        <errorConditionFormula>AND(ISNEW(),NOT(ISPICKVAL(ER_Contact__r.Core_Login_Status__c ,&apos;Active&apos;)),ISNULL( ER_End_Date__c))</errorConditionFormula>
        <errorMessage>Only Active Contacts Can be Added to CMF Group</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ER_add_contact_only_if_cmf_ispresent</fullName>
        <active>false</active>
        <description>Add Contact to particular group if atleast one CMF is attached to group</description>
        <errorConditionFormula>NOT(ER_Customer_Master_File_Group__r.ER_Count_of_Customer_Master_Files__c&gt;0)</errorConditionFormula>
        <errorMessage>No CMF is linked to this group</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Delete</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Delete</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/flow/Mass_Delete_records?retURL={!ER_Customer_Master_File_Group__c.Id}</url>
    </webLinks>
</CustomObject>
