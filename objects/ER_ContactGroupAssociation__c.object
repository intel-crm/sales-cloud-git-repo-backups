    <fields>
        <fullName>ER_Account_Id__c</fullName>
        <externalId>false</externalId>
        <formula>ER_Contact__r.AccountId</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Account_IsODM__c</fullName>
        <description>Contact having Account isODM true or false</description>
        <formula>ER_Contact__r.Account.Core_IsODM__c</formula>
        <label>IsODM Account</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_Account_Name__c</fullName>
        <externalId>false</externalId>
        <formula>ER_Contact__r.Account.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Account__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(LEFT($Api.Partner_Server_URL_260, FIND( &apos;/services&apos;, $Api.Partner_Server_URL_260)) + &quot;/lightning/r/Account/&quot; &amp;CASESAFEID(ER_Account_Id__c) +&quot;/view&quot;,ER_Account_Name__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Active_CMF_Count_Formula__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(ER_Customer_Master_File_Group__r.ER_Count_of_Customer_Master_Files__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Active CMF Count</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <label>Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ER_Audit_Field_Association__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field is created to track the audit history of the records</description>
        <label>Audit Field Association</label>
        <referenceTo>ER_Customer_Master_File_Group__c</referenceTo>
        <relationshipName>Contacts_Audit</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ER_Contact_Email__c</fullName>
        <externalId>false</externalId>
        <formula>ER_Contact__r.Email</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Contact_Email_backend__c</fullName>
        <externalId>false</externalId>
        <label>Contact Email</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Contact_Fields_Merged__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;Account : &quot;+ER_Account__c+&quot;;  Email : &quot;+ER_Contact_Email__c+&quot;;  Phone : &quot;+ER_Phone__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contact Fields Merged</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ER_Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipName>ContactGroupAssociations</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ER_Created_By__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field is created to track audit history</description>
        <label>Created By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Contacts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
