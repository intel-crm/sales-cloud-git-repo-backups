    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Contact_Association_Compact_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Contact_Association_Compact_Layout</fullName>
        <fields>ER_Contact__c</fields>
        <fields>ER_Account__c</fields>
        <fields>ER_Contact_Email__c</fields>
        <fields>ER_Phone__c</fields>
        <label>Contact Association Compact Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
