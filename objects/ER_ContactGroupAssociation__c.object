    </fields>
    <fields>
        <fullName>ER_Post_Delete_Association__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field is created to track the deleted records in a new related list of CMF group</description>
        <label>Post Delete Association</label>
        <referenceTo>ER_Customer_Master_File_Group__c</referenceTo>
        <relationshipName>Contacts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
