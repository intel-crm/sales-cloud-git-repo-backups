    </fields>
    <fields>
        <fullName>ER_StartDate__c</fullName>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>ER_Start_Date__c</fullName>
        <formula>CreatedDate</formula>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <label>Contact Association</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>ER_Customer_Master_File_Group__c</columns>
        <columns>ER_Contact__c</columns>
        <columns>ER_Account_Name__c</columns>
        <columns>ER_Phone__c</columns>
