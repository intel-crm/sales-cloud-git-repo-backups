    <deploymentStatus>Deployed</deploymentStatus>
    <description>Temporary object to store the list of Contacts and their details like Account Id, User Id, User Role Id etc. This is used as a staging table for the IPS Customer to Partner conversion program.</description>
    <enableActivities>false</enableActivities>
