    <fields>
        <fullName>Pricing_Weighting_Pct__c</fullName>
        <description>Represents the allocated proportion of performance metric used as a percent. Performance metrics are measures of quantitative assesment used for assessing, comparing and tracking performance of Intel products by the use of standardized testing methods to gauge the performance.</description>
        <inlineHelpText>Percent of weight used by the selected performance metric.</inlineHelpText>
        <label>Weighting(%)</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
