    <fields>
        <fullName>Pricing_Comp_SKU_Performance_Nbr__c</fullName>
        <description>Identifies the score of the competitor&apos;s product sku. The score represents the results of performance testing. The score is used for comparison purposes with Intel&apos;s products.</description>
        <externalId>false</externalId>
        <label>Comp Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
