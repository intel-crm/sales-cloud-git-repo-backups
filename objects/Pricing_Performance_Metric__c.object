    <fields>
        <fullName>Pricing_Quote_Line__c</fullName>
        <description>Represents the individual quote lines that are part of the quote. The individual lines that are part of a customer quote that lists the details of both intel and competitors products and price details associated.</description>
        <label>Quote Line</label>
        <referenceTo>SBQQ__QuoteLine__c</referenceTo>
