        <deleteConstraint>SetNull</deleteConstraint>
        <description>SAP End Customer Parent Name</description>
        <label>Pricing Parent Name</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Direct Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Direct_Account_Type_Nm__c</field>
                <operation>equals</operation>
                <value>End Customer Parent</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>PRIDs</relationshipLabel>
        <relationshipName>PRIDs</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
