    <fields>
        <fullName>core_cpq_type__c</fullName>
        <label>Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Flat</fullName>
                    <default>false</default>
                    <label>Flat</label>
                </value>
                <value>
                    <fullName>Step</fullName>
                    <default>false</default>
                    <label>Step</label>
                </value>
                <value>
                    <fullName>AVP</fullName>
                    <default>false</default>
                    <label>VTP</label>
                </value>
                <value>
                    <fullName>VTP</fullName>
                    <default>false</default>
                    <label>VTP not in use</label>
                </value>
                <value>
                    <fullName>Qty Limited</fullName>
                    <default>false</default>
                    <label>Qty Limited</label>
                </value>
                <value>
                    <fullName>Time Limited</fullName>
                    <default>false</default>
                    <label>Time Limited</label>
                </value>
                <value>
                    <fullName>Prototype</fullName>
                    <default>false</default>
                    <label>Prototype</label>
                </value>
                <value>
                    <fullName>Non-Step</fullName>
                    <default>false</default>
                    <label>Non-Step</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>core_cpq_unique_combination_nm__c</fullName>
        <externalId>false</externalId>
        <formula>if(
(ISPICKVAL(core_cpq_type__c,&apos;Step&apos;)),
(core_cpq_sap_ecp_nm__c + core_cpq_device__c + TEXT(core_cpq_lower_bound_qty_nbr__c) + TEXT(core_cpq_upper_bound_qty_nbr__c)),
IF(
ISPICKVAL(core_cpq_type__c,&apos;AVP&apos;),
(core_cpq_sap_ecp_nm__c + core_cpq_device__c + TEXT(core_cpq_lower_bound_qty_nbr__c) + TEXT(core_cpq_upper_bound_qty_nbr__c)+TEXT(core_cpq_prid_eligiblity_date_dt__c)),
(core_cpq_sap_ecp_nm__c + core_cpq_device__c )))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Unique Combination</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
