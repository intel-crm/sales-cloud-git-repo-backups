    <validationRules>
        <fullName>PSG_Restrict_PRID_Edit</fullName>
        <active>false</active>
        <description>It restricts users from creating new record and editing existing records during freeze period.</description>
        <errorConditionFormula>OR(
     ISNEW() ,
     !ISNULL( PRIORVALUE(Id) )
   )</errorConditionFormula>
        <errorMessage>PRID Record cannot be created or edited during Freeze Period!</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
