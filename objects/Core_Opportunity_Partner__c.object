    <fields>
        <fullName>Core_Fulfillment_Company__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Fulfillment company related to the Opportunity Partner</description>
        <inlineHelpText>A third party such as systems integrator, distributor, contract manufacturer purchasing from the Partner on behalf of the Customer. Used to track shipments.</inlineHelpText>
        <label>Fulfillment Company</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordType.Name</field>
                <operation>notEqual</operation>
                <value>Direct Account</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Opportunity Partners (Fulfillment Company)</relationshipLabel>
        <relationshipName>Opportunity_Partners1</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
