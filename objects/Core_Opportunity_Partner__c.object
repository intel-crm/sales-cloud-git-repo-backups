    <fields>
        <fullName>Core_Partner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Look up to an Account (Partner)</description>
        <inlineHelpText>3rd party involved in the opportunity, for example co-selling, co-design, fulfillment, or end customer</inlineHelpText>
        <label>Partner</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Partner Account Group, Intel Account</value>
            </filterItems>
            <infoMessage>Intel ultimate and Inactive accounts have been excluded from the below-listed accounts as they should not be selected. Please DO NOT OVERRIDE the filter criteria by clicking on &quot;Search All&quot; link below and only select an account from the ones listed below.</infoMessage>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Partner Opportunities</relationshipLabel>
        <relationshipName>Opportunity_Partners</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
