    <nameField>
        <displayFormat>OP-{00000000}</displayFormat>
        <label>Opportunity Partner ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Opportunity Partners</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Core_OppPartner_Prevent_Account</fullName>
        <active>true</active>
        <description>Allow only Intel and Partner Account Record Types.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Core_Partner__c != &apos;&apos;,
Core_Partner__r.RecordType.DeveloperName != &apos;Mastered_Account&apos;,
Core_Partner__r.RecordType.DeveloperName != &apos;Core_Partner_Account_Group&apos;
)
)</errorConditionFormula>
        <errorMessage>The account you are attempting to relate this Opportunity Partner to is not an Intel or Partner Account. Please choose an Intel or Partner Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Partner_Led_External_Opp_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, ($Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name &amp;&amp; ISCHANGED(Core_Partner_Led_External_Opportunity__c) &amp;&amp; Core_Partner_Led_External_Opportunity__c = false))</errorConditionFormula>
        <errorDisplayField>Core_Partner_Led_External_Opportunity__c</errorDisplayField>
        <errorMessage>Partner Led External Opportunity cannot be deselected.  Please submit an AAQ to request removal of this flag</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
