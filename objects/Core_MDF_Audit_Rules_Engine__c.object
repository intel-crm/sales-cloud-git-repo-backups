    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_ARE_ID_Field_Mandate</fullName>
        <active>true</active>
        <description>Mandate ID Field on Audit Rules Engine when Field is a lookup field (Account, Activity)</description>
        <errorConditionFormula>IF((
(ISPICKVAL(Core_MDF_Field_Nm__c , &apos;ChannelPartnerId&apos;) || ISPICKVAL(Core_MDF_Field_Nm__c , &apos;RequestId&apos;))
&amp;&amp; Core_MDF_ID_Field_Id__c==&apos;&apos;),true,false)</errorConditionFormula>
        <errorMessage>ID Field is mandatory for this Field value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ARE_ID_Field_Not_Mandate</fullName>
        <active>true</active>
        <description>Mandate ID Field on Audit Rules Engine when Field is a lookup field (Account, Activity)</description>
        <errorConditionFormula>NOT(ISPICKVAL(Core_MDF_Field_Nm__c , &apos;ChannelPartnerId&apos;)) &amp;&amp; Core_MDF_ID_Field_Id__c!=&apos;&apos; &amp;&amp; 
NOT(ISPICKVAL(Core_MDF_Field_Nm__c , &apos;RequestId&apos;)) &amp;&amp; NOT(ISPICKVAL(Core_MDF_Field_Nm__c , &apos;CreatedById&apos;)) 
&amp;&amp; NOT(ISPICKVAL(Core_MDF_Field_Nm__c , &apos;OwnerId&apos;))
&amp;&amp; NOT(ISPICKVAL(Core_MDF_Field_Nm__c , &apos;Core_MDF_Ultimate_Account_ID__c&apos;))</errorConditionFormula>
        <errorMessage>ID Field is not required for this criteria.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ID_Field_should_be_Mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>Core_MDF_Look_Up_Field_Ind__c	&amp;&amp;  ISBLANK(Core_MDF_ID_Field_Id__c)</errorConditionFormula>
        <errorMessage>Id Field is required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validation_for_Imm_rule_as_No</fullName>
        <active>true</active>
        <description>When Immediate rule is No do not mandate Program Region and Budget type</description>
        <errorConditionFormula>ISPICKVAL(Core_MDF_Immediate_Ind__c , &apos;No&apos;) &amp;&amp; NOT(ISPICKVAL(Core_MDF_Program_Nm__c,&quot;&quot;))</errorConditionFormula>
        <errorMessage>Program field should be blank if Immediate rule is No</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
