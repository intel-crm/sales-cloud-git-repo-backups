        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Intel_Sales_Rep_Email_Txt__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>The Sales Rep (ex. Sales Dev Mgr (SDM) or Field Sales Engineer (FSE)) at Intel who will be actioning the quote in Tenders IQR. If this field is populated, the price rule will run ONLY on quote lines that meet the price rule criteria, which have this representative listed on the quote.</inlineHelpText>
        <label>Intel Sales Rep Email</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Is_Active__c</fullName>
        <formula>IF((TODAY() &gt;=  Pricing_Rule_Start_Date__c &amp;&amp; TODAY() &lt; Pricing_Rule_End_Date__c &amp;&amp;  Owner:User.IsActive == true &amp;&amp;  Pricing_Is_Enabled__c == true) , true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Pricing_Is_Enabled__c</fullName>
