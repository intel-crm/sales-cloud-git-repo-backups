    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Pricing_EndDateCannotBePast_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(Pricing_End_Date__c &lt; Today(), OR(ISCHANGED(Pricing_End_Date__c), ISNEW()))</errorConditionFormula>
        <errorDisplayField>Pricing_End_Date__c</errorDisplayField>
        <errorMessage>Pricing End Date should be today or in future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_MinMax_Quantity_Check</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
Pricing_Minimum_Quantity__c &lt; 0,
Pricing_Maximum_Quantity__c &lt;= 0
)</errorConditionFormula>
        <errorMessage>Minimum Quantity should be greater than or equal to 0 and Maximum Quantity should be greater than 0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_MinMax_RestrictedUnitPrice_Check</fullName>
        <active>true</active>
        <description>Min value cannot be negative and max value cannot be 0 or nehative.</description>
        <errorConditionFormula>OR(
Pricing_Minimum_Requested_Unit_Price__c &lt; 0,
Pricing_Maximum_Requested_Unit_Price__c &lt;= 0
)</errorConditionFormula>
        <errorMessage>Minimum Requested Unit Price should be greater than or equal to 0 and Maximum Requested Unit Price should be greater than 0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Quantity_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISCHANGED(  Pricing_Maximum_Quantity__c  ),
ISCHANGED(  Pricing_Minimum_Quantity__c  ),
ISNEW()
),
Pricing_Maximum_Quantity__c &lt; Pricing_Minimum_Quantity__c
)</errorConditionFormula>
        <errorDisplayField>Pricing_Maximum_Quantity__c</errorDisplayField>
        <errorMessage>Minimum Quantity is greater than Maximum Quantity. Please enter a Maximum Quantity greater than Minimum Quantity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_RequestedUnitPrice_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISCHANGED(  Pricing_Maximum_Requested_Unit_Price__c  ),
ISCHANGED(  Pricing_Minimum_Requested_Unit_Price__c  ),
ISNEW()
),
Pricing_Maximum_Requested_Unit_Price__c &lt; Pricing_Minimum_Requested_Unit_Price__c
)</errorConditionFormula>
        <errorDisplayField>Pricing_Maximum_Requested_Unit_Price__c</errorDisplayField>
        <errorMessage>Minimum Requested Unit Price is greater than Maximum Requested Unit Price. Please enter a Maximum Requested Unit Price greater than Minimum Requested Unit Price.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_RestrictFormFactorORApplication</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
AND(
ISPICKVAL(Pricing_Quote_Type__c, &apos;Data Center&apos;),
Not(ISPICKVAL(Pricing_Form_Factor__c , &apos;&apos;))
),
AND(
ISPICKVAL(Pricing_Quote_Type__c, &apos;Client&apos;),
Not(ISPICKVAL(Pricing_Server_Deal_Type_Nm__c, &apos;&apos;))
)
)</errorConditionFormula>
        <errorMessage>For Data Center quote types, Application is a required field and Form Factor should be blank. For Client quote types, Form Factor is a required field and Application should be blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_RestrictRuleStartAnd_EndDateNull</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
AND(
NOT(ISNEW()),
ISCHANGED(Pricing_Rule_Start_Date__c),
ISNULL(Pricing_Rule_Start_Date__c) 
),
AND(
NOT(ISNEW()),
ISCHANGED( Pricing_Rule_End_Date__c ),
ISNULL(Pricing_Rule_End_Date__c) 
)
)</errorConditionFormula>
        <errorMessage>Rule Start or Rule End Date Cannot be blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_RuleEndDate_Before_RuleStartDate</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISCHANGED( Pricing_Rule_Start_Date__c ),
ISCHANGED( Pricing_Rule_End_Date__c ),
ISNEW()
),
Pricing_Rule_End_Date__c &lt; Pricing_Rule_Start_Date__c
)</errorConditionFormula>
        <errorDisplayField>Pricing_Rule_End_Date__c</errorDisplayField>
        <errorMessage>Rule End Date is before Rule Start Date. Please enter a Rule End Date that is after the Rule Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_RuleStartAndEndDate_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
AND(
NOT(ISNEW()),
ISCHANGED(Pricing_Rule_Start_Date__c),
Pricing_Rule_Start_Date__c &lt; TODAY()
),
AND(
NOT(ISNEW()),
ISCHANGED( Pricing_Rule_End_Date__c ),
Pricing_Rule_End_Date__c &lt; TODAY()
),
AND(
ISNEW(),
OR(
Pricing_Rule_End_Date__c &lt; TODAY(),
Pricing_Rule_Start_Date__c &lt; TODAY()
)
)
)</errorConditionFormula>
        <errorMessage>Either Rule Start Date or Rule End Date has already passed. Please ensure both dates are in the future.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
