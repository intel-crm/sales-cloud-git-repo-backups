    <fields>
        <fullName>Pricing_Intel_Account_Exec_Email_Txt__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Email address for the Intel employee who is covering the end customer. If this field is populated, the price rule will run ONLY on quote lines that meet the price rule criteria, which have this representative listed on the quote.</inlineHelpText>
        <label>Intel Account Executive Email</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
