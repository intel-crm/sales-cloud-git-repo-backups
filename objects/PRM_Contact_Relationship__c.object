<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Stores relationship ids with name and code</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>PRM_Relationship_Id__c</fullName>
        <description>15 or 18 digit SF id of relationship</description>
        <externalId>false</externalId>
        <label>Relationship Id</label>
        <length>18</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Relationship_Name__c</fullName>
        <caseSensitive>true</caseSensitive>
        <description>stores name of relationship</description>
        <externalId>false</externalId>
        <label>Relationship Name</label>
        <length>18</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <label>Contact Relationship</label>
    <visibility>Public</visibility>
</CustomObject>
