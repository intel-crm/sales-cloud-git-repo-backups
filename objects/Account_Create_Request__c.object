        </valueSet>
    </fields>
    <fields>
        <fullName>Dataops_Action_Time__c</fullName>
        <description>This backend field stores the number of hours elapsed before DataOps Approved/Rejected an Account Request record.</description>
        <externalId>false</externalId>
        <label>Dataops Action Time</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Dataops_SLA__c</fullName>
        <description>Formula field, Shows timegap (In Hours) from Created date to dataops Approval,</description>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Status__c, &quot;Pending Approval&quot;),
(Floor((Now()- CreatedDate)* 24)),

IF((ISPICKVAL(Status__c, &quot;In Process&quot;) || ISPICKVAL(Status__c,&apos;Approved&apos;) || ISPICKVAL(Status__c,&apos;Rejected&apos;)) &amp;&amp; NOT ISBLANK(Dataops_Action_Time__c) ,
(Floor(Dataops_Action_Time__c )), null ))</formula>
        <label>Sales CRM Measured SLA (Hours)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Delegate_Approver__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup relationship field, with a relationship to User object. This is used to delegate Account Request to an user who can Approve/Reject (Data Ops)</description>
        <label>Delegate Approver</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>User.IsActive</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>User.Core_User_License__c</field>
                <operation>equals</operation>
                <value>Salesforce</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>Account_Request_Queues</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
