        <columns>UPDATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Pending Approval</value>
        </filters>
        <label>New Request</label>
    </listViews>
    <listViews>
        <fullName>Pending_Request</fullName>
        <columns>CCDO_SLA__c</columns>
        <columns>Total_Measured_SLA__c</columns>
        <columns>Delegate_Approver__c</columns>
        <columns>NAME</columns>
        <columns>Process_Type__c</columns>
        <columns>Status__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>Customer_Aggregation_Type__c</columns>
        <columns>Account_Name__c</columns>
        <columns>Requested_Account__c</columns>
        <columns>Core_Sales_Groups__c</columns>
        <columns>Global_Account__c</columns>
        <columns>Requestor_Name__c</columns>
        <columns>UPDATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>In Process</value>
        </filters>
        <label>In Process Request</label>
        <language>en_US</language>
    </listViews>
    <listViews>
        <fullName>Rejected_Request</fullName>
        <columns>NAME</columns>
        <columns>CREATED_DATE</columns>
        <columns>Process_Type__c</columns>
        <columns>Status__c</columns>
        <columns>Rejected_Reason__c</columns>
        <columns>Account_Name__c</columns>
        <columns>Requested_Account__c</columns>
        <columns>Address__CountryCode__s</columns>
        <columns>Core_Sales_Groups__c</columns>
        <columns>Global_Account__c</columns>
        <columns>Requestor_Name__c</columns>
        <columns>LAST_ACTIVITY</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </filters>
        <label>Rejected Request</label>
    </listViews>
    <nameField>
        <displayFormat>AQR - {0000}</displayFormat>
        <label>Account Request Id</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Request Queues</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>New</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Account_Name_Should_be_alphanumeric</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(REGEX( Account_Name__c, &quot;^(?=.*?[a-zA-Z0-9])[a-zA-Z0-9()/\\@\\&amp;\\s\\*\\,\\#\\.\\_\\-]+$&quot;))</errorConditionFormula>
        <errorDisplayField>Account_Name__c</errorDisplayField>
        <errorMessage>Customer Name only allows English characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Approval_Flow_Update</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(PRIORVALUE(Status__c), &apos;Approved&apos;) ||  (ISPICKVAL(PRIORVALUE(Status__c), &apos;In Process&apos;) &amp;&amp; NOT(BEGINS($User.Username, &apos;ucd_reltio_connector_user&apos;)) &amp;&amp; NOT(BEGINS($User.Username, &apos;crm.acm.system.user&apos;)))</errorConditionFormula>
        <errorMessage>You cannot edit a record once Approved</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Billing_city</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK( Address__City__s )</errorConditionFormula>
        <errorDisplayField>Address__City__s</errorDisplayField>
        <errorMessage>Complete this Field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Billing_country_mandatary</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(Address__CountryCode__s, &apos;&apos;)
||
ISPICKVAL(Address__CountryCode__s, &apos;--None--&apos;)</errorConditionFormula>
        <errorDisplayField>Address__CountryCode__s</errorDisplayField>
        <errorMessage>Complete this Field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Billing_state_mandatary</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(  Address__Street__s  )</errorConditionFormula>
        <errorDisplayField>Address__Street__s</errorDisplayField>
        <errorMessage>Complete this field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Postal_code_Alphanumeric_validation</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(REGEX(Address__PostalCode__s , &quot;^[a-zA-Z0-9- ]*$&quot;))</errorConditionFormula>
        <errorDisplayField>Address__PostalCode__s</errorDisplayField>
        <errorMessage>Postal code should be Alphanumeric.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Rejection_Flow_Update</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(PRIORVALUE( Status__c ), &apos;Rejected&apos;) &amp;&amp; NOT(BEGINS($User.Username , &apos;crm.acm.system.user&apos;))</errorConditionFormula>
        <errorDisplayField>Core_Account_Category__c</errorDisplayField>
        <errorMessage>You cannot edit a record once rejected</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Umbrella_Group_Required_for_Industries</fullName>
        <active>true</active>
        <description>Umbrella Group is required when Industry is Defense and Space, Education, or Government</description>
        <errorConditionFormula>AND(
    OR(
        ISPICKVAL(Industry__c,&apos;Defense and Space&apos;),
        ISPICKVAL(Industry__c,&apos;Education&apos;),
        ISPICKVAL(Industry__c,&apos;Government&apos;)
    ),
    ISBLANK(TEXT(Core_Umbrella_Group__c))
)</errorConditionFormula>
        <errorMessage>Umbrella Group is required when Industry is Defense and Space, Education, or Government</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>postal_code_should_be_Integer</fullName>
        <active>true</active>
        <description>postal_code_should_be_Integer</description>
        <errorConditionFormula>!REGEX( Zip_Postal_Code__c ,&quot;[0-9]*&quot;)</errorConditionFormula>
        <errorDisplayField>Zip_Postal_Code__c</errorDisplayField>
        <errorMessage>Postal code should be an integer</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
