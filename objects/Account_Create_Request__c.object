        <fullName>DataOps_Action_Time_New__c</fullName>
        <label>DataOps Action Time New</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Dataops_Action_Time__c</fullName>
        <description>Stores datetime of dataops Approval, Which is using for SLA Calculation</description>
        <externalId>false</externalId>
        <label>Dataops Action Time</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Dataops_SLA__c</fullName>
        <description>Formula field, Shows timegap (In Hours) from Created date to dataops Approval,</description>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Status__c, &quot;Pending Approval&quot;),
(Floor((Now()- CreatedDate)* 24)),

IF((ISPICKVAL(Status__c, &quot;In Process&quot;) || ISPICKVAL(Status__c,&apos;Approved&apos;) || ISPICKVAL(Status__c,&apos;Rejected&apos;)) &amp;&amp; NOT ISBLANK(Dataops_Action_Time__c) ,
(Floor(Dataops_Action_Time__c )), null ))</formula>
        <label>Sales CRM Measured SLA (Hours)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Delegate_Approver__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Delegate Approver</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>equals</operation>
                <value>Data Ops</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>Account_Request_Queues</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
