    <fields>
        <fullName>Total_Measured_SLA__c</fullName>
        <description>Formula field, Shows timegap (In Hours) from record creation to Reltio Approval.</description>
        <externalId>false</externalId>
        <formula>IF((ISPICKVAL(Status__c, &quot;Pending Approval&quot;) || ISPICKVAL(Status__c, &quot;In Process&quot;)),
(FLOOR((Now()- CreatedDate)* 24))
,
IF((ISPICKVAL(Status__c, &quot;Approved&quot;) || ISPICKVAL(Status__c, &quot;Rejected&quot;)),
Floor(ccdo_Action_Time__c + Dataops_Action_Time__c), null ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Measured SLA (Hours)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
