    <label>Account Request Queue</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Account_Name__c</columns>
        <columns>Requested_Account__c</columns>
        <columns>Customer_Process_Engagement__c</columns>
        <columns>Country__c</columns>
        <columns>Status__c</columns>
        <columns>Request_Flow_Status__c</columns>
        <columns>Request_Owner__c</columns>
        <columns>Rejected_Reason__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Approved_Requests</fullName>
        <columns>NAME</columns>
        <columns>Account_Name__c</columns>
        <columns>Requested_Account__c</columns>
        <columns>Customer_Process_Engagement__c</columns>
        <columns>Country__c</columns>
        <columns>Request_Flow_Status__c</columns>
        <columns>Rejected_Reason__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </filters>
        <label>Approved Requests</label>
    </listViews>
    <listViews>
        <fullName>New_Request</fullName>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Pending Approval</value>
        </filters>
        <label>New Request</label>
    </listViews>
    <listViews>
        <fullName>Pending_Requests</fullName>
        <columns>NAME</columns>
        <columns>Account_Name__c</columns>
        <columns>Requested_Account__c</columns>
        <columns>Customer_Process_Engagement__c</columns>
        <columns>Country__c</columns>
        <columns>Request_Flow_Status__c</columns>
        <columns>Rejected_Reason__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>In Process</value>
        </filters>
        <label>In Process Requests</label>
    </listViews>
    <listViews>
        <fullName>Rejected_Requests</fullName>
        <columns>NAME</columns>
        <columns>Account_Name__c</columns>
        <columns>Requested_Account__c</columns>
        <columns>Customer_Process_Engagement__c</columns>
        <columns>Country__c</columns>
        <columns>Request_Flow_Status__c</columns>
        <columns>Rejected_Reason__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </filters>
        <label>Rejected Requests</label>
    </listViews>
    <listViews>
        <fullName>Reuse_Requests</fullName>
        <columns>NAME</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Reuse</value>
        </filters>
        <label>Reuse Requests</label>
    </listViews>
    <nameField>
        <displayFormat>AQR - {0000}</displayFormat>
        <label>Account Request Id</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Request Queues</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>New</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Account_Name_Should_be_alphanumeric</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(REGEX( Account_Name__c, &quot;^(?=.*?[a-zA-Z0-9])[a-zA-Z0-9()/\\@\\&amp;\\s\\*\\,\\#\\.\\_\\-]+$&quot;))</errorConditionFormula>
        <errorDisplayField>Account_Name__c</errorDisplayField>
        <errorMessage>Customer Name only allows English characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Approval_Flow_Update</fullName>
        <active>false</active>
        <errorConditionFormula>ISPICKVAL(PRIORVALUE(Status__c) , &apos;Approved&apos;)</errorConditionFormula>
        <errorMessage>You cannot edit a record once Approved</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Billing_city</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK( Address__City__s )</errorConditionFormula>
        <errorDisplayField>Address__City__s</errorDisplayField>
        <errorMessage>Complete this Field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Billing_country_mandatary</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(Address__CountryCode__s, &apos;&apos;)
||
ISPICKVAL(Address__CountryCode__s, &apos;--None--&apos;)</errorConditionFormula>
        <errorDisplayField>Address__CountryCode__s</errorDisplayField>
        <errorMessage>Complete this Field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Billing_state_mandatary</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(  Address__Street__s  )</errorConditionFormula>
        <errorDisplayField>Address__Street__s</errorDisplayField>
        <errorMessage>Complete this field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPE_Field_Is_Mandatory</fullName>
        <active>false</active>
        <errorConditionFormula>ISPICKVAL(PRIORVALUE( Customer_Process_Engagement__c ) , &apos;&apos;)</errorConditionFormula>
        <errorMessage>Customer Process Engagement Is Mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_Core_Account_Primary_Coverage</fullName>
        <active>false</active>
        <description>Bi-Annual Temp Account Category cannot be blank when Account Primary Coverage is &apos;Intel-Led&apos;</description>
        <errorConditionFormula>AND(
(ISPICKVAL(Core_Account_Primary_Coverage__c, &quot;Intel-Led&quot;)), 
(ISBLANK(Core_Account_Category__c)))</errorConditionFormula>
        <errorDisplayField>Core_Account_Category__c</errorDisplayField>
        <errorMessage>Bi-Annual Temp Account Category cannot be blank when Account Primary Coverage is &apos;Intel-Led&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Digital_Identifier_website_validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISBLANK( Digital_Identifier_Value__c ), ISPICKVAL( Digital_Identifier_Type__c ,&apos;Website/URL&apos;))</errorConditionFormula>
        <errorDisplayField>Digital_Identifier_Value__c</errorDisplayField>
        <errorMessage>If a customer website cannot be found, you can enter N/A</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Language_Mandatory_If_LocalLang_Is_Chose</fullName>
        <active>false</active>
        <description>Language picklist is mandatory if Account Name Local Language is entered.</description>
        <errorConditionFormula>AND(
NOT(ISNULL(Core_Alternate_Language_Name__c)),
ISBLANK(TEXT(Local_Language__c))
)</errorConditionFormula>
        <errorDisplayField>Local_Language__c</errorDisplayField>
        <errorMessage>Language picklist is mandatory if Account Name Local Language is entered.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Postal_code_Alphanumeric_validation</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(REGEX(Address__PostalCode__s , &quot;^[a-zA-Z0-9- ]*$&quot;))</errorConditionFormula>
        <errorDisplayField>Address__PostalCode__s</errorDisplayField>
        <errorMessage>Postal code should be Alphanumeric.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>postal_code_should_be_alphanumeric</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(REGEX(  Address__PostalCode__s ,  &quot;^[a-zA-Z0-9- ]*$&quot;))</errorConditionFormula>
        <errorDisplayField>Address__PostalCode__s</errorDisplayField>
        <errorMessage>Postal code should be an integer</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
