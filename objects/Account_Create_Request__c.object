    <fields>
        <fullName>Customer_Aggregation_Type__c</fullName>
        <label>Customer Aggregation Type</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>UNFD_GLBL_CUST</fullName>
                    <default>false</default>
                    <label>Unified Global Customer</label>
                </value>
                <value>
                    <fullName>UNFD_INTRMD_CUST</fullName>
                    <default>false</default>
                    <label>Unified Intermediate Customer</label>
                </value>
                <value>
                    <fullName>UNFD_CTRY_CUST</fullName>
                    <default>false</default>
                    <label>Unified Country Customer</label>
                </value>
                <value>
                    <fullName>UNFD_LOC_CUST</fullName>
                    <default>false</default>
                    <label>Unified Location Customer</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Customer_Process_Engagement__c</fullName>
        <label>Customer Process Engagement</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>DIR_PRC_EXCPT</fullName>
                    <default>false</default>
                    <label>Direct Price Exception</label>
                </value>
                <value>
                    <fullName>DISTI_PRC_EXCPT</fullName>
                    <default>false</default>
                    <label>Distributor Price Exception</label>
                </value>
                <value>
                    <fullName>SLS_PPLN</fullName>
                    <default>false</default>
                    <label>Sales Pipeline</label>
                </value>
                <value>
                    <fullName>SD_REV</fullName>
                    <default>false</default>
                    <label>Supply Demand Revenue</label>
                </value>
