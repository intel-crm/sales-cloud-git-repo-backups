    <fields>
        <fullName>Core_Account_Level__c</fullName>
        <description>This field is used to to measure accounts to coverage ratio</description>
        <inlineHelpText>Segmentation of accounts for focus &amp; resourcing.
Level 1: High-level customer engagement &amp; dedicated Sales/Technical resources
Level 2: Transaction and discovery accounts with minimal required resources
Level 3: Program generated accounts (ODRs, DDRs, DRs)
No Level: Not Covered Accounts &amp; no Opportunities present</inlineHelpText>
        <label>Account Level</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Level1</fullName>
                    <default>false</default>
                    <label>Level 1</label>
                </value>
                <value>
                    <fullName>Level2</fullName>
                    <default>false</default>
                    <label>Level 2</label>
                </value>
                <value>
                    <fullName>Level3</fullName>
                    <default>false</default>
                    <label>Level 3</label>
                </value>
                <value>
                    <fullName>NoLevel</fullName>
                    <default>true</default>
                    <label>No Level</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
