    <fields>
        <fullName>CCDO_SLA__c</fullName>
        <description>Formula field, Shows timegap (In Hours) between DataOps Approval and Reltio Approval.</description>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Status__c, &quot;In Process&quot;) &amp;&amp; NOT ISBLANK(Dataops_Action_Time__c),
(FLOOR(((Now()-  CreatedDate)* 24)- Dataops_Action_Time__c )),

IF((ISPICKVAL(Status__c, &quot;Approved&quot;) || ISPICKVAL(Status__c, &quot;Rejected&quot;)) &amp;&amp; NOT ISBLANK(ccdo_Action_Time__c),
(FLOOR( ccdo_Action_Time__c)), null ))</formula>
        <label>UCD Measured SLA (Hours)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
