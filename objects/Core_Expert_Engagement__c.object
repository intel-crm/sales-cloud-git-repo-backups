        <displayFormat>EE-{0000000}</displayFormat>
        <label>Engagement ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Expert Engagements</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>Core_Engagement_Type_pick_Geo</fullName>
        <active>true</active>
        <description>If a user selects IoT Lab, Expert Engagement Region field should be required</description>
        <errorConditionFormula>ISPICKVAL(Core_Expert_Engagement_Type__c, &quot;IoT Lab&quot;) &amp;&amp;  ISBLANK(Text(Core_Expert_Engagement_Geo__c))</errorConditionFormula>
        <errorDisplayField>Core_Expert_Engagement_Geo__c</errorDisplayField>
        <errorMessage>Expert Engagement Region field is required for Engagement Type &quot;IoT Lab&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_ExpertEngagmentType_CQR</fullName>
        <active>true</active>
        <description>Expert Engagement Region field is required for Engagement Type &quot;CQ&amp;R&quot;</description>
        <errorConditionFormula>ISPICKVAL(Core_Expert_Engagement_Type__c, &quot;CQ&amp;R&quot;) &amp;&amp; ISBLANK(Text(Core_Expert_Engagement_Geo__c))</errorConditionFormula>
        <errorDisplayField>Core_Expert_Engagement_Geo__c</errorDisplayField>
        <errorMessage>Expert Engagement Region field is required for Engagement Type &quot;CQ&amp;R&quot;</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_New_IT_Intel_Engagement</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>IT@Intel Engagement - Use Sales Support</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>alert(&quot;For IT@Intel, please use the sales support tab or button below&quot;);</url>
    </webLinks>
</CustomObject>
