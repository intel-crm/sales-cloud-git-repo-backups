        <columns>Core_IPS_Target_System__c</columns>
        <columns>Core_IPS_Target_Field__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>FM-{0000000}</displayFormat>
        <label>Backend Field Mapping ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Backend Field Mappings</pluralLabel>
