    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object contains the list of fields which needs value mapping between IPS and target systems for picklist type of fields only or also used to define target default mandate field.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_IPS_Backend_System__c</fullName>
        <label>Backend System</label>
        <referenceTo>Core_IPS_Backend_System__c</referenceTo>
        <relationshipLabel>Field Mappings</relationshipLabel>
        <relationshipName>Backend_Field_Mappings</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_IPS_Bi_Directional__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Bi-Directional</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Deactivated__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Deactivated</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Field_Object_Name__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Please provide the object which the custom field is part of.</inlineHelpText>
        <label>Field Object Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Field_Technical_name__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Please provide the salesforce custom field name only when support update field is checked.</inlineHelpText>
        <label>Field Technical name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Source_Field__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Pleae provide XML node name not any other field name for eg : issue_title is the xml node name which stores the case subjectin the integration layer but not subject field name in salesforce. So provide &quot;issue_title&quot; as Source Field</inlineHelpText>
        <label>Source Field</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Source_System__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Core_IPS_Bi_Directional__c = false, &apos;IPS&apos;,  Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Source System</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Support_Update__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>Check this field,if this field update has to be sent to target system</inlineHelpText>
        <label>Support Update</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Target_Field__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Keep same as the source field if only value translation is required else provide the target name which the target system is expecting to send over in the xml.But field name translation is applicable only for few fields like environmental detail field</inlineHelpText>
        <label>Target Field</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Target_System__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Core_IPS_Bi_Directional__c = true,&apos;IPS&apos; , Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c)</formula>
        <label>Target System</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Unique_Identifier_Key__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>false</externalId>
        <label>Unique Identifier Key</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Update_Only__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Consider field mapping for case update only</description>
        <label>Update Only</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Backend Field Mapping</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_IPS_Backend_System__c</columns>
        <columns>Core_IPS_Bi_Directional__c</columns>
        <columns>Core_IPS_Deactivated__c</columns>
