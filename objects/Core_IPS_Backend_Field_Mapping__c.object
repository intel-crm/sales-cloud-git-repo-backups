    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_IPS_BK_SuppFldUpdate_Validate</fullName>
        <active>true</active>
        <description>This validation rule ensures the support field update flag is applicable for records which has source and target field maintained and also technical object and field names are maintained.</description>
        <errorConditionFormula>Core_IPS_Support_Update__c == true &amp;&amp; Core_IPS_Source_Field__c &lt;&gt; null &amp;&amp;(OR(Core_IPS_Field_Object_Name__c == null ,  Core_IPS_Field_Technical_name__c == null   ))</errorConditionFormula>
        <errorDisplayField>Core_IPS_Support_Update__c</errorDisplayField>
        <errorMessage>Support Update field requires the source field, target field, technical object and field name to be supplied.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
