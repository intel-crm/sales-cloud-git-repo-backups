    <fields>
        <fullName>Core_Account_Name__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity__r.Account.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Add_to_Opportunity_Team__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Adds the IT Region resource member to the opportunity</description>
        <inlineHelpText>Adds the IT Region resource member to the opportunity</inlineHelpText>
        <label>Add to Opportunity Team</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_DRD_Case_Owner__c</fullName>
        <description>The owner of the case in SSG DRD System that is working on the Support Request. This data comes back into SMG via Custom REST Service when it changes in SSG.</description>
        <externalId>false</externalId>
        <label>Case Owner</label>
        <length>150</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_DRD_Deadline_for_Results__c</fullName>
        <description>Deadline entered by the User that is sent to SSG DRD System. DRD System uses this info to disposition the Support Request.</description>
        <label>Deadline for Results</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_DRD_Description__c</fullName>
        <description>Description entered by the User that is sent to SSG DRD System. DRD System uses this info to disposition the Support Request.</description>
        <label>Description</label>
        <length>1000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>15</visibleLines>
    </fields>
    <fields>
        <fullName>Core_DRD_Request_Type__c</fullName>
        <description>Request Type selected by the User that is sent to SSG DRD System. DRD System uses this info to disposition the Support Request.</description>
        <label>Request Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Engineering Services</fullName>
                    <default>false</default>
                    <label>Engineering Services</label>
                </value>
                <value>
                    <fullName>Software Development Tools</fullName>
                    <default>false</default>
                    <label>Software Development Tools</label>
                </value>
                <value>
                    <fullName>Remote Access</fullName>
                    <default>false</default>
                    <label>Remote Access</label>
                </value>
                <value>
                    <fullName>Acknowledge Existing/Previous Support Engagement</fullName>
                    <default>false</default>
                    <label>Acknowledge Existing/Previous Support Engagement</label>
                </value>
                <value>
                    <fullName>Data Center &amp; Cloud SW Support</fullName>
                    <default>false</default>
                    <label>Data Center &amp; Cloud SW Support</label>
                </value>
                <value>
                    <fullName>Networking, Comms, Media SW Support</fullName>
                    <default>false</default>
                    <label>Networking, Comms, Media SW Support</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_DRD_Subject__c</fullName>
