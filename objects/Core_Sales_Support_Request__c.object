    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Check_IT_Intel_Opportunity_Team</fullName>
        <active>false</active>
        <description>Makes sure if IT @ Intel support is needed that the IT geo manager is explicitly selected.   If checked it works.  If not checked and error is thrown to the user</description>
        <errorConditionFormula>AND(Core_Add_to_Opportunity_Team__c  = false, RecordType.DeveloperName = &quot;Core_DS_IT_Intel&quot;)</errorConditionFormula>
        <errorDisplayField>Core_Add_to_Opportunity_Team__c</errorDisplayField>
        <errorMessage>You must select &quot;Add to Opportunity&quot; team for IT@Intel Support</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Closed_Request_can_not_be_reopened</fullName>
        <active>true</active>
        <description>You can not reopen a support request</description>
        <errorConditionFormula>AND ( $User.ProfileId =  $Label.Core_System_Admin,
     RecordType.Id =  $Label.Core_IT_Intel_Record_Type ,
     ISPICKVAL(PRIORVALUE(Status__c), &quot;Closed&quot;)
    )</errorConditionFormula>
        <errorDisplayField>Status__c</errorDisplayField>
        <errorMessage>You can not reopen a support request once it is closed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_IT_Intel_Opportunity_Team</fullName>
        <active>true</active>
        <description>Makes sure if IT @ Intel support is needed that the IT geo manager is explicitly selected.   If checked it works.  If not checked and error is thrown to the user</description>
        <errorConditionFormula>AND(Core_Add_to_Opportunity_Team__c  = false, RecordType.DeveloperName = &quot;Core_DS_IT_Intel&quot;)</errorConditionFormula>
        <errorDisplayField>Core_Add_to_Opportunity_Team__c</errorDisplayField>
        <errorMessage>You must select &quot;Add to Opportunity&quot; team for IT@Intel Support</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IT_Intel_Rate_Feedback</fullName>
        <active>true</active>
        <description>If the current user is closes the ticket, then have them give feedback.</description>
        <errorConditionFormula>AND(
      RecordType.DeveloperName =&quot;Core_DS_IT_Intel&quot;,   
      LEN(TEXT( Core_Rate_Enagement__c)) = 0,
      $Profile.Name &lt;&gt;&quot;IT @ Intel&quot;,
      OR (
            Core_Requestor__c = $User.Username  ,
            CreatedById = $User.Id,
            OwnerId = $User.Id
          ),
      OR (
          TEXT(Status__c) = &quot;Closed&quot;,
          TEXT(Status__c) = &quot;Cancelled&quot;
         )

   )</errorConditionFormula>
        <errorDisplayField>Core_Rate_Enagement__c</errorDisplayField>
        <errorMessage>Please provide a feedback by rating this engagement</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MAG_Approved</fullName>
        <active>true</active>
        <description>Checks is an Opportunity is MAG related and if the opportunity is approved</description>
        <errorConditionFormula>AND( 
   RecordType.DeveloperName = &apos;IT @ Intel&apos;,
   Core_MAG_End_Use__c = &apos;Yes&apos;, 
   Core_MAG_Compliance_Status__c &lt;&gt; &apos;Approved&apos;
   )</errorConditionFormula>
        <errorMessage>You can not add the support request until the MAG Questionnaire is approved.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MAG_Approved</fullName>
        <active>true</active>
        <description>Checks is an Opportunity is MAG related and if the opportunity is approved</description>
        <errorConditionFormula>AND( 
   RecordType.DeveloperName = &apos;IT @ Intel&apos;,
   Core_MAG_End_Use__c = &apos;Yes&apos;, 
   Core_MAG_Compliance_Status__c &lt;&gt; &apos;Approved&apos;
   )</errorConditionFormula>
        <errorMessage>You can not add the support request until the MAG Questionnaire is approved.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_DSR_Edit</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Edit</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>/a19/e?CF00Nq0000000i0Xm={!Opportunity.Name}
&amp;CF00Nq0000000i0XX={!Opportunity.Account}
&amp;retURL=%2F{!Opportunity.Id}&amp;
RecordType=012q00000000POC&amp;ent=01Iq00000000gHR</url>
    </webLinks>
    <webLinks>
        <fullName>Core_IT_Intel_Key_Contacts</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>IT@Intel Key Contacts</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>SFDCpopup(&apos;http://it.intel.com/itatintel/contacts.htm&apos;,1024,768);

function SFDCpopup (url,w,h){

  if (isIE()) { // bypass checks because ie can&apos;t make cross domain requests without relaxing security
    popupCenter(url, &apos;&apos;,w, h );
  }
  else {
    var http = new XMLHttpRequest();

    try
    {
      http.open(&apos;GET&apos;, &apos;https://cloudcrmtrng.amr.corp.intel.com&apos;, false);
      http.send();
      popupCenter(url, &apos;&apos;,w, h );
    }
    catch (error)
    {
      //alert(error);
      alert(&apos;An error has occured. Please make sure you are on the Intel network&apos;);
    }
  }
};

function isIE() {
  var ua = window.navigator.userAgent;
  var msie = ua.indexOf(&quot;MSIE &quot;);

  return (msie &gt; -1 || !!navigator.userAgent.match(/Trident.*rv\:11\./));
}

function popupCenter(url, title, w, h) {
  var left = (screen.width/2)-(w/2);
  var top = (screen.height/2)-(h/2);
  return window.open(url, title, &apos;toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=yes, resizable=no, copyhistory=no, width=&apos;+w+&apos;, height=&apos;+h+&apos;, top=&apos;+top+&apos;, left=&apos;+left);
};</url>
    </webLinks>
