        <fullName>Core_Opportunity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Sales Support Requests</relationshipLabel>
        <relationshipName>Sales_Support_Requests</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Rate_Enagement__c</fullName>
        <description>Rate the support of the engagement</description>
        <inlineHelpText>Rate the support of the engagement</inlineHelpText>
        <label>Rate Enagement</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1- Poor</fullName>
                    <default>false</default>
                    <label>1- Poor</label>
                </value>
                <value>
                    <fullName>2 - Fair</fullName>
                    <default>false</default>
                    <label>2 - Fair</label>
                </value>
                <value>
                    <fullName>3 - Good</fullName>
                    <default>false</default>
                    <label>3 - Good</label>
                </value>
                <value>
                    <fullName>4 - Very Good</fullName>
                    <default>false</default>
                    <label>4 - Very Good</label>
                </value>
                <value>
                    <fullName>5 - Excellent</fullName>
                    <default>false</default>
                    <label>5 - Excellent</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Requestor_Email__c</fullName>
        <externalId>false</externalId>
        <formula>Owner:User.Email</formula>
        <label>Requestor Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Requestor__c</fullName>
        <externalId>false</externalId>
        <formula>Owner:User.FirstName + &apos; &apos; +  Owner:User.LastName</formula>
