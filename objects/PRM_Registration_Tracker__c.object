    <fields>
        <fullName>PRM_Time_Difference__c</fullName>
        <externalId>false</externalId>
        <formula>IF (FLOOR((CreatedDate - PRM_Last_Milestone_DateTime__c )) &gt; 0, TEXT(FLOOR((CreatedDate - PRM_Last_Milestone_DateTime__c )) ) &amp; &quot; day(s) &quot;, &quot;&quot;) 
&amp; IF(FLOOR(MOD((CreatedDate - PRM_Last_Milestone_DateTime__c )* 24, 24 )) &gt; 0, TEXT(FLOOR(MOD((CreatedDate - PRM_Last_Milestone_DateTime__c )* 24, 24 ))) &amp; &quot; hour(s) &quot;,&quot;&quot;) 
&amp; TEXT(ROUND(MOD(ABS((CreatedDate - PRM_Last_Milestone_DateTime__c ))* 24 * 60, 60 ), 0)) &amp; &quot; min(s) &quot;
&amp; TEXT(ROUND(MOD(ABS((CreatedDate - PRM_Last_Milestone_DateTime__c) )* 24 * 60*60, 60 ), 0)) &amp; &quot; sec(s)&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Time Taken between Previous Milestone and current Milestone</inlineHelpText>
        <label>Time Taken</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
