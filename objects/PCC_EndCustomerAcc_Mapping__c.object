    <fields>
        <fullName>PCC_DesignUser__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field is created for using in screen flow to get the user details from Internal Users to fetch the new Approver and stamp the user on Design Registration Object. This field is not used in DR End Customer Account Mapping Object.This field has been created on this object because the DDR Internal Users PS , has the create Permission for this object , and to enable a user lookup in screen flow, the create permission on Source Object is requied, which  cannot be provided on DR Object. So this field acts as just a transactional field for showing user lookup field on screen.</description>
        <label>PCC_DesignUser</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>User.UserType</field>
                <operation>equals</operation>
                <value>Standard</value>
            </filterItems>
            <filterItems>
                <field>User.IsActive</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>notEqual</operation>
                <value>System Administrator</value>
            </filterItems>
            <filterItems>
                <field>User.Profile.Name</field>
                <operation>notContain</operation>
                <value>IT Admin</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>PCC_GetDesignUsers</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
