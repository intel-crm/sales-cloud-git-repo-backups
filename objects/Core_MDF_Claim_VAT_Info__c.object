    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Core_MDF_VAT_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Core_MDF_VAT_Layout</fullName>
        <fields>Name</fields>
        <fields>Core_MDF_VAT_Invoice_Number_Txt__c</fields>
        <fields>Core_MDF_VAT_Amt__c</fields>
        <fields>Core_MDF_Status_Txt__c</fields>
        <label>VAT Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Store the claims VAT Information</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Approved_File_Id__c</fullName>
        <description>To store the Id of the File that is selected as the approved file</description>
        <externalId>false</externalId>
        <label>Approved File Id</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Approved_File_Name_Txt__c</fullName>
        <description>To store the name of the file which is selected as the approved file</description>
        <externalId>false</externalId>
        <inlineHelpText>Name of the payment document approved for sending to GSPO.</inlineHelpText>
        <label>Approved Payment Document</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_ClaimSubRemNotificationSent_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This flag will be true after sending reminder notification to claim submitter on 3rd day to upload VAT documents.</description>
        <label>Claim Submitter Reminder Sent</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_ClaimSubmitterReminder_Dtm__c</fullName>
        <description>This field is used to send reminder notification to claim owner on 3rd day of VAT record creation/rejection of VAT record by payment admin, if VAT documents are not uploaded.</description>
        <label>Claim Submitter Reminder Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_Id__c</fullName>
        <inlineHelpText>Indicates the claim associated with the payment document</inlineHelpText>
        <label>Claim</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>Payment Documents</relationshipLabel>
        <relationshipName>Claim_VAT_Documents</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Document_Type_Txt__c</fullName>
        <description>For Positive claim  document type is VAT Invoice and Negative claim is Credit Memo.</description>
        <externalId>false</externalId>
        <formula>IF( Core_MDF_Claim_Id__r.Core_MDF_C_Type_Ind__c , $Label.Core_MDF_Credit_Memo, $Label.Core_MDF_VAT_Invoice)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Indicates the type of the payment document that needs to be uploaded by the customer.</inlineHelpText>
        <label>Document Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Last_VAT_ModifiedBy_Nm__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
ISPICKVAL(LastModifiedBy.Profile.UserType,&apos;PowerPartner&apos;),
LastModifiedBy.FirstName &amp; &apos; &apos; &amp; LastModifiedBy.LastName,
$Label.Core_MDF_Intel_System_User	
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Last Modified By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Payment_Admin_Reminder_Date_Dtm__c</fullName>
        <description>This field will be used to send reminder notification to payment admin in every 2 days to approve or reject the VAT record.</description>
        <label>Payment Admin Reminder Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Payment_Admin_Reminder_Sent_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This flag will be true after sending approval reminder notification to Payment Admin on every 2 days till they take action on VAT record.</description>
        <label>Payment Admin Reminder Sent</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_RSMRemNotificationSent_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This flag will be true after sending reminder notification to RSM on every 5th day till they take action on VAT record.</description>
        <label>RSM Reminder Sent</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_RSMReminderDate_Dtm__c</fullName>
        <description>This field is used to send reminder notification to RSM on 5th day of VAT record creation/rejection of VAT record by payment admin, if VAT documents are not uploaded.</description>
        <label>RSM Reminder Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Reimbursement_Amt__c</fullName>
        <description>Sum of Claim Reimbursement Amount and Offset Amount</description>
        <formula>Core_MDF_Claim_Id__r.Amount + Core_MDF_Claim_Id__r.Core_MDF_Total_Claim_Offsets__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Reimbursement amount without tax</inlineHelpText>
        <label>Reimbursement amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Status_Txt__c</fullName>
        <inlineHelpText>The status of the payment document</inlineHelpText>
        <label>Document Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending Documents</fullName>
                    <default>true</default>
                    <label>Pending Documents</label>
                </value>
                <value>
                    <fullName>Under Review</fullName>
                    <default>false</default>
                    <label>Under Review</label>
                </value>
                <value>
                    <fullName>Revision Required</fullName>
                    <default>false</default>
                    <label>Revision Required</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Denied</fullName>
                    <default>false</default>
                    <label>Denied</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_VAT_Amt__c</fullName>
        <description>Claim VAT Amount</description>
        <formula>Core_MDF_Claim_Id__r.Core_MDF_VAT_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The tax amount</inlineHelpText>
        <label>Tax Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_VAT_CreatedBy_Nm__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;), 
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName, 
$Label.Core_MDF_Intel_System_User)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_VAT_Invoice_Number_Txt__c</fullName>
        <description>Store the VAT Invoice number from the customer</description>
        <externalId>false</externalId>
        <inlineHelpText>The transaction/invoice number  related to the payment document</inlineHelpText>
        <label>Tax Invoice Number</label>
        <length>16</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_VAT_Per__c</fullName>
        <description>VAT percentage which we are inheriting from Bank object</description>
        <externalId>false</externalId>
        <formula>IF(Core_MDF_Claim_Id__r.Core_MDF_VAT_Eligibility_Ind__c,IF( AND( TEXT(Core_MDF_Claim_Id__r.Core_MDF_Applicable_VAT_Percentage_nm__c) != null,
 OR(TEXT(Core_MDF_Claim_Id__r.Core_MDF_Bank__r.Core_MDF_Intel_Company_Code__c) = &apos;650&apos;,
 TEXT(Core_MDF_Claim_Id__r.Core_MDF_Bank__r.Core_MDF_Intel_Company_Code__c) = &apos;420&apos;), 
 OR(Core_MDF_Claim_Id__r.Core_MDF_Program__c = &apos;Intel Partner Alliance&apos;, Core_MDF_Claim_Id__r.Core_MDF_Program__c = &apos;Retail Marketing Funds&apos;, Core_MDF_Claim_Id__r.Core_MDF_Program__c = &apos;Co-GTM&apos;) ) , 
TEXT(Core_MDF_Claim_Id__r.Core_MDF_Applicable_VAT_Percentage_nm__c),TEXT(Core_MDF_Claim_Id__r.Core_MDF_Bank__r.Core_MDF_VAT_pct__c)),&apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The tax percentage applied on the reimbursement amount</inlineHelpText>
        <label>Tax %</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Vat_Inv_Guide_Link__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(Core_MDF_Claim_Id__r.Core_MDF_Bank__r.Core_MDF_Intel_Company_Code__c , &apos;650&apos;, IF(ISPICKVAL($User.UserType,&apos;PowerPartner&apos;), 
HYPERLINK($Label.Core_MDF_PFRCommunityLink &amp; $Label.Core_MDF_FileURLInternal &amp; &apos;0153b000005OQbF&apos;, $Label.Core_MDF_Click_here), 
HYPERLINK($Label.Core_MDF_PFRDetailLink &amp; $Label.Core_MDF_FileURLInternal &amp; &apos;0153b000005OQbF&apos;, $Label.Core_MDF_Click_here)), 
&apos;420&apos;, IF(ISPICKVAL($User.UserType,&apos;PowerPartner&apos;), 
HYPERLINK($Label.Core_MDF_PFRCommunityLink &amp; $Label.Core_MDF_FileURLInternal &amp; &apos;0153b000005OQbG&apos;, $Label.Core_MDF_Click_here), 
HYPERLINK($Label.Core_MDF_PFRDetailLink &amp; $Label.Core_MDF_FileURLInternal &amp; &apos;0153b000005OQbG&apos;, $Label.Core_MDF_Click_here)), null)</formula>
        <label>Payment Document Guidelines</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Payment Document</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_VAT_Amt__c</columns>
        <columns>Core_MDF_VAT_Invoice_Number_Txt__c</columns>
        <columns>Core_MDF_Status_Txt__c</columns>
        <columns>Core_MDF_Claim_Id__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>{000000}</displayFormat>
        <label>Document ID</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Payment Documents</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Core_MDF_Payment_Document</fullName>
        <active>true</active>
        <description>Payment Document Record Type</description>
        <label>Payment Document</label>
        <picklistValues>
            <picklist>Core_MDF_Status_Txt__c</picklist>
            <values>
                <fullName>Approved</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Cancelled</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Denied</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Documents</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Revision Required</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Under Review</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <recordTypes>
        <fullName>Core_MDF_Submit_for_Approval</fullName>
        <active>true</active>
        <description>Submit for Approval Record Type</description>
        <label>Submit for Approval</label>
        <picklistValues>
            <picklist>Core_MDF_Status_Txt__c</picklist>
            <values>
                <fullName>Approved</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Cancelled</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Denied</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Documents</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Revision Required</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Under Review</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts>
        <searchResultsAdditionalFields>Core_MDF_Claim_Id__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_VAT_Amt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Status_Txt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CREATEDBY_USER</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CREATED_DATE</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_MDF_PreventInvNoEditAfterApproval</fullName>
        <active>true</active>
        <description>To Prevent the Payment Admin from editing the Vat Invoice Number after the Vat is Approved</description>
        <errorConditionFormula>AND(ISCHANGED(Core_MDF_VAT_Invoice_Number_Txt__c),
OR(ISPICKVAL(Core_MDF_Status_Txt__c, &apos;Approved&apos;),
ISPICKVAL(Core_MDF_Status_Txt__c, &apos;Cancelled&apos;),
ISPICKVAL(Core_MDF_Status_Txt__c, &apos;Denied&apos;)))</errorConditionFormula>
        <errorMessage>The Tax Invoice Number cannot be edited in its current status</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
