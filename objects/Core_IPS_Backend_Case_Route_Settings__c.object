<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>This object stores the IPS Backend Case Routing settings need to defined for a profile and used in Formula editor</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Core_IPS_Help_Link__c</fullName>
        <label>IPS Help Link</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Object_Link__c</fullName>
        <description>This link refers to salesforce server link</description>
        <externalId>false</externalId>
        <label>Object Link</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Support_Email__c</fullName>
        <externalId>false</externalId>
        <label>Support Email</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_User_Name__c</fullName>
        <externalId>false</externalId>
        <label>User Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>IPS_Backend_Case_Route_Settings</label>
    <visibility>Public</visibility>
</CustomObject>
