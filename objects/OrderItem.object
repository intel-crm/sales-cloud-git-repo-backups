    <validationRules>
        <fullName>Contact_mandatory_on_orderproduct</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Order.Sales_status__c,&apos;SAP Order Creation Failed&apos;),
ISPICKVAL(Product2.Core_Product_Ext_Attribute_Id__r.Core_Prod_Tool_Type_Nm__c , &apos;Corporate&apos;)
,ISCHANGED( Sales_Contact__c ))</errorConditionFormula>
        <errorMessage>Contact is mandatory for corporate OPN.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Intel_product_for_ARM_license_Order</fullName>
        <active>false</active>
        <description>prevent addition of Intel product for ARM license Order</description>
        <errorConditionFormula>IF(  
	ISPICKVAL(Order.Sales_Order_Sub_Type__c, &quot;ARM standalone license order&quot;),
	IF( ISPICKVAL( Product2.Core_Product_Ext_Attribute_Id__r.Core_Prod_Tool_Type_Nm__c 	, &quot;Software&quot;) ||
	ISPICKVAL( Product2.Core_Product_Ext_Attribute_Id__r.Core_Prod_Tool_Type_Nm__c , &quot;IP&quot;) || (  Product2.Core_Item_Class_Nm__c == &quot;BD&quot;) 
	,TRUE,FALSE),
	FALSE
)</errorConditionFormula>
        <errorMessage>Cannot add intel product, for ARM License Order Type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Quote_Line_with_Product</fullName>
        <active>true</active>
        <errorConditionFormula>if(!ISBLANK( Product2Id ) &amp;&amp; !ISBLANK(Order.SBQQ__Quote__c) &amp;&amp; ISBLANK(SBQQ__QuoteLine__c), TRUE,FALSE)</errorConditionFormula>
        <errorMessage>Please use edit Order Product button to create Products from Quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__CannotChangeBookingIndicatorOnActivation</fullName>
        <active>true</active>
        <description>Can’t edit the bookings status on an activated order product.</description>
        <errorConditionFormula>AND(SBQQ__Activated__c, ISCHANGED(SBQQ__BookingsIndicator__c))</errorConditionFormula>
        <errorDisplayField>SBQQ__BookingsIndicator__c</errorDisplayField>
        <errorMessage>Can’t edit the bookings status on an activated order product.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__RecurringChargeTypeMustHaveBillingType</fullName>
        <active>true</active>
        <description>When Charge Type is Recurring, a Billing Type must be selected.</description>
        <errorConditionFormula>AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;Recurring&apos;), ISPICKVAL(SBQQ__BillingType__c, &apos;&apos;))</errorConditionFormula>
        <errorDisplayField>SBQQ__BillingType__c</errorDisplayField>
        <errorMessage>When Charge Type is Recurring, a Billing Type must be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Validate_billing_frequency</fullName>
        <active>true</active>
        <description>When Charge Type is &apos;One-Time&apos;, a Billing Frequency value cannot be selected.</description>
        <errorConditionFormula>AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;One-Time&apos;), NOT(ISPICKVAL(SBQQ__BillingFrequency__c, &apos;&apos;)))</errorConditionFormula>
        <errorDisplayField>SBQQ__BillingFrequency__c</errorDisplayField>
        <errorMessage>When Charge Type is &apos;One-Time&apos;, a Billing Frequency value cannot be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Validate_billing_type</fullName>
        <active>true</active>
        <description>When Charge Type is One-Time or Usage, a Billing Type cannot be selected.</description>
        <errorConditionFormula>OR(
            AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;One-Time&apos;), NOT(ISPICKVAL(SBQQ__BillingType__c, &quot;&quot;))),
            AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;Usage&apos;), NOT(ISPICKVAL(SBQQ__BillingType__c, &quot;&quot;))))</errorConditionFormula>
        <errorDisplayField>SBQQ__BillingType__c</errorDisplayField>
        <errorMessage>When Charge Type is One-Time or Usage, a Billing Type value cannot be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Adding_a_Product_to_Order</fullName>
        <active>true</active>
        <errorConditionFormula>IF( $Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, false,
AND(OR(ISBLANK( Product2.Core_Product_Ext_Attribute_Id__c ) ,
(Product2.Core_Product_Ext_Attribute_Id__r.Core_SW_Prod_Avail_To_TL_ORD_ENBLMT_Ind__c = false),
(Product2.Core_Item_Orderable_Ind__c = false)
),
 NOT(ISPICKVAL( Order.Status  , &apos;Activated&apos;))
)
)</errorConditionFormula>
        <errorMessage>This Product is not Orderable or Available for TOE.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_CantEditOP_CancelActiveResubmitSAP</fullName>
        <active>true</active>
        <description>Cannot Edit Order Products on Orders that are Cancelled, in SAP Resubmission in Progress or Activated.</description>
        <errorConditionFormula>AND(
OR(ISPICKVAL(Order.Sales_status__c , &apos;Order Cancelled&apos;), ISPICKVAL(Order.Sales_status__c , &apos;SAP Resubmission In Progress&apos;), ISPICKVAL( Order.Status , &apos;Activated&apos;)),
OR(
ISCHANGED( Quantity ),
ISCHANGED( Sales_Contact__c ),
ISCHANGED( Description ),
ISCHANGED( Sales_Customer_frght_collect_account__c )
)
)</errorConditionFormula>
        <errorMessage>Cannot Edit Order Products on Orders that are Cancelled, in SAP Resubmission in Progress or Activated.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Contact_Mandatory</fullName>
        <active>true</active>
        <description>Contact is Mandatory for Non Corporate and Non Stocking Order</description>
        <errorConditionFormula>IF( $Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(OR(NOT(ISPICKVAL(Order.Sales_status__c ,&apos;Order Cancelled&apos;)), NOT(ISPICKVAL(Order.Sales_status__c ,&apos;Order Cancelled by SAP&apos;))),

ISBLANK(SBQQ__QuoteLine__c),
ISBLANK(Sales_Cancelled_Quoteline_No__c),
!ISPICKVAL(Product2.Core_Product_Ext_Attribute_Id__r.Core_Prod_Tool_Type_Nm__c , &apos;Corporate&apos;),
ISPICKVAL(Order.Sales_Order_Reason__c ,&quot;Non Stocking Order&quot;),
ISBLANK(Sales_Contact__c),  !(ISPICKVAL( Order.Status , &apos;Activated&apos;))   ))</errorConditionFormula>
        <errorMessage>Contact is Mandatory for Non Corporate and Non Stocking Order</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_validateQuantity</fullName>
        <active>true</active>
        <description>Validate if the Quantity is  equal to zero.</description>
        <errorConditionFormula>Quantity = 0</errorConditionFormula>
        <errorMessage>Quantity can&apos;t be zero.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Clone</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
