    <sharingModel>Read</sharingModel>
    <validationRules>
        <fullName>Core_IPS_Core_Ques_Cant_Revert_to_Active</fullName>
        <active>true</active>
        <description>Once Environmental Details Question status has been set to Inactive, it cannot be reset to Active.</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = &quot;EDQ&quot;,  TEXT(  Core_IPS_Status__c ) = &quot;ACTIVE&quot;,
TEXT (PRIORVALUE ( Core_IPS_Status__c )) = &quot;INACTIVE&quot;)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Status__c</errorDisplayField>
        <errorMessage>Once set to Inactive, the Status cannot be reset to Active. This is to prevent inconsistencies in Case usage of the Environment Detail Question.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Remove_text_From_Reporting_Name</fullName>
        <active>false</active>
        <description>If Add to Reporting checkbox is unchecked and Reporting Name field has some value then validation rule will fire and display the error message.</description>
        <errorConditionFormula>AND(Core_IPS_Add_to_Reporting__c == false,  NOT(ISBLANK(Core_IPS_Reporting_Name__c)))</errorConditionFormula>
        <errorDisplayField>Core_IPS_Reporting_Name__c</errorDisplayField>
        <errorMessage>Please remove the value from Reporting Name Field or check Add to Reporting check box.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Reporting_Field_mandatory</fullName>
        <active>false</active>
        <description>If Add to Reporting checkbox is checked and Reporting Name field is blank then validation rule will fire and display the error message.</description>
        <errorConditionFormula>AND(Core_IPS_Add_to_Reporting__c == true,ISBLANK(Core_IPS_Reporting_Name__c))</errorConditionFormula>
        <errorMessage>Please Enter the Reporting Name Field value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Validate_Data_Type_Change</fullName>
        <active>true</active>
        <description>Once an Environment Detail Question record is created, the Datatype cannot be changed to prevent impact to Case display.</description>
        <errorConditionFormula>Core_IPS_Answer_Count__c &gt; 1 &amp;&amp; ISCHANGED(Core_IPS_Datatype__c) &amp;&amp;
ISPICKVAL(Core_IPS_Datatype__c , &apos;Text&apos;)</errorConditionFormula>
        <errorMessage>Environment Detail Questions that are Text can only have 1 Answer defined.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Validate_Parent_Question</fullName>
        <active>true</active>
        <description>Parent Question can only be selected for Environment Detail Question record type</description>
        <errorConditionFormula>RecordType.DeveloperName != &apos;EDQ&apos; &amp;&amp;
 Core_IPS_Parent_Question__c != null</errorConditionFormula>
        <errorMessage>Parent Question can only be selected for Environment Detail Question record type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Validate_Support_Org</fullName>
        <active>true</active>
        <description>If Environmental Detail Question record type is not Environment Detail Question and Support Org is selected then deisplay error</description>
        <errorConditionFormula>RecordType.DeveloperName != &apos;EDQ&apos; &amp;&amp; 
Core_IPS_Product_Organization__c!=null</errorConditionFormula>
        <errorMessage>Product Organization can only be selected for Environment Detail Question record type</errorMessage>
    </validationRules>
