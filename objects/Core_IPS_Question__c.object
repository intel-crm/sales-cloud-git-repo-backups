                    <label>Text Area (5000)</label>
                </value>
                <value>
                    <fullName>Select Radio</fullName>
                    <default>false</default>
                    <label>Select Radio</label>
                </value>
                <value>
                    <fullName>Multiselect Picklist</fullName>
                    <default>false</default>
                    <label>Multiselect Picklist</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
