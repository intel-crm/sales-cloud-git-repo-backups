    <fields>
        <fullName>Core_IPS_Parent_Question__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Select if this question is dependent on parent question</description>
        <inlineHelpText>Select if this question is dependent on parent question</inlineHelpText>
        <label>Parent Question</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Only Picklist EDQ Questions can be selected as Parent Question</errorMessage>
            <filterItems>
                <field>Core_IPS_Question__c.Core_IPS_Datatype__c</field>
                <operation>equals</operation>
                <value>Picklist</value>
            </filterItems>
            <filterItems>
                <field>Core_IPS_Question__c.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>EDQ</value>
            </filterItems>
            <filterItems>
                <field>Core_IPS_Question__c.Core_IPS_Product_Organization__c</field>
                <operation>equals</operation>
                <valueField>$Source.Core_IPS_Product_Organization__c</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Core_IPS_Question__c</referenceTo>
        <relationshipLabel>Child Environment Detail Questions</relationshipLabel>
        <relationshipName>Core_IPS_Questions</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
