    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>LID__cannot_edit_Priority_on_Linkedin_Tasks</fullName>
        <active>false</active>
        <description>Validation Rule not in use</description>
        <errorConditionFormula>false</errorConditionFormula>
        <errorDisplayField>Priority</errorDisplayField>
        <errorMessage>You cannot edit the Priority field on LInkedin Tasks</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LID__cannot_edit_assigned_on_Linkedin_Tasks</fullName>
        <active>true</active>
        <errorConditionFormula>OR(RecordType.Name = &quot;inMail&quot;, RecordType.Name = &quot;Messages&quot;, RecordType.Name = &quot;PointDrive Presentation Created&quot;, RecordType.Name = &quot;PointDrive Presentation Viewed&quot;, RecordType.Name = &quot;LinkedIn_Call&quot;)
&amp;&amp; (ISCHANGED( OwnerId ))</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>You cannot edit the Assigned To field on LinkedIn Tasks</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LID__cannot_edit_status_on_Linkedin_Tasks</fullName>
        <active>false</active>
        <errorConditionFormula>OR(RecordType.Name = &quot;inMail&quot;, RecordType.Name = &quot;Messages&quot;, RecordType.Name = &quot;PointDrive Presentation Created&quot;, RecordType.Name = &quot;PointDrive Presentation Viewed&quot;, RecordType.Name = &quot;LinkedIn_Call&quot;)
&amp;&amp; (ISCHANGED( Status ))</errorConditionFormula>
        <errorDisplayField>OwnerId</errorDisplayField>
        <errorMessage>You cannot edit the Assigned To field on LinkedIn Tasks</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Task_Subtype_Update</fullName>
        <active>true</active>
        <description>Prevent &quot;Core_Task_Type__c&quot; update for all records other than the one with TaskSubtype as “Task”</description>
        <errorConditionFormula>AND(
      ISCHANGED(Core_Task_Type__c),
      NOT(OR(Core_Type_of_Activity__c = &quot;Task&quot;,  Core_Type_of_Activity__c = &quot;Email&quot;))
   )</errorConditionFormula>
        <errorMessage>Invalid Task Subtype for the &quot;Type of activity&quot;</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Core_Call_Script</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Call Script</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>window.open(&apos;/flow/{!Task.Core_Call_Script_API_Name__c}?campaignId={!Task.What}&amp;contactId={!Task.Who}&amp;callScriptId={!Task.Core_Call_Script_ID__c}&apos;, &apos;_blank&apos;);</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Create_Campaign_Task</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Create Campaign Task</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/00T/e?what_id={!Campaign.Id}
&amp;retURL=%2F{!Campaign.Id}
&amp;RecordType= 012o0000000Tr9MAAS
&amp;ent=Task</url>
    </webLinks>
    <webLinks>
        <fullName>Log_Expert_Engagement</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Log Expert Engagement</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!Event.CreatedDate}</url>
    </webLinks>
</CustomObject>
