    <fields>
        <fullName>Core_MDF_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Reference to Comarketing Accounts</description>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Co_Marketing</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Comarketing CMF Map</relationshipLabel>
        <relationshipName>Comarketing_CMF_Map</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
