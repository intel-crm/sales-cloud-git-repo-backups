<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Custom metadata to control trigger code execution, per piece of functionality</description>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Switch to control the execution of the trigger</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Class_Name__c</fullName>
        <description>Name of the class that handles the logic for the trigger</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Class Name</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Description of the functionality in the trigger code</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Description</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Inactive_for_Profile__c</fullName>
        <description>If there is a profile ID specified here, the trigger code will not execute for anyone with that profile</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>If there is a profile ID specified here, the trigger code will not execute for anyone with that profile</inlineHelpText>
        <label>Inactive for Profile</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Inactive_for_User__c</fullName>
        <description>If there is a user ID specified here, the trigger code will not execute for that user</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>If there is a user ID specified here, the trigger code will not execute for that user</inlineHelpText>
        <label>Inactive for User</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Object__c</fullName>
        <description>API name of the object being controlled by the trigger</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Object</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Trigger_Events__c</fullName>
        <description>Events that trigger transaction logic for this functionality (e.g. after insert, before update)</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Trigger Events</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Trigger Execution</label>
    <listViews>
        <fullName>All_Trigger_Execution_Entries</fullName>
        <columns>MasterLabel</columns>
        <columns>DeveloperName</columns>
        <columns>Active__c</columns>
        <columns>Inactive_for_User__c</columns>
        <columns>Object__c</columns>
        <columns>Class_Name__c</columns>
        <columns>Trigger_Events__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Trigger Execution Entries</label>
    </listViews>
    <listViews>
        <fullName>Biswa</fullName>
        <columns>MasterLabel</columns>
        <columns>DeveloperName</columns>
        <columns>NamespacePrefix</columns>
        <columns>Active__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>MasterLabel</field>
            <operation>contains</operation>
            <value>Core_Commission_NO_KPI_OTM_Changes</value>
        </filters>
        <label>Biswa</label>
        <language>en_US</language>
        <sharedTo>
            <group>IQR_Tech_Team</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>License_Triggers</fullName>
        <columns>MasterLabel</columns>
        <columns>DeveloperName</columns>
        <columns>NamespacePrefix</columns>
        <columns>Active__c</columns>
        <columns>Inactive_for_User__c</columns>
        <columns>Object__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Object__c</field>
            <operation>equals</operation>
            <value>License,Sales_License__c</value>
        </filters>
        <label>License Triggers</label>
        <language>en_US</language>
    </listViews>
    <listViews>
        <fullName>Order_and_Order_Products</fullName>
        <columns>MasterLabel</columns>
        <columns>Object__c</columns>
        <columns>DeveloperName</columns>
        <columns>Active__c</columns>
        <columns>NamespacePrefix</columns>
        <columns>Inactive_for_User__c</columns>
        <columns>Inactive_for_Profile__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Object__c</field>
            <operation>equals</operation>
            <value>Order,OrderItem,OrderProduct</value>
        </filters>
        <label>Order and Order Products</label>
        <language>en_US</language>
    </listViews>
    <pluralLabel>Trigger Executions</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
