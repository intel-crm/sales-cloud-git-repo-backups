<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Metadata to store URL and their filters and configuration</description>
    <fields>
        <fullName>Dynamic_filter__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If the URL needs dynamic filter</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Dynamic filter</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Filter__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If the URL needs a filter</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Filter?</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Filter_and_Value__c</fullName>
        <description>Field to store dynamic filter and the corresponding field name for the filter</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Filter and Value</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>No_Access_Error__c</fullName>
        <description>Error that needs to be displayed if no access</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>No Access Error</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Object__c</fullName>
        <description>Store the object from where the filter fields need to be retrieved</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Object</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <description>Stores the project name of the URL</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Project</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Security_Query__c</fullName>
        <description>The condition that needs to be check. Output can be True/False</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Security Query</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Security_enforced__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Check box if additional security check is required to view PowerBI report</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Security enforced</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Static_Filter__c</fullName>
        <description>Static filter value</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Static Filter</label>
        <length>1000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>URL__c</fullName>
        <description>Field to store URL</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Field to store URL</inlineHelpText>
        <label>URL</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>PBI Embed Configuration</label>
    <listViews>
        <fullName>All_Configurations</fullName>
        <columns>MasterLabel</columns>
        <columns>NamespacePrefix</columns>
        <columns>DeveloperName</columns>
        <columns>Project__c</columns>
        <columns>URL__c</columns>
        <columns>Dynamic_filter__c</columns>
        <columns>Object__c</columns>
        <columns>Filter_and_Value__c</columns>
        <columns>Filter__c</columns>
        <columns>Static_Filter__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Configurations</label>
        <language>en_US</language>
    </listViews>
    <pluralLabel>PBI Embed Configurations</pluralLabel>
    <validationRules>
        <fullName>Dynamic_Filter_Validation</fullName>
        <active>true</active>
        <description>Fill &apos;Filter and Value&apos; and &apos;Object&apos; field for Dynamic filter to work.</description>
        <errorConditionFormula>if(Dynamic_filter__c &amp;&amp;  
(ISBLANK(Filter_and_Value__c)||ISBLANK(Object__c)),
true,false)</errorConditionFormula>
        <errorMessage>Fill &apos;Filter and Value&apos; and &apos;Object&apos; field for Dynamic filter to work.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Security_Validation</fullName>
        <active>true</active>
        <description>Fill &apos;Security Query&apos; &amp; &apos;No Access Error&apos; fields for Security to be enforced.</description>
        <errorConditionFormula>if(Security_enforced__c &amp;&amp; (ISBLANK(Security_Query__c)|| ISBLANK(No_Access_Error__c)),true,false)</errorConditionFormula>
        <errorMessage>Fill &apos;Security Query&apos; field for Security to be enforced.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Static_Filter_Validation</fullName>
        <active>true</active>
        <description>Fill &apos;Static Filter&apos; field for Static filter to work.</description>
        <errorConditionFormula>if(Filter__c &amp;&amp; ISBLANK(Static_Filter__c),true,false)</errorConditionFormula>
        <errorMessage>Fill &apos;Static Filter&apos; field for Static filter to work.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
