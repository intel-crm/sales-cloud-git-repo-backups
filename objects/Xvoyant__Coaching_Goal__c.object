    <fields>
        <fullName>Xvoyant__Goal_Status__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF ( AND( Xvoyant__Actual_Value__c = 0,  Xvoyant__Goal_Value__c !=0), &quot;Actual Value Not Set&quot;,
IF ( Xvoyant__Actual_Value__c - Xvoyant__Goal_Value__c &gt;=0, &quot;Goal Met&quot;,
&quot;Goal Not Met&quot;
)
)</formula>
