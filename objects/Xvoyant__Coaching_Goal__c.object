    <searchLayouts>
        <customTabListAdditionalFields>Xvoyant__Goal_Value__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Xvoyant__Actual_Value__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Xvoyant__Willingness_To_Change__c</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>Xvoyant__Goal_Value__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Xvoyant__Actual_Value__c</lookupDialogsAdditionalFields>
        <searchResultsAdditionalFields>Xvoyant__Goal_Value__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Xvoyant__Actual_Value__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Xvoyant__Coaching_Focus_Other</fullName>
        <active>true</active>
        <description>Makes the Coaching Focus Other field required when &quot;Other&quot; is selected as Coaching Focus</description>
        <errorConditionFormula>And(
ISBLANK( Xvoyant__Coaching_Focus_Other__c ),
ISPICKVAL( Xvoyant__Coaching_Focus__c, &quot;Other&quot;)
)</errorConditionFormula>
        <errorDisplayField>Xvoyant__Coaching_Focus_Other__c</errorDisplayField>
        <errorMessage>This is a required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Xvoyant__Follow_Up_Date_in_Future</fullName>
        <active>true</active>
        <description>Requires the Follow Up Date to be in the future</description>
        <errorConditionFormula>AND( ISNEW(),
 Xvoyant__Follow_Up_DateTime__c &lt;= now()
)</errorConditionFormula>
        <errorDisplayField>Xvoyant__Follow_Up_DateTime__c</errorDisplayField>
        <errorMessage>A future date needs to be selected</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Xvoyant__Valid_Goal_Month</fullName>
        <active>true</active>
        <errorConditionFormula>Xvoyant__Goal_Month__c &lt; 0 || Xvoyant__Goal_Month__c &gt; 11</errorConditionFormula>
        <errorMessage>Month must be between 0 and 11.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
