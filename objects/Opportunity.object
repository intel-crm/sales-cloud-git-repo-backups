        <fullName>Core_Quantity_count__c</fullName>
        <label>Quantity count</label>
        <summarizedField>OpportunityLineItem.Quantity</summarizedField>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Status__c</field>
            <operation>notEqual</operation>
            <value>Lost, Cancelled, Production Win, Production Lost, Production Cancelled, Delete In Progress (&lt;15 min)</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Status__c</field>
            <operation>notEqual</operation>
            <value>Win Approved, Win Submitted</value>
        </summaryFilterItems>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
