    <fields>
        <fullName>Core_Project_Size__c</fullName>
        <description>Indicates the estimated US dollar size of the opportunity. This field will default from a converted lead if applicable and is not editable</description>
        <inlineHelpText>Indicates the estimated US dollar size of the opportunity. This field will default from a converted lead if applicable and is not editable.</inlineHelpText>
        <label>Project Size</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>&gt;$10,000,000</fullName>
                    <default>false</default>
                    <label>&gt;$10,000,000</label>
                </value>
                <value>
                    <fullName>$10,000,000 - $5,000,000</fullName>
                    <default>false</default>
                    <label>$10,000,000 - $5,000,000</label>
                </value>
                <value>
                    <fullName>$5,000,000 - $1,000,000</fullName>
                    <default>false</default>
                    <label>$5,000,000 - $1,000,000</label>
                </value>
                <value>
                    <fullName>&lt;$1,000,000</fullName>
                    <default>false</default>
                    <label>&lt;$1,000,000</label>
                </value>
                <value>
                    <fullName>&lt;$100,000</fullName>
                    <default>false</default>
                    <label>&lt;$100,000</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
