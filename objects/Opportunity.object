        <fullName>Core_OSC_Collaboration_Type__c</fullName>
        <description>If Opportunity Owner, Technical Owner, and All Team Members have &quot;Is OSC? = true&quot;, then OSC Solo
• If Opportunity Owner has &quot;Is OSC? = true&quot;, and Technical Owner or Any Team Member has &quot;Is OSC? = false&quot;, then OSC with Field Assistance
•  If Opportunity Owner has &quot;Is OSC? = false&quot;, and Technical Owner or Any Team Member has &quot;Is OSC? = true&quot;, then OSC Assisting the Field
•  Else &quot;No OSC Involvement&quot;</description>
        <externalId>false</externalId>
        <label>OSC Collaboration Type</label>
        <length>80</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Open_Oppty__c</fullName>
        <description>This is a flag that will be used at reporting side to create calculations.
The value of this field is 1 when Opportunity Stage is either &quot;Qualify&quot;, &quot;Define&quot;, &quot;Develop&quot; or &quot;Design&quot;; otherwise it will be 0.</description>
        <externalId>false</externalId>
        <formula>IF(  OR(TEXT( StageName )  = &quot;Qualify&quot;, TEXT( StageName )  = &quot;Define&quot;, TEXT( StageName )  = &quot;Develop&quot;,TEXT( StageName )  = &quot;Design&quot; ), 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Open Oppty</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Open_Products_Count__c</fullName>
        <label>Open Products Count</label>
        <summarizedField>OpportunityLineItem.Quantity</summarizedField>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Status__c</field>
            <operation>equals</operation>
            <value>Pending, On Hold</value>
        </summaryFilterItems>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_Operating_System__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_Operating_System__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Operating System</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_Prime_Account_Name__c</fullName>
        <description>Holds the Prime Account Name of the Account associated with the Opportunity - Used for List Views &amp; Global Search for Opportunities (US90489)</description>
        <externalId>false</externalId>
        <label>Prime Account Name</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_Strategic_Opportunity__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Strategic Opportunity flag to opportunities, so that I can flag the opportunities that meet my BU&apos;s strategic criteria</description>
        <label>Strategic Opportunity</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Activity_Measure__c</fullName>
        <description>Whether an Opportunity has experienced activity within the last 30 days</description>
        <externalId>false</externalId>
        <formula>IF((TODAY() - Core_Last_Activity_Date__c ) &lt;= 30, &quot;Activity Within Last 30 Days&quot;, &quot;No Activity Within Last 30 Days&quot;)</formula>
        <inlineHelpText>Whether an Opportunity has experienced activity within the last 30 days</inlineHelpText>
        <label>Opportunity Activity Measure</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Count__c</fullName>
        <externalId>false</externalId>
        <formula>1</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
