    <fields>
        <fullName>Core_Public_Group_Visibility__c</fullName>
        <description>Hidden field that supports Wave row-level security based on public groups &amp; sharing rules. Generates a comma-separated list of public groups that have visibility to the current record.</description>
        <externalId>false</externalId>
        <formula>&apos;Core_Oppty_AllSalesGroups_WW_Read,Core_Oppty_AllSalesGroups_WW_Write&apos; 
&amp; 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Global Accounts&apos;), &apos;,Core_Oppty_GlobalAccounts_WW_Read,Core_Oppty_GlobalAccounts_WW_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Industry Sales&apos;), &apos;,Core_Oppty_IndustrySales_WW_Read,Core_Oppty_IndustrySales_WW_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Regional Sales&apos;), &apos;,Core_Oppty_RegionalSales_WW_Read,Core_Oppty_RegionalSales_WW_Write&apos;, &apos;&apos;)))
&amp; 
IF(Core_Opportunity_Geo_APJ__c = True, &apos;,Core_Oppty_AllSalesGroups_APJ_Read,Core_Oppty_AllSalesGroups_APJ_Write&apos; &amp; 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Global Accounts&apos;), &apos;,Core_Oppty_GlobalAccounts_APJ_Read,Core_Oppty_GlobalAccounts_APJ_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Industry Sales&apos;), &apos;,Core_Oppty_IndustrySales_APJ_Read,Core_Oppty_IndustrySales_APJ_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Regional Sales&apos;), &apos;,Core_Oppty_RegionalSales_APJ_Read,Core_Oppty_RegionalSales_APJ_Write&apos;, &apos;&apos;))), &apos;&apos;) 
&amp; 
IF(Core_Opportunity_Geo_ASMO__c = True, &apos;,Core_Oppty_AllSalesGroups_ASMO_Read,Core_Oppty_AllSalesGroups_ASMO_Write&apos; &amp; 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Global Accounts&apos;), &apos;,Core_Oppty_GlobalAccounts_ASMO_Read,Core_Oppty_GlobalAccounts_ASMO_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Industry Sales&apos;), &apos;,Core_Oppty_IndustrySales_ASMO_Read,Core_Oppty_IndustrySales_ASMO_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Regional Sales&apos;), &apos;,Core_Oppty_RegionalSales_ASMO_Read,Core_Oppty_RegionalSales_ASMO_Write&apos;, &apos;&apos;))), &apos;&apos;) 
&amp; 
IF(Core_Opportunity_Geo_EMEA__c = True, &apos;,Core_Oppty_AllSalesGroups_EMEA_Read,Core_Oppty_AllSalesGroups_EMEA_Write&apos; &amp; 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Global Accounts&apos;), &apos;,Core_Oppty_GlobalAccounts_EMEA_Read,Core_Oppty_GlobalAccounts_EMEA_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Industry Sales&apos;), &apos;,Core_Oppty_IndustrySales_EMEA_Read,Core_Oppty_IndustrySales_EMEA_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Regional Sales&apos;), &apos;,Core_Oppty_RegionalSales_EMEA_Read,Core_Oppty_RegionalSales_EMEA_Write&apos;, &apos;&apos;))), &apos;&apos;) 
&amp; 
IF(Core_Opportunity_Geo_PRC__c = True, &apos;,Core_Oppty_AllSalesGroups_PRC_Read,Core_Oppty_AllSalesGroups_PRC_Write&apos; &amp; 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Global Accounts&apos;), &apos;,Core_Oppty_GlobalAccounts_PRC_Read,Core_Oppty_GlobalAccounts_PRC_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Industry Sales&apos;), &apos;,Core_Oppty_IndustrySales_PRC_Read,Core_Oppty_IndustrySales_PRC_Write&apos;, 
IF(ISPICKVAL(Core_Sales_Group__c, &apos;Regional Sales&apos;), &apos;,Core_Oppty_RegionalSales_PRC_Read,Core_Oppty_RegionalSales_PRC_Write&apos;, &apos;&apos;))), &apos;&apos;)</formula>
        <label>Public Group Visibility</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
