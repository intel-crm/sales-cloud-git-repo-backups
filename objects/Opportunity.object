    <fields>
        <fullName>Core_Weighted_U__c</fullName>
        <description>This field multiplies the sum of product quantity at opportunity level by Probability %, it will be used at reporting side to create calculations.</description>
        <externalId>false</externalId>
        <formula>Probability  *    Core_Opportunity_U__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Weighted (U)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
