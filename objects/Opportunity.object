    <fields>
        <fullName>Core_MAG_Questionnaire__c</fullName>
        <description>The MINDS questionnaire helps assess Intel’s export compliance obligations and must be filled out for Intel opportunities as indicated. Non-Intel parties must independently ensure their DR-related actions are compliant with all relevant trade obligations.</description>
        <externalId>false</externalId>
        <formula>IF (Core_Design_Registration_Id__c != NULL, &apos;N/A&apos;,

IF (ISPICKVAL(Core_Compliance_Sub_Status__c, &apos;AR - Owner to complete MINDS Questionnaire&apos;),

HYPERLINK(
IF ($User.UITheme != &apos;Theme3&apos;,&apos;/one/one.app#/alohaRedirect/&apos;, (Left($Api.Enterprise_Server_URL_190,(find(&apos;/services&apos;,$Api.Enterprise_Server_URL_190))))) + &apos;apex/Core_MAGQuestionnaire?OpportunityId=&apos; + Id +
IF (Core_MAG_Questionnaire_ID__c != &apos;&apos;,&apos;&amp;Id=&apos;+Core_MAG_Questionnaire_ID__c,&apos;&apos;),
IMAGE (&apos;/servlet/servlet.FileDownload?file=0151J000003qhti&apos;,&apos;Click Here to Fill Out MINDS Questionnaire&apos;),
&apos;_self&apos;),

IF (ISPICKVAL(Core_Compliance_Sub_Status__c, &apos;AR - Owner to Respond to GEC Clarifying Questions&apos;),

HYPERLINK(
IF ($User.UITheme != &apos;Theme3&apos;,&apos;/one/one.app#/alohaRedirect/&apos;, (Left($Api.Enterprise_Server_URL_190,(find(&apos;/services&apos;,$Api.Enterprise_Server_URL_190))))) + &apos;apex/Core_MAGQuestionnaire?OpportunityId=&apos; + Id +
IF (Core_MAG_Questionnaire_ID__c != &apos;&apos;,&apos;&amp;Id=&apos;+Core_MAG_Questionnaire_ID__c,&apos;&apos;),
IMAGE (&apos;/servlet/servlet.FileDownload?file=0151J000003qhth&apos;,&apos;Responses to GEC Clarifying Questions Required on MAG Questionnaire&apos;),
&apos;_self&apos;),

HYPERLINK(
Left ($Api.Enterprise_Server_URL_190,(find(&apos;/services&apos;,$Api.Enterprise_Server_URL_190))) + &apos;apex/Core_MAGQuestionnaire?OpportunityId=&apos; + Id +
IF (Core_MAG_Questionnaire_ID__c != &apos;&apos;,&apos;&amp;Id=&apos;+Core_MAG_Questionnaire_ID__c,&apos;&apos;),
&apos;MINDS Questionnaire&apos;,
&apos;_self&apos;)

)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The MINDS questionnaire helps assess Intel’s export compliance obligations and must be filled out for Intel opportunities as indicated. Non-Intel parties must independently ensure their DR-related actions are compliant with all relevant trade obligations.</inlineHelpText>
        <label>MINDS Questionnaire</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
