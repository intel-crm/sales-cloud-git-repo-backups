        <fullName>Core_Technical_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The person who is the technical owner of the opportunity. Use the default value of &quot;User&quot; when selecting your technical owner.</description>
        <inlineHelpText>Select the FAE/ITS supporting this opportunity. Required for Design opportunity type.  For Channel Opportunities, this is the Intel employee.</inlineHelpText>
        <label>Technical Owner</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>User.ContactId</field>
                <operation>equals</operation>
                <value></value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>Opportunities</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
