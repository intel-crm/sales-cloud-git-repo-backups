    <validationRules>
        <fullName>CRM_Audit_Start_End_Date</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,FALSE,
AND(
CRM_Audit_Close_Date__c &lt; CRM_Audit_Start_Date__c
)
)</errorConditionFormula>
        <errorMessage>Please ensure the audit close date is ON or AFTER the audit start date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_Non_VBS_Annual_Recurring_Revenue</fullName>
        <active>true</active>
        <description>Annual Recurring Revenue should be always less than or equal to Total Contract Revenue</description>
        <errorConditionFormula>IF(
    $Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,
    FALSE,
    AND( OR(ISCHANGED(CRM_VBS_Annual_Recurring_Revenue__c),ISCHANGED(CRM_VBS_Total_Contract_Value__c)) ,
        CRM_VBS_Annual_Recurring_Revenue__c &gt; CRM_VBS_Total_Contract_Value__c, OR(
            $RecordType.DeveloperName = &apos;Core_Design_Opportunity&apos;,
            $RecordType.DeveloperName = &apos;Core_Deal_Opportunity&apos;
        ),
        ISPICKVAL(Core_Opportunity_Coverage_Nm__c, &apos;Intel-Led Opportunity&apos;)
    )
)</errorConditionFormula>
        <errorMessage>Annual Recurring Revenue should be always less than or equal to Total Contract Revenue</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_Non_VBS_Contract_Start_Date</fullName>
        <active>true</active>
        <description>Contract Start Date should be greater than opportunity decision date.</description>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,
FALSE,
	IF(
	OR(
		ISPICKVAL(Core_VBS_Status__c, &apos;Pending&apos;),
		ISPICKVAL(Core_VBS_Status__c, &apos;SOAR1 Qualified&apos;),
		ISPICKVAL(Core_VBS_Status__c, &apos;SOAR3 Approved&apos;),
		ISPICKVAL(Core_VBS_Status__c, &apos;SOAR4 Contract Signed&apos;)
	),
		False,
		AND(
			ISCHANGED(CRM_VBS_Contract_Start_Date__c),
			ISPICKVAL(Core_Opportunity_Coverage_Nm__c, &apos;Intel-Led Opportunity&apos;),
			CRM_VBS_Contract_Start_Date__c &lt;= Decision_Date__c,
			OR(
            $RecordType.DeveloperName = &apos;Core_Design_Opportunity&apos;,
            $RecordType.DeveloperName = &apos;Core_Deal_Opportunity&apos;
))
	)
)</errorConditionFormula>
        <errorDisplayField>CRM_VBS_Contract_Start_Date__c</errorDisplayField>
        <errorMessage>Contract Start Date should be greater than opportunity decision date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_Non_VBS_Contract_Value_Check</fullName>
        <active>true</active>
        <description>Total Contract Value should be greater than Design Win Amount for Contracts greater than 12 months lifetime.</description>
        <errorConditionFormula>IF(
    $Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,
    FALSE,
    AND( OR(ISCHANGED(CRM_VBS_Contract_Lifetime_in_Months__c),ISCHANGED(CRM_VBS_Total_Contract_Value__c)),
        OR(
            $RecordType.DeveloperName = &apos;Core_Design_Opportunity&apos;,
            $RecordType.DeveloperName = &apos;Core_Deal_Opportunity&apos;
        ),
        ISPICKVAL(Core_Opportunity_Coverage_Nm__c, &apos;Intel-Led Opportunity&apos;),
        CRM_VBS_Contract_Lifetime_in_Months__c &gt; 12,
        CRM_VBS_Total_Contract_Value__c &lt;= Amount
    )
)</errorConditionFormula>
        <errorMessage>Total Contract Value should be greater than Design Win Amount for Contracts greater than 12 months lifetime.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_SoftwareOpportunity</fullName>
        <active>true</active>
        <description>For Software Opportunity do not allow VBS Potential to be modify</description>
        <errorConditionFormula>AND( ISCHANGED( Core_VBS_Potential__c ),
Core_VBS_Potential__c =true,
CRM_SW_Flag_Ind__c=true )</errorConditionFormula>
        <errorMessage>The VBS checkbox should not be edited once a Software &amp; Services quote has been linked to an opportunity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Add_Product_Restriction</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF( ( ISPICKVAL(Core_Opportunity_Coverage_Nm__c, &apos;Intel-Led Opportunity&apos;) &amp;&amp; (OR(ISPICKVAL(Core_VBS_Status__c , &apos;Pending&apos;),ISPICKVAL(Core_VBS_Status__c , &apos;SOAR1 Qualified&apos;)) &amp;&amp; Core_VBS_Potential__c)) &amp;&amp; ISCHANGED(Core_Product_Count__c ), TRUE, FALSE)
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Group__c</errorDisplayField>
        <errorMessage>Opportunity Products OR Team cannot be updated if ‘VBS Status’ field is “Pending or SOAR1 Qualified&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Stage_restriction</fullName>
        <active>true</active>
        <description>SOAR process is initiated. Cannot modify opportunity stage to lost/cancelled</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF((( ISPICKVAL(Core_Opportunity_Coverage_Nm__c, &apos;Intel-Led Opportunity&apos;) &amp;&amp; (OR(ISPICKVAL(Core_VBS_Status__c , &apos;Pending&apos;),ISPICKVAL(Core_VBS_Status__c , &apos;SOAR1 Qualified&apos;)) &amp;&amp; Core_VBS_Potential__c)) &amp;&amp; ISCHANGED( StageName )) &amp;&amp; NOT( ISPICKVAL(StageName , &apos;Qualify&apos;) || ISPICKVAL(StageName , &apos;Define&apos;) || ISPICKVAL(StageName , &apos;Lost&apos;)) , TRUE, FALSE)
)</errorConditionFormula>
        <errorMessage>Opportunity cannot moved to further stages where there is a SOAR Process Pending/Qualified.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_checkBox_Restriction</fullName>
        <active>true</active>
        <description>Once SOAR process initiate no one can uncheck.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,ISCHANGED(Core_VBS_Potential__c) &amp;&amp; NOT(Core_VBS_Potential__c))</errorConditionFormula>
        <errorMessage>Uncheck action cannot be performed, instead request the VBS status to be updated to &apos;SOAR1 Un-qualified&apos;. Please log an Ask A Question (AAQ)/Topic Sales CRM to have the VBS Status updated to &apos;SOAR1 Un-qualified&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_Valid_ARR_Contract_Value</fullName>
        <active>true</active>
        <errorConditionFormula>OR(AND(ISCHANGED( CRM_VBS_Annual_Recurring_Revenue__c),CRM_VBS_Annual_Recurring_Revenue__c &lt;0),AND(ISCHANGED( CRM_VBS_Total_Contract_Value__c ),CRM_VBS_Total_Contract_Value__c &lt;0))</errorConditionFormula>
        <errorMessage>Please enter a valid amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_Valid_Contract_Lifetime</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISCHANGED(CRM_VBS_Contract_Lifetime_in_Months__c),CRM_VBS_Contract_Lifetime_in_Months__c &lt; 0
)</errorConditionFormula>
        <errorDisplayField>CRM_VBS_Contract_Lifetime_in_Months__c</errorDisplayField>
        <errorMessage>Please enter a numeric value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Account_Check_OnCreate_Update</fullName>
        <active>true</active>
        <errorConditionFormula>IF(OR($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,$Profile.Name = &quot;Sales CRM API&quot;),FALSE,
AND(
Account.RecordType.DeveloperName &lt;&gt; &apos;Mastered_Account&apos;,
AccountId &lt;&gt; null,
OR(ISNEW(),NOT(ISNEW()))
)
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>The account on this opportunity is not an intel account. Please ensure the account selected on the opportunity is an Intel Account in order to proceed with any operations on this opportunity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Contact_NoOppportunity_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
Core_Lead_to_Opportunity_Conversion__c 

) 
)</errorConditionFormula>
        <errorMessage>Please check ‘Do Not Create a New Opportunity’ check box when converting a disqualified lead to ‘Contact No Opportunity’ stage</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_DDR_Lock_MINDS_Field</fullName>
        <active>true</active>
        <description>Rule to prevent users from editing the field &apos;Are Intel items used for MINDS?&apos; on Opportunities converted from Design Registrations. The rule does not apply for Admin users.</description>
        <errorConditionFormula>AND
(
ISCHANGED(Core_Military_Aerospace_Govmt_End_Use__c) = TRUE,
Core_Design_Registration_Id__c != NULL,
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;IT Admin&apos;
)</errorConditionFormula>
        <errorDisplayField>Core_Military_Aerospace_Govmt_End_Use__c</errorDisplayField>
        <errorMessage>The Opportunity is created from Design Registration Conversion and this field is NOT editable.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_DealOppty_PWStage</fullName>
        <active>false</active>
        <description>User should not be able to update Deal type of opportunities with the &quot;Production Win&quot;, &quot;Production Lost&quot; &amp; &quot;Production Cancelled&quot; picklist values</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName =&apos;Core_Deal_Opportunity&apos;,
ISCHANGED( StageName ),
OR(
ISPICKVAL( StageName, &apos;Production Win&apos;),
ISPICKVAL( StageName, &apos;Production Lost&apos;),
ISPICKVAL( StageName, &apos;Production Cancelled&apos;)
)
)
)</errorConditionFormula>
        <errorMessage>Production Win/Lost/Cancelled Stages are not applicable for Deal Opportunity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Deal_Define_Exit_Criteria</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos;,
OR(
TEXT(Core_Product_Segment__c) = null,
TEXT(Core_Product_Application__c) = null,
TEXT(Core_Consumption_Market__c) = null,
Core_Contact_Roles_Count__c &lt; 1),
ISCHANGED(StageName),
OR(ISPICKVAL(StageName, &apos;Develop&apos;),ISPICKVAL(StageName, &apos;Design&apos;)),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorMessage>Each of the fields must be completed before moving to the next Stage:  Product Segment, Product Application and Vertical Market and have at least one Contact must be associated to the Opportunity (Contact Roles section).</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Deal_Develop_Exit_Criteria</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos;,
OR(TEXT(Core_Competitive_Architecture__c) = null,
OR(Core_Write_In_Product_Count__c &gt; 0, Core_Product_Count__c &lt;1)),
ISCHANGED(StageName),
ISPICKVAL(StageName, &apos;Design&apos;),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorMessage>Must complete Competitive Architecture field and must include at least one (1) Product and zero (0)  Write In Products.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Deal_Qualify_Exit_Criteria</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos;,
OR(Description = null,
Core_Status_Update__c = null),
ISCHANGED(StageName),
OR(ISPICKVAL(StageName, &apos;Define&apos;),ISPICKVAL(StageName, &apos;Develop&apos;),ISPICKVAL(StageName, &apos;Design&apos;)),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorMessage>Each of the following fields must be completed before moving to the next Stage:  Description and Status Update.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Design_Define_Exit_Criteria</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName=&apos;Core_Design_Opportunity&apos;,
OR(
TEXT(Core_Product_Segment__c) = null,
TEXT(Core_Product_Application__c) = null,
TEXT(Core_Consumption_Market__c) = null,
			AND(
				Core_Contact_Roles_Count__c &lt; 1,
				Core_Design_Registration_Id__c = null
			)
		),
ISCHANGED(StageName),
OR(ISPICKVAL(StageName, &apos;Develop&apos;),ISPICKVAL(StageName, &apos;Design&apos;)),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorMessage>Each of the fields must be completed before moving to the next Stage:  Product Segment, Product Application and Vertical Market and at least one Contact must be associated to the Opportunity (Contact Roles section).</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Design_Develop_Exit_Criteria</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName=&apos;Core_Design_Opportunity&apos;,
OR(
			AND(
TEXT(Core_Competitive_Architecture__c) = null,
				Core_Design_Registration_Id__c = null
			),
TEXT(Core_Intel_Platform__c) = null,
			OR(Core_Write_In_Product_Count__c &gt; 0, Core_Product_Count__c &lt;1)
		),
ISCHANGED(StageName),
ISPICKVAL(StageName, &apos;Design&apos;),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorMessage>Each of the following fields must be completed before moving to the next Stage:  Competitive Architecture, Intel Platform and must include at least one (1) Product and zero (0)  Write In Products.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Design_Qualify_Exit_Criteria</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.DeveloperName=&apos;Core_Design_Opportunity&apos;,
OR(Description = null,
Core_Status_Update__c = null,
Core_Technical_Owner__c = null),
ISCHANGED(StageName),
OR(ISPICKVAL(StageName, &apos;Define&apos;),ISPICKVAL(StageName, &apos;Develop&apos;),ISPICKVAL(StageName, &apos;Design&apos;)),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Group__c</errorDisplayField>
        <errorMessage>Each of the following fields must be completed before moving to the next Stage:  Technical Owner, Description and Status Update.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Industry_WithoutAccount</fullName>
        <active>true</active>
        <description>This Rule that will stop the creation of an Opportunity for an account without Industry or Industry equal to &apos;To Be Defined&apos;</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF(AND(  ISPICKVAL( Core_Opportunity_Coverage_Nm__c , &apos;Partner-Led Opportunity&apos;) , RecordType.Name = &apos;Design Opportunity&apos;)= TRUE,FALSE,
NOT(CONTAINS(Name, &apos;Amendment&apos;)) &amp;&amp; 
NOT(AND(CONTAINS(Name, &apos;Renewal&apos;), Core_Renewed_Opportunity_Ind__c = FALSE)) &amp;&amp;
(AND(ISNEW(), (ISPICKVAL(Account.Industry,&apos;&apos;) || ISPICKVAL(Account.Industry, &apos;To Be Defined&apos;)), Account.RecordType.DeveloperName = &quot;Mastered_Account&quot;, Account.OwnerId &lt;&gt; $Label.Core_Uncovered_Account_ID) ||
AND(ISCLONE(), (ISPICKVAL(Account.Industry,&apos;&apos;)|| ISPICKVAL(Account.Industry, &apos;To Be Defined&apos;)), Account.RecordType.DeveloperName = &quot;Mastered_Account&quot;, Account.OwnerId &lt;&gt; $Label.Core_Uncovered_Account_ID) ||
AND (ISCHANGED(AccountId),( ISPICKVAL(Account.Industry, &apos;&apos;) || ISPICKVAL(Account.Industry, &apos;To Be Defined&apos;)),Account.RecordType.DeveloperName = &quot;Mastered_Account&quot;, Account.OwnerId &lt;&gt; $Label.Core_Uncovered_Account_ID))))</errorConditionFormula>
        <errorMessage>Please select the account&apos;s Industry and Sub Industry immediately after taking ownership.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_New_Deal_Qualify_Exit_Criteria_Desc</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name=&apos;Deal Opportunity&apos;,
Core_IsClone__c = False,
Description = null,
ISPICKVAL(StageName, &apos;Define&apos;),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
,ISNEW()
)
)</errorConditionFormula>
        <errorDisplayField>Description</errorDisplayField>
        <errorMessage>The required Fields must be completed: Description</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_New_Deal_Qualify_Exit_Criteria_s_u</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name=&apos;Deal Opportunity&apos;,
Core_IsClone__c = False,
Core_Status_Update__c = null,
ISPICKVAL(StageName, &apos;Define&apos;),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
,ISNEW()
)
)</errorConditionFormula>
        <errorDisplayField>Core_Status_Update__c</errorDisplayField>
        <errorMessage>The required Fields must be completed: Status Update.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_New_Design_Qual_Exit_Criteria_Desc</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name=&apos;Design Opportunity&apos;,
Core_IsClone__c = False,
Description = null,
ISPICKVAL(StageName, &apos;Define&apos;),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
,ISNEW()
)
)</errorConditionFormula>
        <errorDisplayField>Description</errorDisplayField>
        <errorMessage>The required Fields must be completed:  Description</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_New_Design_Qual_Exit_Criteria_Techn</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name=&apos;Design Opportunity&apos;,
Core_Technical_Owner__c = null,
ISPICKVAL(StageName, &apos;Define&apos;),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
,ISNEW()
)
)</errorConditionFormula>
        <errorDisplayField>Core_Technical_Owner__c</errorDisplayField>
        <errorMessage>The required Fields must be completed: Technical Owner</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_New_Design_Qual_Exit_Criteria_statu</fullName>
        <active>false</active>
        <description>When updating the stage, it checks for the exit criteria fields of the current stage before moving to the next stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
RecordType.Name=&apos;Design Opportunity&apos;,
Core_IsClone__c = False,
Core_Status_Update__c = null,
ISPICKVAL(StageName, &apos;Define&apos;),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
,ISNEW()
)
)</errorConditionFormula>
        <errorDisplayField>Core_Status_Update__c</errorDisplayField>
        <errorMessage>The required Fields must be completed:  Status Update.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_No_Lost_Cancelled_Stage_OnHold_Prod</fullName>
        <active>true</active>
        <description>When the Opportunity Stage is set to Lost or Cancelled and there are On Hold products, prevent the stage from updating the Stage to Lost or Cancelled and return the below error</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,AND(Core_No_of_On_Hold_Opportunity_Products__c  &gt; 0,  OR( ISPICKVAL(StageName, &apos;Lost&apos;) ,ISPICKVAL(StageName, &apos;Production Lost&apos;),ISPICKVAL(StageName, &apos;Cancelled&apos;),ISPICKVAL(StageName, &apos;Production Cancelled&apos;))))</errorConditionFormula>
        <errorMessage>Opportunity Stage cannot be set to Lost, Cancelled, Production Lost or Production Cancelled as there are Opportunity Products in On-Hold status. Please update Opportunity Product status to Pending before proceeding.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OppPrevent_Cancel</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(StageName, &apos;Cancelled&apos;) ,
ISCHANGED(StageName) ,
ISPICKVAL(Core_Opportunity_Coverage_Nm__c, &apos;Intel-Led Opportunity&apos;) ,
AND (
$Profile.Name &lt;&gt; $Label.Core_Data_Ops_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name
)

)</errorConditionFormula>
        <errorMessage>Cancelled Stage cannot be selected on an Opportunity , Please select Lost Stage instead</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Block_DesignWin_Change</fullName>
        <active>true</active>
        <description>Prevents someone from changing Stage from to Design Win if the Approval Status is not set to Approved</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
  ISCHANGED(StageName),
  Text(StageName) = &quot;Design Win&quot;,
  Not(ISPICKVAL(Core_Approval_Status__c, &quot;Approved&quot;))
  )
)</errorConditionFormula>
        <errorMessage>Opportunity &quot;Design Win&quot; Stage can only be changed through Approval Process.
This is triggered by Click on &quot;Submit for Approval&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Block_ProductionWin_Change</fullName>
        <active>true</active>
        <description>Prevents someone from changing Stage from to Production Win  if the Approval Status is not set to Approved.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF( AND(CRM_IsLowTouchAdmin_Chk__c = true),
		FALSE, AND(
RecordType.DeveloperName = &apos;Core_Design_Opportunity&apos;, 
ISCHANGED(StageName),
Text(StageName) = &quot;Production Win&quot;,
Not(ISPICKVAL(Core_PW_Approval_Status__c, &quot;Approved&quot;))
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Group__c</errorDisplayField>
        <errorMessage>Opportunity &quot;Production Win&quot; Stage can only be changed through Approval Process.
This is triggered by Click on &quot;Submit for PW Approval&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Block_Spl_Chars_OpptyName</fullName>
        <active>true</active>
        <description>Block the Special Characters in the Opportunity Name (seeing issues at the commission&apos;s end)</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
NOT(REGEX(Name,&quot;^[^|]*&quot;))

)</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Opportunity Name should not contain &quot; | &quot; Character.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Details_At_Risk</fullName>
        <active>true</active>
        <description>Require a value in the Details field if the stage is set to Lost or Production Loss</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(Core_Bypass_Field_Validation__c),
ISCHANGED(Core_Loss_Cancel_Reason__c),
ISBLANK(TEXT(Core_Loss_Cancel_Reason__c)),
OR( ISPICKVAL(StageName, &apos;Lost&apos;),
ISPICKVAL(StageName, &apos;Production Lost&apos;)
))

)</errorConditionFormula>
        <errorMessage>Please enter Loss/Cancel Details.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Details_if_Lost</fullName>
        <active>true</active>
        <description>Require a value in the Details field if the stage is set to Lost or Production Lost</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF((TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Partner-Led Opportunity&apos; &amp;&amp; TEXT(Core_Coverage_Type_Nm__c) =&apos;Deal Registration&apos;)=TRUE, FALSE,
OR(
AND(
AND(NOT(CONTAINS(Name, &apos;Amendment&apos;)),
NOT(CONTAINS(Name, &apos;Renewal&apos;))),
OR(
ISPICKVAL(StageName, &apos;Lost&apos;),
ISPICKVAL(StageName, &apos;Production Lost&apos;),
ISPICKVAL(StageName, &apos;Production Cancelled&apos;),
AND(
ISPICKVAL(StageName, &apos;Cancelled&apos;),
ISPICKVAL(Core_Opportunity_Coverage_Nm__c, &apos;Partner-Led Opportunity&apos;)
)
),
AND(ISCHANGED( StageName ),
ISBLANK(TRIM(
SUBSTITUTE(SUBSTITUTE(Core_Loss_Cancel_Details__c, &apos;.&apos;, &apos;&apos;), &apos;-&apos;, &apos;&apos;)
))),
NOT(OR(
ISCHANGED(Core_Opportunity_Team_Geo_APJ__c),
ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c),
ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c),
ISCHANGED(Core_Opportunity_Team_Geo_PRC__c),
ISCHANGED(Core_OSC_Collaboration_Type__c),
ISCHANGED(Core_Opportunity_Products__c)
))
),
AND(
OR(
ISPICKVAL(StageName, &apos;Lost&apos;),
ISPICKVAL(StageName, &apos;Production Lost&apos;),
ISPICKVAL(StageName, &apos;Production Cancelled&apos;),
ISPICKVAL(StageName, &apos;Cancelled&apos;)
),	
ISBLANK(TRIM(
SUBSTITUTE(SUBSTITUTE(Core_Loss_Cancel_Details__c, &apos;.&apos;, &apos;&apos;), &apos;-&apos;, &apos;&apos;)
)),
NOT(ISBLANK(PRIORVALUE(Core_Loss_Cancel_Details__c)))
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Loss_Cancel_Details__c</errorDisplayField>
        <errorMessage>Loss/Cancel Details are required if Stage is set to Lost or Production Lost or Cancelled or Production Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Details_if_Lost_PCC</fullName>
        <active>true</active>
        <description>Require a value in the Details field if the stage is set to Lost or Production Lost</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( AND (TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Partner-Led Opportunity&apos;,
           TEXT(Core_Coverage_Type_Nm__c) =&apos;Deal Registration&apos;),
OR(
AND(
AND(NOT(CONTAINS(Name, &apos;Amendment&apos;)),
NOT(CONTAINS(Name, &apos;Renewal&apos;))),
OR(
ISPICKVAL(StageName, &apos;Lost&apos;),
ISPICKVAL(StageName, &apos;Cancelled&apos;)
),
AND(ISCHANGED( StageName ),
ISBLANK(TRIM(
SUBSTITUTE(SUBSTITUTE(Core_Loss_Cancel_Details__c, &apos;.&apos;, &apos;&apos;), &apos;-&apos;, &apos;&apos;)
))),
NOT(OR(
ISCHANGED(Core_Opportunity_Team_Geo_APJ__c),
ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c),
ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c),
ISCHANGED(Core_Opportunity_Team_Geo_PRC__c),
ISCHANGED(Core_OSC_Collaboration_Type__c),
ISCHANGED(Core_Opportunity_Products__c)
))
),
AND(
OR(
ISPICKVAL(StageName, &apos;Lost&apos;),
ISPICKVAL(StageName, &apos;Cancelled&apos;)
),
ISBLANK(TRIM(
SUBSTITUTE(SUBSTITUTE(Core_Loss_Cancel_Details__c, &apos;.&apos;, &apos;&apos;), &apos;-&apos;, &apos;&apos;)
)),
NOT(ISBLANK(PRIORVALUE(Core_Loss_Cancel_Details__c)))
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Loss_Cancel_Details__c</errorDisplayField>
        <errorMessage>Loss/Cancel Details are required if Stage is set to Lost or Cancelled.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Intel_Ultimate_Account</fullName>
        <active>true</active>
        <description>Prevents creating an Opportunity against an Account where the record type is &apos;Intel Ultimate Account&apos;</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
Account.RecordType.Name = &quot;Intel Ultimate Account&quot;

)</errorConditionFormula>
        <errorMessage>You cannot create an Opportunity against an Intel Ultimate Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Locking_Account</fullName>
        <active>true</active>
        <description>Once an opportunity has moved to Design Win, Production Win, Production Loss, or Production Cancelled only Data Ops and Admins can change the Account</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(
  OR(
   TEXT(StageName) = &quot;Design Win&quot;,
   TEXT(StageName) = &quot;Production Win&quot;,
   TEXT(StageName) = &quot;Production Lost&quot;,
   TEXT(StageName) = &quot;Production Cancelled&quot;
  ),

  AND (
  $Profile.Name &lt;&gt; $Label.Core_Data_Ops_Profile_Name,
  $Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
  $Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name
  ),

  ISCHANGED(   AccountId  )
)
)</errorConditionFormula>
        <errorMessage>Account can only be changed by Data Ops and Admins in the Design Win, Production Win, Production Loss, and Production Cancelled stages</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Opportunity_MAG</fullName>
        <active>true</active>
        <description>Prevents changing the Opportunity MAG field from &apos;Yes&apos; to any other value</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_Integration_Profile_Name, 
$Profile.Name &lt;&gt; $Label.Core_Global_Export_Compliance_Profile_Name, 
ISPICKVAL(PRIORVALUE(Core_Military_Aerospace_Govmt_End_Use__c), &quot;Yes&quot;), 
ISCHANGED(Core_Military_Aerospace_Govmt_End_Use__c) = TRUE)
)</errorConditionFormula>
        <errorDisplayField>Core_Military_Aerospace_Govmt_End_Use__c</errorDisplayField>
        <errorMessage>Value cannot be changed from &apos;Yes&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_PC_PL_stage_To_designWin_check</fullName>
        <active>true</active>
        <description>This validation rule will not allow user to move the Oppty stage from Production Lost/Cancelled stages to Design win. Only Owner&apos;s manger/tech owner/data ops users able to move the stage from production stages(won/lost/cancelled) to design win</description>
        <errorConditionFormula>IF(
		RecordType.DeveloperName = &apos;Core_Deal_Opportunity&apos; &amp;&amp;
		(ISCHANGED(StageName) &amp;&amp;
			NOT(OR(
			$User.Id = Core_Technical_Owner__c ,
			$User.Id = Core_Technical_Owner__r.ManagerId ,
			$User.Id = Owner.ManagerId,
			$User.Id = OwnerId
			))
		)=TRUE,FALSE,

IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,FALSE,
		AND(ISCHANGED(StageName),
		NOT( ISCHANGED(Core_PC_PL_Reversal_Backend_Field__c) ),
		OR(
		ISPICKVAL(PRIORVALUE(StageName), &apos;Production Lost&apos;),
		ISPICKVAL(PRIORVALUE(StageName), &apos;Production Cancelled&apos;)
		),
		NOT(
		OR(

		ISPICKVAL(StageName, &apos;Production Lost&apos;),
		ISPICKVAL(StageName, &apos;Production Cancelled&apos;)
		)),

		$Profile.Name&lt;&gt;$Label.Core_System_Admin_Profile_Name,
		$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
		$Profile.Name &lt;&gt; &apos;Data Ops&apos;
		)
		))</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>Opportunities with Stage of Design Win  or Production Lost/Cancelled cannot be changed to previous Stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Prevent_Creation</fullName>
        <active>true</active>
        <description>Based on Account deactivation</description>
        <errorConditionFormula>IF(
    $Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,
    FALSE,
    AND(
NOT(
AND(
$Permission.Export_Compliance_Block,
OR(
ISPICKVAL(StageName, &quot;Lost&quot;),
ISPICKVAL(StageName, &quot;Cancelled&quot;)
)
)
),
OR(
Account.Core_Export_Compliance_Block__c = TRUE,
Account.Core_Deactivated__c = TRUE
)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Group__c</errorDisplayField>
        <errorMessage>The Account that you are attempting to relate this Opportunity to is inactive. Please choose an active Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Prevent_Deletion_Won_Products</fullName>
        <active>true</active>
        <description>Prevents deletion of products that are Win Approved</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name, 
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name, 
PRIORVALUE(Core_Won_Product_Count__c) &gt; Core_Won_Product_Count__c,
PRIORVALUE(Core_Product_Count__c) &gt;
Core_Product_Count__c)
)</errorConditionFormula>
        <errorMessage>Products that are Win Approved cannot be deleted. If this product needs to be deleted, please have the Approving Manager set it back to Pending.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Prevent_Product_Del_By_Partner</fullName>
        <active>true</active>
        <description>Prevents deletion of Products by Partner Users.</description>
        <errorConditionFormula>AND
(
PRIORVALUE(Core_Product_Count__c) &gt; Core_Product_Count__c, 
$Profile.Name = $Label.Core_Partner_Profile_Name
)</errorConditionFormula>
        <errorMessage>Deletion of Opportunity Products is restricted. If this product needs to be deleted, please contact your Intel representative.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Prod_Stage_To_designWin_check</fullName>
        <active>true</active>
        <description>This validation rule will not allow user to move the Oppty stage from Production stages to Design win. Only Owner&apos;s manger/tech owner/data ops users able to move the stage from production stages(won/lost/cancelled) to design win</description>
        <errorConditionFormula>IF(RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos; &amp;&amp;  
(ISCHANGED(StageName) &amp;&amp;  
OR(
$User.Id = Core_Technical_Owner__c ,
$User.Id = Core_Technical_Owner__r.ManagerId ,
$User.Id = Owner.ManagerId
))=TRUE,FALSE,

IF( CRM_IsLowTouchAdmin_Chk__c = true,FALSE,
IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(ISCHANGED(StageName),
NOT(AND(ISCHANGED(Core_PW_Approval_Status__c) ,
ISPICKVAL(Core_PW_Approval_Status__c, &apos;Recalled&apos;))),
NOT(ISPICKVAL(Core_PW_Approval_Status__c, &apos;Not Submitted&apos;)),
ISPICKVAL(PRIORVALUE(StageName), &apos;Production Win&apos;),
NOT(OR(
ISPICKVAL(StageName, &apos;Production Win&apos;),
ISPICKVAL(StageName, &apos;Production Lost&apos;),
ISPICKVAL(StageName, &apos;Production Cancelled&apos;)
)),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
$Profile.Name &lt;&gt; &apos;Data Ops&apos;
)
)
)
)</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>Opportunities with Stage of Design Win or Production Win/Lost/Cancelled cannot be changed to previous Stage. Manager of Opportunity or Technical Owner must first revert products. For detailed guidance, please visit goto/ReversingOpptyApproval</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Production_Cancelled</fullName>
        <active>true</active>
        <description>Prevents someone from changing Stage to Production Cancelled if the previous stage isn&apos;t Design Win, Production Lost, or Production Win</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
  ISCHANGED(StageName),
  RecordType.Name &lt;&gt; &quot;Solution Group&quot;, 
  RecordType.Name &lt;&gt; &quot;New Solution Group&quot;, 
  Text(StageName) = &quot;Production Cancelled&quot;, 
  NOT(OR(
    ISPICKVAL(PRIORVALUE(StageName), &quot;Design Win&quot;),
    ISPICKVAL(PRIORVALUE(StageName), &quot;Production Lost&quot;),
    ISPICKVAL(PRIORVALUE(StageName), &quot;Production Win&quot;)
  )), 
  NOT(OR(
    ISCHANGED(Core_Opportunity_Team_Geo_APJ__c), 
    ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c), 
    ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c), 
    ISCHANGED(Core_Opportunity_Team_Geo_PRC__c), 
    ISCHANGED(Core_OSC_Collaboration_Type__c)
  ))
)
)</errorConditionFormula>
        <errorMessage>Only Won Opportunities can be changed to Production Cancelled.  Please select Cancelled as the Stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Production_Lost</fullName>
        <active>true</active>
        <description>Prevents someone from changing Stage to Production Lost if the previous stage isn&apos;t Design Win, Production Win, or Production Cancelled</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
  ISCHANGED(StageName),
  RecordType.Name &lt;&gt; &quot;Solution Group&quot;, 
  RecordType.Name &lt;&gt; &quot;New Solution Group&quot;, 
  Text(StageName) = &quot;Production Lost&quot;, 
  NOT(OR(
    ISPICKVAL(PRIORVALUE(StageName), &quot;Design Win&quot;),
    ISPICKVAL(PRIORVALUE(StageName), &quot;Production Win&quot;),
    ISPICKVAL(PRIORVALUE(StageName), &quot;Production Cancelled&quot;)
  )), 
  NOT(OR(
    ISCHANGED(Core_Opportunity_Team_Geo_APJ__c), 
    ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c), 
    ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c), 
    ISCHANGED(Core_Opportunity_Team_Geo_PRC__c), 
    ISCHANGED(Core_OSC_Collaboration_Type__c)
  ))
)

)</errorConditionFormula>
        <errorMessage>Only Won Opportunities can be changed to Production Lost.  Please select Lost as the Stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Production_Win</fullName>
        <active>true</active>
        <description>Prevents someone from changing Stage to Production Win if the previous stage isn&apos;t Design Win, Production Lost, or Production Cancelled</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(StageName),
RecordType.Name &lt;&gt; &quot;Design Opportunity&quot;,
RecordType.Name &lt;&gt; &quot;Solution Group&quot;,
RecordType.Name &lt;&gt; &quot;New Solution Group&quot;,
Text(StageName) = &quot;Production Win&quot;,
NOT(OR(
ISPICKVAL(PRIORVALUE(StageName), &quot;Design Win&quot;),
ISPICKVAL(PRIORVALUE(StageName), &quot;Production Lost&quot;),
ISPICKVAL(PRIORVALUE(StageName), &quot;Production Cancelled&quot;)
)),
NOT(OR(
ISCHANGED(Core_Opportunity_Team_Geo_APJ__c),
ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c),
ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c),
ISCHANGED(Core_Opportunity_Team_Geo_PRC__c),
ISCHANGED(Core_OSC_Collaboration_Type__c)
))
)
)</errorConditionFormula>
        <errorMessage>Stage must be &quot;Design Win&quot;, &quot;Production Lost&quot;, or &quot;Production Cancelled&quot; before it can be set to &quot;Production Win&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Qualify_Define</fullName>
        <active>true</active>
        <description>Opportunity Can created for Qualify or Define Stage only</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( OR(
RecordType.Name=&apos;Deal Opportunity&apos;,
RecordType.Name=&apos;Design Opportunity&apos;),
Core_IsClone__c = False,
NOT(OR
(ISPICKVAL(StageName, &apos;Qualify&apos;),
ISPICKVAL(StageName, &apos;Define&apos;))),
ISNEW()
)
)</errorConditionFormula>
        <errorMessage>Opportunity may only be created at a Stage of Qualify or Define.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Reason_At_Risk</fullName>
        <active>true</active>
        <description>Require a value in the Reason field if the stage is set to Lost or Cancelled. Bypass for PCC.</description>
        <errorConditionFormula>IF((TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Partner-Led Opportunity&apos; &amp;&amp; TEXT(Core_Coverage_Type_Nm__c) =&apos;Deal Registration&apos;)=TRUE, FALSE,


IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(Core_Bypass_Field_Validation__c),
NOT(Core_Created_from_CPQ__c),
ISCHANGED(Core_Loss_Cancel_Reason__c),
ISBLANK(TEXT(Core_Loss_Cancel_Reason__c)),
OR(
text(StageName) = &quot;Lost&quot;,
text(StageName) = &quot;Cancelled&quot;,
text(StageName) = &quot;Production Lost&quot;,
text(StageName) = &quot;Production Cancelled&quot;))
)
)</errorConditionFormula>
        <errorDisplayField>Core_Loss_Cancel_Reason__c</errorDisplayField>
        <errorMessage>Please enter a Loss/Cancel Reason.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Reason_if_Flagged_for_Deletion</fullName>
        <active>true</active>
        <description>Require a reason for deletion if an Opportunity is flagged for deletion</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(
Core_Flag_for_Deletion__c = TRUE,
ISBLANK(Core_Reason_for_Deletion__c) = TRUE)

)</errorConditionFormula>
        <errorDisplayField>Core_Reason_for_Deletion__c</errorDisplayField>
        <errorMessage>Required if Flag for Deletion is checked</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Reason_if_Lost</fullName>
        <active>true</active>
        <description>Require a value in the Reason field if the stage is set to Lost or Cancelled. For PCC</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Partner-Led Opportunity&apos;,
TEXT(Core_Coverage_Type_Nm__c) =&apos;Deal Registration&apos;,
NOT(Core_Bypass_Field_Validation__c),
NOT(Core_Created_from_CPQ__c),
OR(
ISCHANGED(Core_Loss_Cancel_Reason__c),
ISCHANGED(StageName)
),
ISBLANK(TEXT(Core_Loss_Cancel_Reason__c)),
OR(
text(StageName) = &quot;Lost&quot;,
text(StageName) = &quot;Cancelled&quot;))
)</errorConditionFormula>
        <errorDisplayField>Core_Loss_Cancel_Reason__c</errorDisplayField>
        <errorMessage>Loss/Cancel Reason is required if Stage is set to Lost or Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Req_First_Cust_Ship_Date</fullName>
        <active>false</active>
        <description>Require First Customer Ship Date on Design opportunities if Sales Group is Global Accounts or Regional Sales or PSG Sales.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 

ISBLANK(TEXT(Core_First_Customer_Ship_Date__c)), 

NOT(AND(Core_Lead_Conversion_Flag__c, ISNEW())), 
NOT(AND(PRIORVALUE(Core_Lead_Conversion_Flag__c) = TRUE, Core_Lead_Conversion_Flag__c = FALSE)), 

RecordType.Name &lt;&gt; $Label.Core_Solution_Group_Record_Type, 
RecordType.Name &lt;&gt; $Label.Core_New_Solution_Group_Record_Type, 
RecordType.Name &lt;&gt; &apos;Design Opportunity&apos;, 

NOT(OR( 
ISCHANGED(Core_Opportunity_Team_Geo_APJ__c), 
ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c), 
ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c), 
ISCHANGED(Core_Opportunity_Team_Geo_PRC__c), 
ISCHANGED(Core_OSC_Collaboration_Type__c), 
ISCHANGED(Core_Business_Unit_Territory__c), 
ISCHANGED(Core_Business_Unit_Territory_Name__c), 
ISCHANGED(Core_Geographical_Territory__c), 
ISCHANGED(Core_Geographical_Territory_Name__c), 
ISCHANGED(Core_Named_Strategic__c), 
ISCHANGED(Core_Named_Strategic_Territory_Name__c) 
)), 


OR( 
ISPICKVAL(Core_Opportunity_Type__c, &quot;Design: Original&quot;), 
ISPICKVAL(Core_Opportunity_Type__c, &quot;Design: Secondary&quot;),
ISPICKVAL(Core_Opportunity_Type__c, &quot;Design: Software-enable&quot;) 
) 

)

)</errorConditionFormula>
        <errorDisplayField>Core_First_Customer_Ship_Date__c</errorDisplayField>
        <errorMessage>First Customer Ship Date is required on Design opportunities.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Req_Intel_Platform</fullName>
        <active>false</active>
        <description>Require Intel Platform on Design opportunities</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
  
ISBLANK(TEXT(Core_Intel_Platform__c)), 
  
NOT(AND(Core_Lead_Conversion_Flag__c, ISNEW())),  
NOT(AND(PRIORVALUE(Core_Lead_Conversion_Flag__c) = TRUE, Core_Lead_Conversion_Flag__c = FALSE)),
  
RecordType.Name &lt;&gt; $Label.Core_Solution_Group_Record_Type, 
RecordType.Name &lt;&gt; $Label.Core_New_Solution_Group_Record_Type, 
RecordType.Name &lt;&gt; &apos;Design Opportunity&apos;,

NOT(OR(
ISCHANGED(Core_Opportunity_Team_Geo_APJ__c),
ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c),
ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c),
ISCHANGED(Core_Opportunity_Team_Geo_PRC__c),
ISCHANGED(Core_OSC_Collaboration_Type__c),
ISCHANGED(Core_Business_Unit_Territory__c),
ISCHANGED(Core_Business_Unit_Territory_Name__c),
ISCHANGED(Core_Geographical_Territory__c),
ISCHANGED(Core_Geographical_Territory_Name__c),
ISCHANGED(Core_Named_Strategic__c),
ISCHANGED(Core_Named_Strategic_Territory_Name__c)
)),



OR( 
ISPICKVAL(Core_Opportunity_Type__c, &quot;Design: Original&quot;), 
ISPICKVAL(Core_Opportunity_Type__c, &quot;Design: Secondary&quot;),
ISPICKVAL(Core_Opportunity_Type__c, &quot;Design: Software-enable&quot;)
)

)
)</errorConditionFormula>
        <errorDisplayField>Core_Intel_Platform__c</errorDisplayField>
        <errorMessage>Intel Platform is required on Design opportunities.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Req_Product_Competitior_OEM</fullName>
        <active>true</active>
        <description>Competitor and Competitor Product is required for each product when Stage = Lost.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
        IF((TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Partner-Led Opportunity&apos; &amp;&amp; TEXT(Core_Coverage_Type_Nm__c) =&apos;Deal Registration&apos;)=TRUE, FALSE,

OR(
AND(
ISCHANGED(StageName),
  OR(
    ISPICKVAL(StageName, &apos;Lost&apos;),
    ISPICKVAL(StageName, &apos;Production Lost&apos;)
  ), 
  Core_System_Prod_Competitor_Empty_Count__c &gt; 0
),
AND(
ISCHANGED(Core_System_Prod_Competitor_Empty_Count__c),
OR(
    ISPICKVAL(StageName, &apos;Lost&apos;),
    ISPICKVAL(StageName, &apos;Production Lost&apos;)
  ), 
  Core_System_Prod_Competitor_Empty_Count__c &gt; 0
)
)
)
)</errorConditionFormula>
        <errorMessage>Competitor and Competitor Product is required for each product when Stage = Lost/Production Lost.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Req_Technical_Owner</fullName>
        <active>false</active>
        <description>Require Technical Owner if the Opportunity Type is Design: Original or Design: Secondary.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
	
ISBLANK(Core_Technical_Owner__c), 
	
NOT(AND(Core_Lead_Conversion_Flag__c, ISNEW())), 
NOT(AND(PRIORVALUE(Core_Lead_Conversion_Flag__c) = TRUE, Core_Lead_Conversion_Flag__c = FALSE)),
	
RecordType.Name &lt;&gt; $Label.Core_Solution_Group_Record_Type, 
RecordType.Name &lt;&gt; $Label.Core_New_Solution_Group_Record_Type,
RecordType.Name &lt;&gt; &apos;Design Opportunity&apos;,

NOT(OR(
ISCHANGED(Core_Opportunity_Team_Geo_APJ__c),
ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c),
ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c),
ISCHANGED(Core_Opportunity_Team_Geo_PRC__c),
ISCHANGED(Core_OSC_Collaboration_Type__c),
ISCHANGED(Core_Business_Unit_Territory__c),
ISCHANGED(Core_Business_Unit_Territory_Name__c),
ISCHANGED(Core_Geographical_Territory__c),
ISCHANGED(Core_Geographical_Territory_Name__c),
ISCHANGED(Core_Named_Strategic__c),
ISCHANGED(Core_Named_Strategic_Territory_Name__c)
)),


OR( 
ISPICKVAL(Core_Opportunity_Type__c, &quot;Design: Original&quot;), 
ISPICKVAL(Core_Opportunity_Type__c, &quot;Design: Secondary&quot;),
ISPICKVAL(Core_Opportunity_Type__c, &quot;Design: Software-enable&quot;) 
)

)
)</errorConditionFormula>
        <errorDisplayField>Core_Technical_Owner__c</errorDisplayField>
        <errorMessage>Technical Owner is required on Design opportunities.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Restrict_Closing_Opportunity</fullName>
        <active>false</active>
        <description>Restricts closing of an Opportunity if an Account is not approved

deactivated because of CIM/UCD blank was failing approval process</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(Core_Bypass_Field_Validation__c),
NOT(Core_Created_from_CPQ__c),
Account.Core_Approved_Account__c = FALSE,
OR(
text(StageName) = &quot;Design Win&quot;,
text(StageName) = &quot;Production Win&quot;,
text(StageName) = &quot;Production Lost&quot;,
text(StageName) = &quot;Production Cancelled&quot;,
text(StageName) = &quot;Lost&quot;,
text(StageName) = &quot;Cancelled&quot;))
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Group__c</errorDisplayField>
        <errorMessage>You cannot close an Opportunity on an Account that is not approved (Stage cannot be Design Win, Production Win, Production Lost, Production Cancelled, Lost, or Cancelled)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Restrict_RecordType_Change</fullName>
        <active>true</active>
        <description>Throws error when user tries to change the record type</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(ISNEW()),
ISCHANGED(RecordTypeId),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorMessage>Opportunity Record Type cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Restrict_SME_Collaborator</fullName>
        <active>true</active>
        <description>Restricts SME Collaborator from editing standard fields on opportunity</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,FALSE,
AND(
$Permission.Core_BU_SME_Collaborator_CustomPermission,
$Profile.Name = &apos;CRM - Core Access&apos;,
OR(
ISCHANGED(StageName),
ISCHANGED( Name ),
ISCHANGED( Core_Opportunity_Owner__c ),
ISCHANGED( CloseDate )
)
)
)</errorConditionFormula>
        <errorMessage>You do not have access to edit this field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Restrict_Standard_field_change</fullName>
        <active>true</active>
        <description>Restricts read only users from editing standard fields on opportunity.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c = TRUE,FALSE,
AND(
$Permission.CRM_Opportunity_Auditor_CustomPermission,
$Profile.Name = &apos;SMG/GMC Read Only&apos;,
OR(
ISCHANGED(StageName),
ISCHANGED( Name ),
ISCHANGED( OwnerId),
ISCHANGED( CloseDate )
)
)
)</errorConditionFormula>
        <errorMessage>Auditors do not have permission to update any fields other than the Audit Section Fields</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Sales_Group_Undefined</fullName>
        <active>true</active>
        <description>New , clone, update actions in OPTY, we will check only account sales group ( not the sales group of OPTY).
Applicable OPTYs are open Opportunities.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF((TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Partner-Led Opportunity&apos; &amp;&amp; TEXT(Core_Coverage_Type_Nm__c) =&apos;Deal Registration&apos;)=TRUE, FALSE,
AND(
AND(ISNEW(),ISPICKVAL(Account.Core_Sales_Groups__c, &apos;&apos;))
|| AND(ISNEW(), ISPICKVAL(Account.Core_Sales_Groups__c, &quot;Undefined&quot;))
|| AND(ISCLONE(), ISPICKVAL(Account.Core_Sales_Groups__c, &apos;&apos;))
|| AND(ISCLONE(), ISPICKVAL(Account.Core_Sales_Groups__c, &quot;Undefined&quot;))
|| AND(((ISCHANGED(AccountId)) &amp;&amp; (Core_Open_Oppty__c= 1)),ISPICKVAL(Account.Core_Sales_Groups__c, &quot;Undefined&quot;) )
|| AND(((ISCHANGED(AccountId)) &amp;&amp; (Core_Open_Oppty__c= 1)),ISPICKVAL(Account.Core_Sales_Groups__c, &apos;&apos;) )
)

)
)</errorConditionFormula>
        <errorMessage>Opportunities cannot be created against accounts with an Undefined Sales Group. Please update the account with the correct Sales Group and then save your opportunity. BKM: You can update the Sales Group in a new window.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_SubmitApproveNotLessThanCreated</fullName>
        <active>true</active>
        <description>US64659 - Added validation date submitted for approval cannot have a lesser value than the created date.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(NOT(ISBLANK(Core_Date_Submitted_for_Approval__c)),  Core_Date_Submitted_for_Approval__c &lt; Core_Converted_Created_Date__c)

)</errorConditionFormula>
        <errorDisplayField>Core_Date_Submitted_for_Approval__c</errorDisplayField>
        <errorMessage>Date Submitted for Approval cannot be less than the Created Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_To_Prevent_AE_Account_Owner</fullName>
        <active>true</active>
        <description>User cannot create a new and Clone Opportunity as  Account Owner is being &quot;A&amp;E Account Owner&quot;.</description>
        <errorConditionFormula>AND(OR(ISNEW(),ISCLONE()),Account.OwnerId= $Label.Core_Opp_A_E_Account_OwnerId
         )</errorConditionFormula>
        <errorMessage>Opportunities cannot be created against accounts where &apos;A and E Account Owner&apos; is set as the Account Owner.  Please log an AAQ to request ownership and once completed you can create your opportunities.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Won_StagePrevent</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(ISCHANGED(StageName),
OR(
ISPICKVAL(PRIORVALUE(StageName), &apos;Design Win&apos;),
ISPICKVAL(PRIORVALUE(StageName), &apos;Production Win&apos;),
ISPICKVAL(PRIORVALUE(StageName), &apos;Production Lost&apos;),
ISPICKVAL(PRIORVALUE(StageName), &apos;Production Cancelled&apos;)
),
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name)
)</errorConditionFormula>
        <errorMessage>Won opportunities cannot be changed to a previous Stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Won_To_Pending</fullName>
        <active>true</active>
        <description>This validation rule will not allow users to move the Oppty stage from DESIGN WIN to DESIGN, except data ops users(jeff,daniela &amp;Sonia)</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(StageName),
ISPICKVAL(PRIORVALUE(StageName), &apos;Design Win&apos;),
NOT(OR(
ISPICKVAL(StageName, &apos;Production Win&apos;),
ISPICKVAL(StageName, &apos;Production Lost&apos;),
ISPICKVAL(StageName, &apos;Production Cancelled&apos;)
)),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id )),
NOT(
AND(
ISCHANGED(Core_Won_Product_Count__c),
PRIORVALUE(Core_Won_Product_Count__c)&gt;0,
Core_Won_Product_Count__c = 0
))
)
)</errorConditionFormula>
        <errorMessage>Opportunities with Stage of Design Win or Production Win/Lost/Cancelled cannot be changed to previous Stage. Manager of Opportunity or Technical Owner must first revert products. For detailed guidance, please visit goto/ReversingOpptyApproval</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Won_To_Pending_Data_Ops</fullName>
        <active>true</active>
        <description>Data Ops users will not able move Oppty stage from DESIGN win To DESIGN if no pending products.</description>
        <errorConditionFormula>AND(
CONTAINS($Label.Core_DataOpsProfile , $User.Id ),
Core_Pending_Product_Count__c = 0,
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
ISCHANGED(StageName),
ISPICKVAL(PRIORVALUE(StageName), &apos;Design Win&apos;),
ISPICKVAL(StageName, &apos;Design&apos;)
)</errorConditionFormula>
        <errorMessage>Opportunities with Stage of Design Win or Production Win/Lost/Cancelled cannot be changed to previous Stage. Manager of Opportunity or Technical Owner must first revert products. For detailed guidance, please visit goto/ReversingOpptyApproval</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_OpportunityIOGMCheck</fullName>
        <active>true</active>
        <description>This will fire when IOGM is checked for other Accounts other than Americas Users Salesgroup</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
OR(ISNEW(),ISCHANGED(Core_IOGM_Opportunity__c)),
Core_IOGM_Opportunity__c =TRUE,
Core_Sales_Groups__c &lt;&gt; &apos;Americas US Sales Group&apos;,
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;IT Admin&apos;,
OR(RecordType.DeveloperName =&apos;Core_Deal_Opportunity&apos;,RecordType.DeveloperName =&apos;Core_Design_Opportunity&apos;)
)
)</errorConditionFormula>
        <errorDisplayField>Core_IOGM_Opportunity__c</errorDisplayField>
        <errorMessage>Only Americas Sales Group opportunities are IOGM eligible.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Oppty_Decision_Date_In_Future</fullName>
        <active>true</active>
        <description>US41260: Opportunity:   Prevent (or alert) users from selecting a decision date in the past (SR-02442)</description>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,
FALSE, 
IF(($Profile.Name == &apos;Sales Ops&apos; || $Profile.Name == &apos;System Administrator&apos; || $Profile.Name == &apos;Data Ops&apos; || $Profile.Name == &apos;IT Admin&apos; || $Profile.Name == &apos;Production Support&apos;),
FALSE, 
(
AND(
(ISNEW() || ISCHANGED(CloseDate)) &amp;&amp; CloseDate &lt; TODAY(),
OR(
ISPICKVAL( StageName , &apos;Qualify&apos;),
ISPICKVAL( StageName , &apos;Define&apos;), 
ISPICKVAL( StageName , &apos;Develop&apos;), 
ISPICKVAL( StageName , &apos;Design&apos;), 
ISPICKVAL( StageName , &apos;Group&apos;), 
ISPICKVAL( StageName , &apos;Group Open&apos;) 
)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>CloseDate</errorDisplayField>
        <errorMessage>Past Decision Dates are invalid. Please enter a future Decision Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PCCDealOppty_PWStage</fullName>
        <active>true</active>
        <description>User should not be able to update PCC Deal Reg opportunities with the &quot;Production Win&quot;, &quot;Production Lost&quot; &amp; &quot;Production Cancelled&quot; picklist values</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
(ISPICKVAL(Core_Opportunity_Coverage_Nm__c, &apos;Partner-Led Opportunity&apos;) &amp;&amp; ISPICKVAL(Core_Coverage_Type_Nm__c, &apos;Deal Registration&apos;)),
NOT(ISNEW()) ,
ISCHANGED( StageName ), 
OR( 
ISPICKVAL( StageName, &apos;Production Win&apos;),
ISPICKVAL( StageName, &apos;Production Lost&apos;),
ISPICKVAL( StageName, &apos;Production Cancelled&apos;)
)
)
)</errorConditionFormula>
        <errorMessage>Production Win/Production Cancelled/Production Lost are not applicable for Partner Opportunities.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PCC_Deal_Product_Segment</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				ISCHANGED(Core_Product_Segment__c), 
				ISPICKVAL(Core_Product_Segment__c , &apos;Software &amp; Services&apos;),
				ISPICKVAL(Core_Coverage_Type_Nm__c , &apos;Deal Registration&apos; ) ,
				ISPICKVAL(Core_Opportunity_Coverage_Nm__c , &apos;Partner-Led Opportunity&apos;)
				)</errorConditionFormula>
        <errorDisplayField>Core_Product_Segment__c</errorDisplayField>
        <errorMessage>Not applicable for Partner Opportunities</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PCC_Restrict_OPTY_CancelToRevert</fullName>
        <active>true</active>
        <description>PCC OPTY Restrict OPTY Cancel to Pending</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,
FALSE,
AND(
ISPICKVAL(Core_Coverage_Type_Nm__c, &apos;Deal Registration&apos;), ISPICKVAL(Core_Opportunity_Coverage_Nm__c , &apos;Partner-Led Opportunity&apos;),
NOT(ISNEW()),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,

ISCHANGED(StageName ),

OR(
ISPICKVAL( PRIORVALUE(StageName ) , &apos;Lost&apos;),
ISPICKVAL( PRIORVALUE(StageName ) , &apos;Cancelled&apos;)
)


)
)</errorConditionFormula>
        <errorMessage>Opportunity stage cannot be reversed to open stages from Lost/Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PCC_Restrict_OPTY_TechOwner_Update</fullName>
        <active>true</active>
        <description>Restrict changing the Technical Owner on Opportunity by PSAM. Only allow it for DataOps/Admin.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_Data_Ops_Profile_Name,
TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Partner-Led Opportunity&apos;,
ISPICKVAL(Core_Coverage_Type_Nm__c , &apos;Deal Registration&apos;),
ISCHANGED(Core_Technical_Owner__c ),
Core_Technical_Owner__r.Core_User_Type__c =&apos;External User&apos;,
!(ISNEW()),
OwnerId &lt;&gt; $User.Id
)
)</errorConditionFormula>
        <errorMessage>Technical Owner update on Opportunity is only allowed by DataOps/Admin.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Edit_BU_Collaborator_User</fullName>
        <active>true</active>
        <description>For profile BU Account Collaborator</description>
        <errorConditionFormula>IF( 
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( 
NOT(ISNEW()),
$Profile.Name = &quot;BU Account Collaborator&quot;
) 
)</errorConditionFormula>
        <errorMessage>Cannot edit Opportunity. Please contact system admin.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_OpportunityStage_Update</fullName>
        <active>true</active>
        <description>Users are prevented from changing the Opportunity Stage to Lost, Cancelled, Production Lost, Production Cancelled or Production Win if there are products on that opportunity flagged at risk where the Risk Status = &apos;New&apos; or &apos;In Progress&apos;.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,AND(OR( ISPICKVAL( StageName , &apos;Lost&apos;), ISPICKVAL(StageName, &apos;Cancelled&apos;),ISPICKVAL( StageName , &apos;Production Lost&apos;),ISPICKVAL( StageName , &apos;Production Cancelled&apos;),ISPICKVAL( StageName , &apos;Production Win&apos;)), AND(Core_At_Risk__c = true, Core_Product_At_Risk_Not_Closed_Count__c&gt;0)))</errorConditionFormula>
        <errorMessage>Opportunity Stage cannot be updated as specified as there are open product(s) flagged at risk. Please navigate to the At Risk tab to either uncheck the At Risk checkbox or disposition the Risk Status to a “Closed” state.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Forward_Jump</fullName>
        <active>false</active>
        <description>Restrict user to skip stages. (After Develop Stage)</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
OR(RecordType.DeveloperName=&apos;Core_Design_Opportunity&apos;,
RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos;),
ISCHANGED(StageName),
OR(ISPICKVAL(PRIORVALUE(StageName), &apos;Qualify&apos;),
ISPICKVAL(PRIORVALUE(StageName), &apos;Define&apos;)),
ISPICKVAL(StageName, &apos;Design&apos;),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorMessage>Skipping stage is not allowed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Previous_Stage</fullName>
        <active>false</active>
        <description>To restrict the user to move back to the previous stage</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
OR(RecordType.DeveloperName=&apos;Core_Design_Opportunity&apos;,
RecordType.DeveloperName=&apos;Core_Deal_Opportunity&apos;),
OR(
AND(
ISCHANGED(StageName),
ISPICKVAL(PRIORVALUE(StageName), &apos;Design&apos;),
OR(ISPICKVAL(StageName, &apos;Develop&apos;),ISPICKVAL(StageName, &apos;Define&apos;),ISPICKVAL(StageName, &apos;Qualify&apos;))),
AND(
ISCHANGED(StageName),
ISPICKVAL(PRIORVALUE(StageName), &apos;Develop&apos;),
OR(ISPICKVAL(StageName, &apos;Define&apos;),ISPICKVAL(StageName, &apos;Qualify&apos;))),
AND(
ISCHANGED(StageName),
ISPICKVAL(PRIORVALUE(StageName), &apos;Define&apos;),
ISPICKVAL(StageName, &apos;Qualify&apos;))
),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id ))
)
)</errorConditionFormula>
        <errorMessage>Cannot move back to the previous stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Technical_Owner_Update_DR</fullName>
        <active>true</active>
        <description>Technical Owner update should be restricted for Opportunities which are created from Design Registration</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
NOT(CONTAINS($Label.Core_DataOpsProfile , $User.Id )),
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
ISPICKVAL(Core_Opportunity_Coverage_Nm__c,&apos;Partner-Led Opportunity&apos;) ,
Core_Design_Registration_Id__c !=null,
ISCHANGED(Core_Technical_Owner__c),
Core_Technical_Owner__r.Core_User_Type__c =&apos;External User&apos;,
$User.Id &lt;&gt; OwnerId 
))</errorConditionFormula>
        <errorDisplayField>Core_Technical_Owner__c</errorDisplayField>
        <errorMessage>Technical Owner cannot be updated for DR Converted Opportunities</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_SalesGroup_WithoutAccount</fullName>
        <active>false</active>
        <description>This Rule that will stop the creation of an Opportunity for an account without Sales Group</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
IF((TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Partner-Led Opportunity&apos; &amp;&amp; TEXT(Core_Coverage_Type_Nm__c) =&apos;Deal Registration&apos;)=TRUE, FALSE,
AND(
(ISCHANGED(AccountId))
&amp;&amp; (Core_Open_Oppty__c= 1)
&amp;&amp; AND(NOT(ISNEW()), NOT(ISCLONE()))
&amp;&amp; AND((ISPICKVAL(Account.Core_Sales_Groups__c, &apos;&apos;)) ||   (ISPICKVAL(Account.Core_Sales_Groups__c, &quot;Undefined&quot;)))
)
)
)</errorConditionFormula>
        <errorMessage>Opportunities cannot be created against accounts with an Undefined Sales Group. Please update the account with the correct Sales Group and then save your opportunity. BKM: You can update the Sales Group in a new window.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Sales_motion_date_validation</fullName>
        <active>true</active>
        <description>Sales motion date field validation</description>
        <errorConditionFormula>AND( 
    NOT($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c),
    NOT ( $Profile.Name == &apos;Sales Ops&apos; || 
          $Profile.Name == &apos;System Administrator&apos; || 
          $Profile.Name == &apos;Data Ops&apos; || 
          $Profile.Name == &apos;IT Admin&apos; || 
          $Profile.Name == &apos;Production Support&apos;
         ),

(( (ISCHANGED(POC_Start_Date__c) ||   ISCHANGED(POC_End_Date__c)) &amp;&amp; ( POC_Start_Date__c &gt;  POC_End_Date__c ) )  || 
 ( (ISCHANGED(FAD_Start_Date__c) ||   ISCHANGED(FAD_End_Date__c)) &amp;&amp; ( FAD_Start_Date__c &gt;  FAD_End_Date__c ) )  ||
 ( (ISCHANGED(RFP_Open_Date__c) ||   ISCHANGED(RFP_Close_Date__c))  &amp;&amp; ( RFP_Open_Date__c &gt; RFP_Close_Date__c ) ))
 )</errorConditionFormula>
        <errorMessage>End Date of all the Summary Date fields should be greater than or equal to Start Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Solution_Area_Required</fullName>
        <active>false</active>
        <description>If Opportunity Type equals any of the Deal Opportunity Types (Deal:  Sell-to, Deal:  Sell-through, Deal:  Sell-with, Deal:  Scale-Estimate (per Finance)), Solution Area is required to save the opportunity when creating or editing.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE || $Profile.Name  = &apos;Integration&apos;,FALSE, 
AND(RecordType.DeveloperName&lt;&gt;&apos;Core_Deal_Opportunity&apos;, ISBLANK ( TEXT(Core_Solution_Area__c) ), CONTAINS( TEXT(Core_Opportunity_Type__c) , &quot;Deal&quot;),  RecordType.Name != &apos;Solution Group&apos; ))</errorConditionFormula>
        <errorDisplayField>Core_Solution_Area__c</errorDisplayField>
        <errorMessage>Solution Area is Required on Deal opportunities.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_TechOwner_Check_OnCreate_Update</fullName>
        <active>true</active>
        <errorConditionFormula>IF(OR($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,$Profile.Name = &quot;Sales CRM API&quot;),FALSE,
AND(
		TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Intel-Led Opportunity&apos;,
		Core_Technical_Owner__c&lt;&gt; null,
		Core_Technical_Owner__r.Core_User_Type__c=&apos;External User&apos;,
		OR(ISNEW(),ISCHANGED(Core_Technical_Owner__c))
	)
)</errorConditionFormula>
        <errorDisplayField>Core_Technical_Owner__c</errorDisplayField>
        <errorMessage>A partner user can’t be selected as technical owner .Please select appropriate user to proceed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_TechOwner_Check_OnCreate_Update_DDR</fullName>
        <active>true</active>
        <description>Restriction of Partner-Led Opportunities</description>
        <errorConditionFormula>IF(OR($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,$Profile.Name = &quot;Sales CRM API&quot;),FALSE,
AND(
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
TEXT(Core_Opportunity_Coverage_Nm__c)=&apos;Partner-Led Opportunity&apos;,
Core_Technical_Owner__c&lt;&gt; null,
 Core_Technical_Owner__r.Core_User_Type__c =&apos;Internal User&apos;,
OR(ISNEW(),ISCHANGED(Core_Technical_Owner__c))
)
)</errorConditionFormula>
        <errorDisplayField>Core_Technical_Owner__c</errorDisplayField>
        <errorMessage>A partner must be the technical owner for Partner Opportunities. Please select an appropriate partner user to proceed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Uncovered_Account</fullName>
        <active>true</active>
        <description>To prevent the Opportunity for Uncovered Accounts Owners</description>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,
FALSE, AND(
NOT(CONTAINS(Name, &apos;Amendment&apos;)),
NOT(CONTAINS(Name, &apos;Renewal&apos;)),
NOT( ISPICKVAL(Core_Opportunity_Coverage_Nm__c, &apos;Partner-Led Opportunity&apos;) &amp;&amp; ISPICKVAL(Core_Coverage_Type_Nm__c, &apos;Deal Registration&apos;) ),
$Profile.Name &lt;&gt; &quot;Data Ops&quot;,
OR(ISNEW(), ISCLONE(), ISCHANGED(AccountId)),
CONTAINS(Account.Core_Account_Owner__c, &apos;Uncovered Account&apos;) 
)
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Opportunities cannot be created against uncovered accounts.  Please select a covered account or take ownership of the selected account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_VBSPotential_Check_for_creating_Opp</fullName>
        <active>true</active>
        <errorConditionFormula>$Profile.Name != &apos;Data Ops&apos; &amp;&amp; ISNEW() &amp;&amp;  !ISPICKVAL(StageName , &apos;Qualify&apos;) &amp;&amp; !ISPICKVAL(StageName , &apos;Define&apos;) &amp;&amp;  Core_VBS_Potential__c == true</errorConditionFormula>
        <errorMessage>You can create VBS potential Opportunities only in Qualify/Define stages.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_Push_Reason</fullName>
        <active>true</active>
        <description>Please enter Push Reason and Push Details</description>
        <errorConditionFormula>AND( NOT($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c),
    NOT (
          $Profile.Name == &apos;System Administrator&apos; || 
          $Profile.Name == &apos;Data Ops&apos;  || $Profile.Name == &apos;IT Admin&apos; || $Profile.Name == &apos;Core Integration&apos; || $Profile.Name == &apos;Partner&apos;
         ),
    
    OR(ISPICKVAL(StageName,&quot;Develop&quot;),
       ISPICKVAL(StageName,&quot;Design&quot;) 
       ),
    ISCHANGED(Core_Push_Counter__c),
Core_Push_Counter__c &gt; 0,
     ISPICKVAL(Push_Reason__c, &quot;&quot;), NOT(ISNEW())

)</errorConditionFormula>
        <errorDisplayField>Push_Reason__c</errorDisplayField>
        <errorMessage>Please enter Push Reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Validate_Push_Reason_Details</fullName>
        <active>true</active>
        <description>when Push Reason Details but change in Decision date more then month</description>
        <errorConditionFormula>AND( NOT($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c),
NOT (
$Profile.Name == &apos;System Administrator&apos; ||
$Profile.Name == &apos;Data Ops&apos;  || $Profile.Name == &apos;IT Admin&apos; ||  $Profile.Name == &apos;Core Integration&apos;  || $Profile.Name == &apos;Partner&apos;
),

OR(ISPICKVAL(StageName,&quot;Develop&quot;),
ISPICKVAL(StageName,&quot;Design&quot;)
),
ISCHANGED(Core_Push_Counter__c),Core_Push_Counter__c &gt; 0,
OR ( ISNULL(Push_Reason_Details__c),
ISBLANK(Push_Reason_Details__c)
), NOT(ISNEW())

)</errorConditionFormula>
        <errorDisplayField>Push_Reason_Details__c</errorDisplayField>
        <errorMessage>Please enter Push Reason Details</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_opportunity_forecast</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( ISPICKVAL( ForecastCategoryName ,&quot;Closed&quot; ),
       OR( ISPICKVAL( StageName , &quot;Qualify&quot;),
           ISPICKVAL( StageName , &quot;Define&quot; ),
           ISPICKVAL( StageName , &quot;Develop&quot;),
           ISPICKVAL( StageName , &quot;Design&quot;))
))</errorConditionFormula>
        <errorDisplayField>ForecastCategoryName</errorDisplayField>
        <errorMessage>Forecast cannot be changed to Closed for any Open Opportunity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_restrict_to_update_submitted_oppty</fullName>
        <active>true</active>
        <description>The Status of the opportunity cannot be changed to lost /cancelled/ production lost/ production cancelled once it is submitted for approval.</description>
        <errorConditionFormula>AND(

ISCHANGED(StageName),

OR(ISPICKVAL( Core_Approval_Status__c, &quot;Submitted&quot;),ISPICKVAL( Core_PW_Approval_Status__c, &quot;Submitted&quot;)),

OR(

ISPICKVAL( StageName,&quot;Lost&quot;),

ISPICKVAL( StageName,&quot;Cancelled&quot;),

ISPICKVAL( StageName,&quot;Production Lost&quot;),

ISPICKVAL(StageName,&quot;Production Cancelled&quot;)

)

)</errorConditionFormula>
        <errorMessage>This record is locked . The status cannot be changed once submitted for approval. If you need to edit it contact your admin.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LID__Check_CompanyId_Value</fullName>
        <active>true</active>
        <description>Throws an exception message if the company id contains non-numerics</description>
        <errorConditionFormula>AND(
	(LID__LinkedIn_Company_Id__c &lt;&gt; NULL),
	NOT(ISNUMBER(LID__LinkedIn_Company_Id__c))
)</errorConditionFormula>
        <errorDisplayField>LID__LinkedIn_Company_Id__c</errorDisplayField>
        <errorMessage>CompanyId should be a numeric value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LID__Check_Company_Id_Value</fullName>
        <active>true</active>
        <description>Throws an exception message if the company id contains non-numerics</description>
        <errorConditionFormula>AND(
	(LID__LinkedIn_Company_Id__c &lt;&gt; NULL),
	NOT(ISNUMBER(LID__LinkedIn_Company_Id__c))
)</errorConditionFormula>
        <errorDisplayField>LID__LinkedIn_Company_Id__c</errorDisplayField>
        <errorMessage>CompanyId should be a numeric value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Low_Touch_Admin_Check_on_Recall</fullName>
        <active>true</active>
        <description>When Low Touch Admin Users change any of the stages from Production Win to Qualify/Define/Develop/Design</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(StageName),
NOT(CRM_Reversed_By_Low_Touch_Admin__c),
TEXT(PRIORVALUE(StageName))=&apos;Production Win&apos; ,
OR(TEXT(StageName)=&apos;Qualify&apos;,TEXT(StageName)=&apos;Define&apos;,TEXT(StageName)=&apos;Develop&apos;,TEXT(StageName)=&apos;Design&apos;),
$Permission.Core_Sales_CRM_PartnerLed_LowTouch_Admin_Access))</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>Reversal is only possible from Reverse Button.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Opp_Stage_Update_By_Int_User</fullName>
        <active>true</active>
        <description>Restrict opportunity update by Azure integration user</description>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,
FALSE,
AND(
    ISCHANGED(StageName),
    $User.Username = &apos;azure@intel.com.crm&apos;
)
)</errorConditionFormula>
        <errorMessage>You are not authorized to update the opportunity stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>core_decisionDate_move</fullName>
        <active>true</active>
        <description>If Decision date move more than month user need to update Push Reason or Push Reason detail</description>
        <errorConditionFormula>AND( NOT($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c),
NOT (
$Profile.Name == &apos;System Administrator&apos; ||
$Profile.Name == &apos;Data Ops&apos; || $Profile.Name == &apos;IT Admin&apos; || $Profile.Name == &apos;Core Integration&apos;  || $Profile.Name == &apos;Partner&apos;
),

OR(ISPICKVAL(StageName,&quot;Develop&quot;),
ISPICKVAL(StageName,&quot;Design&quot;)
),
ISCHANGED(Core_Push_Counter__c),Core_Push_Counter__c &gt; 0,
NOT( ISCHANGED(Push_Reason_Details__c) ), NOT(ISNEW()) 


)</errorConditionFormula>
        <errorMessage>Opportunity has been pushed, please update the push reason and push reason details.</errorMessage>
    </validationRules>
