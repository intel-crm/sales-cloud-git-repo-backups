    <fields>
        <fullName>Core_Lost_Oppty__c</fullName>
        <description>This is a flag that will be used at reporting side to create calculations.
The value of this field is 1 when Opportunity Stage is either &quot;Lost&quot; or &quot;Cancelled&quot;; otherwise it will be 0.</description>
        <externalId>false</externalId>
        <formula>IF( OR( TEXT(StageName)  = &quot;Lost&quot; , TEXT(StageName)  = &quot;Cancelled&quot; ) , 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Lost Oppty</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Low_Power_Connectivity__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_Low_Power_Connectivity__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Low Power Connectivity</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Low_Quality__c</fullName>
        <description>One of the above metrics is set to true, thus indicating some form of low pipeline quality.</description>
        <formula>IF((Core_Past_Due__c || Core_Inactive__c ||  Core_Low_Velocity__c ||  Core_Pushes__c ),True,False)</formula>
        <label>Low Quality</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Low_Velocity__c</fullName>
        <description>Opptys that are approaching their decision date and have not progressed from the early stages are at increased risk of push or cancel/loss.</description>
        <formula>If( (ISPICKVAL(StageName,&apos;Qualify&apos;)  &amp;&amp; (TODAY()- CloseDate &gt;-30) &amp;&amp; (TODAY()- CloseDate &lt;90)),true,false)</formula>
        <label>Low Velocity</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MAG_Account__c</fullName>
        <description>Formula field that pulls the value of the MAG field on the related Account</description>
        <formula>Account.Core_Military_Aerospace_and_Government__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This field will default from the Account and is not editable. If the account is identified as a Military, Aerospace or Government account, this field will be checked which will automatically trigger a review by the export compliance team</inlineHelpText>
        <label>MAG Account</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MAG_Questionnaire_ID__c</fullName>
        <description>Salesforce ID of the MAG Questionnaire for this opportunity, if any</description>
        <externalId>false</externalId>
        <label>MAG Questionnaire ID</label>
        <length>18</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MAG_Questionnaire__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL(Core_Compliance_Sub_Status__c, &apos;AR - Owner to fill out MAG Questionnaire&apos;),
    HYPERLINK(
        Left($Api.Enterprise_Server_URL_190,(find(&apos;/services&apos;,$Api.Enterprise_Server_URL_190))) + &apos;apex/Core_MAGQuestionnaire?OpportunityId=&apos; + Id +
            IF(Core_MAG_Questionnaire_ID__c != &apos;&apos;,&apos;&amp;Id=&apos;+Core_MAG_Questionnaire_ID__c,&apos;&apos;),
        IMAGE(&apos;/servlet/servlet.FileDownload?file=015o0000001v9FB&apos;,&apos;Click Here to Fill Out MAG Questionnaire&apos;),
        &apos;_self&apos;),

    IF( ISPICKVAL(Core_Compliance_Sub_Status__c, &apos;AR - Owner to Respond to GEC Clarifying Questions&apos;),
        HYPERLINK(
            Left($Api.Enterprise_Server_URL_190,(find(&apos;/services&apos;,$Api.Enterprise_Server_URL_190))) + &apos;apex/Core_MAGQuestionnaire?OpportunityId=&apos; + Id +
                IF(Core_MAG_Questionnaire_ID__c != &apos;&apos;,&apos;&amp;Id=&apos;+Core_MAG_Questionnaire_ID__c,&apos;&apos;),
            IMAGE(&apos;/servlet/servlet.FileDownload?file=015o0000001v9FC&apos;,&apos;Responses to GEC Clarifying Questions Required on MAG Questionnaire&apos;),
            &apos;_self&apos;),
        HYPERLINK(
            Left($Api.Enterprise_Server_URL_190,(find(&apos;/services&apos;,$Api.Enterprise_Server_URL_190))) + &apos;apex/Core_MAGQuestionnaire?OpportunityId=&apos; + Id +
                IF(Core_MAG_Questionnaire_ID__c != &apos;&apos;,&apos;&amp;Id=&apos;+Core_MAG_Questionnaire_ID__c,&apos;&apos;),
            &apos;MAG Questionnaire&apos;,
            &apos;_self&apos;)
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>MAG Questionnaire</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
