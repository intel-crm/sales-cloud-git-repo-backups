        <fullName>Core_Volume__c</fullName>
        <description>The estimated first full year of production units based on customer input and Sales Owner / Tech Owner best judgment. Enter actual quantity, not quantity in thousands</description>
        <externalId>false</externalId>
        <inlineHelpText>1st year of full volume production (after ramp up)</inlineHelpText>
        <label>Volume</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Number</type>
