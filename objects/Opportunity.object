    <fields>
        <fullName>CRM_IsLowTouchAdmin_Chk__c</fullName>
        <formula>AND(
$Permission.Core_Sales_CRM_PartnerLed_LowTouch_Admin_Access,
RecordType.DeveloperName = &apos;Core_Design_Opportunity&apos;,
TEXT(Core_Opportunity_Coverage_Nm__c) = &apos;Partner-Led Opportunity&apos;,
TEXT(Core_Coverage_Type_Nm__c) = &apos;Disti Design Registration Low&apos;, 
OR(TEXT(Core_Approval_Status__c) = &apos;&apos; ,TEXT(Core_Approval_Status__c) = &apos;Not Submitted&apos;,TEXT(Core_Approval_Status__c) = &apos;Recalled&apos;,TEXT(Core_Approval_Status__c) = &apos;Rejected&apos;),
OR(TEXT(Core_PW_Approval_Status__c) = &apos;&apos;,TEXT(Core_PW_Approval_Status__c) = &apos;Not Submitted&apos;,TEXT(Core_PW_Approval_Status__c)=&apos;Recalled&apos;,TEXT(Core_PW_Approval_Status__c) = &apos;Rejected&apos;)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>isLowTouchAdmin</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
