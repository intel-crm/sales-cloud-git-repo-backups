    <fields>
        <fullName>Core_Pipeline_Heath__c</fullName>
        <formula>IF(
(Core_Past_Due__c || Core_Inactive__c || Core_Low_Velocity__c )&amp;&amp;
 (ISPICKVAL(StageName, &apos;Qualify&apos;) || ISPICKVAL(StageName, &apos;Define&apos;) || ISPICKVAL(StageName, &apos;Develop&apos;) || ISPICKVAL(StageName, &apos;Design&apos;)),True,False)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Pipeline Health</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Platform_Status__c</fullName>
        <description>Status of the platform</description>
        <label>Platform Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Cancelled Platform</fullName>
                    <default>false</default>
                    <label>Cancelled Platform</label>
                </value>
                <value>
                    <fullName>Incomplete Platform</fullName>
                    <default>false</default>
                    <label>Incomplete Platform</label>
                </value>
                <value>
                    <fullName>Lost Platform</fullName>
                    <default>false</default>
                    <label>Lost Platform</label>
                </value>
                <value>
                    <fullName>Non-ATS Qualified Platform</fullName>
                    <default>false</default>
                    <label>Non-ATS Qualified Platform</label>
