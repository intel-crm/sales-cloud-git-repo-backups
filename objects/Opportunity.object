        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_CPU__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>CPU</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Calculated_Sales_Group__c</fullName>
        <description>Formula field to calculate the Sales Group. The calculation depends on the following fields

Account.Core_Global_Account__c (New Field to indicate the Global Account)
Core_System_Sales_Segment_Count__c (New Field that has a count of of values in Core_Sales_Segments__c)
Core_Opportunity_Type__c</description>
        <externalId>false</externalId>
        <formula>IF(Core_System_Sales_Segment_Count__c &gt; 0 &amp;&amp; Account.Core_Global_Account__c = true, &quot;Global Accounts&quot;, 

IF(Core_System_Sales_Segment_Count__c = 1 &amp;&amp; INCLUDES(Core_Sales_Segments__c, &apos;Influencer&apos;), &quot;Industry Sales&quot;, 
IF(Core_System_Sales_Segment_Count__c = 1 &amp;&amp; (INCLUDES(Core_Sales_Segments__c, &apos;Compute&apos;) || INCLUDES(Core_Sales_Segments__c, &apos;Embedded&apos;) || INCLUDES(Core_Sales_Segments__c, &apos;Reseller/Channel&apos;) || INCLUDES(Core_Sales_Segments__c, &apos;Distributor/Channel&apos;)), &quot;Regional Sales&quot;, 

IF(INCLUDES(Core_Sales_Segments__c, &apos;Influencer&apos;) &amp;&amp; CONTAINS(TEXT(Core_Opportunity_Type__c), &apos;Deal&apos;), &quot;Industry Sales&quot;, 
IF(INCLUDES(Core_Sales_Segments__c, &apos;Influencer&apos;) &amp;&amp; CONTAINS(TEXT(Core_Opportunity_Type__c), &apos;Design&apos;), &quot;Regional Sales&quot;, 

IF(Core_System_Sales_Segment_Count__c &gt; 1 &amp;&amp; !INCLUDES(Core_Sales_Segments__c, &apos;Influencer&apos;) &amp;&amp; CONTAINS(TEXT(Core_Opportunity_Type__c), &apos;Deal&apos;), &quot;Regional Sales&quot;, 
IF(Core_System_Sales_Segment_Count__c &gt; 1 &amp;&amp; !INCLUDES(Core_Sales_Segments__c, &apos;Influencer&apos;) &amp;&amp; CONTAINS(TEXT(Core_Opportunity_Type__c), &apos;Design&apos;), &quot;Regional Sales&quot;, &quot;&quot; 
)))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Calculated Sales Group</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
