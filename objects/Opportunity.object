    <fields>
        <fullName>Core_Standard_Customer_Refresh__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Standard Customer Refresh ITAR Review Exception:  Intel BDM/TME/FSE/FAE provides MAG customer with standard Intel roadmap and product guidance to assist in fulfillment of standard PC, tablet, workstation or server procurement through an OEM or channel supplier.  The BDM/TME/FSE/FAE is not engaged in solutions architected or modified for military or aerospace specific application, or SW optimization or services, and is not engaged in discussions regarding the export of technology or solutions that are for military use or application.</description>
        <inlineHelpText>Indicates that the opportunity qualifies for the &quot;Standard Customer Refresh ITAR Review Exception.&quot; For full definition, see the popup message displayed when checking this box.</inlineHelpText>
        <label>Standard Customer Refresh</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Status_Update_Check__c</fullName>
        <description>Value  &apos;1&apos; get populated when &apos;status update&apos; field is not null. The value gets populated by a workflow.  This is being used in a report, which is developed to show the percentage of opportunities where the data is completed for the items we are checking in the Pre Submit Check functionality on opportunities.</description>
        <externalId>false</externalId>
        <label>Is Blank Status Update</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Status_Update__c</fullName>
        <description>Status Update</description>
        <inlineHelpText>A free text field for you to enter the current status. 
Suggested format  
[mm/dd/yy] Status
Major risks: none
Key actions: none
Further comments:</inlineHelpText>
        <label>Status Update</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>6</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Storm_Lake__c</fullName>
        <externalId>false</externalId>
