    <fields>
        <fullName>Core_Opportunity_Activity_Measure__c</fullName>
        <description>Whether an Opportunity has experienced activity within the last 30 days</description>
        <externalId>false</externalId>
        <formula>IF((TODAY() - Core_Last_Activity_Date__c ) &lt;= 30, &quot;Activity Within Last 30 Days&quot;, &quot;No Activity Within Last 30 Days&quot;)</formula>
        <inlineHelpText>Whether an Opportunity has experienced activity within the last 30 days</inlineHelpText>
        <label>Opportunity Activity Measure</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
