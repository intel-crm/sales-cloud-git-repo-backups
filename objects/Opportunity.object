    <fields>
        <fullName>Core_Loss_Cancel_Reason__c</fullName>
        <description>Reason why the Opportunity was lost or cancelled</description>
        <inlineHelpText>The main reason the opportunity was Lost or Cancelled. Only editable when the opportunity stage is changed to Lost or Cancelled.</inlineHelpText>
        <label>Loss/Cancel Reason</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <controllingField>StageName</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Another IA Bid Selected</fullName>
                    <default>false</default>
                    <label>Another IA Bid Selected </label>
                </value>
                <value>
                    <fullName>Intel No Longer Pursuing</fullName>
                    <default>false</default>
                    <label>Intel No Longer Pursuing </label>
                </value>
                <value>
                    <fullName>Other (refer to Loss Details)</fullName>
                    <default>false</default>
                    <label>Other (refer to Loss Details) </label>
                </value>
                <value>
                    <fullName>Price</fullName>
                    <default>false</default>
                    <label>Price </label>
                </value>
                <value>
                    <fullName>Product Schedule</fullName>
                    <default>false</default>
                    <label>Product Schedule </label>
                </value>
                <value>
                    <fullName>Supply</fullName>
                    <default>false</default>
                    <label>Supply </label>
                </value>
                <value>
                    <fullName>Customer Discontinued Project</fullName>
                    <default>false</default>
                    <label>Customer Discontinued Project </label>
                </value>
                <value>
                    <fullName>Entered in Error</fullName>
                    <default>false</default>
                    <label>Entered in Error </label>
                </value>
                <value>
                    <fullName>POP Unobtainable</fullName>
                    <default>false</default>
                    <label>POP Unobtainable </label>
                </value>
                <value>
                    <fullName>Feature/Performance</fullName>
                    <default>false</default>
                    <label>Feature/Performance</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>Lost</controllingFieldValue>
                <controllingFieldValue>Production Lost</controllingFieldValue>
                <valueName>Another IA Bid Selected</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Lost</controllingFieldValue>
                <controllingFieldValue>Production Lost</controllingFieldValue>
                <valueName>Intel No Longer Pursuing</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Lost</controllingFieldValue>
                <controllingFieldValue>Production Lost</controllingFieldValue>
                <valueName>Other (refer to Loss Details)</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Lost</controllingFieldValue>
                <controllingFieldValue>Production Lost</controllingFieldValue>
                <valueName>Price</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Lost</controllingFieldValue>
                <controllingFieldValue>Production Lost</controllingFieldValue>
                <valueName>Product Schedule</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Lost</controllingFieldValue>
                <controllingFieldValue>Production Lost</controllingFieldValue>
                <valueName>Supply</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Lost</controllingFieldValue>
                <controllingFieldValue>Cancelled</controllingFieldValue>
                <controllingFieldValue>Production Cancelled</controllingFieldValue>
                <valueName>Customer Discontinued Project</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Lost</controllingFieldValue>
                <controllingFieldValue>Cancelled</controllingFieldValue>
                <controllingFieldValue>Production Cancelled</controllingFieldValue>
                <valueName>Entered in Error</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Lost</controllingFieldValue>
                <controllingFieldValue>Cancelled</controllingFieldValue>
                <controllingFieldValue>Production Cancelled</controllingFieldValue>
                <valueName>POP Unobtainable</valueName>
            </valueSettings>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Lost_Oppty__c</fullName>
        <description>This is a flag that will be used at reporting side to create calculations.
The value of this field is 1 when Opportunity Stage is either &quot;Lost&quot; or &quot;Cancelled&quot;; otherwise it will be 0.</description>
        <externalId>false</externalId>
        <formula>IF( OR( TEXT(StageName)  = &quot;Lost&quot; , TEXT(StageName)  = &quot;Cancelled&quot; ) , 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Lost Oppty</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Low_Power_Connectivity__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_Low_Power_Connectivity__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Low Power Connectivity</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Low_Quality__c</fullName>
        <description>One of the above metrics is set to true, thus indicating  form of low pipeline quality.</description>
        <formula>IF((Core_Past_Due__c || Core_Inactive__c ||  Core_Low_Velocity__c ||  Core_Pushes__c )&amp;&amp;  (ISPICKVAL(StageName, &apos;Qualify&apos;) || ISPICKVAL(StageName, &apos;Define&apos;) || ISPICKVAL(StageName, &apos;Develop&apos;) || ISPICKVAL(StageName, &apos;Design&apos;)),True,False)</formula>
        <label>Low Quality</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Low_Velocity__c</fullName>
        <description>Opptys that are approaching their decision date and have not progressed from the early stages are at increased risk of push or cancel/loss.</description>
        <formula>If(((TODAY()- CloseDate &gt;-60) 
&amp;&amp; (TODAY()- CloseDate&lt;=90)&amp;&amp; 
(OR((ISPICKVAL(StageName, &apos;Qualify&apos;)),ISPICKVAL(StageName, &apos;Define&apos;)) )),true,false)</formula>
        <label>Low Velocity</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Low_pipeline_confidence__c</fullName>
        <formula>Core_Past_Due__c || Core_Pushes__c || Core_Oppty_with_No_Products__c || Core_Low_stage_progression__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Low pipeline confidence</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Low_stage_progression__c</fullName>
        <formula>(ISPICKVAL(StageName, &apos;Qualify&apos;) || ISPICKVAL(StageName, &apos;Define&apos;)) &amp;&amp; 
(OR(
    AND(
        CEILING( MONTH( CloseDate ) / 3 ) = CEILING( MONTH( TODAY() ) / 3 ),
        YEAR( CloseDate ) = YEAR( TODAY() )
        ),
    AND(
        CEILING( MONTH( CloseDate ) / 3 ) = CEILING( MONTH( ADDMONTHS(TODAY(),3) ) / 3 ),
        YEAR( CloseDate ) = YEAR( ADDMONTHS(TODAY(),3))
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Low stage progression</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MAG_Account__c</fullName>
        <description>Formula field that pulls the value of the MAG field on the related Account</description>
        <formula>Account.Core_Military_Aerospace_and_Government__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This field will default from the Account and is not editable. If the account is identified as a Military, Aerospace or Government account, this field will be checked which will automatically trigger a review by the export compliance team</inlineHelpText>
        <label>MAG Account</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MAG_Questionnaire_ID__c</fullName>
        <description>Salesforce ID of the MAG Questionnaire for this opportunity, if any</description>
        <externalId>false</externalId>
        <label>MAG Questionnaire ID</label>
        <length>18</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
