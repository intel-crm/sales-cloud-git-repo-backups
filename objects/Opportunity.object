    <fields>
        <fullName>Core_Wins_Oppty__c</fullName>
        <description>This is a flag that will be used at reporting side to create calculations.
The value of this field is 1 when Opportunity Stage is &quot;Design Win&quot;; otherwise it will be 0.</description>
        <externalId>false</externalId>
        <formula>IF(OR(ISPICKVAL(StageName, &apos;Design Win&apos;), ISPICKVAL(StageName, &apos;Production Win&apos;), ISPICKVAL(StageName, &apos;Production Lost&apos;), ISPICKVAL(StageName, &apos;Production Cancelled&apos;)),
	1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Wins Oppty</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
