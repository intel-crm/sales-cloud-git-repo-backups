    <fields>
        <fullName>Core_Weighted_U__c</fullName>
        <description>This field multiplies the sum of product quantity at opportunity level by Probability %, it will be used at reporting side to create calculations.</description>
        <externalId>false</externalId>
        <formula>Probability  *    Core_Opportunity_U__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Weighted (U)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_WiFi__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_WiFi__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>WiFi</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Wins_Oppty__c</fullName>
        <description>This is a flag that will be used at reporting side to create calculations.
The value of this field is 1 when Opportunity Stage is &quot;Design Win&quot;; otherwise it will be 0.</description>
        <externalId>false</externalId>
        <formula>IF(OR(ISPICKVAL(StageName, &apos;Design Win&apos;), ISPICKVAL(StageName, &apos;Production Win&apos;), ISPICKVAL(StageName, &apos;Production Lost&apos;), ISPICKVAL(StageName, &apos;Production Cancelled&apos;)),
	1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Wins Oppty</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
