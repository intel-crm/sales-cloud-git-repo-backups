    <fields>
        <fullName>Core_Participating_Geos__c</fullName>
        <description>Reporting - Opportunity Participating Geos</description>
        <externalId>false</externalId>
        <formula>if(Core_Opportunity_Geo_APJ__c,
if(Core_Opportunity_Geo_ASMO__c, 
		if(Core_Opportunity_Geo_EMEA__c, 
			if(Core_Opportunity_Geo_PRC__c, 
				&quot;APJ,ASMO,EMEA,PRC&quot;, 								&quot;APJ,ASMO,EMEA&quot;), 
		if(Core_Opportunity_Geo_PRC__c, 
			&quot;APJ,ASMO,PRC&quot;, 
		&quot;APJ,ASMO&quot;)),
	 if(Core_Opportunity_Geo_EMEA__c, 
		if(Core_Opportunity_Geo_PRC__c,&quot;ASMO,EMEA,PRC&quot;, 
		&quot;APJ,EMEA&quot;),
	if(Core_Opportunity_Geo_PRC__c,&quot;APJ,PRC&quot;, 
	&quot;APJ&quot;))),
if(Core_Opportunity_Geo_ASMO__c, 
	if(Core_Opportunity_Geo_EMEA__c,
		if(Core_Opportunity_Geo_PRC__c, &quot;ASMO,EMEA,PRC&quot;, 
		&quot;ASMO,EMEA&quot;),
	if(Core_Opportunity_Geo_PRC__c, &quot;ASMO,PRC&quot;, 
	&quot;ASMO&quot;)),
if(Core_Opportunity_Geo_EMEA__c, 
	if(Core_Opportunity_Geo_PRC__c,&quot;EMEA,PRC&quot;, 
	&quot;EMEA&quot;),
if(Core_Opportunity_Geo_PRC__c,&quot;PRC&quot;, &quot;&quot;)
)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Participating Regions</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Past_Due__c</fullName>
        <formula>If((CloseDate-TODAY()  &lt; -30 &amp;&amp; (ISPICKVAL(StageName, &apos;Qualify&apos;) || ISPICKVAL(StageName, &apos;Define&apos;) || ISPICKVAL(StageName, &apos;Develop&apos;) || ISPICKVAL(StageName, &apos;Design&apos;))),true,false)</formula>
        <label>Past Due</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Pending_Product_Count__c</fullName>
        <description>Number of &quot;Pending&quot; products in this opportunity. Used to make sure opportunity approval submissions have at least one.</description>
        <label>Pending Product Count</label>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Status__c</field>
            <operation>equals</operation>
