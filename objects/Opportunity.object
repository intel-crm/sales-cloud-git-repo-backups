    <fields>
        <fullName>Core_Opportunity_Team_Geos__c</fullName>
        <description>Reporting: Opportunity Team&apos;s Geos</description>
        <externalId>false</externalId>
        <formula>LEFT( IF(Core_Opportunity_Team_Geo_APJ__c, &quot;APJ,&quot;, &quot;&quot;) &amp;     
IF(Core_Opportunity_Team_Geo_ASMO__c, &quot;ASMO,&quot;, &quot;&quot;) &amp;     
IF(Core_Opportunity_Team_Geo_EMEA__c, &quot;EMEA,&quot;, &quot;&quot;) &amp;     
IF(Core_Opportunity_Team_Geo_PRC__c, &quot;PRC,&quot;, &quot;&quot;)&amp;
IF(CRM_Opportunity_Team_Geo_INDIA__c,&quot;INDIA,&quot;,&quot;&quot;),     
LEN(IF(Core_Opportunity_Team_Geo_APJ__c, &quot;APJ,&quot;, &quot;&quot;) &amp;         
IF(Core_Opportunity_Team_Geo_ASMO__c, &quot;ASMO,&quot;, &quot;&quot;) &amp;         
IF(Core_Opportunity_Team_Geo_EMEA__c, &quot;EMEA,&quot;, &quot;&quot;) &amp;         
IF(Core_Opportunity_Team_Geo_PRC__c, &quot;PRC,&quot;, &quot;&quot;)&amp; 
IF(CRM_Opportunity_Team_Geo_INDIA__c,&quot;INDIA,&quot;,&quot;&quot;)) - 1 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Team Regions</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Type__c</fullName>
        <description>Opportunity Type</description>
        <inlineHelpText>Indicates whether opportunity is a Deal (bringing Intel based solutions to market) or Design (designing Intel products into customer applications). For Deal and Design definitions, please visit: goto/dealvsdesign</inlineHelpText>
        <label>Opportunity Type</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Design: Original</fullName>
                    <default>false</default>
                    <label>Design: Original</label>
                </value>
                <value>
                    <fullName>Design: Secondary</fullName>
                    <default>false</default>
                    <label>Design: Secondary</label>
                </value>
                <value>
                    <fullName>Design: Software-enable</fullName>
                    <default>false</default>
                    <label>Design: Software-enable</label>
                </value>
                <value>
                    <fullName>Deal: Partner Scale-enable</fullName>
                    <default>false</default>
                    <label>Deal: Partner Scale-enable</label>
                </value>
                <value>
                    <fullName>Deal: Sell-through</fullName>
                    <default>false</default>
                    <label>Deal: Sell-through</label>
                </value>
                <value>
                    <fullName>Deal: Sell-to</fullName>
                    <default>false</default>
                    <label>Deal: Sell-to</label>
                </value>
                <value>
                    <fullName>Deal - Sell To</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Deal - Sell To</label>
                </value>
                <value>
                    <fullName>Deal: Scale-Estimate (per Finance)</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Deal: Scale-Estimate (per Finance)</label>
                </value>
                <value>
                    <fullName>Deal: Scale-enable</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Deal: Scale-enable</label>
                </value>
                <value>
                    <fullName>Deal: Sell-with</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Deal: Sell-with</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
