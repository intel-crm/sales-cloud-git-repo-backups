    <fields>
        <fullName>Core_Participating_Geos__c</fullName>
        <description>Reporting - Opportunity Participating Geos</description>
        <externalId>false</externalId>
        <formula>LEFT( IF(Core_Opportunity_Geo_APJ__c, &quot;APJ,&quot;, &quot;&quot;) &amp;     
IF(Core_Opportunity_Geo_ASMO__c, &quot;ASMO,&quot;, &quot;&quot;) &amp;     
IF(Core_Opportunity_Geo_EMEA__c, &quot;EMEA,&quot;, &quot;&quot;) &amp;     
IF(Core_Opportunity_Geo_PRC__c, &quot;PRC,&quot;, &quot;&quot;) &amp;
IF(CRM_Opportunity_Geo_INDIA__c, &quot;INDIA,&quot;,&quot;&quot;),     
LEN(IF(Core_Opportunity_Geo_APJ__c, &quot;APJ,&quot;, &quot;&quot;) &amp;         
IF(Core_Opportunity_Geo_ASMO__c, &quot;ASMO,&quot;, &quot;&quot;) &amp;         
IF(Core_Opportunity_Geo_EMEA__c, &quot;EMEA,&quot;, &quot;&quot;) &amp;         
IF(Core_Opportunity_Geo_PRC__c, &quot;PRC,&quot;, &quot;&quot;)&amp;
IF(CRM_Opportunity_Geo_INDIA__c, &quot;INDIA,&quot;,&quot;&quot;)) - 1 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Participating Regions</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_PastDue_FlowUpdate__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is updated from flow Core_Opp_PastDueUpdate</description>
        <label>PastDue FlowUpdate</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Past_Due__c</fullName>
        <formula>IF(CloseDate-TODAY() &lt; 0 &amp;&amp; (ISPICKVAL(StageName, &apos;Qualify&apos;) || ISPICKVAL(StageName, &apos;Define&apos;) || ISPICKVAL(StageName, &apos;Develop&apos;) 
|| ISPICKVAL(StageName, &apos;Design&apos;)) &amp;&amp; (NOT(ISPICKVAL( Core_Approval_Status__c, &apos;Submitted&apos;))), true, false)</formula>
        <label>Past Due</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Pending_Product_Count__c</fullName>
        <description>Number of &quot;Pending&quot; products in this opportunity. Used to make sure opportunity approval submissions have at least one.</description>
        <label>Pending Product Count</label>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Status__c</field>
            <operation>equals</operation>
            <value>Pending</value>
        </summaryFilterItems>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
