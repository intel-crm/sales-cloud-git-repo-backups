    <fields>
        <fullName>AccountId</fullName>
        <inlineHelpText>Customer name for whom the opportunity is created and tracked.</inlineHelpText>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>notEqual</operation>
                <value>Intel Ultimate Account, Inactive Account,CoMarketing</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Covered_Account__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <infoMessage>Please Note: Your search results are restricted to show only Covered Accounts.</infoMessage>
            <isOptional>false</isOptional>
        </lookupFilter>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Amount</fullName>
        <inlineHelpText>System calculated value of all pending and won products (Price x Quantity) included on the opportunity; also known as unweighted value.  Does not include lost or cancelled line items and cannot be edited.</inlineHelpText>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>true</trackTrending>
    </fields>
    <fields>
        <fullName>CampaignId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CloseDate</fullName>
        <inlineHelpText>The expected date the customer will make decision to award opportunity AND it can be submitted for approval. 
This date should be continuously updated based on customer input. More details here: goto/claimdesignwin</inlineHelpText>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>true</trackTrending>
    </fields>
    <fields>
        <fullName>ContractId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Account_Country__c</fullName>
        <externalId>false</externalId>
        <formula>Account.BillingCountry</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Country</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Ambient_Temp_Req__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_Ambient_Temp_Req__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ambient Temp Req</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Approval_Status__c</fullName>
        <description>Show the current approval status and is not editable</description>
        <inlineHelpText>Displays the current approval status and is not editable.</inlineHelpText>
        <label>Approval Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Not Submitted</fullName>
                    <default>true</default>
                    <label>Not Submitted</label>
                </value>
                <value>
                    <fullName>Submitted</fullName>
                    <default>false</default>
                    <label>Submitted</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>Recalled</fullName>
                    <default>false</default>
                    <label>Recalled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Approved_By__c</fullName>
        <description>Stores the user the last approved the Opportunity, so we can take a snapshot at the Opportunity Product level</description>
        <externalId>false</externalId>
        <label>Approved By</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Approved_Date__c</fullName>
        <description>Stores the date/time that the Opportunity was last approved, so we can take a snapshot at the Opportunity Product level</description>
        <label>Approved Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Approved_Opportunity_Coverage__c</fullName>
        <externalId>false</externalId>
        <label>Approved Opportunity Coverage</label>
        <length>80</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Approved_Opportunity_Region__c</fullName>
        <description>Stores the Region of the Opportunity Owner when the Opportunity goes into any of these Stages for the first time - Design Win, Production Win, Lost, Cancelled. The field will not be updated once set.</description>
        <externalId>false</externalId>
        <label>Approved Opportunity Region</label>
        <length>25</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Approved_Sales_Group__c</fullName>
        <description>Formula field to show the first approved sales group. This value will show up if the Stage is &apos;Design Win&apos; or &apos;Production Win&apos; or &apos;Production Lost&apos; or &apos;Production Cancelled&apos;.</description>
        <externalId>false</externalId>
        <formula>IF(OR(ISPICKVAL(StageName, &quot;Design Win&quot;), ISPICKVAL(StageName, &quot;Production Win&quot;), ISPICKVAL(StageName, &quot;Production Lost&quot;), ISPICKVAL(StageName, &quot;Production Cancelled&quot;)),
	Core_System_First_Approved_Sales_Group__c, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Approved Sales Group</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
