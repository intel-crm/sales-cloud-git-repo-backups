    <fields>
        <fullName>Core_Won_Product_Count__c</fullName>
        <description>Number of products that are &quot;Win Approved&quot;. Used in a validation rule to prevent (non-admin) users from deleting Win Approved products.</description>
        <label>Won Product Count</label>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Status__c</field>
            <operation>equals</operation>
            <value>Win Approved, Production Win, Production Lost, Production Cancelled</value>
        </summaryFilterItems>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_Write_In_Product_Count__c</fullName>
        <description>Roll-up Summary field helps to check whether &quot;Write in Product&quot; exists in Opportunity Products ( Value should be &quot;Zero&quot; for the user to submit Opportunity for Approval ( User Story: 14406 )</description>
        <label>Write In Product Count</label>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Write_In_Product_Flag__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Status__c</field>
            <operation>notEqual</operation>
            <value>On Hold</value>
        </summaryFilterItems>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
