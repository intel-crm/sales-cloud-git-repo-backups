    <validationRules>
        <fullName>Core_Opp_Restrict_Closing_Opportunity</fullName>
        <active>true</active>
        <description>Restricts closing of an Opportunity if an Account is not approved</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(
Account.Core_Approved_Account__c = FALSE, 

OR(
text(StageName) = &quot;Design Win&quot;, 
text(StageName) = &quot;Production Win&quot;, 
text(StageName) = &quot;Production Lost&quot;, 
text(StageName) = &quot;Production Cancelled&quot;, 
text(StageName) = &quot;Lost&quot;, 
text(StageName) = &quot;Cancelled&quot;))
)</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>You cannot close an Opportunity on an Account that is not approved (Stage cannot be Design Win, Production Win, Production Lost, Production Cancelled, Lost, or Cancelled)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_SubmitApproveNotLessThanCreated</fullName>
        <active>true</active>
        <description>US64659 - Added validation date submitted for approval cannot have a lesser value than the created date.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(NOT(ISBLANK(Core_Date_Submitted_for_Approval__c)),  Core_Date_Submitted_for_Approval__c &lt; Core_Converted_Created_Date__c)

)</errorConditionFormula>
        <errorDisplayField>Core_Date_Submitted_for_Approval__c</errorDisplayField>
        <errorMessage>Date Submitted for Approval cannot be less than the Created Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Opp_Won_To_Pending</fullName>
        <active>true</active>
        <description>Prevent won opportunities from changing to a previous Stage.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(ISCHANGED(StageName),
  OR(
    ISPICKVAL(PRIORVALUE(StageName), &apos;Design Win&apos;),
    ISPICKVAL(PRIORVALUE(StageName), &apos;Production Win&apos;),
    ISPICKVAL(PRIORVALUE(StageName), &apos;Production Lost&apos;),
    ISPICKVAL(PRIORVALUE(StageName), &apos;Production Cancelled&apos;)
  ),
  NOT(OR(
    ISPICKVAL(StageName, &apos;Design Win&apos;),
    ISPICKVAL(StageName, &apos;Production Win&apos;),
    ISPICKVAL(StageName, &apos;Production Lost&apos;),
    ISPICKVAL(StageName, &apos;Production Cancelled&apos;)
  )),
  $Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
  $Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name)
)</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>Won opportunities cannot be changed to a previous Stage.  If this opportunity was approved in error, please have the approving manager set the products back to pending and revert the Stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Oppty_Decision_Date_In_Future</fullName>
        <active>true</active>
        <description>US41260: Opportunity:   Prevent (or alert) users from selecting a decision date in the past (SR-02442)</description>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,
FALSE, 
IF(($Profile.Name == &apos;Sales Ops&apos; || $Profile.Name == &apos;System Administrator&apos; || $Profile.Name == &apos;Data Ops&apos; || $Profile.Name == &apos;IT Admin&apos; || $Profile.Name == &apos;Production Support&apos;),
FALSE, 
(ISNEW() || ISCHANGED(CloseDate)) &amp;&amp; CloseDate &lt; TODAY()
)
)</errorConditionFormula>
        <errorDisplayField>CloseDate</errorDisplayField>
        <errorMessage>Past Decision Dates are invalid. Please enter a future Decision Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Solution_Area_Required</fullName>
        <active>true</active>
        <description>If Opportunity Type equals any of the Deal Opportunity Types (Deal:  Sell-to, Deal:  Sell-through, Deal:  Sell-with, Deal:  Scale-Estimate (per Finance)), Solution Area is required to save the opportunity when creating or editing.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND( ISBLANK ( TEXT(Core_Solution_Area__c) ), CONTAINS( TEXT(Core_Opportunity_Type__c) , &quot;Deal&quot;)))</errorConditionFormula>
        <errorDisplayField>Core_Solution_Area__c</errorDisplayField>
        <errorMessage>Solution Area is Required on Deal opportunities.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Uncovered_Account</fullName>
        <active>true</active>
        <description>To prevent the Opportunity for Uncovered Accounts Owners</description>
        <errorConditionFormula>IF(
$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,
FALSE, AND(OR(ISNEW(), ISCLONE(), ISCHANGED(AccountId)), 
   Account.Core_Covered_Account__c=FALSE)

)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Opportunities cannot be created against uncovered accounts.  Please select a covered account or take ownership of the selected account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LID__Check_CompanyId_Value</fullName>
        <active>true</active>
        <description>Throws an exception message if the company id contains non-numerics</description>
        <errorConditionFormula>AND(
	(LID__LinkedIn_Company_Id__c &lt;&gt; NULL),
	NOT(ISNUMBER(LID__LinkedIn_Company_Id__c))
)</errorConditionFormula>
        <errorDisplayField>LID__LinkedIn_Company_Id__c</errorDisplayField>
        <errorMessage>CompanyId should be a numeric value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>x_Core_1Opp_Reason_if_Lost</fullName>
        <active>false</active>
        <description>Require a value in the Reason field if the stage is set to Lost or Cancelled</description>
        <errorConditionFormula>AND(
NOT(Core_Bypass_Field_Validation__c), 
ISBLANK(TEXT(Core_Loss_Cancel_Reason__c)),
OR( 
text(StageName) = &quot;Lost&quot;,
text(StageName) = &quot;Cancelled&quot;))</errorConditionFormula>
        <errorDisplayField>Core_Loss_Cancel_Reason__c</errorDisplayField>
        <errorMessage>Loss/Cancel Reason is required if Stage is set to Lost or Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>x_Core_Opp_Req_Account_Role</fullName>
        <active>false</active>
        <description>Require Account Role if Sales Segment is Embedded or Compute</description>
        <errorConditionFormula>AND(
	ISBLANK( TEXT( Core_Role_on_Opportunity__c ) ),
	NOT(AND(Core_Lead_Conversion_Flag__c, ISNEW())), 
	NOT(AND(PRIORVALUE(Core_Lead_Conversion_Flag__c)=TRUE, Core_Lead_Conversion_Flag__c=FALSE)),
	RecordType.Name &lt;&gt; $Label.Core_Solution_Group_Record_Type,
	RecordType.Name &lt;&gt; $Label.Core_New_Solution_Group_Record_Type,
	NOT(OR(ISCHANGED(Core_Opportunity_Team_Geo_APJ__c),
	       ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c),
	       ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c),
	       ISCHANGED(Core_Opportunity_Team_Geo_PRC__c),
               ISCHANGED(Core_OSC_Collaboration_Type__c))),

	OR(
		INCLUDES(Core_Sales_Segments__c, &quot;Embedded&quot;), 
		INCLUDES(Core_Sales_Segments__c, &quot;Compute&quot;)
	)
)</errorConditionFormula>
        <errorDisplayField>Core_Role_on_Opportunity__c</errorDisplayField>
        <errorMessage>Role on Opportunity is required if Sales Segment is set to Compute or Embedded</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>x_Core_Opp_Req_Sales_Model</fullName>
        <active>false</active>
        <description>Require Sales Model if Sales Segment is Influencer</description>
        <errorConditionFormula>AND( 
	ISBLANK( TEXT( Core_Sales_Model__c ) ), 
	NOT(AND(Core_Lead_Conversion_Flag__c, ISNEW())), 
	NOT(AND(PRIORVALUE(Core_Lead_Conversion_Flag__c)=TRUE, Core_Lead_Conversion_Flag__c=FALSE)),
	RecordType.Name &lt;&gt; $Label.Core_Solution_Group_Record_Type, 
	RecordType.Name &lt;&gt; $Label.Core_New_Solution_Group_Record_Type, 

	NOT(OR(ISCHANGED(Core_Opportunity_Team_Geo_APJ__c),
	       ISCHANGED(Core_Opportunity_Team_Geo_ASMO__c),
	       ISCHANGED(Core_Opportunity_Team_Geo_EMEA__c),
	       ISCHANGED(Core_Opportunity_Team_Geo_PRC__c),
               ISCHANGED(Core_OSC_Collaboration_Type__c))),

	INCLUDES(Core_Sales_Segments__c, &quot;Influencer&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Model__c</errorDisplayField>
        <errorMessage>Sales Model is required if Sales Segment is set to Influencer</errorMessage>
    </validationRules>
