    <fields>
        <fullName>Core_IsBlank_Competitive_Arch__c</fullName>
        <description>Used in pipeline improvement check report</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(TEXT( Core_Competitive_Architecture__c )), 0, 1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Blank Competitive Arch</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IsBlank_Manufacturing_Region__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(TEXT( Core_Manufacturing_Geo__c )), 0, 1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Blank Manufacturing Region</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IsBlank_Prod_End_Date__c</fullName>
        <description>Used for pipeline improvement check report</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Core_Production_End_Date__c),0,1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Blank Prod End Date</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Is_DCS__c</fullName>
        <formula>if( Account.Core_Global_MNC_ODM_Account__c == null &amp;&amp;
    OR(INCLUDES( Core_Sales_Segments__c, &apos;Embedded&apos;),
       INCLUDES( Core_Sales_Segments__c, &apos;Compute&apos;),
       INCLUDES( Core_Sales_Segments__c, &apos;Reseller/Channel&apos;),
       INCLUDES( Core_Sales_Segments__c, &apos;Distributor/Channel&apos;))
,true
,false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is DCS?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Is_DPDK_Used__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_Is_DPDK_Used__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is DPDK Used?</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_Business_Industry_Function__c</fullName>
        <description>INF KPI Business Industry function</description>
        <externalId>false</externalId>
        <formula>IF(OR(ISPICKVAL(Core_Product_Application__c,&quot;Workstation&quot;), 
      INCLUDES(Core_Solution_Focus__c , &quot;HPC&quot;)),&quot;HPC;&quot;,&quot;&quot;) &amp;

IF(INCLUDES(Core_Solution_Focus__c , &quot;Big Data/Analytics&quot;), &quot;Big Data;&quot;,&quot;&quot;) &amp;

IF(INCLUDES(Core_Solution_Focus__c , &quot;IoT/Embedded&quot;), &quot;IoT;&quot;,&quot;&quot;)  &amp;

IF(OR(ISPICKVAL(Account.Industry, &quot;Biotechnology&quot;),
      ISPICKVAL(Account.Industry, &quot;Healthcare&quot;),
      ISPICKVAL(Core_Consumption_Market__c, &quot;Health and Life Sciences&quot;),
      ISPICKVAL(Core_Consumption_Market__c, &quot;Healthcare&quot;)),&quot;Industry:Healthcare;&quot;,&quot;&quot;)  &amp; 

IF(OR(ISPICKVAL(Account.Industry, &quot;Finance&quot;),
      ISPICKVAL(Account.Industry, &quot;Insurance&quot;),
      ISPICKVAL(Core_Consumption_Market__c,&quot;Financial Services&quot;)), &quot;Industry:FSI;&quot;, &quot;&quot;)  &amp; 

IF((ISPICKVAL(Account.Industry, &quot;Retail&quot;) &amp;&amp;
    NOT(ISPICKVAL(Core_Consumption_Market__c, &quot;Consumer&quot;))) || 
   ISPICKVAL(Account.Industry, &quot;Apparel&quot;) ||
   ISPICKVAL(Account.Industry, &quot;Food &amp; Beverage&quot;) ||
   ISPICKVAL(Account.Industry, &quot;Hospitality&quot;) ||
   ISPICKVAL(Core_Consumption_Market__c, &quot;Retail&quot;), &quot;Industry:Retail;&quot;, &quot;&quot;) &amp; 

IF(ISPICKVAL(Account.Industry, &quot;Energy&quot;) ||
   ISPICKVAL(Core_Consumption_Market__c, &quot;Energy&quot;), &quot;Industry:Energy;&quot;, &quot;&quot;) &amp; 

IF(ISPICKVAL(Account.Industry, &quot;Utilities&quot;) ||
   ISPICKVAL(Core_Consumption_Market__c, &quot;Utilities&quot;), &quot;Industry:Utilities;&quot;, &quot;&quot;)  &amp; 

IF(INCLUDES(Core_Solution_Focus__c , &quot;Education: Post Secondary&quot;) ||
   INCLUDES(Core_Solution_Focus__c , &quot;Education: K12&quot;) ||
   INCLUDES(Core_Solution_Focus__c , &quot;Vertical Linkage: Education&quot;) ||
   ISPICKVAL(Core_Consumption_Market__c, &quot;Education&quot;) ||
   ISPICKVAL(Core_Consumption_Market__c, &quot;Education&quot;), &quot;Intel Education;&quot;, &quot;&quot;) &amp; 

IF((INCLUDES(Core_Solution_Focus__c , &quot;SP/Telco: Client GTM&quot;) ||
    INCLUDES(Core_Solution_Focus__c , &quot;SP/Telco: DC-Cloud&quot;) ||
    INCLUDES(Core_Solution_Focus__c , &quot;SP/Telco: DC-Enterprise IT&quot;) ||
    INCLUDES(Core_Solution_Focus__c , &quot;SP/Telco: DC-Mission Critical&quot;) ||
    INCLUDES(Core_Solution_Focus__c , &quot;SP/Telco: DC-Subscriber Services&quot;) ||
    INCLUDES(Core_Solution_Focus__c , &quot;SP/Telco: Home CE/IOT&quot;) ||
    INCLUDES(Core_Solution_Focus__c , &quot;SP/Telco: Network Blackbox&quot;) ||
    INCLUDES(Core_Solution_Focus__c , &quot;SP/Telco: Network Open&quot;) ||
    INCLUDES(Core_Solution_Focus__c , &quot;Vertical Linkage: Service Provider&quot;)) ||
   ISPICKVAL(Core_Consumption_Market__c, &quot;Service Providers (Cloud and Comms)&quot;) ||
   ISPICKVAL(Core_Consumption_Market__c, &quot;Service Providers/Telco&quot;), &quot;SP/Telco;&quot;,&quot;&quot;)</formula>
        <label>KPI - Business Industry Function</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_KPI_Production_Past_Due__c</fullName>
        <description>True if today&apos;s date is 30 days or more past the First Customer Ship Date and the opportunity Stage does NOT equal Group, Lost, Cancelled, Production Win, Production Lost or Production Cancelled</description>
        <formula>TODAY() - Core_First_Customer_Ship_Date__c &gt; 30 &amp;&amp; NOT(OR(
	ISPICKVAL(StageName, &apos;Group&apos;), ISPICKVAL(StageName, &apos;Lost&apos;), ISPICKVAL(StageName, &apos;Cancelled&apos;), 
	ISPICKVAL(StageName, &apos;Production Win&apos;), ISPICKVAL(StageName, &apos;Production Lost&apos;), ISPICKVAL(StageName, &apos;Production Cancelled&apos;)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>KPI - Production Past Due</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Knights_Landing__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_Knights_Landing__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Knights Landing</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
