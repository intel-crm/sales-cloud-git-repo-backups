    <fields>
        <fullName>Core_Loss_Cancel_Details__c</fullName>
        <description>Detailed reason for loss/cancel</description>
        <inlineHelpText>Required field to provide details that expand upon the Loss/Cancel Reason.  This data helps us learn from losses.</inlineHelpText>
        <label>Loss/Cancel Details</label>
        <length>32768</length>
