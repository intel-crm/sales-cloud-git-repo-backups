        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Time_Till_Opportunity_Decision_Date__c</fullName>
        <description>Will display time in positive numbers if the Decision Date is in the future, and in negative numbers if Today is past the Decision Date.</description>
        <externalId>false</externalId>
        <formula>CloseDate - TODAY()</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Will display time in positive numbers if the Decision Date is in the future, and in negative numbers if Today is past the Decision Date.</inlineHelpText>
        <label>Time Till Opportunity Decision Date</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
