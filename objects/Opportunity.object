    <fields>
        <fullName>Core_Org_URL__c</fullName>
        <description>Formula field that generates a URL to the org itself, e.g. https://intel--crmdev1.cs21.my.salesforce.com/, so it can be used in email alerts on the Opportunity object that aren&apos;t directly to the opportunity itself (i.e. where {!Opportunity.Link} won&apos;t work). Avoids hard-coding. Created for MAG email notifications on Opportunity that go directly to the MAG questionnaire itself, e.g. https://intel--crmdev1.cs21.my.salesforce.com/apex/Core_MAGQuestionnaire?OpportunityID=006q0000005H9VO.</description>
        <externalId>false</externalId>
        <formula>LEFT($Api.Partner_Server_URL_340, FIND( &apos;/services&apos;, $Api.Partner_Server_URL_340))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Org URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
