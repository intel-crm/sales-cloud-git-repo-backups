        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Team_Geo_ASMO__c</fullName>
        <defaultValue>false</defaultValue>
        <description>True if there is an opportunity team member in the geo, false if not</description>
        <label>Opportunity Team Region ASMO</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Team_Geo_EMEA__c</fullName>
        <defaultValue>false</defaultValue>
        <description>True if there is an opportunity team member in the geo, false if not</description>
        <label>Opportunity Team Region EMEA</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Team_Geo_PRC__c</fullName>
        <defaultValue>false</defaultValue>
        <description>True if there is an opportunity team member in the geo, false if not</description>
        <label>Opportunity Team Region PRC</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Team_Geos__c</fullName>
        <description>Reporting: Opportunity Team&apos;s Geos</description>
        <externalId>false</externalId>
        <formula>if(Core_Opportunity_Team_Geo_APJ__c,
if(Core_Opportunity_Team_Geo_ASMO__c, 
		if(Core_Opportunity_Team_Geo_EMEA__c, 
			if(Core_Opportunity_Team_Geo_PRC__c, 
				&quot;APJ,ASMO,EMEA,PRC&quot;, 								&quot;APJ,ASMO,EMEA&quot;), 
		if(Core_Opportunity_Team_Geo_PRC__c, 
			&quot;APJ,ASMO,PRC&quot;, 
		&quot;APJ,ASMO&quot;)),
	 if(Core_Opportunity_Team_Geo_EMEA__c, 
		if(Core_Opportunity_Team_Geo_PRC__c,&quot;ASMO,EMEA,PRC&quot;, 
		&quot;APJ,EMEA&quot;),
	if(Core_Opportunity_Team_Geo_PRC__c,&quot;APJ,PRC&quot;, 
	&quot;APJ&quot;))),
if(Core_Opportunity_Team_Geo_ASMO__c, 
	if(Core_Opportunity_Team_Geo_EMEA__c,
		if(Core_Opportunity_Team_Geo_PRC__c, &quot;ASMO,EMEA,PRC&quot;, 
		&quot;ASMO,EMEA&quot;),
	if(Core_Opportunity_Team_Geo_PRC__c, &quot;ASMO,PRC&quot;, 
	&quot;ASMO&quot;)),
if(Core_Opportunity_Team_Geo_EMEA__c, 
	if(Core_Opportunity_Team_Geo_PRC__c,&quot;EMEA,PRC&quot;, 
	&quot;EMEA&quot;),
if(Core_Opportunity_Team_Geo_PRC__c,&quot;PRC&quot;, &quot;&quot;)
)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Team Regions</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Type__c</fullName>
        <description>Opportunity Type</description>
        <inlineHelpText>Refers to the type of sales activity: Choose “design” when designing products into customer applications (push); choose “deal” when bringing Intel based solutions to the market (pull)</inlineHelpText>
        <label>Opportunity Type</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Design: Original</fullName>
                    <default>false</default>
                    <label>Design: Original</label>
                </value>
                <value>
                    <fullName>Design: Secondary</fullName>
                    <default>false</default>
                    <label>Design: Secondary</label>
                </value>
                <value>
                    <fullName>Deal: Sell-to</fullName>
                    <default>false</default>
                    <label>Deal: Sell-to</label>
                </value>
                <value>
                    <fullName>Deal: Sell-through</fullName>
                    <default>false</default>
                    <label>Deal: Sell-through</label>
                </value>
                <value>
                    <fullName>Deal: Sell-with</fullName>
                    <default>false</default>
                    <label>Deal: Sell-with</label>
                </value>
                <value>
                    <fullName>Deal: Scale-Estimate (per Finance)</fullName>
                    <default>false</default>
                    <label>Deal: Scale-Estimate (per Finance)</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Opportunity_U_Base__c</fullName>
        <description>This is a sum of product quantity at opportunity level, it will be used as base to create other costume formula fields.</description>
        <label>Opportunity (U) Base</label>
