        <fullName>Core_System_Owners_Manager__c</fullName>
        <description>Captures the email address of the Owner&apos;s manager. This is used  to send risk notification to the owner&apos;s manager if the opportunity is as risk.</description>
        <externalId>false</externalId>
        <label>System Owners Manager</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_System_Prod_Competitor_Empty_Count__c</fullName>
        <description>This field counts the number of Opportunity Product records that have empty values in Competitor OEM or Competitor OEM Product.</description>
        <label>System Product Competitor Empty Count</label>
        <summarizedField>OpportunityLineItem.Core_System_Competitor_Empty_Flag__c</summarizedField>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_System_Sales_Segment_Count__c</fullName>
        <description>Calculates the count of of values in Core_Sales_Segments__c.

This field is used to calculate the Sales Group value.</description>
        <externalId>false</externalId>
        <formula>IF(INCLUDES(Core_Sales_Segments__c, &quot;Influencer&quot;), 1, 0) + 
IF(INCLUDES(Core_Sales_Segments__c, &quot;Compute&quot;), 1, 0) + 
IF(INCLUDES(Core_Sales_Segments__c, &quot;Embedded&quot;), 1, 0) + 
IF(INCLUDES(Core_Sales_Segments__c, &quot;Reseller/Channel&quot;), 1, 0) + 
IF(INCLUDES(Core_Sales_Segments__c, &quot;Distributor/Channel&quot;), 1, 0 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System Sales Segment Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_System_Submitter__c</fullName>
        <description>Captures the email address of the user submitting the opportunity for approval. This is used later to send rejection notification to the user if the opportunity is rejected.</description>
        <externalId>false</externalId>
        <label>System Submitter</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Email</type>
        <unique>false</unique>
    </fields>
