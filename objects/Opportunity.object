            <value>Pending, On Hold,Win Submitted</value>
        </summaryFilterItems>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_Performance_Features_Enabled__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_Performance_Features_Enabled__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Performance Features Enabled</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Permission_View_All_Analytics_Data__c</fullName>
        <externalId>false</externalId>
        <formula>&apos;Core_View_All_Analytics_Data&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Permission View All Analytics Data</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Pipeline_Heath__c</fullName>
        <formula>IF(
(Core_Past_Due__c || Core_Inactive__c || Core_Low_Velocity__c )&amp;&amp;
 (ISPICKVAL(StageName, &apos;Qualify&apos;) || ISPICKVAL(StageName, &apos;Define&apos;) || ISPICKVAL(StageName, &apos;Develop&apos;) || ISPICKVAL(StageName, &apos;Design&apos;)),True,False)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Pipeline Health</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
