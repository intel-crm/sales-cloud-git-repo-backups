    <fields>
        <fullName>Core_VBS_Potential__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Value Based Selling Potential flag</description>
        <inlineHelpText>Value Based Selling is discontinued, no new opportunities can be marked as VBS Potential.
Please refer to https://salescrmtraining.intel.com/sales-practices-policies/value-based-selling/ for further details.
Please reach out to vbs-help-desk@intel.com for any questions.</inlineHelpText>
        <label>VBS Potential</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_VBS_Status__c</fullName>
        <description>Status of VBS SOAR assessment.</description>
        <inlineHelpText>Status of VBS SOAR assessment.

Pending – SOAR1 Assessment is in-progress.
SOAR1 Qualified – SOAR1 qualification achieved.
SOAR1 Un-qualified – SOAR1 qualification not achieved.
SOAR3 Approved – Opportunity approved for VBS.
SOAR3 Denied – Opportunity denied for VBS.
SOAR4 Contract Signed - Customer has agreed to deal.
SOAR4 Contract Not Signed- Customer does not agree to deal.</inlineHelpText>
        <label>VBS Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>SOAR1 Qualified</fullName>
                    <default>false</default>
                    <label>SOAR1 Qualified</label>
                </value>
                <value>
                    <fullName>SOAR1 Un-qualified</fullName>
                    <default>false</default>
                    <label>SOAR1 Un-qualified</label>
                </value>
                <value>
                    <fullName>SOAR3 Approved</fullName>
                    <default>false</default>
                    <label>SOAR3 Approved</label>
                </value>
                <value>
                    <fullName>SOAR3 Denied</fullName>
                    <default>false</default>
                    <label>SOAR3 Denied</label>
                </value>
                <value>
                    <fullName>SOAR4 Contract Signed</fullName>
                    <default>false</default>
                    <label>SOAR4 Contract Signed</label>
                </value>
                <value>
                    <fullName>SOAR4 Contract Not Signed</fullName>
                    <default>false</default>
                    <label>SOAR4 Contract Not Signed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
