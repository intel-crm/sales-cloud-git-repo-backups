    <fields>
        <fullName>Core_Age__c</fullName>
        <description>This fields displays age of opportunity for open stages and displays age after opportunity is closed.</description>
        <externalId>false</externalId>
        <formula>IF(
OR(ISPICKVAL(StageName,&apos;Qualify&apos;),ISPICKVAL(StageName,&apos;Define&apos;),
ISPICKVAL(StageName,&apos;Develop&apos;),ISPICKVAL(StageName,&apos;Design&apos;),
ISPICKVAL(StageName,&apos;Group&apos;),ISPICKVAL(StageName,&apos;Group Open&apos;)),
 NOW()- CreatedDate, LastStageChangeDate-CreatedDate
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Age</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
