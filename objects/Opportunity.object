    <fields>
        <fullName>Core_Opportunity_Coverage_Nm__c</fullName>
        <inlineHelpText>Intel-led - This option is systematically populated when an opportunity is created directly in the Sales CRM
Partner-led - This option is systematically populated when an opportunity is created through the Partner Design Registration Portal</inlineHelpText>
        <label>Opportunity Coverage</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Intel-Led Opportunity</fullName>
                    <default>true</default>
                    <label>Intel-Led Opportunity</label>
                </value>
                <value>
                    <fullName>Partner-Led Opportunity</fullName>
                    <default>false</default>
                    <label>Partner-Led Opportunity</label>
                </value>
                <value>
                    <fullName>Intel-Led</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Intel-Led</label>
                </value>
                <value>
                    <fullName>Partner-Led</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Partner-Led</label>
                </value>
                <value>
                    <fullName>Retail</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Retail</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Coverage__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  OR(
       ISPICKVAL(StageName, &quot;Design Win&quot;),
       ISPICKVAL(StageName, &quot;Production Win&quot;),
       ISPICKVAL(StageName, &quot;Production Lost&quot;),
       ISPICKVAL(StageName, &quot;Production Cancelled&quot;),
       ISPICKVAL(StageName, &quot;Lost&quot;),
       ISPICKVAL(StageName, &quot;Cancelled&quot;)
    ), 
  Core_Approved_Opportunity_Coverage__c  , IF(ISBLANK (TEXT(Owner.Core_User_Coverage__c)),&apos;Other&apos;, TEXT(Owner.Core_User_Coverage__c)) )</formula>
        <label>Opportunity Role Coverage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Create_to_Submit_LOV__c</fullName>
        <description>Flag an opportunity as a bluebird opportunity if its been less than 30 days since an Opportunity was created and submitted for approval. Prevents users from entering an opportunity just to receive commissions.</description>
        <externalId>false</externalId>
        <formula>IF( Core_Date_Submitted_for_Approval__c - DATEVALUE(CreatedDate) &lt;= 30, &quot;Within 30 Days&quot;,
IF( Core_Date_Submitted_for_Approval__c - DATEVALUE(CreatedDate) &lt;= 60, &quot;Within 60 Days&quot;,
IF( Core_Date_Submitted_for_Approval__c - DATEVALUE(CreatedDate) &lt;= 90, &quot;Within 90 Days&quot;,
IF( Core_Date_Submitted_for_Approval__c - DATEVALUE(CreatedDate) &gt; 90, &quot;More than 90 Days&quot;,&quot;N/A&quot;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Flag an opportunity as a bluebird opportunity if its been less than 30 days since an Opportunity was created and submitted for approval. Prevents users from entering an opportunity just to receive commissions.</inlineHelpText>
        <label>Opportunity Create to Submit</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Created_Coverage_New__c</fullName>
        <description>Should reflect the ‘User Coverage’ entry of the person who is creating the opportunity</description>
        <externalId>false</externalId>
        <label>Opportunity Created Coverage</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Created_Coverage__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Owner.Core_User_Coverage__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Created Coverage - Don&apos;t Use</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Entry_Stage__c</fullName>
        <description>RPTG: Opportunity entry stage - 
•The &quot;Opportunity Entry Stage&quot; field should capture the first value assigned to the opportunity &quot;Stage&quot; when an opportunity is first opened. 
•If the opportunity is opened with no in value in the &quot;Stage&quot; field, use the first Stage value assigned to the oppty (e.g., Qualify, Define, Develop, etc.)</description>
        <externalId>false</externalId>
        <label>Opportunity Entry Stage</label>
        <length>80</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Facts_ID__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Used to map Opportunites with the related descriptive features in a column format.</description>
        <label>Opportunity Facts</label>
        <referenceTo>Core_Opportunity_Facts__c</referenceTo>
        <relationshipLabel>Opportunities</relationshipLabel>
        <relationshipName>Opportunities</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Geo_APJ__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Opportunity Region APJ</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Geo_ASMO__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Opportunity Region ASMO</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Geo_EMEA__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Opportunity Region EMEA</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Geo_PRC__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Opportunity Region PRC</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Geo__c</fullName>
        <description>This is a derived field from Opportunity Country automatically by the System using APEX Code</description>
        <externalId>false</externalId>
        <inlineHelpText>This is a derived field from Opportunity Country</inlineHelpText>
        <label>Deal Region</label>
        <length>10</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_ID__c</fullName>
        <description>Formula field that looks up the value of the Opportunity ID</description>
        <externalId>false</externalId>
        <formula>CaseSafeId(Id)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Unique 18 character system generated identifier for the opportunity (not editable). This ID is also embedded in the URL string.</inlineHelpText>
        <label>Opportunity ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Lost_U__c</fullName>
        <description>This field will sum the quantity of units for Lost Opportunities; otherwise it will be 0.</description>
        <externalId>false</externalId>
        <formula>IF(Core_Lost_Oppty__c  &gt; 0,   Core_Opportunity_U_Base__c  , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Lost (U)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Lost__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Core_Lost_Oppty__c  &gt; 0,  Core_Oppty_Lost_Total_Price__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Lost ($)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Owner_Geo__c</fullName>
        <description>The Region of the Opportunity. It is the Region of the Account for Channel Opportunities. It is the Region of the Opportunity Owner when the Opportunity goes into any of these Stages for the first time - Design Win, Production Win, Lost, Cancelled. It is the Region of the Current Opportunity Owner if the Opportunity never went into those Stages.</description>
        <externalId>false</externalId>
        <formula>IF (Core_Channel_Opportunity_Ind__c = true, TEXT(Account.Core_Geo__c), 
IF (Core_Approved_Opportunity_Region__c != null  &amp;&amp;  TEXT(Core_Approval_Status__c) = &apos;Approved&apos;, Core_Approved_Opportunity_Region__c, Owner.Core_User_Geo__c)
)</formula>
        <label>Opportunity Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Owner_Manager_Email__c</fullName>
        <description>This Field holds opportunity owner&apos;s manager&apos;s email id</description>
        <externalId>false</externalId>
        <formula>Owner.Manager.Email</formula>
        <label>Opportunity Owner Manager Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Owner_Sub_Geo__c</fullName>
        <description>Reporting: Opportunity Owner sub Geo</description>
        <externalId>false</externalId>
        <formula>IF(Core_Channel_Opportunity_Ind__c = true, TEXT(Account.Core_Sub_Geo__c), Owner.Core_User_Sub_Geo__c)</formula>
        <label>Opportunity Sub Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Owner__c</fullName>
        <externalId>false</externalId>
        <formula>IF($Profile.Name == &apos;Partner&apos;, Owner.FirstName  &amp; &quot; &quot; &amp;  Owner.LastName, 
IMAGE(&quot;/profilephoto/005/T&quot;, &quot;&quot;, 16, 16) + &quot; &quot; + HYPERLINK(&quot;/&quot; &amp; OwnerId, Owner.FirstName &amp; &quot; &quot; &amp; Owner.LastName) + &quot; &quot; + IF($User.UIThemeDisplayed=&quot;Theme3&quot;,HYPERLINK(&quot;/&quot;+Id+&quot;/a?retURL=&quot;+Id+&quot;&amp;keepTeam=1&quot;, &quot;[Change]&quot;, &apos;_self&apos;),&quot;&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Opportunity Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Past_Due__c</fullName>
        <description>Flags an Opportunity as overdue if the Close Date is less than Today.</description>
        <externalId>false</externalId>
        <formula>IF((TODAY() - 30 &gt;= CloseDate),&quot;Past Due&quot;, &quot;Not Past Due&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Flags an Opportunity as overdue if the Close Date is less than Today.</inlineHelpText>
        <label>Decision Date Timing</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
