        <fullName>Core_ProductionWin_KPI_Txt__c</fullName>
        <label>Production Win KPI</label>
        <length>1500</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Production_End_Date__c</fullName>
        <description>The date that the customer is ending the manufacturing of their product. No additional orders are expected to be placed for Intel product</description>
        <inlineHelpText>The date the customer expects to stop manufacturing the product.  Additional orders aren&apos;t expected to be placed with Intel past this date.</inlineHelpText>
        <label>Production End Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Production_Lifecycle__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_Production_Lifecycle__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Production Lifecycle</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Production_Win_Oppty__c</fullName>
        <description>This is a flag that will be used at reporting side to create calculations.
The value of this field is 1 when Opportunity Stage is &quot;Production Win&quot;; otherwise it will be 0.</description>
        <externalId>false</externalId>
        <formula>IF( TEXT( StageName ) = &quot;Production Win&quot;, 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Production Win Oppty</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Products_At_Risk_Count__c</fullName>
        <label>Products At Risk Count</label>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_At_Risk__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
