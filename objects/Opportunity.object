        <label>Won Product Count</label>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Status__c</field>
            <operation>equals</operation>
            <value>Win Approved, Production Win Approved, Production Lost, Production Cancelled</value>
        </summaryFilterItems>
