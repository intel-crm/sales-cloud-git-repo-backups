    <fields>
        <fullName>Core_Relationship_on_Opportunity__c</fullName>
        <description>Account associated with the Opportunity</description>
        <inlineHelpText>Please identify the OEM-ODM relationship on the Opportunity. 
Example: 
• If Dell = OEM, who is the ODM? 
• If Quanta = ODM, which OEM name will brand product? 
• If Quanta = ODM, will it be for “Channel”?</inlineHelpText>
        <label>Relationship on Opportunity(Do Not Use)</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Channel – Selling as non-Branded System</fullName>
                    <default>false</default>
                    <label>Channel – Selling as non-Branded System</label>
                </value>
                <value>
                    <fullName>Channel – Selling as Branded System</fullName>
                    <default>false</default>
                    <label>Channel – Selling as Branded System</label>
                </value>
                <value>
                    <fullName>Channel – Selling as Motherboard</fullName>
                    <default>false</default>
                    <label>Channel – Selling as Motherboard</label>
                </value>
                <value>
                    <fullName>Channel - Other</fullName>
                    <default>false</default>
                    <label>Channel - Other</label>
                </value>
                <value>
                    <fullName>ODM – Built by Compal</fullName>
                    <default>false</default>
                    <label>ODM – Built by Compal</label>
                </value>
                <value>
                    <fullName>ODM – Built by Inventec</fullName>
                    <default>false</default>
                    <label>ODM – Built by Inventec</label>
                </value>
                <value>
                    <fullName>ODM – Built by Pegatron</fullName>
                    <default>false</default>
                    <label>ODM – Built by Pegatron</label>
                </value>
