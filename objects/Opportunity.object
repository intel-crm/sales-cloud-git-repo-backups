    <fields>
        <fullName>Core_Opportunity_Coverage__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  OR(
       ISPICKVAL(StageName, &quot;Design Win&quot;),
       ISPICKVAL(StageName, &quot;Production Win&quot;),
       ISPICKVAL(StageName, &quot;Production Lost&quot;),
       ISPICKVAL(StageName, &quot;Production Cancelled&quot;),
       ISPICKVAL(StageName, &quot;Lost&quot;),
       ISPICKVAL(StageName, &quot;Cancelled&quot;)
    ), 
  Core_Approved_Opportunity_Coverage__c  , IF(ISBLANK (TEXT(Owner.Core_User_Coverage__c)),&apos;Other&apos;, TEXT(Owner.Core_User_Coverage__c)) )</formula>
        <label>Opportunity Coverage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Create_to_Submit_LOV__c</fullName>
        <description>Flag an opportunity as a bluebird opportunity if its been less than 30 days since an Opportunity was created and submitted for approval. Prevents users from entering an opportunity just to receive commissions.</description>
        <externalId>false</externalId>
        <formula>IF( Core_Date_Submitted_for_Approval__c - DATEVALUE(CreatedDate) &lt;= 30, &quot;Within 30 Days&quot;,
IF( Core_Date_Submitted_for_Approval__c - DATEVALUE(CreatedDate) &lt;= 60, &quot;Within 60 Days&quot;,
IF( Core_Date_Submitted_for_Approval__c - DATEVALUE(CreatedDate) &lt;= 90, &quot;Within 90 Days&quot;,
IF( Core_Date_Submitted_for_Approval__c - DATEVALUE(CreatedDate) &gt; 90, &quot;More than 90 Days&quot;,&quot;N/A&quot;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Flag an opportunity as a bluebird opportunity if its been less than 30 days since an Opportunity was created and submitted for approval. Prevents users from entering an opportunity just to receive commissions.</inlineHelpText>
        <label>Opportunity Create to Submit</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Entry_Stage__c</fullName>
        <description>RPTG: Opportunity entry stage - 
•The &quot;Opportunity Entry Stage&quot; field should capture the first value assigned to the opportunity &quot;Stage&quot; when an opportunity is first opened. 
•If the opportunity is opened with no in value in the &quot;Stage&quot; field, use the first Stage value assigned to the oppty (e.g., Qualify, Define, Develop, etc.)</description>
        <externalId>false</externalId>
        <label>Opportunity Entry Stage</label>
        <length>80</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Facts_ID__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Used to map Opportunites with the related descriptive features in a column format.</description>
        <label>Opportunity Facts</label>
        <referenceTo>Core_Opportunity_Facts__c</referenceTo>
        <relationshipLabel>Opportunities</relationshipLabel>
        <relationshipName>Opportunities</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
