    <fields>
        <fullName>Core_Product_At_Risk_Not_Closed_Count__c</fullName>
        <label>Product At Risk Not Closed Count</label>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_At_Risk__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_At_Risk_Status__c</field>
            <operation>notEqual</operation>
            <value>Closed: Support Provided, Closed: Support Not Provided</value>
        </summaryFilterItems>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_Product_At_Risk__c</fullName>
        <formula>IF(AND(Core_At_Risk__c,
Core_Product_At_Risk_Not_Closed_Count__c &gt; 0),
true,false
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product At Risk</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Product_Capability_Technology__c</fullName>
        <externalId>false</externalId>
        <formula>Core_Opportunity_Facts_ID__r.Core_Product_Capability_Technology__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product Capability/Technology</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Product_Count__c</fullName>
        <label>Product Count</label>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_Product_EOL_Count_Nm__c</fullName>
        <label>Product EOL Count</label>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Is_Product_EOL__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>OpportunityLineItem.Core_Status__c</field>
            <operation>equals</operation>
            <value>Pending, On Hold, Win Submitted</value>
        </summaryFilterItems>
        <summaryForeignKey>OpportunityLineItem.OpportunityId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_Product_Interest__c</fullName>
        <description>Indicates the Intel Product Families that the Account is interested in. This field will default from a converted lead if applicable and is not editable</description>
        <inlineHelpText>Indicates the Intel Product Families that the Account is interested in. This field will default from a converted lead if applicable and is not editable.</inlineHelpText>
        <label>Product Interest</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>MultiselectPicklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Ethernet Controllers</fullName>
