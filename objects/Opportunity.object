    <fields>
        <fullName>Core_Inactive__c</fullName>
        <description>Opptys that have not progressed stages and have no material change are at increased risk for cancel/loss. Consider the ROI and update the record.</description>
        <formula>If(  (ISPICKVAL(StageName, &apos;Define&apos;) || ISPICKVAL(StageName, &apos;Develop&apos;) || ISPICKVAL(StageName, &apos;Design&apos;))&amp;&amp;
(( !ISBLANK( Core_Last_Activity_Date__c ) &amp;&amp; TODAY()-Core_Last_Activity_Date__c &gt;60)
||(ISBLANK( Core_Last_Activity_Date__c ) &amp;&amp; NOW()-CreatedDate &gt;60)),True,False)</formula>
        <label>Inactive</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
