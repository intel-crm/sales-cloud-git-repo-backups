        <fullName>Core_Time_Till_Opportunity_Decision_Date__c</fullName>
        <description>Will display time in positive numbers if the Decision Date is in the future, and in negative numbers if Today is past the Decision Date.</description>
        <externalId>false</externalId>
        <formula>CloseDate - TODAY()</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
