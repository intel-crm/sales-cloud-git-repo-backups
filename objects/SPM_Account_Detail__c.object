    <label>Account Detail</label>
    <listViews>
        <fullName>Account_Owners_modified_in_last_30_days</fullName>
        <booleanFilter>1 AND 2 AND 3</booleanFilter>
        <columns>NAME</columns>
        <columns>SPM_Customer_ID__c</columns>
        <columns>SF_Account__c</columns>
        <columns>Account_Owner__c</columns>
        <columns>Coverage_Type__c</columns>
        <columns>Category__c</columns>
        <columns>Sales_Group__c</columns>
        <columns>Region__c</columns>
        <columns>CST_Region__c</columns>
        <columns>Country__c</columns>
        <columns>Industry__c</columns>
        <columns>UPDATEDBY_USER</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CST_Account_Owner_Id__c</field>
            <operation>notEqual</operation>
        </filters>
        <filters>
            <field>LAST_UPDATE</field>
            <operation>equals</operation>
            <value>LAST_N_DAYS:30</value>
        </filters>
        <filters>
            <field>CRM_CST_Is_Active_Planning_Period__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Account Owners modified in last 30 days</label>
    </listViews>
    <listViews>
        <fullName>Accounts_without_Owner</fullName>
        <columns>NAME</columns>
        <columns>SPM_Customer_ID__c</columns>
        <columns>SF_Account__c</columns>
        <columns>CST_Account_Owner_Id__c</columns>
        <columns>Coverage_Type__c</columns>
        <columns>Category__c</columns>
        <columns>Sales_Group__c</columns>
        <columns>Region__c</columns>
        <columns>CST_Region__c</columns>
        <columns>Country__c</columns>
        <columns>Industry__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Account_Owner__c</field>
            <operation>equals</operation>
        </filters>
        <filters>
            <field>CRM_CST_Is_Active_Planning_Period__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Accounts without Owner</label>
    </listViews>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>SPM_Customer_ID__c</columns>
        <columns>SF_Account__c</columns>
        <columns>Account_Owner__c</columns>
        <columns>Coverage_Type__c</columns>
        <columns>Category__c</columns>
        <columns>Sales_Group__c</columns>
        <columns>Region__c</columns>
        <columns>CST_Region__c</columns>
        <columns>Country__c</columns>
        <columns>Industry__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CRM_CST_Is_Active_Planning_Period__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>ACD-{000000}</displayFormat>
        <label>Account Detail ID</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Detail</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>New</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <searchResultsAdditionalFields>SPM_Customer_ID__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>SF_Account__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Account_Owner__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Coverage_Type__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Category__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Sales_Group__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Region__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CST_Region__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Country__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>check_New_Account_Creation</fullName>
        <active>true</active>
        <description>only DR and VP can create New account</description>
        <errorConditionFormula>AND ( ISNEW() ,$Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name,
$Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name,$Profile.Name &lt;&gt; &apos;Sales_CRM_CST_Director&apos;, $Profile.Name &lt;&gt; &apos;Sales_CRM_CST_Vice_President&apos;)</errorConditionFormula>
        <errorMessage>Access is denied to create a new Account</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
