        <fullName>PRM_Transaction_time__c</fullName>
        <externalId>false</externalId>
        <formula>( PRM_Response_timestamp__c -  PRM_Request_timestamp__c )*24*60*60</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
