        <inlineHelpText>Outbound = From SFDC to BES (Source Field ► Target Field)
Inbound = From BES to SFDC (Source Field ◄ Target Field)</inlineHelpText>
        <label>Direction</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Inbound</fullName>
                    <default>false</default>
                    <label>Inbound</label>
                </value>
                <value>
                    <fullName>Outbound</fullName>
                    <default>true</default>
                    <label>Outbound</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
