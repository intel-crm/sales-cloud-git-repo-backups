    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>2020 version of object containing &quot;Fields&quot; to be mapped between IPS and a Target/Backend System; may include child Value Map table for picklist type fields &amp; optional default data for mandatory BES fields.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
