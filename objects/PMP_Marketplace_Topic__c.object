    <label>Marketplace Topic</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>PMP_Marketplace_Topic_Name__c</columns>
        <columns>PMP_Topic_Id__c</columns>
        <columns>PMP_Topic_Type__c</columns>
        <columns>PMP_Is_Active_Ind__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>TOPIC-{0000}</displayFormat>
        <label>Topic Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Marketplace Topics</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>End_Date_cannot_be_before_Start_Date</fullName>
        <active>true</active>
        <description>End Date cannot be before Start Date</description>
        <errorConditionFormula>PMP_Marketplace_Event_End_Dt__c &lt;
PMP_Marketplace_Event_Start_Dt__c</errorConditionFormula>
        <errorDisplayField>PMP_Marketplace_Event_End_Dt__c</errorDisplayField>
        <errorMessage>End Date cannot be before Start Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMP_Cannot_Change_Topic_Type</fullName>
        <active>true</active>
        <description>Topic Type cannot be changed</description>
        <errorConditionFormula>NOT(ISNEW())  &amp;&amp;  ISCHANGED( PMP_Topic_Type__c )</errorConditionFormula>
        <errorDisplayField>PMP_Topic_Type__c</errorDisplayField>
        <errorMessage>Topic Type cannot be modified</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMP_Topic_Name_Cannot_Be_Changed</fullName>
        <active>true</active>
        <description>Market Place Topic Name cannot be changed</description>
        <errorConditionFormula>NOT(ISNEW()) &amp;&amp; ISCHANGED(  PMP_Marketplace_Topic_Name__c  )</errorConditionFormula>
        <errorDisplayField>PMP_Marketplace_Topic_Name__c</errorDisplayField>
        <errorMessage>Marketplace Topic Name Cannot be changed</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
