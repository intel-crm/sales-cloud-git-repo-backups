    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>PMP_Event_Banner_Language_Mapping__c</fullName>
        <description>This field is used to map the language related to event</description>
        <label>Event Banner Language Mapping</label>
        <length>25500</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>2</visibleLines>
    </fields>
    <fields>
        <fullName>PMP_Event_Banner_Language__c</fullName>
        <description>This field is used to store the language related to event banner</description>
        <label>Event Banner Language</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>English</fullName>
                    <default>false</default>
                    <label>English</label>
                </value>
                <value>
                    <fullName>Simplified Chinese</fullName>
                    <default>false</default>
                    <label>Simplified Chinese</label>
                </value>
                <value>
                    <fullName>Japanese</fullName>
                    <default>false</default>
                    <label>Japanese</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMP_Event_Chinese_Tagline__c</fullName>
        <description>Holds chinese tagline for this event</description>
        <externalId>false</externalId>
        <inlineHelpText>Holds chinese tagline for this event</inlineHelpText>
        <label>Event Chinese Tagline</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
