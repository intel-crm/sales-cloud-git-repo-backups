        <fullName>PMP_Topic_Type__c</fullName>
        <description>Holds information about the type of Topic</description>
        <inlineHelpText>Holds information about the type of Topic</inlineHelpText>
        <label>Topic Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
