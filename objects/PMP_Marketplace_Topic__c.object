        <label>Event Japanese Tagline</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Event_Learn_More_Link_Txt__c</fullName>
        <description>Holds the URL value for learn more link</description>
        <label>Event Learn More Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>PMP_Event_Screen_Reader_Txt__c</fullName>
        <description>Holds the event CTA button screen reader values which will be used for assistance.</description>
        <label>Event Screen Reader Text</label>
        <length>2000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>PMP_Is_Active_Ind__c</fullName>
        <defaultValue>true</defaultValue>
        <description>This field is used to check whether topic is Active</description>
        <inlineHelpText>This field is used to check whether topic is Active</inlineHelpText>
        <label>Is Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Marketplace_Event_End_Dt__c</fullName>
        <description>Holds the information for event end date.</description>
        <inlineHelpText>Holds the information for event end date.</inlineHelpText>
        <label>Marketplace Event End Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMP_Marketplace_Event_Id__c</fullName>
        <description>Holds the related Marketplace Event Id</description>
        <externalId>false</externalId>
        <inlineHelpText>Holds the related Marketplace Event Id</inlineHelpText>
        <label>Marketplace Event Id</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Marketplace_Event_Start_Dt__c</fullName>
        <description>Holds the information for event start date.</description>
        <inlineHelpText>Holds the information for event start date.</inlineHelpText>
        <label>Marketplace Event Start Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMP_Marketplace_Event_Status__c</fullName>
        <description>Holds the information of event status</description>
        <formula>( NOW() &gt;=   DATETIMEVALUE(PMP_Marketplace_Event_Start_Dt__c))  &amp;&amp; (NOW() &lt;=   DATETIMEVALUE(PMP_Marketplace_Event_End_Dt__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Marketplace Event Status</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMP_Marketplace_Event_Tagline__c</fullName>
        <description>Holds the information for Event Tagline.</description>
        <externalId>false</externalId>
        <inlineHelpText>Holds the information for Event Tagline.</inlineHelpText>
        <label>Marketplace Event Tagline</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
