    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Check_Account_InActive</fullName>
        <active>false</active>
        <description>Check if Account Node is inactive</description>
        <errorConditionFormula>Core_MDF_Budget_Partner__r.Core_MDF_Active_Ind__c = False</errorConditionFormula>
        <errorMessage>Budget cannot be created because associated Account Node is inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Amt_Not_Less_Than_Saved_CoInv</fullName>
        <active>true</active>
        <description>On edit, the Amount of a Co-Inv budget (RecordType Core_MDF_Co_Inv, Program Co-Inv) cannot be less than the Amount already saved on the record.</description>
        <errorConditionFormula>AND(
    NOT(ISNEW()),
    RecordType.DeveloperName = &quot;Core_MDF_Co_Inv&quot;,
    Core_MDF_Program_Nm__c = &quot;Co-Inv&quot;,
    Amount &lt; PRIORVALUE(Amount)
)</errorConditionFormula>
        <errorDisplayField>Amount</errorDisplayField>
        <errorMessage>Enter an amount that&apos;s greater than or equal to the allocations within this budget.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_BudgetTypMandatoryForOEM</fullName>
        <active>true</active>
        <description>Budget Type is mandatory for CCF/DCF/IPA/RMF/CMDF Programs</description>
        <errorConditionFormula>OR(AND(
RecordType.DeveloperName = $Label.Core_MDF_CoMarketing_Budget_Record_type,
OR((ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c,&apos;Client CoMarketing Fund&apos;)),
(ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Data Center CoMarketing Fund&apos;))),
(ISBLANK(TEXT(Core_MDF_Budget_Type_Txt__c)))),
AND(OR(RecordType.DeveloperName = $Label.Core_MDF_IPA_Record_Type_Developer_Name,RecordType.DeveloperName = $Label.Core_MDF_Retail_Budget_Record_type),(ISBLANK(TEXT(Core_MDF_Budget_Type_Txt__c)))))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Budget_Partner__c</errorDisplayField>
        <errorMessage>Budget Type is mandatory for the selected program</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_BudgetType_Cannot_Be_Edited</fullName>
        <active>true</active>
        <description>To restrict any changes to Budget Type for all programs</description>
        <errorConditionFormula>AND(
NOT(ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c,&apos;Client CoMarketing Fund Boost&apos;)),
NOT(ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Service Provider CoMarketing Fund&apos;)),
ISCHANGED(Core_MDF_Budget_Type_Txt__c))</errorConditionFormula>
        <errorMessage>Budget Type cannot be changed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Budget_Amount_Decrease_Amount</fullName>
        <active>true</active>
        <description>Error will occur , in case user is trying to change Amount and Decrease Amount at same time</description>
        <errorConditionFormula>ISCHANGED( Amount )  &amp;&amp;  (ISCHANGED(Core_MDF_Decrease_Budget_Amount_Amt__c )  &amp;&amp; Core_MDF_Decrease_Budget_Amount_Amt__c &gt;0)</errorConditionFormula>
        <errorMessage>Budget reduction amount and Budget amount cannot be updated at the same time</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Budget_Decrease_Amount_Create</fullName>
        <active>true</active>
        <description>Decrease Budget Amount cannot be added during budget creation</description>
        <errorConditionFormula>ISNEW()  &amp;&amp;  Core_MDF_Decrease_Budget_Amount_Amt__c  &gt; 0</errorConditionFormula>
        <errorMessage>Budget reduction amount cannot be greater than 0, as budget has not been created yet.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Budget_Loader_OR_Approver</fullName>
        <active>false</active>
        <description>Restricting the MDF Budget Loader/Approver to create Budget CMP/Legacy Budget types</description>
        <errorConditionFormula>OR(AND($Permission.Core_MDF_CCP_Internal_MDF_Budget_Loader_Approver,NOT(OR(ISPICKVAL(Core_MDF_Budget_Type_Txt__c ,&apos;MDF&apos;),
ISPICKVAL( Core_MDF_Budget_Type_Txt__c ,&apos;MDF+&apos;)))),
AND(NOT($Permission.Core_MDF_CCP_Internal_MDF_Budget_Loader_Approver),OR(ISPICKVAL(Core_MDF_Budget_Type_Txt__c ,&apos;MDF&apos;),
ISPICKVAL( Core_MDF_Budget_Type_Txt__c ,&apos;MDF+&apos;))))</errorConditionFormula>
        <errorMessage>You are not authorized to create the Budgets for the Selected Budget Type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Budget_Partner_and_Program_rule</fullName>
        <active>true</active>
        <description>Program and Budget Partner should be same</description>
        <errorConditionFormula>Core_MDF_Program__c != Core_MDF_Budget_Partner__r.Core_MDF_Channel_Program__c</errorConditionFormula>
        <errorDisplayField>Core_MDF_Program__c</errorDisplayField>
        <errorMessage>The Program is not same as the Channel Program of the Account Node. Please update.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Budget_Retail_Quarter</fullName>
        <active>false</active>
        <errorConditionFormula>IF( Core_MDF_Program__r.Name = &apos;Retail Co-Marketing Program&apos;, 
EndDate - StartDate &gt; 450, 
False
)</errorConditionFormula>
        <errorMessage>Budget duration cannot be more than 5 quarters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Checking_Enddate</fullName>
        <active>true</active>
        <errorConditionFormula>EndDate  &lt;  StartDate</errorConditionFormula>
        <errorDisplayField>EndDate</errorDisplayField>
        <errorMessage>End date should be after the Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_DecBudAmtCannotBeGreateThanAmt</fullName>
        <active>true</active>
        <description>Decrease Budget Amount should be always less than Amount</description>
        <errorConditionFormula>(ISCHANGED(Core_MDF_Decrease_Budget_Amount_Amt__c )  || ISCHANGED(Amount)) &amp;&amp; Core_MDF_Decrease_Budget_Amount_Amt__c &gt;Amount</errorConditionFormula>
        <errorMessage>Budget reduction amount cannot be greater than Budget amount</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Negative_Amount</fullName>
        <active>true</active>
        <errorConditionFormula>(Amount &lt; 0)</errorConditionFormula>
        <errorMessage>Budget amount must be greater or equal to zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Negative_Decrease_Amount</fullName>
        <active>true</active>
        <errorConditionFormula>(Core_MDF_Decrease_Budget_Amount_Amt__c &lt; 0)</errorConditionFormula>
        <errorMessage>Budget reduction amount must be greater or equal to zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Negative_Max_Approved_Amount</fullName>
        <active>true</active>
        <errorConditionFormula>(Core_MDF_Maximum_Approved_Budget_Amt__c &lt; 0)</errorConditionFormula>
        <errorMessage>Max Approved Budget cannot be negative.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PartnerNonEditable</fullName>
        <active>true</active>
        <description>Make partner account field non-editable once assigned</description>
        <errorConditionFormula>ISCHANGED( Core_MDF_Budget_Partner__c)</errorConditionFormula>
        <errorMessage>Account Node cannot be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventBudgetEditingByFM</fullName>
        <active>true</active>
        <errorConditionFormula>AND( AND( OR( $Permission.Core_MDF_FinanceManager, $Permission.Core_MDF_BudgetApprover ), OR( AND( Core_MDF_Program_Nm__c == &apos;Client&apos;, OR( AND( NOT($Permission.Core_MDF_CCP_Internal_CCF_MDF_Budget_Loader), NOT($Permission.Core_MDF_CCP_Internal_CCF_User), NOT($Permission.Core_MDF_CCP_Internal_Finance_User) ), AND( $Permission.Core_MDF_CCP_Internal_CCF_MDF_Budget_Loader, NOT($Permission.Core_MDF_CCP_Internal_CCF_User), NOT($Permission.Core_MDF_CCP_Internal_Finance_User), OR( Core_MDF_Legacy_Budget_Ind__c, TEXT(Core_MDF_Budget_Type_Txt__c) == &apos;OEM CMP&apos; ) ), AND( $Permission.Core_MDF_CCP_Internal_CCF_User, $Permission.Core_MDF_CCP_Internal_Finance_User, NOT($Permission.Core_MDF_CCP_Internal_CCF_MDF_Budget_Loader), NOT(Core_MDF_Legacy_Budget_Ind__c), TEXT(Core_MDF_Budget_Type_Txt__c) != &apos;OEM CMP&apos; ), AND( $Permission.Core_MDF_CCP_Internal_CCF_MDF_Budget_Loader, $Permission.Core_MDF_CCP_Internal_Finance_User, NOT($Permission.Core_MDF_CCP_Internal_CCF_User), OR( Core_MDF_Legacy_Budget_Ind__c, TEXT(Core_MDF_Budget_Type_Txt__c) == &apos;OEM CMP&apos; ) ), AND( NOT($Permission.Core_MDF_CCP_Internal_CCF_MDF_Budget_Loader), $Permission.Core_MDF_CCP_Internal_Finance_User, NOT($Permission.Core_MDF_CCP_Internal_CCF_User), OR( Core_MDF_Legacy_Budget_Ind__c, TEXT(Core_MDF_Budget_Type_Txt__c) == &apos;OEM CMP&apos; ) ) ) ), AND( Core_MDF_Program_Nm__c == &apos;Datacenter&apos;, OR( AND( NOT($Permission.Core_MDF_CCP_Internal_DCF_MDF_Budget_Loader), NOT($Permission.Core_MDF_CCP_Internal_DCF_User), NOT($Permission.Core_MDF_CCP_Internal_Finance_User) ), AND( $Permission.Core_MDF_CCP_Internal_DCF_MDF_Budget_Loader, NOT($Permission.Core_MDF_CCP_Internal_DCF_User), NOT($Permission.Core_MDF_CCP_Internal_Finance_User), OR( Core_MDF_Legacy_Budget_Ind__c, TEXT(Core_MDF_Budget_Type_Txt__c) == &apos;OEM CMP&apos;, TEXT(Core_MDF_Budget_Type_Txt__c) == &apos;Service Provider CMP&apos; ) ), AND( $Permission.Core_MDF_CCP_Internal_Finance_User, $Permission.Core_MDF_CCP_Internal_DCF_User, NOT($Permission.Core_MDF_CCP_Internal_DCF_MDF_Budget_Loader), NOT(Core_MDF_Legacy_Budget_Ind__c), TEXT(Core_MDF_Budget_Type_Txt__c) != &apos;OEM CMP&apos;, TEXT(Core_MDF_Budget_Type_Txt__c) != &apos;Service Provider CMP&apos; ), AND( $Permission.Core_MDF_CCP_Internal_DCF_MDF_Budget_Loader, $Permission.Core_MDF_CCP_Internal_Finance_User, NOT($Permission.Core_MDF_CCP_Internal_DCF_User), OR( Core_MDF_Legacy_Budget_Ind__c, TEXT(Core_MDF_Budget_Type_Txt__c) == &apos;OEM CMP&apos;, TEXT(Core_MDF_Budget_Type_Txt__c) == &apos;Service Provider CMP&apos; ) ), AND( NOT($Permission.Core_MDF_CCP_Internal_DCF_MDF_Budget_Loader), $Permission.Core_MDF_CCP_Internal_Finance_User, NOT($Permission.Core_MDF_CCP_Internal_DCF_User), OR( Core_MDF_Legacy_Budget_Ind__c, TEXT(Core_MDF_Budget_Type_Txt__c) == &apos;OEM CMP&apos;, TEXT(Core_MDF_Budget_Type_Txt__c) == &apos;Service Provider CMP&apos; ) ) ) ), AND( Core_MDF_Program_Nm__c == &apos;Retail Marketing Funds&apos;, NOT($Permission.Core_MDF_CCP_Internal_Retail_Finance_Usr) ), AND( Core_MDF_Program_Nm__c == &apos;Intel Partner Alliance&apos;, RecordType.DeveloperName == &apos;Core_MDF_IPA_Account_Based&apos;, NOT($Permission.Core_MDF_CCP_Internal_IPA_Budget_Loader) ), AND( Core_MDF_Program_Nm__c == &apos;Co-GTM&apos;, RecordType.DeveloperName == &apos;Core_MDF_Co_GTM&apos;, NOT($Permission.Core_MDF_CCP_Internal_Co_GTM_Budget_Loader) ), AND( Core_MDF_Program_Nm__c == &apos;Co-Inv&apos;, RecordType.DeveloperName == &apos;Core_MDF_Co_Inv&apos;, NOT($Permission.Core_MDF_CCP_Internal_Co_Inv_Budget_Loader) ) ) ), IF( AND( AND( ISCHANGED(Amount), PRIORVALUE(Core_MDF_Decrease_Budget_Amount_Amt__c) &gt; 0 ), ISPICKVAL(Core_MDF_Budget_Status__c, &apos;Released&apos;) ), false, IF( OR( ISCHANGED(Amount), ISCHANGED(Type), ISCHANGED(Description), ISCHANGED(OwnerId), ISCHANGED(Core_MDF_Program__c), ISCHANGED(StartDate), ISCHANGED(Title), ISCHANGED(EndDate), ISCHANGED(Core_MDF_Decrease_Budget_Amount_Amt__c) ), true, false ) ) )</errorConditionFormula>
        <errorMessage>You cannot update the budget attributes other than Budget Status with your current level of access.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventDowngradingStatusbyFM</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
OR($Permission.Core_MDF_FinanceManager,$Permission.Core_MDF_BudgetApprover),
ISPICKVAL(PRIORVALUE(Core_MDF_Budget_Status__c),&apos;Released&apos;), 
ISCHANGED( Core_MDF_Budget_Status__c )  
)</errorConditionFormula>
        <errorMessage>Budget status cannot be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Program_Cannot_Be_Edited</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(PRIORVALUE(Core_MDF_Program__c))),ISCHANGED(Core_MDF_Program__c))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Program__c</errorDisplayField>
        <errorMessage>Program cannot be changed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RestrictLegacyBudgetCreation</fullName>
        <active>false</active>
        <description>Restrict User from creating legacy budget</description>
        <errorConditionFormula>AND( ISNEW() ,
OR(TEXT(Core_MDF_Budget_Type_Txt__c)=&apos;CCF 1.0&apos;,
TEXT(Core_MDF_Budget_Type_Txt__c)=&apos;DCF 1.0&apos;,
ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c,&apos;Client CoMarketing Fund Boost&apos;),
ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Service Provider CoMarketing Fund&apos;)
)
)</errorConditionFormula>
        <errorMessage>Cannot create budget for the selected Program/Budget Type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_AccountSelection</fullName>
        <active>true</active>
        <errorConditionFormula>IF( Core_MDF_Program_Nm__c == $Label.Core_MDF_EEF_Program_Name, NOT(INCLUDES(  Core_MDF_Budget_Partner__r.Core_MDF_Partner_Type_nm__c , &apos;Primary Partner&apos;)) , false)</errorConditionFormula>
        <errorMessage>You are not authorized to create the record for the selected Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ValidateAmount</fullName>
        <active>true</active>
        <errorConditionFormula>Amount &gt; 9999999999999</errorConditionFormula>
        <errorMessage>Amount cannot be greater than 9999999999999</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ValidateBudgetTypForCCPProgram</fullName>
        <active>true</active>
        <description>Error message will be thrown if budget type is not blank for other than ccf and dcf programs</description>
        <errorConditionFormula>OR(AND(
RecordType.DeveloperName = $Label.Core_MDF_CoMarketing_Budget_Record_type,
NOT(ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c,&apos;Client CoMarketing Fund&apos;)),
NOT(ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Data Center CoMarketing Fund&apos;)),
NOT(ISBLANK(TEXT(Core_MDF_Budget_Type_Txt__c)))), 
AND(RecordType.DeveloperName = $Label.Core_MDF_CoMarketing_Budget_Record_type,ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c,&apos;Client CoMarketing Fund&apos;),OR((TEXT(Core_MDF_Budget_Type_Txt__c)=&apos;DCF 1.0&apos;),(TEXT(Core_MDF_Budget_Type_Txt__c)=&apos;Service Provider CMP&apos;))),
AND(RecordType.DeveloperName = $Label.Core_MDF_CoMarketing_Budget_Record_type,ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c,&apos;Data Center CoMarketing Fund&apos;),TEXT(Core_MDF_Budget_Type_Txt__c)=&apos;CCF 1.0&apos;))</errorConditionFormula>
        <errorMessage>Budget Type is not applicable for selected program</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Budget_Class_Check</fullName>
        <active>false</active>
        <description>This validation rule ensures that the checkbox selection aligns with the Budget Classification picklist value. - If &apos;Co-marketing&apos; is selected, only the &apos;Marketing Approval of Co-Marketing&apos; checkbox can be checked. - If &apos;Co-Selling&apos; is selected, only the</description>
        <errorConditionFormula>AND( ISPICKVAL(Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c, &apos;CoInv&apos;), OR( AND( ISPICKVAL(Core_MDF_Budget_Classification__c, &apos;Co-marketing&apos;), Core_MDF_Co_Selling_ind__c = TRUE ), AND( ISPICKVAL(Core_MDF_Budget_Classification__c, &apos;Co-Selling&apos;), Core_MDF_Co_Marketing_ind__c = TRUE ), AND( Core_MDF_Co_Marketing_ind__c = TRUE, Core_MDF_Co_Selling_ind__c = TRUE ) ) )</errorConditionFormula>
        <errorMessage>Invalid Checkbox Selection: For &apos;Co-marketing&apos;, check only &apos;Marketing Approval of Co-Marketing&apos;. For &apos;Co-Selling&apos;, check only &apos;Field Sales Approval of Co-Selling&apos;. Both checkboxes cannot be selected simultaneously.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Test_validation_Rule</fullName>
        <active>false</active>
        <errorConditionFormula>Test_validation_Rule__c</errorConditionFormula>
        <errorMessage>Exception</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Core_MDF_Export_List_View</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Export List View</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/apex/Core_MDF_ExportToExcel?ObjName=PartnerMarketingBudget</url>
    </webLinks>
</CustomObject>
