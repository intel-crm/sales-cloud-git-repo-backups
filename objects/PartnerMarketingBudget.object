    <listViews>
        <fullName>All_Partner_Marketing_Budgets</fullName>
        <columns>Name</columns>
        <columns>Core_MDF_Budget_Partner__c</columns>
        <columns>Core_MDF_Budget_Status__c</columns>
        <columns>Core_MDF_Program__c</columns>
        <columns>StartDate</columns>
        <columns>EndDate</columns>
        <filterScope>Everything</filterScope>
        <label>All Budgets</label>
    </listViews>
    <listViews>
        <fullName>Budgets_FY_2019_Retail</fullName>
        <columns>Name</columns>
        <columns>Core_MDF_Budget_Partner__c</columns>
        <columns>Core_MDF_Budget_Status__c</columns>
        <columns>Amount</columns>
        <columns>StartDate</columns>
        <columns>EndDate</columns>
        <columns>Core_MDF_Program__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>StartDate</field>
            <operation>greaterOrEqual</operation>
            <value>1/1/2019</value>
        </filters>
        <filters>
            <field>EndDate</field>
            <operation>lessOrEqual</operation>
            <value>12/31/2019</value>
        </filters>
        <filters>
            <field>Core_MDF_Program__c</field>
            <operation>equals</operation>
            <value>Retail Marketing Funds</value>
        </filters>
        <label>Budgets FY 2019 - Retail</label>
        <sharedTo>
            <group>Core_MDF_CCP_Internal_Retail_All</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Budgets_Requiring_Approval_Retail</fullName>
        <columns>Name</columns>
        <columns>Core_MDF_Budget_Partner__c</columns>
        <columns>Core_MDF_Budget_Status__c</columns>
        <columns>Amount</columns>
        <columns>StartDate</columns>
        <columns>EndDate</columns>
        <columns>Core_MDF_Program__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Budget_Status__c</field>
            <operation>equals</operation>
            <value>Pending Review</value>
        </filters>
        <filters>
            <field>Core_MDF_Program__c</field>
            <operation>equals</operation>
            <value>Retail Marketing Funds</value>
        </filters>
        <label>Budgets Requiring Approval - Retail</label>
        <sharedTo>
            <group>Core_MDF_CCP_Retail_APJ_FinMgr_Q_Grp</group>
            <group>Core_MDF_CCP_Retail_ASMOLAR_FinMgr_Q_Grp</group>
            <group>Core_MDF_CCP_Retail_ASMONAR_FinMgr_Q_Grp</group>
            <group>Core_MDF_CCP_Retail_EMEA_FinMgr_Q_Grp</group>
            <group>Core_MDF_CCP_Retail_PRC_FinMgr_Q_Grp</group>
            <group>Core_MDF_CCP_Retail_WW_Fin_Mgr_Queue_Grp</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Budgets_to_be_Released_Retail</fullName>
        <columns>Name</columns>
        <columns>Core_MDF_Budget_Partner__c</columns>
        <columns>Core_MDF_Budget_Status__c</columns>
        <columns>Amount</columns>
        <columns>StartDate</columns>
        <columns>EndDate</columns>
        <columns>Core_MDF_Program__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Budget_Status__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </filters>
        <filters>
            <field>Core_MDF_Program__c</field>
