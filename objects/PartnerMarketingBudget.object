    <fields>
        <fullName>Core_MDF_Budget_Comments__c</fullName>
        <description>Comments related to the budget</description>
        <label>Budget Comments</label>
        <length>1000</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Consumption__c</fullName>
        <description>Percentage of Budget Consumption</description>
        <externalId>false</externalId>
        <formula>IF(Amount &gt; 0, IMAGE(&quot;/img/samples/color_red.gif&quot;,&quot;red&quot;,10,(( TotalApprovedFcs /Amount)*100)) &amp;
IMAGE(&quot;/img/samples/color_green.gif&quot;,&quot;green&quot;,10, 100 - ((TotalApprovedFcs /Amount)*100)) &amp;
&quot; &quot; &amp;  TEXT(ROUND(((TotalApprovedFcs /Amount)*100),2)) &amp; &quot;%&quot;, &quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This field represents percentage of budget consumed by claims submitted for the budget period that are in either Payment Due, Pending Payment or Paid Status.</inlineHelpText>
        <label>Budget Consumption %</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Identifier__c</fullName>
        <externalId>false</externalId>
        <formula>Core_MDF_Program__r.Name  &amp; &quot; - &quot; &amp; Core_MDF_Budget_Partner__r.Name &amp; &quot; - &quot; &amp;  TEXT(YEAR( StartDate ))</formula>
        <label>Budget Identifier</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Partner__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>The Partner this budget is associated with</description>
        <label>Account Node</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>$Source.Core_MDF_Program__c</field>
                <operation>equals</operation>
                <valueField>Account.Core_MDF_Channel_Program__c</valueField>
            </filterItems>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>CoMarketing</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_Parent_Fund_Account__r.RecordTypeId</field>
                <operation>notEqual</operation>
                <value>CoMarketing</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Partner Marketing Budgets</relationshipLabel>
        <relationshipName>Partner_Marketing_Budgets</relationshipName>
        <required>true</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Status__c</fullName>
        <description>The Status of a Budget</description>
        <label>Budget Status</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Pending Review</fullName>
                    <default>false</default>
                    <label>Pending Review</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>Released</fullName>
                    <default>false</default>
                    <label>Released</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Type_Report_txt__c</fullName>
        <description>If budget type value is blank then it will store Not Applicable (for xCF), else it will store Budget Type value. This field is created for Account Balances Report</description>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Core_MDF_Budget_Type_Txt__c,&apos;&apos;), $Label.Core_MDF_Not_Applicable_value_for_Budget_Type, TEXT(Core_MDF_Budget_Type_Txt__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Budget Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
