        <inlineHelpText>Marketing Approval required for funding Co-Selling Tactic(s)</inlineHelpText>
        <label>Co-Marketing</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Co_Selling_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Field Sales Approval required for funding Co-Marketing Tactic(s)</description>
        <inlineHelpText>Field Sales Approval required for funding Co-Marketing Tactic(s)</inlineHelpText>
        <label>Co-Selling</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_CreatedBy_Nm__c</fullName>
        <description>Shows the name for external user if created by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF (
ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;),
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Decrease_Budget_Amount_Amt__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Amount the budget should be reduced by 
Amount= Amount - Budget_Reduction_Amount</description>
        <inlineHelpText>Enter the amount the budget should be reduced by</inlineHelpText>
        <label>Budget Reduction Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Geo__c</fullName>
        <label>Region</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>APJ</fullName>
                    <default>false</default>
                    <label>APJ</label>
                </value>
                <value>
                    <fullName>ASMO</fullName>
                    <default>false</default>
                    <label>ASMO</label>
                </value>
                <value>
                    <fullName>EMEA</fullName>
                    <default>false</default>
                    <label>EMEA</label>
                </value>
                <value>
                    <fullName>PRC</fullName>
                    <default>false</default>
                    <label>PRC</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Intermediate_Budget_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Intermediate Budget</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_IsApprovalProcessBypassed_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>IsApprovalProcessBypassed</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Last_ModifiedBy_Nm__c</fullName>
        <description>Shows the name for external user if last modified by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(LastModifiedBy.Profile.UserType,&apos;PowerPartner&apos;),
LastModifiedBy.FirstName &amp; &apos; &apos; &amp; LastModifiedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Last Modified By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Legacy_Budget_Ind__c</fullName>
        <formula>IF(
OR(
AND(Core_MDF_Program_Nm__c = $Label.Core_MDF_CCF_Program_Name,TEXT(Core_MDF_Budget_Type_Txt__c) = $Label.Core_MDF_BudgetType_CCF1_0),
AND(Core_MDF_Program_Nm__c = $Label.Core_MDF_Non_Localized_DCF_Program_Name,TEXT(Core_MDF_Budget_Type_Txt__c) = $Label.Core_MDF_BudgetType_DCF1_0),
Core_MDF_Program_Nm__c= $Label.Core_MDF_CCFB_Program_Name,
Core_MDF_Program_Nm__c= $Label.Core_MDF_SPCF_Program_Name
), true, false)</formula>
        <label>Legacy Budget</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Maximum_Approved_Budget_Amt__c</fullName>
        <inlineHelpText>Full budget, visible to Intel only</inlineHelpText>
        <label>Maximum Approved Budget</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Owner_Nm__c</fullName>
        <description>Shows the name for external user if Owner is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF( 
ISPICKVAL( Owner:User.Profile.UserType ,&apos;PowerPartner&apos;), 
Owner:User.FirstName  &amp; &apos; &apos; &amp;  Owner:User.LastName , 
$Label.Core_MDF_Intel_System_User 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Program_Nm__c</fullName>
        <description>Program Name</description>
        <externalId>false</externalId>
        <formula>Core_MDF_Program__r.Name</formula>
        <label>Program Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
