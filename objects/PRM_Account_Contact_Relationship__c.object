            <values>
                <fullName>Admin Invite</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Bulk Add</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Bulk Invite</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Partner Invite</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>PRM_Status_Nm__c</picklist>
            <values>
                <fullName>Complete</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Action</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts>
        <searchFilterFields>NAME</searchFilterFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>PRM_BlockedEmailDomain</fullName>
        <active>false</active>
        <description>The Account Contact Relationship can&apos;t be active for blocked domains for Intel Partner Alliance Program.</description>
        <errorConditionFormula>AND(
	AND($User.FirstName &lt;&gt; &quot;IPA&quot;, $User.LastName &lt;&gt; &quot;Data Migration User &quot;),
	NOT(PRM_InActive_Ind__c),
	PRM_Contact_Id__r.RecordType.Name = &quot;Intel Contact&quot;,
	OR(
		/* PRC Logic */
			AND(
			ISPICKVAL(PRM_Account_Id__r.Core_Geo__c, &quot;PRC&quot;),
			OR(
			CONTAINS(&quot;;&quot; &amp; $Label.Blocked_Domains_Prc1 &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT(PRM_Contact_Id__r.Email, LEN(PRM_Contact_Id__r.Email) - FIND(&quot;@&quot;, PRM_Contact_Id__r.Email)) &amp; &quot;;&quot;),
			CONTAINS(&quot;;&quot; &amp; $Label.Blocked_Domains_Prc2 &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT(PRM_Contact_Id__r.Email, LEN(PRM_Contact_Id__r.Email) - FIND(&quot;@&quot;, PRM_Contact_Id__r.Email)) &amp; &quot;;&quot;)
			)
			),
			/* Non-PRC Logic */
			AND(
			NOT(ISPICKVAL(PRM_Account_Id__r.Core_Geo__c, &quot;PRC&quot;)),
			OR(
			CONTAINS(&quot;;&quot; &amp; $Label.Blocked_Domains_Non_Prc1 &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT(PRM_Contact_Id__r.Email, LEN(PRM_Contact_Id__r.Email) - FIND(&quot;@&quot;, PRM_Contact_Id__r.Email)) &amp; &quot;;&quot;),
			CONTAINS(&quot;;&quot; &amp; $Label.Blocked_Domains_Non_Prc2 &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT(PRM_Contact_Id__r.Email, LEN(PRM_Contact_Id__r.Email) - FIND(&quot;@&quot;, PRM_Contact_Id__r.Email)) &amp; &quot;;&quot;),
			CONTAINS(&quot;;&quot; &amp; $Label.Blocked_Domains_Non_Prc3 &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT(PRM_Contact_Id__r.Email, LEN(PRM_Contact_Id__r.Email) - FIND(&quot;@&quot;, PRM_Contact_Id__r.Email)) &amp; &quot;;&quot;)
			)
			)
	)
)</errorConditionFormula>
        <errorMessage>This email domain is not allowed for Intel Partner Alliance program. Please register with corporate email domain</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_Contact_Embargoed_Country_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Permission.PCC_Bypass_Automation = false,
PRM_Account_Id__r.Core_Intel_Partner_Alliance_PartnerGroup__c = TRUE,
PRM_InActive_Ind__c = FALSE,
OR(
CONTAINS($Label.PRM_Embargoed_country , PRM_Contact_Id__r.MailingCountry),
CONTAINS($Label.PRM_Embargoed_country , PRM_Account_Id__r.BillingCountry)
),
NOT(ISBLANK(PRM_Contact_Id__r.MailingCountry)),
NOT(ISBLANK(PRM_Account_Id__r.BillingCountry))
)</errorConditionFormula>
        <errorDisplayField>PRM_Contact_Id__c</errorDisplayField>
        <errorMessage>This registration was denied because the registrant identified their location as an embargoed country or their IP address is from an embargoed country. For more information please visit https://goto.intel.com/gec-sanctioned-country-info</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_Contact_Relationship_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF( ISBLANK( PRM_Relationship_Id__c ) , true, false)</errorConditionFormula>
        <errorDisplayField>PRM_Relationship_Id__c</errorDisplayField>
        <errorMessage>Contact Relationship is required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_WebsiteCheck</fullName>
        <active>true</active>
        <errorConditionFormula>AND( PRM_SkipValidation__c==false,ISBLANK(PRM_Account_Id__r.Core_User_Defined_Website__c),OR(AND( ISNEW(), PRM_Relationship_Id__r.Name =&quot;Employee&quot;, ISPICKVAL(PRM_Status_Nm__c ,&quot;Pending Action&quot; ) ) ,
AND(NOT( ISNEW()) ,PRM_Relationship_Id__r.Name =&quot;Employee&quot;,AND(ISCHANGED(PRM_InActive_Ind__c ), PRIORVALUE(PRM_InActive_Ind__c )=true), ISPICKVAL(PRM_Status_Nm__c ,&quot;Pending Action&quot; ))
))</errorConditionFormula>
        <errorMessage>Website is mandatory for extending invite</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
