    <fields>
        <fullName>PRM_Partner_Role_UI__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Not Applicable&quot;),&quot;Not Applicable&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Distributor&quot;),&quot;Distributor&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;FPGA Designer&quot;),&quot;FPGA Design Services&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Independent Software Vendor&quot;),&quot;Independent Software Vendor&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Manufacturer&quot;),&quot;Manufacturer&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Seller&quot;),&quot;Solution Provider&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Service Provider&quot;),&quot;Cloud &amp; Comms Service Provider&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Solution Integrator&quot;),&quot;Solution Integrator&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Builder&quot;),&quot;Builder&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Sponsor&quot;),&quot;Sponsor&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Original Equipment Manufacturer (OEM)&quot;),&quot;Original Equipment Manufacturer (OEM)&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Guest&quot;),&quot;Guest&quot;,null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Partner Role</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Partner_Role__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Not Applicable&quot;),&quot;Not Applicable&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Distributor&quot;),&quot;Distributor&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;FPGA Designer&quot;),&quot;FPGA Designer&quot;,null)+ 
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Independent Software Vendor&quot;),&quot;Independent Software Vendor&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Manufacturer&quot;),&quot;Manufacturer&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Seller&quot;),&quot;Seller&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Service Provider&quot;),&quot;Service Provider&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Solution Integrator&quot;),&quot;Solution Integrator&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Sponsor&quot;),&quot;Sponsor&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Builder&quot;),&quot;Builder&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Original Equipment Manufacturer (OEM)&quot;),&quot;Original Equipment Manufacturer (OEM)&quot;,null)+
IF(ISPICKVAL(PRM_Contact_Id__r.Core_IPA_PartnerRole__c,&quot;Guest&quot;),&quot;Guest&quot;,null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Partner Role</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
