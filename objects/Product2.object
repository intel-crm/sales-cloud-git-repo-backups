        <fullName>Core_End_of_Intel_Service_Flag__c</fullName>
        <formula>NOT(OR( ISNULL(Core_End_of_Intel_Service_Date__c) ,
(  Core_End_of_Intel_Service_Date__c &gt; TODAY() ) ))</formula>
        <label>End of Intel Service Flag</label>
