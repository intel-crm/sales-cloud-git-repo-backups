    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Core_IPS_Cannot_Revert_IPS_Visible</fullName>
        <active>true</active>
        <description>Once the IPS Internal Visible flag is set to True, it cannot be set to False.
This is needed to ensure there is no cascading impact to Assets, MAP, PAR and Case that uses a particular Product ID.</description>
        <errorConditionFormula>AND
(
OR 
(
TEXT( Core_IPS_Visible_Flag_Internal__c ) = &quot;NO&quot;, 
TEXT( Core_IPS_Visible_Flag_Internal__c ) = &quot;&quot;
),
TEXT (PRIORVALUE ( Core_IPS_Visible_Flag_Internal__c )) = &quot;YES&quot;
)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Visible_Flag_Internal__c</errorDisplayField>
        <errorMessage>Once set to Yes, IPS Visible Flag (Internal) cannot be reverted. Press Cancel to Exit.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_No_Sales_Product_for_IPS</fullName>
        <active>true</active>
        <description>The Product_Org must be IPS, for the IPS Visible Internal flag to be set to True.</description>
        <errorConditionFormula>IF (
NOT (ISPICKVAL(Core_Product_Org__c, &apos;IPS&apos;)),
IF ( Core_IPS_Visible_Flag__c, TRUE, FALSE), FALSE
)</errorConditionFormula>
        <errorDisplayField>Core_IPS_Visible_Flag_Internal__c</errorDisplayField>
        <errorMessage>Not an IPS product. Cannot be made IPS Visible. Click Cancel to exit.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_IPS_OrgAdm_Name_Edit</fullName>
        <active>true</active>
        <description>Prevent the editing of the Name field for IPS Prod Support Org users</description>
        <errorConditionFormula>$Profile.Name =&apos;IPS Support Org Admin&apos; &amp;&amp; 
(ISCHANGED( Name))</errorConditionFormula>
        <errorMessage>Cannot Edit Name field</errorMessage>
    </validationRules>
</CustomObject>
