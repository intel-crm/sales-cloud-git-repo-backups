<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Metadata to store image Url of different tiles shown in Marketplace</description>
    <fields>
        <fullName>PMP_Tile_Id__c</fullName>
        <description>PIM Id or Specific Id of tile other than record id</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Tile Id</label>
        <length>60</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Tile_Type__c</fullName>
        <description>List of different tile types shown in Marketplace</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Tile Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Intel Partner Directory</fullName>
                    <default>true</default>
                    <label>Intel Partner Directory</label>
                </value>
                <value>
                    <fullName>Product Categories</fullName>
                    <default>false</default>
                    <label>Product Categories</label>
                </value>
                <value>
                    <fullName>Specialists Group</fullName>
                    <default>false</default>
                    <label>Specialists Group</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMP_Url__c</fullName>
        <description>URL of the tiles</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Url</label>
        <required>false</required>
        <type>Url</type>
    </fields>
    <label>PMP Tiles Image Url</label>
    <pluralLabel>PMP Tiles Images Url</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
