    <fields>
        <fullName>Requester__c</fullName>
        <externalId>false</externalId>
        <formula>Owner:User.FirstName&amp;&quot;,&quot;&amp;Owner:User.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
