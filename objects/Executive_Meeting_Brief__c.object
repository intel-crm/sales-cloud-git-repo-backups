        <label>Executive Meeting Brief</label>
        <picklistValues>
            <picklist>Brief_Status__c</picklist>
            <values>
                <fullName>Draft</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Final</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>CRM_Agentic_Drafting_Status__c</picklist>
            <values>
                <fullName>Completed</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>In Progress</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>CRM_Dress_Code__c</picklist>
            <values>
                <fullName>Business Casual</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Formal</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>CRM_Agentic_Brief_Generation_Check</fullName>
        <active>true</active>
        <description>Validation rule to check agentic brief generation before Status Update to Ready for Review or Final</description>
        <errorConditionFormula>AND(
    OR(
        ISPICKVAL(Brief_Status__c, &quot;Ready for Review&quot;),
        ISPICKVAL(Brief_Status__c, &quot;Final&quot;)
    ),
    RecordType.DeveloperName = &quot;CRM_New_Executive_Meeting_Brief&quot;,
    ISBLANK(CRM_Rating__c)
)</errorConditionFormula>
        <errorMessage>Agentic Brief Generation must be completed before updating status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_StartDate_EndDate_Validation</fullName>
        <active>true</active>
        <description>Validation to check the Endate &amp; Startdate</description>
        <errorConditionFormula>OR(
    CRM_Scheduled_End_Date__c &lt; CRM_Start_Date__c,
    AND(
        CRM_Scheduled_End_Date__c = CRM_Start_Date__c,
        CRM_Scheduled_End_Time_Only__c &lt;= CRM_Start_Time__c
    )
)</errorConditionFormula>
        <errorMessage>Scheduled Start Date and Time must not be greater than Scheduled End Date and Time.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_Timezone_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT(ISNEW()),
OR(ISCHANGED(CRM_Start_Time__c),ISCHANGED(CRM_Scheduled_End_Time_Only__c), ISCHANGED(CRM_Start_Date__c), ISCHANGED(CRM_Scheduled_End_Date__c)),
RecordType.DeveloperName = &apos;CRM_New_Executive_Meeting_Brief&apos;,
$Permission.CRM_New_Executive_Meeting_Brief_Custom_Permission,
ISBLANK(CRM_Time_Zone__c)
)</errorConditionFormula>
        <errorMessage>Please select the Meeting Timezone</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
