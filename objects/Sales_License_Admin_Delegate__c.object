    <validationRules>
        <fullName>Sales_Same_Primary_Delegate_NotAllowed</fullName>
        <active>true</active>
        <description>Primary Admin Contact should not be same as Delegate Admin Contact.</description>
        <errorConditionFormula>IF(
Sales_License_DlgAdmin_Contact__c = Sales_License_PrimaryAdmin_Contact__c , 
True, False)</errorConditionFormula>
        <errorMessage>Delegate Admin Contact and Primary Admin Contact cannot be same.</errorMessage>
    </validationRules>
