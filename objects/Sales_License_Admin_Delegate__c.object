    <fields>
        <fullName>Sales_LoggedInUserPrimaryAdmin__c</fullName>
        <formula>IF( ( NOT(ISBLANK($User.ContactId)) &amp;&amp; $User.ContactId =  Sales_License_PrimaryAdmin_Contact__c ), True, False )</formula>
