<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This Metadata used to manage VAT Program, Country ,Budget Type, VAT Enable</description>
    <fields>
