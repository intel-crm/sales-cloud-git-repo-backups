    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Validate_Compliant_Responses</fullName>
        <active>false</active>
        <description>Validates if every Compliant Checklist response does not have an Impact Amount tied to it.</description>
        <errorConditionFormula>IF(AND(ISPICKVAL(Core_MDF_Checklist_Status__c, &apos;Compliant&apos;),  !ISNULL(Core_MDF_Impact_Amount__c)),true,false)</errorConditionFormula>
        <errorMessage>Remove Impact Amount from items checked Compliant, or mark items with Impact Amount as Non-compliant</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_Impact_Amount</fullName>
        <active>false</active>
        <description>Impact Amount should be greater than 0</description>
        <errorConditionFormula>if(Core_MDF_Impact_Amount__c &lt;0,true,false)</errorConditionFormula>
        <errorMessage>Enter Impact Amount (local) greater than or equal to 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_NonCompliant_Responses</fullName>
        <active>true</active>
        <description>Validates if every Non-Compliant Checklist response has an Impact Amount tied to it.</description>
        <errorConditionFormula>IF(AND(ISPICKVAL(Core_MDF_Checklist_Status__c, &apos;Non-Compliant&apos;),  ISNULL(Core_MDF_Impact_Amount__c) || Core_MDF_Impact_Amount__c &lt;0),true,false)</errorConditionFormula>
        <errorMessage>Enter Impact Amount (local) greater than or equal to 0</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
