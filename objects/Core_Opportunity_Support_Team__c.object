    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Store the users that will work on the Opportunity Support</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_Approval_Comment_History__c</fullName>
        <description>Captures the History of the Approvers</description>
        <label>Approval Comment History</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Approval_Comment__c</fullName>
        <label>Approval Comments</label>
        <length>2500</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Support_Team_Member__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The user that will support the Opportunity</description>
        <label>Opportunity Support Team Member</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>User.IsActive</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>User</referenceTo>
        <relationshipName>Core_Opportunity_Support_Team</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Opportunity_Support__c</fullName>
        <description>Associated with Opportunity Support record</description>
        <label>Opportunity Support</label>
        <referenceTo>Core_Opportunity_Support__c</referenceTo>
        <relationshipLabel>Opportunity Support Team</relationshipLabel>
        <relationshipName>Core_Opportunity_Support_Team</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Reassign_counter__c</fullName>
        <defaultValue>0</defaultValue>
        <externalId>false</externalId>
        <label>Reassign counter</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Status__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>New</fullName>
                    <default>false</default>
                    <label>New</label>
                </value>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Accepted</fullName>
                    <default>false</default>
                    <label>Accepted</label>
                </value>
                <value>
                    <fullName>Denied</fullName>
                    <default>false</default>
                    <label>Denied</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Not Submitted</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Not Submitted</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Opportunity Support Team</label>
    <nameField>
        <displayFormat>OST- {0000}</displayFormat>
        <label>Opportunity Support Team Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Opportunity Support Team</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>CRM_Restrict_STM_modifiey</fullName>
        <active>true</active>
        <description>Once Opportunity is Closed, Support Request cannot be Edited</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,OR(
Core_Opportunity_Support__r.Core_Sales_Stages__c = &apos;Design Win&apos;, 
Core_Opportunity_Support__r.Core_Sales_Stages__c = &apos;Production Win&apos;,
Core_Opportunity_Support__r.Core_Sales_Stages__c = &apos;Lost&apos;,
Core_Opportunity_Support__r.Core_Sales_Stages__c = &apos;Cancelled&apos;,
Core_Opportunity_Support__r.Core_Sales_Stages__c = &apos;Production Lost&apos;,
Core_Opportunity_Support__r.Core_Sales_Stages__c = &apos;Production Cancelled&apos;
))</errorConditionFormula>
        <errorMessage>Once Opportunity is Closed, Support Request cannot be Edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reassign_counter_limit</fullName>
        <active>true</active>
        <description>validation rule when user reach max reassignment limit</description>
        <errorConditionFormula>ISCHANGED( Core_Opportunity_Support_Team_Member__c ) &amp;&amp; Core_Reassign_counter__c &gt; 2</errorConditionFormula>
        <errorMessage>Reached max reassignment limit</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>core_adding_team_member</fullName>
        <active>true</active>
        <description>Only approver can add new user to CSA support request</description>
        <errorConditionFormula>AND ($Profile.Name &lt;&gt; &apos;System Administrator&apos; , $Profile.Name &lt;&gt; 
 &apos;IT Admin&apos;, OR (Core_Opportunity_Support__r.RecordType.DeveloperName  =&apos;Core_CSA_RecordType&apos; ,Core_Opportunity_Support__r.RecordType.DeveloperName  =&apos;Core_TSS_Request&apos; , Core_Opportunity_Support__r.RecordType.DeveloperName 
 =&apos;Core_Center_of_Excellence_Request&apos;), OR(ISNEW() ,ISCHANGED( Core_Opportunity_Support_Team_Member__c )  ),
NOT( Core_Opportunity_Support__r.Core_Approver_1__r.Id = $User.Id ||  Core_Opportunity_Support__r.Core_Approver_2__r.Id  =  $User.Id ||  Core_Opportunity_Support__r.Core_Approver_3__r.Id  =  $User.Id ||  Core_Opportunity_Support__r.Core_Approver_4__r.Id   =  $User.Id ||  Core_Opportunity_Support__r.Core_Approver_5__r.Id   =  $User.Id || 
Core_Opportunity_Support__r.Core_Approver_6__r.Id = $User.Id ||  Core_Opportunity_Support__r.Core_Approver_7__r.Id  =  $User.Id ||  Core_Opportunity_Support__r.Core_Approver_8__r.Id  =  $User.Id ||  Core_Opportunity_Support__r.Core_Approver_9__r.Id   =  $User.Id ||  Core_Opportunity_Support__r.Core_Approver_10__r.Id =  $User.Id),
NOT( $Permission.Data_Ops_Elevated_Access ))</errorConditionFormula>
        <errorDisplayField>Core_Opportunity_Support__c</errorDisplayField>
        <errorMessage>Only Approver can add new user to Opportunity support request</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
