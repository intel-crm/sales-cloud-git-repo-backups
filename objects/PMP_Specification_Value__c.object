        <fullName>PMP_Product_Status__c</fullName>
        <label>Product Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Launched</fullName>
                    <default>false</default>
                    <label>Launched</label>
                </value>
                <value>
                    <fullName>Roadmap</fullName>
                    <default>false</default>
                    <label>Roadmap</label>
                </value>
                <value>
                    <fullName>Discontinued</fullName>
                    <default>false</default>
                    <label>Discontinued</label>
                </value>
                <value>
                    <fullName>Announced</fullName>
                    <default>false</default>
                    <label>Announced</label>
                </value>
            </valueSetDefinition>
        </valueSet>
