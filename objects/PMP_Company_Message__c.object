    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Contains  the Messages related to Company Information.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>PMP_Company_Id__c</fullName>
        <description>This is a Master Detail field for the Company Information Object</description>
        <inlineHelpText>Company Information Id</inlineHelpText>
        <label>Marketing Profile ID</label>
        <referenceTo>PMP_Company__c</referenceTo>
        <relationshipLabel>Marketing  Profile Messages</relationshipLabel>
        <relationshipName>Company_Messages</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>PMP_Company_Lifecycle_Status_Nm__c</fullName>
        <description>This holds the partner life cycle status against which comments are stored</description>
        <externalId>false</externalId>
        <inlineHelpText>Company Information Status</inlineHelpText>
        <label>Marketing  Profile Information Lifecycle</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Internal_Message_Txt__c</fullName>
        <description>This stores the internal conversation between Admin and FAE</description>
        <label>Internal Message</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PMP_Message_By_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Look up user id who posted the offering message</description>
        <inlineHelpText>User</inlineHelpText>
        <label>Message By User Id</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Company_Messages</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMP_Message_By_User_Nm__c</fullName>
        <externalId>false</externalId>
        <formula>PMP_Message_By_Id__r.FirstName + &quot; &quot; + PMP_Message_By_Id__r.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Message By User Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Message_Dtm__c</fullName>
        <description>This holds the date and time the partner message got posted</description>
        <inlineHelpText>Partner Message Date</inlineHelpText>
        <label>Message Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMP_Message_Txt__c</fullName>
        <description>This field will store the Partner related Messages</description>
        <inlineHelpText>Partner Message</inlineHelpText>
        <label>Message</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PMP_Message_Type__c</fullName>
        <description>This holds the type of the message, either it can be message or status</description>
        <inlineHelpText>Message Type</inlineHelpText>
        <label>Message Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Message</fullName>
                    <default>false</default>
                    <label>Message</label>
                </value>
                <value>
                    <fullName>Status</fullName>
                    <default>false</default>
                    <label>Status</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Marketing Profile Message</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>Message-{0000}</displayFormat>
        <label>Company  Message Id</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Marketing Profile Messages</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
