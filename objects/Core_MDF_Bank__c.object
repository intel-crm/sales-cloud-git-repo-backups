    <fields>
        <fullName>Core_MDF_Note__c</fullName>
        <externalId>false</externalId>
        <formula>IF( INCLUDES(Core_MDF_Program__c, &quot;Core_MDF_Intel_Partner_Alliance&quot;),
($Label.Core_MDF_CorporateOrganizationAndMembershipChangeFormAndLink +&apos; &apos;+ HYPERLINK($Label.Core_MDF_IPA_BankDocLink, $Label.Core_MDF_CorporateOrganization2) +&apos; &apos;+ $Label.Core_MDF_CorporateOrganization +&apos; &apos;+HYPERLINK($Label.Core_MDF_IPABankCorpOrgMailId, $Label.Core_MDF_CorporateOrganizationMail)+&apos;&apos;+$Label.Core_MDF_CorporateOrganization3) ,
($Label.Core_MDF_CorporateOrganizationAndMembershipChangeFormAndLink +&apos; &apos;+ HYPERLINK($Label.Core_MDF_CorporateOrganizationDocLink, $Label.Core_MDF_CorporateOrganization2) +&apos; &apos;+ $Label.Core_MDF_CorporateOrganization +&apos; &apos;+HYPERLINK($Label.Core_MDF_CorporateOrganizationMailId, $Label.Core_MDF_CorporateOrganizationMail)+&apos;&apos;+$Label.Core_MDF_CorporateOrganization3))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Note</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
