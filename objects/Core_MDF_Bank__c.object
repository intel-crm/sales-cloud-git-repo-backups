    <sharingReasons>
        <fullName>Core_MDF_AccountNodeGroup__c</fullName>
        <label>AccountNodeGroup</label>
    </sharingReasons>
    <validationRules>
        <fullName>Core_MDF_Bank_Account_Not_Editable</fullName>
        <active>true</active>
        <description>Account should not be editable after initial Draft Stage.</description>
        <errorConditionFormula>AND(ISCHANGED(Core_MDF_Account__c),
    Core_MDF_ESD_Update__c 
   )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account__c</errorDisplayField>
        <errorMessage>Can only Edit Bank Account field when it&apos;s in initial Draft Status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Bank_Blank_Currency</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
	OR(
		ISNEW(),
		ISCHANGED(Core_MDF_Currency_cd__c)
	),
	ISPICKVAL(Core_MDF_Currency_cd__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Currency_cd__c</errorDisplayField>
        <errorMessage>Please select a supplier currency.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Bank_Blank_Payment_Currency</fullName>
        <active>true</active>
        <description>The payment currency on Bank cannot be blank for Retail Program.</description>
        <errorConditionFormula>AND( OR(ISNEW(),ISCHANGED(Core_MDF_Payment_Currency_Cd__c)),ISPICKVAL(Core_MDF_Payment_Currency_Cd__c, &quot;&quot;))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Payment_Currency_Cd__c</errorDisplayField>
        <errorMessage>Please select a payment currency.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Bank_Name_Non_Editable</fullName>
        <active>true</active>
        <description>Bank Name is non-editable.</description>
        <errorConditionFormula>AND( NOT( OR( $Profile.Name = &apos;System Administrator&apos;,$Profile.Name = &apos;IT Admin&apos;,$Profile.Name = &apos;Integration&apos;) ), ISCHANGED( Name ), Core_MDF_ESD_Update__c == true)</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Cannot edit this field at this time</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CheckUserPermission</fullName>
        <active>true</active>
        <description>Prevents user from creating a Bank when they are not associated to a particular program</description>
        <errorConditionFormula>AND(
  NOT($Permission.Core_MDF_Internal_CSC_User),
  OR(
AND(
INCLUDES( Core_MDF_Program__c,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_DCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_SPCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_CCFB_Payment_Admin, $Permission.Core_MDF_CCP_Internal_Retail_Payment_Admin,$Permission.Core_MDF_CCP_Internal_IPA_Payment_Admin,$Permission.Core_MDF_CCP_Internal_EEF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm),
NOT($Permission.Core_MDF_CCP_Internal_CCF_Payment_Admin)
),
AND(
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_SPCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_CCFB_Payment_Admin,
$Permission.Core_MDF_CCP_Internal_Retail_Payment_Admin,$Permission.Core_MDF_CCP_Internal_IPA_Payment_Admin,$Permission.Core_MDF_CCP_Internal_EEF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm),
NOT($Permission.Core_MDF_CCP_Internal_DCF_Payment_Admin)
),
AND(
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_DCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_CCFB_Payment_Admin,
$Permission.Core_MDF_CCP_Internal_Retail_Payment_Admin,$Permission.Core_MDF_CCP_Internal_IPA_Payment_Admin,$Permission.Core_MDF_CCP_Internal_EEF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm),
NOT($Permission.Core_MDF_CCP_Internal_SPCF_Payment_Admin)
),
AND(
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_DCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_SPCF_Payment_Admin,
$Permission.Core_MDF_CCP_Internal_Retail_Payment_Admin,$Permission.Core_MDF_CCP_Internal_IPA_Payment_Admin,$Permission.Core_MDF_CCP_Internal_EEF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm),
NOT($Permission.Core_MDF_CCP_Internal_CCFB_Payment_Admin)
),
AND(
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Retail_Marketing_Funds&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_DCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_SPCF_Payment_Admin,
$Permission.Core_MDF_CCP_Internal_CCFB_Payment_Admin,$Permission.Core_MDF_CCP_Internal_IPA_Payment_Admin,$Permission.Core_MDF_CCP_Internal_EEF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm),
NOT($Permission.Core_MDF_CCP_Internal_Retail_Payment_Admin)
),
AND(
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Intel_Partner_Alliance&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_DCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_SPCF_Payment_Admin,
$Permission.Core_MDF_CCP_Internal_CCFB_Payment_Admin,$Permission.Core_MDF_CCP_Internal_Retail_Payment_Admin,$Permission.Core_MDF_CCP_Internal_EEF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm),
NOT($Permission.Core_MDF_CCP_Internal_IPA_Payment_Admin)
),
AND(
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Ecosystem_Extension_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_DCF_Payment_Admin,$Permission.Core_MDF_CCP_Internal_SPCF_Payment_Admin,
$Permission.Core_MDF_CCP_Internal_CCFB_Payment_Admin,$Permission.Core_MDF_CCP_Internal_Retail_Payment_Admin,$Permission.Core_MDF_CCP_Internal_IPA_Payment_Admin,$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm),
NOT($Permission.Core_MDF_CCP_Internal_EEF_Payment_Admin)
    )
  )
)</errorConditionFormula>
        <errorMessage>Please select valid program</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EnterHoldReason</fullName>
        <active>true</active>
        <description>Throws an error when the hold reason is blank while the hold payment from ap file is set to true</description>
        <errorConditionFormula>AND( 
    Core_MDF_ESD_Update__c == TRUE,
    ISPICKVAL(Core_MDF_Hold_Payments_from_AP_file_ind__c,&apos;YES&apos;),
    ISBLANK(Core_MDF_Hold_Reason_txt__c),  Core_MDF_Ineffective_Selection_ind__c == False
)</errorConditionFormula>
        <errorMessage>Please enter a Hold Reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_InactiveBank_Uneditable_AP_Hold</fullName>
        <active>true</active>
        <description>Restricting the AP Hold and Hold Reason Field when bank is Inactive</description>
        <errorConditionFormula>OR(AND( Core_MDF_Ineffective_Selection_ind__c == True, ISCHANGED(Core_MDF_Hold_Payments_from_AP_file_ind__c), ISCHANGED( Core_MDF_Hold_Reason_txt__c )),(AND(Core_MDF_Ineffective_Selection_ind__c == True,OR(ISCHANGED(Core_MDF_Hold_Payments_from_AP_file_ind__c), ISCHANGED( Core_MDF_Hold_Reason_txt__c ))) ))</errorConditionFormula>
        <errorMessage>This bank is in Inactive status and cannot currently be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_LegalEntityForCCFDCFSPCFCCFB</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
	OR(ISNEW(), ISCHANGED(Core_MDF_Intel_Company_Code__c), ISCHANGED(Core_MDF_Program__c)),
	OR(
		ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;150&quot;),
		ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;220&quot;),
		ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;420&quot;),
		ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;650&quot;),
		ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;760&quot;)
	),
	OR(
		INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
		INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
		INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
		INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;)
	)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Intel_Company_Code__c</errorDisplayField>
        <errorMessage>Client/Datacenter/SPCF/CCFB can only select Legal Entity 100.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_LegalEntityForIPA</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    OR(ISNEW(), ISCHANGED(Core_MDF_Intel_Company_Code__c), ISCHANGED(Core_MDF_Program__c)),
    INCLUDES(Core_MDF_Program__c, &quot;Core_MDF_Intel_Partner_Alliance&quot;),
    ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;220&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Intel_Company_Code__c</errorDisplayField>
        <errorMessage>IPA cannot select Legal Entity 220.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_LegalEntityForRMF</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(ISNEW(), ISCHANGED(Core_MDF_Intel_Company_Code__c), ISCHANGED(Core_MDF_Program__c)),
INCLUDES(Core_MDF_Program__c, &quot;Core_MDF_Retail_Marketing_Funds&quot;),
OR(
ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;100&quot;),
ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;220&quot;)
)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Intel_Company_Code__c</errorDisplayField>
        <errorMessage>RMF cannot select Legal Entity 100/220.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_LegalEntityFor_Co_GTM</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    OR(ISNEW(), ISCHANGED(Core_MDF_Intel_Company_Code__c), ISCHANGED(Core_MDF_Program__c)),
    INCLUDES(Core_MDF_Program__c, &quot;Core_MDF_Co_GTM&quot;),
    ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;220&quot;)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Intel_Company_Code__c</errorDisplayField>
        <errorMessage>Co-GTM cannot select Legal Entity 220.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_LegalEntity_TaxCode_Restriction</fullName>
        <active>true</active>
        <description>To restrict the users to create a Bank with Intel Company code(Legal Entity) 420 and select I0 in the tax code.</description>
        <errorConditionFormula>AND(OR(ISNEW(), ISCHANGED(Core_MDF_Intel_Company_Code__c), ISCHANGED(Core_MDF_Tax_codes_cd__c)),
ISPICKVAL(Core_MDF_Intel_Company_Code__c, &quot;420&quot;),
ISPICKVAL(Core_MDF_Tax_codes_cd__c, &quot;I0&quot;))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Tax_codes_cd__c</errorDisplayField>
        <errorMessage>This Tax Code is not valid with the Intel Company Code selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_NoTaxCodeForCCFDCFSPCFCCFB</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
OR(ISNEW(), ISCHANGED(Core_MDF_Tax_codes_cd__c)),
NOT(ISBLANK(TEXT(Core_MDF_Tax_codes_cd__c))),
OR(
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;)
)
)</errorConditionFormula>
        <errorMessage>CCF/DCF/SPCF/CCFB cannot select Tax Code.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_NoTaxCodeForCCFDCFSPCFCCFBEEF</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
	OR(ISNEW(), ISCHANGED(Core_MDF_Tax_codes_cd__c)),
	NOT(ISBLANK(TEXT(Core_MDF_Tax_codes_cd__c))),
	OR(
		INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
		INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
		INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
		INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),
		INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Ecosystem_Extension_Fund&quot;)
	)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Tax_codes_cd__c</errorDisplayField>
        <errorMessage>Client/Datacenter/SPCF/CCFB/EEF cannot select Tax Code.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Paymentadmin_UserPermission</fullName>
        <active>true</active>
        <description>Prevents user from creating a Bank when they are not associated to a particular program</description>
        <errorConditionFormula>AND(
  NOT($Permission.Core_MDF_Internal_CSC_User),
  OR(
    AND(
      INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Co_GTM&quot;),
      OR($Permission.Core_MDF_CCP_Internal_CCF_Payment_Admin,
         $Permission.Core_MDF_CCP_Internal_DCF_Payment_Admin,
         $Permission.Core_MDF_CCP_Internal_SPCF_Payment_Admin,
         $Permission.Core_MDF_CCP_Internal_CCFB_Payment_Admin,
         $Permission.Core_MDF_CCP_Internal_Retail_Payment_Admin,
         $Permission.Core_MDF_CCP_Internal_IPA_Payment_Admin,
         $Permission.Core_MDF_CCP_Internal_EEF_Payment_Admin),
      NOT($Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm)
    )
  )
)</errorConditionFormula>
        <errorMessage>Please select valid program</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_MultipleProgSelection</fullName>
        <active>true</active>
        <description>To Restrict users from selecting more than one program value.</description>
        <errorConditionFormula>AND(ISNEW(),PICKLISTCOUNT(Core_MDF_Program__c) &gt; 1, OR(INCLUDES( Core_MDF_Program__c ,&apos;Core_MDF_Intel_Partner_Alliance&apos;),
INCLUDES(Core_MDF_Program__c,&apos;Core_MDF_Retail_Marketing_Funds&apos;)))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Program__c</errorDisplayField>
        <errorMessage>Please select only one Program value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_PaymtCurrency_ReadOnly</fullName>
        <active>true</active>
        <description>Restrict the change of payment currency other than USD for CCP and IPA programs</description>
        <errorConditionFormula>AND( OR(ISNEW(), ISCHANGED( Core_MDF_Payment_Currency_Cd__c )),
NOT( ISPICKVAL(Core_MDF_Payment_Currency_Cd__c, &apos;&apos;)), NOT( ISPICKVAL(Core_MDF_Payment_Currency_Cd__c, &quot;USD&quot;)), NOT(INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Retail_Marketing_Funds&quot;)))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Payment_Currency_Cd__c</errorDisplayField>
        <errorMessage>This payment currency is not valid for the program selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Program_Update</fullName>
        <active>true</active>
        <description>To restrict users from updating Program field.</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),
$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)), ISCHANGED( Core_MDF_Program__c ), INCLUDES( Core_MDF_Program__c ,&apos;Core_MDF_Intel_Partner_Alliance&apos;),
INCLUDES(Core_MDF_Program__c,&apos;Core_MDF_Retail_Marketing_Funds&apos;), PICKLISTCOUNT( Core_MDF_Program__c ) &gt;1 )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Program_Value__c</errorDisplayField>
        <errorMessage>You cannot use the same bank for the IPA and RMF Programs. Please create a new bank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_TaxCodeMandatoryForRMF</fullName>
        <active>true</active>
        <description>Making Tax code mandatory for RMF and IPA program.</description>
        <errorConditionFormula>AND(
OR(ISNEW(), ISCHANGED(Core_MDF_Tax_codes_cd__c)),
ISBLANK(TEXT(Core_MDF_Tax_codes_cd__c)),
OR(
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Retail_Marketing_Funds&quot;),
INCLUDES(Core_MDF_Program__c,&quot;Core_MDF_Intel_Partner_Alliance&quot;)
)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Tax_codes_cd__c</errorDisplayField>
        <errorMessage>Tax Code is mandatory for RMF/IPA/Channel MDF</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ValidateAccountOnBank</fullName>
        <active>true</active>
        <description>This rule checks if the selected account on the bank is co-marketing active or not in active status.</description>
        <errorConditionFormula>AND(NOT(Core_MDF_Account__r.Core_MDF_CoMarketingActive__c),
NOT(Core_MDF_Ineffective_Selection_ind__c),
OR(ISCHANGED(Core_MDF_Ineffective_Selection_ind__c),
   ISCHANGED(Core_MDF_Account__c),
   AND(ISCHANGED(Core_MDF_ESD_Update__c),
Core_MDF_ESD_Update__c, 
ISPICKVAL(PRIORVALUE(Core_MDF_Bank_Status__c),&apos;Draft&apos; )),
AND(Core_MDF_ESD_Update__c,ISPICKVAL(PRIORVALUE(Core_MDF_Bank_Status__c),&apos;Draft&apos; ),
				OR(ISPICKVAL(Core_MDF_Bank_Status__c,&apos;Active&apos;),
   ISPICKVAL(Core_MDF_Bank_Status__c,&apos;Hold&apos;)))
)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account__c</errorDisplayField>
        <errorMessage>Selected Account is not a Comarketing Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_errorIfNotNumberAN</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(REGEX( Core_MDF_Bank_Account_Number__c ,&quot;^[a-zA-Z0-9]{4}$&quot;))</errorConditionFormula>
        <errorMessage>Enter Valid Account Number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_errorIfNotNumberSN</fullName>
        <active>true</active>
        <description>Throws error when user tries to enter other than number.</description>
        <errorConditionFormula>NOT(REGEX( Core_MDF_Supplier_Number__c ,&quot;^[0-9]{10}$&quot;))</errorConditionFormula>
        <errorMessage>Enter Valid Supplier Number</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_MDF_Export_List_View</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Export List View</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/apex/Core_MDF_ExportToExcel?ObjName=Core_MDF_Bank__c</url>
    </webLinks>
</CustomObject>
