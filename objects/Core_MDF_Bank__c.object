    <fields>
        <fullName>Core_MDF_DUNS__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Data Universal Numbering System, regulated by Dun &amp; Bradstreet (D&amp;B) that assigns a unique numeric identifier to a single business entity.  This number is per Enterprise Supplier Data for the matching Supplier Number.</inlineHelpText>
        <label>DUNS</label>
        <length>9</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
