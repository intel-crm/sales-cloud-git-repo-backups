        <fullName>Core_MDF_Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>7 OR (1 AND 2) OR ((3 OR 4) AND 5) AND (6 OR 8)</booleanFilter>
            <filterItems>
                <field>Account.Core_MDF_CoMarketingActive__c</field>
                <operation>equals</operation>
                <value>True</value>
