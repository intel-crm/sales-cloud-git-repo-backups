    <fields>
        <fullName>Sales_Account_Competitor__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>This will have lookup to Account which is the competitor of Account</description>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 AND 2 AND 3) OR (4 AND 5)</booleanFilter>
            <errorMessage>Only End Customer and active Intel Accounts are allowed.</errorMessage>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Direct Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Direct_Account_Type_Nm__c</field>
                <operation>equals</operation>
                <value>End Customer, Ship To</value>
            </filterItems>
            <filterItems>
                <field>Account.ParentId</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Deactivated__c</field>
                <operation>equals</operation>
                <value>False</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Sales Licences Control</relationshipLabel>
        <relationshipName>Sales_Licences_Control</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sales_InActive_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This will help to identify if record is active or not.If checkbox is true then record will be consider as deleted</description>
        <label>InActive</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Sales_License_Vendor_Nm__c</fullName>
        <label>License Vendor</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_PSG_License_Vendor</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Sales_OPN__c</fullName>
        <externalId>false</externalId>
        <formula>Sales_Product__r.Core_OPN__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>OPN</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sales_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Product</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Sales Licences Control</relationshipLabel>
        <relationshipName>Sales_Licences_Control</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Sales License Control</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Sales_Account_Competitor__c</columns>
        <columns>Sales_Product__c</columns>
        <columns>Sales_OPN__c</columns>
        <columns>Sales_InActive_Ind__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>SLC-{0000}</displayFormat>
        <label>Sales License Control Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Sales Licences Control</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
