        <searchResultsAdditionalFields>Core_Support_Org_Name__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_IPS_Cannot_Update_Supp_Prod_Header</fullName>
        <active>true</active>
        <description>On an existing Supported Product record, prevent re-lookup to Product MD. Any Product MD name changes will flow thru via a trigger update. Allow updates to other Supp Prod data elements like EOIS, Status, Alias etc.</description>
        <errorConditionFormula>ISCHANGED(  Core_Product__c  )</errorConditionFormula>
        <errorDisplayField>Core_Product__c</errorDisplayField>
        <errorMessage>Product name on an existing record cannot be updated. Create a new Supported Product instead.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Cannot_change_Access_Flag</fullName>
        <active>false</active>
        <description>Cannot change the value for access flag for a public product</description>
        <errorConditionFormula>AND( IF( Core_IPS_Public_Product__c = true, true, false) , ISCHANGED( Core_Flag_Status__c ) )</errorConditionFormula>
        <errorDisplayField>Core_Flag_Status__c</errorDisplayField>
        <errorMessage>Cannot change the value of Access Flag as it is a public product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Cannot_change_Public_Product</fullName>
        <active>true</active>
        <description>To restrict reverting from Public Product</description>
        <errorConditionFormula>AND(
	OR(
		AND(Core_IPS_Public_Product__c=FALSE, PRIORVALUE(Core_IPS_Public_Product__c)=TRUE),
		AND(
			ISCHANGED( Core_Flag_Status__c ), 			TEXT(PRIORVALUE(Core_Flag_Status__c))= $Label.Core_IPS_General_Public_Product, 
			NOT(ISPICKVAL(Core_Flag_Status__c, &apos;EOIS&apos;))
		)
	),
	$Setup.Core_IPS_Run_Rules_Exception_Admin__c.Run_Validation_Rule__c
)</errorConditionFormula>
        <errorDisplayField>Core_Flag_Status__c</errorDisplayField>
        <errorMessage>Once Set to as Public Product, cannot revert back</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Prevent_EOIS_Removal</fullName>
        <active>true</active>
        <description>This validation rule will prevent the clearing of the EOIS checkbox on a Supported Product.  We are preventing this in R1 because of the impact it can have on MAP/PAR</description>
        <errorConditionFormula>AND(
	OR(
		AND(Core_EOIS__c=FALSE, PRIORVALUE(Core_EOIS__c)=TRUE),
		AND(ISCHANGED( Core_Flag_Status__c ), ISPICKVAL( PRIORVALUE(Core_Flag_Status__c), &apos;EOIS&apos;))
	), 
	$Profile.Name &lt;&gt; &apos;IPS Data Migration&apos;,
 $Setup.Core_IPS_Run_Rules_Exception_Admin__c.Run_Validation_Rule__c
)</errorConditionFormula>
        <errorDisplayField>Core_Flag_Status__c</errorDisplayField>
        <errorMessage>Once set to EOIS, you cannot clear the EOIS value from a Supported Product.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_VPH_Check_PublicProduct</fullName>
        <active>true</active>
        <errorConditionFormula>Core_Product__r.Core_Hierarchy_ID__c &lt;&gt; &apos;43&apos;
&amp;&amp; 
(ISCHANGED( Core_IPS_Public_Product__c ) || ISNEW() )&amp;&amp; Core_IPS_Public_Product__c</errorConditionFormula>
        <errorDisplayField>Core_IPS_Public_Product__c</errorDisplayField>
        <errorMessage>Only Valid Product Hierarchy can be made as Public Product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_VPLCH_Restrict_PublicProduct</fullName>
        <active>true</active>
        <description>Restrict Valid Platform Codename Hierarchy from making public product</description>
        <errorConditionFormula>Core_Product__r.Core_Hierarchy_ID__c = &apos;59&apos;
&amp;&amp;
(ISCHANGED( Core_IPS_Public_Product__c ) ||  ISNEW() )&amp;&amp; Core_IPS_Public_Product__c</errorConditionFormula>
        <errorDisplayField>Core_IPS_Public_Product__c</errorDisplayField>
        <errorMessage>Cannot make Valid Platform Codename Hierarchy Product as public product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Product_Name_Cant_Be_Null</fullName>
        <active>true</active>
        <description>Prevent saving a Supported Product record if Product name is NULL.</description>
        <errorConditionFormula>ISBLANK(Core_Product__c)</errorConditionFormula>
        <errorDisplayField>Core_Product__c</errorDisplayField>
        <errorMessage>Product Name cannot be blank.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
