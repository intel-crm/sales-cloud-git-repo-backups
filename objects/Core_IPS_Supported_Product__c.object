    <webLinks>
        <fullName>Core_IPS_Set_to_General</fullName>
        <availability>online</availability>
        <description>Set Access flag to General (ALL Access!)</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Set to General</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/41.0/connection.js&quot;)} 


// Get the record
var SP = new sforce.SObject(&quot;Core_IPS_Supported_Product__c&quot;); 
SP.id = &quot;{!Core_IPS_Supported_Product__c.Id}&quot;; 

// If current status is EOIS=TRUE
if(&quot;{!Core_IPS_Supported_Product__c.Core_EOIS__c}&quot; === &quot;1&quot;) {
 alert(&quot;Once set to EOIS, you cannot clear the EOIS value from a Supported Product.&quot;);
}

// If current status is Public Product=TRUE
else if(&quot;{!Core_IPS_Supported_Product__c.Core_IPS_Public_Product__c}&quot; === &quot;1&quot;) {
 alert(&quot;Supported Product is already set as {!$Label.Core_IPS_General_Public_Product}. No change will be made.&quot;);
}
else{

var cnfrm = window.confirm(&apos;**WARNING**  \nSetting the Access Flag to General (ALL Access!) will open up access to every IPS active customer allowing them to potentially create Cases with this Supported Product!  This setting cannot be undone!  \n\nAre you sure you want to set this Supported Product\&apos;s Access Flag to General (ALL Access!)?&apos;);

if (cnfrm) {
    var supprod = new sforce.SObject(&quot;Core_IPS_Supported_Product__c&quot;);
    supprod.Id = &apos;{!Core_IPS_Supported_Product__c.Id}&apos;;
    supprod.Core_Flag_Status__c = &apos;{!$Label.Core_IPS_General_Public_Product}&apos;;
    supprod.Core_IPS_Public_Product__c = true;
    result = sforce.connection.update([supprod]);
    if (result[0].success == &apos;true&apos;) {
        location.reload();
    } else {
        console.log(result[0].errors);
        var exceptionMsg = &apos;&apos;;
        if(result[0].errors instanceof Array) {
			for(var i=0;i&lt;result[0].errors.length;i++)
				exceptionMsg += result[0].errors[i].message + &apos;\n\n&apos; ;
        }
        else { 
			exceptionMsg = result[0].errors.message; 		
		}
        if (exceptionMsg == null || exceptionMsg == &apos;&apos;)
            exceptionMsg = &apos;Something went wrong, Please contact Support Team !!&apos;;
		alert(exceptionMsg);
    }
}
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_Supported_Product_Make_EOIS</fullName>
        <availability>online</availability>
        <description>This button will change the EOIS value from FALSE to TRUE.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Set to EOIS</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/19.0/connection.js&quot;)} 

// Get the record
var SP = new sforce.SObject(&quot;Core_IPS_Supported_Product__c&quot;); 
SP.id = &quot;{!Core_IPS_Supported_Product__c.Id}&quot;; 

// If current status is EOIS=TRUE
if(&quot;{!Core_IPS_Supported_Product__c.Core_EOIS__c}&quot; === &quot;1&quot;) {
 alert(&quot;Supported Product is already set to EOIS. No change will be made.&quot;);
}

// current status is EOIS=FALSE
else {

	function confirmEOIS() {
 //ask if they are sure 
	 var isConfirm = confirm(&quot;**WARNING**  \nSetting the Access Flag to EOIS (End Of Interactive Support) can only be undone by KTBR!  \n\nAre you sure you want to set this Supported Product\&apos;s Access Flag to EOIS?&quot;);
	 if (isConfirm) return true; 
 return false; 
}

//if they say OK then save the change
	if (confirmEOIS()) {
	 // change status to EOIS and Access Flag to EOIS
	 SP.Core_Flag_Status__c=&apos;EOIS&apos;;
 SP.Core_EOIS__c = &quot;1&quot;;
 // update the record
 result = sforce.connection.update([SP]);
	 if (result[0].success == &apos;true&apos;) {
 //reload the page to show the updated status if the save was successful
 window.location.reload();
		} else {
			console.log(result[0].errors);
        var exceptionMsg = &apos;&apos;;
        if(result[0].errors instanceof Array) {
			for(var i=0;i&lt;result[0].errors.length;i++)
				exceptionMsg += result[0].errors[i].message + &apos;\n\n&apos; ;
        }
        else { 
			exceptionMsg = result[0].errors.message; 		
		}
			if (exceptionMsg == null || exceptionMsg == &apos;&apos;)
				exceptionMsg = &apos;Something went wrong, Please contact Support Team !!&apos;;
			alert(exceptionMsg);
		}	 
}
}</url>
