    <fields>
        <fullName>Code_Name_Hidden_Evaluate_NA__c</fullName>
        <description>Hidden field. Not to be shown on any layouts. Input - Core_Code_Name_Hidden_Insert_Spaces 
Output - If codename contains &apos;N/A,&apos; or &apos;N/A&apos;, replace it with space. Else return the value of Core_Code_Name_Hidden_Evaluate_NOCONA (codename with spaces &amp; commas and after NOCONA removed).</description>
        <externalId>false</externalId>
        <formula>IF(CONTAINS(Code_Name_Hidden_Evaluate_NOCONA__c, &apos;N/A,&apos;), 
SUBSTITUTE(Code_Name_Hidden_Evaluate_NOCONA__c, &apos;N/A,&apos;, &apos;&apos;), 
IF (CONTAINS(Code_Name_Hidden_Evaluate_NOCONA__c, &apos;N/A&apos;), SUBSTITUTE (Code_Name_Hidden_Evaluate_NOCONA__c, &apos;N/A&apos;, &apos;&apos;), Code_Name_Hidden_Evaluate_NOCONA__c) 
)</formula>
        <label>Code Name Hidden Evaluate NA</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Code_Name_Hidden_Evaluate_NOCONA__c</fullName>
        <description>Hidden field. Not to be shown on any layouts. 
Input - Core_Code_Name_Hidden_Insert_Spaces
Output - If codename contains &apos;NOCONA,&apos; or &apos;NOCONA&apos;, replace it with space. Else return the value of Core_Code_Name_Hidden_Insert_Spaces (codename with spaces &amp; commas).</description>
        <externalId>false</externalId>
        <formula>IF(CONTAINS(Core_Code_Name_Hidden_Insert_Spaces__c, &apos;NOCONA,&apos;),
    SUBSTITUTE(Core_Code_Name_Hidden_Insert_Spaces__c, &apos;NOCONA,&apos;, &apos;&apos;),
IF (CONTAINS(Core_Code_Name_Hidden_Insert_Spaces__c, &apos;NOCONA&apos;), SUBSTITUTE (Core_Code_Name_Hidden_Insert_Spaces__c, &apos;NOCONA&apos;, &apos;&apos;), Core_Code_Name_Hidden_Insert_Spaces__c)
)</formula>
        <label>Code Name Hidden Evaluate NOCONA</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Code_Name_Hidden_Insert_Spaces__c</fullName>
        <description>Hidden field. Not to be shown on any layout. Input: Product2.Codename field . Output: 2 things - replaces semi colon delimiter in the Code Name with commas. Also inserts spaces between 2 consecutive code names.</description>
        <externalId>false</externalId>
        <formula>IF(CONTAINS(Core_Product__r.Core_Code_Name__c, &apos;;&apos;),
    SUBSTITUTE(Core_Product__r.Core_Code_Name__c, &apos;;&apos;, &apos;, &apos;), Core_Product__r.Core_Code_Name__c)</formula>
        <label>Code Name Hidden Insert Spaces</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Code_Name__c</fullName>
        <description>Final codename field. Is shown on Supported Product layout &amp; value is copied over to Asset &amp; Case. Input - Code_Name_Hidden_Evaluate_NA. Output - code name with spaces &amp; commas inserted and truncated to first 255 characters.</description>
        <externalId>false</externalId>
        <formula>LEFT(Code_Name_Hidden_Evaluate_NA__c, 255)</formula>
        <inlineHelpText>Derived from Product master data. Read only field.</inlineHelpText>
        <label>Code Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_EOIS__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Used to expire assets related to this Product</description>
        <inlineHelpText>Check this to expire related assets</inlineHelpText>
        <label>EOIS</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Flag_Status__c</fullName>
        <description>This is to show the access setting for each Supported Product</description>
        <inlineHelpText>A value is mandatory for this field.</inlineHelpText>
        <label>Access Flag</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Par Hidden</fullName>
                    <default>true</default>
                    <label>Par Hidden</label>
                </value>
                <value>
                    <fullName>Approval Required</fullName>
                    <default>false</default>
                    <label>Approval Required</label>
                </value>
                <value>
                    <fullName>Auto Approve</fullName>
                    <default>false</default>
                    <label>Auto Approve</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
