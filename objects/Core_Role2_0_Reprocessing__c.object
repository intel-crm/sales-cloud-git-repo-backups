<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>This custom setting controls the logic that reprocesses the failed Role 2.0 Inbound Messages via the Scheduled Flow</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <label>Is Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Reprocessing_Frequency__c</fullName>
        <description>This field stores the value of the time between re-processing batch flows (in minutes)</description>
        <externalId>false</externalId>
        <label>Reprocessing Frequency</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Core Failed Inbound Reprocessing Flow</label>
    <visibility>Public</visibility>
</CustomObject>
