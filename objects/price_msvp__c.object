            <field>core_cpq_effective_date_dt__c</field>
            <operation>lessOrEqual</operation>
            <value>NEXT_N_YEARS:5</value>
        </filters>
        <filters>
            <field>core_cpq_product_opn__c</field>
            <operation>contains</operation>
            <value>5CSXFC6D6F31I7N</value>
        </filters>
