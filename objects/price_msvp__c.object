    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>PSG_MSVP_NoNegativeValueCheck</fullName>
        <active>true</active>
        <description>Should perform the validation to ensure there are no -ve values for any of the pricing tiers of MSVP.</description>
        <errorConditionFormula>AND(NOT( $Permission.PSG_External_Disty ),
RecordType.DeveloperName = &apos;PSG_MSVP_Record_Type&apos;,
OR( (price_level_1_amt__c&lt;0),( price_level_2_amt__c&lt;0),
(price_10ku_y_amt__c &lt;0),(price_1ku_y_amt__c &lt;0),
(price_2_5ku_y_amt__c &lt;0),( price_500u_y_amt__c &lt;0),
( price_prototype_amt__c &lt;0),
(price_5ku_y_amt__c &lt;0),( price_250u_y_amt__c &lt;0)))</errorConditionFormula>
        <errorMessage>Negative Values not allowed for MSVP</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
