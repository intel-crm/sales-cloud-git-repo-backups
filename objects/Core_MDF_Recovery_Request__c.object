    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores the Recovery data from the Claim Recovery if the user clicks on the Save as Draft or Recover</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Store the Account ID</description>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Recovery Requests</relationshipLabel>
        <relationshipName>Recovery_Requests</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Active_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Active_RO_Ind__c</fullName>
        <formula>IF(
    OR(
        TEXT(Core_MDF_Claim_Id__r.Core_MDF_Status__c) == $Label.Core_MDF_Claim_Status_Payment_Due,
        TEXT(Core_MDF_Claim_Id__r.Core_MDF_Status__c) == $Label.Core_MDF_Claim_Status_Pending_Available_Fund
    ) &amp;&amp; Core_MDF_Active_Ind__c,
    true,
    false
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Active Indicator</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_External_ID__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Store the Claim ID field</description>
        <externalId>true</externalId>
        <label>Claim ID External</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup to claim</description>
        <label>Claim Id</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>Recovery Requests</relationshipLabel>
        <relationshipName>Recovery_Requests</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_Number__c</fullName>
        <externalId>false</externalId>
        <formula>Core_MDF_Claim_Id__r.Core_MDF_Claim_Ref_Number__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Claim Number</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Comment_Txt__c</fullName>
        <description>To store the comment entered while recovering the amount</description>
        <label>Comment</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Is_System_Created_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Used to identify whether the Recovery Request record is created through UI or Recovery Batch.</description>
        <label>Is System Created?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Partnership_Grade_Maint_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup to PGM</description>
        <label>Partnership Grade Maintenance</label>
        <referenceTo>Core_MDF_Partnership_Score__c</referenceTo>
        <relationshipLabel>Recovery Requests</relationshipLabel>
        <relationshipName>Recovery_Requests</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Program_Nm__c</fullName>
        <description>Stores the Program name</description>
        <label>Program</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Technical_Program_Name</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Quarter_Year_Nm__c</fullName>
        <description>Stores the quarter year</description>
        <label>Quarter Year</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Quarter_Year</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Ready_to_Recover_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether request is ready to recover or not</description>
        <label>Ready to Recover</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Ready_to_Recover_RO_Ind__c</fullName>
        <formula>IF(
    OR(
        TEXT(Core_MDF_Claim_Id__r.Core_MDF_Status__c) == $Label.Core_MDF_Claim_Status_Payment_Due,
        TEXT(Core_MDF_Claim_Id__r.Core_MDF_Status__c) == $Label.Core_MDF_Claim_Status_Pending_Available_Fund
    ) &amp;&amp; Core_MDF_Ready_to_Recover_Ind__c,
    true,
    false
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ready to Recover Indicator</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_RecoveredPartnershipScoreDetail__c</fullName>
        <description>To store the Partnership score detail id and the amounts to be recovered</description>
        <label>Recovered Partnership Score Detail</label>
        <length>1000</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Recovered_Budget_Nm__c</fullName>
        <description>Denotes the Budget Type and Region from where the claim is recovered</description>
        <label>Recovered Budget</label>
        <length>1000</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Recovery_Amount_Amt__c</fullName>
        <description>to store the Recovery amount</description>
        <label>Recovery Amount</label>
        <precision>18</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Recovery__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>To store te corresponding recovery record</description>
        <label>Recovery</label>
        <referenceTo>Core_MDF_Recovery__c</referenceTo>
        <relationshipLabel>Recovery Requests</relationshipLabel>
        <relationshipName>Recovery_Requests</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Recovery Request</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Account_Id__c</columns>
        <columns>Core_MDF_Program_Nm__c</columns>
        <columns>Core_MDF_Quarter_Year_Nm__c</columns>
        <columns>Core_MDF_Claim_Number__c</columns>
        <columns>Core_MDF_Recovery_Amount_Amt__c</columns>
        <columns>Core_MDF_Active_Ind__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>RecoveryRequest-{0000}</displayFormat>
        <label>Recovery Request Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Recovery Requests</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
