    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Holds the Multi-Select region values and Multi-select Sub-Region values and their mappings</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>PMP_Company_Id__c</fullName>
        <description>Id of the related Company Information record</description>
        <label>Marketing Profile ID</label>
        <referenceTo>PMP_Company__c</referenceTo>
        <relationshipLabel>Marketing  Profile Regions</relationshipLabel>
        <relationshipName>Company_Regions</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>PMP_Company_Region__c</fullName>
        <description>Holds a region related to the Partner</description>
        <externalId>false</externalId>
        <label>Region</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Company_Sub_Region__c</fullName>
        <description>Holds Sub-Region belonging to the region of the related Partner</description>
        <externalId>false</externalId>
        <label>Sub-Region</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMP_Specification_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Relation between region and specification</description>
        <label>Specification</label>
        <referenceTo>PMP_Specification__c</referenceTo>
        <relationshipName>Company_Regions</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Marketing Profile Region</label>
    <nameField>
        <displayFormat>CR-{0000}</displayFormat>
        <label>Company Region Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Marketing Profile Regions</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
