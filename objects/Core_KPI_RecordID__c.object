    <validationRules>
        <fullName>Core_year_Limitation</fullName>
        <active>true</active>
        <description>Validation rule is created for year field should allow only 4 characters.</description>
        <errorConditionFormula>OR(NOT(ISNUMBER(Core_Year__c)),
LEN(Core_Year__c) &lt;&gt; 4)</errorConditionFormula>
        <errorDisplayField>Core_Year__c</errorDisplayField>
        <errorMessage>The Year must be 4 digits Ex: 2020</errorMessage>
    </validationRules>
