<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This metadata holds the Languages listed in Salesforce and their corresponding language code for IAM Microservice (Azure B2C) outbound call</description>
    <fields>
        <fullName>B2C_Code__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>B2C Code</label>
        <length>5</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_ISO_3_Language_Code__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>ISO 3 Language Code</label>
        <length>3</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>IAM Microservice Language Code</label>
    <pluralLabel>IAM Microservice Language Codes</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
