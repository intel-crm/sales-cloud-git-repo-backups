    <fields>
        <fullName>Core_MDF_Partner_Repsonse_Zone_nm__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Core_MDF_Partner_Score_num__c &lt; 2 &amp;&amp;  Core_MDF_Trend_pct__c &lt; -5 ,&apos;A4&apos;,  IF(Core_MDF_Partner_Score_num__c &lt; 4 &amp;&amp; Core_MDF_Partner_Score_num__c &gt;= 2 &amp;&amp;  Core_MDF_Trend_pct__c &lt; -5, &apos;A3&apos;, IF(Core_MDF_Partner_Score_num__c &lt; 6 &amp;&amp; Core_MDF_Partner_Score_num__c &gt;= 4 &amp;&amp;  Core_MDF_Trend_pct__c &lt; -5, &apos;A2&apos;, IF(Core_MDF_Partner_Score_num__c &gt; 6 &amp;&amp;  Core_MDF_Trend_pct__c &lt; -5, &apos;A1&apos;, IF(Core_MDF_Partner_Score_num__c &lt; 2 &amp;&amp;  Core_MDF_Trend_pct__c &lt; -5 &amp;&amp;  Core_MDF_Trend_pct__c &lt; 5, &apos;B4&apos;, IF(Core_MDF_Partner_Score_num__c &lt; 4 &amp;&amp; Core_MDF_Partner_Score_num__c &gt;= 2 &amp;&amp;  Core_MDF_Trend_pct__c &gt; -5 &amp;&amp;  Core_MDF_Trend_pct__c &gt; -5 &amp;&amp; Core_MDF_Trend_pct__c &lt; 5, &apos;B3&apos;, IF(Core_MDF_Partner_Score_num__c &lt; 6 &amp;&amp; Core_MDF_Partner_Score_num__c &gt;= 4 &amp;&amp;  Core_MDF_Trend_pct__c &gt; -5 &amp;&amp;  Core_MDF_Trend_pct__c &lt; 5, &apos;B2&apos;, IF(Core_MDF_Partner_Score_num__c &gt; 6 &amp;&amp;  Core_MDF_Trend_pct__c &gt; -5 &amp;&amp;  Core_MDF_Trend_pct__c &lt; 5, &apos;B1&apos;, IF(Core_MDF_Partner_Score_num__c &lt; 2 &amp;&amp;  Core_MDF_Trend_pct__c &gt; 5 , &apos;C4&apos;, IF(Core_MDF_Partner_Score_num__c &lt; 4 &amp;&amp; Core_MDF_Partner_Score_num__c &gt;= 2 &amp;&amp;  Core_MDF_Trend_pct__c &gt; 5, &apos;C3&apos;, IF(Core_MDF_Partner_Score_num__c &lt; 6 &amp;&amp; Core_MDF_Partner_Score_num__c &gt;= 4 &amp;&amp;  Core_MDF_Trend_pct__c &gt; 5, &apos;C2&apos;, IF(Core_MDF_Partner_Score_num__c &gt; 6 &amp;&amp;  Core_MDF_Trend_pct__c &gt; 5, &apos;C1&apos;, &apos;&apos;)
))))))))
)
) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Partner Repsonse Zone</label>
        <required>false</required>
        <type>Text</type>
