<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Table to store the list of Job Function Names and their Codes.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Core_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Field to indicate if the record is Active.</description>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Job_Function_Code__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Field to store the Job Function Code.</description>
        <externalId>false</externalId>
        <label>Job Function Code</label>
        <length>20</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_Job_Function_Name__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Field to store the Job Function Name.</description>
        <externalId>false</externalId>
        <label>Job Function Name</label>
        <length>100</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <label>Job Function Reference</label>
    <listViews>
        <fullName>All_Records</fullName>
        <columns>NAME</columns>
        <columns>Core_Job_Function_Name__c</columns>
        <columns>Core_Job_Function_Code__c</columns>
        <columns>UPDATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <label>All Records</label>
    </listViews>
    <visibility>Public</visibility>
</CustomObject>
