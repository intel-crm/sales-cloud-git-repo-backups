    <label>xOpportunity</label>
    <nameField>
        <displayFormat>DWGOPP-{00000000}</displayFormat>
        <label>Opportunity  Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>xOpportunities</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_Goal_Add_Opportunity</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Add Opportunity</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>?id={!Core_Goal__c.Id}</url>
    </webLinks>
