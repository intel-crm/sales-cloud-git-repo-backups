    <fields>
        <fullName>CPT_Validation_Message__c</fullName>
        <description>Error message that is captured after the execution of validation script.</description>
        <externalId>false</externalId>
        <label>Validation Message</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CPT_Validation_Status__c</fullName>
        <description>The status of validation. Starts with the value of Pending and moves to Pass or Fail after the execution of validation script.</description>
        <label>Validation Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Pass</fullName>
                    <default>false</default>
                    <label>Pass</label>
                </value>
                <value>
                    <fullName>Fail</fullName>
                    <default>false</default>
                    <label>Fail</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Commissionable Employee - Staging</label>
    <listViews>
        <fullName>All_Records</fullName>
        <columns>NAME</columns>
        <columns>CPT_Batch_Id__c</columns>
        <columns>CPT_Employee_WWID__c</columns>
        <columns>CPT_First_Name__c</columns>
        <columns>CPT_Last_Name__c</columns>
        <columns>CPT_Manager_WWID__c</columns>
        <columns>CPT_Plan_Name__c</columns>
        <columns>CPT_Validation_Status__c</columns>
        <columns>CPT_Validation_Message__c</columns>
        <columns>CPT_Manager__c</columns>
        <columns>CPT_Sales_Compensation_Plan__c</columns>
        <columns>CPT_Job_Role__c</columns>
        <columns>UPDATEDBY_USER</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CPT_Validation_Status__c</field>
            <operation>notEqual</operation>
            <value>Pass</value>
        </filters>
        <label>All Records</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
