    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_IPS_EnvDtlsMaster_Cant_Revert_2_Act</fullName>
        <active>true</active>
        <description>Once Env Details Master status has been set to Inactive, it cannot be reset to Active.</description>
        <errorConditionFormula>$Setup.Core_IPS_Run_Rules_Exception_Admin__c.Run_Validation_Rule__c 
&amp;&amp; 
(
AND
( TEXT( Core_Status__c ) = &quot;ACTIVE&quot;,
TEXT (PRIORVALUE ( Core_Status__c )) = &quot;INACTIVE&quot;
)
)</errorConditionFormula>
        <errorDisplayField>Core_Status__c</errorDisplayField>
        <errorMessage>Once set to Inactive, the Status cannot be reset to Active. This is to prevent inconsistencies in Case usage of the Environment Detail Question.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_EnvDtlsMstr_No_Change_Datatype</fullName>
        <active>true</active>
        <description>Once an Environment Detail record is created, the Datatype cannot be changed to prevent impact to Case display.</description>
        <errorConditionFormula>ISCHANGED( Core_Datatype__c )</errorConditionFormula>
        <errorDisplayField>Core_Datatype__c</errorDisplayField>
        <errorMessage>Cannot change the datatype of an existing Environment Detail. Create a new record with the correct datatype if needed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Env_Dtls_Master_Ans_No_Blanks</fullName>
        <active>true</active>
        <description>Ensures that when a datatype of Picklist or Multi Select is selected, there must be at least one row of text in the Answer text box.</description>
        <errorConditionFormula>AND
(OR(
ISPICKVAL(Core_Datatype__c, &apos;Picklist&apos;), ISPICKVAL(Core_Datatype__c, &apos;Multiselect Picklist&apos;)
),
 ISBLANK(Core_Answers__c) 
)</errorConditionFormula>
        <errorDisplayField>Core_Answers__c</errorDisplayField>
        <errorMessage>Enter at least 1 row of text when Datatype is &apos;Picklist&apos; or &apos;Multiselect Picklist&apos;.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_IPS_Add_To_Products</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Add to Products</masterLabel>
        <openType>sidebar</openType>
        <page>Core_addEnvToProducts</page>
        <protected>false</protected>
    </webLinks>
