    <fields>
        <fullName>Core_File_Hyperlink__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Core_Upload_Status__c, &apos;Complete&apos;),HYPERLINK(Core_File_URL__c ,&apos;Download&apos;,&apos;Self&apos;),HYPERLINK($Label.Core_IPS_File_SCFT_URL + &apos;&amp;caseid=&apos;+  CASESAFEID(Core_Case__c) +&apos;&amp;visibility=&apos;+TEXT(Core_IPS_Attachment_Visibility__c)+&apos;&amp;appfileId=&apos;+Core_File_GUID__c  ,&apos;Resume&apos;,&apos;Self&apos;  ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>File Download Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
