    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_IPS_Prevent_Edit_Until_Complete</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(ISPICKVAL(Core_Upload_Status__c, &apos;Complete&apos;)),
($Profile.Name &lt;&gt; $Label.Core_System_Admin_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_IT_Admin_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_Integration_Profile_Name),
($Profile.Name &lt;&gt; $Label.Core_IPS_DataMigration_ProfileName)
)</errorConditionFormula>
        <errorMessage>No Edits allowed until File Upload Status is set to &apos;Complete&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Prevent_StatusChng_FromComplete</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(PRIORVALUE( Core_Upload_Status__c ),&quot;Complete&quot;), NOT(ISPICKVAL( Core_Upload_Status__c ,&quot;Complete&quot;))
)</errorConditionFormula>
        <errorMessage>Status Change not allowed once set to Complete</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IPS_Altera_Go_Live_Attmt_Restriction</fullName>
        <active>true</active>
        <description>Restricting the user to add attachments on a case with Altera products during migration</description>
        <errorConditionFormula>AND($Label.IPS_Altera_Go_Live= &apos;True&apos;,Core_Case__r.Core_IPS_Product_Org_Number__c = &apos;025&apos;, Core_Case__r.Core_IPS_Product_name__c &lt;&gt;&apos;Licensed Products&apos;)</errorConditionFormula>
        <errorMessage>Not allowed to create or update record related to Org 025</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_Attach_File</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Attach File</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/35.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/support/console/35.0/integration.js&quot;)}

if (sforce.console.isInConsole()) {
srcSelf(&apos;/apex/Core_IPS_File_AttachToCase?id={!Case.Id}&amp;isdtp=vw&apos;);
} else {
window.open(&quot;/apex/Core_IPS_File_AttachToCase?id={!Case.Id}&quot;, &apos;_self&apos;);
}</url>
    </webLinks>
    <webLinks>
        <fullName>Core_IPS_External_Attach_File</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Attach File</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>if(&apos;{!Case.Core_IPS_GEC_Flag__c}&apos;==true){ 
// GEC flag checked true. 
if(&apos;{!JSENCODE($Label.Core_IPS_MAG_Support_Org)}&apos;==(&apos;{!JSENCODE( Case.Core_IPS_Product_Org1Id__c )}&apos;)){ 
// Equal Support org Id with custom label &quot;Core_IPS_MAG_Support_Org&quot; 
alert(&quot;{!JSENCODE($Label.Core_IPS_GEC_FileAttach_Message)}&quot;); 
} 
else{ 
// Not Equal Support org id with custom label &quot;Core_IPS_MAG_Support_Org&quot; 
window.open(&quot;{!URLFOR($Site.Prefix+&apos;/Core_IPS_File_AttachToCase?id=&apos;+Case.Id)}&quot;, &apos;_self&apos;); 
} 
}else { 
// GEC flag checked false. 
window.open(&quot;{!URLFOR($Site.Prefix+&apos;/Core_IPS_File_AttachToCase?id=&apos;+Case.Id)}&quot;, &apos;_self&apos;); 
} 
//Previous code as URL 
//{!URLFOR($Site.Prefix+&apos;/Core_IPS_File_AttachToCase?id=&apos;+Case.Id)}</url>
