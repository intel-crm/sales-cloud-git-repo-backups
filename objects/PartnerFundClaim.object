        <description>This is a backend field for updating the locale language of the User.</description>
        <externalId>false</externalId>
        <formula>IF( TEXT(Owner:User.LanguageLocaleKey) != null, TEXT(Owner:User.LanguageLocaleKey), $Label.Core_English_Language_Locale_Key)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner Language Locale Key</label>
