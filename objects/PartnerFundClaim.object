        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_3rd_Party_POP_Doc_Required_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if the claim needs any 3rd party invoice. This is decided based on business rules.</description>
        <inlineHelpText>Third Party documentation is required if the value is selected</inlineHelpText>
        <label>3rd Party POP Documentation Required</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
