    </fields>
    <fields>
        <fullName>Core_MDF_Legacy_Claim_Ind__c</fullName>
        <description>An indicator if the claim was created prior to change in Audit process</description>
        <formula>IF(
  OR(
	AND(Core_MDF_Program__c = $Label.Core_MDF_CCF_Program_Name,TEXT(Core_MDF_Budget_Type_Options_Nm__c) = $Label.Core_MDF_BudgetType_CCF1_0),
	AND(Core_MDF_Program__c = $Label.Core_MDF_Non_Localized_DCF_Program_Name,TEXT(Core_MDF_Budget_Type_Options_Nm__c) = $Label.Core_MDF_BudgetType_DCF1_0),
	Core_MDF_Program__c = $Label.Core_MDF_CCFB_Program_Name,
	Core_MDF_Program__c = $Label.Core_MDF_SPCF_Program_Name
), true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Legacy Claim</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Legacy_Reminder_txt__c</fullName>
        <description>Used to send Legacy claims reminder notifications when Claim status is &apos;Resubmission Required&apos; or &apos;Paid and Resubmission Required&apos;.</description>
        <label>Legacy Reminder</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
