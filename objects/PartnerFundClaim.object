        <inlineHelpText>Execution Start Date</inlineHelpText>
        <label>Execution Start Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Ad_run_end_date_Clm_sub_date__c</fullName>
        <externalId>false</externalId>
        <formula>DATETIMEVALUE( Core_MDF_Ad_Run_End_Date__c ) -  DATETIMEVALUE( CreatedDate )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ad run end date - Claim submission date</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Amount_Percentage__c</fullName>
