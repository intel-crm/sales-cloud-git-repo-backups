        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Category__c</fullName>
        <description>The Activity Category for this marketing Activity</description>
        <externalId>false</externalId>
        <formula>TEXT(Request.Core_MDF_ActivityCategory__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
