        <searchResultsAdditionalFields>Core_MDF_Program__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ChannelPartner</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Country_Location_nm__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Requested_Reimbursement_Amt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_CreatedBy_Nm__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CreatedDate</searchResultsAdditionalFields>
        <searchResultsCustomButtons>Core_MDF_Export_List_View</searchResultsCustomButtons>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Claim_cannot_be_reprocessed</fullName>
        <active>true</active>
        <description>To prevent a processes claim from being reprocessed</description>
        <errorConditionFormula>AND(!ISPICKVAL( Core_MDF_Status__c , &apos;Submitted&apos;), Core_MDF_Reprocess_Claim__c = true)</errorConditionFormula>
        <errorMessage>This claim cannot be reprocessed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Amount_Validation</fullName>
        <active>true</active>
        <description>Total Amount should not be zero or less than zero</description>
        <errorConditionFormula>IF( 
AND( 
ISPICKVAL(Core_MDF_Type_Txt__c,&apos;Claim&apos;),Core_MDF_Total_Invoice_Amount_Local__c &lt;= 0) 
, 
TRUE, FALSE 
)</errorConditionFormula>
        <errorDisplayField>Amount</errorDisplayField>
        <errorMessage>Please enter a total amount that is greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_BlockPendingReviewToDraft</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(Core_MDF_Status__c),
    TEXT(PRIORVALUE(Core_MDF_Status__c)) = &quot;Pending Review&quot;,
    TEXT(Core_MDF_Status__c) = &quot;Draft&quot;
)</errorConditionFormula>
        <errorMessage>An application error occurred. Please try again. If error still persists, please contact Support Services.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ClaimEndDateBetween3Months</fullName>
        <active>true</active>
        <description>Difference between ad run end date and ad run start date cannot be greater than 3 months.</description>
        <errorConditionFormula>AND(
AND(NOT(Core_MDF_Program__c = $Label.Core_MDF_Retail_Program_Name),NOT(Core_MDF_Program__c= $Label.Core_MDF_IPA_Program_Name)),
AND(OR(Core_MDF_Program__c = &apos;Client&apos;, Core_MDF_Program__c = &apos;Datacenter&apos;	),NOT(CONTAINS($Label.Core_MDF_OPAL_BudgetTypes,TEXT(Request.Core_MDF_Budget_Type_nm__c)))),
NOT(Core_MDF_IsClaimReviewEscalation_Ind__c),
OR(ISNEW(),ISCHANGED( Core_MDF_Ad_Run_Start_Date__c ),ISCHANGED( Core_MDF_Ad_Run_End_Date__c )),
ADDMONTHS( Core_MDF_Ad_Run_Start_Date__c ,3) &lt; Core_MDF_Ad_Run_End_Date__c,
(TEXT(Core_MDF_Type_Txt__c) ==$Label.Core_MDF_Claim)
)</errorConditionFormula>
        <errorMessage>The start and end date on a claim can cover only a 3 month period.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Claim_Required_Fields</fullName>
        <active>false</active>
        <description>This rule will check if the required fields are blank.For Retail MD field like &quot;Start &amp; End data,Currency,Amount,Country&quot; will check where as for Retail MDF field like &quot;Start &amp; End data,Currency,Amount,Country&quot; will check</description>
        <errorConditionFormula>OR(
ISBLANK(Core_MDF_Ad_Run_End_Date__c),
ISBLANK(Core_MDF_Ad_Run_Start_Date__c),
AND(
NOT(AND(Core_MDF_Program__c = $Label.Core_MDF_IPA_Program_Name,Core_MDF_OutcomeBased_Ind__c))
),
ISPICKVAL(Core_MDF_Currency__c,&apos;&apos;),
ISNULL(Core_MDF_Total_Invoice_Amount_Local__c),
AND(NOT(Core_MDF_Program__c = &apos;Co-GTM&apos;),ISPICKVAL(Core_MDF_Country_Location_nm__c,&apos;&apos;)),
IF(AND(NOT(Core_MDF_Program__c = $Label.Core_MDF_Retail_Program_Name),NOT(Core_MDF_Program__c= $Label.Core_MDF_IPA_Program_Name), NOT(Core_MDF_Proposal_Based_Ind__c)),
OR(
ISBLANK(Core_MDF_Invoice_Date__c),
ISBLANK(Core_MDF_Invoice_Number__c),
ISNULL(Core_MDF_OtherCostsnotReimbursable_Local__c),
IF(CONTAINS($Label.Core_MDF_OPAL_BudgetTypes, TEXT(Core_MDF_Budget_Type_Options_Nm__c)) , false, ISNULL(Core_MDF_Taxes_Local__c))
),
IF(OR(Text(Core_MDF_Budget_Type_Options_Nm__c) &lt;&gt; $Label.Core_MDF_Retail_RSA_MD_Budget_Type,Core_MDF_Program__c= $Label.Core_MDF_IPA_Program_Name,Core_MDF_Proposal_Based_Ind__c),
IF(AND(Core_MDF_Program__c = $Label.Core_MDF_IPA_Program_Name, OR(Core_MDF_Payment_Type_nm__c = &apos;Distributor (Credit Memo)&apos;, Core_MDF_Payment_Type_nm__c = &apos;Customer (Pass Through)&apos;)), false, IF(
AND(
Core_MDF_Program__c = $Label.Core_MDF_Co_GTM_program_name,
OR(
Core_MDF_Payment_Type_nm__c = &apos;Distributor (Credit Memo)&apos;,
Core_MDF_Payment_Type_nm__c = &apos;Customer (Pass Through)&apos;,
Core_MDF_Payment_Type_nm__c = &apos;Vistex (Credit Memo)&apos;,
Core_MDF_Payment_Type_nm__c = &apos;Customer (Credit Memo)&apos;
)
),
false,
false
)),
false)
)
)</errorConditionFormula>
        <errorMessage>Please enter following Mandatory fields: Execution Start Date, Execution End Date, Proof Of Cost Currency, Proof Of Cost Date, Proof Of Cost Number, Costs not Reimbursable (Local), Taxes (Local), Total Amount (Local), Country/Region</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Claim_Window</fullName>
        <active>true</active>
        <description>External users should submit a claim within 6 months from the execution end date. Internal users can submit that with any execution end date.</description>
        <errorConditionFormula>IF(
AND(NOT(Core_MDF_Program__c = $Label.Core_MDF_Retail_Program_Name),NOT(Core_MDF_Program__c= $Label.Core_MDF_IPA_Program_Name)),
AND((OR(ISNEW(),
ISCHANGED(Core_MDF_Ad_Run_End_Date__c)
)),
(TEXT($User.UserType)==$Label.Core_MDF_Partner_User_Type ),
AND(TODAY() &gt; (Core_MDF_Ad_Run_End_Date__c+185),
IF(ISBLANK(Request.Core_MDF_ToBeClosedDate__c),true,
IF(Core_MDF_Activity_End_Date__c + 185 &lt; Request.Core_MDF_ToBeClosedDate__c,false,true))),
ISBLANK(Core_MDF_Escalation_Id__c),
(TEXT(Core_MDF_Type_Txt__c)&lt;&gt; $Label.Core_MDF_Claim_Adjustment_Type)
),
false)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Ad_Run_End_Date__c</errorDisplayField>
        <errorMessage>The claim cannot be created/updated as it is outside the claiming window. A claim must be submitted within 6 months from the execution end date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Close_Adjustment</fullName>
        <active>true</active>
        <description>Adjustment cannot be closed if there is no offset or if it is in Paid status</description>
        <errorConditionFormula>AND(
TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Adjustment_Type,
TEXT(Core_MDF_Status__c)==$Label.Core_MDF_Claim_Activity_Closed_Status,
OR(Core_MDF_Total_Invoice_Amount_Local__c=Amount,Amount=0)
)</errorConditionFormula>
        <errorMessage>An Adjustment may not be Closed when no Offsets exist, but it may be Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CostNotReimbursable</fullName>
        <active>true</active>
        <description>Costs not Reimbursable amount should be greater than or equal to zero</description>
        <errorConditionFormula>IF(
AND(TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Type,Core_MDF_OtherCostsnotReimbursable_Local__c&lt; 0, NOT(ISBLANK(Core_MDF_OtherCostsnotReimbursable_Local__c))),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter Costs not Reimbursable amount that is greater than or equal to zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EndDateFutureValidation</fullName>
        <active>true</active>
        <description>End date should not be greater than today&apos;s date</description>
        <errorConditionFormula>IF(DATEVALUE(TEXT(Core_MDF_Ad_Run_End_Date__c)) &gt; DATEVALUE(TEXT(NOW())) ,TRUE, FALSE)</errorConditionFormula>
        <errorMessage>Execution end date cannot be a date in the future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EndDateValidation</fullName>
        <active>true</active>
        <description>Checks if the end date of the claim falls in the range of activity</description>
        <errorConditionFormula>IF( AND(Request.Core_MDF_Is_Outcome_Based_Ind__c = false, OR( Core_MDF_Ad_Run_End_Date__c &gt; Core_MDF_Activity_End_Date__c, Core_MDF_Ad_Run_End_Date__c &lt; Core_MDF_Activity_Start_Date__c ) ), true, false )</errorConditionFormula>
        <errorMessage>Please enter an Execution End Date that falls within the activity estimated date range.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EndDateValidation_OutcomeBased</fullName>
        <active>true</active>
        <description>Checks if the end date of the claim falls in the range of activity</description>
        <errorConditionFormula>IF( AND(Request.Core_MDF_Is_Outcome_Based_Ind__c = true, OR( Core_MDF_Ad_Run_End_Date__c &gt; Core_MDF_Activity_End_Date__c, Core_MDF_Ad_Run_End_Date__c &lt; Core_MDF_Activity_Start_Date__c ) ), true, false )</errorConditionFormula>
        <errorMessage>Please enter an Execution End Date that falls within the Outcome-Based Campaign estimated date range.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_InactiveAccountValidation_Outco</fullName>
        <active>true</active>
        <errorConditionFormula>AND( Request.ChannelPartner.Core_MDF_Active_Ind__c = false, 
Request.Core_MDF_Is_Outcome_Based_Ind__c = true, 
TEXT(Core_MDF_Status__c) &lt;&gt; $Label.Core_MDF_Claim_Status_Paid, 
TEXT(Core_MDF_Status__c) &lt;&gt; $Label.Core_MDF_Claim_Status_Paid_and_Pending_Documents, 
TEXT(Core_MDF_Status__c) &lt;&gt; $Label.Core_MDF_Claim_Status_Paid_and_PIC_Pending, 
TEXT(Core_MDF_Status__c) &lt;&gt; $Label.Core_MDF_Claim_Status_Paid_and_Resubmission_Required, 
TEXT(Core_MDF_Type_Txt__c) &lt;&gt; $Label.Core_MDF_NegativeClaim )</errorConditionFormula>
        <errorMessage>You cannot use this Outcome-Based Campaign as the account over the Outcome-Based Campaign is inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Inactive_Account_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND( Request.ChannelPartner.Core_MDF_Active_Ind__c = false, 
Request.Core_MDF_Is_Outcome_Based_Ind__c = false, 
TEXT(Core_MDF_Status__c) &lt;&gt; $Label.Core_MDF_Claim_Status_Paid, 
TEXT(Core_MDF_Status__c) &lt;&gt; $Label.Core_MDF_Claim_Status_Paid_and_Pending_Documents, 
TEXT(Core_MDF_Status__c) &lt;&gt; $Label.Core_MDF_Claim_Status_Paid_and_PIC_Pending, 
TEXT(Core_MDF_Status__c) &lt;&gt; $Label.Core_MDF_Claim_Status_Paid_and_Resubmission_Required, 
TEXT(Core_MDF_Type_Txt__c) &lt;&gt; $Label.Core_MDF_NegativeClaim )</errorConditionFormula>
        <errorMessage>You cannot use this Activity as the account over the Activity is inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Invoice_Date</fullName>
        <active>true</active>
        <description>Proof Of Cost Date cannot be in future date</description>
        <errorConditionFormula>IF(OR(
AND(ISNEW(),Core_MDF_Invoice_Date__c &gt; TODAY()), 
AND( ISCHANGED( Core_MDF_Invoice_Date__c ), Core_MDF_Invoice_Date__c &gt; TODAY())),
TRUE, 
FALSE)</errorConditionFormula>
        <errorMessage>Proof Of Cost Date cannot be a date in future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_NegativeClaimAmountVal</fullName>
        <active>true</active>
        <description>To check whether the Amount of Negative Claim is NOT greater than 0</description>
        <errorConditionFormula>TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Adjustment_Type&amp;&amp;Amount  &gt; 0</errorConditionFormula>
        <errorMessage>The Amount of a Negative Claim cannot be greater than 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Opal_StopClaimCreation</fullName>
        <active>false</active>
        <description>This is to avoid Opal claim creation until complete Opal Claim functionality is in place.</description>
        <errorConditionFormula>AND(OR(RecordType.DeveloperName = &apos;Core_MDF_Client_Co_Marketing_Fund&apos;,RecordType.DeveloperName = &apos;Core_MDF_Data_Center_Co_Marketing_Fund&apos;),NOT(ISBLANK(TEXT(Request.Core_MDF_Budget_Type_nm__c))),CONTAINS($Label.Core_MDF_OPAL_BudgetTypes,TEXT(Request.Core_MDF_Budget_Type_nm__c)))</errorConditionFormula>
        <errorMessage>Claim Creation for the selected budget type is not supported currently.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PaymentId_Check</fullName>
        <active>true</active>
        <description>when the claim status is Pending Payment, Payment Id should not be blank</description>
        <errorConditionFormula>AND(ISPICKVAL(Core_MDF_Status__c,&apos;Pending Payment&apos;), Core_MDF_Payment_Id__c = null,NOT(Core_MDF_Has_Sub_Claims_Ind__c))</errorConditionFormula>
        <errorMessage>Payment Id is mandatory for Pending Payment Claims</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Reimbursable_Transaction_Amount</fullName>
        <active>true</active>
        <description>reimbursable amount should be greater than zero</description>
        <errorConditionFormula>IF(
AND(TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Type,OR(Core_MDF_Reimbursable_TransactionAmt_Loc__c&lt;= 0, ISBLANK(Core_MDF_Reimbursable_TransactionAmt_Loc__c))),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter a reimbursable amount that is greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RequestedReimbursementAmt</fullName>
        <active>true</active>
        <errorConditionFormula>IF( 
AND(TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Type,OR(Core_MDF_Requested_Reimbursement_Amt__c &lt;= 0, ISBLANK(Core_MDF_Requested_Reimbursement_Amt__c ))), 
TRUE, FALSE 
)</errorConditionFormula>
        <errorMessage>Please enter a requested amount that is greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RestrictClaimCreationOnDeclined</fullName>
        <active>true</active>
        <description>Claim cannot be created as the MDF Intel® Partner Alliance activity associated to the claim is declined.</description>
        <errorConditionFormula>ISPICKVAL( Core_MDF_Campaign_Id__r.Status, &apos;Declined&apos;)</errorConditionFormula>
        <errorMessage>Claim cannot be created as the MDF Intel® Partner Alliance activity associated to the claim is declined.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RestrictClaimforClosed_Outcome</fullName>
        <active>true</active>
        <description>Blocking Claim creation on Cancelled Activity for all users and Claim Creation/Edit on closed activity by External User.</description>
        <errorConditionFormula>AND( ISNEW(), Request.Core_MDF_Is_Outcome_Based_Ind__c = true, OR( (AND( ISPICKVAL(Request.Core_MDF_Fund_Request_Status__c, &quot;Closed&quot;), NOT($Permission.Core_MDF_CreateClaimOnClosedActivity), ISBLANK(Core_MDF_Escalation_Id__c) )), ISPICKVAL(Request.Core_MDF_Fund_Request_Status__c, &quot;Cancelled&quot;) ) )</errorConditionFormula>
        <errorMessage>Claim cannot be created on an Outcome-Based Campaign in Closed/Cancelled status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RestrictCreationOfMultipleClaim</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISNEW(),
NOT(ISBLANK(Core_MDF_Escalation_Id__c)),
NOT(ISBLANK(Core_MDF_Escalation_Id__r.Core_MDF_Claim_Number_id__c)),
NOT(
AND(
NOT(ISBLANK(Core_MDF_Claim_Id__c)),
Core_MDF_OutcomeBased_Ind__c = TRUE,
Core_MDF_Program__c = $Label.Core_MDF_IPA_Program_Name
)
)
)</errorConditionFormula>
        <errorMessage>A claim has already been created with this escalation. If additional claims have to be submitted please raise a new escalation.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Change_Owner</fullName>
        <active>true</active>
        <description>To restrict the owner change for Positive Adjustment Claims for External users</description>
        <errorConditionFormula>AND( ISPICKVAL($User.UserType, &apos;PowerPartner&apos;) , ISCHANGED( OwnerId) ,  Core_MDF_CRR_Positive_Ind__c )</errorConditionFormula>
        <errorMessage>This user does not have permission to perform this action.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_ClaimCloneAndEdit</fullName>
        <active>false</active>
        <description>Restrict Account based users from cloning/editing proposal based claims and vice versa</description>
        <errorConditionFormula>AND(TEXT($User.UserType)==$Label.Core_MDF_Partner_User_Type,
Core_MDF_Program__c == &apos;Intel Partner Alliance&apos;,
OR(
AND(RecordType.DeveloperName == $Label.Core_MDF_IPA_AccountBased_RecType_DevName,NOT($Permission.Core_MDF_CCP_External_IPA_Account_Based_User),Core_MDF_Proposal_Based_Ind__c == false),
AND(RecordType.DeveloperName == $Label.Core_MDF_IPA_RecordType,NOT($Permission.Core_MDF_CCP_External_IPA_Proposal_Based_User),Core_MDF_Proposal_Based_Ind__c == true)))</errorConditionFormula>
        <errorMessage>This user does not have permission to perform this action</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Claim_Creation</fullName>
        <active>true</active>
        <description>This validation rule is to restrict claim creation when activity is in the following statuses: In-Progress Pending Review, In-Progress Pending Approval and In-Progress Revision Required.</description>
        <errorConditionFormula>AND( ISNEW(), Request.Core_MDF_Is_Outcome_Based_Ind__c = false, OR( Core_MDF_Activity_Status_nm__c = &apos;In-Progress Pending Review&apos;, Core_MDF_Activity_Status_nm__c = &apos;In-Progress Pending Approval&apos;, Core_MDF_Activity_Status_nm__c = &apos;In-Progress Revision Required&apos; ) )</errorConditionFormula>
        <errorMessage>Claim creation is blocked due to the ‘In-Progress’ Activity needing approval.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Claim_Creation_Outcome</fullName>
        <active>true</active>
        <description>This validation rule is to restrict claim creation when activity is in the following statuses: In-Progress Pending Review, In-Progress Pending Approval and In-Progress Revision Required.</description>
        <errorConditionFormula>AND( ISNEW(), Request.Core_MDF_Is_Outcome_Based_Ind__c = true, OR( Core_MDF_Activity_Status_nm__c = &apos;In-Progress Pending Review&apos;, Core_MDF_Activity_Status_nm__c = &apos;In-Progress Pending Approval&apos;, Core_MDF_Activity_Status_nm__c = &apos;In-Progress Revision Required&apos; ) )</errorConditionFormula>
        <errorMessage>Claim creation is blocked due to the ‘In-Progress’ Outcome-Based Campaign needing approval.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_ClaimforClosedActivity</fullName>
        <active>true</active>
        <description>Blocking Claim creation on Cancelled Activity for all users and Claim Creation/Edit on closed activity by External User.</description>
        <errorConditionFormula>AND( ISNEW(), Request.Core_MDF_Is_Outcome_Based_Ind__c = false, OR( (AND( ISPICKVAL(Request.Core_MDF_Fund_Request_Status__c, &quot;Closed&quot;), NOT($Permission.Core_MDF_CreateClaimOnClosedActivity), ISBLANK(Core_MDF_Escalation_Id__c) )), ISPICKVAL(Request.Core_MDF_Fund_Request_Status__c, &quot;Cancelled&quot;) ) )</errorConditionFormula>
        <errorMessage>Claim cannot be created on an activity in Closed/Cancelled status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Status_For_Super_Claim</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordType.DeveloperName= &quot;Core_MDF_IPA_Account_Based&quot;,
    Core_MDF_Has_Sub_Claims_Ind__c,
    NOT(
        OR(
            ISPICKVAL(Status, &quot;Rejected&quot;),
            ISPICKVAL(Status, &quot;Draft&quot;),
            ISPICKVAL(Status, &quot;Submitted&quot;)
        )
    )
)</errorConditionFormula>
        <errorMessage>Super Claims having sub claims can be set to only Draft, Submitted or Rejected status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Status_Update</fullName>
        <active>false</active>
        <description>This rule restricts the updating of the claim status to pre-payment status from &apos;paid&apos; and &apos;pending payment&apos;</description>
        <errorConditionFormula>AND(
	ISCHANGED(Core_MDF_Status__c),
	OR(
		AND(
			ISPICKVAl(PRIORVALUE(Core_MDF_Status__c),&apos;Pending Payment&apos;),
			NOT(
				OR(
					AND(
						OR(
							ISPICKVAL(Core_MDF_Status__c,&apos;Paid and PIC Pending&apos;),
							ISPICKVAL(Core_MDF_Status__c,&apos;Paid and Pending Documents&apos;),
							ISPICKVAL(Core_MDF_Status__c,&apos;Paid and Resubmission Required&apos;)
						),
						Core_MDF_Legacy_Claim_Ind__c = true
					),
					ISPICKVAL(Core_MDF_Status__c,&apos;Paid&apos;)
				)
			),
			ISPICKVAL(Core_MDF_Payment_Rollback_Reason_nm__c,&apos;&apos;)
		),
		AND(
			ISPICKVAl(PRIORVALUE(Core_MDF_Status__c),&apos;Paid&apos;),
			NOT(
				AND(
					OR(
						ISPICKVAL(Core_MDF_Status__c,&apos;Paid and PIC Pending&apos;),
						ISPICKVAL(Core_MDF_Status__c,&apos;Paid and Pending Documents&apos;),
						ISPICKVAL(Core_MDF_Status__c,&apos;Paid and Resubmission Required&apos;)
					),
					Core_MDF_Legacy_Claim_Ind__c = true
				)
			)
		)
		
	),
	AND(
		$CustomMetadata.Trigger_Execution__mdt.Core_MDF_RestrictPostPaymentStatusUpdate.Active__c,
		OR(
			(ISBLANK( $CustomMetadata.Trigger_Execution__mdt.Core_MDF_RestrictPostPaymentStatusUpdate.Inactive_for_User__c )),
			AND(
				NOT( ISBLANK( $CustomMetadata.Trigger_Execution__mdt.Core_MDF_RestrictPostPaymentStatusUpdate.Inactive_for_User__c ) ),
				IF(($User.Id &lt;&gt; $CustomMetadata.Trigger_Execution__mdt.Core_MDF_RestrictPostPaymentStatusUpdate.Inactive_for_User__c) ,true,false)
			)
		)
	)
)</errorConditionFormula>
        <errorMessage>Claim Status cannot be updated in its current status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RetailAmtLessThanEscalationAmt</fullName>
        <active>true</active>
        <description>Validates that the Claim Amount does not exceed the approved Escalation Amount for Retail and IPA programs.</description>
        <errorConditionFormula>AND(
 OR(
        AND(
            OR($Permission.Core_MDF_RetailClaimSubmitter,
                $Permission.Core_MDF_CCP_RMF_Internal_Claim_Operations
            ),
            Core_MDF_Program__c = $Label.Core_MDF_Retail_Program_Name
        ),
        AND(
            $Permission.Core_MDF_IPAClaimSubmitter,
            Core_MDF_Program__c = $Label.Core_MDF_IPA_Program_Name
        )
    ),
!ISNULL(Core_MDF_Escalation_Id__c),
OR(
AND(ISNEW(),Amount &gt; Core_MDF_Escalation_Id__r.Core_MDF_Approved_Amount_amt__c),
AND(ISCHANGED(Amount),Amount &gt; Core_MDF_Escalation_Id__r.Core_MDF_Approved_Amount_amt__c)
))</errorConditionFormula>
        <errorMessage>Claim amount cannot exceed the amount that was approved on the escalation.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_SPCF_Negative_Number_Val</fullName>
        <active>true</active>
        <errorConditionFormula>IF(($Permission.Core_MDF_Internal_PaymentAdmin), 
false, 
OR(( Core_MDF_NoOfEngagements_Nbr__c &lt; 0 ),(  Core_MDF_NoOfImpressions_Nbr__c  &lt; 0),(  Core_MDF_No_of_Leads_nbr__c  &lt; 0 ), (Core_MDF_NoOfTrialActivations_Nbr__c  &lt; 0)
))</errorConditionFormula>
        <errorMessage>Numeric fields must be greater than or equal to zero </errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_StartDateFutureValidation</fullName>
        <active>true</active>
        <description>Start date should not be greater than today&apos;s date</description>
        <errorConditionFormula>IF(DATEVALUE(TEXT(Core_MDF_Ad_Run_Start_Date__c)) &gt;  DATEVALUE(TEXT(NOW())) ,TRUE, FALSE)</errorConditionFormula>
        <errorMessage>Execution start date cannot be a date in the future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_StartDateValidation</fullName>
        <active>true</active>
        <description>Checks if the ad run start date falls in the activity range</description>
        <errorConditionFormula>IF( AND( Request.Core_MDF_Is_Outcome_Based_Ind__c = false,
OR( Core_MDF_Ad_Run_Start_Date__c &gt; Core_MDF_Activity_End_Date__c, Core_MDF_Ad_Run_Start_Date__c &lt; Core_MDF_Activity_Start_Date__c ) ),
TRUE, FALSE )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Number_of_Attendees_Nbr__c</errorDisplayField>
        <errorMessage>Please enter an Execution Start Date that falls within the activity estimated date range.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_StartDateValidation_Outcome</fullName>
        <active>true</active>
        <description>Checks if the ad run start date falls in the activity range</description>
        <errorConditionFormula>IF( AND( Request.Core_MDF_Is_Outcome_Based_Ind__c = true,
OR( Core_MDF_Ad_Run_Start_Date__c &gt; Core_MDF_Activity_End_Date__c, Core_MDF_Ad_Run_Start_Date__c &lt; Core_MDF_Activity_Start_Date__c ) ),
TRUE, FALSE )</errorConditionFormula>
        <errorMessage>Please enter an Execution Start Date that falls within the Outcome-Based Campaign estimated date range.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_StartDate_EndDate_Validation</fullName>
        <active>true</active>
        <description>Execution start date cannot be greater than Execution end date</description>
        <errorConditionFormula>IF(
Core_MDF_Ad_Run_Start_Date__c &gt; Core_MDF_Ad_Run_End_Date__c ,
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Execution start date cannot be greater than execution end date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_TaxesLocal</fullName>
        <active>true</active>
        <description>Taxes amount should be greater than or equal to zero</description>
        <errorConditionFormula>IF(
AND(TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Type,Core_MDF_Taxes_Local__c&lt; 0, NOT(ISBLANK(Core_MDF_Taxes_Local__c))),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter Tax amount that is greater than or equal to zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ValidateBank</fullName>
        <active>true</active>
        <description>To validate that Bank is not selected for RSA MD, MDF and MDF+ Claims. Also, when the Payment Type is &apos;Distributor (Credit Memo)&apos; or &apos;Customer (Pass Through)&apos; for IPA Program.</description>
        <errorConditionFormula>AND(
	OR(
		ISNEW(), 
		ISCHANGED(Core_MDF_Bank__c), 
		ISCHANGED( Core_MDF_Budget_Type_Options_Nm__c)
	), 
	OR(
		ISPICKVAL( Core_MDF_Budget_Type_Options_Nm__c , &apos;RSA MD&apos;) ,
		ISPICKVAL( Core_MDF_Budget_Type_Options_Nm__c , &apos;MDF&apos;),
		ISPICKVAL( Core_MDF_Budget_Type_Options_Nm__c , &apos;MDF+&apos;),
		AND(
			Core_MDF_Program__c = $Label.Core_MDF_IPA_Program_Name, 
			OR(
				Core_MDF_Payment_Type_nm__c = &apos;Distributor (Credit Memo)&apos;, 
				Core_MDF_Payment_Type_nm__c = &apos;Customer (Pass Through)&apos;
			)
		)
	),
	Core_MDF_Bank__c &lt;&gt; &apos;&apos;
)</errorConditionFormula>
        <errorMessage>Bank is not applicable for this Claim due to the Budget Type provided.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Testing_BudgetType_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>IF( CONTAINS($Label.Core_MDF_OPAL_BudgetTypes, TEXT(Core_MDF_Budget_Type_Options_Nm__c)) , false, ISNULL(Core_MDF_Taxes_Local__c))</errorConditionFormula>
        <errorMessage>Budget Type cant be empty for legacy</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>mandatory_fileds_validation</fullName>
        <active>true</active>
        <description>for channel MDF mandatory filed should not be empty</description>
        <errorConditionFormula>IF(
(Core_MDF_Program__c=&apos;Channel MDF&apos;)
 ,  
  OR(
  ISBlANK(Title),
  ISBLANK(Core_MDF_Ad_Run_End_Date__c),
  ISBLANK(Core_MDF_Ad_Run_Start_Date__c),
  ISPICKVAL(Core_MDF_Currency__c,&apos;&apos;),
  ISNULL(Core_MDF_Total_Invoice_Amount_Local__c),
  ISPICKVAL(Core_MDF_Country_Location_nm__c,&apos;&apos;),
  ISPICKVAL(Core_MDF_Currency__c,&apos;&apos;),
  ISBLANK(Core_MDF_OtherCostsnotReimbursable_Local__c)
  )
  ,  
  false)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Number_of_Attendees_Nbr__c</errorDisplayField>
        <errorMessage>mandatory filed should not be empty!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>test_Core_MDF_Claim_Required_Fields</fullName>
        <active>false</active>
        <description>This rule will check if the required fields are blank.For Retail MD field like &quot;Start &amp; End data,Currency,Amount,Country&quot; will check where as for Retail MDF field like &quot;Start &amp; End data,Currency,Amount,Country,Bank &quot; will check</description>
        <errorConditionFormula>OR(
ISBLANK(Core_MDF_Ad_Run_End_Date__c),
ISBLANK(Core_MDF_Ad_Run_Start_Date__c),
ISPICKVAL(Core_MDF_Currency__c,&apos;&apos;),
ISNULL(Core_MDF_Total_Invoice_Amount_Local__c),
ISPICKVAL(Core_MDF_Country_Location_nm__c,&apos;&apos;),
IF(AND(NOT(Core_MDF_Program__c = $Label.Core_MDF_Retail_Program_Name),NOT(Core_MDF_Program__c= $Label.Core_MDF_IPA_Program_Name)),
OR(
ISBLANK(Core_MDF_Invoice_Date__c),
ISBLANK(Core_MDF_Invoice_Number__c),
ISNULL(Core_MDF_OtherCostsnotReimbursable_Local__c),

 IF(OR (CONTAINS($Label.Core_MDF_OPAL_BudgetTypes, 
 TEXT(Core_MDF_Budget_Type_Options_Nm__c)),
 OR (Core_MDF_Program__c=&apos;ChannelMDF&apos;)) ,
 false, 
 ISNULL(Core_MDF_Taxes_Local__c)) ,

AND(Text(Core_MDF_Budget_Type_Options_Nm__c) &lt;&gt; &apos;MDF&apos;,Text(Core_MDF_Budget_Type_Options_Nm__c) &lt;&gt; &apos;MDF+&apos;,ISBLANK(Core_MDF_Bank__c))
),

IF(OR(Text(Core_MDF_Budget_Type_Options_Nm__c) &lt;&gt; $Label.Core_MDF_Retail_RSA_MD_Budget_Type,Core_MDF_Program__c= $Label.Core_MDF_IPA_Program_Name),
ISBLANK(Core_MDF_Bank__c),
false)
)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Number_of_Attendees_Nbr__c</errorDisplayField>
        <errorMessage>Please enter following Mandatory fields.
Execution Start Date, Execution End Date, Proof Of Cost Currency, Proof Of Cost Date, Proof Of Cost Number, Media Vehicle, Costs not Reimbursable (Local), Taxes (Local), Total Amount (Local), Country/Region</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>test_VR_block_status_update</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
  Id = &quot;0RBdh0000000TLNGA2&quot;,
  ISCHANGED(Core_MDF_Claim_Review_Case__c)
)</errorConditionFormula>
        <errorMessage>update blocked</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>test_validation_for_Opal</fullName>
        <active>false</active>
        <errorConditionFormula>AND(OR(RecordType.DeveloperName = &apos;Core_MDF_Client_Co_Marketing_Fund&apos;,RecordType.DeveloperName = 	&apos;Core_MDF_Data_Center_Co_Marketing_Fund&apos;),NOT(CONTAINS($Label.Core_MDF_OPAL_BudgetTypes,TEXT(Request.Core_MDF_Budget_Type_nm__c))))</errorConditionFormula>
        <errorMessage>This is test validation for legacy CCF &amp; DCF</errorMessage>
    </validationRules>
