        <summarizedField>Core_MDF_Recovery__c.Core_MDF_Amount_Amt__c</summarizedField>
        <summaryForeignKey>Core_MDF_Recovery__c.Core_MDF_Claim_Id__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_Invoice_Amount_Local__c</fullName>
        <description>Total amount of the transaction/invoice in the transaction currency</description>
        <externalId>false</externalId>
