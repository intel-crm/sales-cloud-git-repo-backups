        <description>The Country in which the Co-Marketing Activity was executed</description>
        <inlineHelpText>The Country in which the  Co-Marketing Activity took place</inlineHelpText>
        <label>Country/Region</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Country</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_CreatedBy_Nm__c</fullName>
        <description>Name of the user who submitted the claim</description>
        <externalId>false</externalId>
        <formula>IF(Core_MDF_Batch_Nbr__c != &apos;&apos;,
IF(NOT(ISBLANK(Core_MDF_Claim_Submitter_Id__c)),
Core_MDF_Claim_Submitter_Id__r.FirstName &amp;  &apos; &apos; &amp;  Core_MDF_Claim_Submitter_Id__r.LastName,
IF(ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;),
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName,
$Label.Core_MDF_Intel_System_User
)),
IF(ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;),
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName,
$Label.Core_MDF_Intel_System_User
)
)</formula>
        <label>Created By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
