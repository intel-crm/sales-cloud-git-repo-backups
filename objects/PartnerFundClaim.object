    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Amount_Validation</fullName>
        <active>true</active>
        <description>Total Amount should not be zero or less than zero</description>
        <errorConditionFormula>IF(
AND( 
ISPICKVAL(Core_MDF_Type_Txt__c,&apos;Claim&apos;),Core_MDF_Total_Invoice_Amount_Local__c &lt;= 0) 
, 
TRUE, FALSE
)</errorConditionFormula>
        <errorDisplayField>Amount</errorDisplayField>
        <errorMessage>Please enter a total amount that is greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ClaimEndDateBetween3Months</fullName>
        <active>true</active>
        <description>Difference between ad run end date and ad run start date cannot be greater than 3 months.</description>
        <errorConditionFormula>NOT(Core_MDF_IsClaimReviewEscalation_Ind__c) &amp;&amp;
(ISNEW() || ISCHANGED( Core_MDF_Ad_Run_Start_Date__c ) || ISCHANGED( Core_MDF_Ad_Run_End_Date__c ) ) &amp;&amp; ADDMONTHS( Core_MDF_Ad_Run_Start_Date__c ,3) &lt;  Core_MDF_Ad_Run_End_Date__c 
 &amp;&amp;(TEXT(Core_MDF_Type_Txt__c) ==$Label.Core_MDF_Claim)</errorConditionFormula>
        <errorMessage>The start and end date on a claim can cover only a 3 month period.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Claim_Required_Fields</fullName>
        <active>true</active>
        <description>This rule will check if the required fields are blank.</description>
        <errorConditionFormula>IF(
OR(ISBLANK(Core_MDF_Ad_Run_End_Date__c),ISBLANK(Core_MDF_Ad_Run_Start_Date__c),ISBLANK(Core_MDF_Bank__c),ISPICKVAL(Core_MDF_Currency__c,&apos;&apos;),ISBLANK(Core_MDF_Invoice_Date__c),ISBLANK(Core_MDF_Invoice_Number__c),ISBLANK(Core_MDF_Media_Vehicle__c),ISNULL(Core_MDF_OtherCostsnotReimbursable_Local__c),ISNULL(Core_MDF_Taxes_Local__c),ISNULL(Core_MDF_Total_Invoice_Amount_Local__c),ISPICKVAL(Core_MDF_Country_Location_nm__c,&apos;&apos;)),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter following Mandatory fields.
Ad Run Start Date, Ad Run End Date, Bank, Invoice/Receipt Currency, Invoice/Receipt Date, Invoice/Receipt Number, Media Vehicle, Costs not Reimbursable (Local), Taxes (Local), Total Amount (Local), Country/Region</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Claim_Window</fullName>
        <active>true</active>
        <description>External users should submit a claim within 6 months from the ad run end date. Internal users can submit that with any ad run end date.</description>
        <errorConditionFormula>AND((OR(ISNEW(),
ISCHANGED(Core_MDF_Ad_Run_End_Date__c)
)),
(TEXT($User.UserType)==$Label.Core_MDF_Partner_User_Type	), 
TODAY() &gt; (Core_MDF_Ad_Run_End_Date__c+185),
ISBLANK(Core_MDF_Escalation_Id__c),
(TEXT(Core_MDF_Type_Txt__c)&lt;&gt; $Label.Core_MDF_Claim_Adjustment_Type)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Ad_Run_End_Date__c</errorDisplayField>
        <errorMessage>The claim cannot be created/updated as it is outside the claiming window. A claim must be submitted within 6 months from the ad run end date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Claiming_Window_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>IF( 
AND(
ISPICKVAL( $User.UserType , &quot;PowerPartner&quot;),
OR 
(
(AND(Request.RecordType.DeveloperName = $CustomMetadata.Core_MDF_Claim_Submission_Window__mdt.Core_MDF_CCF_Claim_Submission_Window.Program__c , 
TODAY() &gt; ADDMONTHS(Core_MDF_Activity_End_Date__c,$CustomMetadata.Core_MDF_Claim_Submission_Window__mdt.Core_MDF_CCF_Claim_Submission_Window.Months__c ) )) , 

(AND( Request.RecordType.DeveloperName = $CustomMetadata.Core_MDF_Claim_Submission_Window__mdt.Core_MDF_DCF_Claim_Submission_Window.Program__c , 
TODAY() &gt; ADDMONTHS(Core_MDF_Activity_End_Date__c,$CustomMetadata.Core_MDF_Claim_Submission_Window__mdt.Core_MDF_DCF_Claim_Submission_Window.Months__c))) 
,

(AND( Request.RecordType.DeveloperName = $CustomMetadata.Core_MDF_Claim_Submission_Window__mdt.Core_MDF_SPCF_Claim_Submission_Window.Program__c , 
TODAY() &gt; ADDMONTHS(Core_MDF_Activity_End_Date__c,$CustomMetadata.Core_MDF_Claim_Submission_Window__mdt.Core_MDF_SPCF_Claim_Submission_Window.Months__c)))  
) 
)
, 

TRUE, FALSE )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Ad_Run_End_Date__c</errorDisplayField>
        <errorMessage>Your claim is out of claiming window.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Close_Adjustment</fullName>
        <active>true</active>
        <description>Adjustment cannot be closed if there is no offset or if it is in Paid status</description>
        <errorConditionFormula>AND(
TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Adjustment_Type,
TEXT(Core_MDF_Status__c)==$Label.Core_MDF_Claim_Activity_Closed_Status,
OR(Core_MDF_Total_Invoice_Amount_Local__c=Amount,Amount=0)
)</errorConditionFormula>
        <errorMessage>An Adjustment may not be Closed when no Offsets exist, but it may be Cancelled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EndDateFutureValidation</fullName>
        <active>true</active>
        <description>End date should not be greater than today&apos;s date</description>
        <errorConditionFormula>IF(
Core_MDF_Ad_Run_End_Date__c &gt; TODAY() ,
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Ad run end date cannot be a date in the future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EndDateValidation</fullName>
        <active>true</active>
        <description>Checks if the end date of the claim falls in the range of activity</description>
        <errorConditionFormula>IF(
OR(Core_MDF_Ad_Run_End_Date__c &gt; Core_MDF_Activity_End_Date__c,Core_MDF_Ad_Run_End_Date__c &lt; Core_MDF_Activity_Start_Date__c
),
TRUE,
FALSE
)</errorConditionFormula>
        <errorMessage>Please enter an end date that falls within the activity estimated date range.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Inactive_Account_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Request.ChannelPartner.Core_MDF_Active_Ind__c = false,TEXT(Core_MDF_Status__c) &lt;&gt; $Label.Core_MDF_Claim_Status_Paid, TEXT(Core_MDF_Type_Txt__c) &lt;&gt; $Label.Core_MDF_NegativeClaim
)</errorConditionFormula>
        <errorMessage>You cannot use this activity as the account over the activity is inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Invoice_Date</fullName>
        <active>true</active>
        <description>Invoice date cannot be in future date</description>
        <errorConditionFormula>IF( 
Core_MDF_Invoice_Date__c  &gt;  TODAY(), 
TRUE, FALSE 
)</errorConditionFormula>
        <errorMessage>Invoice/Receipt date cannot be a date in future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_NegativeClaimAmountVal</fullName>
        <active>true</active>
        <description>To check whether the Amount of Negative Claim is NOT greater than 0</description>
        <errorConditionFormula>TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Adjustment_Type&amp;&amp;Amount  &gt; 0</errorConditionFormula>
        <errorMessage>The Amount of a Negative Claim cannot be greater than 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Reimbursable_Transaction_Amount</fullName>
        <active>true</active>
        <description>reimbursable amount should be greater than zero</description>
        <errorConditionFormula>IF(
AND(TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Type,OR(Core_MDF_Reimbursable_TransactionAmt_Loc__c&lt;= 0, ISBLANK(Core_MDF_Reimbursable_TransactionAmt_Loc__c))),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter a reimbursable amount that is greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_AdRunEndDate</fullName>
        <active>false</active>
        <description>checks if Ad Run End Date is blank</description>
        <errorConditionFormula>IF(
ISBLANK( Core_MDF_Ad_Run_End_Date__c ),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter ad run end date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_AdRunStartdate</fullName>
        <active>false</active>
        <description>checks if the Ad Run Start Date is blank</description>
        <errorConditionFormula>IF(
ISBLANK(  Core_MDF_Ad_Run_Start_Date__c  ),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter ad run start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_Bank</fullName>
        <active>false</active>
        <description>checks if Bank is blank</description>
        <errorConditionFormula>IF( 
ISBLANK( Core_MDF_Bank__c), 
TRUE, FALSE 
)</errorConditionFormula>
        <errorMessage>Please enter bank</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_Currency</fullName>
        <active>false</active>
        <description>checks if the currency is null</description>
        <errorConditionFormula>IF(
ISPICKVAL(Core_MDF_Currency__c,&apos;&apos;),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter currency</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_InvoiceDate</fullName>
        <active>false</active>
        <description>Validation rule to check the required field Invoice Date</description>
        <errorConditionFormula>IF(
ISBLANK(Core_MDF_Invoice_Date__c),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter invoice/Receipt date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_InvoiceNum</fullName>
        <active>false</active>
        <description>checks if the invoice number is blank</description>
        <errorConditionFormula>IF(
ISBLANK(Core_MDF_Invoice_Number__c),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter invoice number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_MediaVehicle</fullName>
        <active>false</active>
        <description>checks if the media vehicle is blank</description>
        <errorConditionFormula>IF(
ISBLANK(Core_MDF_Media_Vehicle__c),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter media vehicle</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_Othercostnotreimb</fullName>
        <active>false</active>
        <description>checks if the other cost not reimbursable is blank</description>
        <errorConditionFormula>IF(
ISNULL(Core_MDF_OtherCostsnotReimbursable_Local__c),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter costs not reimbursable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_taxes_local</fullName>
        <active>false</active>
        <description>checks if the taxes is null</description>
        <errorConditionFormula>IF(
ISNULL(Core_MDF_Taxes_Local__c),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter taxes</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ReqField_total_inv_amt_loc</fullName>
        <active>false</active>
        <description>checks if the total amount is null</description>
        <errorConditionFormula>IF(
ISNULL(Core_MDF_Total_Invoice_Amount_Local__c),
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Please enter total amount</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RequestedReimbursementAmt</fullName>
        <active>true</active>
        <errorConditionFormula>IF( 
AND(TEXT(Core_MDF_Type_Txt__c)==$Label.Core_MDF_Claim_Type,OR(Core_MDF_Requested_Reimbursement_Amt__c &lt;= 0, ISBLANK(Core_MDF_Requested_Reimbursement_Amt__c ))), 
TRUE, FALSE 
)</errorConditionFormula>
        <errorMessage>Please enter a requested amount that is greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_ClaimforClosedActivity</fullName>
        <active>true</active>
        <description>Blocking Claim creation on Cancelled Activity for all users and Claim Creation/Edit on closed activity by External User.</description>
        <errorConditionFormula>AND(
ISNEW(),
OR(
(AND(ISPICKVAL(Request.Core_MDF_Fund_Request_Status__c, &quot;Closed&quot;),NOT($Permission.Core_MDF_CreateClaimOnClosedActivity))),
ISPICKVAL(Request.Core_MDF_Fund_Request_Status__c, &quot;Cancelled&quot;)
))</errorConditionFormula>
        <errorMessage>Claim cannot be created on an activity in Closed/Cancelled status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_SPCF_Negative_Number_Val</fullName>
        <active>true</active>
        <errorConditionFormula>OR(( Core_MDF_NoOfEngagements_Nbr__c &lt; 0 ),(  Core_MDF_NoOfImpressions_Nbr__c  &lt; 0),(  Core_MDF_NoOfLeads_Nbr__c  &lt; 0 ), (Core_MDF_NoOfTrialActivations_Nbr__c  &lt; 0))</errorConditionFormula>
        <errorMessage>Numeric fields must be greater than or equal to zero </errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_StartDateFutureValidation</fullName>
        <active>true</active>
        <description>Start date should not be greater than today&apos;s date</description>
        <errorConditionFormula>IF(
Core_MDF_Ad_Run_Start_Date__c &gt; TODAY() ,
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Ad run start date cannot be a date in the future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_StartDateValidation</fullName>
        <active>true</active>
        <description>Checks if the ad run start date falls in the activity range</description>
        <errorConditionFormula>IF( 
OR(  
Core_MDF_Ad_Run_Start_Date__c &gt; Core_MDF_Activity_End_Date__c, 
Core_MDF_Ad_Run_Start_Date__c &lt; Core_MDF_Activity_Start_Date__c 
), 
TRUE, 
FALSE 
)</errorConditionFormula>
        <errorMessage>Please enter a start date that falls within the activity estimated date range.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_StartDate_EndDate_Validation</fullName>
        <active>true</active>
        <description>Ad run start date cannot be greater than Ad run end date</description>
        <errorConditionFormula>IF(
Core_MDF_Ad_Run_Start_Date__c &gt; Core_MDF_Ad_Run_End_Date__c ,
TRUE, FALSE
)</errorConditionFormula>
        <errorMessage>Ad run start date cannot be greater than Ad run end date</errorMessage>
    </validationRules>
