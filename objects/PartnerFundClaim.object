Text(Request.ChannelPartner.Core_MDF_Payment_Type_NodeLevel_nm__c), IF(Text(Request.ChannelPartner.Core_MDF_Payment_Type_nm__c) != null ,
 Text(Request.ChannelPartner.Core_MDF_Payment_Type_nm__c),&apos;&apos;))))</formula>
