        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Applicable_VAT_Percentage_nm__c</fullName>
        <description>To store VAT Percentage if the selected Bank has Legal entity as 650 or 420. Applicable only for IPA and RMF(Retail MDF) programs.</description>
        <inlineHelpText>VAT percentage which is applicable.</inlineHelpText>
        <label>Applicable VAT Percentage</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>0</fullName>
                    <default>false</default>
                    <label>0%</label>
                </value>
                <value>
                    <fullName>8</fullName>
                    <default>false</default>
                    <label>8%</label>
                </value>
                <value>
                    <fullName>10</fullName>
                    <default>false</default>
                    <label>10%</label>
                </value>
                <value>
                    <fullName>20</fullName>
                    <default>false</default>
                    <label>20%</label>
                </value>
                <value>
                    <fullName>21</fullName>
                    <default>false</default>
                    <label>21%</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
