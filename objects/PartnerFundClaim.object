        <description>The Country in which the ad took place</description>
        <externalId>false</externalId>
        <formula>&apos;Field is EOL&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The Country in which the  Co-Marketing Activity took place</inlineHelpText>
        <label>Country/Region Old</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
