        <label>Activity Category</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_End_Date__c</fullName>
        <description>End Date of the Co-Marketing Activity</description>
        <formula>Request.Core_MDF_End_Date__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>End Date of the Co-Marketing Activity</inlineHelpText>
        <label>Activity End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Prior_to_Claiming_Nbr__c</fullName>
        <description>This field determines how many days before Activity was created prior to Occurring, i.e Ad Run End Date over Claim</description>
        <externalId>false</externalId>
        <formula>CreatedDate-Request.CreatedDate</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Activity Prior to Claiming</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Prior_to_Occuring_Nbr__c</fullName>
        <description>This field determines how many days before Activity was created prior to Occurring, i.e. Ad Run End Date over Claim</description>
        <externalId>false</externalId>
        <formula>Core_MDF_Ad_Run_Start_Date__c - DATEVALUE(Request.CreatedDate)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Activity Prior to Occuring</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Start_Date__c</fullName>
        <description>Start Date of the Co-Marketing Activity</description>
        <formula>Request.Core_MDF_Start_Date__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Start Date of the Co-Marketing Activity</inlineHelpText>
        <label>Activity Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
