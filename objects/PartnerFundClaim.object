    <fields>
        <fullName>Core_MDF_Quantity_to_Date_Nbr__c</fullName>
        <description>Used to capture the Quantity to Date</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the quantity from the beginning of the campaign until now, even if it is 0 or if it hasn’t changed since the most recent time it was reported.</inlineHelpText>
        <label>Quantity to Date</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Quarter_Year_Txt__c</fullName>
        <description>Indicates the claim&apos;s quarter and year</description>
        <externalId>false</externalId>
        <label>Quarter Number and Year</label>
        <length>25</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Quarter__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( MONTH ( DATEVALUE( DATETIMEVALUE(  CreatedDate ) ) ) , 12, &quot;Q1&quot;, 1, &quot;Q1&quot;, 2, &quot;Q1&quot;, 3, &quot;Q1&quot;, 4, &quot;Q2&quot;, 5, &quot;Q2&quot;, 6, &quot;Q2&quot;, 7, &quot;Q3&quot;, 8, &quot;Q3&quot;, 9, &quot;Q3&quot;, &quot;Q4&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Quarter_c</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Queued_Email_Sent_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This flag will be true after sending queued email notification to customers</description>
        <label>Queued Hold Email Sent</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_RMF_Claim_Approval_Dt__c</fullName>
        <description>The date the claim was approved. This field is created for Retail. It is used in retail payment file during payment run. &apos;Claim created date&apos; would be populated, if no case exists on claim. &apos;Case closed date&apos; would be populated, if case exists on claim and its status is &apos;Closed&apos;. Else it will be blank.</description>
        <formula>IF(
Core_MDF_Claim_Review_Case__c = null,
DATEVALUE( CreatedDate )
,
IF(
ISPICKVAL(Core_MDF_Claim_Review_Case__r.Status,  &apos;Closed&apos;)
,
DATEVALUE(Core_MDF_Claim_Review_Case__r.ClosedDate)
,
NULL
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Claim Approval Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_RMF_Intel_Hold_Ind__c</fullName>
        <description>When the claim is put on hold by intel for Backend Review or other reason. Hold stops the claim from being paid</description>
        <formula>OR(Core_MDF_Intel_Manual_Hold_Ind__c,Core_MDF_Criteria_Hold_Ind__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Checked when claim is on either Intel Manual Hold or Intel Hold</inlineHelpText>
        <label>Intel Hold</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
