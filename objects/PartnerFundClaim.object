        <fullName>Core_MDF_Latest_Review_Cycle_Number_nbr__c</fullName>
        <description>Tracks and stores the most recent PIC Review cycle number for a claim record. This was used for legacy claims to set the status based on the number of PIC Review cycles.</description>
        <label>Latest Review Cycle Number</label>
        <summarizedField>Core_MDF_PIC_Review__c.Core_MDF_CycleNumber_nbr__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_PIC_Review__c.Core_MDF_Review_Status_nm__c</field>
            <operation>equals</operation>
            <value>Completed, Failed</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_MDF_PIC_Review__c.Core_MDF_Claim_ID_id__c</summaryForeignKey>
        <summaryOperation>max</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
