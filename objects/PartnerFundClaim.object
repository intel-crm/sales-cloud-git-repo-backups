    <fields>
        <fullName>Core_MDF_Claim_Creation_Dur_Min_nbr__c</fullName>
        <description>This Field displays Duration spent by user to create an activity in minutes</description>
        <externalId>false</externalId>
        <formula>TRUNC(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24*60, 60 ),2)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Claim Creation Duration (Mins)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_Creation_Duration_txt__c</fullName>
        <description>This Field displays Duration spent by user to create an activity in minutes and seconds</description>
        <externalId>false</externalId>
        <formula>IF(AND(NOT(ISBLANK(Core_MDF_EndTime_dtm__c)),(NOT(ISBLANK(Core_MDF_EndTime_dtm__c)) )),
(IF(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24 * 60, 60 ) &lt; 1,
TEXT(FLOOR(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24 * 60*60, 60 ))) &amp; &quot; Sec&quot;,
TEXT(FLOOR(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24 * 60, 60 ))) &amp; &quot; Min &quot;
&amp;
TEXT(FLOOR(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24 * 60*60, 60 ))) &amp; &quot; Sec&quot;)),NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Claim Creation Duration</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_Date_Difference_Nbr__c</fullName>
        <externalId>false</externalId>
        <formula>ABS(DATEVALUE(CreatedDate) -  TODAY())</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Claim Date Difference</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_EvalInProgress_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To be used during the PIC Batch processing</description>
        <label>Claim evaluation in progress</label>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_Hold_Type_txt__c</fullName>
        <description>This field shows the hold type of the claim</description>
        <externalId>false</externalId>
        <formula>LEFT(IF(Core_MDF_Bank_Doc_Hold_Ind__c = true,$Label.Core_MDF_Bank_Document_Hold_Localized+&apos;, &apos;,&apos;&apos;) + IF(Core_MDF_ESD_Hold__c = true,$Label.Core_MDF_ESD_Hold_Localized+&apos;, &apos;,&apos;&apos;) + IF(AND(Core_MDF_RMF_Intel_Hold_Ind__c = true,ISPICKVAL($Profile.UserType ,&apos;PowerPartner&apos;),
OR(RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;,RecordType.DeveloperName= &apos;Core_MDF_Intel_Partner_Alliance&apos;)),
$Label.Core_MDF_Criteria_Hold_Localized+&apos;, &apos;, &apos;&apos;) + IF(AND(Core_MDF_Criteria_Hold_Ind__c = true,
NOT(AND(ISPICKVAL($Profile.UserType ,&apos;PowerPartner&apos;),RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;)),
NOT(AND(ISPICKVAL($Profile.UserType ,&apos;PowerPartner&apos;),RecordType.DeveloperName = &apos;Core_MDF_Intel_Partner_Alliance&apos;))),
$Label.Core_MDF_Criteria_Hold_Localized+&apos;, &apos;, &apos;&apos;) + IF(AND(Core_MDF_Intel_Manual_Hold_Ind__c = true,
NOT(AND(ISPICKVAL($Profile.UserType,&apos;PowerPartner&apos;),RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;)),
NOT(AND(ISPICKVAL($Profile.UserType ,&apos;PowerPartner&apos;),RecordType.DeveloperName = &apos;Core_MDF_Intel_Partner_Alliance&apos;))),
$Label.Core_MDF_Intel_Manual_Hold_Localized+&apos;, &apos;, &apos;&apos;)+ IF(Core_MDF_Member_Manual_Hold_Ind__c = true,$Label.Core_MDF_Member_Manual_Hold_Localized+&apos;, &apos;,&apos;&apos;)+ IF(Core_MDF_VAT_Hold_Ind__c= true,$Label.Core_MDF_VAT_Hold_Localized+&apos;, &apos;,&apos;&apos;) + IF(Core_MDF_Payment_Hold_ind__c = true,$Label.Core_MDF_Payment_Hold_Localized+&apos;, &apos;,&apos;&apos;)+IF(Core_MDF_Audit_Hold__c = true,$Label.Core_MDF_Audit_Hold_Localized+&apos;, &apos;,&apos;&apos;),LEN(IF(Core_MDF_Bank_Doc_Hold_Ind__c = true,$Label.Core_MDF_Bank_Document_Hold_Localized+&apos;, &apos;,&apos;&apos;) + IF(Core_MDF_ESD_Hold__c = true,$Label.Core_MDF_ESD_Hold_Localized+&apos;, &apos;,&apos;&apos;) + IF(AND(Core_MDF_RMF_Intel_Hold_Ind__c = true,ISPICKVAL($Profile.UserType ,&apos;PowerPartner&apos;),
OR(RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;,RecordType.DeveloperName= &apos;Core_MDF_Intel_Partner_Alliance&apos;)), $Label.Core_MDF_Criteria_Hold_Localized+&apos;, &apos;, &apos;&apos;) + IF(AND(Core_MDF_Criteria_Hold_Ind__c = true,NOT(AND(ISPICKVAL($Profile.UserType ,&apos;PowerPartner&apos;),RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;)),NOT(AND(ISPICKVAL($Profile.UserType ,&apos;PowerPartner&apos;),RecordType.DeveloperName = &apos;Core_MDF_Intel_Partner_Alliance&apos;))),$Label.Core_MDF_Criteria_Hold_Localized+&apos;, &apos;, &apos;&apos;) + IF(AND(Core_MDF_Intel_Manual_Hold_Ind__c = true,NOT(AND(ISPICKVAL($Profile.UserType,&apos;PowerPartner&apos;),RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;)),NOT(AND(ISPICKVAL($Profile.UserType,&apos;PowerPartner&apos;),RecordType.DeveloperName = &apos;Core_MDF_Intel_Partner_Alliance&apos;))),$Label.Core_MDF_Intel_Manual_Hold_Localized+&apos;, &apos;, &apos;&apos;)+ IF(Core_MDF_Member_Manual_Hold_Ind__c = true,$Label.Core_MDF_Member_Manual_Hold_Localized+&apos;, &apos;,&apos;&apos;)+ IF(Core_MDF_VAT_Hold_Ind__c= true,$Label.Core_MDF_VAT_Hold_Localized+&apos;, &apos;,&apos;&apos;) + IF(Core_MDF_Payment_Hold_ind__c = true,$Label.Core_MDF_Payment_Hold_Localized+&apos;, &apos;,&apos;&apos;)+IF(Core_MDF_Audit_Hold__c = true,$Label.Core_MDF_Audit_Hold_Localized+&apos;, &apos;,&apos;&apos;))-2)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Claim Hold Type(s)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
