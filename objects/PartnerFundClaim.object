    <fields>
        <fullName>Core_MDF_VAT_Amt__c</fullName>
        <externalId>false</externalId>
        <formula>((Amount+Core_MDF_Total_Claim_Offsets__c)* (

IF( Core_MDF_VAT_Eligibility_Ind__c, IF(AND( TEXT(Core_MDF_Applicable_VAT_Percentage_nm__c) != null,  
OR(TEXT(Core_MDF_Bank__r.Core_MDF_Intel_Company_Code__c) = &apos;650&apos;,
TEXT(Core_MDF_Bank__r.Core_MDF_Intel_Company_Code__c) = &apos;420&apos;), 
OR(Core_MDF_Program__c = &apos;Intel Partner Alliance&apos;, 
Core_MDF_Program__c = &apos;Retail Marketing Funds&apos;, Core_MDF_Program__c = &apos;Ecosystem Extension Fund&apos;,Core_MDF_Program__c=&apos;Co-GTM&apos;) ) , 
VALUE( SUBSTITUTE( TEXT(Core_MDF_Applicable_VAT_Percentage_nm__c) , &apos;%&apos;, &apos;&apos;)),
VALUE( SUBSTITUTE( TEXT(Core_MDF_Bank__r.Core_MDF_VAT_pct__c) , &apos;%&apos;, &apos;&apos;))),0)))/100</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>VAT Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_VAT_Eligibility_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is to identify weather Claim is flagged for VAT hold or not</description>
        <inlineHelpText>To identify weather claim is eligible for VAT or not</inlineHelpText>
        <label>VAT Eligibility</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_VAT_Hold_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if the claim is put on VAT hold</description>
        <inlineHelpText>Checked when the Claim is selected for Payment Document process</inlineHelpText>
        <label>Payment Documents Review Hold</label>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_VAT_Opt_In__c</fullName>
        <description>To identify weather claim is eligible for Bank Document hold, based on Ultimate Account&apos;s Country.</description>
        <inlineHelpText>To identify whether Claim is eligible for VAT or not</inlineHelpText>
        <label>Invoice Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>Service Invoice to Intel (VAT may apply)</fullName>
                    <default>false</default>
                    <label>Service Invoice to Intel (VAT may apply)</label>
                </value>
                <value>
                    <fullName>Reimbursement Request for 3rd party payment (NET cost only)</fullName>
                    <default>false</default>
                    <label>Reimbursement Request for 3rd party payment (NET cost only)</label>
                </value>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_VAT_Opt_In_txt__c</fullName>
        <description>To identify weather claim is eligible for Bank Document hold, based on Ultimate Account&apos;s Country.</description>
        <externalId>false</externalId>
        <formula>IF(OR(ISBLANK(TEXT(Core_MDF_VAT_Opt_In__c)),ISPICKVAL(Core_MDF_VAT_Opt_In__c, &quot;&quot;)),$Label.Core_MDF_Not_Applicable_value_for_Budget_Type,
    IF(ISPICKVAL(Core_MDF_VAT_Opt_In__c, &quot;Service Invoice to Intel (VAT may apply)&quot;),$Label.Core_MDF_Service_Invoice_to_Intel,
    IF(ISPICKVAL(Core_MDF_VAT_Opt_In__c, &quot;Reimbursement Request for 3rd party payment (NET cost only)&quot;),$Label.Core_MDF_Reimbursement_Request_for_3rd_party_payment,
    TEXT(Core_MDF_VAT_Opt_In__c))
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Invoice Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Vat_Payment_lcl_Amount__c</fullName>
        <description>To capture the converted VAT amount during payment based on the bank&apos;s payment currency.</description>
        <label>Vat Payment Local Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
