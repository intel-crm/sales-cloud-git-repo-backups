        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_AccountCompany__c</fullName>
        <description>The virtual corp of the claim&apos;s account</description>
        <externalId>false</externalId>
        <formula>Request.ChannelPartner.Core_MDF_CoMarketing_Ultimate_Account__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
