    <fields>
        <fullName>Core_MDF_Processing_Preference_nm__c</fullName>
        <description>To store the Processing Preference for a claim.</description>
        <inlineHelpText>Processing Preference applies if the claim is selected for Back-End Review.
Get paid, then settle – Best for accelerating cash flow; prioritizes time-to-money, and leaves the door open to possible future recovery.
Settle, then get paid – Best for minimizing post-payment recovery; prioritizes final resolution prior to payment, reduces risk of future recovery.</inlineHelpText>
        <label>Processing Preference</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Get paid, then settle</fullName>
                    <default>false</default>
                    <label>Get paid, then settle</label>
                </value>
                <value>
                    <fullName>Settle, then get paid</fullName>
                    <default>false</default>
                    <label>Settle, then get paid</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
