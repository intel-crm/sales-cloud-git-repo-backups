        <fullName>Core_MDF_Claim_Previous_Status__c</fullName>
        <description>This will store the claims previous status</description>
        <label>Claim Previous Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Submitted</fullName>
                    <default>false</default>
                    <label>Submitted</label>
                </value>
                <value>
                    <fullName>Pending Available Fund</fullName>
                    <default>false</default>
                    <label>Pending Available Funds</label>
                </value>
                <value>
                    <fullName>Payment Due</fullName>
                    <default>false</default>
                    <label>Payment Due</label>
                </value>
                <value>
                    <fullName>Pending Payment</fullName>
                    <default>false</default>
                    <label>Pending Payment</label>
                </value>
                <value>
                    <fullName>Paid</fullName>
                    <default>false</default>
                    <label>Paid</label>
                </value>
                <value>
                    <fullName>Hold</fullName>
                    <default>false</default>
                    <label>Hold</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Denied</fullName>
                    <default>false</default>
                    <label>Denied</label>
                </value>
                <value>
                    <fullName>Adjusted</fullName>
                    <default>false</default>
                    <label>Adjusted</label>
                </value>
                <value>
                    <fullName>Closed</fullName>
                    <default>false</default>
                    <label>Closed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
