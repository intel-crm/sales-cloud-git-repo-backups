    <fields>
        <fullName>Core_MDF_Document_Hold_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field will be set to true when claim is under POP Selection Process and will become false when it is out of POP Selection Process</description>
        <inlineHelpText>Checked when the claim is selected for POP document submission and awaiting the document upload by the customer</inlineHelpText>
        <label>Document Hold</label>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Document_Submission_DueDate_dtm__c</fullName>
        <description>This is just for display purpose. For Legacy Claims, we are mapping the value from Core_MDF_Doc_Hold_Doc_Sub_Due_Date_Dtm__c and for Non-legacy claim with status as &apos;Resubmission Required&apos; we are mapping from Request.Core_MDF_ToBeClosedDate__c. Otherwise, it holds NULL value.</description>
        <formula>IF((Core_MDF_Legacy_Claim_Ind__c = true &amp;&amp; (TEXT(Core_MDF_Status__c) =  $Label.Core_MDF_Claim_Status_Pending_Documents 
|| TEXT(Core_MDF_Status__c) = $Label.Core_MDF_Claim_Status_Paid_and_Pending_Documents ||
 TEXT(Core_MDF_Status__c) = $Label.Core_MDF_Claim_Status_Resubmission_Required || 
 TEXT(Core_MDF_Status__c) = $Label.Core_MDF_Claim_Status_Paid_and_Resubmission_Required)),
 Core_MDF_Doc_Hold_Doc_Sub_Due_Date_Dtm__c, IF(Core_MDF_Legacy_Claim_Ind__c = false &amp;&amp; (TEXT(Core_MDF_Status__c) = $Label.Core_MDF_Claim_Status_Resubmission_Required || TEXT(Core_MDF_Status__c) = &apos;Pending Account Manager Clarification&apos;), DATETIMEVALUE(Request.Core_MDF_ToBeClosedDate__c), NULL))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>If the documents are not received and confirmed by this date, the claim will not be processed for payments.</inlineHelpText>
        <label>Document Submission Due Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Document_Submission_Missed_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if any POP document is not submitted</description>
        <label>Document Submission Missed</label>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Due_Date_nbr__c</fullName>
        <description>An indication as to by when the system will allow a claim to be submitted, past that date the claim needs a late claim escalation approval</description>
        <externalId>false</externalId>
        <formula>IF((Request.Core_MDF_ToBeClosedDate__c - Today())&lt;=0, 0 ,Request.Core_MDF_ToBeClosedDate__c - Today())</formula>
        <inlineHelpText>Number of Days in which the claiming window will be closed.</inlineHelpText>
        <label>Days to Claim Window Closure</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
