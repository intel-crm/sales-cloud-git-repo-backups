    <fields>
        <fullName>Core_MDF_Owner_Nm__c</fullName>
        <description>The name of the claim owner</description>
        <externalId>false</externalId>
        <formula>IF( 
ISPICKVAL( Owner:User.Profile.UserType ,&apos;PowerPartner&apos;), 
Owner:User.FirstName  &amp; &apos; &apos; &amp;  Owner:User.LastName , 
$Label.Core_MDF_Intel_System_User 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Owner_UserType_Txt__c</fullName>
        <description>Formula field to store the user type (Standard or PowerPartner) of the claim&apos;s owner. Used in claim notifications.</description>
        <externalId>false</externalId>
        <formula>IF( (TEXT( Owner:User.Profile.UserType ) == &apos;PowerPartner&apos;), &apos;PowerPartner&apos;, &apos;Standard&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner UserType</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
