        <fullName>Core_MDF_Qrts_Year_Of_Claim_Start_Date__c</fullName>
        <externalId>false</externalId>
        <formula>&apos;Q&apos; + TEXT(CEILING( MONTH (  Core_MDF_Ad_Run_Start_Date__c  ) / 3 )) + &apos;-&apos; + TEXT(YEAR(Core_MDF_Ad_Run_Start_Date__c))</formula>
