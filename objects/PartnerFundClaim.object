        <fullName>Core_MDF_Status_Image__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( Core_MDF_Status__c , &quot;Paid&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3Ay&amp;operationContext=CHATTER&amp;contentId=05Tg0000006vYd5&quot;, &quot;paid&quot;, 30, 30),
&quot;Pending Available Fund&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3Av&amp;operationContext=CHATTER&amp;contentId=05Tg0000006vYd0&quot;, &quot;paf&quot;, 30, 30),
&quot;Payment Due&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3B3&amp;operationContext=CHATTER&amp;contentId=05Tg0000006vYdA&quot;,&quot;pd&quot;,30,30),
&quot;Hold&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3Au&amp;operationContext=CHATTER&amp;contentId=05Tg0000006vYcv&quot;,&quot;pd&quot;,30,30),
&quot;Hold&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3Au&amp;operationContext=CHATTER&amp;contentId=05Tg0000006vYcv&quot;,&quot;pd&quot;,30,30),
&quot;Cancelled&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3At&amp;operationContext=CHATTER&amp;contentId=05Tg0000006vYcq&quot;,&quot;pd&quot;,30,30),
&quot;Denied&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3At&amp;operationContext=CHATTER&amp;contentId=05Tg0000006vYcq&quot;,&quot;pd&quot;,30,30),
&quot;Adjusted&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3Ao&amp;operationContext=CHATTER&amp;contentId=05Tg0000006vYcl&quot;,&quot;pd&quot;,30,30),
&quot;Pending Payment&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3BS&amp;operationContext=CHATTER&amp;contentId=05Tg0000006vYde&quot;,&quot;pd&quot;,30,30),
&quot;Submitted&quot;, IMAGE(&quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=068g0000001h3dv&amp;operationContext=CHATTER&amp;contentId=05Tg0000006va2p&quot;,&quot;pd&quot;,30,30),
IMAGE(&quot;/servlet/servlet.FileDownload?file=015g0000001PDZo&quot;, &quot;yellow&quot;, 30, 30))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
