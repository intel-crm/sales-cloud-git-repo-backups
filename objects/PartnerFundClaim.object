        <fullName>Core_MDF_Activity_Types__c</fullName>
        <description>The type to which the activity is related to</description>
        <externalId>false</externalId>
        <formula>TEXT(Request.Core_MDF_Activity_Types__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
