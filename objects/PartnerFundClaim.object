    </fields>
    <fields>
        <fullName>Core_MDF_BankSetUpInformation_txt__c</fullName>
        <description>IPA Bank information for setting up a new bank</description>
        <externalId>false</externalId>
        <formula>IF(AND(
Core_MDF_Program__c = $Label.Core_MDF_IPA_Program_Name,
OR(
Core_MDF_Payment_Type_nm__c = &apos;Distributor (Credit Memo)&apos;,
Core_MDF_Payment_Type_nm__c = &apos;Customer (Pass Through)&apos;
)
), &apos;&apos;, $Label.Core_MDF_IPA_BankLink_Verbage1+&apos; &apos;+ HYPERLINK($Label.Core_MDF_IPA_BankDocLink, $Label.Core_MDF_IPA_BankLink_Verbage2)+&apos; &apos;+ $Label.Core_MDF_IPA_BankLink_Verbage3+&apos; &apos;+ IF(Core_MDF_Program__c= $Label.Core_MDF_Co_GTM_program_name, HYPERLINK($Label.Core_MDF_COGTMBankCorpOrgMailId, $Label.Core_MDF_IPABankCorporateOrganizationMail), HYPERLINK($Label.Core_MDF_IPABankCorpOrgMailId, $Label.Core_MDF_IPABankCorporateOrganizationMail)) +&apos;&apos;+$Label.Core_MDF_CorporateOrganization3
)</formula>
        <label>Bank set up information</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Bank_Doc_Hold_Eligibility_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is to identify weather Claim is flagged for Bank Document Hold or not</description>
