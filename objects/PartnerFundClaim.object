        <label>Activity Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Ad_Run_End_Date__c</fullName>
        <description>Activity Execution End Date</description>
        <inlineHelpText>Execution End Date</inlineHelpText>
        <label>Execution End Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Ad_Run_Start_Date__c</fullName>
