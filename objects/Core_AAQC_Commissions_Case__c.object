    <fields>
        <fullName>Core_AAQC_Cancellation_Reason__c</fullName>
        <description>Used To Store Cancellation Reason Of  Ask Commissions Case</description>
        <externalId>false</externalId>
        <formula>TEXT( Core_AAQC_Case__r.Core_AAQC_Cancellation_Reason__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>When creating a new case keep as --None--
When editing a case to cancel it change as appropriate</inlineHelpText>
        <label>Cancellation Reason</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_AAQC_Case_Detail__c</fullName>
        <description>Ask Commissions- Case Details to specify details of Category selected</description>
        <inlineHelpText>Please provide as much detail as possible to help us answer you quickly, 
such as: 
-Commissions month/relevant dates 
-Pay element(s) involved 
-Account(s) 
-Other data points e.g. Quota 
-Commissions cloud report or screen being used</inlineHelpText>
        <label>Case Details</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>9</visibleLines>
    </fields>
    <fields>
        <fullName>Core_AAQC_Case_Owner__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Core_AAQC_Case__r.Owner:Queue.QueueName !=null,Core_AAQC_Case__r.Owner:Queue.QueueName,  Core_AAQC_Case__r.Owner:User.LastName+&apos; &apos;+Core_AAQC_Case__r.Owner:User.FirstName )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Case Owner</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
