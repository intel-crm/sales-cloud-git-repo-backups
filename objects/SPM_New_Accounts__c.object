    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>CRM_VBS_No_Null_Coverage_Field</fullName>
        <active>true</active>
        <description>Account Primary Coverage cannot be None.</description>
        <errorConditionFormula>(ISBLANK(TEXT(Coverage__c)) || ISBLANK(TEXT(Coverage__c)))</errorConditionFormula>
        <errorMessage>Account Primary Coverage cannot be None.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SF_Account_or_Account_name_is_mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>IF((SF_Account__c == NULL &amp;&amp; Account_Name__c==NULL),TRUE,FALSE)</errorConditionFormula>
        <errorMessage>Either provide an existing SF Account or provide a new customer name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>URL_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  NOT(ISBLANK( Company_URL__c )), 
  NOT(REGEX(Company_URL__c ,&quot;^((http|https)://)??(www[.])??([a-zA-Z0-9]|-)+?([.][a-zA-Z0-9(-|/|=|?)??]+?)+?$&quot;))
)</errorConditionFormula>
        <errorDisplayField>Company_URL__c</errorDisplayField>
        <errorMessage>Please enter a valid URL.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>CRM_Update_New_Customer</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>CRM Update</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/flow/CST_Account_Update_New_Customers</url>
    </webLinks>
</CustomObject>
