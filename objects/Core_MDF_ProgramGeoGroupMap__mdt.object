<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Custom Metadata to store the Program and Geo based Group Names</description>
    <fields>
        <fullName>Core_MDF_Check_SubGeo__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To indicate whether a subGeo level sharing has to be done</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Check SubGeo</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Group_Name__c</fullName>
        <description>Group Name</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Group Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Program__c</fullName>
        <description>Program</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Program</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Client Co-Marketing Fund</fullName>
                    <default>true</default>
                    <label>Client Co-Marketing Fund</label>
                </value>
                <value>
                    <fullName>Client Co-Marketing Fund Boost</fullName>
                    <default>false</default>
                    <label>Client Co-Marketing Fund Boost</label>
                </value>
                <value>
                    <fullName>Data Center Co-Marketing Fund</fullName>
                    <default>false</default>
                    <label>Data Center Co-Marketing Fund</label>
                </value>
                <value>
                    <fullName>Retail Marketing Funds</fullName>
                    <default>false</default>
                    <label>Retail Marketing Funds</label>
                </value>
                <value>
                    <fullName>Service Provider Co-Marketing Fund</fullName>
                    <default>false</default>
                    <label>Service Provider Co-Marketing Fund</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Region__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Region</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>APJ</fullName>
                    <default>true</default>
                    <label>APJ</label>
                </value>
                <value>
                    <fullName>ASMO</fullName>
                    <default>false</default>
                    <label>ASMO</label>
                </value>
                <value>
                    <fullName>EMEA</fullName>
                    <default>false</default>
                    <label>EMEA</label>
                </value>
                <value>
                    <fullName>PRC</fullName>
                    <default>false</default>
                    <label>PRC</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Sub_Region__c</fullName>
        <description>Sub Region</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Sub Region</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>LAR</fullName>
                    <default>true</default>
                    <label>LAR</label>
                </value>
                <value>
                    <fullName>NAR</fullName>
                    <default>false</default>
                    <label>NAR</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>CCP ProgramGeoGroupMap</label>
    <pluralLabel>CCPProgramGeoGroupMaps</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
