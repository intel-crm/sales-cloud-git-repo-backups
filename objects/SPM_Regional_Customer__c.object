    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Regional_Customer</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Regional_Customer</fullName>
        <fields>Name</fields>
        <fields>Core_Planning_Period__c</fields>
        <fields>Core_Region__c</fields>
        <fields>Stage__c</fields>
        <label>Regional Customer</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>CRM_CST_Is_Active_Planning_Period__c</fullName>
        <formula>Core_Planning_Period__r.Active__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Active Planning Period</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CRM_CST_Planning_Period__c</fullName>
        <formula>Core_Planning_Period__r.Inactive__c</formula>
        <label>Is Inactive Planning Period</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Planning_Period__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Planning Period</label>
        <referenceTo>SPM_Planning_Period__c</referenceTo>
        <relationshipName>Regional_Customers</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Region__c</fullName>
        <externalId>false</externalId>
        <label>Region</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Starting_Stage__c</fullName>
        <externalId>false</externalId>
        <label>Starting Stage</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Region_Formula__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot; &amp; Id,  Core_Region__c )</formula>
        <label>Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Stage__c</fullName>
        <label>Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>DR</fullName>
                    <default>false</default>
                    <label>DR</label>
                </value>
                <value>
                    <fullName>VP</fullName>
                    <default>false</default>
                    <label>VP</label>
                </value>
                <value>
                    <fullName>Country Manager</fullName>
                    <default>false</default>
                    <label>Country Manager</label>
                </value>
                <value>
                    <fullName>GM</fullName>
                    <default>false</default>
                    <label>GM</label>
                </value>
                <value>
                    <fullName>BU</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>BU</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Regional View</label>
    <listViews>
        <fullName>All</fullName>
        <columns>Region_Formula__c</columns>
        <columns>Stage__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CRM_CST_Is_Active_Planning_Period__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>RC-{0000}</displayFormat>
        <label>Regional Customer Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Regional View</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>OpenListInQuip</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>Accept</excludedStandardButtons>
        <excludedStandardButtons>PrintableListView</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <searchResultsAdditionalFields>Region_Formula__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Stage__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Check_PS_for_moving_stage_forward</fullName>
        <active>true</active>
        <errorConditionFormula>IF( ISCHANGED(Stage__c ) &amp;&amp; NOT(OR($Permission.CST_Regional_Admin, $Permission.CST_Super_Admin )),TRUE,FALSE)</errorConditionFormula>
        <errorMessage>You are not allowed to move the stages. Please contact your regional admins.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_stage_to_move_back</fullName>
        <active>false</active>
        <errorConditionFormula>OR(IF(ISCHANGED( Stage__c ) &amp;&amp; ( ISPICKVAL(PRIORVALUE(Stage__c), &apos;GM&apos;) &amp;&amp; (TEXT(Stage__c)==&apos;VP&apos; || TEXT(Stage__c) == &apos;Country Manager&apos; || TEXT(Stage__c) == &apos;DR&apos;)),true,false),
IF(ISCHANGED( Stage__c ) &amp;&amp; (ISPICKVAL(PRIORVALUE(Stage__c), &apos;Country Manager&apos;) &amp;&amp; (TEXT(Stage__c)==&apos;VP&apos; || TEXT(Stage__c) == &apos;DR&apos;)),true,false),
IF(ISCHANGED( Stage__c ) &amp;&amp; (ISPICKVAL(PRIORVALUE(Stage__c), &apos;VP&apos;) &amp;&amp; (TEXT(Stage__c)==&apos;DR&apos;)),true,false))</errorConditionFormula>
        <errorMessage>Cannot change the stage back.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
