    <validationRules>
        <fullName>PRM_Restrict_End_Date_Prior_Start_Date</fullName>
        <active>true</active>
        <description>This is used to restrict user from entering the End date prior to the Start Date.</description>
        <errorConditionFormula>AND(
OR(
ISNEW(),
ISCHANGED(PRM_End_Date_Dt__c)
),
PRM_End_Date_Dt__c &lt;= PRM_Start_Date_Dt__c 
)</errorConditionFormula>
        <errorMessage>End Date cannot be same or prior to the Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_Restrict_Inactive_BGBA_Creation</fullName>
        <active>true</active>
        <description>Inactive Indicator cannot set while associating Benefit to a Benefit Group</description>
        <errorConditionFormula>AND ( ISNEW(), PRM_InActive_Ind__c = TRUE )</errorConditionFormula>
        <errorMessage>Inactive Indicator cannot set while associating Benefit to a Benefit Group</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_Restrict_Past_End_Date</fullName>
        <active>true</active>
        <description>This is used to restrict user from entering past End Dates.</description>
        <errorConditionFormula>AND(
OR(
ISNEW(),
ISCHANGED(PRM_End_Date_Dt__c)
),
PRM_End_Date_Dt__c &lt;= TODAY()
)</errorConditionFormula>
        <errorDisplayField>PRM_End_Date_Dt__c</errorDisplayField>
        <errorMessage>End Date cannot be less than Today&apos;s Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PRM_Restrict_Past_Start_Date</fullName>
        <active>true</active>
        <description>This is used to restrict user from entering past Start Dates</description>
        <errorConditionFormula>AND(
OR(
ISNEW(),
ISCHANGED(PRM_Start_Date_Dt__c )
),
PRM_Start_Date_Dt__c &lt; TODAY()
)</errorConditionFormula>
        <errorDisplayField>PRM_Start_Date_Dt__c</errorDisplayField>
        <errorMessage>Start Date cannot be less than Today&apos;s Date</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
