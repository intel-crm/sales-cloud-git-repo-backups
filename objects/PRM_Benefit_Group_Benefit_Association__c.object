    <fields>
        <fullName>PRM_Benefit_Group_Id__c</fullName>
        <label>Benefit Group</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>You cannot assign benefit to inactive Benefit Group</errorMessage>
            <filterItems>
                <field>PRM_Benefit_Group__c.PRM_InActive_Ind__c</field>
                <operation>equals</operation>
                <value>False</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>PRM_Benefit_Group__c</referenceTo>
        <relationshipLabel>Benefit Group Benefit Associations</relationshipLabel>
        <relationshipName>Benefit_Group_Benefit_Associations</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
