        <description>This fields determines whether the Routing Rule is Active/Inactive.</description>
        <formula>IF((TODAY() &gt;=  Pricing_Routing_Rule_Start_Dt__c &amp;&amp; TODAY() &lt;  Pricing_Routing_Rule_End_Dt__c &amp;&amp; Owner:User.IsActive == true) , true, false)</formula>
