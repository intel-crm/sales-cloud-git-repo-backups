        <columns>Pricing_EndCustomer_CSP_List_Ind__c</columns>
        <columns>Pricing_EndCust_Exclusion_List_Ind__c</columns>
        <columns>Pricing_EndCust_HighTouch_List_Ind__c</columns>
        <columns>Pricing_Is_Covered_Account_Ind__c</columns>
        <columns>Pricing_ASMO_Country__c</columns>
        <columns>Pricing_Program_Type_Nm__c</columns>
        <columns>Pricing_Routing_Output_Criteria_Nm__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>RPR-{000000}</displayFormat>
        <label>Rule Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Routing Rules</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Pricing_EndDateCannotBePast_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND( Pricing_Routing_Rule_End_Dt__c &lt; Today(), OR(ISCHANGED(Pricing_Routing_Rule_End_Dt__c), ISNEW()))</errorConditionFormula>
        <errorDisplayField>Pricing_Routing_Rule_End_Dt__c</errorDisplayField>
        <errorMessage>Pricing End Date should be today or in future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_MinMax_Quantity_Check</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
 Pricing_Overall_Quote_Quantity_Nbr__c &lt; 0,
 Pricing_Maximum_Quote_Qty_Allowed_Nbr__c &lt; 0
)</errorConditionFormula>
        <errorMessage>Total Requested Quantity and  Maximum Quantity Allowed should be greater than 0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_RouteRuleStartAnd_EndDate_Null</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
AND(
NOT(ISNEW()),
ISCHANGED(Pricing_Routing_Rule_Start_Dt__c),
ISNULL(Pricing_Routing_Rule_Start_Dt__c)
),
AND(
NOT(ISNEW()),
ISCHANGED(Pricing_Routing_Rule_End_Dt__c),
ISNULL(Pricing_Routing_Rule_End_Dt__c)
)
)</errorConditionFormula>
        <errorMessage>Routing Rule Start Date or Routing Rule End Date cannot be blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_RouteRule_EitherRPMEmailOrRPMGrp</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
    AND(NOT(ISBLANK( Pricing_Routing_RPM_Email__c )), NOT(ISBLANK( Pricing_RPM_Group_Name_Txt__c ))),
    AND(ISBLANK(Pricing_Routing_RPM_Email__c ), ISBLANK(Pricing_RPM_Group_Name_Txt__c ))
)</errorConditionFormula>
        <errorMessage>Please Provide Value for Either Pricing Manager Email or Pricing Manager Group Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_RuleEndDate_Before_RuleStartDate</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISCHANGED(Pricing_Routing_Rule_Start_Dt__c),
ISCHANGED(Pricing_Routing_Rule_End_Dt__c),
ISNEW()
),
Pricing_Routing_Rule_End_Dt__c &lt; Pricing_Routing_Rule_Start_Dt__c
)</errorConditionFormula>
        <errorDisplayField>Pricing_Routing_Rule_End_Dt__c</errorDisplayField>
        <errorMessage>Routing Rule End Date is before Routing Rule Start Date. Please enter a Routing Rule End Date that is after the Routing Rule Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_RuleStartAndEndDate_In_Past</fullName>
        <active>false</active>
        <errorConditionFormula>OR(
AND(
NOT(ISNEW()),
ISCHANGED(Pricing_Routing_Rule_Start_Dt__c),
Pricing_Routing_Rule_Start_Dt__c &lt; TODAY()
),
AND(
NOT(ISNEW()),
ISCHANGED(Pricing_Routing_Rule_End_Dt__c),
Pricing_Routing_Rule_End_Dt__c &lt; TODAY()
),
AND(
ISNEW(),
OR(
Pricing_Routing_Rule_End_Dt__c &lt; TODAY(),
Pricing_Routing_Rule_Start_Dt__c &lt; TODAY()
)
)
)</errorConditionFormula>
        <errorMessage>Either Routing Rule Start Date or Routing Rule End Date has already passed. Please ensure both dates are in the future.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
