        <description>This field will check for country Canada and United States</description>
        <formula>IF(OR(INCLUDES(Pricing_End_Customer_Country_Nm__c,&quot;Canada&quot;), INCLUDES(Pricing_End_Customer_Country_Nm__c,&quot;United States&quot;)),true, false)</formula>
