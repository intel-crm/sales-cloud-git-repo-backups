    <validationRules>
        <fullName>EOL_Solutions_EDIT</fullName>
        <active>true</active>
        <description>EOL Solutions are not allowed to edit</description>
        <errorConditionFormula>OR(
ISCHANGED(Core_Status__c) &amp;&amp; (($Profile.Name &lt;&gt; &apos;Data Ops&apos;) &amp;&amp; (NOT($Permission.Core_CRM_Special_Access))) &amp;&amp; ISPICKVAL(PRIORVALUE(Core_Status__c ), &quot;EOL&quot;),
(!ISCHANGED(Core_Status__c)) &amp;&amp; ISPICKVAL(PRIORVALUE(Core_Status__c ), &quot;EOL&quot;)
)</errorConditionFormula>
        <errorMessage>Solution is already EOL’d. Cannot make further changes.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
