    <fields>
        <fullName>Core_MDF_Batch_Class_Name_Txt__c</fullName>
        <description>Name of the batch class that needs to be executed</description>
        <externalId>false</externalId>
        <label>Batch Class Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Batch_Size_Nbr__c</fullName>
        <description>To Capture Batch Size from UI/Apex, Batch will be executed with mentioned size</description>
        <externalId>false</externalId>
        <label>Batch Size</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
