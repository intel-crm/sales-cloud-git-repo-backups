<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Setting for PSG SAP CMF Accounts</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>isDeactivated__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Set to turn off the integration with SAP for CMF Account flow</description>
        <label>isDeactivated</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Core PSG SAP Integration</label>
    <visibility>Public</visibility>
</CustomObject>
