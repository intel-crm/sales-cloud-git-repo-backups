    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>PSG_Broken_Cost_Disty_Cost_check</fullName>
        <active>false</active>
        <description>Should perform the validation to ensure Broken Cost IS NOT GREATER THAN Disty Cost.</description>
        <errorConditionFormula>AND(
    NOT($Permission.PSG_System_User),
    $Permission.PSG_Internal_Biz_Ops,
    OR(price_broken_cost_disty_amt__c &gt; price_disty_cost_amt__c,
       price_broken_cost_disty_amt__c = price_disty_cost_amt__c
       )
    
)</errorConditionFormula>
        <errorMessage>Broken Cost $ should not be more than Disty Cost $</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Negative_Value_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Permission.PSG_System_User),
OR(
   core_cpq_approved_qty_nbr__c  &lt; 0,
   core_cpq_claimed_qty_nbr__c &lt; 0,
   core_cpq_lower_bound_qty_nbr__c &lt; 0,
   core_cpq_quoted_qty_nbr__c &lt; 0,
   core_cpq_requested_qty_nbr__c &lt; 0,
   core_cpq_upper_bound_qty_nbr__c &lt; 0,
   price_disty_cost_amt__c &lt; 0,
   core_list_unit_price__c &lt; 0,
   core_cpq_resale_amt__c &lt; 0,
   price_broken_cost_disty_amt__c &lt; 0,
   core_cpq_disty_margin_pct__c &lt; 0
)
)</errorConditionFormula>
        <errorMessage>Pricing and Qty attributes cannot have negative values</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Restrict_DPA_ALN_Line_Edit</fullName>
        <active>false</active>
        <description>It restricts users from creating new record and editing existing records during freeze period.</description>
        <errorConditionFormula>OR(
     ISNEW() ,
     !ISNULL( PRIORVALUE(Id) )
   )</errorConditionFormula>
        <errorMessage>DPA &amp; ALN Line Record cannot be created or edited during Freeze Period!</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
