    </fields>
    <fields>
        <fullName>core_cpq_DM_Validity_Check__c</fullName>
        <formula>IF(
NOT(ISBLANK(core_cpq_distributor_margin__c)),
NOT(
OR(
core_cpq_distributor_margin__r.core_cpq_end_date__c &lt;TODAY(),
core_cpq_distributor_margin__r.core_cpq_Effective_Date_Dt__c &gt;TODAY(),
core_cpq_distributor_margin__r.core_cpq_Active_Cb__c=false,
core_cpq_Config_Disty_Margin__c &lt;&gt; core_cpq_distributor_margin__r.core_cpq_Disty_Margin_Pct__c ,
TEXT(core_cpq_distributor_margin_type__c) &lt;&gt; TEXT(core_cpq_distributor_margin__r.core_cpq_dm_type__c),
AND(
NOT(ISBLANK(core_cpq_prid__c)), 
core_cpq_prid__r.core_cpq_prid_validity_date_dt__c&lt;TODAY(),
ISPICKVAL( core_cpq_distributor_margin__r.core_cpq_dm_type__c,&quot;Hunter&quot;)
),NOT(
CONTAINS(core_cpq_cis_no_nbr__r.core_cpq_account_program__c, TEXT(core_cpq_distributor_margin__r.core_cpq_Partner_Program_Txt__c))
),
core_cpq_cis_no_nbr__r.core_cpq_active_quote__r.SBQQ__PriceBook__c &lt;&gt; core_cpq_distributor_margin__r.core_cpq_Price_Book__c,
NOT( CONTAINS(core_cpq_cis_no_nbr__r.core_cpq_account_tier__c,TEXT(core_cpq_distributor_margin__r.core_cpq_Account_Tier_Txt__c))
), 
TEXT(core_cpq_cis_no_nbr__r.core_cpq_active_quote__r.core_cpq_margin_geo_txt__c)&lt;&gt;TEXT(core_cpq_distributor_margin__r.core_cpq_Margin_GEO_Txt__c),
core_cpq_distributor_margin__r.core_cpq_Registered_Product_Txt__c&lt;&gt;core_cpq_quote_item_line_no__r.core_cpq_registerable_flag__c,
OR(
AND(OR(core_cpq_registration_status_txt__c =&apos;Approved&apos;,NOT(ISBLANK(core_cpq_master_ddr__c ))
)
,NOT(ISPICKVAL(core_cpq_distributor_margin__r.core_cpq_Approved_Registration_Txt__c, &apos;Yes&apos;))),
AND(AND(core_cpq_registration_status_txt__c &lt;&gt; &apos;Approved&apos;,ISBLANK(core_cpq_master_ddr__c )
)
,ISPICKVAL(core_cpq_distributor_margin__r.core_cpq_Approved_Registration_Txt__c, &apos;Yes&apos;))
),AND(core_cpq_distributor_margin__r.core_cpq_product_family_txt__c &lt;&gt; null, core_cpq_device_nm__r.Core_Product_Family__c &lt;&gt; core_cpq_distributor_margin__r.core_cpq_product_family_txt__c )
)),true
)</formula>
        <label>DM Validity Check</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>core_cpq_DPA_ALN_Line_BC_Check__c</fullName>
        <description>This field is used for DPA/ALN lines broken cost checks fallouts</description>
        <externalId>false</externalId>
        <formula>(IF(ROUND((core_cpq_resale_amt__c - (core_cpq_resale_amt__c * core_cpq_disty_margin_pct__c )),2)== price_broken_cost_disty_amt__c , 0,IF( ABS(ROUND((core_cpq_resale_amt__c - (core_cpq_resale_amt__c * core_cpq_disty_margin_pct__c )),2)- price_broken_cost_disty_amt__c )==0.01, 0, 1)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>DPA/ALN Line BC Check</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
