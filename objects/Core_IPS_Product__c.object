    <fields>
        <fullName>Core_Supported_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Preventing PAR Hidden Or EOIS Products from being selected on Project</description>
        <label>Supported Product</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Core_IPS_Supported_Product__c.Core_Product__c</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <infoMessage>1. Please select All fields radio button for proper search
2. Do not select EOIS or PAR Hidden products.</infoMessage>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Core_IPS_Supported_Product__c</referenceTo>
        <relationshipLabel>Premier Support Project Products</relationshipLabel>
        <relationshipName>IPS_Products</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
