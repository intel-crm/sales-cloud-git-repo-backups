    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_IPS_PreventParHidden</fullName>
        <active>false</active>
        <description>This is to prevent PAR Hidden type Supported Products from being added</description>
        <errorConditionFormula>OR(ISPICKVAL(Core_Supported_Product__r.Core_Flag_Status__c, &quot;Par Hidden&quot;),  Core_Supported_Product__r.Core_EOIS__c )</errorConditionFormula>
        <errorMessage>Cannot Add Par Hidden or EOIS Type Supported Product</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_PreventProductLookupChange</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED(Core_Supported_Product__c)</errorConditionFormula>
        <errorMessage>Changes to Supported Product Lookup are not allowed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_IPS_Prevent_ParHidden_and_EOIS</fullName>
        <active>true</active>
        <description>This is to prevent PAR Hidden type Supported Products from being added</description>
        <errorConditionFormula>OR(
	AND(
		ISPICKVAL( Core_IPS_Product_Status__c , &quot;Active&quot;),
		ISPICKVAL(Core_Supported_Product__r.Core_Flag_Status__c, &quot;Par Hidden&quot;), 
		$Profile.Name &lt;&gt; $Label.Core_IPS_Interested_Parties_Internal_Admin,
		$Profile.Name &lt;&gt; $Label.Core_IPS_Interested_Parties_Internal_Agent,
		$Profile.Name &lt;&gt; $Label.Core_IPS_Agent_Enhanced_Profile,
		$Profile.Name &lt;&gt; $Label.Core_IPS_Partner_AE_ProfileName,
		$Profile.Name &lt;&gt; $Label.Core_IPS_External_Customer_Profile,
		$Profile.Name &lt;&gt; $Label.Core_IPS_Partner_Profile_Name,
		$Profile.Name &lt;&gt; $Label.Core_IPS_System_Admin_Profile_Name,
		$Profile.Name &lt;&gt; $Label.Core_IPS_IT_Admin_Profile ,
		$Profile.Name &lt;&gt; $Label.Core_IPS_Production_Support_IPS_Profile,
		$Profile.Name &lt;&gt; $Label.Core_IPS_Data_Migration_Profile_Name			
	), 
	AND(
		ISPICKVAL( Core_IPS_Product_Status__c , &quot;Active&quot;), 
		Core_Supported_Product__r.Core_EOIS__c = TRUE,
		$Profile.Name &lt;&gt; $Label.Core_IPS_Data_Migration_Profile_Name
	)
)</errorConditionFormula>
        <errorMessage>Cannot Add Par Hidden Type Supported Product or EOIS type Supported Products</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IPS_Altera_Go_Live_Project_Restriction</fullName>
        <active>true</active>
        <description>Restricting the user to add Altera Products on an existing Project during migration</description>
        <errorConditionFormula>AND($Label.IPS_Altera_Go_Live= &apos;True&apos;,Core_Supported_Product__r.Core_Support_Org_Name__c = &apos;Programmable Solutions Group&apos;,  $User.Id  &lt;&gt;  $Label.Altera_Bypass_UserId )</errorConditionFormula>
        <errorMessage>Not allowed to create or update record related to Org 025</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Add_default_case_owner</fullName>
        <availability>online</availability>
        <description>Custom button that adds default case owner for a project product</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Add / Remove Default Case Owner</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&apos;/support/console/41.0/integration.js&apos;)}
if(sforce.console.isInConsole()){ //Checks that it is in console
window.open(&quot;apex/Core_IPS_AddDefaultCaseOwner?isdtp=vw&amp;productId={!Core_IPS_Product__c.Id}&quot;,&apos;_self&apos;);
}else{
window.open(&quot;/apex/Core_IPS_AddDefaultCaseOwner?productId={!Core_IPS_Product__c.Id}&quot;,&apos;_self&apos;);
}</url>
    </webLinks>
</CustomObject>
