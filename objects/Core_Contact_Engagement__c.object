        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Engagement__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Engagement</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR 2</booleanFilter>
            <errorMessage>Engagement selected is not available for edit in Salesforce.</errorMessage>
            <filterItems>
                <field>Core_Engagement__c.Core_Editable__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>$Profile.Name</field>
                <operation>equals</operation>
                <value>Integration</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Core_Engagement__c</referenceTo>
        <relationshipLabel>Contact Engagements</relationshipLabel>
        <relationshipName>Contact_Engagements</relationshipName>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_ExtId__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <label>ExtId</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <label>Contact Engagement</label>
    <nameField>
        <displayFormat>CE-{000000000}</displayFormat>
        <label>Contact Engagement Id</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Contact Engagements</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>DisableEdit</fullName>
        <active>true</active>
        <errorConditionFormula>AND (NOT( ISNEW() ), ISCHANGED(Core_Engagement__c) , $Profile.Name != &quot;Integration&quot;)</errorConditionFormula>
        <errorDisplayField>Core_Active__c</errorDisplayField>
        <errorMessage>Engagement cannot be changed.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
