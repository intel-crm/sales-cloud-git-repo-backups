<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>This custom setting hosts the list of Entitlements which enable B2B flag on Contact and Account once assigned</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Entitlement_Display_Name__c</fullName>
        <externalId>false</externalId>
        <label>Entitlement Display Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <defaultValue>true</defaultValue>
        <label>IsActive</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>B2B Flag Entitlements</label>
    <visibility>Public</visibility>
</CustomObject>
