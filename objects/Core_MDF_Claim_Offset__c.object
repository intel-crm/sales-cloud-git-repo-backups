    <fields>
        <fullName>Core_MDF_Adjustment_Claim_Nbr__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Unique identifier of Claim created based on the Adjustment Request</description>
        <inlineHelpText>Unique identifier of Claim created based on the Adjustment Request</inlineHelpText>
        <label>Adjustment Claim Name</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>Claim Offsets (Adjustment Claim)</relationshipLabel>
        <relationshipName>Claim_Offset</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_CreatedBy_Nm__c</fullName>
        <description>Shows the name for external user if created by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF (
ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;),
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Last_ModifiedBy_Nm__c</fullName>
        <description>Shows the name for external user if modified by is external otherwise Intel System User</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(LastModifiedBy.Profile.UserType,&apos;PowerPartner&apos;),
LastModifiedBy.FirstName &amp; &apos; &apos; &amp; LastModifiedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Last Modified By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Offset_Amount_Amt__c</fullName>
        <description>The Amount in US Dollars that was used to offset a Claim</description>
        <inlineHelpText>The Amount in US Dollars that was used to offset a Claim</inlineHelpText>
        <label>Offset Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Offset_Claim_Nbr__c</fullName>
        <description>The Claim that was offset by an Adjustment Claim</description>
        <inlineHelpText>The Claim that was offset by an Adjustment Claim</inlineHelpText>
        <label>Offset Claim Name</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>Claim Offsets</relationshipLabel>
        <relationshipName>Claim_Offsets</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Sub_Claim_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Sub Claim</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>Claim Offsets (Sub Claim)</relationshipLabel>
        <relationshipName>Claim_Offsets1</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Partner_Marketing_Budget__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Partner Marketing Budget</label>
        <referenceTo>PartnerMarketingBudget</referenceTo>
        <relationshipLabel>Claim Offsets</relationshipLabel>
