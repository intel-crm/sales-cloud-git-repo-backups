    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Forecasting Products quantity.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_Core_FC_Appvd_SalesPrice__c</fullName>
        <label>Forecast Approved Sales Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_FC_4Q_Shed_Quantity__c</fullName>
        <externalId>false</externalId>
        <label>4Q Shed Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_FC_4Q_Shed_Revenue__c</fullName>
        <description>Stores the total Revenue for one forecast product</description>
        <label>4Q Shed Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_FC_BU_Product_Segment__c</fullName>
        <externalId>false</externalId>
        <label>BU Product Segment</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_FC_BU_Short_Name__c</fullName>
        <externalId>false</externalId>
        <label>BU Short Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_FC_Last_Modified_Date__c</fullName>
        <description>Stores the latest last modified date for a group of records having same Opportunity Line Item</description>
        <label>Forecast Last Modified Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_FC_OppStage__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Core_Opp_FC_Opportunity__r.StageName)</formula>
        <label>Opportunity Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_FC_Vendor__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Vendor</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Forecast Product Schedules</relationshipLabel>
        <relationshipName>Forecast_Product_Schedules</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Forecast_Old_Claim_Date__c</fullName>
        <label>Forecast Old Claim Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Approval_Manager__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Forecast Approval Manager</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Forecast_Product_Schedules_Manager</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Approval_Status__c</fullName>
        <label>Forecast Approval Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Submitted</fullName>
                    <default>false</default>
                    <label>Submitted</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Approved_By__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Captures the Manager/Delegated approver details who approved the 6QPS record.</description>
        <label>Forecast Approved By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Forecast_Product_Schedules</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Approved_Date__c</fullName>
        <description>Stamping the date when the record was approved</description>
        <label>Forecast Approved Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Claim_Date__c</fullName>
        <description>Captures the date when the 6QPS is submitted for approval and if the manager rejects it will be cleared out.</description>
        <label>Forecast Claim Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Delegated_Approver__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Forecast Delegated Approver</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Forecast_Product_Schedules_Delegate</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Opportunity__c</fullName>
        <description>Master detail with Opportunity object</description>
        <label>Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Forecast Product Schedules</relationshipLabel>
        <relationshipName>Forecast_Product_Schedules</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Prod_Sales_Price__c</fullName>
        <label>Forecast Product Sales Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Product</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Forecast Product Schedules</relationshipLabel>
        <relationshipName>Forecast_Product_Schedules</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Quantity__c</fullName>
        <defaultValue>0000</defaultValue>
        <description>Capture the Forecasted Quantity</description>
        <externalId>false</externalId>
        <label>Forecast Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Quarter_Date__c</fullName>
        <label>Forecast Quarter Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Quarter__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(YEAR(Core_Opp_FC_Quarter_Date__c)) &amp; &quot;-Q&quot; &amp; TEXT(CASE(MONTH(Core_Opp_FC_Quarter_Date__c),
1, 1,
2, 1,
3, 1,
4, 2,
5, 2,
6, 2,
7, 3,
8, 3,
9, 3,
10, 4,
11, 4,
12, 4,
0))</formula>
        <label>Forecast Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Rejected_By__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Forecast Rejected By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Forecast_Rejected_By</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Rejected_Date__c</fullName>
        <label>Forecast Rejected Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_Sched_Revenue__c</fullName>
        <description>Calculates the Revenue by multiplying the Forecast Product Sales Price with Forecast Quantity</description>
        <formula>IF( NOT(ISNULL(Core_Core_FC_Appvd_SalesPrice__c)),  Core_Opp_FC_Prod_Sales_Price__c * Core_Opp_FC_Quantity__c,  Core_Core_FC_Appvd_SalesPrice__c * Core_Opp_FC_Quantity__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Forecast Scheduled Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_isTaskCreated__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Checked if the task is created upon submission for approval</description>
        <label>Forecast Is Task Created</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opp_FC_isdeleted__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Forecast Is Hidden</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Opp_Line_Item_RecordID__c</fullName>
        <description>Stores the record Id of the associated Opportunity Line Item on the Opportunity for the given Product.</description>
        <externalId>true</externalId>
        <label>Opportunity Line Item RecordID</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Forecast Product Schedule</label>
    <nameField>
        <displayFormat>FPS{0000000000}</displayFormat>
        <label>Forecast Product Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Forecast Product Schedules</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
