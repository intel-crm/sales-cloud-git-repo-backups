    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>For support purposes, relate inbound and outbound messages to the contact to be viewed in a related list</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>false</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>false</enableSharing>
    <enableStreamingApi>false</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Contact__c</fullName>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Contact Messages</relationshipLabel>
        <relationshipName>Contact_Messages</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_Inbound_Message_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
AND(
NOT(ISBLANK(Inbound_Message__c)), 
(Outbound_Message__r.Core_MessageType__c = &quot;Role 2.0&quot;) 
),
TEXT(Inbound_Message__r.Core_Processing_Status__c),
NULL
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Inbound Message Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Message_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(Inbound_Message__c)),
  TEXT(Inbound_Message__r.Core_Message_Type__c),
  Outbound_Message__r.Core_MessageType__c
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Message Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Inbound_Message__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Inbound Message</label>
        <referenceTo>Core_Integration_Inbound_Message__c</referenceTo>
        <relationshipLabel>Contact Messages</relationshipLabel>
        <relationshipName>Contact_Messages</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Outbound_Message__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Outbound Message</label>
        <referenceTo>Core_Integration_Outbound_Message__c</referenceTo>
        <relationshipLabel>Contact Messages</relationshipLabel>
        <relationshipName>Contact_Messages</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Contact Message</label>
    <nameField>
        <displayFormat>CM-{00000000}</displayFormat>
        <label>Contact Message ID</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Contact Messages</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
