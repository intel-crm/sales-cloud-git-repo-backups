    <fields>
        <fullName>Account__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot; &amp; Opportunity__r.AccountId,Opportunity__r.Account.Name)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Approved_By__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Approved By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Core_IPS_Opportunity_PAR</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Account_Name__c</fullName>
        <description>To display Opportunity&apos;s Account Name field in Email template</description>
        <externalId>false</externalId>
        <formula>Opportunity__r.Account.Name</formula>
        <label>Account Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Account_Region__c</fullName>
        <description>To display opportunity&apos;s Region field of Account</description>
        <externalId>false</externalId>
        <formula>TEXT(Opportunity__r.Account.Core_Geo__c)</formula>
        <label>Account Region</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Account_Sub_Region__c</fullName>
        <description>To display opportunity&apos;s Sub Region field of Account</description>
        <externalId>false</externalId>
        <formula>TEXT(Opportunity__r.Account.Core_Sub_Geo__c)</formula>
        <label>Account Sub Region</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_AddNewProject__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This will create new project</description>
        <label>Add New Project</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Approval_Status__c</fullName>
        <label>Approval Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
