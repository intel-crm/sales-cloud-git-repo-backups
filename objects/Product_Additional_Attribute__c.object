    <validationRules>
        <fullName>Is_Product_Selected_Correct</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISCHANGED(Product_Add_on_Configuration__c),00NDf00000QM82N.00NDf00000QM84d = FALSE,  
NOT(ISBLANK(Product_Add_on_Configuration__c )), 
OR ( 00NDf00000QM82N.00NDf00000QM80R &gt; TODAY(),  00NDf00000QM82N.00NDf00000QM80W &lt;= TODAY()))</errorConditionFormula>
        <errorMessage>Please choose a different Product as it is not available anymore</errorMessage>
    </validationRules>
