                </value>
                <value>
                    <fullName>CIM Dup Failure</fullName>
                    <default>false</default>
                    <label>CIM Dup Failure</label>
                </value>
                <value>
                    <fullName>OPID Inbound Failure</fullName>
                    <default>false</default>
                    <label>OPID Inbound Failure</label>
                </value>
                <value>
                    <fullName>OPID Not Received</fullName>
                    <default>false</default>
                    <label>OPID Not Received</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
