    <webLinks>
        <fullName>Core_IPS_Reprocess_Failed_CasePromotes</fullName>
        <availability>online</availability>
        <description>This button upon click will reprocess the failed promotes/updates captured by the selected log entries.</description>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Reprocess Failed IPSCasePromotes</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/54.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/54.0/apex.js&quot;)}
var records = {!GETRECORDIDS($ObjectType.Core_Log_Entry__c)}; 
var res; var resstring;
if(records.length&lt;1) { res=confirm(&quot;Are you sure to continue without selecting any records? The records will be selected using the custom date range.&quot;);
} else { res=confirm(&quot;Selected records will be reprocessed&quot;);}
if(res==true){ ressrting=sforce.apex.execute(&quot;Core_IPS_Reprocess_Backend_FailedRecords&quot;, &quot;reProcessRecords&quot;,{logEntries:records}); alert(&apos;Processing completed&apos;);}
document.getElementsByName(&apos;fcf&apos;).item(0).onchange();</url>
    </webLinks>
</CustomObject>
