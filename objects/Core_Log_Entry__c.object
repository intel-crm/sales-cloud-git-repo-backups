    <fields>
        <fullName>File_Name__c</fullName>
        <description>This Formula filed calculates the Created date as string with MMDDYYYY</description>
        <externalId>false</externalId>
        <formula>IF(MONTH(DATEVALUE(CreatedDate)) &lt; 10, &apos;0&apos;+TEXT(MONTH(DATEVALUE(CreatedDate))), TEXT(MONTH(DATEVALUE(CreatedDate))) )
&amp;&quot;&quot;&amp;
IF(DAY(DATEVALUE(CreatedDate)) &lt; 10, &apos;0&apos;+TEXT(DAY(DATEVALUE(CreatedDate))), TEXT(DAY(DATEVALUE(CreatedDate))) )
&amp;&quot;&quot;&amp;
TEXT(YEAR(DATEVALUE(CreatedDate)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>File Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Review_Status__c</fullName>
        <label>Review Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Reviewed</fullName>
                    <default>false</default>
                    <label>Reviewed</label>
                </value>
                <value>
                    <fullName>Investigating</fullName>
                    <default>false</default>
                    <label>Investigating</label>
                </value>
                <value>
                    <fullName>Closed</fullName>
                    <default>false</default>
                    <label>Closed</label>
                </value>
                <value>
                    <fullName>Fixed</fullName>
                    <default>false</default>
                    <label>Fixed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
