    <sharingModel>Read</sharingModel>
    <validationRules>
        <fullName>Core_MDF_HostRegionVal_ForAgencyAcounts</fullName>
        <active>true</active>
        <description>Host Region is not applicable for Agency accounts</description>
        <errorConditionFormula>AND(TEXT(Core_MDF_Type__c)= $CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_AgencyAccount.Core_MDF_Value_Txt__c ,NOT(ISBLANK(TEXT( Core_MDF_Host_Region_nm__c))))</errorConditionFormula>
        <errorMessage>Host Region is not applicable for Agency Accounts</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_HostRegionVal_OtherPrograms</fullName>
        <active>true</active>
        <description>Host Region is applicable only for IPA Program. So, this validation rule is to restrict for other programs.</description>
        <errorConditionFormula>AND(NOT(ISBLANK( TEXT(Core_MDF_Host_Region_nm__c))), NOT(TEXT(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c)=$Label.Core_MDF_IPA_Program_Name))</errorConditionFormula>
        <errorMessage>Host Region is only applicable for Intel Partner Alliance Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND((TEXT(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c)==&apos;Intel Partner Alliance&apos;),  NOT( ISBLANK(Core_MDF_Domains_txt__c) ))</errorConditionFormula>
        <errorMessage>Domains are not applicable for the selected program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_HostRegionCheck</fullName>
        <active>true</active>
        <description>Host Region is mandatory for IPA Program</description>
        <errorConditionFormula>AND(TEXT( Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c)=$Label.Core_MDF_IPA_Program_Name, TEXT(Core_MDF_Type__c) =  $CustomMetadata.Core_MDF_Custom_Label_Configration__mdt.Core_MDF_IntelAccount.Core_MDF_Value_Txt__c, ISBLANK(TEXT( Core_MDF_Host_Region_nm__c)))</errorConditionFormula>
        <errorMessage>Host Region is mandatory for Intel Partner Alliance Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_PaymentTypeCheck</fullName>
        <active>true</active>
        <description>Selected Payment Type is only applicable for Intel Partner Alliance Program and Ecosystem Extension Fund.</description>
        <errorConditionFormula>AND(NOT(OR(TEXT(Core_MDF_Technical_Program_nm__c)==$Label.Core_MDF_IPA_Program_Name,TEXT(Core_MDF_Technical_Program_nm__c)==$Label.Core_MDF_EEF_Program_Name,TEXT(Core_MDF_Technical_Program_nm__c)==$Label.Core_MDF_Co_GTM_Technical_program_name)),
OR(TEXT(Core_MDF_Payment_Type_nm__c )== &apos;Distributor (Cash)&apos;,TEXT(Core_MDF_Payment_Type_nm__c )== &apos;Distributor (Credit Memo)&apos;,TEXT(Core_MDF_Payment_Type_nm__c )== &apos;Customer (Pass Through)&apos;))</errorConditionFormula>
        <errorMessage>Payment Type is only applicable for Intel Partner Alliance Program and Ecosystem Extension Fund.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_RetailValidation</fullName>
        <active>true</active>
        <errorConditionFormula>If( (TEXT(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c)== &apos;Retail Marketing Funds&apos; ||  TEXT(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c)==&apos;Intel Partner Alliance&apos;)&amp;&amp; TEXT(Core_MDF_Type__c )==&apos;Agency Account&apos;, true,false)</errorConditionFormula>
        <errorMessage>Agency account type is not applicable for the selected program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RestrictAccountOnboardEdit</fullName>
        <active>true</active>
        <description>Blocking editing of account onboarding records</description>
        <errorConditionFormula>OR(ISCHANGED( Core_MDF_Account__c ),
ISCHANGED( Core_MDF_Channel_Program__c ),
ISCHANGED( Core_MDF_Type__c ),
ISCHANGED( Core_MDF_Virtual_Account_Name_txt__c ),
ISCHANGED( Core_MDF_SubParent_Account_to_be_Created__c ),
ISCHANGED( Core_MDF_Works_For__c ),
ISCHANGED( Core_MDF_Domains_txt__c ),
ISCHANGED( Core_MDF_Payment_Type_nm__c ), ISCHANGED( Core_MDF_Host_Region_nm__c ))</errorConditionFormula>
        <errorMessage>Account onboarding record cannot be edited</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
