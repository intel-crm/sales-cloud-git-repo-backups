    <fields>
        <fullName>Core_MDF_Scheduler_Status_Txt__c</fullName>
        <description>Update Parent Scheduler status based on child status</description>
        <externalId>false</externalId>
        <formula>IF( Core_MDF_Line_Items_Count_Nbr__c = 0,&apos;&apos;,
IF(Core_MDF_Inactive__c = true,&apos;Cancelled&apos;,
IF(Core_MDF_No_of_Pending_Jobs_Nbr__c &gt;0, &apos;Pending&apos;,
IF(Core_MDF_No_of_Scheduled_Jobs_Nbr__c &gt;0, &apos;Scheduled&apos;,
IF( Core_MDF_Completed_Item_Count_Nbr__c &gt;0,&apos;Finished&apos;,&apos;Failed&apos;)))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Scheduler Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Status_Txt__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Scheduled</fullName>
                    <default>true</default>
                    <label>Scheduled</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Time__c</fullName>
        <description>Dependent on &quot;Daily&quot; and &quot;Days of Week&quot; ; To capture what time of day job will be executed</description>
        <label>Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Time</type>
    </fields>
    <fields>
        <fullName>Scheduled_Time_Dt__c</fullName>
        <description>Dependent on &quot;Once&quot; ; To capture the time of one time job</description>
        <label>Scheduled Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <label>Batch Scheduler</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Program_Txt__c</columns>
        <columns>Core_MDF_Batch_Class_Name_Txt__c</columns>
        <columns>Core_MDF_Batch_Size_Nbr__c</columns>
        <columns>Core_MDF_Job_Frequency__c</columns>
        <columns>Core_MDF_Priority__c</columns>
        <columns>Core_MDF_Scheduler_Status_Txt__c</columns>
        <columns>Core_MDF_Object_JSON_Txt__c</columns>
        <columns>Core_MDF_Inactive__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Completed_Batches</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Batch_Class_Name_Txt__c</columns>
        <columns>Core_MDF_Scheduler_Status_Txt__c</columns>
        <columns>Core_MDF_Batch_Size_Nbr__c</columns>
        <columns>Core_MDF_Job_Frequency__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Scheduler_Status_Txt__c</field>
            <operation>equals</operation>
            <value>Failed,Finished</value>
        </filters>
        <label>Completed Batches</label>
    </listViews>
    <listViews>
        <fullName>Pending_Batches</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Batch_Class_Name_Txt__c</columns>
        <columns>Core_MDF_Scheduler_Status_Txt__c</columns>
        <columns>Core_MDF_Batch_Size_Nbr__c</columns>
        <columns>Core_MDF_Job_Frequency__c</columns>
        <columns>Core_MDF_Next_Batch_Run_Time_Txt__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Scheduler_Status_Txt__c</field>
            <operation>equals</operation>
            <value>Pending</value>
        </filters>
        <label>Pending Batches</label>
    </listViews>
    <listViews>
        <fullName>Scheduled_Batches</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Batch_Class_Name_Txt__c</columns>
        <columns>Core_MDF_Scheduler_Status_Txt__c</columns>
        <columns>Core_MDF_Batch_Size_Nbr__c</columns>
        <columns>Core_MDF_Job_Frequency__c</columns>
        <columns>Core_MDF_Next_Batch_Run_Time_Txt__c</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>Core_MDF_Program_Txt__c</columns>
        <columns>Core_MDF_Status_Txt__c</columns>
        <columns>Scheduled_Time_Dt__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Scheduler_Status_Txt__c</field>
            <operation>equals</operation>
            <value>Scheduled</value>
        </filters>
        <label>Scheduled Batches</label>
    </listViews>
    <nameField>
        <displayFormat>Sch-{0000}</displayFormat>
        <label>Batch Scheduler Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Batch Scheduler</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Core_MDF_Program_Txt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Batch_Class_Name_Txt__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Batch_Size_Nbr__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Job_Frequency__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Priority__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_MDF_Scheduler_Status_Txt__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_End_Date_Greater_Than_Next_Run</fullName>
        <active>true</active>
        <description>End date should be greater than Next batch run time</description>
        <errorConditionFormula>AND( ISCHANGED( Core_MDF_Effective_End_Time_Dt__c ) , Core_MDF_Effective_End_Time_Dt__c  &lt;  Core_MDF_Next_Batch_Run_Time_Txt__c )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Effective_End_Time_Dt__c</errorDisplayField>
        <errorMessage>Please select an End date greater than Next run time.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Batch_Class_Name_Edit</fullName>
        <active>true</active>
        <description>Batch class name can&apos;t be changed</description>
        <errorConditionFormula>ISCHANGED(Core_MDF_Batch_Class_Name_Txt__c)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Batch_Class_Name_Txt__c</errorDisplayField>
        <errorMessage>Batch class cannot be changed. Please create a new job.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Batch_Size</fullName>
        <active>true</active>
        <description>batch size cannot exceed 200</description>
        <errorConditionFormula>OR(Core_MDF_Batch_Size_Nbr__c &gt;200, Core_MDF_Batch_Size_Nbr__c&lt;=0)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Batch_Size_Nbr__c</errorDisplayField>
        <errorMessage>Please enter a valid Batch size between 1 to 200</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Edit_Based_On_Status</fullName>
        <active>true</active>
        <description>Edit not allowed when Scheduler status is Finished/Failed/Cancelled</description>
        <errorConditionFormula>AND(OR( PRIORVALUE(Core_MDF_Scheduler_Status_Txt__c )   = &quot;Cancelled&quot;, PRIORVALUE(Core_MDF_Scheduler_Status_Txt__c ) = &quot;Finished&quot;, PRIORVALUE(Core_MDF_Scheduler_Status_Txt__c ) = &quot;Failed&quot; ), NOT(OR( ISCHANGED(  Core_MDF_No_of_Scheduled_Jobs_Nbr__c  ), ISCHANGED(   Core_MDF_No_of_Pending_Jobs_Nbr__c   ),ISCHANGED(   Core_MDF_Completed_Item_Count_Nbr__c ))))</errorConditionFormula>
        <errorMessage>Batch Schedule cannot be edited in current status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Frequency_Change</fullName>
        <active>true</active>
        <description>Frequency once selected cannot be changed. Create a new job instead.</description>
        <errorConditionFormula>OR(ISCHANGED( Core_MDF_Job_Frequency__c ),ISCHANGED(  Core_MDF_Every_X_Hour_Nbr__c  ),ISCHANGED(  Core_MDF_Every_X_Minute_Nbr__c  ),ISCHANGED(  Core_MDF_Days_of_Week__c  ),ISCHANGED(  Scheduled_Time_Dt__c  ),ISCHANGED(Core_MDF_Time__c   ))</errorConditionFormula>
        <errorMessage>Batch Schedule Frequency cannot be modified. Please Create a new job.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Inactive_Checkbox_Edit</fullName>
        <active>true</active>
        <description>Inactive checkbox is editable only when status is scheduled</description>
        <errorConditionFormula>AND( PRIORVALUE(Core_MDF_Scheduler_Status_Txt__c)  &lt;&gt; &apos;Scheduled&apos; , ISCHANGED( Core_MDF_Inactive__c ) )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Inactive__c</errorDisplayField>
        <errorMessage>Batch Schedule cannot be cancelled in current status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Scheduler_Time</fullName>
        <active>true</active>
        <description>scheduler time cannot be in past</description>
        <errorConditionFormula>AND(ISNEW(),  ISPICKVAL(Core_MDF_Job_Frequency__c, &apos;Once&apos;) ,Scheduled_Time_Dt__c  &lt;   NOW())</errorConditionFormula>
        <errorDisplayField>Scheduled_Time_Dt__c</errorDisplayField>
        <errorMessage>Scheduled time cannot be in past</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Start_Date_Change</fullName>
        <active>true</active>
        <description>Start date can&apos;t be changed</description>
        <errorConditionFormula>ISCHANGED( Core_MDF_Effective_Start_Time_Dt__c )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Effective_Start_Time_Dt__c</errorDisplayField>
        <errorMessage>Batch Schedule Start date cannot be modified. Please create a new job.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Start_date</fullName>
        <active>true</active>
        <description>start date cannot be in past</description>
        <errorConditionFormula>AND(ISNEW(),NOT( ISPICKVAL(Core_MDF_Job_Frequency__c, &apos;Once&apos;)), Core_MDF_Effective_Start_Time_Dt__c &lt; Now())</errorConditionFormula>
        <errorDisplayField>Core_MDF_Effective_Start_Time_Dt__c</errorDisplayField>
        <errorMessage>Effective Start Time cannot be in past</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Time_Change</fullName>
        <active>false</active>
        <description>time cannot be changed</description>
        <errorConditionFormula>ISCHANGED( Core_MDF_Time__c )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Time__c</errorDisplayField>
        <errorMessage>Batch Schedule Time cannot be modified. Please create a new job.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Start_Date_Less_Than_End_Date</fullName>
        <active>true</active>
        <description>End date cannot be less than start date</description>
        <errorConditionFormula>Core_MDF_Effective_End_Time_Dt__c  &lt;  Core_MDF_Effective_Start_Time_Dt__c</errorConditionFormula>
        <errorMessage>Please select an End date greater than Start date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>To_allow_only_Once_option_for_Job_Freq</fullName>
        <active>false</active>
        <description>Validation to allow only Once option for Job Frequency until other features are enabled</description>
        <errorConditionFormula>OR(ISPICKVAL(Core_MDF_Job_Frequency__c, &apos;Every X Minute&apos;),
ISPICKVAL(Core_MDF_Job_Frequency__c, &apos;Every X Hour&apos;),
ISPICKVAL(Core_MDF_Job_Frequency__c, &apos;Daily&apos;),
ISPICKVAL(Core_MDF_Job_Frequency__c, &apos;Days of Week&apos;))</errorConditionFormula>
        <errorMessage>This is feature is not available at the moment. The Job frequency can be set to only Once.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
