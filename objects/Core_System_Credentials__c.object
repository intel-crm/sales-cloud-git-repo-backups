<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Holds the credentials required for various integration pieces.</description>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Core_End_Point_URL__c</fullName>
        <description>This field is for storing the end point urls for the different integrations.</description>
        <externalId>false</externalId>
        <label>End Point URL</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Password__c</fullName>
        <externalId>false</externalId>
        <label>Password</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_UserName__c</fullName>
        <externalId>false</externalId>
        <label>UserName</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>System Credentials</label>
    <listViews>
        <fullName>All_System_Credentials</fullName>
        <columns>NAME</columns>
        <columns>Core_End_Point_URL__c</columns>
        <columns>UPDATEDBY_USER</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <label>All System Credentials</label>
    </listViews>
    <visibility>Public</visibility>
</CustomObject>
