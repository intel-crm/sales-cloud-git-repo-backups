    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>To capture Event and Non Event Feedbacks</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ReadWrite</externalSharingModel>
    <fields>
        <fullName>Application__c</fullName>
        <label>Application</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>PSG Quoting</fullName>
                    <default>false</default>
                    <label>PSG Quoting</label>
                </value>
                <value>
                    <fullName>PSG Licensing</fullName>
                    <default>false</default>
                    <label>PSG Licensing</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Capability__c</fullName>
        <description>To store Capability of Feedback</description>
        <label>Capability</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Generate License</fullName>
                    <default>false</default>
                    <label>Generate License</label>
                </value>
                <value>
                    <fullName>Split Seats</fullName>
                    <default>false</default>
                    <label>Split Seats</label>
                </value>
                <value>
                    <fullName>New License Request</fullName>
                    <default>false</default>
                    <label>New License Request</label>
                </value>
                <value>
                    <fullName>Apply Renewal</fullName>
                    <default>false</default>
                    <label>Apply Renewal</label>
                </value>
                <value>
                    <fullName>Re-host</fullName>
                    <default>false</default>
                    <label>Re-host</label>
                </value>
                <value>
                    <fullName>Merge Seats</fullName>
                    <default>false</default>
                    <label>Merge Seats</label>
                </value>
                <value>
                    <fullName>Evaluation License/Employee License</fullName>
                    <default>false</default>
                    <label>Evaluation License/Employee License</label>
                </value>
                <value>
                    <fullName>Others</fullName>
                    <default>false</default>
                    <label>Others</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Chatbot_Feedback__c</fullName>
        <defaultValue>false</defaultValue>
        <description>value is set to True for feedback submitted from Chatbot</description>
        <label>Chatbot Feedback</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Event_Type__c</fullName>
        <description>To differentiate Feedback</description>
        <label>Event Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Event Feedback</fullName>
                    <default>false</default>
                    <label>Event Feedback</label>
                </value>
                <value>
                    <fullName>Non Event Feedback</fullName>
                    <default>false</default>
                    <label>Non Event Feedback</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Feedback_Date__c</fullName>
        <description>To capture Date Time of Event and Non Event Feedbacks</description>
        <label>Feedback Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Feedback_Text__c</fullName>
        <label>Feedback Text</label>
        <length>500</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Last_Feedback_Captured__c</fullName>
        <externalId>false</externalId>
        <formula>TODAY()- Feedback_Date__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days Since Last Feedback Captured</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Rating__c</fullName>
        <description>To store Rating from the End User</description>
        <label>Rating</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Extremely Unsatisfied</fullName>
                    <default>false</default>
                    <label>Extremely Unsatisfied</label>
                </value>
                <value>
                    <fullName>Dissatisfied</fullName>
                    <default>false</default>
                    <label>Dissatisfied</label>
                </value>
                <value>
                    <fullName>Neutral</fullName>
                    <default>false</default>
                    <label>Neutral</label>
                </value>
                <value>
                    <fullName>Satisfied</fullName>
                    <default>false</default>
                    <label>Satisfied</label>
                </value>
                <value>
                    <fullName>Extremely Satisfied</fullName>
                    <default>false</default>
                    <label>Extremely Satisfied</label>
                </value>
                <value>
                    <fullName>No Rating</fullName>
                    <default>false</default>
                    <label>No Rating</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Reference_Id__c</fullName>
        <externalId>false</externalId>
        <label>Reference Id</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sales_Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Feedbacks</relationshipLabel>
        <relationshipName>Feedbacks</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Scale__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( Rating__c , &apos;Extremely Dissatisfied&apos;, 1, &apos;Dissatisfied&apos;, 2,&apos;Neutral&apos;,3,&apos;Satisfied&apos;,4,&apos;Extremely Satisfied&apos;,5,0)</formula>
        <label>Scale</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <label>Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Feedback</fullName>
                    <default>false</default>
                    <label>Feedback</label>
                </value>
                <value>
                    <fullName>Skipped</fullName>
                    <default>false</default>
                    <label>Skipped</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <description>What type of user is giving feedback.</description>
        <label>User Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Internal</fullName>
                    <default>false</default>
                    <label>Internal</label>
                </value>
                <value>
                    <fullName>External</fullName>
                    <default>false</default>
                    <label>External</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Feedback</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>PSG_Quoting_Feedback</fullName>
        <columns>NAME</columns>
        <columns>Application__c</columns>
        <columns>User__c</columns>
        <columns>Type__c</columns>
        <columns>Rating__c</columns>
        <columns>Scale__c</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Application__c</field>
            <operation>equals</operation>
            <value>PSG Quoting</value>
        </filters>
        <label>PSG Quoting Feedback</label>
    </listViews>
    <nameField>
        <displayFormat>F-{0000000000}</displayFormat>
        <label>Feedback Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Feedbacks</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
