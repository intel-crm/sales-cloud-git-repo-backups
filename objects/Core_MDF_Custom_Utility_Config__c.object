    <validationRules>
        <fullName>Core_MDF_AccountField_Required</fullName>
        <active>true</active>
        <description>This field is required for when Enable Account Filter is checked</description>
        <errorConditionFormula>AND(
    Core_MDF_Enable_Account_Filter_Ind__c = TRUE,  
    ISBLANK(Core_MDF_Account_Field_nm__c)
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Account_Field_nm__c</errorDisplayField>
        <errorMessage>Account Field cannot be Blank</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
