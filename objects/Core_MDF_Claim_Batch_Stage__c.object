    <validationRules>
        <fullName>Core_MDF_Succesful_StageCannot_Be_Edited</fullName>
        <active>true</active>
        <description>Claim Batch Stage with Successful status cannot be edited</description>
        <errorConditionFormula>NOT(ISBLANK( PRIORVALUE(Core_MDF_Claim_Reference_Nbr__c) ))  &amp;&amp; TEXT(Core_MDF_Processing_Status_Nm__c ) == $Label.Core_MDF_Claim_Batch_Successful</errorConditionFormula>
        <errorMessage>Claim Batch Record cannot be edited in its current status</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
