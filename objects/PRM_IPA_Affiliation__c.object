    <fields>
        <fullName>PRM_Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipName>IPA_Affiliations</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PRM_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PRM_Builder_Strategy__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>IPA Affiliation</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Association to account is not possible as Affiliation is Inactive</errorMessage>
            <filterItems>
                <field>PRM_Builder_Strategy__c.PRM_Active__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>PRM_Builder_Strategy__c</referenceTo>
        <relationshipLabel>Account IPA Affiliations</relationshipLabel>
        <relationshipName>IPA_Affiliations</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PRM_Builder__c</fullName>
        <label>Builder</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>AI Builders</fullName>
                    <default>false</default>
                    <label>AI Builders</label>
                </value>
                <value>
                    <fullName>Network Builders</fullName>
                    <default>false</default>
                    <label>Network Builders</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PRM_Notes__c</fullName>
        <inlineHelpText>On update of any field, Reason Text should also be updated</inlineHelpText>
        <label>Reason Text</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Record_Link__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot; &amp; Id, &apos;Record Link&apos;, &quot;_self&quot; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Record Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Unique_Key__c</fullName>
        <description>to check the data uniqueness</description>
        <externalId>false</externalId>
        <label>Unique Key</label>
        <length>36</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Account IPA Affiliation</label>
    <nameField>
        <displayFormat>IA-{000000000}</displayFormat>
        <label>IPA Affiliation Association Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account IPA Affiliations</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Intel_Account_Affiliation</fullName>
        <active>true</active>
        <label>Intel Account Affiliation</label>
        <picklistValues>
            <picklist>PRM_Builder__c</picklist>
            <values>
                <fullName>AI Builders</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Network Builders</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <recordTypes>
        <fullName>Partner_Account_Group_Affiliation</fullName>
        <active>true</active>
        <label>Partner Account Group Affiliation</label>
        <picklistValues>
            <picklist>PRM_Builder__c</picklist>
            <values>
                <fullName>AI Builders</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Network Builders</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts>
        <excludedStandardButtons>New</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>prevention_of_Duplicate_Comb_logic</fullName>
        <active>true</active>
        <description>to prevent duplicate combination of account and affiliation</description>
        <errorConditionFormula>AND(  NOT( $Permission.PCC_Bypass_Automation ),
    OR(
    ISCHANGED(PRM_Account__c)
   ,
    ISCHANGED( PRM_Builder_Strategy__c )
	)
)</errorConditionFormula>
        <errorMessage>You cannot update Account and Strategy fields</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
