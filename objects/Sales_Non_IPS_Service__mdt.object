                </value>
                <value>
                    <fullName>I can&apos;t see/find a computer</fullName>
                    <default>false</default>
                    <label>I can&apos;t see/find a computer</label>
                </value>
                <value>
                    <fullName>I can&apos;t assign product to a computer</fullName>
                    <default>false</default>
                    <label>I can&apos;t assign product to a computer</label>
                </value>
                <value>
                    <fullName>I need to remove a product from a computer</fullName>
                    <default>false</default>
                    <label>I need to remove a product from a computer</label>
                </value>
                <value>
                    <fullName>I am getting errors generating a license file</fullName>
                    <default>false</default>
                    <label>I am getting errors generating a license file</label>
                </value>
                <value>
                    <fullName>I can&apos;t generate a companion or temporary license</fullName>
                    <default>false</default>
                    <label>I can&apos;t generate a companion or temporary license</label>
                </value>
                <value>
                    <fullName>I need to merge licenses/seats</fullName>
                    <default>false</default>
                    <label>I need to merge licenses/seats</label>
                </value>
                <value>
                    <fullName>Having issue when generating license for Questa Beta version</fullName>
                    <default>false</default>
                    <label>Having issue when generating license for Questa Beta version</label>
                </value>
                <value>
                    <fullName>I can&apos;t update License User</fullName>
                    <default>false</default>
