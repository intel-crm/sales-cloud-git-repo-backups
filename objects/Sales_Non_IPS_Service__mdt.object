        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Type of License Issue</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>I can&apos;t see/find a product that I want to license</fullName>
                    <default>false</default>
                    <label>I can&apos;t see/find a product that I want to license</label>
