    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This is detail Object of Partner Group Mapping Object. It will store email domain records for each Partner group Mapping record.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Active_Ind__c</fullName>
        <defaultValue>true</defaultValue>
        <description>It will show if domain is active or not.</description>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Partner_Group_Mapping_Id__c</fullName>
        <description>It will store Partner Group Mapping Id.</description>
        <label>Partner Group Mapping</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 AND (2 OR 3)</booleanFilter>
            <errorMessage>Domain name cannot be created</errorMessage>
            <filterItems>
                <field>Core_MDF_Partner_Group_Mapping__c.Core_MDF_Type_of_Access__c</field>
                <operation>equals</operation>
                <value>External</value>
            </filterItems>
            <filterItems>
                <field>Core_MDF_Partner_Group_Mapping__c.Core_MDF_Account__r.Core_MDF_CoMarketingActive__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Core_MDF_Partner_Group_Mapping__c.Core_MDF_Account__r.Core_MDF_CoMarketingAgency__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Core_MDF_Partner_Group_Mapping__c</referenceTo>
        <relationshipLabel>Partner Group Domain Mappings</relationshipLabel>
        <relationshipName>Partner_Group_Mapping_Domains</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <label>Partner Group Domain Mapping</label>
    <nameField>
        <label>Domain Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Partner Group Domain Mappings</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_MDF_DomainCannotBeEdited</fullName>
        <active>true</active>
        <description>Domain name cannot be edited once created</description>
        <errorConditionFormula>ISCHANGED(Name)</errorConditionFormula>
        <errorMessage>Domain name cannot be edited at this time</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_InvalidDomainName</fullName>
        <active>true</active>
        <description>This will prevent entering invalid domain.</description>
        <errorConditionFormula>NOT(REGEX(Name,&apos;^[a-zA-Z0-9-]{1,100}+[&quot;.&quot;]+[a-zA-Z0-9.]{1,100}$&apos;))</errorConditionFormula>
        <errorMessage>Incorrect domain name entered</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
