    <fields>
        <fullName>Pricing_Additional_Comments_Txt__c</fullName>
        <description>Represents free form text entered by the Field or OEM that provides additional details at the quote line level.</description>
        <inlineHelpText>Additional comments for the quote line.</inlineHelpText>
        <label>Additional Comments</label>
        <length>20000</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Pricing_Additional_OEM_Discount_Amt__c</fullName>
        <description>Represents the total investment to win the bid in US dollars. This is the total investment as a whole, and should not be the amount per system.</description>
        <inlineHelpText>Any additional OEM investment needed to win the bid. This is the total discount (in US Dollars), not amount per system.</inlineHelpText>
        <label>Additional Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Pricing_Additional_RPM_Notify_Recipients__c</fullName>
        <inlineHelpText>List of RPM email addresses who should receive notifications in addition to the RPM actioning the quote line.</inlineHelpText>
        <label>Additional RPM Notification Recipients</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Pricing_Additional_T_C_s_Txt__c</fullName>
        <inlineHelpText>Terms and conditions put in place in addition to the standard T’s&amp;C’s available in Intel Quote Request or on the quote letter.</inlineHelpText>
        <label>Additional T&apos;s &amp; C&apos;s</label>
        <length>1000</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Pricing_Application_Agent_Status__c</fullName>
        <label>Application Agent Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Success</fullName>
                    <default>false</default>
                    <label>Success</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
