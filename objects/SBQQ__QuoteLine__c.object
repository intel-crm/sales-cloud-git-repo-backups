    <fields>
        <fullName>Pricing_ReqDiscUnitPricePerGB_Amt__c</fullName>
        <formula>IF(Pricing_Density__c &lt;&gt; 0, Pricing_Req_Discounted_Unit_Price__c / Pricing_Density__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Requested Discount Unit Price/GB</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
