        <fullName>Pricing_Intel_Discount_Pct__c</fullName>
        <description>Represents the Intel discount on the product as a percentage.</description>
        <formula>(Pricing_OEM_Standard_Unit_Price_Amt__c  -  Pricing_Req_Discounted_Unit_Price__c ) /  Pricing_OEM_Standard_Unit_Price_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>(Customer Standard Unit Price - Requested Discount Price) / Customer Standard Unit Price</inlineHelpText>
        <label>Intel Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
