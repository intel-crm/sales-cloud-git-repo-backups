    <listViews>
        <fullName>IQR_QuoteLines_About_To_Be_Rejected</fullName>
        <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
        <columns>SBQQ__Quote__c</columns>
        <columns>Pricing_Quote_Line_Number_Txt__c</columns>
        <columns>SBQQ__Product__c</columns>
        <columns>Pricing_Other_Product_Nm__c</columns>
        <columns>Pricing_OEM_Account_Nm__c</columns>
        <columns>Pricing_EndCustomer_Nm__c</columns>
        <columns>Pricing_UnifiedEndCustomer__c</columns>
        <columns>Pricing_Region_Nm__c</columns>
        <columns>Pricing_End_Customer_Country__c</columns>
        <columns>Pricing_Server_Deal_Type_Nm__c</columns>
        <columns>Pricing_New_Change_Request_cb__c</columns>
        <columns>Pricing_Program_Type_Nm__c</columns>
        <columns>Pricing_Intel_Response_Requested_By_Date__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Pricing_Quote_Program_Nm__c</field>
            <operation>equals</operation>
            <value>Tender</value>
        </filters>
        <filters>
            <field>Pricing_Status_Nm__c</field>
            <operation>equals</operation>
            <value>Pending Intel Field Review</value>
        </filters>
        <filters>
            <field>Pricing_Sales_Rep__c</field>
            <operation>equals</operation>
            <value>$USER</value>
        </filters>
        <filters>
            <field>Pricing_Last_Submitted_Date_dt__c</field>
