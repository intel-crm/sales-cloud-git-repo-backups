        <fullName>Pricing_Change_Request_Ind__c</fullName>
        <formula>If((LEN(Pricing_Quote_Line_Number__c) - LEN(SUBSTITUTE(Pricing_Quote_Line_Number__c, &quot;-&quot;, &quot;&quot;)) &gt; 2), true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Of Change Request ?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
