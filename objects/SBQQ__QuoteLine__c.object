    <fields>
        <fullName>PSG_BrokenCost_Amt__c</fullName>
        <label>Broken Cost - To be deleted</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PSG_Broken_Cost_Amt__c</fullName>
        <formula>PSG_Suggested_Resale_txt__c  -  (  PSG_Suggested_Resale_txt__c  *  (  PSG_Disti_Pct__c  / 100))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Broken Cost - To be deleted</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
