    <fields>
        <fullName>Pricing_Systems_qty__c</fullName>
        <description>Identifies the number of systems that will be used for project.</description>
        <externalId>false</externalId>
        <inlineHelpText>Number of servers (nodes).</inlineHelpText>
        <label>No. of Systems</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Tentative_ECAP_Price_Amt__c</fullName>
        <inlineHelpText>Calculated ECAP. Used to access how the model influenced the Approved ECAP (in US Dollars).</inlineHelpText>
        <label>Tentative ECAP Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Pricing_Total_Bid_without_Discount_Amt__c</fullName>
        <description>Represents the total bid amount for the product without any discount in US dollars.</description>
        <formula>Pricing_Single_System_Price_Amt__c  *  Pricing_Systems_qty__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Single System Price Point  x No. of Systems (in US Dollars).</inlineHelpText>
        <label>Total Bid without Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Pricing_Total_Intel_Discount_Amt__c</fullName>
        <description>Represents the total Intel discount amount in US dollars.</description>
        <formula>IF( ISPICKVAL(Pricing_Program_Type_Nm__c, &apos;Data Center GPU&apos;) , (Pricing_OEM_Standard_Unit_Price_Amt__c  -  Pricing_Req_Discounted_Unit_Price__c ) *   Pricing_No_of_GPUs__c, 
(Pricing_OEM_Standard_Unit_Price_Amt__c  -  Pricing_Req_Discounted_Unit_Price__c ) *   Pricing_Unit_Qty__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>(Customer Standard Unit Price - Requested Discount Price) x Quantity (in US Dollars).</inlineHelpText>
        <label>Total Intel Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Pricing_Total_Product_Rebate__c</fullName>
        <formula>Pricing_FI_Net_RPU_Amt__c  *  Pricing_Approved_Unit_Qty__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Product Rebate</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
