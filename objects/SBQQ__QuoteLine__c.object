    <listViews>
        <fullName>Copy_of_IQRListView</fullName>
        <columns>SBQQ__Quote__c</columns>
        <columns>Pricing_Quote_Line_Number_Txt__c</columns>
        <columns>Pricing_Status_Nm__c</columns>
        <columns>Pricing_Last_Submitted_Date_dt__c</columns>
        <columns>Pricing_EndCustomer_Nm__c</columns>
        <columns>Pricing_UnifiedEndCustomer__c</columns>
        <columns>Pricing_ECAP_Price_Dup_Amt__c</columns>
        <columns>SBQQ__Product__c</columns>
        <columns>Pricing_Other_Product_Nm__c</columns>
        <columns>Pricing_New_Change_Request_cb__c</columns>
        <columns>Pricing_Deal_RFQ_Dup_Id__c</columns>
        <columns>Pricing_Program_Type_Nm__c</columns>
        <columns>Pricing_Intel_Response_Requested_By_Date__c</columns>
        <columns>Pricing_Market_Segment_values_Nm__c</columns>
        <columns>Pricing_Market_Segment_Nm__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>SBQQ__QuoteLine__c.Pricing_SVD_Quote_Line_Edit,SBQQ__QuoteLine__c.Pricing_SVD_Quote_Line_Read_Only,SBQQ__QuoteLine__c.Pricing_SVD_Quote_Line_Submitted,SBQQ__QuoteLine__c.Pricing_Tender_Quote_Line_Edit,SBQQ__QuoteLine__c.Pricing_Tender_Quote_Line_ReadOnly,SBQQ__QuoteLine__c.Pricing_Tender_Quote_Line_Submitted</value>
        </filters>
        <filters>
            <field>Pricing_Status_Nm__c</field>
            <operation>notEqual</operation>
            <value>Revised</value>
        </filters>
        <filters>
            <field>SBQQ__Quote__c</field>
            <operation>greaterOrEqual</operation>
            <value>Q-111935</value>
        </filters>
        <label>Copy of IQR Quote Lines​​​​​​​</label>
    </listViews>
