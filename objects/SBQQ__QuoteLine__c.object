    <fields>
        <fullName>core_cpq_sum_dm_im_pas_diff__c</fullName>
        <description>used for advance approval</description>
        <externalId>false</externalId>
        <formula>core_cpq_disty_margin_difference__c  +  core_cpq_intel_margin_difference__c  +  core_cpq_peak_annual_resale_difference__c</formula>
        <label>Sum of IM-DM-PAS Diff</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_tools_nc_bm_routing_check__c</fullName>
        <formula>IF( AND( ISPICKVAL(SBQQ__Quote__r.core_cpq_quote_type_nm__c, &apos;Tools&apos;),  
   SBQQ__Quote__r.core_cpq_corporate_flag__c = false,
   OR( 
   AND( SBQQ__Product__r.Core_Item_Class_Nm__c = &apos;BD&apos;, 
       SBQQ__Product__r.Core_BU_Operation_Code__c = &apos;HF&apos;) ,
   AND( SBQQ__Product__r.Core_Item_Class_Nm__c = &apos;BD&apos;, 
       SBQQ__Product__r.Core_BU_Operation_Code__c = &apos;KP&apos;) ,
   AND( SBQQ__Product__r.Core_Item_Class_Nm__c = &apos;BD&apos;, 
       SBQQ__Product__r.Core_BU_Operation_Code__c = &apos;&apos;) , 
   AND( SBQQ__Product__r.Core_Item_Class_Nm__c = &apos;SV&apos;, 
       SBQQ__Product__r.Core_BU_Operation_Code__c = &apos;PS&apos;) 
   ) ), true, false)</formula>
        <label>Tools NC BM Routing Check</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>core_cpq_unique_id__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <label>Unique Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>core_cpq_upper_bound_qty_nbr__c</fullName>
        <externalId>false</externalId>
        <label>Upper Bound Qty</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>core_cpq_years_nbr__c</fullName>
        <defaultValue>1</defaultValue>
        <externalId>false</externalId>
        <label># of Years</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>previous_core_cpq_quote_line_type_txt__c</fullName>
        <externalId>false</externalId>
        <label>Previous Quote Line Type</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>price_broken_cost_cp__c</fullName>
        <externalId>false</externalId>
        <formula>price_suggested_resale_amt__c - (price_suggested_resale_amt__c * (core_cpq_distributor_margin_pct__c ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Broken Cost</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>price_brokencost_amt__c</fullName>
        <label>Broken Cost</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>price_disty_cost_nbr__c</fullName>
        <label>Disti Cost</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>price_disty_margin_amt__c</fullName>
        <externalId>false</externalId>
        <formula>( price_suggested_resale_amt__c - price_brokencost_amt__c ) *  SBQQ__Quantity__c  * core_cpq_years_nbr__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Disty Margin $</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>price_goal_price_amt__c</fullName>
        <label>Goal Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>price_intel_margin_amt__c</fullName>
        <externalId>false</externalId>
        <formula>(price_brokencost_amt__c -  price_std_fwd_cost_amt__c) *   SBQQ__Quantity__c  *  core_cpq_years_nbr__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Intel Margin $</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>price_msvp_l1_amt__c</fullName>
        <label>MSVP L1</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>price_msvp_l2_amt__c</fullName>
        <label>MSVP L2</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>price_peak_annual_resale_amt__c</fullName>
        <externalId>false</externalId>
        <formula>price_suggested_resale_amt__c  *  SBQQ__Quantity__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
