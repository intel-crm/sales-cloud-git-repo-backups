    <fields>
        <fullName>Pricing_Unit_Qty__c</fullName>
        <description>Represents the number of CPUs requested based on the number of systems and number of CPUs per system listed.</description>
        <externalId>false</externalId>
        <formula>IF(AND(NOT( ISNULL(Pricing_New_Quantity_qty__c)),
(OR( ISPICKVAL(Pricing_Quote_Program_Nm__c , &apos;Tender&apos;), ISPICKVAL(Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;)))), Pricing_New_Quantity_qty__c, IF(TEXT(Pricing_Program_Type_Nm__c) =&quot;Data Center GPU&quot;,Pricing_No_of_GPUs__c, 
IF(TEXT(Pricing_Program_Type_Nm__c) = &quot;Optane™ PMem&quot;, Pricing_Systems_qty__c * Pricing_Units_per_system_qty__c, 
IF( OR(TEXT(Pricing_Program_Type_Nm__c) = &quot;Data Center Xeon® CPU&quot;,TEXT(Pricing_Program_Type_Nm__c) = &quot;Small Volume Quotes - Data Center Xeon® CPU&quot;) , Pricing_Systems_qty__c * Pricing_CPUs_per_system_qty__c, Pricing_Total_Volume_Qty__c))))</formula>
        <inlineHelpText>Total number of units.</inlineHelpText>
        <label>Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
