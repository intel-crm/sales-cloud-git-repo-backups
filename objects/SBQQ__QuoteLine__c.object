    <validationRules>
        <fullName>End_date_check</fullName>
        <active>true</active>
        <description>End date cannot be a date in the past</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Read_Only&apos;,
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;
),
OR(
ISCHANGED(Pricing_End_Date_dt__c),
ISNEW()
),
Pricing_End_Date_dt__c &lt; TODAY()
)</errorConditionFormula>
        <errorMessage>Quote Line Pricing End Date has already passed. Please enter a Quote Line Pricing End Date in the future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Other_Competitor_Product_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Client_Quote_Line_Create&apos;,
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;),
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;
),
OR(
	ISNEW(),
	ISCHANGED(Pricing_Competetor_Product__c),
	ISCHANGED(Pricing_Other_Competitor_Product_Nm__c)
),
	AND(
NOT(ISNULL(Pricing_Competetor_Product__c)),
Pricing_Competetor_Product__r.Name  = &apos;Write In Product&apos;,
		ISBLANK(Pricing_Other_Competitor_Product_Nm__c)
)
)</errorConditionFormula>
        <errorMessage>When &apos;Write In Product&apos; is selected in the Competitor Product field, the name of the other product must be provided in the Write In Competitor Product field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Broken_Cost_Disty_Cost_check</fullName>
        <active>false</active>
        <description>Should perform the validation to ensure Broken Cost IS NOT GREATER THAN Disty Cost.</description>
        <errorConditionFormula>AND( 
 $Permission.PSG_Internal_SOS ,
OR(RecordType.DeveloperName = &apos;PSG_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;PSG_Quote_Line_Create&apos;),
(price_brokencost_amt__c &gt;  price_disty_cost_nbr__c ),
ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c, &apos;Quote&apos;)
)</errorConditionFormula>
        <errorDisplayField>price_brokencost_amt__c</errorDisplayField>
        <errorMessage>Broken Cost cannot be more than Disty Cost.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_DDR_Product_Density_validation</fullName>
        <active>false</active>
        <description>To Validate the Density of the DDR &amp; Product to accept in Quote Line</description>
        <errorConditionFormula>AND(
NOT($Permission.PSG_External_Disty ),
OR(
RecordType.DeveloperName = &apos;PSG_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;PSG_Quote_Line_Create&apos;),
(ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c ,&apos;Quote&apos;)),
(NOT(ISBLANK(core_cpq_design_registration_product__c))),
(NOT(ISBLANK(SBQQ__Quote__r.SBQQ__Opportunity2__c))),

OR(((core_cpq_design_registration_product__r.Core_Product_Id__r.Core_Product_Type__c) != &apos;Intel® FPGAs&apos;),
(SBQQ__Product__r.Core_Product_Density_Value__c) != (core_cpq_design_registration_product__r.Core_Product_Id__r.Core_Product_Density_Value__c),
(SBQQ__Quote__r.SBQQ__Opportunity2__r.Core_Design_Registration_Id__c) != (core_cpq_design_registration_product__r.Core_Design_Registration_Id__c)))</errorConditionFormula>
        <errorMessage>Invalid Product Selected - DDR Product Density and Product Density is not matching</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Post_Release_Prod_Validation</fullName>
        <active>true</active>
        <description>Non-Budgetary Quote type - For OPN validation (Active, Orderable, Quotable)</description>
        <errorConditionFormula>AND(
NOT($Permission.PSG_System_User),
ISBLANK( core_cpq_qcp_error_nm__c ) ,
NOT($Permission.PSG_External_Disty ),
ISPICKVAL(SBQQ__Quote__r.Pricing_Quote_Program_Nm__c, &apos;PSG&apos;),
ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c,&apos;Quote&apos;),
NOT( ISCHANGED(core_cpq_follow_on_process_cb__c )),
ISPICKVAL( SBQQ__Quote__r.core_cpq_quote_type_nm__c , &apos;Contract Pricing&apos;),
OR(
(AND(SBQQ__Product__r.Core_Product_Type_Nm__c==&apos;Tool&apos;,
OR(SBQQ__Product__r.Core_BU_Operation_Code__c != &apos;KP&apos;,
SBQQ__Product__r.Core_Item_Class_Nm__c != &apos;BD&apos;)
)),
NOT(SBQQ__Product__r.Core_Item_Orderable_Ind__c),
NOT(SBQQ__Product__r.IsActive),
NOT(SBQQ__Product__r.Core_Item_Quotable_Ind__c),
NOT(ISPICKVAL(SBQQ__Product__r.Core_Product_Org__c,&apos;Sales&apos;))
)
)</errorConditionFormula>
        <errorMessage>Invalid Product selected for Contract Pricing Quote (Active = X, Quotable = X, Orderable = X) 
(Note: The only Tools product that can be added to Design Win Quotes are specific PAC Cards)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Restrict_Quote_Line_Edit</fullName>
        <active>false</active>
        <description>It restricts users from creating new record and editing existing records during freeze period.</description>
        <errorConditionFormula>AND(
OR(
 ISNEW() ,
 !ISNULL( PRIORVALUE(Id) ) 
),
 ISPICKVAL(  Pricing_Quote_Program_Nm__c  , &apos;PSG&apos;) 
)</errorConditionFormula>
        <errorMessage>Quote Line Record cannot be created or edited during Freeze Period!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_SOS_IN_Review_Disable_Edit</fullName>
        <active>true</active>
        <description>SOS don&apos;t have Edit permission for In Review Status for Quote Line</description>
        <errorConditionFormula>AND( $Permission.PSG_Internal_SOS ,  
ISPICKVAL(SBQQ__Quote__r.Pricing_Quote_Program_Nm__c, &apos;PSG&apos;),
ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c,&apos;Quote&apos;),
ISPICKVAL(SBQQ__Quote__r.SBQQ__Status__c, &apos;In Review&apos;))</errorConditionFormula>
        <errorMessage>You Don&apos;t Have Edit Permission for Quotes in &apos;In Review&apos; Status. Recall the Quote to proceed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PSG_Tools_Prod_Validation</fullName>
        <active>true</active>
        <description>Tools Quote type - For OPN validation (Active, Orderable, Quotable) and Product type (Core_Product_Type_Nm__c) should be &quot;Tool&quot;</description>
        <errorConditionFormula>AND(
NOT($Permission.PSG_System_User),
ISBLANK( core_cpq_qcp_error_nm__c ) ,
NOT(ISCLONE()),
NOT($Permission.PSG_External_Disty ),
ISPICKVAL(SBQQ__Quote__r.Pricing_Quote_Program_Nm__c, &apos;PSG&apos;),
ISPICKVAL( SBQQ__Quote__r.core_cpq_quote_type_nm__c , &apos;Tools&apos;),
ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c,&apos;Quote&apos;),
NOT( ISCHANGED(core_cpq_follow_on_process_cb__c )),
OR(
ISNULL(core_cpq_product_nm__r.Core_Product_Type_Nm__c),
(core_cpq_product_nm__r.Core_Product_Type_Nm__c)!=&apos;Tool&apos;
),
OR(
NOT(SBQQ__Product__r.Core_Item_Orderable_Ind__c),
NOT(SBQQ__Product__r.IsActive),
NOT(SBQQ__Product__r.Core_Item_Quotable_Ind__c),
NOT(ISPICKVAL(SBQQ__Product__r.Core_Product_Org__c,&apos;Sales&apos;))
)
)</errorConditionFormula>
        <errorMessage>Invalid Product selected for Tools Quote(Active = X,  Quotable = X, Orderable = X, FPGA Product Type = &apos;Tool&apos;)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_editing_of_approved_QL</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
OR(
$RecordType.Name = &quot;PSG Quote Line - Create&quot;,
$RecordType.Name = &quot;PSG Quote Line - Submitted&quot;
),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
AND(
ISPICKVAL(SBQQ__Quote__r.SBQQ__Status__c, &apos;Approved&apos;),
SBQQ__Quote__r.core_cpq_first_bm_approver__c &lt;&gt; $User.Id
),
NOT(ISBLANK(Name)),
NOT(ISNULL(Name))

)</errorConditionFormula>
        <errorMessage>QuoteLine can not be edited for Approved Quotes</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Preventing_Editing_of_Hold_QL</fullName>
        <active>true</active>
        <description>This validation rule does not allow user to edit quote line when its quote is on hold</description>
        <errorConditionFormula>AND( ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Tender&apos;), 
OR( $Permission.Tender_User , 
$Permission.Tender_Account_Executive , $Permission.Pricing_Tender_Regional_Pricing_Manager, $Permission.Pricing_Tender_IT_Specialist,
 $Permission.Pricing_Tender_Rebate_Analyst ) ,SBQQ__Quote__r.Pricing_On_Hold_Cb__c = true)</errorConditionFormula>
        <errorMessage>Quote line cannot be Edited while Quote is On Hold</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_AfterDeal_Validation</fullName>
        <active>true</active>
        <description>Market Segment Type, Market Segment, Group Type and Region cannot be edited after deal is created in My Deals.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager, 	
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
OR(
	ISCHANGED(Pricing_Market_Segment_values_Nm__c), 
	ISCHANGED(Pricing_Market_Segment_Nm__c) , 
	ISCHANGED(Pricing_Group_Type_nm__c ),
        ISCHANGED(Pricing_RegionQL_Nm__c)	
),
OR( 
	Pricing_Integration_Status_Nm__c = &quot;Pending&quot;,
	Pricing_Integration_Status_Nm__c =&quot;InProcess&quot;,
        NOT(ISBLANK(Pricing_Deal_RFQ_Id__c)),
	Pricing_Deal_RFQ_Status_Nm__c = &apos;Requested&apos;,
	Pricing_Deal_RFQ_Status_Nm__c = &apos;Submitted&apos;,
	Pricing_Deal_RFQ_Status_Nm__c = &apos;Offer&apos;
)
)</errorConditionFormula>
        <errorDisplayField>core_cpq_dollar_change_flag_cb__c</errorDisplayField>
        <errorMessage>Market Segment Type, Market Segment, Group Type and Region cannot be edited after deal is created in My Deals.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ApprStartDtPastInflightWon_Check</fullName>
        <active>true</active>
        <description>When deal is Inflight and deal status is Won or deal is in Approved/Won in Past , Approved Pricing Start Date cannot be editable.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager, 	
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
NOT( ISBLANK( Pricing_Reference_Quote_Line_Nbr__c ) ) ,
OR(
(Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_Start_Date_Dt__c &lt;=   TODAY() &amp;&amp;
Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_End_Date_Dt__c &gt;=   TODAY() &amp;&amp; 
ISPICKVAL(Pricing_Reference_Quote_Line_Nbr__r.Pricing_Status_Nm__c,&quot;WON&quot; ) ), 
Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_End_Date_Dt__c &lt; TODAY() ),
ISCHANGED( Pricing_Approved_Start_Date_Dt__c )
  )</errorConditionFormula>
        <errorMessage>Approved Pricing Start Date cannot be edited for Won quote lines that are active (i.e. today is between Approved Pricing Start Date and Approved Pricing End Date) or  for a Approved/Won Past Deal.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ApproStartDtInflightFuture_Check</fullName>
        <active>true</active>
        <description>When Deal is Inflight/Future , Approved Pricing Start Date should be Today or later. When Backdate Reason is Empty.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
AND(
NOT(ISNULL(Pricing_Approved_Start_Date_Dt__c)),
ISCHANGED(Pricing_Approved_Start_Date_Dt__c),
ISPICKVAL(Pricing_Backdate_Reason_Txt__c,&quot;&quot;),
NOT(ISBLANK( Pricing_Reference_Quote_Line_Nbr__c )), 
Pricing_Approved_Start_Date_Dt__c &lt; TODAY()
)
)</errorConditionFormula>
        <errorDisplayField>core_cpq_dollar_change_flag_cb__c</errorDisplayField>
        <errorMessage>Back Date Reason is mandatory when Approved Pricing Start Date is in the past.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ApproveEndDtInflightFuture_Check</fullName>
        <active>true</active>
        <description>When Deal is Inflight/Future , Approved Pricing End Date should be Today or later.</description>
        <errorConditionFormula>AND(
OR(
$Permission.Pricing_Tender_Regional_Pricing_Manager, 
$Permission.Pricing_Financial_Incentive_Regional_Pricing_Manager ),	
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;,
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;)
),
OR(AND(
NOT(ISBLANK( Pricing_Reference_Quote_Line_Nbr__c )) ,
OR(
(Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_Start_Date_Dt__c &lt;=   TODAY() &amp;&amp;
Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_End_Date_Dt__c &gt;=   TODAY()),
Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_Start_Date_Dt__c &gt;  TODAY()),
Pricing_Approved_End_Date_Dt__c  &lt; TODAY()
),
AND(
NOT(ISNULL(Pricing_Approved_End_Date_Dt__c)),
OR(
ISCHANGED(Pricing_Approved_Start_Date_Dt__c),
ISCHANGED(Pricing_Approved_End_Date_Dt__c)
),
Pricing_Approved_End_Date_Dt__c &lt; Pricing_Approved_Start_Date_Dt__c
)
))</errorConditionFormula>
        <errorMessage>Approved Pricing End Date cannot be earlier than Approved Pricing Start Date nor earlier than today.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ApproveEndDtPast_Check</fullName>
        <active>true</active>
        <description>When Deal is in the Past , Approved Pricing End Date should be the same as the reference quote line&apos;s Approved Pricing End Date or later.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager, 	
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
NOT( ISBLANK( Pricing_Reference_Quote_Line_Nbr__c ) ) ,
Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_End_Date_Dt__c &lt; TODAY(),
Pricing_Approved_End_Date_Dt__c  &lt;  Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_End_Date_Dt__c  )</errorConditionFormula>
        <errorMessage>Approved Pricing End Date for a past deal must be the same as the reference quote line&apos;s Approved Pricing End Date or later.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ApprovedECAPPricePastDeal_Check</fullName>
        <active>true</active>
        <description>When Deal is in the Past, Approved ECAP Price should not be editable.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager, 	
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(	
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;
),
NOT( ISBLANK( Pricing_Reference_Quote_Line_Nbr__c ) ) ,
Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_End_Date_Dt__c &lt; TODAY(),
ISCHANGED( Pricing_ECAP_Price_Amt__c ) )</errorConditionFormula>
        <errorMessage>Approved ECAP Price for a past deal cannot be edited.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ApprovedECAPprice_Validation</fullName>
        <active>true</active>
        <description>Approved ECAP Price cannot be less than or equal to zero</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;
),
Pricing_ECAP_Price_Amt__c &lt;=0
)</errorConditionFormula>
        <errorMessage>Approved ECAP Price cannot be less than or equal to zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ApprovedEndDate_Past_FI_Validate</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISCHANGED(Pricing_Approved_End_Date_Dt__c),
ISNEW()
),
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;),
Pricing_New_Change_Request_cb__c = false,
Pricing_Approved_End_Date_Dt__c &lt; today(),
NOT(ISPICKVAL(Pricing_Status_Nm__c , &apos;Cancelled&apos;))
)</errorConditionFormula>
        <errorMessage>Approved Pricing End Date has already passed. Please enter Approved Pricing End Date in the future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ApprovedQuantity_Validation</fullName>
        <active>true</active>
        <description>Approved Quantity cannot be zero</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;)),
Pricing_Approved_Unit_Qty__c&lt;=0
)</errorConditionFormula>
        <errorMessage>Approved Quantity must be greater than zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Approved_Field_Validation</fullName>
        <active>true</active>
        <description>Pricing Approved Fields and Region Field validation for RPM with Draft/Pending Intel Field Review</description>
        <errorConditionFormula>IF(
AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;
),
OR(
ISPICKVAL(Pricing_Status_Nm__c, &quot;Draft&quot;),
ISPICKVAL(Pricing_Status_Nm__c, &quot;Pending Intel Field Review&quot;)
),
OR(
ISCHANGED(Pricing_Approved_Start_Date_Dt__c),
ISCHANGED(Pricing_Approved_End_Date_Dt__c),
ISCHANGED(Pricing_Approved_Unit_Qty__c),
ISCHANGED(Pricing_ECAP_Price_Amt__c),
ISCHANGED(Pricing_RegionQL_Nm__c),
ISCHANGED(Pricing_Revised_Pricing_Start_Date_dt__c)
)
), TRUE, null)</errorConditionFormula>
        <errorMessage>Approved Start Date, Approved End Date, Approved Quantity, Approved ECAP Price, Effective Pricing Start Date and Region cannot be edited except when quote line status is Pending Further Intel Review.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_BackdateReason_Field_Validation</fullName>
        <active>true</active>
        <description>Back date Reason field would be to be editable whenever Approved Pricing Start Date is in the past.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;
), 
ISCHANGED(Pricing_Backdate_Reason_Txt__c), 
OR(Pricing_Approved_Start_Date_Dt__c &gt;= TODAY(),
ISNULL(Pricing_Approved_Start_Date_Dt__c)))</errorConditionFormula>
        <errorMessage>Back Date Reason can only be edited when Approved Pricing Start Date is in the past.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_BillingDate_Validation</fullName>
        <active>true</active>
        <description>Billing End Date must be greater than Billing Start Date</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
OR
(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
Pricing_Billing_End_Date_Dt__c &lt; Pricing_Billing_Start_Date_Dt__c,
NOT( ISNEW()),
NOT( ISPICKVAL( Pricing_Status_Nm__c ,&apos;Revised&apos; ) ),
NOT( ISPICKVAL( Pricing_Status_Nm__c ,&apos;Rejected&apos; ) )
)</errorConditionFormula>
        <errorMessage>Billing End Date must be greater than Billing Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Billing_End_Date_Error</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
(Pricing_Billing_End_Date_Dt__c  &gt; Pricing_Approved_End_Date_Dt__c),
NOT( ISPICKVAL( Pricing_Status_Nm__c ,&apos;Revised&apos; ) ),
NOT( ISPICKVAL( Pricing_Status_Nm__c ,&apos;Rejected&apos; ) )
)</errorConditionFormula>
        <errorDisplayField>core_cpq_dollar_change_flag_cb__c</errorDisplayField>
        <errorMessage>Billing End Date cannot be later than the Approved Pricing End Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Billing_Start_Date_Error</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
(Pricing_Billing_Start_Date_Dt__c  &gt;  Pricing_Approved_Start_Date_Dt__c),
NOT( ISPICKVAL( Pricing_Status_Nm__c ,&apos;Revised&apos; ) ),
NOT( ISPICKVAL( Pricing_Status_Nm__c ,&apos;Rejected&apos; ) )
)</errorConditionFormula>
        <errorMessage>Billing Start Date cannot be later than Approved Pricing Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Comp_Write_In_Product_Restrict</fullName>
        <active>true</active>
        <description>The Write In Competitor Product field must be blank unless the &apos;Write In Product&apos; option is selected in the Competitor Product field.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Client_Quote_Line_Create&apos;,
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;),
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;
),
OR(
 ISNEW(),
ISCHANGED(Pricing_Competetor_Product__c),
ISCHANGED(Pricing_Other_Competitor_Product_Nm__c)
),
AND(
NOT(CONTAINS(Pricing_Competetor_Product__r.Name , &apos;Write In Product&apos;)),
NOT(ISBLANK(Pricing_Other_Competitor_Product_Nm__c))
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Other_Competitor_Product_Nm__c</errorDisplayField>
        <errorMessage>The Write In Competitor Product field is used to provide the name of a product missing from the Competitor Product field. It must be blank unless the &apos;Write In Product&apos; option is selected in the Competitor Product field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Competitor_Density_Validation</fullName>
        <active>true</active>
        <description>Competitor Density should always be greater than zero.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_SSD_Quote_Line_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_PMem_Quote_Line_Create&apos;
),
OR(
ISCHANGED(Pricing_Comp_Density_Nbr__c),
ISNEW()
),
Pricing_Comp_Density_Nbr__c  &lt;=0
)</errorConditionFormula>
        <errorDisplayField>Pricing_Comp_Density_Nbr__c</errorDisplayField>
        <errorMessage>Competitor Density must be greater than zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Competitor_Product_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND(OR(ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Tender&apos;),
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;)),
OR(isnew(), ISCHANGED(Pricing_Competetor_Product__c)),
Pricing_Competetor_Product__r.Pricing_Active_cb__c = false,
Pricing_New_Change_Request_cb__c = false)</errorConditionFormula>
        <errorMessage>Competitor Product is inactive. Please select a valid product.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Consumption_Parameter_Check</fullName>
        <active>true</active>
        <description>User can enter either Sales Geo OR Consumption Country /Region</description>
        <errorConditionFormula>OR(
       AND(
              NOT(ISBLANK(Pricing_Consumption_Sale_Geo__c)),
              NOT(ISBLANK(Pricing_Consumption_Region__c)),
              NOT(ISBLANK(Pricing_Consumption_Country__c))
       ),
       AND( 
              NOT(ISBLANK(Pricing_Consumption_Sale_Geo__c)),
              OR(NOT(ISBLANK(Pricing_Consumption_Region__c)),
              NOT(ISBLANK(Pricing_Consumption_Country__c)))
       )
)</errorConditionFormula>
        <errorMessage>A selection can be made in either Consumption Country/Region or Customer Sales Geography, but cannot be both. Please correct</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_DRAM_Density_Validation</fullName>
        <active>true</active>
        <description>DRAM Density cannot be less than or equal to zero.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_PMem_Quote_Line_Create&apos;
),
OR(
ISCHANGED(Pricing_DRAM_Density_Nbr__c),
ISNEW()
),
Pricing_DRAM_Density_Nbr__c &lt;=0
)</errorConditionFormula>
        <errorMessage>DRAM Density cannot be less than or equal to zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_EffPricingStartDtOnChange_Check</fullName>
        <active>true</active>
        <description>On Change request, Effective Pricing Start Date must be between Approved Pricing Start Date and Approved Pricing End Date and cannot be earlier than the Effective Pricing Start Date of the reference quote line.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager, 	
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
AND(NOT( ISBLANK( Pricing_Reference_Quote_Line_Nbr__c ) ), 
ISPICKVAL( Pricing_Reference_Quote_Line_Nbr__r.Pricing_Status_Nm__c, &quot;Won&quot;) ),
OR(
(Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_Start_Date_Dt__c &lt;= TODAY() &amp;&amp;
Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_End_Date_Dt__c &gt;= TODAY()),
Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_Start_Date_Dt__c &gt; TODAY()),
 OR( Pricing_Revised_Pricing_Start_Date_dt__c  &lt; Pricing_Approved_Start_Date_Dt__c,
Pricing_Revised_Pricing_Start_Date_dt__c &lt; Pricing_Reference_Quote_Line_Nbr__r.Pricing_Revised_Pricing_Start_Date_dt__c,
Pricing_Revised_Pricing_Start_Date_dt__c &gt; Pricing_Approved_End_Date_Dt__c) )</errorConditionFormula>
        <errorMessage>Effective Pricing Start Date must be between Approved Pricing Start Date and Approved Pricing End Date and cannot be earlier than the Effective Pricing Start Date of the reference quote line.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_EffStartDateMeetPriceOnCR_check</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
NOT( ISBLANK( Pricing_Reference_Quote_Line_Nbr__c ) ) ,
OR(ISCHANGED(Pricing_Revised_Pricing_Start_Date_dt__c),
ISCHANGED(Pricing_Meet_Comp_Price_Amt__c)) ,
Pricing_Approved_Start_Date_Dt__c = Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_Start_Date_Dt__c,
Pricing_Approved_End_Date_Dt__c = Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_End_Date_Dt__c,
Pricing_ECAP_Price_Amt__c = Pricing_Reference_Quote_Line_Nbr__r.Pricing_ECAP_Price_Amt__c,
Pricing_Approved_Unit_Qty__c = Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_Unit_Qty__c,
Pricing_Payable_Quantity__c = Pricing_Reference_Quote_Line_Nbr__r.Pricing_Payable_Quantity__c)</errorConditionFormula>
        <errorMessage>My Deals Meet Comp Price and Effective Pricing Start Date cannot be modified without also modifying at least one of the following fields: Approved Pricing Start Date, Approved Pricing End Date, Approved ECAP Price, Approved Quantity, Payable Quantity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_EffectPricingStartDatePast_Check</fullName>
        <active>true</active>
        <description>When Deal is in the Past, Effective Pricing Start Date should not be editable.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager, 	
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
NOT( ISBLANK( Pricing_Reference_Quote_Line_Nbr__c ) ) ,
Pricing_Reference_Quote_Line_Nbr__r.Pricing_Approved_End_Date_Dt__c &lt; TODAY(),
ISCHANGED(  Pricing_Revised_Pricing_Start_Date_dt__c  ) )</errorConditionFormula>
        <errorMessage>Effective Pricing Start Date for a past deal cannot be edited.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_EffectiveStartDate_RequiredCheck</fullName>
        <active>true</active>
        <description>Effective Pricing Start Date cannot be blank.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
NOT( ISBLANK( Pricing_Reference_Quote_Line_Nbr__c ) ) ,
ISCHANGED( Pricing_Revised_Pricing_Start_Date_dt__c ) ,
ISBLANK( Pricing_Revised_Pricing_Start_Date_dt__c ) )</errorConditionFormula>
        <errorMessage>Effective Pricing Start Date cannot be blank.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_End_date_Validation</fullName>
        <active>true</active>
        <description>Quote Line Pricing End Date is not before the quote’s Pricing Start Date</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SSD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_PMem_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Client_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Read_Only&apos;,
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;
),
 
 Pricing_End_Date_dt__c  &lt;   SBQQ__Quote__r.Pricing_ShipmentStDate_Dt__c 
)</errorConditionFormula>
        <errorDisplayField>Pricing_End_Date_dt__c</errorDisplayField>
        <errorMessage>Quote Line Pricing End Date cannot be earlier than the Pricing Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_FI_Competitor_Product_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Read_Only&apos;
),
OR(
ISNEW(),
ISCHANGED(Pricing_Competitor_OEM_Name_FI_Nm__c),
ISCHANGED(Pricing_Fl_CompWriteInOEMName_Txt__c)
),
AND(
ISPICKVAL(Pricing_Competitor_OEM_Name_FI_Nm__c , &apos;Write In Competitor OEM Name&apos;),
ISBLANK(Pricing_Fl_CompWriteInOEMName_Txt__c)
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Competitor_OEM_Name_FI_Nm__c</errorDisplayField>
        <errorMessage>When &apos;Write In Competitor OEM Name&apos; is selected in the Competitor OEM Name field, the name of the unlisted Competitor OEM Name must be provided in the  Write In Competitor OEM Name field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_FI_Other_Product_Validation</fullName>
        <active>true</active>
        <description>When &apos;Write In OEM Name&apos; is selected in the OEM Name field, the name of the unlisted OEM Name  must be provided in the Write In OEM Name field.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Read_Only&apos;
),
OR(
ISNEW(),
ISCHANGED(Pricing_OEM_Name_FI_Nm__c),
ISCHANGED(Pricing_FI_Write_In_OEM_Name_Txt__c)
),
AND(
ISPICKVAL(Pricing_OEM_Name_FI_Nm__c , &apos;Write In OEM Name&apos;),
ISBLANK(Pricing_FI_Write_In_OEM_Name_Txt__c)
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_OEM_Name_FI_Nm__c</errorDisplayField>
        <errorMessage>When &apos;Write In OEM Name&apos; is selected in the OEM Name field, the name of the unlisted OEM Name must be provided in the Write In OEM Name field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_FI_QL_Start_Date_validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISNEW(),
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;),
Pricing_New_Change_Request_cb__c = false,
Pricing_Start_Date_dt__c &lt; today()
)</errorConditionFormula>
        <errorDisplayField>Pricing_Start_Date_dt__c</errorDisplayField>
        <errorMessage>Quote Line Pricing Start Date has already passed. Please enter a Quote Line Pricing Start Date in the future.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_FI_QuoteLine_End_Date_Validation</fullName>
        <active>true</active>
        <description>Quote Line Pricing End Date cannot be Earlier than Quote Line Pricing Start Date.</description>
        <errorConditionFormula>AND(
ISNEW(),
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;),
Pricing_New_Change_Request_cb__c = false,
Pricing_End_Date_dt__c &lt; Pricing_Start_Date_dt__c
)</errorConditionFormula>
        <errorDisplayField>Pricing_End_Date_dt__c</errorDisplayField>
        <errorMessage>Quote Line Pricing End Date cannot be Earlier than Quote Line Pricing Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_FI_WriteIn_OEMComp_Name_Restrict</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Read_Only&apos;
),
OR(
ISNEW(),
ISCHANGED(Pricing_Competitor_OEM_Name_FI_Nm__c),
ISCHANGED(Pricing_Fl_CompWriteInOEMName_Txt__c)
),
AND(
NOT(ISPICKVAL(Pricing_Competitor_OEM_Name_FI_Nm__c , &apos;Write In Competitor OEM Name&apos;)),
NOT(ISBLANK(Pricing_Fl_CompWriteInOEMName_Txt__c))
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Fl_CompWriteInOEMName_Txt__c</errorDisplayField>
        <errorMessage>The Write In Competitor OEM Name field is used to provide the name of a Competitor OEM missing from the Competitor OEM Name field. It must be blank unless the &apos; Write In Competitor OEM Name&apos; option is selected in the Competitor OEM Name field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_FI_WriteIn_OEM_Restrict</fullName>
        <active>true</active>
        <description>The Write In OEM Field must be blank unless the &apos;Write In OEM Name&apos; option is selected in the OEM Name field.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Read_Only&apos;
),
OR(
ISNEW(),
ISCHANGED(Pricing_OEM_Name_FI_Nm__c),
ISCHANGED(Pricing_FI_Write_In_OEM_Name_Txt__c)
),
AND(
NOT(ISPICKVAL(Pricing_OEM_Name_FI_Nm__c , &apos;Write In OEM Name&apos;)),
NOT(ISBLANK(Pricing_FI_Write_In_OEM_Name_Txt__c))
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_FI_Write_In_OEM_Name_Txt__c</errorDisplayField>
        <errorMessage>The Write In OEM Name field is used to provide the name of an OEM missing from the OEM Name field. It must be blank unless the &apos;Write In OEM Name&apos; option is selected in the OEM Name field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_FeedbackReason_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL(Pricing_Quote_Program_Nm__c ,&apos;Tender&apos;),
OR(
ISNEW(),
ISCHANGED(Pricing_Reason_for_FeedBack_Txt__c),
ISCHANGED(Pricing_Recommendation_FeedBack_Nm__c)
),
AND(
ISPICKVAL(Pricing_Recommendation_FeedBack_Nm__c, &apos;Other – Please provide comments&apos;),
ISBLANK(Pricing_Reason_for_FeedBack_Txt__c)
))</errorConditionFormula>
        <errorMessage>When &apos;Other&apos; is selected in the AI Recommendation Feedback field, feedback must be entered in the Reason for Feedback field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_IntelScore_CompScore_validation</fullName>
        <active>true</active>
        <description>Intel Score and Comp Score must be greater than 0</description>
        <errorConditionFormula>AND(
ISPICKVAL(Pricing_Quote_Program_Nm__c , &apos;Tender&apos;),
ISPICKVAL(Pricing_Program_Type_Nm__c , &apos;Client&apos;) ,
OR(
ISCHANGED( Pricing_Comp_SKU_Performance_Nbr__c ),
ISCHANGED( Pricing_Intel_SKU_Performance_Nbr__c ),
ISNEW()),
OR(
Pricing_Intel_SKU_Performance_Nbr__c &lt;= 0, Pricing_Comp_SKU_Performance_Nbr__c &lt;= 0)
)</errorConditionFormula>
        <errorMessage>Intel Score and Comp Score must be greater than 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Intel_Write_In_Product_Restrict</fullName>
        <active>true</active>
        <description>The Write In Product field must be blank unless the &apos;Write In Product&apos; option is selected in the Product field.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Client_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Read_Only&apos;,
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;
),
OR(
ISNEW(),
ISCHANGED(Pricing_Product_Nm__c),
ISCHANGED(Pricing_Other_Product_Nm__c)
),
AND(
NOT(CONTAINS(Pricing_Product_Nm__r.Name , &apos;Write In Product&apos;)),
NOT(ISBLANK(Pricing_Other_Product_Nm__c))
)
)</errorConditionFormula>
        <errorDisplayField>Pricing_Other_Product_Nm__c</errorDisplayField>
        <errorMessage>The Write In Product field is used to provide the name of a product missing from the Product field. It must be blank unless the &apos;Write In Product&apos; option is selected in the Product field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_LostReason_Validation</fullName>
        <active>true</active>
        <description>When Won/Lost Status is set to Won, Lost Reason cannot be edited.</description>
        <errorConditionFormula>AND(
ISPICKVAL(Pricing_Quote_Program_Nm__c ,&apos;Tender&apos;),
OR(
ISCHANGED(Pricing_Lost_Reason_Nm__c),
ISCHANGED(Pricing_Quote_Line_Won_Lost_Status__c)
),
AND(
ISPICKVAL(Pricing_Quote_Line_Won_Lost_Status__c, &apos;Won&apos;),
NOT(ISPICKVAL(Pricing_Lost_Reason_Nm__c, &apos;&apos;))
))</errorConditionFormula>
        <errorMessage>Lost Reason can only be edited when Won/Lost Status is set to Lost.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_MyDealsMeetCompPrice_Validation</fullName>
        <active>true</active>
        <description>My Deals Meet Comp Price should be greater than zero.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager, 
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;
),
 Pricing_Meet_Comp_Price_Amt__c  &lt;= 0
)</errorConditionFormula>
        <errorMessage>My Deals Meet Comp Price must be greater than $0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_NumberofCPUperSystem_Validation</fullName>
        <active>true</active>
        <description>No. of CPUs per system cannot be less than or equal to zero.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;
),
Pricing_CPUs_per_system_qty__c  &lt;=0
)</errorConditionFormula>
        <errorMessage>No. of CPUs per system cannot be less than or equal to zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_NumberofDRAMperSystem_Validation</fullName>
        <active>true</active>
        <description>No. of DRAM per System cannot be less than or equal to zero.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_PMem_Quote_Line_Create&apos;
),
OR(
ISCHANGED(Pricing_DRAM_per_System_qty__c),
ISNEW()
),
Pricing_DRAM_per_System_qty__c &lt;=0
)</errorConditionFormula>
        <errorMessage>No. of DRAM per System cannot be less than or equal to zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_NumberofSystems_Validation</fullName>
        <active>true</active>
        <description>No. of Systems cannot be less than or equal to zero.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;),
Pricing_Systems_qty__c  &lt;=0
)</errorConditionFormula>
        <errorMessage>No. of Systems cannot be less than or equal to zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_NumberofUnitperSystem_Validation</fullName>
        <active>true</active>
        <description>No. of Units per system cannot be less than or equal to zero.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_PMem_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;
),
OR(
ISCHANGED(Pricing_Units_per_system_qty__c),
ISNEW()
),
Pricing_Units_per_system_qty__c  &lt;=0
)</errorConditionFormula>
        <errorMessage>No. of Units per system cannot be less than or equal to zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Other_Product_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Client_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Financial_Incentive_Quote_Line_Read_Only&apos;,
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;
),
OR(
	ISNEW(),
	ISCHANGED(Pricing_Product_Nm__c),
	ISCHANGED(Pricing_Other_Product_Nm__c)
),
	AND(
	NOT(ISNULL(Pricing_Product_Nm__c)),
	Pricing_Product_Nm__r.Name = &apos;Write In Product&apos;,
		ISBLANK(Pricing_Other_Product_Nm__c)
)
)</errorConditionFormula>
        <errorMessage>When &apos;Write In Product&apos; is selected in the Product field, the name of the unlisted product must be provided in the Write In Product field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Prevent_Save_DraftQLStatus_RPM</fullName>
        <active>false</active>
        <description>Validation Rule to prevent RPM User to edit a Draft Quote Line.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
ISPICKVAL(Pricing_Status_Nm__c,&quot;Draft&quot;),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;
))</errorConditionFormula>
        <errorMessage>Quote Line Record cannot be edited while in Draft Status for a RPM User.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Rebate_Per_Unit_Validation</fullName>
        <active>true</active>
        <description>Rebate Per Unit must be greater than 0.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Financial_Incentive_Regional_Pricing_Manager, 
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;), 
ISCHANGED(Pricing_FI_Net_RPU_Amt__c),
OR(ISBLANK(Pricing_FI_Net_RPU_Amt__c),
Pricing_FI_Net_RPU_Amt__c &lt;= 0)
)</errorConditionFormula>
        <errorDisplayField>Pricing_FI_Net_RPU_Amt__c</errorDisplayField>
        <errorMessage>Rebate Per Unit must be greater than 0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_ReqDiscountUnitPrice_Validation</fullName>
        <active>true</active>
        <description>Requested Unit Price must be greater than zero.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;,
RecordType.DeveloperName =&apos;Pricing_SSD_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_PMem_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Client_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Data_Center_GPU_Quote_Line_Create&apos;
),
Pricing_Req_Discounted_Unit_Price__c &lt;=0
)</errorConditionFormula>
        <errorDisplayField>Pricing_Req_Discounted_Unit_Price__c</errorDisplayField>
        <errorMessage>Requested Unit Price must be greater than zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Restrict_New_SVD_QuoteLines</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISNEW(), Pricing_New_Change_Request_cb__c = false, CONTAINS(TEXT(Pricing_Program_Type_Nm__c), $Label.Pricing_Tender_Small_Volume_Quote),NOT($CustomMetadata.Trigger_Execution__mdt.Pricing_SVD_QuoteLine_Disabled.Active__c))</errorConditionFormula>
        <errorMessage>Small Volume Quote Line creation is no longer supported.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SSD_Quantity_Validate</fullName>
        <active>true</active>
        <description>Quantity for SSD should always be greater than zero.</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName =&apos;Pricing_SSD_Quote_Line_Create&apos;,
RecordType.DeveloperName =&apos;Pricing_NIC_Quote_Line_Create&apos;,
RecordType.DeveloperName = &apos;Pricing_Client_Quote_Line_Create&apos;,
ISPICKVAL( Pricing_Quote_Program_Nm__c , &apos;Financial Incentive&apos;)),
OR(
ISCHANGED(Pricing_Total_Volume_Qty__c),
ISNEW()
),
Pricing_Total_Volume_Qty__c &lt;=0
)</errorConditionFormula>
        <errorDisplayField>Pricing_Total_Volume_Qty__c</errorDisplayField>
        <errorMessage>Quantity must be greater than zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_List_Unit_Price_update</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;), 
NOT($Permission.Pricing_SW_Update_QL_List_Unit_Price), OR(ISCHANGED(SBQQ__ListPrice__c),
ISBLANK(SBQQ__ListPrice__c),
AND(ISNEW(),NOT(SBQQ__ListPrice__c = SBQQ__OriginalPrice__c))))</errorConditionFormula>
        <errorMessage>Cannot Update List Unit Price</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_QL_Additional_Discount_0_100</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;), ISCHANGED(SBQQ__Discount__c), OR(SBQQ__Discount__c &lt; 0,SBQQ__Discount__c &gt; 1))</errorConditionFormula>
        <errorMessage>Additional Discount % should be in between 0 - 100.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_SW_QL_Quantity_Greaterthan_0</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(Pricing_Quote_Program_Nm__c, &apos;Software &amp; Services&apos;), OR(SBQQ__Quantity__c &lt; 1, ISNULL(SBQQ__Quantity__c)))</errorConditionFormula>
        <errorMessage>Quantity should be greater than or equals to 1.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Single_System_Price_Validation</fullName>
        <active>false</active>
        <description>Competitor Single System Price cannot be higher than Single System Price.</description>
        <errorConditionFormula>AND(
 OR(
 $RecordType.Name =&apos;Pricing Tender Quote Line - Create&apos;,
 $RecordType.Name =&apos;Pricing Tender Quote Line - Edit&apos;,
 $RecordType.Name =&apos;Pricing Tender Quote Line - Submitted&apos;,
 $RecordType.Name =&apos;Pricing Tender Quote Line - ReadOnly&apos;
),
Pricing_Comp_Single_System_Price_Amt__c  &gt;  Pricing_Single_System_Price_Amt__c,
 NOT( ISPICKVAL( Pricing_Status_Nm__c ,&apos;Revised&apos; ) ) 
)</errorConditionFormula>
        <errorMessage>Competitor Single System Price cannot be higher than Single System Price.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_TentativeECAPPrice_Validation</fullName>
        <active>false</active>
        <description>Tentative ECAP Price should be greater than zero.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Edit&apos;,
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;
),
Pricing_Tentative_ECAP_Price_Amt__c &lt;= 0
)</errorConditionFormula>
        <errorMessage>Tentative ECAP Price must be greater than $0.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_Write_in_performance_validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Pricing_Quote_Program_Nm__c ,&apos;Tender&apos;),
ISPICKVAL(Pricing_Program_Type_Nm__c ,&apos;Client&apos;),
OR(
ISNEW(),
ISCHANGED(Pricing_Performance_Metric_Nm__c),
ISCHANGED(Pricing_Write_In_Performance_Metric_Nm__c)
),
OR(
AND(
ISPICKVAL(Pricing_Performance_Metric_Nm__c, &apos;Write In Performance Metric&apos;),
ISBLANK(Pricing_Write_In_Performance_Metric_Nm__c)
),
AND(
NOT(ISPICKVAL(Pricing_Performance_Metric_Nm__c, &apos;Write In Performance Metric&apos;) ),
NOT(ISBLANK(Pricing_Write_In_Performance_Metric_Nm__c))
)
))</errorConditionFormula>
        <errorMessage>When &apos; Write In Performance Metric&apos; is selected in the Performance Metric Used field then the name must be provided in the &apos;Write In Performance Metric&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Pricing_editProductRestrictAfterDealSent</fullName>
        <active>true</active>
        <description>When Deal is Created,Product should not be editable.</description>
        <errorConditionFormula>AND(
$Permission.Pricing_Tender_Regional_Pricing_Manager,
ISPICKVAL(Pricing_Status_Nm__c,&quot;Pending Further Intel Review&quot;),
OR(
RecordType.DeveloperName =&apos;Pricing_Tender_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
),
NOT(ISBLANK(Pricing_Deal_RFQ_Id__c)),
OR(ISCHANGED(Pricing_Product_Nm__c ),ISCHANGED(Pricing_Other_Product_Nm__c))
)</errorConditionFormula>
        <errorMessage>Product cannot be edited after deal is created in My Deals.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Additional_discount_percent_or_amount</fullName>
        <active>true</active>
        <description>Validates additional discount is specified as a percentage or absolute amount but not both.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(SBQQ__Discount__c)), NOT(ISBLANK(SBQQ__AdditionalDiscountAmount__c)),NOT(SBQQ__Incomplete__c))</errorConditionFormula>
        <errorMessage>You may not specify additional discount as both percentage and absolute amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Invalid_Subscription_Term</fullName>
        <active>true</active>
        <description>Validates that subscription term is positive</description>
        <errorConditionFormula>IF( AND( NOT(ISNULL(SBQQ__SubscriptionTerm__c)), SBQQ__SubscriptionTerm__c &lt;= 0), TRUE, null)</errorConditionFormula>
        <errorMessage>The subscription term must be a positive number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Markup_percent_or_amount</fullName>
        <active>true</active>
        <description>Validates markup is specified as a percentage or absolute amount but not both.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(SBQQ__MarkupRate__c)), NOT(ISBLANK(SBQQ__MarkupAmount__c)),NOT(SBQQ__Incomplete__c))</errorConditionFormula>
        <errorMessage>You may not specify markup as both percentage and absolute amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__RecurringChargeTypeMustHaveBillingType</fullName>
        <active>true</active>
        <description>When Charge Type is Recurring, a Billing Type must be selected.</description>
        <errorConditionFormula>AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;Recurring&apos;), ISPICKVAL(SBQQ__BillingType__c, &apos;&apos;))</errorConditionFormula>
        <errorDisplayField>SBQQ__BillingType__c</errorDisplayField>
        <errorMessage>When Charge Type is Recurring, a Billing Type must be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Validate_billing_frequency</fullName>
        <active>true</active>
        <description>When Charge Type is One-Time, Billing Frequency must not be selected.</description>
        <errorConditionFormula>AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;One-Time&apos;), NOT(ISPICKVAL(SBQQ__BillingFrequency__c, &apos;&apos;)))</errorConditionFormula>
        <errorDisplayField>SBQQ__BillingFrequency__c</errorDisplayField>
        <errorMessage>When Charge Type is One-Time, a Billing Frequency value cannot be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Validate_billing_type</fullName>
        <active>true</active>
        <description>When Charge Type is One-Time or Usage, a Billing Type cannot be selected.</description>
        <errorConditionFormula>OR( 
AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;One-Time&apos;), NOT(ISPICKVAL(SBQQ__BillingType__c, &quot;&quot;))), 
AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;Usage&apos;), NOT(ISPICKVAL(SBQQ__BillingType__c, &quot;&quot;))))</errorConditionFormula>
        <errorDisplayField>SBQQ__BillingType__c</errorDisplayField>
        <errorMessage>When Charge Type is One-Time or Usage, a Billing Type value cannot be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_QuoteLine_OPN_for_Pre_Release</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISNEW(),
NOT($Permission.PSG_External_Disty ),
OR(
RecordType.DeveloperName = &apos;PSG_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;PSG_Quote_Line_Create&apos;
),
OR(
ISPICKVAL(SBQQ__Quote__r.core_cpq_quote_type_nm__c, &apos;Design Win&apos;),
ISPICKVAL( SBQQ__Quote__r.core_cpq_quote_type_nm__c , &apos;Transfer Pricing&apos;),
ISPICKVAL( SBQQ__Quote__r.core_cpq_quote_type_nm__c , &apos;Contract Pricing&apos;)),
OR(
NOT(core_cpq_product_nm__r.Core_Item_Orderable_Ind__c),
NOT(core_cpq_product_nm__r.IsActive),
NOT(core_cpq_product_nm__r.Core_Sales_Visible_Flag__c),
NOT( core_cpq_product_nm__r.Core_Item_Quotable_Ind__c)
)
)</errorConditionFormula>
        <errorMessage>Invalid Product selected for DW/Contract Pricing/Transfer Pricing Quote (Active = X,  Sales Visible Flag = X,  Quotable = X, Orderable = X)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_QuoteLine_Tools_OPN_for_Pre_Rel</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISNEW(),
NOT($Permission.PSG_External_Disty ),
OR(
RecordType.DeveloperName = &apos;PSG_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;PSG_Quote_Line_Create&apos;
),
ISPICKVAL( SBQQ__Quote__r.core_cpq_quote_type_nm__c , &apos;Tools&apos;),
OR(
NOT(core_cpq_product_nm__r.Core_Item_Orderable_Ind__c),
NOT(core_cpq_product_nm__r.IsActive),
NOT(core_cpq_product_nm__r.Core_Sales_Visible_Flag__c),
NOT( core_cpq_product_nm__r.Core_Item_Quotable_Ind__c)
)
)</errorConditionFormula>
        <errorDisplayField>core_cpq_dollar_change_flag_cb__c</errorDisplayField>
        <errorMessage>Invalid Product selected for Tools Quote(Active = X,  Sales Visible Flag = X,  Quotable = X, Orderable = X, FPGA Product Type = &apos;Tool&apos;)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>core_cpq_transferpricing_val</fullName>
        <active>false</active>
        <description>To validate the transfer pricing type with approved design win status as parent quote</description>
        <errorConditionFormula>AND(
OR(
RecordType.DeveloperName = &apos;PSG_Quote_Line_Submitted&apos;,
RecordType.DeveloperName = &apos;PSG_Quote_Line_Create&apos;
),
AND(ISPICKVAL(SBQQ__Quote__r.core_cpq_quote_type_nm__c,&apos;Transfer Pricing&apos;),ISBLANK(core_cpq_parent_quote__c)),
NOT( $Permission.PSG_External_Disty )

)</errorConditionFormula>
        <errorDisplayField>core_cpq_parent_quote__c</errorDisplayField>
        <errorMessage>The Transfer pricing quote should have a Parent Quote  associated  with it</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
