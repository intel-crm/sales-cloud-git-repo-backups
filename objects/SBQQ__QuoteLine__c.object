    <fields>
        <fullName>Pricing_Product_Nm__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Identifies the Intel product that is included with the quote. This is user entered in a free form field and the system will validate the information.</description>
        <inlineHelpText>Begin typing the Intel product to be used in the system. Hit enter for more options. If product is not listed (ex. future SKU), select the &apos;Write In Product&apos; option and type the name of the unlisted product in the &apos;Write In Product&apos; field below.</inlineHelpText>
        <label>Product</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>4 AND ((2 AND 3 AND 6 AND (5 OR 9 OR 1)) OR 7 OR 8)</booleanFilter>
            <filterItems>
                <field>Product2.Core_VerticalSegment__c</field>
                <operation>contains</operation>
                <value>Mobile,Desktop,Workstation,Embedded</value>
            </filterItems>
            <filterItems>
                <field>Product2.Core_Product_Type__c</field>
                <operation>contains</operation>
                <value>Processors,Partnered Products</value>
            </filterItems>
            <filterItems>
                <field>Product2.Core_Sales_Visible_Flag__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Product2.IsActive</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Product2.Core_Line_of_Business__c</field>
                <operation>contains</operation>
                <value>150134,152777,150214</value>
            </filterItems>
            <filterItems>
                <field>Product2.Core_Hierarchy_ID__c</field>
                <operation>equals</operation>
                <value>43</value>
            </filterItems>
            <filterItems>
                <field>Product2.Name</field>
                <operation>equals</operation>
                <value>Write In Product</value>
            </filterItems>
            <filterItems>
                <field>Product2.Core_IQR_Visible__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>Product2.Name</field>
                <operation>contains</operation>
                <value>Intel® Xeon®</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Quote Lines (Product)</relationshipLabel>
        <relationshipName>Quote_Lines</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
