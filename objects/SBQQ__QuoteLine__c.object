        <fullName>Pricing_Approved_End_Date_Dt__c</fullName>
        <description>Represents the date that the approved price quote that was approved by Intel expires.</description>
        <inlineHelpText>Approved end date of the tender pricing and last date consumption can happen.</inlineHelpText>
        <label>Approved Pricing End Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Pricing_Approved_End_Date_Dup_Dt__c</fullName>
        <description>Represents the date that the approved price quote that was approved by Intel expires.</description>
        <inlineHelpText>Approved end date of the tender pricing and last date consumption can happen.</inlineHelpText>
        <label>Approved Pricing End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Pricing_Approved_Rejected_Month_Txt__c</fullName>
        <externalId>false</externalId>
        <label>Approved/Rejected Month</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Approved_Rejected_Month__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(YEAR (DATEVALUE( Pricing_Last_Approved_Date_dt__c ))) +&apos;-&apos;+ CASE(MONTH(DATEVALUE( Pricing_Last_Approved_Date_dt__c )),
1, &apos;01&apos;,
2, &apos;02&apos;,
3, &apos;03&apos;,
4, &apos;04&apos;,
5, &apos;05&apos;,
6, &apos;06&apos;,
7, &apos;07&apos;,
8, &apos;08&apos;,
9, &apos;09&apos;,
10, &apos;10&apos;,
11, &apos;11&apos;,
12, &apos;12&apos;,
null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Approved/Rejected Month Old</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Approved_Rejected_Quarter__c</fullName>
        <externalId>false</externalId>
        <label>Approved/Rejected Quarter</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Approved_Start_Date_Dt__c</fullName>
        <description>Represents the date that the approved price quote that was approved by Intel begins.</description>
