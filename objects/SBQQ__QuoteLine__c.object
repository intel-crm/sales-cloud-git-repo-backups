    <fields>
        <fullName>Pricing_Ready_for_QuoteLetter_T_C_cb__c</fullName>
        <description>Checkbox to check if Quote Line T&amp;C is ready for Quote Letter generation. used for Filter Field in IQR Quote Letter T&amp;C Line Items.</description>
        <formula>if(OR(ISPICKVAL( Pricing_Program_Type_Nm__c , &quot;Financial Incentive&quot;),NOT(ISBLANK(Pricing_Deal_RFQ_Id__c))) &amp;&amp; ((TEXT(Pricing_Status_Nm__c) = &apos;Won&apos;) || (TEXT(Pricing_Status_Nm__c) = &apos;Approved&apos;) || (TEXT(Pricing_Status_Nm__c) = &apos;Cancelled&apos;)) &amp;&amp; Pricing_Is_Additional_T_C_Not_Blank_cb__c = TRUE , TRUE , FALSE )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ready for QuoteLetter T&amp;C</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Pricing_Ready_for_QuoteLetter_cb__c</fullName>
        <description>check box to check if Quote Line is ready for Quote Letter generation. used for Filter Field in IQR Quote Letter Line Items.</description>
        <formula>if( OR(ISPICKVAL( Pricing_Program_Type_Nm__c, &quot;Financial Incentive&quot;),NOT(ISBLANK(Pricing_Deal_RFQ_Id__c))) &amp;&amp; ((TEXT(Pricing_Status_Nm__c)  = &apos;Won&apos;)  || (TEXT(Pricing_Status_Nm__c)  = &apos;Approved&apos;) || (TEXT(Pricing_Status_Nm__c)  = &apos;Cancelled&apos;)) , TRUE , FALSE )</formula>
        <label>Ready for QuoteLetter</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Pricing_Ready_for_Review_cb__c</fullName>
        <defaultValue>false</defaultValue>
        <description>indicates quote line is ready for internal review.</description>
