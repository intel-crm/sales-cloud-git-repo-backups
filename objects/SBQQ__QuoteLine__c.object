                </value>
                <value>
                    <fullName>Price Change</fullName>
                    <default>false</default>
                    <label>Price Change</label>
                </value>
                <value>
                    <fullName>Volume Change</fullName>
                    <default>false</default>
                    <label>Volume Change</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
