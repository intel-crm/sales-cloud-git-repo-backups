        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_Competetor_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Represents the name of competitor&apos;s product. Refers to the products and offerings from the competitors- business organizations competing with Intel to capture the market share in a particular product class having similar products but differentiated in terms of price, benefits &amp; features provided. This field is entered in by the user and validated by the system.</description>
        <inlineHelpText>Begin typing product to be used in system for assumed competitive offering. Hit enter for more options. If product is not listed, select the &apos;Write In Product&apos; option and type the name of unlisted product in the &apos;Write In Competitor Product&apos; field.</inlineHelpText>
        <label>Competitor Product</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>((1 AND 2) OR (3 AND 4) OR (6 AND 7) OR 5)</booleanFilter>
            <filterItems>
                <field>$Source.Pricing_Program_Type_Nm__c</field>
                <operation>equals</operation>
                <value>Client, Financial Incentive</value>
            </filterItems>
            <filterItems>
                <field>Pricing_Competitor_Product__c.RecordTypeId</field>
                <operation>equals</operation>
                <value>Client</value>
            </filterItems>
            <filterItems>
                <field>$Source.Pricing_Program_Type_Nm__c</field>
                <operation>equals</operation>
                <value>Data Center Xeon® CPU, Small Volume Quotes - Data Center Xeon® CPU, Optane™ SSD, Optane™ PMem, Ethernet</value>
            </filterItems>
            <filterItems>
                <field>Pricing_Competitor_Product__c.RecordTypeId</field>
                <operation>equals</operation>
                <value>Data Center</value>
            </filterItems>
            <filterItems>
                <field>Pricing_Competitor_Product__c.Name</field>
                <operation>equals</operation>
                <value>Write In Product</value>
            </filterItems>
            <filterItems>
                <field>$Source.Pricing_Program_Type_Nm__c</field>
                <operation>equals</operation>
                <value>Data Center GPU</value>
            </filterItems>
            <filterItems>
                <field>Pricing_Competitor_Product__c.RecordTypeId</field>
                <operation>equals</operation>
                <value>Graphics</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Pricing_Competitor_Product__c</referenceTo>
        <relationshipLabel>Quote Lines</relationshipLabel>
        <relationshipName>Quote_Lines</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Pricing_Competitive_Bid_Discount_Pct__c</fullName>
        <formula>IF(Pricing_Comp_Total_without_discount_Amt__c=0,0,
Pricing_Comp_Additional_OEM_Disc_Amt__c / Pricing_Comp_Total_without_discount_Amt__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Competitor Additional Discount/Competitor Total without discount</inlineHelpText>
        <label>Competitive Bid Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
