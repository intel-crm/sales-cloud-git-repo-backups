        <externalId>false</externalId>
        <formula>Pricing_Competitor_Systems_Cnt__c  *  Pricing_Comp_CPUs_per_system_Cnt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Total assumed competitive number of units.</inlineHelpText>
        <label>Competitor Quantity</label>
