    <fields>
        <fullName>Pricing_SW_Additional_Disc__c</fullName>
        <formula>((((SBQQ__ListPrice__c/12)*SBQQ__EffectiveSubscriptionTerm__c ) - SBQQ__NetPrice__c) / ((SBQQ__ListPrice__c/12)*SBQQ__EffectiveSubscriptionTerm__c ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Additional Disc. (%)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Pricing_SW_Description_hyperlink__c</fullName>
        <label>Description</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>Pricing_SW_Exclude_Prepaid_Upfront__c</fullName>
        <description>Field used in Template content for Software &amp; Services Quote Program and PLI Quote Product Type. When Prepaid Upfront Discount is applied on Distributor discount field in Quote Line based on Billing Frequency and Effective Subscription term we are calculating List Total - Discount % - Partner Discount and not calculating Distributor discount field.</description>
        <formula>If(AND(ISPICKVAL(SBQQ__Quote__r.Pricing_Quote_Program_Nm__c,&quot;Software &amp; Services&quot;),SBQQ__EffectiveSubscriptionTerm__c &gt;= 36), ((SBQQ__ListTotal__c *(1 - SBQQ__Discount__c)) * (1- SBQQ__PartnerDiscount__c)), 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Exclude Prepaid Upfront</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Pricing_SW_Monthly_Price__c</fullName>
        <formula>(SBQQ__NetPrice__c/SBQQ__EffectiveSubscriptionTerm__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Monthly Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
