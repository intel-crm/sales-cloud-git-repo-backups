    <fields>
        <fullName>Pricing_Meet_Comp_Price_Amt__c</fullName>
        <description>Identifies the My Deals Meet Comp Price in US Dollars for specific quote line. This field is determined by the Regional Pricing Manager based on what is entered in the Competitor Product Information area. The Meet Comp Price listed is the price of the componenet vs. the price of the system.</description>
        <label>My Deals Meet Comp Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Pricing_Net_Comp_Bid_Price_Amt__c</fullName>
        <description>Represents the &quot;Competitor Total without Discount&quot; minus the &quot;Customer Discount.&quot;</description>
        <formula>Pricing_Comp_Total_without_discount_Amt__c  -  Pricing_Comp_Additional_OEM_Disc_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Competitor Total without Discount - Customer Discount (in US Dollars).</inlineHelpText>
        <label>Net Competitor Bid Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Pricing_Net_IA_Bid_Price_Amt__c</fullName>
        <description>Represents the &quot;Total Bid Without Discount&quot; less the &quot;Total Intel Discount&quot; and &quot;Additional Original Equipment Manufacturers (OEM) Discount&quot; in US dollars.</description>
        <formula>Pricing_Total_Bid_without_Discount_Amt__c  -  Pricing_Total_Intel_Discount_Amt__c  -   Pricing_Additional_OEM_Discount_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Total Bid without Discount - Total Requested Discounted - Additional Discount (in US Dollars).</inlineHelpText>
        <label>Net Intel Bid Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Pricing_New_Change_Request_cb__c</fullName>
        <formula>NOT(ISBLANK( Pricing_Reference_Quote_Line_Nbr__c ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>If checked, quote line represents a request to change the quantity, end date, and/or price.</inlineHelpText>
        <label>Change Request</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Pricing_New_Quantity_qty__c</fullName>
        <description>Represents the quantity requested if different than the tool calculated quantity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Total quantity of units if different than the current approved quantity.</inlineHelpText>
        <label>New Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_No_of_GPUs__c</fullName>
        <externalId>false</externalId>
        <formula>Pricing_No_of_GPUs_per_system_nbr__c * Pricing_Systems_qty__c</formula>
        <label>No. of GPUs</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_No_of_GPUs_per_system_nbr__c</fullName>
        <externalId>false</externalId>
        <label>No. of GPUs per system</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_OEM_Account_Nm__c</fullName>
        <externalId>false</externalId>
        <label>Account</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Pricing_OEM_Discount_Pct__c</fullName>
        <description>Represents the Additional Discount as a percentage of the total bid without CPUs included in the quote.</description>
        <formula>Pricing_Additional_OEM_Discount_Amt__c  / ( Pricing_Total_Bid_without_Discount_Amt__c  - ( Pricing_OEM_Standard_Unit_Price_Amt__c *  Pricing_Unit_Qty__c ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Additional Discount / (Total Bid without Discount-(Customer Standard Unit Price x Quantity))</inlineHelpText>
        <label>Customer Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Pricing_OEM_Name_FI_Nm__c</fullName>
        <label>OEM Name</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>PCC_Deal_OEM_Name</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Pricing_OEM_Name_FI__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL( Pricing_OEM_Name_FI_Nm__c , &apos;Write In OEM Name&apos;),Pricing_FI_Write_In_OEM_Name_Txt__c ,  TEXT(Pricing_OEM_Name_FI_Nm__c) )</formula>
        <label>Pricing FI OEM Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
