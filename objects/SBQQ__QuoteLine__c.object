        <externalId>false</externalId>
        <formula>SBQQ__Quote__r.Pricing_Account_Division_Nm__c</formula>
        <inlineHelpText>Selecting an Account Division limits the billings that can be used for this quote to those of the account divisions selected. Leaving Account Divisions blank means all billings are eligible for this quote.</inlineHelpText>
        <label>Account Division</label>
