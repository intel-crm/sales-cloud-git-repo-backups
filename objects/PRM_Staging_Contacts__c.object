    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Staging table to initially load the potential IPA Registrations coming from various Campaigns.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>PRM_Account_Id__c</fullName>
        <description>The Salesforce Id of the Account. This data comes from the data load file.</description>
        <externalId>false</externalId>
        <label>Account Id</label>
        <length>20</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup to the Account record. This is assigned after validating the Id value in &apos;Account Id&apos; field.</description>
        <label>SFDC Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>IPA Staging - Contacts</relationshipLabel>
        <relationshipName>IPA_Campaign_Registrations_Staging_Table</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
