    </fields>
    <fields>
        <fullName>Core_MDF_Previous_Closed_Quarter_nm__c</fullName>
        <description>This field stores the quarter on which the previous closed date lies</description>
        <externalId>false</externalId>
        <formula>IF( MONTH(DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c)) == 1 || MONTH(DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c)) == 2 || MONTH(DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c)) == 3 ,
&apos;Q1 &apos;+ TEXT(YEAR(DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c))) ,
IF( MONTH( DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c) ) == 4 || MONTH( DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c) ) == 5 || MONTH( DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c) ) == 6 ,
&apos;Q2 &apos;+ TEXT(YEAR(DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c))) ,
IF( MONTH( DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c) ) == 7 || MONTH( DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c) ) == 8 || MONTH( DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c) ) == 9 ,
&apos;Q3 &apos;+ TEXT(YEAR(DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c))) ,
IF(TEXT(YEAR(DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c))) &lt;&gt; &apos;&apos; , &apos;Q4 &apos;+ TEXT(YEAR(DATEVALUE(Core_MDF_Case_Id__r.Core_MDF_Previous_Closed_Dt__c))) , &apos;&apos;))))</formula>
        <label>Previous Closed Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Process_Feedback_Comments_Txt__c</fullName>
        <description>Process Feedback Comments</description>
        <label>Process Feedback Comments</label>
        <length>32768</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Quarter__c</fullName>
        <externalId>false</externalId>
        <formula>IF( MONTH(DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate))) == 1 || MONTH(DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate))) == 2 || MONTH(DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate))) == 3 ,
&apos;Q1 &apos;+  TEXT(YEAR(DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate))))  , 
IF( MONTH( DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate)) ) == 4 || MONTH( DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate) )) == 5 || MONTH( DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate)) ) == 6 ,
&apos;Q2 &apos;+ TEXT(YEAR(DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate))))  , 
IF( MONTH( DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate)) ) == 7 || MONTH( DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate)) ) == 8 || MONTH( DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate)) ) == 9 ,
&apos;Q3 &apos;+ TEXT(YEAR(DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate))))  , 
IF(TEXT(YEAR(DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate))))  &lt;&gt; &apos;&apos; , &apos;Q4 &apos;+ TEXT(YEAR(DATEVALUE(TEXT(Core_MDF_Case_Id__r.ClosedDate)))) , &apos;&apos;))))</formula>
        <label>Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Recommended_investigation_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Recommend For Investigation</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Redaction_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Redaction</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Right_to_Recover_Amt__c</fullName>
        <description>Stores the Recovery Amount in USD</description>
        <formula>Core_MDF_Case_Id__r.Core_MDF_Right_to_Recover_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Right to Recover (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Score_Nbr__c</fullName>
        <description>Score of the Scorecard</description>
        <externalId>false</externalId>
        <formula>VALUE( TEXT(Core_MDF_Engagement_Nbr__c)) * VALUE( TEXT(Core_MDF_Attribution_Nbr__c)) *  VALUE( TEXT(Core_MDF_POP__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Support_Advice_Ind__c</fullName>
        <description>Process Feedback for Scorecard</description>
        <label>Support Advice</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Variance_Nm__c</fullName>
        <description>Variance field on Scorecard</description>
        <label>Variance</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>N/A</fullName>
                    <default>false</default>
                    <label>N/A</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Virtual_Corp_Account_Id__c</fullName>
        <description>Used to store the Virtual Corp Account Id</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Core_MDF_Case_Id__r.Account.Core_MDF_Virtual_Corp_Account_Id__c), CASESAFEID(Core_MDF_Case_Id__r.AccountId), CASESAFEID(Core_MDF_Case_Id__r.Account.Core_MDF_Virtual_Corp_Account_Id__c) )</formula>
        <label>Virtual Corp Account</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Virtual_Corp_Account_nm__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Core_MDF_Case_Id__r.Account.Core_MDF_Virtual_Corp_Account_Id__c), CASESAFEID(Core_MDF_Case_Id__r.Account.Name), CASESAFEID(Core_MDF_Case_Id__r.Account.Core_MDF_Virtual_Corp_Account_Id__r.Name) )</formula>
        <label>Virtual Corp Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Weighted_PV_Amt__c</fullName>
        <description>Used to calculate weighted PV amount for Partial score of Attribution, POP, Engagement</description>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(Core_MDF_Quarter__c)), IF(ISPICKVAL( Core_MDF_Attribution_Nbr__c , &apos;1&apos; ), (IF( (ISPICKVAL(Core_MDF_Attribution_PV_Ind__c , &apos;H&apos;)) , 8, 
IF((ISPICKVAL(Core_MDF_Attribution_PV_Ind__c , &apos;M&apos;)), 4, 0))) *  Core_MDF_Claim_Amt__c  , 0) +


IF(ISPICKVAL(  Core_MDF_POP__c  , &apos;1&apos; ), (IF( (ISPICKVAL( Core_MDF_POP_PV_Ind__c  , &apos;H&apos;)) , 8, IF((ISPICKVAL(Core_MDF_POP_PV_Ind__c , &apos;M&apos;)), 4, 0))) *  Core_MDF_Claim_Amt__c  , 0) +


IF(ISPICKVAL(  Core_MDF_Engagement_Nbr__c  , &apos;1&apos; ), (IF( (ISPICKVAL( Core_MDF_Engagement_PV_Ind__c  , &apos;H&apos;)) , 8, IF((ISPICKVAL(Core_MDF_Engagement_PV_Ind__c , &apos;M&apos;)), 4, 0))) *  Core_MDF_Claim_Amt__c  , 0) , 0)</formula>
        <label>Weighted PV Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Scorecard</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>ScoreCard-{00000}</displayFormat>
        <label>Scorecard Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Scorecards</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Manual_Recovery_Amt_Check</fullName>
        <active>true</active>
        <description>Manual Recovery Amount (USD) cannot exceed Requested Amount (USD) - Excess Requested Amount (USD)</description>
        <errorConditionFormula>Core_MDF_Manual_Recovery_Amount_USD_Amt__c &gt;  
(Core_MDF_Case_Id__r.Core_MDF_Requested_Amount_USD_Amt__c  -  (IF(ISNULL(Core_MDF_Case_Id__r.Core_MDF_Excess_Requested_Amt__c),0,Core_MDF_Case_Id__r.Core_MDF_Excess_Requested_Amt__c)))</errorConditionFormula>
        <errorMessage>Manual Recovery Amount (USD) cannot exceed Requested Amount (USD) - Excess Requested Amount (USD)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Manual_Recovery_Amt_Neg_Check</fullName>
        <active>true</active>
        <description>Manual Recovery Amount should not be negative.</description>
        <errorConditionFormula>Core_MDF_Manual_Recovery_Amount_USD_Amt__c &lt; 0</errorConditionFormula>
        <errorMessage>Enter positive numeric values.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
