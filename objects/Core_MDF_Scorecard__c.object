                    <fullName>Credit/Debit Memo</fullName>
                    <default>false</default>
                    <label>Credit/Debit Memo</label>
                </value>
                <value>
                    <fullName>Invoice/Receipt</fullName>
                    <default>false</default>
                    <label>Invoice/Receipt</label>
                </value>
                <value>
                    <fullName>Non-financial document</fullName>
                    <default>false</default>
                    <label>Non-financial document</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_POP_Comments_Txt__c</fullName>
        <description>POP Comments on Scorecard</description>
        <label>POP Comments</label>
        <length>32768</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_POP_PV_Ind__c</fullName>
        <label>POP PV</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
