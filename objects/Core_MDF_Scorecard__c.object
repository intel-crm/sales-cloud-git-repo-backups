            <valueSetName>Core_MDF_PV</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_POP__c</fullName>
        <description>Stores the POP Scores</description>
        <label>POP</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
