    <fields>
        <fullName>Core_MDF_Max_Possible_Amt__c</fullName>
        <description>Used to calculate Max Possible Amount for Partial scores.</description>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(Core_MDF_Quarter__c)), ((IF( ISPICKVAL(Core_MDF_Attribution_Nbr__c,&apos;1&apos;), 1, 0 ) + IF(  ISPICKVAL( Core_MDF_POP__c ,&apos;1&apos;), 1, 0 ) + IF( ISPICKVAL(Core_MDF_Engagement_Nbr__c,&apos;1&apos;) , 1, 0 )) *  Core_MDF_Claim_Amt__c * 8) , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Max Possible Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
