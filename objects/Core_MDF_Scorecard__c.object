    <fields>
        <fullName>Core_MDF_Case_Id__c</fullName>
        <label>Case</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 OR 2</booleanFilter>
            <filterItems>
                <field>Case.RecordTypeId</field>
                <operation>equals</operation>
                <value>Audit</value>
            </filterItems>
            <filterItems>
                <field>Case.RecordTypeId</field>
                <operation>equals</operation>
                <value>Audit Closed</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Case</referenceTo>
        <relationshipLabel>Scorecards</relationshipLabel>
        <relationshipName>Scorecards</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_Amt__c</fullName>
        <description>Reference of Claim Amount from Score Card</description>
        <formula>(Core_MDF_Case_Id__r.Core_MDF_Claim_Lookup_Id__r.Core_MDF_Requested_Reimbursement_Amt__c -  Core_MDF_Case_Id__r.Core_MDF_Claim_Lookup_Id__r.Core_MDF_Excess_Requested_Amount__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Claim Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
