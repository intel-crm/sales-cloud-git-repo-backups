        <inlineHelpText>Manual recovery (MR) amount. What this means for you: this amount will be recovered.</inlineHelpText>
        <label>Manual Recovery Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
