    <fields>
        <fullName>Core_MDF_BU_Amount_Nbr__c</fullName>
        <description>Store the amount split by multiplying the split % with claims amount defined on Activity</description>
        <externalId>false</externalId>
        <label>Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_BU_Split_Percent__c</fullName>
        <description>Split % of BU as defined on the Activity</description>
        <label>Split %</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Core_MDF_BU_Txt__c</fullName>
        <description>BU of the Split record</description>
        <externalId>false</externalId>
        <label>Business Unit (BU)</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Type_Txt__c</fullName>
        <description>Formula field to store Claim&apos;s budget type</description>
        <externalId>false</externalId>
        <formula>TEXT(Core_MDF_Claim__r.Core_MDF_Budget_Type_Options_Nm__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Budget Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim__c</fullName>
        <description>This field links the parent Claim to individual Business unit split record</description>
        <label>Claim</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipLabel>Amount Split by BU</relationshipLabel>
        <relationshipName>Claim_BU_Split</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <label>Amount Split by BU</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>{00000}</displayFormat>
        <label>Amount Split by BU Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Amount Split by BU</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
