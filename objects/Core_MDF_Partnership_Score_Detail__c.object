        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Recovery_Account_nm__c</fullName>
        <externalId>false</externalId>
        <formula>IF( NOT(ISBLANK(Core_MDF_Node_Account_Id__c)), Core_MDF_Node_Account_Id__r.Name, Core_MDF_Account_nm__c  )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Recovery Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Recovery_Offset_Amt__c</fullName>
        <description>Used to hold Offset amount that&apos;s entered by Payment Admin in Claim Recovery page. Currently allowed only for RMF PRC region</description>
        <inlineHelpText>Payment Admin can set Recovery Offset for PRC RSA MD Recoveries only</inlineHelpText>
        <label>Recovery Offset Amount (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Recovery_Offset_Comments_txt__c</fullName>
        <description>Used to get the comments from Payment admin while doing Recovery Offset</description>
        <label>Recovery Offset Comments</label>
        <length>10000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Region_Cd__c</fullName>
        <label>Region</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>APJ</fullName>
                    <default>false</default>
                    <label>APJ</label>
                </value>
                <value>
                    <fullName>ASMO</fullName>
                    <default>false</default>
                    <label>ASMO</label>
                </value>
                <value>
                    <fullName>EMEA</fullName>
                    <default>false</default>
                    <label>EMEA</label>
                </value>
                <value>
                    <fullName>PRC</fullName>
                    <default>false</default>
                    <label>PRC</label>
                </value>
                <value>
                    <fullName>WW</fullName>
                    <default>false</default>
                    <label>WW</label>
                </value>
                <value>
                    <fullName>INDIA</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>INDIA</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_Amt__c</fullName>
        <label>Total Recovery Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_Claim_Amt__c</fullName>
        <description>Sum of Claim Amount with Active Indicator as TRUE</description>
        <label>Total Claim Amount</label>
        <summarizedField>Core_MDF_Recovery_Dashboard__c.Core_MDF_Claim_Amt__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Is_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_MDF_Recovery_Dashboard__c.Core_MDF_Partnership_Score_Detail_Id__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_Manual_Recovery_Amt__c</fullName>
        <description>Sum of Manual Recovery Amount other than Score 0 with Active Indicator as TRUE</description>
        <label>Total Manual Recovery Amount</label>
        <summarizedField>Core_MDF_Recovery_Dashboard__c.Core_MDF_Manual_Recovery_Amount_USD_Amt__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Score_Nbr__c</field>
            <operation>notEqual</operation>
            <value>0</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Is_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_MDF_Recovery_Dashboard__c.Core_MDF_Partnership_Score_Detail_Id__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_PV0_Amt__c</fullName>
        <description>Sum of Score 0 records with active indicator as TRUE</description>
        <label>Total PV0 Amount</label>
        <summarizedField>Core_MDF_Recovery_Dashboard__c.Core_MDF_Claim_Amt__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Score_Nbr__c</field>
            <operation>equals</operation>
            <value>0</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Is_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_MDF_Recovery_Dashboard__c.Core_MDF_Partnership_Score_Detail_Id__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_PV1_Amt__c</fullName>
        <description>Sum of Score 1 records with active indicator as TRUE</description>
        <label>Total PV1 Amount</label>
        <summarizedField>Core_MDF_Recovery_Dashboard__c.Core_MDF_Claim_Amt__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Score_Nbr__c</field>
            <operation>equals</operation>
            <value>1</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Is_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_MDF_Recovery_Dashboard__c.Core_MDF_Partnership_Score_Detail_Id__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_PV2_Amt__c</fullName>
        <description>Sum of Score 2 records with active indicator as TRUE</description>
        <label>Total PV2 Amount</label>
        <summarizedField>Core_MDF_Recovery_Dashboard__c.Core_MDF_Claim_Amt__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Score_Nbr__c</field>
            <operation>equals</operation>
            <value>2</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Core_MDF_Recovery_Dashboard__c.Core_MDF_Is_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_MDF_Recovery_Dashboard__c.Core_MDF_Partnership_Score_Detail_Id__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Total_Recovery_Amt__c</fullName>
        <description>Manual Recovery Amount + PV 0 Amount + Pv1 and PV2 Amount based on Petty Rule Indicator</description>
        <formula>Core_MDF_Total_Manual_Recovery_Amt__c + Core_MDF_Total_PV0_Amt__c + IF( Core_MDF_Partnership_Score_Id__r.Core_MDF_Petty_Rule_Applied_Ind__c , 0 , (Core_MDF_Total_PV1_Amt__c * Core_MDF_Partnership_Score_Id__r.Core_MDF_PV1_Percentage_nbr__c /100) + (Core_MDF_Total_PV2_Amt__c * Core_MDF_Partnership_Score_Id__r.Core_MDF_PV2_Percentage_nbr__c /100))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Recovery Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <label>Partnership Score Detail</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Core_MDF_Partnership_Score_Id__c</columns>
        <columns>Core_MDF_Budget_Type_Nm__c</columns>
        <columns>Core_MDF_Region_Cd__c</columns>
        <columns>Core_MDF_Total_Recovery_Amt__c</columns>
        <columns>Core_MDF_Carry_Over_Amt__c</columns>
        <columns>Core_MDF_Recovered_Amt__c</columns>
        <columns>Core_MDF_Balance_Amount_Amt__c</columns>
        <columns>Core_MDF_Program_Nm__c</columns>
        <columns>Core_MDF_Account_Id__c</columns>
        <columns>Core_MDF_Quarter_Year_Nm__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_MDF_Program_Nm__c</field>
            <operation>contains</operation>
            <value>Retail Marketing Funds</value>
        </filters>
        <filters>
            <field>Core_MDF_Account_Id__c</field>
            <operation>contains</operation>
            <value>Yandex</value>
        </filters>
        <filters>
            <field>Core_MDF_Budget_Type_Nm__c</field>
            <operation>equals</operation>
            <value>RSA MD</value>
        </filters>
        <filters>
            <field>Core_MDF_Region_Cd__c</field>
            <operation>equals</operation>
            <value>PRC</value>
        </filters>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>PS - Detail {0000000}</displayFormat>
        <label>PS Detail</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Partnership Score Details</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Non_Editable_Fields_on_Update</fullName>
        <active>true</active>
        <errorConditionFormula>AND( NOT(ISNEW()),  OR(ISCHANGED(Core_MDF_Region_Cd__c),ISCHANGED( Core_MDF_Budget_Type_Nm__c )))</errorConditionFormula>
        <errorMessage>Fields cannot be updated (Budget Type, Region)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Required_Fields</fullName>
        <active>false</active>
        <errorConditionFormula>AND( ISNEW() ,  OR(ISPICKVAL(Core_MDF_Region_Cd__c, &apos;&apos;), AND( Core_MDF_Program_Nm__c != &apos;Service Provider CoMarketing Fund&apos;,Core_MDF_Program_Nm__c != &apos;Client CoMarketing Fund Boost&apos;,ISPICKVAL(Core_MDF_Budget_Type_Nm__c, &apos;&apos;)) ))</errorConditionFormula>
        <errorMessage>Required Fields (Region, Budget Type)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_External_Id</fullName>
        <active>false</active>
        <errorConditionFormula>AND( NOT( ISNEW() ) ,(Core_MDF_External_ID__c &lt;&gt; ( CASESAFEID(Core_MDF_Partnership_Score_Id__r.Core_MDF_Channel_Program_Id__c) + CASESAFEID(Core_MDF_Partnership_Score_Id__r.Core_MDF_Account_Id__c) + text(Core_MDF_Partnership_Score_Id__r.Core_MDF_Quarter_Year_Nm__c) + text(Core_MDF_Budget_Type_Nm__c)+text(Core_MDF_Region_Cd__c ))))</errorConditionFormula>
        <errorDisplayField>Core_MDF_External_ID__c</errorDisplayField>
        <errorMessage>External Id is INVALID</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
