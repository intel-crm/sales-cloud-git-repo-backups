    <fields>
        <fullName>Core_MDF_Quarter_Year_Nm__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Core_MDF_Partnership_Score_Id__r.Core_MDF_Quarter_Year_Nm__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Quarter Year</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Recovered_Amt__c</fullName>
        <defaultValue>0.00</defaultValue>
        <label>Recovered Amount</label>
        <precision>18</precision>
