        <fullName>Core_MDF_Program_Nm__c</fullName>
        <externalId>false</externalId>
        <formula>Core_MDF_Partnership_Score_Id__r.Core_MDF_Channel_Program_txt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
