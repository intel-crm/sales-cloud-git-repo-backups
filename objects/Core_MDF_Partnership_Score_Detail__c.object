        <description>Used to track history of the Recovery Offset Comments field</description>
        <label>Offset Comment Detail</label>
        <length>131072</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Partnership_Score_Detail_Id__c</fullName>
