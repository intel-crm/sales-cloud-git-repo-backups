    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Channel_Program_id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup to Program to get the Program Id</description>
        <label>Channel Program</label>
        <referenceTo>ChannelProgram</referenceTo>
        <relationshipLabel>Partnership Score Details</relationshipLabel>
        <relationshipName>Partnership_Score_Details</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Account_Id__c</fullName>
        <description>Account Id from Parent</description>
        <externalId>false</externalId>
        <formula>Core_MDF_Partnership_Score_Id__r.Core_MDF_Account_Id__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Account_nm__c</fullName>
        <externalId>false</externalId>
        <formula>Core_MDF_Partnership_Score_Id__r.Core_MDF_Virtual_Corp_Account_Id__r.Core_MDF_Parent_Fund_Account__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Balance_Amount_Amt__c</fullName>
        <description>(Total Recovery Amount + Carry Over Amount) - Recovered Amount</description>
        <formula>((Core_MDF_Total_Recovery_Amt__c +  Core_MDF_Carry_Over_Amt__c ) - (Core_MDF_Recovered_Amt__c + Core_MDF_Recovery_Offset_Amt__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Balance Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Balance_Amt__c</fullName>
        <description>Total + Carry Over - Recovered Amt</description>
        <formula>((Core_MDF_Total_Recovery_Amt__c + Core_MDF_Carry_Over_Amt__c) -  (Core_MDF_Recovered_Amt__c + Core_MDF_Recovery_Offset_Amt__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Balance Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Type_Nm__c</fullName>
        <label>Budget Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Budget_Types</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Carry_Over_Amt_Mismatch_Ind__c</fullName>
        <formula>Core_MDF_Carry_Over_Amt__c &lt;&gt; Core_MDF_Partnership_Score_Detail_Id__r.Core_MDF_Balance_Amount_Amt__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Carry Over Amt Mismatch</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Carry_Over_Amt__c</fullName>
        <defaultValue>0.00</defaultValue>
        <label>Carry Over Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_External_ID__c</fullName>
        <caseSensitive>false</caseSensitive>
