    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Check_for_valid_time</fullName>
        <active>true</active>
        <description>Check for valid time in ##:## AM/PM</description>
        <errorConditionFormula>NOT( 
OR( 
REGEX( Core_Account_Meeting_Items_Date_and_Time__c , &quot;[\\d]{1,2}:[0-5]{1}[0-9] [APap][mM]{1}&quot;) 
, 
REGEX( Core_Account_Meeting_Items_Date_and_Time__c, &quot;[\\d]{1,2}:[0-5]{1}[0-9][APap][mM]{1}&quot;) 
) 
)</errorConditionFormula>
        <errorDisplayField>Core_Account_Meeting_Brief__c</errorDisplayField>
        <errorMessage>Please format the time in ##:## AM/PM</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
