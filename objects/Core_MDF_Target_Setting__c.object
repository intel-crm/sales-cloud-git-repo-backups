        <description>Rollup summary field for showing the active Spending Targets Versions Amount</description>
        <label>Spending Targets Amount</label>
        <summarizedField>Core_MDF_Spending_Targets_Version__c.Core_MDF_Amount_amt__c</summarizedField>
        <summaryFilterItems>
            <field>Core_MDF_Spending_Targets_Version__c.Core_MDF_Is_Active_Ind__c</field>
            <operation>equals</operation>
