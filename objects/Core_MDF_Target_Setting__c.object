    <validationRules>
        <fullName>Core_MDF_EndDateLessThanStartDate</fullName>
        <active>true</active>
        <errorConditionFormula>Core_MDF_End_Date__c &lt; Core_MDF_Start_Date__c</errorConditionFormula>
        <errorDisplayField>Core_MDF_End_Date__c</errorDisplayField>
        <errorMessage>End Date should always be greater than or equal to Start Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ProgramChangeRestriction</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED( Core_MDF_Program_Name__c )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Program_Name__c</errorDisplayField>
        <errorMessage>Program cannot be updated</errorMessage>
    </validationRules>
