    <validationRules>
        <fullName>CPT_Prevent_Fname_Update</fullName>
        <active>false</active>
        <description>Prevent First Name update</description>
        <errorConditionFormula>ISCHANGED(  CPT_First_Name__c )</errorConditionFormula>
        <errorDisplayField>CPT_First_Name__c</errorDisplayField>
        <errorMessage>Field not editable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_Lname_Update</fullName>
        <active>false</active>
        <description>Prevent Last Name update</description>
        <errorConditionFormula>ISCHANGED(  CPT_Last_Name__c )</errorConditionFormula>
        <errorDisplayField>CPT_Last_Name__c</errorDisplayField>
        <errorMessage>Field not editable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Prevent_WWID_Update</fullName>
        <active>true</active>
        <description>Prevent WWID update</description>
        <errorConditionFormula>ISCHANGED( CPT_Employee_WWID__c )</errorConditionFormula>
        <errorDisplayField>CPT_Employee_WWID__c</errorDisplayField>
        <errorMessage>Field not editable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CPT_Restrict_Update_OnLockedRecord</fullName>
        <active>true</active>
        <description>Prevent update when the quota period is Hard Locked.</description>
        <errorConditionFormula>AND
(
NOT( $Permission.CPT_IT_Admin_System_Admin_Permission ),
TEXT( CPT_Quota_Period__r.CPT_Locked_Status__c ) = &apos;Hard Lock&apos;
)</errorConditionFormula>
        <errorMessage>This record is locked. Contact Commissions Admin with questions.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
