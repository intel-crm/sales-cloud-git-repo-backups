    </fields>
    <fields>
        <fullName>Core_Completed_Time__c</fullName>
        <description>The time the event being logged completed (if applicable).</description>
        <label>Completed Time</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_Completed__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(Core_Completed_Time__c)), 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Completed</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
