    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Source-of-truth mapping between the backend Rev Segment value stored on PartnerMarketingBudget and the friendly Budget Rev Segment label/Profit Center shown in the UI. New segments can be added here (e.g. via Data Import from Excel) without any picklist/metadata changes; Core_MDF_RevenueSegmentMappingTrigger automatically syncs active rows into the Core_MDF_Budget_Rev_Segment global picklist value set.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Only Active rows are synced into the Core_MDF_Budget_Rev_Segment global value set and offered in the Revenue Segment dropdown.</description>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Budget_Rev_Segment__c</fullName>
        <description>The friendly label shown in the Revenue Segment dropdown on the Budget screen UI, e.g. &quot;CCPG CPU Notebook - 2214&quot;.</description>
        <externalId>false</externalId>
        <label>Budget Rev Segment</label>
        <length>120</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Profit_Center_Name__c</fullName>
        <externalId>false</externalId>
        <label>Profit Center Name</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Profit_Center_Number__c</fullName>
        <externalId>false</externalId>
        <label>Profit Center #</label>
        <length>20</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Program__c</fullName>
        <defaultValue>&quot;Co-Inv&quot;</defaultValue>
        <description>Scopes this mapping row to a specific Budget program, e.g. Co-Inv.</description>
        <externalId>false</externalId>
        <label>Program</label>
        <length>40</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Revenue Segment Mapping</label>
    <nameField>
        <label>Rev Segment</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Revenue Segment Mappings</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
