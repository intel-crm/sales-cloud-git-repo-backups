    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>To add Notes related to CCP Objects</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_Activity_id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>To populate activity on which Notes is being created.</description>
        <label>Co-Marketing Activity</label>
        <referenceTo>PartnerFundRequest</referenceTo>
        <relationshipName>Notes</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Claim_id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>To populate Claim on which Notes is being created.</description>
        <label>Claim</label>
        <referenceTo>PartnerFundClaim</referenceTo>
        <relationshipName>Notes</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Comments_txt__c</fullName>
        <description>To add comments on the Notes.</description>
        <label>Comments</label>
        <length>131072</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Program_Name_nm__c</fullName>
        <description>To populate field with program name of activity or claim associated to Notes, this field is used to share record from sharing rule</description>
        <label>Program Name</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Technical_Program_Name</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Title_txt__c</fullName>
        <description>To Add title for the Notes</description>
        <label>Title</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <label>Internal Notes</label>
    <nameField>
        <displayFormat>Notes-{0000}</displayFormat>
        <label>Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Internal Notes</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Check_Notes_without_actiorclaim</fullName>
        <active>true</active>
        <description>Validate that while Creating/Editing either one of activity or claim is selected.</description>
        <errorConditionFormula>OR(AND( ISBLANK(Core_MDF_Activity_id__c ),ISBLANK( Core_MDF_Claim_id__c )),
AND( NOT(ISBLANK(Core_MDF_Activity_id__c )),NOT(ISBLANK( Core_MDF_Claim_id__c ))))</errorConditionFormula>
        <errorMessage>Please select either Activity or Claim to create/edit a Note.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
