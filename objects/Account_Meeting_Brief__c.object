    <fields>
        <fullName>Core_Account_Brief_Grid_PPT__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;https://composer.congamerge.com&quot; 
+ &quot;?SessionId=&quot; + $Api.Session_ID 
+ &quot;&amp;ServerUrl=&quot; + $Api.Partner_Server_URL_290 
+ &quot;&amp;Id=&quot; + Id 
+ &quot;&amp;QueryId=[Attendees]a0ho0000001kgmL?pv0=&quot; + Id 
+ &quot;&amp;QueryId=[Agenda]a0ho0000001kgmQ?pv0=&quot; + Id 
+ &quot;&amp;QueryId=[Objectives]a0ho0000001kgmV?pv0=&quot; + Id 
+ &quot;&amp;TemplateId=a0io0000004Dc4Q&quot; 

+ &quot;&amp;OFN= Account Brief for &quot; + SUBSTITUTE(Account__r.Name, &quot;&amp;&quot;, &quot;{~~~}&quot; ) + &quot;-&quot; + &quot; published for &quot; + 

CASE( MONTH(TODAY()) , 
1, &quot;Jan&quot;, 
2, &quot;Feb&quot;, 
3, &quot;Mar&quot;, 
4, &quot;Apr&quot;, 
5, &quot;May&quot;, 
6, &quot;Jun&quot;, 
7, &quot;Jul&quot;, 
8, &quot;Aug&quot;, 
9, &quot;Sep&quot;, 
10, &quot;Oct&quot;, 
11, &quot;Nov&quot;, 
12, &quot;Dec&quot;, 
&quot;None&quot;) 

+ text(DAY(TODAY()))+ &quot;,&quot; + text(YEAR(TODAY())) 
+ &quot;&amp;SC0=1&quot; 
+ &quot;&amp;SC1=Attachments&quot; 
+ &quot;&amp;DS7=13&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Brief Grid PPT</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Account_Brief_Word_GridAction__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;https://composer.congamerge.com&quot; 
+ &quot;?SessionId=&quot; + $Api.Session_ID 
+ &quot;&amp;ServerUrl=&quot; + $Api.Partner_Server_URL_290 
+ &quot;&amp;Id=&quot; + Id 
+ &quot;&amp;QueryId=[Attendees]a0ho0000001kgmL?pv0=&quot; + Id 
+ &quot;&amp;QueryId=[Agenda]a0ho0000001kgmQ?pv0=&quot; + Id 
+ &quot;&amp;QueryId=[Objectives]a0ho0000001kgmV?pv0=&quot; + Id 
+ &quot;&amp;TemplateId=a0io0000004DbxQ&quot; 

+ &quot;&amp;OFN= Account Brief for &quot; + SUBSTITUTE(Account__r.Name, &quot;&amp;&quot;, &quot;{~~~}&quot; ) + &quot;-&quot; + &quot; published for &quot; + 

CASE( MONTH(TODAY()) , 
1, &quot;Jan&quot;, 
2, &quot;Feb&quot;, 
3, &quot;Mar&quot;, 
4, &quot;Apr&quot;, 
5, &quot;May&quot;, 
6, &quot;Jun&quot;, 
7, &quot;Jul&quot;, 
8, &quot;Aug&quot;, 
9, &quot;Sep&quot;, 
10, &quot;Oct&quot;, 
11, &quot;Nov&quot;, 
12, &quot;Dec&quot;, 
&quot;None&quot;) 

+ text(DAY(TODAY()))+ &quot;,&quot; + text(YEAR(TODAY())) 
+ &quot;&amp;SC0=1&quot; 
+ &quot;&amp;SC1=Attachments&quot; 
+ &quot;&amp;DS7=13&quot;</formula>
        <label>Account Brief Grid Word</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
