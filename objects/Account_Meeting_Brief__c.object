    <validationRules>
        <fullName>Check_Time_format</fullName>
        <active>true</active>
        <description>checks for time format</description>
        <errorConditionFormula>NOT(
   OR(
     REGEX( Core_Account_Meeting_Time__c , &quot;[\\d]{1,2}:[0-5]{1}[0-9] [APap][mM]{1}&quot;)
     ,
     REGEX( Core_Account_Meeting_Time__c , &quot;[\\d]{1,2}:[0-5]{1}[0-9][APap][mM]{1}&quot;)
     )
)</errorConditionFormula>
        <errorDisplayField>Core_Account_Meeting_Time__c</errorDisplayField>
        <errorMessage>Time format need to be HH:MM AM/PM.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_if_event_is_empty</fullName>
        <active>true</active>
        <description>Checks to see if an event drop down is empty and tells user to fill in other location</description>
        <errorConditionFormula>ISBLANK(TEXT(Core_Account_Brief_Event__c ))= TRUE</errorConditionFormula>
        <errorDisplayField>Core_Account_Meeting_Location__c</errorDisplayField>
        <errorMessage>Please fill in the location for this meeting.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_time</fullName>
        <active>true</active>
        <description>This is used to formate the end time in HH:MM AM/PM</description>
        <errorConditionFormula>NOT(
OR(
REGEX( Core_Account_Meeting_End_Time__c, &quot;[\\d]{1,2}:[0-5]{1}[0-9] [APap][mM]{1}&quot;)
,
REGEX( Core_Account_Meeting_End_Time__c, &quot;[\\d]{1,2}:[0-5]{1}[0-9][APap][mM]{1}&quot;)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Account_Meeting_End_Time__c</errorDisplayField>
        <errorMessage>Time format need to be HH:MM AM/PM.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Account_AMB</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Account__c != &apos;&apos;,
Account__r.RecordType.DeveloperName != &apos;Mastered_Account&apos;
)
)</errorConditionFormula>
        <errorMessage>Only Intel Account is permitted on this field. Please select Intel Account and retry again.</errorMessage>
    </validationRules>
