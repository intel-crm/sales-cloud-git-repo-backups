        <queue>Core_IPS_Org2_090</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <nameField>
        <displayFormat>ABM-{00000}</displayFormat>
        <label>Account Meeting Brief ID</label>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Meeting Briefs</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Account__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Core_Account_Meeting_Customer_Contact__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Core_Account_Meeting_Date__c</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>Account__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Core_Account_Meeting_Customer_Contact__c</lookupDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>Account__c</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>Core_Account_Meeting_Customer_Contact__c</lookupPhoneDialogsAdditionalFields>
        <searchResultsAdditionalFields>Account__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Core_Account_Meeting_Customer_Contact__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <sharingReasons>
        <fullName>Account_Team_Member__c</fullName>
        <label>Account Team Member</label>
    </sharingReasons>
    <validationRules>
        <fullName>Check_Time_format</fullName>
        <active>true</active>
        <description>checks for time format</description>
        <errorConditionFormula>NOT(
   OR(
     REGEX( Core_Account_Meeting_Time__c , &quot;[\\d]{1,2}:[0-5]{1}[0-9] [APap][mM]{1}&quot;)
     ,
     REGEX( Core_Account_Meeting_Time__c , &quot;[\\d]{1,2}:[0-5]{1}[0-9][APap][mM]{1}&quot;)
     )
)</errorConditionFormula>
        <errorDisplayField>Core_Account_Meeting_Time__c</errorDisplayField>
        <errorMessage>Time format need to be ##:## am/pm.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_if_event_is_empty</fullName>
        <active>true</active>
        <description>Checks to see if an event drop down is empty and tells user to fill in other location</description>
        <errorConditionFormula>ISBLANK(TEXT(Core_Account_Brief_Event__c ))= TRUE</errorConditionFormula>
        <errorDisplayField>Core_Account_Meeting_Location__c</errorDisplayField>
        <errorMessage>Please fill in the location for this meeting.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_Account_Brief_Word</fullName>
        <availability>online</availability>
        <description>Generates a word document for the account brief</description>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Account Brief - Word</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>https://composer.congamerge.com
?SessionId={!API.Session_ID}
&amp;ServerUrl={!API.Partner_Server_URL_290}
&amp;Id={!Account_Meeting_Brief__c.Id}
&amp;QueryId=[Attendees]a0ho0000001kgmL?pv0={!Account_Meeting_Brief__c.Id}
&amp;QueryId=[Agenda]a0ho0000001kgmQ?pv0={!Account_Meeting_Brief__c.Id}
&amp;QueryId=[Objectives]a0ho0000001kgmV?pv0={!Account_Meeting_Brief__c.Id}
&amp;TemplateId=a0io0000004DbxQ

&amp;OFN= Account Brief for +{!Account.Name}+-+ published for + 

{!CASE( MONTH(TODAY()) , 
   1, &quot;Jan&quot;,
   2, &quot;Feb&quot;,
   3, &quot;Mar&quot;,
   4, &quot;Apr&quot;,
   5, &quot;May&quot;,
   6, &quot;Jun&quot;,
   7, &quot;Jul&quot;,
   8, &quot;Aug&quot;,
   9, &quot;Sep&quot;,
   10, &quot;Oct&quot;,
   11, &quot;Nov&quot;,
   12, &quot;Dec&quot;,
   &quot;None&quot;)
}
+ {!DAY(TODAY())}+, +{!YEAR(TODAY())}

&amp;DS7=1</url>
    </webLinks>
