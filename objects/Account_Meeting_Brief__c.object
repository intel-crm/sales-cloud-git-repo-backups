    <fields>
        <fullName>Existing_Opportunity_1_Risk_Reason__c</fullName>
        <description>US71113 - Update Account Briefs with At Risk Info</description>
        <externalId>false</externalId>
        <formula>IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;Application Enablement/Software Tuning&quot;), &quot;Application Enablement/Software Tuning&quot; + BR(), NULL) +

IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;Competition&quot;), &quot;Competition&quot; + BR(), NULL)    + 

IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;Legal&quot;), &quot;Legal&quot; + BR(), NULL)    + 

IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;MAG Account Escalation&quot;), &quot;MAG Account Escalation&quot; + BR(), NULL)    + 

IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;Other&quot;), &quot;Other&quot; + BR(), NULL)    + 

IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;Pricing&quot;), &quot;Pricing&quot; + BR(), NULL)    + 

IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;Product Mod/Special SKU&quot;), &quot;Product Mod/Special SKU&quot; + BR(), NULL)    + 

IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;Supply&quot;), &quot;Supply&quot; + BR(), NULL)    + 

IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;Supply with adjacency impact&quot;), &quot;Supply with adjacency impact&quot; + BR(), NULL)    + 

IF(INCLUDES( Core_Brief_Existing_Opportunity_1__r.Core_Risk_Reason__c , &quot;Technical Expertise&quot;), &quot;Technical Expertise&quot; + BR(), NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This is the Risk Reason for the Selected Opportunity</inlineHelpText>
        <label>Opportunity 1 Risk Reason</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
