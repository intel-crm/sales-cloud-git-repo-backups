    <fields>
        <fullName>Core_Recommendations_Available_New__c</fullName>
        <description>Indicates whether or not any NEW &quot;Account Recommendations&quot; are available for this account. (As a COUNT of the number of child objects, which will always be 0 or 1 with the current design.) &quot;New&quot; means they haven&apos;t been viewed yet. Created initially for the SMART What integration.</description>
        <label>Recommendations Available New</label>
        <summaryFilterItems>
            <field>Core_Account_Recommendations__c.Core_Recommendations_Viewed__c</field>
            <operation>equals</operation>
            <value>False</value>
        </summaryFilterItems>
        <summaryForeignKey>Core_Account_Recommendations__c.Core_Account__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_Recommendations_Available__c</fullName>
        <description>Indicates whether or not any &quot;Account Recommendations&quot; are available for this account. (As a COUNT of the number of child objects, which will always be 0 or 1 with the current design.) Created initially for the SMART What integration.</description>
        <label>Recommendations Available</label>
        <summaryForeignKey>Core_Account_Recommendations__c.Core_Account__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Core_Recommendations_Indicator__c</fullName>
        <description>Image and link to show when &quot;Account Recommendations&quot; are available for this account. Leverages the rollup summary field that counts the child records. Created initially for the SMART What integration.</description>
        <externalId>false</externalId>
        <formula>IF(Core_Recommendations_Available_New__c &gt; 0,
   HYPERLINK(&quot;/apex/Core_AccountRecommendations?AccountId=&quot; &amp; Id,
     IMAGE(&quot;/servlet/servlet.FileDownload?file=015o0000001g4s9&quot;, &quot;New Recommendations Available!&quot;),
     &quot;_self&quot;),
   IF(Core_Recommendations_Available__c &gt; 0,
     HYPERLINK(&quot;/apex/Core_AccountRecommendations?AccountId=&quot; &amp; Id,
       IMAGE(&quot;/servlet/servlet.FileDownload?file=015o0000001g4sO&quot;, &quot;Recommendations Available&quot;),
       &quot;_self&quot;),
   &quot;No recommendations available&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product Recommendations</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
