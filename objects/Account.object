        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(Core_Deactivated__c=FALSE, 
NOT(ISBLANK(Core_Deactivation_Reason__c)),
$RecordType.DeveloperName &lt;&gt; &quot;Core_Partner_Account_Group&quot; 
) 
)</errorConditionFormula>
        <errorMessage>Please clear  deactivation reason.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Disable_WOM_When_B2B</fullName>
        <active>true</active>
        <description>WOM Access for ODM can&apos;t be edited when B2B is true on the Account.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
ISCHANGED( Core_IsODM__c ) &amp;&amp;  (Core_B2B_Entitlement__c = true)

)</errorConditionFormula>
        <errorMessage>WOM Access for ODM can&apos;t be edited when B2B Entitlement is checked on the Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Industry_ToBeDefined</fullName>
        <active>true</active>
        <description>When the Industry is To be defined or blank, dont allow the user to edit the account after taking the ownership of the account</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
NOT(ISNEW()),
OwnerId &lt;&gt; $Label.Core_Uncovered_Account_ID,
NOT(ISCHANGED(OwnerId)),
Core_Owner_Changed_From_Uncovered__c = true,
OR(TEXT(Industry) = Null,TEXT(Industry)=&apos;To Be Defined&apos;),
$Profile.Name &lt;&gt; &quot;Integration&quot;,
$RecordType.DeveloperName = &quot;Mastered_Account&quot;)
)</errorConditionFormula>
        <errorMessage>Please select an Industry and Sub Industry immediately after taking ownership.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Limit_Account_English_Name_Length</fullName>
        <active>true</active>
        <description>Limit the length of Account English Name due to ERPM restrictions.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
LEN( Core_English_Only_Name__c ) &gt; 129
)</errorConditionFormula>
        <errorMessage>English Only Name cannot be longer than 129 characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Limit_Account_Legal_Name_Length</fullName>
        <active>true</active>
        <description>Used to limit Account Legal Name Length since ERPM has length restrictions.L</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
LEN( Core_Account_Legal_Name__c ) &gt; 129

)</errorConditionFormula>
        <errorMessage>Account Legal Name cannot be longer than 129 characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Limit_Account_Name_Length</fullName>
        <active>true</active>
        <description>Limits length of Account Name field since the length is restricted in ERPM.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
LEN(Name) &gt; 129

)</errorConditionFormula>
        <errorMessage>Account name cannot be longer than 129 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Account_Hierarchy_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>IF(ISCHANGED(Core_MDF_Parent_Fund_Account__c),
AND(RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;, ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Retail Marketing Funds&apos;),
Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = &apos;Mastered_Account&apos;,
TEXT($User.UserType)!= $Label.Core_MDF_Partner_User_Type),
AND(RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;, ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Retail Marketing Funds&apos;),
Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = &apos;Mastered_Account&apos;)
)</errorConditionFormula>
        <errorMessage>Account nodes cannot be created beyond three levels of hierarchy</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Auto_Transfer_Validation</fullName>
        <active>true</active>
        <description>1) For Co Marketing Accounts, Both fields should be available &quot;Enable Auto Transfer&quot; and &quot;Auto Transfer Account&quot;.
2) For Retail Accounts Auto Transfer Functionality is not applicable.</description>
        <errorConditionFormula>IF(RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name &amp;&amp; 
((Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Retail_Program_Name &amp;&amp; (Core_MDF_Enabled_Auto_Transfer__c || NOT(ISBLANK(Core_MDF_Auto_Transfer_Account__c )))) || ((Core_MDF_Enabled_Auto_Transfer__c &amp;&amp; ISBLANK(Core_MDF_Auto_Transfer_Account__c)) || (!Core_MDF_Enabled_Auto_Transfer__c &amp;&amp; NOT(ISBLANK(Core_MDF_Auto_Transfer_Account__c )))))
,true,false)</errorConditionFormula>
        <errorMessage>Auto transfer may not be applicable for this account; When applicable ensure enable auto transfer and auto transfer from account are selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ParentFundAccountNotEditable</fullName>
        <active>true</active>
        <description>This Validation Rule ensures that the Parent Fund Account Field should not be changed once it is assigned to an Account</description>
        <errorConditionFormula>ISCHANGED( Core_MDF_Parent_Fund_Account__c )</errorConditionFormula>
        <errorMessage>Parent account cannot be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Parent_Hierarchy_Account</fullName>
        <active>true</active>
        <description>Node should only have direct parent hierarchy details .if it select siblings should through Error</description>
        <errorConditionFormula>AND(
Core_MDF_Channel_Program__r.Name &lt;&gt; $Label.Core_MDF_Retail_Program_Name, 
$RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,
Core_MDF_Enabled_Auto_Transfer__c  = True, 
Core_MDF_Auto_Transfer_Account__r.Id &lt;&gt; NULL ,
Core_MDF_Auto_Transfer_Account__r.Id != Core_MDF_Parent_Fund_Account__r.Id, Core_MDF_Auto_Transfer_Account__r.Id != Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Id )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Auto_Transfer_Account__c</errorDisplayField>
        <errorMessage>This account is not available for Auto Transfer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventInactiveAccountAsPFA</fullName>
        <active>true</active>
        <description>This validation rule will prevent Inactive account in parent fund account.</description>
        <errorConditionFormula>AND(ISNEW(), Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,Core_MDF_Parent_Fund_Account__r.Core_MDF_Active_Ind__c = FALSE)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Parent_Fund_Account__c</errorDisplayField>
        <errorMessage>The Parent Account selected is Inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RMF_Geo_SubGeo_Validation</fullName>
        <active>true</active>
        <description>1) Geo is Mandatory for Retail Accounts 2) If Intel Account has Geo and Sub Geo, then Virtual Corp should follow the same 3) Geo and Sub Geo over Account Nodes should be same as parent account. 4) If Geo is &quot;AMSO&quot;, Sub geo should be either &quot;LAR&quot; or &quot;NAR&quot;</description>
        <errorConditionFormula>IF(
(RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name &amp;&amp; Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Retail_Program_Name),
IF(
ISPICKVAL(Core_Geo__c, &apos;&apos;),TRUE,
IF(
OR(ISCHANGED(Core_Geo__c),
AND(NOT(ISBLANK(PRIORVALUE(Core_Sub_Geo__c))),ISCHANGED(Core_Sub_Geo__c))),TRUE,
IF(
(!ISPICKVAL(Core_MDF_Parent_Fund_Account__r.Core_Geo__c, &apos;&apos;) &amp;&amp;( TEXT(Core_MDF_Parent_Fund_Account__r.Core_Geo__c) &lt;&gt; TEXT(Core_Geo__c) ) ||
(!ISPICKVAL(Core_MDF_Parent_Fund_Account__r.Core_Sub_Geo__c, &apos;&apos;) &amp;&amp; (TEXT( Core_MDF_Parent_Fund_Account__r.Core_Sub_Geo__c) &lt;&gt; TEXT(Core_Sub_Geo__c)))||
(Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name &amp;&amp; (TEXT( Core_MDF_Parent_Fund_Account__r.Core_Sub_Geo__c) &lt;&gt; TEXT(Core_Sub_Geo__c)))),TRUE,
IF(
ISPICKVAL(Core_Geo__c, &apos;ASMO&apos;) &amp;&amp; NOT(ISBLANK(TEXT(Core_Sub_Geo__c))) &amp;&amp; CONTAINS($Label.Core_MDF_ASMO_SubGeo, TEXT(Core_Sub_Geo__c)),FALSE,
IF(ISPICKVAL(Core_Geo__c, &apos;PRC&apos;) &amp;&amp; (ISBLANK(TEXT(Core_Sub_Geo__c)) || CONTAINS($Label.Core_MDF_PRC_SubGeo, TEXT(Core_Sub_Geo__c))),FALSE,
IF(ISPICKVAL(Core_Geo__c, &apos;APJ&apos;) &amp;&amp; (ISBLANK(TEXT(Core_Sub_Geo__c)) || CONTAINS($Label.Core_MDF_APJ_SubGeo, TEXT(Core_Sub_Geo__c))),FALSE,IF(ISPICKVAL(Core_Geo__c, &apos;EMEA&apos;) &amp;&amp; (ISBLANK(TEXT(Core_Sub_Geo__c)) || CONTAINS($Label.Core_MDF_EMEA_SubGeo, TEXT(Core_Sub_Geo__c))),FALSE,TRUE))))))),
FALSE)</errorConditionFormula>
        <errorMessage>Please select region. Region and sub region values selected should be the same as that on the parent account. Once selected, region and sub region values cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Owner_Change_On_Uncovered</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(OwnerId),
NOT(ISNEW()),
PRIORVALUE(OwnerId) = $Label.Core_Uncovered_Account_ID,
OwnerId &lt;&gt; $Label.Core_Uncovered_Account_ID,
OR(
ISPICKVAL( Core_Customer_Aggregation_Type__c , &quot;null&quot;)
),
OR(TEXT(Industry) = Null,TEXT(Industry)=&apos;To Be Defined&apos;),
$Profile.Name &lt;&gt; &quot;Integration&quot;,
$RecordType.DeveloperName &lt;&gt; &quot;Mastered_Account&quot;
)
)</errorConditionFormula>
        <errorMessage>Please fill in an Industry value apart from &quot;To Be Defined&quot; before changing the ownership of this account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_ParentAcc_Check_On_DirectAcc</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
OR(
AND(
Core_Account_Record_Type__c ==&apos;Direct Account&apos;,
ISNEW(),
ParentId &lt;&gt; null,
Parent.RecordType.Name &lt;&gt; &apos;Intel Account&apos;
),
AND(
Core_Account_Record_Type__c ==&apos;Direct Account&apos;,
NOT(ISNEW()),
ISCHANGED(ParentId),
ParentId &lt;&gt; null,
Parent.RecordType.Name &lt;&gt; &apos;Intel Account&apos;
)
)
)</errorConditionFormula>
        <errorMessage>Only Intel Accounts can be selected as Parent Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_AE_User_Account_Name_Edit</fullName>
        <active>true</active>
        <description>Don&apos;t allow A&amp;E Users to edit Account Name unless they are an A&amp;E Super User.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
$Profile.Id = &apos;00eg0000000MIT0&apos; &amp;&amp;  $Permission.Allow_Account_Name_Field_Edit = false &amp;&amp;
ISCHANGED( Name )

)</errorConditionFormula>
        <errorMessage>A&amp;E Users can&apos;t edit Account Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_AnEAccountOwner_Assign</fullName>
        <active>true</active>
        <description>Prevent “A&amp;E Account Owner” being assigned as an account owner</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(ISCHANGED(OwnerId),
OwnerId = &apos;005o0000004M7SF&apos;
)
)</errorConditionFormula>
        <errorDisplayField>Ownership</errorDisplayField>
        <errorMessage>&apos;A&amp;E Account Owner&apos; can&apos;t be assigned as an account owner.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Duplicate_Account</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
Core_Is_Duplicate__c != &apos;&apos;,
OR(
Core_Is_Duplicate__r.RecordType.DeveloperName = &apos;Core_Direct_Account&apos;,
Core_Is_Duplicate__r.RecordType.DeveloperName = &apos;Rejected_Account&apos;,
Core_Is_Duplicate__r.RecordType.DeveloperName = &apos;Requested_Account&apos;
)
)
)</errorConditionFormula>
        <errorMessage>Direct, Requested or Rejected Account Record Types are not permissible on this field. Please choose the Intel Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Non_PSG_Usr_Account_Fields</fullName>
        <active>true</active>
        <description>Prevent non PSG and PSG users from modifying PSG data (Direct Account)</description>
        <errorConditionFormula>IF(($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE  || $Profile.Name ==&apos;System Administrator&apos; || $Profile.Name ==&apos;IT Admin&apos; || $Profile.Name ==&apos;Integration&apos;)
,FALSE,
( 
Not(ISNEW()) &amp;&amp;
AND(RecordType.Name=&apos;Direct Account&apos;, 
OR(
ischanged(Name) ||
ischanged(BillingAddress) ||
ischanged(BillingCity) ||
ischanged(BillingCountry) ||
ischanged(BillingCountry) ||
ischanged(BillingCountryCode) ||
ischanged(BillingGeocodeAccuracy) ||
ischanged(BillingLatitude) ||
ischanged(BillingLongitude) ||
ischanged(BillingPostalCode) ||
ischanged(BillingState) ||
ischanged(BillingStateCode) ||
ischanged(BillingStreet))
)
)
)</errorConditionFormula>
        <errorMessage>You cannot edit PSG data</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_Non_PSG_Usr_IAccount_Fields</fullName>
        <active>false</active>
        <description>Prevent non-PSG users from modifying PSG data (Intel Account with PSG Downstream)</description>
        <errorConditionFormula>IF(($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE  || $Profile.Name ==&apos;System Administrator&apos; || $Profile.Name ==&apos;IT Admin&apos;)
,FALSE,
(
NOT(($Permission.PSG_Master_Data_Read_Access || $Permission.PSG_Master_Data_Read_Write_Access ||
$Permission.PSG_Account_Contact_Read_Write_Access || $Permission.PSG_Account_Contact_Super_Admin || $Permission.PSG_Product_Super_Admin
|| $Permission.PSG_Product_Read_Write_Access)) &amp;&amp;

AND(RecordType.Name=&apos;Intel Account&apos; &amp;&amp; Core_PSG_Account__c) ) )</errorConditionFormula>
        <errorMessage>You cannot edit PSG data</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_PSGU_Non_PSG_Account_Fields</fullName>
        <active>true</active>
        <description>Prevent PSG Users from editing Non-PSG data</description>
        <errorConditionFormula>IF(($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE  || $Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass_Account_Flow__c=TRUE || $Profile.Name ==&apos;System Administrator&apos; || $Profile.Name ==&apos;IT Admin&apos; || $Profile.Name ==&apos;Integration&apos;)
,FALSE,
(
 Not(ISNEW()) &amp;&amp;
($Permission.PSG_Master_Data_Read_Write_Access ||
$Permission.PSG_Account_Contact_Read_Write_Access || $Permission.PSG_Account_Contact_Super_Admin || $Permission.PSG_Product_Super_Admin
|| $Permission.PSG_Product_Read_Write_Access) &amp;&amp;

NOT(ischanged(Core_Account_Owner__c) || ischanged(Core_Opportunity_Revenue_for_Account__c)) &amp;&amp;
AND(Not(RecordType.Name=&apos;Direct Account&apos;) &amp;&amp; !(Core_PSG_Account__c) &amp;&amp;
(
!ischanged(Core_Direct_Account_Id__c) ||
!ischanged(Core_Direct_Incoterm_Dsc__c) ||
!ischanged(Core_Direct_Account_Type_Nm__c) ||
!ischanged(Core_Direct_Shipping_Condition_Nm__c) ||
!ischanged(Core_Direct_Sales_Organization_Nm__c) ||
!ischanged(Core_Direct_Distributor_Channel_Nm__c) ||
!ischanged(Core_Direct_Ship_To_End_Customer_Id__c) ||
!ischanged(Core_Direct_Payment_Term_Nm__c) ||
!ischanged(Core_Direct_Shipping_Instruction_Txt__c) ||
!ischanged(Core_Direct_Account_Name_Txt__c) ||
!ischanged(Core_Direct_Parent_Account_Tier_Nm__c) ||
!ischanged(Core_Direct_Primary_Account_Id__c) ||
!ischanged(Core_Direct_Legal_Parent_Id__c) ||
!ischanged(Core_Direct_Account_Active_Ind__c) ||
!ischanged(Core_Direct_Pricing_Parent_Id__c)
)
)
)
)</errorConditionFormula>
        <errorMessage>You cannot edit non-PSG records, Please contact the support team for any access related help</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PricingParent_LegalParent</fullName>
        <active>true</active>
        <errorConditionFormula>IF(($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE||$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass_Account_Flow__c=TRUE),FALSE,
AND(Core_Direct_Pricing_Parent_Id__c!=&apos;&apos;, Core_Direct_Legal_Parent_Id__c==&apos;&apos;)
)</errorConditionFormula>
        <errorMessage>Please populate legal parent</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Change_Account_Owner</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(OwnerId),
(BEGINS($Label.Core_Uncovered_Account_ID, PRIORVALUE(OwnerId))),
OwnerId &lt;&gt; $Label.Core_Uncovered_Account_ID,
OR( $RecordType.DeveloperName = &quot;End_Customer_Deal_Account&quot;,
$RecordType.DeveloperName = &quot;Rejected_Account&quot;,
$RecordType.DeveloperName = &quot;Requested_Account&quot;
)
)
)</errorConditionFormula>
        <errorMessage>Account Owner cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_Edit_Business_Org_Type</fullName>
        <active>true</active>
        <description>Any other Sales profiles should be able to add value to this field during create only. Once created the sales profiles should not be able to edit it. </description>
        <errorConditionFormula>AND(
NOT(ISNEW()),
NOT(ISBLANK(PRIORVALUE(Core_Account_Type__c))),
ISCHANGED(Core_Account_Type__c),
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;IT Admin&quot;,
$Profile.Name &lt;&gt; &quot;Cloud CRM BSA-Pre Prod&quot;,
$Profile.Name &lt;&gt; &quot;Data Ops&quot;,
$Profile.Name &lt;&gt; &quot;Integration&quot;,
$Profile.Name &lt;&gt; &quot;CCP - Core Access&quot;,
$Profile.Name &lt;&gt; &quot;IPA A&amp;E User&quot;,
RecordType.Name&lt;&gt;&apos;CoMarketing&apos;,
RecordType.Name&lt;&gt;&apos;Intel Ultimate Account&apos;

)</errorConditionFormula>
        <errorMessage>Formerly Account Type, indicates the company purpose, how they define themselves in the market. If you need to update this multi-select field, please log an AAQ and provide your value(s). The available LOVs are posted at goto/bizorgtypeLOV.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Restrict_PSG_Downstream</fullName>
        <active>true</active>
        <description>To Restrict from editing PSG Downstream field with different owner</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
ISCHANGED(Core_PSG_Account__c),
PRIORVALUE(OwnerId) &lt;&gt; $User.Id,
(!BEGINS($Profile.Name, $Label.Core_System_Admin_Profile_Name)),
(!BEGINS($Profile.Name, $Label.Core_Production_Support_Profile_Name)),
(!BEGINS($Profile.Name, $Label.Core_Data_Ops_Profile_Name))
)
)</errorConditionFormula>
        <errorDisplayField>Core_PSG_Account__c</errorDisplayField>
        <errorMessage>You cannot edit PSG Downstream field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Sales_Grp_Preview_DataOps_Editable</fullName>
        <active>false</active>
        <description>If the field Sales Group Preview has a value, then this can be edited by the Data ops &amp; Admin.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
 AND(
 NOT(ISBLANK(TEXT(PRIORVALUE(Core_Sales_Group_Preview__c)))),
 ischanged(Core_Sales_Group_Preview__c),
 (!($Profile.Name == &apos;Data Ops&apos; || $Profile.Name == &apos;System Administrator&apos;) || Owner.Id == $User.Id)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Group_Preview__c</errorDisplayField>
        <errorMessage>Sales Group Preview can be edited by Data Ops.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Embargo_country_validation</fullName>
        <active>true</active>
        <errorConditionFormula>Core_Not_an_Embargoed_Country__c = true</errorConditionFormula>
        <errorMessage>This registration was denied because the registrant identified their location as an embargoed country or their IP address is from an embargoed country.For more information please visit https://goto.intel.com/gec-sanctioned-country-info</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LID__Check_CompanyId_Value</fullName>
        <active>true</active>
        <description>Throws an exception message if the company id contains non-numerics</description>
        <errorConditionFormula>AND(
	(LID__LinkedIn_Company_Id__c &lt;&gt; NULL),
	NOT(ISNUMBER(LID__LinkedIn_Company_Id__c))
)</errorConditionFormula>
        <errorDisplayField>LID__LinkedIn_Company_Id__c</errorDisplayField>
        <errorMessage>CompanyId should be a numeric value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LID__Check_Company_Id_Value</fullName>
        <active>true</active>
        <description>Throws an exception message if the company id contains non-numerics</description>
        <errorConditionFormula>AND(
	(LID__LinkedIn_Company_Id__c &lt;&gt; NULL),
	NOT(ISNUMBER(LID__LinkedIn_Company_Id__c))
)</errorConditionFormula>
        <errorDisplayField>LID__LinkedIn_Company_Id__c</errorDisplayField>
        <errorMessage>CompanyId should be a numeric value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Limit_DSS_Users</fullName>
        <active>false</active>
        <description>Bypass DSS Users, IT Admin, System Administrator and Jeff Peet.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
OR( 
ISNEW(), 
ISCHANGED( Core_Sales_Groups__c ) 
), 
TEXT(Core_Sales_Groups__c )=&apos;DCG Sales Group - Direct System Sales&apos;, 
NOT ($Profile.Name ==&apos;System Administrator&apos;|| $Profile.Name ==&apos;IT Admin&apos;||$User.Id=&apos;005o0000001fV6u&apos;) 
))</errorConditionFormula>
        <errorMessage>The &quot;DCG Sales Group - Direct System Sales&quot; Sales Group can only be selected by DSS team members.  If you feel you&apos;ve received this message in error, please submit an AAQ.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Limiting_the_sales_group_values</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
 $Profile.Name &lt;&gt; &apos;Data Ops&apos;,
 NOT( ISBLANK(Text( Core_Sales_Groups__c))),
 Text(Core_Sales_Groups__c)&lt;&gt;&apos;EMEA Partner Holding&apos;,
 Text(Core_Sales_Groups__c)&lt;&gt;&apos;Americas Partner Holding&apos;,
 Text(Core_Sales_Groups__c)&lt;&gt;&apos;APJ Partner Holding&apos;,
 Text(Core_Sales_Groups__c)&lt;&gt;&apos;PRC Partner Holding&apos;,
 Text(Core_Sales_Groups__c)&lt;&gt;&apos;Undefined&apos;
)</errorConditionFormula>
        <errorMessage>This Value is only for Data ops Profile. Please Select any of these value mention below Americas Partner Holding
EMEA Partner Holding
APJ Partner Holding
PRC Partner Holding
Undefined</errorMessage>
    </validationRules>
