        <fullName>Core_CPM_ID_message__c</fullName>
        <description>CPM ID - displays either message or one CPM ID</description>
        <externalId>false</externalId>
        <formula>if(Contains(Core_CPM_ID_255__c, &quot;,&quot;), &quot;There are multiple CPM IDs&quot;,Core_CPM_ID_255__c)</formula>
