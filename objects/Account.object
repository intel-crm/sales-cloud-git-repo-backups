        <fullName>Core_Is_Duplicate__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Indicator to duplicat account</description>
        <inlineHelpText>System generated field that displays an account with the same name and address as the created account at the time of creation.  This field does not get updated after account create.</inlineHelpText>
        <label>Duplicate Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>notEqual</operation>
                <value>Direct Account, Rejected Account, Requested Account, End Customer Deal Account</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Accounts</relationshipLabel>
        <relationshipName>Accounts</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
