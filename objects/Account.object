$Profile.Name &lt;&gt; &quot;Sales Ops&quot; 
) 
, 
OR( 
ISCHANGED(Name) 
) 
)
)</errorConditionFormula>
        <errorDisplayField>Core_Account_Code__c</errorDisplayField>
