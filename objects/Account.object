    <fields>
        <fullName>Core_Uncover_Marked_for_Clean_Up__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Uncovered Marked for Clean Up</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_UnifiedHierarchy__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(KCR_Process_Outcome_Temp__c, &apos;Business Process Block&apos;), &apos;Not Unified&apos; ,
IF(ISPICKVAL(Core_Customer_Aggregation_Type__c, &apos;UNFD_GLBL_CUST&apos;), &apos;Global&apos;,
IF(ISPICKVAL(Core_Customer_Aggregation_Type__c, &apos;UNFD_INTRMD_CUST&apos;), &apos;Intermediate&apos;,
IF(ISPICKVAL(Core_Customer_Aggregation_Type__c, &apos;UNFD_CTRY_CUST&apos;),    Core_Data_Country_Nm__c    ,&apos;&apos;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Unified Hierarchy</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Unified_Country_Customer__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
