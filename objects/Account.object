    <fields>
        <fullName>Core_Survivor_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>UCD - This field holds the value of survivor account ID when an account request is rejected/merged</description>
        <label>Survivor Account Id</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Accounts (Survivor Account Id)</relationshipLabel>
        <relationshipName>SurrenderedAccounts</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Sys_Next_Account__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This Field is used check if the Account is being Data Loaded from the Backend (If its checked then its data loaded) and its visible only to IT Admins/Sys Admins</description>
        <label>System NEXT Account</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_System_Siebel_Account_Matched__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Field to indicate if PSG Siebel Account matched with an existing Intel account. This field is used for initial data migration of accounts from Siebel to Salesforce.</description>
        <label>System Siebel Account Matched</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_System_Siebel_Account_Row_ID__c</fullName>
        <description>Field to store the Id of PSG Siebel account. This is used for initial migration of Siebel accounts into Salesforce.</description>
        <externalId>false</externalId>
        <label>System Siebel Account Row ID</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
