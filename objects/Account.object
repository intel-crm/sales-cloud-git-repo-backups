        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
 AND(
 NOT(ISBLANK(PRIORVALUE(Core_Account_Owner_Preview__c))),
 ischanged(Core_Account_Owner_Preview__c),
 (!($Profile.Name == &apos;Data Ops&apos; || $Profile.Name == &apos;System Administrator&apos;) || Owner.Id == $User.Id)
)
)</errorConditionFormula>
        <errorDisplayField>Core_Account_Owner_Preview__c</errorDisplayField>
        <errorMessage>Account Owner Preview can be edited by Data Ops.</errorMessage>
    </validationRules>
