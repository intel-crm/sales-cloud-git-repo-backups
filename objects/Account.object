    <fields>
        <fullName>Core_Account_City_State_nm__c</fullName>
        <externalId>false</externalId>
        <formula>if(LEN(BillingCity)&gt;0, BillingCity +&quot;/&quot;,&quot;&quot;)&amp;
if(LEN(BillingState)&gt;0, BillingState +&quot;/&quot;,&quot;&quot;)&amp;
if(LEN(BillingCountry)&gt;0, BillingCountry,&quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account City/State/Country</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Account_Cnt__c</fullName>
        <description>Used to support DDR (Disti Design Registration) dashboards.</description>
        <externalId>false</externalId>
        <formula>1</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
