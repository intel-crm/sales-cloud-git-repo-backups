    <fields>
        <fullName>Core_IPS_Active__c</fullName>
        <defaultValue>false</defaultValue>
        <description>The IPS Active flag signifies that this Account has or has had contacts which have been IPS Active. This is checked when a Contact is IPS Active and is never unchecked even if all of the contacts have been deactivated.</description>
        <label>IPS Active</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
