((!($Profile.Name ==&apos;Data Ops&apos; ||$Profile.Name ==&apos;Integration&apos;|| $User.Id == OwnerId ) &amp;&amp; ischanged(Core_PSG_Account__c) &amp;&amp; Core_PSG_Account__c=true)||  (ischanged(Core_PSG_Account__c) &amp;&amp; Core_PSG_Account__c=false)))</errorConditionFormula>
