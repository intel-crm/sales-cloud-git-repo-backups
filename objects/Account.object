ISCHANGED( Core_IsODM__c ) &amp;&amp;  (Core_B2B_Entitlement__c = true)

)</errorConditionFormula>
        <errorMessage>WOM Access for ODM can&apos;t be edited when B2B Entitlement is checked on the Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Limit_Account_English_Name_Length</fullName>
        <active>true</active>
        <description>Limit the length of Account English Name due to ERPM restrictions.</description>
