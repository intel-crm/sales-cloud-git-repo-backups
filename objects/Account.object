        <deleteConstraint>SetNull</deleteConstraint>
        <description>This represents the Account field from where the Auto-Transfer will take place.</description>
        <label>Auto-Transfer Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Co_Marketing</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_Channel_Program__c</field>
                <operation>equals</operation>
                <valueField>$Source.Core_MDF_Channel_Program__c</valueField>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_Active_Ind__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Accounts (Auto-Transfer Account)</relationshipLabel>
        <relationshipName>AccountsWithAutoTransfer</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
