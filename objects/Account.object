    <validationRules>
        <fullName>Account_Name_Should_be_alphanumeric</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(REGEX(Name , &quot;^(?=.*?[a-zA-Z0-9])[a-zA-Z0-9()/\\@\\&amp;\\s\\*\\,\\#\\.]+$&quot;))</errorConditionFormula>
        <errorMessage>Account Name only allows English characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_ACM_Account_Owner</fullName>
        <active>false</active>
        <description>If its an L1, L2, L3 account, Account Owner cannot be changed</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
!ISNEW(),
ISCHANGED(OwnerId),
PRIORVALUE(OwnerId) &lt;&gt; OwnerId,
PRIORVALUE(Core_Account_Owner_Active__c),
OR(
ISPICKVAL( Core_Customer_Aggregation_Type__c , &quot;UNFD_GLBL_CUST&quot;),
ISPICKVAL( Core_Customer_Aggregation_Type__c , &quot;UNFD_INTRMD_CUST&quot;),
ISPICKVAL( Core_Customer_Aggregation_Type__c , &quot;UNFD_CTRY_CUST&quot;))
)
)</errorConditionFormula>
        <errorMessage>You can&apos;t update the Account Owner</errorMessage>
    </validationRules>
