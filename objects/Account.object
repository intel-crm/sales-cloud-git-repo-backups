LEN( Core_English_Only_Name__c ) &gt; 129
)</errorConditionFormula>
        <errorMessage>English Only Name cannot be longer than 129 characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Limit_Account_Legal_Name_Length</fullName>
        <active>true</active>
        <description>Used to limit Account Legal Name Length since ERPM has length restrictions.L</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
LEN( Core_Account_Legal_Name__c ) &gt; 129

)</errorConditionFormula>
        <errorMessage>Account Legal Name cannot be longer than 129 characters</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Limit_Account_Name_Length</fullName>
        <active>true</active>
        <description>Limits length of Account Name field since the length is restricted in ERPM.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
LEN(Name) &gt; 129

)</errorConditionFormula>
        <errorMessage>Account name cannot be longer than 129 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Account_Hierarchy_Validation</fullName>
        <active>true</active>
        <description>This validation rule is applicable for only Retail Marketing Funds</description>
        <errorConditionFormula>IF(ISCHANGED(Core_MDF_Parent_Fund_Account__c),
AND(RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;, ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Retail Marketing Funds&apos;),
Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = &apos;Mastered_Account&apos;,
TEXT($User.UserType)!= $Label.Core_MDF_Partner_User_Type),
AND(RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;, ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Retail Marketing Funds&apos;),
Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = &apos;Mastered_Account&apos;)
)</errorConditionFormula>
        <errorMessage>Account nodes cannot be created beyond three levels of hierarchy</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_AutoTransfer_NotNull</fullName>
        <active>false</active>
        <description>If Enable Auto transfer is checked, than Auto transfer Account cannot be null</description>
        <errorConditionFormula>AND( 
Core_MDF_Channel_Program__r.Name &lt;&gt; $Label.Core_MDF_Retail_Program_Name,
$RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name, 
Core_MDF_Enabled_Auto_Transfer__c = True,  
ISBLANK(Core_MDF_Auto_Transfer_Account__c)
)</errorConditionFormula>
        <errorMessage>Please select an account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Auto_Transfer_Validation</fullName>
        <active>true</active>
        <description>1) For Co Marketing Accounts, Both fields should be available &quot;Enable Auto Transfer&quot; and &quot;Auto Transfer Account&quot;.
2) For Retail Accounts Auto Transfer Functionality is not applicable.</description>
        <errorConditionFormula>IF(RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name &amp;&amp;
(((Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Retail_Program_Name || Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_IPA_Program_Name) &amp;&amp; (Core_MDF_Enabled_Auto_Transfer__c || NOT(ISBLANK(Core_MDF_Auto_Transfer_Account__c )))) || ((Core_MDF_Enabled_Auto_Transfer__c &amp;&amp; ISBLANK(Core_MDF_Auto_Transfer_Account__c)) || (!Core_MDF_Enabled_Auto_Transfer__c &amp;&amp; NOT(ISBLANK(Core_MDF_Auto_Transfer_Account__c )))))
,true,false)</errorConditionFormula>
        <errorMessage>Auto transfer may not be applicable for this account; When applicable ensure enable auto transfer and auto transfer from account are selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Channel_Program_NotNull</fullName>
        <active>true</active>
        <description>If the record type is co-marketing, then Channel Program cannot be null.</description>
        <errorConditionFormula>AND($RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,
ISBLANK(Core_MDF_Channel_Program__r.Name))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Channel_Program__c</errorDisplayField>
        <errorMessage>Please select Channel Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Check_VirtualCorpAcc_Creation</fullName>
        <active>false</active>
        <description>Please reach out to support team Virtual Corp Account creation</description>
        <errorConditionFormula>AND( ISNEW(), 
Core_MDF_Parent_Fund_Account__r.RecordType.Name  = &apos;Intel Account&apos;, 
RecordType.Name = &apos;CoMarketing&apos;,
NOT(ISPICKVAL(AccountSource , &apos;CCP Onboarding&apos;))  )</errorConditionFormula>
        <errorMessage>Please reach out to support team Virtual Corp Account creation</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EnableAutoTransfer_NotNull</fullName>
        <active>false</active>
        <description>If Enable Auto transfer is checked, than Auto transfer Account cannot be null</description>
        <errorConditionFormula>AND( 
Core_MDF_Channel_Program__r.Name &lt;&gt; $Label.Core_MDF_Retail_Program_Name, 
$RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,
Core_MDF_Enabled_Auto_Transfer__c = False,  
NOT(ISBLANK(Core_MDF_Auto_Transfer_Account__c )) 
)</errorConditionFormula>
        <errorMessage>Please select Enable Auto transfer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Geo_Dependent_SubGeo</fullName>
        <active>false</active>
        <description>To validate If Geo is ASMO then we need to have Sub Geo mandatorily amongst list , for other geos sub geo is optional , but if available then it has to be from list.</description>
        <errorConditionFormula>AND(
(RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name &amp;&amp;
Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Retail_Program_Name),
IF(ISPICKVAL(Core_Geo__c, &apos;ASMO&apos;) &amp;&amp; NOT(ISBLANK(TEXT(Core_Sub_Geo__c))) &amp;&amp; CONTAINS($Label.Core_MDF_ASMO_SubGeo, TEXT(Core_Sub_Geo__c)),false,IF(ISPICKVAL(Core_Geo__c, &apos;PRC&apos;) &amp;&amp; (ISBLANK(TEXT(Core_Sub_Geo__c)) || CONTAINS($Label.Core_MDF_PRC_SubGeo, TEXT(Core_Sub_Geo__c))),false,IF(ISPICKVAL(Core_Geo__c, &apos;APJ&apos;) &amp;&amp; (ISBLANK(TEXT(Core_Sub_Geo__c)) || CONTAINS($Label.Core_MDF_APJ_SubGeo, TEXT(Core_Sub_Geo__c))),false,IF(ISPICKVAL(Core_Geo__c, &apos;EMEA&apos;) &amp;&amp; (ISBLANK(TEXT(Core_Sub_Geo__c)) || CONTAINS($Label.Core_MDF_EMEA_SubGeo, TEXT(Core_Sub_Geo__c))),false,true))))
)</errorConditionFormula>
        <errorMessage>Incorrect Region/Sub region</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_AccountHierarchy_Validation</fullName>
        <active>false</active>
        <description>This validation rule is applicable for only IPA</description>
        <errorConditionFormula>IF(ISCHANGED(Core_MDF_Parent_Fund_Account__c),
AND(RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;, ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Intel Partner Alliance&apos;),
Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = &apos;Mastered_Account&apos;,
TEXT($User.UserType)!= $Label.Core_MDF_Partner_User_Type),
AND(RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;, ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Intel Partner Alliance&apos;),
Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = &apos;Mastered_Account&apos;)
)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Group__c</errorDisplayField>
        <errorMessage>Account nodes cannot be created beyond one level of hierarchy</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_IPA_PaymentTypeCheck</fullName>
        <active>true</active>
        <description>This Validation Rule is only applicable to CoMarketing Account of IPA Program for selecting new Payment type and Payment type node level.</description>
        <errorConditionFormula>AND(
  RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;,
  OR(
    ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Customer-NonPO&quot;),
    ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Customer-NonPO&quot;)
  ),
  OR(
    ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &quot;CoGTM&quot;),
    AND(
    ISNEW(),
      NOT(ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &quot;Intel Partner Alliance&quot;))
    )
  )
)</errorConditionFormula>
        <errorMessage>Payment Type and Payment Type Node level with value &apos;Customer - NonPO&apos; is not applicable</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_NonRMF_Acc_Hierarchy_Validation</fullName>
        <active>true</active>
        <description>This validation rule is applicable for all program except Retail Marketing Funds</description>
        <errorConditionFormula>IF(ISCHANGED(Core_MDF_Parent_Fund_Account__c), AND(RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;, NOT(ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Retail Marketing Funds&apos;)),
Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = &apos;Mastered_Account&apos;,
TEXT($User.UserType) != $Label.Core_MDF_Partner_User_Type), AND(RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;, NOT(ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c ,&apos;Retail Marketing Funds&apos;)),
Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = &apos;Mastered_Account&apos;))</errorConditionFormula>
        <errorMessage>Account nodes cannot be created beyond five levels of hierarchy</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PFACannotBeIntelAccount</fullName>
        <active>true</active>
        <description>This Validation Rule ensures that Parent Fund Account of node cannot be an Intel Account.</description>
        <errorConditionFormula>AND (ISCHANGED(Core_MDF_Parent_Fund_Account__c), RecordType.DeveloperName = &apos;Core_MDF_Co_Marketing&apos; ,Core_MDF_Parent_Fund_Account__c = Core_MDF_CoMarketing_Ultimate_Account__c,TEXT($User.UserType) != $Label.Core_MDF_Partner_User_Type)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Parent_Fund_Account__c</errorDisplayField>
        <errorMessage>Parent Fund Account cannot be an Intel Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PFAEnabledAutoTransfer</fullName>
        <active>true</active>
        <description>This Validation Rule restrict editing of Parent Fund Account if Enable Auto Transfer is true and Auto-Transfer Account is populated.</description>
        <errorConditionFormula>AND(ISCHANGED(Core_MDF_Parent_Fund_Account__c),RecordType.DeveloperName = &apos;Core_MDF_Co_Marketing&apos;, Core_MDF_Enabled_Auto_Transfer__c = True,Core_MDF_Auto_Transfer_Account__c &lt;&gt; NULL,TEXT($User.UserType) != $Label.Core_MDF_Partner_User_Type)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Parent_Fund_Account__c</errorDisplayField>
        <errorMessage>Parent Fund Account cannot be edited if Enable Auto Transfer is true and Auto-Transfer Account is populated.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PFAProgramAndUltimateAccount</fullName>
        <active>true</active>
        <description>Parent Fund Account should belong to same account hierarchy and same program.</description>
        <errorConditionFormula>AND(ISCHANGED( Core_MDF_Parent_Fund_Account__c), RecordType.DeveloperName = &apos;Core_MDF_Co_Marketing&apos;,
OR( Core_MDF_Channel_Program__c != Core_MDF_Parent_Fund_Account__r.Core_MDF_Channel_Program__c , 
Core_MDF_CoMarketing_Ultimate_Account__c != Core_MDF_Parent_Fund_Account__r.Core_MDF_CoMarketing_Ultimate_Account__c ), Core_MDF_Parent_Fund_Account__c != Core_MDF_CoMarketing_Ultimate_Account__c,TEXT($User.UserType) != $Label.Core_MDF_Partner_User_Type)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Parent_Fund_Account__c</errorDisplayField>
        <errorMessage>Parent Fund Account should belong to same account hierarchy and same program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ParentFundAccountNotEditable</fullName>
        <active>true</active>
        <description>This Validation Rule ensures that the External User can not change Parent Fund Account Field once it is assigned to an Account.</description>
        <errorConditionFormula>AND(ISCHANGED( Core_MDF_Parent_Fund_Account__c),  RecordType.DeveloperName = &apos;Core_MDF_Co_Marketing&apos;,TEXT($User.UserType) = $Label.Core_MDF_Partner_User_Type )</errorConditionFormula>
        <errorDisplayField>Core_MDF_Parent_Fund_Account__c</errorDisplayField>
        <errorMessage>Parent account cannot be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Parent_Hierarchy_Account</fullName>
        <active>true</active>
        <description>Node should only have direct parent hierarchy details .if it select siblings should through Error</description>
        <errorConditionFormula>AND(
Core_MDF_Channel_Program__r.Name &lt;&gt; $Label.Core_MDF_Retail_Program_Name,
$RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,
Core_MDF_Enabled_Auto_Transfer__c = True,
Core_MDF_Auto_Transfer_Account__r.Id &lt;&gt; NULL ,
Core_MDF_Auto_Transfer_Account__r.Id != Core_MDF_Parent_Fund_Account__r.Id, 
Core_MDF_Auto_Transfer_Account__r.Id != Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Id,
Core_MDF_Auto_Transfer_Account__r.Id != Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Id,
Core_MDF_Auto_Transfer_Account__r.Id != Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__r.Id)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Auto_Transfer_Account__c</errorDisplayField>
        <errorMessage>This account is not available for Auto Transfer</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PartnerFundAccount_NotNull</fullName>
        <active>true</active>
        <description>If the record type is co-marketing, then Partner Fund Account cannot be null.</description>
        <errorConditionFormula>AND($RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,
				ISBLANK(Core_MDF_Parent_Fund_Account__c))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Parent_Fund_Account__c</errorDisplayField>
        <errorMessage>Please select Parent Fund Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PaymentTypeValidation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(RecordType.DeveloperName=$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,
OR(Core_MDF_Channel_Program__r.Name=$Label.Core_MDF_IPA_Program_Name,
Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Co_GTM_program_name), Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = $Label.Core_MDF_Intel_Account_Record_Type_Developer_Name, ISPICKVAL(Core_MDF_Payment_Type_nm__c,&apos;&apos;))</errorConditionFormula>
        <errorMessage>Payment Type  cannot be empty for the selected program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Payment_Type_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
     RecordType.DeveloperName =&apos;Core_MDF_Co_Marketing&apos;,
     OR(     
       ISCHANGED(Core_MDF_Payment_Type_nm__c), 
       ISCHANGED(Core_MDF_Payment_Type_NodeLevel_nm__c)
     ),
     OR(
       AND(
        ISCHANGED(Core_MDF_Payment_Type_nm__c),
        NOT(
           ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Customer&quot;) || 
           ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Non-Customer&quot;)
        )
       ),
       AND(
        ISCHANGED(Core_MDF_Payment_Type_NodeLevel_nm__c),
        NOT(
           ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Customer&quot;)||
           ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Non-Customer&quot;)
        )
       )
     ),
     OR(
       ISPICKVAL( Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c , &apos;Client CoMarketing Fund&apos;),
       ISPICKVAL( Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c , &apos;Data Center CoMarketing Fund&apos;),
       ISPICKVAL( Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c , &apos;Retail Marketing Funds&apos;),
       ISPICKVAL( Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c , &apos;Client CoMarketing Fund Boost&apos;),
       ISPICKVAL( Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c , &apos;Service Provider CoMarketing Fund&apos;)

     )
)</errorConditionFormula>
        <errorMessage>Please select &apos;Customer&apos; or &apos;Non-Customer&apos; for Payment Type or Payment Type Node Level fields</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Payment_Type_Validation_Rule</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &apos;Core_MDF_Co_Marketing&apos;,
    OR(
        ISCHANGED(Core_MDF_Payment_Type_nm__c),
        ISCHANGED(Core_MDF_Payment_Type_NodeLevel_nm__c),
        ISNEW()
    ),
    OR(
        AND(
            ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &apos;CoGTM&apos;),
            OR(
                AND(
                    ISCHANGED(Core_MDF_Payment_Type_nm__c),
                    NOT(
                        OR(
                            ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Customer&quot;),
                            ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Non-Customer&quot;),
                            ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Customer (Credit Memo)&quot;),
                            ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Vistex (Cash)&quot;),
                            ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Vistex (Credit Memo)&quot;)
                        )
                    )
                ),
                AND(
                    OR(ISCHANGED(Core_MDF_Payment_Type_NodeLevel_nm__c),ISNEW()),
                    NOT(
                        OR(
                            ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Customer&quot;),
                            ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Non-Customer&quot;),
                            ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Customer (Credit Memo)&quot;),
                            ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Vistex (Cash)&quot;),
                            ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Vistex (Credit Memo)&quot;),
                            ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;&quot;)
                        )
                    )
                )
            )
        ),
        AND(
            ISPICKVAL(Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c, &apos;Intel Partner Alliance&apos;),
            OR(
                AND(
                    ISCHANGED(Core_MDF_Payment_Type_nm__c),
                    OR(
                        ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Customer (Credit Memo)&quot;),
                        ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Vistex (Cash)&quot;),
                        ISPICKVAL(Core_MDF_Payment_Type_nm__c, &quot;Vistex (Credit Memo)&quot;)
                    )
                ),
                AND(
                    OR(ISCHANGED(Core_MDF_Payment_Type_NodeLevel_nm__c),ISNEW()),
                    OR(
                        ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Customer (Credit Memo)&quot;),
                        ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Vistex (Cash)&quot;),
                        ISPICKVAL(Core_MDF_Payment_Type_NodeLevel_nm__c, &quot;Vistex (Credit Memo)&quot;)
                    )
                )
            )
        )
    )
)</errorConditionFormula>
        <errorMessage>Selected Payment Type or Payment Type Node Level is not applicable for this program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventInactiveAccountAsPFA</fullName>
        <active>true</active>
        <description>This validation rule will prevent Inactive account in parent fund account.</description>
        <errorConditionFormula>AND(ISNEW(), Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,Core_MDF_Parent_Fund_Account__r.Core_MDF_Active_Ind__c = FALSE)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Parent_Fund_Account__c</errorDisplayField>
        <errorMessage>The Parent Account selected is Inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventPartnerTypeEdit</fullName>
        <active>false</active>
        <errorConditionFormula>ISCHANGED(Core_MDF_Partner_Type_nm__c)</errorConditionFormula>
        <errorMessage>Partner Type cannot be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventUncheckCCPFlag</fullName>
        <active>false</active>
        <description>To Prevent disabling the Co-marketing Active Flag once its enabled</description>
        <errorConditionFormula>AND(
Core_Intel_Partner_Alliance_PartnerGroup__c = true,
ISCHANGED( Core_MDF_CoMarketingActive__c),
PRIORVALUE(Core_MDF_CoMarketingActive__c) = true
)</errorConditionFormula>
        <errorMessage>You cannot disable this Flag, please contact your Salesforce Admin.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PreventUncheckCCPOnboardIPAFlag</fullName>
        <active>true</active>
        <description>To Prevent disabling the CCP Onboarding for IPA Flag once its enabled</description>
        <errorConditionFormula>AND(
Core_Intel_Partner_Alliance_PartnerGroup__c = true,
ISCHANGED( Core_MDF_CCP_Onboarding_for_IPA__c ),
PRIORVALUE(Core_MDF_CCP_Onboarding_for_IPA__c ) = true
)</errorConditionFormula>
        <errorDisplayField>Core_MDF_CCP_Onboarding_for_IPA__c</errorDisplayField>
        <errorMessage>You cannot disable this Flag, please contact your Salesforce Admin.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RMF_Geo_SubGeo_Validation</fullName>
        <active>true</active>
        <description>1) Geo is Mandatory for Retail Accounts 2) If Intel Account has Geo and Sub Geo, then Virtual Corp should follow the same 3) Geo and Sub Geo over Account Nodes should be same as parent account. 4) If Geo is &quot;AMSO&quot;, Sub geo should be either &quot;LAR&quot; or &quot;NAR&quot;</description>
        <errorConditionFormula>IF(
(RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name &amp;&amp; Core_MDF_Channel_Program__r.Name = $Label.Core_MDF_Retail_Program_Name),
IF(
ISPICKVAL(Core_Geo__c, &apos;&apos;),TRUE,
IF(
OR(ISCHANGED(Core_Geo__c),
AND(NOT(ISBLANK(PRIORVALUE(Core_Sub_Geo__c))),ISCHANGED(Core_Sub_Geo__c))),TRUE,
IF(
((!ISPICKVAL(Core_MDF_Parent_Fund_Account__r.Core_Geo__c, &apos;&apos;) &amp;&amp;

TEXT(Core_MDF_Parent_Fund_Account__r.Core_Geo__c) &lt;&gt; TEXT(Core_Geo__c))
||
(!ISPICKVAL(Core_MDF_Parent_Fund_Account__r.Core_Sub_Geo__c, &apos;&apos;) &amp;&amp;
TEXT(Core_MDF_Parent_Fund_Account__r.Core_Sub_Geo__c) &lt;&gt; TEXT(Core_Sub_Geo__c))
||
(Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name
&amp;&amp;

TEXT(Core_MDF_Parent_Fund_Account__r.Core_Sub_Geo__c) &lt;&gt; TEXT(Core_Sub_Geo__c))),TRUE,
IF(
ISPICKVAL(Core_Geo__c, &apos;ASMO&apos;) &amp;&amp; NOT(ISBLANK(TEXT(Core_Sub_Geo__c))) &amp;&amp;
CONTAINS($Label.Core_MDF_ASMO_SubGeo, TEXT(Core_Sub_Geo__c)),FALSE,
IF(ISPICKVAL(Core_Geo__c, &apos;PRC&apos;) &amp;&amp; (ISBLANK(TEXT(Core_Sub_Geo__c)) ||
CONTAINS($Label.Core_MDF_PRC_SubGeo, TEXT(Core_Sub_Geo__c))),FALSE,
IF(ISPICKVAL(Core_Geo__c, &apos;APJ&apos;) &amp;&amp; (ISBLANK(TEXT(Core_Sub_Geo__c)) ||
CONTAINS($Label.Core_MDF_APJ_SubGeo, TEXT(Core_Sub_Geo__c))),FALSE,
IF(ISPICKVAL(Core_Geo__c, &apos;EMEA&apos;) &amp;&amp; (ISBLANK(TEXT(Core_Sub_Geo__c)) ||
CONTAINS($Label.Core_MDF_EMEA_SubGeo, TEXT(Core_Sub_Geo__c))),FALSE,TRUE))))))),
FALSE)</errorConditionFormula>
        <errorMessage>Please select region. Region and sub region values selected should be the same as that on the parent account. Once selected, region and sub region values cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RegionAndSubRegionRestriction</fullName>
        <active>true</active>
        <description>To restrict region and sub region selection for co-marketing programs other than Retail and IPA. This validation is only for co-marketing accounts.</description>
        <errorConditionFormula>IF( RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name &amp;&amp; Core_MDF_Channel_Program__r.Name != $Label.Core_MDF_Retail_Program_Name &amp;&amp; Core_MDF_Channel_Program__r.Name != $Label.Core_MDF_IPA_Program_Name &amp;&amp; ( NOT(ISPICKVAL(Core_Geo__c,&apos;&apos;) )|| NOT(ISPICKVAL(Core_Sub_Geo__c,&apos;&apos;))) &amp;&amp; ( ISNEW() || ISCHANGED(Core_Geo__c) || ISCHANGED(Core_Sub_Geo__c) ) , true, false)</errorConditionFormula>
        <errorMessage>Region/Sub Region are not applicable for the selected Partner Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RegionCheckForIPA</fullName>
        <active>false</active>
        <errorConditionFormula>AND(RecordType.DeveloperName=$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName = $Label.Core_MDF_Intel_Account_Record_Type_Developer_Name,Core_MDF_Channel_Program__r.Name=$Label.Core_MDF_IPA_Program_Name,ISPICKVAL(Core_Geo__c,&apos;&apos;))</errorConditionFormula>
        <errorMessage>Host Region cannot be empty for the selected program</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_TopAccountValidation</fullName>
        <active>true</active>
        <description>This will restrict internal users to select Top Account option on other than Virtual Corp Accounts</description>
        <errorConditionFormula>AND(Core_MDF_Is_Top_Account_Ind__c != False, ISCHANGED(Core_MDF_Is_Top_Account_Ind__c), NOT(AND (Core_MDF_Parent_Fund_Account__c != null, Core_MDF_Parent_Fund_Account__r.Core_MDF_Parent_Fund_Account__c = null)))</errorConditionFormula>
        <errorMessage>Top Account option can be selected only on Virtual Corp Accounts</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Virtual_Corp_ParentNotEditable</fullName>
        <active>true</active>
        <description>This Validation Rule ensures that Virtual Corp’s Parent Fund Account field cannot be changed once it is assigned to an Account.</description>
        <errorConditionFormula>AND(ISCHANGED( Core_MDF_Parent_Fund_Account__c), RecordType.DeveloperName = &apos;Core_MDF_Co_Marketing&apos;, PRIORVALUE(Core_MDF_Parent_Fund_Account__c) = Core_MDF_CoMarketing_Ultimate_Account__c,TEXT($User.UserType) != $Label.Core_MDF_Partner_User_Type)</errorConditionFormula>
        <errorDisplayField>Core_MDF_Parent_Fund_Account__c</errorDisplayField>
        <errorMessage>Virtual Corp node&apos;s Parent Fund Account cannot be edited.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Prevent_AE_User_Account_Name_Edit</fullName>
        <active>true</active>
        <description>Don&apos;t allow A&amp;E Users to edit Account Name unless they are an A&amp;E Super User.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
$Profile.Id = &apos;00eg0000000MIT0&apos; &amp;&amp;  $Permission.Allow_Account_Name_Field_Edit = false &amp;&amp;
ISCHANGED( Name )

)</errorConditionFormula>
        <errorMessage>A&amp;E Users can&apos;t edit Account Name.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LID__Check_CompanyId_Value</fullName>
        <active>true</active>
        <description>Throws an exception message if the company id contains non-numerics</description>
        <errorConditionFormula>AND(
	(LID__LinkedIn_Company_Id__c &lt;&gt; NULL),
	NOT(ISNUMBER(LID__LinkedIn_Company_Id__c))
)</errorConditionFormula>
        <errorDisplayField>LID__LinkedIn_Company_Id__c</errorDisplayField>
        <errorMessage>CompanyId should be a numeric value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Limit_DSS_Users</fullName>
        <active>false</active>
        <description>Bypass DSS Users, IT Admin, System Administrator and Jeff Peet.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
OR( 
ISNEW(), 
ISCHANGED( Core_Sales_Groups__c ) 
), 
TEXT(Core_Sales_Groups__c )=&apos;DCG Sales Group - Direct System Sales&apos;, 
NOT ($Profile.Name ==&apos;System Administrator&apos;|| $Profile.Name ==&apos;IT Admin&apos;||$User.Id=&apos;005o0000001fV6u&apos;) 
))</errorConditionFormula>
        <errorMessage>The &quot;DCG Sales Group - Direct System Sales&quot; Sales Group can only be selected by DSS team members.  If you feel you&apos;ve received this message in error, please submit an AAQ.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>test_vr</fullName>
        <active>false</active>
        <errorConditionFormula>Core_MDF_CCP_Error_Occured_ind__c = true</errorConditionFormula>
        <errorMessage>error occured</errorMessage>
    </validationRules>
