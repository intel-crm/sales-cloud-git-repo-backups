    <recordTypes>
        <fullName>Core_Account_Intel_Ultimate</fullName>
        <active>true</active>
        <description>Represents an Intel Ultimate record, which is simply a grouping of Standard Account records, not to be used in transactions</description>
        <label>Intel Ultimate Account</label>
        <picklistValues>
            <picklist>AccountSource</picklist>
            <values>
                <fullName>Eloqua Scoring Model</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Event</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Inbound Email Inquiry</fullName>
                <default>false</default>
            </values>
