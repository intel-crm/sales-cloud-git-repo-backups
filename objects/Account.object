    <fields>
        <fullName>Core_Account_Owner__c</fullName>
        <description>Account Owner field that defaults to Keeping the Account Team and the Opportunities Teams.</description>
        <externalId>false</externalId>
        <formula>IMAGE(&quot;/profilephoto/005/T&quot;, &quot;&quot;, 16, 16) + &quot; &quot; + HYPERLINK(&quot;/&quot; &amp; OwnerId, Owner.FirstName &amp; &quot; &quot; &amp; Owner.LastName) + &quot; &quot; + 
IF($User.UIThemeDisplayed=&quot;Theme3&quot;,
HYPERLINK(&quot;/&quot;+Id+&quot;/a?retURL=&quot;+Id+&quot;&amp;keepTeam=1&amp;keepSalesTeam=1&quot;, &quot;[Change]&quot;, &apos;_self&apos;), 
&quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Owner Test</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
