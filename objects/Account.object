        <formula>&quot;/&quot; &amp; LEFT(Core_Account_ID__c, 15) &amp; &quot;?displayTrueTeamAccess=1#&quot; &amp; LEFT(Core_Account_ID__c, 15) &amp; &quot;_RelatedAccountSalesTeam_target&quot;</formula>
