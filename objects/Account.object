    <fields>
        <fullName>Core_Calculated_Sales_Group__c</fullName>
        <externalId>false</externalId>
        <formula>MID 
( 
IF 
( 
Core_Global_Account__c, 
&apos;;Global Accounts&apos;, &apos;&apos; 
) 

&amp; 
IF 
( 
OR 
( 
(!Core_Global_Account__c &amp;&amp; (INCLUDES(Core_Sales_Segment__c, &apos;Embedded&apos;) || INCLUDES(Core_Sales_Segment__c, &apos;Compute&apos;))), 
INCLUDES(Core_Sales_Segment__c, &apos;Reseller/Channel&apos;), 
INCLUDES(Core_Sales_Segment__c, &apos;Distributor/Channel&apos;), 
INCLUDES(Core_Sales_Segment__c, &apos;3SO&apos;) 
), 
&apos;;Regional Sales&apos;, &apos;&apos; 
) 

&amp; 
IF 
(!Core_Global_Account__c &amp;&amp; INCLUDES(Core_Sales_Segment__c, &apos;Influencer&apos;), 
&apos;;Industry Sales&apos;, &apos;&apos; 
), 
2, 100 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Calculated Sales Group</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Country_Label__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(BillingCountryCode)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core_Country_Label</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Covered_Account__c</fullName>
        <formula>AND(Owner.Alias &lt;&gt; &quot;iuser&quot;, Owner.Alias &lt;&gt; &quot;uncoverd&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Covered Account</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
