    <fields>
        <fullName>PRM_IPA_Row_Level_Security__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
OR
($Profile.Name = &quot;System Administrator&quot;,$Profile.Name = &quot;IT Admin&quot;
),
&apos;TRUE&apos;,
IF(
AND($User.Core_IPA_One_Partner_Id__c != &quot;&quot;,
$User.Core_IPA_One_Partner_Id__c = Core_IPA_One_Partner_Id__c
),
&apos;TRUE&apos;,
IF(
AND($User.Core_IPA_One_Partner_Id__c = &quot;&quot;,
$User.Core_IPS_AccountId__c= Id
),
&apos;TRUE&apos;,
&apos;FALSE&apos;)
))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IPA Row Level Security</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
