    <fields>
        <fullName>Core_Total_Approved_Revenue_Amount__c</fullName>
        <description>Sum of approved revenue amount, when the opportunity products tied to the opportunity on an account experiences an approved win.</description>
        <inlineHelpText>Sum of approved revenue amount, when the opportunity products tied to the opportunity on an account experiences an approved win.</inlineHelpText>
        <label>Total Approved Revenue Amount</label>
        <summarizedField>Opportunity.Amount</summarizedField>
        <summaryFilterItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Design Win, Production Win</value>
        </summaryFilterItems>
        <summaryForeignKey>Opportunity.AccountId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
