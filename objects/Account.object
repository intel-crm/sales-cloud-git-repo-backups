    <fields>
        <fullName>Core_Direct_Primary_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>CMF with highest rank (E.g Sold to &gt; Ship to &gt; EC) will be show up in SFDC account level as primary</description>
        <label>Direct Primary Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 AND 2 AND 3</booleanFilter>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Direct Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Direct_Account_Type_Nm__c</field>
                <operation>equals</operation>
                <value>Sold To, Ship To, End Customer</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Direct_Account_Active_Ind__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Accounts (CMF Primary Account)</relationshipLabel>
        <relationshipName>Accounts3</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
