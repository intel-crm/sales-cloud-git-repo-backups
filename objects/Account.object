AND( 
ISNEW(),
OR(Core_Lead_to_Account_Conversion__c=&apos;True&apos;,Lead_to_Account_on_Contact_NoOpportunity__c=true)
		
)
)</errorConditionFormula>
        <errorMessage>Please Select the Existing Account before convert</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Clear_Deactivation_Reason</fullName>
        <active>true</active>
        <description>if Deactivation is false, Remove the values from Deactivation Reason.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE, 
AND(Core_Deactivated__c=FALSE, 
NOT(ISBLANK(Core_Deactivation_Reason__c)) 
) 
)</errorConditionFormula>
        <errorMessage>Please clear  deactivation reason.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Disable_WOM_When_B2B</fullName>
        <active>true</active>
        <description>WOM Access for ODM can&apos;t be edited when B2B is true on the Account.</description>
