    <fields>
        <fullName>Core_Account_BU_Focus__c</fullName>
        <description>Hunting
Accounts that are being hunted within the Countries/Territories. Country/Territory Team has not committed to covering account but owner can capture Notes and Leads against it. Should not see Deal   or Design Wins against these accounts (wins should be at committed covered accounts).

CCG
Accounts with a CCG product focus

DCG
Accounts with a DCG product focus

IOTG
Accounts with a IOTG product focus

NSG
Accounts with a NSG product focus

PSG
Accounts with a PSG product focus

Not Applicable
For the accounts which won’t be mapped to the values (BU hosted or uncovered accounts)</description>
        <inlineHelpText>Multi-select field indicates BU Focus Area(s) and/or ABM (Account Based Marketing) account. To request change in BU value(s), log an AAQ (Ask A Question) and select topic &apos;Sales CRM&apos;.</inlineHelpText>
        <label>Account BU Focus</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>ABM</fullName>
                    <default>false</default>
                    <label>ABM</label>
                </value>
                <value>
                    <fullName>CCG</fullName>
                    <default>false</default>
                    <label>CCG</label>
                </value>
                <value>
                    <fullName>DCG</fullName>
                    <default>false</default>
                    <label>DCG</label>
                </value>
                <value>
                    <fullName>DCG-Cloud</fullName>
                    <default>false</default>
                    <label>DCG-Cloud</label>
                </value>
                <value>
                    <fullName>DCG-Comms</fullName>
                    <default>false</default>
                    <label>DCG-Comms</label>
                </value>
                <value>
                    <fullName>DCG-Consulting</fullName>
                    <default>false</default>
                    <label>DCG-Consulting</label>
                </value>
                <value>
                    <fullName>DCG-E&amp;G</fullName>
                    <default>false</default>
                    <label>DCG-E&amp;G</label>
                </value>
                <value>
                    <fullName>Hunting</fullName>
                    <default>false</default>
                    <label>Hunting</label>
                </value>
                <value>
                    <fullName>IOTG</fullName>
                    <default>false</default>
                    <label>IOTG</label>
                </value>
                <value>
                    <fullName>IOTG-AMS</fullName>
                    <default>false</default>
                    <label>IOTG-AMS</label>
                </value>
                <value>
                    <fullName>Not Applicable</fullName>
                    <default>false</default>
                    <label>Not Applicable</label>
                </value>
                <value>
                    <fullName>NSG</fullName>
                    <default>false</default>
                    <label>NSG</label>
                </value>
                <value>
                    <fullName>PSG</fullName>
                    <default>false</default>
                    <label>PSG</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
