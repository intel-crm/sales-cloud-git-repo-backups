IF( 
AND( 
INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 2&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 3&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 4&apos;) 
), 
true, 
IF( 
AND( 
INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 2&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 3&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 5&apos;) 
), 
true, 
IF( 
AND( 
INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 3&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 4&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 5&apos;) 
), 
true, 
IF( 
AND( 
INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 1&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 2&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 3&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 4&apos;),INCLUDES( Core_Account_Tier__c , &apos;RSG-Tier 5&apos;) 
), 
true, 
false 
) 
) 
) 
) 
) 
) 
) 
) 
) 
) 
) 
) 
) 
) 
) 
) 
) 
) 
)
)</errorConditionFormula>
        <errorDisplayField>Core_Account_Tier__c</errorDisplayField>
        <errorMessage>Please select only one RSG Tier value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Account_SalesGroup</fullName>
        <active>false</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
(!($Profile.Name ==&apos;Data Ops&apos;) &amp;&amp; ischanged(Core_Sales_Groups__c)) 

)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Groups__c</errorDisplayField>
        <errorMessage>This field can be edited only by Data ops.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Account_SalesGroup_DataOps_Editable</fullName>
        <active>true</active>
        <description>If the field SalesGroup has a value, then this can be edited by the Data ops &amp; Admin.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
 AND(
 NOT(ISBLANK(TEXT(PRIORVALUE(Core_Sales_Groups__c)))),
 ischanged(Core_Sales_Groups__c),
 !($Profile.Name ==&apos;Data Ops&apos; ||$Profile.Name ==&apos;System Administrator&apos;)
)

)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Groups__c</errorDisplayField>
        <errorMessage>Sales Group can be edited by Data Ops.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Account_SalesGroup_Required</fullName>
        <active>false</active>
