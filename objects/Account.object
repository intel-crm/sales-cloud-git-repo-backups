AND(ISCHANGED(OwnerId),ISBLANK(TEXT(Core_Sales_Groups__c))) 

)</errorConditionFormula>
        <errorDisplayField>Core_Sales_Groups__c</errorDisplayField>
        <errorMessage>Sales Group cannot be Blank</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_B2B_English_Only_Name</fullName>
        <active>true</active>
        <description>Don&apos;t allow English Only Name to be blanked out when the B2B Entitlement field is checked on the Account.</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
NOT(ISBLANK(PRIORVALUE(Core_English_Only_Name__c ))) &amp;&amp; ISBLANK(Core_English_Only_Name__c) &amp;&amp; Core_B2B_Entitlement__c = true

)</errorConditionFormula>
        <errorMessage>Core English Only Name data cannot be removed on a B2B Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_CNDA_Number_is_Required_for_b2b</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
NOT(ISBLANK(PRIORVALUE(Core_CNDA_Number__c))) &amp;&amp; ISBLANK(Core_CNDA_Number__c) &amp;&amp; Core_B2B_Entitlement__c = true

)</errorConditionFormula>
        <errorMessage>CNDA number can not be removed if b2b entitlement is active</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Check_Contact_NoOpportunity</fullName>
