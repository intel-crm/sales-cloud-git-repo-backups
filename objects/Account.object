AND( 
NOT(ISBLANK(Core_CIM_ID__c)), 
$Profile.Name &lt;&gt; &quot;Integration&quot;, 
$Profile.Name &lt;&gt; &quot;Data Ops&quot;, 
$Profile.Name &lt;&gt; &quot;Sales Ops&quot; 
) 
, 
OR( 
ISCHANGED(Name) 
) 
)
)</errorConditionFormula>
        <errorDisplayField>Core_Account_Code__c</errorDisplayField>
        <errorMessage>Account Name cannot be updated if value is entered for CIM ID field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Account_Owner</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
ISCHANGED(OwnerId), 
PRIORVALUE(OwnerId) &lt;&gt; $User.Id,
(!BEGINS($Label.Core_CRM_Integration_User_ID, PRIORVALUE(OwnerId))), 
(!BEGINS($Label.Core_Uncovered_Account_ID, PRIORVALUE(OwnerId))), 
(!BEGINS($Profile.Name, $Label.Core_System_Admin_Profile_Name)),
(!BEGINS($Profile.Name, $Label.Core_Data_Ops_Profile_Name)),
(!BEGINS($Profile.Name, $Label.Core_Production_Support_Profile_Name)),
PRIORVALUE(Core_Account_Owner_Active__c)  
)
)</errorConditionFormula>
        <errorMessage>You can&apos;t update the Account Owner</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_Account_PSG_SalesGroup</fullName>
        <active>true</active>
        <errorConditionFormula>IF(($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE || $Profile.Name ==&apos;System Administrator&apos;),FALSE,
((!($Profile.Name ==&apos;Data Ops&apos; ||$Profile.Name ==&apos;Integration&apos;|| $User.Id == OwnerId || $Profile.Name ==&apos;IT Admin&apos; ||  ($Permission.PRM_Accounts_Approval_Permission &amp;&amp;  Core_Intel_Partner_Alliance_PartnerGroup__c ==TRUE)) &amp;&amp; ischanged(Core_PSG_Account__c) &amp;&amp; Core_PSG_Account__c=true)||  (ischanged(Core_PSG_Account__c) &amp;&amp; Core_PSG_Account__c=false)))</errorConditionFormula>
        <errorDisplayField>Core_PSG_Account__c</errorDisplayField>
        <errorMessage>You do not have enough permission to edit this field.</errorMessage>
    </validationRules>
