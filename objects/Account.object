                <operation>equals</operation>
                <value>Integration</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Accounts (Account)</relationshipLabel>
        <relationshipName>Accounts2</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Direct_Primary_Account_Details__c</fullName>
        <externalId>false</externalId>
        <formula>if(LEN(Core_Direct_Primary_Account_Id__r.BillingStreet)&gt;0, Core_Direct_Primary_Account_Id__r.BillingStreet&amp; &quot; &quot; , &quot;&quot; ) &amp; BR() &amp;
if(LEN(Core_Direct_Primary_Account_Id__r.BillingCity)&gt;0, Core_Direct_Primary_Account_Id__r.BillingCity&amp; &quot;, &quot; , &quot;&quot; )&amp;
if(LEN(Core_Direct_Primary_Account_Id__r.BillingState)&gt;0, Core_Direct_Primary_Account_Id__r.BillingState&amp; &quot; &quot; , &quot;&quot; )&amp;
if(LEN(Core_Direct_Primary_Account_Id__r.BillingPostalCode)&gt;0, Core_Direct_Primary_Account_Id__r.BillingPostalCode,&quot;&quot;) &amp; BR() &amp;
If(LEN( Core_Direct_Primary_Account_Id__r.BillingCountry) &gt;0, Core_Direct_Primary_Account_Id__r.BillingCountry,&quot;&quot;) &amp; BR() &amp;
If(LEN( TEXT(Core_Direct_Primary_Account_Id__r.Core_Direct_Account_Type_Nm__c)) &gt;0, &apos;Type&apos;+&apos; :&apos;+ TEXT(Core_Direct_Primary_Account_Id__r.Core_Direct_Account_Type_Nm__c),&quot;&quot;)  &amp; BR() &amp;
If(LEN( Core_Direct_Primary_Account_Id__r.Core_Direct_Account_Id__c) &gt;0, &apos;CMF ID&apos;+&apos; :&apos;+ Core_Direct_Primary_Account_Id__r.Core_Direct_Account_Id__c,&quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Direct Primary Address Details</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Direct_Primary_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>CMF with highest rank (E.g Sold to &gt; Ship to &gt; EC) will be show up in SFDC account level as primary</description>
        <label>Direct Primary Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 AND 2 AND 3</booleanFilter>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Direct Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Direct_Account_Type_Nm__c</field>
                <operation>equals</operation>
                <value>Sold To, Ship To, End Customer</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Direct_Account_Active_Ind__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Accounts (CMF Primary Account)</relationshipLabel>
        <relationshipName>Accounts3</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
