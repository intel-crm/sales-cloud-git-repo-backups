        <fullName>Core_User_Defined_Number_of_Employees__c</fullName>
        <label>User Defined Number of Employees</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1-9</fullName>
                    <default>false</default>
                    <label>1 - 9 Employees</label>
                </value>
                <value>
                    <fullName>10-24</fullName>
