                    <default>false</default>
                    <label>No Clarification Response Provided</label>
                </value>
                <value>
                    <fullName>OTHR</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
                <value>
                    <fullName>HLDCO</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>HLDCO</label>
                </value>
                <value>
                    <fullName>fine</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
