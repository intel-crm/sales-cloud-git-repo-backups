    <validationRules>
        <fullName>Core_Account_English_Only_Name</fullName>
        <active>true</active>
        <description>Only allow English (alphanumeric ASCII) characters in the English Only Name field</description>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
NOT(ISBLANK(Core_English_Only_Name__c) ||
    REGEX(Core_English_Only_Name__c, &quot;[a-zA-Z0-9 \\p{Punct}]+&quot;))

)</errorConditionFormula>
        <errorDisplayField>Core_English_Only_Name__c</errorDisplayField>
        <errorMessage>Only English (alphanumeric ASCII) characters are allowed in the English Only Name field</errorMessage>
    </validationRules>
