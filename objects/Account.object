    <fields>
        <fullName>Core_Survivor_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>UCD - This field holds the value of survivor account ID when an account request is rejected/merged</description>
        <label>Survivor Account Id</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Accounts (Survivor Account Id)</relationshipLabel>
        <relationshipName>SurrenderedAccounts</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Sys_Next_Account__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This Field is used check if the Account is being Data Loaded from the Backend (If its checked then its data loaded) and its visible only to IT Admins/Sys Admins</description>
        <label>System NEXT Account</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_System_Account__c</fullName>
        <defaultValue>false</defaultValue>
        <label>System Account</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_System_Siebel_Account_Matched__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Field to indicate if PSG Siebel Account matched with an existing Intel account. This field is used for initial data migration of accounts from Siebel to Salesforce.</description>
        <label>System Siebel Account Matched</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_System_Siebel_Account_Row_ID__c</fullName>
        <description>Field to store the Id of PSG Siebel account. This is used for initial migration of Siebel accounts into Salesforce.</description>
        <externalId>false</externalId>
        <label>System Siebel Account Row ID</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Technical_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Technical Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Accounts</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Territory_Description__c</fullName>
        <description>Description of Territory</description>
        <label>Territory Description</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Core_Territory_ID__c</fullName>
        <description>The ID of a Territory. This will be populated via integration</description>
        <externalId>false</externalId>
        <label>Territory ID</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Total_Approved_Revenue_Amount__c</fullName>
        <description>Sum of approved revenue amount, when the opportunity products tied to the opportunity on an account experiences an approved win.</description>
        <inlineHelpText>Sum of approved revenue amount, when the opportunity products tied to the opportunity on an account experiences an approved win.</inlineHelpText>
        <label>Total Approved Revenue Amount</label>
        <summarizedField>Opportunity.Amount</summarizedField>
        <summaryFilterItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Design Win, Production Win</value>
        </summaryFilterItems>
        <summaryForeignKey>Opportunity.AccountId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <type>Summary</type>
    </fields>
    <fields>
