        <label>Parent Fund Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>(1 AND (2 OR 3)) OR (4 AND 2 AND 5)</booleanFilter>
            <filterItems>
                <field>$User.UserType</field>
                <operation>equals</operation>
                <value>Standard</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_Channel_Program__c</field>
                <operation>equals</operation>
                <valueField>$Source.Core_MDF_Channel_Program__c</valueField>
            </filterItems>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Mastered_Account</value>
            </filterItems>
            <filterItems>
                <field>$User.UserType</field>
                <operation>equals</operation>
                <value>PowerPartner</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Co_Marketing</value>
