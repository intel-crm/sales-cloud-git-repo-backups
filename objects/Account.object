    <validationRules>
        <fullName>Core_Account_Owner</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( 
ISCHANGED(OwnerId), 
PRIORVALUE(OwnerId) &lt;&gt; $User.Id,
(!BEGINS($Label.Core_CRM_Integration_User_ID, PRIORVALUE(OwnerId))), 
(!BEGINS($Label.Core_Uncovered_Account_ID, PRIORVALUE(OwnerId))), 
(!BEGINS($Profile.Name, $Label.Core_System_Admin_Profile_Name)),
(!BEGINS($Profile.Name, $Label.Core_Data_Ops_Profile_Name)),
(!BEGINS($Profile.Name, $Label.Core_Production_Support_Profile_Name)),
PRIORVALUE(Core_Account_Owner_Active__c)  
)
)</errorConditionFormula>
        <errorMessage>You can&apos;t update the Account Owner</errorMessage>
    </validationRules>
