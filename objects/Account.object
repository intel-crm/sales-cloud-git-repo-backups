    <fields>
        <fullName>Core_Annual_Revenue__c</fullName>
        <label>Annual Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_Approved_Account__c</fullName>
        <formula>IF(NOT(ISBLANK( Core_CIM_ID__c )) || NOT(ISBLANK( Core_Business_Party_Id__c )),TRUE,FALSE)</formula>
        <label>Approved Account</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Approved_Sales_Group_Exception__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>A checked box confirms this specific Account has an approved Sales Group exception value (e.g., Hosted Account that is being managed by Country/Territory team, Account in US covered by Mexico team, etc.).  More details at goto/SalesCRMSalesGroup</inlineHelpText>
        <label>Approved Sales Group Exception</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_B2B_AcctGrpCMF_Link__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK($Label.Core_ERPM_Link &amp;  CASESAFEID(Id) &amp; &apos;&amp;&apos; &amp; &apos;DedupCode=DEDUPB2B&apos;, &quot;Account Group and CMF&quot;)</formula>
        <label>ERPM Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_B2B_ERPM_Account_Number__c</fullName>
        <description>Populated for accounts where the &quot;dedup group code&quot; from ERPM is the B2B dedup group</description>
        <externalId>false</externalId>
        <label>B2B ERPM Account Number</label>
        <length>20</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_B2B_Entitlement__c</fullName>
        <defaultValue>false</defaultValue>
        <label>B2B Entitlement</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
