        <fullName>Core_Create_Par</fullName>
        <availability>online</availability>
        <description>Request Product Access - Create PAR</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Request Product Access</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>//Added an alert message for Non-NDA Accounts by Sugandha on 14/02/2018 for UserStory US80366 Iteration 7 
if({!ISBLANK( Account.Core_CNDA_Number__c )} ){ 
alert(&apos;{!JSENCODE($Label.Core_IPS_PAR_NON_NDA_Error_Msg)}&apos;); 
} 
else{ 
 if(typeof(srcUp) == &apos;function&apos;){ //Checks that it is in console 
  srcSelf(&quot;/apex/Core_IPS_Create_PAR?isdtp=vw&amp;id={!Account.Id}&amp;eType=Par&quot;,&apos;_self&apos;); 
 }
 else{ 
  window.open(&quot;/apex/Core_IPS_Create_PAR?id={!Account.Id}&amp;eType=Par&quot;,&apos;_self&apos;); 
 }
}</url>
    </webLinks>
