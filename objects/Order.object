    <fields>
        <fullName>AccountId</fullName>
        <lookupFilter>
            <active>false</active>
            <errorMessage>On Account Field on Order, For Partner/Evaluation License Order, you can use only an Active Intel Account and For other order types, Please check if the Sold To(Stocking) / End Customer(Non-Stocking) Account&apos;s Parent Account is an Active Intel Account.</errorMessage>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Deactivated__c</field>
                <operation>equals</operation>
                <value>False</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
