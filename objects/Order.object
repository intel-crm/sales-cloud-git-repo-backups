    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_PSG_Cancelled_Reason_On_Order</fullName>
        <active>true</active>
        <description>Cannot cancel order without providing Cancellation reason</description>
        <errorConditionFormula>IF( ISPICKVAL(Sales_status__c, &apos;Order Cancelled&apos;) &amp;&amp; ISBLANK( Sales_Cancelled_Reason_Dsc__c ), true, false)</errorConditionFormula>
        <errorMessage>Cannot cancel order without providing Cancellation reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_Cannot_Skip_Stage_Value</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
Sales_Is_Recalled__c=False,
(AND(ISPICKVAL( PRIORVALUE (Status),&quot;Activated&quot;),ISPICKVAL(Status,&quot;Draft&quot;))))</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>You are not allowed go back to Previous stage</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_END_Customer_Account</fullName>
        <active>false</active>
        <description>End Customer Account is mandatory for non-stocking orders.</description>
        <errorConditionFormula>AND( 
OR(ISPICKVAL( Status , &apos;Activated&apos;), 
Sales_Is_Verified__c = True
),
ISPICKVAL(Sales_Order_Reason__c, &apos;Non Stocking Order&apos;),
NOT(ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Partner license order&quot;)),
OR(
ISBLANK(Sales_End_Customer_Account__c),
ISBLANK(Sales_End_Customer_Street_Dsc__c),
ISBLANK(Sales_End_Customer_City_Txt__c),
ISBLANK(Sales_End_Customer_State_Txt__c),
ISBLANK(Sales_End_Customer_Country_Txt__c),
ISBLANK(Sales_End_Customer_Zip_Txt__c),
ISBLANK(Sales_End_Customer_Province_Txt__c)
)
)</errorConditionFormula>
        <errorMessage>Cannot activate non stocking order without providing End Customer Account and Address details.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_Log</fullName>
        <active>false</active>
        <description>If Order Type is &apos;ARM License Order&apos;  and Order reason Stocking order then order placed by Disti/OEM allowed.</description>
        <errorConditionFormula>AND( ISPICKVAL( Status , &apos;Activated&apos;) , 
 ! ISBLANK(Sales_ERP_SO_Txt__c ))</errorConditionFormula>
        <errorDisplayField>Sales_SoldTo_Account_2_Txt__c</errorDisplayField>
        <errorMessage>When status is activated ERP so# should not be blank</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_Mandatory_Fields</fullName>
        <active>false</active>
        <description>Mandatory fields according to order types</description>
        <errorConditionFormula>OR(AND(
OR(ISPICKVAL( Status , &apos;Activated&apos;),
Sales_Is_Verified__c = True
),
NOT(ISPICKVAL(Sales_status__c,&apos;SAP Order Creation Failed&apos;)),
OR(
ISBLANK(TEXT(Type)),
ISBLANK(TEXT(Sales_Order_Sub_Type__c))
)
),
AND(
OR( ISPICKVAL( Status , &apos;Activated&apos;), Sales_Is_Verified__c = True ),
NOT(ISPICKVAL(Type,&quot;Non Commercial Order&quot;)),
OR(
ISBLANK(Sales_Ship_To_Account__c),
ISBLANK(TEXT(Sales_Shipping_Condition_Txt__c )),
ISBLANK(TEXT(Sales_Incoterms_Txt__c)),
ISBLANK(Sales_ShipTo_Street_Dsc__c),
ISBLANK(Sales_ShipTo_City_Txt__c),
ISBLANK(Sales_ShipTo_State_Txt__c),
ISBLANK(Sales_ShipTo_Province_Txt__c),
ISBLANK(Sales_ShipTo_Zip_Txt__c),
ISBLANK(Sales_ShipTo_Country_Txt__c),
ISBLANK( Sales_SoldTo_Street_Dsc__c ),
ISBLANK( Sales_SoldTo_City_Txt__c ),
ISBLANK( Sales_SoldTo_State_Txt__c ),
ISBLANK( Sales_SoldTo_Province_Txt__c ),
ISBLANK( Sales_SoldTo_Zip_Txt__c ),
ISBLANK( Sales_SoldTo_Country_Txt__c )
)
),
AND(
OR( ISPICKVAL( Status , &apos;Activated&apos;), Sales_Is_Verified__c = True ),
NOT(ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Partner license order&quot;)),
OR(
ISBLANK( Sales_PO_Number_Txt__c ),
ISNULL(Sales_Req_Ship_Date_Dt__c),
ISBLANK(Pricebook2Id)
)
)
)</errorConditionFormula>
        <errorMessage>All Mandatory fields should be filled to activate the order-1.Order Type/Sub Type 2.Ship to Account 3.Po Number 4.Shipping Condition 5.Incoterms 6.Req Ship Date 7.PriceBook 8.Sold To and Ship To Address.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_Mandatory_Fields_Sample_Order</fullName>
        <active>true</active>
        <description>Cost Center is mandatory for sample order</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False, AND(
OR(ISPICKVAL( Status , &apos;Activated&apos;),
 Sales_Is_Verified__c = True
),
ISPICKVAL( Type , &apos;Sample Order&apos;),
ISBLANK(TEXT(Sales_Cost_Center__c)),
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;)))
)</errorConditionFormula>
        <errorDisplayField>Sales_Cost_Center__c</errorDisplayField>
        <errorMessage>Cost Center is mandatory for sample order</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_Order_Type_on_Order</fullName>
        <active>false</active>
        <description>View that Order Type is defaulted as &quot;Partner License Order&quot; and cannot be changed</description>
        <errorConditionFormula>AND
( ISCHANGED(  Type  )
, OR
  ( ISPICKVAL( PRIORVALUE(  Type  ), &apos;Partner license order&apos; )
    
  )
)</errorConditionFormula>
        <errorDisplayField>Type</errorDisplayField>
        <errorMessage>Order Type is defaulted and cannot be changed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_Partner_License_Order_Mandatory</fullName>
        <active>false</active>
        <description>Mandatory fields for Partner license order</description>
        <errorConditionFormula>AND(
OR(ISPICKVAL( Status , &apos;Activated&apos;),
 Sales_Is_Verified__c = True
),
ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Partner license order&quot;),
OR(
ISNULL(Sales_Req_Ship_Date_Dt__c),
ISBLANK(Pricebook2Id),
ISBLANK(TEXT(Type)),
ISBLANK(TEXT(Sales_Order_Sub_Type__c))
)
)</errorConditionFormula>
        <errorMessage>All Mandatory fields should be filled to activate the order :-
1. Req Ship Date
2. Price Book</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_RestrictFieldForSubmittedOrder</fullName>
        <active>false</active>
        <description>Validation rule to prevent order editing once submitted to SAP ie.Stage of Order is Activated or Acknowledged or the order is cancelled i.e. Status is Cancelled</description>
        <errorConditionFormula>IF( $Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
IF( OR(ISPICKVAL( PRIORVALUE(Status), &quot;Activated&quot;),(ISPICKVAL( PRIORVALUE(Status), &quot;Acknowledged&quot;))),
IF(Ischanged(SBQQ__Contracted__c),false, IF(ISNEW(), FALSE, TRUE)),false))  || 

(IF( ISPICKVAL( PRIORVALUE(Sales_status__c), &quot;Order Cancelled&quot;), true,false))</errorConditionFormula>
        <errorMessage>You can&apos;t edit the fields on Activated Orders or Cancelled Orders</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_Valid_Quote_Filter_On_Order</fullName>
        <active>false</active>
        <description>This Validation rule which check quote selected on order should be active ,approved and  should have quote type as non non-budgetary. Else it will not allow to save record with non satisfying quotes.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,AND( NOT(ISBLANK(SBQQ__Quote__c)) ,
OR( NOT(SBQQ__Quote__r.core_cpq_active_cb__c),
NOT(ISPICKVAL( SBQQ__Quote__r.SBQQ__Status__c , &quot;Approved&quot;)) ),
OR(NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;)),Sales_Is_Verified__c)
))</errorConditionFormula>
        <errorDisplayField>SBQQ__Quote__c</errorDisplayField>
        <errorMessage>Please make sure the selected quote is Active and Approved</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_PSG_Valid_Req_Ship_Date_On_Order</fullName>
        <active>false</active>
        <errorConditionFormula>AND(Sales_Req_Ship_Date_Dt__c    &lt;   TODAY(),
NOT( ISPICKVAL(Sales_status__c	, &apos;Order Cancelled&apos;) ),
OR( Not( Sales_Is_Verified__c ) , NOT( ISPICKVAL( PRIORVALUE( Status ) , &apos;Activated&apos;) )),
$Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c=false
 )</errorConditionFormula>
        <errorMessage>Req. Ship date should be present or future date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Cannot_Contract_New_Order</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISNEW(), SBQQ__Contracted__c)</errorConditionFormula>
        <errorDisplayField>SBQQ__Contracted__c</errorDisplayField>
        <errorMessage>Can&apos;t contract the order. Activate the order and try again.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ActivateOrd_EndCustAcc_Reqd</fullName>
        <active>true</active>
        <description>End Customer Account field is required to Activate Non-Stocking order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
OR(ISPICKVAL( Status , &apos;Activated&apos;),
Sales_Is_Verified__c = True
),
ISPICKVAL(Sales_Order_Reason__c, &apos;Non Stocking Order&apos;),
NOT(ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Partner license order&quot;)),
ISBLANK(Sales_End_Customer_Account__c),
NOT(ISPICKVAL( PRIORVALUE( Status ) , &apos;Activated&apos;) )
)
)</errorConditionFormula>
        <errorDisplayField>Sales_End_Customer_Account__c</errorDisplayField>
        <errorMessage>End Customer Account field is required to Activate Non-Stocking order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ActivateOrd_Incoterms_Reqd</fullName>
        <active>true</active>
        <description>Incoterms field is required to Activate the order for license ,sample, fpga university order</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
OR( ISPICKVAL( Status , &apos;Activated&apos;), Sales_Is_Verified__c = True ),
OR( ISPICKVAL(Type,&quot;Licensed Tool Order&quot;), ISPICKVAL(Type,&quot;Sample Order&quot;),AND(ISPICKVAL(Type,&quot;Non Commercial Order&quot;),ISPICKVAL(Sales_Order_Sub_Type__c,&quot;FPGA university program license request&quot;))),
NOT(ISBLANK( Sales_Ship_To_Account__c )),
ISBLANK(TEXT(Sales_Incoterms_Txt__c)),
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;))
)
)</errorConditionFormula>
        <errorDisplayField>Sales_Incoterms_Txt__c</errorDisplayField>
        <errorMessage>Incoterms field is required to Activate the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ActivateOrd_PONumber_Reqd</fullName>
        <active>true</active>
        <description>PO# field is required to Activate the order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
OR( ISPICKVAL( Status , &apos;Activated&apos;), Sales_Is_Verified__c = True ),
NOT(ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Partner license order&quot;)),
ISBLANK( Sales_PO_Number_Txt__c ),
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;))
)
)</errorConditionFormula>
        <errorDisplayField>Sales_PO_Number_Txt__c</errorDisplayField>
        <errorMessage>PO# field is required to Activate the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ActivateOrd_Pricebook_Reqd</fullName>
        <active>true</active>
        <description>Price Book field is required to Activate the order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
OR( ISPICKVAL( Status , &apos;Activated&apos;), Sales_Is_Verified__c = True ),
ISBLANK(Pricebook2Id)
)
)</errorConditionFormula>
        <errorDisplayField>Pricebook2Id</errorDisplayField>
        <errorMessage>Price Book field is required to Activate the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ActivateOrd_ReqShipDate_Reqd</fullName>
        <active>true</active>
        <description>Req. Ship Date field is required to Activate the order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
OR( ISPICKVAL( Status , &apos;Activated&apos;), Sales_Is_Verified__c = True ),
ISNULL(Sales_Req_Ship_Date_Dt__c),
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;))
)
)</errorConditionFormula>
        <errorDisplayField>Sales_Req_Ship_Date_Dt__c</errorDisplayField>
        <errorMessage>Req. Ship Date field is required to Activate the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ActivateOrd_ShipToAcc_Reqd</fullName>
        <active>true</active>
        <description>Ship To Account field is required to Activate the order for license, sample ,non-commercial( fpga university order , corporate order)</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
OR( ISPICKVAL( Status , &apos;Activated&apos;), Sales_Is_Verified__c = True ),
OR( ISPICKVAL(Type,&quot;Licensed Tool Order&quot;), ISPICKVAL(Type,&quot;Sample Order&quot;),AND(ISPICKVAL(Type,&quot;Non Commercial Order&quot;),OR(ISPICKVAL(Sales_Order_Sub_Type__c,&quot;FPGA university program license request&quot;),ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Corporate Order&quot;)))),
ISBLANK(Sales_Ship_To_Account__c),
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;))
)
)</errorConditionFormula>
        <errorDisplayField>Sales_Ship_To_Account__c</errorDisplayField>
        <errorMessage>Ship To Account field is required to Activate the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ActivateOrd_SubType_Reqd</fullName>
        <active>true</active>
        <description>Order Sub Type field is required to Activate the order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
OR(ISPICKVAL( Status , &apos;Activated&apos;), Sales_Is_Verified__c = True ),
NOT(ISPICKVAL(Sales_status__c,&apos;SAP Order Creation Failed&apos;)),
NOT(ISBLANK(TEXT( Type ))),
ISBLANK(TEXT(Sales_Order_Sub_Type__c)),
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;))
)
)</errorConditionFormula>
        <errorDisplayField>Sales_Order_Sub_Type__c</errorDisplayField>
        <errorMessage>Order Sub Type field is required to Activate the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_ActivateOrd_Type_Reqd</fullName>
        <active>true</active>
        <description>Order Type field is required to Activate the order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
OR(ISPICKVAL( Status , &apos;Activated&apos;), Sales_Is_Verified__c = True ),
NOT(ISPICKVAL(Sales_status__c,&apos;SAP Order Creation Failed&apos;)),
ISBLANK(TEXT(Type)),
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;))
)
)</errorConditionFormula>
        <errorDisplayField>Type</errorDisplayField>
        <errorMessage>Order Type field is required to Activate the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Amend_Non_Commercial_Order_SubType</fullName>
        <active>false</active>
        <description>User can set  the Amend non Commercial order sub type only if the order has quote and Quotes&apos;s type is amendment.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
	AND(
		ISPICKVAL(Type,&apos;Non Commercial Order&apos;),ISPICKVAL(Sales_Order_Sub_Type__c, &apos;Amend Non Commercial&apos;) ,
		OR(
			AND(
				SBQQ__Quote__c != NULL , NOT(ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c, &apos;Amendment&apos;))
			),
			AND(
				NOT(ISPICKVAL(Sales_status__c,&apos;Order Cancelled&apos;)), SBQQ__Quote__c == NULL
			)
		)
	)
)</errorConditionFormula>
        <errorMessage>User can set the order sub type as  Amend Non Commercial only incase of amend order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Cannot_Activate_Order_Manually</fullName>
        <active>false</active>
        <description>Once Order pushed to SAP and order creation failed, It cannot be Activated manually.(Except for Non-Commercial Order)</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
OR(
AND(
Sales_Is_Verified__c = false,
ISPICKVAL(PRIORVALUE(Sales_status__c), &apos;Draft Order&apos;),
ISPICKVAL(Status, &apos;Activated&apos;)
),
AND(
NOT(ISPICKVAL(Type, &apos;Non Commercial Order&apos;)),
ISPICKVAL(PRIORVALUE(Sales_status__c) ,&apos;SAP Order Creation Failed&apos;),
NOT(ISBLANK(Sales_Sync_Comments_Txt__c)),
ISPICKVAL(Status, &apos;Activated&apos;)
)
)
)</errorConditionFormula>
        <errorDisplayField>Sales_status__c</errorDisplayField>
        <errorMessage>Cannot Activate Order Manually In case of &apos;Draft Order&apos; or &apos;SAP order Creation Failed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Cant_SubmitToSAP_WithoutOrderItem</fullName>
        <active>true</active>
        <description>Order should have atleast one Order Product inorder to Submit to SAP</description>
        <errorConditionFormula>AND( 
NOT( ISPICKVAL( Sales_status__c , &apos;SAP Order Creation Failed&apos;) ),
NOT( ISPICKVAL( Sales_status__c , &apos;Order Cancelled&apos;) ),
Sales_Is_Verified__c = True ,   
OrderItemCount__c = 0
)</errorConditionFormula>
        <errorMessage>Order should have atleast one Order Product inorder to Submit to SAP.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Check_PriceBook</fullName>
        <active>false</active>
        <description>If the Pricebook at the Quote is not the same as the one in the Order details then the user should get a validation error stopping the addition of the Quote. </description>
        <errorConditionFormula>AND(
NOT( ISPICKVAL( Type , &quot;Sample Order&quot;) ),
NOT( ISBLANK( SBQQ__Quote__c ) ),
NOT(ISBLANK( Pricebook2Id )),
NOT(ISBLANK( SBQQ__Quote__r.SBQQ__PriceBook__c )),
NOT(  SBQQ__Quote__r.SBQQ__PriceBook__c  =  Pricebook2Id )
)</errorConditionFormula>
        <errorMessage>Pricebook at the Quote is not the same as the one in the Order details.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Corporate_Reason_Default</fullName>
        <active>false</active>
        <description>when order type is &quot;Licensed Tool Order&quot; and Sub Type is Corporate Order then Order reason is defaulted to &quot;Non Stocking&quot; and cannot be changed</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False, IF(ISPICKVAL(Type,&apos;Licensed Tool Order&apos;) &amp;&amp; ISPICKVAL(Sales_Order_Sub_Type__c,&apos;Corporate Order&apos;)
&amp;&amp; ISPICKVAL(Sales_Order_Reason__c , &quot;Stocking Order&quot;) &amp;&amp; (OR( Sales_Is_Verified__c , NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;)))), true, false))</errorConditionFormula>
        <errorMessage>Corporate Order cannot have Stocking Order Reason</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_EC_Validation_External_Account</fullName>
        <active>false</active>
        <description>If Sold to account is an External account(Disti channel 01/02), You can&apos;t use Ship to account as an EC account for non-stocking order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False, AND(
ISPICKVAL( Sales_Order_Reason__c , &apos;Non Stocking Order&apos;),
NOT(ISBlank(Sales_Ship_To_Account__c)),
NOT(ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Partner license order&quot;)),
(OR((Sales_Sold_To_Account__r.Core_Direct_Distributor_Channel_Nm__c = &apos;01&apos;) ,
(Sales_Sold_To_Account__r.Core_Direct_Distributor_Channel_Nm__c = &apos;02&apos;))
),
OR(ISPICKVAL(Sales_End_Customer_Account__r.Core_Direct_Account_Type_Nm__c ,&apos;Ship To&apos;) ,Sales_End_Customer_Account__c = Sales_Ship_To_Account__c),
OR(ISPICKVAL(Status,&apos;Draft&apos;),
Sales_Is_Verified__c=true,
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;))
))
)</errorConditionFormula>
        <errorMessage>Sold to account is an External account, You can&apos;t use Ship to account as an End customer account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_EC_Validation_Internal_Account</fullName>
        <active>true</active>
        <description>If the sold to account is an internal account (Disti Channel 04) and order reason is non-stocking, you can use only Internal Ship to accounts as an end customer account</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False, AND(
ISPICKVAL( Sales_Order_Reason__c , &apos;Non Stocking Order&apos;),
NOT(ISBlank(Sales_Ship_To_Account__c)),
NOT(ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Partner license order&quot;)),
(Sales_Sold_To_Account__r.Core_Direct_Distributor_Channel_Nm__c = &apos;04&apos;) ,
NOT((Sales_Ship_To_Account__r.Core_Direct_Distributor_Channel_Nm__c = &apos;04&apos;)) ,
OR(
AND(NOT(Sales_End_Customer_Account__r.Core_Direct_Distributor_Channel_Nm__c=&apos;04&apos;),ISPICKVAL(Sales_End_Customer_Account__r.Core_Direct_Account_Type_Nm__c ,&apos;Ship To&apos;)),Sales_End_Customer_Account__c = Sales_Ship_To_Account__c),
OR(ISPICKVAL(Status,&apos;Draft&apos;),Sales_Is_Verified__c=true,NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;))
))
)</errorConditionFormula>
        <errorMessage>Sold to account is an Internal account, You can use only Internal Ship to account as an end customer account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Mandatory_Accounts_For_Order</fullName>
        <active>false</active>
        <description>For License ,Sample , Non-commercial(FPGA University, Corporate) all 3 accounts (sold to ,ship to , end customer ) are mandatory.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
NOT(ISBLANK(TEXT(Type))),
NOT(ISBLANK(TEXT(Sales_Order_Sub_Type__c))),
OR( ISPICKVAL(Type,&quot;Licensed Tool Order&quot;), ISPICKVAL(Type,&quot;Sample Order&quot;),AND(ISPICKVAL(Type,&quot;Non Commercial Order&quot;),OR(ISPICKVAL(Sales_Order_Sub_Type__c,&quot;FPGA university program license request&quot;),ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Corporate Order&quot;),ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Amend Non Commercial&quot;)))),
OR(ISBLANK(Sales_Sold_To_Account__c) ,ISBLANK(Sales_Ship_To_Account__c),AND(ISPICKVAL(Sales_Order_Reason__c, &apos;Non Stocking Order&apos;),ISBLANK(Sales_End_Customer_Account__c))
), (OR( Sales_Is_Verified__c ,
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;))))
)
)</errorConditionFormula>
        <errorMessage>Sold to ,ship to and end customer accounts are mandatory .</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_OrderCreation_OrderReason_Reqd</fullName>
        <active>true</active>
        <description>Order Reason field is mandatory for Licensed tool order and Sample order in-order to create a order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
ISNEW(),
OR( ISPICKVAL(Type,&quot;Licensed Tool Order&quot;), ISPICKVAL(Type,&quot;Sample Order&quot;)),
ISBLANK(TEXT(Sales_Order_Reason__c))
)
)</errorConditionFormula>
        <errorDisplayField>Sales_Order_Reason__c</errorDisplayField>
        <errorMessage>Order Reason field is required to create the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_OrderCreation_PONumber_Reqd</fullName>
        <active>true</active>
        <description>PO Number field is mandatory for Licensed tool order and Sample order in-order to create a order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
ISNEW(),
OR( ISPICKVAL(Type,&quot;Licensed Tool Order&quot;), ISPICKVAL(Type,&quot;Sample Order&quot;)),
ISBLANK(Sales_PO_Number_Txt__c)
)
)</errorConditionFormula>
        <errorDisplayField>Sales_PO_Number_Txt__c</errorDisplayField>
        <errorMessage>PO# field is required to create the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_OrderCreation_ShipToAcc_Reqd</fullName>
        <active>true</active>
        <description>Ship To Account field is mandatory for Licensed tool order ,Sample order and FPGA University program license  order  in-order to create a order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
ISNEW(),
OR( ISPICKVAL(Type,&quot;Licensed Tool Order&quot;), ISPICKVAL(Type,&quot;Sample Order&quot;),AND(ISPICKVAL(Type,&quot;Non Commercial Order&quot;),ISPICKVAL(Sales_Order_Sub_Type__c,&quot;FPGA university program license request&quot;))),
ISBLANK(Sales_Ship_To_Account__c)
)
)</errorConditionFormula>
        <errorDisplayField>Sales_Ship_To_Account__c</errorDisplayField>
        <errorMessage>Ship To Account field is required to create the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_OrderCreation_SoldToAcc_Reqd</fullName>
        <active>false</active>
        <description>Sold To Account field is mandatory for Licensed tool order and Sample order in-order to create a order.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
ISNEW(),
OR( ISPICKVAL(Type,&quot;Licensed Tool Order&quot;), ISPICKVAL(Type,&quot;Sample Order&quot;)),
ISBLANK(Sales_Sold_To_Account__c)
)
)</errorConditionFormula>
        <errorDisplayField>Sales_Sold_To_Account__c</errorDisplayField>
        <errorMessage>Sold To Account field is required to create the order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_PO_Number</fullName>
        <active>true</active>
        <description>PO# cannot exceed 21 characters and cannot contain &amp; in it.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False ,AND(
OR( 
LEN( Sales_PO_Number_Txt__c ) &gt; 21 ,
CONTAINS(Sales_PO_Number_Txt__c, &apos;&amp;&apos;)
),OR( Sales_Is_Verified__c , NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;)))
))</errorConditionFormula>
        <errorDisplayField>Sales_PO_Number_Txt__c</errorDisplayField>
        <errorMessage>PO# cannot exceed 21 characters and cannot contain &apos;&amp;&apos; in it.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_PSG_Order_Reason</fullName>
        <active>false</active>
        <description>You cannot have Stocking Order Reason for Non Commercial order type.</description>
        <errorConditionFormula>IF( $Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, false, IF( ISPICKVAL(Type,&quot;Non Commercial Order&quot;) 
&amp;&amp; ISPICKVAL( Sales_Order_Reason__c , &quot;Stocking Order&quot;), true, false))</errorConditionFormula>
        <errorDisplayField>Sales_Order_Reason__c</errorDisplayField>
        <errorMessage>You cannot have Stocking Order Reason for Non Commercial order type.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Quote_Mandatory</fullName>
        <active>false</active>
        <description>Quote is mandatory for corporate orders.</description>
        <errorConditionFormula>IF( $Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False,
AND(
OR(
Sales_Is_Verified__c = true,
AND((ISPICKVAL( Status , &quot;Activated&quot;)),
NOT(ISPICKVAL (Sales_status__c, &quot;Order Cancelled by SAP&quot;))),
NOT(ISPICKVAL (Sales_status__c, &quot;Order Cancelled&quot;))
),
 ISPICKVAL( Sales_Order_Sub_Type__c , &quot;Corporate Order&quot;),
 ISBLANK( SBQQ__Quote__c ),
ISBLANK(Sales_Cancelled_Quote_No__c )
)
)</errorConditionFormula>
        <errorDisplayField>SBQQ__Quote__c</errorDisplayField>
        <errorMessage>Quote is mandatory for corporate orders.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_RestrictFields_Validation</fullName>
        <active>false</active>
        <description>Cannot edit Stage, Order start date, Account and also cannot edit Order Products on Orders that are Cancelled And in SAP Resubmission In Progress.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False, AND(
OR( AND(ISPICKVAL( PRIORVALUE(Sales_status__c) , &apos;SAP Resubmission In Progress&apos;),Sales_Is_Verified__c = False), ISPICKVAL( PRIORVALUE(Sales_status__c) , &apos;Order Cancelled&apos;) ),
OR(
ISCHANGED( Status ),
ISCHANGED( AccountId ),
ISCHANGED( EffectiveDate ),
ISCHANGED( OrderItemCount__c )
)
))</errorConditionFormula>
        <errorMessage>Cannot edit Stage, Order start date, Account and also cannot edit Order Products on Orders that are Cancelled And in SAP Resubmission In Progress.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Restrict_Non_Commercial_Status</fullName>
        <active>false</active>
        <description>If Order type is &apos;Non Commercial Order&apos; user not allowed to set status as a &apos;SAP Order Creation Failed&apos;.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False, AND(
ISPICKVAL(Type, &apos;Non Commercial Order&apos;),
ISPICKVAL(Status ,&apos;Draft&apos;),
OR(
ISPICKVAL(Sales_status__c ,&apos;SAP Order Creation Failed&apos;),
ISPICKVAL(Sales_status__c ,&apos;SAP Resubmission In Progress&apos;)
)
))</errorConditionFormula>
        <errorMessage>In &apos;Non Commercial Order&apos; should not allowed Status as &apos;SAP Order Creation Failed&apos; and &apos;SAP Resubmission In Progress&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Ship_to_EC_Account_Validation</fullName>
        <active>true</active>
        <description>If Order reason is Non stocking order and SAP ship to acc selected on an order has SAP Ship To End Customer associated to it then the EC acc chosen on the order should be same as SAP Ship to EC associated with the SAP ship to acc</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False ,AND(
NOT(ISPICKVAL(Sales_Order_Sub_Type__c,&quot;Partner license order&quot;)),
ISPICKVAL( Sales_Order_Reason__c , &apos;Non Stocking Order&apos;),
NOT(ISBlank(Sales_Ship_To_Account__c)),
NOT(ISBlank(Sales_End_Customer_Account__c)),
NOT(ISBlank( Sales_Ship_To_Account__r.Core_Direct_Ship_To_End_Customer_Id__c)),
NOT( Sales_End_Customer_Account__r.Core_Direct_Account_Id__c=Sales_Ship_To_Account__r.Core_Direct_Ship_To_End_Customer_Id__c),
NOT(ISPICKVAL( PRIORVALUE(Status),&apos;Activated&apos;)))
)</errorConditionFormula>
        <errorMessage>End customer account chosen on the order should be same as SAP Ship to End Customer associated with the SAP ship to account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_Validation_Shipping_Instruction</fullName>
        <active>true</active>
        <description>The Shipping instruction of sample order should be defaulted from the ship to account but should be editable.</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, FALSE,
AND(
OR(
AND(
OR( ISPICKVAL( PRIORVALUE(Type) ,&apos;Licensed Tool Order&apos;), ISPICKVAL( PRIORVALUE(Type) ,&apos;Non Commercial Order&apos;) ),
NOT( ISPICKVAL( Type ,&apos;Sample Order&apos;) ),
ISCHANGED( Sales_Shipping_Instructions_Dsc__c )
),
AND(
ISPICKVAL( PRIORVALUE(Type) ,&apos;Sample Order&apos;),
OR( ISPICKVAL( Type ,&apos;Licensed Tool Order&apos;), ISPICKVAL( Type ,&apos;Non Commercial Order&apos;) ),
Sales_Shipping_Instructions_Dsc__c != Sales_Ship_To_Account__r.Core_Direct_Shipping_Instruction_Txt__c
)
),
NOT(ISCHANGED( Sales_Ship_To_Account__c )),
NOT(ISPICKVAL( Status,&apos;Activated&apos;))
)
)</errorConditionFormula>
        <errorMessage>Shipping Instruction cannot be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_cancelled_reason</fullName>
        <active>false</active>
        <description>Cannot add Cancelled reason if order is not cancelled.</description>
        <errorConditionFormula>AND(
ISPICKVAL(  Status  , &apos;Draft&apos;),
NOT(ISPICKVAL(Sales_status__c , &apos;Order Cancelled&apos;)),
NOT( ISBLANK( Sales_Cancelled_Reason_Dsc__c ) )
)</errorConditionFormula>
        <errorDisplayField>Sales_Cancelled_Reason_Dsc__c</errorDisplayField>
        <errorMessage>Cannot add Cancelled reason if order is not cancelled.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sales_checkActivePricebook</fullName>
        <active>true</active>
        <description>Check if User selects an Active Pricebook</description>
        <errorConditionFormula>IF($Setup.PRM_Execution_Controls__c.Skip_ValidationRule_Order_Status__c, False ,AND(Pricebook2.IsActive = FALSE,
  (OR(  Sales_Is_Verified__c ,ISPICKVAL( PRIORVALUE(Status) , &apos;Activated&apos;) )) 
))</errorConditionFormula>
        <errorMessage>Can not select an Inactive Pricebook</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>test</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL(Sales_status__c,&apos;Order Cancelled by SAP&apos;) , Sales_Req_Ship_Date_Dt__c &lt;= TODAY())</errorConditionFormula>
        <errorDisplayField>Sales_SoldTo_Account_2_Txt__c</errorDisplayField>
        <errorMessage>order cannot be cancle</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>SBQQ__EditOrderProducts</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Edit Order Products</masterLabel>
        <openType>noSidebar</openType>
        <page>SBQQ__OrderLineSelector</page>
        <protected>false</protected>
    </webLinks>
</CustomObject>
