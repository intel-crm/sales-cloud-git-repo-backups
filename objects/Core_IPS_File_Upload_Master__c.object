        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_FileUploadedBy__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>File Uploaded By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>IPS_File_Uploads</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_File_Description__c</fullName>
        <label>File Description</label>
        <length>1200</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Core_File_GUID__c</fullName>
        <caseSensitive>true</caseSensitive>
        <externalId>true</externalId>
        <label>File GUID</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Core_File_Hyperlink__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Core_Upload_Status__c, &apos;Complete&apos;),HYPERLINK(Core_File_URL__c ,&apos;Download&apos;,&apos;Self&apos;),HYPERLINK($Label.Core_IPS_File_SCFT_URL +&apos;&amp;console=true&amp;appfileId=&apos;+Core_File_GUID__c ,&apos;Resume&apos;,&apos;Self&apos; ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>File Download Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_File_Name__c</fullName>
        <externalId>false</externalId>
        <label>File Name</label>
        <length>255</length>
        <required>false</required>
