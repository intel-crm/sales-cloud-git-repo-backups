    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object is used to extend the visibility of Quote to distributor</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>core_cpq_distributor__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Holds the distributor account with which the quote is being shared</description>
        <inlineHelpText>Select Distributor to extend the Quote Visibility</inlineHelpText>
        <label>Distributor</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Direct_Primary_Account_Id__c</field>
                <operation>notEqual</operation>
                <value>null</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_PSG_Account__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Disty Visibilities</relationshipLabel>
        <relationshipName>Disty_Visibilities</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>core_cpq_quote__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>Holds the quote which is to be shared with the disty</description>
        <label>Quote</label>
        <referenceTo>SBQQ__Quote__c</referenceTo>
        <relationshipLabel>Disty Visibilities</relationshipLabel>
        <relationshipName>Disty_Visibilities</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Disty Visibility</label>
    <nameField>
        <displayFormat>DV-{00000}</displayFormat>
        <label>Disty Visibility #</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Disty Visibilities</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>PSG_Disty_Visibility</fullName>
        <active>true</active>
        <label>PSG Disty Visibility</label>
    </recordTypes>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Duplicate_Distributor</fullName>
        <active>true</active>
        <description>Checks if this account is already the quote distributor.</description>
        <errorConditionFormula>core_cpq_distributor__c =  core_cpq_quote__r.SBQQ__Distributor__c</errorConditionFormula>
        <errorDisplayField>core_cpq_distributor__c</errorDisplayField>
        <errorMessage>This is already the distributor to which the quote belongs. Please select another distributor account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Valid_Distributor_Account</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
(
$RecordType.Name = &quot;PSG Disty Visibility&quot;
),
NOT( INCLUDES( core_cpq_distributor__r.Core_Account_BU_Focus__c, &apos;PSG-DISTI&apos;)),
NOT(ISBLANK(core_cpq_distributor__c)),
NOT(ISNULL(core_cpq_distributor__c)),
NOT( $Permission.PSG_External_Disty )
)</errorConditionFormula>
        <errorDisplayField>core_cpq_distributor__c</errorDisplayField>
        <errorMessage>Please select a valid distributor account</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
