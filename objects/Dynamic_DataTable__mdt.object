                    <label>email</label>
                </value>
                <value>
                    <fullName>location</fullName>
                    <default>false</default>
                    <label>location</label>
                </value>
                <value>
                    <fullName>number</fullName>
                    <default>false</default>
                    <label>number</label>
                </value>
                <value>
                    <fullName>percent</fullName>
                    <default>false</default>
                    <label>percent</label>
                </value>
                <value>
                    <fullName>phone</fullName>
                    <default>false</default>
                    <label>phone</label>
                </value>
                <value>
                    <fullName>text</fullName>
                    <default>false</default>
                    <label>text</label>
                </value>
                <value>
                    <fullName>url</fullName>
                    <default>false</default>
                    <label>url</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Custom_FieldName__c</fullName>
