           IF(CONTAINS(PMP_Ancestor_Category_Cd__c, &quot;NPP_01_TYPE&quot;) , &apos;Category&apos;, 
              IF(CONTAINS(PMP_Partner_Product_Category_Cd__c, &quot;NPP_01_TYPE&quot;) , &apos;Category&apos;, &apos;&apos;))))))</formula>
