    <fields>
        <fullName>CRM_VBS_Opportunity_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Opportunity Product</label>
        <referenceTo>OpportunityLineItem</referenceTo>
        <relationshipLabel>SOAR Products</relationshipLabel>
        <relationshipName>SOAR_Products</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Product Name</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>SOAR Products</relationshipLabel>
        <relationshipName>SOAR_Products</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_Quantity__c</fullName>
        <description>Quantity of SOAR Product</description>
        <externalId>false</externalId>
        <label>Quantity</label>
        <precision>12</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CRM_VBS_SOAR_Product_Name__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot;&amp; Id ,  CRM_VBS_Product__r.Name )</formula>
        <label>SOAR Product Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CRM_VBS_SOAR__c</fullName>
        <label>SOAR</label>
        <referenceTo>CRM_VBS_SOAR__c</referenceTo>
        <relationshipLabel>SOAR Products</relationshipLabel>
        <relationshipName>SOAR_Products</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>CRM_VBS_Status__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Lost</fullName>
                    <default>false</default>
                    <label>Lost</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>On Hold</fullName>
                    <default>false</default>
                    <label>On Hold</label>
                </value>
                <value>
                    <fullName>Production Lost</fullName>
                    <default>false</default>
                    <label>Production Lost</label>
                </value>
                <value>
                    <fullName>Production Cancelled</fullName>
                    <default>false</default>
                    <label>Production Cancelled</label>
                </value>
                <value>
                    <fullName>Delete In Progress (&lt;15 min)</fullName>
                    <default>false</default>
                    <label>Delete In Progress (&lt;15 min)</label>
                </value>
                <value>
                    <fullName>Post-Win</fullName>
                    <default>false</default>
                    <label>Post-Win</label>
                </value>
                <value>
                    <fullName>Win Submitted</fullName>
                    <default>false</default>
                    <label>Win Submitted</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>CRM_VBS_TotalPrice__c</fullName>
        <formula>CRM_VBS_UnitPrice__c * CRM_VBS_Quantity__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_Total_Price__c</fullName>
        <label>Total Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_UnitPrice__c</fullName>
        <label>Sales Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_Vendor__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Vendor</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Covered_Account__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>SOAR Products</relationshipLabel>
        <relationshipName>SOAR_Products</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CRM_VBS_Write_In_Product_Name__c</fullName>
        <externalId>false</externalId>
        <label>Write In Product Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>SOAR Product</label>
    <nameField>
        <displayFormat>SP-{0000}</displayFormat>
        <label>SOAR Product</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>SOAR Products</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>OpenListInQuip</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>Accept</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>PrintableListView</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>CRM_OppProd_Write_In_Name</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,AND( ISCHANGED( CRM_VBS_Write_In_Product_Name__c ) ,
 CRM_VBS_Product__r.Name = &quot;Write In Product&quot;,
ISBLANK(CRM_VBS_Write_In_Product_Name__c ) = True
))</errorConditionFormula>
        <errorMessage>Required for write in products</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_Quantity_only_supports_whole_numbers</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND(
 ISCHANGED(CRM_VBS_Quantity__c) ,
NOT(REGEX(TEXT( CRM_VBS_Quantity__c ), &quot;^\\d+$&quot;)),
NOT(CRM_VBS_Quantity__c  =0))
)</errorConditionFormula>
        <errorMessage>Quantity field only supports whole numbers. Edit Quantity field(s) by removing the decimal/negative value to enable saving.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_SalesPrice_NonNegative</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,
AND( ISCHANGED(CRM_VBS_UnitPrice__c ),CRM_VBS_UnitPrice__c &lt; 0 ))</errorConditionFormula>
        <errorMessage>Please input non-negative value for Sales Price</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_Product_Update_SOAR3</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,
FALSE,
IF( 
AND(
ISPICKVAL(CRM_VBS_SOAR__r.CRM_VBS_SOAR_VBS_Decision__c  , &apos;SOAR3 Approved&apos;),
NOT(ISCHANGED(
CRM_VBS_Opportunity_Product__c)), 
NOT( ISNEW() )) , TRUE,FALSE))</errorConditionFormula>
        <errorDisplayField>CRM_VBS_Opportunity_Product__c</errorDisplayField>
        <errorMessage>SOAR Products/Team cannot be modified after SOAR VBS Decision is SOAR3 Approved.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CRM_VBS_SOAR_Product_Update_Other</fullName>
        <active>true</active>
        <errorConditionFormula>IF($Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass__c=TRUE,FALSE,IF( AND(OR(ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Design Win&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Production Win&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Production Lost&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Production Cancelled&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName , &apos;Lost&apos;),ISPICKVAL(  CRM_VBS_SOAR__r.CRM_VBS_SOAR_VBS_Decision__c  , &apos;SOAR4 Contract Signed&apos;),ISPICKVAL( CRM_VBS_SOAR__r.CRM_VBS_SOAR_VBS_Decision__c , &apos;SOAR1 Qualified&apos;) ), NOT( ISNEW() )) , TRUE,FALSE))</errorConditionFormula>
        <errorMessage>SOAR Cannot be modified Once Contract is Signed or Opportunity is Closed.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Add_Products</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Add Products</masterLabel>
        <openType>noSidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/lightning/cmp/c__CRM_VBS_SOAR_NewButtonOverride?c__recordId={!CRM_VBS_SOAR__c.Id}</url>
    </webLinks>
</CustomObject>
