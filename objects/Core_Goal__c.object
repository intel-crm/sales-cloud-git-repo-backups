    <listViews>
        <fullName>Deal_Wins_Not_Cancelled</fullName>
        <columns>NAME</columns>
        <columns>Core_Goal_Name__c</columns>
        <columns>Core_Goal_Owner__c</columns>
        <columns>Core_Goal_Status__c</columns>
        <columns>Core_Goal_Category__c</columns>
        <columns>Core_Goal_BU_Focus_Area__c</columns>
        <columns>Core_Goal_Criteria__c</columns>
        <columns>Core_Goal_Opportunity_Identified__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>Core_Goal_Accept_Date__c</columns>
        <columns>Core_Goal_Claim_Date__c</columns>
        <columns>Core_Goal_Approved_Date__c</columns>
        <columns>Core_Goal_Approved_By__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_Goal_Status__c</field>
            <operation>notEqual</operation>
            <value>Cancelled</value>
        </filters>
        <label>Deal Wins (Not Cancelled)</label>
    </listViews>
    <nameField>
        <displayFormat>DWG-{0000000}</displayFormat>
        <label>Deal Win Goal ID</label>
        <trackHistory>false</trackHistory>
