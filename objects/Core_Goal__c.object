        <deleteConstraint>SetNull</deleteConstraint>
        <inlineHelpText>Individual responsible for achieving and receiving credit for the Deal Win Goal (DWG), typically the user who created the DWG.</inlineHelpText>
        <label>Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Deal_Win_Goals</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Goal_Status__c</fullName>
        <inlineHelpText>FIELD KEY:  DRAFT: new (can&apos;t submit); ACCEPTED: Manager accepts DWG (can&apos;t submit); APPROVED: Manager has approved DWG (can submit ONLY if Oppty is approved); CANCELLED: DWG has been cancelled (can be put back to Draft status); more at goto/dealwingoals</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Accepted</fullName>
                    <default>false</default>
                    <label>Accepted</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Draft</fullName>
                    <default>true</default>
                    <label>Draft</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_KPI_Revenue_Difference__c</fullName>
        <formula>Core_KPI_Revenue__c -  Core_Approved_KPI_Revenue__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>KPI Revenue Difference</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_KPI_Revenue_Update__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This Checkbox will be used to calculate the KPI revenue</description>
        <label>KPI Revenue Update</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_KPI_Revenue__c</fullName>
        <label>KPI Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MatchOppKPI_2ndPrev_Backend__c</fullName>
