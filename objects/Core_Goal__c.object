    <fields>
        <fullName>Core_Goal_Criteria__c</fullName>
        <inlineHelpText>The criteria which should be met to achieve the goal. This is a system populated field based on KPI selected.</inlineHelpText>
        <label>Criteria</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Core_Goal_BU_Focus_Area__c</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Please refer to criteria on https://saleskpi.intel.com/</fullName>
                    <default>false</default>
                    <label>Please refer to https://saleskpi.intel.com/</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>CCG Commercial Deal Revenue $</controllingFieldValue>
                <controllingFieldValue>CCG Strategic Next Gen Design #</controllingFieldValue>
                <controllingFieldValue>CCG vPro Platform Deal Revenue $</controllingFieldValue>
                <controllingFieldValue>DC Growth Deal $</controllingFieldValue>
                <controllingFieldValue>DCAI Compute Deal $</controllingFieldValue>
                <controllingFieldValue>NEX Deal (Sell-To) $</controllingFieldValue>
                <controllingFieldValue>DC Strategic Next Gen Design #</controllingFieldValue>
                <valueName>Please refer to criteria on https://saleskpi.intel.com/</valueName>
            </valueSettings>
        </valueSet>
    </fields>
