    <fields>
        <fullName>Core_Goal_Category__c</fullName>
        <inlineHelpText>Select the category the goal falls into.   List of values will include:  Assigned, Team Member, Overachievement. Select “Assigned” if given to you by your manager as primary AE/ITS responsible for delivering KPI as part of base quota.</inlineHelpText>
        <label>Category</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Assigned</fullName>
                    <default>false</default>
                    <label>Assigned</label>
                </value>
                <value>
                    <fullName>Overachievement</fullName>
                    <default>false</default>
                    <label>Overachievement</label>
                </value>
                <value>
                    <fullName>Team Member</fullName>
                    <default>false</default>
                    <label>Team Member</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_Goal_Claim_Date__c</fullName>
        <description>Populated with the date the Goal was submitted for approval/win</description>
        <inlineHelpText>Date the goal was last submitted for approval by the Owner.</inlineHelpText>
        <label>Claim Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_Goal_Commissionable__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Core_Opportunity__r.Core_Commissionable__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Commissionable?</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
