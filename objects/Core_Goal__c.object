        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Goal_Match_Opportunity_KPI__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Core_Opportunity__c != null, IF(Core_Goal_KPI_Achieved_Flag__c = FALSE &amp;&amp; Core_Goal_KPI_Match_Flag__c = FALSE, IMAGE(&apos;/servlet/servlet.FileDownload?file=0152D0000009ds7&apos;,&apos;No KPI Match&apos;), IF(Core_Goal_KPI_Achieved_Flag__c = FALSE &amp;&amp; Core_Goal_KPI_Match_Flag__c = TRUE, IMAGE(&apos;/servlet/servlet.FileDownload?file=0152D0000005he7&apos;,&apos;KPI Not Achieved&apos;), IF(Core_Goal_KPI_Achieved_Flag__c = TRUE &amp;&amp; Core_Goal_KPI_Match_Flag__c = TRUE, IMAGE(&apos;/servlet/servlet.FileDownload?file=0152D0000005heC&apos;,&apos;KPI Achieved&apos;), &apos;&apos;))),&apos;&apos;)</formula>
        <inlineHelpText>Field Help: 1.No KPI Match: Opportunity doesn’t meet KPI criteria--&gt;CAN’T submit  2.KPI Not Achieved: Opportunity meets KPI criteria but not yet ‘win approved’--&gt;CAN’T submit  3.KPI Achieved: Opportunity meets KPI criteria &amp; ‘win approved’--&gt;CAN submit.</inlineHelpText>
        <label>Match Opportunity KPI?</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
