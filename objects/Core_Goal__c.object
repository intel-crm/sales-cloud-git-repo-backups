    <fields>
        <fullName>Core_Goal_Name__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Enter a name that uniquely defines the goal</inlineHelpText>
        <label>Name</label>
        <length>80</length>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Goal_Opportunities_Added_History__c</fullName>
        <externalId>false</externalId>
        <label>Opportunities Added History</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Goal_Opportunities_at_Approval__c</fullName>
        <inlineHelpText>A list of the opportunity IDs that were associated with the Deal Win Goal at the time of approval.</inlineHelpText>
        <label>Opportunities at Approval</label>
        <length>131072</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Goal_Opportunity_Identified__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>If an opportunity is associated with the goal, this will be systematically set to yes.</inlineHelpText>
        <label>Opportunity Identified?</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Goal_Owner_WWID__c</fullName>
        <externalId>false</externalId>
        <formula>Owner:User.Core_WWID__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Owner WWID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Goal_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <inlineHelpText>Owner of achieving the goal, the person who will receive credit.</inlineHelpText>
        <label>Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Deal_Win_Goals</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Goal_Status__c</fullName>
        <inlineHelpText>The current status of the goal.  New goals will be in “Draft” status.  After manager approval, the status will be “Approved”.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Accepted</fullName>
                    <default>false</default>
                    <label>Accepted</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Draft</fullName>
                    <default>true</default>
                    <label>Draft</label>
                </value>
                <value>
                    <fullName>Submitted</fullName>
                    <default>false</default>
                    <label>Submitted</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Deal Win Goal</label>
