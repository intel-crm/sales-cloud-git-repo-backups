    <fields>
        <fullName>Core_Goal_KPI_Achieved_Flag__c</fullName>
        <defaultValue>false</defaultValue>
        <label>KPI Achieved Flag</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Goal_KPI_Match_Flag__c</fullName>
        <defaultValue>false</defaultValue>
        <label>KPI Match Flag</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Goal_Match_Opportunity_KPI__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Core_Opportunity__c != null, IF(Core_Goal_KPI_Achieved_Flag__c = FALSE &amp;&amp; Core_Goal_KPI_Match_Flag__c = FALSE, IMAGE(&apos;/servlet/servlet.FileDownload?file=0151J000003lqFq&apos;,&apos;No KPI Match&apos;), IF(Core_Goal_KPI_Achieved_Flag__c = FALSE &amp;&amp; Core_Goal_KPI_Match_Flag__c = TRUE, IMAGE(&apos;/servlet/servlet.FileDownload?file=0151J000003lqFp&apos;,&apos;KPI Not Achieved&apos;), IF(Core_Goal_KPI_Achieved_Flag__c = TRUE &amp;&amp; Core_Goal_KPI_Match_Flag__c = TRUE, IMAGE(&apos;/servlet/servlet.FileDownload?file=0151J000003lqFo&apos;,&apos;KPI Achieved&apos;), &apos;&apos;))),&apos;&apos;)</formula>
        <inlineHelpText>Field Help: 1.No KPI Match: Opportunity doesn&apos;t meet KPI criteria--&gt;CAN&apos;T submit  2.KPI Not Achieved:Opportunity meets KPI criteria but not yet &apos;win approved&apos;--&gt;CAN&apos;T submit  3.KPI Achieved: Opportunity meets KPI criteria &amp; &apos;win approved&apos;--&gt;CAN submit</inlineHelpText>
        <label>Match Opportunity KPI?</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Goal_Name__c</fullName>
