    <fields>
        <fullName>Core_Goal_Criteria__c</fullName>
        <inlineHelpText>The criteria which should be met to achieve the goal. This is a system populated field based on KPI selected.</inlineHelpText>
        <label>Criteria</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Core_Goal_BU_Focus_Area__c</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Deal Win $ at end user accounts to ramp and grow Data Center Adjancency Products</fullName>
                    <default>false</default>
                    <label>Deal Win $ at end user accounts to ramp and grow Data Center Adjancency Products</label>
                </value>
                <value>
                    <fullName>Deal Win $ to ramp Intel® NAND SSD for Datacenter technology adoption with End Users and Partners in support of Intel&apos;s LRP</fullName>
                    <default>false</default>
                    <label>Deal Win $ to ramp Intel® NAND SSD for Datacenter technology adoption with End Users and Partners in support of Intel&apos;s LRP</label>
                </value>
                <value>
                    <fullName>Deal Win $ to ramp Intel® Optane™ SSD for Client Platform adoption with End Users in support of Intel’s Optane ramp in ’20+. Intel Optane™ memory with SSD is eligible.</fullName>
                    <default>false</default>
                    <label>Deal Win $ to ramp Intel® Optane™ SSD for Client Platform adoption with End Users in support of Intel’s Optane ramp in ’20+. Intel Optane™ memory with SSD is eligible.</label>
                </value>
                <value>
                    <fullName>Deal Win $ to ramp Intel® Optane™ SSD for Datacenter technology adoption with End Users and Partners in support of Intel&apos;s  Optane ramp in ’20+.</fullName>
                    <default>false</default>
                    <label>Deal Win $ to ramp Intel® Optane™ SSD for Datacenter technology adoption with End Users and Partners in support of Intel&apos;s  Optane ramp in ’20+.</label>
                </value>
                <value>
                    <fullName>Deal Win # to ramp Intel® Optane™ SSD for Datacenter technology adoption with End Users and Partners in support of Intel&apos;s  Optane ramp in ’20+.</fullName>
                    <default>false</default>
                    <label>Deal Win # to ramp Intel® Optane™ SSD for Datacenter technology adoption with End Users and Partners in support of Intel&apos;s  Optane ramp in ’20+.</label>
                </value>
                <value>
                    <fullName>Drive Data Center compute technology with priority workloads and solutions into end user markets.</fullName>
                    <default>false</default>
                    <label>Drive Data Center compute technology with priority workloads and solutions into end user markets.</label>
                </value>
                <value>
                    <fullName>Drive Deal Wins focused on Application Acceleration.</fullName>
                    <default>false</default>
                    <label>Drive Deal Wins focused on Application Acceleration.</label>
                </value>
                <value>
                    <fullName>Drive focused effort within the OXM/CSP account community to ensure a solid portfolio of system/solutions Designs using key products to support future revenue growth.  Includes DCG Platforms and Adjacency products</fullName>
                    <default>false</default>
                    <label>Drive focused effort within the OXM/CSP account community to ensure a solid portfolio of system/solutions Designs using key products to support future revenue growth.  Includes DCG Platforms and Adjacency products</label>
                </value>
                <value>
                    <fullName>Drive Public Sector revenue w/wins, win-back, sell-up, refresh.Gov: Ci5+ (vPro under vPro KPI).Edu Big Core: Mature Markets: Ci3+ on Student devices, Ci5+ in Teacher/Computer/eSports labs, Emerging Markets: Ci3+.Edu Small Core: Competitive wins on ICP/IPP</fullName>
                    <default>false</default>
                    <label>Drive Public Sector revenue w/wins, win-back, sell-up, refresh.Gov: Ci5+ (vPro under vPro KPI).Edu Big Core: Mature Markets: Ci3+ on Student devices, Ci5+ in Teacher/Computer/eSports labs, Emerging Markets: Ci3+.Edu Small Core: Competitive wins on ICP/IPP</label>
                </value>
                <value>
                    <fullName>Drive vPro branded revenue w/win-back on vPro, sell-up to vPro, sell-up to Xeon Wkstn, or vPro refresh (i.e. non-vPro to vPro, vPro ci5 to vPro ci7, core to vPro Xeon Wkstn, vPro refresh). Alignment w/SMG BU Segment Director</fullName>
                    <default>false</default>
                    <label>Drive vPro branded revenue w/win-back on vPro, sell-up to vPro, sell-up to Xeon Wkstn, or vPro refresh (i.e. non-vPro to vPro, vPro ci5 to vPro ci7, core to vPro Xeon Wkstn, vPro refresh). Alignment w/SMG BU Segment Director</label>
                </value>
                <value>
                    <fullName>Drive vPro differentiation/sell-up/TAM expansion w/vPro Manageability/Security and Unite. Deal size Mins: AMT  500, Unite and Security 50u,  (US/UK/,GER)  30u (ROW).Defer to vPro Manageability/Security &amp; Unite Criteria. Alignment w/SMG BU Segment Director</fullName>
                    <default>false</default>
                    <label>Drive vPro differentiation/sell-up/TAM expansion w/vPro Manageability/Security and Unite. Deal size Mins: AMT  500, Unite and Security 50u,  (US/UK/,GER)  30u (ROW).Defer to vPro Manageability/Security &amp; Unite Criteria. Alignment w/SMG BU Segment Director</label>
                </value>
                <value>
                    <fullName>Inclusive of all Connected Home products. Must contain &quot;CCG-CHD BU product segment&quot; products</fullName>
                    <default>false</default>
                    <label>Inclusive of all Connected Home products. Must contain &quot;CCG-CHD BU product segment&quot; products</label>
                </value>
                <value>
                    <fullName>Opportunities for TGL UP3/UP4/H notebook design wins or RKL-S desktop design wins</fullName>
                    <default>false</default>
                    <label>Opportunities for TGL UP3/UP4/H notebook design wins or RKL-S desktop design wins</label>
                </value>
                <value>
                    <fullName>Scale w/defined GTM programs yielding pipeline/sales out/products as a standard offering.Incl. integrated marketing plan/collaterals/training. See criteria for vPro Manageability/Security/Unite/Optane/SMB/Public Sector. Alignment w/SMG BU Segment Director</fullName>
                    <default>false</default>
                    <label>Scale w/defined GTM programs yielding pipeline/sales out/products as a standard offering.Incl. integrated marketing plan/collaterals/training. See criteria for vPro Manageability/Security/Unite/Optane/SMB/Public Sector. Alignment w/SMG BU Segment Director</label>
                </value>
                <value>
                    <fullName>This is an aggregate of all IOTG Deal Revenue $.  No $ Thresholds per Deal - &quot;a $ is a $&quot;</fullName>
                    <default>false</default>
                    <label>This is an aggregate of all IOTG Deal Revenue $.  No $ Thresholds per Deal - &quot;a $ is a $&quot;</label>
                </value>
                <value>
                    <fullName>Win claimed at critical steps in a multi-year journey – Step 1) Intel influenced commercial RFP/MOU/LOI (specifying IA), Step 2) Trial Completion. Can claim TW at EACH step.</fullName>
                    <default>false</default>
                    <label>Win claimed at critical steps in a multi-year journey – Step 1) Intel influenced commercial RFP/MOU/LOI (specifying IA), Step 2) Trial Completion. Can claim TW at EACH step.</label>
                </value>
                <value>
                    <fullName>Test Goal</fullName>
                    <default>false</default>
                    <label>Test Goal</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>CCG Public Sector Deal $</controllingFieldValue>
                <valueName>Drive Public Sector revenue w/wins, win-back, sell-up, refresh.Gov: Ci5+ (vPro under vPro KPI).Edu Big Core: Mature Markets: Ci3+ on Student devices, Ci5+ in Teacher/Computer/eSports labs, Emerging Markets: Ci3+.Edu Small Core: Competitive wins on ICP/IPP</valueName>
