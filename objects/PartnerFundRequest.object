    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_22_Days_Prior_Event</fullName>
        <active>false</active>
        <description>Please enter a Start Date that is at least 22 days before the Event created.</description>
        <errorConditionFormula>AND( 
                ISPICKVAL( Core_MDF_ActivityCategory__c , &apos;Event&apos;), 
                OR( 
                                AND( 
                                                RecordType.DeveloperName = &apos;Core_MDF_Client_CoMarketing_Fund&apos;, 
		OR(
		AND(RequestedAmount &gt;= VALUE($Label.Core_MDF_CCF_100K_Budget_Activity), 
		CONTAINS($Label.Core_MDF_Activity_CCF_Types,TEXT(Core_MDF_Activity_Types__c)),
                Core_MDF_Start_Date__c - TODAY() &lt; 60),
		AND(RequestedAmount &lt; VALUE($Label.Core_MDF_CCF_100K_Budget_Activity), 
		CONTAINS($Label.Core_MDF_Activity_CCF_Types,TEXT(Core_MDF_Activity_Types__c)),
                Core_MDF_Start_Date__c - TODAY() &lt; 30)		
		)), 
                                AND(     
                                                RecordType.DeveloperName = &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;, 
        OR( 
		AND(RequestedAmount &gt;= VALUE($Label.Core_MDF_DCF_100K_Budget_Activity), 
		CONTAINS($Label.Core_MDF_Activity_DCF_Types,TEXT(Core_MDF_Activity_Types__c)),
                Core_MDF_Start_Date__c - TODAY() &lt; 60),
		AND(RequestedAmount &lt; VALUE($Label.Core_MDF_DCF_100K_Budget_Activity), 
		CONTAINS($Label.Core_MDF_Activity_DCF_Types,TEXT(Core_MDF_Activity_Types__c)),
                Core_MDF_Start_Date__c - TODAY() &lt; 30)		
		)), 
                                AND(     
                                                RecordType.DeveloperName = &apos;Core_MDF_Service_Provider_CoMarketing_Fund&apos;, 
                                                RequestedAmount &gt;= VALUE($Label.Core_MDF_SPCF_100K_Budget_Activity),
		CONTAINS($Label.Core_MDF_Activity_SPCF_Types,TEXT(Core_MDF_Activity_Types__c)),
                Core_MDF_Start_Date__c - TODAY() &lt; 22 
                                )              
                ), 
                NOT(ISPICKVAL( Core_MDF_Fund_Request_Status__c , &apos;Cancelled&apos;)),
                NOT(ISPICKVAL(Core_MDF_Fund_Request_Status__c,&apos;In-Progress&apos;)),
                NOT(ISPICKVAL(Core_MDF_Fund_Request_Status__c,&apos;Closed&apos;)),
		NOT($Permission.Core_MDF_Internal_Account_Manager),
		 
	OR(
		AND(
		ISPICKVAL(Core_MDF_Fund_Request_Status__c,&apos;Pending Review&apos;),
		NOT(ISNEW()),  
		ISCHANGED(Core_MDF_Start_Date__c)
			
               
		),

        ISNEW()
                
        )
)</errorConditionFormula>
        <errorMessage>Please submit event activities 22 days before activity Start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ActivityForCancelledCampaign</fullName>
        <active>true</active>
        <description>Activity cannot be created for cancelled campaign</description>
        <errorConditionFormula>AND(
   ISNEW(),
   TEXT(Campaign.Core_MDF_Campaign_Status__c) =  $Label.Core_MDF_Activity_Cancelled_Status
)</errorConditionFormula>
        <errorMessage>Activity cannot be created on this Campaign.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Activity_types_2020</fullName>
        <active>false</active>
        <description>Disable Channel partner checkbox for some Category types for activities created after Jan,1,2020</description>
        <errorConditionFormula>AND(
 YEAR(Core_MDF_Start_Date__c)  &gt;= 2020,
 Core_MDF_Channel_Partner_Led__c == true,
OR(
AND(
 ISPICKVAL( Core_MDF_ActivityCategory__c , &apos;Digital Media&apos;),
 ISPICKVAL( Core_MDF_Activity_Types__c , &apos;Online Display&apos;)  
),
AND(
 ISPICKVAL(Core_MDF_ActivityCategory__c, &apos;Print Media&apos;) ,
 ISPICKVAL(Core_MDF_Activity_Types__c, &apos;Insert/Outsert/Flyer&apos;) 
)
)
)</errorConditionFormula>
        <errorMessage>Channel Partner is not available for selected activity type starting Jan 1, 2020.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_BudgetAmtShldBeGrtr_1Dollar</fullName>
        <active>true</active>
        <description>Please enter a Budget Amount of $1 or higher (No decimal points).</description>
        <errorConditionFormula>OR(
  (Core_MDF_Budget_Amount_Local_amt__c &lt;1) 

	&amp;&amp; 

  (RecordType.DeveloperName = 
   &apos;Core_MDF_Client_CoMarketing_Fund&apos; ||  
   RecordType.DeveloperName  = 
   &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos; || 
   RecordType.DeveloperName  = 
   &apos;Core_MDF_Service_Provider_CoMarketing_Fund&apos; ||
   RecordType.DeveloperName = 
   &apos;Core_MDF_Client_CoMarketing_Fund_Boost&apos; ||
   RecordType.DeveloperName = 
   &apos;Core_MDF_Retail_Marketing_Funds&apos;), 
		
   (Core_MDF_Budget_Amount_Local_amt__c &lt;&gt;  
    FLOOR(Core_MDF_Budget_Amount_Local_amt__c )),

   ( RequestedAmount &lt;1)
)</errorConditionFormula>
        <errorMessage>Please enter a Budget Amount of $1 or higher (No decimal points).</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CheckActivityCancellation</fullName>
        <active>true</active>
        <description>It fires when any user tries to cancel activity if the Activity Status is &quot; In-Progress&quot; and 
&quot; Closed&quot;.</description>
        <errorConditionFormula>AND(
	OR(
		AND(
		TEXT(PRIORVALUE(Core_MDF_Fund_Request_Status__c)) == &apos;In-Progress&apos;,
 NOT($Permission.Core_MDF_ClaimCaseReviewer ||  
    $Permission.Core_MDF_CCP_Internal_CCF_Account_Manager ||
    $Permission.Core_MDF_CCP_Internal_SPCF_Account_Manager ||
    $Permission.Core_MDF_CCP_Internal_DCF_Account_Manager ||
    $Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager 
		)
	),
		AND(
			TEXT(PRIORVALUE(Core_MDF_Fund_Request_Status__c)) == &apos;Closed&apos;,
			NOT(
				OR(
					$Permission.Core_MDF_CCP_Internal_CCF_Account_Manager,
					$Permission.Core_MDF_CCP_Internal_SPCF_Account_Manager,
					$Permission.Core_MDF_CCP_Internal_DCF_Account_Manager,
					$Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager
				)
			)
		)
	)
	,TEXT(Core_MDF_Fund_Request_Status__c) == &apos;Cancelled&apos;
)</errorConditionFormula>
        <errorMessage>Activity cannot be Cancelled when it is In-Progress or Closed status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CheckTargetAudience</fullName>
        <active>false</active>
        <description>It validates if user has selected the target audience in the campaign</description>
        <errorConditionFormula>isBlank( Text(Core_MDF_TargetAudience__c ))</errorConditionFormula>
        <errorMessage>Enter Target Audience in order to submit Activity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_DCF_NotApplicableBrandsFrom2020</fullName>
        <active>true</active>
        <description>Don&apos;t allow any Xeon Processor Brand Filter in Activities to be selected when user selects start date for DCF of Jan 1, 2020</description>
        <errorConditionFormula>AND(
 RecordType.DeveloperName = &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;,
 YEAR(Core_MDF_Start_Date__c) &gt;= 2020,
 ISPICKVAL(Core_MDF_Brand__c ,&apos;Intel® Xeon® E Processor&apos;)
)</errorConditionFormula>
        <errorMessage>This Brand is not available starting Jan 1, 2020.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EDateSldBeGreaterOrEqlToSDate</fullName>
        <active>true</active>
        <description>End date should always be greater than equal to start date</description>
        <errorConditionFormula>( RecordType.DeveloperName = &apos;Core_MDF_Client_CoMarketing_Fund&apos; || RecordType.DeveloperName = &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;
|| RecordType.DeveloperName  = &apos;Core_MDF_Service_Provider_CoMarketing_Fund&apos; || RecordType.DeveloperName = 
&apos;Core_MDF_Client_CoMarketing_Fund_Boost&apos; ||
RecordType.DeveloperName = 
&apos;Core_MDF_Retail_Marketing_Funds&apos;)  &amp;&amp; (Core_MDF_End_Date__c    &lt;   Core_MDF_Start_Date__c)</errorConditionFormula>
        <errorMessage>End date cannot be Lesser than start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Edit_Acty_AfterCancelled</fullName>
        <active>true</active>
        <description>User Should not able to edit Activity when it is already cancelled</description>
        <errorConditionFormula>AND( 
NOT(ISCHANGED(Core_MDF_Fund_Request_Status__c)), 
ISPICKVAL(Core_MDF_Fund_Request_Status__c,&quot;Cancelled&quot;), 
NOT(ISNEW()), 
NOT(ISCHANGED(Core_MDF_PriorValueStatusForExternalUser__c)) 
)</errorConditionFormula>
        <errorMessage>Cannot edit Cancelled Activities</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Number_of_Pages_Eligible</fullName>
        <active>true</active>
        <description>This will validate if Activity Category is Print Media but # of pages information is not filled.</description>
        <errorConditionFormula>AND( ISPICKVAL(Core_MDF_ActivityCategory__c ,&apos;Print Media&apos;), ISBLANK(Core_MDF_ofPagesEligible__c))</errorConditionFormula>
        <errorMessage>Please fill out the # Pages Eligible For field before submitting the activity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Number_of_Pages_PayingFor</fullName>
        <active>true</active>
        <description>This will validate if Activity Category is Print Media but # of pages information is not filled.</description>
        <errorConditionFormula>AND( ISPICKVAL(Core_MDF_ActivityCategory__c ,&apos;Print Media&apos;) , ISBLANK(Core_MDF_pagespayingfor__c))</errorConditionFormula>
        <errorMessage>Please fill out the # Pages Paying For field before submitting the activity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PagesEligibleAndPaying</fullName>
        <active>true</active>
        <description>To make sure the user enters positive or numbers greater than zero in &quot;number of pages eligible&quot; and &quot;Number of pages paying for&quot;</description>
        <errorConditionFormula>AND(ISPICKVAL(Core_MDF_ActivityCategory__c , &apos;Print Media&apos;),
	OR(Core_MDF_ofPagesEligible__c  &lt;= 0,
	   Core_MDF_pagespayingfor__c &lt;= 0)
	)</errorConditionFormula>
        <errorMessage>The number is too low.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Pages_Eligible_Not_Greater</fullName>
        <active>true</active>
        <description># of pages eligible number cannot be larger than # of pages paying for</description>
        <errorConditionFormula>AND( ISPICKVAL(Core_MDF_ActivityCategory__c , &apos;Print Media&apos;), Core_MDF_ofPagesEligible__c  &gt; Core_MDF_pagespayingfor__c )</errorConditionFormula>
        <errorMessage># of Eligible Pages cannot be greater than # of Pages Member is paying for</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Reimbursement_Rate_Below_0_Pct</fullName>
        <active>true</active>
        <description>Validate that the reimbursement rate does not go below 0%.</description>
        <errorConditionFormula>VALUE(TRIM(SUBSTITUTE(Core_MDF_Reimbursement_Rate__c, &quot;%&quot;, &quot;&quot;))) &lt;= 0</errorConditionFormula>
        <errorMessage>Reimbursement rate cannot be 0%. Please check your values.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Retail_One_Quarter</fullName>
        <active>true</active>
        <description>Retail activity start and end dates difference cannot be more than 13 weeks.</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;,
NOT( AND(
ISPICKVAL( PRIORVALUE( Core_MDF_Fund_Request_Status__c ),&quot;Planned&quot;),
ISPICKVAL(Core_MDF_Fund_Request_Status__c,&quot;In-Progress&quot;)
)),
CEILING((Core_MDF_End_Date__c-Core_MDF_Start_Date__c)/7)&gt;13)</errorConditionFormula>
        <errorMessage>Retail activity start and end dates difference cannot be more than 13 weeks.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Single_Calender_Year</fullName>
        <active>true</active>
        <description>Budget date should be from same calendar year</description>
        <errorConditionFormula>OR(
    AND(
		AND(
			ISPICKVAL($User.UserType , &apos;PowerPartner&apos;),
			MONTH( Core_MDF_End_Date__c )- MONTH( Core_MDF_Start_Date__c )&gt; 6	
		),
		NOT( AND(
			ISPICKVAL( PRIORVALUE( Core_MDF_Fund_Request_Status__c ),&quot;Planned&quot;),
			ISPICKVAL(Core_MDF_Fund_Request_Status__c,&quot;In-Progress&quot;)
		)),
		OR(
			RecordType.DeveloperName = &apos;Core_MDF_Client_CoMarketing_Fund&apos;,
			RecordType.DeveloperName = &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;,
                        RecordType.DeveloperName = &apos;Core_MDF_Service_Provider_CoMarketing_Fund&apos;,
                        RecordType.DeveloperName = &apos;Core_MDF_Client_CoMarketing_Fund_Boost&apos;,
                        RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;
		)
	),
	YEAR( Core_MDF_End_Date__c ) &lt;&gt; YEAR( Core_MDF_Start_Date__c )
)</errorConditionFormula>
        <errorMessage>The budget amount is only for a single year. Please enter the dates for a single year and not more than 6 months</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_TargetAudience_Brand_Dependency</fullName>
        <active>true</active>
        <description>For Server Target Audience we are not allowed select Intel Xeon Processor</description>
        <errorConditionFormula>AND(
ISPICKVAL( Core_MDF_ProductType__c  , &quot;Server&quot;),  
ISPICKVAL( Core_MDF_Brand__c , &quot;Intel® Xeon® Processor&quot;),
OR(
RecordType.DeveloperName = &quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;,
RecordType.DeveloperName = &quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;
)
)</errorConditionFormula>
        <errorMessage>This Brand is not available for Server</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ValidateAcct_Based_on_SlctdCamp</fullName>
        <active>true</active>
        <description>Validating whether Selected Account is Child of Selected Campaign Account</description>
        <errorConditionFormula>ChannelPartner.Core_MDF_CoMarketing_Ultimate_Account__c &lt;&gt; 
Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__c</errorConditionFormula>
        <errorMessage>Please select account associated to the selected campaign&apos;s account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_ContentCreation</fullName>
        <active>true</active>
        <description>Restrict the external user to stop creating the content creation activities</description>
        <errorConditionFormula>ISPICKVAL($User.UserType,&quot;PowerPartner&quot;)
&amp;&amp; ISPICKVAL(Core_MDF_Activity_Types__c , &quot;Content Creation&quot;)
&amp;&amp; (
    ISNEW() 
    || ( NOT(ISNEW())
    &amp;&amp; ISCHANGED(Core_MDF_Activity_Types__c)
   )
)</errorConditionFormula>
        <errorMessage>This activity type is not available. Contact your Intel Representative for more information.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_validateCampED_onchangePFRedate</fullName>
        <active>true</active>
        <description>Validate If End Date is modify should not exceed Campaigns End Date in Edit Scenario.
Also Start Date should not decrease below Campaign Start Date in Edit Scenario.</description>
        <errorConditionFormula>AND(
	OR(
		ISNEW(),
		ISCHANGED(Core_MDF_End_Date__c),
		ISCHANGED(Core_MDF_Start_Date__c)
	),
	OR(
		Core_MDF_End_Date__c  &gt; Campaign.EndDate,
		Core_MDF_Start_Date__c &lt; Campaign.StartDate
	)
)</errorConditionFormula>
        <errorMessage>Activity date range must comply with Campaign date range.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reimbursement_Rate_Over_100_Percent</fullName>
        <active>true</active>
        <description>validate that the reimbursement rate does not exceed 100%</description>
        <errorConditionFormula>IF((VALUE
	(TRIM
		(LEFT
			(Core_MDF_Reimbursement_Rate__c,
				(FIND(&quot;%&quot;,Core_MDF_Reimbursement_Rate__c)-1)
			)
		)) &gt; 100
	),TRUE,FALSE)</errorConditionFormula>
        <errorMessage>The reimbursement rate has exceeded 100%. Please verify your values.</errorMessage>
    </validationRules>
