    <fields>
        <fullName>Core_MDF_Actual_closedt_beforeclosure_dt__c</fullName>
        <description>This field will get updated when activity is Closed Manually with the value of Actual Close Date before activity is getting manually closed.</description>
        <label>Actual Close Date Before Manual Closure</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Additional_Review_Type_txt__c</fullName>
        <externalId>false</externalId>
        <formula>IF( 
	AND(
		ISPICKVAL(Core_MDF_Budget_Type_nm__c , &apos;OEM CMP&apos;), 
		Core_MDF_Require_Additional_Review_ind__c
		), $Label.Core_MDF_Field_Review,
	IF(
		AND(
			Core_MDF_Require_Additional_Review_ind__c,
			OR(
				ISPICKVAL(Core_MDF_Budget_Type_nm__c , &apos;MDF&apos;), 
				ISPICKVAL(Core_MDF_Budget_Type_nm__c , &apos;MDF+&apos;)
			)
		), 
		$Label.Core_MDF_Marketing_Review, &apos;&apos;)
	)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Additional Review Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_AfterTheFact_Comment_txt__c</fullName>
        <label>After the Fact Comments</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_After_the_Fact_Approved_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Set flag true if the Activity approved by After The Fact</description>
        <label>After the Fact Approved</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Approval_Stage__c</fullName>
        <description>Approval Stage field is to capture in which stage the activity&apos;s approval request exists.</description>
        <label>Approval Stage</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Action_on_True_False</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Approval_Status_Stage_txt__c</fullName>
        <description>Indicator flag on the retail activity detail page, so that I can see if the activity is still within the approval queue/process and in which approval stage</description>
        <externalId>false</externalId>
        <formula>IF(	
AND(RecordType.DeveloperName == $Label.Core_MDF_PFR_Retail,
NOT(ISBLANK(Core_MDF_Approval_Step_Completed__c)),
NOT(ISBLANK(Core_MDF_Budget_Amount_Local_amt__c)),
NOT(ISPICKVAL(Core_MDF_Fund_Request_Status__c, &apos;&apos;))),
IF(
AND(
Core_MDF_Approval_Step_Completed__c == 0,
ISPICKVAL(Core_MDF_Fund_Request_Status__c ,&apos;Pending Review&apos;)
),$Label.Core_MDF_PFR_Stage_Status_GeoMarketingLead,
IF(

ISPICKVAL(Core_MDF_Fund_Request_Status__c , &apos;Pending Approval&apos;),
$Label.Core_MDF_PFR_Stage_Status_ExternalApprover,

IF(
AND(
ISPICKVAL(Core_MDF_Fund_Request_Status__c ,&apos;Pending Review&apos;),
OR(
AND(
Core_MDF_Budget_Amount_Local_amt__c &gt;= 250000,
Core_MDF_Budget_Amount_Local_amt__c &lt; 1000000,
Core_MDF_Approval_Step_Completed__c == 1
),
AND(
Core_MDF_Budget_Amount_Local_amt__c &gt;= 1000000,
Core_MDF_Approval_Step_Completed__c == 1
)
)
), $Label.Core_MDF_PFR_Stage_Status_L1,
IF(
AND(
Core_MDF_Budget_Amount_Local_amt__c &gt;= 1000000,
Core_MDF_Approval_Step_Completed__c == 2,
ISPICKVAL(Core_MDF_Fund_Request_Status__c , &apos;Pending Review&apos;)						
), $Label.Core_MDF_PFR_Stage_Status_L2,
IF(
AND(
	Core_MDF_Price_reviewer_check_ind__c,
	ISPICKVAL(Core_MDF_Fund_Request_Status__c , &apos;Pending Review&apos;),							
	OR(
		AND(
		Core_MDF_Budget_Amount_Local_amt__c &lt; 250000,
		Core_MDF_Approval_Step_Completed__c == 1
		),
		AND(
		Core_MDF_Budget_Amount_Local_amt__c &gt;= 250000,
		Core_MDF_Budget_Amount_Local_amt__c &lt; 1000000,
		Core_MDF_Approval_Step_Completed__c == 2
		),
		AND(
		Core_MDF_Budget_Amount_Local_amt__c &gt;= 1000000,
		Core_MDF_Approval_Step_Completed__c == 3
		)
	)
), $Label.Core_MDF_PFR_Stage_Status_PCT,&apos;&apos;
)
)
)
)
),&apos;&apos;
)</formula>
        <label>Status Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Approval_Step_Completed__c</fullName>
        <defaultValue>0</defaultValue>
        <externalId>false</externalId>
        <label>Approval Step Completed</label>
