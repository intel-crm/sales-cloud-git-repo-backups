        <fullName>Core_MDF_Campaign_Amount__c</fullName>
        <description>This field should be populated for RMF from Campaign Budget Amount and for IPA Account Based &amp; EEF from Campaign Reimbursement Amount</description>
        <externalId>false</externalId>
        <formula>IF(RecordType.Name == &apos;Retail Marketing Funds&apos;, Campaign.Core_MDF_Budget_Amount_amt__c,
IF(((RecordType.Name == &apos;Intel Partner Alliance&apos; &amp;&amp; Campaign.Core_MDF_Proposal_Based_Ind__c == false) || RecordType.Name == &apos;Ecosystem Extension Fund&apos;), Campaign.Core_MDF_Reimbursement_Amt__c, 0))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Core_MDF_Campaign_Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
