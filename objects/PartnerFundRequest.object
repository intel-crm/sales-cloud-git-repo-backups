TEXT(MONTH( Core_MDF_End_Date__c )) &amp;&quot;/&quot;&amp; TEXT(DAY(Core_MDF_End_Date__c )) &amp;&quot;/&quot;&amp; TEXT(YEAR(Core_MDF_End_Date__c ))</formula>
