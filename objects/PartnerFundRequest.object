    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_ActivityForCancelledCampaign</fullName>
        <active>true</active>
        <description>Activity cannot be created for cancelled campaign</description>
        <errorConditionFormula>AND( 
ISNEW(), 
NOT(AND(ISBLANK(Campaign.Id),Core_MDF_Is_Outcome_Based_Ind__c=TRUE)), 
TEXT(Campaign.Status) = $Label.Core_MDF_Activity_Cancelled_Status )</errorConditionFormula>
        <errorMessage>Activity cannot be created on this Campaign.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Activity_Required_Fields</fullName>
        <active>true</active>
        <description>Check if all the mandatory fields are populated</description>
        <errorConditionFormula>AND( NOT(AND(ISBLANK(Campaign.Id), Core_MDF_Is_Outcome_Based_Ind__c=TRUE)), OR( AND( ISNEW(), OR( ISBLANK( Core_MDF_Start_Date__c ), ISBLANK( Core_MDF_End_Date__c ), ISBLANK(Campaign.Id), ISBLANK( ChannelPartner.Id ), ChannelPartner.RecordType.DeveloperName &lt;&gt; &apos;Core_MDF_Co_Marketing&apos; ) ), OR( AND( ISCHANGED(Core_MDF_Start_Date__c), ISBLANK(Core_MDF_Start_Date__c), NOT(ISBLANK(PRIORVALUE(Core_MDF_Start_Date__c))) ), AND( ISCHANGED(Core_MDF_End_Date__c), ISBLANK(Core_MDF_End_Date__c), NOT(ISBLANK(PRIORVALUE(Core_MDF_End_Date__c))) ), ISBLANK(Campaign.Id), ISBLANK( ChannelPartner.Id ), ChannelPartner.RecordType.DeveloperName &lt;&gt; &apos;Core_MDF_Co_Marketing&apos; ) ) )</errorConditionFormula>
        <errorMessage>Please enter following Mandatory fields.
Start Date, End Date, Campaign, Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_BudgetAmtShldBeGrtr_1Dollar</fullName>
        <active>true</active>
        <description>Please enter a Budget Amount of $1 or higher (No decimal points).</description>
        <errorConditionFormula>AND(
    OR(
        ISNEW(),
        ISCHANGED(Core_MDF_Budget_Amount_Local_amt__c),
        ISCHANGED(RequestedAmount)
    ),
    OR(
        RecordType.DeveloperName = &apos;Core_MDF_Client_CoMarketing_Fund&apos;,
        RecordType.DeveloperName = &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;,
        RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;,
		RecordType.DeveloperName = &apos;Core_MDF_Ecosystem_Extension_Fund&apos;,
	RecordType.DeveloperName = &apos;Core_MDF_Co_GTM&apos;,
	AND(
	    RecordType.DeveloperName = &apos;Core_MDF_Intel_Partner_Alliance&apos;,
	    NOT( $Permission.Core_MDF_Bypass_Activity_Zero_Amount_Validation)
	)
    ),
    OR(
        Core_MDF_Budget_Amount_Local_amt__c &lt;1,
        Core_MDF_Budget_Amount_Local_amt__c &lt;&gt; FLOOR(Core_MDF_Budget_Amount_Local_amt__c ),
        RequestedAmount &lt;1
    )
)</errorConditionFormula>
        <errorMessage>Please enter a Budget Amount of $1 or higher (No decimal points).</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_BudgetType_Validation</fullName>
        <active>false</active>
        <description>Compare the PFR&apos;s budgettype with campaign&apos;s budgettype</description>
        <errorConditionFormula>AND(Core_MDF_Program__c==&quot;Retail Marketing Funds&quot;,
AND ($CustomMetadata.Trigger_Execution__mdt.Core_MDF_PFR_BT_ValidationRule.Active__c,
OR(AND(
TEXT(Core_MDF_Budget_Type_nm__c) = &quot;Retail MDF&quot;,
NOT(INCLUDES(Campaign.Core_MDF_Opal_Budget_Type_Txt__c, &quot;Retail MDF&quot;))
),
AND(
TEXT(Core_MDF_Budget_Type_nm__c) = &quot;RSA MD&quot;,
NOT(INCLUDES(Campaign.Core_MDF_Opal_Budget_Type_Txt__c, &quot;RSA MD&quot;))
))))</errorConditionFormula>
        <errorMessage>Activity budget type must match the campaign budget type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CheckActivityCancellation</fullName>
        <active>false</active>
        <description>It fires when any user tries to cancel activity if the Activity Status is &quot; In-Progress&quot; and 
&quot; Closed&quot;.</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
ISCHANGED(Core_MDF_Fund_Request_Status__c),
TEXT(Core_MDF_Fund_Request_Status__c) == &apos;Cancelled&apos;,
AND(
TEXT(PRIORVALUE(Core_MDF_Fund_Request_Status__c)) == &apos;Closed&apos;,
NOT(
OR(
$Permission.Core_MDF_CCP_Internal_CCF_Account_Manager,
$Permission.Core_MDF_CCP_Internal_SPCF_Account_Manager,
$Permission.0CP3b000000fxl1,
$Permission.Core_MDF_CCP_Internal_DCF_Account_Manager,
$Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager,
$Permission.Core_MDF_CCP_Internal_Retail_Account_Manager
)
)
)
)</errorConditionFormula>
        <errorMessage>Activity cannot be Cancelled when it is Closed status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_DCF_NotApplicableBrandsFrom2020</fullName>
        <active>true</active>
        <description>Don&apos;t allow any Xeon Processor Brand Filter in Activities to be selected when user selects start date for DCF of Jan 1, 2020</description>
        <errorConditionFormula>AND(
 RecordType.DeveloperName = &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;,
 YEAR(Core_MDF_Start_Date__c) &gt;= 2020,
INCLUDES( Core_MDF_Brand_nm__c , &apos;Intel® Xeon® E Processor&apos;) 
)</errorConditionFormula>
        <errorMessage>This Brand is not available starting Jan 1, 2020.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Date_Range_Within_Year</fullName>
        <active>false</active>
        <description>Budget date should be from same calendar year</description>
        <errorConditionFormula>AND(
	OR(
		ISNEW(),
		ISCHANGED(Core_MDF_End_Date__c),
		ISCHANGED(Core_MDF_Start_Date__c)
	),
RecordType.DeveloperName = &apos;Core_MDF_Intel_Partner_Alliance&apos;,
	YEAR( Core_MDF_End_Date__c ) &lt;&gt; YEAR( Core_MDF_Start_Date__c )
)</errorConditionFormula>
        <errorMessage>Activities cannot span multiple years.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EDateSldBeGreaterOrEqlToSDate</fullName>
        <active>true</active>
        <description>End date should always be greater than equal to start date</description>
        <errorConditionFormula>( RecordType.DeveloperName = &apos;Core_MDF_Client_CoMarketing_Fund&apos; ||
RecordType.DeveloperName = &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;||
RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos; ||
RecordType.DeveloperName = &apos;Core_MDF_Intel_Partner_Alliance&apos; || 
RecordType.DeveloperName = &apos;Core_MDF_Ecosystem_Extension_Fund&apos; ||
RecordType.DeveloperName = &apos;Core_MDF_Co_GTM&apos;) &amp;&amp;
(Core_MDF_End_Date__c &lt; Core_MDF_Start_Date__c)</errorConditionFormula>
        <errorMessage>End date cannot be Lesser than start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Edit_Acty_AfterCancelled</fullName>
        <active>true</active>
        <description>User Should not able to edit Activity when it is already cancelled</description>
        <errorConditionFormula>AND(
NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
NOT(AND(
    Core_MDF_Budget_Amount_Local_amt__c = 0,
    Core_MDF_Proposal_Based_Ind__c = true
)),
NOT(ISCHANGED(Core_MDF_Fund_Request_Status__c)),
ISPICKVAL(Core_MDF_Fund_Request_Status__c,&quot;Cancelled&quot;),
NOT(ISNEW()),
NOT(ISCHANGED(Core_MDF_PriorValueStatusForExternalUser__c)),
NOT(AND(
    TEXT(Core_MDF_Activity_Level_nm__c) = &quot;Sub Activity&quot;,
    ISCHANGED(Core_MDF_Fund_Request_Status__c),
    ISPICKVAL(PRIORVALUE(Core_MDF_Fund_Request_Status__c), &quot;Cancelled&quot;)
))
)</errorConditionFormula>
        <errorMessage>Cannot edit Cancelled Activities</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_MemberEvent_Type_Error</fullName>
        <active>true</active>
        <description>Restrict users to create an activity with Activity Type as &quot;Member Event&quot;</description>
        <errorConditionFormula>AND( Core_MDF_Program__c != &quot;Retail Marketing Funds&quot;,OR(AND( ISNEW() , ISPICKVAL( Core_MDF_Activity_Types__c , &quot;Member Event&quot;)), AND(ISCHANGED(Core_MDF_Activity_Types__c),ISPICKVAL( Core_MDF_Activity_Types__c , &quot;Member Event&quot;)) ))</errorConditionFormula>
        <errorDisplayField>Core_MDF_Activity_Types__c</errorDisplayField>
        <errorMessage>Please select a value other than Member Event for Activity Type field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Number_of_Pages_Eligible</fullName>
        <active>false</active>
        <description>This will validate if Activity Category is Print Media but # of pages information is not filled.</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
 ISPICKVAL(Core_MDF_ActivityCategory__c ,&apos;Print Media&apos;),
 ISBLANK(Core_MDF_ofPagesEligible__c))</errorConditionFormula>
        <errorMessage>Please fill out the # Pages Eligible For field before submitting the activity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Number_of_Pages_PayingFor</fullName>
        <active>false</active>
        <description>This will validate if Activity Category is Print Media but # of pages information is not filled.</description>
        <errorConditionFormula>AND( NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),

ISPICKVAL(Core_MDF_ActivityCategory__c ,&apos;Print Media&apos;) , ISBLANK(Core_MDF_pagespayingfor__c))</errorConditionFormula>
        <errorMessage>Please fill out the # Pages Paying For field before submitting the activity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_OutcomeCampaign_OptInError</fullName>
        <active>true</active>
        <description>Restrict creation of activity where campaign field is Core_MDF_CampOutcomeOpt_In_Ind__c
marked as true and activity category/type is other than(not) outcome based</description>
        <errorConditionFormula>AND( 
ISNEW(), 
 OR($Label.Core_MDF_IPA_RecordType = RecordType.DeveloperName,$Label.Core_MDF_PFR_Retail= RecordType.DeveloperName) , TEXT(Core_MDF_ActivityCategory__c) &lt;&gt; $Label.Core_MDF_Outcome_Based_CatType, 
NOT(AND(ISBLANK(Campaign.Id),Core_MDF_Is_Outcome_Based_Ind__c=TRUE)), (Campaign.Core_MDF_CampOutcomeOpt_In_Ind__c) )</errorConditionFormula>
        <errorMessage>Outcome-based values must be chosen if the campaign is opted in for Outcome-based criteria. If any questions, please contact Program Support.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_OutcomeCampaign_OptOutError</fullName>
        <active>true</active>
        <description>Restrict creation of activity where campaign field is Core_MDF_CampOutcomeOpt_In_Ind__c
marked as false and activity category/type is outcome based</description>
        <errorConditionFormula>AND( 
ISNEW(), 
OR($Label.Core_MDF_IPA_RecordType = RecordType.DeveloperName,$Label.Core_MDF_PFR_Retail= RecordType.DeveloperName), TEXT(Core_MDF_ActivityCategory__c) == $Label.Core_MDF_Outcome_Based_CatType, 
NOT(AND(ISBLANK(Campaign.Id),Core_MDF_Is_Outcome_Based_Ind__c=TRUE)), NOT(Campaign.Core_MDF_CampOutcomeOpt_In_Ind__c) )</errorConditionFormula>
        <errorMessage>Outcome-based values can only be chosen if the campaign is opted in for Outcome-based criteria. If any questions, please contact Program Support.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_PagesEligibleAndPaying</fullName>
        <active>true</active>
        <description>To make sure the user enters positive or numbers greater than zero in &quot;number of pages eligible&quot; and &quot;Number of pages paying for&quot;</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;))
,ISPICKVAL(Core_MDF_ActivityCategory__c , &apos;Print Media&apos;),
	OR(Core_MDF_ofPagesEligible__c  &lt;= 0,
	   Core_MDF_pagespayingfor__c &lt;= 0)
	)</errorConditionFormula>
        <errorMessage>The number is too low.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Pages_Eligible_Not_Greater</fullName>
        <active>false</active>
        <description># of pages eligible number cannot be larger than # of pages paying for</description>
        <errorConditionFormula>AND( NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;))
,ISPICKVAL(Core_MDF_ActivityCategory__c , &apos;Print Media&apos;), Core_MDF_ofPagesEligible__c &gt; Core_MDF_pagespayingfor__c )</errorConditionFormula>
        <errorMessage># of Eligible Pages cannot be greater than # of Pages Member is paying for</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Reimbursement_Rate_Below_0_Pct</fullName>
        <active>true</active>
        <description>Validate that the reimbursement rate does not go below 0%.</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
VALUE(TRIM(SUBSTITUTE(Core_MDF_Reimbursement_Rate__c, &quot;%&quot;, &quot;&quot;))) &lt;= 0)</errorConditionFormula>
        <errorMessage>Reimbursement rate cannot be 0%. Please check your values.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RestrictCCFBActivityCreation</fullName>
        <active>false</active>
        <description>US924030 - [Opal CCF/DCF] - Cannot create historical CCFB Activity post June 30th</description>
        <errorConditionFormula>AND(
	RecordType.DeveloperName = $Label.Core_MDF_PFR_CCF_Boost,
	AND
	(
		$CustomMetadata.01I3b000000f9hj.m1o3b000000001T.00N3b000006w1Th != Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name, 
		Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001c.00N3b000006w1Ti 
	),
	AND
	(
		$CustomMetadata.01I3b000000f9hj.m1o3b000000001Z.00N3b000006w1Th != Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name, 
		Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001c.00N3b000006w1Ti
	),
	AND
	(
		$CustomMetadata.01I3b000000f9hj.m1o3b000000001W.00N3b000006w1Th != Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name, 
		Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001c.00N3b000006w1Ti
	)
)</errorConditionFormula>
        <errorMessage>Activity cannot be created for the selected date range</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RestrictCCFDCFLegacyActivity</fullName>
        <active>false</active>
        <errorConditionFormula>OR
(
AND
(
RecordType.DeveloperName = $Label.Core_MDF_PFR_CCF,
TEXT(Core_MDF_Budget_Type_nm__c) =  $Label.Core_MDF_BudgetType_CCF1_0,
OR
( 
$CustomMetadata.01I3b000000f9hj.m1o3b000000001U.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name, $CustomMetadata.01I3b000000f9hj.m1o3b000000001a.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name,$CustomMetadata.01I3b000000f9hj.m1o3b000000001X.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name
),
OR
(
Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001U.00N3b000006w1Ti ,Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001a.00N3b000006w1Ti,Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001X.00N3b000006w1Ti
)
),
AND
(
RecordType.DeveloperName = $Label.Core_MDF_PFR_DCF,
TEXT(Core_MDF_Budget_Type_nm__c) =  $Label.Core_MDF_BudgetType_DCF1_0,
OR
(
$CustomMetadata.01I3b000000f9hj.m1o3b000000001V.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name, $CustomMetadata.01I3b000000f9hj.m1o3b000000001b.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name,
$CustomMetadata.01I3b000000f9hj.m1o3b000000001Y.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name
),
OR
(
Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001V.00N3b000006w1Ti ,
Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001b.00N3b000006w1Ti,
Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001Y.00N3b000006w1Ti
)
),	
AND
(
RecordType.DeveloperName = $Label.Core_MDF_PFR_CCF,
TEXT(Core_MDF_Budget_Type_nm__c)=  $Label.Core_MDF_BudgetType_CCF1_0,
NOT(
OR
(
$CustomMetadata.01I3b000000f9hj.m1o3b000000001U.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name, $CustomMetadata.01I3b000000f9hj.m1o3b000000001a.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name,
$CustomMetadata.01I3b000000f9hj.m1o3b000000001X.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name)
),
 Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001d.00N3b000006w1Ti
),	
AND
(
RecordType.DeveloperName = $Label.Core_MDF_PFR_DCF,
TEXT(Core_MDF_Budget_Type_nm__c) =  $Label.Core_MDF_BudgetType_DCF1_0, 
NOT(
OR
(
$CustomMetadata.01I3b000000f9hj.m1o3b000000001V.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name, $CustomMetadata.01I3b000000f9hj.m1o3b000000001b.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name,
$CustomMetadata.01I3b000000f9hj.m1o3b000000001Y.00N3b000006w1Th = Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__r.Name)
), 
Core_MDF_End_Date__c &gt; $CustomMetadata.01I3b000000f9hj.m1o3b000000001e.00N3b000006w1Ti)
)</errorConditionFormula>
        <errorMessage>Selected Budget type is not applicable for the time period selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_Event_Promotion_type</fullName>
        <active>true</active>
        <description>For Retail and IPA Programs, restricting users to select promotion activity type under event category.</description>
        <errorConditionFormula>AND(
TEXT( Core_MDF_ActivityCategory__c ) == $Label.Core_MDF_Activity_Category_Event ,
TEXT( Core_MDF_Activity_Types__c ) == $Label.Core_MDF_Activity_Type_Promotion ,
OR(
RecordType.DeveloperName =  $Label.Core_MDF_RetailProgram ,
RecordType.DeveloperName =  $Label.Core_MDF_IPA_RecordType 
)
)</errorConditionFormula>
        <errorMessage>Event-Promotion is not available for this program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_ExternalUserContentAct</fullName>
        <active>false</active>
        <description>Restrict the external user to stop creating the content creation activities</description>
        <errorConditionFormula>ISPICKVAL($User.UserType,&quot;PowerPartner&quot;)
&amp;&amp; ISPICKVAL(Core_MDF_Activity_Types__c , &quot;Content Creation&quot;)
&amp;&amp; (
    ISNEW() 
    || ( NOT(ISNEW())
    &amp;&amp; ISCHANGED(Core_MDF_Activity_Types__c)
   )
)</errorConditionFormula>
        <errorMessage>This activity type is not available. Contact your Intel Representative for more information.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_IPA_SrchBannerDisplay</fullName>
        <active>true</active>
        <description>Restrict the Search-Banner/Display for IPA program. This is applicable for RMF but not for IPA</description>
        <errorConditionFormula>$Label.Core_MDF_IPA_RecordType = RecordType.DeveloperName &amp;&amp;
(ISNEW() || 
 ISCHANGED(Core_MDF_Activity_SubType_nm__c) ||
 ISCHANGED(Core_MDF_Activity_Types__c)) &amp;&amp;
INCLUDES( Core_MDF_Activity_SubType_nm__c , &quot;Search - Banner/Display&quot;) &amp;&amp;
ISPICKVAL(Core_MDF_Activity_Types__c , &quot;Member.com&quot;)</errorConditionFormula>
        <errorMessage>Search - Banner/Display subtype is not allowed for selected activity type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Retail_One_Quarter</fullName>
        <active>false</active>
        <description>Retail activity start and end dates difference cannot be more than 13 weeks.</description>
        <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;,
NOT( AND(
ISPICKVAL( PRIORVALUE( Core_MDF_Fund_Request_Status__c ),&quot;Planned&quot;),
ISPICKVAL(Core_MDF_Fund_Request_Status__c,&quot;In-Progress&quot;)
)),
CEILING((Core_MDF_End_Date__c-Core_MDF_Start_Date__c)/7)&gt;13,
NOT(AND(ISPICKVAL( Core_MDF_Budget_Type_nm__c  ,&apos;RSA MD&apos;), Core_MDF_Ultimate_Account_Country_txt__c = &apos;Japan&apos;))
)</errorConditionFormula>
        <errorMessage>Retail activity start and end dates difference cannot be more than 13 weeks.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Single_Calender_Year</fullName>
        <active>false</active>
        <description>Budget date should be from same calendar year</description>
        <errorConditionFormula>AND(
	OR(
		ISNEW(),
		ISCHANGED(Core_MDF_End_Date__c),
		ISCHANGED(Core_MDF_Start_Date__c)
	),
	OR(
		YEAR( Core_MDF_End_Date__c ) &lt;&gt; YEAR( Core_MDF_Start_Date__c ),
			MONTH( Core_MDF_End_Date__c )- MONTH( Core_MDF_Start_Date__c )&gt; 6	
		),
		OR(
			RecordType.DeveloperName = &apos;Core_MDF_Client_CoMarketing_Fund&apos;,
			RecordType.DeveloperName = &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;,
RecordType.DeveloperName = &apos;Core_MDF_Channel_MDF&apos;,
                        RecordType.DeveloperName = &apos;Core_MDF_Service_Provider_CoMarketing_Fund&apos;,
		RecordType.DeveloperName = &apos;Core_MDF_Client_CoMarketing_Fund_Boost&apos;
),
NOT(
CONTAINS($Label.Core_MDF_OPAL_BudgetTypes, TEXT(Core_MDF_Budget_Type_nm__c )) 
		)
)</errorConditionFormula>
        <errorMessage>The budget amount is only for a single year. Please enter the dates for a single year and not more than 6 months</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_TargetAudience_Brand_Dependency</fullName>
        <active>false</active>
        <description>For Server Target Audience we are not allowed select Intel Xeon Processor</description>
        <errorConditionFormula>AND(
ISPICKVAL( Core_MDF_ProductType__c  , &quot;Server&quot;),  
ISPICKVAL( Core_MDF_Brand__c , &quot;Intel® Xeon® Processor&quot;),
OR(
RecordType.DeveloperName = &quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;,
RecordType.DeveloperName = &quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;
)
)</errorConditionFormula>
        <errorMessage>This Brand is not available for Server</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ValidateAcct_Based_on_SlctdCamp</fullName>
        <active>false</active>
        <description>Validating whether Selected Account is Child of Selected Campaign Account</description>
        <errorConditionFormula>AND(NOT(AND(CONTAINS($Label.Core_MDF_VRBypassByUser, $User.Username),$Label.Core_MDF_Is_ValidationBypassed =&apos;TRUE&apos;)),
ChannelPartner.Core_MDF_CoMarketing_Ultimate_Account__c &lt;&gt; 
Campaign.Core_MDF_Account__r.Core_MDF_CoMarketing_Ultimate_Account__c)</errorConditionFormula>
        <errorMessage>Please select account associated to the selected campaign&apos;s account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_IntelOwner_Mandate_CMP</fullName>
        <active>true</active>
        <description>Intel Owner is mandate for SP CMP,OEM CMP and Activity Type as EcosystemPartner.com</description>
        <errorConditionFormula>AND(ISNEW(),ISPICKVAL($Profile.UserType,&apos;PowerPartner&apos;),Core_MDF_Intel_Activity_Owner_Id__c =&apos;&apos;,OR(ISPICKVAL(Core_MDF_Budget_Type_nm__c,&apos;OEM CMP&apos;),ISPICKVAL(Core_MDF_Budget_Type_nm__c,&apos;SP CMP&apos;)),ISPICKVAL(Core_MDF_Activity_Types__c, &apos;EcosystemPartner.com&apos;))</errorConditionFormula>
        <errorMessage>Please select an Intel Owner for the activity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_IntelOwner_Mandate_MDF</fullName>
        <active>true</active>
        <description>Intel Owner is mandate for MDF,MDF+.</description>
        <errorConditionFormula>AND(ISNEW(),ISPICKVAL($Profile.UserType,&apos;PowerPartner&apos;),Core_MDF_Intel_Activity_Owner_Id__c =&apos;&apos;,OR(ISPICKVAL(Core_MDF_Budget_Type_nm__c, &apos;MDF&apos;) ,ISPICKVAL(Core_MDF_Budget_Type_nm__c,&apos;MDF+&apos;)))</errorConditionFormula>
        <errorMessage>Please select an Intel Owner for the activity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Validate_PrimaryOwner_Mandate</fullName>
        <active>true</active>
        <description>Primary Intel Owner Mandatory for Activating partner internal &amp; external</description>
        <errorConditionFormula>AND(
ISNEW(),
ISPICKVAL($Profile.UserType,&apos;PowerPartner&apos;),
Core_MDF_Primary_Intel_Owner_Id__c =&apos;&apos;,
$Permission.Core_MDF_CCP_Internal_EEF_Activating_Account_Manager	
)</errorConditionFormula>
        <errorMessage>Please select a Primary Intel Owner for the activity</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_restrict_categorychange</fullName>
        <active>true</active>
        <description>Restrict user to change category from outcome based model to non outcome based and vice versa</description>
        <errorConditionFormula>AND(
     ISCHANGED(Core_MDF_ActivityCategory__c),
      OR($Label.Core_MDF_IPA_RecordType = RecordType.DeveloperName,$Label.Core_MDF_PFR_Retail= RecordType.DeveloperName) ,
     NOT(AND(ISBLANK(Campaign.Id),Core_MDF_Is_Outcome_Based_Ind__c=TRUE)),
     OR(AND(TEXT(Core_MDF_ActivityCategory__c)== $Label.Core_MDF_Outcome_Based_CatType,
     TEXT( PRIORVALUE(Core_MDF_ActivityCategory__c)) &lt;&gt;  $Label.Core_MDF_Outcome_Based_CatType),
     AND( TEXT(Core_MDF_ActivityCategory__c)&lt;&gt; $Label.Core_MDF_Outcome_Based_CatType,
     TEXT( PRIORVALUE(Core_MDF_ActivityCategory__c)) ==  $Label.Core_MDF_Outcome_Based_CatType)
)
)</errorConditionFormula>
        <errorMessage>Activity Category selection change between &apos;Outcome-Based&apos; and other values is not permitted once saved</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_validateCampED_onchangePFRedate</fullName>
        <active>true</active>
        <description>Validate If End Date is modify should not exceed Campaigns End Date in Edit Scenario.
Also Start Date should not decrease below Campaign Start Date in Edit Scenario.</description>
        <errorConditionFormula>AND( 
OR( 
ISNEW(), 
ISCHANGED(Core_MDF_End_Date__c), 
ISCHANGED(Core_MDF_Start_Date__c) ), 
NOT(AND(ISBLANK(Campaign.Id),Core_MDF_Is_Outcome_Based_Ind__c=TRUE)),
OR( 
Core_MDF_End_Date__c &gt; Campaign.EndDate, 
Core_MDF_Start_Date__c &lt; Campaign.StartDate ) )</errorConditionFormula>
        <errorMessage>Activity date range must comply with Campaign date range.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reimbursement_Rate_Over_100_Percent</fullName>
        <active>true</active>
        <description>validate that the reimbursement rate does not exceed 100%</description>
        <errorConditionFormula>IF((VALUE
	(TRIM
		(LEFT
			(Core_MDF_Reimbursement_Rate__c,
				(FIND(&quot;%&quot;,Core_MDF_Reimbursement_Rate__c)-1)
			)
		)) &gt; 100
	),TRUE,FALSE)</errorConditionFormula>
        <errorMessage>The reimbursement rate has exceeded 100%. Please verify your values.</errorMessage>
    </validationRules>
