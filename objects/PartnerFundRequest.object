        <fullName>Core_MDF_Activity_CreatedByExternalUsr__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Checked the field when acitvity is created by external user</description>
        <label>isActivityCreatedByExternalUser</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Creation_Dur_Min_nbr__c</fullName>
        <description>This Field displays Duration spent by user to create an activity in minutes</description>
        <externalId>false</externalId>
        <formula>TRUNC(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24*60, 60 ),2)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Activity Creation Duration (Mins)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Creation_Duration_txt__c</fullName>
        <description>This Field displays Duration spent by user to create an activity in minutes and seconds</description>
        <externalId>false</externalId>
        <formula>IF(AND(NOT(ISBLANK(Core_MDF_EndTime_dtm__c)),(NOT(ISBLANK(Core_MDF_EndTime_dtm__c)) )),
(IF(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24 * 60, 60 ) &lt; 1,
TEXT(FLOOR(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24 * 60*60, 60 ))) &amp; &quot; Sec&quot;,
TEXT(FLOOR(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24 * 60, 60 ))) &amp; &quot; Min &quot;
&amp;
TEXT(FLOOR(MOD((Core_MDF_EndTime_dtm__c - Core_MDF_StartTime_dtm__c)* 24 * 60*60, 60 ))) &amp; &quot; Sec&quot;)),NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Activity Creation Duration</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
