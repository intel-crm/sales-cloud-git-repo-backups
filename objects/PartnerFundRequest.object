                </value>
                <value>
                    <fullName>Retail MDF</fullName>
                    <default>false</default>
                    <label>Retail MDF</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Channel_Partner_Led__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicator for whether or not this Activity is Channel Partner Led, and will thus be subject to the CP Spending Limit</description>
        <inlineHelpText>Indicator for whether or not this Activity is Channel Partner Led, and will thus be subject to the CP Spending Limit</inlineHelpText>
        <label>Channel Partner Led?</label>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Channel_Partner__c</fullName>
        <externalId>false</externalId>
        <label>Channel Partner</label>
        <length>70</length>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Competitive_Elements__c</fullName>
        <description>Does your event feature a non-qualifying product?</description>
        <inlineHelpText>Does your event include one or more Competitive Elements?</inlineHelpText>
        <label>Competitive Elements</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Yes</fullName>
