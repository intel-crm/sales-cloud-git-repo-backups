        <fullName>Core_MDF_Campaign_Reimbursement_Amt__c</fullName>
        <description>Field to store Campaign&apos;s Reimbursement Amount</description>
        <formula>IF( RecordType.DeveloperName == $Label.Core_MDF_IPA_RecordType &amp;&amp; Core_MDF_Proposal_Based_Ind__c == False, Campaign.Core_MDF_Reimbursement_Amount_Amt__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
