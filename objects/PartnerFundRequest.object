    <fields>
        <fullName>Core_MDF_Reimbursement_Rate__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
   AND( 
       Campaign.Id &lt;&gt; null, 
		(RecordType.DeveloperName = &apos;Core_MDF_Retail_Marketing_Funds&apos;)
	   ),
	TEXT(Core_MDF_Reimbursement_Rate_pct__c),
	IF( 
	   AND(
			Campaign.Id &lt;&gt; null,
			ISPICKVAL(Core_MDF_ActivityCategory__c , &apos;Event&apos;),
			(ISPICKVAL(Core_MDF_Competitive_Elements__c,&apos;Yes&apos;) = TRUE)
			), 
		TEXT((VALUE(SUBSTITUTE(TEXT(Campaign.Core_MDF_Reimbursement_Rate__c),&apos;%&apos;,&apos;&apos;))+IF(!ISNULL(Core_MDF_Incentive_pct__c),(Core_MDF_Incentive_pct__c*100),0))/ 2.0)+&apos;%&apos; ,
			IF( 
			   AND(
				   Campaign.Id &lt;&gt; null, 
				   (ISPICKVAL(Core_MDF_ActivityCategory__c, &apos;Print Media&apos;))
				   ), 
			TEXT(
				ROUND(
					(VALUE(SUBSTITUTE(TEXT(Campaign.Core_MDF_Reimbursement_Rate__c),&apos;%&apos;,&apos;&apos;))+IF(!ISNULL(Core_MDF_Incentive_pct__c),(Core_MDF_Incentive_pct__c*100),0)) * ROUND((Core_MDF_EligibleSpace__c),2),3
		)
			)+&apos;%&apos;,
			TEXT(
				VALUE(
				SUBSTITUTE(TEXT(Campaign.Core_MDF_Reimbursement_Rate__c),&apos;%&apos;,&apos;&apos;))+
				IF(!ISNULL(Core_MDF_Incentive_pct__c),(Core_MDF_Incentive_pct__c*100),0)
			)+&apos;%&apos;
	)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Reimbursement Rate</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Reimbursement_Rate_pct__c</fullName>
        <description>Reimbursement rate for Activty</description>
        <label>Reimbursement Rate</label>
