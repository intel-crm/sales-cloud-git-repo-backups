        <externalId>false</externalId>
        <formula>TEXT(MONTH( Core_MDF_Start_Date__c )) &amp;&quot;/&quot;&amp; TEXT(DAY(Core_MDF_Start_Date__c)) &amp;&quot;/&quot;&amp; TEXT(YEAR(Core_MDF_Start_Date__c)) &amp; &quot; - &quot; &amp; 
TEXT(MONTH( Core_MDF_End_Date__c )) &amp;&quot;/&quot;&amp; TEXT(DAY(Core_MDF_End_Date__c )) &amp;&quot;/&quot;&amp; TEXT(YEAR(Core_MDF_End_Date__c ))</formula>
        <label>Start Date &amp; End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
