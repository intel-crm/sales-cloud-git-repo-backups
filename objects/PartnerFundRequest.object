        <description>Eligible Space = (&apos;# of pages eligible&apos; / &apos;# of pages paying for&apos;)</description>
        <externalId>false</externalId>
        <formula>IF(((( NOT(ISNULL(Core_MDF_ofPagesEligible__c))) &amp;&amp; Core_MDF_ofPagesEligible__c &gt; 0) &amp;&amp; ((NOT(ISNULL(Core_MDF_pagespayingfor__c))) &amp;&amp; Core_MDF_pagespayingfor__c &gt; 0)), (Core_MDF_ofPagesEligible__c / Core_MDF_pagespayingfor__c), 0)</formula>
