    <fields>
        <fullName>Activity</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>AllocationId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Amount</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>BudgetId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CampaignId</fullName>
        <lookupFilter>
            <active>false</active>
            <booleanFilter>((1 AND 2) OR (3 AND 4)) AND (5 AND 6)</booleanFilter>
            <filterItems>
                <field>$Source.RecordTypeId</field>
                <operation>equals</operation>
                <value>Client Co-Marketing Fund</value>
            </filterItems>
            <filterItems>
                <field>Campaign.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Client_CoMarketing_Fund</value>
            </filterItems>
            <filterItems>
                <field>$Source.RecordTypeId</field>
                <operation>equals</operation>
                <value>Data Center Co-Marketing Fund</value>
            </filterItems>
            <filterItems>
                <field>Campaign.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Data_Center_CoMarketing_Fund</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Start_Date__c</field>
                <operation>greaterOrEqual</operation>
                <valueField>Campaign.StartDate</valueField>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_End_Date__c</field>
                <operation>lessOrEqual</operation>
                <valueField>Campaign.EndDate</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ChannelPartnerId</fullName>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_15digitId__c</fullName>
        <externalId>false</externalId>
        <formula>LEFT(Id,15)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>15digitId</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_ActivityCatagoryStatus__c</fullName>
        <defaultValue>&apos;Saved&apos;</defaultValue>
        <externalId>false</externalId>
        <label>ActivityCatagoryStatus</label>
        <length>50</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_ActivityCategory__c</fullName>
        <description>The Activity Category for this marketing Activity</description>
        <inlineHelpText>The Activity Category for this marketing Activity</inlineHelpText>
        <label>Activity Category</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Activity_Category</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Description__c</fullName>
        <description>A longer description of the activity to be performed</description>
        <inlineHelpText>A longer description of the activity to be performed</inlineHelpText>
        <label>Activity Description</label>
        <length>4000</length>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Number__c</fullName>
        <description>Auto generated activity number</description>
        <displayFormat>{00000000}</displayFormat>
        <externalId>false</externalId>
        <label>Activity #</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </fields>
