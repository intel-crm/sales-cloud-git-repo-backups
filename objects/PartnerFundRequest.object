                <sorted>false</sorted>
                <value>
                    <fullName>Out of Store</fullName>
                    <default>false</default>
                    <label>Out of Store</label>
                </value>
                <value>
                    <fullName>Online</fullName>
                    <default>false</default>
                    <label>Online</label>
                </value>
                <value>
                    <fullName>In Store</fullName>
                    <default>false</default>
                    <label>In Store</label>
                </value>
                <value>
                    <fullName>Out of Store/In Store</fullName>
                    <default>false</default>
                    <label>Out of Store/In Store</label>
                </value>
                <value>
                    <fullName>Advocacy</fullName>
                    <default>false</default>
                    <label>Advocacy</label>
                </value>
                <value>
                    <fullName>Win Screen</fullName>
                    <default>false</default>
                    <label>Win Screen</label>
                </value>
                <value>
                    <fullName>Win in Store/Out of Store</fullName>
                    <default>false</default>
                    <label>Win in Store/Out of Store</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Reimbursement_Amt_nbr__c</fullName>
        <formula>IF( RecordType.DeveloperName == $Label.Core_MDF_IPA_RecordType,
    IF(Core_MDF_Proposal_Based_Ind__c == True,
       IF(Core_MDF_Maximum_Intel_Investment_amt__c &gt; 0,Core_MDF_Maximum_Intel_Investment_amt__c,((RequestedAmount * VALUE( SUBSTITUTE(Core_MDF_Reimbursement_Rate_txt__c, &apos;%&apos;,&apos;&apos;)))/100)), 
        IF(AND(Core_MDF_Is_Outcome_Based_Ind__c == True, ISBLANK(Campaign.Id)),
            Core_MDF_Maximum_Intel_Investment_amt__c,
            IF( ISBLANK(VALUE( SUBSTITUTE(Core_MDF_Reimbursement_Rate_txt__c, &apos;%&apos;,&apos;&apos;))) ,
                ((RequestedAmount * VALUE( SUBSTITUTE( Core_MDF_Campaign_Reimbursement_Rate_txt__c , &apos;%&apos;,&apos;&apos;)))/100),
                ((RequestedAmount * VALUE( SUBSTITUTE(Core_MDF_Reimbursement_Rate_txt__c, &apos;%&apos;,&apos;&apos;)))/100)
            )
        )
    ),
    IF(RecordType.DeveloperName == $Label.Core_MDF_EEF_RecordType,
((RequestedAmount * VALUE( SUBSTITUTE(Core_MDF_Reimbursement_Rate_txt__c, &apos;%&apos;,&apos;&apos;)))/100),
IF(AND(Core_MDF_MDFReimbursement_Amt__c &gt; 0,
OR(
TEXT(Core_MDF_Budget_Type_nm__c) = $Label.Core_MDF_BudgetType_MDF, TEXT(Core_MDF_Budget_Type_nm__c) = $Label.Core_MDF_BudgetType_MDFPlus)
),
Core_MDF_MDFReimbursement_Amt__c ,
((RequestedAmount * VALUE( SUBSTITUTE( Core_MDF_Reimbursement_Rate_txt__c, &apos;%&apos;,&apos;&apos;)))/100)
))

)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Amount eligible for reimbursement for this Activity.</inlineHelpText>
        <label>Intel Contribution</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Reserved_Amount_txt__c</fullName>
        <description>Field is used to expose Amount for specific budget types( MDF,MDF+,Retail MDF,Account Plan) and display NA for other budget types in reports for Internal Users</description>
        <externalId>false</externalId>
        <formula>IF(
   ((RecordType.Name == $Label.Core_MDF_Retail_Program_Name) &amp;&amp; ISPICKVAL(Core_MDF_Budget_Type_nm__c,&apos;Retail MDF&apos;))||
   (((RecordType.Name == $Label.Core_MDF_CCF_Program_Name) || (RecordType.Name == $Label.Core_MDF_DCF_Program_Name)) &amp;&amp; ISPICKVAL(Core_MDF_Budget_Type_nm__c,&apos;MDF&apos;))||
   (((RecordType.Name == $Label.Core_MDF_CCF_Program_Name) || (RecordType.Name == $Label.Core_MDF_DCF_Program_Name)) &amp;&amp;  ISPICKVAL(Core_MDF_Budget_Type_nm__c,&apos;MDF+&apos;))||
   (RecordType.Name == $Label.Core_MDF_IPA_Program_Name),
   (&apos;$&apos;&amp;TEXT(Amount)),
   &apos;NA&apos;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Activity Reserved Amount</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
