    <fields>
        <fullName>Core_MDF_Is_Scheduled_Activity_Ind__c</fullName>
        <formula>If( CEILING(MONTH(TODAY())/4 ) == 3,
		IF(Core_MDF_End_Date__c &lt;= Date(YEAR(TODAY()),8,31) &amp;&amp; Core_MDF_End_Date__c&gt;=Date(YEAR(TODAY()),5,01),true,false)
,
	IF(CEILING(MONTH(TODAY())/4 ) == 2,
			IF(Core_MDF_End_Date__c &lt;= Date(YEAR(TODAY()),4,30) &amp;&amp; Core_MDF_End_Date__c&gt;=Date(YEAR(TODAY()),1,1),true,false)
	    ,
		
				IF(CEILING(MONTH(TODAY())/4 ) == 1,IF(Core_MDF_End_Date__c &lt;= Date(YEAR(TODAY())-1,12,31) &amp;&amp; Core_MDF_End_Date__c&gt;=Date(YEAR(TODAY())-1,9,1),true,false) , false)
		
		
		
		)
)</formula>
        <label>Is Scheduled Activity</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
