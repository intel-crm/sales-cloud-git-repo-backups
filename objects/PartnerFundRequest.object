    <fields>
        <fullName>Core_MDF_Budget_Amount_Local_amt__c</fullName>
        <description>Budget Amount in Local Currency</description>
        <externalId>false</externalId>
        <inlineHelpText>The rate is an estimate, it may be different when you submit for claiming</inlineHelpText>
        <label>Budget Amount Local</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Budget_Currency_cd__c</fullName>
        <description>The Currency of Budget Amount</description>
        <label>Currency</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Currencies</valueSetName>
        </valueSet>
    </fields>
