        <label>End Date</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Event_Format_Nm__c</fullName>
        <description>This Field stores the values of Event Format.</description>
        <label>Event Format</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <controllingField>Core_MDF_Activity_Types__c</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>In Person</fullName>
                    <default>false</default>
                    <label>In Person</label>
                </value>
                <value>
                    <fullName>Virtual Event</fullName>
                    <default>false</default>
                    <label>Virtual Event</label>
                </value>
                <value>
                    <fullName>Hybrid Event</fullName>
                    <default>false</default>
                    <label>Hybrid Event</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>Member Owned Event</controllingFieldValue>
                <controllingFieldValue>Channel Partner Owned Event</controllingFieldValue>
                <controllingFieldValue>Channel Partner Participation in Third-Party Event</controllingFieldValue>
                <controllingFieldValue>Member Participation in Third-Party Event</controllingFieldValue>
                <valueName>In Person</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Member Owned Event</controllingFieldValue>
                <controllingFieldValue>Channel Partner Owned Event</controllingFieldValue>
                <controllingFieldValue>Channel Partner Participation in Third-Party Event</controllingFieldValue>
                <controllingFieldValue>Member Participation in Third-Party Event</controllingFieldValue>
                <valueName>Virtual Event</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Member Owned Event</controllingFieldValue>
                <controllingFieldValue>Channel Partner Owned Event</controllingFieldValue>
                <controllingFieldValue>Channel Partner Participation in Third-Party Event</controllingFieldValue>
                <controllingFieldValue>Member Participation in Third-Party Event</controllingFieldValue>
                <valueName>Hybrid Event</valueName>
            </valueSettings>
        </valueSet>
    </fields>
