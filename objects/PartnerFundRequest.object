                    <label>Yes</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Country__c</fullName>
        <label>Country/Region_Old</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Country</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_Country_nm__c</fullName>
        <description>Multi-select country on PFR</description>
        <label>Country/Region</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Core_MDF_Country</valueSetName>
        </valueSet>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_CreatedBy__c</fullName>
        <description>This will populate as the First Name and Last Name if First Name is not blank. Otherwise, it will give Last Name only.</description>
        <externalId>false</externalId>
        <formula>IF (
ISPICKVAL(CreatedBy.Profile.UserType,&apos;PowerPartner&apos;),
CreatedBy.FirstName &amp; &apos; &apos; &amp; CreatedBy.LastName,
$Label.Core_MDF_Intel_System_User
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Created By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_ELC_Reminder__c</fullName>
        <description>This store the content related to ELC reminder</description>
        <label>ELC Reminder</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_EffectiveDateTime__c</fullName>
        <description>Effective date/time for picklist value</description>
        <label>Effective Date/Time</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Core_MDF_EligibleSpace__c</fullName>
        <description>Eligible Space = (&apos;# of pages eligible&apos; / &apos;# of pages paying for&apos;)</description>
        <externalId>false</externalId>
        <formula>IF((( NOT(ISNULL(Core_MDF_ofPagesEligible__c)))  &amp;&amp;  NOT(ISNULL(Core_MDF_pagespayingfor__c))), (Core_MDF_ofPagesEligible__c  /  Core_MDF_pagespayingfor__c), 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Eligible Space</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_End_Date_Is_Changed_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If the End Date field is updated, this field will be set to True.</description>
        <label>End Date Is Changed</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
