    <fields>
        <fullName>Core_MDF_Activity_Start_Quarter_txt__c</fullName>
        <description>To Show Activity Start Quarter on Member Transaction Report</description>
        <externalId>false</externalId>
        <formula>If(NOT(ISBLANK(Core_MDF_Start_Date__c)),CASE(
CEILING( MONTH( Core_MDF_Start_Date__c ) / 3 ),
1, &quot;Q1&quot;,
2, &quot;Q2&quot;,
3, &quot;Q3&quot;,
4, &quot;Q4&quot;,
&quot;&quot;),&quot;&quot;)</formula>
        <label>Activity Start Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
