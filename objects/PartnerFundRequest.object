    <fields>
        <fullName>Core_MDF_Host_Region_or_Region_txt__c</fullName>
        <description>Takes Host Region if available, else region</description>
        <externalId>false</externalId>
        <formula>IF( AND(NOT(ISPICKVAL(Core_MDF_Approval_Stage__c,&apos;Price Reviewer&apos;)),Core_MDF_Program__c = &apos;Intel Partner Alliance&apos;) , Core_MDF_Host_Region_txt__c, IF ( INCLUDES ( Core_MDF_Region_nm__c , &quot;APJ&quot; ), &quot;APJ&quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Region_nm__c , &quot;EMEA&quot; ), &quot;EMEA&quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Region_nm__c , &quot;PRC&quot; ), &quot;PRC&quot;,null ) &amp;
IF ( INCLUDES ( Core_MDF_Region_nm__c , &quot;ASMO&quot; ), &quot;ASMO&quot;,null ))</formula>
        <label>Host Region / Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Host_Region_txt__c</fullName>
        <description>This field represents the Host Region of an Account</description>
        <externalId>false</externalId>
        <formula>IF( Core_MDF_Program__c = &apos;Intel Partner Alliance&apos; , TEXT(ChannelPartner.Core_Geo__c),&apos;&apos;)</formula>
        <label>Host Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
