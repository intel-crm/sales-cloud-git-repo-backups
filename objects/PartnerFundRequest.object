    <fields>
        <fullName>Core_MDF_BU_Percent_txt__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(NOT(ISBLANK(Core_MDF_BU_Split__c)),OR(Core_MDF_BU1_Split_Percent_nbr__c &gt; 0 ,Core_MDF_BU2_Split_Percent_nbr__c &gt;0,Core_MDF_BU3_Split_Percent_nbr__c &gt;0,Core_MDF_BU4_Split_Percent_nbr__c &gt;0,Core_MDF_BU5_Split_Percent_nbr__c &gt;0)),IF(Core_MDF_BU1_Split_Percent_nbr__c &gt;0 &amp;&amp; OR(Core_MDF_BU2_Split_Percent_nbr__c=0,ISBLANK(Core_MDF_BU2_Split_Percent_nbr__c)) &amp;&amp; OR(Core_MDF_BU3_Split_Percent_nbr__c=0,ISBLANK(Core_MDF_BU3_Split_Percent_nbr__c))&amp;&amp; OR(Core_MDF_BU4_Split_Percent_nbr__c=0,ISBLANK(Core_MDF_BU4_Split_Percent_nbr__c)) &amp;&amp; OR(Core_MDF_BU4_Split_Percent_nbr__c=0,ISBLANK(Core_MDF_BU5_Split_Percent_nbr__c)),Core_MDF_BU_Split__c + &apos; - 100%; &apos;,IF(Core_MDF_BU1_Split_Percent_nbr__c &gt; 0,&apos;CCG - &apos;+ TEXT(Core_MDF_BU1_Split_Percent_nbr__c) + &apos;%; &apos;,&apos;&apos;)) +
IF(Core_MDF_BU2_Split_Percent_nbr__c&gt;0,&apos;DCG - &apos;+ TEXT(Core_MDF_BU2_Split_Percent_nbr__c) + &apos;%; &apos;,&apos;&apos;)+
IF(Core_MDF_BU3_Split_Percent_nbr__c&gt;0,&apos;IOTG - &apos;+ TEXT(Core_MDF_BU3_Split_Percent_nbr__c) + &apos;%; &apos;,&apos;&apos;) +
IF(Core_MDF_BU4_Split_Percent_nbr__c&gt;0,&apos;NSG - &apos;+ TEXT(Core_MDF_BU4_Split_Percent_nbr__c) + &apos;%; &apos;,&apos;&apos;) +
IF(Core_MDF_BU5_Split_Percent_nbr__c&gt;0,&apos;PSG - &apos;+ TEXT(Core_MDF_BU5_Split_Percent_nbr__c) + &apos;%; &apos;,&apos;&apos;),&apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Intel Business Unit Split%</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
