            <operation>equals</operation>
            <value>After the Fact</value>
        </filters>
        <filters>
            <field>Core_MDF_ATF_Approval_Reqd_ind__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
