, Core_MDF_Intel_Activity_Owner_Id__r.FirstName &amp; &apos; &apos; &amp; Core_MDF_Intel_Activity_Owner_Id__r.LastName &amp; &apos; (Intel Owner)&apos;, &apos;&apos;)</formula>
