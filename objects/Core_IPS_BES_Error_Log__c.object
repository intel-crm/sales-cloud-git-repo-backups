        <fullName>Core_IPS_Eligible_for_retry__c</fullName>
        <formula>if(AND(Core_IPS_Error_Code__c != 200, Core_IPS_Error_Code__c != 400), true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Eligible for retry</label>
