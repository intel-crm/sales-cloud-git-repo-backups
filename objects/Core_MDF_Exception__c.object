    <fields>
        <fullName>Core_MDF_Account_id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Field to Store Account with which exception is associated to</description>
        <label>Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>((1 OR 7) AND 2 AND 3) OR (4 AND 5 AND 6)</booleanFilter>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Mastered_Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_CoMarketingActive__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Program_nm__c</field>
                <operation>equals</operation>
                <value>Client, Datacenter, Service Provider Co-Marketing Fund, Client Co-Marketing Fund Boost, Intel Partner Alliance, Ecosystem Extension Fund</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Core_MDF_Co_Marketing</value>
            </filterItems>
            <filterItems>
                <field>$Source.Core_MDF_Program_nm__c</field>
                <operation>equals</operation>
                <value>Retail Marketing Funds</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_MDF_Channel_Program__r.Name</field>
                <operation>equals</operation>
                <value>Retail Marketing Funds</value>
            </filterItems>
            <filterItems>
                <field>Account.RecordType.DeveloperName</field>
                <operation>equals</operation>
                <value>Inactive_Account</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Exceptions</relationshipLabel>
        <relationshipName>Exceptions</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
