    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_AccountAndExceptionProgram</fullName>
        <active>false</active>
        <errorConditionFormula>IF( 
	AND(
		Core_MDF_Account_id__c != NULL,
        Core_MDF_Select_All_Accounts_ind__c == false,
		OR( 
			( 
			AND( 
				ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
				CONTAINS(Core_MDF_Account_id__r.Core_MDF_Channel_Program__r.Name, &apos;Client Co-Marketing Fund&apos;)
				)
			), 

			( 
			AND( 
				ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
				CONTAINS(Core_MDF_Account_id__r.Core_MDF_Channel_Program__r.Name, &apos;Data Center Co-Marketing Fund&apos;)
				) 
			), 

			( 
			AND( 
				ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
				CONTAINS(Core_MDF_Account_id__r.Core_MDF_Channel_Program__r.Name, &apos;Service Provider Co-Marketing Fund&apos;)
				) 
			),
                       
                        ( 
			AND( 
				ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),
				CONTAINS(Core_MDF_Account_id__r.Core_MDF_Channel_Program__r.Name, &apos;Client Co-Marketing Fund Boost&apos;)
				)
			) 
		) 
	)
	,FALSE,TRUE
)</errorConditionFormula>
        <errorMessage>Select Account same as Program</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Account_Selection_Mandatory</fullName>
        <active>true</active>
        <description>It makes Account Selection Mandatory on Exception</description>
        <errorConditionFormula>OR(
	AND(
		Core_MDF_Select_All_Accounts_ind__c, 
		NOT(ISBLANK(Core_MDF_Account_id__c))
	),
	AND(
		NOT(Core_MDF_Select_All_Accounts_ind__c), 
		ISBLANK(Core_MDF_Account_id__c)
	)
)</errorConditionFormula>
        <errorMessage>Please enter an account or select all accounts.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CannotChangeExceptionReason</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 NOT(ISNEW()),
 ISCHANGED(Core_MDF_Exception_Reason_nm__c),
 PRIORVALUE(Core_MDF_Exception_Reason_nm__c)!= TEXT(Core_MDF_Exception_Reason_nm__c)
)</errorConditionFormula>
        <errorMessage>Exception reason cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CheckReviewerProgramAccess</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISNEW()),OR(
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ),
NOT( $Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer )
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer )
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer)
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer),
NOT($Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer )
)
))</errorConditionFormula>
        <errorMessage>User doesn’t have access to edit this program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CheckUserPermission</fullName>
        <active>true</active>
        <description>Validates the Program selected in exception with the user permission.</description>
        <errorConditionFormula>OR( 
	AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund&quot;), 
	OR($Permission.Core_MDF_CCP_Internal_DCF_Account_Manager,
           $Permission.Core_MDF_CCP_Internal_SPCF_Account_Manager, 
           $Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager), 
	NOT($Permission.Core_MDF_CCP_Internal_CCF_Account_Manager) 
	), 

	AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;), 
	OR($Permission.Core_MDF_CCP_Internal_CCF_Account_Manager,
           $Permission.Core_MDF_CCP_Internal_SPCF_Account_Manager,
           $Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager), 
	NOT($Permission.Core_MDF_CCP_Internal_DCF_Account_Manager) 
	),
 
	AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;), 
	OR($Permission.Core_MDF_CCP_Internal_CCF_Account_Manager,     
           $Permission.Core_MDF_CCP_Internal_DCF_Account_Manager,  
           $Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager), 
	NOT($Permission.Core_MDF_CCP_Internal_SPCF_Account_Manager) 
	),

        AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;), 
	OR($Permission.Core_MDF_CCP_Internal_CCF_Account_Manager,
           $Permission.Core_MDF_CCP_Internal_DCF_Account_Manager,
           $Permission.Core_MDF_CCP_Internal_SPCF_Account_Manager), 
	NOT($Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager) 
	)
)</errorConditionFormula>
        <errorMessage>Cannot create an exception for this Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Country_Mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
	AND(
		Core_MDF_Select_All_Country_ind__c, 
		NOT(ISBLANK(Core_MDF_Country_Region_nm__c))
	),
	AND(
		NOT(Core_MDF_Select_All_Country_ind__c), 
		ISBLANK(Core_MDF_Country_Region_nm__c)
	)
)</errorConditionFormula>
        <errorMessage>Must select a Country or select All</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EndDatCannotBeLessThanStartDate</fullName>
        <active>true</active>
        <description>End date should always be greater than start date</description>
        <errorConditionFormula>Core_MDF_Exception_End_Date_dt__c &lt; Core_MDF_Exception_Start_Date_dt__c</errorConditionFormula>
        <errorMessage>End Date cannot be earlier than the Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ExceptionInDeniedOrCancelled</fullName>
        <active>true</active>
        <description>Exception cannot be edited in denied or in cancelled state. Also, the account manager will not be able to edit exception in approved state.</description>
        <errorConditionFormula>AND(
	OR(
	   ISPICKVAL(Core_MDF_Exception_Status_nm__c, &apos;Denied&apos;),
	   ISPICKVAL(Core_MDF_Exception_Status_nm__c, &apos;Cancelled&apos;),
	   AND(
		   ISPICKVAL(Core_MDF_Exception_Status_nm__c, &apos;Approved&apos;),
		   $Permission.Core_MDF_Internal_Account_Manager
		)
	),
	OR(
		ISCHANGED(Core_MDF_Country_Region_nm__c),
		ISCHANGED(Core_MDF_Activity_Cate_and_Type_nm__c),
		ISCHANGED(Core_MDF_Exception_End_Date_dt__c),
		ISCHANGED(Core_MDF_Comments_txt__c),
		ISCHANGED(Core_MDF_Company_Name_txt__c),
		ISCHANGED(Core_MDF_Exception_Reason_nm__c),
		ISCHANGED(Core_MDF_Exception_Start_Date_dt__c),
		ISCHANGED(Core_MDF_Name_of_Exception_nm__c),
		ISCHANGED(Core_MDF_Program_nm__c),
		ISCHANGED(Core_MDF_Total_Dollar_Impact_amt__c),
		ISCHANGED(Core_MDF_Issue_Description_dsc__c),
		ISCHANGED(Core_MDF_Select_All_Country_ind__c),
		ISCHANGED( Core_MDF_Account_id__c ),
		ISCHANGED( Core_MDF_Select_All_Accounts_ind__c )
	)
)</errorConditionFormula>
        <errorMessage>Cannot edit Exception in this status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_TotalBudgetImpact_Cannot_Be_Neg</fullName>
        <active>true</active>
        <description>Total Budget Cannot be negative</description>
        <errorConditionFormula>Core_MDF_Total_Dollar_Impact_amt__c &lt;= 0</errorConditionFormula>
        <errorMessage>Total Dollar Impacted cannot be less than or equal to zero.</errorMessage>
    </validationRules>
