    <validationRules>
        <fullName>Core_MDF_AccountAndExceptionProgram</fullName>
        <active>false</active>
        <errorConditionFormula>IF( 
	AND(
		Core_MDF_Account_id__c != NULL,
        Core_MDF_Select_All_Accounts_ind__c == false,
		OR( 
			( 
			AND( 
				ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
				CONTAINS(Core_MDF_Account_id__r.Core_MDF_Channel_Program__r.Name, &apos;Client Co-Marketing Fund&apos;)
				)
			), 

			( 
			AND( 
				ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
				CONTAINS(Core_MDF_Account_id__r.Core_MDF_Channel_Program__r.Name, &apos;Data Center Co-Marketing Fund&apos;)
				) 
			), 

			( 
			AND( 
				ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
				CONTAINS(Core_MDF_Account_id__r.Core_MDF_Channel_Program__r.Name, &apos;Service Provider Co-Marketing Fund&apos;)
				) 
			),
                       
                        ( 
			AND( 
				ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),
				CONTAINS(Core_MDF_Account_id__r.Core_MDF_Channel_Program__r.Name, &apos;Client Co-Marketing Fund Boost&apos;)
				)
			) 
		) 
	)
	,FALSE,TRUE
)</errorConditionFormula>
        <errorMessage>Select Account same as Program</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Account_Selection_Mandatory</fullName>
        <active>false</active>
        <description>It makes Account Selection Mandatory on Exception</description>
        <errorConditionFormula>OR(
	AND(
		Core_MDF_Select_All_Accounts_ind__c, 
		NOT(ISBLANK(Core_MDF_Account_id__c))
	),
	AND(
		NOT(Core_MDF_Select_All_Accounts_ind__c), 
		ISBLANK(Core_MDF_Account_id__c)
	)
)</errorConditionFormula>
        <errorMessage>Please enter an account or select all accounts.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CSC_Check_UserPermission</fullName>
        <active>true</active>
        <description>Validates the Program selected in exception with the user permission.</description>
        <errorConditionFormula>AND( $Permission.Core_MDF_Internal_CSC_User,
OR(
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
NOT( $Permission.Core_MDF_CCP_Internal_CCF_Acct_Mgr)

),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
NOT( $Permission.Core_MDF_CCP_Internal_DCF_Acct_Mgr)

),


AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
NOT( $Permission.Core_MDF_CCP_Internal_SPCF_Acct_Mgr)
),


AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),
NOT( $Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager)
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Retail_Marketing_Funds&quot;),
NOT( $Permission.Core_MDF_CCP_Internal_Retail_Account_Manager)
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Intel_Partner_Alliance&quot;),
NOT( $Permission.Core_MDF_CCP_Internal_IPA_Acct_Mgr)
),
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Ecosystem_Extension_Fund&quot;),
NOT(
OR($Permission.Core_MDF_CCP_Internal_EEF_Primary_Account_Manager ,
$Permission.Core_MDF_CCP_Internal_EEF_Activating_Account_Manager )

)
)
))</errorConditionFormula>
        <errorMessage>User does not have access to create an exception for this Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CannotChangeExceptionReason</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 NOT(ISNEW()),
 ISCHANGED(Core_MDF_Exception_Reason_nm__c),
 PRIORVALUE(Core_MDF_Exception_Reason_nm__c)!= TEXT(Core_MDF_Exception_Reason_nm__c)
)</errorConditionFormula>
        <errorMessage>Exception reason cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CheckReviewerProgramAccess</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISNEW()),OR(
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer ),
NOT( $Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer )
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer )
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer)
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer )
),
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Retail_Marketing_Funds&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer )
),
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Intel_Partner_Alliance&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ),
NOT($Permission.Core_MDF_Internal_IPA_Exception_Reviewer )
),
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Ecosystem_Extension_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ),
NOT($Permission.Core_MDF_Internal_EEF_Exception_Reviewer ))

))</errorConditionFormula>
        <errorMessage>User doesn’t have access to edit this program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_CheckUserPermission</fullName>
        <active>true</active>
        <description>Validates the Program selected in exception with the user permission.</description>
        <errorConditionFormula>AND(OR(
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer ),
NOT( $Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer )
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer )
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer)
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer )
),
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Retail_Marketing_Funds&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ),
NOT($Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer )
),
AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Intel_Partner_Alliance&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ),
NOT($Permission.Core_MDF_Internal_IPA_Exception_Reviewer )
),

AND( ISPICKVAL(Core_MDF_Program_nm__c ,&quot;Core_MDF_Ecosystem_Extension_Fund&quot;),
OR($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer ,
$Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer,
$Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer ),
$Permission.Core_MDF_Internal_IPA_Exception_Reviewer ,
NOT($Permission.Core_MDF_Internal_EEF_Exception_Reviewer)
)
))</errorConditionFormula>
        <errorMessage>Cannot create an exception for this Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Country_Mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(TEXT(Core_MDF_Program_nm__c) = &apos;Co-GTM&apos;), 
(OR(
	AND(
		Core_MDF_Select_All_Country_ind__c, 
		NOT(ISBLANK(Core_MDF_Country_Region_nm__c))
	),
	AND(
		NOT(Core_MDF_Select_All_Country_ind__c), 
		ISBLANK(Core_MDF_Country_Region_nm__c)
	)
)))</errorConditionFormula>
        <errorMessage>Must select a Country or select All</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_EndDatCannotBeLessThanStartDate</fullName>
        <active>true</active>
        <description>End date should always be greater than start date</description>
        <errorConditionFormula>Core_MDF_Exception_End_Date_dt__c &lt; Core_MDF_Exception_Start_Date_dt__c</errorConditionFormula>
        <errorMessage>End Date cannot be earlier than the Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ExceptionInDeniedOrCancelled</fullName>
        <active>true</active>
        <description>Exception cannot be edited in denied or in cancelled state. Also, the account manager will not be able to edit exception in approved state.</description>
        <errorConditionFormula>AND(
	OR(
	   ISPICKVAL(Core_MDF_Exception_Status_nm__c, &apos;Denied&apos;),
	   ISPICKVAL(Core_MDF_Exception_Status_nm__c, &apos;Cancelled&apos;),
	   AND(
		   ISPICKVAL(Core_MDF_Exception_Status_nm__c, &apos;Approved&apos;),                 
 $Permission.Core_MDF_Internal_Account_Manager, 
                    NOT($Permission.Core_MDF_ExceptionReviewer)                  
		)
	),
	OR(
		ISCHANGED(Core_MDF_Country_Region_nm__c),
		ISCHANGED(Core_MDF_Activity_Cate_and_Type_nm__c),
		ISCHANGED(Core_MDF_Exception_End_Date_dt__c),
		ISCHANGED(Core_MDF_Comments_txt__c),
		ISCHANGED(Core_MDF_Company_Name_txt__c),
		ISCHANGED(Core_MDF_Exception_Reason_nm__c),
		ISCHANGED(Core_MDF_Exception_Start_Date_dt__c),
		ISCHANGED(Core_MDF_Name_of_Exception_nm__c),
		ISCHANGED(Core_MDF_Program_nm__c),
		ISCHANGED(Core_MDF_Total_Dollar_Impact_amt__c),
		ISCHANGED(Core_MDF_Issue_Description_dsc__c),
		ISCHANGED(Core_MDF_Select_All_Country_ind__c),
                ISCHANGED(Core_MDF_Expose_Externally_ind__c),
		ISCHANGED(Core_MDF_Select_All_Accounts_ind__c)
	)
)</errorConditionFormula>
        <errorMessage>Cannot edit Exception in this status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ProgramChangeCheck</fullName>
        <active>false</active>
        <description>If user does not have access to exception program then program change is now allowed.</description>
        <errorConditionFormula>AND(
NOT(ISNEW()),
ISCHANGED(Core_MDF_Program_nm__c),
OR(
AND(TEXT(Core_MDF_Program_nm__c) ==  &apos;Core_MDF_Client_CoMarketing_Fund&apos; , NOT($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer)),
AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos; , NOT($Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer)),
AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Client_CoMarketing_Fund_Boost&apos; , NOT($Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer)),
AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Service_Provider_CoMarketing_Fund&apos; , NOT($Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer)),
AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Retail_Marketing_Funds&apos; , NOT($Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer)),
AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Intel_Partner_Alliance&apos; , NOT($Permission.Core_MDF_Internal_IPA_Exception_Reviewer)),
AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Ecosystem_Extension_Fund&apos; , NOT($Permission.Core_MDF_Internal_EEF_Exception_Reviewer))
)

)</errorConditionFormula>
        <errorMessage>Exception program cannot be changed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_ProgramCheckAccMgr</fullName>
        <active>true</active>
        <description>If user does not have access to exception program then program change is now allowed.</description>
        <errorConditionFormula>AND(
  OR(
        ISNEW(),
        ISCHANGED(Core_MDF_Program_nm__c)
    ),
  OR(
    AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Client_CoMarketing_Fund&apos;, NOT($Permission.Core_MDF_CCP_Internal_CCF_Acct_Mgr)),
    AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;, NOT($Permission.Core_MDF_CCP_Internal_DCF_Acct_Mgr)),
    AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Client_CoMarketing_Fund_Boost&apos;, NOT($Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager)),
    AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Service_Provider_CoMarketing_Fund&apos;, NOT($Permission.Core_MDF_CCP_Internal_SPCF_Acct_Mgr)),
    AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Retail_Marketing_Funds&apos;, NOT($Permission.Core_MDF_CCP_Internal_Retail_Account_Manager)),
    AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Intel_Partner_Alliance&apos;, NOT($Permission.Core_MDF_CCP_Internal_IPA_Acct_Mgr)),
    AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Co_GTM&apos;, NOT($Permission.Core_MDF_CCP_Internal_Co_GTM_Account_Manager)),
    AND(TEXT(Core_MDF_Program_nm__c) == &apos;Core_MDF_Ecosystem_Extension_Fund&apos;, 
      NOT(
        OR(
          $Permission.Core_MDF_CCP_Internal_EEF_Primary_Account_Manager,
          $Permission.Core_MDF_CCP_Internal_EEF_Activating_Account_Manager
        )
      )
    )
  )
)</errorConditionFormula>
        <errorMessage>User does not have access to create/edit exception for this Program.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_RestrictRecordEditToAcctManager</fullName>
        <active>true</active>
        <description>Used to restrict the edit of the exception if account manager as any other program&apos;s exception reviewer permission set</description>
        <errorConditionFormula>AND( NOT(ISNEW()), ISPICKVAL( Core_MDF_Exception_Status_nm__c ,&apos;Pending Review&apos;),NOT( ISPICKVAL(PRIORVALUE(Core_MDF_Exception_Status_nm__c),&apos;Draft&apos;))  ,

OR(AND(ISPICKVAL(Core_MDF_Program_nm__c,&apos;Core_MDF_Intel_Partner_Alliance&apos;),$Permission.Core_MDF_CCP_Internal_IPA_Acct_Mgr,NOT($Permission.Core_MDF_Internal_IPA_Exception_Reviewer)),

AND(ISPICKVAL(Core_MDF_Program_nm__c,&apos;Core_MDF_Client_CoMarketing_Fund_Boost&apos;),$Permission.Core_MDF_CCP_Internal_CCFB_Account_Manager,NOT($Permission.Core_MDF_CCP_Internal_CCF_Boost_Exception_Reviewer)),

AND(ISPICKVAL(Core_MDF_Program_nm__c,&apos;Core_MDF_Client_CoMarketing_Fund&apos;),$Permission.Core_MDF_CCP_Internal_CCF_Account_Manager,NOT($Permission.Core_MDF_CCP_Internal_CCF_Exception_Reviewer)),

AND(ISPICKVAL(Core_MDF_Program_nm__c,&apos;Core_MDF_Data_Center_CoMarketing_Fund&apos;),$Permission.Core_MDF_CCP_Internal_DCF_Acct_Mgr,NOT($Permission.Core_MDF_CCP_Internal_DCF_Exception_Reviewer)),

AND(ISPICKVAL(Core_MDF_Program_nm__c,&apos;Core_MDF_Service_Provider_CoMarketing_Fund&apos;),$Permission.Core_MDF_CCP_Internal_SPCF_Acct_Mgr,NOT($Permission.Core_MDF_CCP_Internal_SPCF_Exception_Reviewer)),

AND(ISPICKVAL(Core_MDF_Program_nm__c,&apos;Core_MDF_Retail_Marketing_Funds&apos;),$Permission.Core_MDF_CCP_Internal_Retail_Account_Manager,NOT($Permission.Core_MDF_CCP_Internal_RMF_Exception_Reviewer)),

AND(ISPICKVAL(Core_MDF_Program_nm__c,&apos;Core_MDF_Ecosystem_Extension_Fund&apos;),OR($Permission.Core_MDF_CCP_Internal_EEF_Activating_Account_Manager,$Permission.Core_MDF_CCP_Internal_EEF_Primary_Account_Manager),NOT($Permission.Core_MDF_Internal_EEF_Exception_Reviewer))
),

OR(
ISCHANGED(Core_MDF_Country_Region_nm__c),
ISCHANGED(Core_MDF_Activity_Cate_and_Type_nm__c),
ISCHANGED(Core_MDF_Exception_End_Date_dt__c),
ISCHANGED(Core_MDF_Comments_txt__c),
ISCHANGED(Core_MDF_Company_Name_txt__c),
ISCHANGED(Core_MDF_Exception_Reason_nm__c),
ISCHANGED(Core_MDF_Exception_Start_Date_dt__c),
ISCHANGED(Core_MDF_Name_of_Exception_nm__c),
ISCHANGED(Core_MDF_Program_nm__c),
ISCHANGED(Core_MDF_Total_Dollar_Impact_amt__c),
ISCHANGED(Core_MDF_Issue_Description_dsc__c),
ISCHANGED(Core_MDF_Select_All_Country_ind__c),
ISCHANGED(Core_MDF_Select_All_Accounts_ind__c),
ISCHANGED(Core_MDF_Budget_Type_nm__c),
ISCHANGED(Core_MDF_Exception_Status_nm__c)
))</errorConditionFormula>
        <errorMessage>Exception record cannot be edited</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_TotalBudgetImpact_Cannot_Be_Neg</fullName>
        <active>true</active>
        <description>Total Budget Cannot be negative</description>
        <errorConditionFormula>Core_MDF_Total_Dollar_Impact_amt__c &lt;= 0</errorConditionFormula>
        <errorMessage>Total Dollar Impacted cannot be less than or equal to zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_restrict_acc_to_allaccswitch</fullName>
        <active>true</active>
        <description>Restrict user to switch from all to specific account exception account mapping and vice versa</description>
        <errorConditionFormula>AND(
 ISCHANGED(Core_MDF_Select_All_Accounts_ind__c),
 OR(ISPICKVAL(Core_MDF_Exception_Status_nm__c, &apos;Approved&apos;),
 ISPICKVAL(Core_MDF_Exception_Status_nm__c, &apos;Pending Review&apos;)
)
)</errorConditionFormula>
        <errorMessage>Cannot edit Select All Accounts field in this status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_validate_Program_SPCF_CCFB</fullName>
        <active>false</active>
        <description>Restricts creation of exceptions with &apos;SPCF&apos; and &apos;CCFB&apos; as Program.</description>
        <errorConditionFormula>CASE(Core_MDF_Program_nm__c  , 
&quot;Service Provider Co-Marketing Fund&quot;,1,
&quot;Client Co-Marketing Fund Boost&quot;,1,0)=1</errorConditionFormula>
        <errorMessage>The values &apos;SPCF&apos; and &apos;CCFB&apos; are restricted values in the Program field. Please choose a valid value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_validate_legacy_budget_type</fullName>
        <active>true</active>
        <description>Restricts creation of exceptions with &apos;SPCF&apos; and &apos;CCFB&apos; as Program and restricts creation of exceptions with  &apos;CCF 1.0&apos; and &apos;DCF 1.0&apos; as Budget Type.</description>
        <errorConditionFormula>OR(
    AND(
        ISNEW(), 
        OR(
            ISPICKVAL(Core_MDF_Program_nm__c , &quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
            ISPICKVAL(Core_MDF_Program_nm__c , &quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),
            INCLUDES(Core_MDF_Budget_Type_nm__c , &quot;CCF 1.0&quot;),
            INCLUDES(Core_MDF_Budget_Type_nm__c , &quot;DCF 1.0&quot;)
        )
    ),
    AND(
        ISCHANGED(Core_MDF_Program_nm__c), 
        OR(
            ISPICKVAL(Core_MDF_Program_nm__c , &quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),
            ISPICKVAL(Core_MDF_Program_nm__c , &quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;)
        )
    ),
    AND(
        ISCHANGED(Core_MDF_Budget_Type_nm__c),
        OR(
            INCLUDES(Core_MDF_Budget_Type_nm__c , &quot;CCF 1.0&quot;),
            INCLUDES(Core_MDF_Budget_Type_nm__c , &quot;DCF 1.0&quot;)
        )
    )
)</errorConditionFormula>
        <errorMessage>Invalid Program/Budget Type</errorMessage>
    </validationRules>
