    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Provides a complete audit log of AI assistance during MDF Partner Fund Request submissions and approvals.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Core_MDF_AI_Confidence_Score__c</fullName>
        <description>A numeric score representing the AI model&apos;s confidence level in the generated recommendation. Higher values indicate stronger certainty. Used to assess recommendation quality and calibrate AI trust thresholds.</description>
        <externalId>false</externalId>
        <label>AI Confidence Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_AI_Recommendation_Details__c</fullName>
        <description>A JSON-serialized payload containing supplementary metadata about the AI recommendation, including the group ID, source type, field path, target object, and target record key. Used for deep auditing and traceability.</description>
        <label>AI Recommendation Details</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_AI_Recommendation__c</fullName>
        <description>The field label of the MDF activity field for which the AI generated a recommendation. Provides a human-readable identifier for the recommendation context (e.g., &quot;Campaign Description&quot;).</description>
        <externalId>false</externalId>
        <label>AI Recommendation</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_AI_Source_Files__c</fullName>
        <description>Stores the names or references of uploaded files that were used as input by the AI engine to generate the recommendation. Populated when AI Source Type is File or Combined.</description>
        <label>AI Source Files</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_AI_Source_Type__c</fullName>
        <description>Indicates the input source used to generate the AI recommendation. Description = derived from the MDF activity text description. File = derived from uploaded supporting documents. Combined = both description and files were used.
Approval Process = Recommendation for Approval Process</description>
        <label>AI Source Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Description</fullName>
                    <default>false</default>
                    <label>Description</label>
                </value>
                <value>
                    <fullName>File</fullName>
                    <default>false</default>
                    <label>File</label>
                </value>
                <value>
                    <fullName>Combined</fullName>
                    <default>false</default>
                    <label>File + Description</label>
                </value>
                <value>
                    <fullName>Approval Process</fullName>
                    <default>false</default>
                    <label>Approval Process</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Core_MDF_AI_Suggested_Value__c</fullName>
        <description>The field value recommended by the AI engine based on the analyzed input (description, files, or both). This is the raw AI output before any user action is taken.</description>
        <label>AI Suggested Value</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity_Last_Modified_Date__c</fullName>
        <description>The last modified timestamp of the associated MDF activity at the time the AI recommendation was processed. Used to correlate AI interactions with the activity&apos;s editing timeline.</description>
        <label>Activity Last Modified Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Activity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Reference to the Partner Fund Request (MDF activity) for which the AI recommendation was generated. Links this tracking record back to the originating funding request.</description>
        <label>Activity</label>
        <referenceTo>PartnerFundRequest</referenceTo>
        <relationshipLabel>AI Recommendation Trackings</relationshipLabel>
        <relationshipName>AI_Recommendation_Trackings</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Approval_Stage__c</fullName>
        <description>The approval stage of the Partner Fund Request at the time the AI recommendation was generated. Enables analysis of AI usage patterns across different stages of the MDF approval workflow.</description>
        <externalId>false</externalId>
        <label>Approval Stage</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Decision_Date__c</fullName>
        <description>The date and time when the user made a decision on the AI recommendation. Captured at the moment of save to enable time-series analysis of AI adoption trends.</description>
        <label>Decision Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Core_MDF_Final_Saved_Value__c</fullName>
        <description>The value ultimately saved on the target record after all user interactions, including any edits made after applying the AI suggestion. Reflects the true outcome of the AI recommendation flow.</description>
        <label>Final Saved Value</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>Core_MDF_Recommendation_Used__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether the user chose to apply the AI recommendation to the field. True when the suggestion was accepted (with or without subsequent edits). Used as a primary AI adoption metric.</description>
        <label>Recommendation Used</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_User_Decision__c</fullName>
        <description>Records the explicit decision made by the user regarding the AI recommendation (e.g., Accepted, Rejected, Modified). Complements the Recommendation Used flag with a descriptive outcome label.</description>
        <externalId>false</externalId>
        <label>User Decision</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Salesforce user who interacted with the AI recommendation — either applying, modifying, or dismissing it. Used for user-level adoption and behavior analysis.</description>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>AI_Recommendation_Trackings</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>AI Recommendation Tracking</label>
    <nameField>
        <displayFormat>AI-{00000}</displayFormat>
        <label>AI Tracking Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>AI Recommendation Trackings</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
