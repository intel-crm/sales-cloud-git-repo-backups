        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Internal_SF_File_Download_URL__c</fullName>
        <externalId>false</externalId>
        <formula>$Label.Core_MDF_PFRDetailLink+&apos;sfc/servlet.shepherd/document/download/&apos;+ Core_MDF_Document_Id__c+&apos;?operationContext=S1&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Internal Salesforce File Download URL</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
