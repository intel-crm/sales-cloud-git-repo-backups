        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_SFT_File_Available_ind__c</fullName>
        <defaultValue>false</defaultValue>
        <label>SFT File Available Indicator</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDF_SFT_File_Download_URL__c</fullName>
        <externalId>false</externalId>
        <formula>$Label.Core_MDF_SFT_Hyperlink + &apos;FileName=&apos; + Core_MDF_Encoded_Document_Title_txt__c
+&apos;&amp;AppFileID=&apos; + Core_MDF_App_File_Id__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SFT File Download URL</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
