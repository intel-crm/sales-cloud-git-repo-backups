        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_MDF_Int_Document_Name_txt__c</fullName>
        <externalId>false</externalId>
        <formula>IF((!Core_MDF_SFT_File_Available_ind__c) , HYPERLINK(&apos;/sfc/servlet.shepherd/document/download/&apos;+ Core_MDF_Document_Id__c +&apos;?operationContext=S1&apos;, Core_MDF_Document_Title_txt__c ,&apos;_blank&apos;), HYPERLINK(Core_MDF_SFT_File_Download_URL__c,Core_MDF_Document_Title_txt__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
