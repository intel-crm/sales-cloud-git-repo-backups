<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This custom metadata is used to maintain the Security Dashboard</description>
    <fields>
        <fullName>SCRTY_Inactive_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Whether to display the permission on dashboard or not.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Check if permission to be displayed on dashboard.</inlineHelpText>
        <label>Inactive Indicator</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>SCRTY_Permission_API_Nm__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Permission API Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SCRTY_Permission_Nm__c</fullName>
        <description>This field is used to hold the Name of the system permissions.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Name of System permissions.</inlineHelpText>
        <label>Permission Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>System Permissions Mapping</label>
    <pluralLabel>System Permissions Mappings</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
