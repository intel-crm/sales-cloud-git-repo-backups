    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object to store the members of Partner Account Group.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Comments__c</fullName>
        <description>Holds the user comments on Delinking and Relinking scenarios</description>
        <label>Comments</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Core_Business_Party_Id__c</fullName>
        <description>Holds the Unified Id of the associated Intel Account.</description>
        <externalId>false</externalId>
        <formula>Core_Intel_Account_Id__r.Core_Business_Party_Id__c</formula>
        <label>Unified ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_Inactive_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This is used to identify if the corresponding Intel Account is associated with the PAG or not.</description>
        <label>Inactive OPID Association</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Intel_Account_Id__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Account Id of the group member.</description>
        <label>Intel Account</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 AND 2</booleanFilter>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Intel Account</value>
            </filterItems>
            <filterItems>
                <field>Account.Core_Is_PAG_Member_Ind__c</field>
                <operation>equals</operation>
                <value>False</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>One Partner ID Group Members</relationshipLabel>
        <relationshipName>Partner_Account_Group_Members1</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Core_Intel_Partner_Alliance_PartnerGroup__c</fullName>
        <description>IPA Flag</description>
        <formula>Core_Intel_Account_Id__r.Core_Intel_Partner_Alliance_PartnerGroup__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IPA Account</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_MDA_Ind__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if this member is MDA (MarketPlace Designated Account). Only one member in the group is tagged as MDA.</description>
        <inlineHelpText>Indicates if this member is MDA (MarketPlace Designated Account). Only one member in the group is tagged as MDA.</inlineHelpText>
        <label>MDA Indicator</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_Partner_Account_Id__c</fullName>
        <description>Account Id of the group.</description>
        <label>One Partner ID</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Please select an Account with Record Type &apos;Partner Account Group&apos;</errorMessage>
            <filterItems>
                <field>Account.RecordTypeId</field>
                <operation>equals</operation>
                <value>Partner Account Group</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>One Partner ID Group Members</relationshipLabel>
        <relationshipName>Partner_Account_Group_Members</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Delink_Association_User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>To store the user who initiates Delinking / Association  to OPID</description>
        <label>Delink / Association Requested by</label>
        <referenceTo>User</referenceTo>
        <relationshipName>One_Partner_ID_Group_Members</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Inactive_Account__c</fullName>
        <description>If true then indicates that the corresponding Intel account is deactivated</description>
        <formula>IF( Core_Intel_Account_Id__r.RecordType.Name = &apos;Inactive Account&apos;,true , false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Inactive Account</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Intel_Account_Name__c</fullName>
        <description>Holds name of the corresponding Intel account</description>
        <externalId>false</externalId>
        <formula>Core_Intel_Account_Id__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Intel Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Intel_Record_Type_Text__c</fullName>
        <externalId>false</externalId>
        <label>Intel Record Type</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PRM_RelationshipEndDate__c</fullName>
        <label>RelationshipEndDate</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PRM_RelationshipStartDate__c</fullName>
        <label>RelationshipStartDate</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Primary_Account__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if the account is primary node and responsible for the linkage to OPID</description>
        <label>UCD Primary Account</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>UCD_Hierarchy__c</fullName>
        <description>Holds the hierarchy value of the Intel account in the UCD Hierarchy (Eg: Unified Global Customer, Unified Country Customer, Unified Location Customer or Unified Intermediate Customer)</description>
        <externalId>false</externalId>
        <formula>CASE(Core_Intel_Account_Id__r.Core_Customer_Aggregation_Type__c,
&quot;UNFD_GLBL_CUST&quot;,&quot;Unified Global Customer&quot;,
&quot;UNFD_INTRMD_CUST&quot;,&quot;Unified Intermediate Customer&quot;,
&quot;UNFD_CTRY_CUST&quot;,&quot;Unified Country Customer&quot;,
&quot;UNFD_LOC_CUST&quot;,&quot;Unified Location Customer&quot;,
&quot;&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>UCD Hierarchy</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>One Partner ID Group Member</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>OBJECT_ID</columns>
        <columns>Core_Partner_Account_Id__c</columns>
        <columns>RECORDTYPE</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Core_Partner_Account_Id__c</field>
            <operation>contains</operation>
            <value>Seashore</value>
        </filters>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>PAG-MEM-{0000000}</displayFormat>
        <label>One Partner ID Group Member Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>One Partner ID Group Members</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Standard</fullName>
        <active>true</active>
        <label>Standard</label>
    </recordTypes>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
