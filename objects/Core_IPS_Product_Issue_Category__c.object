                <default>true</default>
            </values>
            <values>
                <fullName>Inactive</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Core_Type__c</picklist>
            <values>
                <fullName>Case Subcategory</fullName>
                <default>true</default>
            </values>
        </picklistValues>
    </recordTypes>
