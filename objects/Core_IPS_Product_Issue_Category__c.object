    <fieldSets>
        <fullName>Case_Category_Edit_Fields</fullName>
        <description>This Field-set is for Edit fields</description>
        <displayedFields>
            <field>Core_Type__c</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
