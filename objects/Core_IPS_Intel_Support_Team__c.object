    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Internal support team on projects will contain Internal members like FAEs and Agents</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Add_as_Case_Interested_Party__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>Adds member as an Interested Party on New or Open Cases</inlineHelpText>
        <label>Add as Case Interested Party</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Core_IPS_Profile__c</fullName>
        <externalId>false</externalId>
        <formula>Core_IPS_User__r.Profile.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Profile</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Core_IPS_Project__c</fullName>
        <label>Premier Support Project</label>
        <referenceTo>Core_IPS_Project__c</referenceTo>
        <relationshipLabel>Intel Support Teams</relationshipLabel>
        <relationshipName>Intel_Support_Teams</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Core_IPS_User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Intel_Support_Teams</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Inactive</fullName>
                    <default>false</default>
                    <label>Inactive</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Intel Support Team</label>
    <nameField>
        <displayFormat>IST MN-{00000000}</displayFormat>
        <label>Intel Support Team Members Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Intel Support Teams</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Restrict_PrivateProjOwner_Inactive_IST</fullName>
        <active>true</active>
        <description>To disable Private Project Owner deactivation from IST</description>
        <errorConditionFormula>IF(AND( $Setup.Core_IPS_Run_Rules_Exception_Admin__c.Run_Validation_Rule__c, Core_IPS_Project__r.Core_IPS_Private__c, ISPICKVAL( Status__c , &quot;Inactive&quot;), Core_IPS_User__c ==  Core_IPS_Project__r.OwnerId ), true, false)</errorConditionFormula>
        <errorMessage>An Intel Support Team member cannot be made Inactive if currently the Project Owner.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Core_IPS_Add_Intel_Support_Team_Members</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Add Intel Support Team Members</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>false</requireRowSelection>
        <url>{!REQUIRESCRIPT(&apos;/support/console/41.0/integration.js&apos;)} 

if(sforce.console.isInConsole()){ //Checks that it is in console 
window.open(&quot;apex/Core_IPS_Add_IntelSupportTeam?isdtp=vw&amp;projectId={!Core_IPS_Project__c.Id}&quot;,&apos;_self&apos;); 
}else{ 
window.open(&quot;/apex/Core_IPS_Add_IntelSupportTeam?projectId={!Core_IPS_Project__c.Id}&quot;,&apos;_self&apos;); 
}</url>
    </webLinks>
</CustomObject>
