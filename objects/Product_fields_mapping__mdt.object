    <pluralLabel>Product fields mapping</pluralLabel>
    <validationRules>
        <fullName>Level_configuration_modification_rule</fullName>
        <active>true</active>
        <errorConditionFormula>AND(  $Profile.Name &lt;&gt; &apos;System Administrator&apos;, NOT( $Permission.Allow_Product_Configuration_change ) )</errorConditionFormula>
        <errorMessage>You are not allowed to make changes on configurations</errorMessage>
    </validationRules>
