    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object to store Commissionable Quota Periods. Each Period represents a window where the Manager will enter the Assignments and Quota Numbers for their Employees. There will be only one Period active at a time.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>CPT_End_Date__c</fullName>
        <description>The End Date of the Quota Period.</description>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>CPT_Inactive__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if the record is Inactive.</description>
        <label>Inactive</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CPT_Locked_Status__c</fullName>
        <description>No Lock: Everyone can update the Quota Setup Record.
Soft Lock: Admin can update the Quota Setup Record.
Hard Lock: No one can update the Quota Setup Record.</description>
        <inlineHelpText>No Lock: Everyone can update the Quota Setup Record.
Soft Lock: Admin can update the Quota Setup Record.
Hard Lock: No one can update the Quota Setup Record.</inlineHelpText>
        <label>Locked Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>No Lock</fullName>
                    <default>true</default>
                    <label>No Lock</label>
                </value>
                <value>
                    <fullName>Soft Lock</fullName>
                    <default>false</default>
                    <label>Soft Lock</label>
                </value>
                <value>
                    <fullName>Hard Lock</fullName>
                    <default>false</default>
                    <label>Hard Lock</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>CPT_Quota_Period__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Unique Name given to the Quota Period.</description>
        <externalId>false</externalId>
        <label>Quota Period</label>
        <length>100</length>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>CPT_Start_Date__c</fullName>
        <description>The Start Date of the Quota Period.</description>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
