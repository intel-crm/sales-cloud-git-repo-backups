    <fields>
        <fullName>Pricing_Is_Country_Mismatch_Request__c</fullName>
        <formula>IF( Text(Pricing_QuoteID__r.Pricing_End_Customer_Country_Nm__c) !=  Pricing_RequestID__r.Core_Data_Country_Nm__c , true, false)</formula>
