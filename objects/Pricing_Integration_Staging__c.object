    <listViews>
        <fullName>Tender_Pending_Failed_Status</fullName>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <columns>NAME</columns>
        <columns>Pricing_Message_Type__c</columns>
        <columns>Pricing_QuoteID__c</columns>
        <columns>Pricing_Status__c</columns>
        <columns>Pricing_Payload__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Pricing_Message_Type__c</field>
