        </filters>
        <filters>
            <field>Pricing_Status__c</field>
            <operation>equals</operation>
            <value>Pending</value>
        </filters>
        <filters>
            <field>Pricing_Status__c</field>
            <operation>equals</operation>
            <value>Failed</value>
        </filters>
