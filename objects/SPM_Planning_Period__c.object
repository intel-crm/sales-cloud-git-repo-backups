    <fields>
        <fullName>Active_Period__c</fullName>
        <description>For Testing</description>
        <externalId>false</externalId>
        <formula>IF(AND(TODAY() &gt;=  BU_Feedback_Start__c , TODAY() &lt; BU_Feedback_End__c), &quot;BU&quot;,
  IF(AND(TODAY() &gt;=  DR_Feedback_Start__c , TODAY() &lt; DR_Feedback_End__c), &quot;DR&quot;,
    IF(AND(TODAY() &gt;=  VP_Feedback_Start__c , TODAY() &lt; VP_Feedback_End__c), &quot;VP&quot;,
      IF(AND(TODAY() &gt;=  GM_Feedback_Start__c , TODAY() &lt; GM_Feedback_End__c), &quot;GM&quot;, &apos;NA&apos;))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Active Period</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
