    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Core_MDF_Check_For_Relationship_Checkbox</fullName>
        <active>true</active>
        <errorConditionFormula>AND( Core_MDF_Is_Lookup_Ind__c , Core_MDF_Is_Relationship_Ind__c )</errorConditionFormula>
        <errorMessage>More than one relationship checkbox cannot be checked at a time.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Core_MDF_Restrict_ParentObjectName</fullName>
        <active>true</active>
        <description>Parent Object Name is mandatory only for relation ship fields(not for lookup, isRelationship true)</description>
        <errorConditionFormula>OR( AND( Core_MDF_Is_Relationship_Ind__c = true,  ISBLANK( Core_MDF_Parent_Object_nm__c )), AND(Core_MDF_Is_Relationship_Ind__c = false,  NOT(ISBLANK( Core_MDF_Parent_Object_nm__c ))))</errorConditionFormula>
        <errorMessage>Parent Object Name is mandatory only when the field Is Relationship is true.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
