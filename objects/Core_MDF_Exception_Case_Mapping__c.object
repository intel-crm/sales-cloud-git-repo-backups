    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>Core_MDF_Cannot_UpdateECM_IF_Case_Closed</fullName>
        <active>true</active>
        <description>Cannot update Exception Case Mapping records.</description>
        <errorConditionFormula>AND(
	OR(
		ISCHANGED( Core_MDF_Case_id__c ),
		ISCHANGED( Core_MDF_Exception_id__c ), 
		ISCHANGED(  Core_MDF_Claim_id__c)
	)
)</errorConditionFormula>
        <errorMessage>Cannot update Exception Case Mapping records for a Case.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
