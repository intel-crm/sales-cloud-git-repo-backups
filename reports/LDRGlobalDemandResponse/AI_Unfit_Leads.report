    <customDetailFormulas>
        <calculatedFormula>IF((TODAY()-(DATEVALUE(Lead.Core_Lead_Stage_Change_Date_Time__c))) &lt; 8, &quot;&lt;7 days&quot;,
IF((TODAY()-(DATEVALUE(Lead.Core_Lead_Stage_Change_Date_Time__c))) &lt; 15, &quot;08 to 14 days&quot;,
IF((TODAY()-(DATEVALUE(Lead.Core_Lead_Stage_Change_Date_Time__c))) &lt; 30, &quot;15 to 30 days&quot;,
IF((TODAY()-(DATEVALUE(Lead.Core_Lead_Stage_Change_Date_Time__c))) &lt; 999, &quot;30+ days&quot;, &quot;&lt;7 days&quot;))))</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Days since Creation</label>
