    <description>This is a test to run my virtual pipeline</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Decision_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>THIS_YEAR,NEXT_N_YEARS:2</value>
        </criteriaItems>
        <criteriaItems>
            <column>ACCOUNT_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>startsWith</operator>
            <value>Siemens,ABB,Basler,Schneider,Datalogic,Kontron,TTTEch,Emerson,General Electric,KUKA,LEnze,Phoenix,SEW,Advantech,Beckhoff,ASML,Danfoss,Hitachi Energy,GE Healthcare,Mentor,Dspace,Apple,Rohde,Keysight,Viavi,Advantest,Synopsys,Pro Design,Envisics,Daimler,BMW,Bosch,Vector,Audi,Alstom,Volkswagen,Porsche,Mercedes</value>
        </criteriaItems>
        <criteriaItems>
            <column>ROLLUP_DESCRIPTION</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Eisele,Kahrmann,Flajolet</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
