<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <aggregates>
        <calculatedFormula>(2 * SUM(IF(
STAGE_NAME = &apos;Develop&apos;, AMOUNT:SUM, 0))) / (SUM(IF(
STAGE_NAME = &apos;Design Win&apos;, AMOUNT:SUM, 0)) - 1500000)</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <downGroupingContext>GRAND_SUMMARY</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>coverage</masterLabel>
        <reportType>OpportunityProduct</reportType>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>(2 * SUM(IF(STAGE_NAME = &apos;Qualify&apos; || STAGE_NAME = &apos;Define&apos; || STAGE_NAME = &apos;Develop&apos; || STAGE_NAME = &apos;Design&apos;, AMOUNT:SUM, 0))) / (SUM(IF(STAGE_NAME = &apos;Design Win&apos;, AMOUNT:SUM, 0)) - 1500000)</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA2</developerName>
        <downGroupingContext>GRAND_SUMMARY</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>teststst</masterLabel>
        <reportType>OpportunityProduct</reportType>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>SUM(IF(STAGE_NAME = &apos;Qualify&apos;, AMOUNT:SUM, 0)) - 1000000</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA3</developerName>
        <downGroupingContext>GRAND_SUMMARY</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>8y9y</masterLabel>
        <reportType>OpportunityProduct</reportType>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>1500000 - AMOUNT:SUM</calculatedFormula>
        <datatype>currency</datatype>
        <developerName>FORMULA4</developerName>
        <downGroupingContext>GRAND_SUMMARY</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Left to Target</masterLabel>
        <reportType>OpportunityProduct</reportType>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>B0#AMOUNT:SUM / (1500000 - B1#AMOUNT:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA5</developerName>
        <isActive>true</isActive>
        <isCrossBlock>true</isCrossBlock>
        <masterLabel>Pipeline Coverage</masterLabel>
        <scale>2</scale>
    </aggregates>
    <block>
