    <filter>
        <booleanFilter>(1 AND 2 AND (3 or 4 or 5)) AND 6</booleanFilter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>win approv,won,production win,pending,submit</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>deal</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>includes</operator>
            <value>Intel® Select Solutions,Intel Select Solutions Influence (Select Like)</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Detail__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>includes</operator>
            <value>Select Solutions - AI Inferencing,Select Solutions - BigDL on Apache Spark,Select Solutions - Blockchain for Hyperledger Fabric,Select Solutions - Genomics Analytics,Select Solutions - Google Anthos Hybrid Cloud,Select Solutions - Hardened Security with Lockheed Martin,Select Solutions - HPC and AI Converged Clusters,Select Solutions - Huawei FusionStorage,Select Solutions - Microsoft Azure Stack HCI,Select Solutions - Microsoft SQL Server Business Operations,Select Solutions - Microsoft SQL Server Linux,Select Solutions - MSFT Azure Stack,Select Solutions - MSFT SQL Server Enterprise Data Warehouse,Select Solutions - MSFT Windows Server Software Defined Storage,Select Solutions - NFVI Huawei FusionSphere,Select Solutions - NFVi with Red Hat,Select Solutions - NFVi with Ubuntu,Select Solutions - Nutanix HCI,Select Solutions - PRC Select,Select Solutions - Professional Visualization,Select Solutions - Red Hat OpenShift Containers,Select Solutions - SAP Hana Certified Appliance</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Detail__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>includes</operator>
            <value>Select Solutions - Simulation and Modeling,Select Solutions - uCPE (universal customer premise equipment),Select Solutions - Visual Cloud Delivery Network,Select Solutions - VMware Cloud Foundation (VCF),Select Solutions - VMware vSAN</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Area__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>DCG Partner Consumption $</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Matrix</format>
    <groupingsAcross>
        <dateGranularity>FiscalQuarter</dateGranularity>
        <field>OpportunityLineItem.Core_KPI_Date__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>OpportunityLineItem.Core_Status__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>ACCOUNT_NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Select with Products 2020 Recon</name>
    <params>
        <name>terr</name>
        <value>all</value>
    </params>
    <params>
        <name>open</name>
        <value>all</value>
    </params>
    <params>
        <name>probability</name>
        <value>&gt;0</value>
    </params>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>OpportunityProduct</reportType>
