    <description>Close rate</description>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>FK_NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Close Rate Open YTD&apos;26 Google/Quanta IPS</name>
    <params>
        <name>units</name>
