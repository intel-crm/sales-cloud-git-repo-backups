    <customDetailFormulas>
        <calculatedFormula>IF(
  ISPICKVAL(STATUS, &quot;Closed&quot;),
  1,
  0
)</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF2</developerName>
        <label>Closed Flag</label>
