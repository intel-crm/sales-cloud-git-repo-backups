        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Area__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>DCG Compute Deal $</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>includes</operator>
            <value>AI on IA Deal Win (Off-Prem),AI on IA Deal Win (On-Prem),Comms Infrastructure,Enterprise Analytics (Off-Prem),Enterprise Analytics (On-Prem),Enterprise High Perf Compute (Off-Prem),Enterprise High Perf Compute (On-Prem),Select Solutions (combine w/KPI above)</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Lost,Cancelled,Deleted</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
