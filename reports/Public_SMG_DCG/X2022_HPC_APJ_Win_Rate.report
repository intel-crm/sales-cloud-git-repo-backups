<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>Opportunity.Core_Wins_Oppty__c:SUM / 
(Opportunity.Core_Wins_Oppty__c:SUM + Opportunity.Core_Lost_Oppty__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Win Rate % - Oppty</masterLabel>
        <scale>1</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>1 -
(OpportunityLineItem.Core_Lost_Total_Price__c:SUM
/ OpportunityLineItem.Core_KPI_Total_Price__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Win Rate - Total Price %</masterLabel>
        <scale>1</scale>
    </aggregates>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OpportunityLineItem.Core_KPI_Total_Price__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OpportunityLineItem.Core_KPI_CPU_Units__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OpportunityLineItem.Core_Lost_Total_Price__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Opportunity.Core_Opportunity_Count__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Opportunity.Core_Wins_Oppty__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Opportunity.Core_Lost_Oppty__c</field>
    </columns>
    <columns>
        <field>Account.Core_Account_BU_Focus__c</field>
    </columns>
    <columns>
        <field>Opportunity.Core_Sales_Groups__c</field>
    </columns>
    <columns>
        <field>OpportunityLineItem.Core_Vendor__c</field>
    </columns>
    <columns>
        <field>OpportunityLineItem.Core_Account_Name__c</field>
    </columns>
    <columns>
        <field>Opportunity.Core_Solution_Area__c</field>
    </columns>
    <columns>
        <field>Opportunity.Core_Solution_Type__c</field>
    </columns>
    <columns>
        <field>Opportunity.Core_Combined_Solution_Detail__c</field>
    </columns>
    <columns>
        <field>TYPE</field>
    </columns>
    <columns>
        <field>Opportunity.Core_Opp_Prime_Account_Name__c</field>
    </columns>
    <columns>
        <field>FULL_NAME</field>
    </columns>
    <columns>
        <field>CLOSE_DATE</field>
    </columns>
    <columns>
        <field>PROBABILITY</field>
    </columns>
    <columns>
        <field>CREATED_DATE</field>
    </columns>
    <columns>
        <field>PRODUCT_NAME</field>
    </columns>
    <columns>
