    <customDetailFormulas>
        <calculatedFormula>IF(
    OR(
    Opportunity.Core_Technical_Owner_Manager__c = &quot;Tao Yan&quot;), &quot;TEG-CCG&quot;,

    IF(OR(
    Opportunity.Core_Technical_Owner_Manager__c = &quot;Yue Li&quot;), &quot;TEG-DC&quot;,
    
    IF(OR(
    Opportunity.Core_Technical_Owner_Manager__c = &quot;Jimmy Wang&quot;,
    Opportunity.Core_Technical_Owner_Manager__c = &quot;Bo Liu&quot;,
    Opportunity.Core_Technical_Owner_Manager__c = &quot;Geng Xia&quot;
    ), &quot;TEG-NEX&quot;,
    
    IF(OR(OWNER_MANAGER=&quot;Amy Li Li&quot;,
        OWNER_MANAGER=&quot;Dan Lin Chen&quot;,
        OWNER_MANAGER=&quot;Kelvin Liu&quot;,
        OWNER_MANAGER=&quot;Yong Li&quot;),&quot;DCAI OEM&quot;,

    IF(OR(OWNER_MANAGER=&quot;Wei Guo&quot;,
    OWNER_MANAGER=&quot;Arthur Yang&quot;,
    OWNER_MANAGER=&quot;Grace Geng&quot;,
    OWNER_MANAGER=&quot;heng zhang&quot;,
    OWNER_MANAGER=&quot;John Li&quot;,
    OWNER_MANAGER=&quot;Ke Bi&quot;,
    OWNER_MANAGER=&quot;Andrew Jiang&quot;),&quot;NEX Sales Team&quot;,
    
    IF(OR(OWNER_MANAGER=&quot;Yang Chen&quot;,
    OWNER_MANAGER=&quot;Yan Chang&quot;,
    OWNER_MANAGER=&quot;Alex Zhu&quot;,
    OWNER_MANAGER=&quot;Yiping Liu&quot;,
    OWNER_MANAGER=&quot;Dingjia Cai&quot;),&quot;ISG&quot;,

    IF(OR(OWNER_MANAGER=&quot;Eric Tang&quot;,
    OWNER_MANAGER=&quot;Bin Liu&quot;,
    OWNER_MANAGER=&quot;Victoria Yang&quot;),&quot;STSG&quot;,
    
    
    IF(OR(
    OWNER_MANAGER=&quot;Kai Hu&quot;),&quot;NWCSP&quot;,

        IF(OR(OWNER_MANAGER=&quot;Jim Gong&quot;,
    OWNER_MANAGER=&quot;Hongbo Cui&quot;),&quot;Enterprise&quot;,

        IF(OR(
    OWNER_MANAGER=&quot;Jay Yu&quot;,
    OWNER_MANAGER=&quot;Carol Qin&quot;,
    OWNER_MANAGER=&quot;Wanjie Wang&quot;,
    OWNER_MANAGER=&quot;Ryan Sun&quot;),&quot;Public Sector&quot;,
    
    IF(OR(OWNER_MANAGER=&quot;Tiffany Xia&quot;,
    OWNER_MANAGER=&quot;Stanley Wang&quot;,
    OWNER_MANAGER=&quot;James Zheng&quot;,
    OWNER_MANAGER=&quot;Hunter Li&quot;,
    OWNER_MANAGER=&quot;Carol Qin&quot;,
    OWNER_MANAGER=&quot;Wanjie Wang&quot;,
    OWNER_MANAGER=&quot;Ryan Sun&quot;),&quot;TABB&quot;,

    IF(OR(OWNER_MANAGER=&quot;Gavin Gao&quot;,
    OWNER_MANAGER=&quot;Kuo Liao&quot;,
    OWNER_MANAGER=&quot;Chen Guang Yang&quot;,
    FULL_NAME=&quot;Gavin Gao&quot;,
     FULL_NAME=&quot;Kuo Liao&quot;,
    FULL_NAME=&quot;Chen Guang Yang&quot;),&quot;CoSP&quot;,
    
    &quot;Other&quot;)
    )
    )
    )
    )
    )))))))</calculatedFormula>
