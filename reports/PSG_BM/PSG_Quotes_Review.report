    </columns>
    <description>It gives an overview of quotes in &apos;In Review&apos; status across Geos over a time period.</description>
    <filter>
        <criteriaItems>
            <column>SBQQ__Quote__c$SBQQ__Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Draft,New,In Progress,In Review,Pending,Approved,Denied,Presented,Accepted,Rejected,Submitted,Won,Lost,Cancelled,Recalled,Not Yet Approved</value>
        </criteriaItems>
        <criteriaItems>
            <column>SBQQ__Quote__c$SBQQ__Distributor__c.Core_Geo__c</column>
