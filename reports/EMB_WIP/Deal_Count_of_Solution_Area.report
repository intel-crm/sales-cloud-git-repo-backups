<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>1-(Opportunity.Core_Low_Quality__c:SUM/Opportunity.Core_Oppty_Count__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>% Good Quality</masterLabel>
        <scale>0</scale>
    </aggregates>
    <columns>
        <field>Opportunity.Core_Sales_Groups__c</field>
    </columns>
    <columns>
        <field>PRODUCT_NAME</field>
    </columns>
    <columns>
        <field>OpportunityLineItem.Core_Status__c</field>
    </columns>
    <columns>
