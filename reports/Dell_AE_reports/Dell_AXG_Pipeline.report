    <description>Dell AXG Pipeline</description>
    <filter>
        <booleanFilter>1 AND 3 AND (2 OR 4) AND 5</booleanFilter>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Deal: Partner Scale-enable</value>
        </criteriaItems>
        <criteriaItems>
            <column>PRODUCT_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>CPU Max 9480,CPU Max 9470C,CPU Max 9470,CPU Max 9468,CPU Max 9462,CPU Max 9460,Sapphire Rapids HBM,Rialto Bridge,Ponte Vecchio,GPU Max 1550,GPU Max 1350,GPU Max 1100,Arctic Sound,GPU Flex 170,GPU Flex 140,Falcon Shores</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Vendor__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>dell</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_BU_Short_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>AXG</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Owner_Geo__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>EMEA,APJ,ASMO,PRC</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
