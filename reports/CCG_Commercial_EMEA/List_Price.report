    <customDetailFormulas>
        <calculatedFormula>IF (UNIT_PRICE=0, &quot;Sales price = $0.00&quot;,
IF (PRODUCT_PRICE=0, &quot;List price = $0.00, Sales price is NOT $0.00&quot;,
IF (UNIT_PRICE&lt;PRODUCT_PRICE, &quot;Sales price is low&quot;, 
IF (UNIT_PRICE&gt;PRODUCT_PRICE, &quot;Sales price is high&quot;, 
IF (UNIT_PRICE=PRODUCT_PRICE, &quot;No difference&quot;, &quot;ERROR&quot;)))))</calculatedFormula>
