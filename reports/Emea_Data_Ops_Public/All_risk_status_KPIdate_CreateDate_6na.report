    <customDetailFormulas>
        <calculatedFormula>IF(Opportunity.Core_Products_At_Risk_Count__c&gt;0,OpportunityLineItem.Core_Lost_Total_Price__c, 0)</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Total Lost At Risk</label>
