<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <aggregates>
        <calculatedFormula>IF (B1#RowCount&gt;0, 1, 
IF (B0#RowCount&gt;0, 1, 0))</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <downGroupingContext>Opportunity.Core_Opportunity_ID__c</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>true</isCrossBlock>
        <masterLabel>Total Opportunities</masterLabel>
        <scale>0</scale>
    </aggregates>
    <block>
        <blockInfo>
            <blockId>B0</blockId>
            <joinTable>o</joinTable>
        </blockInfo>
        <columns>
            <field>OWNER_MANAGER</field>
        </columns>
        <columns>
            <field>OWNER_FULL_NAME</field>
        </columns>
        <columns>
            <field>MEMBER_NAME</field>
        </columns>
        <columns>
            <field>ACCOUNT.NAME</field>
        </columns>
        <columns>
            <aggregateTypes>Unique</aggregateTypes>
            <field>OPPORTUNITY.NAME</field>
        </columns>
        <columns>
            <field>MEMBER_ROLE</field>
        </columns>
        <columns>
            <field>OpportunityTeamMember.Core_Description_of_Contribution__c</field>
        </columns>
        <columns>
            <field>OpportunityTeamMember.Core_Date_Added__c</field>
        </columns>
        <filter>
            <criteriaItems>
                <column>OpportunityTeamMember.Core_Date_Added__c</column>
                <columnToColumn>false</columnToColumn>
                <isUnlocked>true</isUnlocked>
                <operator>greaterOrEqual</operator>
                <value>LAST_MONTH</value>
            </criteriaItems>
            <criteriaItems>
                <column>MEMBER_NAME</column>
                <columnToColumn>false</columnToColumn>
                <isUnlocked>true</isUnlocked>
                <operator>equals</operator>
                <value>Jimmy Wai,Rory Browne,Everton Paulino,Rafael Escalante Alfonso,Ruben Gomez Arteaga,Mattur Mattur,Ahmed Al-Jeshi,Chloe Lewis,Federico Canete,Karie Gardner,Traci Taylor,Yuan Xu,Franck Vigilant,Huipeng Deng,Jimin Cai,Marty Liang,Qingfeng Zhang,Tong Chen,Wei Yang,Xiaobao Gu,Xiaolei Ren,Yu-Ping Zhao,Illyse Sheaffer,Leila Sabeti,Gianluca Cecchi,Oliver Heard,Chaoqing Zhao,Emily ZHOU,Jiang Chen,Jianqian Zhou,Lan Ding,Lianghou Xu,Myles Hu,Wei Wen,Wei Yu,Xingxian Luo,yang lu,Dave Buchholz,Matthew Harrison,Michael BQ Yao,Abhishek Kumar Singh,Fouzhan Hosseini,Pamina Karvela,Feng Gao,Shuangfei Yu,Joab Paiva,Darek Wittek</value>
            </criteriaItems>
            <criteriaItems>
                <column>MEMBER_ROLE</column>
                <columnToColumn>false</columnToColumn>
                <isUnlocked>true</isUnlocked>
                <operator>notEqual</operator>
                <value>Technical Owner (100%),Technical Owner (100% commitment over the lifetime of the opportunity)</value>
            </criteriaItems>
            <criteriaItems>
                <column>Account.Core_Sales_Groups__c</column>
                <columnToColumn>false</columnToColumn>
                <isUnlocked>true</isUnlocked>
                <operator>equals</operator>
                <value>EMEA Hosted Sales Group,EMEA Partner Holding,EMEA Sales Group</value>
            </criteriaItems>
        </filter>
        <format>Summary</format>
        <name>All TSSs added to opps</name>
        <params>
            <name>terr</name>
            <value>all</value>
        </params>
        <params>
            <name>include</name>
            <value>all</value>
        </params>
        <params>
            <name>co</name>
            <value>1</value>
        </params>
        <reportType>OpportunityTeam</reportType>
        <scope>organization</scope>
        <showGrandTotal>true</showGrandTotal>
        <showSubTotals>true</showSubTotals>
        <timeFrameFilter>
            <dateColumn>CLOSE_DATE</dateColumn>
            <interval>INTERVAL_CUSTOM</interval>
        </timeFrameFilter>
    </block>
    <block>
        <blockInfo>
            <blockId>B1</blockId>
            <joinTable>Opportunity</joinTable>
        </blockInfo>
        <columns>
            <field>Opportunity.Core_Opportunity_Supports__r$Id</field>
        </columns>
        <columns>
            <field>Opportunity.Core_Opportunity_Supports__r$Name</field>
        </columns>
        <columns>
            <field>Opportunity.Core_Opportunity_Supports__r.Core_Opportunity_Support_Team__r$Core_Status__c</field>
        </columns>
        <columns>
            <field>Opportunity.Core_Opportunity_Supports__r.Core_Opportunity_Support_Team__r$Core_Opportunity_Support_Team_Member__c</field>
        </columns>
        <columns>
            <aggregateTypes>Unique</aggregateTypes>
            <field>Opportunity$Name</field>
        </columns>
        <filter>
            <criteriaItems>
                <column>Opportunity.Core_Opportunity_Supports__r.Core_Opportunity_Support_Team__r$LastModifiedDate</column>
                <columnToColumn>false</columnToColumn>
                <isUnlocked>true</isUnlocked>
                <operator>greaterOrEqual</operator>
                <value>LAST_MONTH</value>
            </criteriaItems>
            <criteriaItems>
                <column>Opportunity.Core_Opportunity_Supports__r.Core_Opportunity_Support_Team__r$Core_Status__c</column>
                <columnToColumn>false</columnToColumn>
                <isUnlocked>true</isUnlocked>
                <operator>equals</operator>
                <value>Accepted</value>
            </criteriaItems>
        </filter>
        <format>Summary</format>
        <name>TSS Opportunity Support Members added</name>
        <params>
            <name>co</name>
            <value>1</value>
        </params>
        <reportType>Opportunities_with_Opportunity_Supports_with_Opportunity_Support_Team__c</reportType>
        <scope>organization</scope>
        <showGrandTotal>true</showGrandTotal>
        <showSubTotals>true</showSubTotals>
        <timeFrameFilter>
            <dateColumn>Opportunity.Core_Opportunity_Supports__r$CreatedDate</dateColumn>
            <interval>INTERVAL_CUSTOM</interval>
        </timeFrameFilter>
    </block>
    <blockInfo>
        <blockId xsi:nil="true"/>
        <joinTable>o</joinTable>
    </blockInfo>
    <description>Check Justin&apos;s dashboard for TSS&apos;s by name filter updates https://intel.lightning.force.com/lightning/r/Dashboard/01Z3b000001fMyPEAU/view?queryScope=userFolders</description>
    <format>MultiBlock</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.Core_Opportunity_ID__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>%opps with TSS have Opportunity Support</name>
    <params>
        <name>lsk</name>
        <value>1</value>
    </params>
    <reportType>OpportunityTeam</reportType>
    <showDetails>false</showDetails>
</Report>
