    <customDetailFormulas>
        <calculatedFormula>(IF(ISBLANK(Opportunity.Desired_End_State__c), 0, 1)) + 
(IF(ISBLANK(Opportunity.Technology_and_Readiness_Gaps__c), 0, 1)) +
(IF(ISBLANK(Opportunity.Business_Need__c), 0, 1)) +
(IF(ISBLANK(Opportunity.Technical_Need__c), 0, 1)) +
(IF(ISBLANK(Opportunity.Competitor_Threat_Mitigation__c), 0, 1))</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Populated?</label>
        <scale>0</scale>
    </customDetailFormulas>
    <filter>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
