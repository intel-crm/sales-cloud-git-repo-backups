    <description>Used by Elaine Cook, EMEA marketing</description>
    <filter>
        <booleanFilter>(1 OR 2) AND 3 AND 4</booleanFilter>
        <criteriaItems>
            <column>OPPORTUNITY_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>#WAICF,#MWC24,#MWC24Existing,#Cloudfest,#MWC2024,#MWC2024Existing,#WAICF2024,#Cloudfest2024</value>
        </criteriaItems>
        <criteriaItems>
            <column>DESCRIPTION</column>
