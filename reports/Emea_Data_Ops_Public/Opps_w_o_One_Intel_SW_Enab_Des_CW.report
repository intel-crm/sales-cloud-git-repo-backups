    <description>Opportunities without KPI=One Intel SW Enablement Design CW # but should have it</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Design: Software-enable</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_has_Solution__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
