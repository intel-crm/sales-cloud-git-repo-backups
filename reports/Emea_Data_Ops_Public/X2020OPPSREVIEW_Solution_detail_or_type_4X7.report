    <description>Solution detail or type is invalid</description>
    <filter>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Qualify,Define,Develop,Design,Group,Group Open</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Area__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>,CCG Public Sector Deal $,DCG Compute Deal $,DCG Partner Consumption $,IOTG All Deal $,IOTG Transformation Win # - Step 1 (RFP/LOI/MOU),IOTG Transformation Win # - Step 2 (Trial),Not Applicable,PSG Cloud-Enterprise-Storage Deal $,PSG IOT Deal $,PSG NFV-Comms Deal $</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>includes</operator>
            <value>vPro Manageability Standard Offering &amp; GTM Program,Unite Standard Offering &amp; GTM Program,Authenticate Standard Offering &amp; GTM Program,Commercial Client Optane Standard Offering &amp; GTM Program,SMB GTM Program,Public Sector GTM Program</value>
