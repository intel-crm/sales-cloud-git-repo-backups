    <customDetailFormulas>
        <calculatedFormula>IF(AND(CONTAINS(TEXT(PRM_Registration_Request__c.Current_Status__c), &quot;Sales&quot;), 
ISNULL(PRM_Registration_Request__c.Days_in_Sales_Pending_status__c), 
ISNULL(PRM_Registration_Request__c.Days_in_AE_Pending_status__c)), PRM_Registration_Request__c.Days_in_Open_status__c,

IF(AND(CONTAINS(TEXT(PRM_Registration_Request__c.Current_Status__c), &quot;A&amp;E&quot;), 
ISNULL (PRM_Registration_Request__c.Days_in_AE_Pending_status__c), 
ISNULL (PRM_Registration_Request__c.Days_in_Pending_status__c)), 
PRM_Registration_Request__c.Days_in_Open_status__c,

IF(AND(CONTAINS(TEXT(PRM_Registration_Request__c.Current_Status__c), &quot;A&amp;E&quot;), 
ISNULL (PRM_Registration_Request__c.Days_in_AE_Pending_status__c)), 
PRM_Registration_Request__c.Days_in_Open_status__c+PRM_Registration_Request__c.Days_in_Pending_status__c,

IF(AND(CONTAINS(TEXT(PRM_Registration_Request__c.Current_Status__c), &quot;Sales&quot;), 
ISNULL(PRM_Registration_Request__c.Days_in_Sales_Pending_status__c), 
NOT(ISNULL(PRM_Registration_Request__c.Days_in_AE_Pending_status__c))), PRM_Registration_Request__c.Days_in_Open_status__c+PRM_Registration_Request__c.Days_in_Pending_status__c,

PRM_Registration_Request__c.Days_in_Open_status__c+
(IF(AND(ISNULL(PRM_Registration_Request__c.Days_in_AE_Pending_status__c), NOT(ISNULL(PRM_Registration_Request__c.Days_in_Sales_Pending_status__c))), 0, PRM_Registration_Request__c.Days_in_AE_Pending_status__c))))))</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Days Open + Days A&amp;E Pending</label>
        <scale>2</scale>
    </customDetailFormulas>
