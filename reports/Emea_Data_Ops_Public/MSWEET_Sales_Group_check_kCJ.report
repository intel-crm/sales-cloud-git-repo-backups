    <customDetailFormulas>
        <calculatedFormula>IF(
    AND(
        CONTAINS(TEXT(Account.Core_Sales_Groups__c), &quot;APJ&quot;), NOT(TEXT(Account.Core_Geo__c)=&quot;APJ&quot;)), &quot;Not APJ&quot;, 
        IF(AND(
        CONTAINS(TEXT(Account.Core_Sales_Groups__c), &quot;Americas&quot;), NOT(TEXT(Account.Core_Geo__c)=&quot;ASMO&quot;)), &quot;Not ASMO&quot;, 
        IF(AND(
        CONTAINS(TEXT(Account.Core_Sales_Groups__c), &quot;EMEA&quot;), NOT(TEXT(Account.Core_Geo__c)=&quot;EMEA&quot;)), &quot;Not EMEA&quot;, 
        IF(AND(
        CONTAINS(TEXT(Account.Core_Sales_Groups__c), &quot;PRC&quot;), NOT(TEXT(Account.Core_Geo__c)=&quot;PRC&quot;)), &quot;Not PRC&quot;, &quot;Other&quot;))))</calculatedFormula>
