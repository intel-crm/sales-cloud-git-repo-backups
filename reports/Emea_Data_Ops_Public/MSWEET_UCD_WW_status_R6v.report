<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <acrossGroupingContext>CDF1</acrossGroupingContext>
        <calculatedFormula>RowCount / PARENTGROUPVAL(RowCount, BucketField_62002409, COLUMN_GRAND_SUMMARY)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA1</developerName>
        <downGroupingContext>BucketField_62002409</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>% Accounts</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <acrossGroupingContext>CDF1</acrossGroupingContext>
        <calculatedFormula>Account.Core_Open_Revenue_For_Account__c:SUM / PARENTGROUPVAL(Account.Core_Open_Revenue_For_Account__c:SUM, BucketField_62002409, COLUMN_GRAND_SUMMARY)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA2</developerName>
