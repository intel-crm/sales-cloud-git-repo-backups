    <customDetailFormulas>
        <calculatedFormula>IF(ACCOUNT_OWNER = &quot;Jakub Rak&quot;, &quot;DR&quot;, 
IF(Account.Core_Account_Owner_Manager__c = &quot;Malhar Thakkar&quot;, &quot;ISV Strategy Partner&quot;,
 IF(Account.Core_Account_Owner_Manager__c = &quot;Ryan Olson&quot;, &quot;INB Intel Network Builder&quot;,
 IF(AND(OR(Account.Core_Account_Owner_Manager__c = &quot;Gosia Dzul&quot;, Account.Core_Account_Owner_Manager__c = &quot;Christine Harrison&quot;), TEXT(Account.Core_Account_Primary_Coverage__c)=&quot;Partner-Led Account&quot;), &quot;DR&quot;,
  IF(AND(OR(Account.Core_Account_Owner_Manager__c = &quot;Gosia Dzul&quot;, Account.Core_Account_Owner_Manager__c = &quot;Christine Harrison&quot;), TEXT(Account.Core_Account_Primary_Coverage__c)!=&quot;Partner-Led Account&quot;), &quot;DR team - not Partner Led&quot;,
 IF(Account.Core_Account_Owner_Manager__c = &quot;Simon Windsor&quot;, &quot;EMEA Inside Scale program&quot;,
 IF(OR(Account.Core_Account_Owner_Manager__c = &quot;Simon Wilyman&quot;, Account.Core_Account_Owner_Manager__c = &quot;Paolo Righi&quot;), &quot;EMEA NEX Longtail&quot;,
 IF(OR(CONTAINS(Account.Core_Account_Owner_Department__c, &quot;PSG&quot;),CONTAINS(Account.Core_Account_Owner_Department__c, &quot;Altera&quot;)), &quot;PSG&quot;, 
 IF(CONTAINS(Account.Core_Account_Owner_Department__c, &quot;RealSense&quot;), &quot;RealSense&quot;,
 IF(ACCOUNT_OWNER = &quot;Alexey Ivanov&quot;, &quot;Alexey Ivanov&quot;,
 IF(ACCOUNT_OWNER = &quot;Uncovered Account&quot;, &quot;Uncovered&quot;, 
 IF(ACCOUNT_OWNER = &quot;A&amp;E Account Owner&quot;, &quot;A&amp;E Account Owner&quot;,
 IF(TEXT(Account.Core_Account_Primary_Coverage__c)=&quot;Partner-led Account&quot;, &quot;Other Partner-led&quot;, 
 IF(TEXT(Account.Core_Account_Primary_Coverage__c)=&quot;Other-led Account&quot;, &quot;Other Other-led&quot;,
 IF(TEXT(Account.Core_Account_Primary_Coverage__c)=&quot;Not Covered Account&quot;, &quot;Other Not Covered&quot;, &quot;Other&quot;)))))))))))))))</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Explanation</label>
        <scale>2</scale>
    </customDetailFormulas>
