    <customDetailFormulas>
        <calculatedFormula>IF(UNIT_PRICE&lt;PRODUCT_PRICE, &quot;Sales price is lower&quot;, 
IF (UNIT_PRICE&gt;PRODUCT_PRICE, &quot;Sales price is higher&quot;, 
IF (UNIT_PRICE=PRODUCT_PRICE, &quot;No difference&quot;, &quot;ERROR&quot;)))</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Sales:List Price</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>Pipeline clean up 2023</description>
