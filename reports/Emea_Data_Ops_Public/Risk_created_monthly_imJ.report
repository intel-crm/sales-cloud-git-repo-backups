    <description>MSWEET Risk (for subscription)</description>
    <filter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_At_Risk_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,New,In-Progress,Closed: Support Provided,Closed: Support Not Provided</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Risk_Create_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>LAST_N_MONTHS:13</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_At_Risk__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Loss_Cancel_Reason__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
