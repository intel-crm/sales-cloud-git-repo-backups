            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,APJ Australia &amp; New Zealand Sales Group,APJ Hosted Sales Group,APJ India Sales Group,APJ Japan Sales Group,APJ Korea Sales Group,APJ Partner Holding,APJ Southeast Asia Sales Group,APJ Taiwan Sales Group,Americas Brazil Sales Group,Americas Canada Sales Group,Americas ELAR Sales Group,Americas Hosted Sales Group,Americas Mexico Sales Group,Americas Partner Holding,Americas US Sales Group,EMEA Hosted Sales Group,EMEA Partner Holding,EMEA Sales Group,Global Accounts Sales Group,PRC Hosted Sales Group,PRC Partner Holding,PRC Sales Group,Undefined</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Risk_Reason1__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Risk - Lack of Tech Support,Risk - Other (refer to &quot;Risk Details&quot;),Risk - Pricing,Risk - Pricing Meetcomp,Risk - Product Feature/Quality/Performance,Risk - Product Roadmap/Schedule,Risk - Supply,Risk - Supply: Sample,Risk - Supply: System Build</value>
        </criteriaItems>
