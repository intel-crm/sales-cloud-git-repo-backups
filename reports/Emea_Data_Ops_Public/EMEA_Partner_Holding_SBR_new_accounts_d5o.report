    <customDetailFormulas>
        <calculatedFormula>IF(FK_ACC_OWNER_NAME = &quot;Jakub Rak&quot;, &quot;DR&quot;,
IF(FK_Account.Core_Account_Owner_Manager__c = &quot;Malhar Thakkar&quot;, &quot;ISV Strategy Partner&quot;,
 IF(FK_Account.Core_Account_Owner_Manager__c = &quot;Ryan Olson&quot;, &quot;INB Intel Network Builder&quot;,
 IF(OR(FK_Account.Core_Account_Owner_Manager__c = &quot;Gosia Dzul&quot;, FK_Account.Core_Account_Owner_Manager__c = &quot;Christine Harrison&quot;), &quot;DR&quot;,
 IF(FK_Account.Core_Account_Owner_Manager__c = &quot;Simon Windsor&quot;, &quot;EMEA Inside Scale program&quot;,
 IF(OR(FK_Account.Core_Account_Owner_Manager__c = &quot;Simon Wilyman&quot;, FK_Account.Core_Account_Owner_Manager__c = &quot;Paolo Righi&quot;), &quot;EMEA NEX Longtail&quot;, 
  IF(OR(CONTAINS(FK_Account.Core_Account_Owner_Department__c, &quot;PSG&quot;),CONTAINS(FK_Account.Core_Account_Owner_Department__c, &quot;Altera&quot;)), &quot;PSG&quot;, 
 IF(CONTAINS(FK_Account.Core_Account_Owner_Department__c, &quot;RealSense&quot;), &quot;RealSense&quot;,
 IF(FK_ACC_OWNER_NAME = &quot;Alexey Ivanov&quot;, &quot;Alexey Ivanov&quot;,
 IF(FK_ACC_OWNER_NAME = &quot;Uncovered Account&quot;, &quot;Uncovered&quot;, 
 IF(FK_ACC_OWNER_NAME = &quot;A&amp;E Account Owner&quot;, &quot;A&amp;E Account Owner&quot;,
 IF(TEXT(FK_Account.Core_Account_Primary_Coverage__c)=&quot;Partner-led Account&quot;, &quot;Other Partner-led&quot;, 
 IF(TEXT(FK_Account.Core_Account_Primary_Coverage__c)=&quot;Other-led Account&quot;, &quot;Other Other-led&quot;,
 IF(TEXT(FK_Account.Core_Account_Primary_Coverage__c)=&quot;Not Covered Account&quot;, &quot;Other Not Covered&quot;, &quot;Other&quot;))))))))))))))</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Explanation</label>
        <scale>2</scale>
    </customDetailFormulas>
