    <customDetailFormulas>
        <calculatedFormula>IF(NOT(ISPICKVAL(OpportunityLineItem.Core_Competitor_Product__c, &quot;&quot;)),
        OpportunityLineItem.Core_KPI_Total_Price__c, 0)</calculatedFormula>
        <dataType>Double</dataType>
        <description>KPI total price if with OEM competitor product</description>
        <developerName>CDF1</developerName>
        <label>Total w/CompProd</label>
        <scale>0</scale>
    </customDetailFormulas>
    <description>Pipeline subteam Risk Loss Metrics</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND ((4 AND 5) OR 6)</booleanFilter>
        <criteriaItems>
            <column>Account.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>EMEA France Sales Group,EMEA Germany Sales Group,EMEA Named Account Sales Group,EMEA Russia Sales Group,EMEA Sales Territory,EMEA UK Sales Group</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Design: Original,Design: Secondary,Design: Software-enable,Deal: Partner Scale-enable,Deal: Sell-through,Deal: Sell-to</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_At_Risk_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,New,In-Progress,Closed: Support Provided,Closed: Support Not Provided</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Pending</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_At_Risk__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Lost</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
