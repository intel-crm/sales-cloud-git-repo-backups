    <description>Closed cases with breakdown by Prime Account by Quarter</description>
    <filter>
        <criteriaItems>
            <column>RECORDTYPE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Case.Core_AAQC_Case_recordType,Case.Core_MDF_Audit,Case.Core_MDF_Audit_Closed,Case.IPS_GEC_ReadOnly</value>
        </criteriaItems>
        <criteriaItems>
            <column>Case.Core_Product_Organization__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Programmable Solutions Group</value>
        </criteriaItems>
        <criteriaItems>
            <column>Case.core_Account_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>contains</operator>
            <value>ALIBABA,ERICSSON,HUAWEI,MICROSOFT,NOKIA,ZHONGXING</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Quarter</dateGranularity>
        <field>CLOSED_DATEONLY</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
