            <column>Opportunity.Core_Concatenated_Technology_Enabled__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>OneAPI,AI Analytics Toolkit,OpenVINO</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>EMEA Sales,EMEA Hosted,EMEA Partner</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Matrix</format>
    <groupingsAcross>
