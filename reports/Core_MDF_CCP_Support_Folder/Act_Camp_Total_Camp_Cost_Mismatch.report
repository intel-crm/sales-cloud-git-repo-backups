<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>PartnerFundRequest$RequestedAmount</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>PartnerFundRequest$Campaign.Core_MDF_Total_Campaign_Cost_Amt__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>CDF1</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>IF(
  PartnerFundRequest.RequestedAmount -
  PartnerFundRequest.Campaign.Core_MDF_Total_Campaign_Cost_Amt__c &gt; 0,
  1,
  0
)</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Total Camp Cost Diff</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>This report highlights records where the sum of activity spending limit(USD) does not match the total campaign cost.</description>
    <filter>
        <criteriaItems>
            <column>PartnerFundRequest$Core_MDF_Program__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Intel Partner Alliance</value>
        </criteriaItems>
        <criteriaItems>
            <column>PartnerFundRequest$Core_MDF_Fund_Request_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Cancelled</value>
        </criteriaItems>
        <criteriaItems>
            <column>CDF1</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notEqual</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>PartnerFundRequest$Core_MDF_Proposal_Based_Ind__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>PartnerFundRequest$Campaign.Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Mismatch Act Camp Total Campaign Cost</name>
    <params>
        <name>co</name>
        <value>0</value>
    </params>
    <reportType>Co_Marketing_Activities_with_Campaign__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>false</showGrandTotal>
    <showSubTotals>false</showSubTotals>
    <timeFrameFilter>
        <dateColumn>PartnerFundRequest$Core_MDF_ToBeClosedDate__c</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
