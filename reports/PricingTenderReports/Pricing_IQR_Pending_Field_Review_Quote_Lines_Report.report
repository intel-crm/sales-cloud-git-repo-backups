    <description>Report that shows quote lines pending Field Review for 2 or more days</description>
    <filter>
        <criteriaItems>
            <column>SBQQ__Quote__c.SBQQ__LineItems__r$Pricing_Last_Submitted_Date_dt__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>lessOrEqual</operator>
            <value>LAST_N_DAYS:2</value>
        </criteriaItems>
        <criteriaItems>
            <column>SBQQ__Quote__c.SBQQ__LineItems__r$Pricing_Status_Nm__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>Pending Intel Field Review</value>
        </criteriaItems>
        <criteriaItems>
            <column>SBQQ__Quote__c.SBQQ__LineItems__r$Pricing_Program_Type_Nm__c</column>
