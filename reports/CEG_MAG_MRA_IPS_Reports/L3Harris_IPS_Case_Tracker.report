    <description>This report tracks L3Harris&apos;s IPS cases. L3Harris is the lead customer for the Bantam Bay (MCP5) program. For any questions on this report, contact Victoria Weaver</description>
    <filter>
        <criteriaItems>
            <column>STATUS</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>New,Open,​Open,​​Open,Closed,Escalated</value>
        </criteriaItems>
        <criteriaItems>
            <column>CONTACT.ACCOUNT</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
