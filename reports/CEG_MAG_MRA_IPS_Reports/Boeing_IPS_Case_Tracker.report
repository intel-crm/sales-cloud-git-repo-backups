    <description>This report tracks Boeing&apos;s IPS cases by case number, case owner, title, status, etc. Boeing is the early access lead customer for the Mammoth Bay (MCP4) program. For any questions on this report, contact Shawnna Cabanday.</description>
    <filter>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <criteriaItems>
            <column>STATUS</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>New,Open,​Open,​​Open,Closed</value>
        </criteriaItems>
        <criteriaItems>
            <column>CONTACT.NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
