    <description>RT: Leads with Converted lead info.  Shows conversion summary of  SAL%, SQL%, Won Conv%</description>
    <filter>
        <criteriaItems>
            <column>Lead.Core_Lead_State__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Terminated,Converted,Rejected</value>
        </criteriaItems>
        <criteriaItems>
            <column>LEAD_OWNER</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
