    <description>RT: Accounts  Accounts in BU Sales</description>
    <filter>
        <criteriaItems>
            <column>USERS.NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Uncovered Account</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Account_Coverage__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>OSC</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>GMP Americas Sales Territory,GMP APJ Sales Territory,GMP Brazil Sales Group,GMP EMEA Sales Territory,GMP France Sales Group,GMP Germany Sales Group,GMP India Sales Group,GMP Japan Sales Group,GMP Korea Sales Group,GMP Mexico Sales Group,GMP Russia Sales Group,GMP Taiwan Sales Group,GMP UK Sales Group,PRC Sales Group,US Sales Group</value>
        </criteriaItems>
        <criteriaItems>
            <column>User.Core_User_Geo__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>ASMO</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Account_Country__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>United States</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
