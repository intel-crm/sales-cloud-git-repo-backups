    <customDetailFormulas>
        <calculatedFormula>NOW()-LAST_UPDATE</calculatedFormula>
        <dataType>Double</dataType>
        <description>Inactive Days</description>
        <developerName>CDF1</developerName>
        <label>Inactive Days</label>
        <scale>0</scale>
    </customDetailFormulas>
    <description>Opty Health for the BR Inside Sales Team</description>
    <filter>
        <criteriaItems>
            <column>ROLLUP_DESCRIPTION</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Villamil,Ribeiro,Montenegro,Rodrigues,Ram</value>
        </criteriaItems>
        <criteriaItems>
            <column>FULL_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>*</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Design: Original,Design: Secondary,Deal: Sell-through,Deal: Sell-to</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <formattingRules>
        <aggregate>Sum</aggregate>
        <columnName>Opportunity.Core_Past_Due__c</columnName>
        <values>
            <backgroundColor>#3AE867</backgroundColor>
            <rangeUpperBound>0.0</rangeUpperBound>
        </values>
        <values>
            <backgroundColor>#FFFF93</backgroundColor>
            <rangeUpperBound>1.0</rangeUpperBound>
        </values>
        <values>
            <backgroundColor>#E74340</backgroundColor>
        </values>
    </formattingRules>
    <formattingRules>
        <aggregate>Sum</aggregate>
        <columnName>Opportunity.Core_Inactive__c</columnName>
