    <description>USED IN DASHBOARD.
This report shows the competitor OEM with all Statuses that are lost. Used to measure Competitor OEM on Lost vs. Won opportunities.</description>
    <filter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Competitor__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
