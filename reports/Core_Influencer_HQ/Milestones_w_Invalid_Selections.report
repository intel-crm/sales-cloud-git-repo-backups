    <description>If a milestone appears on this report it has blanks or invalid selections. For influencers Milestone Area, Milestone Focus, Milestone and Use Case or Key Technology all must have values.</description>
    <filter>
        <booleanFilter>(1 And 2 and 6 and (3 or 4 or 5 or (7 and 8)))</booleanFilter>
        <criteriaItems>
            <column>Core_Solution_Milestone__c.Core_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
