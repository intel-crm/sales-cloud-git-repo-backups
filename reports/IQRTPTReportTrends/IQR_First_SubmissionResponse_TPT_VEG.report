    </columns>
    <columns>
        <aggregateTypes>Average</aggregateTypes>
        <field>CDF1</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>(SBQQ__QuoteLine__c.Pricing_Last_Approved_Date_dt__c - SBQQ__QuoteLine__c.Pricing_Original_Submitted_Date_dt__c)*24</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Response Time (Hours)</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>Time elapsed between when OEM first submitted quote line until Intel responded, calculated as Approved/Rejected Date minus First Submitted Date. Includes time quote line was in Draft status while OEM made updates for Customer Revision.</description>
    <filter>
        <criteriaItems>
            <column>SBQQ__QuoteLine__c$Pricing_Status_Nm__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Approved,Rejected,Won,Lost,Revised,Cancelled</value>
        </criteriaItems>
        <criteriaItems>
            <column>SBQQ__QuoteLine__c$Pricing_Original_Submitted_Date_dt__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>SBQQ__QuoteLine__c$Pricing_OEM_Account_Nm__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>IQR - First Submission-Response TPT</name>
    <params>
