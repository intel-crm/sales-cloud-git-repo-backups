    <description>ALL MY AT RISK Oppties with a DECISION DATE in 2020 (and NO At Risk Created Date, in old At Risk Format) - Top Level View
(if YOU do not find any oppties in this report then all your oppties are in new format and you&apos;re done! THANKS!)</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Core_Support_Requested__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Products_At_Risk_Count__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
