    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Account.Core_Account_Country__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Team Dell Oppty with Vendor name</name>
    <params>
        <name>terr</name>
