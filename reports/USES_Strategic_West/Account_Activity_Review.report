            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>auto,Ian Chick,Camille Cudaback,Kristy Fay,Chris Haynes,Albert Lougedo,Andrew Meyer,Jose Monroy,Dane Nelson,Emily Schumacher,Connor Willihnganz</value>
        </criteriaItems>
        <criteriaItems>
            <column>ACCOUNT.NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>dell,lenovo,HP,Hewl,Insight,Super Micro,CDW</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Matrix</format>
    <groupingsAcross>
