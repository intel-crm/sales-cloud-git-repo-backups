    <customDetailFormulas>
        <calculatedFormula>if (CREATED_BY =&apos;Automated Process&apos;, &apos;EAC&apos;, &apos;AE&apos; )</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF2</developerName>
        <label>Calc Created By</label>
        <scale>2</scale>
    </customDetailFormulas>
    <customDetailFormulas>
