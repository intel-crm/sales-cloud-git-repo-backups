        <developerName>CDF1</developerName>
        <label>AE Calculated</label>
        <scale>2</scale>
    </customDetailFormulas>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6</booleanFilter>
        <criteriaItems>
            <column>Activity.Core_Subtype_of_Activity__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>6 QPS,6QPS,Push Reason,Complete SOAR1 qualification documentation,SOAR1 review meeting scheduled,Get Regional Manager Approval for Value Based Selling,Complete Win Analysis,Conduct Testing and Review Results,Articulate Prioritized Problem Statements and Desired Business Results,Complete Competitor Threat Mitigation,Complete Current and Future State Analysis</value>
        </criteriaItems>
        <criteriaItems>
            <column>SUBJECT</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>6QPS</value>
        </criteriaItems>
        <criteriaItems>
            <column>DUE_DATE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>lessThan</operator>
            <value>NEXT_N_DAYS:60</value>
        </criteriaItems>
        <criteriaItems>
            <column>ASSIGNED</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Ian Chick,Camille Cudaback,Kristy Fay,Chris Haynes,Albert Lougedo,Andrew Meyer,Jose Monroy,Dane Nelson,Emily Schumacher,Connor Willihnganz</value>
        </criteriaItems>
        <criteriaItems>
            <column>CREATED_BY</column>
