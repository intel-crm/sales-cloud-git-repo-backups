    <description>IoT opps with stages for full FY</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Core_Product_Segment__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>contains</operator>
            <value>Embedded</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Product_Application__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>,Automotive Controls,Automotive - Other,Business Gateway,Connected Services Gateway,Embedded  - Other,Energy - Command &amp; Controls,Energy - Home Energy Management,Energy - Other,Energy - Smart Appliances,Energy - Smart Meters,Energy - Turbine Controls &amp; Comms,Home Gateway,Industrial - Automation,Industrial - HMI,Industrial - Other,Industrial - PC-Base Design,Industrial - PLC &amp; PAC,Industrial - Robotics,Industrial - Ruggedized/Indu PC,Interactive Whiteboard,In-vehicle Infotainment,Medical &amp; Health - Fitness,Medical &amp; Health - Medical Diagnostics/Therapeutics,Medical &amp; Health - Medical Healthcare IT,Medical &amp; Health - Medical High End Imaging,Medical &amp; Health - Medical Ultrasound</value>
        </criteriaItems>
        <criteriaItems>
            <column>User.Core_User_Sub_Geo__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>contains</operator>
            <value>RCIS</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>STAGE_NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.Core_Product_Segment__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>IoT all other segments</name>
    <params>
        <name>terr</name>
        <value>all</value>
    </params>
    <params>
        <name>open</name>
        <value>all</value>
    </params>
    <params>
        <name>probability</name>
        <value>&gt;0</value>
    </params>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Opportunity</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
