    <description>USBC DCG Compute No Affinity in Solution Type AND contains Public Cloud Consumption product-using to uncover affinity opportunities</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Area__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>DCG Compute Deal $,DCG Partner Consumption $</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>excludes</operator>
            <value>Intel Affinity CSP Deal #</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>US Sales Group</value>
        </criteriaItems>
        <criteriaItems>
            <column>PRODUCT_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>public cloud consumption</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
