    <description>Looks for reports containing #TippingPoint is the Description field.</description>
    <filter>
        <booleanFilter>(1 OR 4) AND 2 AND 3 AND 5</booleanFilter>
        <criteriaItems>
            <column>DESCRIPTION</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>#TippingPoint,#tippingpoint</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Product_Segment__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Data Center Computing</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Deal: Partner Scale-enable,Deal: Sell-through,Deal: Sell-to</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opp_Strategic_Opportunity__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Lighthouse,Regional Strategic</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Area__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>NEX</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
