    <customDetailFormulas>
        <calculatedFormula>if(AND(ISPICKVAL(Case.Core_MDF_Status__c,&apos;Compliant&apos;),Case.Core_MDF_Adjustment_Amount_USD_Amt__c &gt; 0),&apos;Compliant with adjustment&apos;,&apos;Compliant without adjustment&apos;)</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Compliant with/wo adjustment</label>
        <scale>2</scale>
    </customDetailFormulas>
    <filter>
        <criteriaItems>
            <column>Case.Core_MDF_Channel_Program_txt__c</column>
