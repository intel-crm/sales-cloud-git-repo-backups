            <interval>INTERVAL_CURPREVQ</interval>
        </timeFrameFilter>
    </block>
    <block>
        <blockInfo>
            <blockId>B2</blockId>
            <joinTable>a</joinTable>
        </blockInfo>
        <columns>
            <field>STAGE_NAME</field>
        </columns>
        <filter>
            <criteriaItems>
                <column>ACCOUNT_OWNER_NAME</column>
