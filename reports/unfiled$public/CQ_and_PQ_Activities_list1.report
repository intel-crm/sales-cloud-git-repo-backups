        </columns>
        <filter>
            <criteriaItems>
                <column>Account.Core_Account_Category__c</column>
                <columnToColumn>false</columnToColumn>
                <isUnlocked>true</isUnlocked>
                <operator>notEqual</operator>
                <value>Extended Sales Force</value>
            </criteriaItems>
            <criteriaItems>
                <column>ACCOUNT_OWNER_NAME</column>
                <columnToColumn>false</columnToColumn>
                <isUnlocked>true</isUnlocked>
                <operator>notContain</operator>
                <value>Uncovered Account</value>
            </criteriaItems>
            <criteriaItems>
                <column>Account.Core_Account_Primary_Coverage__c</column>
                <columnToColumn>false</columnToColumn>
                <isUnlocked>true</isUnlocked>
                <operator>equals</operator>
                <value>,Intel Covered</value>
            </criteriaItems>
        </filter>
        <format>Summary</format>
