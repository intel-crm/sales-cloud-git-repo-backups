    <customDetailFormulas>
        <calculatedFormula>IF(PRM_Registration_Request__c.PRM_Record_Type_Name_rpt_txt__c == &quot;Account Create Request&quot; &amp;&amp; Ispickval(PRM_Registration_Request__c.PRM_Status__c,&quot;Approved&quot;) &amp;&amp; PRM_Registration_Request__c.PRM_Auto_Approve_rpt_txt__c == &quot;True&quot;,&quot;Request Auto Approved&quot;,
IF(PRM_Registration_Request__c.PRM_Record_Type_Name_rpt_txt__c == &quot;Account Create Request&quot; &amp;&amp; Ispickval(PRM_Registration_Request__c.PRM_Status__c,&quot;Approved&quot;) &amp;&amp; PRM_Registration_Request__c.PRM_Auto_Approve_rpt_txt__c == &quot;False&quot;,&quot;Request Manual Approved&quot;,
IF(PRM_Registration_Request__c.PRM_Record_Type_Name_rpt_txt__c == &quot;Account Create Request&quot; &amp;&amp; Ispickval(PRM_Registration_Request__c.PRM_Status__c,&quot;New&quot;),&quot;Pending Request&quot;,
IF(PRM_Registration_Request__c.PRM_Record_Type_Name_rpt_txt__c == &quot;Email Verification Request&quot; &amp;&amp; !ISBLANK(PRM_Registration_Request__c.PRM_EmailVerifiedDateTime__c),&quot;New Request-EV Completed&quot;,
IF(PRM_Registration_Request__c.PRM_Record_Type_Name_rpt_txt__c == &quot;Email Verification Request&quot; &amp;&amp; ISBLANK(PRM_Registration_Request__c.PRM_EmailVerifiedDateTime__c),&quot;New Request-Pending EV&quot;,
IF((PRM_Registration_Request__c.PRM_Record_Type_Name_rpt_txt__c == &quot;Email Verification Request&quot; || PRM_Registration_Request__c.PRM_Record_Type_Name_rpt_txt__c == &quot;Account Create Request&quot;)&amp;&amp; Ispickval(PRM_Registration_Request__c.PRM_Status__c,&quot;Rejected&quot;),&quot;Rejected Request&quot;,&quot;Rejected Request&quot;))))))</calculatedFormula>
        <dataType>Text</dataType>
