    <description>All PSG Opportunities with Products with filter Product Type=Intel FPGASort Descending by Total Price.</description>
    <filter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Product_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Intel® FPGAs</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Consumption_Market__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Government</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>TOTAL_PRICE</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Copy of PSG Military Opportunities with</name>
    <params>
