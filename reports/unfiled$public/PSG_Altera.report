    <customDetailFormulas>
        <calculatedFormula>
IF(
    AND(
        NOT(ISBLANK(CLOSE_DATE)),
        CLOSE_DATE &lt; TODAY()
    ),
    &quot;Past Due&quot;,
    &quot;On Time&quot;
)</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Passed Due Flag</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>Complete list of 2025 Opportunities</description>
    <filter>
        <criteriaItems>
            <column>Account.Core_Account_Primary_Coverage__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Intel Covered,Indirect Covered</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Product_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Intel® FPGAs</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
