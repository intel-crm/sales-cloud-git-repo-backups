    <description>Report for tracking nominations for the 1H&apos;24 Bonus - Bonus 2-2A Top 3 End-Customers Sellers per region with the most impactful wins in 1H&apos;24
Opptys must be flagged as &apos;Region Strategic&apos; or &apos;Lighthouse&apos;</description>
    <filter>
        <criteriaItems>
            <column>Opportunity$Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Americas,Global</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>,partner holding,undefined</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.KPI_Opportunity__r$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>DAIS Accelerator Deal,DCAI SPR,CCG vPro,NEX SW Attach Deal,NEX VRAN Deal,NEX Ethernet</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Core_Opp_Strategic_Opportunity__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Lighthouse,Regional Strategic</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Design Win,Production Win</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Deal: Sell-through,Deal: Sell-to</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity$Owner.Core_Manager__c</field>
