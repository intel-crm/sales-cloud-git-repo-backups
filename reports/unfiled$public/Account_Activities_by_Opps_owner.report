        <criteriaItems>
            <column>ACCOUNT_OWNER_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Uncovered</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Account_Category__c</column>
