    <description>Report with Education (K-12 + HiEd) opportunities used for the CCG Commercial Segments - 4P Strategy Team</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND (((4 OR 5) AND (8 AND 9)) OR (6 OR 7) OR (7 AND 8) OR (6 AND 9)) AND 10</booleanFilter>
        <criteriaItems>
            <column>STAGE_NAME</column>
