<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Opportunity.Core_Opportunity_Count__c</field>
    </columns>
    <columns>
        <field>Opportunity.Core_Solution_Area__c</field>
    </columns>
    <columns>
        <field>Opportunity.Core_Opp_Prime_Account_Name__c</field>
