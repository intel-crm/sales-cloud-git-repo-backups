    <description>This report pulls all opportunities tagged #latammustwin with the decision date on 2024. It shows the current and past week&apos;s DW amount, stage, decision date and forecast category.</description>
    <filter>
        <criteriaItems>
            <column>Opportunity$Description</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>#latammustwin</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <historicalSelector>
        <snapshot>N_WEEKS_AGO:1</snapshot>
    </historicalSelector>
    <name>#LATAMMUSTWIN 2024 WoW report</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Opportunities_with_Historical_Trending__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Opportunity$CloseDate</dateColumn>
        <endDate>2024-12-28</endDate>
        <interval>INTERVAL_CUSTOM</interval>
        <startDate>2024-01-01</startDate>
    </timeFrameFilter>
