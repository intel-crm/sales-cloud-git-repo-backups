    <description>Looking for AI opportunities. Criteria is Solution Detail contains &quot;ML/DL&quot; OR Solution Type contains &quot;One Intel AI Deal&quot;</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND (4 OR 5)</booleanFilter>
        <criteriaItems>
            <column>Account.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>EMEA Sales Group</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Deal: Sell-through,Deal: Sell-to</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_BU_Short_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>DCAI</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Combined_Solution_Detail__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>ML/DL</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Solution_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>includes</operator>
            <value>One Intel AI Deal</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
