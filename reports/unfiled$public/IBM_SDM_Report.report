    <description>Shows all opportunities where IBM team is a Team Member or an Opportunity Owner</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.OpportunityTeamMembers$Manager</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Jeff Cannada</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Cancelled,Define,Design,Design Win,Develop,Group,Group Cancelled,Group Closed,Group Open,Lost,Production Cancelled,Production Lost,Production Win,Qualify</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
