        <textColor>#000000</textColor>
        <textSize>12</textSize>
        <title>CSAs Opportunity Teams Since 6/20</title>
        <titleColor>#000000</titleColor>
        <titleSize>18</titleSize>
    </chart>
    <columns>
        <field>Opportunity$Name</field>
    </columns>
    <columns>
        <field>Opportunity.OpportunityTeamMembers*OpportunityTeamMember$Core_Date_Added__c</field>
    </columns>
    <description>Report of all known TSSs added to opportunity teams since 6/20 (when new support request process was rolled out) sorted by region and individual.</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.OpportunityTeamMembers$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Sarah Musick,Gopal Kandhasamy,Brian Caddell,Kiran Agrahara,Vijay Bandari,Sumesh Sukumar,Nishikant Singh,Willian Steve Fowler Vivek Kulkarni,Kieth Sundberg,Rajiv Mandal,Ibett Acarapi,Bhavani Salunkhe,Farid El Chalouhi,Marcel Brueckner,Can Yurtseven,Marco Righini,Pedro Benito,Volga Simsek,Swapnil Shah,Feng1 Gao,Jimin Cai,Qingfeng Zhang,Marty Liang,Lianghou Xu,Emily Zhou,Tong Chen,Xingxian Luo,Abhishek Kumar Singh,Beny Ibrani,John Kim,Mousumi Dash,Prabhas Harlapur</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.OpportunityTeamMembers*OpportunityTeamMember$Core_Date_Added__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>6/20/2023 12:00 AM</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity$Core_Opportunity_Owner_Geo__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.OpportunityTeamMembers$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>TSSs to Opportunity Teams since 6/20</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Opportunity_with_Opportunity_Team_Members__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>false</showSubTotals>
    <sortColumn>Opportunity.OpportunityTeamMembers*OpportunityTeamMember$Core_Date_Added__c</sortColumn>
    <sortOrder>Asc</sortOrder>
    <timeFrameFilter>
        <dateColumn>Opportunity$Core_Approved_Date__c</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
