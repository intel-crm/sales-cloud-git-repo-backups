        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>KPU Sum per account</masterLabel>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>Core_Oppty_KPI_New__c.Core_KPI_Total_Price__c:SUM</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>KPI_Sum</masterLabel>
        <scale>2</scale>
    </aggregates>
    <columns>
        <field>Opportunity$Account</field>
    </columns>
    <columns>
        <field>Opportunity$Core_Opportunity_Owner__c</field>
    </columns>
    <columns>
        <field>Opportunity$Name</field>
    </columns>
    <columns>
        <field>Opportunity$StageName</field>
    </columns>
    <columns>
        <field>Opportunity$Core_Technical_Owner__c</field>
    </columns>
    <columns>
        <field>Opportunity$CreatedDate</field>
    </columns>
    <columns>
        <field>Opportunity$Core_Sales_Groups__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Opportunity.KPI_Opportunity__r$Core_KPI_Quantity__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Opportunity.KPI_Opportunity__r$Core_KPI_Total_Price__c</field>
    </columns>
    <description>This is a report of Japan Deal Win 1H&apos;2024 Status.</description>
    <filter>
        <criteriaItems>
            <column>Opportunity$Probability</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Qualify,Define,Develop,Design,Design Win</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Owner.Core_Manager__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,ray zhang,masato hotta,akinori kojihara,Shinsaku shimada,yuko kohmura</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.KPI_Opportunity__r$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>CCG Commercial Deal Acceleration $,CCG vPro Platform + Solution Adoption Deal $,DAIS Accelerator Deal $,DCAI Deal Sell-To $,DCAI SPR+ Deal $,NEX Core Network Deal %,NEX SW Attach Deal $,NEX Ethernet Deal %,NEX VRAN Deal $,One Intel AI Deal $,Top Acct Public Cloud Deal $</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Matrix</format>
    <groupingsAcross>
        <dateGranularity>Quarter</dateGranularity>
        <field>Opportunity$CloseDate</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsAcross>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity$sbaa__ApprovalStatus__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.KPI_Opportunity__r$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity$Owner.Core_Manager__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>1H&apos;2024 Japan Deal Win KPI</name>
    <params>
        <name>co</name>
        <value>0</value>
    </params>
    <reportType>Opportunities_with_New_Opportunity_KPIs__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Opportunity$CloseDate</dateColumn>
        <endDate>2024-06-30</endDate>
        <interval>INTERVAL_CUSTOM</interval>
        <startDate>2024-01-01</startDate>
    </timeFrameFilter>
</Report>
