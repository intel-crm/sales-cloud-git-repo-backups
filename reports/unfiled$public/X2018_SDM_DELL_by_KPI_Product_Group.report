    <description>For Caitlin - report on Dell progress against 2018 KPI Product Groups</description>
    <filter>
        <booleanFilter>(1 AND 2 AND 3 AND 4 AND 5 ) OR (1 AND 2 AND 3 AND 4 AND 6) OR (1 AND 2 AND 3 AND 4 AND 7)</booleanFilter>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
