<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>Lead.Core_Partner_Name__c:UNIQUE</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel># of Unique Partners</masterLabel>
        <scale>0</scale>
    </aggregates>
    <columns>
        <field>STATUS</field>
    </columns>
    <description>Total records by Partners - Partner Leads, Dashboard for ET and DG</description>
    <filter>
        <criteriaItems>
            <column>Lead.Core_Lead_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,New,Accepted,Rejected,Contacted,Qualified,Disqualified,Passed to Partner,Unreachable,Opportunity</value>
        </criteriaItems>
        <criteriaItems>
            <column>RECORDTYPE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>Lead.Partner_Lead</value>
        </criteriaItems>
        <criteriaItems>
            <column>LEAD_SOURCE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>,Eloqua Scoring Model,Event,Inbound Email Inquiry,Intel Customer Support,Intel Website,List Purchase,Media,Outbound Call,Partner Program,Prospecting Existing Account,Prospecting New Account,Referral - Employee,Referral – Partner/Disti/Third Party,Sales AI,Scoring Model,Social Selling,Webinar,Website</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Lead.Core_Partner_Name__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Partner Leads_by Partners</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>LeadList</reportType>
    <scope>org</scope>
    <showDetails>true</showDetails>
