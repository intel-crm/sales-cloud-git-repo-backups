    <description>Displays all MSFT ECI EMEA campaigns Post L2 Approval</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5</booleanFilter>
        <criteriaItems>
            <column>Campaign.Core_MDF_Account__c</column>
