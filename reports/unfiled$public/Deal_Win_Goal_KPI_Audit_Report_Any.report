    <description>Shows all approved DWGs where the KPI on the DWG does not match an achieved KPI on the associated opportunity and the approved difference is any amount</description>
    <filter>
        <criteriaItems>
            <column>Core_Goal__c.Core_Goal_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Approved</value>
        </criteriaItems>
        <criteriaItems>
            <column>Core_Goal__c.Core_Goal_KPI_Achieved_Flag__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>Core_Goal__c.Core_Goal_Claim_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>1/1/2021</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>Deal Win Goal KPI Audit Report Any $</name>
