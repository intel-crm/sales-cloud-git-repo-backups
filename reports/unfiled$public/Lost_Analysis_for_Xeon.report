    <customDetailFormulas>
        <calculatedFormula>
IF(
    AND(
        NOT(ISBLANK(CLOSE_DATE)),
        CLOSE_DATE &lt; TODAY()
    ),
    &quot;Past Due&quot;,
    &quot;On Time&quot;
)</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Pass Due Flag</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>Lost Analysis for Xeon</description>
