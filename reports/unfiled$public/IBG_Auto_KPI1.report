            <column>Opportunity.KPI_Opportunity__r$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>CCG Commercial Deal Acceleration $,DAIS Accelerator Deal $,DCAI Deal Sell-To $,One Intel AI Deal $,Top Acct Public Cloud Deal $</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Account</column>
            <columnToColumn>false</columnToColumn>
