    <description>Shows all Vpro and Optane SSD opportunities that are not showing as KPIs</description>
    <filter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Advanced_Technology__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>INTEL® VPRO™ TECHNOLOGY,INTEL® Optane™ DC SSD First Implementation</value>
        </criteriaItems>
        <criteriaItems>
            <column>PRODUCT_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Optane SSD,Core i5,Core i7</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>Advanced Technology Oppty without KPI&apos;s</name>
    <params>
        <name>terr</name>
        <value>all</value>
    </params>
    <params>
        <name>open</name>
        <value>open</value>
    </params>
    <params>
        <name>probability</name>
        <value>&gt;0</value>
    </params>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>OpportunityProduct</reportType>
    <scope>user</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>CLOSE_DATE</dateColumn>
        <endDate>2026-11-24</endDate>
        <interval>INTERVAL_CUSTOM</interval>
        <startDate>2026-11-24</startDate>
    </timeFrameFilter>
