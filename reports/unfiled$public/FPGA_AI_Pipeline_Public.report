    <description>FPGA Pipeline based upon &quot;AI Content in System&quot; Descriptive feature that are Open and have PSG as the BU</description>
    <filter>
        <booleanFilter>(1 OR 2 OR 3 OR 4 OR 5) AND 6</booleanFilter>
        <criteriaItems>
