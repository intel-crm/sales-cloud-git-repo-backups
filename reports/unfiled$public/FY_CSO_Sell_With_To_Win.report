    <description>Current List of CSP&apos;s include Microsoft, Alphabet, Google, Amazon, AWS, Oracle, IBM, Redhat</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
        <criteriaItems>
            <column>ACCOUNT_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Alphabet,Google,Microsoft,Amazon,Oracle,IBM,Redhat</value>
        </criteriaItems>
        <criteriaItems>
            <column>RECORDTYPE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Opportunity.Core_Deal_Opportunity,Opportunity.Core_Design_Opportunity,Opportunity.Core_New_Opportunity,Opportunity.Core_New_Solution_Group,Opportunity.Core_Opportunity,Opportunity.Core_Solution_Group</value>
