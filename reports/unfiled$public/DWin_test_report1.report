        <field>Account.Core_Account_Tier__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.Core_Design_Registration_Id__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>2021 Arrow DWin Report - capture</name>
    <params>
        <name>terr</name>
        <value>all</value>
    </params>
    <params>
        <name>open</name>
        <value>closedwon</value>
    </params>
    <params>
