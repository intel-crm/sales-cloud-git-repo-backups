    <description>Historical trends report to show the opportunities that have increase in value since last month.</description>
    <filter>
        <criteriaItems>
            <column>Opportunity$Core_Sales_Segments__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>includes</operator>
            <value>Influencer,Embedded</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Opportunity__hd$Amount__hst</column>
            <columnToColumn>true</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>lessThan</operator>
            <value>Opportunity$Amount</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <historicalSelector>
