    <description>Report that exports Optane DC Projects information in the format that the BDM-TSS EU Tracker requires. Only copy the rows and paste from column B and on :)</description>
    <filter>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Design Win,Lost,Cancelled,Production Lost,Production Cancelled,Group Cancelled,Group Closed</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_BU_Short_Name_Old__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
