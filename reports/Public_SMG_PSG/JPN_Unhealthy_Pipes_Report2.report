    <description>JPN Unhealthy Pipes Report filter by Technical/Opps Owner &amp; Role</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6 AND (7 OR 8) AND 9</booleanFilter>
        <criteriaItems>
            <column>RECORDTYPE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Opportunity.Core_Deal_Opportunity,Opportunity.Core_Design_Opportunity,Opportunity.Core_New_Opportunity,Opportunity.Core_New_Solution_Group,Opportunity.Core_Opportunity,Opportunity.Core_Solution_Group</value>
        </criteriaItems>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Qualify,Define,Develop,Design</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>APJ Japan Sales Group,APJ Hosted Sales Group,APJ Partner Holding</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Pipeline_Heath__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Compliance_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>On Hold – Review in Progress,On Hold – Government Authorization Needed</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Export_Compliance_Block__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>ROLLUP_DESCRIPTION</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>ALTIMA CORP Partner User,EMP of Takahiro Goto,EMP of Kiyohisa Kawano,EMP of Akinori Ito</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Technical_Owner__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
