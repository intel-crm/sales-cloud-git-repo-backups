    <description>All PSG Opportunities with Products with filter Product Type=Intel FPGA Sort Descending by Total Price. For Prime NetApp, Pure Storage, Hitachi, IBM, Fujitsu, Megh Computing, Facebook, and Account Name Bittware Limited</description>
    <filter>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Product_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Intel® FPGAs</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opp_Prime_Account_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>NetApp,Pure Storage,Hitachi,IBM,Fujitsu,Megh Computing,Facebook,Seagate</value>
        </criteriaItems>
        <criteriaItems>
            <column>ACCOUNT_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Bittware Limited</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>Shahar Noy - Opportunities with Products</name>
    <params>
        <name>terr</name>
        <value>all</value>
    </params>
