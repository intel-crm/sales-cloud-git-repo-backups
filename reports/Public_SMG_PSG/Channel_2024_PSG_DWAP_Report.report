    <description>PSG DWAP Report for Approval Meeting (with registrations only)</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Product_Type__c</column>
