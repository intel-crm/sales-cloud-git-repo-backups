    <description>Open (Qualify, Define, Develop, Design) PSG Opportunities with Products with filter Product Type=Intel FPGA and Omnitek target market segments</description>
    <filter>
        <booleanFilter>((1 AND (2 OR 3)) AND 4) AND 5</booleanFilter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Product_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Intel® FPGAs</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Product_Application__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>AR/VR/MR - Commercial,AR/VR/MR - Consumer,AR/VR/MR - other,Consumer Mobility,CE - Camera,CE - other,Drone - Consumer,Drone - Intel Inside Platform,Drone - Light Show,Drone - other,AI - HDDL,AI - other,Head-End (Encoder/Decoder),Studio Cameras,Multi-viewers,Editors,Studio Router/Switcher,Consoles,Electronic Gaming Machines,Entertainment Devices,Gaming - Other,Lottery/Voting,AI Edge Healthcare,Health Sector - Other,Medical Diagnostics/Lab/Therapeutics,Medical Imaging - Non Ultrasound,Medical Ultrasound,Remote Health / Patient Monitoring,Machine Vision,Projectors,RFID Sensor Platform,Multi-Sensor Smart Kiosks,Smart City - Other,Smart Parking,ATM,Computer Vision,Analytics and AI,PC Cash Register,Point of Sale,Retail Mobility (mPOS,Retail Tablet),Thin Client,Cloud Client,Edge Client),Transactional Retail - Other,Workload Consolidation (Edge Virtualization),Video - Other,Video Conferencing,Video IP Cameras,Digital Signage,Intelligent Vending</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Product_Application__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Kiosk,Public Kiosk,Visual Retail - Other,Visual Retail - Visual Data Device (VDD)/Smart Edge Module (SEM),Visual Solutions – Computer Vision,Analytics and AI,Visual Solutions – Interactive Whiteboards (IWB) - Corporate,Visual Solutions – Interactive Whiteboards (IWB) - Education,Visual Solutions – Workload Consolidation,NAS System,Smart Home,SMB Gateway,Phone</value>
        </criteriaItems>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Qualify,Define,Develop,Design</value>
        </criteriaItems>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>Design Win</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>Omnitek Target Market Segment Oppty</name>
    <params>
        <name>terr</name>
        <value>all</value>
    </params>
    <params>
        <name>open</name>
        <value>all</value>
    </params>
    <params>
        <name>probability</name>
        <value>&gt;0</value>
    </params>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>OpportunityProduct</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
