    <description>If Stage is Lost, update product STATUS to lost.  If Stage is anything other than Lost, update product status to Cancelled.   No change in Decision dates.   Claim Date of Product should be last date Oppty Stage was changed (back date if necessary)</description>
    <filter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>On Hold,Pending</value>
        </criteriaItems>
        <criteriaItems>
