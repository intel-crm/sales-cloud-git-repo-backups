    <description>Sales Group contains Partner Holding AND Opportunity Owner is no longer in SMG or at Intel</description>
    <filter>
        <booleanFilter>2 AND (1 OR 3) AND 4</booleanFilter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
