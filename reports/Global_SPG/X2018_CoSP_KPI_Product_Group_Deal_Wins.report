    <description>For 2018 KPI&apos;s that are Product Group KPI&apos;s and use the &quot;KPI Product Group&quot; mapping</description>
    <filter>
        <criteriaItems>
            <column>Product2.Core_Inf_KPI_ProdGroup__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Not Applicable</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Win Approved,Production Win</value>
        </criteriaItems>
        <criteriaItems>
            <column>Product2.Core_Inf_KPI_ProdGroup__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
