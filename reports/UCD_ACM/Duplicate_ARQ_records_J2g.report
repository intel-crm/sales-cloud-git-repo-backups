<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>Account_Create_Request__c$Name</field>
    </columns>
    <columns>
        <field>Account_Create_Request__c$Process_Type__c</field>
    </columns>
    <columns>
        <field>Account_Create_Request__c$CreatedBy</field>
    </columns>
    <columns>
        <field>Account_Create_Request__c$CreatedDate</field>
    </columns>
    <description>Report to monitor duplicate Account Request queue records created in last 14 days</description>
    <filter>
        <criteriaItems>
            <column>Account_Create_Request__c.DuplicateRecordItems$CreatedDate</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>LAST_WEEK</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Account_Create_Request__c$Account_Name__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Duplicate ARQ records</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Duplicate_ARQ_records__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Account_Create_Request__c$CreatedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
