<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>DATE(YEAR(TODAY()),12,31) - TODAY()</calculatedFormula>
        <datatype>number</datatype>
        <description>how many days left of the calendar year from TODAY</description>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Days Left of the Year</masterLabel>
        <scale>2</scale>
    </aggregates>
