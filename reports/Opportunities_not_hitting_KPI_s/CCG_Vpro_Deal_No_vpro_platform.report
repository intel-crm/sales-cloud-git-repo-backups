    <description>CCG Vpro Deal 
A product where the &quot;Advanced Technology“ field has INTEL® VPRO™ TECHNOLOGY selected but doesn’t have a Product Name that equals “Intel vPro® Platform”.</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Deal: Sell-to</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Advanced_Technology__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
