    <description>IoTG report of all &quot;design&quot; SoFIA product line items including the Status Update and At Risk fields. (Deals excluded).</description>
    <filter>
        <criteriaItems>
            <column>PRODUCT_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>contains</operator>
            <value>SoFIA,C3130,C3445,C3405,C320RK,C3200RK</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_BU_Short_Name_Old__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>IOTG</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>contains</operator>
            <value>Design</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
