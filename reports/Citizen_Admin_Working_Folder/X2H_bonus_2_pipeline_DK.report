    <customDetailFormulas>
        <calculatedFormula>IF(OpportunityLineItem.Core_BU_Short_Name__c = &quot;DCAI&quot; &amp;&amp;TOTAL_PRICE&gt;=1000000, &quot;Yes&quot;, 
IF(OpportunityLineItem.Core_BU_Short_Name__c = &quot;CCG&quot; &amp;&amp;TOTAL_PRICE&gt;=200000, &quot;Yes&quot;,
IF((OpportunityLineItem.Core_BU_Short_Name__c = &quot;NEX NCCG&quot; ||OpportunityLineItem.Core_BU_Short_Name__c = &quot;NEX NESG&quot;) &amp;&amp;TOTAL_PRICE&gt;=450000, &quot;Yes&quot;, &quot;No&quot;)))</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Qualify?</label>
        <scale>2</scale>
    </customDetailFormulas>
    <filter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_BU_Short_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>dcai,nex,ccg</value>
        </criteriaItems>
        <criteriaItems>
            <column>RECORDTYPE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Opportunity.Core_Deal_Opportunity</value>
        </criteriaItems>
        <criteriaItems>
            <column>PRODUCT_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>guadi</value>
        </criteriaItems>
        <criteriaItems>
            <column>CDF1</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Yes</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_BU_Short_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>DCAI PSG</value>
        </criteriaItems>
        <criteriaItems>
            <column>CLOSE_DATE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>3/31/2024</value>
        </criteriaItems>
        <criteriaItems>
            <column>CLOSE_DATE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>lessOrEqual</operator>
            <value>12/31/2024</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.Core_Opportunity_ID__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>2H bonus 2 pipeline - Yes Only (DD=Q2-Q4</name>
    <params>
        <name>terr</name>
        <value>all</value>
