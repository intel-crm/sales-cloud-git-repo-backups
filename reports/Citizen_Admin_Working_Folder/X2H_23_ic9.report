    <filter>
        <criteriaItems>
            <column>Opportunity$CloseDate</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>3/31/2024</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$CloseDate</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>lessOrEqual</operator>
            <value>12/31/2024</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$RecordType</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Opportunity.Core_Deal_Opportunity</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.KPI_Opportunity__r$Core_Opp_KPI_Product__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>Gaudi</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.KPI_Opportunity__r$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>DCAI SPR+ Deal $,CCG vPro Platform + Solution Adoption Deal $,NEX SW Attach Design $,NEX VRAN Deal $,NEX Ethernet Deal</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
