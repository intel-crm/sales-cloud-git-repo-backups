<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>RowCount</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel># of Deal Win Goals</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(Core_Goal__c.Core_Goal_BU_Focus_Area__c:UNIQUE &lt; RowCount,1,0)</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Has Duplicate KPIs?</masterLabel>
        <scale>0</scale>
    </aggregates>
    <columns>
        <field>FK_NAME</field>
    </columns>
    <columns>
        <field>CUST_NAME</field>
    </columns>
    <columns>
        <aggregateTypes>Unique</aggregateTypes>
        <field>Core_Goal__c.Core_Goal_BU_Focus_Area__c</field>
    </columns>
    <columns>
        <field>Core_Goal__c.Core_Goal_Status__c</field>
    </columns>
    <filter>
        <criteriaItems>
            <column>Core_Goal__c.Core_Goal_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Cancelled</value>
        </criteriaItems>
        <criteriaItems>
            <column>Core_Goal__c.Core_Goal_BU_Focus_Area__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>CCG Commercial Deal Revenue $,CCG vPro Platform Deal Revenue $,DCAI Compute Deal $,DC Growth Deal $,NEX Deal (Sell-To) $</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>FK_OPP_ID</field>
        <sortByName>FORMULA2</sortByName>
        <sortOrder>Asc</sortOrder>
        <sortType>CustomSummaryFormula</sortType>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Core_Goal__c.Core_Goal_Owner__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Duplicate DWGs</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>CustomEntity$Core_Goal__c@Core_Goal__c.Core_Opportunity__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Core_Goal__c.Core_Goal_Claim_Date__c</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
        <startDate>2021-01-19</startDate>
    </timeFrameFilter>
</Report>
