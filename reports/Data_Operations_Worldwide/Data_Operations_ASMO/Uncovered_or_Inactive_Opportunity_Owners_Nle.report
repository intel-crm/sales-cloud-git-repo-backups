    <description>List of Open Opportunities owned by &quot;Uncovered Account&quot;, &quot;A&amp;E Account Owner&quot;, or by Users listed as Inactive in Salesforce.</description>
    <filter>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <column>FULL_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Uncovered Account,A&amp;E Account Owner</value>
        </criteriaItems>
        <criteriaItems>
            <column>OWNER_ACTIVE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>0</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>Uncovered or Inactive Opportunity Owners</name>
    <params>
        <name>terr</name>
        <value>all</value>
    </params>
    <params>
