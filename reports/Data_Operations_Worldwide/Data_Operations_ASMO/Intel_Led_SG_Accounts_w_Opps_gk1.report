            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Account.Mastered_Account</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>,Americas Partner Holding,EMEA Partner Holding,APJ Partner Holding,PRC Partner Holding,Undefined</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
