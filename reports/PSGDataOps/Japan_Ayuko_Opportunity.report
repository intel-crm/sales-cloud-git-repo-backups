    <description>All PSG Opportunities with Products with filter Product Type=Intel FPGA
BU Territory &lt;&gt; PSG; Owner Department = PSG; Owner Role = Partner User</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Core_Technical_Owner__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Ayuko</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
