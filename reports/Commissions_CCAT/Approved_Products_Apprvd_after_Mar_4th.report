    <description>used to validate SFDC/Callidus DWR feed enhancement release on March 5th pm</description>
    <filter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>win approved</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Approved_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>3/4/2019 12:00 AM</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>Approved_Products_Apprvd after Mar 4th</name>
    <params>
        <name>terr</name>
