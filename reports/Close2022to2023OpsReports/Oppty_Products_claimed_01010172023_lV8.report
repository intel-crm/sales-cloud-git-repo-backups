    <description>These will NOT count toward 2022 credit and will be recalled or reversed (if approved) as communicated goto/2022.     Check Sales CRM home screen for latest update regarding Go Live timing for SMG &apos;23.</description>
    <filter>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Claim_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>1/1/2023 12:00 AM</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
