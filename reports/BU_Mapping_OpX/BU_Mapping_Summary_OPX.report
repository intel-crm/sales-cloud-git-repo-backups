        <developerName>FORMULA1</developerName>
        <downGroupingContext>OpportunityLineItem.Core_BU_Product_Segment__c</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>% of Segment to BU</masterLabel>
        <scale>0</scale>
    </aggregates>
    <columns>
