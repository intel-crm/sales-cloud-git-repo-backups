    <description>RT: Leads with converted lead information. TQL Coverage contains LDR, starting NOV 1 &apos;21.  Excluding PRC</description>
    <filter>
        <criteriaItems>
            <column>RECORDTYPE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Lead.Lead</value>
        </criteriaItems>
        <criteriaItems>
            <column>STATUS</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Marketing Qualified Lead,Tele Accepted Lead,Tele Qualified Lead,Sales Accepted Lead,Sales Qualified Lead,Contact - No Opportunity,Tele Accepted Prospect,Tele Qualified Prospect,Partner Qualified Lead,PRL,PAL,PQL,Rejected</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.Core_TQL_Lead_Coverage__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>LDR</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.Core_Geo__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>PRC</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
