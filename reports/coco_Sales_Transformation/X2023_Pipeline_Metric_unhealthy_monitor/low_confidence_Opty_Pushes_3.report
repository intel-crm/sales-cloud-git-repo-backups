    <description>PRC low confidence Opportunities.  Filter pushes &gt; 3.  Current Quarter + 3</description>
    <filter>
        <booleanFilter>(1 AND 3) AND 2 AND 4</booleanFilter>
        <criteriaItems>
            <column>Opportunity.Core_Push_Counter__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>2</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>PRC Hosted Sales Group,PRC Sales Group</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Deal: Sell-through,Deal: Sell-to,Design: Original,Design: Secondary,Design: Software-enable</value>
        </criteriaItems>
        <criteriaItems>
            <column>CREATED_DATE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>1/1/2023 12:00 AM</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
