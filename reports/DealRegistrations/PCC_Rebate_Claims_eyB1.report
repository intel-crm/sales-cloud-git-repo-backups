<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF(PCC_Rebate_Claim__c.PCC_Claim_Status__c = &apos;Claim Submitted&apos;,PCC_Rebate_Claim__c.PCC_Total_Claimed_Rebate__c:SUM,IF(PCC_Rebate_Claim__c.PCC_Claim_Status__c=&apos;	Claim Approved - Payment Pending&apos;,PCC_Rebate_Claim_Line_Item__c.PCC_Approved_Rebate_Amount__c:SUM,0))</calculatedFormula>
        <datatype>currency</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>amount</masterLabel>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>CDF1:SUM</calculatedFormula>
        <datatype>currency</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Rebate Amount</masterLabel>
        <scale>2</scale>
    </aggregates>
    <columns>
        <field>PCC_Rebate_Claim_Line_Item__c.PCC_Quote_Line_Number__c</field>
    </columns>
    <columns>
        <field>CHILD_NAME</field>
    </columns>
    <columns>
        <field>PCC_Rebate_Claim_Line_Item__c.PCC_Status__c</field>
    </columns>
    <columns>
        <field>CUST_NAME</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>PCC_Rebate_Claim_Line_Item__c.PCC_Claimed_Rebate_Amount__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>PCC_Rebate_Claim_Line_Item__c.PCC_Approved_Rebate_Amount__c</field>
    </columns>
    <columns>
        <field>PCC_Rebate_Claim__c.PCC_Partner__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>CDF1</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>IF(ISPICKVAL(PCC_Rebate_Claim__c.PCC_Claim_Status__c,&apos;Claim Submitted&apos;), 
						PCC_Rebate_Claim_Line_Item__c.PCC_Claimed_Rebate_Amount__c, 
						IF(AND(NOT(ISPICKVAL(PCC_Rebate_Claim__c.PCC_Claim_Status__c,&apos;Claim Submitted&apos;)),NOT(ISPICKVAL(PCC_Rebate_Claim__c.PCC_Claim_Status__c,&apos;Claim Rejected&apos;))),PCC_Rebate_Claim_Line_Item__c.PCC_Approved_Rebate_Amount__c,0))</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Amount</label>
        <scale>2</scale>
    </customDetailFormulas>
    <filter>
        <criteriaItems>
            <column>PCC_Rebate_Claim__c.PCC_Claim_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Draft</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>PCC_Rebate_Claim__c.PCC_Claim_Status__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Rebate Claims with QLS</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>CustomEntityCustomEntity$PCC_Rebate_Claim__c$PCC_Rebate_Claim_Line_Item__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>PCC_Rebate_Claim__c.PCC_Approval_Date__c</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
