    TEXT(ROUND(MOD((PRM_Registration_Request__c.Status_Pending_Time__c - PRM_Registration_Request__c.PRM_Submitted_Date__c) * 24, 1) * 60, 0)) &amp; &quot; minutes&quot;,
    &quot;&quot;
)</calculatedFormula>
