    <filter>
        <booleanFilter>1 AND 2 AND 3 AND ((4 AND 5) OR 6) AND 7</booleanFilter>
        <criteriaItems>
            <column>Opportunity$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>,Lost,Cancelled</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Core_Approval_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Rejected,Recalled</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.KPI_Opportunity__r$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>CCG Commercial Deal Revenue $,CCG vPro Platform Deal Revenue $,CCG vPro Solution Adoption Deal #,DC Growth Deal $,DCAI Compute Deal $,DCAI Optane Deal $,DCAI AXG HPC Deal $,Intel Affinity CSP Deal #,Intel Affinity On-Prem Deal #,One Intel AI Deal $,DCAI PSG Deal $,NEX Industry Transformation Engagement #,NEX Deal (Sell-To) $,NEX IOTG Deal (Sell-to) $,One Edge Deal #,NEX Networking Deal (Sell-To) $,CCG Strategic Next Gen Design #,DC Strategic Next Gen Design #,One Intel SW Enablement Design PW #,One Intel SW Enablement Design CW #,DCAI PSG Design $,NEX Design $,NEX Production Win $,NEX Networking Design $,NEX IOTG Design $,One Edge Design #,One Intel OpenVINO Enabled Design $</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>APJ Named Account Sales Group</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Core_Opp_Prime_Account_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>LG,SK Telecom</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>APJ Korea Sales Group</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.KPI_Opportunity__r$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>DCAI CESG Intel Affinity CSP Deal #</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Matrix</format>
    <groupingsAcross>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity$Core_Approval_Status__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsAcross>
        <dateGranularity>Quarter</dateGranularity>
        <field>Opportunity$CloseDate</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.KPI_Opportunity__r$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity$Probability</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>2022 Korea KPI Pipeline (filter by proba</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Opportunities_with_New_Opportunity_KPIs__c</reportType>
    <roleHierarchyFilter>SMG</roleHierarchyFilter>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Opportunity$CloseDate</dateColumn>
        <interval>INTERVAL_CURY</interval>
    </timeFrameFilter>
</Report>
