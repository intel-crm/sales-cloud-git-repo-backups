    <description>commission credits cross check</description>
    <filter>
        <booleanFilter>1 AND (2 AND 3) AND 4</booleanFilter>
        <criteriaItems>
            <column>Opportunity$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>,Lost,Cancelled</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Core_Approval_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Approved</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Core_Approved_Date__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>1/1/2023 12:00 AM</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.KPI_Opportunity__r$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>DCAI Strategic Next Gen Design #,DCAI PSG Design $,NEX Design $,One Intel SW Enablement Design PW #,CSO AMS Design $,CCG Commercial Deal Sell-To $,CCG vPro Platform + Solution Adoption Deal $,CCG Channel and Influencer vPro Solution Adoption Deal $,DCAI Deal Sell-To $,Intel Affinity Deal #,DCAI Public Cloud Deal $,Intel Affinity Solutions Program #,NEX Deal Sell-To $,One Intel Industry Transformational Engagement #,AXG Deal Sell-To $,Sapphire</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>2023 Approved Opportunities by KPI</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Opportunities_with_New_Opportunity_KPIs__c</reportType>
    <roleHierarchyFilter>SMG</roleHierarchyFilter>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Opportunity$CloseDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
