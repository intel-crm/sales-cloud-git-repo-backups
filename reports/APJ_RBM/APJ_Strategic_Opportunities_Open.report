    <description>RT: Opportunities.  Open Opyts that have been flagged as Strategic for Staff Review.  There is a 3-hour delay from when an Opportunity is flagged to when it will show in the Pipeline Mgmt Dashboard.  This report will show immediately flagged optys</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Core_Opp_Strategic_Opportunity__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>Lighthouse,Regional Strategic</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>BucketField_67833849</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>APJ Strategic Opportunities Open</name>
    <params>
        <name>terr</name>
