<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <chart>
        <backgroundColor1>#FFFFFF</backgroundColor1>
        <backgroundColor2>#FFFFFF</backgroundColor2>
        <backgroundFadeDir>Diagonal</backgroundFadeDir>
        <chartSummaries>
            <axisBinding>y</axisBinding>
            <column>RowCount</column>
        </chartSummaries>
        <chartType>Donut</chartType>
        <enableHoverLabels>false</enableHoverLabels>
        <expandOthers>true</expandOthers>
        <groupingColumn>SWS_Cloud_Credit_Request__c$SWS_Redeemed__c</groupingColumn>
        <legendPosition>Right</legendPosition>
        <location>CHART_BOTTOM</location>
        <showAxisLabels>true</showAxisLabels>
        <showPercentage>true</showPercentage>
        <showTotal>true</showTotal>
        <showValues>false</showValues>
        <size>Medium</size>
        <summaryAxisRange>Auto</summaryAxisRange>
        <textColor>#000000</textColor>
        <textSize>12</textSize>
        <titleColor>#000000</titleColor>
        <titleSize>18</titleSize>
    </chart>
    <columns>
        <field>SWS_Cloud_Credit_Request__c$Name</field>
    </columns>
    <columns>
        <field>SWS_Cloud_Credit_Request__c$SWS_Coupon_Status__c</field>
    </columns>
    <columns>
        <field>SWS_Cloud_Credit_Request__c$SWS_Last_redeemed_date__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>SWS_Cloud_Credit_Request__c$SWS_No_Of_User__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>SWS_Cloud_Credit_Request__c$SWS_Number_of_Redemptions__c</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula> &apos;Q&apos;+TEXT(Ceiling(Month(Datevalue(SWS_Cloud_Credit_Request__c.CreatedDate)) / 3 ))</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Quarter</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>This report is used to track the coupon redemption details.</description>
    <filter>
        <criteriaItems>
            <column>SWS_Cloud_Credit_Request__c$SWS_Request_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Coupon_Generated</value>
        </criteriaItems>
        <criteriaItems>
            <column>SWS_Cloud_Credit_Request__c$RecordType</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>SWS_Cloud_Credit_Request__c.SWS_Cloud_Credit_Request</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Matrix</format>
    <groupingsAcross>
        <dateGranularity>Day</dateGranularity>
        <field>SWS_Cloud_Credit_Request__c$SWS_Redeemed__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsDown>
        <dateGranularity>Month</dateGranularity>
        <field>SWS_Cloud_Credit_Request__c$SWS_Submitted_On__c</field>
        <sortOrder>Desc</sortOrder>
    </groupingsDown>
    <name>Coupon Generated vs. Redeemed</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Credit_requests_with_lead_and_opportunities__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>SWS_Cloud_Credit_Request__c$CreatedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
