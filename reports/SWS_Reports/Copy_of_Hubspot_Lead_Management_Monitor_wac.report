<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>CREATED_DATE:UNIQUE</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Quarter</masterLabel>
        <scale>2</scale>
    </aggregates>
    <chart>
        <backgroundColor1>#FFFFFF</backgroundColor1>
        <backgroundColor2>#FFFFFF</backgroundColor2>
        <backgroundFadeDir>Diagonal</backgroundFadeDir>
        <chartSummaries>
            <axisBinding>y</axisBinding>
            <column>RowCount</column>
        </chartSummaries>
        <chartType>Funnel</chartType>
        <enableHoverLabels>false</enableHoverLabels>
        <expandOthers>true</expandOthers>
        <groupingColumn>CDF1</groupingColumn>
        <legendPosition>Right</legendPosition>
        <location>CHART_BOTTOM</location>
        <showAxisLabels>false</showAxisLabels>
        <showPercentage>true</showPercentage>
        <showTotal>false</showTotal>
        <showValues>true</showValues>
        <size>Medium</size>
        <summaryAxisRange>Auto</summaryAxisRange>
        <textColor>#000000</textColor>
        <textSize>12</textSize>
        <titleColor>#000000</titleColor>
        <titleSize>18</titleSize>
    </chart>
    <columns>
        <field>LEAD_SOURCE</field>
    </columns>
    <columns>
        <field>FIRST_NAME</field>
    </columns>
    <columns>
        <field>LAST_NAME</field>
    </columns>
    <columns>
        <field>STATUS</field>
    </columns>
    <columns>
        <field>OPP_NAME</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>CONVERTED</field>
    </columns>
    <columns>
        <field>CONVERTED_DATE</field>
    </columns>
    <columns>
        <field>STAGE_NAME</field>
    </columns>
    <columns>
        <field>CREATED_DATE</field>
    </columns>
    <columns>
        <field>Lead.SWS_Lead_Source_System__c</field>
    </columns>
    <columns>
        <field>LEAD_ID</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>IF(
    ISBLANK(CONVERTED_DATE),
    IF(
        ISPICKVAL(STATUS, &apos;Converted To Opportunity&apos;), &quot;6.Converted To Opportunity&quot;,
        IF(
            ISPICKVAL(STATUS, &apos;Marketing Qualified Lead&apos;), &quot;1.Marketing Qualified Leads&quot;,
            IF(
                ISPICKVAL(STATUS, &apos;Sales Accepted Lead&apos;), &quot;4.Sales Accepted Leads&quot;,
                IF(
                    ISPICKVAL(STATUS, &apos;Sales Qualified Lead&apos;), &quot;5.Sales Qualified Leads&quot;,
                    IF(
                        ISPICKVAL(STATUS, &apos;Tele Accepted Lead&apos;), &quot;2.Tele Accepted Leads&quot;,
                        IF(
                            ISPICKVAL(STATUS, &apos;Tele Qualified Lead&apos;), &quot;3.Tele Qualified Leads&quot;,
                            &quot;&quot;
                        )
                    )
                )
            )
        )
    ),
    IF(
        ISPICKVAL(STAGE_NAME, &quot;Design Win&quot;), &quot;7.Design Win Opportunity&quot;,
        IF(
            ISPICKVAL(STAGE_NAME, &quot;Production Win&quot;), &quot;8.Production Win Opportunity&quot;,
            &quot;5.Sales Qualified Leads&quot;
        )
    )
)</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Stage</label>
        <scale>2</scale>
    </customDetailFormulas>
    <filter>
        <criteriaItems>
            <column>RECORDTYPE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Lead.Lead</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.SWS_Lead_Source_System__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>HubSpot,HubSpot1,HubSpot2</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>CDF1</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Copy of Hubspot Lead Management Monitor</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>OpportunityLead</reportType>
    <scope>org</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>LAST_ACTIVITY</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
