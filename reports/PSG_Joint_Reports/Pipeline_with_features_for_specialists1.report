    <description>Pull for specialists (IP and features needs to be edited for different needs)</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND (5 OR 6 OR 7)</booleanFilter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Product_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Intel® FPGAs</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Owner_Geo__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>ASMO</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Descriptive_Feature_Check__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>1</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Business_Unit_Territory__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>PSG-NA</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Design_Entry_Method__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>DSP,HLS,OpenCL,DLA,oneAPI</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_FPGA_Virtualization_Framework__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>DLA</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Memory_DSP_and_Embedded_IP__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>reed,parity,video</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
