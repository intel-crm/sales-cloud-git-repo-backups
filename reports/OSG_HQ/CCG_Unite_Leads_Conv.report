<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF(Lead.Core_SAL_Count__c:SUM&lt;1, 0, Lead.Core_SAL_Count__c:SUM/Lead.Core_MQL_Count__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <description>MGL Conversion to SAL</description>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>SAL %</masterLabel>
        <scale>1</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(Lead.Core_SQL_Count__c:SUM&lt;1, 0, Lead.Core_SQL_Count__c:SUM/Lead.Core_MQL_Count__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <description>Conversion of MAQLs to SQL</description>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>SQL %</masterLabel>
        <scale>1</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(Opportunity.Core_Wins_Oppty__c:SUM&lt;1, 0, Opportunity.Core_Wins_Oppty__c:SUM/Lead.Core_MQL_Count__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <description>MAQL to Won Conversion</description>
        <developerName>FORMULA3</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Won Conv %</masterLabel>
        <scale>2</scale>
    </aggregates>
