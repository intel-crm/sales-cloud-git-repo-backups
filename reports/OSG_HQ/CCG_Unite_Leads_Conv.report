    <description>RT: Leads with converted lead information.  Special report for Kathy Mann on Unite Leads with conversion information</description>
    <filter>
        <booleanFilter>(1 OR 2 OR 3) AND 4</booleanFilter>
        <criteriaItems>
            <column>Lead.Core_Lead_Conversion_Point__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Unite</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Lead_Conversion_Point__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>ccg_NAR_ccgcom_LL_2021_Redmond Partner Leads_C-MKA-16511_T-MKA-22809</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.Core_Lead_Conversion_Point__c</column>
