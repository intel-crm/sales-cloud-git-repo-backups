<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF(Lead.Core_TQL_Count__c:SUM&lt;1,0,Lead.Core_TQL_Count__c:SUM/Lead.Core_MQL_Count__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <description>Conversions MAQL to TAL %</description>
        <developerName>FORMULA1</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>TQL %</masterLabel>
        <scale>1</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(Lead.Core_TAP_Count__c:SUM&lt;1,0,Lead.Core_TAP_Count__c:SUM/Lead.Core_MQL_Count__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <description>Conversion from MQL to TAL</description>
        <developerName>FORMULA2</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>MQL to TAL</masterLabel>
        <scale>1</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(Lead.Core_TQL_Count__c:SUM&lt;1,0,Lead.Core_TQL_Count__c:SUM/Lead.Core_TAP_Count__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <description>Conversion from TAL to TQL</description>
        <developerName>FORMULA3</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>TAL to TQL</masterLabel>
        <scale>1</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>if(Lead.Core_SAL_Count__c:SUM&lt;1,0,Lead.Core_SAL_Count__c:SUM/Lead.Core_TAP_Count__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <description>TQL to SAL Conversion, without Pass to Partner</description>
        <developerName>FORMULA4</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>TQL to SAL</masterLabel>
        <scale>1</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>Lead.Core_TQL_Count__c:SUM-Lead.Core_SAL_Count__c:SUM</calculatedFormula>
        <datatype>number</datatype>
        <description>TQL less SAL. TQL Disposed</description>
        <developerName>FORMULA5</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>TQL Disposed</masterLabel>
        <scale>0</scale>
    </aggregates>
    <columns>
        <field>COUNTRY_CODE</field>
    </columns>
    <columns>
        <field>CREATED_DATE</field>
    </columns>
    <columns>
        <field>Lead.Core_Lead_Conversion_Point__c</field>
    </columns>
    <columns>
        <field>STATUS</field>
    </columns>
    <columns>
        <field>Lead.Core_Lead_State__c</field>
    </columns>
    <columns>
        <field>Lead.Core_Lead_Status__c</field>
    </columns>
    <columns>
        <field>Lead.Core_Lead_Sub_Status__c</field>
    </columns>
    <columns>
        <field>FIRST_NAME</field>
    </columns>
    <columns>
        <field>LAST_NAME</field>
    </columns>
    <columns>
        <field>COMPANY</field>
    </columns>
    <columns>
        <field>OWNER</field>
    </columns>
    <columns>
        <field>LAST_UPDATE</field>
    </columns>
    <columns>
        <field>LAST_UPDATE_BY</field>
    </columns>
    <columns>
        <field>Lead.Core_Last_Activity_Date__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Lead.Core_TQL_Count__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Lead.Core_SAL_Count__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Lead.Core_SQL_Count__c</field>
    </columns>
    <columns>
        <field>CREATED</field>
    </columns>
    <description>RT: Leads</description>
    <filter>
        <criteriaItems>
            <column>RECORDTYPE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Lead.Lead</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.Core_Lead_State__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Terminated,Converted,Rejected</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.Core_TQL_Count__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.Core_Lead_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Passed to Partner</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Lead.Core_Geo__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>LEAD_SOURCE</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Lead.Core_PSG_Lead__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>TQL Excluding Pass to Partner</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>LeadList</reportType>
    <scope>org</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>CREATED_DATE</dateColumn>
        <interval>INTERVAL_PREVCUR2Y</interval>
    </timeFrameFilter>
</Report>
