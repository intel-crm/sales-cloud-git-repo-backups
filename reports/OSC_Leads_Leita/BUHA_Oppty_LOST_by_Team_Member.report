    <description>shows all opportunities that have been lost or cancelled that have a BUHA team member tagged</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
        <criteriaItems>
            <column>MEMBER_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Daniels Wang,martin suarez,alan coelho,Vilmary Orta Perez,Ignacio Mosquera,Tomás Correa,Sergio Venier,Sheldon Prince,RON DELOS SANTOS,Diego Gonzalez,Selin Browning,Magdalena Lewicka,Daria Serzysko,SECHKIN EROL FEIM,Pawel Madry,Piotr Kwiatkowski,Pawel Tarnowski,Karim Elsweefy,Emmilyn Leong,Charu Dixit,Oi Ling Kan,YUN SIN SOO,winnie wong,Zi Qian Thong,Christopher Thong</value>
        </criteriaItems>
        <criteriaItems>
            <column>MEMBER_ROLE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Team Member (100%),Team member (100% commitment over the lifetime of the opportunity)</value>
        </criteriaItems>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Lost,Cancelled,Production Lost,Production Cancelled,Group Cancelled,Group Closed</value>
        </criteriaItems>
        <criteriaItems>
            <column>AMOUNT</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>1</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
