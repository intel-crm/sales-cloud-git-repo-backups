        <developerName>BucketField_6066387</developerName>
        <masterLabel>WR Bucket</masterLabel>
        <nullTreatment>n</nullTreatment>
        <sourceColumnName>STAGE_NAME</sourceColumnName>
        <useOther>false</useOther>
        <values>
            <sourceValues>
                <sourceValue>Design Win</sourceValue>
            </sourceValues>
            <sourceValues>
                <sourceValue>Production Win</sourceValue>
            </sourceValues>
            <sourceValues>
                <sourceValue>Production Lost</sourceValue>
            </sourceValues>
            <sourceValues>
                <sourceValue>Production Cancelled</sourceValue>
            </sourceValues>
            <value>WON</value>
        </values>
        <values>
            <sourceValues>
                <sourceValue>Lost</sourceValue>
            </sourceValues>
            <value>LOST</value>
        </values>
        <values>
            <sourceValues>
                <sourceValue>Cancelled</sourceValue>
            </sourceValues>
            <value>CANCELLED</value>
        </values>
    </buckets>
    <chart>
