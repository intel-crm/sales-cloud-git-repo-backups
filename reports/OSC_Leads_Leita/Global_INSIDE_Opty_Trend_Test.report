<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF(Opportunity.Core_DW_Count__c:SUM &gt;= Opportunity.Core_Opportunity_Count__c:SUM , Opportunity.Core_Opportunity_Count__c:SUM *1, Opportunity.Core_Opportunity_Count__c:SUM * -1)</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Net Optys</masterLabel>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>Opportunity.Core_DW_Count__c:SUM -Opportunity.Core_Lost_Oppty__c:SUM</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Total Net Optys</masterLabel>
        <scale>2</scale>
    </aggregates>
    <buckets>
