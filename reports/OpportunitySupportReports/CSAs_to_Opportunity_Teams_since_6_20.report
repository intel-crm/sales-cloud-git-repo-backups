    <description>Report of all known CSAs added to opportunity teams since 6/20 (when new support request process was rolled out) sorted by region and individual.</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.OpportunityTeamMembers$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Sarah Musick,Gopal Kandhasamy,Brian Caddell,Kiran Agrahara,Vijay Bandari,Sumesh Sukumar,Nishikant Singh,Steve Fowler,Vivek Kulkarni,Keith Sundberg,Rajiv Mandal,Ibett Acarapi,Samantha Cabrera Moscofian,Miguel Soto,Volga Simsek,Bhavani Salunkhe,Farid El Chalouhi,Marcel Brueckner,Ali Can Yurtseven,Marco Righini,Pedro Benito Mendoza,Swapnil Shah,Jimin Cai,Qingfeng Zhang,Marty Liang,Lianghou Xu,Emily Zhou,Tong Chen,Xingxian Luo,Xiaolei Ren,Myles Hu,John Kim,Abhishek Kumar Singh,Beny Ibrani,Mousumi Dash,Prabhas Harlapur,Jackie Lee,Seva Semouchin</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.OpportunityTeamMembers*OpportunityTeamMember$Core_Date_Added__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>6/20/2023 12:00 AM</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.OpportunityTeamMembers$TeamMemberRole</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Technical Owner (100%),Technical Owner (100% commitment over the lifetime of the opportunity)</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
