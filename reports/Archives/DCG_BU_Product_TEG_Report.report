    <description>Provides a view of the DCG Pipeline data (including Lost &amp; Canx products) for all Design-Original and Design-Secondary opportunities.  Aligned with the Intel Pipeline Dashboard</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>contains</operator>
            <value>Design</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_BU_Short_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
