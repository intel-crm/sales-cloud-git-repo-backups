    <description>All opportunities with an Opportunity Type of &quot;Design&quot; and a &quot;Code Name&quot; of Silver Butte&quot;.</description>
    <filter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_KPI_Date__c</column>
            <columnToColumn>false</columnToColumn>
