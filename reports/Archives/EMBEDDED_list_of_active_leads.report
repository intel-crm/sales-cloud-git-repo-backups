        <criteriaItems>
            <column>OWNER_ROLE_DISPLAY</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>contains</operator>
            <value>Smelkova,Gal,Williams,Czekaj,Garcia Comin,Peters,Galyamov,Osiecki,Carrera,Huzjak,Podsiedlik</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.Core_Sales_Segment__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>Embedded</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
