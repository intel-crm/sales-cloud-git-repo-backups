        <criteriaItems>
            <column>SBQQ__Quote__c.SBQQ__LineItems__r$Pricing_Status_Nm__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Approved,Lost,Pending Further Intel Review,Pending Intel Field Review,Rejected,Revised,Won</value>
        </criteriaItems>
        <criteriaItems>
            <column>SBQQ__Quote__c$RecordType</column>
