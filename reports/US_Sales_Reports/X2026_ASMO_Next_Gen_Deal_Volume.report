<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>
IF(
  (Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000) &gt; 1,
  IF(
    (Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000) &gt;= 1.10,
    1 + ((Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000 - 1.10) * 1) + 0.20,
    1 + ((Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000 - 1) * 2)
  ),
  (Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000)
)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Rate of Pay</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM/6200000</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>YTD Achievement %</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>
(
  IF(
    (Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000) &gt; 1,
    IF(
      (Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000) &gt;= 1.10,
      1 + ((Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000 - 1.10)) + 0.20,
      1 + ((Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000 - 1) * 2)
    ),
    (Core_Oppty_KPI_New__c.Core_KPI_Quantity__c:SUM / 6200000)
  )
) * 0.25</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA3</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>STG Line Item Payout</masterLabel>
        <scale>0</scale>
    </aggregates>
