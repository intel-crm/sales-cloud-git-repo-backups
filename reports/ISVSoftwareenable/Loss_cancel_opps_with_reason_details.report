    <customDetailFormulas>
        <calculatedFormula>
IF(
    TEXT(STAGE_NAME) = &quot;Production Win&quot;,
    Opportunity.Core_First_Customer_Ship_Date__c - DATEVALUE(CREATED_DATE),
    TODAY() - DATEVALUE(CREATED_DATE)
)</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>AGE</label>
        <scale>0</scale>
    </customDetailFormulas>
    <description>Copy of Loss/cancel opps with reason/details</description>
    <filter>
        <booleanFilter>2 AND 1 AND 3 AND 4</booleanFilter>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Lost,Cancelled</value>
        </criteriaItems>
        <criteriaItems>
            <column>RECORDTYPE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Opportunity.Core_Design_Opportunity</value>
        </criteriaItems>
        <criteriaItems>
            <column>LAST_STAGE_CHANGE_DATE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>1/1/2026 12:00 AM</value>
        </criteriaItems>
        <criteriaItems>
            <column>FULL_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Ankit Kumar,Ashton Porter,Chris Smart,Christel Thompson,Ellen Farber,George Kondos,Khondoker Mujtaba,Maneesh Durgaiah,Mario DiSanza,Mark Wier,Matthew House,Naveen Kumar,Peter Bas,Robert McLoughlin,Rodney Dahleen,Samanth R,Sameera Kandewatte,Shantanu Priyadarshi,Sonali Singh,Syed Amir Ali,Umair Tariq,XIN FAN</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>STAGE_NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <field>LAST_STAGE_CHANGE_DATE</field>
        <sortOrder>Desc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>FULL_NAME</field>
        <sortOrder>Desc</sortOrder>
    </groupingsDown>
    <name>!!!Loss/cancel opps with reason/details</name>
    <params>
        <name>terr</name>
        <value>all</value>
    </params>
    <params>
        <name>open</name>
        <value>all</value>
    </params>
    <params>
        <name>probability</name>
        <value>&gt;0</value>
    </params>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Opportunity</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>false</showSubTotals>
