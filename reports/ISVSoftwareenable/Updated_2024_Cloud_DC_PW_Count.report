    <description>Updated methodology for Cloud &amp; DC Accelerator tagging using Account BU Focus = NEX NESG tag</description>
    <filter>
        <booleanFilter>1 AND 2 AND ((3 AND 7) OR (4 AND 5 AND 6))</booleanFilter>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Production Win</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Design: Software-enable</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Account_BU_Focus__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>includes</operator>
            <value>IOTG</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Product_Segment__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Comms Infra. / Networking</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Concatenated_Application_workload__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>Networking,AI inference,AI Training,Security,AI PC</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Account_BU_Focus__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>includes</operator>
            <value>DCG-Cloud</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Concatenated_Application_workload__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>Networking</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity.Core_Sales_Groups__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Updated: 2024 Cloud &amp; DC PW Count</name>
    <params>
        <name>terr</name>
        <value>all</value>
    </params>
    <params>
        <name>open</name>
        <value>all</value>
    </params>
    <params>
        <name>probability</name>
        <value>&gt;0</value>
    </params>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Opportunity</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Opportunity.Core_First_Customer_Ship_Date__c</dateColumn>
        <interval>INTERVAL_PREVY</interval>
    </timeFrameFilter>
</Report>
