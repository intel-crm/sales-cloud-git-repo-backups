    <customDetailFormulas>
        <calculatedFormula>IF( AND(TODAY()-DUE_DATE &gt;=0 , TODAY()-DUE_DATE &lt;15),&quot;0-15&quot;,

IF( AND(TODAY()-DUE_DATE &gt;=15 , TODAY()-DUE_DATE &lt;30),&quot;15-30&quot;,

IF( AND(TODAY()-DUE_DATE &gt;=30 , TODAY()-DUE_DATE &lt;60),&quot;30-60&quot;,

IF( AND(TODAY()-DUE_DATE &gt;=60 , TODAY()-DUE_DATE &lt;90),&quot;60-90&quot;,

IF( AND(TODAY()-DUE_DATE &gt;=90 , TODAY()-DUE_DATE &lt;120),&quot;90-120&quot;,

IF( TODAY()-DUE_DATE &gt;=120 ,&quot;x_120+&quot;, &quot;y_Never&quot;

))))))</calculatedFormula>
