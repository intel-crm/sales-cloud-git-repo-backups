    <description>AMOGLION_EMEA_EPS_Won =  Template
Report to show DCAI Deals by stage to identify opportunities for acceleration. Hardware Sold to and through only</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6</booleanFilter>
        <criteriaItems>
            <column>INDUSTRY</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Accommodation and Food Services,Agriculture,&quot;Arts, Entertainment and Recreation&quot;,Automotive (Non Manufacturing),Construction,Consulting,Defense and Space,Education,Energy and Utilities,Finance and Insurance,Gaming,Government,Health and Life Sciences,Manufacturing,Media,Not For Profit,Professional and Business Services,&quot;Real Estate, Rental and Leasing&quot;,Retail,Software and Services,Telecommunications,To Be Defined,&quot;Transportation, Travel and Warehousing&quot;</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>EMEA Sales Group,EMEA Hosted Sales Group,EMEA Partner Holding</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Deal: Sell-through,Deal: Sell-to</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_BU_Product_Segment__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>DCAI</value>
        </criteriaItems>
        <criteriaItems>
            <column>STAGE_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Design,Design Win,Production Win</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Product_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Services</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
