    <description>AMOGLION_EMEA_EPS_Won =  Template
Report to show DCAI Deals lost to identify opportunities for winback and incremental volumes</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5</booleanFilter>
        <criteriaItems>
            <column>INDUSTRY</column>
