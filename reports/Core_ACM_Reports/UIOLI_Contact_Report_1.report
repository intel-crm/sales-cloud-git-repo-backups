    <description>This report displays external contacts gone through B2B delete or Downgrade to B2C from Azure. Email notification can be subscribed.</description>
    <filter>
        <criteriaItems>
            <column>Contact.Core_Enterprise_Id__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <column>Contact.Core_Login_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Deleted,Downgrade to B2C</value>
        </criteriaItems>
        <criteriaItems>
            <column>Contact.Core_Deletion_Reason__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <column>Contact.Core_Email_Domain__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notContain</operator>
            <value>mailinator,mailosaur,dispostable.com,intel.com,ipatest.com,testexpected.com</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>Contacts for Deactivation-UIOLI Impact</name>
    <params>
        <name>co</name>
