    <description>*Updated w/ NRTK Reports*
Pipeline Dashboard. List of PENDING opportunities with the KPIs.</description>
    <filter>
        <criteriaItems>
            <column>Opportunity$Core_Sales_Groups__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>americas,hosted</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$Owner.Core_Manager__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Wood,Covey,Stiles,thomson,gordon</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Qualify,Define,Develop,Design</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
