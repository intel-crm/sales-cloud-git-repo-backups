        <criteriaItems>
            <column>OWNER_ROLE_DISPLAY</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>contains</operator>
            <value>thompson,wood,halversen,amacher,montana,swyers,de grazia,garcia vitores,durrieu,oldfield</value>
        </criteriaItems>
        <criteriaItems>
            <column>LEAD_OWNER</column>
