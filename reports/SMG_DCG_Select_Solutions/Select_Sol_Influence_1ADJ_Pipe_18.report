            <isUnlocked>true</isUnlocked>
            <operator>includes</operator>
            <value>Select Solutions - NFVi with Ubuntu,Select Solutions - VMware Cloud Foundation (VCF),Select Solutions - VMware vSAN,Select Solutions - MSFT SQL Server Business Operations,Select Solutions - MSFT SQL Server Enterprise Data Warehouse,Select Solutions - Genomics Analytics,Select Solutions - Simulation and Modeling,Select Solutions - MSFT Windows Server Software Defined Storage,Select Solutions - MSFT Azure Stack</value>
        </criteriaItems>
