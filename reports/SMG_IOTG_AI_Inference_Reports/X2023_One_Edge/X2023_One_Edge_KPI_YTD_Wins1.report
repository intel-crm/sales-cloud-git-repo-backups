    <description>Design and Deal - (Workload contains &quot;Internet of Things(IOT)&quot; AND Industry Use Case contains &quot;OneEdge&quot;) OR (Product name starts with &quot;Intel® Smart Edge, Intel® Edge Insights, Converged Edge Insights, Edge Insights, Intel® Geti™ Platform&quot;)</description>
    <filter>
        <booleanFilter>1 AND ((2 AND 3) OR 4) AND 5 AND 6</booleanFilter>
        <criteriaItems>
            <column>Opportunity.Core_Opportunity_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Design: Original,Design: Secondary,Deal: Sell-through,Deal: Sell-to</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Concatenated_Application_workload__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Internet of Things(IoT)</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Concatenated_Industry_use_case__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>OneEdge</value>
        </criteriaItems>
        <criteriaItems>
            <column>PRODUCT_NAME</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>startsWith</operator>
            <value>Intel® Smart Edge,Intel® Edge Insights,Converged Edge Insights,Edge Insights,Intel® Geti™ Platform,Intel® Ultra Cloud Client,Open Visual Cloud,Intel® Edge Controls for Industrial (Intel® ECI),Situational Awareness at the Dynamic Edge (SADE),Intel® SceneScape,Intel® Distribution of OpenVINO™ toolkit,OpenVINO™ toolkit,OpenVINO™ toolkit for Marketplace</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Commissionable__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Yes</value>
        </criteriaItems>
        <criteriaItems>
            <column>Opportunity.Core_Exclude_From_KPIs__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>0</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
