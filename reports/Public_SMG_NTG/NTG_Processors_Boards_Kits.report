    <description>Report of Processors, Boards &amp; Kits that are mapped to BU Short Name &quot;NTG&quot;</description>
    <filter>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_BU_Short_Name_Old__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>NTG</value>
        </criteriaItems>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Product_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Processor</value>
        </criteriaItems>
        <criteriaItems>
            <column>Product2.Core_Product_Type__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>Board</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
