<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF((Opportunity.Core_Wins_Oppty__c:SUM + Opportunity.Core_Lost_Oppty__c:SUM)=0,Opportunity.Core_Wins_Oppty__c:SUM,Opportunity.Core_Wins_Oppty__c:SUM /(Opportunity.Core_Wins_Oppty__c:SUM + Opportunity.Core_Lost_Oppty__c:SUM))</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Win Rate % - Oppty</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>1 -
(OpportunityLineItem.Core_Lost_Total_Price__c:SUM
/ OpportunityLineItem.Core_KPI_Total_Price__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Win Rate - Total Price %</masterLabel>
        <scale>1</scale>
    </aggregates>
    <aggregates>
