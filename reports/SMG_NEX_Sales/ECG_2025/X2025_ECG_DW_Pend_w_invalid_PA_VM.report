    <description>Pending ECG Design Opts. with invalid Product Application and Vertical Market Values</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND (4 AND 5) AND (6 OR 7)</booleanFilter>
        <criteriaItems>
            <column>OpportunityLineItem.Core_Status__c</column>
