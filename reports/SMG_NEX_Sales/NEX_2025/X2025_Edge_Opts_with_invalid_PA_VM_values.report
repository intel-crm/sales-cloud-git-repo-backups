            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Aerospace/Avionics,ASIC Prototyping/Emulation,ATE &amp; Semiconductor Tester,Broadcast/Studio,&quot;Diagnostic, Test &amp; Measurement Equipment&quot;,&quot;Drives, Motor Control, Encoders&quot;,Embedded/IOT Virtual Appliances,Embedded Board,EV Charger,Gaming &amp; Lottery Machines,Gateway,Imaging Devices (not IP Camera based),&quot;Infrastructure (e.g., Roadside, Rail, etc.)&quot;,Interactive Displays &amp; Kiosks,Motion Control and CNC,PLC &amp; PAC,POS / ATM,Radar,&quot;Robotics: Mobile (AGV, AMR)&quot;,Robotics: Stationary,Ruggedized/Industrial/Vertical Grade PCs,Ruggedized/Industrial/Vertical Grade Servers,&quot;Thin Client, Cloud Client&quot;,&quot;Vehicles - Non-Automotive (e.g. Trains, Ships, etc.)&quot;,&quot;Video (incl. Camera, NVR, AI Box, Video Server)&quot;</value>
        </criteriaItems>
