    <description>2020 Opportunity Products submitted between Jan 1st through and including Jan 20th, but NOT yet approved</description>
    <filter>
        <criteriaItems>
            <column>Opportunity.Core_Date_Submitted_for_Approval__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
