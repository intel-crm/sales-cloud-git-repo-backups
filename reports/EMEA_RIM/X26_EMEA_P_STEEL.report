    <description>Displays all EMEA campaigns Post L2 Approval</description>
    <filter>
        <criteriaItems>
            <column>Campaign.Core_MDF_Account__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>IPA - Bristal org_CCPTest</value>
        </criteriaItems>
        <criteriaItems>
            <column>Campaign.Core_MDF_Host_Region_cd__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
