        </criteriaItems>
        <criteriaItems>
            <column>START_DATE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>1/1/2026</value>
        </criteriaItems>
        <criteriaItems>
            <column>CAMPAIGN_STATUS</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Campaign Accepted,Completed,In Progress,Pending Approval,Planned,Proposal Accepted,Revision Required,Submitted</value>
        </criteriaItems>
        <criteriaItems>
            <column>Campaign.Core_MDF_Budget_Type_txt__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Account Plan,Proposal II MDF,Proposal I MDF</value>
        </criteriaItems>
        <criteriaItems>
            <column>Campaign.Core_MDF_Comments_Internal_Only__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>[#PRG-5IR01#],#PRG-5IR01#,PRG-5IR01,PRG--5IR01</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
