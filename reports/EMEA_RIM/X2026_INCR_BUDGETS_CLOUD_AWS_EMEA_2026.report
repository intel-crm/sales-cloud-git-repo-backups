    <description>Report that lists account balance for each account node for a given budget year .</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6 AND 7</booleanFilter>
        <criteriaItems>
            <column>PartnerMarketingBudget.PartnerFundAllocations.PartnerFundRequests.PartnerFundClaims$Core_MDF_Region_Cd__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,ASMO,EMEA</value>
        </criteriaItems>
        <criteriaItems>
            <column>PartnerMarketingBudget$Core_MDF_Budget_Type_Txt__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Account Plan</value>
        </criteriaItems>
        <criteriaItems>
            <column>PartnerMarketingBudget$Core_MDF_Program__c.Core_MDF_Technical_Program_Name__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Intel Partner Alliance</value>
        </criteriaItems>
        <criteriaItems>
            <column>PartnerMarketingBudget.PartnerFundAllocations$ChannelPartner</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>IPA - Bristal org_CCPTest,Bristal org_CCPTest Node</value>
        </criteriaItems>
        <criteriaItems>
            <column>PartnerMarketingBudget.PartnerFundAllocations.PartnerFundRequests$Core_MDF_Fund_Request_Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Closed,Draft,In-Progress,Pending Approval,Pending Review,Planned,Revision Required</value>
        </criteriaItems>
        <criteriaItems>
            <column>PartnerMarketingBudget.PartnerFundAllocations$ChannelPartner</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notContain</operator>
            <value>Component,United States,Canada,PSG,Mexico,Hong Kong,Singapore,Taiwan,Miami,India,New Zealand,Malaysia,Thailand,Australia,Eastronics,Rutronik,CMS,Asbis,Lafi</value>
        </criteriaItems>
        <criteriaItems>
            <column>PartnerMarketingBudget$Name</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>contains</operator>
            <value>CLOUD AWS EMEA 2026</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>PartnerMarketingBudget$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>2026 INCR BUDGETS = CLOUD AWS EMEA 2026</name>
    <params>
        <name>co</name>
        <value>0</value>
    </params>
    <reportType>Partner_Budgets_with_Allocations__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>PartnerMarketingBudget$StartDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
