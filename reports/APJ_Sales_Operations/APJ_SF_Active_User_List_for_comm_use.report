    <description>This report uses to pull the active APJ Salesforce Users for sending communications.  This report contains the following profile users EXCEPT HQ users.(1) Sales Manger, (2) Sales Rep-BB, (3) Sales Ops, (4) Data Ops EXCLUDE CWs.</description>
    <filter>
        <criteriaItems>
            <column>User.Core_User_Geo__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>APJ</value>
        </criteriaItems>
        <criteriaItems>
            <column>PROFILE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>Data Ops,Sales Manager,Sales Rep-BB,Sales Ops,marketing development manager,Sales Rep-BB-Dual IPS</value>
        </criteriaItems>
        <criteriaItems>
            <column>User.Core_WWID__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notEqual</operator>
            <value>11594564,11242442,11641186,11678950,11504000</value>
        </criteriaItems>
        <criteriaItems>
            <column>ROLE</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notEqual</operator>
            <value></value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>APJ SF Active User List (for comm use)</name>
    <params>
        <name>active</name>
        <value>active</value>
    </params>
