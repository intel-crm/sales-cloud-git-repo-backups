<?xml version="1.0" encoding="UTF-8"?>
<MatchingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <matchingRules>
        <fullName>Pricing_Competitor_Product_Dup_Check_matching_rule</fullName>
        <description>Competitor Product Duplicate Check with competitor Product Name Matching Rule</description>
