        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CNDA_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Salesforce_ID__r.Core_CNDA_Number__c</leftValueReference>
