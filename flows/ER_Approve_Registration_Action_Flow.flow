    <decisions>
        <name>Verify_reqType</name>
        <label>Verify reqType</label>
        <locationX>613</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Verify_Account_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Not_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Salesforce_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
