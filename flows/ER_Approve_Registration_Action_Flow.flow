    <recordLookups>
        <name>Get_Valid_Registration_Record</name>
        <label>Get Valid Registration Record</label>
        <locationX>2091</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
