<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Status_to_Approved</name>
        <label>Assign Status to Approved</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>Get_Valid_Registration_Record.PRM_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Approve_Registration_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Status_to_Pending</name>
        <label>Assign Status to Pending</label>
        <locationX>50</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>Get_Valid_Registration_Record.PRM_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Valid_Registration_Record.PRM_Account_Request_Queue__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Account_Request_Queue</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Approve_Registration_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Valid_Registration_Check</name>
        <label>Valid Registration Check</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Error_Display_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Registration</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>Valid Registration</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_reqType</name>
        <label>Verify reqType</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Assign_Status_to_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>reqType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Account Creation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Account_Request_Queue</targetReference>
            </connector>
            <label>New Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Status</name>
        <label>Verify Status</label>
        <locationX>182</locationX>
        <locationY>974</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Success_Screen</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
    </decisions>
    <description>This flow gets called from Quick Action &apos;Approve&apos; on new registration record</description>
    <environments>Default</environments>
    <formulas>
        <name>accountName</name>
        <dataType>String</dataType>
        <expression>if({!Get_Valid_Registration_Record.PRM_Account_Name__c} !=null,{!Get_Valid_Registration_Record.PRM_Account_Name__c},null)</expression>
    </formulas>
    <formulas>
        <name>globalAccount</name>
        <dataType>String</dataType>
        <expression>if({!Get_Valid_Registration_Record.PRM_Review_Note_txt__c} !=null,{!Get_Valid_Registration_Record.PRM_Review_Note_txt__c},null)</expression>
    </formulas>
    <formulas>
        <name>reqType</name>
        <dataType>String</dataType>
        <expression>if({!Get_Valid_Registration_Record.PRM_Salesforce_ID__c}==null &amp;&amp; {!Get_Valid_Registration_Record.RecordType.DeveloperName} =&apos;Account_Create_Request&apos;,&apos;New Account Creation&apos;,null)</expression>
    </formulas>
    <formulas>
        <name>requestorEmail</name>
        <dataType>String</dataType>
        <expression>if({!$User.Email} !=null,{!$User.Email},null)</expression>
    </formulas>
    <formulas>
        <name>RequestorName</name>
        <dataType>String</dataType>
        <expression>if({!$User.FirstName} !=null,{!$User.FirstName},null)</expression>
    </formulas>
    <interviewLabel>ER Approve Registration Action Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ER Approve Registration Action Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Account_Request_Queue</name>
        <label>Create Account Request Queue</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <connector>
            <targetReference>Assign_Status_to_Pending</targetReference>
        </connector>
        <inputAssignments>
            <field>Account_Name__c</field>
            <value>
                <elementReference>accountName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Sales_Groups__c</field>
            <value>
                <stringValue>Undefined</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Sub_Industry__c</field>
            <value>
                <stringValue>To Be Defined</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Digital_Identifier_Type__c</field>
            <value>
                <stringValue>Website/URL</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Digital_Identifier_Value__c</field>
            <value>
                <elementReference>Get_Valid_Registration_Record.PRM_Account_URL__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Global_Account__c</field>
            <value>
                <elementReference>globalAccount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Industry__c</field>
            <value>
                <stringValue>To Be Defined</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Process_Type__c</field>
            <value>
                <stringValue>DZP</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Requestor_Email__c</field>
            <value>
                <elementReference>requestorEmail</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Requestor_Name__c</field>
            <value>
                <elementReference>RequestorName</elementReference>
            </value>
        </inputAssignments>
        <object>Account_Create_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get AccountCreateRequest RT</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Verify_reqType</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account_Create_Request</stringValue>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PRM_Registration_Request__c</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Valid_Registration_Record</name>
        <label>Get Valid Registration Record</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Valid_Registration_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>Entitlement_Details__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DZP</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_Registration_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Approve_Registration_Record</name>
        <label>Approve Registration Record</label>
        <locationX>182</locationX>
        <locationY>866</locationY>
        <connector>
            <targetReference>Verify_Status</targetReference>
        </connector>
        <inputReference>Get_Valid_Registration_Record</inputReference>
    </recordUpdates>
    <screens>
        <name>Error_Display_Screen</name>
        <label>Error Display Screen</label>
        <locationX>578</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>errorDisplayText</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(254, 2, 2);&quot;&gt;This registration record does not meet the necessary criteria, please review.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Success Screen</label>
        <locationX>50</locationX>
        <locationY>1082</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>successDisplayText</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(3, 250, 7);&quot;&gt;Registration record approval successful!!&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Valid_Registration_Record</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>req_Type</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
