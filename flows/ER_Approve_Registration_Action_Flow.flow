    <decisions>
        <name>Assign_Different_DZP_Status</name>
        <label>Assign Different DZP Status</label>
        <locationX>1568</locationX>
        <locationY>1706</locationY>
        <defaultConnector>
            <targetReference>Assign_Status_to_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>A_E_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.Current_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>A&amp;E Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_to_A_E_Approved</targetReference>
            </connector>
            <label>A&amp;E Pending</label>
        </rules>
        <rules>
            <name>IPA_Admin_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.Current_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IPA Admin Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_to_IPA_Admin_Pending</targetReference>
            </connector>
            <label>IPA Admin Pending</label>
        </rules>
        <rules>
            <name>RPM_Admin_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.Current_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RPM Admin Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_to_RPM_Admin_Pending</targetReference>
            </connector>
            <label>RPM Admin Pending</label>
        </rules>
        <rules>
            <name>Sales_Pending_status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.Current_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Insides Sales Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_to_Sales_Approved</targetReference>
            </connector>
            <label>Sales Pending</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_employee_entl_and_IPA_T_C_s</name>
        <label>Check for employee entl and IPA T&amp;C&apos;s</label>
        <locationX>1700</locationX>
        <locationY>1214</locationY>
        <defaultConnector>
            <targetReference>CNDA_for_DZP_Warning_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>employee_entl_and_IPA_T_C_s_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact_with_Employee_Entitlement</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Salesforce_ID__r.PRM_Count_IPA_Terms_And_Conditions__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Different_DZP_Status</targetReference>
            </connector>
            <label>employee entl and IPA T&amp;C&apos;s present</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if registration record is DZP</description>
        <name>CheckDZPRecord</name>
        <label>CheckDZPRecord</label>
        <locationX>2041</locationX>
        <locationY>890</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RecordEqualsDZP</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DZP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IPA - Portal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Verify_CNDA_number_for_DZP</targetReference>
            </connector>
            <label>RecordEqualsDZP</label>
        </rules>
        <rules>
            <name>RecordNotEqualsDZP</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Source__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>DZP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Source__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>IPA - Portal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_to_Approved</targetReference>
            </connector>
            <label>RecordNotEqualsDZP</label>
        </rules>
    </decisions>
    <decisions>
        <name>Valid_Registration_Check</name>
        <label>Valid Registration Check</label>
        <locationX>2091</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Error_Display_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Registration</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Intel_Account_RT</targetReference>
            </connector>
            <label>Valid Registration</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Account_Details</name>
        <label>Verify Account Details</label>
        <locationX>1177</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Registration_record_Approve_Warning_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CIM_ID_UCD_ID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Salesforce_ID__r.Core_CIM_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Salesforce_ID__r.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Salesforce_ID__r.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Intel_Account_RT.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Warning_Display</targetReference>
            </connector>
            <label>CIM ID &amp; UCD ID</label>
        </rules>
        <rules>
            <name>Account_Record_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Salesforce_ID__r.RecordTypeId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Intel_Account_RT.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Not_valid_Account</targetReference>
            </connector>
            <label>Account Record Type</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_CNDA_number_for_DZP</name>
        <label>Verify CNDA number for DZP</label>
        <locationX>1568</locationX>
        <locationY>998</locationY>
        <defaultConnector>
