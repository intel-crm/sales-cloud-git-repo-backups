    <decisions>
        <name>Assign_Different_DZP_Status</name>
        <label>Assign Different DZP Status</label>
        <locationX>1106</locationX>
        <locationY>1082</locationY>
        <defaultConnector>
            <targetReference>Assign_Status_to_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.Current_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>A&amp;E Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_to_A_E_Approved</targetReference>
            </connector>
            <label>A&amp;E Pending</label>
        </rules>
        <rules>
            <name>IPA_Admin_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.Current_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IPA Admin Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_to_IPA_Admin_Pending</targetReference>
            </connector>
            <label>IPA Admin Pending</label>
        </rules>
        <rules>
            <name>Sales_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.Current_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RPM Admin Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_to_RPM_Admin_Pending</targetReference>
            </connector>
            <label>RPM Admin Pending</label>
        </rules>
        <rules>
            <name>Sales_Pending_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.Current_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_to_Sales_Approved</targetReference>
            </connector>
            <label>Sales Pending</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_IF_IPA_Account</name>
        <label>Check IF IPA Account</label>
        <locationX>1106</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>Assign_Different_DZP_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Show_Warning_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Details.Core_Intel_Partner_Alliance_PartnerGroup__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DZP_Registration_record_Approve_Warning_Message</targetReference>
            </connector>
            <label>Show Warning Message</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if registration record is DZP</description>
        <name>CheckDZPRecord</name>
        <label>CheckDZPRecord</label>
        <locationX>1590</locationX>
        <locationY>566</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RecordEqualsDZP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DZP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Details</targetReference>
            </connector>
            <label>RecordEqualsDZP</label>
        </rules>
        <rules>
            <name>RecordsNotEqualDZP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Source__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>DZP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Registration_record_Approve_Warning_Message</targetReference>
            </connector>
            <label>RecordsNotEqualDZP</label>
        </rules>
    </decisions>
    <decisions>
        <name>Valid_Registration_Check</name>
        <label>Valid Registration Check</label>
        <locationX>1843</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Error_Display_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Registration</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>Valid Registration</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_reqType</name>
        <label>Verify reqType</label>
        <locationX>820</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>CheckDZPRecord</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>reqType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Account Creation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ARQ_creation_warning_screen</targetReference>
            </connector>
            <label>New Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Status</name>
        <label>Verify Status</label>
        <locationX>820</locationX>
        <locationY>1766</locationY>
        <defaultConnector>
            <targetReference>Success</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Valid_Registration_Record.PRM_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approve_Message</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
    </decisions>
    <description>This flow gets called from Quick Action &apos;Approve&apos; on new registration record</description>
    <environments>Default</environments>
    <formulas>
        <name>accountName</name>
        <dataType>String</dataType>
        <expression>if({!Get_Valid_Registration_Record.PRM_Account_Name__c} !=null,{!Get_Valid_Registration_Record.PRM_Account_Name__c},null)</expression>
    </formulas>
    <formulas>
        <name>addressCity</name>
        <dataType>String</dataType>
        <expression>if( {!Get_Valid_Registration_Record.PRM_City__c} != null, {!Get_Valid_Registration_Record.PRM_City__c} , null )</expression>
    </formulas>
    <formulas>
        <name>addressStreet</name>
        <dataType>String</dataType>
        <expression>if( {!Get_Valid_Registration_Record.PRM_Address_Line_1__c} != null, {!Get_Valid_Registration_Record.PRM_Address_Line_1__c} , null )</expression>
    </formulas>
    <formulas>
        <name>globalAccount</name>
        <dataType>String</dataType>
        <expression>if({!Get_Valid_Registration_Record.PRM_Review_Note_txt__c} !=null,{!Get_Valid_Registration_Record.PRM_Review_Note_txt__c},null)</expression>
    </formulas>
    <formulas>
        <name>postalCode</name>
        <dataType>String</dataType>
        <expression>if( {!Get_Valid_Registration_Record.PRM_Zip_Postal_Code__c} != null, {!Get_Valid_Registration_Record.PRM_Zip_Postal_Code__c}, null )</expression>
    </formulas>
    <formulas>
        <name>reqType</name>
        <dataType>String</dataType>
        <expression>if({!Get_Valid_Registration_Record.PRM_Salesforce_ID__c}==null &amp;&amp; {!Get_Valid_Registration_Record.RecordType.DeveloperName} =&apos;Account_Create_Request&apos;,&apos;New Account Creation&apos;,null)</expression>
    </formulas>
    <formulas>
        <name>requestorEmail</name>
        <dataType>String</dataType>
        <expression>if({!$User.Email} !=null,{!$User.Email},null)</expression>
    </formulas>
    <formulas>
        <name>RequestorName</name>
        <dataType>String</dataType>
        <expression>if({!$User.FirstName} !=null,{!$User.FirstName}&amp;{!$User.LastName},null)</expression>
    </formulas>
    <formulas>
        <name>stateCountryCode</name>
        <dataType>String</dataType>
        <expression>if( {!Get_Valid_Registration_Record.PRM_State_Province__c} != null, {!Get_Valid_Registration_Record.PRM_State_Province__c} , null )</expression>
    </formulas>
