                </rightValue>
            </conditions>
            <connector>
                <targetReference>checkCaseStatus</targetReference>
            </connector>
            <label>Available</label>
        </rules>
    </decisions>
    <description>Changes to update claim post the new PIC and Recovery processes</description>
