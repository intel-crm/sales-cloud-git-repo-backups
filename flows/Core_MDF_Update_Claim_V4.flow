    <decisions>
        <name>checkCaseStatus</name>
        <label>checkCaseStatus</label>
        <locationX>943</locationX>
        <locationY>46</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>ReviewCompleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Review Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Release_Review_Hold</targetReference>
            </connector>
            <label>Review Completed</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkClaimId</name>
        <label>checkClaimId</label>
        <locationX>390</locationX>
        <locationY>52</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>NotNull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
