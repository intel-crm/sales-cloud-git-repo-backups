    <description>Migrated from the Core IPS Case Notif External PB R4.2 process using multiple criteria.
Process Builder to send IPS notifications - External</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(       
             NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)), 
	       OR(  {!$Record.RecordType.developerName=}
                                           $Label.Core_IPS_CaseCreateRecordType_Name,
		         {!$Record.RecordType.developerName=} 
                                           $Label.Core_IPS_GECRecordTypeName),   
                  NOT( ISBLANK({!$Record.ContactId} )),
                  NOT(ISNULL({!$Record.ContactId} )) , 
                 ISNEW(),
                 {!$Record.Core_IPS_Is_Notification_Active__c} = TRUE,
                 {!$Record.Contact.Core_IPS_Active__c} = TRUE, 
		 {!$Record.Contact.Core_IPS_Email_Opt_Out__c} = FALSE,  
                 {!$Record.Core_IPS_Customer_Visible__c} = TRUE,
              OR(    ISPICKVAL({!$Record.Status}, &apos;New&apos;),
			  ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;)  ) 
               
   )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_11</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)), 
	       {!$Record.RecordType.developerName=}
                                           $Label.Core_IPS_CaseCreateRecordType_Name,
              NOT(ISNULL({!$Record.ContactId} )) , 
              NOT( ISBLANK({!$Record.ContactId} )),

                 {!$Record.Core_IPS_Is_Notification_Active__c} = TRUE,
                 {!$Record.Contact.Core_IPS_Active__c} = TRUE, 
		         {!$Record.Contact.Core_IPS_Email_Opt_Out__c} = FALSE,  
                 {!$Record.Core_IPS_Customer_Visible__c} = TRUE,
			          ISPICKVAL({!$Record.Status}, &apos;Open&apos;)  ,
             ISPICKVAL({!$Record.Core_Sub_Status__c} , &apos;Close-Pending&apos;) ,
                AND(   
                                ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                                NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))
                               
	                    ),
                                       
             ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Public to Customers&apos; )

        

)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_15</name>
        <dataType>Boolean</dataType>
        <expression>AND(       
             NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)), 
	     {!$Record.RecordType.developerName=}
                                           $Label.Core_IPS_CaseCreateRecordType_Name,
		  
                 /* NOT( ISBLANK({!$Record.Core_IPS_Partner_Sup_Owner__c}  )),
                  NOT(ISNULL({!$Record.Core_IPS_Partner_Sup_Owner__c}  )) , */

              /*Null checks and user active checks on  case Core_IPS_Partner_Sup_Owner__c field added by karthick- US113974*/ 				
IF(ISBLANK({!$Record.Core_IPS_Partner_Sup_Owner__c}  ), FALSE,{!$Record.Core_IPS_Partner_Sup_Owner__c.IsActive=true}),


                 {!$Record.Core_IPS_Is_Notification_Active__c} = TRUE,
                 {!$Record.Core_IPS_Customer_Visible__c} = TRUE,
              OR(    ISPICKVAL({!$Record.Status}, &apos;New&apos;),
			  ISPICKVAL({!$Record.Status}, &apos;Open&apos;)  ) ,
              ISCHANGED( {!$Record.Core_IPS_Partner_Sup_Owner__c} )
               
   )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_17</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)), 
	       {!$Record.RecordType.developerName=}
                                           $Label.Core_IPS_CaseCreateRecordType_Name,
            /*   NOT(ISNULL({!$Record.Core_IPS_Partner_Sup_Owner__c} )) , 
              NOT( ISBLANK({!$Record.Core_IPS_Partner_Sup_Owner__c})), */

           /*Null checks and user active checks on  case Core_IPS_Partner_Sup_Owner__c field added by karthick- US113974*/ 				
IF(ISBLANK({!$Record.Core_IPS_Partner_Sup_Owner__c}  ), FALSE,{!$Record.Core_IPS_Partner_Sup_Owner__c.IsActive=true}),


                 {!$Record.Core_IPS_Is_Notification_Active__c} = TRUE,
  
                 {!$Record.Core_IPS_Customer_Visible__c} = TRUE,
                       OR(    ISPICKVAL({!$Record.Status}, &apos;New&apos;),
			          ISPICKVAL({!$Record.Status}, &apos;Open&apos;)  ) ,
             
              AND(   
                                ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                                NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))                
	                    ),
                                       
             ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Private to Partner&apos;)


)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
	     NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)),  
             {!$Record.RecordType.developerName=} 
                                                   $Label.Core_IPS_CaseCreateRecordType_Name, 
              NOT(ISNULL({!$Record.ContactId} )) , 
              NOT( ISBLANK({!$Record.ContactId} )),
	      {!$Record.Core_IPS_Is_Notification_Active__c}  = TRUE,
              {!$Record.Contact.Core_IPS_Active__c} = TRUE,
              {!$Record.Contact.Core_IPS_Email_Opt_Out__c} = FALSE,
              {!$Record.Core_IPS_Customer_Visible__c} = TRUE,       
                 OR(       ISPICKVAL({!$Record.Status}, &apos;New&apos;),
			       ISPICKVAL({!$Record.Status}, &apos;Open&apos;)  ),
            ISCHANGED( {!$Record.Contact.Id} )
                 
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_7</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)), 
	       {!$Record.RecordType.developerName=}
                                           $Label.Core_IPS_CaseCreateRecordType_Name,
               NOT(ISNULL({!$Record.ContactId} )) , 
              NOT( ISBLANK({!$Record.ContactId} )),

                 {!$Record.Core_IPS_Is_Notification_Active__c} = TRUE,
                 {!$Record.Contact.Core_IPS_Active__c} = TRUE, 
		 {!$Record.Contact.Core_IPS_Email_Opt_Out__c} = FALSE,  
                 {!$Record.Core_IPS_Customer_Visible__c} = TRUE,
                       OR(    ISPICKVAL({!$Record.Status}, &apos;New&apos;),
			          ISPICKVAL({!$Record.Status}, &apos;Open&apos;)  ) ,
             NOT(  ISPICKVAL({!$Record.Core_Sub_Status__c} , &apos;Close-Pending&apos;)) ,
              AND(   
                                ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                                NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))                
	                    ),
                                       
             ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Public to Customers&apos; )
      


)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_9</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)), 
	       {!$Record.RecordType.developerName=}
                                           $Label.Core_IPS_CaseCreateRecordType_Name,
        
                   OR(      {!$Record.Count_Ext_Interested_Parties__c} &gt; 0,
                           /* NOT( ISBLANK({!$Record.Core_IPS_Partner_Sup_Owner__c}  )) */
                            /*Null checks and user active checks on  case Core_IPS_Partner_Sup_Owner__c field added by karthick- US113974*/ 				
IF(ISBLANK({!$Record.Core_IPS_Partner_Sup_Owner__c}  ), FALSE,{!$Record.Core_IPS_Partner_Sup_Owner__c.IsActive=true})
                         ),
                             
                 {!$Record.Core_IPS_Is_Notification_Active__c} = TRUE,
                 {!$Record.Core_IPS_Customer_Visible__c} = TRUE,
                       OR(    ISPICKVAL({!$Record.Status}, &apos;New&apos;),
			          ISPICKVAL({!$Record.Status}, &apos;Open&apos;)  ) ,
             NOT(  ISPICKVAL({!$Record.Core_Sub_Status__c} , &apos;Close-Pending&apos;)) ,
              AND(   
                                ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                                NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))                
	                    ),
                                       
             ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Public to Customers&apos; )
      


)</expression>
    </formulas>
    <formulas>
        <name>Workflowcriteria</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISNULL({!$Record.Owner:User.Id})),
    CONTAINS({!$Record.RecordType.DeveloperName}, &quot;IPS_&quot;),
OR(ISCHANGED({!$Record.OwnerId}),ISNEW())
)</expression>
    </formulas>
