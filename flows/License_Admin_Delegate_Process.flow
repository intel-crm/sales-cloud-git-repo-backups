        <label>Delegate Admin Added check</label>
        <locationX>446</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Delegate_Admin_Added</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DelegateAdminAdded</leftValueReference>
