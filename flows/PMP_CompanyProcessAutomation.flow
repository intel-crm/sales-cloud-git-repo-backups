    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>If_No_Existing_Emails_for_this_Company</name>
        <label>If No Existing Emails for this Company</label>
        <locationX>182</locationX>
        <locationY>5088</locationY>
        <defaultConnector>
            <targetReference>verify_whether_to_send_translation_approved_email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_If_no_existing_emails</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Email_Logs</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Company_Info_Email</targetReference>
            </connector>
            <label>Check If no existing emails</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is 10 Day(s) &apos;Update Required&apos; Reminder Emails Sent to Company ?</description>
        <name>Is_10_Day_s_Update_Required_Reminder_Emails_Sent_to_Company</name>
        <label>Is 10 Day(s) &apos;Update Required&apos; Reminder Emails Sent to Company ?</label>
        <locationX>1238</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Entry_Criteria_10_Day_s_Company_Update_Required_Reminder_Emails</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMP_Company_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Update Required</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Company_Status_Update_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Workflow_One_Week_Trigger_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Partner_Submitter_UserId__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Partner_Submitter_UserId__r.Contact.Core_Do_Not_Contact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>X10_Day_s_Reminder_Emails_for_Company_Update_Required</targetReference>
            </connector>
            <label>Entry Criteria : 10 Day(s) Company &apos;Update Required&apos; Reminder Emails</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is 3 Day(s) &apos;Update Required&apos; Reminder Emails Sent to Company ?</description>
        <name>Is_3_Day_s_Update_Required_Reminder_Emails_Sent_to_Company</name>
