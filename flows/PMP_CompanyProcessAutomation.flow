    <description>Company Process Automation</description>
    <environments>Default</environments>
    <formulas>
        <description>This formula is used verify whether Approved and published Email could be sent to partners</description>
        <name>Formula_Approved_and_Published_Email</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c},&apos;Approved&apos;)  &amp;&amp; NOT(ISNEW() ) &amp;&amp; ISCHANGED({!$Record.PMP_Company_Lifecycle_Status_Nm__c})</expression>
    </formulas>
    <formulas>
        <description>This formula is used to verify whether to send enhanced benefit email</description>
        <name>Formula_Enhanced_Benefit_Email</name>
        <dataType>Boolean</dataType>
        <expression>(ISNEW() &amp;&amp; ISPICKVAL({!$Record.PMP_Partner_Benefit_Type__c} , &apos;Solutions Marketplace Enhanced&apos;)||ISPICKVAL({!$Record.PMP_Partner_Benefit_Type__c} , &apos;Solutions Marketplace Enhanced&apos;) ) &amp;&amp; {!$Record.PMP_Is_Working_Copy_Ind__c} = true</expression>
    </formulas>
    <formulas>
        <description>This formula is used to pass input parameter to the new company info email apex class</description>
        <name>Formula_Input_for_New_Company_Info_Mail</name>
        <dataType>String</dataType>
        <expression>{!$Record.PMP_Published_Copy_Id__c} +&quot;|&quot; + &quot;New_CompanyInfo_CreationEmail&quot;</expression>
    </formulas>
    <formulas>
        <description>This formula is used for passing input parameter for enhanced benefit email</description>
        <name>Formula_Input_parameter_Enhanced_Benefit_Email</name>
        <dataType>String</dataType>
        <expression>{!$Record.Id} +&quot;|&quot; + &quot;Email_For_Create_Offering&quot;</expression>
    </formulas>
    <formulas>
        <description>This formula is used to verify and send an email if intel admin is changed for the partner</description>
        <name>Formula_Intel_Admin_Changed_Email</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c},&apos;Admin Review&apos;) &amp;&amp; ISCHANGED({!$Record.PMP_Intel_Admin_Id__c}) &amp;&amp; NOT(ISNEW() )
 &amp;&amp; ISCHANGED({!$Record.PMP_Company_Lifecycle_Status_Nm__c})</expression>
    </formulas>
    <formulas>
        <description>This formula is used to update last updated date of storefront details.</description>
        <name>Formula_Last_Update_Date_Strorefront</name>
        <dataType>Boolean</dataType>
        <expression>OR(AND(ISCHANGED( {!$Record.PMP_Company_Lifecycle_Status_Nm__c}), ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c}, &apos;Admin Review&apos;)), AND(ISCHANGED( {!$Record.PMP_Company_Lifecycle_Status_Nm__c}),ISPICKVAL( {!$Record.PMP_Company_Lifecycle_Status_Nm__c}, &apos;Published&apos;),NOT(ISBLANK({!$Record.PMP_Working_Copy_Id__c}))))</expression>
    </formulas>
    <formulas>
        <description>This Formula is used to verify whether to send new company information email</description>
        <name>Formula_New_Company_Information_Email</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() &amp;&amp; ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c}, &apos;Draft&apos;)  &amp;&amp; {!$Record.PMP_Is_Working_Copy_Ind__c} = true</expression>
    </formulas>
    <formulas>
        <description>This Formula is used to verify whether to send Non English resubmit email</description>
        <name>Formula_Non_English_Resubmit</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c},&apos;Admin Review&apos;), NOT(ISNEW()) )  &amp;&amp;({!$Record.PMP_Is_Updated_Ind__c} = True)
 &amp;&amp; ISCHANGED({!$Record.PMP_Company_Lifecycle_Status_Nm__c})
&amp;&amp; NOT(ISPICKVAL({!$Record.PMP_Company_Information_Language_Nm__c} , &apos;English&apos;)  )</expression>
    </formulas>
    <formulas>
        <description>This formula is used to verify the Non-english Storefront changes which will be used to verify whether to send an email to IntelAdmin</description>
        <name>Formula_Non_English_Storefront_Changes</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c} ,  &apos;Admin Review&apos;), NOT(ISNEW()) )  
 &amp;&amp;({!$Record.PMP_Is_Updated_Ind__c} = False)
 &amp;&amp; ISCHANGED({!$Record.PMP_Company_Lifecycle_Status_Nm__c}) 
&amp;&amp;NOT(ISPICKVAL({!$Record.PMP_Company_Information_Language_Nm__c} , &apos;English&apos;) )</expression>
    </formulas>
    <formulas>
        <description>This formula to verify if opid sfid in sync iwth opid sfid ref</description>
        <name>Formula_Opid_Sfid_Sync</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.PMP_Opid_Sfid_Txt__c} = {!$Record.PMP_Opid_Sfid_Ref_Txt__c}</expression>
    </formulas>
    <formulas>
        <description>This Formula is used to verify whether to send partner rejected email</description>
        <name>Formula_Rejected_Email_To_Partner</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c},&apos;Rejected&apos;)  &amp;&amp; NOT(ISNEW() ) &amp;&amp; ISCHANGED({!$Record.PMP_Company_Lifecycle_Status_Nm__c})</expression>
    </formulas>
    <formulas>
        <description>This formula is used to verifty whether to send resubmit Email for the partner</description>
        <name>Formula_Resubmit_Email</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c} ,  &apos;Admin Review&apos;), NOT(ISNEW()) )  &amp;&amp;({!$Record.PMP_Is_Updated_Ind__c} = True)
 &amp;&amp; ISCHANGED({!$Record.PMP_Company_Lifecycle_Status_Nm__c}) 
 &amp;&amp;ISPICKVAL({!$Record.PMP_Company_Information_Language_Nm__c}, &apos;English&apos;)</expression>
    </formulas>
    <formulas>
        <description>This formula is used to verify whether to send translation approved email</description>
        <name>Formula_Translation_Approved_Email</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c},&apos;Approved&apos;)  &amp;&amp; NOT(ISNEW() ) &amp;&amp; ISCHANGED({!$Record.PMP_Company_Lifecycle_Status_Nm__c}) &amp;&amp; INCLUDES({!$Record.PMP_Partner_Segment_Nm__c},&apos;Internet of Things and Embedded&apos;)</expression>
    </formulas>
    <formulas>
        <description>This formula is used to Verify If Partner Status is Update Required to send partner Edit email</description>
        <name>Formula_Update_Required_Email</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c},&apos;Update Required&apos;)  &amp;&amp; NOT(ISNEW() )   &amp;&amp; ISCHANGED({!$Record.PMP_Company_Lifecycle_Status_Nm__c})</expression>
    </formulas>
    <formulas>
        <description>Formula to verify and Send Admin Review Email to intel Admin If all the following conditions met:
		i) PMP_Company_Lifecycle_Status_Nm__c is &apos;Admin Review&apos; andPMP_Company_Lifecycle_Status_Nm__c is changed
		ii) Not a new record
		iii) PMP_Is_Updated_Ind__c is false, i.e Not benefit revoked
		iv) PMP_Company_Information_Language_Nm__c is &apos;English&apos;</description>
        <name>FormulaSendAdminReviewEmailIntelAdmin</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISPICKVAL({!$Record.PMP_Company_Lifecycle_Status_Nm__c},  &apos;Admin Review&apos;), NOT(ISNEW()))  
 &amp;&amp;({!$Record.PMP_Is_Updated_Ind__c} = False)
 &amp;&amp; ISCHANGED({!$Record.PMP_Company_Lifecycle_Status_Nm__c}) 
 &amp;&amp;ISPICKVAL({!$Record.PMP_Company_Information_Language_Nm__c}, &apos;English&apos;)</expression>
    </formulas>
    <formulas>
        <name>Test_Formula_Last_Updated_Date_Storefront</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.PMP_Last_Updated_Date_Dt__c} = Today()</expression>
    </formulas>
    <formulas>
        <name>Test_Formula_published_Storefront_Date</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.PMP_Company_Status_Published_Date_Dt__c} = Today()</expression>
    </formulas>
    <interviewLabel>PMP_CompanyProcessAutomation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMP_CompanyProcessAutomation</label>
