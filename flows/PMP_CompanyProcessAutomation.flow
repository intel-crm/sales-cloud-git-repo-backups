    <decisions>
        <description>This decision is used to Verify If Intel Admin is changed for Partner and then send email</description>
        <name>Verfiy_If_Intel_Admin_is_changed_for_Partner</name>
        <label>Verify If Intel Admin is changed for Partner</label>
        <locationX>182</locationX>
        <locationY>2448</locationY>
        <defaultConnector>
            <targetReference>Verify_If_Update_Required_to_send_partner_Edit_email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Dont send Email and Continue</defaultConnectorLabel>
        <rules>
            <name>Send_Email_When_Intel_Admin_is_changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Formula_Intel_Admin_Changed_Email</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Last_Status_Update_Date_0_0</targetReference>
            </connector>
            <label>Send Email When Intel Admin is changed</label>
        </rules>
    </decisions>
    <decisions>
        <description>Send Email to intel Admin If all the following conditions met:
		i) PMP_Company_Lifecycle_Status_Nm__c is &apos;Admin Review&apos; and PMP_Company_Lifecycle_Status_Nm__c is changed
		ii) Not a new record
		iii) PMP_Is_Updated_Ind__c is false, i.e Not benefit revoked
		iv) PMP_Company_Information_Language_Nm__c is &apos;English&apos;</description>
        <name>Verify_Admin_Review_Email_can_be_sent_to_Intel_Admin</name>
        <label>Verify Admin Review Email can be sent to Intel Admin</label>
        <locationX>182</locationX>
        <locationY>1296</locationY>
        <defaultConnector>
            <targetReference>Verify_to_send_Email_for_any_Non_English_Storefront_changes_to_Intel_Admin</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Dont Send Email,Continue</defaultConnectorLabel>
        <rules>
            <name>Send_Admin_Review_Email_to_Intel_Admin</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FormulaSendAdminReviewEmailIntelAdmin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
