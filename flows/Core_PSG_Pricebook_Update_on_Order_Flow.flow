    <decisions>
        <name>PriceBook_update_on_order_when_quote_is_added</name>
        <label>PriceBook update on order when quote is added</label>
        <locationX>182</locationX>
        <locationY>1007</locationY>
        <defaultConnector>
            <targetReference>Activate_For_Non_Commercial_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FalseCondition3</defaultConnectorLabel>
        <rules>
            <name>TrueCondition3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.core_cpq_active_cb__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.SBQQ__Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.AccountId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.SBQQ__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Activated</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricebook2Id</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SBQQ__Quote__r.SBQQ__PriceBook__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OrderItemCount__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricebook_update</targetReference>
            </connector>
            <label>TrueCondition3</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CheckFormuala3</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!$Record.Sales_Retry_Count__c}) ,PRIORVALUE({!$Record.Sales_Retry_Count__c} ) =={!ResubmitToSapCount} ,
ISCHANGED({!$Record.Sales_status__c} ),ISPICKVAL({!$Record.Sales_status__c}, &apos;SAP Order Creation Failed&apos;) )</expression>
    </formulas>
    <formulas>
        <name>Criteria1Formula</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISPICKVAL({!$Record.Status}, &apos;Draft&apos; ),
NOT(ISBLANK({!$Record.Sales_End_Customer_Account__c})),
NOT(ISBLANK({!$Record.SBQQ__Quote__c})),
{!$Record.Sales_End_Customer_Account__r.ParentId}&lt;&gt;{!$Record.SBQQ__Quote__r.SBQQ__Account__c},
OR(ISNEW(),ISCHANGED({!$Record.Sales_End_Customer_Account__c}),ISCHANGED({!$Record.SBQQ__Quote__c})))</expression>
    </formulas>
    <formulas>
        <name>CriteriaFormula3</name>
        <dataType>Boolean</dataType>
        <expression>AND (
         OR
             ( 
              AND( 
                       ISNEW() , 
                       NOT(ISBLANK({!$Record.Sales_Contract_Id__c} ))
               ),
               ISBLANK(PRIORVALUE({!$Record.Sales_Contract_Id__c}))
          ),
          ISPICKVAL({!$Record.Type}, &apos;Non Commercial Order&apos;) ,
          ISPICKVAL({!$Record.Status}, &apos;Activated&apos;),
          ISPICKVAL({!$Record.Sales_Order_Sub_Type__c} , &apos;Corporate Order&apos;),
          ISPICKVAL({!$Record.Sales_Contract_Id__r.Status}, &apos;Draft&apos;)
 )</expression>
    </formulas>
    <formulas>
        <name>CriteriaFormula4</name>
        <dataType>Boolean</dataType>
        <expression>AND(
        ISCHANGED({!$Record.SBQQ__Quote__c} ),
        NOT(ISBLANK({!$Record.SBQQ__Quote__c}) ),
        ISPICKVAL({!$Record.SBQQ__Quote__r.SBQQ__Type__c} , &apos;Amendment&apos;),
        NOT(ISBLANK({!$Record.SBQQ__Quote__r.SBQQ__MasterContract__c})),
        ISPICKVAL({!$Record.SBQQ__Quote__r.Pricing_Quote_Program_Nm__c} , &apos;PSG&apos;)
)</expression>
    </formulas>
    <formulas>
        <name>CriteriaFormula5</name>
        <dataType>Boolean</dataType>
        <expression>AND(
        ISCHANGED({!$Record.SBQQ__Quote__c} ),
        NOT(ISBLANK({!$Record.SBQQ__Quote__c} ) ),
        NOT(ISPICKVAL({!$Record.SBQQ__Quote__r.SBQQ__Type__c} , &apos;Amendment&apos;)),
        ISPICKVAL({!$Record.SBQQ__Quote__r.Pricing_Quote_Program_Nm__c} , &apos;PSG&apos;),
        NOT(ISBLANK({!$Record.Sales_Amend_Contract__c} ))
)</expression>
    </formulas>
    <formulas>
        <name>nullValue</name>
        <dataType>String</dataType>
        <expression>NULL</expression>
    </formulas>
