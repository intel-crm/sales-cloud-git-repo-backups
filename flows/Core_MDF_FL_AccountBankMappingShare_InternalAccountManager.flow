<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_MDF_if_vGroupId_is_NOT_NULL_Decision</name>
        <label>if vGroupId is NOT NULL Decision</label>
        <locationX>521</locationX>
        <locationY>141</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_if_vGroupId_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vGroupId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Create_Account_Bank_Mapping_Share</targetReference>
            </connector>
            <label>if vGroupId is NOT NULL</label>
        </rules>
    </decisions>
    <description>This will share the Account Bank Mapping records with the corresponding Internal Account Managers.</description>
    <interviewLabel>Core_MDF_FL_AccountBankMappingShare_InternalAccountManager {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_FL_AccountBankMappingShare_InternalAccountManager</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Create_Account_Bank_Mapping_Share</name>
        <label>Create Account Bank Mapping Share</label>
        <locationX>522</locationX>
        <locationY>277</locationY>
        <inputAssignments>
            <field>AccessLevel</field>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>vAccountBankMappingRecordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UserOrGroupId</field>
            <value>
                <elementReference>vGroupId</elementReference>
            </value>
        </inputAssignments>
        <object>Core_MDF_Account_Bank_Mapping__Share</object>
    </recordCreates>
    <recordLookups>
        <name>Core_MDF_Fetch_the_Group_Id</name>
        <label>Fetch the Group Id</label>
        <locationX>343</locationX>
        <locationY>141</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_if_vGroupId_is_NOT_NULL_Decision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vIntelAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vChannelProgramId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Group_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Partner_Group_Mapping__c</object>
        <outputAssignments>
            <assignToReference>vGroupId</assignToReference>
            <field>Core_MDF_Group_Id__c</field>
        </outputAssignments>
    </recordLookups>
    <startElementReference>Core_MDF_Fetch_the_Group_Id</startElementReference>
    <status>Active</status>
    <variables>
        <description>This will contain the Record Id of the Account Bank Mapping record.</description>
        <name>vAccountBankMappingRecordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <description>This will contain the Record Id of the Channel Program field from the Account field of the Account Bank Mapping record.</description>
        <name>vChannelProgramId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <description>This will contain the Group Id of the Internal Account Managers that the Account Bank Mapping records will be shared with.</description>
        <name>vGroupId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <description>This will contain the Record Id of the Intel Account from Bank field of the Account Bank Mapping record.</description>
        <name>vIntelAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
</Flow>
