    <decisions>
        <name>On_Getting_Duplicate_Lead_or_Contact</name>
        <label>On Getting Duplicate Lead or Contact</label>
        <locationX>1458</locationX>
        <locationY>611</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Contact_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Duplicate_Contacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count</targetReference>
            </connector>
            <label>Duplicate Contact found</label>
        </rules>
        <rules>
            <name>Duplicate_Terminated_Lead_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Duplicate_Terminated_Leads</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count_Terminated_Leads</targetReference>
            </connector>
            <label>Duplicate Terminated Lead found</label>
        </rules>
        <rules>
            <name>Duplicate_Lead_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Duplicate_Leads</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count_Duplicate_Leads</targetReference>
            </connector>
            <label>Duplicate Lead found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Contact_Record_URL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;.com&quot;, {!$Api.Partner_Server_URL_540}) + 3) &amp; &quot;/&quot;</expression>
    </formulas>
    <formulas>
        <name>Lead_Record_URL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;.com&quot;, {!$Api.Partner_Server_URL_540}) + 3) &amp; &quot;/&quot;</expression>
    </formulas>
    <formulas>
        <name>Terminated_Lead_URL</name>
