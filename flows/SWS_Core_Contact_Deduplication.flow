    <decisions>
        <name>Duplicate_Lead_records_greater_than_1</name>
        <label>Duplicate  Lead records greater than 1</label>
        <locationX>2074</locationX>
        <locationY>827</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Leads_Equals_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountNum</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_duplicate_Leads</targetReference>
            </connector>
            <label>Duplicate Leads Equals 1</label>
        </rules>
        <rules>
            <name>Duplicate_Leads_greater_than_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountNum</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message_for_leads</targetReference>
            </connector>
            <label>Duplicate Leads greater than 1</label>
        </rules>
    </decisions>
    <decisions>
        <name>Duplicate_records_greater_than_1</name>
