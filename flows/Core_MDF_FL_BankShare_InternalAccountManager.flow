<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_the_value_to_share_record</name>
        <label>Assign the value to share record</label>
        <locationX>1242</locationX>
        <locationY>749</locationY>
        <assignmentItems>
            <assignToReference>sBankShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>vBankRecordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sBankShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>sPGM.Core_MDF_Group_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sBankShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Insert_all_the_bank_share_record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Get the CCF Program Name from the metadata record.</description>
        <name>Core_MDF_Get_CCF_Program_Name</name>
        <label>Get CCF Program Name</label>
