    <assignments>
        <name>Insert_all_the_bank_share_record</name>
        <label>Insert all the bank share record</label>
        <locationX>1240</locationX>
        <locationY>902</locationY>
        <assignmentItems>
            <assignToReference>sCollBankShareInsertList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>sBankShareTemp</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Empty_the_temp_variable</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>We are verifying if the Account has been updated for the Bank. We are also checking if the ids from the Account and Bank are NULL.</description>
        <name>Core_MDF_Account_is_changed</name>
        <label>Account is changed</label>
        <locationX>42</locationX>
        <locationY>630</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Account_Not_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankRecordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vAccountChangeFlagBln</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Check_For_BankProgram_Entitlement_Mapping_Metadata_1</targetReference>
            </connector>
            <label>Account Not Changed</label>
        </rules>
        <rules>
            <name>Core_MDF_Account_changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankRecordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vAccountChangeFlagBln</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_Bank_Share_Records</targetReference>
            </connector>
            <label>Account changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Align_Bank_Program_with_it_s_respective_values</name>
        <label>Align Bank Program with it&apos;s respective values</label>
        <locationX>461</locationX>
        <locationY>272</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Loop_Metadata</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_CCF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sChannelProgam_temp.Core_MDF_Bank_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>vCCFBankProgram</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Get_CCF_Program_Name</targetReference>
            </connector>
            <label>CCF</label>
        </rules>
        <rules>
            <name>Core_MDF_DCF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sChannelProgam_temp.Core_MDF_Bank_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>vDCFBankProgram</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Get_DCF_Program_Name</targetReference>
            </connector>
            <label>DCF</label>
        </rules>
        <rules>
            <name>Core_MDF_SPCF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sChannelProgam_temp.Core_MDF_Bank_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>vSPCFBankProgram</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Get_SPCF_Program_Name</targetReference>
            </connector>
            <label>SPCF</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_BankShare_NOT_EMPTY</name>
        <label>BankShare List NOT EMPTY</label>
        <locationX>957</locationX>
        <locationY>609</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Check_if_bank_share_record_to_be_inserted_is_empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollBankShareInsertList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Insert_Bank_Share_to_Internal_Account_Manager</targetReference>
            </connector>
            <label>Check if bank share record to be inserted is empty</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if Bank Share Records are already created.</description>
        <name>Core_MDF_Check_if_Existing_Bank_Share_Records_present</name>
        <label>Check if Existing Bank Share Records present</label>
        <locationX>289</locationX>
        <locationY>875</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_BankShare_Records_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollBankShareListToBeDeleted</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Delete_Bank_Share_List</targetReference>
            </connector>
            <label>BankShare Records Present</label>
        </rules>
        <rules>
            <name>Core_MDF_No_BankShare_Records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollBankShareListToBeDeleted</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Check_For_BankProgram_Entitlement_Mapping_Metadata_1</targetReference>
            </connector>
            <label>No BankShare Records</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_PGM_NOT_NULL_DECISION</name>
        <label>PGM NOT NULL</label>
        <locationX>653</locationX>
        <locationY>750</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_PGM_NOT_NULL_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollPGMList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_throiuph_PGM_List</targetReference>
            </connector>
            <label>PGM NOT NULL</label>
        </rules>
    </decisions>
    <description>Share bank records to Internal Account Managers based on program.</description>
    <formulas>
        <name>fBankProgramIdLength</name>
        <dataType>Number</dataType>
        <expression>LEN({!vBankProgramId})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Formula containing CCF Channel Program Id</description>
        <name>fCCFProgramId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_CCF_Channel_Program_Id}</expression>
    </formulas>
    <formulas>
        <description>Formula containing DCF Channel Program Id</description>
        <name>fDCFProgramId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_DCF_Channel_Program_Id}</expression>
    </formulas>
    <formulas>
        <description>Formula containing SPCF Channel Program Id</description>
        <name>fSPCFProgramId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_SPCF_Channel_Program_Id}</expression>
    </formulas>
    <interviewLabel>Core_MDF_FL_BankShare_InternalAccountManager {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_FL_BankShare_InternalAccountManager</label>
    <loops>
        <description>Loop through sCollChannelProgramNames  List</description>
        <name>Core_MDF_Loop_Metadata</name>
        <label>Loop Metadata</label>
        <locationX>469</locationX>
        <locationY>629</locationY>
        <assignNextValueToReference>sChannelProgam_temp</assignNextValueToReference>
        <collectionReference>sCollChannelProgramNames</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_MDF_Align_Bank_Program_with_it_s_respective_values</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_MDF_Fetch_PGM</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_throiuph_PGM_List</name>
        <label>Loop through PGM List</label>
        <locationX>967</locationX>
        <locationY>750</locationY>
        <assignNextValueToReference>sPGM</assignNextValueToReference>
        <collectionReference>sCollPGMList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_the_value_to_share_record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_MDF_BankShare_NOT_EMPTY</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Insert_Bank_Share_to_Internal_Account_Manager</name>
        <label>Insert Bank Share to Internal Account Manager</label>
        <locationX>1214</locationX>
        <locationY>607</locationY>
        <inputReference>sCollBankShareInsertList</inputReference>
    </recordCreates>
    <recordDeletes>
        <description>Delete the Existing Bank Share Records</description>
        <name>Core_MDF_Delete_Bank_Share_List</name>
        <label>Delete Bank Share List</label>
        <locationX>412</locationX>
        <locationY>765</locationY>
        <connector>
            <targetReference>Core_MDF_Check_For_BankProgram_Entitlement_Mapping_Metadata_1</targetReference>
        </connector>
        <inputReference>sCollBankShareListToBeDeleted</inputReference>
    </recordDeletes>
    <recordLookups>
        <description>Fetch all the records of the BankProgram Entitlement Mapping metadata.</description>
        <name>Core_MDF_Check_For_BankProgram_Entitlement_Mapping_Metadata_1</name>
        <label>Fetch BankProgram Metadata</label>
        <locationX>308</locationX>
        <locationY>629</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Loop_Metadata</targetReference>
        </connector>
        <object>Core_MDF_BankProgram_Entitlement_Mapping__mdt</object>
        <outputReference>sCollChannelProgramNames</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Channel_Program__c</queriedFields>
        <queriedFields>Core_MDF_Bank_Program_Name__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>Fetch all the existing Bank Share records with &quot;Manual&quot; Rowcause.</description>
        <name>Core_MDF_Fetch_Bank_Share_Records</name>
        <label>Fetch Bank Share Records</label>
        <locationX>50</locationX>
        <locationY>872</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Check_if_Existing_Bank_Share_Records_present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vBankRecordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>RowCause</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Manual</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Bank__Share</object>
        <outputReference>sCollBankShareListToBeDeleted</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>Fetch all the PGM records with the help of Account, Program(s) and Internal Type.</description>
        <name>Core_MDF_Fetch_PGM</name>
        <label>Fetch PGM</label>
        <locationX>662</locationX>
        <locationY>637</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_PGM_NOT_NULL_DECISION</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4) AND 5 AND 6</filterLogic>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vCCFChannelProgramId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vDCFChannelProgramId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vSPCFChannelProgramId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Group_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Partner_Group_Mapping__c</object>
        <outputReference>sCollPGMList</outputReference>
        <queriedFields>Core_MDF_Group_Id__c</queriedFields>
    </recordLookups>
    <startElementReference>Core_MDF_Account_is_changed</startElementReference>
    <status>Obsolete</status>
