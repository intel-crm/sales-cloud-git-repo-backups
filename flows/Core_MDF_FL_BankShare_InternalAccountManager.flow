            <value>
                <elementReference>fSPCFProgramId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_Metadata</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Empty_the_temp_variable</name>
        <label>Empty the temp variable</label>
        <locationX>967</locationX>
        <locationY>902</locationY>
        <assignmentItems>
            <assignToReference>sBankShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sBankShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sBankShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_throiuph_PGM_List</targetReference>
        </connector>
