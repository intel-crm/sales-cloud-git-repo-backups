<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>first_Performance_metric_record</name>
        <label>first Performance metric record</label>
        <locationX>264</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>SinglePerformanceMetricRecord.Pricing_Quote_Line__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>quoteLineId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SinglePerformanceMetricRecord.Pricing_Comp_SKU_Performance_Nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loop_performance_metrics.Comp_Score</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SinglePerformanceMetricRecord.Pricing_Intel_SKU_Performance_Nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loop_performance_metrics.Intel_Score</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SinglePerformanceMetricRecord.Pricing_Weighting_Pct__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loop_performance_metrics.Weighting</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SinglePerformanceMetricRecord.Pricing_Other_Nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loop_performance_metrics.Other_Text</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Single_Performance_Metric_to_List</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Single_Performance_Metric_to_List</name>
        <label>Single Performance Metric to List</label>
        <locationX>264</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>listOfPerformaceMetrics</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>SinglePerformanceMetricRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loop_performance_metrics</targetReference>
        </connector>
    </assignments>
    <dynamicChoiceSets>
        <name>PerformanceMetricsUsed</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Pricing_Performance_Metric_Nm__c</picklistField>
        <picklistObject>Pricing_Performance_Metric__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Performance Metrics Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Performance Metrics Create</label>
    <loops>
        <name>loop_performance_metrics</name>
        <label>loop performance metrics</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <collectionReference>Repeater.AllItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>first_Performance_metric_record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Performance_Metric_record</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Performance_Metric_record</name>
        <label>Create Performance Metric record</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <inputReference>listOfPerformaceMetrics</inputReference>
    </recordCreates>
    <screens>
        <name>Performance_MetricScreen</name>
        <label>Performance Metric</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>loop_performance_metrics</targetReference>
        </connector>
        <fields>
            <name>Repeater</name>
            <fieldType>Repeater</fieldType>
            <fields>
                <name>Performance_Metrics_Used</name>
                <choiceReferences>PerformanceMetricsUsed</choiceReferences>
                <dataType>String</dataType>
                <fieldText>Performance Metrics Used</fieldText>
                <fieldType>DropdownBox</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>true</isRequired>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
            </fields>
            <fields>
                <name>Weighting</name>
                <dataType>Number</dataType>
                <fieldText>Weighting(%)</fieldText>
                <fieldType>InputField</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>false</isRequired>
                <scale>0</scale>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
                <validationRule>
                    <errorMessage>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 12px; color: rgb(186, 5, 23);&quot;&gt;Value must be between 1 and 100&lt;/span&gt;&lt;/p&gt;</errorMessage>
                    <formulaExpression>{!Repeater.AllItems[$EachItem].Weighting}&gt; 0 &amp;&amp; {!Repeater.AllItems[$EachItem].Weighting}&lt; 101</formulaExpression>
                </validationRule>
            </fields>
            <fields>
                <name>Intel_Score</name>
                <dataType>Number</dataType>
                <fieldText>Intel Score</fieldText>
                <fieldType>InputField</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>true</isRequired>
                <scale>0</scale>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
                <validationRule>
                    <errorMessage>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 12px; color: rgb(186, 5, 23);&quot;&gt;Value must be greater than 0&lt;/span&gt;&lt;/p&gt;</errorMessage>
                    <formulaExpression>{!Repeater.AllItems[$EachItem].Intel_Score} &gt; 0</formulaExpression>
                </validationRule>
            </fields>
            <fields>
                <name>Comp_Score</name>
                <dataType>Number</dataType>
                <fieldText>Comp Score</fieldText>
                <fieldType>InputField</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>true</isRequired>
                <scale>0</scale>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
                <validationRule>
                    <errorMessage>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 12px; color: rgb(186, 5, 23);&quot;&gt;Value must be greater than 0&lt;/span&gt;&lt;/p&gt;</errorMessage>
                    <formulaExpression>{!Repeater.AllItems[$EachItem].Comp_Score}&gt; 0</formulaExpression>
                </validationRule>
            </fields>
            <fields>
                <name>Other_Text</name>
                <dataType>String</dataType>
                <fieldText>Other Text</fieldText>
                <fieldType>InputField</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>false</isRequired>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
                <visibilityRule>
                    <conditionLogic>1</conditionLogic>
                    <conditions>
                        <leftValueReference>Repeater.AllItems[$EachItem].Performance_Metrics_Used</leftValueReference>
                        <operator>EqualTo</operator>
                        <rightValue>
                            <stringValue>Other</stringValue>
                        </rightValue>
                    </conditions>
                </visibilityRule>
            </fields>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Save</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Performance_MetricScreen</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>listOfPerformaceMetrics</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Pricing_Performance_Metric__c</objectType>
    </variables>
    <variables>
        <name>quoteLineId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>SinglePerformanceMetricRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Pricing_Performance_Metric__c</objectType>
    </variables>
</Flow>
