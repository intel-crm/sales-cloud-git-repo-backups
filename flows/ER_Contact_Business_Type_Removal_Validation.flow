<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Ent_with_Same_BT_to_List</name>
        <label>Assign Ent with Same BT to List</label>
        <locationX>270</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>entListWithSameBT</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Ent_Matrix_Records.PRM_Entitlement_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Ent_Matrix_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_CBT_Back_to_Approved</name>
        <label>Update CBT Back to Approved</label>
        <locationX>50</locationX>
        <locationY>911</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Validate_Ent_with_Same_BT</name>
        <label>Validate Ent with Same BT</label>
        <locationX>182</locationX>
        <locationY>803</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Ent_Exist_with_same_BT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_existing_Contact_Entitlements_With_Same_BT</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_CBT_Back_to_Approved</targetReference>
            </connector>
            <label>Ent Exist with same BT</label>
        </rules>
    </decisions>
    <description>This flow is triggered when entitlement is removed from a contact to validate CBT removal</description>
    <environments>Default</environments>
    <interviewLabel>Contact Business Type Removal Validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Business Type Removal Validation</label>
    <loops>
        <name>Loop_Through_Ent_Matrix_Records</name>
        <label>Loop Through Ent Matrix Records</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <collectionReference>Get_Ent_Matrix_with_Same_BT</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Ent_with_Same_BT_to_List</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_existing_Contact_Entitlements_With_Same_BT</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Ent_Matrix_with_Same_BT</name>
        <label>Get Ent Matrix with Same BT</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Ent_Matrix_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Business_Types__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Business_Types__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PRM_VXEnttlmntMatrix__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_existing_Contact_Entitlements_With_Same_BT</name>
        <label>Get existing Contact Entitlements With Same BT</label>
        <locationX>182</locationX>
        <locationY>695</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Validate_Ent_with_Same_BT</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Contact_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Contact__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Complete</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Selected__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Entitlement_Id__c</field>
            <operator>In</operator>
            <value>
                <elementReference>entListWithSameBT</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Contact_Entitlement__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Ent_Matrix_with_Same_BT</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Rejection - Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </filters>
        <object>Contact_Business_Types__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>entitlementExistWithBT</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>entListWithSameBT</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
