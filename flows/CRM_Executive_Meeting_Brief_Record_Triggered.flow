<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Email</name>
        <label>Send Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Create_Log_Record</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Error_Log_Record</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipientAddresses</name>
            <value>
                <collectionElements>
                    <elementReference>$Record.CRM_Brief_Reviewer__r.Email</elementReference>
                </collectionElements>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>wsm-postmaster@intel.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>useEmailTemplate</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailTemplateId</name>
            <value>
                <elementReference>Get_Ready_for_Review_Email_Template.Id</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>attachmentId</name>
            <value>
                <elementReference>attachmentId</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientId</name>
            <value>
                <elementReference>$Record.CRM_Brief_Reviewer__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>relatedRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>logEmailOnSend</name>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>2.0.1</versionString>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Account_Restricted_Error</name>
        <label>Assign Account Restricted Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AccountRestrictedErrorMsg</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account_Error_Custom_Label.Value__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Restricted_account</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_AttachmentId</name>
        <label>Assign AttachmentId</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>attachmentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Content_Document.LatestPublishedVersionId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Ready_for_Review_Email_Template</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Content_Document_Id</name>
        <label>Assign Content Document Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>contentDocIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_Content_Document_Link.ContentDocumentId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_Content_Document_Link</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Restricted_account</name>
        <label>Restricted account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>If_Brief_Status_is_Ready_for_Review</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>{!AccountRestrictedErrorMsg}</errorMessage>
            <fieldSelection>Account__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_Account_Field</name>
        <label>Check Account Field</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>If_Brief_Status_is_Ready_for_Review</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_field_populated</name>
            <conditionLogic>(1 OR 3 OR 4) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CRM_New_Executive_Meeting_Brief</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_CRM_Label_Custom_Setting</targetReference>
            </connector>
            <label>Account field populated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Account_Id_Allowed</name>
        <label>Check if Account Id Allowed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Account_Error_Custom_Label</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Account Id not allowed</defaultConnectorLabel>
        <rules>
            <name>Account_Id_Allowed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_CRM_Label_Custom_Setting.Value__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Account__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_CRM_Label_Custom_Setting.Value__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>All Accounts</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_Brief_Status_is_Ready_for_Review</targetReference>
            </connector>
            <label>Account Id Allowed</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Brief_Status_is_Ready_for_Review</name>
        <label>If Brief Status is Ready for Review</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_is_Ready_for_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Brief_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ready for Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CRM_New_Executive_Meeting_BrieF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Brief_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Content_Document_Link</targetReference>
            </connector>
            <label>Status is Ready for Review</label>
        </rules>
    </decisions>
    <description>Executive Meeting Brief Record Triggered Flow for New Executive Meeting Brief Record Type
Check if Account is allowed for New Executive Meeting Brief POC
Send Email on Ready for Review Status to Brief Reviewer</description>
    <environments>Default</environments>
    <interviewLabel>Executive Meeting Brief Record {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Executive Meeting Brief Record Triggered</label>
    <loops>
        <name>Loop_through_Content_Document_Link</name>
        <label>Loop through Content Document Link</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Content_Document_Link</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Content_Document_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Content_Document</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
