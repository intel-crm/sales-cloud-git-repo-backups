<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Core_OppProd_Claim_Date_Clear {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_OppProd_Claim_Date_Clear</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Claim_date_to_null</name>
        <label>Update Claim date to null</label>
        <locationX>504</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>Core_Claim_Date__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>401</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Update_Claim_date_to_null</targetReference>
        </connector>
        <filterFormula>OR(
AND ( 
ISNEW(),    NOT(ISNULL( {!$Record.Core_Claim_Date__c}  ))
)
,
OR (
    ISPICKVAL(  {!$Record.Core_Status__c}  , &apos;Pending&apos;),
    ISPICKVAL(  {!$Record.Core_Status__c}  ,&apos;On Hold&apos;)
) 

)</filterFormula>
        <object>OpportunityLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
