    <decisions>
        <name>Check_Escalation_Type</name>
        <label>Check Escalation Type</label>
        <locationX>1033</locationX>
        <locationY>231</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Claim_Case_Review_Result_Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Escalation_Record.Core_MDF_Escalation_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Case_Escalation_Type</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Cancellation_Message_Claim_Case_Review_Result</targetReference>
            </connector>
            <label>Claim Case Review Result Check</label>
        </rules>
        <rules>
            <name>Late_Claim_Esc_Type_Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Escalation_Record.Core_MDF_Escalation_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Escalation_Status_Type</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Claim_Records</targetReference>
            </connector>
            <label>Late Claim Check</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_whether_Active_Claims_are_Present</name>
        <label>Check whether Active Claims are Present</label>
        <locationX>386</locationX>
        <locationY>500</locationY>
        <defaultConnector>
            <targetReference>Display_Cancel_Confirmation_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Active Claims Exist</defaultConnectorLabel>
        <rules>
            <name>Active_Claims_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Claim_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Error_Message</targetReference>
            </connector>
            <label>Active Claims Exist</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CheckIssueDescription</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Escalation_Record.Core_MDF_Claim_Number_id__c}), {!Get_Escalation_Record.Core_MDF_Issue_Description_txt__c} +BR() + &apos;Note: &apos; +TEXT(MONTH({!$Flow.CurrentDate}))+ &quot;/&quot; + TEXT(DAY({!$Flow.CurrentDate}))+ &quot;/&quot; + TEXT(YEAR({!$Flow.CurrentDate})) + &apos;  &apos; + &apos;Escalation is cancelled.&apos;, {!Get_Escalation_Record.Core_MDF_Issue_Description_txt__c} +BR() + &apos;Note: &apos; +TEXT(MONTH({!$Flow.CurrentDate}))+ &quot;/&quot; + TEXT(DAY({!$Flow.CurrentDate}))+ &quot;/&quot; + TEXT(YEAR({!$Flow.CurrentDate})) + &apos;  &apos; + &apos;Escalation cancelled as associated claim was cancelled.&apos;)</expression>
    </formulas>
    <interviewLabel>Core_MDF_Cancel_Escalation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_CancelEscalation</label>
