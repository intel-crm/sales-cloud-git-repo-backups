    <recordLookups>
        <description>Fetch Related Account Record</description>
        <name>Get_Associated_Account</name>
        <label>Get Associated Account</label>
        <locationX>1370</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Account_Record_Presence</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_For_Get_Parent_Account</targetReference>
        </faultConnector>
        <filterLogic>1 And (2 OR 3)</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Account_Id__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Inactive Account</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Fetch All Compliance Watch List Record associated with account</description>
        <name>Get_Compliance_Watch_List_Record</name>
        <label>Get Compliance Watch List Record</label>
        <locationX>1194</locationX>
        <locationY>755</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Over_the_compliance_record</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_for_Get_Compliance_Watch_List_Record</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Associated_Account.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Account_Compliance_Watch_List__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update the account ECB Field To True</description>
        <name>Check_Export_Compliance_Block</name>
        <label>Check Export Compliance Block</label>
        <locationX>50</locationX>
        <locationY>863</locationY>
        <faultConnector>
            <targetReference>Create_Log_Entry_For_Check_Export_Compliance_Block</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Account_Id__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Export_Compliance_Block_Reason__c</field>
            <value>
                <elementReference>$Label.UCD_ACM_Export_Compliance_Block_Reason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Export_Compliance_Block__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <name>UnCheck_Export_Compliance_Block</name>
        <label>UnCheck Export Compliance Block</label>
        <locationX>930</locationX>
        <locationY>1463</locationY>
        <faultConnector>
            <targetReference>Create_Log_Entry_for_Uncheck_Export_Compliance_Block</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Associated_Account.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Export_Compliance_Block_Reason__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Export_Compliance_Block__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>1816</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_IAO_Change_Switch</targetReference>
        </connector>
        <object>Core_Account_Compliance_Watch_List__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
