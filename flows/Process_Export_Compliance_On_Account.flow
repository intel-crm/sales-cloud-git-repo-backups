<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_All_Compliance_Watch_List_Have_End_Date_Variable_False</name>
        <label>Set All Compliance Watch List Have End Date Variable False</label>
        <locationX>1282</locationX>
        <locationY>1079</locationY>
        <assignmentItems>
            <assignToReference>All_Have_End_Date</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_the_compliance_record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check Account Export Compliance Block Is Set To False</description>
        <name>Check_Account_ECB_Is_Unchecked</name>
        <label>Check Account ECB Is Unchecked</label>
        <locationX>314</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_ECB_UnChecked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Associated_Account.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Export_Compliance_Block</targetReference>
            </connector>
            <label>Is ECB UnChecked</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Account_Record_Presence</name>
        <label>Check Account Record Presence</label>
        <locationX>1370</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Account_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Associated_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_For_Block_Codes</targetReference>
            </connector>
            <label>Is Account Available</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if End Date is Null For Blocked Code</description>
        <name>Check_End_Date_is_Null_For_Blocked_Code</name>
        <label>Check End Date is Null For Blocked Code</label>
        <locationX>1414</locationX>
        <locationY>971</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_the_compliance_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_End_Date_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_the_compliance_record.Core_Effective_End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsComplianceWatchListBlock</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_All_Compliance_Watch_List_Have_End_Date_Variable_False</targetReference>
            </connector>
            <label>Is End Date Null</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check For Compliance List Type is blocked one or not.</description>
        <name>Check_For_Block_Codes</name>
        <label>Check For Block Codes</label>
        <locationX>754</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Get_Compliance_Watch_List_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is Block Lifted</defaultConnectorLabel>
        <rules>
            <name>Has_Active_Blocked_Codes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Effective_End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsWatchListTypeBlock</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Account_ECB_Is_Unchecked</targetReference>
            </connector>
            <label>Has Active Blocked Codes</label>
        </rules>
    </decisions>
    <decisions>
        <description>IAO Change Switch is Enabled/Disabled</description>
        <name>Check_IAO_Change_Switch</name>
        <label>Check IAO Change Switch</label>
        <locationX>1942</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IS_IAO_Switch_Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Label.UCD_ACM_Switch_IAO_Change</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Associated_Account</targetReference>
            </connector>
            <label>IS IAO Switch Disabled</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if all block compliance record has end date and account Export Compliance Block is set to true</description>
        <name>Check_If_All_Compliance_Watch_List_Have_End_Date_And_Account_ECB_is_Checked</name>
        <label>Check If All Compliance Watch List Have End Date And Account ECB is Checked</label>
        <locationX>1194</locationX>
        <locationY>1355</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_End_Date_Present_And_ECB_Checked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>All_Have_End_Date</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Associated_Account.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UnCheck_Export_Compliance_Block</targetReference>
            </connector>
            <label>Is End Date Present And ECB Checked</label>
        </rules>
    </decisions>
    <description>This Flow updates the Account Export Compliance Block And Reason Field On Account Based on Compliance Code Is Blocked Or Not</description>
    <environments>Default</environments>
    <formulas>
        <name>IsComplianceWatchListBlock</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&apos;,&apos;+{!$Label.UCD_ACM_ExportComplianceBlock_Codes}+&apos;,&apos;, &apos;,&apos;+TEXT({!Loop_Over_the_compliance_record.Core_Type__c})+ &apos;,&apos;)</expression>
    </formulas>
    <formulas>
        <name>IsWatchListTypeBlock</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&apos;,&apos;+{!$Label.UCD_ACM_ExportComplianceBlock_Codes}+&apos;,&apos;, &apos;,&apos;+TEXT({!$Record.Core_Type__c})+ &apos;,&apos;)</expression>
    </formulas>
    <interviewLabel>Process Export Compliance On Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UCD ACM Process Export Compliance On Account</label>
    <loops>
        <name>Loop_Over_the_compliance_record</name>
        <label>Loop Over the compliance record</label>
        <locationX>1194</locationX>
        <locationY>863</locationY>
        <collectionReference>Get_Compliance_Watch_List_Record</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_End_Date_is_Null_For_Blocked_Code</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_If_All_Compliance_Watch_List_Have_End_Date_And_Account_ECB_is_Checked</targetReference>
        </noMoreValuesConnector>
    </loops>
