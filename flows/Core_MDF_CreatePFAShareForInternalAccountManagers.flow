    <decisions>
        <name>Core_MDF_Check_if_account_region_is_blank_or_not_AND_Intel_account_is_not_null</name>
        <label>Check if account region is blank or not AND Intel account is not null</label>
        <locationX>922</locationX>
        <locationY>174</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_GeoBased_Sharing_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsGeoBasedReq</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vIntelAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vIntelAccountId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_SubGeo</targetReference>
            </connector>
            <label>If GeoBased Sharing Required</label>
        </rules>
        <rules>
            <name>If_GeoBased_Sharing_Not_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsGeoBasedReq</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vIntelAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vIntelAccountId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_the_PGM_records_0</targetReference>
            </connector>
            <label>If GeoBased Sharing Not Required</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_vIntelAccountId_is_NOT_NULL</name>
        <label>Check if vIntelAccountId is NOT NULL</label>
        <locationX>555</locationX>
        <locationY>4</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_if_vIntelAccountId_is_NOT_NULL</name>
