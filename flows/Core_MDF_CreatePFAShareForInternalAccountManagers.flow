            <conditions>
                <leftValueReference>vIntelAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_GetMetadataRecords</targetReference>
            </connector>
            <label>if vIntelAccountId is NOT NULL</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_SubGeo_Check</name>
        <label>SubGeo Check</label>
        <locationX>1714</locationX>
        <locationY>166</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Fetch_the_PGM_records_when_account_region_is_NOT_blank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_SubGeo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimActivityAllocationRecordtypeMappingRecord.Core_MDF_Region_cd__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>vRegion</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_PGMCollection_List_with_SubRegion</targetReference>
            </connector>
            <label>If SubGeo</label>
        </rules>
    </decisions>
