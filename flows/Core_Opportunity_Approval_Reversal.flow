    <description>Reversal of Oppty from PC/PL to DW - Changes to update Prod Cancelled to Lost instead of Cancelled.
For Low Touch
Production Sales Price and Production Quantity on Product and Production Win amount on Opportunity should blank out when using the reverse button.</description>
    <environments>Default</environments>
    <formulas>
        <name>Blanking</name>
        <dataType>DateTime</dataType>
        <expression>null</expression>
    </formulas>
    <formulas>
        <name>Blankingcurrency</name>
        <dataType>Currency</dataType>
        <expression>null</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>byPassField</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!Get_Opportunity.Core_Bypass_Field_Validation__c})</expression>
    </formulas>
    <formulas>
        <name>fBypass</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!DW_Oppty_Prods.Core_BypassFlow__c})</expression>
    </formulas>
    <formulas>
        <name>LoggedInUserId</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!$User.Id})</expression>
    </formulas>
    <interviewLabel>Core {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Opportunity_Approval_Reversal</label>
