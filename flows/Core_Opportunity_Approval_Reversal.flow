        <locationX>6886</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Get_SAM_Manager_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Decision_15</name>
            <conditionLogic>(((1 AND 3) OR (2 AND 4) OR (1 AND 4) OR (2 AND 3)) AND 5)</conditionLogic>
            <conditions>
                <leftValueReference>Get_SAM_Manager_Records.User.ManagerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Approval_Data.LastActorId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_SAM_Manager_Records.User.Manager.DelegatedApproverId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Approval_Data.LastActorId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_SAM_Manager_Records.User.ManagerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>LoggedInUserId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_SAM_Manager_Records.User.Manager.DelegatedApproverId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>LoggedInUserId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SAM_Manager_Approved</targetReference>
            </connector>
            <label>SAM Manager Check True</label>
        </rules>
    </decisions>
