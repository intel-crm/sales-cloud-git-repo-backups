            </conditions>
            <conditions>
                <leftValueReference>PW_Oppty_Prods.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
