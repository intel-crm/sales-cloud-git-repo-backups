        <locationX>4230</locationX>
        <locationY>1706</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PW_Approved_Prods_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountPWApprovedProds</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RecordTypes</targetReference>
            </connector>
            <label>PW Approved Prods Present</label>
        </rules>
        <rules>
            <name>PW_Approved_prods_Absent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountPWApprovedProds</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Win_Products_not_present</targetReference>
            </connector>
            <label>PW Approved prods Absent</label>
        </rules>
    </decisions>
