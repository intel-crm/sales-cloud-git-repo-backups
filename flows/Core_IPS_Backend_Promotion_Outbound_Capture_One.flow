<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This Flow capture the outbound case promotion details</description>
    <environments>Default</environments>
    <formulas>
        <name>PromoteCountOutbound</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.Core_IPS_Promote_Count_Outbound__c}),
1,{!$Record.Core_IPS_Promote_Count_Outbound__c})+1</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core IPS Backend Promotion Outbound Capture One {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core IPS Backend Promotion Outbound Capture Two</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_IPS_Case_Promote_Count</name>
        <label>Core_IPS_Case_Promote_Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Core_IPS_Promote_Count_Outbound__c</field>
            <value>
                <elementReference>PromoteCountOutbound</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_IPS_Case_Promote_Count</targetReference>
        </connector>
        <filterFormula>AND({!$Record.Core_IPS_Backend_System__c} &lt;&gt; null,
       {!$Record.Core_IPS_Backend_ID__c} &lt;&gt; null, 
       {!$Record.Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c} &lt;&gt; null,
        {!$Record.Core_IPS_Backend_System__r.Core_IPS_Deactivated__c} = false , 
ISCHANGED({!$Record.Priority}),
        NOT(ISPICKVAL( {!$Record.Status} , &apos;Closed&apos;)), 
        ({!$Profile.Name} &lt;&gt; &apos;Integration&apos; &amp;&amp; {!$Profile.Name} &lt;&gt; &apos;IPS Data Migration&apos;))
         ||
       AND( {!$Record.Core_IPS_Backend_System__c} &lt;&gt; null,
 {!$Record.Core_IPS_Backend_ID__c} &lt;&gt; null, 
 {!$Record.Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c} &lt;&gt; null,
  {!$Record.Core_IPS_Backend_System__r.Core_IPS_Deactivated__c} = false ,
   {!$Record.Core_IPS_Backend_Previous_Status__c} &lt;&gt; null, 
   {!$Record.Core_IPS_Backend_Previous_Status__c} &lt;&gt; &apos;&apos;,
    OR(ISCHANGED({!$Record.Core_IPS_Backend_Previous_Status__c}),
     ISCHANGED({!$Record.Core_Sub_Status__c})) ,
      ({!$Profile.Name} &lt;&gt; &apos;Integration&apos; &amp;&amp; {!$Profile.Name} &lt;&gt; &apos;IPS Data Migration&apos;))</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
