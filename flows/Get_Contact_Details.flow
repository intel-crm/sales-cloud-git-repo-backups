<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Output_Value</name>
        <label>Assign Output Value</label>
        <locationX>182</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>Contact</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.Core_IPA_Partner_Role__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.Core_IPA_Partner_Role__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.Core_User_Defined_Website__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.Core_User_Defined_Website__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.BillingAddress</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.BillingAddress</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.BillingCity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.BillingCity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.BillingCountry</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.BillingCountry</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.BillingState</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.BillingState</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.BillingStreet</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.BillingStreet</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.BillingPostalCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.BillingPostalCode</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.BillingCountryCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.BillingCountryCode</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Account.BillingStateCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contacat_Details.Account.BillingStateCode</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Registration</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Pending_Self_Reg_Request</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SystemAccount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_System_Account_Details</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PendingACM</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Pending_ACM_Details</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BlockedAccountContact</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IPABlockedAccountContact</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Existing_Account_Found</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Variables</name>
        <label>Update Variables</label>
        <locationX>50</locationX>
        <locationY>1106</locationY>
        <assignmentItems>
            <assignToReference>ExistingAccount</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Valid_Email_Address</name>
        <label>Check Valid Email Address?</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contacat_Details</targetReference>
            </connector>
            <label>Valid Email?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Existing_Account_Found</name>
        <label>Existing Account Found?</label>
        <locationX>182</locationX>
        <locationY>998</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contacat_Details</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Variables</targetReference>
            </connector>
            <label>Found?</label>
        </rules>
    </decisions>
    <description>This flow is called from PRM_Admin_Registration screen flow</description>
    <environments>Default</environments>
    <formulas>
        <name>IPABlockedAccountContact</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Get_Blocked_Account_Contact.Id})) &amp;&amp; NOT(ISNULL({!Get_Blocked_Account_Contact.Id}))</expression>
    </formulas>
    <formulas>
        <name>isSystemAccount</name>
        <dataType>Boolean</dataType>
        <expression>!ISNULL({!Get_System_Account_Details.AccountId__c})</expression>
    </formulas>
    <interviewLabel>Get Contact Details {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>Get Contact Details</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Blocked_Account_Contact</name>
        <label>Get Blocked Account/Contact</label>
        <locationX>182</locationX>
        <locationY>782</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Output_Value</targetReference>
        </connector>
        <filterLogic>(1 AND 2) AND ((3 AND 4) OR (5 AND 6))</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetSBCRecordType.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_isActive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account_Blocked</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Contact_Blocked</stringValue>
            </value>
        </filters>
        <filters>
            <field>Contact_Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Email</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_SBC_Account_Search_Configuration__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contacat_Details</name>
        <label>Get Contacat Details</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Pending_Self_Reg_Request</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Email</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Pending_ACM_Details</name>
        <label>Get Pending ACM Details</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GetSBCRecordType</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Contact.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_AccountChannelMembership__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Pending_Self_Reg_Request</name>
        <label>Get Pending Self Reg Request</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_System_Account_Details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Email_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Email</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Record_Type_Name_rpt_txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account Create Request</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Channel_Program_Level_txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Partner Alliance</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_Registration_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_System_Account_Details</name>
        <label>Get System Account Details</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Pending_ACM_Details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contacat_Details.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Intel_System_Accounts__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetSBCRecordType</name>
        <label>GetSBCRecordType</label>
        <locationX>182</locationX>
        <locationY>674</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Blocked_Account_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PRM_BlockedAccountContacts</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Valid_Email_Address</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>Account</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>BlockedAccountContact</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>Contact</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>Email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>ExistingAccount</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Stores the Pending ACM Details</description>
        <name>PendingACM</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>PRM_AccountChannelMembership__c</objectType>
    </variables>
    <variables>
        <description>Pending Self Registration Record</description>
        <name>Registration</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>PRM_Registration_Request__c</objectType>
    </variables>
    <variables>
        <name>SystemAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Core_Intel_System_Accounts__mdt</objectType>
    </variables>
</Flow>
