<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Sync New Opp Product {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sync New Opp Product on SOAR</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_SOAR_Product</name>
        <label>Create SOAR Product</label>
        <locationX>308</locationX>
        <locationY>384</locationY>
        <inputAssignments>
            <field>CRM_VBS_Opportunity_Product__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Product__c</field>
            <value>
                <elementReference>$Record.Product2.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Quantity__c</field>
            <value>
                <elementReference>$Record.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_SOAR__c</field>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_UnitPrice__c</field>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Vendor__c</field>
            <value>
                <elementReference>$Record.Core_Vendor__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Write_In_Product_Name__c</field>
            <value>
                <elementReference>$Record.Core_Write_In_Product_Name__c</elementReference>
            </value>
        </inputAssignments>
        <object>CRM_VBS_Product__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_SOAR_Record</name>
        <label>Get SOAR Record</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_SOAR_Product</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_SOAR_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterFormula>ISPICKVAL({!$Record.Opportunity.Core_Opportunity_Coverage_Nm__c}, &apos;Intel-Led Opportunity&apos;) &amp;&amp; (OR(ISPICKVAL({!$Record.Opportunity.Core_VBS_Status__c} , &apos;Pending&apos;),ISPICKVAL({!$Record.Opportunity.Core_VBS_Status__c} , &apos;SOAR1 Qualified&apos;))) &amp;&amp; {!$Record.Opportunity.Core_VBS_Potential__c}</filterFormula>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_SOAR_Record</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
