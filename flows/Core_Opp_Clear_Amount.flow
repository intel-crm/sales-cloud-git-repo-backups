<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Commissionable_Flag</name>
        <label>Set Commissionable Flag</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_Commissionable__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_for_Record_type</name>
        <label>Check for Record type</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>mainUpdate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Applicable_record_type</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_Deal_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_Design_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Commissionable_Flag</targetReference>
            </connector>
            <label>Applicable record type</label>
        </rules>
    </decisions>
    <decisions>
        <name>opptyCreatedbyId_is_null</name>
        <label>opptyCreatedbyId is null</label>
        <locationX>336</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>mainUpdate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isOpptyCreatedbyIdnull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CreatedById</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_Record_type</targetReference>
            </connector>
            <label>isOpptyCreatedbyIdnull</label>
        </rules>
    </decisions>
    <description>Migrated from the: Core_Opp_Clear_Amount workflow rule
Workflow rule description: Clears the Amount field if an Opportunity is cloned with no products&quot;
Removed Oppty Focus field &quot; core/growth&quot; ,as we are hiding and not going to use this field.</description>
    <environments>Default</environments>
    <interviewLabel>Core_Opp_Clear_Amount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Opp_Clear_Amount</label>
    <migratedFromWorkflowRuleName>Core_Opp_Clear_Amount</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Clears the value in the Amount field</description>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>336</locationX>
        <locationY>779</locationY>
        <inputAssignments>
            <field>Amount</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>210</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>opptyCreatedbyId_is_null</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Core_Product_Count__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Core_Product_Count__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
