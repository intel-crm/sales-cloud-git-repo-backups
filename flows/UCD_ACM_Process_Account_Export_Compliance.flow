<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Set Export Compliance Block To False</description>
        <name>Set_ECB_Flag_To_False</name>
        <label>Set ECB Flag To False</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_Export_Compliance_Block__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_Export_Compliance_Block_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Set Export Compliance Block</description>
        <name>Set_Export_Compliance_Block_To_True</name>
        <label>Set Export Compliance Block To True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_Export_Compliance_Block__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_Export_Compliance_Block_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Label.UCD_ACM_Export_Compliance_Block_Reason</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Check if Export Compliance Block is set to True</description>
        <name>Check_Account_ECB_Flag_is_Checked</name>
        <label>Check Account ECB Flag is Checked</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IS_ECB_Checked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_ECB_Flag_To_False</targetReference>
            </connector>
            <label>IS ECB Checked</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check Account Export Compliance Block Is Set To False</description>
        <name>Check_Account_ECB_Is_Unchecked</name>
        <label>Check Account ECB Is Unchecked</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_ECB_UnChecked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Export_Compliance_Block_To_True</targetReference>
            </connector>
            <label>Is ECB UnChecked</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check For Compliance Status is blocked Or Released.</description>
        <name>Check_For_Compliance_Status</name>
        <label>Check For Compliance Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Compliance_Status_is_Blocked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Compliance_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BLK</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Label.UCD_ACM_Switch_IAO_Change</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Account_ECB_Is_Unchecked</targetReference>
            </connector>
            <label>Compliance Status is Blocked</label>
        </rules>
        <rules>
            <name>Compliance_Status_is_Released</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Label.UCD_ACM_Switch_IAO_Change</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Compliance_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>REL</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Account_ECB_Flag_is_Checked</targetReference>
            </connector>
            <label>Compliance Status is Released</label>
        </rules>
    </decisions>
    <description>This Flow updates the Account Export Compliance Block And Reason Field Based on Compliance Watch List Code Is Blocked Or Not</description>
    <environments>Default</environments>
    <formulas>
        <name>IsComplianceWatchListTypeBlocked</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&apos;,&apos;+{!$Label.UCD_ACM_ExportComplianceBlock_Codes}+&apos;,&apos;, &apos;,&apos;+TEXT({!$Record.Core_Compliance_Status__c})+ &apos;,&apos;)</expression>
    </formulas>
    <interviewLabel>UCD ACM Process Account Export Compliance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UCD ACM Process Account Export Compliance</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_For_Compliance_Status</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND 3</filterLogic>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Inactive Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Compliance_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
