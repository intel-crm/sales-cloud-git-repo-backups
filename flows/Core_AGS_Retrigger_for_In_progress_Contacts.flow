<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Update_Collection</name>
        <label>Add To Update Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varEntitlementsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Entitlement_Records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Entitlement_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Minutes_Difference</name>
        <label>Set Minutes Difference</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varMinutesDiff</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formula_MinutesDiff</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Has_30_Minutes_Passed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Pending_Assignment_Fields</name>
        <label>Set Pending Assignment Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Through_Entitlement_Records.Core_Selected__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Through_Entitlement_Records.Core_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Through_Entitlement_Records.Core_Data_Loaded__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Update_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Pending_Removal_Fields</name>
        <label>Set Pending Removal Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Through_Entitlement_Records.Core_Selected__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Through_Entitlement_Records.Core_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Through_Entitlement_Records.Core_Data_Loaded__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Add_To_Update_Collection</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Check_AGS_Integration_Status</name>
        <label>Check AGS Integration Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not In Progress</defaultConnectorLabel>
        <rules>
            <name>Is_In_Progress</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varContact.Core_AGS_Integration_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In-Progress</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Minutes_Difference</targetReference>
            </connector>
            <label>Is In Progress</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Assignment_or_Removal_Type</name>
        <label>Check Assignment or Removal Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_To_Update_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Status - Skip</defaultConnectorLabel>
        <rules>
            <name>Pending_Assignment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_Entitlement_Records.Core_Status_of_Assignment_Failure__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Assignment</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Pending_Assignment_Fields</targetReference>
            </connector>
            <label>Pending Assignment</label>
        </rules>
        <rules>
            <name>Pending_Removal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_Entitlement_Records.Core_Status_of_Assignment_Failure__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Removal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Pending_Removal_Fields</targetReference>
            </connector>
            <label>Pending Removal</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_30_Minutes_Passed</name>
        <label>Has 30 Minutes Passed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_30Min_Restriction</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Within 30 Min Window</defaultConnectorLabel>
        <rules>
            <name>Thirty_Min_Passed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMinutesDiff</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact_Entitlement_Records</targetReference>
            </connector>
            <label>30 Min Passed</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_2</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>formula_MinutesDiff</name>
        <dataType>Number</dataType>
        <expression>({!$Flow.CurrentDateTime} - {!varContact.Core_AGS_Status_Change_Date_Time__c}) * 1440</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core AGS {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core AGS Retrigger for In-progress Contacts</label>
    <loops>
        <name>Loop_Through_Entitlement_Records</name>
        <label>Loop Through Entitlement Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varContactEntitlements</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Assignment_or_Removal_Type</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Contact_Entitlement_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Contact_Entitlement_Records</name>
        <label>Get Contact Entitlement Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Entitlement_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Contact_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Core_Contact_Entitlement__c</object>
        <outputReference>varContactEntitlements</outputReference>
        <queriedFields>Id</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Get_Contact_Record</name>
        <label>Get Contact Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_AGS_Integration_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>varContact</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Contact_Entitlement_Records</name>
        <label>Update Contact Entitlement Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <inputReference>varEntitlementsToUpdate</inputReference>
    </recordUpdates>
    <screens>
        <name>Screen_30Min_Restriction</name>
        <label>30 Minute Restriction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>END_ELEMENT_4</targetReference>
        </connector>
        <fields>
            <name>txt_30MinRestriction</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;background-color: rgba(150, 150, 150, 0.1); font-size: 13.6px; font-family: SFMono-Regular, Consolas, &amp;quot;Liberation Mono&amp;quot;, Menlo, Courier, monospace; color: rgb(0, 0, 0);&quot;&gt;Action Temporarily Restricted. This action was recently triggered. You must wait 30 minutes before triggering it again. Last Triggered: {!varContact.&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Salesforce Sans&amp;quot;, Arial, sans-serif; color: rgb(22, 50, 92);&quot;&gt;Core_AGS_Status_Change_Date_Time__c&lt;/span&gt;&lt;span style=&quot;background-color: rgba(150, 150, 150, 0.1); font-size: 13.6px; font-family: SFMono-Regular, Consolas, &amp;quot;Liberation Mono&amp;quot;, Menlo, Courier, monospace; color: rgb(0, 0, 0);&quot;&gt;} Please try again after the 30-minute window has passed.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Success Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
        <fields>
            <name>txt_Success</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;background-color: rgba(150, 150, 150, 0.1); font-size: 13.6px; font-family: SFMono-Regular, Consolas, &amp;quot;Liberation Mono&amp;quot;, Menlo, Courier, monospace; color: rgb(0, 0, 0);&quot;&gt;Update Successful! All Contact Entitlement records have been updated successfully.The next action can be triggered after 30 minutes.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contact_Record</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varContact</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>varContactEntitlements</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_Contact_Entitlement__c</objectType>
    </variables>
    <variables>
        <name>varEntitlementsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_Contact_Entitlement__c</objectType>
    </variables>
    <variables>
        <name>varMinutesDiff</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
