        <locationX>176</locationX>
        <locationY>170</locationY>
        <defaultConnector>
            <targetReference>check_if_community_eligible_for_removal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If not</defaultConnectorLabel>
        <rules>
            <name>Is_active_and_complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_inactiveIndicator__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ACR_status</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_ASA_records</targetReference>
            </connector>
            <label>Is active and complete</label>
        </rules>
    </decisions>
