    <decisions>
        <name>Check_ASA_records_matches</name>
        <label>Check ASA records matches</label>
        <locationX>1311</locationX>
        <locationY>2750</locationY>
        <defaultConnector>
            <targetReference>Check_Network_Builders_Partner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>ifnot</defaultConnectorLabel>
        <rules>
            <name>if_asa_found</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>lstOfSelectBenefits</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>asavalue1IOT</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>lstOfSelectBenefits</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>asavalue2IOT</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>lstOfSelectBenefits</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>asavalue3IOT</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_assign_IOT_solution_partner_community</targetReference>
            </connector>
            <label>if asa found</label>
        </rules>
    </decisions>
