    <formulas>
        <name>accoundidofACR</name>
        <dataType>String</dataType>
        <expression>{!$Record.PRM_Account_Id__c}</expression>
    </formulas>
    <formulas>
        <name>allcontact_communities</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(CONTAINS({!loop_non_eligible_communities}, {!contact_community})),
  {!contact_community} &amp; &quot;;&quot; &amp; {!loop_non_eligible_communities},
  {!loop_non_eligible_communities}
)</expression>
    </formulas>
    <formulas>
        <name>asavalue1IOT</name>
        <dataType>String</dataType>
        <expression>
IF(
    {!Loop_metadata_records.order__c} = 2, 
    MID(
       {!Loop_metadata_records.selectBenefit__c}, 
        1, 
        FIND(&quot;;&quot;, {!Loop_metadata_records.selectBenefit__c}) - 1
    ), 
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>asavalue2IOT</name>
        <dataType>String</dataType>
        <expression>IF(
     {!Loop_metadata_records.order__c} = 2, 
    MID(
       {!Loop_metadata_records.selectBenefit__c},
        FIND(&quot;;&quot;, {!Loop_metadata_records.selectBenefit__c}) + 1, 
        FIND(&quot;;&quot;, {!Loop_metadata_records.selectBenefit__c}, FIND(&quot;;&quot;, {!Loop_metadata_records.selectBenefit__c}) + 1) - FIND(&quot;;&quot;, {!Loop_metadata_records.selectBenefit__c}) - 1
    ),
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>asavalue3IOT</name>
        <dataType>String</dataType>
        <expression>IF(
   {!Loop_metadata_records.order__c} = 2, 
    MID(
       {!Loop_metadata_records.selectBenefit__c},
        FIND(&quot;;&quot;, {!Loop_metadata_records.selectBenefit__c}, FIND(&quot;;&quot;, {!Loop_metadata_records.selectBenefit__c}) + 1) + 1, 
        LEN({!Loop_metadata_records.selectBenefit__c}) - FIND(&quot;;&quot;, {!Loop_metadata_records.selectBenefit__c}, FIND(&quot;;&quot;, {!Loop_metadata_records.selectBenefit__c}) + 1)
    ),
    &quot;&quot;
)</expression>
    </formulas>
