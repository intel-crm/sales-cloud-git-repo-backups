<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>PRM_VXData_MarketType_Update</description>
    <environments>Default</environments>
    <interviewLabel>PRM_VXData_MarketType_Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PRM_VXData_MarketType_Update</label>
    <migratedFromWorkflowRuleName>PRM_VXData_MarketType_Update</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Vx Data Market Type Update</description>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <inputAssignments>
            <field>PRM_Country_Market_Type_Nm__c</field>
            <value>
                <stringValue>NA</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
        <filterLogic>(1 OR 2)</filterLogic>
        <filters>
            <field>PRM_Partner_Role_Nm__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Seller</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Partner_Role_Nm__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Original Equipment Manufacturer (OEM)</stringValue>
            </value>
        </filters>
        <object>PRM_Value_Exchange_Data__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
