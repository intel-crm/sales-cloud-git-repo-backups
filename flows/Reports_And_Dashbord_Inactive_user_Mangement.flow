    <decisions>
        <name>ChcekCRMUserOrNot</name>
        <label>ChcekCRMUserOrNot</label>
        <locationX>435</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Check_If_Report_OR_Dashbord</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NOTCRM_user</name>
            <conditionLogic>NOT(1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8 OR 9 OR 10 OR 11)</conditionLogic>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BU Account Collaborator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Commissions Office Inquiries Admin User</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Data Ops</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Global Export Compliance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reporting Admin</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Manager</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Ops</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Rep-BB</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Rep-BB-Dual IPS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Rep-CW</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>UserCheck.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SMG/GMC Read Only</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CheckInvalid_User</targetReference>
            </connector>
            <label>NOTCRM user</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Report_OR_Dashbord</name>
        <label>Check_If_Report_OR_Dashbord</label>
        <locationX>820</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Report</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SelectOptions</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Option_Report</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CheckReportAccess</targetReference>
            </connector>
            <label>Is_Report</label>
        </rules>
        <rules>
            <name>Is_Dashboard</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SelectOptions</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Option_Dashboard</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Records</targetReference>
            </connector>
            <label>Is_Dashboard</label>
        </rules>
    </decisions>
