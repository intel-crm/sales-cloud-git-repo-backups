    <environments>Default</environments>
    <formulas>
        <name>Create_HTML_Data</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;tr&gt;&quot;&amp;
&quot;&lt;td &gt;&quot;  &amp; HTMLENCODE({!Loop_On_Result.DashaboardName}) &amp; &quot;&lt;/td&gt;&quot;&amp;
&quot;&lt;td &gt;&quot;  &amp; HTMLENCODE({!Loop_On_Result.RunningUsrName}) &amp; &quot;&lt;/td&gt;&quot;&amp;
&quot;&lt;td &gt;&quot;  &amp; HTMLENCODE(IF( {!Loop_On_Result.RunningUsrisActive}, &apos;True&apos;, &apos;False&apos;) ) &amp; &quot;&lt;/td&gt;&quot;&amp;
&quot;&lt;td &gt;&quot;  &amp; HTMLENCODE({!Loop_On_Result.ReportName}) &amp; &quot;&lt;/td&gt;&quot;&amp;
&quot;&lt;/tr&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>Formula_for_string</name>
        <dataType>String</dataType>
        <expression>&apos;Dashboard Name:-&apos; &amp;{!Loop_On_Result.DashaboardName}&amp; BR() &amp; &apos;Running user Name:-&apos; &amp; {!Loop_On_Result.RunningUsrName}  &amp; BR() &amp;  &apos;Running User Is Active:-&apos; &amp; IF({!Loop_On_Result.RunningUsrisActive}, &apos;True&apos;, &apos;False&apos;) &amp; BR() &amp; &apos;Reports Related To Dashboard:-&apos; &amp; BR() &amp;{!Loop_On_Result.ReportName} &amp; BR() &amp; BR() &amp;BR()</expression>
    </formulas>
