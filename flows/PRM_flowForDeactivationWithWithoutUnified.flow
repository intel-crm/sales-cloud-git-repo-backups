                </rightValue>
            </conditions>
            <connector>
                <targetReference>if_listOfACMToUpdate_is_not_empty</targetReference>
            </connector>
            <label>if present</label>
        </rules>
    </decisions>
    <decisions>
        <name>get_IPA_Affiliation_records_not_null</name>
