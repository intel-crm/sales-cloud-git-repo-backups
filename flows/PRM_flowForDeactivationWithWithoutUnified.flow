    <decisions>
        <name>If_multiple_Intel_Accounts_are_associated_with_same_OPID</name>
        <label>If multiple Intel Accounts are associated with same OPID</label>
        <locationX>226</locationX>
        <locationY>1682</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>get_OPID_ACMS_to_Inactivate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>accounts are not present</defaultConnectorLabel>
        <rules>
            <name>accounts_are_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>intelAccIdsLst</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>intelAccIdsLst</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_acms_of_all_location_accounts</targetReference>
            </connector>
            <label>accounts are present</label>
        </rules>
    </decisions>
    <decisions>
        <name>if_OPID_Id_is_there</name>
        <label>if OPID_Id is there</label>
        <locationX>446</locationX>
        <locationY>974</locationY>
        <defaultConnector>
            <targetReference>if_listOfACMToUpdate_is_not_empty</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>OPID_is_there_or_Acm_is_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>opid_id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>opid_id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_all_accounts_under_opid</targetReference>
            </connector>
            <label>OPID is there or Acm is present</label>
        </rules>
    </decisions>
    <decisions>
        <name>if_PAG_is_active</name>
        <label>if PAG is active</label>
        <locationX>446</locationX>
        <locationY>1298</locationY>
        <defaultConnector>
            <targetReference>Loop_PAGs_to_See_if_any_active_account_present</targetReference>
