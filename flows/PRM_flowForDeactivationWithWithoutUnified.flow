    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Log_Entry</name>
        <label>Create Log Entry</label>
        <locationX>446</locationX>
        <locationY>2690</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <stringValue>Flow for Deactivation With/Without Unified Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>PRM_flowForDeactivationWithWithoutUnified</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <stringValue>IPA</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <stringValue>Flow for Deactivation With/Without Unified</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$System.OriginDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_ACM_Records_To_Inactivate</name>
        <label>Get ACM Records To Inactivate</label>
        <locationX>666</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_get_acm_records_not_null</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4) AND 5</filterLogic>
        <filters>
            <field>PRM_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>accid</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Channel_Program_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Channel_Program.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Account_RT__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Inactive_Account</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PRM_AccountChannelMembership__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_acms_of_all_location_accounts</name>
        <label>get acms of all location accounts</label>
        <locationX>50</locationX>
        <locationY>1790</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>check_if_same_acms_present_in_another_location_accounts_of_same_opid</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Account_Id__c</field>
            <operator>In</operator>
            <value>
                <elementReference>intelAccIdsLst</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Partner_Role__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>intelAccPartnerRole</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Tier_Name_txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>intelAccPartnerTier</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Account_Id__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>accid</elementReference>
            </value>
        </filters>
        <object>PRM_AccountChannelMembership__c</object>
        <outputReference>lstActiveAcmsOfLocAccs</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>PRM_Partner_Role__c</queriedFields>
        <queriedFields>PRM_Tier_Name_txt__c</queriedFields>
        <queriedFields>PRM_Account_Id__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_all_accounts_under_opid</name>
        <label>Get all accounts under opid</label>
        <locationX>226</locationX>
        <locationY>1082</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_PAGs_to_See_if_any_active_account_present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Partner_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>opid_id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Inactive_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Intel_Account_Id__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>accid</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Account_Group_Member__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get Intel partner alliance program name</description>
        <name>Get_Channel_Program</name>
        <label>Get Channel Program</label>
        <locationX>666</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
