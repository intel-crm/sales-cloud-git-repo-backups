<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This is used to create AllocationShare record for both Internal Account Managers group for a particular program and External users.</description>
    <environments>Default</environments>
    <interviewLabel>Core_MDF_CreatePFAforInternalAccountManagerAndExternal {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_CreatePFAforInternalAndExternalAccountManager</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_MDF_CreatePFAShareRecordforInernalAcctManager</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(),ISCHANGED({!$Record.OwnerId}))</filterFormula>
        <object>PartnerFundAllocation</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <subflows>
        <description>Calling another Subflow</description>
        <name>Core_MDF_CreatePFAShareRecordforInernalAcctManager</name>
        <label>CreatePFAShareRecordforInernalAcctManager</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <flowName>Core_MDF_CreatePFAShareForInternalAccountManagers</flowName>
        <inputAssignments>
            <name>ProgramName</name>
            <value>
                <elementReference>$Record.Budget.Core_MDF_Program__r.Core_MDF_Technical_Program_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vBudgetType</name>
            <value>
                <elementReference>$Record.Budget.Core_MDF_Budget_Type_Txt__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vIntelAccountId</name>
            <value>
                <elementReference>$Record.Budget.Core_MDF_Budget_Partner__r.Core_MDF_Parent_Fund_Account__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vPFAId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vProgram</name>
            <value>
                <elementReference>$Record.Budget.Core_MDF_Program__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vRegion</name>
            <value>
                <elementReference>$Record.Budget.Core_MDF_Budget_Partner__r.Core_Geo__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vSubRegion</name>
            <value>
                <elementReference>$Record.Budget.Core_MDF_Budget_Partner__r.Core_Sub_Geo__c</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
