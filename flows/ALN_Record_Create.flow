<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>52.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Line_Item_to_ALN_List</name>
        <label>Add Line Item to ALN List</label>
        <locationX>2082</locationX>
        <locationY>154</locationY>
        <assignmentItems>
            <assignToReference>ALNLineList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>IndividualALNLineItem</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IterateQuoteLineList</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign true if BC GT DC</description>
        <name>AssignBCGTDC</name>
        <label>AssignBCGTDC</label>
        <locationX>917</locationX>
        <locationY>704</locationY>
        <assignmentItems>
            <assignToReference>CheckifBCGTDC</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_QuoteLine</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Create_New_Line_Item_Instance</name>
        <label>Create New Line Item Instance</label>
        <locationX>2086</locationX>
        <locationY>298</locationY>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_cpq_cis_no_nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ALNID</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_cpq_quote_item_line_no__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_cpq_device_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.SBQQ__Product__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>lineRecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_cpq_prid__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.core_cpq_PRID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_cpq_resale_amt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.price_suggested_resale_amt__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.price_broken_cost_disty_amt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.price_brokencost_amt__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_list_unit_price__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.SBQQ__ListPrice__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_cpq_quoted_qty_nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.SBQQ__Quantity__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_cpq_upper_bound_qty_nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.core_cpq_upper_bound_qty_nbr__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_cpq_lower_bound_qty_nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.core_cpq_lower_bound_qty_qty__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>IndividualALNLineItem.core_cpq_requested_qty_nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateQuoteLineList.core_cpq_requested_qty__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Line_Item_to_ALN_List</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>CheckBCGTDC</name>
        <label>CheckBCGTDC</label>
        <locationX>864</locationX>
        <locationY>547</locationY>
        <defaultConnector>
            <targetReference>AssignBCGTDC</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes, BC is GT DC</defaultConnectorLabel>
        <rules>
            <name>No_BC_is_not_GT_DC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Iterate_QuoteLine.price_brokencost_amt__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Iterate_QuoteLine.price_disty_cost_nbr__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Iterate_QuoteLine</targetReference>
            </connector>
            <label>No, BC is not GT DC</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if variable BCGTDC is true or false.</description>
        <name>Checking_BC_GT_DC</name>
        <label>Checking BC GT DC</label>
        <locationX>1069</locationX>
        <locationY>526</locationY>
        <defaultConnector>
            <targetReference>ErrorMessageForALN</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes, BC is GT DC</defaultConnectorLabel>
        <rules>
            <name>No_BC_is_not_GT_Disty_Cost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckifBCGTDC</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_ALN_records</targetReference>
            </connector>
            <label>No, BC is not GT Disty Cost</label>
        </rules>
    </decisions>
    <decisions>
        <name>QuoteTypeChoose</name>
        <label>QuoteTypeChoose</label>
        <locationX>1551</locationX>
        <locationY>196</locationY>
        <defaultConnector>
            <targetReference>GetQuoteLinesNotTP</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not TP</defaultConnectorLabel>
        <rules>
            <name>If_TP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QuoteType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Transfer Pricing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetQuoteLinesIfTP</targetReference>
            </connector>
            <label>If TP</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>ALN Record Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ALN Record Create</label>
    <loops>
        <description>Iterate Quote Lines.</description>
        <name>Iterate_QuoteLine</name>
        <label>Iterate QuoteLine</label>
        <locationX>961</locationX>
        <locationY>368</locationY>
        <collectionReference>QuoteLineList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>CheckBCGTDC</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Checking_BC_GT_DC</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>IterateQuoteLineList</name>
        <label>IterateQuoteLineList</label>
        <locationX>1737</locationX>
        <locationY>276</locationY>
        <collectionReference>QuoteLineList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Create_New_Line_Item_Instance</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_ALN_Lines</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
