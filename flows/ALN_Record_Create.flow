        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_ALN_Lines</name>
        <label>Create ALN Lines</label>
        <locationX>1742</locationX>
        <locationY>459</locationY>
        <connector>
            <targetReference>ALN_Record_Created</targetReference>
        </connector>
        <faultConnector>
            <targetReference>ALNLineErrorScreen</targetReference>
        </faultConnector>
        <inputReference>ALNLineList</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_ALN_records</name>
        <label>Create ALN records</label>
        <locationX>1226</locationX>
        <locationY>335</locationY>
        <connector>
            <targetReference>Newly_Created_ALN_record</targetReference>
        </connector>
        <faultConnector>
            <targetReference>ALNErrorScreen</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>recordTypeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>core_cpq_active_quote__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>core_cpq_disty_submitted_user__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>core_cpq_record_type_identifier__c</field>
            <value>
                <stringValue>ALN</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>core_cpq_sap_distributor_nm__c</field>
            <value>
                <elementReference>sapdistributorid</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>core_cpq_status_txt__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>core_cpq_submitter_comments_txt__c</field>
            <value>
                <elementReference>Submitter_Comments</elementReference>
            </value>
        </inputAssignments>
        <object>core_cpq_dpa_aln__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Channel_Program_Record</name>
