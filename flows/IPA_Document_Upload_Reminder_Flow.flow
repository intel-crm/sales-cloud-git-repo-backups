    <decisions>
        <name>Is_Registration_still_Pending_with_Partner</name>
        <label>Is Registration still Pending with Partner?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PendingwithPartner</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reject_Registration_Request</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Status_Pending_with_Partner</name>
        <label>Is Status Pending with Partner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PendingwithPartner</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Registration_Request_to_List</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
