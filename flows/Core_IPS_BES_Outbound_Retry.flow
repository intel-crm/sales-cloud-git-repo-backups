    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND( CONTAINS([Core_IPS_BES_Error_Log__c].Core_IPS_Error_Description__c, &apos;Class.&apos;),[Core_IPS_BES_Error_Log__c].Core_IPS_Eligible_for_retry__c  == false)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND( CONTAINS({!myVariable_event_context.Core_IPS_Error_Description__c}, &apos;Class.&apos;),{!myVariable_event_context.Core_IPS_Eligible_for_retry__c}  == false)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>(NOT(CONTAINS([Core_IPS_BES_Error_Log__c].Core_IPS_Error_Description__c, &quot;request_end_time_utc&quot;)) &amp;&amp; NOT(CONTAINS([Core_IPS_BES_Error_Log__c].Core_IPS_Error_Description__c, &quot;Class.&quot;)))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>(NOT(CONTAINS({!myVariable_event_context.Core_IPS_Error_Description__c}, &quot;request_end_time_utc&quot;)) &amp;&amp; NOT(CONTAINS({!myVariable_event_context.Core_IPS_Error_Description__c}, &quot;Class.&quot;)))</expression>
    </formulas>
