    <screens>
        <description>Displays a confirmation message after successfully creating the Lead record.</description>
        <name>DealSubmissionConfirmation</name>
        <label>Deal Submission Confirmation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>DealSubmittedConfirmationMessage</name>
            <fieldText>&lt;p&gt;{!DealSubmittedConfirmationMessageFormula}&lt;/p&gt;</fieldText>
