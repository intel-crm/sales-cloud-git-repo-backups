<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <description>Stores the string value of the Lead Process Name.</description>
        <name>LeadProcessName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Partner Deal Registration</stringValue>
        </value>
    </constants>
    <constants>
        <description>Stores the string value of the Record Type Name.</description>
        <name>RecordTypeName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Partner Deal Registration</stringValue>
        </value>
    </constants>
    <dynamicChoiceSets>
        <description>Stores values provided by the Industry field of the Lead object to display as choices for Industry picklist in Collect Additional Information screen.</description>
        <name>IndustryPicklist</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Industry</picklistField>
        <picklistObject>Lead</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <description>Stores values provided by the Lead Source field of the Lead object to display as choices for Lead Source picklist in Collect Additional Information screen.</description>
        <name>LeadSourcePicklist</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>LeadSource</picklistField>
        <picklistObject>Lead</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <description>Stores values provided by the Rating field of the Lead object to display as choices for Rating radio buttons in Collect Lead Details screen.</description>
        <name>RatingPicklist</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Rating</picklistField>
        <picklistObject>Lead</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <description>Stores values provided by the Salutation field of the Lead object to display as choices for Salutation picklist in Collect Lead Details screen.</description>
        <name>SalutationPicklist</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Salutation</picklistField>
        <picklistObject>Lead</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>Generates the final confirmation message by substituting the {0} placeholder in the DealSubmittedConfirmationMessageText template with the Company variable value.</description>
        <name>DealSubmittedConfirmationMessageFormula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!DealSubmittedConfirmationMessageText}, &quot;{0}&quot;,{!Company})</expression>
    </formulas>
    <interviewLabel>$Label.PartnerDealRegstrFlow.FlowName {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Partner Deal Registration</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <description>Creates one Lead record using data from the Collect Lead Details screen. Sets the Lead Source field to &apos;Partner&apos;, and sets the Status field to the the value of the LeadStatus variable.</description>
        <name>CreateLeadRecord</name>
        <label>Create Lead Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>DealSubmissionConfirmation</targetReference>
        </connector>
        <faultConnector>
            <targetReference>LeadSubmissionError</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>AnnualRevenue</field>
            <value>
                <elementReference>AnnualRevenue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>City</field>
            <value>
                <elementReference>Address.city</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Company</field>
            <value>
                <elementReference>Company</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Country</field>
            <value>
                <elementReference>Address.country</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email</field>
            <value>
                <elementReference>Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <elementReference>FirstName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Industry</field>
            <value>
                <elementReference>IndustryFieldPicklist</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>LastName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LeadSource</field>
            <value>
                <stringValue>Partner</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NumberOfEmployees</field>
            <value>
                <elementReference>NumberOfEmployees</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone</field>
            <value>
                <elementReference>PhoneNumber.value</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PostalCode</field>
            <value>
                <elementReference>Address.postalCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Rating</field>
            <value>
                <elementReference>Rating</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>GetLeadRecordTypeRecord.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ReferralCode__NotFound</field>
            <value>
                <elementReference>ReferralCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Salutation</field>
            <value>
                <elementReference>SalutationFieldPicklist</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>State</field>
            <value>
                <elementReference>Address.province</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>LeadStatus</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Street</field>
