    <recordLookups>
        <name>Core_MDF_Fetch_RecordType_Id</name>
        <label>Fetch RecordType Id</label>
        <locationX>642</locationX>
        <locationY>771</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Check_if_Allocation_Record_Type_is_NOT_NULL</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vAllocationRTDeveloperName</elementReference>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PartnerFundAllocation</stringValue>
            </value>
        </filters>
        <object>RecordType</object>
        <outputAssignments>
            <assignToReference>vAllocationRecordTypeId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Core_MDF_Fetch_the_Allocation_RT_Developer_Name</name>
        <label>Fetch the Allocation RT Developer Name</label>
        <locationX>640</locationX>
        <locationY>409</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Check_if_vAllocationRTDeveloperName_is_NOT_NULL</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Channel_Program_txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vProgramName</elementReference>
            </value>
        </filters>
        <object>Core_MDF_ObjRecType_Budget_FieldSetMap__mdt</object>
        <outputAssignments>
            <assignToReference>vAllocationRTDeveloperName</assignToReference>
            <field>Core_MDF_Allocation_RecordType_txt__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Core_MDF_FetchAllAllocationRecords</name>
        <label>FetchAllAllocationRecords</label>
        <locationX>156</locationX>
        <locationY>409</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_If_Allocation_Record_present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BudgetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vBudgetId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ChannelPartnerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vBudgetAccountId</elementReference>
            </value>
        </filters>
        <object>PartnerFundAllocation</object>
        <outputReference>sColl_PFAList</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>BudgetId</queriedFields>
        <queriedFields>ChannelPartnerId</queriedFields>
        <queriedFields>Amount</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <recordUpdates>
        <description>Re-Calculating the Budget Amount with a Decreased budget amount  and updating the Allocation amount first</description>
        <name>Core_MDF_DescreaseFirstPFARecordBudget</name>
        <label>DescreaseFirstPFARecordBudget</label>
        <locationX>813</locationX>
        <locationY>258</locationY>
        <connector>
            <targetReference>Core_MDF_Update_Budget_Amount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>sPFARecord.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>vReduceAllocationAmount</elementReference>
            </value>
        </inputAssignments>
        <object>PartnerFundAllocation</object>
    </recordUpdates>
    <recordUpdates>
        <description>Updating Budget &quot;Amount&quot; and making Decreased budget amount value to &quot;0&quot;</description>
        <name>Core_MDF_Update_Budget_Amount</name>
        <label>Update Budget Amount</label>
        <locationX>1193</locationX>
        <locationY>258</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
