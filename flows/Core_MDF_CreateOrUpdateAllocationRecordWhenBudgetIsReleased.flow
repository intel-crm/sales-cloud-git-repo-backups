<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_MDF_Check_if_Allocation_Record_Type_is_NOT_NULL</name>
        <label>Check if Allocation Record Type is NOT NULL</label>
        <locationX>810</locationX>
        <locationY>773</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Allocation_RT_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vAllocationRecordTypeId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Decrease_Budget</targetReference>
            </connector>
            <label>Allocation RT is NOT NULL</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_vAllocationRTDeveloperName_is_NOT_NULL</name>
        <label>Check if vAllocationRTDeveloperName is NOT NULL</label>
        <locationX>632</locationX>
        <locationY>549</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_vAllocationRTDeveloperName_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vAllocationRTDeveloperName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_RecordType_Id</targetReference>
            </connector>
            <label>vAllocationRTDeveloperName is NOT NULL</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Decrease_Budget</name>
        <label>Decrease  Budget</label>
        <locationX>1074</locationX>
        <locationY>778</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_DecreaseBudget_No</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Create_Allocation</targetReference>
            </connector>
            <label>No</label>
        </rules>
        <rules>
            <name>Core_MDF_DecreaseBudget_Yes</name>
            <conditionLogic>( 1 OR 2 ) And 3</conditionLogic>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>vBudgetAmount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Create_Allocation_with_Decreased_Budget_Amount</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>To identify whether we are  updated Allocation budget or decrease the Allocation budget</description>
        <name>Core_MDF_Distinguish_between_Increased_budget_or_Decreased_budget</name>
        <label>Distinguish between Increased budget or Decreased budget</label>
        <locationX>576</locationX>
        <locationY>193</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Increased_Budget</name>
            <conditionLogic>(1 OR 2 ) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBudgetAmount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>vTotalAllocationAmount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_UpdateFirstPFARecord</targetReference>
            </connector>
            <label>Increased Budget</label>
        </rules>
        <rules>
            <name>Core_MDF_Decreased_Budget</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vDecreasedBudgetAmount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>vTotalAllocationAmount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_DescreaseFirstPFARecordBudget</targetReference>
            </connector>
            <label>Decreased Budget</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_If_Allocation_Record_present</name>
        <label>If Allocation Record present</label>
        <locationX>330</locationX>
        <locationY>410</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Allocation_Absent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sColl_PFAList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_the_Allocation_RT_Developer_Name</targetReference>
            </connector>
            <label>Allocation Absent</label>
        </rules>
        <rules>
            <name>Core_MDF_Allocation_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sColl_PFAList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_LoopThroughPFAList</targetReference>
            </connector>
            <label>Allocation Present</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>sPFARecord.Amount :  Hold the virtual corp remaining Allocation amount after Funds has been transferred to below nodes in the hierarchy
vBudgetAmount : increased in Allocation budget Amount 
vTotalAllocationAmount: Sum of all allocation budget amount</description>
        <name>vDifferenceAmount</name>
        <dataType>Currency</dataType>
        <expression>{!sPFARecord.Amount}+{!vBudgetAmount}-{!vTotalAllocationAmount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Decreasing allocation amount at the virtual corporation node</description>
        <name>vReduceAllocationAmount</name>
        <dataType>Currency</dataType>
        <expression>IF(AND(NOT(ISNULL({!vDecreasedBudgetAmount})),{!vDecreasedBudgetAmount}&gt;0,{!sPFARecord.Amount}&gt;={!vDecreasedBudgetAmount}), {!sPFARecord.Amount}-{!vDecreasedBudgetAmount}, {!sPFARecord.Amount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>To decrease the budget Amount with specifies a decresed budget Amount</description>
        <name>vReduceBudgetAmount</name>
        <dataType>Currency</dataType>
        <expression>IF(AND(NOT(ISNULL({!vDecreasedBudgetAmount})),{!vDecreasedBudgetAmount}&gt;0,{!vBudgetAmount}&gt;={!vDecreasedBudgetAmount}), {!vBudgetAmount}-{!vDecreasedBudgetAmount}, {!vBudgetAmount})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core_MDF_CreateOrUpdateAllocationRecordWhenBudgetIsReleased {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_CreateOrUpdateAllocationRecordWhenBudgetIsReleased</label>
    <loops>
        <name>Core_MDF_LoopThroughPFAList</name>
        <label>LoopThroughPFAList</label>
        <locationX>334</locationX>
        <locationY>187</locationY>
        <assignNextValueToReference>sPFARecord</assignNextValueToReference>
        <collectionReference>sColl_PFAList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_MDF_Distinguish_between_Increased_budget_or_Decreased_budget</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Create_Allocation</name>
        <label>Create Allocation</label>
        <locationX>980</locationX>
        <locationY>601</locationY>
        <assignRecordIdToReference>vAllocationRecordId</assignRecordIdToReference>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>vBudgetAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>BudgetId</field>
            <value>
                <elementReference>vBudgetId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ChannelPartnerId</field>
            <value>
                <elementReference>vBudgetAccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>vAllocationRecordTypeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Title</field>
            <value>
                <elementReference>vBudgetName</elementReference>
            </value>
        </inputAssignments>
        <object>PartnerFundAllocation</object>
    </recordCreates>
    <recordCreates>
        <name>Core_MDF_Create_Allocation_with_Decreased_Budget_Amount</name>
        <label>Create Allocation with Decreased Budget Amount</label>
        <locationX>1192</locationX>
        <locationY>598</locationY>
        <assignRecordIdToReference>vAllocationRecordId</assignRecordIdToReference>
        <connector>
            <targetReference>Core_MDF_Update_Budget_Amount</targetReference>
        </connector>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>vReduceBudgetAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>BudgetId</field>
            <value>
                <elementReference>vBudgetId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ChannelPartnerId</field>
            <value>
                <elementReference>vBudgetAccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>vAllocationRecordTypeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Title</field>
            <value>
                <elementReference>vBudgetName</elementReference>
            </value>
        </inputAssignments>
        <object>PartnerFundAllocation</object>
