            </value>
        </filters>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>vDifferenceAmount</elementReference>
            </value>
        </inputAssignments>
        <object>PartnerFundAllocation</object>
    </recordUpdates>
    <start>
