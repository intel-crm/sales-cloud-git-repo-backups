<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>CreateUniqueSupportedProduct</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Core_Product_Organization__c}, 15) &amp; {!$Record.Core_Product__r.Core_Unique_ID__c}</expression>
    </formulas>
    <interviewLabel>Core Auto Populate EPM Data {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_IPS_Insert_Code_Name And Core Auto Populate EPM Data</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_IPS_Insert_Codename</name>
        <label>Core_IPS_Insert_Codename</label>
        <locationX>716</locationX>
        <locationY>371</locationY>
        <inputAssignments>
            <field>Core_IPS_Code_Name__c</field>
            <value>
                <elementReference>$Record.Code_Name_Hidden_Evaluate_NA__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Product_EPM_ID__c</field>
            <value>
                <elementReference>$Record.Core_Product__r.Core_Unique_ID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Supported_Product_Name__c</field>
            <value>
                <elementReference>$Record.Core_Product__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Unique_Supported_Product__c</field>
            <value>
                <elementReference>CreateUniqueSupportedProduct</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>590</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Core_IPS_Insert_Codename</targetReference>
        </connector>
        <object>Core_IPS_Supported_Product__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
