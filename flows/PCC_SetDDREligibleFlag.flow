<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_MM_attribute_to_Variable</name>
        <label>Assign MM attribute to Variable</label>
        <locationX>264</locationX>
        <locationY>576</locationY>
        <assignmentItems>
            <assignToReference>MMattributeRecordstoUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Over_MM_Attribute_Expired_records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_MM_Attribute_Expired_records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_eligible_as_No</name>
        <label>Set eligible as No</label>
        <locationX>264</locationX>
        <locationY>468</locationY>
        <assignmentItems>
            <assignToReference>Loop_Over_MM_Attribute_Expired_records.Eligible_for_DDI_Payment__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_MM_attribute_to_Variable</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <interviewLabel>PCC_SetDDREligibleFlag {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PCC_SetDDREligibleFlag</label>
    <loops>
        <name>Loop_Over_MM_Attribute_Expired_records</name>
        <label>Loop Over MM Attribute Expired records</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>Get_MM_attribute_records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
