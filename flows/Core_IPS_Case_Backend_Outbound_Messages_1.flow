    <description>Migrated from the Core IPS Case Backend Outbound Messages process using multiple criteria.
Case depromote, promote, filed update, and status update moving to new  Apigee bridge</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND( (CONTAINS( {!$Record.Core_IPS_Backend_Previous_Status__c} ,&apos;disassociate&apos;)) ,
(({!$Profile.Name} &lt;&gt; &apos;Integration&apos; &amp;&amp; {!$Profile.Name} &lt;&gt; &apos;IPS Data Migration&apos;)||(CONTAINS({!$User.Username}, &apos;ips.file.integrationuser&apos;))))</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.Core_IPS_Backend_System__c} &lt;&gt; null,
 {!$Record.Core_IPS_Backend_ID__c} &lt;&gt; null, 
 {!$Record.Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c} &lt;&gt; null,
  {!$Record.Core_IPS_Backend_System__r.Core_IPS_Deactivated__c} = false ,
   {!$Record.Core_IPS_Backend_Previous_Status__c} &lt;&gt; null, 
   {!$Record.Core_IPS_Backend_Previous_Status__c} &lt;&gt; &apos;&apos;,
    OR(ISCHANGED({!$Record.Core_IPS_Backend_Previous_Status__c}),
     ISCHANGED({!$Record.Core_Sub_Status__c})) ,
      ({!$Profile.Name} &lt;&gt; &apos;Integration&apos; &amp;&amp; {!$Profile.Name} &lt;&gt; &apos;IPS Data Migration&apos;))</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.Core_IPS_Backend_System__c} &lt;&gt; null,
       {!$Record.Core_IPS_Backend_ID__c} &lt;&gt; null, 
       {!$Record.Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c} &lt;&gt; null,
        {!$Record.Core_IPS_Backend_System__r.Core_IPS_Deactivated__c} = false ,
        {!$Record.Core_IPS_BK_Flds_UpdatedAt__c} &lt;&gt; {!$Record.Core_IPS_BK_Flds_UpdatedAt_PreVal__c} , 
        NOT(ISPICKVAL( {!$Record.Status} , &apos;Closed&apos;)), 
        ({!$Profile.Name} &lt;&gt; &apos;Integration&apos; &amp;&amp; {!$Profile.Name} &lt;&gt; &apos;IPS Data Migration&apos;) )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_7</name>
        <dataType>Boolean</dataType>
        <expression>AND( (({!$Profile.Name} &lt;&gt; &apos;Integration&apos; &amp;&amp; {!$Profile.Name} &lt;&gt; &apos;IPS Data Migration&apos;)||
         CONTAINS({!$User.Username}, &apos;ips.file.integrationuser&apos;)),
         {!$Record.Core_IPS_Backend_ID__c} == null, 
         {!$Record.Core_IPS_Backend_System__c} !=null,
          ISPICKVAL( {!$Record.Core_Promote_Status__c} , &apos;In Progress&apos;) ,
           NOT(ISPICKVAL( {!$Record.Status} , &apos;Closed&apos;)), 
           ( ISBLANK(TEXT({!$Record.Core_IPS_GEC_Status__c})) 
           || ISPICKVAL( {!$Record.Core_IPS_GEC_Status__c}, &apos;Approved&apos;) 
           || ISPICKVAL( {!$Record.Core_IPS_GEC_Status__c}, &apos;Approved with Guardrails&apos;)) )</expression>
    </formulas>
    <label>Core IPS Case Backend Outbound Messages_1</label>
