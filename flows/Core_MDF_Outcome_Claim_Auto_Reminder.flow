    <decisions>
        <name>Check_CreatedDate_Diffrence</name>
        <label>Check CreatedDate Diffrence</label>
        <locationX>658</locationX>
        <locationY>390</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CreatedDateMod5</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DateDiffCheck</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendEmailClaimOwner</targetReference>
            </connector>
            <label>CreatedDateMod5</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DateDiffCheck</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) &lt;&gt; TODAY(),
  WEEKDAY(TODAY()) &gt;= 2,
  WEEKDAY(TODAY()) &lt;= 6,
  MOD(
    CASE(
      WEEKDAY(DATEVALUE({!GetClaimHistoryRecords.CreatedDate})),
      1, /* Sunday - Start counting from Monday */
        MAX(0, TODAY() - DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) - 
        2 * FLOOR((TODAY() - DATEVALUE({!GetClaimHistoryRecords.CreatedDate})) / 7) - 1),
      7, /* Saturday - Start counting from Monday */
        MAX(0, TODAY() - DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) - 
        2 * FLOOR((TODAY() - DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) + 1) / 7) - 2),
      /* Weekdays */
        TODAY() - DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) - 
        2 * FLOOR((TODAY() - DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) + WEEKDAY(DATEVALUE({!GetClaimHistoryRecords.CreatedDate})) - 2) / 7)
    ),
    5
  ) = 0
)</expression>
    </formulas>
    <interviewLabel>Outcome Claim Auto Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Outcome Claim Auto Reminder</label>
