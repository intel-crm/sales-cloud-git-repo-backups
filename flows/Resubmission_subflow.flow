            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_Over_Inserted_OLis</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Deal_Eligible_value</name>
        <label>Assign Deal Eligible value</label>
        <locationX>270</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>DealEligible</assignToReference>
            <operator>Assign</operator>
