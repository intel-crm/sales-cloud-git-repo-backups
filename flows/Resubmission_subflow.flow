            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Opportunity_Line_Items</name>
        <label>Create Opportunity Line Items</label>
        <locationX>182</locationX>
        <locationY>1958</locationY>
        <connector>
            <targetReference>Get_Deal_Record_Type</targetReference>
        </connector>
        <inputReference>OpportunityLineItems</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_stage_record_for_Quote_Update</name>
        <label>Create stage record for Quote Update</label>
        <locationX>50</locationX>
        <locationY>2990</locationY>
        <inputAssignments>
            <field>Pricing_Message_Type__c</field>
            <value>
                <stringValue>Financial Incentive Update</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pricing_SObjectId__c</field>
            <value>
                <elementReference>Get_Deal_Details.Core_Opportunity_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pricing_SObject__c</field>
            <value>
                <stringValue>Opportunity</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pricing_Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <object>Pricing_Integration_Staging__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get the deal details</description>
        <name>Get_Deal_Details</name>
        <label>Get Deal Details</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Opportunity_Exisits</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RecordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Design_Registration__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>This will return the Approved and no locked deal products</description>
        <name>Get_Deal_Products</name>
        <label>Get Deal Products</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Iterate_over_Deal_Product_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Locked_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Design_Product_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Design_Registration_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Deal_Details.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Design_Registration_Product__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Deal_Record_Type</name>
        <label>Get Deal Record Type</label>
        <locationX>182</locationX>
        <locationY>2066</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Iterate_Over_Inserted_OLis</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PCC_Deal_Registration_Product_Locked</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Pricebook_Entry_Record</name>
        <label>Get Pricebook Entry Record</label>
        <locationX>182</locationX>
        <locationY>1058</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_DRP_s</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Product2Id</field>
            <operator>In</operator>
            <value>
                <elementReference>Product2Ids</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Pricebook2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Deal_Details.Core_Opportunity_Id__r.Pricebook2Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PricebookEntry</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_DRP_Records</name>
        <label>Update DRP Records</label>
        <locationX>182</locationX>
        <locationY>2774</locationY>
        <connector>
            <targetReference>Eligible_for_Quote_Update</targetReference>
        </connector>
        <inputReference>DealRegistrationsProducts</inputReference>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Deal_Details</targetReference>
        </connector>
    </start>
