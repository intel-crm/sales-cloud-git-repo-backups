                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_over_Deal_Product_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Collect_all_Opportunity_Line_Items</name>
        <label>Collect all Opportunity Line Items</label>
        <locationX>710</locationX>
        <locationY>1598</locationY>
        <assignmentItems>
            <assignToReference>OpportunityLineItems</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>OpportunityLineItemRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_Price_Pricebook_Entries</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Create Opportunity Line Item Record</description>
        <name>Create_Opportunity_Line_Item</name>
        <label>Create Opportunity Line Item</label>
        <locationX>710</locationX>
        <locationY>1490</locationY>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.Core_Design_Registration_Product_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_through_DRP_s.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.UnitPrice</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_through_DRP_s.Core_Target_Resale_Amt__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Deal_Details.Core_Opportunity_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.Quantity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_through_DRP_s.Core_Full_Year_Qty__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.Product2Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_over_Deal_Product_Records.Core_Product_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.Failed_DDR_RecordID__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Deal_Details.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.PricebookEntryId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_through_Price_Pricebook_Entries.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Collect_all_Opportunity_Line_Items</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Deal_Product</name>
        <label>Update Deal Product</label>
        <locationX>270</locationX>
        <locationY>2390</locationY>
        <assignmentItems>
            <assignToReference>DealRegistrationProduct.Core_Locked_Ind__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DealRegistrationProduct.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Deal_Record_Type.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DealRegistrationProduct.Core_Opportunity_Product_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_Over_Inserted_OLis.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DealRegistrationProduct.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_Over_Inserted_OLis.Core_Design_Registration_Product_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Products_to_List</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>check_deal_eligible</name>
        <label>check deal eligible</label>
        <locationX>402</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Iterate_over_Deal_Product_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Deal_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Iterate_over_Deal_Product_Records.PCC_Deal_Eligible_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Deal_Eligible_value</targetReference>
            </connector>
            <label>Deal Eligible?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Opportunity_Exisits</name>
        <label>Check if Opportunity Exisits</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Opportunity_is_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Deal_Details.Core_Opportunity_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Deal_Products</targetReference>
            </connector>
            <label>Opportunity is not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Product_Id_Exists_on_PricebookEntry</name>
        <label>Check if Product Id Exists on PricebookEntry</label>
        <locationX>842</locationX>
        <locationY>1382</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product_Id_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_DRP_s.Core_Product_Id__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_through_Price_Pricebook_Entries.Product2Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Opportunity_Line_Item</targetReference>
            </connector>
            <label>Product Id Exists?</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_if_record_is_Inserted</name>
        <label>check if record is Inserted</label>
        <locationX>402</locationX>
        <locationY>2282</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_ID_not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Iterate_Over_Inserted_OLis.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Deal_Product</targetReference>
            </connector>
            <label>If ID not Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Eligible_for_Quote_Update</name>
        <label>Eligible for Quote Update</label>
        <locationX>182</locationX>
        <locationY>2882</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DealEligible</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_stage_record_for_Quote_Update</targetReference>
            </connector>
            <label>is Eligible?</label>
        </rules>
    </decisions>
    <description>This is the subflow  called for Deal Re-submission</description>
    <environments>Default</environments>
    <interviewLabel>Resubmission subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Resubmission subflow</label>
    <loops>
        <description>Iterate over Deal products to see if there are any deal products</description>
        <name>Iterate_over_Deal_Product_Records</name>
        <label>Iterate over Deal Product Records</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <collectionReference>Get_Deal_Products</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Product2Ids_to_List</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Pricebook_Entry_Record</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Iterate_Over_Inserted_OLis</name>
        <label>Iterate Over Inserted OLis</label>
        <locationX>182</locationX>
        <locationY>2174</locationY>
        <collectionReference>OpportunityLineItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>check_if_record_is_Inserted</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_DRP_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Iterate over Deal products to see if there are any deal products</description>
        <name>Loop_through_DRP_s</name>
        <label>Loop through DRP&apos;s</label>
        <locationX>182</locationX>
        <locationY>1166</locationY>
        <collectionReference>Get_Deal_Products</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Loop_through_Price_Pricebook_Entries</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Opportunity_Line_Items</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_through_Price_Pricebook_Entries</name>
        <label>Loop through Price Pricebook Entries</label>
        <locationX>622</locationX>
        <locationY>1274</locationY>
        <collectionReference>Get_Pricebook_Entry_Record</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_if_Product_Id_Exists_on_PricebookEntry</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_through_DRP_s</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
