<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Product2Ids_to_List</name>
        <label>Add Product2Ids to List</label>
        <locationX>402</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>Product2Ids</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Iterate_over_Deal_Product_Records.Core_Product_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>check_deal_eligible</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Products_to_List</name>
        <label>Add Products to List</label>
        <locationX>270</locationX>
        <locationY>2498</locationY>
        <assignmentItems>
            <assignToReference>DealRegistrationsProducts</assignToReference>
            <operator>Add</operator>
