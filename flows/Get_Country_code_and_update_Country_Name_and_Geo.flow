    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetGeoCodewithCountryName</name>
        <label>Get Geo Code with Country Name</label>
        <locationX>478</locationX>
        <locationY>236</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Country_Name_and_Geo</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>v_CountryName</elementReference>
            </value>
        </filters>
        <object>Core_Country_Reference__c</object>
        <outputAssignments>
            <assignToReference>GeoCode</assignToReference>
            <field>Core_Geo__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>GettheCountrynamewithNewRegistrationrecordCountryName</name>
        <label>Get the Country name with New Registration record Country Name</label>
        <locationX>313</locationX>
        <locationY>321</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GetGeoCodewithCountryName</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PRM_Country__c</elementReference>
            </value>
        </filters>
        <object>Core_Country_Code_Mapping__c</object>
        <outputAssignments>
            <assignToReference>v_CountryName</assignToReference>
            <field>Name</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_Country_Name_and_Geo</name>
        <label>Update Country Name and Geo</label>
        <locationX>614</locationX>
        <locationY>142</locationY>
        <inputAssignments>
            <field>Countries__c</field>
            <value>
                <elementReference>v_CountryName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Geo_Code__c</field>
            <value>
                <elementReference>GeoCode</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>GettheCountrynamewithNewRegistrationrecordCountryName</targetReference>
        </connector>
        <filterLogic>1 OR 2 OR 3</filterLogic>
        <filters>
            <field>PRM_Country__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Countries__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Geo_Code__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>c_ISOCode</name>
        <dataType>String</dataType>
