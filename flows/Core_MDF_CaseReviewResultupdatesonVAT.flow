    <decisions>
        <description>Check whether Claim is Denied</description>
        <name>Denied_Compliants</name>
        <label>Denied/Compliant</label>
        <locationX>1018</locationX>
        <locationY>398</locationY>
        <defaultConnector>
            <targetReference>getEachClaimRecord</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Deny_VAT_and_Claim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varVATRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TypeOfAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Denied</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_VAT_status_as_Denied</targetReference>
            </connector>
            <label>Deny VAT and Claim</label>
        </rules>
        <rules>
            <name>Compliant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TypeOfAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>isVATApprovedOrNot</targetReference>
            </connector>
            <label>Compliant</label>
        </rules>
        <rules>
            <name>Deny_Claim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varVATRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_Denied_Claims_when_VAT_Doesnt_Exist</targetReference>
            </connector>
            <label>Deny Claim</label>
        </rules>
    </decisions>
    <decisions>
        <name>ifVatAmountGreaterThanZero</name>
        <label>ifVatAmountGreaterThanZero</label>
        <locationX>930</locationX>
        <locationY>638</locationY>
        <defaultConnector>
            <targetReference>Release_Claim_from_Audit_Hold_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>currentClaimVatAmtGreaterThanZero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getEachClaimRecord.Core_MDF_VAT_Amt__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_Claim_On_VAT_Hold_and_Release_Audit_Hold_0</targetReference>
            </connector>
            <label>currentClaimVatAmtGreaterThanZero</label>
        </rules>
    </decisions>
    <decisions>
        <name>isVATApprovedOrNot</name>
        <label>isVATApprovedOrNot</label>
        <locationX>930</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>getEachClaimRecord</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isVATApproved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varVATRecord.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Release_Claim_from_Audit_Hold</targetReference>
            </connector>
            <label>isVATApproved</label>
        </rules>
        <rules>
            <name>isVATNotApproved</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varVATRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varVATRecord.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ifVatAmountGreaterThanZero</targetReference>
            </connector>
            <label>isVATNotApproved</label>
        </rules>
    </decisions>
    <decisions>
        <description>update claim collections and VAT collections if it is not null</description>
        <name>releaseClaimFromAudit</name>
        <label>releaseClaimFromAudit</label>
        <locationX>182</locationX>
