        </inputAssignments>
        <inputAssignments>
            <field>CRM_Last_Modified_Date__c</field>
            <value>
                <elementReference>$Record.LastModifiedDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Records</targetReference>
        </connector>
        <object>AccountPlan</object>
