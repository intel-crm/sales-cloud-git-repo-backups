    <decisions>
        <description>If the error description contains &apos;Provided crosswalk was not found within the entity&apos; message then the retry count will not be increased.</description>
        <name>Check_Error_Description</name>
        <label>Check Error Description</label>
        <locationX>1045</locationX>
        <locationY>1008</locationY>
        <defaultConnector>
            <targetReference>Increase_the_Retry_Count</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not contains specific message</defaultConnectorLabel>
        <rules>
            <name>contains_specific_message</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Error_Description</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>label_split_left</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Error_Description</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>label_split_right</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Status_to_Error_and_Retry_Count</targetReference>
            </connector>
            <label>Contains specific message</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_the_status</name>
        <label>Check the status</label>
        <locationX>737</locationX>
        <locationY>900</locationY>
        <defaultConnector>
            <targetReference>Check_Error_Description</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Status is False</defaultConnectorLabel>
        <rules>
            <name>Status_is_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>modified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Status_to_Success</targetReference>
            </connector>
            <label>Status is True</label>
        </rules>
    </decisions>
