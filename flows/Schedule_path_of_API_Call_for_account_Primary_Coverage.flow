        <defaultConnectorLabel>Not contains specific message</defaultConnectorLabel>
        <rules>
            <name>Copy_1_of_Contains_specific_message</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Error_Description__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>label_split_left</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Error_Description__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>label_split_right</elementReference>
                </rightValue>
            </conditions>
            <label>Contains specific message</label>
        </rules>
    </decisions>
    <description>This flow(scheduled path) is used for sending attribute update to Reltio, such as Account Primary Coverage, OPId.</description>
    <environments>Default</environments>
    <formulas>
        <name>additionalContentOPID</name>
        <dataType>String</dataType>
        <expression>LEFT($Record.Additional_Content__c, FIND(&apos;:&apos;, $Record.Additional_Content__c, 1) - 1)</expression>
    </formulas>
    <formulas>
        <name>additionalContentOPIDStatus</name>
        <dataType>Boolean</dataType>
        <expression>IF(MID($Record.Additional_Content__c, FIND(&apos;:&apos;, $Record.Additional_Content__c, 1) + 1, LEN($Record.Additional_Content__c)) == &apos;True&apos;, true, false)</expression>
    </formulas>
    <formulas>
        <description>Splitting the custom label to get the first value</description>
        <name>label_split_left</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Label.UCD_ACM_Reltio_Error_Message}, FIND(&quot;,&quot;, {!$Label.UCD_ACM_Reltio_Error_Message}) - 1)</expression>
    </formulas>
    <formulas>
        <description>Splitting the custom label to get the second value</description>
        <name>label_split_right</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT({!$Label.UCD_ACM_Reltio_Error_Message}, LEN({!$Label.UCD_ACM_Reltio_Error_Message}) - FIND(&quot;,&quot;, {!$Label.UCD_ACM_Reltio_Error_Message})))</expression>
    </formulas>
    <interviewLabel>Schedule path of API Call for account Primary Coverage {!$Flow.CurrentDateTime}</interviewLabel>
