<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Core_Update_MatchOppKPI_BackendField workflow rule
Workflow rule description: &quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Update_MatchOppKPI_Backend_fieldFormula</name>
        <dataType>String</dataType>
        <expression>IF( {!$Record.Core_Opportunity__c} != null,  IF(  {!$Record.Core_Goal_KPI_Achieved_Flag__c}== FALSE &amp;&amp; {!$Record.Core_Goal_KPI_Match_Flag__c}== FALSE,&apos;No KPI Match&apos;, IF(  {!$Record.Core_Goal_KPI_Achieved_Flag__c}== FALSE &amp;&amp; {!$Record.Core_Goal_KPI_Match_Flag__c}== TRUE, &apos;KPI Not Achieved&apos;, IF(  {!$Record.Core_Goal_KPI_Achieved_Flag__c}== TRUE &amp;&amp; {!$Record.Core_Goal_KPI_Match_Flag__c}== TRUE, &apos;KPI Achieved&apos;,&apos;&apos; ))),&apos;&apos;)</expression>
    </formulas>
    <label>Core_Update_MatchOppKPI_BackendField</label>
    <migratedFromWorkflowRuleName>Core_Update_MatchOppKPI_BackendField</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <inputAssignments>
            <field>Core_MatchOppKPI_Backend__c</field>
            <value>
                <elementReference>Core_Update_MatchOppKPI_Backend_fieldFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.Core_Goal_KPI_Achieved_Flag__c}) || ISCHANGED({!$Record.Core_Goal_KPI_Match_Flag__c})</filterFormula>
        <object>Core_Goal__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>1500</triggerOrder>
</Flow>
