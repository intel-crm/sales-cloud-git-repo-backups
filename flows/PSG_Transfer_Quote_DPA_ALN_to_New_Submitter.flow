            <dataType>String</dataType>
            <fieldText>Object</fieldText>
            <fieldType>DropdownBox</fieldType>
            <helpText>&lt;p&gt;&lt;strong&gt;Select the below object for record transfer:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Quote&lt;/strong&gt;- To transfer only quotes records.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;DPAs/ALNs&lt;/strong&gt;- To transfer only DPAs/ALNs records.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Both&lt;/strong&gt;- To Transfer Both Quotes and DPAs/ALNs records.&lt;/p&gt;</helpText>
