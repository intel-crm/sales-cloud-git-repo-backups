<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Transfer_Records</name>
        <label>Transfer Records</label>
        <locationX>842</locationX>
        <locationY>1106</locationY>
        <actionName>PSG_TransferSubmitter</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Finish</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>submitterDetails</name>
            <value>
                <elementReference>SubmitterDetails</elementReference>
            </value>
        </inputParameters>
        <nameSegment>PSG_TransferSubmitter</nameSegment>
    </actionCalls>
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Error_Message</name>
        <label>Assign Error Message</label>
        <locationX>50</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SAME_SUBMITTER_MESSAGE</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>errorScreen</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Submitter_IDs_Name</name>
        <label>Assign Submitter IDs &amp; Name</label>
        <locationX>842</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>fromSubmitterRecord</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fromSubmitter.recordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>fromSubmitterRecord</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fromSubmitter.recordName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>toNewSubmitterRecord</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>toNewSubmitter.recordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>toNewSubmitterRecord</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>toNewSubmitter.recordName</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Value_In_List</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Value_In_List</name>
        <label>Assign Value In List</label>
        <locationX>842</locationX>
        <locationY>998</locationY>
        <assignmentItems>
            <assignToReference>SubmitterDetails</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fromSubmitterRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SubmitterDetails</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>toNewSubmitterRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SubmitterDetails</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Object_choice</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Transfer_Records</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>Both</name>
        <choiceText>Both</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Both</stringValue>
        </value>
    </choices>
    <choices>
        <name>DPAs_ALNs</name>
        <choiceText>DPAs/ALNs</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>DPAs_ALNs</stringValue>
        </value>
    </choices>
    <choices>
        <name>Quote</name>
        <choiceText>Quote</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Quote</stringValue>
        </value>
    </choices>
    <constants>
        <name>SAME_SUBMITTER_MESSAGE</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Old and New submitters cannot be the same</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Validation_for_Submitter</name>
        <label>Validation for Submitter</label>
        <locationX>446</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Confirmation_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Validation Pass</defaultConnectorLabel>
        <rules>
            <name>Same_Submitter</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fromSubmitter.recordId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>toNewSubmitter.recordId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Error_Message</targetReference>
            </connector>
            <label>Same Submitter</label>
        </rules>
        <rules>
            <name>Disty_with_different_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FromSubmitterRecordDetails.AccountId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>ToSubmitterRecordDetails.AccountId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Disty_with_different_account_validation_screen</targetReference>
            </connector>
            <label>Disty with different Account</label>
        </rules>
        <rules>
            <name>Is_Partner_user</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_FromSubmitter_User_Details</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_ToSubmitter_User_Details</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Partner_Validation_screen</targetReference>
            </connector>
            <label>Is Partner user</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PSG Transfer Quote/DPA/ALN to New Submitter {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PSG Record Transfer Flow</label>
    <processMetadataValues>
