<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Do_Not_Delete_Design_Deal_Product</name>
        <label>Do Not Delete Design-Deal Product</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <customErrorMessages>
            <errorMessage>Deal Registration Product cannot be deleted.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_Design_Deal_Status</name>
        <label>Check Design-Deal Status</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Design_Deal_Status_is_Submitted</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Accepted_By_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Do_Not_Delete_Design_Deal_Product</targetReference>
            </connector>
            <label>Design-Deal Status is Submitted</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PCC_Delete_DealProductBeforeDelete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PCC_Delete_DealProductBeforeDelete</label>
    <processMetadataValues>
