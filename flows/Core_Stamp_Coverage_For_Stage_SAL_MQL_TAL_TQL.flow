    <decisions>
        <description>Check if Current Status is SAL</description>
        <name>Check_if_Current_Status_is_SAL</name>
        <label>Check if Current Status is SAL</label>
        <locationX>182</locationX>
        <locationY>1103</locationY>
        <defaultConnector>
            <targetReference>Update_TAL_Coverage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_TQL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Accepted Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_TQL_Coverage</targetReference>
            </connector>
            <label>Update TQL</label>
        </rules>
    </decisions>
