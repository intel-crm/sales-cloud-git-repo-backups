    <description>Core_Stamp_Coverage_For_Stage_SAL_MQL_TAL_TQL</description>
    <environments>Default</environments>
    <formulas>
        <description>Core_Coverage_MAQL_FastTrack1</description>
        <name>Core_Coverage_MAQL_FastTrack1</name>
        <dataType>String</dataType>
        <expression>IF(AND (ISPICKVAL({!$Record__Prior.Status},&quot;Marketing Qualified Lead&quot;), ISPICKVAL({!$Record.Status}, &quot;Sales Accepted Lead&quot;), {!$Record.RecordType.Name} = &quot;Lead&quot; ), 
 (IF(ISBLANK (TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))),{!$Record.Core_Locked_TAL_Coverage__c})</expression>
    </formulas>
    <formulas>
        <description>Core_Coverage_MAQL_FastTrack2</description>
        <name>Core_Coverage_MAQL_FastTrack2</name>
        <dataType>String</dataType>
        <expression>IF(AND (ISPICKVAL({!$Record__Prior.Status},&quot;Marketing Qualified Lead&quot;), ISPICKVAL({!$Record.Status}, &quot;Sales Accepted Lead&quot;), {!$Record.RecordType.Name} = &quot;Lead&quot; ), 
 (IF(ISBLANK (TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))),{!$Record.Core_Locked_TQL_Coverage__c})</expression>
    </formulas>
    <formulas>
        <description>Core_Coverage_TAL_SAL_FastTrack</description>
        <name>Core_Coverage_TAL_SAL_FastTrack</name>
        <dataType>String</dataType>
        <expression>IF(AND (ISPICKVAL({!$Record__Prior.Status},&quot;Tele Accepted Lead&quot;), ISPICKVAL({!$Record.Status}, &quot;Sales Accepted Lead&quot;)), 
 (IF(ISBLANK (TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))),{!$Record.Core_Locked_TQL_Coverage__c})</expression>
    </formulas>
    <formulas>
        <description>Update MQL Lead Coverage</description>
        <name>UpdateMQLLeadCoverage</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record__Prior.Status},&quot;Marketing Qualified Lead&quot;), (IF(ISBLANK (TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))),{!$Record.Core_Locked_MQL_Coverage__c})</expression>
    </formulas>
    <formulas>
        <description>Update SAL</description>
        <name>UpdateSAL</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record__Prior.Status},&quot;Sales Accepted Lead&quot;), (IF(ISBLANK (TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))),{!$Record.Core_Locked_SAL_Coverage__c})</expression>
    </formulas>
    <formulas>
        <description>Update TAL Lead Coverage</description>
        <name>UpdateTALLeadCoverage</name>
        <dataType>String</dataType>
        <expression>IF(AND(ISPICKVAL({!$Record__Prior.Status}, &quot;Tele Accepted Lead&quot;), ISCHANGED({!$Record.Status})), (IF(ISBLANK(TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))),{!$Record.Core_Locked_TAL_Coverage__c})</expression>
    </formulas>
    <formulas>
        <description>Update TQL Lead Coverage</description>
        <name>UpdateTQLLeadCoverage</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record__Prior.Status},&quot;Tele Qualified Lead&quot;), (IF(ISBLANK (TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))),{!$Record.Core_Locked_TQL_Coverage__c})</expression>
    </formulas>
    <formulas>
        <description>Update Unqualified Lead Coverage</description>
        <name>UpdateUnqualifiedLeadCoverage</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record__Prior.Status},&quot;Unqualified&quot;), (IF(ISBLANK (TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))),{!$Record.Core_Locked_Unqualified_Coverage__c})</expression>
    </formulas>
    <formulas>
        <name>UserCoverage</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK (TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))</expression>
    </formulas>
    <interviewLabel>Core_Stamp_Coverage_For_Stage_SAL_MQL_TAL_TQL {!$Flow.CurrentDateTime}</interviewLabel>
