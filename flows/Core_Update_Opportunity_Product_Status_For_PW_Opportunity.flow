<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Date_submitted_for_Approval</name>
        <label>Check  Date submitted for Approval</label>
        <locationX>446</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PW_submission_Date_is_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Date_Submitted_for_Approval__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_First_Customer_ship_Date</targetReference>
            </connector>
            <label>PW submission Date is not null</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check PW approval status and update associated products accordingly.</description>
        <name>Core_Check_PW_Approval_Status</name>
        <label>Check PW Approval Status</label>
        <locationX>710</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_PW_Approval_Submitted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_PW_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Update_products_to_Production_Win_Submitted</targetReference>
            </connector>
            <label>PW_Approval_Submitted</label>
        </rules>
        <rules>
            <name>Core_PW_Approval_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_PW_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Update_products_to_Production_Win_Approved</targetReference>
            </connector>
            <label>PW_Approval_Approved</label>
        </rules>
        <rules>
            <name>Core_PW_Approval_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_PW_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Update_products_back_to_Win_Approved</targetReference>
            </connector>
            <label>PW_Approval_Rejected</label>
        </rules>
        <rules>
            <name>Core_PW_Approval_Recalled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_PW_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Recalled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Update_products_back_to_Win_Approved_on_Recall</targetReference>
            </connector>
            <label>PW_Approval_Recalled</label>
        </rules>
    </decisions>
    <description>Removed 6QPS Retriggering Logic</description>
    <environments>Default</environments>
    <formulas>
        <name>FirstCustomershipDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE( {!$Record.Core_First_Customer_Ship_Date__c})</expression>
    </formulas>
    <interviewLabel>Update Opportunity Product Status For PW_Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Opportunity Product Status For PW_Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_Update_products_back_to_Win_Approved</name>
        <label>Update products back to Win Approved</label>
        <locationX>842</locationX>
        <locationY>431</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Production Win Submitted</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Production_Claim_Date__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <stringValue>Win Approved</stringValue>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordUpdates>
    <recordUpdates>
        <name>Core_Update_products_back_to_Win_Approved_on_Recall</name>
        <label>Update products back to Win Approved on Recall</label>
        <locationX>1106</locationX>
        <locationY>431</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Production Win Submitted</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Production_Claim_Date__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <stringValue>Win Approved</stringValue>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordUpdates>
    <recordUpdates>
        <name>Core_Update_products_to_Production_Win_Approved</name>
        <label>Update products to Production Win Approved</label>
        <locationX>446</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Check_Date_submitted_for_Approval</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Production Win Submitted</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <stringValue>Production Win Approved</stringValue>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordUpdates>
    <recordUpdates>
        <name>Core_Update_products_to_Production_Win_Submitted</name>
        <label>Update products to Production Win Submitted</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Win Approved</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <stringValue>Production Win Submitted</stringValue>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_First_Customer_ship_Date</name>
        <label>Update First Customer ship Date</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Production Win</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_First_Customer_Ship_Date__c</field>
            <value>
                <elementReference>$Record.Core_Date_Submitted_for_Approval__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>584</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_Check_PW_Approval_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_PW_Approval_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
