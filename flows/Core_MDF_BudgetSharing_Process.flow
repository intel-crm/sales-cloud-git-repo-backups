    <description>This PB is used to give access to Internal and External groups for Budgets.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(
ISNEW(), 
AND(
NOT(ISNEW()),
OR(ISCHANGED([PartnerMarketingBudget].OwnerId),
AND(ISCHANGED([PartnerMarketingBudget].Core_MDF_Budget_Status__c ),ISPICKVAL([PartnerMarketingBudget].Core_MDF_Budget_Status__c,&apos;Released&apos;) 
)
)
)
)  </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>OR(
ISNEW(), 
AND(
NOT(ISNEW()),
OR(ISCHANGED({!myVariable_current.OwnerId}),
AND(ISCHANGED({!myVariable_current.Core_MDF_Budget_Status__c} ),ISPICKVAL({!myVariable_current.Core_MDF_Budget_Status__c},&apos;Released&apos;) 
)
)
)
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	NOT(ISNEW()),
        ISCHANGED([PartnerMarketingBudget].Core_MDF_Budget_Status__c ),
        ISPICKVAL([PartnerMarketingBudget].Core_MDF_Budget_Status__c,&apos;Released&apos;) 
	)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	NOT(ISNEW()),
        ISCHANGED({!myVariable_current.Core_MDF_Budget_Status__c} ),
        ISPICKVAL({!myVariable_current.Core_MDF_Budget_Status__c},&apos;Released&apos;) 
	)</expression>
    </formulas>
