        <locationX>528</locationX>
        <locationY>99</locationY>
        <flowName>Core_MDF_FL_Log_Errors_From_Flows</flowName>
        <inputAssignments>
            <name>Core_MDF_Details</name>
            <value>
                <elementReference>Core_MDF_Details2</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>Core_MDF_Message</name>
            <value>
                <elementReference>Core_MDF_Decision_Name2</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>Core_MDF_Origin</name>
