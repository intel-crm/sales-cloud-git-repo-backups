        </inputAssignments>
        <inputAssignments>
            <name>Core_MDF_When</name>
            <value>
                <elementReference>Core_MDF_DateTime</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <description>This Sub flow will create the log entry records</description>
        <name>Core_MDF_Creates_log_entry_records</name>
        <label>Creates log entry records</label>
        <locationX>362</locationX>
        <locationY>32</locationY>
        <flowName>Core_MDF_FL_Log_Errors_From_Flows</flowName>
        <inputAssignments>
            <name>Core_MDF_Details</name>
            <value>
                <elementReference>Core_MDF_Details1</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>Core_MDF_Message</name>
            <value>
                <elementReference>Core_MDF_Decision_Name1</elementReference>
