        </inputAssignments>
    </subflows>
    <variables>
        <description>Stores the Date and Time value</description>
        <name>Core_MDF_DateTime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <elementReference>$Flow.CurrentDateTime</elementReference>
        </value>
    </variables>
    <variables>
        <description>Stores the Decision Name</description>
        <name>Core_MDF_Decision_Name1</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>Core_MDF_Check_if_vIntelAccountId_is_NOT_NULL</stringValue>
        </value>
    </variables>
    <variables>
        <name>Core_MDF_Decision_Name2</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>Core_MDF_Check_if_sCollPGMList_is_NOT_NULL</stringValue>
        </value>
    </variables>
    <variables>
        <name>Core_MDF_Decision_Name3</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>Core_MDF_Check_if_sCollPFRShareToBeInserted_has_values</stringValue>
        </value>
    </variables>
    <variables>
        <description>Stores the Flow Name</description>
        <name>Core_MDF_Flow_Name</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>Core_MDF_CreatePFRShareForInternalAccountManagers Flow</stringValue>
        </value>
    </variables>
    <variables>
        <description>Stores the Severity value</description>
        <name>Core_MDF_Severity</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>Critical</stringValue>
        </value>
    </variables>
    <variables>
        <description>This will contain all the PFR Share records to be inserted.</description>
        <name>sCollPFRShareToBeInserted</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundRequestShare</objectType>
    </variables>
    <variables>
        <description>This will contain the PGM records list fetched.</description>
        <name>sCollPGMList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_Partner_Group_Mapping__c</objectType>
    </variables>
    <variables>
        <description>This will contain the PFR Share record to be inserted.</description>
        <name>sPFRShareTemp</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundRequestShare</objectType>
    </variables>
    <variables>
