        </inputAssignments>
        <inputAssignments>
            <name>Core_MDF_Severity</name>
            <value>
                <elementReference>Core_MDF_Severity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>Core_MDF_When</name>
            <value>
                <elementReference>Core_MDF_DateTime</elementReference>
