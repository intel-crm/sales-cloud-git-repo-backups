        <inputAssignments>
            <name>Core_MDF_When</name>
            <value>
                <elementReference>Core_MDF_DateTime</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <description>Creates the log entry records</description>
        <name>Core_MDF_Creates_log_entry_record</name>
