<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Core_MDF_Add_it_to_PFRShare_Record</name>
        <label>Add it to PFRShare Record</label>
        <locationX>631</locationX>
        <locationY>155</locationY>
        <assignmentItems>
            <assignToReference>sPFRShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>vPFRId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sPFRShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>sPGM.Core_MDF_Group_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sPFRShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Add_sPFRShareTemp_to_sCollPFRShareToBeInserted</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Core_MDF_Add_sPFRShareTemp_to_sCollPFRShareToBeInserted</name>
        <label>Add sPFRShareTemp to sCollPFRShareToBeInserted</label>
        <locationX>876</locationX>
        <locationY>254</locationY>
        <assignmentItems>
            <assignToReference>sCollPFRShareToBeInserted</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>sPFRShareTemp</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Make_the_PFRShare_Record_as_Blank</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Core_MDF_Make_the_PFRShare_Record_as_Blank</name>
        <label>Make the PFRShare Record as Blank</label>
        <locationX>633</locationX>
        <locationY>253</locationY>
        <assignmentItems>
            <assignToReference>sPFRShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sPFRShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sPFRShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_through_sCollPGMList</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Core_MDF_Check_if_sCollPFRShareToBeInserted_has_values</name>
        <label>Check if sCollPFRShareToBeInserted has values</label>
        <locationX>389</locationX>
        <locationY>364</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Create_log_entry_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_sCollPFRShareToBeInserted_is_NOT_EMPTY</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollPFRShareToBeInserted</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Insert_sCollPFRShareToBeInserted</targetReference>
            </connector>
            <label>sCollPFRShareToBeInserted is NOT EMPTY</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_sCollPGMList_is_NOT_NULL</name>
        <label>Check if sCollPGMList is NOT NULL</label>
        <locationX>389</locationX>
        <locationY>155</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Creates_log_entry_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_sCollPGMList_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollPGMList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Loop_through_sCollPGMList</targetReference>
            </connector>
            <label>sCollPGMList is NOT NULL</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_vIntelAccountId_is_NOT_NULL</name>
        <label>Check if vIntelAccountId is NOT NULL</label>
        <locationX>180</locationX>
        <locationY>31</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Creates_log_entry_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_if_vIntelAccountId_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vIntelAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_the_PGM_records_0</targetReference>
            </connector>
            <label>if vIntelAccountId is NOT NULL</label>
        </rules>
    </decisions>
    <description>This flow will share the PFR records with Internal Account Managers group.</description>
    <environments>Default</environments>
    <formulas>
        <description>Stores the Flow name, Decision name and Account Record ID</description>
        <name>Core_MDF_Details1</name>
        <dataType>String</dataType>
        <expression>&quot;Flow : &quot;+{!Core_MDF_Flow_Name} +&quot;, Decision : &quot;+{!Core_MDF_Decision_Name1} +&quot;, Record ID : &quot;+{!vPFRId}</expression>
    </formulas>
    <formulas>
        <description>Stores the information of Flow name, Decision name and PGM list ID</description>
        <name>Core_MDF_Details2</name>
        <dataType>String</dataType>
        <expression>&quot;Flow : &quot;+{!Core_MDF_Flow_Name} +&quot;, Decision : &quot;+{!Core_MDF_Decision_Name2} +&quot;, Record ID : &quot;+{!vPFRId}</expression>
    </formulas>
    <formulas>
        <description>Stores the information of Flow name, Decision name and PFR share ID</description>
        <name>Core_MDF_Details3</name>
        <dataType>String</dataType>
        <expression>&quot;Flow : &quot;+{!Core_MDF_Flow_Name} +&quot;, Decision : &quot;+{!Core_MDF_Decision_Name3} +&quot;, Record ID : &quot;+{!vPFRId}</expression>
    </formulas>
    <interviewLabel>Core_MDF_CreatePFRShareForInternalAccountManagers {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_CreatePFRShareForInternalAccountManagers</label>
    <loops>
        <name>Core_MDF_Loop_through_sCollPGMList</name>
        <label>Loop through sCollPGMList</label>
        <locationX>389</locationX>
        <locationY>253</locationY>
        <assignNextValueToReference>sPGM</assignNextValueToReference>
        <collectionReference>sCollPGMList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_MDF_Add_it_to_PFRShare_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_MDF_Check_if_sCollPFRShareToBeInserted_has_values</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Insert_sCollPFRShareToBeInserted</name>
        <label>Insert sCollPFRShareToBeInserted</label>
        <locationX>390</locationX>
        <locationY>488</locationY>
        <inputReference>sCollPFRShareToBeInserted</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Core_MDF_Fetch_the_PGM_records_0</name>
        <label>Fetch the PGM records</label>
        <locationX>180</locationX>
        <locationY>155</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Check_if_sCollPGMList_is_NOT_NULL</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vIntelAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vProgram</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Group_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Region_cd__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Partner_Group_Mapping__c</object>
        <outputReference>sCollPGMList</outputReference>
        <queriedFields>Core_MDF_Group_Id__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Core_MDF_Check_if_vIntelAccountId_is_NOT_NULL</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
