<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_tO_Paid</name>
        <label>Set tO Paid</label>
        <locationX>496</locationX>
        <locationY>311</locationY>
        <assignmentItems>
            <assignToReference>varPfcRecord.Core_MDF_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Claim_Records</targetReference>
        </connector>
    </assignments>
    <interviewLabel>pfcClaimMultiselect {!$Flow.CurrentDateTime}</interviewLabel>
    <label>pfcClaimMultiselect</label>
    <loops>
        <name>Loop_through_claims</name>
        <label>Loop through claims</label>
        <locationX>181</locationX>
        <locationY>251</locationY>
        <assignNextValueToReference>varPfcRecord</assignNextValueToReference>
        <collectionReference>varClaimRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_tO_Paid</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Update_Claim_Records</name>
        <label>Update Claim Records</label>
        <locationX>520</locationX>
        <locationY>510</locationY>
        <inputReference>varClaimRecords</inputReference>
    </recordUpdates>
    <screens>
        <name>Show_Values</name>
        <label>Show Values</label>
        <locationX>757</locationX>
        <locationY>338</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>claims_status</name>
            <fieldText>&lt;p&gt;{!varPfcRecord.Core_MDF_Status__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Loop_through_claims</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varClaimIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varClaimRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>varPfcRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
</Flow>
