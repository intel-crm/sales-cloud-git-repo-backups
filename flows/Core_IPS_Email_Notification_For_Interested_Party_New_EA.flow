    <description>While interested party member add in case team mail will send to Recently Added Member.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (
	ISPICKVAL([Core_IPS_Case_Interested_Party__c].Type__c ,&apos;External&apos;),

	NOT(ISBLANK( [Core_IPS_Case_Interested_Party__c].User__c)),
	
	[Core_IPS_Case_Interested_Party__c].Case__c.Core_IPS_Is_Notification_Active__c = TRUE,

	[Core_IPS_Case_Interested_Party__c].Case__c.Core_IPS_Customer_Visible__c = TRUE,

	[Core_IPS_Case_Interested_Party__c].Case__c.RecordType.DeveloperName = $Label.Core_IPS_CaseCreateRecordType_Name,

	OR( ISPICKVAL([Core_IPS_Case_Interested_Party__c].Case__c.Status, &apos;New&apos;) ,
		ISPICKVAL([Core_IPS_Case_Interested_Party__c].Case__c.Status, &apos;Open&apos;) 
	),
  
	IF( ISBLANK([Core_IPS_Case_Interested_Party__c].Contact__c), FALSE, 
		AND( [Core_IPS_Case_Interested_Party__c].Contact__c.Core_IPS_Active__c = TRUE,
			 [Core_IPS_Case_Interested_Party__c].Contact__c.Core_IPS_Email_Opt_Out__c = FALSE
		)
	),
	
	[Core_IPS_Case_Interested_Party__c].Core_IPS_Project_Interested_Party__c = FALSE
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND (
	ISPICKVAL({!myVariable_current.Type__c} ,&apos;External&apos;),

	NOT(ISBLANK( {!myVariable_current.User__c})),
	
	{!myVariable_current.Case__r.Core_IPS_Is_Notification_Active__c} = TRUE,

	{!myVariable_current.Case__r.Core_IPS_Customer_Visible__c} = TRUE,

	{!myVariable_current.Case__r.RecordType.DeveloperName} = {!$Label.Core_IPS_CaseCreateRecordType_Name},

	OR( ISPICKVAL({!myVariable_current.Case__r.Status}, &apos;New&apos;) ,
		ISPICKVAL({!myVariable_current.Case__r.Status}, &apos;Open&apos;) 
	),
  
	IF( ISBLANK({!myVariable_current.Contact__c}), FALSE, 
		AND( {!myVariable_current.Contact__r.Core_IPS_Active__c} = TRUE,
			 {!myVariable_current.Contact__r.Core_IPS_Email_Opt_Out__c} = FALSE
		)
	),
	
	{!myVariable_current.Core_IPS_Project_Interested_Party__c} = FALSE
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (
	ISPICKVAL([Core_IPS_Case_Interested_Party__c].Type__c ,&apos;Internal&apos;),

	NOT(ISBLANK([Core_IPS_Case_Interested_Party__c].User__c)),
	
	[Core_IPS_Case_Interested_Party__c].Case__c.Core_IPS_Is_Notification_Active__c = TRUE,

	OR([Core_IPS_Case_Interested_Party__c].Case__c.RecordType.DeveloperName = $Label.Core_IPS_CaseCreateRecordType_Name,
	   [Core_IPS_Case_Interested_Party__c].Case__c.RecordType.DeveloperName = $Label.Core_IPS_NoAssignedContactRecordType_Name,
	   [Core_IPS_Case_Interested_Party__c].Case__c.RecordType.DeveloperName = $Label.Core_IPS_GECRecordTypeName
	),

	OR( ISPICKVAL([Core_IPS_Case_Interested_Party__c].Case__c.Status, &apos;New&apos;),
		ISPICKVAL([Core_IPS_Case_Interested_Party__c].Case__c.Status, &apos;Open&apos;),
		ISPICKVAL([Core_IPS_Case_Interested_Party__c].Case__c.Status, &apos;On Hold&apos;) 
	),

	[Core_IPS_Case_Interested_Party__c].Core_IPS_Project_Interested_Party__c = FALSE
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND (
	ISPICKVAL({!myVariable_current.Type__c} ,&apos;Internal&apos;),

	NOT(ISBLANK({!myVariable_current.User__c})),
	
	{!myVariable_current.Case__r.Core_IPS_Is_Notification_Active__c} = TRUE,

	OR({!myVariable_current.Case__r.RecordType.DeveloperName} = {!$Label.Core_IPS_CaseCreateRecordType_Name},
	   {!myVariable_current.Case__r.RecordType.DeveloperName} = {!$Label.Core_IPS_NoAssignedContactRecordType_Name},
	   {!myVariable_current.Case__r.RecordType.DeveloperName} = {!$Label.Core_IPS_GECRecordTypeName}
	),

	OR( ISPICKVAL({!myVariable_current.Case__r.Status}, &apos;New&apos;),
		ISPICKVAL({!myVariable_current.Case__r.Status}, &apos;Open&apos;),
		ISPICKVAL({!myVariable_current.Case__r.Status}, &apos;On Hold&apos;) 
	),

	{!myVariable_current.Core_IPS_Project_Interested_Party__c} = FALSE
)</expression>
    </formulas>
