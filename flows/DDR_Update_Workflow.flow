            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Registration_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Registration</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Partner_Account_Region_Cd__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>INDIA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_workflow_status_Status_to_Pre_Approved</targetReference>
            </connector>
            <label>Update workflow status and status to &apos;Pre-Approved&apos;</label>
        </rules>
        <rules>
            <name>Update_workflow_status_to_Completed</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 OR 6) AND 5</conditionLogic>
