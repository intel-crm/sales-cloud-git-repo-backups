            </connector>
            <label>Update workflow status to &apos;Completed&apos;</label>
        </rules>
        <rules>
            <name>Update_flow_status_to_Submitted</name>
            <conditionLogic>11 AND ((1 AND 2 AND 4 AND 5 AND 13 AND 6 AND 12 AND 7 AND 8 AND 3) OR (1 AND 6  AND 12 AND 7 AND 8 AND (2 OR 9 OR 10)))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Product_Group_Nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Product_Group_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
