        <locationX>1590</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_workflow_status_to_PreApproved</name>
            <conditionLogic>7 AND ((1 AND(2 OR 6)) OR (1 AND 3 AND (4 OR 5 OR 8)))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Product_Group_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FPGA/Power</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Product_Group_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Embedded/IOT</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Partner_Account_Region_Cd__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
