    <actionCalls>
        <name>Send_Account_Benefit_Details_Update</name>
        <label>Send Account Benefit Details - Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Core_MDF_Account_PGM_Sync</actionName>
        <actionType>apex</actionType>
        <dataTypeMappings>
            <typeName>T__recordDetail</typeName>
            <typeValue>PRM_AccountBenefitAssociation__c</typeValue>
        </dataTypeMappings>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>dmlOperationType</name>
            <value>
                <stringValue>Update</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>objectApiName</name>
            <value>
                <stringValue>PRM_AccountBenefitAssociation__c</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordDetail</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Account_PGM_Sync</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Bypass</name>
        <label>Check Bypass</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Bypass_inactive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Bypass_PGM_Sync.Core_Active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opt_Account_Benefit_Assoc</targetReference>
            </connector>
            <label>Bypass inactive</label>
        </rules>
    </decisions>
    <decisions>
        <description>To check whether this is a Insert/Update scenario.</description>
        <name>Filter_Records</name>
        <label>Filter Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Insert</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_IPA_Benefits.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Account_Benefit_Details_Insert</targetReference>
            </connector>
            <label>Is Insert?</label>
        </rules>
        <rules>
            <name>Is_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>StatusValueChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_IPA_Benefits.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Account_Benefit_Details_Update</targetReference>
            </connector>
            <label>Is Update?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opt_check</name>
        <label>Opt check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>opt_in_true</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Opt_Account_Benefit_Assoc.Core_MDF_Value_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>true</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_IPA_Benefits</targetReference>
            </connector>
            <label>opt in true</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>To store the Benefit Name from the ABA record. Used to match with the Budget Type Benefit Mapping record.</description>
        <name>BenefitName</name>
        <dataType>String</dataType>
        <expression>{!$Record.PRM_Partner_Benefit_Id__r.PRM_Benefit_Cd__c}</expression>
    </formulas>
    <formulas>
        <description>Used to check whether this is a new record or not.</description>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>Used to detect change in Status of an ABA record.</description>
        <name>StatusValueChanged</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(
        TEXT(PRIORVALUE({!$Record.PRM_Status_Nm__c})) = &quot;Active&quot;,
        TEXT({!$Record.PRM_Status_Nm__c}) = &quot;Inactive&quot;
    ),
    AND(
        TEXT(PRIORVALUE({!$Record.PRM_Status_Nm__c})) = &quot;Inactive&quot;,
        TEXT({!$Record.PRM_Status_Nm__c}) = &quot;Active&quot;
    )
)</expression>
    </formulas>
    <interviewLabel>Account Benefit Association Flow Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Benefit Association Flow Trigger</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Bypass_PGM_Sync</name>
        <label>Bypass PGM Sync</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Bypass</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_MDF_BypassBenefitCheck</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Trigger_Executions__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Query on Budget Type Benefit Mapping custom setting to get the correct record.</description>
        <name>Get_IPA_Benefits</name>
        <label>Get IPA Benefits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Filter_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Program_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Partner Alliance</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_IsActive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Partner_Benefit__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>BenefitName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_BudgetType_Benefit_Mappings__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Opt_Account_Benefit_Assoc</name>
        <label>Opt Account Benefit Assoc</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Opt_check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_MDF_OptAccountBenefitAssoc</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_Custom_Label_Configration__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Bypass_PGM_Sync</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Record.PRM_Account_Id__r.RecordType.DeveloperName} == &quot;Core_Partner_Account_Group&quot;,
    NOT(ISBLANK({!$Record.PRM_Partner_Benefit_Id__c})),
    NOT(ISBLANK({!$Record.PRM_Partner_Benefit_Id__r.PRM_Benefit_Cd__c}))
)</filterFormula>
        <object>PRM_AccountBenefitAssociation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
