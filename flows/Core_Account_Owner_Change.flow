    <decisions>
        <name>Core_AOC_Check_for_Integration_user</name>
        <label>Check for Integration user</label>
        <locationX>77</locationX>
        <locationY>411</locationY>
        <defaultConnector>
            <targetReference>Core_AOC_Change_Account_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Change Owner</defaultConnectorLabel>
        <rules>
            <name>Core_AOC_Make_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ownId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>intUser</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ownActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_AOC_Email_Change_Request</targetReference>
            </connector>
            <label>Make Request</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_AOC_Parameter_Check</name>
        <label>Parameter Check</label>
        <locationX>78</locationX>
        <locationY>27</locationY>
        <defaultConnector>
            <targetReference>Core_AOC_Get_Account_Info</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Parameters Available</defaultConnectorLabel>
        <rules>
            <name>Core_AOC_Null_Params</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>acctId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>acctId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_AOC_Close_Screen</targetReference>
            </connector>
            <label>Null_Params</label>
        </rules>
    </decisions>
    <label>Account Owner Change</label>
