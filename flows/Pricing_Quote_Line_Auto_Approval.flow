    <decisions>
        <name>Pricing_Check_for_FSE_Action</name>
        <label>Check for FSE Action</label>
        <locationX>380</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Pricing_PIFR_Rejection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Auto_Approve</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Additional_Comments_Txt__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>#autoapprove</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_PIFR_Approval</targetReference>
            </connector>
            <label>Auto Approve</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricing_Check_for_QuoteLine_Status</name>
        <label>Check for QuoteLine Status</label>
        <locationX>776</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Pricing_Check_for_RPM_Action</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pending_Intel_Field_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Intel Field Review</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_Check_for_FSE_Action</targetReference>
            </connector>
            <label>Pending Intel Field Review</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricing_Check_for_RPM_Action</name>
        <label>Check for RPM Action</label>
        <locationX>1172</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Pricing_PFIR_Rejection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Auto_Approve_Create_Deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Additional_Comments_Txt__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>#autoapprove</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_Check_for_Write_In_Product_for_PFIR</targetReference>
            </connector>
            <label>Auto Approve/Create Deal</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricing_Check_for_Write_In_Product_for_PFIR</name>
        <label>Check for Write In Product for PFIR</label>
        <locationX>974</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>Pricing_PFIR_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pricing_Is_not_Write_In_for_PFIR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Other_Product_Nm__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_PFIR_Create_Deal</targetReference>
            </connector>
            <label>Is not Write In?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricing_Check_for_Write_In_Product_for_PIFR</name>
        <label>Check for Write In Product for PIFR Approval</label>
        <locationX>182</locationX>
        <locationY>611</locationY>
        <defaultConnector>
            <targetReference>Pricing_RPM_Approval_for_PIFR</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_not_Write_In</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Other_Product_Nm__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_Create_Deal_for_PIFR</targetReference>
            </connector>
            <label>Is not Write In?</label>
        </rules>
    </decisions>
    <description>Flow Orchestration for Auto approving Quotelines based on condition.</description>
    <environments>Default</environments>
    <interviewLabel>Quote Line Auto Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Line Auto Approval</label>
