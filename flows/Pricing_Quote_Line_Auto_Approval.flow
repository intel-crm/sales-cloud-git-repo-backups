<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Pricing_FSE_Approve_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>FSE Approve</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_FSE_Reject_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>FSE Reject</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_RPM_Approve_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>RPM Approve</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_RPM_Create_Deal_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>RPM Create Deal</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_RPM_Reject_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>RPM Reject</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Pricing_Check_for_FSE_Action</name>
        <label>Check for FSE Action</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Auto_Approve</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Additional_Comments_Txt__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>#autoapprove</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Pricing_NotAPI</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_PIFR_Approval</targetReference>
            </connector>
            <label>Auto Approve</label>
        </rules>
        <rules>
            <name>Auto_Reject</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Pricing_NotAPI</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_PIFR_Rejection</targetReference>
            </connector>
            <label>Auto Reject</label>
        </rules>
    </decisions>
    <description>Flow Orchestration for Auto approving Quotelines based on condition.</description>
    <environments>Default</environments>
    <formulas>
        <name>Pricing_NotAPI</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!$Record.Pricing_Additional_Comments_Txt__c}, &apos;#autoapproveAPI&apos;))</expression>
    </formulas>
    <interviewLabel>Quote Line Auto Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Line Auto Approval</label>
    <orchestratedStages>
        <name>Pricing_PIFR_Approval</name>
        <label>PIFR Approval</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Step_to_Approve_PIFR_Quoteline</name>
            <actionName>Pricing_auto_launch_flow_where_platform_event_calling</actionName>
            <actionType>stepBackground</actionType>
            <canAssigneeEdit>false</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>Pricing_Action</name>
                <value>
                    <elementReference>Pricing_FSE_Approve_Action</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>Pricing_QuoteLine_Id</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <label>Step to Approve PIFR Quoteline</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>false</runAsUser>
            <shouldLock>false</shouldLock>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <name>Pricing_PIFR_Rejection</name>
        <label>PIFR Rejection</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Step_to_Reject_PIFR_Quoteline</name>
            <actionName>Pricing_Auto_Approval_by_FSE</actionName>
            <actionType>stepBackground</actionType>
            <canAssigneeEdit>false</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>Pricing_Action</name>
                <value>
                    <elementReference>Pricing_FSE_Reject_Action</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>Pricing_QuoteLine_Id</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <label>Step to Reject PIFR Quoteline</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>false</runAsUser>
            <shouldLock>false</shouldLock>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Orchestrator</processType>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Pricing_Check_for_FSE_Action</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1  AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>Pricing_Quote_Program_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Tender</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Intel Field Review</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Additional_Comments_Txt__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>#autoapprove</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Additional_Comments_Txt__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>#autoreject</stringValue>
            </value>
        </filters>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
