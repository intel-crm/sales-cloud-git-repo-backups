<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Lead_List</name>
        <label>Assign Lead List</label>
        <locationX>264</locationX>
        <locationY>866</locationY>
        <assignmentItems>
            <assignToReference>LeadRecordNeedToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>SingleLeadRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_Lead_Ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Lead_Record_Type_Ids</name>
        <label>Assign Lead Record Type Ids</label>
        <locationX>264</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>LeadRecordTypeIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Over_Record_Types.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_Record_Types</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Values_In_Lead</name>
        <label>Assign Values In Lead</label>
        <locationX>264</locationX>
        <locationY>758</locationY>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Core_Lead_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Disqualified</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Core_Lead_Sub_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Rep Inactivity</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Over_Lead_Ids.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Core_Lead_State__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Terminated</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Core_Lead_Notes__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LeadNote</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Lead_List</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_4</name>
        <label>Assignment 4</label>
        <locationX>440</locationX>
        <locationY>1166</locationY>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Origin__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Stale lead disposition</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Details__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_sObjectId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Over_Lead_Ids.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Severity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_sObjectType__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_When__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Log_Entry</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>LASTCREATEDAYS</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>90.0</numberValue>
        </value>
    </constants>
    <constants>
        <name>LASTMODIFIEDDAYS</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>30.0</numberValue>
        </value>
    </constants>
    <environments>Default</environments>
    <formulas>
        <name>LeadCreatedDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(FROMUNIXTIME(UNIXTIMESTAMP({!$Flow.CurrentDateTime}) - VALUE({!$Label.SWS_Lead_Created_Days}) * 24 * 60 * 60))</expression>
    </formulas>
    <formulas>
        <name>LeadLastModifiedDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(FROMUNIXTIME(UNIXTIMESTAMP({!$Flow.CurrentDateTime}) - VALUE({!$Label.SWS_Lead_Modified_Days}) * 24 * 60 * 60 ))</expression>
    </formulas>
    <formulas>
        <name>LeadNote</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!Loop_Over_Lead_Ids.Core_Lead_Notes__c}),
    &quot;This lead has been auto disqualified on &quot; &amp; TEXT({!$Flow.InterviewStartTime}) &amp; 
    &quot; (UTC), as it has been active for over &quot; &amp; {!$Label.SWS_Lead_Created_Days} &amp; 
    &quot; days with no recorded activity in the last &quot; &amp; {!$Label.SWS_Lead_Modified_Days} &amp; &quot; days.&quot;,
    
    {!Loop_Over_Lead_Ids.Core_Lead_Notes__c} &amp; BR() &amp; 
    &quot;This lead has been auto disqualified on &quot; &amp; TEXT({!$Flow.InterviewStartTime}) &amp; 
    &quot; (UTC), as it has been active for over &quot; &amp; {!$Label.SWS_Lead_Created_Days} &amp; 
    &quot; days with no recorded activity in the last &quot; &amp; {!$Label.SWS_Lead_Modified_Days} &amp; &quot; days.&quot;
)</expression>
    </formulas>
    <interviewLabel>Terminate Lead After 90 Day in Activity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Terminate Lead After 90 Day in Activity</label>
    <loops>
        <name>Loop_Over_Lead_Ids</name>
        <label>Loop Over Lead Ids</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <collectionReference>Get_Leads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Values_In_Lead</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Leads_That_Needs_to_Update</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Over_Record_Types</name>
        <label>Loop Over Record Types</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <collectionReference>Get_Record_Type</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Lead_Record_Type_Ids</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Leads</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Log_Entry</name>
        <label>Create Log Entry</label>
        <locationX>440</locationX>
        <locationY>1274</locationY>
        <inputReference>LogEntry</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Leads</name>
        <label>Get Leads</label>
        <locationX>176</locationX>
        <locationY>542</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Over_Lead_Ids</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>LeadCreatedDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>LeadLastModifiedDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>In</operator>
            <value>
                <elementReference>LeadRecordTypeIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Lead_State__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Terminated</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Lead_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Disqualified</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>
            <numberValue>200.0</numberValue>
        </limit>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Lead_Status__c</queriedFields>
        <queriedFields>Core_Lead_Sub_Status__c</queriedFields>
        <queriedFields>Core_Lead_State__c</queriedFields>
        <queriedFields>Core_Lead_Notes__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Record_Type</name>
        <label>Get Record Type</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Over_Record_Types</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sales Lead</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Leads_That_Needs_to_Update</name>
        <label>Update Leads That Needs to Update</label>
        <locationX>176</locationX>
        <locationY>1058</locationY>
        <faultConnector>
            <targetReference>Assignment_4</targetReference>
        </faultConnector>
        <inputReference>LeadRecordNeedToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Record_Type</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>LeadIdList</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LeadNeedToRemove</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LeadRecordNeedToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>LeadRecordTypeIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LogEntry</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Core_Log_Entry__c</objectType>
    </variables>
    <variables>
        <name>SingleLeadRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
</Flow>
