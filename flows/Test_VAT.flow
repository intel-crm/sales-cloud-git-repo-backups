    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_VAT_Invoice_Records</name>
        <label>Get VAT Invoice Records</label>
        <locationX>182</locationX>
        <locationY>253</locationY>
