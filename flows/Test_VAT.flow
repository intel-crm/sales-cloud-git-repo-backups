    <decisions>
        <name>Check_Document_Submitted_Date_if_True</name>
        <label>Check Document Submitted Date if True</label>
        <locationX>182</locationX>
        <locationY>373</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_VAT_Invoice_Records.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Documents</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Document_Requested_Date</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <formulas>
        <name>RequestedDateSetup</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Test VAT {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test VAT</label>
    <processMetadataValues>
        <name>BuilderType</name>
