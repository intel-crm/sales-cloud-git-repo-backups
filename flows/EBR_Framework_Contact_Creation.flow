    <decisions>
        <name>Verify_Engagement_code_is_IPS</name>
        <label>Verify Engagement code is IPS</label>
        <locationX>688</locationX>
        <locationY>2930</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Engagement_code_is_IPS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>triggeredRegisteredRecord.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IPS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contact_Record.Core_IPS_Intel_Support_Owner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact</targetReference>
            </connector>
            <label>Engagement code is IPS</label>
        </rules>
        <rules>
            <name>Engagement_Code_DZP</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>triggeredRegisteredRecord.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DZP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contact_Record.Core_IPS_Intel_Support_Owner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contact_Record.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>triggeredRegisteredRecord.PRM_Salesforce_ID__r.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Contact_owner_as_Account_Owner_DZP_Upd</targetReference>
            </connector>
            <label>Engagement Code DZP</label>
        </rules>
    </decisions>
