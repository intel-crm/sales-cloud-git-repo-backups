    <decisions>
        <name>Assign_Owner_and_Intel</name>
        <label>Assign Owner and ISO for DZP</label>
        <locationX>550</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Create_New_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DZP_Registration</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>triggeredRegisteredRecord.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DZP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_Owner_as_Contact_Owner_DZP</targetReference>
            </connector>
            <label>DZP Registration</label>
        </rules>
    </decisions>
