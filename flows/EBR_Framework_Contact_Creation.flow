<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assign_contact_record_output</name>
        <label>assign contact record output</label>
        <locationX>325</locationX>
        <locationY>1142</locationY>
        <assignmentItems>
            <assignToReference>contactRecordOutput</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contact_Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Verify_Engagement_code_is_IPS</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Reg_Email_to_List</name>
        <label>Assign Reg Email to List</label>
        <locationX>204</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>newRegEmailList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>triggeredRegisteredRecord.PRM_Email_ID__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_partner_Role_if_IPA_Account</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Assign_partner_Role_if_IPA_Account</name>
        <label>Assign partner Role if IPA Account</label>
        <locationX>204</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Create_New_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Set_Variable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>triggeredRegisteredRecord.Account_ID__r.Core_Intel_Partner_Alliance_PartnerGroup__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Create_New_Contact</targetReference>
            </connector>
            <label>Set Partner Role</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Email_already_present</name>
        <label>Verify Email already present</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Assign_Reg_Email_to_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Reg_Email_Matching</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>newRegEmailList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>triggeredRegisteredRecord.PRM_Email_ID__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact_Record</targetReference>
            </connector>
            <label>New Reg Email Matching</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Engagement_code_is_IPS</name>
        <label>Verify Engagement code is IPS</label>
        <locationX>325</locationX>
        <locationY>1250</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Engagement_code_is_IPS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>triggeredRegisteredRecord.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IPS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contact_Record.Core_IPS_Intel_Support_Owner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact</targetReference>
            </connector>
            <label>Engagement code is IPS</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_existing_contact</name>
        <label>Verify existing contact</label>
        <locationX>325</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Get_Contact_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_existing_contact_not_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>triggeredRegisteredRecord.PRM_Contact_Salesforce_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Verify_Email_already_present</targetReference>
            </connector>
            <label>Valid existing contact not present</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>EBR Framework Contact Creation {!$Flow.CurrentDateTime}</interviewLabel>
