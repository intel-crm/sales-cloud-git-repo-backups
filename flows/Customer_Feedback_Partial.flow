        <filterFormula> ISCHANGED({!$Record.Feedback__c}) &amp;&amp; ISPICKVAL({!$Record__Prior.Feedback__c}, &apos;Keep as is&apos;) &amp;&amp; !(ISPICKVAL({!$Record.Feedback__c}, &apos;Keep as is&apos;))</filterFormula>
