    <decisions>
        <name>Check_if_Customer_Feedback_Records_exist</name>
        <label>Check if Customer Feedback Records exist</label>
        <locationX>446</locationX>
        <locationY>731</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CustomerFeedbacktobeUpdated</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Customer_Feedback_values</targetReference>
            </connector>
            <label>Exists</label>
        </rules>
        <rules>
            <name>No_Customer_Feedback</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CustomerFeedbacktobeUpdated</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>No Customer Feedback</label>
        </rules>
    </decisions>
    <description>Propagate changes from Account Feedback to Customer Feedback when Account Feedback is changed from &quot;Keep as is&quot; to other values</description>
