    <description>This is used to create AllocationShare record for both Internal Account Managers group for a particular program and External users.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(ISNEW(), ISCHANGED([PartnerFundAllocation].OwnerId))</stringValue>
