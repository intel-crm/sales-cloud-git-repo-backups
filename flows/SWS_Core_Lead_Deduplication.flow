<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_ID</name>
        <label>Assign ID</label>
        <locationX>138</locationX>
        <locationY>1259</locationY>
        <assignmentItems>
            <assignToReference>Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_get_records.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_get_records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count</name>
        <label>Count</label>
        <locationX>314</locationX>
        <locationY>935</locationY>
        <assignmentItems>
            <assignToReference>Countnum</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Duplicate_Contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Duplicate_records_greater_than_1_or_not</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Duplicate_Non_terminated_Leads_List</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Duplicate Non terminated Leads List</label>
        <locationX>578</locationX>
        <locationY>611</locationY>
        <assignNextValueToReference>currentItem_Duplicate_Non_terminated_Leads_List</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Duplicate_Leads</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Duplicate_Non_terminated_Leads_List.Core_Lead_State__c</leftValueReference>
            <operator>NotEqualTo</operator>
            <rightValue>
                <stringValue>Terminated</stringValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Duplicate_Error_message</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>Duplicate_Terminated_Leads_List</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Duplicate Terminated Leads List</label>
        <locationX>578</locationX>
        <locationY>503</locationY>
        <assignNextValueToReference>currentItem_Duplicate_Terminated_Leads_List</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Duplicate_Leads</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Duplicate_Terminated_Leads_List.Core_Lead_State__c</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <stringValue>Terminated</stringValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Duplicate_Non_terminated_Leads_List</targetReference>
        </connector>
    </collectionProcessors>
    <customErrors>
        <name>Duplicate_Error_message</name>
        <label>Duplicate Error message</label>
        <locationX>578</locationX>
        <locationY>719</locationY>
        <connector>
            <targetReference>On_Getting_Duplicate_Lead_or_Contact</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>There are duplicate records found for this Email.
Duplicate Contacts : {!Get_Duplicate_Contacts}
Duplicate Leads (Terminated): {!Duplicate_Terminated_Leads_List}
Other Duplicate Leads: {!Duplicate_Non_terminated_Leads_List}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Error_Message_for_contact</name>
        <label>Error Message for contact</label>
        <locationX>50</locationX>
        <locationY>1451</locationY>
        <customErrorMessages>
            <errorMessage>A duplicate contact with the same email is found.
View Record: {!Contact_Record_URL}{!Id}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Error_message_for_contacts</name>
        <label>Error message for contacts</label>
        <locationX>314</locationX>
        <locationY>1151</locationY>
        <customErrorMessages>
            <errorMessage>A duplicate contact with the same email is found. Following are the Id&apos;s of the duplicate contacts. {!Get_Duplicate_Contacts}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Duplicate_records_greater_than_1_or_not</name>
        <label>Duplicate records greater than 1 or not</label>
        <locationX>314</locationX>
        <locationY>1043</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Equals_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Countnum</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_get_records</targetReference>
            </connector>
            <label>Equals 1</label>
        </rules>
        <rules>
            <name>Greater_than_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Countnum</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_message_for_contacts</targetReference>
            </connector>
            <label>Greater than 1</label>
        </rules>
    </decisions>
    <decisions>
        <description>Get Lead based on Marketo User and Product</description>
        <name>On_Getting_Duplicate_Lead_or_Contact</name>
        <label>On Getting Duplicate Lead or Contact</label>
        <locationX>578</locationX>
        <locationY>827</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Contact_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Duplicate_Contacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count</targetReference>
            </connector>
            <label>Duplicate Contact found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Contact_Record_URL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;.com&quot;, {!$Api.Partner_Server_URL_540}) + 3) &amp; &quot;/&quot;</expression>
    </formulas>
    <formulas>
        <name>Lead_Record_URL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;.com&quot;, {!$Api.Partner_Server_URL_540}) + 3) &amp; &quot;/&quot;</expression>
    </formulas>
    <formulas>
        <name>Terminated_Lead_URL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;.com&quot;, {!$Api.Partner_Server_URL_540}) + 3) &amp; &quot;/&quot;</expression>
    </formulas>
    <interviewLabel>SWS_Core_Lead_Create_Duplicate_Leads {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SWS_Core_Lead_Deduplication</label>
    <loops>
        <name>Loop_get_records</name>
        <label>Loop get records</label>
        <locationX>50</locationX>
        <locationY>1151</locationY>
        <collectionReference>Get_Duplicate_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_ID</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Error_Message_for_contact</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Duplicate_Contacts</name>
        <label>Get Duplicate Contacts</label>
        <locationX>578</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Duplicate_Terminated_Leads_List</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Id</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Duplicate_Leads</name>
        <label>Get Duplicate Leads</label>
        <locationX>578</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Duplicate_Contacts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>012o00000015YqcAAE</stringValue>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Lead_State__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>452</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Duplicate_Leads</targetReference>
        </connector>
        <filterFormula>AND(
   {!$Record.RecordType.DeveloperName} &lt;&gt; &quot;Partner_Lead&quot;,
   OR(
      ISNEW(), ISCLONE(),
      ISCHANGED({!$Record.Email})
   )
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>Countnum</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>currentItem_Duplicate_Non_terminated_Leads_List</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>currentItem_Duplicate_Terminated_Leads_List</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>Id</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>MarketoUserName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>user.marketo@intel.com</stringValue>
        </value>
    </variables>
</Flow>
