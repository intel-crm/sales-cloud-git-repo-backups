    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>Choice_Actual_Address</name>
        <choiceText>Actual Address:  {!Get_Account_Request_Queue_Record.Address__Street__s}, {!Get_Account_Request_Queue_Record.Address__City__s}, {!Get_Account_Request_Queue_Record.Address__StateCode__s} {!Get_Account_Request_Queue_Record.Address__PostalCode__s}, {!Get_Account_Request_Queue_Record.Address__CountryCode__s}</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Actual</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Loqate_Address</name>
        <choiceText>Loqate Cleansed Address:  {!Get_Account_Request_Queue_Record.Standardized_Address_Street__c}, {!Get_Account_Request_Queue_Record.Standardized_Address_City__c}, {!Get_Account_Request_Queue_Record.Standardized_Address_State__c} {!Get_Account_Request_Queue_Record.Standardized_Address_Postal_Code__c}, {!Get_Account_Request_Queue_Record.Standardized_Address_Country__c}</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Loqate</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Address_Selection_Decision</name>
        <label>Address Selection Decision</label>
        <locationX>50</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>show_actual_address_message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Actual Address</defaultConnectorLabel>
        <rules>
            <name>Loqate_Address_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Address_Selection</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Loqate</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Request_Queue_Record</targetReference>
            </connector>
            <label>Loqate Address Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_status</name>
        <label>Check status</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>status_is_pending_approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Create_Request_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Approval</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Address_AI_Cleansing_Call</targetReference>
            </connector>
            <label>status is pending approval</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verification_Status_check</name>
        <label>Verification Status check</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Reverted_And_Unverified</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Verified_Partially_Verified_and_Ambiguous_status</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request_Queue_Record.Standardized_Address_VerificationStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Verified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request_Queue_Record.Standardized_Address_VerificationStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partially Verified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request_Queue_Record.Standardized_Address_VerificationStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ambiguous</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Adrress_verification_decisison</targetReference>
            </connector>
            <label>Verified Partially Verified and Ambiguous status</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>UCD Request Address Verification {!$Flow.CurrentDateTime}</interviewLabel>
