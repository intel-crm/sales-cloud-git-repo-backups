<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>10 Days reminder emails for Company &apos;Update Required&apos;</description>
        <name>X10_Days_reminder_emails_for_Company_Update_Required</name>
        <label>10 Days reminder emails for Company &apos;Update Required&apos;</label>
        <locationX>578</locationX>
        <locationY>408</locationY>
        <actionName>PMP_SendEmailAlertsForPartners</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>partnerId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>templateName</name>
            <value>
                <stringValue>PMP_CompanyUpdateReqSecondNotification</stringValue>
            </value>
        </inputParameters>
        <nameSegment>PMP_SendEmailAlertsForPartners</nameSegment>
    </actionCalls>
    <actionCalls>
        <description>3 Days reminder emails for Company &apos;Update Required&apos;</description>
        <name>X3_Days_reminder_emails_for_Company_Update_Required</name>
        <label>3 Days reminder emails for Company &apos;Update Required&apos;</label>
        <locationX>50</locationX>
        <locationY>408</locationY>
        <actionName>PMP_SendEmailAlertsForPartners</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>partnerId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>templateName</name>
            <value>
                <stringValue>PMP_CompanyUpdateReqFirstNotification</stringValue>
            </value>
        </inputParameters>
        <nameSegment>PMP_SendEmailAlertsForPartners</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Is 10 Day Company Update Required Emails Sent</description>
        <name>Is_10_Day_Company_Update_Required_Emails_Sent</name>
        <label>Is 10 Day Company Update Required Emails Sent ?</label>
        <locationX>710</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Entry_Criteria_for_10_Day_Company_Update_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMP_Company_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Update Required</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Workflow_One_Week_Trigger_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Partner_Submitter_UserId__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Do_Not_Contact_Enabled__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>X10_Days_reminder_emails_for_Company_Update_Required</targetReference>
            </connector>
            <label>Entry Criteria : 10 Day(s) Company Update Required Email Reminder</label>
        </rules>
    </decisions>
    <decisions>
        <description>Verify if the update required emails are sent to Company Profile.</description>
        <name>Is_3_Day_Company_Update_Required_Emails_Sent</name>
        <label>Is 3 Day Company Update Required Emails Sent ?</label>
        <locationX>182</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Entry_Criteria_for_3_Day_Company_Update_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMP_Company_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Update Required</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Workflow_Three_Day_Trigger_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Partner_Submitter_UserId__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Do_Not_Contact_Enabled__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>X3_Days_reminder_emails_for_Company_Update_Required</targetReference>
            </connector>
            <label>Entry Criteria : 3 Day(s) Company Update Required Reminder Emails</label>
        </rules>
    </decisions>
    <description>Trigger an Email Alert to Partner, if there is no action taken even after 3 days and even after 10 days&quot;</description>
    <environments>Default</environments>
    <interviewLabel>PMP_CompanyUpdateRequiredReminder_ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMP_CompanyUpdateRequiredReminder_Old</label>
    <migratedFromWorkflowRuleName>PMP_CompanyUpdateRequiredReminder_WF</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>122</locationX>
        <locationY>0</locationY>
        <object>PMP_Company__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Update_Required_reminder_email_after_3_days_to_Company</name>
            <connector>
                <targetReference>Is_3_Day_Company_Update_Required_Emails_Sent</targetReference>
            </connector>
            <label>&apos;Update Required&apos; reminder email after 3 days to Company</label>
            <maxBatchSize>1</maxBatchSize>
            <offsetNumber>10</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>PMP_Workflow_Three_Day_Trigger_Dt__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Update_Required_reminder_email_after_10_days_to_Company</name>
            <connector>
                <targetReference>Is_10_Day_Company_Update_Required_Emails_Sent</targetReference>
            </connector>
            <label>&apos;Update Required&apos; reminder email after 10 days to Company</label>
            <maxBatchSize>1</maxBatchSize>
            <offsetNumber>10</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>PMP_Workflow_One_Week_Trigger_Dt__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
