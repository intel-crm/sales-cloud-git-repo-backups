<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Error_Message</name>
        <label>Set Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>showErrorToast</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Success_Toast_Flag</name>
        <label>Set Success Toast Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>showSuccessToast</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <choices>
        <name>CancelCaseNo</name>
        <choiceText>No</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>No</stringValue>
        </value>
    </choices>
    <choices>
        <name>CancelCaseYes</name>
        <choiceText>Yes</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Yes</stringValue>
        </value>
    </choices>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Was_Case_Cancelled</name>
        <label>Was Case Cancelled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Show_Success_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CancelCaseAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>CancelCaseYes</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Record</targetReference>
            </connector>
            <label>Show Success Message</label>
        </rules>
    </decisions>
    <description>Flow used to cancel CCP Under Review Cases</description>
    <environments>Default</environments>
    <formulas>
        <name>Concatenated_Cancellation_Reason</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!Get_Case_Record.Core_MDF_Reason_for_Cancellation_txt__c}),
  &quot;Added on &quot; &amp; TEXT($Flow.CurrentDateTime) &amp; &quot;:&quot; &amp; BR() &amp; {!Reason_for_Cancellation},
  &quot;Added on &quot; &amp; TEXT($Flow.CurrentDateTime) &amp; &quot;:&quot; &amp; BR() &amp; {!Reason_for_Cancellation} &amp; BR() &amp; &quot;----------------&quot; &amp; BR() &amp; {!Get_Case_Record.Core_MDF_Reason_for_Cancellation_txt__c}
)</expression>
    </formulas>
    <formulas>
        <description>Restrict if current reason exceeds 5000 characters or final saved value exceeds 32000 characters.</description>
        <name>Reason_For_Cancellation_Length_Validation</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  LEN({!Reason_for_Cancellation}) &lt;= 5000,
  LEN({!Concatenated_Cancellation_Reason}) &lt;= 32000
)</expression>
    </formulas>
    <interviewLabel>Cancel Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cancel Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Case_Record</name>
        <label>Get  Case Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Cancel_Case</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Set_Error_Message</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Reason_for_Cancellation_txt__c</queriedFields>
        <queriedFields>Core_MDF_Claim_Lookup_Id__c</queriedFields>
        <queriedFields>Core_MDF_Status__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Case_Record</name>
        <label>Update Case Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Related_Claim_Record</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Set_Error_Message</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Reason_for_Cancellation_txt__c</field>
            <value>
                <elementReference>Concatenated_Cancellation_Reason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_Status__c</field>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Related_Claim_Record</name>
        <label>Update Related Claim Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Success_Toast_Flag</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Error_Message</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case_Record.Core_MDF_Claim_Lookup_Id__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Audit_Hold__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_BackendReviewSelection_Ind__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_Claim_Review_Case__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_FlaggedForAudit__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>PartnerFundClaim</object>
    </recordUpdates>
    <screens>
        <description>Cancel Case</description>
        <name>Cancel_Case</name>
        <label>Cancel Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Was_Case_Cancelled</targetReference>
        </connector>
        <fields>
            <name>CancelCaseDisplayText</name>
            <fieldText>&lt;p&gt;Cancel this case and release the claim from Review hold? This action cannot be undone.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>CancelCaseAction</name>
            <choiceReferences>CancelCaseYes</choiceReferences>
            <choiceReferences>CancelCaseNo</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Do you want to cancel this case?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Reason_for_Cancellation</name>
            <fieldText>Reason for Cancellation</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;{!$Label.Core_MDF_Camp_InternalExternalComments_CharLimit}&lt;/p&gt;</errorMessage>
                <formulaExpression>{!Reason_For_Cancellation_Length_Validation}</formulaExpression>
            </validationRule>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>CancelCaseAction</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>CancelCaseYes</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <nextOrFinishButtonLabel>Submit</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Case_Record</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>showErrorToast</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>showSuccessToast</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
