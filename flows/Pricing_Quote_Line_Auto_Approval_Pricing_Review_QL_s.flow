<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Pricing_FSE_Approve_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>FSE Approve</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_FSE_Reject_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>FSE Reject</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_RPM_Approve_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>RPM Approve</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_RPM_Create_Deal_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>RPM Create Deal</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_RPM_Reject_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>RPM Reject</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Pricing_Check_for_RPM_Action</name>
        <label>Check for RPM Action</label>
        <locationX>380</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Pricing_PFIR_Rejection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Auto_Approve_Create_Deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Additional_Comments_Txt__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>#autoapprove</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_Check_for_Write_In_Product_for_PFIR</targetReference>
            </connector>
            <label>Auto Approve/Create Deal</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricing_Check_for_Write_In_Product_for_PFIR</name>
        <label>Check for Write In Product for PFIR</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Pricing_PFIR_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pricing_Is_not_Write_In_for_PFIR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Other_Product_Nm__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_PFIR_Create_Deal</targetReference>
            </connector>
            <label>Is not Write In?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Quote Line Auto Approval Pricing Review QL&apos;s {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Line Auto Approval Pricing Review QL&apos;s</label>
    <orchestratedStages>
        <name>Pricing_PFIR_Approval</name>
        <label>PFIR Approval</label>
        <locationX>314</locationX>
        <locationY>503</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Step_to_Approve_PFIR_Write_In_Quoteline</name>
            <actionName>Pricing_auto_launch_flow_where_platform_event_calling</actionName>
            <actionType>stepBackground</actionType>
            <canAssigneeEdit>false</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>Pricing_Action</name>
                <value>
                    <elementReference>Pricing_RPM_Approve_Action</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>Pricing_QuoteLine_Id</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <label>Step to Approve PFIR Write In Quoteline</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>false</runAsUser>
            <shouldLock>false</shouldLock>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <name>Pricing_PFIR_Create_Deal</name>
        <label>PFIR Create Deal</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Step_to_perform_Create_Deal_on_PFIR_Quoteline</name>
            <actionName>Pricing_auto_launch_flow_where_platform_event_calling</actionName>
            <actionType>stepBackground</actionType>
            <canAssigneeEdit>false</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>Pricing_Action</name>
                <value>
                    <elementReference>Pricing_RPM_Create_Deal_Action</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>Pricing_QuoteLine_Id</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <label>Step to perform Create Deal on PFIR Quoteline</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>false</runAsUser>
            <shouldLock>false</shouldLock>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <name>Pricing_PFIR_Rejection</name>
        <label>PFIR Rejection</label>
        <locationX>578</locationX>
        <locationY>395</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Step_to_Reject_PFIR_Quoteline</name>
            <actionName>Pricing_Auto_Approval_by_FSE</actionName>
            <actionType>stepBackground</actionType>
            <canAssigneeEdit>false</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>Pricing_Action</name>
                <value>
                    <elementReference>Pricing_RPM_Reject_Action</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>Pricing_QuoteLine_Id</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <label>Step to Reject PFIR Quoteline</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>false</runAsUser>
            <shouldLock>false</shouldLock>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Orchestrator</processType>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Pricing_Check_for_RPM_Action</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>(1 AND 2 AND 3 AND 5 AND 6) OR (1 AND 2 AND (3 OR 4))</filterLogic>
        <filters>
            <field>Pricing_Quote_Program_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Tender</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Further Intel Review</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Additional_Comments_Txt__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>#autoapprove</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Additional_Comments_Txt__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>#autoreject</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Deal_Description__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>#IQRAutoApprove</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_New_Change_Request_cb__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
