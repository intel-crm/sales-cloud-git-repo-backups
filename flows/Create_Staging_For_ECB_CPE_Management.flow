        <name>Which_CPE_Needs_To_be_Inserted</name>
        <label>Which Program CPE Needs To be Inserted</label>
        <locationX>974</locationX>
        <locationY>4271</locationY>
        <defaultConnector>
            <targetReference>Null_Check_For_Business_Types_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_For_Program_Based_CPE</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 OR 5) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Intel_Partner_Alliance_PartnerGroup__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_CoMarketingActive__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Is_Opportunity_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_B2B_Entitlement__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Label.UCD_Salesgroup_Value</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Core_Sales_Groups__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_For_Add_Or_Delete_IPA_Acc_CPE</targetReference>
            </connector>
            <label>Check For Program Based CPE</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>accountRecordId</name>
        <dataType>String</dataType>
        <expression>{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>Add_Sales_KPI_CPE</name>
        <dataType>Boolean</dataType>
        <expression>AND(CONTAINS($Label.UCD_Salesgroup_Value, TEXT({!$Record.Core_Sales_Groups__c}))
,NOT(CONTAINS($Label.UCD_Salesgroup_Value, TEXT({!$Record__Prior.Core_Sales_Groups__c}))))</expression>
    </formulas>
    <formulas>
        <name>B2B_CPE_does_Not_exists</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!All_Business_Type_Code}, &apos;ACCS_ENTTL&apos;))</expression>
    </formulas>
    <formulas>
        <name>CoMarketing_CPE_does_Not_exists</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!All_Business_Type_Code}, &apos;CO_MKT&apos;))</expression>
    </formulas>
    <formulas>
        <name>Delete_Sales_KPI_CPE</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(CONTAINS($Label.UCD_Salesgroup_Value, TEXT({!$Record.Core_Sales_Groups__c})))
,CONTAINS($Label.UCD_Salesgroup_Value, TEXT({!$Record__Prior.Core_Sales_Groups__c})))</expression>
    </formulas>
    <formulas>
        <name>IPA_CPE_Does_Exists</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!All_Business_Type_Code}, &apos;PTNR&apos;))</expression>
    </formulas>
    <formulas>
        <name>Sales_Group_Lov_does_Not_contains</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!$Label.UCD_Salesgroup_Value}, TEXT({!$Record.Core_Sales_Groups__c})))</expression>
    </formulas>
    <formulas>
        <name>Sales_PipeLine_CPE_Exists</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!All_Business_Type_Code}, &apos;SLS_PPLN&apos;))</expression>
    </formulas>
    <formulas>
        <name>Sales_PKI_Hosted_CPE_DoesNot_Exists</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!All_Business_Type_Code}, &apos;SLS_KPI_HOST&apos;))</expression>
    </formulas>
