    <interviewLabel>Call Script 2015 Q4 Other - Category of Interaction {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Call Script 2015 Q4 Other - Category of Interaction</label>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Update_Response</name>
        <label>Update Response</label>
        <locationX>289</locationX>
        <locationY>210</locationY>
        <connector>
            <targetReference>Call_Script_Complete</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>callScriptResponseId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Answer_1__c</field>
            <value>
                <elementReference>What_is_the_type_of_Interaction_with_customers</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Answer_2__c</field>
            <value>
                <elementReference>What_is_the_outcome_of_the_call</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Question_1__c</field>
            <value>
                <stringValue>What is the type of interaction with customers?</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Question_2__c</field>
            <value>
                <stringValue>What is the outcome of the call?</stringValue>
            </value>
        </inputAssignments>
        <object>Core_Call_Script_Response__c</object>
    </recordUpdates>
    <screens>
        <name>Call_Script_Complete</name>
        <label>Call Script Complete</label>
        <locationX>112</locationX>
        <locationY>332</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Thank_You</name>
            <fieldText>Thank you for completing the call script questionnaire! Responses have been saved. You may close this window.</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Category_of_Interaction</name>
        <label>Category of Interaction</label>
        <locationX>105</locationX>
        <locationY>207</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Update_Response</targetReference>
        </connector>
        <fields>
            <name>What_is_the_type_of_Interaction_with_customers</name>
            <choiceReferences>Account_Grouping_Profiling</choiceReferences>
            <choiceReferences>General</choiceReferences>
            <choiceReferences>Promotion</choiceReferences>
            <choiceReferences>Training_Webinar</choiceReferences>
            <choiceReferences>Follow_up_call</choiceReferences>
            <choiceReferences>ITP_Membership</choiceReferences>
            <choiceReferences>Sales_call</choiceReferences>
            <choiceReferences>Warranty</choiceReferences>
            <dataType>String</dataType>
            <fieldText>What is the type of Interaction with customers?</fieldText>
            <fieldType>MultiSelectCheckboxes</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Blank2</name>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>What_is_the_outcome_of_the_call</name>
            <fieldText>What is the outcome of the call?</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <startElementReference>Create_Response_Record_if_Necessary</startElementReference>
    <status>Active</status>
    <subflows>
        <name>Create_Response_Record_if_Necessary</name>
