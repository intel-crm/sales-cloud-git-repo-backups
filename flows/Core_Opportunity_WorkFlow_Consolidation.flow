            </value>
        </processMetadataValues>
        <name>formula_24_myRule_23_A2_3893457586</name>
        <dataType>String</dataType>
        <expression>TEXT({!myVariable_current.StageName} )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>DATEVALUE([Opportunity].CreatedDate )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_25_myRule_23_A1_4945648378</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!myVariable_current.CreatedDate} )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>PRIORVALUE([Opportunity].CloseDate ) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_38_myRule_37_A1_1184439169</name>
        <dataType>Date</dataType>
        <expression>PRIORVALUE({!myVariable_current.CloseDate} )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>Today()</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_3_myRule_1_A1_2484577013</name>
        <dataType>Date</dataType>
        <expression>Today()</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>Today() + 120</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_6_myRule_5_A1_0802566883</name>
        <dataType>Date</dataType>
        <expression>Today() + 120</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>TEXT(PRIORVALUE([Opportunity].StageName))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_9_myRule_8_A1_5139647740</name>
        <dataType>String</dataType>
        <expression>TEXT(PRIORVALUE({!myVariable_current.StageName}))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR( 
ISCHANGED( [Opportunity].StageName ),
ISCHANGED( [Opportunity].CloseDate ), 
ISCHANGED( [Opportunity].Core_Volume__c ),
ISCHANGED( [Opportunity].Description ), 
ISCHANGED( [Opportunity].Amount ), 
ISCHANGED([Opportunity].Core_Status_Update__c ), 
ISCHANGED( [Opportunity].Core_Product_Segment__c ), ISCHANGED([Opportunity].Core_Product_Application__c ), 
ISCHANGED( [Opportunity].Core_Consumption_Market__c ), 
ISCHANGED( [Opportunity].Core_Solution_Area__c ), 
ISCHANGED( [Opportunity].Core_Solution_Type__c ), 
ISCHANGED( [Opportunity].Core_Combined_Solution_Detail__c ), 
ISCHANGED( [Opportunity].Core_First_Customer_Ship_Date__c ), 
ISCHANGED( [Opportunity].Core_Manufacturing_Geo__c )
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_11</name>
        <dataType>Boolean</dataType>
        <expression>OR( 
ISCHANGED( {!myVariable_current.StageName} ),
ISCHANGED( {!myVariable_current.CloseDate} ), 
ISCHANGED( {!myVariable_current.Core_Volume__c} ),
ISCHANGED( {!myVariable_current.Description} ), 
ISCHANGED( {!myVariable_current.Amount} ), 
ISCHANGED({!myVariable_current.Core_Status_Update__c} ), 
ISCHANGED( {!myVariable_current.Core_Product_Segment__c} ), ISCHANGED({!myVariable_current.Core_Product_Application__c} ), 
ISCHANGED( {!myVariable_current.Core_Consumption_Market__c} ), 
ISCHANGED( {!myVariable_current.Core_Solution_Area__c} ), 
ISCHANGED( {!myVariable_current.Core_Solution_Type__c} ), 
ISCHANGED( {!myVariable_current.Core_Combined_Solution_Detail__c} ), 
ISCHANGED( {!myVariable_current.Core_First_Customer_Ship_Date__c} ), 
ISCHANGED( {!myVariable_current.Core_Manufacturing_Geo__c} )
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue> OR(ISNEW(),ISCHANGED([Opportunity].AccountId )) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_14</name>
        <dataType>Boolean</dataType>
        <expression> OR(ISNEW(),ISCHANGED({!myVariable_current.AccountId} ))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>TEXT([Opportunity].StageName) &lt;&gt; null</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_23</name>
        <dataType>Boolean</dataType>
        <expression>TEXT({!myVariable_current.StageName}) &lt;&gt; null</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(ISCHANGED([Opportunity].Core_Approval_Status__c), ISPICKVAL([Opportunity].Core_Approval_Status__c, &apos;Approved&apos;), NOT(ISPICKVAL([Opportunity].StageName, &apos;Production Win&apos;)) )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_29</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!myVariable_current.Core_Approval_Status__c}), ISPICKVAL({!myVariable_current.Core_Approval_Status__c}, &apos;Approved&apos;), NOT(ISPICKVAL({!myVariable_current.StageName}, &apos;Production Win&apos;)) )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND ([Opportunity].Core_Approved_Opportunity_Region__c = null, OR ( ISPICKVAL([Opportunity].StageName, &apos;Design Win&apos;), ISPICKVAL([Opportunity].StageName, &apos;Production Win&apos;), ISPICKVAL([Opportunity].StageName, &apos;Lost&apos;), ISPICKVAL([Opportunity].StageName, &apos;Cancelled&apos;) ) )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_33</name>
        <dataType>Boolean</dataType>
        <expression>AND ({!myVariable_current.Core_Approved_Opportunity_Region__c} = null, OR ( ISPICKVAL({!myVariable_current.StageName}, &apos;Design Win&apos;), ISPICKVAL({!myVariable_current.StageName}, &apos;Production Win&apos;), ISPICKVAL({!myVariable_current.StageName}, &apos;Lost&apos;), ISPICKVAL({!myVariable_current.StageName}, &apos;Cancelled&apos;) ) )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue> AND(
OR(
ISPICKVAL([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c, &apos;Yes&apos;),
[Opportunity].Account.Core_Military_Aerospace_and_Government__c =true
),
[Opportunity].Core_Standard_Customer_Refresh__c= true
 )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_35</name>
        <dataType>Boolean</dataType>
        <expression> AND(
OR(
ISPICKVAL({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c}, &apos;Yes&apos;),
{!myVariable_current.Account.Core_Military_Aerospace_and_Government__c} =true
),
{!myVariable_current.Core_Standard_Customer_Refresh__c}= true
 )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND( ISNEW(), [Opportunity].Core_Lead_Conversion_Flag__c )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISNEW(), {!myVariable_current.Core_Lead_Conversion_Flag__c} )</expression>
    </formulas>
