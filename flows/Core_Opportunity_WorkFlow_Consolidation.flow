            <value>
                <stringValue>IF([Opportunity].Core_Status_Update_Check__c=1, 0, 1)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_18_myRule_17_A1_0758442019</name>
        <dataType>Number</dataType>
        <expression>IF({!myVariable_current.Core_Status_Update_Check__c}=1, 0, 1)</expression>
        <scale>18</scale>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
