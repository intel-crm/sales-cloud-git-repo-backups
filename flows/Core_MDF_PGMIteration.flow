    <decisions>
        <description>If List is Not Null</description>
        <name>Core_MDF_Check_if_PGMList_is_NOT_NULL</name>
        <label>Check if PGMList is NOT NULL</label>
        <locationX>450</locationX>
        <locationY>205</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_PGMList_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Core_MDF_PGMList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Loop_through_PGMList</targetReference>
            </connector>
            <label>PGMList is NOT NULL</label>
        </rules>
    </decisions>
    <decisions>
        <description>If List is Not Null</description>
        <name>Core_MDF_Check_if_sCollectionAccountShareToBeInserted_has_values</name>
        <label>Check if  sCollectionAccountShareToBeInserted has values</label>
        <locationX>646</locationX>
        <locationY>399</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_AccountShareToBeInserted_is_NOT_EMPTY</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Core_MDF_AccShareToBeInserted</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Insert_sCollectionAccountShareToBeInserted</targetReference>
            </connector>
            <label>AccountShareToBeInserted is NOT EMPTY</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Core_MDF_PGMIteration {!$Flow.CurrentDateTime}</interviewLabel>
