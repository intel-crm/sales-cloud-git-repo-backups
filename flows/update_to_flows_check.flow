    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>ISPICKVAL([Campaign].Core_MDF_Program__c , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
(ISCHANGED([Campaign].Core_MDF_Approval_Step_Counter_nbr__c ) &amp;&amp;
([Campaign].Core_MDF_Approval_Step_Counter_nbr__c == 1) ||
([Campaign].Core_MDF_Approval_Step_Counter_nbr__c == 0 &amp;&amp;
ISPICKVAL([Campaign].Status , &apos;Revision Required&apos;) &amp;&amp;
PRIORVALUE([Campaign].Core_MDF_Approval_Step_Counter_nbr__c) ==0 ))
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_13</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!myVariable_current.Core_MDF_Program__c} , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
(ISCHANGED({!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c} ) &amp;&amp;
({!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c} == 1) ||
({!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c} == 0 &amp;&amp;
ISPICKVAL({!myVariable_current.Status} , &apos;Revision Required&apos;) &amp;&amp;
PRIORVALUE({!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c}) ==0 ))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>ISPICKVAL([Campaign].Status,&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE([Campaign].Status),&apos;Pending Approval&apos;))&amp;&amp;
(ISPICKVAL([Campaign].Core_MDF_Program__c ,&apos;Intel Partner Alliance&apos;)||ISPICKVAL([Campaign].Core_MDF_Program__c ,&apos;Channel MDF&apos;)) &amp;&amp; (ISPICKVAL(PRIORVALUE([Campaign].Status),&apos;Pending Review&apos;)||(Not(ISPICKVAL(PRIORVALUE([Campaign].Core_MDF_Approval_Stage_nm__c),&apos;L1 Approval&apos;))&amp;&amp;[Campaign].Core_MDF_Approval_Step_Counter_nbr__c= 1))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_15</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!myVariable_current.Status},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!myVariable_current.Status}),&apos;Pending Approval&apos;))&amp;&amp;
(ISPICKVAL({!myVariable_current.Core_MDF_Program__c} ,&apos;Intel Partner Alliance&apos;)||ISPICKVAL({!myVariable_current.Core_MDF_Program__c} ,&apos;Channel MDF&apos;)) &amp;&amp; (ISPICKVAL(PRIORVALUE({!myVariable_current.Status}),&apos;Pending Review&apos;)||(Not(ISPICKVAL(PRIORVALUE({!myVariable_current.Core_MDF_Approval_Stage_nm__c}),&apos;L1 Approval&apos;))&amp;&amp;{!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c}= 1))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>ISPICKVAL([Campaign].Status,&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE([Campaign].Status),&apos;Pending Approval&apos;))&amp;&amp;
(ISPICKVAL([Campaign].Core_MDF_Program__c ,&apos;Intel Partner Alliance&apos;)||ISPICKVAL([Campaign].Core_MDF_Program__c ,&apos;Channel MDF&apos;)) &amp;&amp; (ISPICKVAL(PRIORVALUE([Campaign].Status),&apos;Pending Review&apos;)||(Not(ISPICKVAL(PRIORVALUE([Campaign].Core_MDF_Approval_Stage_nm__c),&apos;L1 Approval&apos;))&amp;&amp;[Campaign].Core_MDF_Approval_Step_Counter_nbr__c= 1))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_15_pmetrule</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!myVariable_old.Status},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!myVariable_old.Status}),&apos;Pending Approval&apos;))&amp;&amp;
(ISPICKVAL({!myVariable_old.Core_MDF_Program__c} ,&apos;Intel Partner Alliance&apos;)||ISPICKVAL({!myVariable_old.Core_MDF_Program__c} ,&apos;Channel MDF&apos;)) &amp;&amp; (ISPICKVAL(PRIORVALUE({!myVariable_old.Status}),&apos;Pending Review&apos;)||(Not(ISPICKVAL(PRIORVALUE({!myVariable_old.Core_MDF_Approval_Stage_nm__c}),&apos;L1 Approval&apos;))&amp;&amp;{!myVariable_old.Core_MDF_Approval_Step_Counter_nbr__c}= 1))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>ISPICKVAL([Campaign].Core_MDF_Program__c , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
ISCHANGED([Campaign].Status) &amp;&amp;
ISPICKVAL([Campaign].Status ,  &apos;Revision Required&apos;) &amp;&amp;
(TEXT(PRIORVALUE([Campaign].Status)) = &quot;Pending Review&quot; ||
TEXT(PRIORVALUE([Campaign].Status)) = &quot;Pending Approval&quot;)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_22</name>
        <dataType>Boolean</dataType>
