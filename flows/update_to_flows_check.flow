ISCHANGED({!myVariable_current.Status}) &amp;&amp;
ISPICKVAL({!myVariable_current.Status} ,  &apos;Revision Required&apos;) &amp;&amp;
(TEXT(PRIORVALUE({!myVariable_current.Status})) = &quot;Pending Review&quot; ||
TEXT(PRIORVALUE({!myVariable_current.Status})) = &quot;Pending Approval&quot;)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
