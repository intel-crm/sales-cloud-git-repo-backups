        <name>formula_myRule_31</name>
        <dataType>Boolean</dataType>
        <expression>(ISPICKVAL({!myVariable_current.Core_MDF_Program__c} , &apos;Channel MDF&apos;) &amp;&amp; {!myVariable_current.Core_MDF_Proposal_Based_Ind__c} == true)  &amp;&amp;
ISCHANGED({!myVariable_current.Status}) &amp;&amp;
ISPICKVAL({!myVariable_current.Status} ,  &apos;Revision Required&apos;) &amp;&amp;
(TEXT(PRIORVALUE({!myVariable_current.Status})) = &quot;Pending Review&quot; ||
TEXT(PRIORVALUE({!myVariable_current.Status})) = &quot;Pending Approval&quot;)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>ISPICKVAL([Campaign].Core_MDF_Program__c ,&apos;Intel Partner Alliance&apos;) &amp;&amp;
 (((ISPICKVAL([Campaign].Status,&apos;Pending Review&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE([Campaign].Status),&apos;Pending Review&apos;))) ||
 (ISPICKVAL([Campaign].Status,&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE([Campaign].Status),&apos;Pending Approval&apos;)) &amp;&amp; 
 [Campaign].Core_MDF_Approval_Step_Counter_nbr__c= 1 &amp;&amp; Not(ISPICKVAL(PRIORVALUE([Campaign].Core_MDF_Approval_Stage_nm__c),&apos;L1 Approval&apos;))))||
 (ISPICKVAL([Campaign].Core_MDF_IPA_Approval_Status_nm__c,&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE([Campaign].Core_MDF_IPA_Approval_Status_nm__c),&apos;Pending Approval&apos;))))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_7</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!myVariable_current.Core_MDF_Program__c} ,&apos;Intel Partner Alliance&apos;) &amp;&amp;
 (((ISPICKVAL({!myVariable_current.Status},&apos;Pending Review&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!myVariable_current.Status}),&apos;Pending Review&apos;))) ||
 (ISPICKVAL({!myVariable_current.Status},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!myVariable_current.Status}),&apos;Pending Approval&apos;)) &amp;&amp; 
 {!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c}= 1 &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!myVariable_current.Core_MDF_Approval_Stage_nm__c}),&apos;L1 Approval&apos;))))||
 (ISPICKVAL({!myVariable_current.Core_MDF_IPA_Approval_Status_nm__c},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!myVariable_current.Core_MDF_IPA_Approval_Status_nm__c}),&apos;Pending Approval&apos;))))</expression>
    </formulas>
