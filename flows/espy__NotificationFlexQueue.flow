    <decisions>
        <name>Holding_count_greater_than_limit</name>
        <label>Holding count greater than limit</label>
        <locationX>1226</locationX>
        <locationY>306</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Holding_count_greater_than_limit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Metadata.espy__Is_Active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>HoldingAsyncApexJobCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Parsingtodouble</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notification_for_Flex_Queue_Limit</targetReference>
            </connector>
            <label>Outcome 1 of Holding count greater than limit</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Started_Today</name>
