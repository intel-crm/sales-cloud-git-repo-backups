        <locationX>617</locationX>
        <locationY>619</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Started_Today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FlowStartDateOnly</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Holding_AsyncApexJob</targetReference>
            </connector>
            <label>Started Today</label>
        </rules>
    </decisions>
