<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_CMF_Group_to_Audit_field</name>
        <label>Assign CMF Group to Audit field</label>
        <locationX>182</locationX>
        <locationY>695</locationY>
        <assignmentItems>
            <assignToReference>$Record.ER_Start_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>StartDateF</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.CreatedById</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.ER_Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.ER_Account__r.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Matching_Duplicate_Record</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Display_Duplicate_Record_error</name>
        <label>Display Duplicate Record error</label>
        <locationX>50</locationX>
        <locationY>1019</locationY>
        <customErrorMessages>
            <errorMessage>{!DuplicateErrorMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Validation_Error_for_Association_Change</name>
        <label>Validation Error for Association Change</label>
        <locationX>248</locationX>
        <locationY>395</locationY>
        <connector>
            <targetReference>Record_creation_check</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>Record Associations cannot be changed.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Duplicate_Record_Validation</name>
        <label>Duplicate Record Validation</label>
        <locationX>182</locationX>
        <locationY>911</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Record_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matching_Duplicate_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Duplicate_Record_error</targetReference>
            </connector>
            <label>Duplicate Record Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Record_creation_check</name>
        <label>Record creation check</label>
        <locationX>380</locationX>
        <locationY>587</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_Insert</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CMF_Group_to_Audit_field</targetReference>
            </connector>
            <label>Record Insert</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Record_Associations_Change</name>
        <label>Verify Record Associations Change</label>
        <locationX>380</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Record_creation_check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Association_Changed</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.ER_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Account__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.ER_Customer_Master_File_Grouping__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ER_Customer_Master_File_Grouping__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Validation_Error_for_Association_Change</targetReference>
            </connector>
            <label>Association Changed</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DuplicateErrorMessage</name>
        <dataType>String</dataType>
        <expression>&apos;Account Record is already associated to the Customer Master File Group &apos;+&apos;&quot;&apos;+{!$Record.ER_Account__r.Name}+&apos;&quot;&apos;</expression>
    </formulas>
    <formulas>
        <name>StartDateF</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Account Business Partner Before Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Business Partner Before Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Matching_Duplicate_Record</name>
        <label>Get Matching Duplicate Record</label>
        <locationX>182</locationX>
        <locationY>803</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Duplicate_Record_Validation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ER_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ER_Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ER_Customer_Master_File_Grouping__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ER_Customer_Master_File_Grouping__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ER_End_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ER_Account_Business_Partner__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Verify_Record_Associations_Change</targetReference>
        </connector>
        <object>ER_Account_Business_Partner__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
