<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_new_Retry_Counter_Value</name>
        <label>Assign new Retry Counter Value</label>
        <locationX>537</locationX>
        <locationY>446</locationY>
        <assignmentItems>
            <assignToReference>RetryCounterOld</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GetInboundMessage.Core_Retry_Counter__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_the_IIM</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>ResumeTime</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} + 1/1440</expression>
    </formulas>
    <formulas>
        <name>RetryCounterNew</name>
        <dataType>Number</dataType>
        <expression>{!RetryCounterOld} + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Update Failed Inbound to Pending {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Failed Inbound to Pending</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetInboundMessage</name>
        <label>GetInboundMessage</label>
        <locationX>537</locationX>
        <locationY>326</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_new_Retry_Counter_Value</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>InboundMessageId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Integration_Inbound_Message__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Retry_Counter__c</queriedFields>
        <queriedFields>Core_Processing_Status__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_the_IIM</name>
        <label>Update the IIM</label>
        <locationX>537</locationX>
        <locationY>566</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>InboundMessageId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Processing_Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Retry_Counter__c</field>
            <value>
                <elementReference>RetryCounterNew</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Integration_Inbound_Message__c</object>
    </recordUpdates>
    <start>
        <locationX>543</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Pause_for_breaking_the_transaction</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>InboundMessageId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>RetryCounterOld</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <waits>
        <name>Pause_for_breaking_the_transaction</name>
        <label>Pause for breaking the transaction</label>
        <locationX>669</locationX>
        <locationY>206</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <name>Pause_Path</name>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>GetInboundMessage</targetReference>
            </connector>
            <eventType>AlarmEvent</eventType>
            <inputParameters>
                <name>AlarmTime</name>
                <value>
                    <elementReference>ResumeTime</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffset</name>
                <value>
                    <numberValue>0.0</numberValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffsetUnit</name>
                <value>
                    <stringValue>Hours</stringValue>
                </value>
            </inputParameters>
            <label>Pause Path</label>
        </waitEvents>
    </waits>
</Flow>
