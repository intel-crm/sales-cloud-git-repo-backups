IF(ISBLANK([Case].Core_IPS_Partner_Sup_Owner__c  ), FALSE,[Case].Core_IPS_Partner_Sup_Owner__c.IsActive=true)
                         ),
                             
                 [Case].Core_IPS_Is_Notification_Active__c = TRUE,
                 [Case].Core_IPS_Customer_Visible__c = TRUE,
                       OR(    ISPICKVAL([Case].Status, &apos;New&apos;),
			          ISPICKVAL([Case].Status, &apos;Open&apos;)  ) ,
             NOT(  ISPICKVAL([Case].Core_Sub_Status__c , &apos;Close-Pending&apos;)) ,
              AND(   
                                ISCHANGED([Case].Core_Latest_Comment_Time_Stamp__c),
                                NOT(ISBLANK([Case].Core_Latest_Comment_Time_Stamp__c))                
	                    ),
                                       
             ISPICKVAL([Case].Core_Latest_Case_Comment_Type__c , &apos;Public to Customers&apos; )
      


)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_9_pmetrule</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
NOT(IF(({!$User.ProfileId}={!$Label.Core_IPS_Data_Migration_ProfileId}),true,false)), 
	       {!myVariable_old.RecordType.DeveloperName}=
                                           {!$Label.Core_IPS_CaseCreateRecordType_Name},
        
                   OR(      {!myVariable_old.Count_Ext_Interested_Parties__c} &gt; 0,
                           /* NOT( ISBLANK(myVariable_old.Core_IPS_Partner_Sup_Owner__c  )) */
                            /*Null checks and user active checks on  case Core_IPS_Partner_Sup_Owner__c field added by karthick- US113974*/ 				
IF(ISBLANK({!myVariable_old.Core_IPS_Partner_Sup_Owner__c}  ), FALSE,{!myVariable_old.Core_IPS_Partner_Sup_Owner__r.IsActive}=true)
                         ),
                             
                 {!myVariable_old.Core_IPS_Is_Notification_Active__c} = TRUE,
                 {!myVariable_old.Core_IPS_Customer_Visible__c} = TRUE,
                       OR(    ISPICKVAL({!myVariable_old.Status}, &apos;New&apos;),
			          ISPICKVAL({!myVariable_old.Status}, &apos;Open&apos;)  ) ,
             NOT(  ISPICKVAL({!myVariable_old.Core_Sub_Status__c} , &apos;Close-Pending&apos;)) ,
              AND(   
                                ISCHANGED({!myVariable_old.Core_Latest_Comment_Time_Stamp__c}),
                                NOT(ISBLANK({!myVariable_old.Core_Latest_Comment_Time_Stamp__c}))                
	                    ),
                                       
             ISPICKVAL({!myVariable_old.Core_Latest_Case_Comment_Type__c} , &apos;Public to Customers&apos; )
      


)</expression>
    </formulas>
