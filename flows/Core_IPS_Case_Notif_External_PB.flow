    <description>Process Builder to send IPS notifications - External</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(       
             NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)), 
	       OR(  [Case].RecordType.developerName=
                                           $Label.Core_IPS_CaseCreateRecordType_Name,
		         [Case].RecordType.developerName= 
                                           $Label.Core_IPS_GECRecordTypeName),   
                  NOT( ISBLANK([Case].ContactId )),
                  NOT(ISNULL([Case].ContactId )) , 
                 ISNEW(),
                 [Case].Core_IPS_Is_Notification_Active__c = TRUE,
                 [Case].Contact.Core_IPS_Active__c = TRUE, 
		 [Case].Contact.Core_IPS_Email_Opt_Out__c = FALSE,  
                 [Case].Core_IPS_Customer_Visible__c = TRUE,
              OR(    ISPICKVAL([Case].Status, &apos;New&apos;),
			  ISPICKVAL([Case].Status, &apos;On Hold&apos;)  ) 
               
   )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(       
             NOT(IF(({!$User.ProfileId}={!$Label.Core_IPS_Data_Migration_ProfileId}),true,false)), 
	       OR(  {!myVariable_current.RecordType.DeveloperName}=
                                           {!$Label.Core_IPS_CaseCreateRecordType_Name},
		         {!myVariable_current.RecordType.DeveloperName}= 
                                           {!$Label.Core_IPS_GECRecordTypeName}),   
                  NOT( ISBLANK({!myVariable_current.ContactId} )),
                  NOT(ISNULL({!myVariable_current.ContactId} )) , 
                 ISNEW(),
                 {!myVariable_current.Core_IPS_Is_Notification_Active__c} = TRUE,
                 {!myVariable_current.Contact.Core_IPS_Active__c} = TRUE, 
		 {!myVariable_current.Contact.Core_IPS_Email_Opt_Out__c} = FALSE,  
                 {!myVariable_current.Core_IPS_Customer_Visible__c} = TRUE,
              OR(    ISPICKVAL({!myVariable_current.Status}, &apos;New&apos;),
			  ISPICKVAL({!myVariable_current.Status}, &apos;On Hold&apos;)  ) 
               
   )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND( 
NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)), 
	       [Case].RecordType.developerName=
                                           $Label.Core_IPS_CaseCreateRecordType_Name,
              NOT(ISNULL([Case].ContactId )) , 
              NOT( ISBLANK([Case].ContactId )),

                 [Case].Core_IPS_Is_Notification_Active__c = TRUE,
                 [Case].Contact.Core_IPS_Active__c = TRUE, 
		         [Case].Contact.Core_IPS_Email_Opt_Out__c = FALSE,  
                 [Case].Core_IPS_Customer_Visible__c = TRUE,
			          ISPICKVAL([Case].Status, &apos;Open&apos;)  ,
             ISPICKVAL([Case].Core_Sub_Status__c , &apos;Close-Pending&apos;) ,
                AND(   
                                ISCHANGED([Case].Core_Latest_Comment_Time_Stamp__c),
                                NOT(ISBLANK([Case].Core_Latest_Comment_Time_Stamp__c))
                               
	                    ),
                                       
             ISPICKVAL([Case].Core_Latest_Case_Comment_Type__c , &apos;Public to Customers&apos; )

        

)</stringValue>
            </value>
