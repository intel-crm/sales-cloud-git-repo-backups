    <description>This flow ensures all change alerts for specification value</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
ISPICKVAL(PRIORVALUE([PMP_Specification_Value__c].PMP_Product_Status__c ) ,&quot;Roadmap&quot;) , ISPICKVAL(([PMP_Specification_Value__c].PMP_Product_Status__c) ,&quot;Launched&quot;)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISPICKVAL(PRIORVALUE({!myVariable_current.PMP_Product_Status__c} ) ,&quot;Roadmap&quot;) , ISPICKVAL(({!myVariable_current.PMP_Product_Status__c}) ,&quot;Launched&quot;)
)</expression>
    </formulas>
