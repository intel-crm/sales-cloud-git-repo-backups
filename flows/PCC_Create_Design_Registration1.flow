<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Deal_Registration_exists</name>
        <label>Deal Registration exists?</label>
        <locationX>611</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Deal_exixts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>DR exists</defaultConnectorLabel>
        <rules>
            <name>Deal_Registration_doesnt_exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Deal_Registration_Record</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Lead_ready_for_conversion</targetReference>
            </connector>
            <label>Deal Registration doesnt exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Lead_ready_for_conversion</name>
        <label>Lead ready for conversion?</label>
        <locationX>380</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>getRecordTypeId</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Lead_not_ready_for_conversion</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Record.PCC_End_Customer_Name__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead_Record.Street1__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>lead_stage</targetReference>
            </connector>
            <label>Lead not ready for conversion?</label>
        </rules>
    </decisions>
    <decisions>
        <name>lead_stage</name>
        <label>lead stage</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Lead_error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>leas_stage_qualified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PQL</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FIELD_VALUES</targetReference>
            </connector>
            <label>lead stage qualified</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Create Design Registration {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Partner Campaign Design Registration</label>
    <processMetadataValues>
        <name>BuilderType</name>
