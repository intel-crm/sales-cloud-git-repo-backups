            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_End_Customer_Nm__c</field>
            <value>
                <elementReference>Get_Lead_Record.PCC_End_Customer_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
