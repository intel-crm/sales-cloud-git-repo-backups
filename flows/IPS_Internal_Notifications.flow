              NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
                {!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,
	 OR(  
               ({!$Record.RecordType.developerName}=={!$Label.Core_IPS_NoAssignedContactRecordType_Name} ),
                                                          
                 ({!$Record.RecordType.developerName} =={!$Label.Core_IPS_CaseCreateRecordType_Name}),                 
                 ({!$Record.RecordType.developerName}=={!$Label.Core_IPS_GECRecordTypeName}) ),
                                                                           
               OR( ISPICKVAL({!$Record.Status}, &apos;New&apos;),
	              ISPICKVAL({!$Record.Status}, &apos;Open&apos;),
                       ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;)  ) ,
																		   
		ISCHANGED({!$Record.Core_Intel_Sup_Owner__c} ),
                 IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive}==true)

   )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_27</name>
        <dataType>Boolean</dataType>
        <expression>AND(
         NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
            {!$Record.Core_IPS_Is_Notification_Active__c}==true,           
       OR( ({!$Record.RecordType.developerName}=={!$Label.Core_IPS_NoAssignedContactRecordType_Name} ),                                   
                 ({!$Record.RecordType.developerName} =={!$Label.Core_IPS_CaseCreateRecordType_Name}),                                                 
                 ({!$Record.RecordType.developerName}=={! $Label.Core_IPS_GECRecordTypeName}) ),
                                                      
            OR( ISPICKVAL({!$Record.Status}, &apos;New&apos;),
	              ISPICKVAL({!$Record.Status}, &apos;Open&apos;),
                      ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;)  ) ,
 
         ISCHANGED({!$Record.Core_Severity__c}  ) ,

          /*Active user check on  case owner, ISO, Co-Owner and interested parties*/ 
	OR(    
		IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive}==true, TRUE),
		IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive}==true),
		IF(ISBLANK({!$Record.Core_Case_Co_Owner__c} ), FALSE, {!$Record.Core_Case_Co_Owner__r.IsActive}==true),
		{!$Record.Core_IPS_Count_Int_Interested_Parties__c}  &gt; 0 
	)   
   )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_29</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
	 NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
	{!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,
	({!$Record.RecordType.developerName}== {!$Label.Core_IPS_GECRecordTypeName}) ,

	ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;),
	{!$Record.Core_IPS_GEC_Flag__c}  == TRUE, 
	
	OR( ISCHANGED({!$Record.Core_IPS_GEC_Request_Status__c}), ISNEW()),
	ISPICKVAL({!$Record.Core_IPS_GEC_Request_Status__c}, &apos;MAG Questionnaire Required&apos;),
	IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive}==true)

)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
   NOT(IF({!$User.ProfileId}=={!$Label.Core_IPS_Data_Migration_ProfileId}, true, false)),
    {!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,
              
OR(
   ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_CaseCreateRecordType_Name}),
   ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_GECRecordTypeName}),
   ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_NoAssignedContactRecordType_Name})
),                                                    
                 
OR(ISPICKVAL({!$Record.Status}, &apos;New&apos;), ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;)
),
ISNEW( ),
IF(LEFT({!$Record.OwnerId}, 3) == &apos;00G&apos;  ,  CONTAINS({!$Label.Core_IPS_Case_Q_Exclude_Asgnmt_Email} ,  {!$Record.Owner:Group.DeveloperName}), FALSE),

OR(
          IF(ISBLANK({!$Record.Core_Case_Co_Owner__c} ), FALSE, {!$Record.Core_Case_Co_Owner__r.IsActive}==true),
          IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive}==true)	
)
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_31</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
    {!$Record.Core_IPS_Is_Notification_Active__c} ==true,           
    {!$Record.RecordType.developerName}== {!$Label.Core_IPS_CaseCreateRecordType_Name},     
    AND( 
		ISPICKVAL({!$Record.Status}, &apos;Open&apos;), 
		ISPICKVAL({!$Record.Core_Sub_Status__c}, &apos;Close-Pending&apos;)  
	),	
	AND(   
                            ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                             NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))                               
	              ),			
	ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Public to Customers&apos; ),	
	OR(    
		IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive}==true, TRUE),
		IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive}==true),
		IF(ISBLANK({!$Record.Core_Case_Co_Owner__c} ), FALSE, {!$Record.Core_Case_Co_Owner__r.IsActive}==true ),
		{!$Record.Core_IPS_Count_Int_Interested_Parties__c}  &gt; 0 
	)

)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_32</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT($User.ProfileId = $Label.Core_IPS_Data_Migration_ProfileId),
    {!$Record.Core_IPS_Is_Notification_Active__c} = true,
    {!$Record.RecordType.DeveloperName} = $Label.Core_IPS_CaseCreateRecordType_Name,

    AND(
        TEXT({!$Record.Status}) = &apos;Open&apos;,
        TEXT({!$Record.Core_Sub_Status__c}) = &apos;Close-Pending&apos;
    ),

        AND(
            NOT(ISBLANK({!$Record.Core_Intel_Sup_Owner__c})),
            {!$Record.Core_Intel_Sup_Owner__r.IsActive} = true
        )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_33</name>
        <dataType>Boolean</dataType>
        <expression>AND(

    NOT($User.ProfileId = $Label.Core_IPS_Data_Migration_ProfileId),

    {!$Record.Core_IPS_Is_Notification_Active__c} = true,

    {!$Record.RecordType.DeveloperName} = $Label.Core_IPS_NoAssignedContactRecordType_Name,

    AND(
        TEXT({!$Record.Status}) = &apos;Open&apos;,
        TEXT({!$Record.Core_Sub_Status__c}) = &apos;Close-Pending&apos;
    ),

    AND(
        ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
        NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))
    ),

    TEXT({!$Record.Core_Latest_Case_Comment_Type__c}) = &apos;Public to Customers&apos;,

    AND(
        {!$Record.CreatedById} &lt;&gt; {!$Record.OwnerId},
        {!$Record.CreatedById} &lt;&gt; {!$Record.Core_Case_Co_Owner__c}
    ),

    OR(
        IF(
            ISBLANK({!$Record.CreatedById}),
            false,
            {!$Record.CreatedBy.IsActive} = true
        ),

        IF(
            BEGINS({!$Record.OwnerId}, &quot;005&quot;),
            {!$Record.Owner:User.IsActive} = true,
            true
        ),

        IF(
            ISBLANK({!$Record.Core_Intel_Sup_Owner__c}),
            false,
            {!$Record.Core_Intel_Sup_Owner__r.IsActive} = true
        ),

        IF(
            ISBLANK({!$Record.Core_Case_Co_Owner__c}),
            false,
            {!$Record.Core_Case_Co_Owner__r.IsActive} = true
        ),

        {!$Record.Core_IPS_Count_Int_Interested_Parties__c} &gt; 0
    )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_33A</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT($User.ProfileId = $Label.Core_IPS_Data_Migration_ProfileId),

    {!$Record.Core_IPS_Is_Notification_Active__c} = true,

    OR(
        {!$Record.RecordType.DeveloperName} = $Label.Core_IPS_ClosedCase_RecordType_Name,
        {!$Record.RecordType.DeveloperName} = $Label.Core_IPS_GECRecordTypeName
    ),

    ISCHANGED({!$Record.Status}),

    TEXT({!$Record.Status}) = &apos;Closed&apos;,

    OR(
        IF(
            BEGINS({!$Record.OwnerId}, &quot;005&quot;),
            {!$Record.Owner:User.IsActive} = true,
            true
        ),

        IF(
            ISBLANK({!$Record.Core_Intel_Sup_Owner__c}),
            false,
            {!$Record.Core_Intel_Sup_Owner__r.IsActive} = true
        ),

        IF(
            ISBLANK({!$Record.Core_Case_Co_Owner__c}),
            false,
            {!$Record.Core_Case_Co_Owner__r.IsActive} = true
        ),

        {!$Record.Core_IPS_Count_Int_Interested_Parties__c} &gt; 0
    )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_35</name>
        <dataType>Boolean</dataType>
        <expression>AND(

    NOT($User.ProfileId = $Label.Core_IPS_Data_Migration_ProfileId),

    {!$Record.Core_IPS_Is_Notification_Active__c} = true,

    OR(
        {!$Record.RecordType.DeveloperName} = $Label.Core_IPS_ClosedCase_RecordType_Name
    ),

    ISCHANGED({!$Record.Status}),

    TEXT({!$Record.Status}) = &apos;Closed&apos;,

    {!$Record.Core_IPS_Self_Assigned__c} = true,

    IF(
        ISBLANK({!$Record.CreatedById}),
        false,
        {!$Record.CreatedBy.IsActive} = true
    ),

    {!$Record.CreatedById} &lt;&gt; {!$Record.OwnerId}
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_36</name>
        <dataType>Boolean</dataType>
        <expression>AND(

    NOT($User.ProfileId = $Label.Core_IPS_Data_Migration_ProfileId),

    {!$Record.Core_IPS_Is_Notification_Active__c} = true,

    {!$Record.RecordType.DeveloperName} = $Label.Core_IPS_GECRecordTypeName,

    TEXT({!$Record.Status}) = &apos;On Hold&apos;,

    ISCHANGED({!$Record.Core_IPS_GEC_Request_Status__c}),

    TEXT({!$Record.Core_IPS_GEC_Request_Status__c}) = &apos;MAG Questionnaire Completed&apos;,

    IF(
        BEGINS({!$Record.OwnerId}, &quot;005&quot;),
        {!$Record.Owner:User.IsActive} = true,
        true
    )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_37</name>
        <dataType>Boolean</dataType>
        <expression>AND(

    NOT($User.ProfileId = $Label.Core_IPS_Data_Migration_ProfileId),

    {!$Record.Core_IPS_Is_Notification_Active__c} = true,

    {!$Record.RecordType.DeveloperName} = $Label.Core_IPS_GECRecordTypeName,

    OR(
        ISNEW(),
        ISCHANGED({!$Record.Status})
    ),

    TEXT({!$Record.Status}) = &apos;On Hold&apos;,

    {!$Record.Core_IPS_GEC_Flag__c} = true,

    IF(
        ISBLANK({!$Record.Core_Intel_Sup_Owner__c}),
        false,
        {!$Record.Core_Intel_Sup_Owner__r.IsActive} = true
    )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
    {!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,
    OR(
        ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_CaseCreateRecordType_Name}),
        ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_GECRecordTypeName}),   
        ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_NoAssignedContactRecordType_Name})           
    ),
    OR(
        ISPICKVAL({!$Record.Status}, &apos;New&apos;),
        ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;),
        ISPICKVAL({!$Record.Status}, &apos;Open&apos;)
    ),
    ISCHANGED({!$Record.OwnerId}),
    IF(LEFT({!$Record.OwnerId}, 3) == &apos;005&apos;  , TRUE, NOT(CONTAINS({!$Label.Core_IPS_Case_Q_Exclude_Asgnmt_Email} , {!$Record.Owner:Group.DeveloperName} ))),
IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive}==true, true)
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_7</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
	 NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
    {!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,
  
OR(
   ({!$Record.RecordType.developerName} = {!$Label.Core_IPS_CaseCreateRecordType_Name}),
   ({!$Record.RecordType.developerName} = {!$Label.Core_IPS_GECRecordTypeName}),                                                    
   ({!$Record.RecordType.developerName} = {!$Label.Core_IPS_NoAssignedContactRecordType_Name})
),             
                 
OR(
   ISPICKVAL({!$Record.Status}, &apos;New&apos;), 
   ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;),
   ISPICKVAL({!$Record.Status}, &apos;Open&apos;)
   ),

ISCHANGED({!$Record.Core_Case_Co_Owner__c} ),
({!$Record.OwnerId} &lt;&gt; {!$Record.Core_Case_Co_Owner__c}),

OR(
        IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive}==true, TRUE),   
         IF(ISBLANK({!$Record.Core_Case_Co_Owner__c} ), FALSE, {!$Record.Core_Case_Co_Owner__r.IsActive}==true )
)


)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_9</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
               NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),

                {!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,
  
         NOT(ISPICKVAL({!$Record.Core_Sub_Status__c},&apos;Close-Pending&apos;) ), 
  
	 OR(  
               ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_NoAssignedContactRecordType_Name} ),                                                         
                 ({!$Record.RecordType.developerName} =={!$Label.Core_IPS_CaseCreateRecordType_Name}),
                   ({!$Record.RecordType.developerName} ==  {!$Label.Core_IPS_ClosedCase_RecordType_Name}),                                      
                  ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_GECRecordTypeName}) ),
                    
	    OR( ISPICKVAL({!$Record.Status}, &apos;New&apos;),
	            ISPICKVAL({!$Record.Status}, &apos;Open&apos;),
                    ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;)  ) ,
                    
	        AND(   
                            ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                             NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))                               
	              ),                   
             ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Public to Customers&apos; ),
	OR(    
		IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive}==true, TRUE),
		IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive}==true),
		IF(ISBLANK({!$Record.Core_Case_Co_Owner__c} ), FALSE, {!$Record.Core_Case_Co_Owner__r.IsActive}==true ),
		{!$Record.Core_IPS_Count_Int_Interested_Parties__c}  &gt; 0 
	)  
  
   )</expression>
    </formulas>
