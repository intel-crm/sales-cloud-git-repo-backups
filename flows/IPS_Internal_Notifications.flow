    </decisions>
    <description>Migrated from the IPS Internal Notifications process using multiple criteria.
This process builder deals with all internal notifications in IPS</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule34</name>
        <dataType>Boolean</dataType>
        <expression>AND(

    NOT($User.ProfileId = $Label.Core_IPS_Data_Migration_ProfileId),

    {!$Record.Core_IPS_Is_Notification_Active__c} = true,

    {!$Record.RecordType.DeveloperName} = $Label.Core_IPS_NoAssignedContactRecordType_Name,

    AND(
        TEXT({!$Record.Status}) = &apos;Open&apos;,
        TEXT({!$Record.Core_Sub_Status__c}) = &apos;Close-Pending&apos;
    ),

    AND(
        {!$Record.CreatedById} &lt;&gt; {!$Record.OwnerId},
        {!$Record.CreatedById} &lt;&gt; {!$Record.Core_Case_Co_Owner__c}
    ),

    OR(
        IF(
            ISBLANK({!$Record.CreatedById}),
            false,
            {!$Record.CreatedBy.IsActive} = true
        ),

        IF(
            ISBLANK({!$Record.Core_Intel_Sup_Owner__c}),
            false,
            {!$Record.Core_Intel_Sup_Owner__r.IsActive} = true
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
    NOT(IF({!$User.ProfileId}=={!$Label.Core_IPS_Data_Migration_ProfileId}, true, false)),
    {!$Record.Core_IPS_Is_Notification_Active__c} = TRUE,
              
OR(
   ({!$Record.RecordType.developerName} =={!$Label.Core_IPS_CaseCreateRecordType_Name}),
   ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_GECRecordTypeName}),
   ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_NoAssignedContactRecordType_Name})
),                                                    
                 
OR(ISPICKVAL({!$Record.Status}, &apos;New&apos;), ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;)
),
ISNEW( ),
IF(LEFT({!$Record.OwnerId}, 3) == &apos;005&apos;  , TRUE, NOT(CONTAINS({!$Label.Core_IPS_Case_Q_Exclude_Asgnmt_Email}, {!$Record.Owner:Group.DeveloperName} ))) ,
IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive==true}, TRUE)
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_11</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
               NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
                {!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,  
              NOT(ISPICKVAL({!$Record.Core_Sub_Status__c},&apos;Close-Pending&apos;) ),   
               ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_NoAssignedContactRecordType_Name} ),
             
	    OR( ISPICKVAL({!$Record.Status}, &apos;New&apos;),
	            ISPICKVAL({!$Record.Status}, &apos;Open&apos;)  ) ,
                        
	        AND(   
                            ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                             NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))                              
	              ),                    
             ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Public to Customers&apos; ),
 
IF(ISBLANK({!$Record.CreatedById}), FALSE,{!$Record.CreatedBy.IsActive}==true),
                  {!$Record.CreatedById} &lt;&gt; {!$Record.OwnerId}   
   )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_13</name>
        <dataType>Boolean</dataType>
        <expression>AND( 

             NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
             {!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,
               
	 OR(
                   ({!$Record.RecordType.developerName}=={!$Label.Core_IPS_NoAssignedContactRecordType_Name} ),                                                      
                 ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_CaseCreateRecordType_Name}),                                                     
                 ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_ClosedCase_RecordType_Name}),                                                       
                  ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_GECRecordTypeName})                                                                          
                ),
	  OR( ISPICKVAL({!$Record.Status}, &apos;New&apos;),
	          ISPICKVAL({!$Record.Status}, &apos;Open&apos;) ,
                  ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;) ),                        
	   AND(   
                            ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                             NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))                               
	              ),                    
             ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Private to Intel&apos; ),	                
	OR(    
		IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive}==true, TRUE),
		IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive}==true),
		IF(ISBLANK({!$Record.Core_Case_Co_Owner__c} ), FALSE, {!$Record.Core_Case_Co_Owner__r.IsActive}==true ),
		{!$Record.Core_IPS_Count_Int_Interested_Parties__c}  &gt; 0 
	)  
  
   )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_15</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
                NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
               {!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,              
	 OR(
                   ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_NoAssignedContactRecordType_Name} ),                                             
                 ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_CaseCreateRecordType_Name}),                                             
                 ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_ClosedCase_RecordType_Name}),                                              
                 ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_GECRecordTypeName})                                                                          
                ),
	    OR( ISPICKVAL({!$Record.Status}, &apos;New&apos;),
	            ISPICKVAL({!$Record.Status}, &apos;Open&apos;),
                    ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;)   ) ,                           
	     AND(   
                            ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                             NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))                               
	              ),                    
             ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Private to Agents&apos; ),
	OR(    
		IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive}==true, TRUE),		
		IF(ISBLANK({!$Record.Core_Case_Co_Owner__c} ), FALSE, {!$Record.Core_Case_Co_Owner__r.IsActive}==true)
	)    
   )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_17</name>
        <dataType>Boolean</dataType>
        <expression>AND( 

             NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),
             {!$Record.Core_IPS_Is_Notification_Active__c} == TRUE,              
	 OR(
                   ({!$Record.RecordType.developerName}=={!$Label.Core_IPS_NoAssignedContactRecordType_Name} ),                                                      
                 ({!$Record.RecordType.developerName}== {!$Label.Core_IPS_CaseCreateRecordType_Name}),                                                     
                 ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_ClosedCase_RecordType_Name}),                                                      
                  ({!$Record.RecordType.developerName}=={!$Label.Core_IPS_GECRecordTypeName})                                                                           
                ),
	  OR( ISPICKVAL({!$Record.Status}, &apos;New&apos;),
	          ISPICKVAL({!$Record.Status}, &apos;Open&apos;) ,
                  ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;) ),                        
	   AND(   
                            ISCHANGED({!$Record.Core_Latest_Comment_Time_Stamp__c}),
                             NOT(ISBLANK({!$Record.Core_Latest_Comment_Time_Stamp__c}))                               
	              ),
                    
             ISPICKVAL({!$Record.Core_Latest_Case_Comment_Type__c} , &apos;Private to Partner&apos; ),
	OR(    
		IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive}==true, TRUE),
		IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive}==true),
		IF(ISBLANK({!$Record.Core_Case_Co_Owner__c} ), FALSE, {!$Record.Core_Case_Co_Owner__r.IsActive}==true),
		{!$Record.Core_IPS_Count_Int_Interested_Parties__c}  &gt; 0 
	)  
   )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_19</name>
        <dataType>Boolean</dataType>
        <expression>AND(
            {!$Record.Core_IPS_Is_Notification_Active__c} ==true,
           NOT(IF({!$User.ProfileId} == {!$Label.Core_IPS_Data_Migration_ProfileId},true, false)),           
         OR( ({!$Record.RecordType.developerName}=={!$Label.Core_IPS_NoAssignedContactRecordType_Name }),                               
                 ({!$Record.RecordType.developerName} =={!$Label.Core_IPS_CaseCreateRecordType_Name}),                                                
                 ({!$Record.RecordType.developerName} == {!$Label.Core_IPS_GECRecordTypeName})  ),
                                                      
            OR( ISPICKVAL({!$Record.Status}, &apos;New&apos;),
	              ISPICKVAL({!$Record.Status}, &apos;Open&apos;),
                     ISPICKVAL({!$Record.Status}, &apos;On Hold&apos;) ) , 
         ISCHANGED({!$Record.Core_IPS_Project_Case__c}) ,

	OR(    
		IF(BEGINS({!$Record.OwnerId}, &quot;005&quot;), {!$Record.Owner:User.IsActive}==true, TRUE),
		IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive}==true),
		IF(ISBLANK({!$Record.Core_Case_Co_Owner__c} ), FALSE, {!$Record.Core_Case_Co_Owner__r.IsActive}==true),
		{!$Record.Core_IPS_Count_Int_Interested_Parties__c}  &gt; 0 
	) 
          
  
   )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_21</name>
