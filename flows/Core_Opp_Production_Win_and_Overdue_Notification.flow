    <recordUpdates>
        <description>Updates the &quot;System Owners Manager&quot; field with the email of Owner&apos;s Manager.</description>
        <name>Core_Opp_Set_Owners_Manager_Email</name>
        <label>Core_Opp_Set_Owners_Manager_Email</label>
        <locationX>50</locationX>
        <locationY>384</locationY>
        <inputAssignments>
            <field>Core_System_Owners_Manager__c</field>
            <value>
                <elementReference>$Record.Owner.Manager.Email</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>540</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_Owner_Manager_Email</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(AND(AND(ISPICKVAL({!$Record.StageName}, &apos;Design Win&apos;),CONTAINS(TEXT({!$Record.Core_Product_Segment__c}), &apos;Embedded&apos;)),CONTAINS(TEXT({!$Record.Core_Opportunity_Type__c}), &apos;Design&apos;)))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
