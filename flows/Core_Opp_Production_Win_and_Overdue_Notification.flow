            <connector>
                <targetReference>Check_for_Owner_Manager_Email_1</targetReference>
            </connector>
            <label>Core_Opp_Production_Win_Notification</label>
            <offsetNumber>-14</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Core_First_Customer_Ship_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
