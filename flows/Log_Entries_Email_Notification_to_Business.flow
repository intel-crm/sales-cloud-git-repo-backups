<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>IPS Survey Failure Email notification to Business Users</description>
        <name>Email_Notification</name>
        <label>Email Notification To Business Users</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>Core_Log_Entry__c.Quality_Builder_EmailAlert_For_Survey_Failure</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_Log_Entry__c.Quality_Builder_EmailAlert_For_Survey_Failure</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Trigger a flow whenever a record gets created in the log entry object with origin as quality builder</description>
    <environments>Default</environments>
    <interviewLabel>Log Entries Email Notification to Business {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Log Entries Email Notification to Business</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Email_Notification</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Project__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>IPS</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Tags__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Failure Quality Builder Report</stringValue>
            </value>
        </filters>
        <object>Core_Log_Entry__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
