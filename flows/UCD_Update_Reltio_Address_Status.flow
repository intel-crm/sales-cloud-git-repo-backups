<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check if User Is Reltio Integration User</description>
        <name>Reltio_UserCheck</name>
        <label>Reltio_UserCheck</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.Username</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>UserCheck</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Reltio_Address_Status_Field</targetReference>
            </connector>
            <label>Valid</label>
        </rules>
    </decisions>
    <description>This Flow will Update the Reltio Address Status Field on Account
V13 Change : The flow is updated to fast field and added logic to check for requested account as well as account reference source name is not equal to IQR/MyDeals.</description>
    <environments>Default</environments>
    <formulas>
        <name>Address_Status</name>
        <dataType>String</dataType>
        <expression>{!$Label.UCD_ACM_Status_Pending}</expression>
    </formulas>
    <interviewLabel>UCD_ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UCD_Update_Reltio_Address_Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update The Reltio Address Status Field on Account</description>
        <name>Update_Reltio_Address_Status_Field</name>
        <label>Update Reltio Address Status Field</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Core_Reltio_Address_Status__c</field>
            <value>
                <elementReference>Address_Status</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Reltio_UserCheck</targetReference>
        </connector>
        <filterLogic>((1 OR 2 OR 9) AND (10 AND 11)) AND (3 OR 4 OR 5 OR 6 OR 7 OR 8)</filterLogic>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Inactive Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDM_Location_State_Nm__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDM_Secondary_State_Cd__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Unified_Customer_Address__Street__s</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Unified_Customer_Address__City__s</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Unified_Customer_Address__PostalCode__s</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Unified_Customer_Address__CountryCode__s</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Requested Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Reference_Source_Name__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>MyDeals</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Reference_Source_Name__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>IQR</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>UserCheck</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>ucd_reltio_connector_user</stringValue>
        </value>
    </variables>
</Flow>
