<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Identify_Status</name>
        <label>Identify Status</label>
        <locationX>435</locationX>
        <locationY>52</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Status_is_Initiated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Internal_Audit_Record.Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Internal_Audit_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Initiated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_Generate_Document</targetReference>
            </connector>
            <label>If Status is Initiated</label>
        </rules>
        <rules>
            <name>If_Status_is_Generate_Document</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Internal_Audit_Record.Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Internal_Audit_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>GenerateDocument</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_UnderReview</targetReference>
            </connector>
            <label>If Status is Generate Document</label>
        </rules>
        <rules>
            <name>If_Status_is_UnderReview</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Internal_Audit_Record.Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Internal_Audit_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UnderReview</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_Reviewed_Successfully</targetReference>
            </connector>
            <label>If Status is UnderReview</label>
        </rules>
        <rules>
            <name>If_Status_is_Reviewed_Successfully</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Internal_Audit_Record.Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Internal_Audit_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reviewed Successfully</stringValue>
                </rightValue>
            </conditions>
            <label>If Status is Reviewed Successfully</label>
        </rules>
    </decisions>
    <interviewLabel>Update Internal Audit Status {!$Flow.CurrentDateTime}</interviewLabel>
