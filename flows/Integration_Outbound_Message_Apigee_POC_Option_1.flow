        <expression>&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;
&lt;InputObject&gt;
	&lt;Id&gt;{!$Record.Id}&lt;/Id&gt;
	&lt;sObject&gt;Core_Integration_Outbound_Message__c&lt;/sObject&gt;
	&lt;Core_MessageType__c&gt;{!$Record.Core_MessageType__c}&lt;/Core_MessageType__c&gt;
