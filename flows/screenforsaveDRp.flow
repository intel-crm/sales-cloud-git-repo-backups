<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>CheckApproved</name>
        <label>CheckApproved</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckDRApprove</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DRGet.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Verify_Date</targetReference>
            </connector>
            <label>CheckDRApprove</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>screenforsaveDRp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>screenforsaveDRp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>DRGet</name>
        <label>DRGet</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CheckApproved</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>DRID</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Design_Registration__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Production_End_Dt__c</queriedFields>
        <queriedFields>Core_First_Customer_Ship_Dt__c</queriedFields>
        <queriedFields>Core_Design_Registration_Status_Nm__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetDR</name>
        <label>GetDR</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DRGet</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>DRPID</elementReference>
            </value>
        </filters>
        <object>Core_Design_Registration_Product__c</object>
        <outputAssignments>
            <assignToReference>DRID</assignToReference>
            <field>Core_Design_Registration_Id__c</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>datesChange</name>
        <label>datesChange</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>DRID</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_First_Customer_Ship_Dt__c</field>
            <value>
                <elementReference>First_Customer_Ship_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Production_End_Dt__c</field>
            <value>
                <elementReference>Production_End_Date</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Design_Registration__c</object>
    </recordUpdates>
    <screens>
        <description>Verify Dates</description>
        <name>Verify_Date</name>
        <label>Verify Date</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>datesChange</targetReference>
        </connector>
        <fields>
            <name>First_Customer_Ship_Date</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>DRGet.Core_First_Customer_Ship_Dt__c</elementReference>
            </defaultValue>
            <fieldText>First Customer Ship Date</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;Cannot be in past and cannot be less that Production End Date&lt;/p&gt;</errorMessage>
                <formulaExpression>AND(
    NOT(ISBLANK({!First_Customer_Ship_Date})),
   {!First_Customer_Ship_Date}&gt;= TODAY(),
   {!First_Customer_Ship_Date} &lt; {!Production_End_Date}
)</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Production_End_Date</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>DRGet.Core_Production_End_Dt__c</elementReference>
            </defaultValue>
            <fieldText>Production End Date</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;Date Cannot be in Past, Production End Date cannot be less than First Customer Ship Date&lt;/p&gt;</errorMessage>
                <formulaExpression>AND(
    NOT(ISBLANK({!Production_End_Date})),
  {!Production_End_Date}&gt; TODAY(),
   {!First_Customer_Ship_Date} &lt; {!Production_End_Date}
)</formulaExpression>
            </validationRule>
        </fields>
        <nextOrFinishButtonLabel>Submit</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetDR</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>DRID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>DRPID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>FirstCusShipDateVar</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>ProdEndDateVar</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
