<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Update Opportunity Sales Group field on SalesGroup Change</description>
    <ends>
        <name>END_ELEMENT_2</name>
        <locationX>176</locationX>
        <locationY>431</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_3</name>
        <locationX>440</locationX>
        <locationY>539</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>Update_Sales_GroupFormula</name>
        <dataType>String</dataType>
        <expression>TEXT($Record.Core_Sales_Groups__c)</expression>
    </formulas>
    <interviewLabel>Core_Update_Sales_Group {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ACM_Core_Update_Sales_Group</label>
    <migratedFromWorkflowRuleName>Core_Update_Sales_Group</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_log_entry</name>
        <label>Create log entry</label>
        <locationX>440</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>END_ELEMENT_3</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>ACM_Core_Update_Sales_Group flow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <stringValue>ACM</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <stringValue>Update Account</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Tags__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <description>Update Opportunity Sales Group field on SalesGroup Change</description>
        <name>Field_Update</name>
        <label>Field Update</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>END_ELEMENT_2</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_log_entry</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_Opportunity_Sales_Group_Txt__c</field>
            <value>
                <elementReference>Update_Sales_GroupFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Field_Update</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>Core_Sales_Groups__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Undefined</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Sales_Groups__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Inactive account</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
