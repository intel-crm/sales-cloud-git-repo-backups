                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hold</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateVATRecord</targetReference>
            </connector>
            <label>CreateNewVATRecord</label>
