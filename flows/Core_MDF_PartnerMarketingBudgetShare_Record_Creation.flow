<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_MDF_Check_if_account_region_is_blank_or_not</name>
        <label>Check if GeoBased</label>
        <locationX>776</locationX>
        <locationY>300</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_GeoBased_Sharing_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsGeoBasedReq</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Check_for_SubGeo</targetReference>
            </connector>
            <label>If GeoBased Sharing Required</label>
        </rules>
        <rules>
            <name>If_GeoBased_Sharing_Not_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsGeoBasedReq</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_all_the_Partner_Group_Mapping_Records</targetReference>
            </connector>
            <label>If GeoBased Sharing Not Required</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_SubGeo_Check</name>
        <label>SubGeo Check</label>
        <locationX>1165</locationX>
        <locationY>310</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Fetch_all_the_PGM_Records_when_account_region_is_not_blank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_SubGeo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimActivityAllocationRecordtypeMappingRecord.Core_MDF_Region_cd__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>vRegion</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_PGMColleList</targetReference>
            </connector>
            <label>If SubGeo</label>
        </rules>
    </decisions>
    <description>This flow is used to create PartnerMarketingBudgetShare records when a PartnerMarketingBudget record is created.</description>
    <interviewLabel>PartnerMarketingBudgetShare Record Creation {!$Flow.CurrentDateTime}</interviewLabel>
