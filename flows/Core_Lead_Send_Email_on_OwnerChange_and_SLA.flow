    <description>for the following WFs --
1.Core_SAL_Email_Alert_Trigger
2.Core_Lead_Send_Email_To_Partners_On_Owner_Change</description>
    <environments>Default</environments>
    <formulas>
        <description>The formula for the WF &quot; Core_SAL_Email_Alert_Trigger &quot;</description>
        <name>F_Core_SAL_Email_Alert_Trigger</name>
        <dataType>Boolean</dataType>
        <expression>OR(AND(ISCHANGED({!$Record.Core_SendEmail__c}), {!$Record.Core_SendEmail__c} = true, {!$Record.RecordType.DeveloperName} &lt;&gt; &apos;Partner_Lead&apos;, ISPICKVAL( {!$Record.Status} , &apos;Sales Accepted Lead&apos;), ISPICKVAL( {!$Record.Core_Lead_Status__c} , &apos;Accepted&apos;), {!$Record.Core_Having_Tasks__c} = false, {!$Record.Core_Created_Post_NewLead_Process__c}=true, {!$Record.Core_SLA_Listed_User__c} = true), AND(ISCHANGED( {!$Record.Core_SendEmail4__c} ), {!$Record.Core_SendEmail4__c} = true, {!$Record.RecordType.DeveloperName} &lt;&gt; &apos;Partner_Lead&apos;, ISPICKVAL( {!$Record.Status} , &apos;Sales Accepted Lead&apos;), ISPICKVAL( {!$Record.Core_Lead_Status__c} , &apos;Accepted&apos;), {!$Record.Core_Created_Post_NewLead_Process__c}=True, {!$Record.Core_SLA_Listed_User__c} = true))</expression>
    </formulas>
    <formulas>
        <description>for the WF &quot;Core_Lead_Send_Email_To_Partners_On_Owner_Change &quot;</description>
        <name>F_Send_Email_To_Partners_On_Owner_Change</name>
        <dataType>Boolean</dataType>
        <expression>AND  (  ISCHANGED({!$Record.OwnerId}),  PRIORVALUE({!$Record.OwnerId}) = {!$Label.Core_Partner_Invalid_Queue_Id},  CONTAINS({!$Record.Owner:Group.DeveloperName}, &quot;Core_PTNR&quot;), {!$Record.RecordType.Name} = &apos;Partner Lead&apos;, ISPICKVAL({!$Record.Core_PSG_Lead__c} , &quot;PSG&quot;) )</expression>
    </formulas>
    <interviewLabel>Core_Lead_Send_Email_on_OwnerChange_ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Lead_Send_Email_on_OwnerChange_and_SLA</label>
