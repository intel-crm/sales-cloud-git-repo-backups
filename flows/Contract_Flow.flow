<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Contract_status_change_check</name>
        <label>Contract status change check</label>
        <locationX>182</locationX>
        <locationY>1007</locationY>
        <defaultConnectorLabel>FalseCondition3</defaultConnectorLabel>
        <rules>
            <name>TrueCondition3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckCondition3</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Contract_field_update</targetReference>
            </connector>
            <label>TrueCondition3</label>
        </rules>
    </decisions>
    <decisions>
        <name>Populate_Fields_from_Quote</name>
        <label>Populate Fields from Quote</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Subscription_End_date_updated_when_contract_end_date_is_changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FalseCondition1</defaultConnectorLabel>
        <rules>
            <name>TrueCondition1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckCondition1</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contract_Fields</targetReference>
            </connector>
            <label>TrueCondition1</label>
        </rules>
    </decisions>
    <decisions>
        <name>Subscription_End_date_updated_when_contract_end_date_is_changed</name>
        <label>Subscription End date updated when contract end date is changed</label>
        <locationX>182</locationX>
        <locationY>671</locationY>
        <defaultConnector>
            <targetReference>Contract_status_change_check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FalseCondition2</defaultConnectorLabel>
        <rules>
            <name>TrueCondition2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckCondition2</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Subscription_End_date_update</targetReference>
            </connector>
            <label>TrueCondition2</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CheckCondition1</name>
        <dataType>Boolean</dataType>
        <expression>OR(
	AND(
		ISNEW(),
		NOT(ISBLANK({!$Record.SBQQ__Quote__c}))
	),
	AND
	(
		NOT (ISBLANK({!$Record.SBQQ__Quote__c})),
		ISCHANGED({!$Record.SBQQ__Quote__c})		
	)
)</expression>
    </formulas>
    <formulas>
        <name>CheckCondition2</name>
        <dataType>Boolean</dataType>
        <expression>AND ( NOT(ISBLANK({!$Record.EndDate} ) ),
           ISCHANGED({!$Record.EndDate} ),
           ISPICKVAL({!$Record.Sales_Program__c} , &apos;PSG&apos;)  )</expression>
    </formulas>
    <formulas>
        <name>CheckCondition3</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
         ISPICKVAL({!$Record.Sales_Program__c}, &apos;PSG&apos;) ,
         ISCHANGED({!$Record.Status} ) ,
         {!$Record.Sales_Is_Amendment_Completed__c}
)</expression>
    </formulas>
    <interviewLabel>Contract Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Contract_field_update</name>
        <label>Contract field update</label>
        <locationX>50</locationX>
        <locationY>1127</locationY>
        <inputAssignments>
            <field>Sales_Is_Amendment_Completed__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Subscription_End_date_update</name>
        <label>Subscription End date update</label>
        <locationX>50</locationX>
        <locationY>791</locationY>
        <connector>
            <targetReference>Contract_status_change_check</targetReference>
        </connector>
        <inputAssignments>
            <field>SBQQ__SubscriptionEndDate__c</field>
            <value>
                <elementReference>$Record.EndDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.SBQQ__Subscriptions__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Contract_Fields</name>
        <label>Update Contract Fields</label>
        <locationX>50</locationX>
        <locationY>455</locationY>
        <connector>
            <targetReference>Subscription_End_date_updated_when_contract_end_date_is_changed</targetReference>
        </connector>
        <inputAssignments>
            <field>SBQQ__PreserveBundleStructureUponRenewals__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SBQQ__RenewalPricebookId__c</field>
            <value>
                <stringValue>01so0000002PRqUAAW</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sales_Account_Name_Txt__c</field>
            <value>
                <elementReference>$Record.SBQQ__Quote__r.core_cpq_cmf_pricing_parent__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sales_Direct_Pricing_Parent_Id__c</field>
            <value>
                <elementReference>$Record.SBQQ__Quote__r.core_cpq_cmf_pricing_parent_id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sales_Program__c</field>
            <value>
                <elementReference>$Record.SBQQ__Quote__r.Pricing_Quote_Program_Nm__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Populate_Fields_from_Quote</targetReference>
        </connector>
        <object>Contract</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
