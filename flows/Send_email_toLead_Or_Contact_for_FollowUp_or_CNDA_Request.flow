    <decisions>
        <name>IF_Lead_OR_Contact_is_having_values</name>
        <label>IF Lead OR Contact is having values</label>
        <locationX>457</locationX>
        <locationY>396</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Core_Inquiry_Asked_For_Contact_Follow_Up</name>
            <conditionLogic>1 AND (2 OR 3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Contact_Inquiries__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Asked for Follow-up</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested Quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact_Inquiry_Owner</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Core_Inquiry_Asked_For_Contact_Follow_Up</label>
        </rules>
        <rules>
            <name>If_Core_Inquiry_CNDA_Request_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Contact_Inquiries__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CNDA Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_Alert_for_Inquiry_Testing</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Core_Inquiry_CNDA_Request_Contact</label>
        </rules>
        <rules>
            <name>If_Core_Inquiry_Asked_For_Lead_Follow_Up</name>
            <conditionLogic>1 AND (2 OR 3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Inquiries__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Asked for Follow-up</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested Quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Inquiry_Owner</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Core_Inquiry_Asked_For_Lead_Follow_Up</label>
        </rules>
        <rules>
            <name>IfCore_Inquiry_CNDA_Request_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Inquiries__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CNDA Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Inquiry_Owner</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Core_Inquiry_CNDA_Request_Lead</label>
        </rules>
    </decisions>
    <environments>Default</environments>
