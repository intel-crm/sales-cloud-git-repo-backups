                <rightValue>
                    <stringValue>Data_Center_Co_Marketing_Fund_MDF</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_BN_Datacenter_MDF</targetReference>
            </connector>
