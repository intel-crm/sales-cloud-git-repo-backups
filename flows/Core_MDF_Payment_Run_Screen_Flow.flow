    <dynamicChoiceSets>
        <name>OOC_PaymentNatureChoiceSet</name>
        <dataType>Multipicklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Core_MDF_Payment_Nature_nm__c</picklistField>
        <picklistObject>Core_MDF_Payment_Run__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>Account15CharId</name>
        <dataType>String</dataType>
        <expression>LEFT({!Loop_Selected_Accounts.Id}, 15)</expression>
    </formulas>
    <formulas>
        <name>IsRunScheduleValid</name>
        <dataType>Boolean</dataType>
        <expression>OR(AND({!varOOCPaymentRun.Core_MDF_Run_Now_Ind__c}, ISBLANK({!varOOCPaymentRun.Core_MDF_ScheduleRun_Dtm__c})), AND(NOT({!varOOCPaymentRun.Core_MDF_Run_Now_Ind__c}), NOT(ISBLANK({!varOOCPaymentRun.Core_MDF_ScheduleRun_Dtm__c}))))</expression>
    </formulas>
    <formulas>
        <name>OOC_ErrorMessage</name>
        <dataType>String</dataType>
        <expression>IF(
CONTAINS({!$Flow.FaultMessage}, &quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;),
MID(
  {!$Flow.FaultMessage},
  FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, {!$Flow.FaultMessage}) + LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;),
  FIND(&quot;. You can look up&quot;, {!$Flow.FaultMessage}) - (FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, {!$Flow.FaultMessage}) + LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;))
),
{!$Flow.FaultMessage}
)</expression>
    </formulas>
    <formulas>
        <name>OOC_PaymentNature</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!OOC_Payment_Nature_IPA}, {!OOC_Payment_Nature_CoEng})</expression>
    </formulas>
    <formulas>
        <name>OOC_RunNowCheckbox</name>
        <dataType>String</dataType>
        <expression>IF({!varOOCPaymentRun.Core_MDF_Run_Now_Ind__c}, &quot;☑&quot;, &quot;☐&quot;)</expression>
    </formulas>
    <formulas>
        <name>OOC_SuccessMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Out of Cycle Payment Run created successfully. &quot; &amp;
&quot;&lt;a href=&apos;/lightning/r/Core_MDF_Payment_Run__c/&quot; &amp; {!varOOCPaymentRun.Id} &amp;
&quot;/view&apos; target=&apos;_top&apos;&gt;Click here to view the Payment Run.&lt;/a&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>OOC_TechnicalProgramName</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Record_Type.DeveloperName},
&quot;Client_Co_Marketing_Fund_CMP&quot;, &quot;Client CoMarketing Fund&quot;,
&quot;Client_Co_Marketing_Fund_MDF&quot;, &quot;Client CoMarketing Fund&quot;,
&quot;Data_Center_Co_Marketing_Fund_CMP&quot;, &quot;Data Center CoMarketing Fund&quot;,
&quot;Data_Center_Co_Marketing_Fund_MDF&quot;, &quot;Data Center CoMarketing Fund&quot;,
&quot;Core_MDF_Retail_Marketing_Funds&quot;, &quot;Retail Marketing Funds&quot;,
&quot;Core_MDF_Intel_Partner_Alliance_MDF&quot;, &quot;Intel Partner Alliance&quot;,
&quot;Co_Engineering&quot;, &quot;CoGTM&quot;,
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>SelectedBudgetTypes</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!OOC_Budget_Type_Client_CMP}, BLANKVALUE({!OOC_Budget_Type_Client_MDF}, BLANKVALUE({!OOC_Budget_Type_Datacenter_CMP}, BLANKVALUE({!OOC_Budget_Type_Datacenter_MDF}, {!OOC_Budget_Type_Retail_Marketing_Funds}))))</expression>
    </formulas>
