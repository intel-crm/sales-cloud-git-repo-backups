            <field>Core_MDF_Technical_Program_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>OOC_TechnicalProgramName</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
