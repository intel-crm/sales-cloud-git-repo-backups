    <collectionProcessors>
        <name>Sort_Program_Accounts</name>
        <elementSubtype>SortCollectionProcessor</elementSubtype>
        <label>Sort Program Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>colProgramAccounts</collectionReference>
        <connector>
            <targetReference>OOC_Account_Select</targetReference>
        </connector>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>Name</sortField>
            <sortOrder>Asc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <decisions>
        <name>Check_Account_Selection</name>
        <label>Check Account Selection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Clear_Account_Ids_NoSelection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Accounts Selected</defaultConnectorLabel>
        <rules>
            <name>Accounts_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>strAccountIds</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_OOC_Claims</targetReference>
            </connector>
            <label>Accounts Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Payment_Admin_Permission</name>
        <label>Check Payment Admin Permission</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>New_Normal_Payment_Run_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Permission</defaultConnectorLabel>
        <rules>
            <name>Has_Payment_Admin_Permission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Core_MDF_CCP_Internal_Payment_Admin_Manager</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Select_Payment_Run_Type</targetReference>
            </connector>
            <label>Has Permission</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Payment_Run_Type</name>
        <label>Check Payment Run Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>New_Normal_Payment_Run_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Normal Payment Run Option</defaultConnectorLabel>
        <rules>
            <name>OOC_Payment_Run_Option</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Payment_Run_Types</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>OOC_Payment_Run</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_OOC_Payment_Run_Screen</targetReference>
            </connector>
            <label>OOC Payment Run Option</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Run_Now_Or_Schedule</name>
        <label>Check Run Now Or Schedule</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_RunSchedule_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid</defaultConnectorLabel>
        <rules>
            <name>Valid_Run_Schedule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsRunScheduleValid</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_RunSchedule_Error</targetReference>
            </connector>
            <label>Valid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_SetRunForAllAccounts</name>
        <label>Check Set Run For All Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_OOC_Claims</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Programs</defaultConnectorLabel>
        <rules>
            <name>Set_Flag_For_Eligible_Programs</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>OOC_Program</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Client_Co_Marketing_Fund_MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OOC_Program</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Data_Center_Co_Marketing_Fund_MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OOC_Program</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Co_Engineering</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_RunForAll_Accounts</targetReference>
            </connector>
            <label>Eligible Programs</label>
        </rules>
    </decisions>
