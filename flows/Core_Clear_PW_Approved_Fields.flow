<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Core_ClearPWApprovedFields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Clear_PW_Approved_Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Clear_PW_section</name>
        <label>Clear PW section</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Production Win Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Production Lost</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Production Cancelled</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>CRM_PW_App_UCD_Customer_Name__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_BU_Product_Segment__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_BU_Short_Name__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_By__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Commissionable__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_KPI_Product_Group__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Quantity__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Sales_Group__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Sales_Price__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Total_Price__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Manager_Approved_Date__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Production_Claim_Date__c</field>
        </inputAssignments>
        <inputReference>$Record.OpportunityLineItems</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Clear_PW_section</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Design Win</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_PW_Approval_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Recalled</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
