                <stringValue>AND(
NOT(ISNEW()),
[Core_MDF_Payment__c].Core_MDF_Program_Txt__c = $Label.Core_MDF_Retail_Program_Name,
TEXT([Core_MDF_Payment__c].Core_MDF_Payment_Run_Id__c.Core_MDF_Budget_Type_txt__c) = $Label.Core_MDF_Retail_RSA_MD_Budget_Type ,
TEXT([Core_MDF_Payment__c].Core_MDF_Payment_Status_Txt__c) = $Label.Core_MDF_Claim_Status_Paid,
ISCHANGED([Core_MDF_Payment__c].Core_MDF_Payment_Status_Txt__c ) 
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISNEW()),
{!myVariable_current.Core_MDF_Program_Txt__c} = {!$Label.Core_MDF_Retail_Program_Name},
TEXT({!myVariable_current.Core_MDF_Payment_Run_Id__r.Core_MDF_Budget_Type_Txt__c}) = {!$Label.Core_MDF_Retail_RSA_MD_Budget_Type} ,
TEXT({!myVariable_current.Core_MDF_Payment_Status_Txt__c}) = {!$Label.Core_MDF_Claim_Status_Paid},
ISCHANGED({!myVariable_current.Core_MDF_Payment_Status_Txt__c} ) 
)</expression>
    </formulas>
