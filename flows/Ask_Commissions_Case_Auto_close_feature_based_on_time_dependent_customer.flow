<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Ask Commissions - Case Auto close feature based on time dependent customer  workflow rule
Workflow rule description: Ask Commissions - Case Auto close based on Time frame allotted to reply, before system automatically closes open case&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>UpdateCaseAutoCloseDateFormula</name>
        <dataType>DateTime</dataType>
        <expression>CASE( 
MOD( datevalue( $Record.LastModifiedDate ) - DATE( 1900, 1, 7 ), 7 ), 
0, $Record.LastModifiedDate + 5, 
1, $Record.LastModifiedDate + 5 + 2 , 
2, $Record.LastModifiedDate + 5 + 2, 
3, $Record.LastModifiedDate + 5 + 2, 
4, $Record.LastModifiedDate + 5 + 2, 
5, $Record.LastModifiedDate + 5 + 2, 
6, $Record.LastModifiedDate + 5 + 1, 
null 
)</expression>
    </formulas>
    <label>Ask Commissions - Case Auto close feature based on time dependent customer</label>
    <migratedFromWorkflowRuleName>Ask Commissions - Case Auto close feature based on time dependent customer replies</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>Core_AAQC_Case_Auto_Close__c</field>
            <value>
                <elementReference>UpdateCaseAutoCloseDateFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND({!$Record.RecordType.DeveloperName} ==&apos;Core_AAQC_Case_recordType&apos;, ISPICKVAL({!$Record.Status} ,&apos;Awaiting Resolution Confirmation&apos;))</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
