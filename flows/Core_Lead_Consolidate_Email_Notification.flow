    <description>Consolidate Email Notification for Lead as part of Org Health Cleanup</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR( AND( ISNEW(), [Lead].RecordType.Name = &quot;Lead&quot;, ISPICKVAL([Lead].Status, &quot;Marketing Qualified Lead&quot;), [Lead].Core_Covered_account_owner__c=[Lead].Core_Lead_Owner_Name__c, [Lead].Core_Is_Covered_Account__c=true ), AND( OR(ISCHANGED([Lead].Core_Existing_Covered_Account__c), ISCHANGED([Lead].OwnerId)), [Lead].Core_Flag_on_Queue_or_User__c =&quot;User&quot;, [Lead].RecordType.Name = &quot;Lead&quot;, ISPICKVAL([Lead].Status, &quot;Marketing Qualified Lead&quot;), [Lead].Core_Covered_account_owner__c=[Lead].Core_Lead_Owner_Name__c, [Lead].Core_Is_Covered_Account__c=true ), AND( ISNEW(), [Lead].RecordType.Name = &quot;Sales Lead&quot;, ISPICKVAL([Lead].Status, &quot;Tele Accepted Lead&quot;), [Lead].Core_Covered_account_owner__c=[Lead].Core_Lead_Owner_Name__c, [Lead].Core_Is_Covered_Account__c=true ), AND( OR(ISCHANGED([Lead].Core_Existing_Covered_Account__c), ISCHANGED([Lead].OwnerId)), [Lead].Core_Flag_on_Queue_or_User__c =&quot;User&quot;, [Lead].RecordType.Name = &quot;Sales Lead&quot;, ISPICKVAL([Lead].Status, &quot;Tele Accepted Lead&quot;), [Lead].Core_Covered_account_owner__c=[Lead].Core_Lead_Owner_Name__c, [Lead].Core_Is_Covered_Account__c=true ) )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>OR( AND( ISNEW(), {!myVariable_current.RecordType.Name} = &quot;Lead&quot;, ISPICKVAL({!myVariable_current.Status}, &quot;Marketing Qualified Lead&quot;), {!myVariable_current.Core_Covered_account_owner__c}={!myVariable_current.Core_Lead_Owner_Name__c}, {!myVariable_current.Core_Is_Covered_Account__c}=true ), AND( OR(ISCHANGED({!myVariable_current.Core_Existing_Covered_Account__c}), ISCHANGED({!myVariable_current.OwnerId})), {!myVariable_current.Core_Flag_on_Queue_or_User__c} =&quot;User&quot;, {!myVariable_current.RecordType.Name} = &quot;Lead&quot;, ISPICKVAL({!myVariable_current.Status}, &quot;Marketing Qualified Lead&quot;), {!myVariable_current.Core_Covered_account_owner__c}={!myVariable_current.Core_Lead_Owner_Name__c}, {!myVariable_current.Core_Is_Covered_Account__c}=true ), AND( ISNEW(), {!myVariable_current.RecordType.Name} = &quot;Sales Lead&quot;, ISPICKVAL({!myVariable_current.Status}, &quot;Tele Accepted Lead&quot;), {!myVariable_current.Core_Covered_account_owner__c}={!myVariable_current.Core_Lead_Owner_Name__c}, {!myVariable_current.Core_Is_Covered_Account__c}=true ), AND( OR(ISCHANGED({!myVariable_current.Core_Existing_Covered_Account__c}), ISCHANGED({!myVariable_current.OwnerId})), {!myVariable_current.Core_Flag_on_Queue_or_User__c} =&quot;User&quot;, {!myVariable_current.RecordType.Name} = &quot;Sales Lead&quot;, ISPICKVAL({!myVariable_current.Status}, &quot;Tele Accepted Lead&quot;), {!myVariable_current.Core_Covered_account_owner__c}={!myVariable_current.Core_Lead_Owner_Name__c}, {!myVariable_current.Core_Is_Covered_Account__c}=true ) )</expression>
    </formulas>
