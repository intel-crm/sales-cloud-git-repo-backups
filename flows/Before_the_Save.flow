<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Duplicate_ABP</name>
        <label>Check Duplicate ABP</label>
        <locationX>456</locationX>
        <locationY>479</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_ABP</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Duplicate Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Before the Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Before the Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Existing_ABP</name>
        <label>Get Existing ABP</label>
        <locationX>456</locationX>
        <locationY>371</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Duplicate_ABP</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ER_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ER_Account__r.RecordType.DeveloperName</elementReference>
            </value>
        </filters>
        <filters>
            <field>ER_Customer_Master_File_Grouping__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ER_Customer_Master_File_Grouping__r.ER_Count_of_Customer_Master_Files__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ER_Account_Business_Partner__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>330</locationX>
        <locationY>48</locationY>
        <connector>
