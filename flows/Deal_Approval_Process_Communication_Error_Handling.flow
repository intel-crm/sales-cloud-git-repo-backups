&lt;td class=&quot;auto-style1&quot; valign=&quot;top&quot; style=&quot;font-size: 10px; border: #d3d3d3; color: #ffffff; font-family: Arial, Helvetica, sans-serif; line-height: 14px; padding-bottom: 10px; text-align: center;&quot;&gt;Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054 USA.&lt;span class=&quot;Apple-converted-space&quot;&gt; &lt;/span&gt;&lt;a style=&quot;color: #ffffff; text-decoration: none;&quot; href=https://www.intel.com/content/www/us/en/homepage.html target=&quot;_blank&quot; _rte_href=https://www.intel.com/content/www/us/en/homepage.html&gt;www.Intel.com&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
