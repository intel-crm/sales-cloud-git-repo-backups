    <decisions>
        <name>Deal_Resubmission_Email</name>
        <label>Deal Resubmission Email</label>
        <locationX>1227</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Error</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Failure</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Error_Message__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Row_lock_issue</targetReference>
            </connector>
            <label>Error</label>
        </rules>
        <rules>
            <name>Quote_Created_Success</name>
            <conditionLogic>(1 AND 2 AND 3) OR 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Success</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Object__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Record_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resubmission Email</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetDealRegProductRecords</targetReference>
            </connector>
            <label>Quote Created Success</label>
        </rules>
        <rules>
            <name>Opportunity_Created_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Success</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Object__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Record_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_deal_process_message_with_success_Opportunity</targetReference>
            </connector>
            <label>Opportunity Created Success</label>
        </rules>
        <rules>
            <name>Create_Design_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Object__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Process_design_reg_opportunity</targetReference>
            </connector>
            <label>Create Design Opportunity</label>
        </rules>
        <rules>
            <name>Create_Design_OLI</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Object__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OLI</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Process_design_reg_OLI</targetReference>
            </connector>
            <label>Create Design OLI</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Resubmission_Flow</name>
        <label>Is Resubmission Flow?</label>
        <locationX>886</locationX>
        <locationY>1334</locationY>
        <defaultConnector>
            <targetReference>Assign_deal_process_message_with_success</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Resubmission_Email1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resubmission Email</stringValue>
                </rightValue>
            </conditions>
            <label>Resubmission Email?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Retry_count_is_under_3</name>
        <label>Retry count is under 3</label>
        <locationX>182</locationX>
        <locationY>494</locationY>
        <defaultConnector>
            <targetReference>Get_Deal_Registration_Partner_record_type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>retryCount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Publish_event_for_re_try</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Row_lock_issue</name>
        <label>Row lock issue?</label>
        <locationX>380</locationX>
        <locationY>386</locationY>
        <defaultConnector>
            <targetReference>Assign_deal_process_message_with_error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>rowLockFailure</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Design__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Retry_count_is_under_3</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>currentyear</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(TODAY()))</expression>
    </formulas>
    <formulas>
        <name>EmailTableRowForApproval</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;tr&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!IterateOverDealDRP.Name}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!IterateOverDealDRP.Core_Product_Id__r.Name}+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + TEXT({!IterateOverDealDRP.Core_Design_Product_Status_Nm__c})+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!IterateOverDealDRP.Core_Comment_Txt__c}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px ; width:150px;&quot;&gt;&apos; + TEXT({!IterateOverDealDRP.CreatedDate})+ 
&apos;&lt;/td&gt;&lt;/tr&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>errorMsg</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;b&gt;Please raise an IT support ticket&lt;/b&gt; &lt;br/&gt;&lt;br/&gt; Error while creating &apos;&amp;{!$Record.PCC_Object__c}&amp;&apos;-&apos;&amp;{!$Record.PCC_Error_Message__c}</expression>
    </formulas>
    <formulas>
        <name>retryCount</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Get_deal_record.PCC_Deal_re_try_count__c}) ,
1,
{!Get_deal_record.PCC_Deal_re_try_count__c} + 1
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>rowLockFailure</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!$Record.PCC_Error_Message__c}, &apos;unable to obtain exclusive access to this record&apos;)</expression>
    </formulas>
    <interviewLabel>Deal Approval Process Communication Error Handling {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Deal Approval Process Communication Error Handling</label>
    <loops>
        <name>IterateOverDealDRP</name>
        <label>IterateOverDealDRP</label>
        <locationX>886</locationX>
