<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>PFR_records_updated_to_Revision_required</name>
        <label>PFR records updated to Revision required</label>
        <locationX>242</locationX>
        <locationY>408</locationY>
        <actionName>Core_MDF_UpdateActivityFields</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>memberId</name>
            <value>
                <elementReference>$Record.Core_MDF_Member_Activity_Owner_Id__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>pfrId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_UpdateActivityFields</nameSegment>
    </actionCalls>
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>To check if the budgets of activities match the conditions</description>
        <name>Check_Budget_Types</name>
        <label>Check Budget Types</label>
        <locationX>374</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_budget</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>MDF+</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>OEM CMP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Service Provider CMP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PFR_records_updated_to_Revision_required</targetReference>
            </connector>
            <label>Check budget</label>
        </rules>
    </decisions>
    <interviewLabel>Get {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get PFR records updated to RR - Deactivated(Not in use)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Core_MDF_Fund_Request_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Revision Required</stringValue>
            </value>
        </filters>
        <object>PartnerFundRequest</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Run_after_5_min</name>
            <connector>
                <targetReference>Check_Budget_Types</targetReference>
            </connector>
            <label>Run after 5 min</label>
            <offsetNumber>5</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
