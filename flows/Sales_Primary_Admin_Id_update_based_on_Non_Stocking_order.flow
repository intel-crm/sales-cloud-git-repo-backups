            <label>If the order reason is non-stocking</label>
        </rules>
    </decisions>
    <description>For Non Stocking Order, automatically populate the &quot;Primary Admin Id &quot; attribute License object record with the &quot;Contact&quot; selected on the Order Product record</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
NOT(ISBlank([Sales_License__c].Sales_License_Order_Product__c)) ,
OR(
ISPICKVAL([Sales_License__c].Sales_License_Order__r.Sales_Order_Reason__c, &apos;Non Stocking Order&apos;),
NOT(ISPICKVAL([Sales_License__c].Sales_License_Order__r.Sales_Order_Reason__c, &apos;Stocking Order&apos;))
)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISBlank({!myVariable_current.Sales_License_Order_Product__c})) ,
OR(
ISPICKVAL({!myVariable_current.Sales_License_Order__r.Sales_Order_Reason__c}, &apos;Non Stocking Order&apos;),
NOT(ISPICKVAL({!myVariable_current.Sales_License_Order__r.Sales_Order_Reason__c}, &apos;Stocking Order&apos;))
)
)</expression>
    </formulas>
    <interviewLabel>Sales_Primary_Admin_Id_update_based_on_Non_Stocking_order-5_InterviewLabel</interviewLabel>
    <label>Primary Admin Id update based on Non-Stocking order</label>
