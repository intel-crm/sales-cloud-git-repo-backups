    <decisions>
        <description>To Check if User needs to upload Files/Attachment</description>
        <name>Attachment_Requested</name>
        <label>Attachment Requested</label>
        <locationX>1295</locationX>
        <locationY>127</locationY>
        <defaultConnector>
            <targetReference>GetRequestRecord</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Attachment_Needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Has_Attachments</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Upload_Attachment_0</targetReference>
            </connector>
            <label>Attachment Needed</label>
        </rules>
    </decisions>
