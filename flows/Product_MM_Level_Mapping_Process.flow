    <assignments>
        <name>Level_5_Assignment</name>
        <label>Level 5 Assignment</label>
        <locationX>691</locationX>
        <locationY>250</locationY>
        <assignmentItems>
            <assignToReference>Get_L5_Product_Id.Core_Product_Name_EPM_ID__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Level_5_EPM_ID__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Get_Product_Types</name>
        <label>Get Product Types</label>
        <locationX>301</locationX>
        <locationY>304</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Level_5</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Level_1_EPM_ID__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>98836</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Level_1_EPM_ID__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>35125</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Level_1_EPM_ID__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>36773</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_L5_Product_Id</targetReference>
            </connector>
            <label>Level 5</label>
        </rules>
        <rules>
            <name>Level_4</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Level_1_EPM_ID__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>98836</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Level_1_EPM_ID__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>35125</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Level_1_EPM_ID__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>36773</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_L4_Product_Id</targetReference>
            </connector>
            <label>Level 4</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Product MM Level Mapping - Process {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Product MM Level Mapping - Process</label>
    <loops>
