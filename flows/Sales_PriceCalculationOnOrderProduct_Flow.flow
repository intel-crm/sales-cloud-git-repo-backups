    <decisions>
        <name>Update_unit_Price_as_0_for_non_commercial_order</name>
        <label>Update unit Price as 0 for non-commercial order</label>
        <locationX>248</locationX>
        <locationY>923</locationY>
        <defaultConnector>
            <targetReference>Order_without_Quote_associated_with_Disti_Account_having_Disti_cost_null</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FalseCondition3</defaultConnectorLabel>
        <rules>
            <name>TrueCondition3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Order.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non Commercial Order</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Order.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Order.SBQQ__Quote__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_unit_price_as_0</targetReference>
            </connector>
            <label>TrueCondition3</label>
        </rules>
    </decisions>
    <description>UnitPrice fix V2</description>
    <environments>Default</environments>
    <formulas>
        <name>OrderProductPricings</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISPICKVAL({!$Record.Order.Status}, &apos;Draft&apos; ),
NOT(ISBLANK({!$Record.Order.SBQQ__Quote__c} ) ), 			
OR(
({!$Record.Sales_Broken_Price_Amt__c}&lt;&gt; {!$Record.SBQQ__QuoteLine__r.price_brokencost_amt__c}  )		
,
OR(
AND(
ISBLANK({!$Record.SBQQ__QuoteLine__r.price_suggested_resale_amt__c}),
({!$Record.Sales_Suggested_Resale_Price__c} &lt;&gt; 0)
),
({!$Record.Sales_Suggested_Resale_Price__c}&lt;&gt; {!$Record.SBQQ__QuoteLine__r.price_suggested_resale_amt__c} )		
)
)
)</expression>
    </formulas>
    <formulas>
        <name>PopulatecontactonlicenseFormula</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISPICKVAL({!$Record.Order.Sales_Order_Reason__c}, &apos;Non Stocking Order&apos; ),
OR(AND(ISBLANK(PRIORVALUE({!$Record.Sales_Contact__c})),NOT(ISBLANK({!$Record.Sales_Contact__c}))),
AND(ISNEW(),NOT(ISBLANK({!$Record.Sales_Contact__c}))),ISCHANGED({!$Record.Sales_Contact__c}), ISCHANGED({!$Record.Order.Sales_Order_Reason__c}),
ISCHANGED({!$Record.Quantity})))</expression>
    </formulas>
