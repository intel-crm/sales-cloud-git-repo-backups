        <rules>
            <name>TrueCondition7</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PopulatecontactonlicenseFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_contact</targetReference>
