            </conditions>
            <conditions>
                <leftValueReference>$Record.Order.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Non Commercial Order</stringValue>
                </rightValue>
            </conditions>
            <conditions>
