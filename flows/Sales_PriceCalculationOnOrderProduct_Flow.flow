    <decisions>
        <name>Check_contact_is_associated_to_OOTB_Account_on_Order</name>
        <label>Check contact is associated to OOTB Account on Order</label>
        <locationX>248</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Order_without_Quote_associated_with_Disti_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FalseCondition1</defaultConnectorLabel>
        <rules>
            <name>TrueCondition1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Sales_Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sales_Contact__r.AccountId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Order.AccountId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Order.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Soft_Warning_Message</targetReference>
            </connector>
            <label>TrueCondition1</label>
        </rules>
    </decisions>
