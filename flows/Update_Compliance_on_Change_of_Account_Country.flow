<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>myRule_1</name>
        <label>Update_Opp_Compliance</label>
        <locationX>578</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>FALSE_Update_Opp_Compliance</defaultConnectorLabel>
        <rules>
            <name>Update_Opp_Compliance_For_Us</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>USA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>myRule_1_A1</targetReference>
            </connector>
            <label>Update Opp Compliance For Us</label>
        </rules>
        <rules>
            <name>Update_Compliance_for_Not_US</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.BillingCountryCode</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>USA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>myRule_4_A1</targetReference>
            </connector>
            <label>Update Compliance for Not US</label>
        </rules>
    </decisions>
    <description>This is used to Update the Compliance Status and Compliance SubStatus  based on MINDS</description>
    <environments>Default</environments>
    <interviewLabel>Update Compliance on Change of Account Country {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ACM Update Compliance on Change of Account Country</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
