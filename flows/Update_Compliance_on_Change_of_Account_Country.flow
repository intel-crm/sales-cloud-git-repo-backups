    <recordUpdates>
        <name>myRule_1_A1</name>
        <label>Core_Opp_MINDS</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <faultConnector>
            <targetReference>Create_Log_Entry_For_Core_Opp_MINDS</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Compliance_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Compliance_Sub_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Military_Aerospace_Govmt_End_Use__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Compliance_Status__c</field>
            <value>
                <stringValue>Approved with Guardrails</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Compliance_Sub_Status__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Opportunities</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>myRule_4_A1</name>
        <label>Update_Opp_NotUS</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <faultConnector>
            <targetReference>Create_Log_Entry_For_Update_Opp_NotUs</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Compliance_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Military_Aerospace_Govmt_End_Use__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Compliance_Status__c</field>
            <value>
                <stringValue>On Hold – Review in Progress</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Compliance_Sub_Status__c</field>
