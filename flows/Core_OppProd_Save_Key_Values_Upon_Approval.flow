<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Opps_Product</name>
        <label>Check Opps Product</label>
        <locationX>776</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_status_Win_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Win Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateApprovalDetails</targetReference>
            </connector>
            <label>if status Win Approved</label>
        </rules>
        <rules>
            <name>if_Sales_Quantity_Changed</name>
            <conditionLogic>(((1 OR 2 ) AND 3 AND 6 ) OR ( 4 AND 5 AND 3 AND 6))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.UnitPrice</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_Approval_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_Design_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateQuantityAndSalesPrice</targetReference>
            </connector>
            <label>if Sales_Quantity_Changed</label>
        </rules>
        <rules>
            <name>New_but_not_pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Post-Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Product_status_to_Pending</targetReference>
            </connector>
            <label>New but not pending</label>
        </rules>
        <rules>
            <name>if_status_Production_Win_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_Approved_User_Id_field</targetReference>
            </connector>
            <label>if status Production Win Approved</label>
        </rules>
    </decisions>
    <decisions>
        <name>Record_Type_Check</name>
        <label>Record Type Check</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RecordType_Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_Design_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PW_Quantity_sales_price</targetReference>
            </connector>
            <label>RecordType Check</label>
        </rules>
    </decisions>
    <description>for the WF &quot; Core_OppProd_Save_Key_Values_Upon_Approval &quot; and Sync PW Quantity and sales price with DW.</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Approved_Date</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.Opportunity.Core_Approved_Date__c}</expression>
    </formulas>
    <formulas>
        <name>Core_Commissionable</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Opportunity.Core_Commissionable__c})</expression>
    </formulas>
    <formulas>
        <name>F_TechicalApprovedOwner</name>
        <dataType>String</dataType>
        <expression>IF ( {!$Record.Opportunity.Core_Technical_Owner__c} != NULL, TRIM( {!$Record.Opportunity.Core_Technical_Owner__r.FirstName} + &quot; &quot; + {!$Record.Opportunity.Core_Technical_Owner__r.LastName}),&apos; &apos;)</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>OpportunityOwnerName</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.Opportunity.Owner.FirstName}+&quot;&quot;+{!$Record.Opportunity.Owner.LastName})</expression>
    </formulas>
    <formulas>
        <name>TechnicalOwnerName</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.Opportunity.Core_Technical_Owner__r.FirstName}+&quot;&quot;+{!$Record.Opportunity.Core_Technical_Owner__r.LastName})</expression>
    </formulas>
    <formulas>
        <name>TotalPrice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.UnitPrice}*{!$Record.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core_OppProd_Save_Key_Values_Upon_Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_OppProd_Save_Key_Values_Upon_Approval and sync PW Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Sets the Opportunity Product status to Pending</description>
        <name>Opportunity_Product_status_to_Pending</name>
        <label>Opportunity Product status to Pending</label>
        <locationX>842</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>update_Approved_User_Id_field</name>
        <label>update Approved User Id field</label>
        <locationX>1106</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Core_Approved_User_Id__c</field>
            <value>
                <elementReference>$Record.LastModifiedBy.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_PW_Quantity_sales_price</name>
        <label>Update PW Quantity &amp; sales price</label>
        <locationX>50</locationX>
        <locationY>611</locationY>
        <inputAssignments>
            <field>Core_PW_Quantity__c</field>
            <value>
                <elementReference>$Record.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Sales_Price__c</field>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateApprovalDetails</name>
        <label>UpdateApprovalDetails</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <connector>
            <targetReference>Record_Type_Check</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Approved_By__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Approved_By__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Commissionable__c</field>
            <value>
                <elementReference>Core_Commissionable</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Date__c</field>
            <value>
                <elementReference>Core_Approved_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Decision_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.CloseDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_List_Price__c</field>
            <value>
                <elementReference>$Record.ListPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Opportunity_Owner__c</field>
            <value>
                <elementReference>OpportunityOwnerName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Quantity__c</field>
            <value>
                <elementReference>$Record.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Sales_Price__c</field>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Technical_Owner__c</field>
            <value>
                <elementReference>F_TechicalApprovedOwner</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Total_Price__c</field>
            <value>
                <elementReference>TotalPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_User_Id__c</field>
            <value>
                <elementReference>$Record.LastModifiedBy.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>To update the PW quantity and sales price.</description>
        <name>UpdateQuantityAndSalesPrice</name>
        <label>UpdateQuantityAndSalesPrice</label>
        <locationX>578</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Core_PW_Quantity__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Sales_Price__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>650</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Opps_Product</targetReference>
        </connector>
        <filterFormula>OR( AND(ISCHANGED({!$Record.Core_Status__c}), ISPICKVAL({!$Record.Core_Status__c},&apos;Win Approved&apos;), ISPICKVAL({!$Record__Prior.Core_Status__c},&apos;Win Submitted&apos;)),
AND(!ISPICKVAL({!$Record.Opportunity.Core_Approval_Status__c},&apos;Approved&apos;), OR(ISCHANGED({!$Record.Quantity}),ISCHANGED({!$Record.UnitPrice}))),
ISNEW(),
AND(ISCHANGED({!$Record.Core_Status__c}),ISPICKVAL({!$Record.Core_Status__c}, &apos;Production Win Approved&apos;))
)</filterFormula>
        <object>OpportunityLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
