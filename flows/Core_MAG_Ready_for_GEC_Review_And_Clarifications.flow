    <environments>Default</environments>
    <formulas>
        <description>Checks if all the questions are answered</description>
        <name>IsCompleted</name>
        <dataType>Boolean</dataType>
        <expression>NOT( ISPICKVAL({!$Record.Core_Opportunity__r.Core_Compliance_Sub_Status__c}, &apos;ITAR Form Received (GEC to review ITAR Form)&apos;) || ISPICKVAL({!$Record.Core_Opportunity__r.Core_Compliance_Sub_Status__c}, &apos;ITAR Form Sent (ITAR Form should be filled out)&apos;)) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 1, {!$Record.Core_A1__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 2, {!$Record.Core_A2__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 3, {!$Record.Core_A3__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 4, {!$Record.Core_A4__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 5, {!$Record.Core_A5__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 6, {!$Record.Core_A6__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 7, {!$Record.Core_A7__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 8, {!$Record.Core_A8__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 9, {!$Record.Core_A9__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 10, {!$Record.Core_A10__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 11, {!$Record.Core_A11__c} != &apos;&apos;, true) &amp;&amp; IF({!$Record.Core_Number_of_Questions__c} &gt;= 12, {!$Record.Core_A12__c} != &apos;&apos;, true)</expression>
    </formulas>
