<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Core_MDF_Update_the_Status_to_Active_on_Effective_Date workflow rule
This will call the Time based action to make the Bank as Active on the Effective Date.</description>
    <environments>Default</environments>
    <interviewLabel>Core_MDF_Update_the_Status_to_Active_on_Effective_Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Update_the_Status_to_Active_on_Effective_Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_MDF_Update_Bank_Status</name>
        <label>Update Bank Status</label>
        <locationX>675</locationX>
        <locationY>414</locationY>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Core_MDF_ESD_Hold_Indicator__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Hold_Payments_from_AP_file_ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>No</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Hold_Payments_from_AP_file_ind__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Bank_Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Bank_Status</name>
        <label>Update Bank Status</label>
        <locationX>901</locationX>
        <locationY>271</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Core_MDF_ESD_Hold_Indicator__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Hold_Payments_from_AP_file_ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Bank_Status__c</field>
            <value>
                <stringValue>Hold</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>330</locationX>
        <locationY>48</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND({!$Record.Core_MDF_ESD_Update__c} == true,{!$Record.Core_MDF_Effective_Date__c} &gt;TODAY(),{!$Record.Core_MDF_Ineffective_Selection_ind__c} == false)</filterFormula>
        <object>Core_MDF_Bank__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>ScheduledPath1</name>
            <connector>
                <targetReference>Core_MDF_Update_Bank_Status</targetReference>
            </connector>
            <label>ScheduledPath1</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Core_MDF_Effective_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>ScheduledPath_2</name>
            <connector>
                <targetReference>Update_Bank_Status</targetReference>
            </connector>
            <label>ScheduledPath 2</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Core_MDF_Effective_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
