    <assignments>
        <name>All_Records</name>
        <label>All Records</label>
        <locationX>507</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>AllRecords</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Related_Records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Related_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Aamount</name>
        <label>Assign Aamount</label>
        <locationX>273</locationX>
        <locationY>743</locationY>
        <assignmentItems>
            <assignToReference>Related_Records.Core_Forecast_Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Amount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>All_Records</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Records_not_null</name>
        <label>Records not null</label>
        <locationX>669</locationX>
        <locationY>479</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Forecast_Not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Forecast</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Related_Records</targetReference>
            </connector>
            <label>Forecast Not null</label>
        </rules>
    </decisions>
    <description>Changes made to not update Cancelled forecasts</description>
    <environments>Default</environments>
    <interviewLabel>Update Amount on Forecast {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Amount on Forecast</label>
    <loops>
        <name>Related_Records</name>
        <label>Related Records</label>
        <locationX>396</locationX>
        <locationY>482</locationY>
        <collectionReference>Get_Opportunity_Forecast</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Aamount</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Opportunity_Forecast</name>
        <label>Get Opportunity Forecast</label>
        <locationX>669</locationX>
        <locationY>359</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Records_not_null</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Read_Only__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Forecast__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancel</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Opportunity_Forecast__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Forecast_Amount__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Records</name>
        <label>Update Records</label>
        <locationX>728</locationX>
        <locationY>628</locationY>
        <inputReference>AllRecords</inputReference>
    </recordUpdates>
    <start>
        <locationX>543</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Get_Opportunity_Forecast</targetReference>
        </connector>
        <filterFormula>AND(AND(NOT(ISNULL({!$Record.RecordTypeId})),CONTAINS({!$Label.Core_Sales_CRM_Record_Types},{!$Record.RecordType.DeveloperName})),ISCHANGED({!$Record.Amount}))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>AllRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_Opportunity_Forecast__c</objectType>
    </variables>
</Flow>
