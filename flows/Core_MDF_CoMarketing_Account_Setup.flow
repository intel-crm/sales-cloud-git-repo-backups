    </actionCalls>
    <actionCalls>
        <name>Reshare_account_with_its_group_when_account_s_owner_is_changed</name>
        <label>Reshare account with its group when account&apos;s owner is changed</label>
        <locationX>749</locationX>
        <locationY>661</locationY>
        <actionName>Core_MDF_Account_Utility</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Share_Record_to_geo_group_on_owner_change</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>accountToBeResharedList</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Account_Utility</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Share_Record_to_geo_group_on_owner_change</name>
        <label>Share Record to geo group on owner change</label>
        <locationX>754</locationX>
        <locationY>856</locationY>
        <actionName>Core_MDF_Account_Sharing</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>External_sharing_on_owner_change</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>listOfAccounts</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Account_Sharing</nameSegment>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_if_account_record_is_created_by_Internal_and_Parent_Fund_RT_is_Intel</name>
        <label>Check if account record is created by Internal and Parent Fund RT is Intel</label>
        <locationX>449</locationX>
        <locationY>406</locationY>
        <defaultConnector>
            <targetReference>Share_Records_when_account_s_owner_is_changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Call_Subflow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_CoMarketingAccount_SetUp_Sharing</targetReference>
            </connector>
            <label>Call Subflow</label>
        </rules>
    </decisions>
    <decisions>
        <name>Share_Records_when_account_s_owner_is_changed</name>
        <label>Share Records when account&apos;s owner is changed</label>
        <locationX>448</locationX>
        <locationY>672</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Share_account_records_based_on_conditions</name>
            <conditionLogic>1 AND 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reshare_account_with_its_group_when_account_s_owner_is_changed</targetReference>
            </connector>
            <label>Share account records based on conditions</label>
        </rules>
    </decisions>
    <description>Update Parent Account, Record Type, IsPartner,  Re share account on owner change</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Core_MDF_Co_Marketing_Account_Setup {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Co_Marketing_Account_Setup</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>330</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Check_if_account_record_is_created_by_Internal_and_Parent_Fund_RT_is_Intel</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Core_MDF_CoMarketingAccount_SetUp_Sharing</name>
        <label>Core_MDF_CoMarketingAccount_SetUp_Sharing</label>
        <locationX>749</locationX>
        <locationY>399</locationY>
        <flowName>Core_MDF_CoMarketingAccount_SetUp_Sharing</flowName>
        <inputAssignments>
