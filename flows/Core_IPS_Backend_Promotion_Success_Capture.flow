            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_IPS_Promote_Count_Inbound__c</field>
            <value>
                <elementReference>Core_IPS_Case_Promote_Inbound_CountFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_4</name>
        <label>Update 4</label>
        <locationX>1252</locationX>
        <locationY>768</locationY>
        <connector>
            <targetReference>Decision_6</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_IPS_Case_Escalated_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_6</name>
        <label>Update 6</label>
        <locationX>1520</locationX>
        <locationY>1060</locationY>
        <inputAssignments>
            <field>Core_IPS_GEC_Flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Sub_Status__c</field>
            <value>
                <stringValue>GEC Hold</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_GroupId_For_IPS_GEC_Cases.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Get_Case_Record_Type_Id_IPS_GEC_Readonly.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>On Hold</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>update Backend Promote DT to NOW() and Backend Promote Success DT to null</description>
        <name>Update_Two</name>
        <label>Update Two</label>
        <locationX>846</locationX>
        <locationY>597</locationY>
        <connector>
            <targetReference>Decision_4</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_IPS_Backend_Promote_DT__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_IPS_Backend_Promote_Success_DT__c</field>
            <value>
                <elementReference>DateTimeToNull</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>590</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Decision_One</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
