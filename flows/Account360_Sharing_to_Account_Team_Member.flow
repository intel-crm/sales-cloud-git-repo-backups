<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Share the Account_Plan__c,Executive_Meeting_Brief__c,Account_Status__c records to the newly added Account Team Member</description>
        <name>invokeAccount360_Sharing</name>
        <label>invokeAccount360_Sharing</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <actionName>Account360_SharingUtility</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>accTeamMember</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Account360_SharingUtility</nameSegment>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>To share Account_Plan__c,Executive_Meeting_Brief__c,Account_Status__c to newly added Account Team Member</description>
    <environments>Default</environments>
    <interviewLabel>Account360 Sharing to Account Team Member {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account360 Sharing to Account Team Member</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>invokeAccount360_Sharing</targetReference>
        </connector>
        <object>AccountTeamMember</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
