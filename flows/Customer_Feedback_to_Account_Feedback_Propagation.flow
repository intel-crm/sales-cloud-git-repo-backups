    <start>
        <locationX>1134</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_DR_Feedback</targetReference>
        </connector>
        <filterFormula>((ISNEW() &amp;&amp; (TEXT({!$Record.DR_Feedback__c}) == &apos;Change to Partner&apos; || TEXT({!$Record.DR_Feedback__c}) == &apos;Change to Uncovered&apos; || TEXT({!$Record.DR_Feedback__c}) == &apos;Change to Other Led&apos;  || TEXT({!$Record.VP_Feedback__c}) == &apos;Change to Partner&apos; || TEXT({!$Record.VP_Feedback__c}) == &apos;Change to Other Led&apos;  || TEXT({!$Record.VP_Feedback__c}) == &apos;Change to Uncovered&apos; )) || ((ISCHANGED({!$Record.DR_Feedback__c}) &amp;&amp; (TEXT({!$Record.Feedback_Type__c}) == &apos;DR&apos; &amp;&amp; (TEXT({!$Record.DR_Feedback__c}) == &apos;Change to Partner&apos; || TEXT({!$Record.DR_Feedback__c}) == &apos;Change to Other Led&apos; || TEXT({!$Record.DR_Feedback__c}) == &apos;Change to Uncovered&apos; ))) || (ISCHANGED({!$Record.VP_Feedback__c}) &amp;&amp; (TEXT({!$Record.Feedback_Type__c}) == &apos;VP&apos; &amp;&amp; (TEXT({!$Record.VP_Feedback__c}) == &apos;Change to Partner&apos; || TEXT({!$Record.VP_Feedback__c}) == &apos;Change to Other Led&apos; || TEXT({!$Record.VP_Feedback__c}) == &apos;Change to Uncovered&apos; )))))</filterFormula>
        <object>SPM_Customer_Feedback__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
