    <decisions>
        <name>Check_for_DR_Feedback</name>
        <label>Check for DR Feedback</label>
        <locationX>1260</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DR_Feedback_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DR_Feedback__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.CST_Regional_Admin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Acc_Feedback</targetReference>
            </connector>
            <label>DR Feedback Exists</label>
        </rules>
        <rules>
            <name>No_DR_Feedback</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DR_Feedback__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.CST_Regional_Admin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_VP_Feedback</targetReference>
            </connector>
            <label>No DR Feedback</label>
        </rules>
        <rules>
            <name>If_User_is_Regional_Admin</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.CST_Regional_Admin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Security_Mapping_Regions_of_RA_manager</targetReference>
            </connector>
            <label>If User is Regional Admin/Lead</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_VP_Feedback</name>
        <label>Check for VP Feedback</label>
