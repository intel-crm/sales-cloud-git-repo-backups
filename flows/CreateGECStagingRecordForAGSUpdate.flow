            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Contact_Rec_Id__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Contact_WWID__c</field>
            <value>
