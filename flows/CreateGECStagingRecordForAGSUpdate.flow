        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>END_ELEMENT_3</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_For_GEC_Staging_record</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_Account_Id__c</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Contact_ID__c</field>
