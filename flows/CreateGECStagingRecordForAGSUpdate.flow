<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Ganesh Testing Flow</description>
    <ends>
        <name>END_ELEMENT_3</name>
        <locationX>176</locationX>
        <locationY>431</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>440</locationX>
        <locationY>539</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>ContactName</name>
        <dataType>String</dataType>
        <expression>{!$Record.FirstName}&amp; &apos; &apos; &amp; {!$Record.LastName}</expression>
    </formulas>
    <interviewLabel>CreateGECStagingRecordForAGSUpdate {!$Flow.CurrentDateTime}</interviewLabel>
