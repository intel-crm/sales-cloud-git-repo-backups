    <description>Update Tender Quote Line Status</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
        ISPICKVAL([SBQQ__QuoteLine__c].Pricing_Previous_Status_Nm__c, &apos;Pending&apos;),
	OR(
	[SBQQ__QuoteLine__c].RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Line_Edit&apos;,
	[SBQQ__QuoteLine__c].RecordType.DeveloperName = 
        &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
        [SBQQ__QuoteLine__c].RecordType.DeveloperName = 
        &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
       	[SBQQ__QuoteLine__c].RecordType.DeveloperName = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
        [SBQQ__QuoteLine__c].RecordType.DeveloperName  = 
        &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
        [SBQQ__QuoteLine__c].RecordType.DeveloperName  = 
        &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
    ),
	ISPICKVAL([SBQQ__QuoteLine__c].Pricing_Status_Nm__c, &apos;Rejected&apos;)
        
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
        ISPICKVAL({!myVariable_current.Pricing_Previous_Status_Nm__c}, &apos;Pending&apos;),
	OR(
	{!myVariable_current.RecordType.DeveloperName} = &apos;Pricing_Tender_Quote_Line_Edit&apos;,
	{!myVariable_current.RecordType.DeveloperName} = 
        &apos;Pricing_Tender_Quote_Line_Submitted&apos;,
        {!myVariable_current.RecordType.DeveloperName} = 
        &apos;Pricing_Tender_Quote_Line_ReadOnly&apos;,
       	{!myVariable_current.RecordType.DeveloperName} = &apos;Pricing_SVD_Quote_Line_Edit&apos;,
        {!myVariable_current.RecordType.DeveloperName}  = 
        &apos;Pricing_SVD_Quote_Line_Submitted&apos;,
        {!myVariable_current.RecordType.DeveloperName}  = 
        &apos;Pricing_SVD_Quote_Line_Read_Only&apos;
    ),
	ISPICKVAL({!myVariable_current.Pricing_Status_Nm__c}, &apos;Rejected&apos;)
        
)</expression>
    </formulas>
    <interviewLabel>Pricing_Tender_Quote_Line_Status_Update-38_InterviewLabel</interviewLabel>
    <label>Update Tender Quote Line Status</label>
