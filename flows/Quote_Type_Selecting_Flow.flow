<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>ProvideInputToApex</name>
        <label>ProvideInputToApex</label>
        <locationX>935</locationX>
        <locationY>267</locationY>
        <actionName>01p2D000004maKVNotFound</actionName>
        <connector>
            <targetReference>Quote_Creation_Successful</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Message</targetReference>
        </faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>qType</name>
            <value>
                <elementReference>Quote_Type</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>success</assignToReference>
            <name>isSuccess</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>Message</assignToReference>
            <name>messageResult</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>quoteId</assignToReference>
            <name>quoteId</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>51.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Quote_Creation_Successful</name>
        <label>Quote Creation Successful</label>
        <locationX>929</locationX>
        <locationY>429</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>QuoteSuccess</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>success</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Quote</targetReference>
            </connector>
            <label>QuoteSuccess</label>
        </rules>
        <rules>
            <name>QuoteFailure</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>success</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Message</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message</targetReference>
            </connector>
            <label>QuoteFailure</label>
        </rules>
    </decisions>
    <description>Allows the user to select the quote type while revising a quote</description>
