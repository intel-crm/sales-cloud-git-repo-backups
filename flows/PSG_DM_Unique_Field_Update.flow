            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>Get_Effective_Date</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR({!$Record.core_cpq_Effective_Date_Dt__c}))  &amp; &apos;-&apos; &amp;  LPAD(TEXT(MONTH({!$Record.core_cpq_Effective_Date_Dt__c})), 2 , &apos;0&apos;) &amp; &apos;-&apos; &amp; LPAD(TEXT(DAY({!$Record.core_cpq_Effective_Date_Dt__c})), 2 , &apos;0&apos;) &amp; &apos; 00:00:00&apos;</expression>
    </formulas>
    <formulas>
        <name>Get_End_Date</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR({!$Record.core_cpq_end_date__c}))  &amp; &apos;-&apos; &amp;  LPAD(TEXT(MONTH({!$Record.core_cpq_end_date__c})), 2 , &apos;0&apos;) &amp; &apos;-&apos; &amp; LPAD(TEXT(DAY({!$Record.core_cpq_end_date__c})), 2 , &apos;0&apos;) &amp; &apos; 00:00:00&apos;</expression>
    </formulas>
    <formulas>
        <name>GET_Margin_Geo</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.core_cpq_Margin_GEO_Txt__c})), &apos;null&apos;,TEXT({!$Record.core_cpq_Margin_GEO_Txt__c}))</expression>
    </formulas>
    <formulas>
        <name>Get_Product_Family</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.core_cpq_product_family_txt__c}), &apos;null&apos;,{!$Record.core_cpq_product_family_txt__c})</expression>
    </formulas>
    <interviewLabel>PSG DM Unique Field Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PSG DM Unique Field Update</label>
