<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Action for calling ERPM APIGEE api -
https://apis.intel.com/m2r/erpm/v1/profiles/set-profiles
Dev-https://fmdverpmws.cps.intel.com/erpm-rest/v2/contact/setprofile</description>
        <name>ERPM_API_Action</name>
        <label>ERPM API Action</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <actionName>CIDAAS_ERPM_Callout</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>requestIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>CIDAAS_ERPM_Callout</nameSegment>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <description>Constants for Entitlement based registrations. Comma separated values</description>
        <name>EntitlementBased</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Resource &amp; Design Center for Secure Content,EPS Verified Company</stringValue>
        </value>
    </constants>
    <constants>
        <description>Constant to store program based values. Program Name/code</description>
        <name>ProgramBased</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Intel Quote Request</stringValue>
        </value>
    </constants>
    <constants>
        <description>Constant to store record types. Only below record type requests are allowed comma separated.
Ex: Account_Create_Request</description>
        <name>RecordTypeNames</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Account_Create_Request</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Decision for filtering programs based, entitlement based registration requests.</description>
        <name>Check_for_Account_Request_and_Program</name>
        <label>Check for Account Request and Program</label>
        <locationX>380</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Program_or_Entitlement_Based_Outcome</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>ProgramBased</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.PRM_Channel_Program__r.Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>EntitlementBased</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Entitlement_Details__r.Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecordTypeNames</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.RecordType.DeveloperName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact_Entitlement</targetReference>
            </connector>
            <label>Program or  Entitlement Based Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_DZS_Engagement_Exists</name>
        <label>Check if DZS Engagement Exists</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Exists</defaultConnectorLabel>
        <rules>
            <name>Does_Not_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EngagementAssignedId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ERPM_API_Action</targetReference>
            </connector>
            <label>Does Not Exists</label>
        </rules>
    </decisions>
    <description>Flow to assign ERPM engagements for contacts. Flow will get triggered when new registration requests are inserted. This hold good only for account create request record type. APIGEE  eRPM  api will get called inside call out method.</description>
    <environments>Default</environments>
    <formulas>
        <description>EngagementMapping</description>
        <name>EngagementMapping</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Entitlement_Details__r.Name}, &quot;Resource &amp; Design Center for Secure Content&quot;, &quot;Developer Zone Standard&quot;, &quot;EPS Verified Company&quot;, &quot;EPS Basic&quot;,&quot;&quot;)</expression>
    </formulas>
    <interviewLabel>CIDAAS ERPM Callout {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CIDAAS Assign ERPM Engagements on new registration</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contact_Entitlement</name>
        <label>Get Contact Entitlement</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_DZS_Engagement_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Contact_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PRM_Matching_Contact__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Entitlement_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>EngagementMapping</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Selected__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Engagement</stringValue>
            </value>
        </filters>
        <object>Core_Contact_Entitlement__c</object>
        <outputAssignments>
            <assignToReference>EngagementAssignedId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_Account_Request_and_Program</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Entitlement_Details__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Channel_Program__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>EngagementAssignedId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
