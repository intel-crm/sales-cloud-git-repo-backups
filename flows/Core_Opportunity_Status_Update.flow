<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>CustomValidation</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT(MID({!fFaultMessage}, FIND(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION&apos;, {!fFaultMessage}), ((FIND(&apos;You can look up ExceptionCode values&apos;, {!fFaultMessage}))-{!firstIndex})), LEN(MID({!fFaultMessage}, FIND(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION&apos;, {!fFaultMessage}), ((FIND(&apos;You can look up ExceptionCode values&apos;, {!fFaultMessage}))-{!firstIndex})))-34))</expression>
    </formulas>
    <formulas>
        <name>fEntityLockedScreenMsg</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT(MID({!fFaultMessage}, FIND(&apos;ENTITY_IS_LOCKED&apos;, {!fFaultMessage}), ((FIND(&apos;You can look up ExceptionCode values&apos;, {!fFaultMessage}))-FIND(&apos;ENTITY_IS_LOCKED&apos;, {!fFaultMessage}))), LEN(MID({!fFaultMessage}, FIND(&apos;ENTITY_IS_LOCKED&apos;, {!fFaultMessage}), ((FIND(&apos;You can look up ExceptionCode values&apos;, {!fFaultMessage}))-FIND(&apos;ENTITY_IS_LOCKED&apos;, {!fFaultMessage}))))-17))</expression>
    </formulas>
    <formulas>
        <name>fFaultMessage</name>
        <dataType>String</dataType>
        <expression>{!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>firstIndex</name>
        <dataType>Number</dataType>
        <expression>FIND(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION&apos;, {!fFaultMessage})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fStatusUpdate</name>
        <dataType>String</dataType>
        <expression>LPAD(TEXT(MONTH(TODAY())),2,&quot;0&quot;)&amp;&quot;/&quot;&amp;LPAD(TEXT(DAY (TODAY())),2,&quot;0&quot;)&amp;&quot;/&quot;&amp;TEXT(YEAR(TODAY()))+&quot; &quot;+{!$User.FirstName}+&quot; &quot;+{!$User.LastName}+&quot; : &quot;+{!Status_Update}+BR()+{!Get_Opportunity_Records.Core_Status_Update__c}</expression>
    </formulas>
    <formulas>
        <name>fStatusUpdateLength</name>
        <dataType>Number</dataType>
        <expression>LEN({!Get_Opportunity_Records.Core_Status_Update__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>LastIndex</name>
        <dataType>Number</dataType>
        <expression>(FIND(&apos;You can look up ExceptionCode values&apos;, {!fFaultMessage}))-{!firstIndex}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Core_Opportunity_Status_Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Opportunity_Status_Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Opportunity_Records</name>
        <label>Get Opportunity Records</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Messgae_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity</name>
        <label>Update Opportunity</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <faultConnector>
            <targetReference>Showing_Validation_Message_on_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Status_Update__c</field>
            <value>
                <elementReference>fStatusUpdate</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <screens>
        <name>Messgae_Screen</name>
        <label>Messgae Screen</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <backButtonLabel>Cancel</backButtonLabel>
        <connector>
            <targetReference>Update_Opportunity</targetReference>
        </connector>
        <fields>
            <name>Status_Update</name>
            <fieldText>Status Update</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;&lt;span style=&quot;color: rgb(255, 13, 13);&quot;&gt;Status Update: data value too large:(max length=32768)&lt;/span&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>(LEN({!Status_Update})+{!fStatusUpdateLength})&lt;32768</formulaExpression>
            </validationRule>
        </fields>
        <nextOrFinishButtonLabel>Save</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity_Records</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Showing_Validation_Message_on_Screen</name>
        <label>Showing Validation Message on Screen</label>
        <locationX>440</locationX>
        <locationY>458</locationY>
        <flowName>Core_FlowErrorHandling</flowName>
        <inputAssignments>
            <name>faultMsg</name>
            <value>
                <elementReference>fFaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
