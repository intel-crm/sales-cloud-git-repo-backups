    <formulas>
        <description>[PMP_Partner_Offering__c].CreatedDate</description>
        <name>DateValue</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CreatedDate}</expression>
    </formulas>
    <formulas>
        <name>PartnerOfferingEndDate</name>
        <dataType>Date</dataType>
        <expression>IF(Month (TODAY())= 2&amp;&amp; Day (TODAY()) = 29,
			(TODAY())+365,
			Date (Year(TODAY())+1, Month(TODAY()),Day(TODAY()))
			)</expression>
    </formulas>
    <formulas>
        <description>Review Comment History</description>
        <name>ReviewCommentHistory</name>
        <dataType>String</dataType>
        <expression>{!$Record.PMP_Review_Comment_Txt__c} + &apos; &apos; +
{!$Record.LastModifiedBy.FirstName} + &apos; &apos; + 
{!$Record.LastModifiedBy.LastName} + &apos; &apos; +
TEXT(DATEVALUE({!$Record.LastModifiedDate})) +  &apos;: &apos; +
{!$Record.PMP_Review_Comment_Txt__c}</expression>
    </formulas>
