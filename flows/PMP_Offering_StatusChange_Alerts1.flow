    <decisions>
        <name>Clearing_values_of_admin_name_comments_and_email_in_each_of_the_end_state</name>
        <label>Clearing values of admin name, comments and email in each of the end state</label>
        <locationX>182</locationX>
        <locationY>5591</locationY>
        <defaultConnector>
            <targetReference>onStatusChange</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Clearing_values_of_admin_name_comments_and_email_in_each_of_the_end_state1</name>
            <conditionLogic>(1 OR 2 OR 3) AND ( 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.PMP_Partner_Offering_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Published</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMP_Partner_Offering_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMP_Partner_Offering_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Partner_Offering_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Partner_Offering_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Admin Review</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Admin_name_comments_and_email</targetReference>
            </connector>
            <label>Clearing values of admin name, comments and email in each of the end state1</label>
        </rules>
    </decisions>
    <decisions>
        <description>Notify All Admins, admin Re-Assigns to another Admin</description>
        <name>Notify_All_Admins_admin_Re_Assigns_to_another_Admin</name>
        <label>Notify All Admins, admin Re-Assigns to another Admin</label>
        <locationX>182</locationX>
        <locationY>7847</locationY>
        <defaultConnector>
            <targetReference>Notify_all_Admins_when_Submitted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Notify_All_Admins_admin_Re_Assigns_to_another_Admin1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMP_Partner_Offering_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Admin Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMP_Intel_Admin_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Intel_Admin_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMP_Intel_Admin_Id__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.PMP_Intel_Admin_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_All_Admin_when_one_admin_reassigns_to_another_admin</targetReference>
            </connector>
            <label>Notify All Admins, admin Re-Assigns to another Admin1</label>
        </rules>
    </decisions>
    <decisions>
        <description>Notify all Admins when Submitted</description>
        <name>Notify_all_Admins_when_Submitted</name>
        <label>Notify all Admins when Submitted</label>
        <locationX>182</locationX>
        <locationY>8183</locationY>
        <defaultConnector>
            <targetReference>On_Change_of_Pre_Release_Item_Count</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Notify_all_Admins_when_Submitted1</name>
            <conditionLogic>1 AND 2 AND (3 OR (NOT(4) AND 5))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMP_Partner_Offering_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Admin Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Intel_Admin_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Offering_Language_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>English</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMP_Offering_Language_Nm__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>English</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Offering_Language_Nm__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>English</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_All_Admin_when_Submitted</targetReference>
            </connector>
            <label>Notify all Admins when Submitted1</label>
        </rules>
    </decisions>
    <decisions>
        <name>Notify_POE_Admin_Published_when_future_date_arrived_without_pre_release_item</name>
        <label>Notify POE,Admin Published(when future date arrived without pre release item)</label>
        <locationX>182</locationX>
        <locationY>6599</locationY>
        <defaultConnector>
            <targetReference>Notify_POE_when_offering_is_retired</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Notify_POE_Admin_Published_when_future_date_arrived_without_pre_release_item_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMP_Partner_Offering_Lifecycle_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMP_Is_Published_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DateValue</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Record.PMP_Partner_Offering_Start_Dt__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMP_Pre_Release_Check_Nm__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Admin_when_Published_in_future</targetReference>
            </connector>
            <label>Notify POE,Admin Published(when future date arrived without pre release item)1</label>
        </rules>
    </decisions>
