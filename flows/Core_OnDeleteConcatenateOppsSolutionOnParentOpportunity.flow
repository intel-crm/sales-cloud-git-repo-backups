    <decisions>
        <name>Check_Application_Workload</name>
        <label>Check Application Workload</label>
        <locationX>1259</locationX>
        <locationY>729</locationY>
        <defaultConnector>
            <targetReference>SemiColon_Applucation_Workload</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Add Next Application Workload</defaultConnectorLabel>
        <rules>
            <name>Is_Blank_Application_Workload</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>For_each_opportunity_solution.Core_Application_Workload__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>For_each_opportunity_solution.Core_Application_Workload__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>For_each_opportunity_solution</targetReference>
            </connector>
            <label>Is Blank Application Workload</label>
        </rules>
        <rules>
            <name>Check_if_Null_Application_Workload</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Application_Workload</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Application_Workload</targetReference>
            </connector>
            <label>Check if Null Application Workload</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Industry_Use_Case</name>
