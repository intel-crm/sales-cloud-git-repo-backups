    <description>This flow used to update the concatenated details(Industry Use Case, Application/workload, technology Enabled) on parent opportunity when any related opportunity solution gets deleted.</description>
    <environments>Default</environments>
    <interviewLabel>Core_OnDeleteConcatenateOppsSolutionOnParentOpportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_OnDeleteConcatenateOppsSolutionOnParentOpportunity</label>
    <loops>
        <name>For_each_opportunity_solution</name>
        <label>For each opportunity solution</label>
        <locationX>670</locationX>
        <locationY>402</locationY>
        <collectionReference>Get_All_Opportunity_Solutions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Industry_Use_Case</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>GetParentOpps</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>to get all related opportunity solutions with parent opportunity.</description>
        <name>Get_All_Opportunity_Solutions</name>
        <label>Get All Opportunity Solutions</label>
        <locationX>439</locationX>
        <locationY>383</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>For_each_opportunity_solution</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity_Solution_Area__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Industry_Use_Case_s__c</queriedFields>
        <queriedFields>Core_Application_Workload__c</queriedFields>
        <queriedFields>Core_Technology_Enabled__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetParentOpps</name>
        <label>GetParentOpps</label>
        <locationX>671</locationX>
        <locationY>621</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SetConcatenatedValues</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Opportunity__r.Id</elementReference>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputReference>StoreParentOpps</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Concatenated_Application_workload__c</queriedFields>
        <queriedFields>Core_Concatenated_Industry_use_case__c</queriedFields>
        <queriedFields>Core_Concatenated_Technology_Enabled__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Core_Update_Parent_Opportunity</name>
        <label>Update Parent Opportunity</label>
        <locationX>374</locationX>
        <locationY>843</locationY>
        <inputReference>StoreResultedOpps</inputReference>
    </recordUpdates>
    <start>
        <locationX>144</locationX>
        <locationY>40</locationY>
        <connector>
            <targetReference>Get_All_Opportunity_Solutions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Opportunity__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity_Solution_Area__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Application_Workload</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
