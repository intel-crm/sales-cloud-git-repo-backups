                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Industry_use_case</targetReference>
            </connector>
            <label>Check If Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Technology_Enabled</name>
        <label>Check Technology Enabled</label>
        <locationX>1258</locationX>
        <locationY>415</locationY>
        <defaultConnector>
            <targetReference>Add_Semicolon_Technology_Enabled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Add Next Technology Enabled</defaultConnectorLabel>
        <rules>
            <name>Is_Blank_Technology_Enabled</name>
            <conditionLogic>or</conditionLogic>
