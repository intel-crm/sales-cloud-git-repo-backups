<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>This Send Email component is used to send email to the recipient defined in  EMail Address parameter.</description>
        <name>sendUserActivationNotificationEmail</name>
        <label>sendUserActivationNotificationEmail</label>
        <locationX>867</locationX>
        <locationY>21</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddressesArray</name>
            <value>
                <elementReference>collEmailRecipients</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <elementReference>frmlSenderEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>RDC Privileged access for IPS enabled contact</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>txttemplate_UserActivationEmailTempalte</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assigning recipient email id before sending the email.</description>
        <name>emailAddressAssignment</name>
        <label>emailAddressAssignment</label>
        <locationX>592</locationX>
        <locationY>320</locationY>
        <assignmentItems>
            <assignToReference>collEmailRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>frmlEmailRecipient</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>sendUserActivationNotificationEmail</targetReference>
        </connector>
    </assignments>
    <description>This Flow is used to send email to RDC Support Team when an external user is activated with RDC Privileged access for IPS enabled contact</description>
    <environments>Default</environments>
    <formulas>
        <name>CIM_Business_Party_ID_Switch</name>
        <dataType>String</dataType>
        <expression>IF({!$Label.Core_IPS_UCD_Toggle_Switch}== &apos;0&apos;,  &apos;Unified ID : &apos;&amp;{!sobj_AccountDetails.Core_Business_Party_Id__c}, &apos;CIM ID: &apos;&amp;{!sobj_AccountDetails.Core_CIM_ID__c})</expression>
    </formulas>
    <formulas>
        <description>This formula field is used to refer email id from Custom Label.</description>
        <name>frmlEmailRecipient</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_IPS_UserActivation_Team_Email}</expression>
    </formulas>
    <formulas>
        <description>This is used to show the Sender email address.</description>
        <name>frmlSenderEmail</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_IPS_UserActivation_Sender_Email_Id}</expression>
    </formulas>
    <interviewLabel>Core IPS flow RDC UserActivation Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core IPS flow RDC UserActivation Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>This Fast Lookup component is used to search account record related to the user record.</description>
        <name>fastLkUp_Account</name>
        <label>fastLkUp_Account</label>
        <locationX>428</locationX>
        <locationY>321</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>emailAddressAssignment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>sobj_UserDetails.AccountId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>sobj_AccountDetails</outputReference>
        <queriedFields>Name</queriedFields>
        <queriedFields>Core_Account_Legal_Name__c</queriedFields>
        <queriedFields>Core_Business_Party_Id__c</queriedFields>
        <queriedFields>BillingStreet</queriedFields>
        <queriedFields>BillingCountry</queriedFields>
        <queriedFields>BillingCity</queriedFields>
        <queriedFields>BillingState</queriedFields>
        <queriedFields>BillingPostalCode</queriedFields>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_CIM_ID__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>This Fast Lookup component is used to search contact record related to the user record.</description>
        <name>fastLkUp_Contact</name>
        <label>fastLkUp_Contact</label>
        <locationX>426</locationX>
        <locationY>203</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>fastLkUp_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>sobj_UserDetails.ContactId</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>sobj_ContactDetails</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Email</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Core_eRPM_Person_Id__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>fastLkUp_User</name>
        <label>fastLkUp_User</label>
        <locationX>428</locationX>
        <locationY>73</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>fastLkUp_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Username</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varUserName</elementReference>
            </value>
        </filters>
        <object>User</object>
        <outputReference>sobj_UserDetails</outputReference>
        <queriedFields>FederationIdentifier</queriedFields>
        <queriedFields>Core_Login_Id__c</queriedFields>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <queriedFields>ContactId</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>fastLkUp_User</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <description>This is used to define email template for user activation notification.</description>
        <name>txttemplate_UserActivationEmailTempalte</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;The following IPS Enabled Contact needs RDC access.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Enterprise Information&lt;/p&gt;&lt;p&gt;Login Id:  {!sobj_UserDetails.Core_Login_Id__c}&lt;/p&gt;&lt;p&gt;Enterprise Id: {!sobj_UserDetails.FederationIdentifier}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Contact Information&lt;/p&gt;&lt;p&gt;Name:  {!sobj_ContactDetails.Name}&lt;/p&gt;&lt;p&gt;Email Address: {!sobj_ContactDetails.Email}&lt;/p&gt;&lt;p&gt;Sales/IPS Cloud Id: {!sobj_ContactDetails.Id}&lt;/p&gt;&lt;p&gt;ERPM Id: {!sobj_ContactDetails.Core_eRPM_Person_Id__c}&lt;/p&gt;&lt;p&gt;User Id: {!sobj_UserDetails.Id}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Account Information&lt;/p&gt;&lt;p&gt;Name:  {!sobj_AccountDetails.Name}&lt;/p&gt;&lt;p&gt;Legal Name: {!sobj_AccountDetails.Core_Account_Legal_Name__c}&lt;/p&gt;&lt;p&gt;Sales/IPS Cloud Id: {!sobj_AccountDetails.Id}&lt;/p&gt;&lt;p&gt;{!CIM_Business_Party_ID_Switch}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Address:&lt;/p&gt;&lt;p&gt;           {!sobj_AccountDetails.BillingStreet}&lt;/p&gt;&lt;p&gt;           {!sobj_AccountDetails.BillingCity}&lt;/p&gt;&lt;p&gt;           {!sobj_AccountDetails.BillingState}  {!sobj_AccountDetails.BillingPostalCode}&lt;/p&gt;&lt;p&gt;           {!sobj_AccountDetails.BillingCountry}&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <description>This collection variable is used to store email ids of the recipients.</description>
        <name>collEmailRecipients</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>This SObject variable is used to store Account record. This variable is used for both input and output parameters.</description>
        <name>sobj_AccountDetails</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <description>This SObject variable is used to store Contact record. This variable is used for both input and output parameters.</description>
        <name>sobj_ContactDetails</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <description>This SObject variable is used to store User record. This variable is used for both input and output parameters.</description>
        <name>sobj_UserDetails</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>User</objectType>
    </variables>
    <variables>
        <description>This variable is used as username input parameter.</description>
        <name>varUserName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
