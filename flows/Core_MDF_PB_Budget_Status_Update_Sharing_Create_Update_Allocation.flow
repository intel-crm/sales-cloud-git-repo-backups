    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (
OR(AND([PartnerMarketingBudget].Core_MDF_Program_Nm__c=&apos;Client Co-Marketing Fund&apos;,
OR(AND($Permission.Core_MDF_CCP_Internal_CCF_MDF_Budget_Loader,NOT([PartnerMarketingBudget].Core_MDF_Legacy_Budget_Ind__c),TEXT([PartnerMarketingBudget].Core_MDF_Budget_Type_Txt__c)!=&apos;OEM CMP&apos;),
AND($Permission.Core_MDF_CCP_Internal_Finance_User,OR([PartnerMarketingBudget].Core_MDF_Legacy_Budget_Ind__c,TEXT([PartnerMarketingBudget].Core_MDF_Budget_Type_Txt__c)=&apos;OEM CMP&apos;)))),
AND([PartnerMarketingBudget].Core_MDF_Program_Nm__c=&apos;Data Center Co-Marketing Fund&apos;,
OR(AND($Permission.Core_MDF_CCP_Internal_DCF_MDF_Budget_Loader,NOT([PartnerMarketingBudget].Core_MDF_Legacy_Budget_Ind__c),TEXT([PartnerMarketingBudget].Core_MDF_Budget_Type_Txt__c)!=&apos;OEM CMP&apos;,TEXT([PartnerMarketingBudget].Core_MDF_Budget_Type_Txt__c)!=&apos;Service Provider CMP&apos;),
AND($Permission.Core_MDF_CCP_Internal_Finance_User,OR([PartnerMarketingBudget].Core_MDF_Legacy_Budget_Ind__c,TEXT([PartnerMarketingBudget].Core_MDF_Budget_Type_Txt__c)=&apos;OEM CMP&apos;,TEXT([PartnerMarketingBudget].Core_MDF_Budget_Type_Txt__c)=&apos;Service Provider CMP&apos;)))),
AND([PartnerMarketingBudget].Core_MDF_Program_Nm__c=&apos;Retail Marketing Funds&apos;,$Permission.Core_MDF_CCP_Internal_Retail_Finance_Usr),
AND(OR([PartnerMarketingBudget].Core_MDF_Program_Nm__c=&apos;Client Co-Marketing Fund Boost&apos;,[PartnerMarketingBudget].Core_MDF_Program_Nm__c=&apos;Service Provider Co-Marketing Fund&apos;),$Permission.Core_MDF_CCP_Internal_Finance_User),
AND([PartnerMarketingBudget].Core_MDF_Program_Nm__c=&apos;Channel MDF&apos;,[PartnerMarketingBudget].RecordType.DeveloperName=&apos;Core_MDF_Channel_MDF_Account_Based&apos;,$Permission.Core_MDF_CCP_Internal_Channel_MDF_Budget_Loader),
AND([PartnerMarketingBudget].Core_MDF_Program_Nm__c=&apos;Intel Partner Alliance&apos;,[PartnerMarketingBudget].RecordType.DeveloperName=$Label.Core_MDF_IPA_AccountBased_RecType_DevName,$Permission.Core_MDF_CCP_Internal_IPA_Budget_Loader)),
NOT(ISNEW()),
OR( 
	ISCHANGED([PartnerMarketingBudget].StartDate) 
	,ISCHANGED([PartnerMarketingBudget].EndDate) 
	,ISCHANGED([PartnerMarketingBudget].Amount)
	,AND(
		ISCHANGED([PartnerMarketingBudget].Core_MDF_Decrease_Budget_Amount_Amt__c ),
		(IF((ISPICKVAL([PartnerMarketingBudget].Core_MDF_Budget_Status__c, &quot;Rejected&quot;)),true, (([PartnerMarketingBudget].Core_MDF_Decrease_Budget_Amount_Amt__c ) &gt; 0)))
	)
    ),
OR(
[PartnerMarketingBudget].RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,
[PartnerMarketingBudget].RecordType.DeveloperName = $Label.Core_MDF_Retail_Record_Type_Developer_Name,
[PartnerMarketingBudget].RecordType.DeveloperName = $Label.Core_MDF_CMDF_Account_Based_RT,
[PartnerMarketingBudget].RecordType.DeveloperName = $Label.Core_MDF_IPA_AccountBased_RecType_DevName) 
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_7</name>
        <dataType>Boolean</dataType>
        <expression>AND (
OR(AND({!myVariable_current.Core_MDF_Program_Nm__c}=&apos;Client Co-Marketing Fund&apos;,
OR(AND({!$Permission.Core_MDF_CCP_Internal_CCF_MDF_Budget_Loader},NOT({!myVariable_current.Core_MDF_Legacy_Budget_Ind__c}),TEXT({!myVariable_current.Core_MDF_Budget_Type_Txt__c})!=&apos;OEM CMP&apos;),
AND({!$Permission.Core_MDF_CCP_Internal_Finance_User},OR({!myVariable_current.Core_MDF_Legacy_Budget_Ind__c},TEXT({!myVariable_current.Core_MDF_Budget_Type_Txt__c})=&apos;OEM CMP&apos;)))),
AND({!myVariable_current.Core_MDF_Program_Nm__c}=&apos;Data Center Co-Marketing Fund&apos;,
OR(AND({!$Permission.Core_MDF_CCP_Internal_DCF_MDF_Budget_Loader},NOT({!myVariable_current.Core_MDF_Legacy_Budget_Ind__c}),TEXT({!myVariable_current.Core_MDF_Budget_Type_Txt__c})!=&apos;OEM CMP&apos;,TEXT({!myVariable_current.Core_MDF_Budget_Type_Txt__c})!=&apos;Service Provider CMP&apos;),
AND({!$Permission.Core_MDF_CCP_Internal_Finance_User},OR({!myVariable_current.Core_MDF_Legacy_Budget_Ind__c},TEXT({!myVariable_current.Core_MDF_Budget_Type_Txt__c})=&apos;OEM CMP&apos;,TEXT({!myVariable_current.Core_MDF_Budget_Type_Txt__c})=&apos;Service Provider CMP&apos;)))),
AND({!myVariable_current.Core_MDF_Program_Nm__c}=&apos;Retail Marketing Funds&apos;,{!$Permission.Core_MDF_CCP_Internal_Retail_Finance_Usr}),
AND(OR({!myVariable_current.Core_MDF_Program_Nm__c}=&apos;Client Co-Marketing Fund Boost&apos;,{!myVariable_current.Core_MDF_Program_Nm__c}=&apos;Service Provider Co-Marketing Fund&apos;),{!$Permission.Core_MDF_CCP_Internal_Finance_User}),
AND({!myVariable_current.Core_MDF_Program_Nm__c}=&apos;Channel MDF&apos;,{!myVariable_current.RecordType.DeveloperName}=&apos;Core_MDF_Channel_MDF_Account_Based&apos;,{!$Permission.Core_MDF_CCP_Internal_Channel_MDF_Budget_Loader}),
AND({!myVariable_current.Core_MDF_Program_Nm__c}=&apos;Intel Partner Alliance&apos;,{!myVariable_current.RecordType.DeveloperName}={!$Label.Core_MDF_IPA_AccountBased_RecType_DevName},{!$Permission.Core_MDF_CCP_Internal_IPA_Budget_Loader})),
NOT(ISNEW()),
OR( 
	ISCHANGED({!myVariable_current.StartDate}) 
	,ISCHANGED({!myVariable_current.EndDate}) 
	,ISCHANGED({!myVariable_current.Amount})
	,AND(
		ISCHANGED({!myVariable_current.Core_MDF_Decrease_Budget_Amount_Amt__c} ),
		(IF((ISPICKVAL({!myVariable_current.Core_MDF_Budget_Status__c}, &quot;Rejected&quot;)),true, (({!myVariable_current.Core_MDF_Decrease_Budget_Amount_Amt__c} ) &gt; 0)))
	)
    ),
OR(
{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name},
{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Retail_Record_Type_Developer_Name},
{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_CMDF_Account_Based_RT},
{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_IPA_AccountBased_RecType_DevName}) 
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(TEXT([PartnerMarketingBudget].Core_MDF_Budget_Status__c) == &apos;Released&apos;,
OR(AND(ISCHANGED([PartnerMarketingBudget].Core_MDF_Budget_Status__c), 
