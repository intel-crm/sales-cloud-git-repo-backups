    <description>Create a new Audit Record when Partner Fund Claim statu is set as Hold for Audit and trigger Assignment rule to assign Audit to Audit Queue, Update Case if Claim field are update. Update ClaimSubmitter on Case when Claim owner changes.</description>
    <formulas>
        <name>varActivityStartAndEndDate</name>
        <dataType>String</dataType>
        <expression>Text(Month ({!varActivityStartDate})) &amp; &quot;/&quot; &amp; Text(Day({!varActivityStartDate})) &amp; &quot;/&quot; &amp; Text(Year({!varActivityStartDate})) &amp; &quot; and &quot; &amp; Text(Month ({!varActivityEndDate})) &amp; &quot;/&quot; &amp; Text(Day({!varActivityEndDate})) &amp; &quot;/&quot; &amp; Text(Year({!varActivityEndDate}))</expression>
    </formulas>
    <formulas>
        <name>varClaimId</name>
        <dataType>String</dataType>
        <expression>{!varActivityNumber} &amp; &quot;-&quot; &amp; {!varClaimNumber}</expression>
    </formulas>
    <formulas>
        <name>varCurrencyCode</name>
        <dataType>String</dataType>
        <expression>LEFT( {!varRequestedAmount},3)</expression>
    </formulas>
    <formulas>
        <name>varDocumentSubmissionDeadlineDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 30</expression>
    </formulas>
    <formulas>
        <name>varReimbursementRateNumber</name>
        <dataType>Number</dataType>
        <expression>VALUE(LEFT( {!varReimbursementRate},LEN({!varReimbursementRate})-1))</expression>
        <scale>2</scale>
    </formulas>
