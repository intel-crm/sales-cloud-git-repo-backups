    <decisions>
        <name>checkActionType</name>
        <label>CheckActionType</label>
        <locationX>293</locationX>
        <locationY>7</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>CreateNewReviewCase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varActionType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Create</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getCampaignId</targetReference>
            </connector>
            <label>CreateNewReviewCase</label>
        </rules>
        <rules>
            <name>UpdateReviewCase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varActionType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Update</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getClaimAmount</targetReference>
            </connector>
            <label>UpdateReviewCase</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkClaimAndCaseStatus</name>
        <label>checkClaimAndCaseStatus</label>
        <locationX>179</locationX>
        <locationY>251</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Cancelled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReviewCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReviewCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Non-compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReviewCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateCancelledCase</targetReference>
            </connector>
            <label>Cancelled</label>
        </rules>
        <rules>
            <name>Not_Cancelled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReviewCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReviewCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Non-compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReviewCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ClaimReviewFieldsChanged</targetReference>
            </connector>
            <label>Not Cancelled</label>
        </rules>
        <rules>
            <name>ClaimOwnerUpdated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimOwner</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>varClaimSubmitter </stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReviewCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReviewCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Non-compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varReviewCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <label>ClaimOwnerUpdated</label>
        </rules>
    </decisions>
