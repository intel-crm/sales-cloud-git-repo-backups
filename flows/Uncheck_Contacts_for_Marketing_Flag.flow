    <recordLookups>
        <name>Get_Opportunity_Contact_Role_ID</name>
        <label>Get Opportunity Contact Role ID</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_the_Contact_Active</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_For_Get_Opportunity_Contact_Role</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityContactRole</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Check_Contacts_for_Marketing_flag</name>
        <label>Check Contacts for Marketing flag</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <faultConnector>
            <targetReference>Create_Log_Entry_For_Contacts_For_Marketing_Flag</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_Contacts_for_Marketing__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Uncheck_Contacts_for_Marketing_flag</name>
        <label>Uncheck Contacts for Marketing flag</label>
        <locationX>578</locationX>
        <locationY>539</locationY>
        <faultConnector>
            <targetReference>Create_Log_Entry_For_Uncheck_Contacts_For_Marketing_Flag</targetReference>
        </faultConnector>
        <filterLogic>((1 OR 2) AND 3) OR (4 AND 5)</filterLogic>
        <filters>
            <field>Core_Login_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Deleted</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Login_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Downgrade to B2C</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Enterprise_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Deactivated__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Deactivation_Reason__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Contacts_for_Marketing__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity_Contact_Role_ID</targetReference>
        </connector>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
