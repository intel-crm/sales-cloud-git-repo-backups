    <recordCreates>
        <name>Create_Log_Entry_For_Uncheck_Contacts_For_Marketing_Flag</name>
        <label>Create Log Entry For Uncheck Contacts For Marketing Flag</label>
        <locationX>842</locationX>
        <locationY>647</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
