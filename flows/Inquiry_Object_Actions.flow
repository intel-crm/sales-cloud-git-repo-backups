    <decisions>
        <name>Check_if_Lead_Contact_Email_field_has_Email_ID</name>
        <label>Check if Lead Contact Email field has Email ID</label>
        <locationX>614</locationX>
        <locationY>357</locationY>
        <defaultConnector>
            <targetReference>IF_Lead_OR_Contact_is_having_values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If Email Id is there</defaultConnectorLabel>
        <rules>
            <name>If_Email_Id_is_not_there</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Contact_Owner_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Contact_Email_ID</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Email Id is not there</label>
        </rules>
    </decisions>
    <decisions>
        <name>IF_Lead_OR_Contact_is_having_values</name>
        <label>IF Lead OR Contact is having values</label>
        <locationX>690</locationX>
        <locationY>730</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Core_Inquiry_Asked_For_Contact_Follow_Up</name>
            <conditionLogic>1 AND (2 OR 3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Contact_Inquiries__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Asked for Follow-up</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested Quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Inquiry_Asked_For_Contact_Follow_Up</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Core_Inquiry_Asked_For_Contact_Follow_Up</label>
        </rules>
        <rules>
            <name>If_Core_Inquiry_CNDA_Request_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Contact_Inquiries__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CNDA Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Inquiry_CNDA_Request_Contact</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Core_Inquiry_CNDA_Request_Contact</label>
        </rules>
        <rules>
            <name>If_Core_Inquiry_Asked_For_Lead_Follow_Up</name>
            <conditionLogic>1 AND (2 OR 3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Inquiries__c</leftValueReference>
