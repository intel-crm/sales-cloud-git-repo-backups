                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested Quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Inquiry_Asked_For_Lead_Follow_Up</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Core_Inquiry_Asked_For_Lead_Follow_Up</label>
        </rules>
        <rules>
            <name>IfCore_Inquiry_CNDA_Request_Lead</name>
            <conditionLogic>and</conditionLogic>
