            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CNDA Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
