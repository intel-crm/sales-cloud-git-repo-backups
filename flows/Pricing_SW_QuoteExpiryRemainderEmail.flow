            </connector>
            <label>Software &amp; Services Quote Expiry Date 14 Days</label>
        </rules>
    </decisions>
    <description>To send expiry reminder notifications before 3, 7 and 14 days; for Software &amp; Services Quote</description>
    <environments>Default</environments>
    <formulas>
        <name>Pricing_SW_FourteenDays</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+14</expression>
    </formulas>
    <formulas>
        <name>Pricing_SW_SevenDays</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+7</expression>
    </formulas>
    <formulas>
        <name>Pricing_SW_ThreeDays</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+3</expression>
    </formulas>
    <interviewLabel>Pricing_SW QuoteExpiryRemainderEmail {!$Flow.CurrentDateTime}</interviewLabel>
