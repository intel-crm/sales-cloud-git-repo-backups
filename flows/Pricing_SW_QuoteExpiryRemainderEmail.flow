    <decisions>
        <name>Software_Services_Quote_Expiry_Date</name>
        <label>Software &amp; Services Quote Expiry Date</label>
        <locationX>660</locationX>
        <locationY>468</locationY>
        <defaultConnector>
            <targetReference>Loop_through_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Software_Services_Quote_Expiry_Date_3_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Records.Pricing_SW_Expiry_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Pricing_SW_ThreeDays</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Software_Services_Quote_3_Days_Expiry_Reminder_Email</targetReference>
            </connector>
            <label>Software &amp; Services Quote Expiry Date 3 Days</label>
        </rules>
