<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Email</name>
        <label>Send Email</label>
        <locationX>908</locationX>
        <locationY>733</locationY>
        <actionName>Case.Core_IPS_Case_Create_Notification</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>Case.Core_IPS_Case_Create_Notification</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Case_Owner_Queue_is_safe_to_send_email</name>
        <label>Is Case Owner Queue is safe to send email</label>
        <locationX>716</locationX>
        <locationY>521</locationY>
        <defaultConnectorLabel>No - Skip Email Alert</defaultConnectorLabel>
        <rules>
            <name>Yes_Send_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Case_Queue_Users_Active_or_Not.out_IsSafeToEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email</targetReference>
            </connector>
            <label>Yes - Send Email</label>
        </rules>
    </decisions>
    <description>This is acting as a main flow to call the sub flow with the logic to check the case queue has the active user or not</description>
    <environments>Default</environments>
    <interviewLabel>Gangadhar Test flow2 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Gangadhar Test flow3</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>543</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Case_Queue_Users_Active_or_Not</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <description>Sub flow to validate the Case Queue has the active users or not</description>
        <name>Case_Queue_Users_Active_or_Not</name>
        <label>Case Queue Users Active or Not</label>
        <locationX>587</locationX>
        <locationY>388</locationY>
        <connector>
            <targetReference>Is_Case_Owner_Queue_is_safe_to_send_email</targetReference>
        </connector>
        <flowName>Core_Ips_CaseQueueUserActiveOrNot</flowName>
        <inputAssignments>
            <name>in_CaseId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>in_OwnerId</name>
            <value>
                <elementReference>$Record.Core_IPS_Assigned_Queue__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>RelatedUserCaseCoOwner</name>
            <value>
                <elementReference>$Record.Core_Case_Co_Owner__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>RelatedUserIntelSupportOwner</name>
            <value>
                <elementReference>$Record.Core_Intel_Sup_Owner__c</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
