    <actionCalls>
        <name>Manual_Approval_Process_Flow</name>
        <label>Manual Approval Process</label>
        <locationX>325</locationX>
        <locationY>322</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>PRM_RegRequestManualAppovalV1</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>submitterId</name>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>submit</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Account_Create_Request_RecordType</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Account_Create_Request</stringValue>
        </value>
    </constants>
    <constants>
        <name>Add_Contact_Request_RecordType</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Add_Contact_Request</stringValue>
        </value>
    </constants>
    <constants>
        <name>Add_Membership_Request_RecordType</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Add_Membership_Request</stringValue>
        </value>
    </constants>
    <constants>
        <name>PSG_Value</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PSG</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Manual_Approval_Process</name>
        <label>Manual Approval Process</label>
        <locationX>625</locationX>
        <locationY>460</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>UIOLI_Return</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Is_Returning_User__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Reg_Req</targetReference>
            </connector>
            <label>UIOLI Return</label>
        </rules>
        <rules>
            <name>Approval_Process</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_isSubmitted__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Channel_Program_Level_txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>PartnerProgram</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Entitlement_Details__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Add_Membership_Request_RecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Add_Contact_Request_RecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Account_Create_Request_RecordType</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Manual_Approval_Process_Flow</targetReference>
            </connector>
            <label>Approval Process</label>
        </rules>
        <rules>
            <name>Apex_Class</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Admin_Registration_RecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_TriggerProcess__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Entitlement_Details__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Channel_Program_Level_txt__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>PSG_Value</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Call_Apex_class</targetReference>
            </connector>
            <label>Apex Class</label>
        </rules>
    </decisions>
    <description>Used for the Manual Approval Process</description>
    <environments>Default</environments>
    <interviewLabel>PRM_Auto_Record_Submission {!$Flow.CurrentDateTime}</interviewLabel>
