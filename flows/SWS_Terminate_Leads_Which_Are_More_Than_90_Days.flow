<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Lead_Id_So_We_Can_Remove_It</name>
        <label>Add Lead Id So We Can Remove It</label>
        <locationX>270</locationX>
        <locationY>1392</locationY>
        <assignmentItems>
            <assignToReference>LeadNeedToRemove</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Over_Task_Lists.WhoId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LeadNeedToRemove</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Over_Task_Lists.WhatId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_Task_Lists</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Lead_Id_So_We_Can_Remove_It_ForEmailMessages</name>
        <label>Add Lead Id So We Can Remove It</label>
        <locationX>138</locationX>
        <locationY>2316</locationY>
        <assignmentItems>
            <assignToReference>LeadNeedToRemove</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Over_Email_Messages.RelationId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_Email_Messages</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Lead_Ids_to_List</name>
        <label>Assign Lead Ids to List</label>
        <locationX>270</locationX>
        <locationY>876</locationY>
        <assignmentItems>
            <assignToReference>LeadIdList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Over_Lead_Ids.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_Lead_Ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Lead_List</name>
        <label>Assign Lead List</label>
        <locationX>138</locationX>
        <locationY>3024</locationY>
        <assignmentItems>
            <assignToReference>LeadRecordNeedToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>SingleLeadRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>For_Each_Valid_Lead</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Lead_Record_Type_Ids</name>
        <label>Assign Lead Record Type Ids</label>
        <locationX>270</locationX>
        <locationY>468</locationY>
        <assignmentItems>
            <assignToReference>LeadRecordTypeIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Over_Record_Types.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_Record_Types</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Values_In_Lead</name>
        <label>Assign Values In Lead</label>
        <locationX>138</locationX>
        <locationY>2916</locationY>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Core_Lead_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Disqualified</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Core_Lead_Sub_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Rep Inactivity</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_Each_Valid_Lead.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Core_Lead_State__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Terminated</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SingleLeadRecord.Core_Lead_Notes__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LeadNote</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Lead_List</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Empty_The_Lead_Need_To_Remove_List</name>
        <label>Empty The Lead Need To Remove List</label>
        <locationX>50</locationX>
        <locationY>1992</locationY>
        <assignmentItems>
            <assignToReference>LeadNeedToRemove</assignToReference>
            <operator>RemoveAll</operator>
            <value>
                <elementReference>LeadNeedToRemove</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_Email_Messages</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Remove_Lead_From_List_Of_Lead_Ids</name>
        <label>Remove Lead From List Of Lead Ids</label>
        <locationX>182</locationX>
        <locationY>1668</locationY>
        <assignmentItems>
            <assignToReference>LeadIdList</assignToReference>
            <operator>RemoveAll</operator>
            <value>
                <elementReference>LeadNeedToRemove</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_If_Lead_Exist_in_List_Or_Not</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Remove_Lead_From_List_Of_Lead_Ids_After_EmailMessage</name>
        <label>Remove Lead From List Of Lead Ids</label>
        <locationX>50</locationX>
        <locationY>2592</locationY>
        <assignmentItems>
            <assignToReference>LeadIdList</assignToReference>
            <operator>RemoveAll</operator>
            <value>
                <elementReference>LeadNeedToRemove</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Valid_Leads</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>LASTCREATEDAYS</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>90.0</numberValue>
        </value>
    </constants>
    <constants>
        <name>LASTMODIFIEDDAYS</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>30.0</numberValue>
        </value>
    </constants>
    <decisions>
        <name>Check_If_Lead_Exist_in_List_Or_Not</name>
        <label>Check If Any Lead Exist in List Or Not</label>
        <locationX>182</locationX>
        <locationY>1776</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_LeadExist</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>LeadIdList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Email_Messages</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_Email_Exist_for_the_Lead</name>
        <label>Does Email Exist for the Lead?</label>
        <locationX>270</locationX>
        <locationY>2208</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_Email_Messages</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_EmailMessageExist</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>LeadIdList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Over_Email_Messages.RelationId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Lead_Id_So_We_Can_Remove_It_ForEmailMessages</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_Task_Exist_for_the_Lead</name>
        <label>Does Task Exist for the Lead?</label>
        <locationX>402</locationX>
        <locationY>1284</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_Task_Lists</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_TaskExist</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>LeadIdList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Over_Task_Lists.WhoId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LeadIdList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Over_Task_Lists.WhatId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Lead_Id_So_We_Can_Remove_It</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>LeadCreatedDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(FROMUNIXTIME(UNIXTIMESTAMP({!$Flow.CurrentDateTime}) - {!LASTCREATEDAYS} * 24 * 60 * 60 ))</expression>
    </formulas>
    <formulas>
        <name>LeadLastModifiedDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(FROMUNIXTIME(UNIXTIMESTAMP({!$Flow.CurrentDateTime}) - {!LASTMODIFIEDDAYS} * 24 * 60 * 60 ))</expression>
    </formulas>
    <formulas>
        <name>LeadNote</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!For_Each_Valid_Lead.Core_Lead_Notes__c}),
   &quot;This lead has been auto disqualified on &quot; &amp; TEXT({!$Flow.InterviewStartTime}) &amp;
   &quot;, as it has been active for over 90 days with no recorded activity in the last 30 days.&quot;,
   {!For_Each_Valid_Lead.Core_Lead_Notes__c} &amp; &quot; This lead has been auto disqualified on &quot; &amp;
   TEXT({!$Flow.InterviewStartTime}) &amp; &quot;, as it has been active for over 90 days with no recorded activity in the last 30 days.&quot;
)</expression>
    </formulas>
    <interviewLabel>SWS Terminate Leads Which Are More Than 90 Days {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Terminate Leads Which Are More Than 90 Days</label>
    <loops>
        <name>For_Each_Valid_Lead</name>
        <label>For Each Valid Lead</label>
        <locationX>50</locationX>
        <locationY>2808</locationY>
        <collectionReference>Get_Valid_Leads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Values_In_Lead</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Leads_That_Needs_to_Update</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Over_Email_Messages</name>
        <label>Loop Over Email Messages</label>
        <locationX>50</locationX>
        <locationY>2100</locationY>
        <collectionReference>Get_Email_Messages</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Does_Email_Exist_for_the_Lead</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Remove_Lead_From_List_Of_Lead_Ids_After_EmailMessage</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Over_Lead_Ids</name>
        <label>Loop Over Lead Ids</label>
        <locationX>182</locationX>
        <locationY>768</locationY>
        <collectionReference>Get_Leads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Lead_Ids_to_List</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Tasks</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Over_Record_Types</name>
        <label>Loop Over Record Types</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <collectionReference>Get_Record_Type</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Lead_Record_Type_Ids</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Leads</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Over_Task_Lists</name>
        <label>Loop Over Task Lists</label>
        <locationX>182</locationX>
        <locationY>1176</locationY>
        <collectionReference>Get_Tasks</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Does_Task_Exist_for_the_Lead</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Remove_Lead_From_List_Of_Lead_Ids</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Email_Messages</name>
        <label>Get Email Messages</label>
        <locationX>50</locationX>
        <locationY>1884</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Empty_The_Lead_Need_To_Remove_List</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RelationObjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </filters>
        <filters>
            <field>RelationId</field>
            <operator>In</operator>
            <value>
                <elementReference>LeadIdList</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>EmailMessageRelation</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>RelationObjectType</queriedFields>
        <queriedFields>RelationId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Leads</name>
        <label>Get Leads</label>
        <locationX>182</locationX>
        <locationY>660</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Over_Lead_Ids</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>LeadCreatedDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>LeadLastModifiedDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>In</operator>
            <value>
                <elementReference>LeadRecordTypeIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>
            <numberValue>250.0</numberValue>
        </limit>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Lead_Status__c</queriedFields>
        <queriedFields>Core_Lead_Sub_Status__c</queriedFields>
        <queriedFields>Core_Lead_State__c</queriedFields>
        <queriedFields>Core_Lead_Notes__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Record_Type</name>
        <label>Get Record Type</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Over_Record_Types</targetReference>
        </connector>
        <filterLogic>1 AND ( 2 OR 3 )</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sales Lead</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Tasks</name>
        <label>Get Tasks</label>
        <locationX>182</locationX>
        <locationY>1068</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Over_Task_Lists</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>In</operator>
            <value>
                <elementReference>LeadIdList</elementReference>
            </value>
        </filters>
        <filters>
            <field>WhoId</field>
            <operator>In</operator>
            <value>
                <elementReference>LeadIdList</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Task</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>WhoId</queriedFields>
        <queriedFields>WhatId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Valid_Leads</name>
        <label>Get Valid Leads</label>
        <locationX>50</locationX>
        <locationY>2700</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>For_Each_Valid_Lead</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>LeadIdList</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Lead_Status__c</queriedFields>
        <queriedFields>Core_Lead_Sub_Status__c</queriedFields>
        <queriedFields>Core_Lead_State__c</queriedFields>
        <queriedFields>Core_Lead_Notes__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Leads_That_Needs_to_Update</name>
        <label>Update Leads That Needs to Update</label>
        <locationX>50</locationX>
        <locationY>3216</locationY>
        <inputReference>LeadRecordNeedToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Record_Type</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-02-04</startDate>
            <startTime>00:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>LeadIdList</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LeadNeedToRemove</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LeadRecordNeedToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>LeadRecordTypeIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>SingleLeadRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
</Flow>
