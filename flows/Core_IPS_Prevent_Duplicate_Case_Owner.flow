<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>Create_Unique_Owner_Group_Name</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Core_IPS_Case_Owner_Email__c}),TEXT(DATETIMEVALUE(NOW())) , {!$Record.Core_IPS_Case_Owner_Email__c})&amp; LEFT({!$Record.Core_IPS_Support_Org__c}, 15)</expression>
    </formulas>
    <interviewLabel>Core IPS Prevent Duplicate Case Owner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core IPS Prevent Duplicate Case Owner</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update Core_IPS_Unique_Owner_Group__c (Unique Owner Group)</description>
        <name>Populate_User_Id</name>
        <label>Populate User Id</label>
        <locationX>661</locationX>
        <locationY>408</locationY>
        <inputAssignments>
            <field>Core_IPS_Unique_Owner_Group__c</field>
            <value>
                <elementReference>Create_Unique_Owner_Group_Name</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>590</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Populate_User_Id</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedById</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Core_IPS_Case_Owner_Group__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
