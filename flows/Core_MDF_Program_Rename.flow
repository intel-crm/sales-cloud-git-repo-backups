<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Apply_Selected_Replacements</name>
        <label>Apply selected replacements</label>
        <locationX>176</locationX>
        <locationY>830</locationY>
        <actionName>Core_MDF_Program_Rename_ApplyAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Rename_Results</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>selectedItems</name>
            <value>
                <elementReference>SelectedItems</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>oldName</name>
            <value>
                <elementReference>OldProgramName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>newName</name>
            <value>
                <elementReference>NewProgramName</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Program_Rename_ApplyAction</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>ApplyResults</assignToReference>
            <name>results</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>ApplyUpdatedCount</assignToReference>
            <name>updatedCount</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>ApplyFailedCount</assignToReference>
            <name>failedCount</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>ApplyErrorMessage</assignToReference>
            <name>errorMessage</name>
        </outputParameters>
    </actionCalls>
    <actionCalls>
        <name>Scan_Selected_Metadata_Type</name>
        <label>Scan selected metadata type</label>
        <locationX>176</locationX>
