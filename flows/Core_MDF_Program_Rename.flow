        <actionName>Core_MDF_Program_Rename_ScanAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_Scan_Error</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>metadataType</name>
            <value>
                <elementReference>MetadataType</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>oldName</name>
            <value>
                <elementReference>OldProgramName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>newName</name>
            <value>
                <elementReference>NewProgramName</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Program_Rename_ScanAction</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>ScanItems</assignToReference>
            <name>items</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>ScanOccurrences</assignToReference>
            <name>occurrences</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>ScanCount</assignToReference>
            <name>itemCount</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>ScanErrorMessage</assignToReference>
            <name>errorMessage</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>RecordTypeChoice</name>
        <choiceText>Record Type</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>RecordType</stringValue>
        </value>
    </choices>
    <choices>
        <name>ValidationRuleChoice</name>
        <choiceText>Validation Rule</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>ValidationRule</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Check_Match_Count</name>
        <label>Check matching components</label>
        <locationX>176</locationX>
        <locationY>542</locationY>
        <defaultConnector>
            <targetReference>No_Matches</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No matches</defaultConnectorLabel>
        <rules>
            <name>Matches_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ScanCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Review_Matches</targetReference>
            </connector>
            <label>Matches found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Scan_Error</name>
        <label>Check scan error</label>
        <locationX>176</locationX>
        <locationY>446</locationY>
        <defaultConnector>
            <targetReference>Check_Match_Count</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No scan error</defaultConnectorLabel>
        <rules>
            <name>Scan_Failed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ScanErrorMessage</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Scan_Error</targetReference>
            </connector>
            <label>Scan failed</label>
        </rules>
    </decisions>
    <description>Scans the workbook-scoped RecordType or ValidationRule entries, previews selected components, requires confirmation, then applies and displays per-component results.</description>
    <environments>Default</environments>
    <interviewLabel>Core MDF Program Rename {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core MDF Program Rename</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Confirm_Updates</name>
        <label>Confirm metadata updates</label>
        <locationX>176</locationX>
        <locationY>734</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Apply_Selected_Replacements</targetReference>
        </connector>
        <fields>
            <name>ConfirmationText</name>
            <fieldText>&lt;p&gt;Confirm that you want to replace {!OldProgramName} with {!NewProgramName} in the selected components.&lt;/p&gt;&lt;p&gt;Click Submit to apply the updates.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Submit</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
