    <decisions>
        <name>CE_Record_status</name>
        <label>CE Record status</label>
        <locationX>996</locationX>
        <locationY>1055</locationY>
        <defaultConnector>
            <targetReference>Update_CE_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Inactive CE</defaultConnectorLabel>
        <rules>
            <name>Active_CE</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact_Entitlement_Records.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Complete</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contact_Entitlement_Records.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contact_Entitlement_Records.Core_Selected__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reg_Req_Subscription_Validation</targetReference>
            </connector>
            <label>Active CE</label>
        </rules>
    </decisions>
