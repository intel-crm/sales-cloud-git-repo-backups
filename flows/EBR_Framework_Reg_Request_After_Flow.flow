<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Verify_SourceType_For_Legal_Agreements</name>
        <label>Verify SourceType For Legal Agreements</label>
        <locationX>182</locationX>
        <locationY>600</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Record_for_Legal_Agreements</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PSG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Tend_Mgmt</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ALA_Association_creation</targetReference>
            </connector>
            <label>Valid Record for Legal Agreements</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Status_and_entitlement_details</name>
        <label>Verify Status and entitlement details</label>
        <locationX>380</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_and_entitlement_details</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Entitlement_Details__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Salesforce_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Contact_Creation</targetReference>
            </connector>
            <label>Status and entitlement details</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Status_and_entitlement_details1</name>
        <label>verify Status and entitlement details</label>
        <locationX>974</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_and_entitlement_details1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Entitlement_Details__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Salesforce_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_Data_Load_Object</targetReference>
            </connector>
            <label>Entitlement details</label>
        </rules>
    </decisions>
    <description>This flow triggers after New registration record is approved and it creates CBT  and Contacts.</description>
    <environments>Default</environments>
    <formulas>
        <name>singleLA</name>
        <dataType>String</dataType>
        <expression>TRIM(                                                                                                         
SUBSTITUTE(
LEFT( {!RegistrationRequestLAs} , FIND(&quot;;&quot;,  {!RegistrationRequestLAs} )),
&quot;;&quot;,                                                                                          
&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>Updated_RegistrationRequest_LAs</name>
        <dataType>String</dataType>
        <expression>MID({!RegistrationRequestLAs},FIND(&quot;;&quot;,
{!RegistrationRequestLAs})+1,LEN({!RegistrationRequestLAs})-
LEN(LEFT({!RegistrationRequestLAs}, FIND(&quot;;&quot;,{!RegistrationRequestLAs})))+1)</expression>
    </formulas>
    <interviewLabel>EBR Framework Reg Request After Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EBR Framework Reg Request After Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_Data_Load_Object</name>
        <label>get Data Load Object</label>
        <locationX>842</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Contact_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>createContact.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_AccountId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account_ID__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Reason__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Auto Grated IPA for DZP</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_Bulk_Data_Upload__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>551</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Verify_Status_and_entitlement_details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Source__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Create_IPA_Entitlements</name>
            <connector>
                <targetReference>Verify_Status_and_entitlement_details1</targetReference>
            </connector>
            <label>Create IPA Entitlements</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>InvalidDraft</status>
    <subflows>
