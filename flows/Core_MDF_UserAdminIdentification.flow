    <decisions>
        <name>To_check_is_user_is_user_admin</name>
        <label>To check is user is user admin</label>
        <locationX>646</locationX>
        <locationY>630</locationY>
        <defaultConnector>
            <targetReference>loop_over_pnums</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_user_is_user_admin</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Temp_PNUM.Core_MDF_User__r.Contact.Core_Audience_List__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>CCF User Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Temp_PNUM.Core_MDF_User__r.Contact.Core_Audience_List__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>DCF User Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Temp_PNUM.Core_MDF_User__r.Contact.Core_Audience_List__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>SPCF User Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Temp_PNUM.Core_MDF_User__r.Contact.Core_Audience_List__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CCF Boost User Administrator</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_users_from_pnum</targetReference>
            </connector>
            <label>If user is user admin</label>
        </rules>
