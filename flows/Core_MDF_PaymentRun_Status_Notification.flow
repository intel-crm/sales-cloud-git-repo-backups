    <decisions>
        <name>Core_MDF_For_sending_notification</name>
        <label>For sending notification</label>
        <locationX>449</locationX>
        <locationY>440</locationY>
        <defaultConnector>
            <targetReference>Verify_Status_changed_or_not</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Notifications_to_GSPO</name>
            <conditionLogic>1 AND 2 AND 3 AND ((4 AND 5 AND 6) OR (7 AND (8 OR 9)))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_PayRunStatus_Completed</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Send_Notification_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_RetailMDF_BudgetType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Geo_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Retail_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_IPA_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Geo_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Geo_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Geo_APJ</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Apex_Action_to_call_invocable_method_to_send_email_to_GSPO</targetReference>
            </connector>
            <label>Send Notifications to GSPO</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Status_changed_or_not</name>
        <label>Verify Status changed or not</label>
        <locationX>450</locationX>
        <locationY>691</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Status_changes_to_Completed_or_Error</name>
            <conditionLogic>1 AND (2 OR 3) AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_PayRunStatus_Completed</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_PayRunStatus_Error</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.Partner_License_Reclaimed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recipient_ID_Assignment</targetReference>
            </connector>
            <label>Status changes to &apos;Completed&apos; or &apos;Error&apos;</label>
        </rules>
    </decisions>
    <description>Send Emails to the Payment Owner when the Payment Run record&apos;s status gets updated to &apos;Error&apos; and &apos;Completed&apos;</description>
    <environments>Default</environments>
    <formulas>
        <name>RecipientIdValue</name>
        <dataType>String</dataType>
        <expression>{!$Record.OwnerId}</expression>
    </formulas>
    <interviewLabel>Core_MDF_PaymentRun_Status_Notifications {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_PaymentRun_Status_Notification</label>
