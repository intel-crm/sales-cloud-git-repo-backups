<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow to concatenate the address details on Address change</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Account_Address_ConcatenateFormula</name>
        <dataType>String</dataType>
        <expression>$Record.BillingStreet +&apos; &apos; +  $Record.BillingState +&apos; &apos; +  $Record.BillingCity + &apos; &apos; +  $Record.BillingCountry  +&apos; &apos; + $Record.BillingPostalCode</expression>
    </formulas>
    <interviewLabel>ACM_Core_Account_AddressConcatenate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ACM_Core_Account_AddressConcatenate</label>
    <migratedFromWorkflowRuleName>Core_Account_AddressConcatenate</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>To concatenate primary address into a field to check for duplicates</description>
        <name>Field_Update</name>
        <label>Field Update</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>Core_Address_Details__c</field>
            <value>
                <elementReference>Core_Account_Address_ConcatenateFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Field_Update</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.BillingStreet}) || ISCHANGED({!$Record.BillingState}) || ISCHANGED({!$Record.BillingCity}) ||  ISCHANGED({!$Record.BillingCountry})  ||  ISCHANGED({!$Record.BillingPostalCode})</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
