    <decisions>
        <name>Core_MDF_Check_if_Bank_Id_and_Status_Are_NOT_NULL</name>
        <label>Check if Bank Id and Status Are NOT NULL</label>
        <locationX>41</locationX>
        <locationY>190</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Creates_log_entry_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Check_if_BankId_and_Status_are_Not_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vBankId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vStatus</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Check_Status_Value</targetReference>
            </connector>
            <label>Check if BankId and Status are Not Blank</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_collClaimIds_Is_Not_Empty</name>
        <label>Check if collClaimIds Is Not Empty</label>
        <locationX>693</locationX>
        <locationY>13</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Check_Status_Value_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
