    <decisions>
        <name>Core_MDF_Check_Status_Value</name>
        <label>Check Status Value</label>
        <locationX>41</locationX>
        <locationY>389</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Create_log_entry_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Updated_to_ESD_Hold_or_AP_Hold_or_From_Initial_Draft_to_Draft</name>
            <conditionLogic>(3 AND ((1 AND 2) OR ((4 OR 8 OR 9) AND 5))) OR (6 AND 7)</conditionLogic>
            <conditions>
                <leftValueReference>vBankESDHoldPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankESDHoldValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankPriorStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Hold</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankPriorStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldPriorValue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Get_Hold_Record_Type</targetReference>
            </connector>
            <label>Updated to ESD Hold or AP Hold or From Initial Draft to Draft</label>
        </rules>
        <rules>
            <name>Core_MDF_Removed_from_ESD_Hold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vBankESDHoldPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankESDHoldValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_StoreClaimIdRelatedToActivity</targetReference>
            </connector>
            <label>Removed from ESD Hold</label>
        </rules>
        <rules>
            <name>Core_MDF_Removed_from_AP_Hold</name>
            <conditionLogic>1 AND (2 OR 3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>vBankAPHoldPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldValue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>StoreClaimId</targetReference>
            </connector>
            <label>Removed from AP Hold</label>
        </rules>
        <rules>
            <name>Core_MDF_Draft_to_Active</name>
            <conditionLogic>1 AND 2 AND ((3 AND 4) OR (5 AND 6) OR (7 AND 8))</conditionLogic>
            <conditions>
                <leftValueReference>vBankESDHoldValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankESDHoldPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldPriorValue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankAPHoldValue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_Active_RT</targetReference>
            </connector>
            <label>Draft to Active</label>
        </rules>
        <rules>
            <name>Core_MDF_Bank_updated_from_Inactive_to_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vBankPriorStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_Active_RT</targetReference>
            </connector>
            <label>Bank updated from Inactive to Active</label>
        </rules>
        <rules>
            <name>Bank_updated_from_Inactive_to_Draft</name>
            <conditionLogic>(1 AND (2 OR 3)) OR 4</conditionLogic>
            <conditions>
                <leftValueReference>vBankPriorStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hold</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Get_Hold_Record_Type</targetReference>
            </connector>
            <label>Bank updated from Inactive to Draft or Hold or directly to Inactive</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_Status_Value_1</name>
        <label>Check Status Value</label>
        <locationX>1069</locationX>
        <locationY>157</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Create_log_entry_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Status_Active</name>
