                <targetReference>Core_MDF_Send_the_sCollClaimId_to_specified_function</targetReference>
            </connector>
            <label>sCollClaimIds Is Not Empty</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_vRecordTypeId_is_Not_Blank</name>
