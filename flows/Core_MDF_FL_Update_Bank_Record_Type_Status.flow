    </formulas>
    <formulas>
        <description>This will contain the value of the Label Core_MDF_ESD_Hold.</description>
        <name>vESDHoldReason</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_ESD_Hold}</expression>
    </formulas>
