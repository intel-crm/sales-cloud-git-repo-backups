    <description>Send Notification Messages to Contacts when Account Owner is Changed</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>$Label.PRM_Msgcd_NewManager </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_6470035379</name>
        <dataType>String</dataType>
        <expression>{!$Label.PRM_Msgcd_NewManager}</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
NOT(ISNEW()),
ISCHANGED([Account].OwnerId ),
[Account].RecordType.DeveloperName = $Label.PRM_Intel_Account ,
[Account].Core_Intel_Partner_Alliance_PartnerGroup__c =true
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISNEW()),
ISCHANGED({!myVariable_current.OwnerId} ),
{!myVariable_current.RecordType.DeveloperName} = {!$Label.PRM_Intel_Account} ,
{!myVariable_current.Core_Intel_Partner_Alliance_PartnerGroup__c} =true
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
NOT(ISNEW()),
ISCHANGED([Account].OwnerId ),
[Account].RecordType.DeveloperName = $Label.PRM_Intel_Account ,
[Account].Core_Intel_Partner_Alliance_PartnerGroup__c =true
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1_pmetrule</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISNEW()),
ISCHANGED({!myVariable_old.OwnerId} ),
{!myVariable_old.RecordType.DeveloperName} = {!$Label.PRM_Intel_Account} ,
{!myVariable_old.Core_Intel_Partner_Alliance_PartnerGroup__c} =true
)</expression>
    </formulas>
