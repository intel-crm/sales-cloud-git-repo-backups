    <description>Notification Emails on Claim Status Changes. Cancel Adjustment Request when Adjustment Claim is Cancelled.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	OR(
	AND(ISCHANGED([PartnerFundClaim].Core_MDF_Status__c ),
	OR( ISCHANGED([PartnerFundClaim].Core_MDF_ESD_Hold__c), 
		ISCHANGED([PartnerFundClaim].Core_MDF_Payment_Hold_ind__c  ),
		ISCHANGED([PartnerFundClaim].Core_MDF_Criteria_Hold_Ind__c  ),
		ISCHANGED([PartnerFundClaim].Core_MDF_Intel_Manual_Hold_Ind__c  ),
		ISCHANGED([PartnerFundClaim].Core_MDF_Member_Manual_Hold_Ind__c  ) )),
	    ISNEW()
	), 
	
	(TEXT([PartnerFundClaim].Core_MDF_Status__c )=$Label.Core_MDF_Hold_Status),

	(TEXT([PartnerFundClaim].Status)=$label.Core_MDF_Status_Submitted), 

        (TEXT([PartnerFundClaim].Core_MDF_Type_Txt__c) &lt;&gt; $Label.Core_MDF_Claim_Adjustment_Type),
	
	OR( [PartnerFundClaim].Core_MDF_ESD_Hold__c, 
		[PartnerFundClaim].Core_MDF_Payment_Hold_ind__c,
		[PartnerFundClaim].Core_MDF_Criteria_Hold_Ind__c,
		[PartnerFundClaim].Core_MDF_Intel_Manual_Hold_Ind__c,
		[PartnerFundClaim].Core_MDF_Member_Manual_Hold_Ind__c) ,

	AND(
	(TEXT([PartnerFundClaim].Owner:User.UserType) != $Label.Core_MDF_Partner_User_Type), [PartnerFundClaim].Owner:User.IsActive ) 
	
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	OR(
	AND(ISCHANGED({!myVariable_current.Core_MDF_Status__c} ),
	OR( ISCHANGED({!myVariable_current.Core_MDF_ESD_Hold__c}), 
		ISCHANGED({!myVariable_current.Core_MDF_Payment_Hold_ind__c}  ),
		ISCHANGED({!myVariable_current.Core_MDF_Criteria_Hold_Ind__c}  ),
		ISCHANGED({!myVariable_current.Core_MDF_Intel_Manual_Hold_Ind__c}  ),
		ISCHANGED({!myVariable_current.Core_MDF_Member_Manual_Hold_Ind__c}  ) )),
	    ISNEW()
	), 
	
	(TEXT({!myVariable_current.Core_MDF_Status__c} )={!$Label.Core_MDF_Hold_Status}),

	(TEXT({!myVariable_current.Status})={!$label.Core_MDF_Status_Submitted}), 

        (TEXT({!myVariable_current.Core_MDF_Type_Txt__c}) &lt;&gt; {!$Label.Core_MDF_Claim_Adjustment_Type}),
	
	OR( {!myVariable_current.Core_MDF_ESD_Hold__c}, 
		{!myVariable_current.Core_MDF_Payment_Hold_ind__c},
		{!myVariable_current.Core_MDF_Criteria_Hold_Ind__c},
		{!myVariable_current.Core_MDF_Intel_Manual_Hold_Ind__c},
		{!myVariable_current.Core_MDF_Member_Manual_Hold_Ind__c}) ,

	AND(
	(TEXT({!myVariable_current.Owner:User.UserType}) != {!$Label.Core_MDF_Partner_User_Type}), {!myVariable_current.Owner:User.IsActive} ) 
	
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	OR(
	AND(ISCHANGED([PartnerFundClaim].Core_MDF_Status__c ),
	OR( ISCHANGED([PartnerFundClaim].Core_MDF_ESD_Hold__c), 
        ISCHANGED([PartnerFundClaim].Core_MDF_Payment_Hold_ind__c  ),
        ISCHANGED([PartnerFundClaim].Core_MDF_Criteria_Hold_Ind__c  ),
	ISCHANGED([PartnerFundClaim].Core_MDF_Intel_Manual_Hold_Ind__c  ),
	ISCHANGED([PartnerFundClaim].Core_MDF_Member_Manual_Hold_Ind__c  ))),
	       ISNEW()
	), 
	(TEXT([PartnerFundClaim].Core_MDF_Status__c )=$Label.Core_MDF_Hold_Status),

	(TEXT([PartnerFundClaim].Status)=$label.Core_MDF_Status_Submitted), 

        (TEXT([PartnerFundClaim].Core_MDF_Type_Txt__c)&lt;&gt; $Label.Core_MDF_Claim_Adjustment_Type),

	
	OR([PartnerFundClaim].Core_MDF_ESD_Hold__c, 
        [PartnerFundClaim].Core_MDF_Payment_Hold_ind__c,
        [PartnerFundClaim].Core_MDF_Criteria_Hold_Ind__c,
        [PartnerFundClaim].Core_MDF_Intel_Manual_Hold_Ind__c,
	[PartnerFundClaim].Core_MDF_Member_Manual_Hold_Ind__c) ,

	AND(
	(TEXT([PartnerFundClaim].Owner:User.UserType) = $Label.Core_MDF_Partner_User_Type),[PartnerFundClaim].Owner:User.Isactive
	) 
	
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	OR(
	AND(ISCHANGED({!myVariable_current.Core_MDF_Status__c} ),
	OR( ISCHANGED({!myVariable_current.Core_MDF_ESD_Hold__c}), 
        ISCHANGED({!myVariable_current.Core_MDF_Payment_Hold_ind__c}  ),
        ISCHANGED({!myVariable_current.Core_MDF_Criteria_Hold_Ind__c}  ),
	ISCHANGED({!myVariable_current.Core_MDF_Intel_Manual_Hold_Ind__c}  ),
