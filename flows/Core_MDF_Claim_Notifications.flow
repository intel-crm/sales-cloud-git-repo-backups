		OR(AND(ISCHANGED([PartnerFundClaim].Core_MDF_Status__c),TEXT([PartnerFundClaim].Core_MDF_Status__c ) =$Label.Core_MDF_Claim_Status_Pending_Documents),
		   AND(ISCHANGED([PartnerFundClaim].Core_MDF_Status__c),TEXT([PartnerFundClaim].Core_MDF_Status__c ) =$Label.Core_MDF_Claim_Status_PIC_Pending),
		   AND(ISCHANGED([PartnerFundClaim].Core_MDF_Status__c),TEXT([PartnerFundClaim].Core_MDF_Status__c ) =$Label.Core_MDF_Claim_Status_Resubmission_Required)),
		   AND(ISCHANGED([PartnerFundClaim].Core_MDF_Queued_Email_Sent_Ind__c),[PartnerFundClaim].Core_MDF_Queued_Email_Sent_Ind__c)),
		
		
		AND(NOT(ISCHANGED([PartnerFundClaim].Core_MDF_Status__c )),
			OR(
			AND(ISCHANGED([PartnerFundClaim].Core_MDF_Intel_Manual_Hold_Ind__c),[PartnerFundClaim].Core_MDF_Intel_Manual_Hold_Ind__c),
			AND(ISCHANGED([PartnerFundClaim].Core_MDF_Member_Manual_Hold_Ind__c),[PartnerFundClaim].Core_MDF_Member_Manual_Hold_Ind__c),
			AND(ISCHANGED([PartnerFundClaim].Core_MDF_ESD_Hold__c),[PartnerFundClaim].Core_MDF_ESD_Hold__c),
			AND(ISCHANGED([PartnerFundClaim].Core_MDF_Payment_Hold_ind__c),[PartnerFundClaim].Core_MDF_Payment_Hold_ind__c),
