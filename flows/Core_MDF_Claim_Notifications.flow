			AND(ISCHANGED([PartnerFundClaim].Core_MDF_Queued_Email_Sent_Ind__c),[PartnerFundClaim].Core_MDF_Queued_Email_Sent_Ind__c),
			
			OR((TEXT([PartnerFundClaim].Core_MDF_Status__c ) =$Label.Core_MDF_Claim_Status_Pending_Documents),
		   (TEXT([PartnerFundClaim].Core_MDF_Status__c ) =$Label.Core_MDF_Claim_Status_PIC_Pending),
		   (TEXT([PartnerFundClaim].Core_MDF_Status__c ) =$Label.Core_MDF_Claim_Status_Resubmission_Required)))
	),
