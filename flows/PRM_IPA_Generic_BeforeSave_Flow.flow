<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>if condition satisfied then - Prepopulate values in Company Name - English Language and Alternate Company Name Language fields if Company Name is in English Language</description>
        <name>PRM_Prepopulate_Values_in_Company_Name_English</name>
        <label>Prepopulate Values in Company Name - English</label>
        <locationX>983</locationX>
        <locationY>419</locationY>
        <assignmentItems>
            <assignToReference>$Record.PRM_Company_Nm_Eng__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PRM_Account_Name__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PRM_Alt_CompanyNameLang__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>ENG</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Check if company Name is Present and in English with allowed characters</description>
        <name>PRM_Check_if_company_Name_is_Present_and_in_English</name>
        <label>Check if company Name is Present and in English</label>
        <locationX>662</locationX>
        <locationY>412</locationY>
        <defaultConnectorLabel>If Company Name not in English</defaultConnectorLabel>
        <rules>
            <name>PRM_company_Name_is_Present_and_in_English</name>
            <conditionLogic>1 AND (2 OR 4) AND 3 AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Account_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Account_Name__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PRM_Is_Company_Name_English</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PRM_Account_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Account Create Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Salesforce_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PRM_Prepopulate_Values_in_Company_Name_English</targetReference>
            </connector>
            <label>company Name is Present and in English</label>
        </rules>
    </decisions>
    <description>This is a common IPA before save flow for fast field updates.</description>
    <environments>Default</environments>
    <formulas>
        <description>Allowed Characters - A-Z, a-z, 0-9, (()/@&amp;s*,#._-</description>
        <name>PRM_Is_Company_Name_English</name>
        <dataType>Boolean</dataType>
        <expression>REGEX($Record.PRM_Account_Name__c, &quot;^[a-zA-Z0-9()/\\@\\&amp;\\s\\*\\,\\#\\.\\_\\-]+$&quot;)</expression>
    </formulas>
    <interviewLabel>IPA_Generic_BeforeSave_Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>IPA_Generic_BeforeSave_FastFieldUpdate_Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>543</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>PRM_Check_if_company_Name_is_Present_and_in_English</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Channel_Program_Level_txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Partner Alliance</stringValue>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
