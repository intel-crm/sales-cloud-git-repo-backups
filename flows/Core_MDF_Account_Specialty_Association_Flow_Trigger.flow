            </connector>
            <label>opt is false</label>
        </rules>
    </decisions>
    <description>Account Specialty Association Flow Trigger
1. Added logic to sync mapped Account with PGM records.</description>
    <environments>Default</environments>
    <formulas>
        <description>Used to check the Inactive indicator value changed or not</description>
        <name>forB_InactiveValueChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.PRM_InActive_Ind__c})</expression>
    </formulas>
    <formulas>
        <description>Used to check the record is new or not</description>
        <name>forB_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>forT_SpecialityName</name>
        <dataType>String</dataType>
        <expression>{!$Record.PRM_Specialty_Id__r.Name}</expression>
    </formulas>
    <interviewLabel>Account Specialty Association Flow Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Specialty Association Flow Trigger</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Bypass_PGM_Sync</name>
        <label>Bypass PGM Sync</label>
        <locationX>842</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Bypass</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_MDF_BypassSpecialtyCheck</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Trigger_Executions__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_IPA_Benifites</name>
        <label>Get IPA Benifites</label>
        <locationX>314</locationX>
        <locationY>755</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Filter_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Program_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Partner Alliance</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_IsActive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Partner_Benefit__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>forT_SpecialityName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_BudgetType_Benefit_Mappings__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Opt_Account_Benefit_Assoc</name>
        <label>Opt Account Benefit Assoc</label>
        <locationX>578</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Opt_check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_MDF_OptAccountBenefitAssoc</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_Custom_Label_Configration__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>716</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Bypass_PGM_Sync</targetReference>
        </connector>
        <filterFormula>AND(
	{!$Record.PRM_Account_Id__r.RecordType.DeveloperName} == {!$Label.Core_MDF_Intel_Account_Record_Type_Developer_Name},
	NOT(ISBLANK({!$Record.PRM_Specialty_Id__c})),
	NOT(ISBLANK({!$Record.PRM_Specialty_Id__r.Name}))
)</filterFormula>
        <object>PRM_Account_Specialty_Association__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
