                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_ASA_Details_Update</targetReference>
            </connector>
            <label>Is Update?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opt_check</name>
        <label>Opt check</label>
        <locationX>578</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>opt_is_false</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Opt_Account_Benefit_Assoc.Core_MDF_Value_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>false</stringValue>
                </rightValue>
            </conditions>
            <connector>
