        <locationX>2074</locationX>
        <locationY>1214</locationY>
        <defaultConnector>
            <targetReference>Get_Locked_RectypeId</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Approval Scenario</defaultConnectorLabel>
        <rules>
            <name>Resubmitted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
