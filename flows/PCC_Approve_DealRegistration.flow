        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_deal_reg</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PCC_Registration_Type__c</leftValueReference>
