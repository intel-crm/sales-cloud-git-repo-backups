    <decisions>
        <name>Comments_Character_limit</name>
        <label>Comments Character limit</label>
        <locationX>2470</locationX>
        <locationY>1106</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>PCC_Deal_Approve_Exception</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Internal_comments_field_is_greater</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CommentsLength</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>20001.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Internal_Comments_Validation</targetReference>
            </connector>
            <label>Internal comments field is greater</label>
        </rules>
        <rules>
            <name>Internal_Comments_Lesser</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CommentsLength</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>20001.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Approval_Status</targetReference>
            </connector>
            <label>Internal Comments Lesser</label>
        </rules>
    </decisions>
