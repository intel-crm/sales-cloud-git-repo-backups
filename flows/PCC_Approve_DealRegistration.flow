    <decisions>
        <name>Past_date_present_on_deal</name>
        <label>Past date present on deal</label>
        <locationX>1788</locationX>
        <locationY>890</locationY>
        <defaultConnector>
            <targetReference>Commentssection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PastDateValidationString</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PastDateValidationString</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>End</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal accepted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Past_date_validation_screen</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Comments</name>
        <dataType>String</dataType>
        <expression>{!recordId.Core_Internal_Comment_Txt__c} &amp;BR()&amp; &apos;Approver Comments-&apos; &amp; {!approvercomments}</expression>
    </formulas>
    <formulas>
        <name>CommentsLength</name>
        <dataType>Number</dataType>
        <expression>LEN({!approvercomments})+{!LengthofInternalComments}+18</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>LengthofInternalComments</name>
        <dataType>Number</dataType>
        <expression>LEN({!recordId.Core_Internal_Comment_Txt__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PastDateValidationString</name>
        <dataType>String</dataType>
        <expression>IF ({!recordId.PCC_Pricing_End_Date__c} &lt; TODAY(),&apos;&lt;br/&gt;Pricing End Date&apos;,&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>PastStartDate</name>
        <dataType>String</dataType>
        <expression>IF ({!recordId.PCC_Pricing_Start_Date__c} &lt; TODAY(),&apos;&lt;br/&gt;Pricing Start Date&apos;,&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>userId</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!$User.Id})</expression>
    </formulas>
    <formulas>
        <name>When</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>PCC_Approve DealRegistration {!$Flow.CurrentDateTime}</interviewLabel>
