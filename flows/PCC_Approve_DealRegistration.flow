            </connector>
            <label>Resubmitted?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_EndCustomer_Account</name>
        <label>Check EndCustomer Account</label>
        <locationX>340</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Get_Inactive_LOV_Values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>End_Customer_Account_is_not_Intel_Account</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_End_Customer_Account_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Core_End_Customer_Account_RecordType__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Intel Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Core_End_Customer_Account_RecordType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>End_Customer_Account_Validation</targetReference>
            </connector>
            <label>End Customer Account is not Intel Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_pending_DRP</name>
        <label>Check for pending DRP</label>
        <locationX>1315</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>Past_date_present_on_deal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Deal_has_Pending_DRP_s</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Pending_Product_Cnt__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Disposition_Products_Screen</targetReference>
            </connector>
            <label>Deal has Pending DRP&apos;s</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_User_is_Authorized_to_approve_deal</name>
        <label>Check if User is Authorized to approve deal</label>
        <locationX>2087</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Un_authorized_error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Authorized</defaultConnectorLabel>
        <rules>
            <name>Authorized_to_approve_deal</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>userId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>recordId.Core_Accepted_By_Id__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>userId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>recordId.Core_Accepted_By_Id__r.DelegatedApproverId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.PCC_Deal_Reg_Internal_Admin_Custom</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_EndCustomer_Account</targetReference>
            </connector>
            <label>Authorized to approve deal</label>
        </rules>
    </decisions>
