<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>This method is called from scheduled Flow that will freeze the user records that have been inactive from past 6 months (as defined in custom label)
and belog to specific profiles (as defined in custom label)</description>
        <name>Apex_Method_to_Freeze_Users</name>
        <label>Apex Method to Freeze Users</label>
        <locationX>670</locationX>
        <locationY>327</locationY>
        <actionName>Core_UserHandler</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>Core_UserHandler</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow will freeze the user records that have been inactive from past 6 months (as defined in custom label: Core_UserFreezingDaysOffset)
and belong to specific profiles (as defined in custom label: Core_ProfileForFreezingUsers)</description>
    <environments>Default</environments>
    <interviewLabel>User Freezing for Last Login {!$Flow.CurrentDateTime}</interviewLabel>
    <label>User Freezing for Last Login</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>544</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Apex_Method_to_Freeze_Users</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2022-06-02</startDate>
            <startTime>23:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
