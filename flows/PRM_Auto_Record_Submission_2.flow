    <description>Migrated from the PRM_Auto_Record_Submission process using multiple criteria.
Used for the Manual Approval Process</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR({!$Record.RecordType.DeveloperName} =  &apos;Add_Membership_Request&apos;, {!$Record.RecordType.DeveloperName} =&apos;Add_Contact_Request&apos;, {!$Record.RecordType.DeveloperName} =&apos;Account_Create_Request&apos;),{!$Record.PRM_isSubmitted__c==False} ,
{!$Record.PRM_Auto_Approve__c} ==False,{!$Record.PRM_Channel_Program_Level_txt__c} =  &apos;Intel Partner Alliance&apos;,ISBLANK({!$Record.Entitlement_Details__c}))</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!$Record.PRM_Status__c} ) ,ISPICKVAL({!$Record.PRM_Status__c} , &quot;Approved&quot;), 
({!$Record.RecordType.DeveloperName}  &lt;&gt; &quot;Admin_Registration&quot;),
{!$Record.PRM_TriggerProcess__c} = False,{!$Record.PRM_Auto_Approve__c} =False,
ISBLANK({!$Record.Entitlement_Details__c}),{!$Record.PRM_Channel_Program_Level_txt__c} &lt;&gt; &quot;PSG&quot;)</expression>
    </formulas>
    <label>PRM_Auto_Record_Submission_2</label>
