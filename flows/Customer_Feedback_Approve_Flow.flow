    <decisions>
        <name>Check_for_stage</name>
        <label>Check for stage</label>
        <locationX>660</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Assign_CF_record_to_CFList</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Country_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_through_CF_records.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Country Manager</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Country_Manager_Feedback</targetReference>
            </connector>
            <label>Country Manager</label>
        </rules>
        <rules>
            <name>GM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_through_CF_records.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>GM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GM_Feedback</targetReference>
            </connector>
            <label>GM</label>
        </rules>
        <rules>
            <name>DR_VP</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>loop_through_CF_records.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loop_through_CF_records.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>VP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>VP_Feedback</targetReference>
            </connector>
            <label>DR/VP</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_IF_Customer_Feedback_CM_GM_VP_is_Approved</name>
        <label>Check IF Customer Feedback CM/GM/VP is Approved</label>
        <locationX>3564</locationX>
        <locationY>1490</locationY>
        <defaultConnector>
            <targetReference>Assign_AF_TO_AFList</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_CM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_CFList.CM_Feedback__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CM_in_Account_Feedback</targetReference>
            </connector>
            <label>Check if CM</label>
        </rules>
        <rules>
            <name>Check_IF_GM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_CFList.GM_Feedback__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_GM_in_Account_Feedback</targetReference>
            </connector>
            <label>Check IF GM</label>
        </rules>
        <rules>
            <name>Check_IF_DR_VP</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_CFList.VP_Feedback__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_VP_in_Account_Feedback</targetReference>
            </connector>
            <label>Check IF DR/VP</label>
        </rules>
    </decisions>
