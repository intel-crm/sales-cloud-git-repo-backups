            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Contact_Salesforce_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Contact_Salesforce_Id__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_DuplicateRegistration_Records.PRM_Contact_Salesforce_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_IsDuplicate_is_True</targetReference>
