    <decisions>
        <name>Check_Approval_Validation</name>
        <label>Check Approval Validation</label>
        <locationX>380</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>Check_if_Language_is_Empty</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_Valid_for_Approval</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PSG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_EmailVerifiedDateTime__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IQR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Entitlement_Details__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Get_Account_Change_Request_Record_Type_Name</targetReference>
            </connector>
            <label>Record Valid for Approval</label>
        </rules>
        <rules>
            <name>IQR_Assign_Entitlement_Detail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IQR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Entitlement_Details__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Account_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_IQR_Matrix_Record_by_Account</targetReference>
            </connector>
            <label>IQR Assign Entitlement Detail</label>
        </rules>
    </decisions>
