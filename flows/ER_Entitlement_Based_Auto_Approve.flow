    <formulas>
        <name>last1Day</name>
        <dataType>Date</dataType>
        <expression>TODAY() -1</expression>
    </formulas>
    <formulas>
        <name>one_Response</name>
        <dataType>String</dataType>
        <expression>TRIM(                                                                                                         
SUBSTITUTE(
LEFT({!profile_Response} , FIND(&quot;}&quot;,  {!profile_Response})),
&quot;}&quot;,                                                                                          
&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>questioncodeF</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT((LEFT({!singleResponse}, FIND(&quot; | &quot;,{!singleResponse}))),(LEN((LEFT({!singleResponse}, FIND(&quot; | &quot;,{!singleResponse}))))-(LEN({!$Label.PRM_QuestionCode})+1))))</expression>
    </formulas>
    <formulas>
        <name>responseValueF</name>
        <dataType>String</dataType>
        <expression>TRIM(SUBSTITUTE(REVERSE(LEFT(REVERSE({!singleResponse}),FIND(&quot;:&quot;, REVERSE({!singleResponse})))),&quot;:&quot;,&quot; &quot;))</expression>
    </formulas>
    <formulas>
        <name>sixhrsago</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - (6/24)</expression>
    </formulas>
    <formulas>
        <name>Updated_RegistrationRequest_LAs</name>
        <dataType>String</dataType>
        <expression>MID({!profile_Response},FIND(&quot;}&quot;,
{!profile_Response})+1,LEN({!profile_Response})-
LEN(LEFT({!profile_Response}, FIND(&quot;}&quot;,{!profile_Response})))+1)</expression>
    </formulas>
