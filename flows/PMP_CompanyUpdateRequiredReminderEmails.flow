        <name>Is_10_Day_s_Update_Required_Reminder_Emails_Sent_to_Company</name>
        <label>Is 10 Day(s) &apos;Update Required&apos; Reminder Emails Sent to Company ?</label>
        <locationX>710</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Entry_Criteria_10_Day_s_Company_Update_Required_Reminder_Emails</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMP_Company_Lifecycle_Status_Nm__c</leftValueReference>
