<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Log</name>
        <label>Assign Log</label>
        <locationX>314</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Origin__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>SWS: Lead Creation Through Credit Request</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Details__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Message__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Error while lead creating/updating lead</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_sObjectId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_sObjectType__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>SWS_Cloud_Credit_Request__c</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_When__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Severity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Log</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Create_Lead</name>
        <label>Create Lead</label>
        <locationX>578</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>NewLead.Email</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.SWS_Email__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.FirstName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.SWS_First_Name__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.LastName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.SWS_Last_Name__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LeadRecordType</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Marketing Qualified Lead</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.Title</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.SWS_Job_Title__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.Core_Product_Interest__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.SWS_HW_Compute_Platform_PL__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.Company</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>RequestTypeFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.Country</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Country_Code_Stored</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.Core_Lead_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewLead.LeadSource</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>IDC Credit Request</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Lead_Record</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Capture_Fault</name>
        <label>Capture Fault</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>Assign_Log</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>{!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Set_Lead_Based_on_Outcomes</name>
        <label>Set Lead Based on Outcomes</label>
        <locationX>710</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Sync_Lead_With_Credit_Request</name>
            <conditionLogic>1 AND 2 AND (3 OR 4 OR 5 OR 6 OR 7 OR 8 OR 9 OR 10 OR 11)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SWS_Lead__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Create_Lead__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_First_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.SWS_First_Name__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Last_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.SWS_Last_Name__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Email__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.SWS_Email__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Company_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.SWS_Company_Name__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Request_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.SWS_Request_Type__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Job_Title__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.SWS_Job_Title__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.SWS_HW_Compute_Platform_PL__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SWS_HW_Compute_Platform_PL__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Request_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.SWS_Request_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Country__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.SWS_Country__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sync_Up_Lead_With_Credit_Request</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Sync Lead With Credit Request</label>
        </rules>
        <rules>
            <name>Create_New_Lead_Record</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SWS_Create_Lead__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Lead__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.SWS_Lead__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SWS_Lead__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Lead__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bypass_Validation</targetReference>
            </connector>
            <label>Create New Lead Record</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>RequestTypeFormula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.SWS_Request_Type__c}) = &quot;Intel_Internal_Use&quot;,
&quot;Intel internal use – one-time or ongoing use for internal development and research projects&quot;,
IF(TEXT({!$Record.SWS_Request_Type__c}) = &quot;External_Customer&quot;,
{!$Record.SWS_Company_Name__c},
IF(TEXT({!$Record.SWS_Request_Type__c}) = &quot;Research_and_education&quot;,
&quot;Research and education – ongoing use by participants of an Intel research and education community outreach program.&quot;,
IF(TEXT({!$Record.SWS_Request_Type__c}) = &quot;One_time_external_event&quot;,
&quot;One-time external event – one-time use by participants attending an Intel community or customer outreach event (e.g., workshop, training, or hackathon).&quot;,&quot; &quot;))))</expression>
    </formulas>
    <formulas>
        <name>SalesQualifiedLeadCriterion</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!$Record.SWS_Request_Type__c}) = &quot;Intel_Internal_Use&quot; &amp;&amp;
TEXT({!$Record.SWS_Request_Status__c}) = &quot;Coupon_Generated&quot;,
&quot;Qualified&quot;, TEXT({!$Record.SWS_Lead__r.Status}))</expression>
    </formulas>
    <interviewLabel>SWS: Lead Creation Through Credit Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SWS: Lead Creation Through Credit Request</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Lead_Record</name>
        <label>Create Lead Record</label>
        <locationX>578</locationX>
        <locationY>863</locationY>
        <connector>
            <targetReference>Update_Lead_Id_on_Credit_Request_Record</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <inputReference>NewLead</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_Log</name>
        <label>Create Log</label>
        <locationX>314</locationX>
        <locationY>863</locationY>
        <inputReference>LogEntry</inputReference>
    </recordCreates>
    <recordLookups>
        <name>getRecordTypeOfLead</name>
        <label>getRecordTypeOfLead</label>
        <locationX>578</locationX>
        <locationY>647</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Lead</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </filters>
        <object>RecordType</object>
        <outputAssignments>
            <assignToReference>LeadRecordType</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Picklist</name>
        <label>Picklist</label>
        <locationX>710</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Lead_Based_on_Outcomes</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EntityParticleId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>entityID</elementReference>
            </value>
        </filters>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SWS_Country__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PicklistValueInfo</object>
        <outputAssignments>
            <assignToReference>Country_Code_Stored</assignToReference>
            <field>Value</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Bypass_Validation</name>
        <label>Bypass Validation</label>
        <locationX>578</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>getRecordTypeOfLead</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Bypass__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Bypass__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>SWS_Bypass_Validation_Rule__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Reactivate_the_validation</name>
        <label>Reactivate the validation</label>
        <locationX>578</locationX>
        <locationY>1079</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Bypass__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Bypass__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>SWS_Bypass_Validation_Rule__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Sync_Up_Lead_With_Credit_Request</name>
        <label>Sync Up Lead With Credit Request</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Company</field>
            <value>
                <elementReference>RequestTypeFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Product_Interest__c</field>
            <value>
                <elementReference>$Record.SWS_HW_Compute_Platform_PL__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Country</field>
            <value>
                <elementReference>Country_Code_Stored</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email</field>
            <value>
                <elementReference>$Record.SWS_Email__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <elementReference>$Record.SWS_First_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>$Record.SWS_Last_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Title</field>
            <value>
                <elementReference>$Record.SWS_Job_Title__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.SWS_Lead__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Lead_Id_on_Credit_Request_Record</name>
        <label>Update Lead Id on Credit Request Record</label>
        <locationX>578</locationX>
        <locationY>971</locationY>
        <connector>
            <targetReference>Reactivate_the_validation</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>SWS_Lead__c</field>
            <value>
                <elementReference>NewLead.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>584</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Picklist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SWS_Create_Lead__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>SWS_Cloud_Credit_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>Country_Code_Stored</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>entityID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Lead.Address.CountryCode</stringValue>
        </value>
    </variables>
    <variables>
        <name>LeadRecordType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LogEntry</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Core_Log_Entry__c</objectType>
    </variables>
    <variables>
        <name>NewLead</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
