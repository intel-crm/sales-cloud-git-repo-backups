<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Redirect_to_New_Case</name>
        <label>Redirect to New Case</label>
        <locationX>248</locationX>
        <locationY>1574</locationY>
        <actionName>c:navigateToUrl</actionName>
        <actionType>component</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>redirectURL</name>
            <value>
                <elementReference>redirectUrlCase</elementReference>
            </value>
        </inputParameters>
        <nameSegment>c:navigateToUrl</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_localExternalId_to_recordId</name>
        <label>Set localExternalId to recordId</label>
        <locationX>50</locationX>
        <locationY>542</locationY>
        <assignmentItems>
            <assignToReference>localExternalAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Screen_Create_a_Service_Cloud_Case_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_New_Case_Values</name>
        <label>Set New Case Values</label>
        <locationX>248</locationX>
        <locationY>1250</locationY>
        <assignmentItems>
            <assignToReference>newCase.RecordTypeId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>caseRecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.AccountId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>serviceAccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedContact</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Product__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedProduct</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Description__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>updatedDescription</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Origin__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Subject__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>enteredSubject</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Case</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Any_Accounts</name>
        <label>Any Accounts?</label>
        <locationX>446</locationX>
        <locationY>650</locationY>
        <defaultConnector>
            <targetReference>Screen_Create_a_Service_Cloud_Case_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes, Account</defaultConnectorLabel>
        <rules>
            <name>No_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>localExternalAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>No Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_xID_passed_in</name>
        <label>Check if xID passed in</label>
        <locationX>248</locationX>
        <locationY>434</locationY>
        <defaultConnector>
            <targetReference>Determine_Service_Cloud_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Account ID</defaultConnectorLabel>
        <rules>
            <name>Yes_External_Acct_ID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>x</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_localExternalId_to_recordId</targetReference>
            </connector>
            <label>Yes, External Acct ID</label>
        </rules>
    </decisions>
    <decisions>
        <name>Debug_Mode_1</name>
        <label>Debug Mode?</label>
        <locationX>248</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Check_if_xID_passed_in</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Debug_Mode_ON_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>debugMode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Entered_the_flow</targetReference>
            </connector>
            <label>Debug Mode ON</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>Contact_Choice_Set</name>
        <dataType>String</dataType>
        <displayField>Name__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>serviceAccountId</elementReference>
            </value>
        </filters>
        <object>Contact__x</object>
        <sortField>Name__c</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>ExternalId</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>Product_Choice_Set</name>
        <dataType>String</dataType>
        <displayField>Name__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name__c</field>
            <operator>Contains</operator>
            <value>
                <elementReference>enteredProductSearchText</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>VPH_Nav_c__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Case_Visible_c__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Product2__x</object>
        <sortField>Name__c</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>ExternalId</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>redirectUrlCase</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;.my.&quot;, {!$Api.Partner_Server_URL_540}) - 1) &amp; &quot;.lightning.force.com/lightning/r/Case__x/&quot; &amp; {!newCase.Id} &amp; &quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>updatedDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Case created from SALES CLOUD by &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot; (&quot; &amp; {!$User.Email} &amp; &quot;, WWID: &quot; &amp; {!$User.Core_WWID__c} &amp; &quot;)&quot; &amp; BR() &amp; BR() &amp; &quot;Entered Description:&quot; &amp; BR() &amp; {!enteredDescription}</expression>
    </formulas>
    <interviewLabel>Case - Create Service Cloud Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - Create Service Cloud Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
