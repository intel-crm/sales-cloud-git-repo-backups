    <decisions>
        <name>Delink_In_progress</name>
        <label>Delink In progress?</label>
        <locationX>1018</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Does_account_have_OPID</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Delink_is_in_Progress</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_Inbound.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>inprogress_error</targetReference>
            </connector>
            <label>Delink is in Progress</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_account_have_OPID</name>
        <label>Does account have OPID?</label>
        <locationX>1986</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>No_Opid_error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_has_opid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_IPA_One_Partner_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Cag_records_for_Opid</targetReference>
            </connector>
            <label>Account has OPID</label>
        </rules>
    </decisions>
    <decisions>
        <name>Get_Cag_of_account</name>
        <label>Get Cag of account</label>
        <locationX>2668</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Loop_cag_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>matching_Cag</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_cag_records.Core_Business_Party_Id__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>recordId.Core_Business_Party_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>is_Primary_Account</targetReference>
            </connector>
            <label>matching Cag</label>
        </rules>
    </decisions>
    <decisions>
        <name>is_Primary_Account</name>
        <label>is Primary Account</label>
        <locationX>2338</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>Validation_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>true</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_cag_records.Primary_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_List</targetReference>
            </connector>
            <label>true</label>
        </rules>
    </decisions>
    <description>Flow to create inbound for delinking an account</description>
    <environments>Default</environments>
    <formulas>
        <name>opid_number</name>
        <dataType>Number</dataType>
        <expression>VALUE({!Loop_cag_records.Core_Partner_Account_Id__r.Core_OnePartnerID__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>unifiedId</name>
        <dataType>Number</dataType>
        <expression>VALUE({!recordId.Core_Business_Party_Id__c})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Delink Account {!$Flow.CurrentDateTime}</interviewLabel>
