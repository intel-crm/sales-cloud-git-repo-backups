    <decisions>
        <name>Check_if_Owner_Change</name>
        <label>Check if Owner Change</label>
        <locationX>698</locationX>
        <locationY>301</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Checking_Parent_Fund_Account_Record_Type_to_Update_Ultimate_account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Owner_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Core_MDF_CCP_Budget_Administrator</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Owner</targetReference>
            </connector>
            <label>If Owner Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Checking_Parent_Fund_Account_Record_Type_to_Update_Ultimate_account</name>
        <label>Checking Parent Fund Account Record Type to Update Ultimate account</label>
        <locationX>703</locationX>
        <locationY>475</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_RT_is_Co_Marketing_and_Parent_Fund_Account_s_RT_is_Intel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Intel_Account_Record_Type_Developer_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Set_account_field_values</targetReference>
            </connector>
            <label>If RT is Co-Marketing and Parent Fund Account&apos;s RT is Intel</label>
        </rules>
        <rules>
            <name>if_RT_is_Co_Marketing_and_Parent_Fund_Account_s_RT_is_Co_Marketing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Set_account_field_values_0</targetReference>
            </connector>
            <label>if RT is Co-Marketing and Parent Fund Account&apos;s RT is Co-Marketing</label>
        </rules>
    </decisions>
