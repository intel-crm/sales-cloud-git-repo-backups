        </outputParameters>
    </actionCalls>
    <apiVersion>50.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>add_claim_batc_rec_to_a_list</name>
        <label>add claim batc rec to a list</label>
        <locationX>667</locationX>
        <locationY>456</locationY>
        <assignmentItems>
            <assignToReference>claimBatchRecordList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>get_claim_batch_records_from_claim_batch</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>null_check</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Adding_claim_batch_record_in_a_list</name>
        <label>Adding claim batch record in a list</label>
        <locationX>779</locationX>
        <locationY>243</locationY>
        <assignmentItems>
            <assignToReference>ClaimBatchRecToBeUpdated</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>get_claim_batch_record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>null_check_for_claim_batch_record_list</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>check_claim_batch_record_is_not_null</name>
        <label>check claim batch record is not null</label>
        <locationX>560</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>No_failed_records_for_retry_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If it is null</defaultConnectorLabel>
        <rules>
            <name>if_it_is_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_claim_batch_record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Adding_claim_batch_record_in_a_list</targetReference>
            </connector>
            <label>if it is not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_for_failed_records</name>
        <label>check for failed records</label>
        <locationX>355</locationX>
        <locationY>450</locationY>
        <defaultConnector>
            <targetReference>No_failed_records_for_retry</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_there_are_any_failed_records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_claim_batch_records_from_claim_batch</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>add_claim_batc_rec_to_a_list</targetReference>
            </connector>
            <label>if there are any failed records</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_record_ID</name>
        <label>check record ID</label>
        <locationX>158</locationX>
        <locationY>237</locationY>
        <defaultConnector>
            <targetReference>get_claim_batch_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If it is claim batch  Record Id</defaultConnectorLabel>
        <rules>
            <name>If_it_is_claim_batch_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>a4O</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_claim_batch_records_from_claim_batch</targetReference>
            </connector>
            <label>If it is claim batch Id</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_the_return_value</name>
        <label>check the return value</label>
        <locationX>969</locationX>
        <locationY>472</locationY>
        <defaultConnector>
            <targetReference>Error_message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If value is false</defaultConnectorLabel>
        <rules>
            <name>if_value_is_true</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>UpdateStageRecords</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_success_message_to_user</targetReference>
            </connector>
            <label>if value is true</label>
        </rules>
    </decisions>
    <decisions>
        <name>null_check</name>
        <label>null check</label>
        <locationX>657</locationX>
        <locationY>657</locationY>
        <defaultConnector>
            <targetReference>No_failed_records_for_retry</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>if it is null</defaultConnectorLabel>
        <rules>
            <name>if_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>claimBatchRecordList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Validation_On_Insert</targetReference>
            </connector>
            <label>if list is not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>null_check_for_claim_batch_record_list</name>
        <label>null check for claim batch record list</label>
        <locationX>767</locationX>
        <locationY>67</locationY>
        <defaultConnector>
            <targetReference>No_failed_records_for_retry_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If it is null</defaultConnectorLabel>
        <rules>
            <name>If_list_is_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimBatchRecToBeUpdated</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>validate_on_insert</targetReference>
            </connector>
            <label>If list is not null</label>
        </rules>
    </decisions>
    <description>This will again submit claim batch record for retry.</description>
    <interviewLabel>Retry Claim Batch Records {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Retry Claim Batch Records</label>
    <processMetadataValues>
