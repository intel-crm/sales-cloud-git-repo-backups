<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>If_No_EAM_Exist_Throw_Error</name>
        <label>If No EAM Exist Throw Error</label>
        <locationX>411</locationX>
        <locationY>170</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Submit_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Display_Error_to_create_EAM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Exception_Account_Mapping</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_No_EAM_Exist_Error</targetReference>
            </connector>
            <label>Display Error to create EAM</label>
        </rules>
    </decisions>
    <description>Submit exception for approval and validate exception account mapping</description>
    <environments>Default</environments>
    <interviewLabel>Submit Exception For Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Submit Exception For Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_NEW_EAM</name>
        <label>Create EAM</label>
        <locationX>566</locationX>
        <locationY>519</locationY>
        <connector>
            <targetReference>FInal_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Display_Error_on_Creation</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_MDF_Account_id__c</field>
            <value>
                <elementReference>AccountID.recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_Exception_id__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <object>Core_MDF_Exception_Account_Mapping__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get all the active exception account mapping</description>
        <name>Get_Exception_Account_Mapping</name>
        <label>Get Exception Account Mapping</label>
        <locationX>259</locationX>
        <locationY>162</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_No_EAM_Exist_Throw_Error</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Exception_id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Active_ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Exception_id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_MDF_Exception_Account_Mapping__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Exception_status_to_Pending_Review</name>
        <label>Update Exception status to Pending Review</label>
        <locationX>676</locationX>
        <locationY>174</locationY>
        <faultConnector>
            <targetReference>Display_Unknown_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Exception_Status_nm__c</field>
            <value>
                <stringValue>Pending Review</stringValue>
            </value>
        </inputAssignments>
        <object>Core_MDF_Exception__c</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <description>Show screen when user clicks on submit for approval button</description>
        <name>Core_MDF_Submit_Screen</name>
