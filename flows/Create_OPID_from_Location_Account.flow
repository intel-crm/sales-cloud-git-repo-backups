    <recordCreates>
        <name>Create_OPID</name>
        <label>Create OPID</label>
        <locationX>300</locationX>
        <locationY>350</locationY>
        <assignRecordIdToReference>opid</assignRecordIdToReference>
        <connector>
            <targetReference>Populate_cag_fields</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_OnePartnerID__c</field>
            <value>
