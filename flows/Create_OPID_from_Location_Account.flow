    <environments>Default</environments>
    <formulas>
        <name>OnePartnerIdFormula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
SUBSTITUTE(
TEXT(( NOW()  - DATETIMEVALUE( &quot;1970-01-01 00:00:00&quot; ))  * 86400),
&apos;,&apos;,&apos;&apos;
),
&apos;.&apos;,&apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>opidUrl</name>
        <dataType>String</dataType>
        <expression> LEFT({!$Api.Partner_Server_URL_260}, FIND( &apos;/services&apos;, {!$Api.Partner_Server_URL_260})) &amp; {!opid}</expression>
    </formulas>
    <interviewLabel>Create OPID from Location Account {!$Flow.CurrentDateTime}</interviewLabel>
