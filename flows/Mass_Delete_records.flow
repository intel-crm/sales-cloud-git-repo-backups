    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_record_Count</name>
        <label>Assign record Count</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <assignmentItems>
            <assignToReference>recordCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>ids</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>How_many_records_were_selected</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Object_Type</name>
        <label>Check Object Type</label>
        <locationX>710</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CMF_Association</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>firstrecordofList</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.ER_CMFAssociation_ObjectIdPrefix</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Query_CMF_Assoc_Records</targetReference>
            </connector>
            <label>CMF Association</label>
        </rules>
        <rules>
            <name>Contact_Association</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>firstrecordofList</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.ER_ContactAssociation_ObjectIdPrefix</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Query_Contact_Assoc_Records</targetReference>
            </connector>
            <label>Contact Association</label>
        </rules>
        <rules>
            <name>Account_Business_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>firstrecordofList</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.ER_AccountBusinessPartner_ObjectId_Prefix</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Query_Account_Business_Partner_Records</targetReference>
            </connector>
            <label>Account Business Partner</label>
        </rules>
    </decisions>
    <decisions>
        <name>Copy_1_of_How_many_records_were_selected</name>
        <label>Copy 1 of How many records were selected</label>
        <locationX>710</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>Success_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>More than one</defaultConnectorLabel>
        <rules>
            <name>Equal_to_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Success_Message</targetReference>
            </connector>
            <label>Equal to 1</label>
        </rules>
    </decisions>
    <decisions>
        <name>How_many_records_were_selected</name>
        <label>How many records were selected</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Check_Object_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>More than zero</defaultConnectorLabel>
        <rules>
            <name>Equal_to_zero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Failure</targetReference>
            </connector>
            <label>Equal to zero</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>currentDateTime</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>firstrecordofList</name>
        <dataType>String</dataType>
        <expression>LEFT({!ids}, 4)</expression>
    </formulas>
