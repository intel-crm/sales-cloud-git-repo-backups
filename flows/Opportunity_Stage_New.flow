<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>When all won products are set back to pending and the stage is not &quot;Design&quot;, set the stage back to &quot;Design&quot;.</description>
        <name>Check_Core_Opp_All_Products_Pending</name>
        <label>Core_Opp_All_Products_Pending</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Core_Opp_Capture_Prior_Opportunity_for_Lost_Opptys</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IF_Core_Opp_All_Products_Pending</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4 AND 5  AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Qualify</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Won_Product_Count__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Won_Product_Count__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Pending_Product_Count__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Core_Won_Product_Count__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_IsLowTouchAdmin_Chk__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Stage_Design</targetReference>
            </connector>
            <label>If Core_Opp_All_Products_Pending</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_Opp_Capture_Prior_Opportunity_for_Lost_Opptys</name>
        <label>Core_Opp_Capture_Prior_Opportunity_for_Lost_Opptys</label>
        <locationX>182</locationX>
        <locationY>623</locationY>
        <defaultConnector>
            <targetReference>Core_Opp_Clear_Loss_Cancel_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Core_Opp_Capture_Prior_Opportunity_for_Lost_Opptys</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Prior_Lost_Opportunity_Stage</targetReference>
            </connector>
            <label>If Core_Opp_Capture_Prior_Opportunity_for_Lost_Opptys</label>
        </rules>
    </decisions>
    <decisions>
        <description>Clears the Loss/Cancel Details text field if the Opportunity is changed from Lost or Cancelled to a stage other than Lost or Cancelled</description>
        <name>Core_Opp_Clear_Loss_Cancel_Details</name>
        <label>Core_Opp_Clear_Loss_Cancel_Details</label>
        <locationX>182</locationX>
        <locationY>923</locationY>
        <defaultConnector>
            <targetReference>Core_Opp_EntryStageValue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Core_Opp_Clear_Loss_Cancel_Details</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4) AND (NOT(5 OR 6 OR 7 OR 8) ) AND 9</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loss_Cancel_Details_NULL</targetReference>
            </connector>
            <label>If Core_Opp_Clear_Loss_Cancel_Details</label>
        </rules>
    </decisions>
    <decisions>
        <description>The &quot;Opportunity Entry Stage&quot; field should capture the first value assigned to the opportunity &quot;Stage&quot; when an opportunity is first opened.</description>
        <name>Core_Opp_EntryStageValue</name>
        <label>Core_Opp_EntryStageValue</label>
        <locationX>182</locationX>
        <locationY>1223</locationY>
        <defaultConnector>
            <targetReference>Core_Opp_Set_Approved_Opportunity_Region</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Core_Opp_EntryStageValue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Converted_Created_Date_and_Opportunity_Entry_Stage</targetReference>
            </connector>
            <label>If_Core_Opp_EntryStageValue</label>
        </rules>
    </decisions>
    <decisions>
        <description>Sets the &apos;Approved Opportunity Region&apos; to the Region of the Opportunity Owner when the Opportunity goes into any of these Stages for the first time - Design Win, Production Win, Lost, Cancelled. The field will not be updated once set.</description>
        <name>Core_Opp_Set_Approved_Opportunity_Region</name>
        <label>Core_Opp_Set_Approved_Opportunity_Region</label>
        <locationX>182</locationX>
        <locationY>1523</locationY>
        <defaultConnector>
            <targetReference>Core_Opp_Stage_DesignWin</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Opportunity_Region_and_Stage</name>
            <conditionLogic>1 AND ( 2 OR 3 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Approved_Opportunity_Region__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_Opportunity_Region_Owner_Core_User_Geo_c</targetReference>
            </connector>
            <label>Check Opportunity Region and Stage</label>
        </rules>
    </decisions>
    <decisions>
        <description>Set the stage to design win when approved if the prior stage was not Production Win.</description>
        <name>Core_Opp_Stage_DesignWin</name>
        <label>Core_Opp_Stage_DesignWin</label>
        <locationX>182</locationX>
        <locationY>1823</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IF_Core_Opp_Stage_DesignWin</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Approval_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Opp_Stage_DW</targetReference>
            </connector>
            <label>IF Core_Opp_Stage_DesignWin</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>f_CreatedDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!$Record.CreatedDate})</expression>
    </formulas>
    <formulas>
        <name>f_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Opportunity Stage New {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Stage New</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Approved_Opportunity_Region_Owner_Core_User_Geo_c</name>
        <label>Approved Opportunity Region=Owner.Core_User_Geo__c</label>
        <locationX>50</locationX>
        <locationY>1631</locationY>
        <connector>
            <targetReference>Core_Opp_Stage_DesignWin</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Approved_Opportunity_Region__c</field>
            <value>
                <elementReference>$Record.Owner.Core_User_Geo__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Core_Opp_Stage_DW</name>
        <label>Core_Opp_Stage_DW</label>
        <locationX>50</locationX>
        <locationY>1931</locationY>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Design Win</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Loss_Cancel_Details_NULL</name>
        <label>Loss/Cancel Details = NULL</label>
        <locationX>50</locationX>
        <locationY>1031</locationY>
        <connector>
            <targetReference>Core_Opp_EntryStageValue</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Loss_Cancel_Details__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Opportunity_Stage_Design</name>
        <label>Opportunity: Stage = Design</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Core_Opp_Capture_Prior_Opportunity_for_Lost_Opptys</targetReference>
        </connector>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Design</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Prior_Lost_Opportunity_Stage</name>
        <label>Prior Lost Opportunity Stage</label>
        <locationX>50</locationX>
        <locationY>731</locationY>
        <connector>
            <targetReference>Core_Opp_Clear_Loss_Cancel_Details</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Prior_Lost_Opportunity_Stage__c</field>
            <value>
                <elementReference>$Record__Prior.StageName</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Converted_Created_Date_and_Opportunity_Entry_Stage</name>
        <label>Update Converted Created Date and Opportunity Entry Stage</label>
        <locationX>50</locationX>
        <locationY>1331</locationY>
        <connector>
            <targetReference>Core_Opp_Set_Approved_Opportunity_Region</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Converted_Created_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Opportunity_Entry_Stage__c</field>
            <value>
                <elementReference>$Record.StageName</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Core_Opp_All_Products_Pending</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
