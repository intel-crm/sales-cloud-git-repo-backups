            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_SalePrice</name>
        <label>Update SalePrice</label>
        <locationX>50</locationX>
        <locationY>479</locationY>
        <connector>
            <targetReference>OppProd_Lost_to_Open_Step_2</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Lost_to_Open_Flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
