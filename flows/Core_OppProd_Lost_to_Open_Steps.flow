        </inputAssignments>
        <inputAssignments>
            <field>UnitPrice</field>
            <value>
                <elementReference>$Record.Core_Lost_Sales_Price__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
