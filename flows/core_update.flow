<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Update_Account_Record_Type_Dup_Check</name>
        <label>Update Account Record Type Dup Check</label>
        <locationX>176</locationX>
        <locationY>311</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_Account_Record_Type_Dup_Check__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.RecordType.Name</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <constants>
        <name>con_CIMOBMIntegration</name>
        <dataType>String</dataType>
        <value>
            <stringValue>CIM.OBM Integration</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_ERPMOBMIntegration</name>
        <dataType>String</dataType>
        <value>
            <stringValue>ERPM.OBM Integration</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_InactiveAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Inactive Account</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_IntegrationOBMUser</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Integration_OBM User</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_IntegrationUser</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Integration User</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_PartnerAccountGroup</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Partner Account Group</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_SalesforceSystemUser</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Salesforce System User</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_UncoveredAccountUser</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Uncovered Account</stringValue>
        </value>
    </constants>
    <description>update Core_Account_RecordType_Dup_CheckField as recordtype value</description>
    <environments>Default</environments>
    <formulas>
        <name>NewAccount</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>core update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>core update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Account_Record_Type_Dup_Check</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(),AND(ISCHANGED({!$Record.RecordTypeId}),{!$Record.RecordTypeId}&lt;&gt;{!$Record__Prior.RecordTypeId}))</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>UncoveredAccountRecordTypeId</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>RecordType</objectType>
    </variables>
    <variables>
        <name>var_UncoveredAccountUserId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
