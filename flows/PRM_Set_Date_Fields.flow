    <description>Set the date field to today if user does not enter the date or blank out the date field if the user unchecks any of the checkboxes</description>
    <environments>Default</environments>
    <formulas>
        <name>blankDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE(&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
