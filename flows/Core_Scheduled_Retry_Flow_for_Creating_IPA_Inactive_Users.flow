<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Contact_Id_to_List</name>
        <label>Assign Contact Id to List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RetryContactIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Log_Entries.Core_sObjectId__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Log_Entries</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Single_User_to_List</name>
        <label>Assign Single User to List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>createUsersList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>createUserSingleVariable</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Contact_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_User_values</name>
        <label>Assign User values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.Alias</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Alias</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.Username</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>username</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.Core_License_Reclaimed_on_Creation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.IsActive</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.ContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_Contact_Records.Contact_ID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.Email</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_Contact_Records.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.EmailEncodingKey</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>UTF-8</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.Core_Federation_ID__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_Contact_Records.Core_Enterprise_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.FirstName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_Contact_Records.FirstName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.LastName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_Contact_Records.LastName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.LanguageLocaleKey</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>en_US</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.LocaleSidKey</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>en_US</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.TimeZoneSidKey</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>America/Los_Angeles</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createUserSingleVariable.ProfileId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Partner_Portal_Profile_Id.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Single_User_to_List</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Flow_StartDate</name>
        <label>Check Flow StartDate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>StarDate_today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FlowStartDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Get_Last_1_hour_created_Log_Entry_Records</targetReference>
            </connector>
            <label>StarDate today</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Log_Entry_Records</name>
        <label>Check Log Entry Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Wait_for_1_hour_for_next_run</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Log_Entry_Records_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Last_1_hour_created_Log_Entry_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_Log_Entries</targetReference>
            </connector>
            <label>Log Entry Records Present</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Alias</name>
        <dataType>String</dataType>
        <expression>LEFT({!Loop_Through_Contact_Records.FirstName}, 5)</expression>
    </formulas>
    <formulas>
        <name>CurrentDate</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime}</expression>
    </formulas>
    <formulas>
        <name>LastHourTime</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} - 1</expression>
    </formulas>
    <formulas>
        <name>PauseDateTime</name>
        <dataType>DateTime</dataType>
        <expression>{!CurrentDate}</expression>
    </formulas>
    <formulas>
        <name>username</name>
        <dataType>String</dataType>
        <expression>{!Loop_Through_Contact_Records.Core_Enterprise_Id__c}+&apos;@intel.com.crm&apos;+IF({!$Label.Core_Draco_sandbox_environment}=&apos;Prod&apos;, &apos;&apos;,{!$Label.Core_Draco_sandbox_environment})</expression>
    </formulas>
    <interviewLabel>Core Scheduled Retry Flow for Creating IPA Inactive Users {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core Scheduled Retry Flow for Creating IPA Inactive Users</label>
    <loops>
        <description>Loop Through to create user records</description>
        <name>Loop_Through_Contact_Records</name>
        <label>Loop Through Contact Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Contact_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_User_values</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Wait_for_1_hour_for_next_run</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Through_Log_Entries</name>
        <label>Loop Through Log Entries</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Last_1_hour_created_Log_Entry_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Contact_Id_to_List</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Contact_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contact_Records</name>
        <label>Get Contact Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Partner_Portal_Profile_Id</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>RetryContactIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Last_1_hour_created_Log_Entry_Records</name>
        <label>Get Last 1 hour created Log Entry Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Log_Entry_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>LastHourTime</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Origin__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Flow Core Draco Create Inactive User for Employee Contact</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Retry_Counter__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Partner_Portal_Profile_Id</name>
        <label>Get Partner Portal Profile Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Contact_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Partner</stringValue>
            </value>
        </filters>
        <filters>
            <field>UserLicenseId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>100o0000000OG1jAAG</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Profile</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Last_1_hour_created_Log_Entry_Records</targetReference>
        </connector>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2026-06-16</startDate>
            <startTime>00:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>createUserSingleVariable</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>
    <variables>
        <name>createUsersList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>
    <variables>
        <name>FlowStartDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>$Flow.CurrentDate</elementReference>
        </value>
    </variables>
    <variables>
        <name>RetryContactIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>UserRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>
    <waits>
        <name>Wait_for_1_hour_for_next_run</name>
        <elementSubtype>WaitDuration</elementSubtype>
        <label>Wait for 1 hour for next run</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>Check_Flow_StartDate</targetReference>
            </connector>
            <label>el_0</label>
            <offset>1</offset>
            <offsetUnit>Hours</offsetUnit>
        </waitEvents>
    </waits>
</Flow>
