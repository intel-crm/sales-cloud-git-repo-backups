<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>recallApproval</name>
        <label>recallApproval</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <actionName>Core_Solution_Area_Controller</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Update_Status_to_Resubmit</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>recId</name>
            <value>
                <elementReference>get_Solution_Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_Solution_Area_Controller</nameSegment>
    </actionCalls>
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Determine_Approvers</name>
        <label>Determine Approvers</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Not_Approver</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isApprover</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>get_Solution_Record.Approver_1__r.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$User.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_Solution_Record.Approver_2__r.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$User.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_Solution_Record.Approver_3__r.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$User.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>System Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IT Admin</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Solution_to_Resubmit</targetReference>
            </connector>
            <label>isApprover</label>
        </rules>
    </decisions>
    <decisions>
        <name>Solution_to_Resubmit</name>
        <label>Solution to Resubmit</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Status_Not_Pending</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pending_Status_check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_Solution_Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>First_Screen</targetReference>
            </connector>
            <label>Pending Status check</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Core_ReSubmit_Solution_Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_ReSubmit_Solution_Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>get_Solution_Record</name>
        <label>get Solution Record</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Determine_Approvers</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Solution_Areas__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Status_to_Resubmit</name>
        <label>Update Status to Resubmit</label>
        <locationX>50</locationX>
        <locationY>674</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <stringValue>Resubmit</stringValue>
            </value>
        </inputAssignments>
        <object>Core_Solution_Areas__c</object>
    </recordUpdates>
    <screens>
        <name>First_Screen</name>
