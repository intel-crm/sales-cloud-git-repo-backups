<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Delete staging-prod3-fph records {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Delete staging-prod3-fph records</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordDeletes>
        <name>delete_fph_records</name>
        <label>delete fph records</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_iPaaS_Load_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>IpaasIdVar</elementReference>
            </value>
        </filters>
        <object>Core_Flat_Product_Hierarchy3__c</object>
    </recordDeletes>
    <recordDeletes>
        <name>delete_product3_records</name>
        <label>delete product3 records</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>delete_fph_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_iPaaS_Load_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>IpaasIdVar</elementReference>
            </value>
        </filters>
        <object>Product3__c</object>
    </recordDeletes>
    <recordDeletes>
        <name>delete_product_staging_records</name>
        <label>delete product staging records</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <connector>
            <targetReference>delete_product3_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>iPaaS_Load_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>IpaasIdVar</elementReference>
            </value>
        </filters>
        <object>Core_Products_Staging__c</object>
    </recordDeletes>
    <screens>
        <name>enterIpaasId</name>
        <label>enterIpaasId</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>delete_product_staging_records</targetReference>
        </connector>
        <fields>
            <name>IpaasIdVar</name>
            <dataType>String</dataType>
            <fieldText>Enter IpaasId</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>submit</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
