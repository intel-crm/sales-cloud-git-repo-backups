    <decisions>
        <name>Check_Account_Coverage</name>
        <label>Check Account Coverage</label>
        <locationX>1964</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Select_Customer_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Intel_Led</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Core_Account_Primary_Coverage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel-led Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request.Core_Account_Category__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Account_Category</targetReference>
            </connector>
            <label>Check Intel-Led</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_account_request_status_flow</name>
        <label>check account request status flow</label>
        <locationX>1007</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Check_Account_Coverage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>In_Process_Status_Error_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Requested_Account__r.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Process</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>error_message_flow</targetReference>
            </connector>
            <label>In Process Status Error Message</label>
        </rules>
        <rules>
            <name>Approved_Staus_error_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Requested_Account__r.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_Error_Message</targetReference>
            </connector>
            <label>Approved Staus error Message</label>
        </rules>
        <rules>
            <name>Rejectes_Status_Error_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rejected_Status_Message</targetReference>
            </connector>
            <label>Rejectes Status Error Message</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Aggregation_Type_is_Location_Customer</name>
        <label>Check Aggregation Type is Location Customer</label>
        <locationX>1964</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>Check_Request_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Aggregation_Type_is_Location</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Unified_Customer_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UNFD_LOC_CUST</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Reference_type</targetReference>
            </connector>
            <label>Aggregation Type is Location</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_parent_unified_Id_is_not_null</name>
        <label>Check parent unified Id is not null</label>
        <locationX>1766</locationX>
        <locationY>1274</locationY>
        <defaultConnector>
            <targetReference>Check_Request_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>parent unified id not empty</defaultConnectorLabel>
        <rules>
            <name>Parent_Unified_Id_is_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ParentUnifiedId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message</targetReference>
            </connector>
            <label>Parent Unified Id is Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Reference_type</name>
        <label>Check Reference type</label>
        <locationX>1766</locationX>
        <locationY>974</locationY>
        <defaultConnector>
            <targetReference>Get_the_Country_BP_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Reference Type is Country</defaultConnectorLabel>
        <rules>
            <name>Reference_Type_is_Global</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Please_choose_a_hierarchy_reference_type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Unified_Global_Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_Global_BP_Id</targetReference>
            </connector>
            <label>Reference Type is Global</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Request_Status</name>
        <label>Check Request Status</label>
        <locationX>1964</locationX>
        <locationY>1766</locationY>
        <defaultConnector>
            <targetReference>Redirect_to_Record_Page</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Request_Status_Value</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Approval</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reuse</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Requested_Account_Record_Type</targetReference>
            </connector>
            <label>Request Status Value</label>
        </rules>
    </decisions>
