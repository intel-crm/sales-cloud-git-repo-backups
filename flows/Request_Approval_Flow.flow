        <locationX>2690</locationX>
        <locationY>3794</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Management</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Core_Account_Reference_Source_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Opportunitysource</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Account_Requested_Record_Type</targetReference>
            </connector>
            <label>Opportunity Management</label>
        </rules>
        <rules>
            <name>CoMarketing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Core_Account_Reference_Source_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>CoMarketingSource</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Req_Account_for_comarketing_source</targetReference>
            </connector>
            <label>CoMarketing</label>
        </rules>
        <rules>
            <name>Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Core_Account_Reference_Source_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>PartnerSource</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Req_Account_for_Partner_Source</targetReference>
            </connector>
            <label>Partner</label>
        </rules>
        <rules>
            <name>Access_Entitlement</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Core_Account_Reference_Source_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AccessandEntitlementSource</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Req_Account_for_Access_and_Entitlement_Source</targetReference>
            </connector>
            <label>Access &amp; Entitlement</label>
        </rules>
        <rules>
            <name>Other</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Core_Account_Reference_Source_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>OtherSource</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Req_Account_for_Other_Source</targetReference>
            </connector>
            <label>Other</label>
        </rules>
    </decisions>
