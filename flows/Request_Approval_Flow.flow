    <decisions>
        <name>Check_Account_Coverage</name>
        <label>Check Account Coverage</label>
        <locationX>4142</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Select_Customer_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Intel_Led</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Core_Account_Primary_Coverage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Intel_Covered</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request.Core_Account_Category__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Account_Category</targetReference>
            </connector>
            <label>Check Intel-Led</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_account_request_status_flow</name>
        <label>check account request status flow</label>
        <locationX>2096</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Check_Account_Coverage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>In_Process_Status_Error_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Requested_Account__r.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Process</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>error_message_flow</targetReference>
            </connector>
            <label>In Process Status Error Message</label>
        </rules>
        <rules>
            <name>Approved_Staus_error_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Requested_Account__r.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_Error_Message</targetReference>
            </connector>
            <label>Approved Staus error Message</label>
        </rules>
        <rules>
            <name>Rejectes_Status_Error_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rejected_Status_Message</targetReference>
            </connector>
            <label>Rejectes Status Error Message</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Aggregation_Type</name>
        <label>Check Aggregation Type</label>
        <locationX>4142</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>Check_Request_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Aggregation_Type_is_Location_or_Customer_or_Intermediate</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Unified_Customer_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UNFD_LOC_CUST</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Unified_Customer_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UNFD_CTRY_CUST</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Unified_Customer_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UNFD_INTRMD_CUST</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getValidGlobalRecord</targetReference>
            </connector>
            <label>Aggregation Type is Location or Customer or Intermediate</label>
        </rules>
        <rules>
            <name>GlobalAggregation</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Unified_Customer_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UNFD_GLBL_CUST</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UsageAndLocationTypeAssign</targetReference>
            </connector>
            <label>GlobalAggregation</label>
        </rules>
    </decisions>
    <decisions>
