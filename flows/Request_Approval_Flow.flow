    <decisions>
        <name>Check_parent_unified_Id_is_not_nul</name>
        <label>Check parent unified Id is not nul</label>
        <locationX>2822</locationX>
        <locationY>2594</locationY>
        <defaultConnector>
            <targetReference>Check_Request_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Parent unified id not empty</defaultConnectorLabel>
        <rules>
            <name>Parent_Unified_Id_is_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ParentUnifiedId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Unified_Customer_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UNFD_LOC_CUST</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message_if_country_is_not_found_for_requested_location_customer</targetReference>
            </connector>
            <label>Parent Unified Id is Null</label>
        </rules>
        <rules>
            <name>Parent_Unified_is_not_empty_and_aggregation_type_is_country</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_any_country_account_present_under_the_selected_node</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Unified_Customer_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UNFD_CTRY_CUST</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message_if_country_node_is_already_present_for_requested_country</targetReference>
            </connector>
            <label>Parent Unified is not empty and aggregation type is country</label>
        </rules>
