<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>ErroMessageForProduct</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Products cannot be added as opportunity is in the win or loss status</stringValue>
        </value>
    </constants>
    <customErrors>
        <name>CustomErrorForProduct</name>
        <label>CustomErrorForProduct</label>
        <locationX>600</locationX>
        <locationY>935</locationY>
        <customErrorMessages>
            <errorMessage>Products cannot be added as opportunity is in the win or loss status</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>PFIR_Error</name>
        <label>PFIR Error</label>
        <locationX>1128</locationX>
        <locationY>1043</locationY>
        <customErrorMessages>
            <errorMessage>Product cannot be added at this Stage, Quote is in Review Status.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_if_QLI_is_in_PFIR_Status</name>
        <label>Check if QLI is in PFIR Status</label>
        <locationX>1260</locationX>
        <locationY>935</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>QLI_is_in_PFIR_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Lines_Details</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PFIR_Error</targetReference>
            </connector>
            <label>QLI is in PFIR Status?</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckOpportunity</name>
        <label>CheckOpportunity</label>
        <locationX>314</locationX>
        <locationY>611</locationY>
        <defaultConnector>
            <targetReference>Opportunity_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>OpenOpp</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4) AND (5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>GetDRRecords.Core_Opportunity_Id__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualify</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetDRRecords.Core_Opportunity_Id__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Define</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetDRRecords.Core_Opportunity_Id__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Develop</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetDRRecords.Core_Opportunity_Id__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetDRRecords.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetDRRecords.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Re-Submitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Opportunity_Product</targetReference>
            </connector>
            <label>OpenOpp</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckStatus</name>
        <label>CheckStatus</label>
        <locationX>512</locationX>
        <locationY>827</locationY>
        <defaultConnector>
            <targetReference>CustomErrorForProduct</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>StatusOPP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OPPLineitems</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Record_Types_for_Design</targetReference>
            </connector>
            <label>StatusOPP</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckUpdateorCreate</name>
        <label>CheckUpdateorCreate</label>
        <locationX>1172</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckCreateCondition</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckCreate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetDRRecords</targetReference>
            </connector>
            <label>CheckCreateCondition</label>
        </rules>
    </decisions>
    <decisions>
        <name>Copy_1_of_CheckStatus</name>
        <label>CheckStatusofApprovedDr</label>
        <locationX>116</locationX>
        <locationY>827</locationY>
        <defaultConnector>
            <targetReference>Get_Record_Types_for_Design</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Copy_1_of_StatusOPP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OppLineitemsApprovedDR</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Opportunity_Product</targetReference>
            </connector>
            <label>CheckStatusofApprovedDr</label>
        </rules>
    </decisions>
    <decisions>
        <name>Deal_or_Design</name>
        <label>Deal or Design?</label>
        <locationX>688</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>is_Partner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CheckOpportunity</targetReference>
            </connector>
            <label>Is Deal</label>
        </rules>
    </decisions>
    <decisions>
        <name>is_Partner</name>
        <label>is Partner?</label>
        <locationX>1062</locationX>
        <locationY>611</locationY>
        <defaultConnector>
            <targetReference>Get_Quote_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Partner_user</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partner</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CheckCreate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Record_Types</targetReference>
            </connector>
            <label>Partner user?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Populate_Product</name>
        <label>Populate Product</label>
        <locationX>314</locationX>
        <locationY>1427</locationY>
        <defaultConnector>
            <targetReference>Update_Product_Detail_on_DRP_Lookup</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_MMID_or_Ordering_Code_Lookup</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.MMID_or_Ordering_code__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Product_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MMID_or_Ordering_code__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Product_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Throw_Validation</targetReference>
            </connector>
            <label>Check MMID or Ordering Code Lookup</label>
        </rules>
        <rules>
            <name>Check_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Product_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Design_Record_Type</targetReference>
            </connector>
            <label>Check Product</label>
        </rules>
    </decisions>
    <description>This flow will run after insert and sets the record type and update the Product</description>
    <environments>Default</environments>
    <formulas>
        <name>CheckCreate</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>ProductId</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Core_Design_Registration_Id__r.Core_Product_Group_Nm__c}, &apos;FPGA/POWER&apos;),{!$Record.MMID_or_Ordering_code__r.L5_Product__c},IF({!$Record.MMID_or_Ordering_code__r.L4_Product__c}!=null, {!$Record.MMID_or_Ordering_code__r.L4_Product__c}, {!$Record.MMID_or_Ordering_code__r.L5_Product__c}))</expression>
    </formulas>
    <interviewLabel>Design Registration Product Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Design-Deal Registration Product Automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
