    <decisions>
        <description>for the LEAD  WFs ====
1.Core_Lead_Time_OnHold_Entrance 
2.Core_Lead_Time_Open_Entrance
3.Core_Lead_Time_Rejected_Entrance
4.Core_Lead_Time_Accepted_Entrance
5.Core_Lead_Time_Engaged_Entrance</description>
        <name>Switch_based_on_Lead_State</name>
        <label>Switch based on Lead State</label>
        <locationX>548</locationX>
        <locationY>291</locationY>
        <defaultConnector>
            <targetReference>SQL_SAL_TQL_TAP_MQL_entrance</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Lead_Time_OnHold_Entrance</name>
            <conditionLogic>1 AND ( 2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_State_Entrance_Date_OnHold__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>F_NewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_State__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_State__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Hold</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Update_State_Entrance_Date_OnHold</targetReference>
            </connector>
            <label>Core_Lead_Time_OnHold_Entrance</label>
        </rules>
        <rules>
            <name>Core_Lead_Time_Open_Entrance</name>
            <conditionLogic>1 AND ( 2 OR 3) AND 4</conditionLogic>
