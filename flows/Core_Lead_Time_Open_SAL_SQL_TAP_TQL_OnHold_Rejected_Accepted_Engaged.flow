        </rules>
        <rules>
            <name>Core_Lead_Time_Accepted_Entrance</name>
            <conditionLogic>1 AND ( 2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_State_Entrance_Date_Accepted__c</leftValueReference>
                <operator>IsNull</operator>
