            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_State__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_State__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
