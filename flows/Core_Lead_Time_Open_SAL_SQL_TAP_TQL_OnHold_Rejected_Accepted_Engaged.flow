            </conditions>
            <conditions>
                <leftValueReference>F_NewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_State__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_State__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Lead_Time_Open_Entrance</targetReference>
            </connector>
            <label>Core_Lead_Time_Open_Entrance</label>
        </rules>
        <rules>
            <name>Core_Lead_Time_Rejected_Entrance</name>
            <conditionLogic>1 AND ( 2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_State_Entrance_Date_Rejected__c</leftValueReference>
                <operator>IsNull</operator>
