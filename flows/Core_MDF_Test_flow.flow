    <decisions>
        <name>Filter_Records</name>
        <label>Filter Records</label>
        <locationX>314</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Insert</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Account__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PRM_Intel_Account</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Builder_Strategy__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF-Excluded Partner</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>forB_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Assignment_Insert</targetReference>
            </connector>
            <label>Is Insert?</label>
        </rules>
        <rules>
            <name>Is_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Account__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PRM_Intel_Account</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Builder_Strategy__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF-Excluded Partner</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>forB_ActiveValueChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Assignment_Update</targetReference>
            </connector>
            <label>Is Update?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Used to check the Active indicator value changed or not</description>
        <name>forB_ActiveValueChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.PRM_Active__c})</expression>
    </formulas>
    <formulas>
        <name>forB_IsIntelAccount</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.PRM_Account__r.RecordType.DeveloperName} == {!$Label.PRM_Intel_Account}, true, false)</expression>
    </formulas>
    <formulas>
        <description>Used to check the record is new or not</description>
        <name>forB_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
