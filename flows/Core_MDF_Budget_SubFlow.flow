<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_PMBShare_record_to_the_PMBShareCollection</name>
        <label>Add PMBShare record to the PMBShareCollection</label>
        <locationX>921</locationX>
        <locationY>93</locationY>
        <assignmentItems>
            <assignToReference>CollPMBShare</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>BudgetShareRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Assign_the_values_to_the_so_PMBShare_record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_the_values_to_the_so_PMBShare_record</name>
        <label>Assign the values to the so_PMBShare record</label>
        <locationX>921</locationX>
        <locationY>292</locationY>
        <assignmentItems>
            <assignToReference>BudgetShareRecord.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>BudgetId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BudgetShareRecord.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PGMRecord.Core_MDF_Group_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BudgetShareRecord.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_PMBShare_record_to_the_PMBShareCollection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Core_MDF_Assign_the_values_to_the_so_PMBShare_record</name>
        <label>Assign the values to the so_PMBShare record</label>
        <locationX>593</locationX>
        <locationY>93</locationY>
        <assignmentItems>
            <assignToReference>BudgetShareRecord.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BudgetShareRecord.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BudgetShareRecord.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_through_the_Partner_Group_Mapping_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_PMBShare_Collection_has_records</name>
        <label>Check if PMBShare Collection has records</label>
        <locationX>50</locationX>
        <locationY>285</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Coll_PMBShare_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CollPMBShare</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Create_PMBShare_Collection</targetReference>
            </connector>
            <label>Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_any_PGM_records_are_there</name>
        <label>Check if any PGM records are there</label>
        <locationX>372</locationX>
        <locationY>34</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Coll_PGMRecods_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CollPGMRecList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Loop_through_the_Partner_Group_Mapping_Collection</targetReference>
            </connector>
            <label>Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_IsGroupIdNull</name>
        <label>IsGroupIdNull</label>
        <locationX>376</locationX>
        <locationY>578</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Loop_through_the_Partner_Group_Mapping_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_ValidGroupId</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PGMRecord.Core_MDF_Group_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PGMRecord.Core_MDF_Group_Id__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsInternalGroup</targetReference>
            </connector>
            <label>ValidGroupId</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsExternalGroup</name>
        <label>IsExternalGroup</label>
        <locationX>625</locationX>
        <locationY>299</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Loop_through_the_Partner_Group_Mapping_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckExternal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PGMRecord.Core_MDF_Type_of_Access__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>External</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>BudgetRecord.Core_MDF_Budget_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Released</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsGeoBasedRequired</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_the_values_to_the_so_PMBShare_record</targetReference>
            </connector>
            <label>CheckExternal</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsInternalGroup</name>
        <label>IsInternalGroup</label>
        <locationX>622</locationX>
        <locationY>580</locationY>
        <defaultConnector>
            <targetReference>IsExternalGroup</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckInternalUser</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PGMRecord.Core_MDF_Type_of_Access__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_the_values_to_the_so_PMBShare_record</targetReference>
            </connector>
            <label>CheckInternalUser</label>
        </rules>
    </decisions>
    <interviewLabel>Budget SubFlow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Budget SubFlow</label>
    <loops>
        <name>Core_MDF_Loop_through_the_Partner_Group_Mapping_Collection</name>
        <label>Loop through the Partner Group Mapping Collection</label>
        <locationX>386</locationX>
        <locationY>286</locationY>
        <assignNextValueToReference>PGMRecord</assignNextValueToReference>
        <collectionReference>CollPGMRecList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
