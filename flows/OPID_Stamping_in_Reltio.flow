        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <elementReference>$Record.Core_Inactive_Ind__c</elementReference>
        </value>
    </variables>
    <variables>
        <name>OPIDWithStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>TEXT({!$Record.Core_Partner_Account_Id__c}:{!$Record.Core_Partner_Account_Id__r.Core_Deactivated__c})</stringValue>
        </value>
    </variables>
