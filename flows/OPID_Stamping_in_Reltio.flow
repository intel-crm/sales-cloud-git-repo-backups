<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>check_if_new_or_existing</name>
        <label>check if new or existing</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Is_Inactive_Indicator_UCD_primary_changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>is existing</defaultConnectorLabel>
        <rules>
            <name>is_new</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>isnewrecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>isPrimaryCheck</targetReference>
            </connector>
            <label>is new</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Inactive_Indicator_UCD_primary_changed</name>
        <label>Is Inactive Indicator / UCD primary changed?</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>inactive indicator / UCD primary is not changed</defaultConnectorLabel>
        <rules>
            <name>changed_inactive_indicator_UCD_Primary</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Inactive_Ind__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Primary_Account__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>isPrimaryCheck</targetReference>
            </connector>
            <label>changed inactive indicator / UCD Primary</label>
        </rules>
    </decisions>
    <decisions>
        <name>isPrimaryCheck</name>
        <label>isPrimaryCheck</label>
        <locationX>182</locationX>
        <locationY>815</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>UCD_Primary_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Primary_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>create_records_in_reltio</targetReference>
            </connector>
            <label>UCD Primary Account</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>inactive_indicator</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Core_Inactive_Ind__c}</expression>
    </formulas>
    <formulas>
        <name>isnewrecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>isupdatedrecord</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED($Record.Core_Inactive_Ind__c)</expression>
    </formulas>
    <formulas>
        <name>opidstatus</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_Partner_Account_Id__c}&amp;&apos;:&apos;&amp;IF({!$Record.Core_Partner_Account_Id__r.Core_Deactivated__c},&apos;False&apos;,&apos;True&apos;)</expression>
    </formulas>
    <interviewLabel>OPID Stamping in Reltio {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OPID Stamping in Reltio</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>create_records_in_reltio</name>
        <label>create records in reltio</label>
        <locationX>50</locationX>
        <locationY>923</locationY>
        <inputAssignments>
            <field>Additional_Content__c</field>
            <value>
                <elementReference>opidstatus</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Content_Type__c</field>
            <value>
                <stringValue>AccountId</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Content__c</field>
            <value>
                <elementReference>$Record.Core_Intel_Account_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Custom_Filter__c</field>
            <value>
                <elementReference>$Record.Core_Intel_Account_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Message_Status__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Module_Name__c</field>
            <value>
                <stringValue>OPID_UPDATE</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Queue_Type__c</field>
            <value>
                <stringValue>Outbound</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Retry_Count__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source_System__c</field>
            <value>
                <stringValue>SLSCLD_OPID</stringValue>
            </value>
        </inputAssignments>
        <object>ACM_Integration_Message_Queue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>check_if_new_or_existing</targetReference>
        </connector>
        <object>Core_Account_Group_Member__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Core_Inactive_Indicator</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <elementReference>$Record.Core_Inactive_Ind__c</elementReference>
        </value>
    </variables>
    <variables>
        <name>Core_Intel_Account_Id</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>$Record.Core_Intel_Account_Id__c</elementReference>
