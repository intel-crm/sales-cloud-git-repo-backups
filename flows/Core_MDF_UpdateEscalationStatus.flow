        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ActivityAmountCCP</name>
        <dataType>Currency</dataType>
        <expression>IF(({!Loop_on_PFR_Records_0.Amount}+{!$Record.Core_MDF_Approved_Amount_amt__c}) &gt; {!Loop_on_PFR_Records_0.Core_MDF_Activity_Reimbursement_Amt_nbr__c}, {!Loop_on_PFR_Records_0.Core_MDF_Activity_Reimbursement_Amt_nbr__c}, {!Loop_on_PFR_Records_0.Amount}+{!$Record.Core_MDF_Approved_Amount_amt__c})</expression>
