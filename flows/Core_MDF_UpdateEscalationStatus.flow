            <name>Core_MDF_Calling_Budget_Escalation_Approval_Process</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Budget_RecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Escalation_Status_nm__c</leftValueReference>
