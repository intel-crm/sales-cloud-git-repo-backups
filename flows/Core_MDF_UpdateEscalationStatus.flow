    <decisions>
        <name>CCF_DCF_SPCF_CCFB_Program_check</name>
        <label>CCF/DCF/SPCF/CCFB/EEF Program check</label>
        <locationX>789</locationX>
        <locationY>569</locationY>
        <defaultConnector>
            <targetReference>IPA_Program_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>co_marketing_program</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Channel_Program_id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_NonTranslateCCFRecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Channel_Program_id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_NonTranslateDCFRecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Channel_Program_id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_NonTranslateSPCFRecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Channel_Program_id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_NonTranslateCCFBoostRecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Channel_Program_id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_NonTranslateEEFRecordType</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MDF_MDF_Budget_type_check</targetReference>
            </connector>
            <label>co-marketing program</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_Activity_field_update</name>
        <label>Check for Activity field update</label>
        <locationX>559</locationX>
        <locationY>397</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_If_Escalation_is_on_Budget_and_Status_is_Pending_Review</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Status_changed_to_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Late_Claim</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Escalation_Status_nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Core_MDF_Escalation_Status_nm__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Escalation_Status_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Co_Marketing_Activity_id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Retail_Program_Check</targetReference>
            </connector>
            <label>If Status changed to Approved</label>
        </rules>
    </decisions>
