    <decisions>
        <description>Send Notification if escalation is rejected or approved</description>
        <name>If_Escalation_is_Rejected_OR_Approved</name>
        <label>If Escalation is Rejected OR Approved</label>
        <locationX>1947</locationX>
        <locationY>2743</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Notification_if_Status_is_Denied_OR_Approved</name>
            <conditionLogic>1 AND (2 OR (3 AND 4))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Escalation_Status_nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Escalation_Status_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Denied</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Escalation_Status_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Late_Claim</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Check_if_Owner_and_Escalation_submitter_are_same_user_1</targetReference>
            </connector>
            <label>Send Notification if Status is Denied/Approved</label>
        </rules>
