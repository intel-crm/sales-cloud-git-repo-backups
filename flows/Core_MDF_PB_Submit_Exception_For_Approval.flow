            <name>originalFormula</name>
            <value>
                <stringValue>AND(ISNEW() ,ISPICKVAL([Core_MDF_Exception__c].Core_MDF_Exception_Status_nm__c , &apos;Pending Review&apos;)) </stringValue>
            </value>
