    <decisions>
        <name>Campaign_Type</name>
        <label>Campaign Type</label>
        <locationX>974</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Executive_Event_Attended</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Single_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Single Email</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clicked_Single_Email</targetReference>
            </connector>
            <label>Single Email</label>
        </rules>
        <rules>
            <name>Newsletter</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Newsletter</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clicked_Newsletter</targetReference>
            </connector>
            <label>Newsletter</label>
        </rules>
        <rules>
            <name>Nurture_Emails</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Nurture Emails</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clicked_Nurture_Emails</targetReference>
            </connector>
            <label>Nurture Emails</label>
        </rules>
        <rules>
            <name>Web_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Web Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Page_Viewed_Web_Request</targetReference>
            </connector>
            <label>Web Request</label>
        </rules>
        <rules>
            <name>Webinar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Webinar</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invited_Webinar</targetReference>
            </connector>
            <label>Webinar</label>
        </rules>
        <rules>
            <name>Onsite_Event</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Onsite Event</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invited_Onsite_Event</targetReference>
            </connector>
            <label>Onsite Event</label>
        </rules>
        <rules>
            <name>WeChat</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WeChat</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>WeChat_Link_Clicked_WeChat</targetReference>
            </connector>
            <label>WeChat</label>
        </rules>
    </decisions>
