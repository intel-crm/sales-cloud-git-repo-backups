    <recordDeletes>
        <name>Delete_Campaign_Member_Statuses</name>
        <label>Delete Campaign Member Statuses</label>
        <locationX>974</locationX>
        <locationY>3107</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Responded</stringValue>
            </value>
        </filters>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
