    <recordDeletes>
        <name>Delete_Campaign_Member_Statuses</name>
        <label>Delete Campaign Member Statuses</label>
        <locationX>176</locationX>
        <locationY>2591</locationY>
        <connector>
            <targetReference>END_ELEMENT_2</targetReference>
        </connector>
        <filterLogic>(1 OR 3) AND 2</filterLogic>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Responded</stringValue>
            </value>
        </filters>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sent</stringValue>
            </value>
        </filters>
        <object>CampaignMemberStatus</object>
    </recordDeletes>
