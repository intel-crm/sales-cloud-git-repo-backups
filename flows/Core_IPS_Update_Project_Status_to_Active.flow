<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>If Product status is Approved  or active and project status is submitted pending then update project status to active</description>
    <environments>Default</environments>
    <interviewLabel>Core IPS Update Project Status to Active {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core IPS Update Project Status to Active</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>We are making Project Status to Active if the Product status is Approved.</description>
        <name>Update_Project_Status_to_Active</name>
        <label>Update Project Status to Active</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Core_IPS_Project__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Project_Status_to_Active</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
    OR(
        ISPICKVAL({!$Record.Status__c}, &apos;Approved&apos;),
        ISPICKVAL({!$Record.Status__c}, &apos;Active&apos;)
    ),
    (
        ISPICKVAL({!$Record.Core_IPS_Project__r.Core_Status__c}, &apos;Submitted Pending&apos;)
    )
)</filterFormula>
        <object>Core_IPS_Product__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
