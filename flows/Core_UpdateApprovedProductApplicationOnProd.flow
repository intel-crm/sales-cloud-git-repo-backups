    <description>Update Approved Product Application On Product when Opportunity is Design Win</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(NOT(PRIORVALUE( [Opportunity].StageName ) ==  &apos;Design Win&apos;) , TEXT([Opportunity].StageName) ==  &apos;Design Win&apos; ) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(PRIORVALUE( {!myVariable_current.StageName} ) ==  &apos;Design Win&apos;) , TEXT({!myVariable_current.StageName}) ==  &apos;Design Win&apos; )</expression>
    </formulas>
    <interviewLabel>Core_UpdateApprovedProductApplicationOnProd-3_InterviewLabel</interviewLabel>
    <label>UpdateApprovedProductApplicationOnProd</label>
