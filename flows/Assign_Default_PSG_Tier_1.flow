<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the Assign Default PSG Tier process using IsChange Account Tier criteria.
Concatenate all the individual group tiers and display it in Account Tier.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_1_myRule_1_A1_8272582218</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Core_Account_PSG_Tier__c} )+
IF(ISPICKVAL({!$Record.Core_Account_ISG_Tier__c}, &quot;&quot;), NULL,&quot;;&quot;+TEXT({!$Record.Core_Account_ISG_Tier__c} )) + 
IF(ISPICKVAL({!$Record.Core_Account_CCG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!$Record.Core_Account_CCG_Tier__c} )) + 
IF(ISPICKVAL({!$Record.Core_Account_DCG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!$Record.Core_Account_DCG_Tier__c} )) + 
IF(ISPICKVAL({!$Record.Core_Account_GA_Tier__c}, &quot;&quot;), NULL,&quot;;&quot;+TEXT({!$Record.Core_Account_GA_Tier__c})) + 
IF(ISPICKVAL({!$Record.Core_Account_IOTG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!$Record.Core_Account_IOTG_Tier__c} )) + 
IF(ISPICKVAL({!$Record.Core_Account_NTG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!$Record.Core_Account_NTG_Tier__c} )) + 
IF(ISPICKVAL({!$Record.Core_Account_RSG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!$Record.Core_Account_RSG_Tier__c} ))</expression>
    </formulas>
    <label>Assign Default PSG Tier_1</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>myRule_1_A1</name>
        <label>Update Account Tier</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>Core_Account_Tier__c</field>
            <value>
                <elementReference>formula_1_myRule_1_A1_8272582218</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>myRule_1_A1</targetReference>
        </connector>
        <filterFormula>AND({!$Record.RecordType.DeveloperName}==&apos;Mastered_Account&apos;,
OR(
ISNEW(),
ISCHANGED({!$Record.Core_Account_CCG_Tier__c} ),
ISCHANGED({!$Record.Core_Account_DCG_Tier__c}  ),
ISCHANGED({!$Record.Core_Account_GA_Tier__c}  ),
ISCHANGED({!$Record.Core_Account_IOTG_Tier__c}  ),
ISCHANGED({!$Record.Core_Account_ISG_Tier__c}  ),
ISCHANGED({!$Record.Core_Account_NTG_Tier__c} ),
ISCHANGED({!$Record.Core_Account_PSG_Tier__c} ),
ISCHANGED({!$Record.Core_Account_RSG_Tier__c} ),
ISCHANGED({!$Record.Core_PSG_Account__c})
)
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
