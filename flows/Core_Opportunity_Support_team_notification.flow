    <actionCalls>
        <name>Reassignement_done</name>
        <label>Reassignement done</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <actionName>Core_Opportunity_Support__c.Opportunity_Support_team_member_is_reassigned</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Assignment_Email</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Core_Opportunity_Support__r.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_Opportunity_Support__c.Opportunity_Support_team_member_is_reassigned</nameSegment>
    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_for_Assignment_or_Reassignment</name>
        <label>Check for Assignment or Reassignment</label>
        <locationX>248</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Reassigned</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Reassignment Check</defaultConnectorLabel>
        <rules>
            <name>Assignment_Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Opportunity_Support_Team_Member__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_Opportunity_Support_Team_Member__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assigned_Only</targetReference>
            </connector>
            <label>Assignment Check</label>
        </rules>
    </decisions>
    <decisions>
        <description>When the status is not submitted and Opportunity Support Team Member is added</description>
        <name>Opportunity_Support_Request_is_Approved_with_Team_Members_Added</name>
        <label>Opportunity Support Request is Approved with Team Members Added</label>
        <locationX>501</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Submission and Approval</defaultConnectorLabel>
        <rules>
            <name>Assignment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Support__r.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_Assignment_or_Reassignment</targetReference>
            </connector>
            <label>Assignment</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reassigned</name>
        <label>Reassigned</label>
        <locationX>446</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Assignment_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Reassignment</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Support__r.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Support__r.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Opportunity_Support_Team_Member__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reassignement_done</targetReference>
            </connector>
            <label>Reassignment</label>
        </rules>
    </decisions>
    <description>Trigger notification when new member is added to the team after Opportunity support approve</description>
    <environments>Default</environments>
    <formulas>
        <name>currentYear</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(DATEVALUE(NOW())))</expression>
    </formulas>
    <formulas>
        <name>emailAddress</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_Opportunity_Support__r.Opportunity__r.Owner.Email}+&apos;,&apos;+{!$Record.Core_Opportunity_Support__r.CreatedBy.Email} +&apos;,&apos;+{!$Record.Core_Opportunity_Support__r.Core_Approver_1__r.Email}+&apos;,&apos;+{!$Record.Core_Opportunity_Support__r.Core_Approver_2__r.Email}+&apos;,&apos;+{!$Record.Core_Opportunity_Support__r.Core_Approver_3__r.Email}+&apos;,&apos;+{!$Record.Core_Opportunity_Support__r.Core_Approver_4__r.Email}+&apos;,&apos;+
{!$Record.Core_Opportunity_Support__r.Core_Approver_5__r.Email}+&apos;,&apos;+{!$Record.LastModifiedBy.Email}</expression>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
        <expression>&apos;REASSIGNED Opportunity Support Request (CSA/TSS):&apos;+ {!$Record.Core_Opportunity_Support__r.Opportunity__r.Account.Name}+&apos; - &apos;+ {!$Record.Core_Opportunity_Support__r.Opportunity__r.Name}</expression>
    </formulas>
    <formulas>
        <name>OppsupportLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_550}, FIND( &apos;/services&apos;, {!$Api.Partner_Server_URL_550})) &amp; {!$Record.Core_Opportunity_Support__c}</expression>
    </formulas>
    <formulas>
        <name>recordcounter</name>
        <dataType>Number</dataType>
        <expression>if ( ISBLANK({!$Record.Core_Reassign_counter__c}) || ISNULL({!$Record.Core_Reassign_counter__c}) , 1 , {!$Record.Core_Reassign_counter__c} + 1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>technicalOwner</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Technical_Owner__c}) || ISBLANK({!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Technical_Owner__c}), &apos; &apos;, {!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Technical_Owner__r.FirstName} + &apos; &apos; +{!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Technical_Owner__r.LastName})</expression>
    </formulas>
    <formulas>
        <name>UserAddition</name>
        <dataType>String</dataType>
        <expression>IF( ISNEW(), ({!$Record.Core_Opportunity_Support_Team_Member__r.FirstName}  + &apos; &apos;+{!$Record.Core_Opportunity_Support_Team_Member__r.LastName} + &apos; added to the Team for the following Opportunity:&apos;) , ({!$Record__Prior.Core_Opportunity_Support_Team_Member__r.FirstName}  + &apos; &apos;+{!$Record__Prior.Core_Opportunity_Support_Team_Member__r.LastName} + &apos; is replcaed by&apos; + {!$Record.Core_Opportunity_Support_Team_Member__r.FirstName}  + &apos; &apos;+{!$Record.Core_Opportunity_Support_Team_Member__r.LastName} + &apos; in the opportunity team for the following Opportunity:&apos;))</expression>
    </formulas>
    <interviewLabel>Opportunity Support team notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Support team notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
