    </actionCalls>
    <actionCalls>
        <name>Assignment_Email</name>
        <label>Assignment Email</label>
        <locationX>446</locationX>
        <locationY>839</locationY>
        <actionName>Core_Opportunity_Support_Team__c.Opportunity_Support_Team_Member_Assigned</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_Opportunity_Support_Team__c.Opportunity_Support_Team_Member_Assigned</nameSegment>
