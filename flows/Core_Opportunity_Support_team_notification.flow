    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>375</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Opportunity_Support_Request_is_Approved_with_Team_Members_Added</targetReference>
        </connector>
        <filterFormula>(ISNEW()||ISCHANGED({!$Record.Core_Opportunity_Support_Team_Member__c})||ISCHANGED ({!$Record.Core_Status__c}))</filterFormula>
        <object>Core_Opportunity_Support_Team__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>userAddtionEmailTemplate</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;table class=&quot;ql-table-blob&quot; style=&quot;background-color: #0071c5;&quot; width=&quot;100%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;padding-left: 50px; border: none;&quot;&gt;&lt;div style=&quot;color: white;&quot;&gt;&lt;h1&gt;Reassigned Opportunity Support Resource (CSA)!&lt;/h1&gt;&lt;/div&gt;&lt;/td&gt;&lt;td align=&quot;right&quot; style=&quot;border: none; padding-right: 20px; white-space: pre;&quot;&gt;&lt;p&gt;&lt;img alt=&quot;app image.jpg&quot; src=&quot;https://intel--c.na104.content.force.com/servlet/servlet.ImageServer?id=0153b000004Pg4i&amp;amp;oid=00Do0000000aRcf&quot; /&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table class=&quot;ql-table-blob&quot; style=&quot;font-family: intel clear; border: 1px solid #d3d3d3; padding-left: 50px; padding-top: 5px; padding-bottom: 5px; font-size: 14px;&quot; width=&quot;100%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Dear Opportunity Owner/Requestor/Assigner {!$Record.CreatedBy.FirstName} {!$Record.CreatedBy.LastName}&lt;br /&gt;&lt;br /&gt;CSA support has been reassigned for the below Opportunity. Please find the link to the Support Request and Opportunity Information below: &lt;br /&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table class=&quot;ql-table-blob&quot; style=&quot;padding-left: 50px; border: 1px solid #d3d3d3; font-size: 14px; font-family: intel clear;&quot; width=&quot;100%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;a style=&quot;font-size: 18px;&quot; href=&quot;{!OppsupportLink}&quot;&gt; Click Here&lt;/a&gt;to see additional information on this opportunity.&lt;br /&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table class=&quot;ql-table-blob&quot; style=&quot;border: 1px solid #d3d3d3; padding-left: 50px; padding-top: 5px; padding-bottom: 5px; font-size: 20px;&quot; width=&quot;100%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;white-space: pre;&quot;&gt;Opportunity Information&lt;br /&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table class=&quot;ql-table-blob&quot; style=&quot;font-family: intel clear; border: 1px solid #d3d3d3; padding-left: 50px; padding-top: 5px; padding-bottom: 5px; font-size: 14px;&quot; width=&quot;100%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;font-family: intel clear;&quot; width=&quot;40%&quot;&gt;Account Name : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Account.Name}&lt;/td&gt;&lt;td style=&quot;font-family: intel clear;&quot; width=&quot;40%&quot;&gt;Opportunity Name : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Name}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family: intel clear;&quot; width=&quot;40%&quot;&gt;Stage : {!$Record.Core_Opportunity_Support__r.Opportunity__r.StageName}&lt;/td&gt;&lt;td style=&quot;font-family: &apos;intel clear&apos;; white-space: pre;&quot; width=&quot;40%&quot;&gt;Decision Date : {!$Record.Core_Opportunity_Support__r.Opportunity__r.CloseDate} &lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family: intel clear;&quot; width=&quot;40%&quot;&gt;SalesGroup : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Sales_Groups__c}&lt;/td&gt;&lt;td style=&quot;font-family: intel clear;&quot; width=&quot;40%&quot;&gt;Opportunity Type : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Opportunity_Type__c}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family: &apos;intel clear&apos;; white-space: pre;&quot; width=&quot;40%&quot;&gt;Opportunity Owner : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Owner.FirstName} {!$Record.Core_Opportunity_Support__r.Opportunity__r.Owner.LastName}&lt;/td&gt;&lt;td style=&quot;font-family: &apos;intel clear&apos;; white-space: pre;&quot; width=&quot;40%&quot;&gt;Product Segement : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Product_Segment__c}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family: &apos;intel clear&apos;; white-space: pre;&quot; width=&quot;40%&quot;&gt;Technical Owner : {!technicalOwner}&lt;/td&gt;&lt;td style=&quot;font-family: &apos;intel clear&apos;; white-space: pre;&quot; width=&quot;40%&quot;&gt;Product Application : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Product_Application__c}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family: intel clear;&quot; width=&quot;40%&quot;&gt;Amount : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Amount}&lt;/td&gt;&lt;td style=&quot;font-family: intel clear;&quot; width=&quot;40%&quot;&gt;Vertical Market : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Consumption_Market__c}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;font-family: intel clear;&quot; width=&quot;40%&quot;&gt;Competitive Architecture: {!$Record.Core_Opportunity_Support__r.Opportunity__r.Core_Competitive_Architecture__c}&lt;/td&gt;&lt;td style=&quot;font-family: intel clear;&quot; width=&quot;40%&quot;&gt;Probability(%) : {!$Record.Core_Opportunity_Support__r.Opportunity__r.Probability}&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table class=&quot;ql-table-blob&quot; style=&quot;font-family: intel clear; border: 1px solid #d3d3d3; padding-left: 50px; padding-top: 5px; padding-bottom: 5px; font-size: 14px;&quot; width=&quot;100%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Opportunity Support Resource Reassignment Details &lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table class=&quot;ql-table-blob&quot; style=&quot;border-collapse: collapse; font-family: intel clear; border: 1px solid #d3d3d3; padding-left: 50px; padding-top: 5px; padding-bottom: 5px; font-size: 14px;&quot; width=&quot;100%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;font-family: intel clear; border: 1px solid #d3d3d3; padding-left: 1%;&quot; width=&quot;40%&quot;&gt;&lt;b&gt;Assigner &lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding-left: 1%; border: 1px solid #d3d3d3; font-family: intel clear;&quot; width=&quot;40%&quot;&gt;&lt;b&gt;{!$Record.LastModifiedBy.FirstName} {!$Record.LastModifiedBy.LastName}&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding-left: 1%; font-family: intel clear; border: 1px solid #d3d3d3;&quot; width=&quot;40%&quot;&gt;&lt;b&gt;CSA Resource Reassigned &lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding-left: 1%; font-family: intel clear; border: 1px solid #d3d3d3;&quot; width=&quot;40%&quot;&gt;&lt;b&gt; {!$Record.Core_Opportunity_Support_Team_Member__r.FirstName} {!$Record.Core_Opportunity_Support_Team_Member__r.LastName}&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding-left: 1%; font-family: intel clear; border: 1px solid #d3d3d3;&quot; width=&quot;40%&quot;&gt;&lt;b&gt;Accepted/Rejected Notes&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding-left: 1%; font-family: intel clear;&quot; width=&quot;40%&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table class=&quot;ql-table-blob&quot; style=&quot;border: 1px solid #d3d3d3; padding-left: 50px; padding-top: 5px; padding-bottom: 5px; font-size: 20px;&quot; width=&quot;100%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;p style=&quot;text-align: center; font-size: 12px;&quot;&gt;This message was sent to you as an important business communication related to your current relationship with Intel Corporation&lt;br /&gt;©{!currentYear} Intel Corporation&lt;br /&gt;Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054 USA.&lt;a href=&quot;http://www.intel.com&quot;&gt;www.intel.com&lt;/a&gt;&lt;br /&gt;&lt;a href=&quot;http://www.intel.com/privacy&quot;&gt;Privacy&lt;/a&gt; | &lt;a href=&quot;http://www.intel.com/cookies&quot;&gt;Cookies&lt;/a&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;</text>
    </textTemplates>
</Flow>
