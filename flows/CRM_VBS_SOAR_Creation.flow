    <decisions>
        <name>check_Contract_fields_are_null</name>
        <label>check Contract fields are null</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>create_new_SOAR_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_Contract_fields_not_Null</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Contract_Start_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Contract_Lifetime_in_Months__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Total_Contract_Value__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Annual_Recurring_Revenue__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_VBS_fields_to_Null</targetReference>
            </connector>
            <label>if Contract fields not Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_for_VBS_condition</name>
        <label>check for VBS condition</label>
        <locationX>501</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>getSoar_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>create_VBS_records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Potential__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Potential__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Coverage_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel-Led Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>check_Contract_fields_are_null</targetReference>
            </connector>
            <label>create VBS records</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_If_STM_is_not_Opp_owner</name>
        <label>check If STM is not Opp owner</label>
        <locationX>402</locationX>
        <locationY>2411</locationY>
        <defaultConnector>
            <targetReference>share_STM_to_OPP</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>STM_user_not_Opp_owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>share_STM_to_OPP.CRM_VBS_Team_member__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_STM_to_Opp_share</targetReference>
            </connector>
            <label>STM user not Opp owner</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_QB_have_access_To_Opp</name>
