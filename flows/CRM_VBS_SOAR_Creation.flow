            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SOARteam.CRM_VBS_User_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Opportunity_Team_Members.Core_User_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
