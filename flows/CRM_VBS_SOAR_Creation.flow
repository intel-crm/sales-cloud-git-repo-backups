    <description>copy SOAR product and team to SOAR record</description>
    <environments>Default</environments>
    <interviewLabel>CRM VBS Process {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CRM VBS SOAR Creation</label>
    <loops>
        <name>Loop_Opportunity_Team_Members</name>
        <label>Loop Opportunity Team Members</label>
        <locationX>182</locationX>
        <locationY>1271</locationY>
        <collectionReference>Get_Opportunity_Team_Members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Opp_Team_Members_to_Soar_Team</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_SOAR_Team</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>share_STM_to_OPP</name>
        <label>share STM to OPP</label>
        <locationX>182</locationX>
        <locationY>2303</locationY>
        <collectionReference>get_SOAR_team</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>check_If_STM_is_not_Opp_owner</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>share_STM_to_Opps</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>create_new_SOAR_record</name>
        <label>create new SOAR record</label>
        <locationX>182</locationX>
        <locationY>731</locationY>
        <connector>
            <targetReference>Get_SOAR_Rec</targetReference>
        </connector>
        <inputAssignments>
            <field>CRM_VBS_Opportunity_Region__c</field>
            <value>
                <elementReference>$Record.Owner.Core_User_Geo__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_SOAR_Opportunity__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_SOAR_Stage__c</field>
            <value>
                <stringValue>SOAR1 - Qualification/Sign-On</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.Owner.Id</elementReference>
            </value>
        </inputAssignments>
        <object>CRM_VBS_SOAR__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_New_Technical_owner</name>
        <label>Create New Technical owner</label>
        <locationX>534</locationX>
        <locationY>1079</locationY>
        <connector>
            <targetReference>Opportunity_Owner_Change</targetReference>
        </connector>
        <inputReference>CreatetechnicalOwner</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_SOAR_Team</name>
        <label>Create SOAR Team</label>
        <locationX>182</locationX>
        <locationY>1679</locationY>
        <connector>
            <targetReference>check_QB_have_access_To_Opp</targetReference>
        </connector>
        <inputReference>SOARTeamCollection</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Opp_Share</name>
        <label>Opp Share</label>
        <locationX>50</locationX>
        <locationY>3011</locationY>
        <connector>
            <targetReference>Update_Bypass_to_false</targetReference>
        </connector>
        <inputReference>OppShareList</inputReference>
    </recordCreates>
    <recordDeletes>
        <description>Delete SOAR team which is copied from Opportunity Team while creating the SOAR record</description>
        <name>Delete_SOAR_TC</name>
        <label>Delete SOAR TC</label>
        <locationX>666</locationX>
        <locationY>755</locationY>
        <connector>
            <targetReference>Technical_Owner_Change_0</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_Is_Copy_OTM__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>CRM_VBS_Team_member__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.Core_Technical_Owner__c</elementReference>
            </value>
        </filters>
        <object>CRM_VBS_SOAR_Team__c</object>
    </recordDeletes>
    <recordDeletes>
        <description>Delete SOAR team which is copied from Opportunity Team while creating the SOAR record</description>
