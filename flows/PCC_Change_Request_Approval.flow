<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Approve_Change_Request</name>
        <label>Approve Change Request</label>
        <locationX>534</locationX>
        <locationY>842</locationY>
        <actionName>PCC_ChangeRequestApproval</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Update_Triggering_Change_Request</targetReference>
        </connector>
        <faultConnector>
            <targetReference>create_log_entry</targetReference>
        </faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>changeRequestId</name>
            <value>
                <elementReference>RecordId.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>PCC_ChangeRequestApproval</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>addResult</assignToReference>
            <name>addResults</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>cancelResult</assignToReference>
            <name>canceledResults</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>Results</assignToReference>
            <name>changedResults</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Change_Request_Validity</name>
        <label>Change Request Validity</label>
        <locationX>534</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Approve_Change_Request</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Eligible_for_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RecordId.Pending_Product_Count__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pending_Line_Items</targetReference>
            </connector>
            <label>Eligible for Approval</label>
        </rules>
        <rules>
            <name>Check_Approved_Products</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RecordId.PCC_Approved_Products_Count__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Approved_Lines</targetReference>
            </connector>
            <label>Check Approved Products</label>
        </rules>
        <rules>
            <name>Unauthorized_Access</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ApproverUserId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$User.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Delegated_Approver_User</targetReference>
            </connector>
            <label>Unauthorized Access</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Delegated_Approver_Exists</name>
        <label>Check if Delegated Approver Exists</label>
        <locationX>666</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Unauthorized_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_Delegated_Approver</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Delegated_Approver_User</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approve_Change_Request</targetReference>
            </connector>
            <label>is Delegated Approver?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ApexResponsecombined</name>
        <dataType>String</dataType>
        <expression>&apos;Add Result :&apos;+{!addResult}+&apos; Cancel Result :&apos;+{!cancelResult}+&apos; Change Result :&apos;+{!Results}</expression>
    </formulas>
    <formulas>
        <name>ApproverUserId</name>
        <dataType>String</dataType>
        <expression>LEFT({!RecordId.PCC_Change_Request_Approver__c}, 15)</expression>
    </formulas>
    <interviewLabel>Change Request Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Change Request Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>create_log_entry</name>
        <label>create log entry</label>
        <locationX>1458</locationX>
        <locationY>950</locationY>
        <connector>
            <targetReference>Approval_Error</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <stringValue>Exception occurred in Change Request Approval</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>PCC Deal : Change request Approval</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Delegated_Approver_User</name>
        <label>Get Delegated Approver User</label>
        <locationX>666</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Delegated_Approver_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DelegatedApproverId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Triggering_Change_Request</name>
        <label>Update Triggering Change Request</label>
        <locationX>534</locationX>
        <locationY>950</locationY>
        <connector>
            <targetReference>ApprovalScreen</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>create_log_entry</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RecordId.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PCC_Approval_Status__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PCC_Transaction_Information_Message__c</field>
            <value>
                <elementReference>ApexResponsecombined</elementReference>
            </value>
        </inputAssignments>
        <object>PCC_Deal_Change_Request__c</object>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
