<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_it_Already_Share</name>
        <label>Is it Already Share?</label>
        <locationX>182</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Yes Shared</defaultConnectorLabel>
        <rules>
            <name>No_Not_Shared</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sharing_Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Share_the_Record_With_6Sense</targetReference>
            </connector>
            <label>No Not Shared</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_it_Valid_Sharing</name>
        <label>Is it Valid Sharing?</label>
        <locationX>446</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Unshared_If_Shared</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Valid Share</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid_Share</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Is_6Sense_Integration_Enabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Consumption_Market__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Government</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Coverage_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel-Led Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Military_Aerospace_Govmt_End_Use__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Consumption_Market__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Federal and Aerospace</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_it_Already_Share</targetReference>
            </connector>
            <label>Yes Valid Share</label>
        </rules>
    </decisions>
    <decisions>
        <name>Unshared_If_Shared</name>
        <label>Unshared If Shared</label>
        <locationX>710</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>No Skip It</defaultConnectorLabel>
        <rules>
            <name>Yes_Deleting_Sharing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sharing_Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Unshared_Sharing</targetReference>
            </connector>
            <label>Yes Deleting Sharing</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>SWS Share Opportunity With 6Sense {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SWS Share Opportunity With 6Sense</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Share_the_Record_With_6Sense</name>
        <label>Share the Record With 6Sense</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <inputAssignments>
            <field>OpportunityAccessLevel</field>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OpportunityId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RowCause</field>
            <value>
                <stringValue>Manual</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UserOrGroupId</field>
            <value>
                <elementReference>Get_6Sense_Group.Id</elementReference>
            </value>
        </inputAssignments>
        <object>OpportunityShare</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordDeletes>
        <name>Unshared_Sharing</name>
        <label>Unshared Sharing</label>
        <locationX>578</locationX>
        <locationY>755</locationY>
        <inputReference>Get_Sharing_Record</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>Get_6Sense_Group</name>
        <label>Get 6Sense Group</label>
        <locationX>446</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Sharing_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>SWS_6Sense_Admin_Group</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Sharing_Record</name>
        <label>Get Sharing Record</label>
        <locationX>446</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_it_Valid_Sharing</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>UserOrGroupId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_6Sense_Group.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityShare</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_6Sense_Group</targetReference>
        </connector>
        <filterFormula>AND(
    OR(
        ISCHANGED({!$Record.OwnerId}),
        ISCHANGED({!$Record.AccountId}),
        ISCHANGED({!$Record.Core_Military_Aerospace_Govmt_End_Use__c}),
        ISCHANGED({!$Record.Core_Consumption_Market__c}),
        ISNEW()
    ),
    {!$Record.Account.Core_Export_Compliance_Block__c} = false,
    ISBLANK({!$Record.Core_Design_Registration_Id__c}),
    ISPICKVAL({!$Record.Core_Opportunity_Coverage_Nm__c}, &apos;Intel-Led Opportunity&apos;)
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
