    <decisions>
        <name>Decide_which_email_to_trigger</name>
        <label>Decide which email to trigger</label>
        <locationX>448</locationX>
        <locationY>386</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>MDF_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Isnew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Project__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Consolidated Co-Marketing Program (CCP)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Severity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Critical</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Trigger_Error_Notification</targetReference>
            </connector>
            <label>MDF Outcome</label>
        </rules>
        <rules>
            <name>IPS_Outcome</name>
            <conditionLogic>1 AND 2 AND (3 OR 4 OR 5) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Project__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IPS Cloud</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Severity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Error</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_sObjectType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>sf:Case</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_sObjectType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>sf:Core_IPS_Case_Comments__c</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_sObjectType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>sf:Core_IPS_Case_Attachments__c</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Support_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_IPS_Case_BK_PromoteUpdate_Failure_Notify</targetReference>
            </connector>
            <label>IPS Outcome</label>
        </rules>
    </decisions>
