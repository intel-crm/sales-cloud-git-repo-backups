    <recordUpdates>
        <name>Update_Existing_Record_Status_to_New</name>
        <label>Update Existing Record Status to New</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_10</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_entry_record_Creation</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Existing_ACM_Integration_Message_Queue_record.Id</elementReference>
