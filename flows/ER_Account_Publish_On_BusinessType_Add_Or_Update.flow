    <recordLookups>
        <name>Get_Existing_ACM_Integration_Message_Queue_record</name>
        <label>Get Existing ACM Integration Message Queue record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_existing_ACM_Integration_Message_Queue_Record_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Content_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Label.ER_ACM_Content_AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Custom_Filter__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Module_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Label.ER_ACM_Module_Name</elementReference>
            </value>
        </filters>
        <filters>
            <field>Queue_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Outbound</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ACM_Integration_Message_Queue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
