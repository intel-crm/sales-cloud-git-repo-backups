<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_status_to_approved</name>
        <label>Set status to approved</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_Design_Product_Status_Nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_PricingStartDate_PricingEndDate_Null</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>FPGA</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Intel® FPGAs</stringValue>
        </value>
    </constants>
    <constants>
        <name>PDI</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PDI</stringValue>
        </value>
    </constants>
    <constants>
        <name>RecordType_Developer_Name</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Deal</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_PricingStartDate_PricingEndDate_Null</name>
        <label>PricingStartDate_PricingEndDate_Null?</label>
        <locationX>182</locationX>
        <locationY>587</locationY>
        <defaultConnector>
            <targetReference>CheckProduct</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PSD_PED_Not_Null</name>
            <conditionLogic>1 AND 2 AND 3 AND 4 AND 5 AND 6 AND 7</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.PCC_Pricing_Start_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.PCC_Pricing_End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CheckPricingStartDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CheckPricingEndDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Product_Additional_Attribute__r.Programs_Eligible__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>PDI</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsCreate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PSD_PED_On_DRP</targetReference>
            </connector>
            <label>PSD_PED_Not_Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckProduct</name>
        <label>Check Product</label>
        <locationX>182</locationX>
        <locationY>887</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Populate_Product</name>
            <conditionLogic>1 AND 2 AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Product_Additional_Attribute__r.Product__r.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Product_Additional_Attribute__r.Product__r.Core_Sales_Visible_Flag__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Product_Additional_Attribute__r.Product__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.RecordType.DeveloperName</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>RecordType_Developer_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateProdDetailonDRPlookup</targetReference>
            </connector>
            <label>Populate_Product</label>
        </rules>
    </decisions>
    <decisions>
        <name>Resubmission_scenario</name>
        <label>Deal Resubmission scenario?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Check_PricingStartDate_PricingEndDate_Null</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>3 AND 2 AND (1 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Deal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsCreate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Re-Submitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_status_to_approved</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CheckPricingEndDate</name>
        <dataType>Boolean</dataType>
        <expression>IF(AND(({!$Record.Core_Design_Registration_Id__r.PCC_Pricing_End_Date__c}&gt;=TODAY()) , ({!$Record.Core_Design_Registration_Id__r.PCC_Pricing_End_Date__c}&gt;={!$Record.Core_Design_Registration_Id__r.PCC_Pricing_Start_Date__c})),TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>CheckPricingStartDate</name>
        <dataType>Boolean</dataType>
        <expression>IF(AND(({!$Record.Core_Design_Registration_Id__r.PCC_Pricing_Start_Date__c}&gt;=TODAY()), ({!$Record.Core_Design_Registration_Id__r.PCC_Pricing_Start_Date__c})&lt;={!$Record.Core_Design_Registration_Id__r.PCC_Pricing_End_Date__c}) , TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>IsCreate</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Update Product Id For Deal Products {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Product Id For Deal Products</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_PSD_PED_On_DRP</name>
        <label>Update PSD_PED_On_DRP</label>
        <locationX>50</locationX>
        <locationY>695</locationY>
        <connector>
            <targetReference>CheckProduct</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PCC_Quote_Line_Pricing_Start_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PCC_Quote_Line_Pricing_End_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>PCC_Quote_Line_Pricing_End_Date__c</field>
            <value>
                <elementReference>$Record.Core_Design_Registration_Id__r.PCC_Pricing_End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PCC_Quote_Line_Pricing_Start_Date__c</field>
            <value>
                <elementReference>$Record.Core_Design_Registration_Id__r.PCC_Pricing_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateProdDetailonDRPlookup</name>
        <label>Update Prod Detail on DRP lookup</label>
        <locationX>50</locationX>
        <locationY>995</locationY>
        <inputAssignments>
            <field>Core_Product_Id__c</field>
            <value>
                <elementReference>$Record.PCC_Product_Additional_Attribute__r.Product__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Resubmission_scenario</targetReference>
        </connector>
        <filterFormula>AND(NOT({!$Permission.PCC_Bypass_Automation}),
NOT(ISBLANK({!$Record.PCC_Product_Additional_Attribute__c})))</filterFormula>
        <object>Core_Design_Registration_Product__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
