    <assignments>
        <name>Assign_approval_status</name>
        <label>Assign approval status</label>
        <locationX>842</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>recordId.SWS_Approval_status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recordId.SWS_Request_Status__c</assignToReference>
