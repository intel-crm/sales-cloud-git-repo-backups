    <decisions>
        <name>Check_User_and_Approver</name>
        <label>Check User and Approver</label>
        <locationX>710</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>User_and_Approver_different</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_user_ID.Id</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>recordId.SWS_Approver__r.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submission_Comments</targetReference>
            </connector>
            <label>User and Approver different</label>
        </rules>
        <rules>
            <name>User_and_approver_same</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_user_ID.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>recordId.SWS_Approver__r.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bypass_Validation</targetReference>
            </connector>
            <label>User and approver same</label>
        </rules>
    </decisions>
    <decisions>
        <name>Request_validation</name>
        <label>Request validation</label>
        <locationX>1304</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MISSINGREQUIREDFIELDS</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_user_ID</targetReference>
            </connector>
            <label>Valid Request</label>
        </rules>
        <rules>
            <name>Not_Valid_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MISSINGREQUIREDFIELDS</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Missing_Fields</targetReference>
            </connector>
            <label>Not Valid Request</label>
        </rules>
    </decisions>
