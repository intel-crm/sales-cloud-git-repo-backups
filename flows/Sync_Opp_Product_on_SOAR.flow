<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>OLI_Status_Cancelled</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Cancelled</stringValue>
        </value>
    </constants>
    <constants>
        <name>OLI_Status_Deleteinprogress</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Delete In Progress (&lt;15 min)</stringValue>
        </value>
    </constants>
    <constants>
        <name>OLI_Status_lost</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Lost</stringValue>
        </value>
    </constants>
    <constants>
        <name>OLI_Status_OnHold</name>
        <dataType>String</dataType>
        <value>
            <stringValue>On Hold</stringValue>
        </value>
    </constants>
    <constants>
        <name>OLI_Status_Pending</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Pending </stringValue>
        </value>
    </constants>
    <constants>
        <name>Status_OLI_PostWin</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Post-Win</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_SOAR</name>
        <label>Check SOAR</label>
        <locationX>809</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_SOAR_Rec_Attached</name>
            <conditionLogic>(1 OR 2 ) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR1 Qualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_VBS_Potential__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_Opportunity_Coverage_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel-Led Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_SOAR_Record</targetReference>
            </connector>
            <label>Is SOAR Rec Attached</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_2</name>
        <label>OLI Status Check</label>
        <locationX>512</locationX>
        <locationY>600</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>StatusequalstoPendingOnholdandPostwin</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Hold</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Post-Win</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_the_Product_is_present_on_the_SOAR</targetReference>
            </connector>
            <label>Status equals to Pending , On hold and Post win</label>
        </rules>
        <rules>
            <name>Status_equals_to_Lost_Cancelled_and_Delete_In_Progress</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delete In Progress (&lt;15 min)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Records_1</targetReference>
            </connector>
            <label>Status equals to Lost , Cancelled and Delete In Progress</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_the_Product_is_present_on_the_SOAR</name>
        <label>If the Product is present on the SOAR</label>
        <locationX>182</locationX>
        <locationY>708</locationY>
        <defaultConnector>
            <targetReference>Create_Records_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_SOAR_Product.CRM_VBS_Opportunity_Product__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_SOAR_Product</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CheckIsNewProduct</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Sync Opp Product on SOAR {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sync Opp Product on SOAR</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Records_1</name>
        <label>Create SOAR Records</label>
        <locationX>314</locationX>
        <locationY>816</locationY>
        <inputAssignments>
            <field>CRM_VBS_Opportunity_Product__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Product__c</field>
            <value>
                <elementReference>$Record.Product2Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Quantity__c</field>
            <value>
                <elementReference>$Record.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_SOAR__c</field>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_UnitPrice__c</field>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Vendor__c</field>
            <value>
                <elementReference>$Record.Core_Vendor__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Write_In_Product_Name__c</field>
            <value>
                <elementReference>$Record.Core_Write_In_Product_Name__c</elementReference>
            </value>
        </inputAssignments>
        <object>CRM_VBS_Product__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordDeletes>
        <name>Delete_Records_1</name>
        <label>Delete Records 1</label>
        <locationX>578</locationX>
        <locationY>708</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_Opportunity_Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CRM_VBS_SOAR__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </filters>
        <object>CRM_VBS_Product__c</object>
    </recordDeletes>
    <recordLookups>
        <name>Get_SOAR_Product</name>
        <label>Get SOAR Product</label>
        <locationX>512</locationX>
        <locationY>492</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_2</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_Opportunity_Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CRM_VBS_SOAR__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_Product__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_SOAR_Record</name>
        <label>Get SOAR Record</label>
        <locationX>512</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_SOAR_Product</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_SOAR_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_SOAR_Product</name>
        <label>Update SOAR Product</label>
        <locationX>50</locationX>
        <locationY>816</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOAR_Product.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CRM_VBS_Quantity__c</field>
            <value>
                <elementReference>$Record.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_UnitPrice__c</field>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Vendor__c</field>
            <value>
                <elementReference>$Record.Core_Vendor__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Write_In_Product_Name__c</field>
            <value>
                <elementReference>$Record.Core_Write_In_Product_Name__c</elementReference>
            </value>
        </inputAssignments>
        <object>CRM_VBS_Product__c</object>
    </recordUpdates>
    <start>
        <locationX>171</locationX>
        <locationY>0</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Quantity</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>UnitPrice</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Vendor__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Write_In_Product_Name__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Check_SOAR</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
