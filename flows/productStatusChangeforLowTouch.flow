<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Update_all_other_OLI_to_Cancelled</name>
        <label>Update all other OLI to Cancelled</label>
        <locationX>490</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>Iterate_through_each_Opportunity.Core_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Production Cancelled</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OLIStatus</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Iterate_through_each_Opportunity</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_through_each_Opportunity</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_SalesLostPrice_is_updated</name>
        <label>Check if SalesLostPrice is updated</label>
        <locationX>798</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>SP_0_PSP_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>For PL/PC</defaultConnectorLabel>
        <rules>
            <name>For_L_C</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lost_Sales_Price__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_PW_Lost_Price__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SP_0_PSP_blank</targetReference>
            </connector>
            <label>For L/C</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opportunity_Product_Status_Change</name>
        <label>Opportunity Product Status Change</label>
        <locationX>974</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Low_Touch_Admin</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.CRM_IsLowTouchAdmin_Chk__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PW_Approval_Details</targetReference>
            </connector>
            <label>Is Low Touch Admin</label>
        </rules>
    </decisions>
    <decisions>
        <name>Update_PW_Approval_Details</name>
        <label>Update PW Approval Details</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Oppty_is_PWA_Update_OLI_PW_Approval_Details</name>
            <conditionLogic>1 AND (2 OR 3 OR 4) AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Opportunity_Production_Win_Approval_Details</targetReference>
            </connector>
            <label>Oppty is PWA. Update OLI PW Approval Details</label>
        </rules>
        <rules>
            <name>Opportunity_is_in_Open_Stages</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4) AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualify</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Define</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Develop</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_OLIs_based_on_this_opp_id</targetReference>
            </connector>
            <label>Opportunity is in Open Stages</label>
        </rules>
        <rules>
            <name>PL_PC_L_C_PL_PC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lost_Price</targetReference>
            </connector>
            <label>!(PL/PC/L/C)-&gt;PL/PC</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>productStatusChangeforLowTouch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>productStatusChangeforLowTouch</label>
    <loops>
        <name>Iterate_through_each_Opportunity</name>
        <label>Iterate through each Opportunity</label>
        <locationX>402</locationX>
        <locationY>647</locationY>
        <collectionReference>Get_OLIs_based_on_this_opp_id</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_all_other_OLI_to_Cancelled</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_OLI_status_to_Cancelled</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the OLIs</description>
        <name>Get_OLIs_based_on_this_opp_id</name>
        <label>Get OLIs based on this opp id</label>
        <locationX>402</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Iterate_through_each_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Production Win Approved</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Opportunity_to_PW</name>
        <label>Opportunity to PW</label>
        <locationX>402</locationX>
        <locationY>1055</locationY>
        <connector>
            <targetReference>SP_0_PSP_0</targetReference>
        </connector>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Production Win</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Opportunity</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>SP_0_PSP_0</name>
        <label>SP=0|PSP=0</label>
        <locationX>578</locationX>
        <locationY>1247</locationY>
        <inputAssignments>
            <field>Core_Loss_Cancel_Details__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Loss_Cancel_Reason__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Sales_Price__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Production_Claim_Date__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>UnitPrice</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>SP_0_PSP_blank</name>
        <label>SP=0 |PSP = blank</label>
        <locationX>666</locationX>
        <locationY>755</locationY>
        <inputAssignments>
            <field>Core_PW_Sales_Price__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>UnitPrice</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Lost_Price</name>
        <label>Update Lost Price</label>
        <locationX>798</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Check_if_SalesLostPrice_is_updated</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Lost_Sales_Price__c</field>
            <value>
                <elementReference>$Record__Prior.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Lost_Price__c</field>
            <value>
                <elementReference>$Record__Prior.Core_PW_Sales_Price__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_OLI_status_to_Cancelled</name>
        <label>Update OLI status to Cancelled</label>
        <locationX>402</locationX>
        <locationY>947</locationY>
        <connector>
            <targetReference>Opportunity_to_PW</targetReference>
        </connector>
        <inputReference>OLIStatus</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>For: Core_OppProd_Save_Key_Values_For_PW</description>
        <name>Update_the_Opportunity_Production_Win_Approval_Details</name>
        <label>Update the Opportunity Production Win Approval Details</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <inputAssignments>
            <field>Core_Approved_Decision_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Claim_Date__c</field>
            <value>
                <elementReference>$Record.Core_Production_Claim_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_BU_Product_Segment__c</field>
            <value>
                <elementReference>$Record.Core_BU_Product_Segment__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_BU_Short_Name__c</field>
            <value>
                <elementReference>$Record.Core_BU_Short_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_By__c</field>
            <value>
                <stringValue>{!$Record.LastModifiedBy.FirstName+$Record.LastModifiedBy.LastName}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Commissionable__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Commissionable__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_KPI_Product_Group__c</field>
            <value>
                <elementReference>$Record.Core_KPI_Product_Group__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Prime_Account_Name__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Opp_Prime_Account_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Quantity__c</field>
            <value>
                <elementReference>$Record.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Sales_Group__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Sales_Groups__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Sales_Price__c</field>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Approved_Total_Price__c</field>
            <value>
                <elementReference>$Record.TotalPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PW_Manager_Approved_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Approved_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Production_Claim_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>848</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Opportunity_Product_Status_Change</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>OLIStatus</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityLineItem</objectType>
    </variables>
</Flow>
