<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Region_field_update</name>
        <label>Region field update</label>
        <locationX>547</locationX>
        <locationY>823</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_Geo__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>get_Regions_from_Country.Core_Geo__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_country_update</name>
        <label>Check country update</label>
        <locationX>572</locationX>
        <locationY>371</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>country_value_updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Address__CountryCode__s</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_Regions_from_Country</targetReference>
            </connector>
            <label>country value updated</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Account Request Queue Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Request Queue Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
