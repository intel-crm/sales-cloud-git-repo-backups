    <decisions>
        <name>Check_if_PSAM_is_Opportunity_owner</name>
        <label>Check if PSAM is Opportunity owner</label>
        <locationX>2338</locationX>
        <locationY>1295</locationY>
        <defaultConnector>
            <targetReference>Create_opportunity_team_member</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpptyOwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_deal_details.Core_Partner_Account_Id__r.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_group_id_for_partner_s_role</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
