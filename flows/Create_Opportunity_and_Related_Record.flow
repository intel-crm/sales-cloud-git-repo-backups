    <recordUpdates>
        <description>update rejected drp as lock</description>
        <name>update_Rejected_DRP_Lock</name>
        <label>update Rejected DRP Lock</label>
        <locationX>2338</locationX>
        <locationY>1811</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Get_all_DRPs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Design_Registration_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Design_Product_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Locked_Ind__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Core_Design_Registration_Product__c</object>
    </recordUpdates>
