    <recordCreates>
        <name>Create_Opportunity_Partner</name>
        <label>Create Opportunity Partner</label>
        <locationX>2338</locationX>
        <locationY>1187</locationY>
        <connector>
            <targetReference>Check_if_PSAM_is_Opportunity_owner</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Opportunity__c</field>
            <value>
                <elementReference>OpportunityId</elementReference>
            </value>
