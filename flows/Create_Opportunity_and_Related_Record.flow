    <description>This is test flow</description>
    <environments>Default</environments>
    <formulas>
        <name>closeDateFormula</name>
        <dataType>Date</dataType>
        <expression>IF (OR(ISBLANK({!Get_deal_details.Core_Opportunity_Decision_Dt__c}) , {!Get_deal_details.Core_Opportunity_Decision_Dt__c} &lt; TODAY()),
TODAY()
,
{!Get_deal_details.Core_Opportunity_Decision_Dt__c}
)</expression>
    </formulas>
    <formulas>
        <name>currentyear</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(TODAY()))</expression>
    </formulas>
    <formulas>
        <name>descFormula</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!Get_deal_details.Core_FPGA_Quote_Comments_Txt__c}),
{!Get_deal_details.PCC_Deal_Description__c},
&apos;Description:&apos;&amp; SUBSTITUTE({!LineBreak}, &apos;~&apos;, &apos;&apos;)&amp;
&apos;---------------&apos;&amp; SUBSTITUTE({!LineBreak}, &apos;~&apos;, &apos;&apos;)
&amp;{!Get_deal_details.PCC_Deal_Description__c}&amp;SUBSTITUTE({!LineBreak}, &quot;~&quot;, &quot;&quot;)&amp;SUBSTITUTE({!LineBreak}, &quot;~&quot;, &quot;&quot;)&amp;
&apos;FPGA Quote Comments:&apos;&amp; SUBSTITUTE({!LineBreak}, &quot;~&quot;, &quot;&quot;)&amp;
&apos;------------------------------&apos;&amp; SUBSTITUTE({!LineBreak}, &quot;~&quot;, &quot;&quot;) 
&amp;{!Get_deal_details.Core_FPGA_Quote_Comments_Txt__c}
)</expression>
    </formulas>
    <formulas>
        <name>EmailTableRowForApproval</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;tr&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!IterateOverDealDRP.Name}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!IterateOverDealDRP.Core_Product_Id__r.Name}+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + TEXT({!IterateOverDealDRP.Core_Design_Product_Status_Nm__c})+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!IterateOverDealDRP.Core_Comment_Txt__c}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px ; width:150px;&quot;&gt;&apos; + TEXT({!IterateOverDealDRP.CreatedDate})+ 
&apos;&lt;/td&gt;&lt;/tr&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>OpportunityName</name>
        <dataType>String</dataType>
        <expression>{!Get_deal_details.Core_Design_Registration_Nm__c} &amp; &apos;  &apos;&amp;SUBSTITUTE(SUBSTITUTE( SUBSTITUTE(SUBSTITUTE(TEXT(NOW()), &apos;-&apos;, &apos;&apos;), &apos;:&apos;, &apos;&apos;),&apos;Z&apos;,&apos;&apos; ),&apos; &apos;,&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>OpptyOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_deal_details.Core_Intel_Technical_Owner_Id__c}),
{!$User.Id},
{!Get_deal_details.Core_Intel_Technical_Owner_Id__c}
)</expression>
    </formulas>
    <formulas>
        <name>salesGroupFormula</name>
        <dataType>String</dataType>
        <expression>IF (ISPICKVAL({!Get_deal_details.Core_Product_Group_Nm__c} , &apos;FPGA/Power&apos;),
&apos;PSG Sales&apos;,
&apos;Regional Sales&apos;
)</expression>
    </formulas>
    <formulas>
        <name>statusUpdateFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Converted from DDR -&apos;&amp;{!Get_deal_details.Name}</expression>
    </formulas>
