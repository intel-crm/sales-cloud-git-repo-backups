<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>uses the Opporuntiy Approval process &quot; Core_Opp_Approval &quot;</description>
        <name>Opp_Approval</name>
        <label>Opp Approval</label>
        <locationX>236</locationX>
        <locationY>1105</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <connector>
            <targetReference>Assign_Price_Book</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>Core_Opp_Approval</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>submitterId</name>
            <value>
                <elementReference>$Record.Core_Technical_Owner__r.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>submit</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>constant_StandardPriceBook</name>
        <dataType>String</dataType>
        <value>
            <stringValue>01so0000002PRqUAAW</stringValue>
        </value>
    </constants>
    <decisions>
        <description>for the PB &quot; Assign Price Book &quot;</description>
        <name>Assign_Price_Book</name>
        <label>Assign Price Book</label>
        <locationX>587</locationX>
        <locationY>1233</locationY>
        <defaultConnector>
            <targetReference>UpdateApprovedProductApplicationOnProd</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_for_Channel_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Channel_Opportunity_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Standard_Price_Book</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Check for Channel Opportunity</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_Opportunity_AtRisk_Update</name>
        <label>Core_Opportunity_AtRisk_Update</label>
        <locationX>578</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Update_Loss_Cancel_From_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product_AtRisk_Greater_Than_Zero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Products_At_Risk_Count__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Products_At_Risk_Count__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OpportunityAtRisk_True</targetReference>
            </connector>
            <label>Product_AtRisk_Greater_Than_Zero</label>
        </rules>
        <rules>
            <name>Product_AtRisk_Count_Zero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Products_At_Risk_Count__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Products_At_Risk_Count__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OpportunityAtRisk_False</targetReference>
            </connector>
            <label>Product_AtRisk_Count_Zero</label>
        </rules>
    </decisions>
    <decisions>
        <description>For the PB &quot; Submit Opportunity For Approval &quot;</description>
        <name>Submit_Opportunity_For_Approval</name>
        <label>Submit Opportunity For Approval</label>
        <locationX>589</locationX>
        <locationY>966</locationY>
        <defaultConnector>
            <targetReference>Assign_Price_Book</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Submit_For_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Submit_For_Approval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Submit_For_Approval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opp_Approval</targetReference>
            </connector>
            <label>Submit For Approval?</label>
        </rules>
    </decisions>
    <decisions>
        <description>For the PB &quot; Update Loss Cancel From Opportunity &quot;</description>
        <name>Update_Loss_Cancel_From_Opportunity</name>
        <label>Update Loss Cancel From Opportunity</label>
        <locationX>578</locationX>
        <locationY>561</locationY>
        <defaultConnector>
            <targetReference>Submit_Opportunity_For_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Stage_Lost_Cancelled</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Loss_Cancel_Reason_for_Loss_and_Cancelled</targetReference>
            </connector>
            <label>Is Stage Lost Cancelled</label>
        </rules>
        <rules>
            <name>Is_Stage_Prod_Lost</name>
            <conditionLogic>(1 OR 2 ) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Loss_Cancel_Reason_for_Pro_Lost</targetReference>
            </connector>
            <label>Is Stage Prod Lost</label>
        </rules>
    </decisions>
    <decisions>
        <description>For UpdateApprovedProductApplicationOnProd  [ Process Builder ]</description>
        <name>UpdateApprovedProductApplicationOnProd</name>
        <label>UpdateApprovedProductApplicationOnProd</label>
        <locationX>590</locationX>
        <locationY>1436</locationY>
        <defaultConnectorLabel>Doesn&apos;t satisfy ?</defaultConnectorLabel>
        <rules>
            <name>Satisfies_UpdateApprovedProductApplicationOnProd</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateOppProduct</targetReference>
            </connector>
            <label>Satisfies UpdateApprovedProductApplicationOnProd ?</label>
        </rules>
    </decisions>
    <description>Has the following PBs--
1. &quot;  Core_Opportunity_AtRisk_Update &quot;                                   [ in 1st DECISION block ]
2.  Update Loss Cancel From Opportunity                                 [ in 2nd DECISION block ]
3. Submit Opportunity For Approval                                         [ in 3rd DECISION block ]
4. Assign Price Book                                                                 [ in 4th DECISION block ]
5. UpdateApprovedProductApplicationOnProd                       [  in 5th DECISION block  ]</description>
    <environments>Default</environments>
    <interviewLabel>Core_Opportunity_PBs {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Opportunity_PBs</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Assign_Standard_Price_Book</name>
        <label>Assign Standard Price Book</label>
        <locationX>1148</locationX>
        <locationY>1236</locationY>
        <connector>
            <targetReference>UpdateApprovedProductApplicationOnProd</targetReference>
        </connector>
        <inputAssignments>
            <field>Pricebook2Id</field>
            <value>
                <elementReference>constant_StandardPriceBook</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>When &quot; Product_AtRisk_Count_Zero &quot; decision part is TRUE</description>
        <name>OpportunityAtRisk_False</name>
        <label>OpportunityAtRisk_False</label>
        <locationX>947</locationX>
        <locationY>353</locationY>
        <connector>
            <targetReference>Update_Loss_Cancel_From_Opportunity</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_At_Risk__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>when &quot; Product_AtRisk_Greater_Than_Zero &quot; decision part is TRUE</description>
        <name>OpportunityAtRisk_True</name>
        <label>OpportunityAtRisk_True</label>
        <locationX>256</locationX>
        <locationY>345</locationY>
        <connector>
            <targetReference>Update_Loss_Cancel_From_Opportunity</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_At_Risk__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>after the previous update do this</description>
        <name>Update_Loss_Cancel_Details_for_Loss_and_Cancelled</name>
        <label>Update Loss Cancel Details for Loss and Cancelled</label>
        <locationX>252</locationX>
        <locationY>892</locationY>
        <connector>
            <targetReference>Submit_Opportunity_For_Approval</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Loss_Cancel_Reason__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Loss_Cancel_Reason__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Loss_Cancel_Reason__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Loss_Cancel_Details__c</field>
            <value>
                <elementReference>$Record.Core_Loss_Cancel_Details__c</elementReference>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordUpdates>
    <recordUpdates>
        <description>when &apos; Is Stage Lost Cancelled &quot; decision is TRUE</description>
        <name>Update_Loss_Cancel_Reason_for_Loss_and_Cancelled</name>
        <label>Update Loss Cancel Reason for Loss and Cancelled</label>
        <locationX>254</locationX>
        <locationY>684</locationY>
        <connector>
            <targetReference>Update_Loss_Cancel_Details_for_Loss_and_Cancelled</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Loss_Cancel_Reason__c</field>
            <value>
                <elementReference>$Record.Core_Loss_Cancel_Reason__c</elementReference>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordUpdates>
    <recordUpdates>
        <description>when the   &quot;  Is Stage Prod Lost &quot;   decision is TRUE</description>
        <name>Update_Loss_Cancel_Reason_for_Pro_Lost</name>
        <label>Update Loss Cancel Reason for Pro Lost</label>
        <locationX>976</locationX>
        <locationY>681</locationY>
        <connector>
            <targetReference>Submit_Opportunity_For_Approval</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Production Lost</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Production Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Delete In Progress (&lt;15 min)</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Lost</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Loss_Cancel_Details__c</field>
            <value>
                <elementReference>$Record.Core_Loss_Cancel_Details__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Loss_Cancel_Reason__c</field>
            <value>
                <elementReference>$Record.Core_Loss_Cancel_Reason__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <elementReference>$Record.StageName</elementReference>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordUpdates>
    <recordUpdates>
        <description>update the related Opplineitems &quot; Core_Approved_Opportunity_Product_App__c &quot; field with &quot; Product Application &quot; from Opportunity</description>
        <name>updateOppProduct</name>
        <label>updateOppProduct</label>
        <locationX>1003</locationX>
        <locationY>1452</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Approved_Opportunity_Product_App__c</field>
            <value>
                <elementReference>$Record.Core_Product_Application__c</elementReference>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordUpdates>
    <start>
        <locationX>458</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Core_Opportunity_AtRisk_Update</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
