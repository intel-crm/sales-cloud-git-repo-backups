<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Increment_Outbound_Count</name>
        <label>Increment Outbound Count</label>
        <locationX>619</locationX>
        <locationY>739</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_IPS_Promote_Count_Outbound__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PromoteOutboundCount</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_FieldChangeFlag</name>
        <label>Set FieldChangeFlag</label>
        <locationX>368</locationX>
        <locationY>491</locationY>
        <assignmentItems>
            <assignToReference>FieldChangeFalg</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_if_Entry_condition_is_satisfied</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_Entry_condition_is_satisfied</name>
        <label>Check if Entry condition is satisfied</label>
        <locationX>606</locationX>
        <locationY>571</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Flow_entry_condition_is_true</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EntryConditionFlag</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increment_Outbound_Count</targetReference>
            </connector>
            <label>Flow entry condition is true</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Description_field_changed</name>
        <label>Is Description field changed</label>
        <locationX>608</locationX>
        <locationY>348</locationY>
        <defaultConnector>
            <targetReference>Check_if_Entry_condition_is_satisfied</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Description_or_Json_field_changed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Issue_Description__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Core_Issue_Description__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_jsonfield__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Core_jsonfield__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_FieldChangeFlag</targetReference>
            </connector>
            <label>Description or Json field changed</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>EntryConditionFlag</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.Core_IPS_Backend_System__c} &lt;&gt; null,
       {!$Record.Core_IPS_Backend_ID__c} &lt;&gt; null, 
       {!$Record.Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c} &lt;&gt; null,
        {!$Record.Core_IPS_Backend_System__r.Core_IPS_Deactivated__c} = false ,
        AND({!$Record.Core_IPS_BK_Flds_UpdatedAt__c} &lt;&gt; {!$Record.Core_IPS_BK_Flds_UpdatedAt_PreVal__c},OR({!FieldChange_Otherfields},{!FieldChangeFalg})) , 
        NOT(ISPICKVAL( {!$Record.Status} , &apos;Closed&apos;)), 
        ({!$Profile.Name} &lt;&gt; &apos;Integration&apos; &amp;&amp; {!$Profile.Name} &lt;&gt; &apos;IPS Data Migration&apos;)) ||
       AND( {!$Record.Core_IPS_Backend_System__c} &lt;&gt; null,
 {!$Record.Core_IPS_Backend_ID__c} &lt;&gt; null, 
 {!$Record.Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c} &lt;&gt; null,
  {!$Record.Core_IPS_Backend_System__r.Core_IPS_Deactivated__c} = false ,
   {!$Record.Core_IPS_Backend_Previous_Status__c} &lt;&gt; null, 
   {!$Record.Core_IPS_Backend_Previous_Status__c} &lt;&gt; &apos;&apos;,
    OR(ISCHANGED({!$Record.Core_IPS_Backend_Previous_Status__c}),
     ISCHANGED({!$Record.Core_Sub_Status__c})) ,
      ({!$Profile.Name} &lt;&gt; &apos;Integration&apos; &amp;&amp; {!$Profile.Name} &lt;&gt; &apos;IPS Data Migration&apos;))</expression>
    </formulas>
    <formulas>
        <description>For field change other than ISsue description and json field</description>
        <name>FieldChange_Otherfields</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISCHANGED({!$Record.Core_Severity__c}),
ISCHANGED({!$Record.Core_CaseType__c}),
ISCHANGED({!$Record.Priority}),
ISCHANGED({!$Record.Subject}),
ISCHANGED({!$Record.Core_Sub_Status__c}),
ISCHANGED({!$Record.Core_IPS_Assigned_Queue__c}),
ISCHANGED({!$Record.Core_IPS_Project_Case__c}),
ISCHANGED({!$Record.Core_IPS_Supported_Product__c}),
ISCHANGED({!$Record.Core_Customer_Reference_ID__c}),
ISCHANGED({!$Record.Core_End_Customer__c}),
ISCHANGED({!$Record.Core_External_Issue_Category__c}),
ISCHANGED({!$Record.Core_External_Issue_Subcategory__c}),
{!$Record.OwnerId}&lt;&gt;{!$Record__Prior.OwnerId},
{!$Record.ProductId}&lt;&gt;{!$Record__Prior.ProductId},
{!$Record.ContactId}&lt;&gt;{!$Record__Prior.ContactId},
{!$Record.AccountId}&lt;&gt;{!$Record__Prior.AccountId})</expression>
    </formulas>
    <formulas>
        <name>PromoteOutboundCount</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.Core_IPS_Promote_Count_Outbound__c}),
1,{!$Record.Core_IPS_Promote_Count_Outbound__c})+1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Core IPS Backend Promotion Outbound Capture {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core IPS Backend Promotion Outbound Capture</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>490</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Is_Description_field_changed</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>FieldChangeFalg</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
