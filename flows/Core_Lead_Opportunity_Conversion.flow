    <description>Update Core_Lead_to_Opportunity_Conversion_flag__c backend field on specific conditions</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Lead].RecordType.Name &lt;&gt; &apos;Partner Lead&apos;,
ISPICKVAL([Lead].Status, &apos;Sales Accepted Lead&apos;),
ISPICKVAL(([Lead].Core_Lead_Status__c), &quot;Disqualified&quot;),
OR(ISCHANGED([Lead].Core_Lead_Status__c),ISCHANGED([Lead].Status))
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;,
ISPICKVAL({!myVariable_current.Status}, &apos;Sales Accepted Lead&apos;),
ISPICKVAL(({!myVariable_current.Core_Lead_Status__c}), &quot;Disqualified&quot;),
OR(ISCHANGED({!myVariable_current.Core_Lead_Status__c}),ISCHANGED({!myVariable_current.Status}))
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Lead].RecordType.Name &lt;&gt; &apos;Partner Lead&apos;,
ISPICKVAL([Lead].Status, &apos;Sales Accepted Lead&apos;),
ISPICKVAL(PRIORVALUE([Lead].Core_Lead_Status__c), &quot;Disqualified&quot;),
ISPICKVAL(([Lead].Core_Lead_Status__c), &quot;Accepted&quot;),
OR(ISCHANGED([Lead].Core_Lead_Status__c),ISCHANGED([Lead].Status))
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;,
ISPICKVAL({!myVariable_current.Status}, &apos;Sales Accepted Lead&apos;),
ISPICKVAL(PRIORVALUE({!myVariable_current.Core_Lead_Status__c}), &quot;Disqualified&quot;),
ISPICKVAL(({!myVariable_current.Core_Lead_Status__c}), &quot;Accepted&quot;),
OR(ISCHANGED({!myVariable_current.Core_Lead_Status__c}),ISCHANGED({!myVariable_current.Status}))
)</expression>
    </formulas>
