<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_Decision_Date_on_Conversion</name>
        <label>Core_Decision_Date_on_Conversion</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Core_Opp_Bypass_Field_Validation_Reset</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AND_ISNEW_Core_Lead_Conversion_Flag_c</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Conversion_Flag__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Close_Date_Today_120</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>AND( ISNEW(), Core_Lead_Conversion_Flag__c )</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_Opp_Bypass_Field_Validation_Reset</name>
        <label>Core_Opp_Bypass_Field_Validation_Reset</label>
        <locationX>182</locationX>
        <locationY>587</locationY>
        <defaultConnector>
            <targetReference>Core_Opp_Clear_Amount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Core_Opp_Bypass_Field_Validation_Reset</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Bypass_Field_Validation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bypass_Field_Validation_False</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Core_Opp_Bypass_Field_Validation_Reset</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_Opp_Clear_Amount</name>
        <label>Core_Opp_Clear_Amount</label>
        <locationX>182</locationX>
        <locationY>887</locationY>
        <defaultConnector>
            <targetReference>Core_Oppty_At_Risk_Created_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Core_Opp_Clear_Amount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Product_Count__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Amount_Null</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Core_Opp_Clear_Amount</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_Oppty_At_Risk_Created_Date</name>
        <label>Core_Oppty_At_Risk_Created_Date</label>
        <locationX>182</locationX>
        <locationY>1187</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ISCHANGED_Core_Risk_Reason_c</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Risk_Reason__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>At_Risk_Created_Date_today</targetReference>
            </connector>
            <label>ISCHANGED( Core_Risk_Reason__c )</label>
        </rules>
    </decisions>
    <description>Has a list of Wfs that are unique ( updates different fields for different scenarios ) :

1. Core_Decision_Date_on_Conversion

2. Core_Opp_Add_Prime_Account_Name

3. Core_Opp_Bypass_Field_Validation_Reset

4. Core_Opp_Clear_Amount

 5.Core_Oppty_At_Risk_Created_Date</description>
    <environments>Default</environments>
    <formulas>
        <name>f_Closedate</name>
        <dataType>Date</dataType>
        <expression>TODAY()+120</expression>
    </formulas>
    <formulas>
        <name>f_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>f_today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Core_Opportunity_Unique_Field_updates Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Opportunity_Unique_Field_updates_Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Amount_Null</name>
        <label>Amount = Null</label>
        <locationX>50</locationX>
        <locationY>995</locationY>
        <connector>
            <targetReference>Core_Oppty_At_Risk_Created_Date</targetReference>
        </connector>
        <inputAssignments>
            <field>Amount</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>At_Risk_Created_Date_today</name>
        <label>At Risk Created Date = today()</label>
        <locationX>50</locationX>
        <locationY>1295</locationY>
        <inputAssignments>
            <field>Core_At_Risk_Created_Date__c</field>
            <value>
                <elementReference>f_today</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Bypass_Field_Validation_False</name>
        <label>Bypass Field Validation = False</label>
        <locationX>50</locationX>
        <locationY>695</locationY>
        <connector>
            <targetReference>Core_Opp_Clear_Amount</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Bypass_Field_Validation__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Close_Date_Today_120</name>
        <label>Close Date = Today() + 120</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <connector>
            <targetReference>Core_Opp_Bypass_Field_Validation_Reset</targetReference>
        </connector>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>f_Closedate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_Decision_Date_on_Conversion</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
