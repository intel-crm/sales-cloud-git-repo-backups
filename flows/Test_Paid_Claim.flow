<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>CLaimdID</name>
        <label>CLaimdID</label>
        <locationX>490</locationX>
        <locationY>576</locationY>
        <assignmentItems>
            <assignToReference>ClaimCollectionVar</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Itertae_Recovery.Core_MDF_Claim_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Itertae_Recovery</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Deciison</name>
        <label>Deciison</label>
        <locationX>226</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>Get_Recovery</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Amount_check</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Payment_Made_Dt__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <dateValue>2023-12-05</dateValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Payment_Made_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Claim_update</targetReference>
            </connector>
            <label>Amount check</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Test {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test_Paid Claim</label>
    <loops>
        <name>Itertae_Recovery</name>
        <label>Itertae Recovery</label>
        <locationX>402</locationX>
        <locationY>468</locationY>
        <collectionReference>VarCollection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>CLaimdID</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
