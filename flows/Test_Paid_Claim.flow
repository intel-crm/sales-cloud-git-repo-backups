            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Recovery</name>
        <label>Get Recovery</label>
        <locationX>402</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Itertae_Recovery</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Claim_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <dateTimeValue>2023-12-07T18:30:00.000Z</dateTimeValue>
            </value>
        </filters>
        <object>Core_MDF_Recovery__c</object>
        <outputReference>VarCollection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Claim_Id__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Claim_update</name>
        <label>Claim update</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>program_picklist_test__c</field>
            <value>
                <stringValue>RMF</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>100</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Deciison</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2023-12-15</startDate>
            <startTime>05:13:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
