    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	[Core_MDF_Bank__c].Core_MDF_ESD_Update__c == true , 
	TODAY() &gt;= [Core_MDF_Bank__c].Core_MDF_Effective_Date__c,
    [Core_MDF_Bank__c].Core_MDF_Ineffective_Selection_ind__c == false,
	[Core_MDF_Bank__c].Core_MDF_ESD_Hold_Indicator__c  == false,
	OR(	   
	   ISPICKVAL([Core_MDF_Bank__c].Core_MDF_Hold_Payments_from_AP_file_ind__c ,&apos;No&apos;),
	   ISPICKVAL([Core_MDF_Bank__c].Core_MDF_Hold_Payments_from_AP_file_ind__c ,&apos;&apos;)
	),   
	OR(
		PRIORVALUE([Core_MDF_Bank__c].Core_MDF_ESD_Hold_Indicator__c),
		ISPICKVAL(PRIORVALUE([Core_MDF_Bank__c].Core_MDF_Hold_Payments_from_AP_file_ind__c),&apos;Yes&apos;),
		ISPICKVAL(PRIORVALUE([Core_MDF_Bank__c].Core_MDF_Bank_Status__c),&apos;Draft&apos;)
	)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_13</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	{!myVariable_current.Core_MDF_ESD_Update__c} == true , 
	TODAY() &gt;= {!myVariable_current.Core_MDF_Effective_Date__c},
    {!myVariable_current.Core_MDF_Ineffective_Selection_ind__c} == false,
	{!myVariable_current.Core_MDF_ESD_Hold_Indicator__c}  == false,
	OR(	   
	   ISPICKVAL({!myVariable_current.Core_MDF_Hold_Payments_from_AP_file_ind__c} ,&apos;No&apos;),
	   ISPICKVAL({!myVariable_current.Core_MDF_Hold_Payments_from_AP_file_ind__c} ,&apos;&apos;)
	),   
	OR(
		PRIORVALUE({!myVariable_current.Core_MDF_ESD_Hold_Indicator__c}),
		ISPICKVAL(PRIORVALUE({!myVariable_current.Core_MDF_Hold_Payments_from_AP_file_ind__c}),&apos;Yes&apos;),
		ISPICKVAL(PRIORVALUE({!myVariable_current.Core_MDF_Bank_Status__c}),&apos;Draft&apos;)
	)
)</expression>
