<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Pricing_SW_Trail_Product_Subscription_term_Error_message</name>
        <label>Pricing_SW Trail Product Subscription term Error message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>{!$Label.Pricing_SW_PLI_TRIAL_112SubscriptonTermRestrictionmorethan12}</errorMessage>
            <fieldSelection>SBQQ__SubscriptionTerm__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Pricing_SW_Check_Subscription_Term_greater_than_12_for_Trail_Product</name>
        <label>Pricing_SW Check Subscription Term greater than 12 for Trail Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pricing_SW_Quote_Line_Trail_Product_and_Quote_Term_greater_than_12</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Pricing_SW_Get_Quote_Lines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_SW_Trail_Product_Subscription_term_Error_message</targetReference>
            </connector>
            <label>Pricing_SW Quote Line Trail Product and Quote Term greater than 12</label>
        </rules>
    </decisions>
    <description>When there are Quote lines with PLI Trial Product and Quote Subscription term is greater than 12Months, show error message.</description>
    <environments>Default</environments>
    <interviewLabel>Pricing_SW Trail product Quote Subscription Term greater than 12 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pricing_SW Trail product Quote Subscription Term greater than 12</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Pricing_SW_Get_Quote_Lines</name>
        <label>Pricing_SW Get Quote Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Pricing_SW_Check_Subscription_Term_greater_than_12_for_Trail_Product</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__Quote__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>SBQQ__ProductName__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Label.Pricing_SW_PLI_TRIAL_112ProductName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SBQQ__QuoteLine__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Pricing_SW_Get_Quote_Lines</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Pricing_Quote_Program_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Software &amp; Services</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_SW_Quote_Product_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PLI</stringValue>
            </value>
        </filters>
        <filters>
            <field>SBQQ__SubscriptionTerm__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>SBQQ__SubscriptionTerm__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>12.0</numberValue>
            </value>
        </filters>
        <object>SBQQ__Quote__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
