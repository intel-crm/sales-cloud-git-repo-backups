        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_MDF_Update_the_Bank_Program_Value</name>
        <label>Update the Bank Program Value</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
