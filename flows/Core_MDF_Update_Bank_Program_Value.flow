    <formulas>
        <name>Core_MDF_Update_the_Bank_Program_ValueFormula</name>
        <dataType>String</dataType>
        <expression>IF(INCLUDES($Record.Core_MDF_Program__c, &quot;Core_MDF_Client_CoMarketing_Fund&quot;),&quot;Client;&quot;,NULL)+
IF(INCLUDES($Record.Core_MDF_Program__c, &quot;Core_MDF_Data_Center_CoMarketing_Fund&quot;),&quot;Datacenter;&quot;,NULL)+
IF(INCLUDES($Record.Core_MDF_Program__c, &quot;Core_MDF_Service_Provider_CoMarketing_Fund&quot;),&quot;Service Provider Co-Marketing Fund;&quot;,NULL)+
IF(INCLUDES($Record.Core_MDF_Program__c, &quot;Core_MDF_Client_CoMarketing_Fund_Boost&quot;),&quot;Client Co-Marketing Fund Boost;&quot;,NULL)+
IF(INCLUDES($Record.Core_MDF_Program__c, &quot;Core_MDF_Retail_Marketing_Funds&quot;),&quot;Retail Marketing Funds;&quot;,NULL)+
IF(INCLUDES($Record.Core_MDF_Program__c, &quot;Core_MDF_Intel_Partner_Alliance&quot;),&quot;Intel Partner Alliance;&quot;,NULL)+
IF(INCLUDES($Record.Core_MDF_Program__c, &quot;Core_MDF_Ecosystem_Extension_Fund&quot;),&quot;Ecosystem Extension Fund;&quot;,NULL)+
IF(INCLUDES($Record.Core_MDF_Program__c, &quot;Core_MDF_Co_GTM&quot;),&quot;Co-GTM;&quot;,NULL)</expression>
    </formulas>
    <interviewLabel>Core_MDF_Update_Bank_Program_Value {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Update_Bank_Program_Value</label>
    <migratedFromWorkflowRuleName>Core_MDF_Update_Bank_Program_Value</migratedFromWorkflowRuleName>
    <processMetadataValues>
