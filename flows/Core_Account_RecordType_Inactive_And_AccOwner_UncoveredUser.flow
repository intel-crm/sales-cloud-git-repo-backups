<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Update_Core_Account_RecordType_as_Inactive</name>
        <label>Update Core Account RecordType as Inactive</label>
        <locationX>50</locationX>
        <locationY>551</locationY>
        <assignmentItems>
            <assignToReference>$Record.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_InactiveAccountRecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_If_Account_owner_contains_Below_Users</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Core_Account_Update_Owner_Uncovered_Acct</name>
        <label>Update Core Account Update Owner Uncovered Acct</label>
        <locationX>50</locationX>
        <locationY>1007</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_UncoveredAccountUserId</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <constants>
        <name>con_InactiveAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Inactive_Account</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_PartnerAccountGroup</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Partner Account Group</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_UncoveredAccountUser</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Uncovered Account</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_If_Account_owner_contains_Below_Users</name>
        <label>Check If Account owner contains Below Users</label>
        <locationX>182</locationX>
        <locationY>767</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Contains_User</name>
            <conditionLogic>(1 AND 2 ) OR (3 AND 4) OR (5 AND 6) OR (7 AND 8) OR (9 AND 10)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner.FirstName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Integration</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.LastName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>User</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.FirstName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Salesforce</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.LastName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>System User</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.FirstName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CIM.OBM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.LastName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Integration</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.FirstName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ERPM.OBM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.LastName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Integration</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.FirstName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Integration_OBM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.LastName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Integration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Uncovered_Account_User</targetReference>
            </connector>
            <label>Contains User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_Account_Inactive_Record_Type</name>
        <label>Core_Account_Inactive_Record_Type</label>
        <locationX>182</locationX>
        <locationY>311</locationY>
        <defaultConnector>
            <targetReference>Check_If_Account_owner_contains_Below_Users</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>InActive</name>
            <conditionLogic>((1 OR 2) AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>con_PartnerAccountGroup</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Inactive_Account_RecordType</targetReference>
            </connector>
            <label>InActive</label>
        </rules>
    </decisions>
    <description>Updating Recordtype as Inactive and Account owner as Uncovered user</description>
    <environments>Default</environments>
    <interviewLabel>Core_Account_RecordType_Inactive_And_AccOwner_UncoveredUser {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Account_RecordType_Inactive_And_AccOwner_UncoveredUser</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Inactive_Account_RecordType</name>
        <label>Get Inactive Account RecordType</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Core_Account_RecordType_as_Inactive</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>con_InactiveAccount</elementReference>
            </value>
        </filters>
        <object>RecordType</object>
        <outputAssignments>
            <assignToReference>var_InactiveAccountRecordTypeId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Uncovered_Account_User</name>
        <label>Get Uncovered Account User</label>
        <locationX>50</locationX>
        <locationY>887</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Core_Account_Update_Owner_Uncovered_Acct</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>con_UncoveredAccountUser</elementReference>
            </value>
        </filters>
        <object>User</object>
        <outputAssignments>
            <assignToReference>var_UncoveredAccountUserId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_Account_Inactive_Record_Type</targetReference>
        </connector>
        <filterFormula>OR(OR(AND({!$Record.Owner.FirstName}=&apos;Integration&apos;,{!$Record.Owner.LastName}=&apos;User&apos;),AND({!$Record.Owner.FirstName}=&apos;Integration_OBM&apos;,{!$Record.Owner.LastName}=&apos;User&apos;),AND({!$Record.Owner.FirstName}=&apos;ERPM.OBM&apos;,{!$Record.Owner.LastName}=&apos;Integration&apos;),AND({!$Record.Owner.FirstName}=&apos;CIM.OBM&apos;,{!$Record.Owner.LastName}=&apos;Integration&apos;),AND({!$Record.Owner.FirstName}=&apos;Salesforce&apos;,{!$Record.Owner.LastName}=&apos;System User&apos;)),AND(({!$Record.RecordType.Name}&lt;&gt;&apos;Partner Account Group&apos;),OR(({!$Record.Core_Deactivated__c}=True), ({!$Record.Core_Export_Compliance_Block__c}=True))))</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_InactiveAccountRecordTypeId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_UncoveredAccountUserId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
