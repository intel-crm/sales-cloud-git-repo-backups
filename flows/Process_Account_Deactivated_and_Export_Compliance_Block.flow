    <actionCalls>
        <name>Account_Owner_Email_Notification</name>
        <label>Account Owner Email Notification</label>
        <locationX>1194</locationX>
        <locationY>539</locationY>
        <actionName>Account.Core_Account_Owner_Deactivation_Notification</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Get_Inactive_Account_Record_Type</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Account.Core_Account_Owner_Deactivation_Notification</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>con_CoMarketing</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Core_MDF_Co_Marketing</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_InactiveAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Inactive_Account</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_IntelUltimateAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Core_Account_Intel_Ultimate</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_MasteredAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Mastered_Account</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_PartnerAccountGroup</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Partner Account Group</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_UncoveredAccountUser</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Uncovered Account</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Checking the account record type</description>
        <name>Check_Account_Record_Types</name>
        <label>Check Account Record Type</label>
        <locationX>490</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Intel_Or_Inactive_Account</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_ECB_flag</targetReference>
            </connector>
            <label>Is Intel Or Inactive Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_For_Deactivated_Flag</name>
        <label>Check For Deactivated Flag</label>
        <locationX>1524</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Check_When_Account_Deactivated_is_Unchecked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Deactivated_Flag_is_Checked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>con_PartnerAccountGroup</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_Owner_Email_Notification</targetReference>
            </connector>
            <label>Deactivated Flag is Checked</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_ECB_flag</name>
        <label>Check for ECB flag</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Get_Intel_AccountRecordType</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>ECB Flag is Unchecked</defaultConnectorLabel>
        <rules>
            <name>ECB_flag_is_checked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Inactive_Account_Record_Type</targetReference>
            </connector>
            <label>ECB flag is checked</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_When_Account_Deactivated_is_Unchecked</name>
        <label>Check When Account Deactivated is Unchecked</label>
        <locationX>1854</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Convert_Account_to_Intel_For_Non_Unified_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive_Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Intel_Account_Record_Type</targetReference>
            </connector>
            <label>Convert Account to Intel For Non-Unified Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Deactivated_flag_or_ECB_flag</name>
        <label>Deactivated flag or ECB flag?</label>
        <locationX>1007</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Check_For_Deactivated_Flag</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>By Deactivated flag</defaultConnectorLabel>
        <rules>
            <name>By_ECB_flag</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Account_Record_Types</targetReference>
            </connector>
            <label>By ECB flag</label>
        </rules>
    </decisions>
    <environments>Default</environments>
