                <stringValue>OR(AND(OR([PRM_Registration_Request__c].RecordType.DeveloperName =  &apos;Add_Membership_Request&apos;, [PRM_Registration_Request__c].RecordType.DeveloperName =&apos;Add_Contact_Request&apos;, [PRM_Registration_Request__c].RecordType.DeveloperName =&apos;Account_Create_Request&apos;),[PRM_Registration_Request__c].PRM_isSubmitted__c==False ,

