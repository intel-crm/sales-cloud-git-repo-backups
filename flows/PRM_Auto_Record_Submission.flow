        <expression>OR(AND(OR({!myVariable_current.RecordType.DeveloperName} =  &apos;Add_Membership_Request&apos;, {!myVariable_current.RecordType.DeveloperName} =&apos;Add_Contact_Request&apos;, {!myVariable_current.RecordType.DeveloperName} =&apos;Account_Create_Request&apos;),{!myVariable_current.PRM_isSubmitted__c}==False ,

{!myVariable_current.PRM_Auto_Approve__c} =False,{!myVariable_current.PRM_Channel_Program_Level_txt__c} =  &apos;Intel Partner Alliance&apos;,ISBLANK({!myVariable_current.Entitlement_Details__c})),

