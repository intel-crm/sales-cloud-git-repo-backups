    <description>Used for the Manual Approval Process</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(OR([PRM_Registration_Request__c].RecordType.DeveloperName =  &apos;Add_Membership_Request&apos;, [PRM_Registration_Request__c].RecordType.DeveloperName =&apos;Add_Contact_Request&apos;, [PRM_Registration_Request__c].RecordType.DeveloperName =&apos;Account_Create_Request&apos;),[PRM_Registration_Request__c].PRM_isSubmitted__c==False )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR({!myVariable_current.RecordType.DeveloperName} =  &apos;Add_Membership_Request&apos;, {!myVariable_current.RecordType.DeveloperName} =&apos;Add_Contact_Request&apos;, {!myVariable_current.RecordType.DeveloperName} =&apos;Account_Create_Request&apos;),{!myVariable_current.PRM_isSubmitted__c}==False )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(ISCHANGED([PRM_Registration_Request__c].PRM_Status__c ) ,ISPICKVAL([PRM_Registration_Request__c].PRM_Status__c , &quot;Approved&quot;), 
([PRM_Registration_Request__c].RecordType.DeveloperName  &lt;&gt; &quot;Admin_Registration&quot;),
[PRM_Registration_Request__c].PRM_TriggerProcess__c = False)
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!myVariable_current.PRM_Status__c} ) ,ISPICKVAL({!myVariable_current.PRM_Status__c} , &quot;Approved&quot;), 
({!myVariable_current.RecordType.DeveloperName}  &lt;&gt; &quot;Admin_Registration&quot;),
{!myVariable_current.PRM_TriggerProcess__c} = False)</expression>
    </formulas>
