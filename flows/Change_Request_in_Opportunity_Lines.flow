                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Approved_QLs_Loop.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_OpptyLines_List</targetReference>
            </connector>
            <label>If Matching</label>
        </rules>
    </decisions>
    <decisions>
