    <decisions>
        <name>If_File_is_uploaded</name>
        <label>If File is uploaded</label>
        <locationX>578</locationX>
        <locationY>2090</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>File_uploaded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFileUploaded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_Request8</targetReference>
            </connector>
            <label>File uploaded</label>
        </rules>
        <rules>
            <name>File_not_uploaded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFileUploaded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_Request6</targetReference>
            </connector>
            <label>File not uploaded</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Opportunity_Line_Exists</name>
        <label>If Opportunity Line Exists</label>
        <locationX>1898</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Line_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpptyLineLst</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OpptyLine_Loop</targetReference>
            </connector>
            <label>Opportunity Line Present</label>
        </rules>
        <rules>
            <name>Oppty_Line_not_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpptyLineLst</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_Request</targetReference>
            </connector>
            <label>Oppty Line not Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_QuoteLine_is_Approved</name>
        <label>If QuoteLine is Approved</label>
        <locationX>1106</locationX>
        <locationY>1766</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QLItemVar.Pricing_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Change_Request1</targetReference>
            </connector>
            <label>If Approved</label>
        </rules>
        <rules>
            <name>If_not_Approved</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>QLItemVar.Pricing_Status_Nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>QLItemVar</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Change_Request</targetReference>
            </connector>
            <label>If not Approved</label>
        </rules>
    </decisions>
    <decisions>
