        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Change_Request2</targetReference>
        </connector>
        <fields>
            <name>OpportunityProd</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Opportunity Product :&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;{!varSelectedOpptyLine.Name}&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Quote_Pricing_Start_Date</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>QLItemVar.Pricing_Start_Date_dt__c</elementReference>
            </defaultValue>
            <fieldText>Quote Line Pricing Start Date</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Pricing start date for this quote line. If currently approved pricing start date is in the future, a change to the pricing start date can be requested.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 14.6667px; font-family: &amp;quot;Aptos Narrow&amp;quot;, Calibri, sans-serif, &amp;quot;Mongolian Baiti&amp;quot;, &amp;quot;Microsoft Yi Baiti&amp;quot;, &amp;quot;Javanese Text&amp;quot;, &amp;quot;Yu Gothic&amp;quot;; color: rgb(0, 0, 0);&quot;&gt;Quote Line Pricing Start Date must be today or later.&lt;/span&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>{!Quote_Pricing_Start_Date} &gt;= Today()</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Quote_Line_Pricing_End_Date</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>QLItemVar.Pricing_End_Date_dt__c</elementReference>
            </defaultValue>
            <fieldText>Quote Line Pricing End Date</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Pricing end date for this quote line. Can be different than the Pricing End Date for the quote.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 14.6667px; font-family: &amp;quot;Aptos Narrow&amp;quot;, Calibri, sans-serif, &amp;quot;Mongolian Baiti&amp;quot;, &amp;quot;Microsoft Yi Baiti&amp;quot;, &amp;quot;Javanese Text&amp;quot;, &amp;quot;Yu Gothic&amp;quot;; color: rgb(0, 0, 0);&quot;&gt;Quote Line Pricing End Date cannot be earlier than Quote Line Pricing Start Date&lt;/span&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>{!Quote_Line_Pricing_End_Date} &gt; 
{!Quote_Pricing_Start_Date}</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>New_Quantity</name>
            <dataType>Number</dataType>
            <defaultValue>
                <elementReference>QLItemVar.Pricing_New_Quantity_qty__c</elementReference>
            </defaultValue>
            <fieldText>New Quantity</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Total quantity of units if different than the current approved quantity.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <scale>0</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;Quantity cannot be zero.&lt;/p&gt;</errorMessage>
                <formulaExpression>{!New_Quantity} &gt; 0</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Additional_Comments</name>
            <defaultValue>
                <stringValue>{!QLItemVar.Pricing_Additional_Comments_Txt__c}</stringValue>
            </defaultValue>
            <fieldText>Additional Comments</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
