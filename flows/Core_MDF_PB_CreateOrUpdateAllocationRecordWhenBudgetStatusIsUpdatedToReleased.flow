        <defaultConnectorLabel>default</defaultConnectorLabel>
        <rules>
            <name>myRule_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_myRule_1</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>myRule_1_A1</targetReference>
            </connector>
            <label>If Budget Status is Updated from Approved to Released for a Co-Marketing RT</label>
        </rules>
    </decisions>
    <description>This process builder will fire when the Budget Status is updated from &quot;Approved&quot; to &quot;Released&quot;.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(TEXT([PartnerMarketingBudget].Core_MDF_Budget_Status__c) == $Label.Core_MDF_Budget_Status_Released, 
ISCHANGED([PartnerMarketingBudget].Core_MDF_Budget_Status__c), 
OR([PartnerMarketingBudget].RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name, 
[PartnerMarketingBudget].RecordType.DeveloperName =
$Label.Core_MDF_Retail_Record_Type_Developer_Name ),
PRIORVALUE([PartnerMarketingBudget].Core_MDF_Budget_Status__c) = $Label.Core_MDF_Budget_Status_Approved)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(TEXT({!myVariable_current.Core_MDF_Budget_Status__c}) == {!$Label.Core_MDF_Budget_Status_Released}, 
ISCHANGED({!myVariable_current.Core_MDF_Budget_Status__c}), 
OR({!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name}, 
{!myVariable_current.RecordType.DeveloperName} =
{!$Label.Core_MDF_Retail_Record_Type_Developer_Name} ),
PRIORVALUE({!myVariable_current.Core_MDF_Budget_Status__c}) = {!$Label.Core_MDF_Budget_Status_Approved})</expression>
    </formulas>
    <interviewLabel>Core_MDF_PB_CreateOrUpdateAllocationRecordWhenBudgetStatusIsUpdatedToReleased-4_InterviewLabel</interviewLabel>
    <label>Core_MDF_PB_CreateOrUpdateAllocationRecordWhenBudgetStatusIsUpdatedToReleased</label>
