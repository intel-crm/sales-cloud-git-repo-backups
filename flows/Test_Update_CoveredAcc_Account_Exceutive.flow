<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Store_Unified_End_Customer_Id</name>
        <label>Store Unified End Customer Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>UnifiedEndCustomerId</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Pricing_Unified_Global_End_Customer_Nm__r.Pricing_Unified_EndCustomer_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Intel_Account</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Intel_Account</name>
        <label>Is Intel Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_AE_AE_Email_covered_fields_to_blank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Intel_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Intel_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Intel_Account.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Intel_Account.OwnerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_is_AE_AE_Email_Covered_Acc_field</targetReference>
            </connector>
            <label>If Intel Account</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Test_Update_CoveredAcc_Account_Exceutive {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test_Update_CoveredAcc_Account_Exceutive</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Intel_Account</name>
        <label>Get Intel Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Intel_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Business_Party_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Business_Party_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>UnifiedEndCustomerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_AE_AE_Email_covered_fields_to_blank</name>
        <label>Update AE, AE Email, covered fields to blank</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Pricing_Account_Executive_Nm__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Pricing_Intel_Account_Exec_Email_Txt__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Pricing_Is_Covered_Account_cb__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_is_AE_AE_Email_Covered_Acc_field</name>
        <label>Update is AE,AE Email, Covered Acc field</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Pricing_Account_Executive_Nm__c</field>
            <value>
                <elementReference>Get_Intel_Account.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pricing_Intel_Account_Exec_Email_Txt__c</field>
            <value>
                <elementReference>Get_Intel_Account.Owner.Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pricing_Is_Covered_Account_cb__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Store_Unified_End_Customer_Id</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Pricing_Unified_Global_End_Customer_Nm__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Unified_Global_End_Customer_Nm__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>SBQQ__Quote__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>UnifiedEndCustomerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
