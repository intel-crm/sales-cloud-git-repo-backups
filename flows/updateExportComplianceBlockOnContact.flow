        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Using this we are trying to  bypass &quot;Embargoed_Country&quot; Validation rule of Contact object</description>
        <name>Bypass_Embargoed_Country_Validation_Rule</name>
        <label>Bypass Embargoed Country Validation Rule</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <connector>
            <targetReference>updateContact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Bypass_Flow__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Bypass_Flow__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Core_Account_Bypass_Validation_Rule__c</object>
    </recordUpdates>
    <recordUpdates>
        <description>Undo the changes done in bypass Embargoed Country Validation Rule</description>
        <name>Undo_Bypass_Embargoed_Country_Validation_Rule</name>
        <label>Undo Bypass Embargoed Country Validation Rule</label>
        <locationX>308</locationX>
        <locationY>492</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Bypass_Flow__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Bypass_Flow__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Core_Account_Bypass_Validation_Rule__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>updateContact</name>
        <label>updateContact</label>
        <locationX>308</locationX>
        <locationY>384</locationY>
        <connector>
            <targetReference>Undo_Bypass_Embargoed_Country_Validation_Rule</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Erro_email</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_Con_Export_Compliance_Block_Reason__c</field>
            <value>
                <elementReference>$Record.Core_Export_Compliance_Block_Reason__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Contact_Export_Compliance_Block__c</field>
            <value>
                <elementReference>$Record.Core_Export_Compliance_Block__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Contacts</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Export_Compliance_Block__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Bypass_Embargoed_Country_Validation_Rule</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
