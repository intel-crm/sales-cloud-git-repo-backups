    <description>ve6</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Core_IPS_Case_Attachments__c].Core_Case__r.Core_IPS_Backend_ID__c &lt;&gt; null, 
[Core_IPS_Case_Attachments__c].Core_Case__r.Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c &lt;&gt; null, 
[Core_IPS_Case_Attachments__c].Core_Case__r.Core_IPS_Backend_System__r.Core_IPS_Deactivated__c = false , 
[Core_IPS_Case_Attachments__c].Core_Is_Migrated__c = false,
(ISPICKVAL([Core_IPS_Case_Attachments__c].Core_Promote_Status__c , &apos;&apos; ) || 
ISPICKVAL( [Core_IPS_Case_Attachments__c].Core_Promote_Status__c , &apos;In Progress&apos; )),
( ISPICKVAL([Core_IPS_Case_Attachments__c].Core_Upload_Status__c, &apos;Complete&apos;)), 
( ($Profile.Name &lt;&gt; &apos;Integration&apos; &amp;&amp; $Profile.Name &lt;&gt; &apos;IPS Data Migration&apos;) || CONTAINS($User.Username, &apos;ips.file.integrationuser&apos;) || CONTAINS($User.Username, &apos;ips.backend.integrationuser&apos;))
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.Core_Case__r.Core_IPS_Backend_ID__c} &lt;&gt; null, 
{!myVariable_current.Core_Case__r.Core_IPS_Backend_System__r.Core_IPS_Backend_Connection_String__c} &lt;&gt; null, 
{!myVariable_current.Core_Case__r.Core_IPS_Backend_System__r.Core_IPS_Deactivated__c} = false , 
{!myVariable_current.Core_Is_Migrated__c} = false,
(ISPICKVAL({!myVariable_current.Core_Promote_Status__c} , &apos;&apos; ) || 
ISPICKVAL( {!myVariable_current.Core_Promote_Status__c} , &apos;In Progress&apos; )),
( ISPICKVAL({!myVariable_current.Core_Upload_Status__c}, &apos;Complete&apos;)), 
( ({!$Profile.Name} &lt;&gt; &apos;Integration&apos; &amp;&amp; {!$Profile.Name} &lt;&gt; &apos;IPS Data Migration&apos;) || CONTAINS({!$User.Username}, &apos;ips.file.integrationuser&apos;) || CONTAINS({!$User.Username}, &apos;ips.backend.integrationuser&apos;))
)</expression>
    </formulas>
