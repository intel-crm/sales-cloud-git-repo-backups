    <decisions>
        <name>check_if_existing_records_are_present</name>
        <label>check if existing records are present</label>
        <locationX>50</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>create_inbound_if_unified_is_there_after_acm_creation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>if no</defaultConnectorLabel>
        <rules>
            <name>if_yesinbound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Inbound_records</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>if yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_if_unified_is_having_value</name>
        <label>check if unified is having value</label>
        <locationX>248</locationX>
        <locationY>623</locationY>
        <defaultConnectorLabel>if not</defaultConnectorLabel>
        <rules>
            <name>Copy_1_of_if_yes</name>
            <conditionLogic>(1 OR 2) AND 3 AND (4 OR 5) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Core_Business_Party_Id__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Inbound_records</targetReference>
            </connector>
            <label>Copy 1 of if yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>&quot;Send Notification Messages to Contacts when Account Owner is Changed	&quot;</description>
        <name>When_Account_Owner_is_Changed</name>
        <label>When Account Owner is Changed</label>
        <locationX>248</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>check_if_unified_is_having_value</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Checks_Account_Owner_is_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PRM_Intel_Account</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Intel_Partner_Alliance_PartnerGroup__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Messages</targetReference>
            </connector>
            <label>Checks Account Owner is Changed</label>
        </rules>
    </decisions>
    <description>Send Notification Messages to Contacts when Account Owner is Changed</description>
    <environments>Default</environments>
    <formulas>
        <name>opidGlobalName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_Unified_Global_Customer_Name__c}+&apos; - Global&apos;</expression>
    </formulas>
    <interviewLabel>PRM Account Notification Messages {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PRM Account Notification Messages</label>
