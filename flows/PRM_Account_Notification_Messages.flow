<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Messages</name>
        <label>Send Messages</label>
        <locationX>50</locationX>
        <locationY>384</locationY>
        <actionName>PRM_SendNotificationMessages</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>accountId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>msgCd</name>
            <value>
                <elementReference>$Label.PRM_Msgcd_NewManager</elementReference>
            </value>
        </inputParameters>
        <nameSegment>PRM_SendNotificationMessages</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>InactiveAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Inactive Account</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_if_account_is_inactivr_and_unified_id_blank</name>
        <label>Check if account is inactivr and unified id blank</label>
        <locationX>710</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>if not</defaultConnectorLabel>
        <rules>
            <name>if_account_is_inactivr_and_unified_id_blank</name>
            <conditionLogic>(1 OR 5) AND (2 OR 3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>InactiveAccount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Null</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Account_Record_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>InactiveAccount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PRM_flowForDeactivationWithWithoutUnified_Flow_1</targetReference>
            </connector>
            <label>if account is inactivr and unified id blank</label>
        </rules>
    </decisions>
    <decisions>
        <description>&quot;Send Notification Messages to Contacts when Account Owner is Changed	&quot;</description>
        <name>When_Account_Owner_is_Changed</name>
        <label>When Account Owner is Changed</label>
        <locationX>182</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Checks_Account_Owner_is_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.PRM_Intel_Account</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Intel_Partner_Alliance_PartnerGroup__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Messages</targetReference>
            </connector>
            <label>Checks Account Owner is Changed</label>
        </rules>
    </decisions>
    <description>Send Notification Messages to Contacts when Account Owner is Changed</description>
    <environments>Default</environments>
    <interviewLabel>PRM Account Notification Messages {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PRM Account Notification Messages</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
