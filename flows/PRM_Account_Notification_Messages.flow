    <recordLookups>
        <name>Get_Existing_Inbound_records</name>
        <label>Get Existing Inbound records</label>
        <locationX>50</locationX>
        <locationY>731</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>check_if_existing_records_are_present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_SalesCloud_AccountID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_OnePartner_Account_Name__c</field>
            <operator>EqualTo</operator>
            <value>
