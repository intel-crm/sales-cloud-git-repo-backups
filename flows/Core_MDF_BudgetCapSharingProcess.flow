<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_MDF_Share_Budget_Cap_Records</name>
        <label>Share Budget Cap Records</label>
        <locationX>236</locationX>
        <locationY>1535</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_VerifyIfNewOrOwnerChanged</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_CCP_Budget_Cap</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_CreateBudgetCapSharingRecords</targetReference>
            </connector>
            <label>VerifyIfNewOrOwnerChanged</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Verify_for_non_IPA_and_non_channelMDF</name>
        <label>Verify for non-IPA and non-channelMDF</label>
        <locationX>233</locationX>
        <locationY>1299</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Share_Budget_Cap_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_If_non_IPA_and_non_ChannelMDF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_IPA_Budget_Type_Cap</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Update_Program_On_Budget_Cap</targetReference>
            </connector>
            <label>If non IPA</label>
        </rules>
    </decisions>
    <description>This flow is used to create Budget Cap share records - converted process builder &apos;Core_MDF_BudgetCapSharing_Process&apos; into flow.</description>
    <environments>Default</environments>
    <formulas>
        <name>CalculatingBudgetChannelProgramKey</name>
        <dataType>String</dataType>
        <expression>({!$Record.Core_MDF_Budget_Name_id__r.Id}) &amp; (TEXT({!$Record.Core_MDF_Cap_Type_nm__c}))</expression>
    </formulas>
    <formulas>
        <name>CheckForNewRecords</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>GetCurrentLoggedInUser</name>
        <dataType>String</dataType>
        <expression>{!$User.Id}</expression>
    </formulas>
    <formulas>
        <name>IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>RequestedCAPAmountChanges</name>
        <dataType>Boolean</dataType>
        <expression>AND( ! (ISNEW()), ISCHANGED ({!$Record.Core_MDF_Requested_Cap_amt__c}))</expression>
    </formulas>
    <formulas>
        <name>RequestedCAPGreaterThanZero</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISNEW(), {!$Record.Core_MDF_Requested_Cap_amt__c}&gt;0)</expression>
    </formulas>
    <interviewLabel>Core_MDF_BudgetCapSharing_Process {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Budget Cap Sharing Process</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_MDF_Update_Program_On_Budget_Cap</name>
        <label>Update Program On Budget Cap</label>
        <locationX>562</locationX>
        <locationY>1300</locationY>
        <connector>
            <targetReference>Core_MDF_Share_Budget_Cap_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Program_txt__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Program_txt__c</field>
            <value>
                <elementReference>$Record.Core_MDF_Budget_Name_id__r.Core_MDF_Program__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>112</locationX>
        <locationY>846</locationY>
        <connector>
            <targetReference>Core_MDF_Verify_for_non_IPA_and_non_channelMDF</targetReference>
        </connector>
        <object>Core_MDF_Budget_Cap__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Core_MDF_CreateBudgetCapSharingRecords</name>
        <label>CreateBudgetCapSharingRecords</label>
        <locationX>572</locationX>
        <locationY>1526</locationY>
        <flowName>Core_MDF_BudgetCapShare_Record_Creation</flowName>
        <inputAssignments>
            <name>so_BudgetCapRecord</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vBudgetCapId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vChannelProgram</name>
            <value>
                <elementReference>$Record.Core_MDF_Budget_Name_id__r.Core_MDF_Budget_Partner__r.Core_MDF_Channel_Program__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vPGMAccountID</name>
            <value>
                <elementReference>$Record.Core_MDF_Budget_Name_id__r.Core_MDF_Budget_Partner__r.Core_MDF_Parent_Fund_Account__c</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
