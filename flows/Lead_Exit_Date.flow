    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>( ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Disqualified&apos;) ||  ISPICKVAL([Lead].Core_Lead_Status__c, &apos;Rejected&apos;)  )&amp;&amp; ISPICKVAL([Lead].Status, &apos;Marketing Qualified Lead&apos;) &amp;&amp;  (ISCHANGED([Lead].Core_Lead_Status__c) || ISCHANGED([Lead].Status)) &amp;&amp; [Lead].RecordType.Name &lt;&gt; &apos;Partner Lead&apos;</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>( ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Disqualified&apos;) ||  ISPICKVAL({!myVariable_current.Core_Lead_Status__c}, &apos;Rejected&apos;)  )&amp;&amp; ISPICKVAL({!myVariable_current.Status}, &apos;Marketing Qualified Lead&apos;) &amp;&amp;  (ISCHANGED({!myVariable_current.Core_Lead_Status__c}) || ISCHANGED({!myVariable_current.Status})) &amp;&amp; {!myVariable_current.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>( ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Disqualified&apos;) ||  ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Rejected&apos;)||ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Unreachable&apos;) || ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Passed to Partner&apos;))&amp;&amp; ISPICKVAL([Lead].Status, &apos;Sales Accepted Lead&apos;)  &amp;&amp;  (ISCHANGED([Lead].Core_Lead_Status__c) || ISCHANGED([Lead].Status))&amp;&amp; [Lead].RecordType.Name &lt;&gt; &apos;Partner Lead&apos;</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_10</name>
        <dataType>Boolean</dataType>
        <expression>( ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Disqualified&apos;) ||  ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Rejected&apos;)||ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Unreachable&apos;) || ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Passed to Partner&apos;))&amp;&amp; ISPICKVAL({!myVariable_current.Status}, &apos;Sales Accepted Lead&apos;)  &amp;&amp;  (ISCHANGED({!myVariable_current.Core_Lead_Status__c}) || ISCHANGED({!myVariable_current.Status}))&amp;&amp; {!myVariable_current.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>[Lead].IsConverted=true &amp;&amp;
ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Disqualified&apos;) &amp;&amp; 
ISPICKVAL([Lead].Status, &apos;Contact - No Opportunity&apos;)  &amp;&amp; 
[Lead].RecordType.Name &lt;&gt; &apos;Partner Lead&apos;</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_13</name>
        <dataType>Boolean</dataType>
        <expression>{!myVariable_current.IsConverted}=true &amp;&amp;
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Disqualified&apos;) &amp;&amp; 
ISPICKVAL({!myVariable_current.Status}, &apos;Contact - No Opportunity&apos;)  &amp;&amp; 
{!myVariable_current.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Accepted&apos;) &amp;&amp;
ISPICKVAL(PRIORVALUE([Lead].Core_Lead_Status__c) , &apos;Disqualified&apos;) &amp;&amp; 
ISPICKVAL([Lead].Status, &apos;Sales Accepted Lead&apos;)  &amp;&amp;  (ISCHANGED([Lead].Core_Lead_Status__c) || ISCHANGED([Lead].Status))&amp;&amp; [Lead].RecordType.Name &lt;&gt; &apos;Partner Lead&apos;</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_17</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Accepted&apos;) &amp;&amp;
ISPICKVAL(PRIORVALUE({!myVariable_current.Core_Lead_Status__c}) , &apos;Disqualified&apos;) &amp;&amp; 
ISPICKVAL({!myVariable_current.Status}, &apos;Sales Accepted Lead&apos;)  &amp;&amp;  (ISCHANGED({!myVariable_current.Core_Lead_Status__c}) || ISCHANGED({!myVariable_current.Status}))&amp;&amp; {!myVariable_current.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>( ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Rejected&apos;) ||  ISPICKVAL([Lead].Core_Lead_Status__c, &apos;Passed to Partner&apos;)|| ISPICKVAL([Lead].Core_Lead_Status__c, &apos;Disqualified&apos;)  )&amp;&amp; ISPICKVAL([Lead].Status, &apos;Tele Accepted Lead&apos;) &amp;&amp;  (ISCHANGED([Lead].Core_Lead_Status__c) || ISCHANGED([Lead].Status)) &amp;&amp; [Lead].RecordType.Name &lt;&gt; &apos;Partner Lead&apos;</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_4</name>
        <dataType>Boolean</dataType>
        <expression>( ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Rejected&apos;) ||  ISPICKVAL({!myVariable_current.Core_Lead_Status__c}, &apos;Passed to Partner&apos;)|| ISPICKVAL({!myVariable_current.Core_Lead_Status__c}, &apos;Disqualified&apos;)  )&amp;&amp; ISPICKVAL({!myVariable_current.Status}, &apos;Tele Accepted Lead&apos;) &amp;&amp;  (ISCHANGED({!myVariable_current.Core_Lead_Status__c}) || ISCHANGED({!myVariable_current.Status})) &amp;&amp; {!myVariable_current.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;</expression>
