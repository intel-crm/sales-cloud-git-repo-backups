<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>If_User_is_present_in_SOAR_Team_Already</name>
        <label>If User is present in SOAR Team Already?</label>
        <locationX>374</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>Create_SOAR_Team</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.UserId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_SOAR_Team.CRM_VBS_Team_member__c</elementReference>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>v1 : For Intel-Led Growth Opportunity and VBS potential is checked, whenever new OTM is added, the flow will sync it to SOAR Team.</description>
    <environments>Default</environments>
    <interviewLabel>CRM_Sync New OTM on SOAR Team {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CRM_Sync New OTM on SOAR Team</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_SOAR_Team</name>
        <label>Create SOAR Team</label>
        <locationX>506</locationX>
        <locationY>600</locationY>
        <inputAssignments>
            <field>CRM_VBS_Description_of_Contribution__c</field>
            <value>
                <elementReference>$Record.Core_Description_of_Contribution__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Is_Copy_OTM__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_SOAR__c</field>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Team_Role__c</field>
            <value>
                <elementReference>$Record.TeamMemberRole</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Team_member__c</field>
            <value>
                <elementReference>$Record.User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>CRM_VBS_SOAR_Team__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_SOAR_Record</name>
        <label>Get SOAR Record</label>
        <locationX>374</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_SOAR_Team</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_SOAR_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_SOAR_Team</name>
        <label>Get SOAR Team</label>
        <locationX>374</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_User_is_present_in_SOAR_Team_Already</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_SOAR__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CRM_VBS_Team_member__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.UserId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR_Team__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterFormula>ISPICKVAL({!$Record.Opportunity.Core_Opportunity_Coverage_Nm__c}, &apos;Intel-Led Opportunity&apos;) &amp;&amp; 
(OR(ISPICKVAL({!$Record.Opportunity.Core_VBS_Status__c} , &apos;Pending&apos;),ISPICKVAL({!$Record.Opportunity.Core_VBS_Status__c} , &apos;SOAR1 Qualified&apos;))) &amp;&amp; {!$Record.Opportunity.Core_VBS_Potential__c} &amp;&amp; {!$Record.User.IsActive} &amp;&amp; {!$Record.User.Core_User_Type__c}= &apos;Internal User&apos;</filterFormula>
        <object>OpportunityTeamMember</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_SOAR_Record</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
