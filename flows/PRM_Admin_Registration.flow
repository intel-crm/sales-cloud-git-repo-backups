    <assignments>
        <name>Account_and_Contact_Assignment</name>
        <label>Account and Contact Assignment</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>ConfirmedAccounts</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>AccountExistingToContact</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ConfirmedContacts</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>duplicateContactRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Confirmation</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;path&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Account_and_Contact_Check</name>
        <label>Account and Contact Check</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>New_Account_Restriction_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_is_already_assigned</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>AccountExistingToContact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ExistingAccounts.selectedRows</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountExistingToContact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_and_Contact_Assignment</targetReference>
            </connector>
            <label>Account is already assigned?</label>
        </rules>
    </decisions>
    <description>This is an Admin Registration Screen flow used in Admin Registration Tab.</description>
