    <environments>Default</environments>
    <formulas>
        <name>AccountExists</name>
        <dataType>Boolean</dataType>
        <expression>!ISBLANK({!Gettheaccountdetails.Results.Account.Name})</expression>
    </formulas>
    <formulas>
        <name>accountIdText</name>
        <dataType>String</dataType>
        <expression>IF(!ISNULL({!Gettheaccountdetails.Results.Contact.AccountId}),{!Gettheaccountdetails.Results.Contact.AccountId}, {!FinalSelectedAccount.Id} )</expression>
    </formulas>
    <formulas>
        <name>AddressVerifiedCity</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!AddressVerification.verifiedCity})), {!AddressVerification.verifiedCity}, {!AccountRequestQueue.Address__City__s})</expression>
    </formulas>
    <formulas>
        <name>AddressVerifiedCountryCode</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!AddressVerification.verifiedCountryCode})), {!AddressVerification.verifiedCountryCode}, TEXT({!AccountRequestQueue.Address__CountryCode__s}))</expression>
    </formulas>
    <formulas>
        <name>AddressVerifiedPostalCode</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!AddressVerification.verifiedPostalCode})), {!AddressVerification.verifiedPostalCode}, {!AccountRequestQueue.Address__PostalCode__s})</expression>
    </formulas>
    <formulas>
        <name>AddressVerifiedStateCode</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!AddressVerification.verifiedStateCode})), {!AddressVerification.verifiedStateCode}, TEXT({!AccountRequestQueue.Address__StateCode__s}))</expression>
    </formulas>
    <formulas>
        <name>AddressVerifiedStreet</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!AddressVerification.verifiedStreet})), {!AddressVerification.verifiedStreet}, {!AccountRequestQueue.Address__Street__s})</expression>
    </formulas>
    <formulas>
        <name>ContactFullName</name>
        <dataType>String</dataType>
        <expression>{!First_Name} +&apos; &apos;+{!Last_Name}</expression>
    </formulas>
    <formulas>
        <name>disableEdits</name>
        <dataType>Boolean</dataType>
        <expression>{!AccountExists} || {!RegistrationRequestExists}</expression>
    </formulas>
    <formulas>
        <name>disablePartnerRoleEdits</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Gettheaccountdetails.Results.Account.Core_IPA_Partner_Role__c}))</expression>
    </formulas>
    <formulas>
        <name>disableUserDefinedWebsiteEdits</name>
        <dataType>Boolean</dataType>
        <expression>( {!AccountExists} || {!RegistrationRequestExists} ) &amp;&amp; NOT( ISBLANK({!Gettheaccountdetails.Results.Account.Core_User_Defined_Website__c}))</expression>
    </formulas>
    <formulas>
        <name>EditAQR</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!Enable_Edit})</expression>
    </formulas>
    <formulas>
        <name>EndUserMessage</name>
        <dataType>String</dataType>
        <expression>MID(
    {!FlowFaultMessage}, 
    FIND(&quot;EXCEPTION: &apos;&quot;, {!FlowFaultMessage}) + LEN(&quot;EXCEPTION: &apos;&quot;), 
    FIND(&quot;You can look up ExceptionCode&quot;, {!FlowFaultMessage}) - FIND(&quot;EXCEPTION: &apos;&quot;, {!FlowFaultMessage}) - 
LEN(&quot;EXCEPTION: &apos;&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>ExistingPartnerRole</name>
        <dataType>String</dataType>
        <expression>TEXT({!Gettheaccountdetails.Results.PendingACM.PRM_Partner_Role__c})</expression>
    </formulas>
    <formulas>
        <name>LockRegistrationAccountName</name>
        <dataType>Boolean</dataType>
        <expression>{!disableEdits} || ({!SearchPrefillActive} &amp;&amp; NOT(ISBLANK({!Account_Search.selectedName})))</expression>
    </formulas>
    <formulas>
        <name>LockRegistrationAccountWebsite</name>
        <dataType>Boolean</dataType>
        <expression>{!disableUserDefinedWebsiteEdits} || ({!SearchPrefillActive} &amp;&amp; NOT(ISBLANK({!Account_Search.selectedWebsite})))</expression>
    </formulas>
    <formulas>
        <name>LockRegistrationCity</name>
        <dataType>Boolean</dataType>
        <expression>{!SearchPrefillActive} &amp;&amp; NOT(ISBLANK({!Account_Search.selectedCity}))</expression>
    </formulas>
    <formulas>
        <name>LockRegistrationCountry</name>
        <dataType>Boolean</dataType>
        <expression>{!SearchPrefillActive} &amp;&amp; (NOT(ISBLANK({!Account_Search.selectedCountry})) || NOT(ISBLANK({!Account_Search.selectedCountryCode})))</expression>
    </formulas>
    <formulas>
        <name>LockRegistrationPartnerRole</name>
        <dataType>Boolean</dataType>
        <expression>{!SearchPrefillActive} &amp;&amp; NOT(ISBLANK({!Account_Search.selectedPartnerRole}))</expression>
    </formulas>
    <formulas>
        <name>LockRegistrationPostalCode</name>
        <dataType>Boolean</dataType>
        <expression>{!SearchPrefillActive} &amp;&amp; NOT(ISBLANK({!Account_Search.selectedPostalCode}))</expression>
    </formulas>
    <formulas>
        <name>LockRegistrationState</name>
        <dataType>Boolean</dataType>
        <expression>{!SearchPrefillActive} &amp;&amp; (NOT(ISBLANK({!Account_Search.selectedState})) || NOT(ISBLANK({!Account_Search.selectedStateCode})))</expression>
    </formulas>
    <formulas>
        <name>LockRegistrationStreet</name>
        <dataType>Boolean</dataType>
        <expression>{!SearchPrefillActive} &amp;&amp; NOT(ISBLANK({!Account_Search.selectedStreet}))</expression>
    </formulas>
    <formulas>
        <description>Checking for Blocked Email domain for non-PRC</description>
        <name>Non_PRC_Blocked_Email_Domain</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    NOT(CONTAINS({!Region_PRC_NonPRC}, &quot;PRC&quot;)),
    IF(
        CONTAINS(&quot;;&quot; &amp; {!$Label.Blocked_Domains_Non_Prc1} &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT({!Email.value}, LEN({!Email.value}) - FIND(&quot;@&quot;, {!Email.value})) &amp; &quot;;&quot;),
        TRUE,
        IF(
            CONTAINS(&quot;;&quot; &amp; {!$Label.Blocked_Domains_Non_Prc2} &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT({!Email.value}, LEN({!Email.value}) - FIND(&quot;@&quot;, {!Email.value})) &amp; &quot;;&quot;),
            TRUE,
            IF(
                CONTAINS(&quot;;&quot; &amp; {!$Label.Blocked_Domains_Non_Prc3} &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT({!Email.value}, LEN({!Email.value}) - FIND(&quot;@&quot;, {!Email.value})) &amp; &quot;;&quot;),
                TRUE,
                FALSE
            )
        )
    ),
    FALSE
)</expression>
    </formulas>
    <formulas>
        <name>nonEditableRole</name>
        <dataType>Boolean</dataType>
        <expression>NOT (ISBLANK({!Gettheaccountdetails.Results.Account.Core_IPA_Partner_Role__c})) &amp;&amp; NOT(ISNULL({!Gettheaccountdetails.Results.Account.Core_IPA_Partner_Role__c}))</expression>
    </formulas>
    <formulas>
        <name>PartnerRoleFinalLabel</name>
        <dataType>String</dataType>
        <expression>CASE({!PartnerRoleFinal}, &quot;Builder&quot;, &quot;Builder&quot;, &quot;Distributor&quot;, &quot;Distributor&quot;, &quot;Independent Software Vendor&quot;, &quot;Independent Software Vendor&quot;,&quot;Service Provider&quot;,&quot;Cloud &amp; Comms Service Provider&quot;,&quot;Solution Integrator&quot;,&quot;Solution Integrator&quot;,&quot;Guest&quot;,&quot;Guest&quot;, {!PartnerRoleFinal})</expression>
    </formulas>
    <formulas>
        <description>Checking for PRC Blocked Email Domain</description>
        <name>PRC_Blocked_Email_Domain</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    CONTAINS({!Region_PRC_NonPRC}, &quot;PRC&quot;),
    IF(
        CONTAINS(&quot;;&quot; &amp; {!$Label.Blocked_Domains_Prc1} &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT({!Email.value}, LEN({!Email.value}) - FIND(&quot;@&quot;, {!Email.value})) &amp; &quot;;&quot;),
        TRUE,
        IF(
            CONTAINS(&quot;;&quot; &amp; {!$Label.Blocked_Domains_Prc2} &amp; &quot;;&quot;, &quot;;&quot; &amp; RIGHT({!Email.value}, LEN({!Email.value}) - FIND(&quot;@&quot;, {!Email.value})) &amp; &quot;;&quot;),
            TRUE,
            FALSE
        )
    ),
    FALSE
)</expression>
    </formulas>
    <formulas>
        <name>readOnlyUserDefinedWebsite</name>
        <dataType>Boolean</dataType>
        <expression>{!AccountExists} &amp;&amp; NOT(ISBLANK({!Gettheaccountdetails.Results.Account.Core_User_Defined_Website__c}))</expression>
    </formulas>
    <formulas>
        <description>Region is prc or non prc?</description>
        <name>Region_PRC_NonPRC</name>
        <dataType>String</dataType>
        <expression> IF(
    CONTAINS(&quot;HKG:CHN:MAC&quot;, {!Contact_Country}), 
    &quot;PRC&quot;, 
    &quot;OTHER&quot;
  )</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountCity</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedCity}, {!Gettheaccountdetails.Results.Account.BillingCity})</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountCountry</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedCountry}, {!Gettheaccountdetails.Results.Account.BillingCountry})</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountCountryCode</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedCountryCode}, TEXT({!Gettheaccountdetails.Results.Account.BillingCountryCode}))</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountName</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedName}, {!Gettheaccountdetails.Results.Account.Name})</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountPartnerRole</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedPartnerRole}, {!Account_Search.existingPartnerRoleText})</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountPostalCode</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedPostalCode}, {!Gettheaccountdetails.Results.Account.BillingPostalCode})</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountState</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedState}, {!Gettheaccountdetails.Results.Account.BillingState})</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountStateCode</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedStateCode}, TEXT({!Gettheaccountdetails.Results.Account.BillingStateCode}))</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountStreet</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedStreet}, {!Gettheaccountdetails.Results.Account.BillingStreet})</expression>
    </formulas>
    <formulas>
        <name>RegistrationAccountWebsite</name>
        <dataType>String</dataType>
        <expression>IF({!SearchPrefillActive}, {!Account_Search.selectedWebsite}, {!Gettheaccountdetails.Results.Account.Core_User_Defined_Website__c})</expression>
    </formulas>
    <formulas>
        <name>RegistrationRequestExists</name>
        <dataType>Boolean</dataType>
        <expression>!ISBLANK({!Gettheaccountdetails.Results.Registration.Id})</expression>
    </formulas>
    <formulas>
        <name>RuningUserName</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName} &amp;&apos; &apos;&amp;{!$User.LastName}</expression>
    </formulas>
    <formulas>
        <name>SearchOrContactAccountId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Gettheaccountdetails.Results.Contact.AccountId})), {!Gettheaccountdetails.Results.Contact.AccountId}, IF({!SearchPrefillActive} &amp;&amp; {!Account_Name} = {!Account_Search.selectedName} &amp;&amp; {!User_Defined_Website} = {!Account_Search.selectedWebsite}, {!Account_Search.selectedAccountId}, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>SearchPrefillActive</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!disableEdits}) &amp;&amp; NOT(ISBLANK({!Account_Search.selectedAccountId}))</expression>
    </formulas>
    <formulas>
        <name>ShowMessage</name>
        <dataType>Boolean</dataType>
        <expression>{!AccountExists}</expression>
    </formulas>
    <formulas>
        <name>SubmitJSON</name>
        <dataType>String</dataType>
        <expression>&quot;{ \&quot;AccountID\&quot;: \&quot;&quot; &amp; IF(!ISNULL({!Gettheaccountdetails.Results.Contact.AccountId}),{!Gettheaccountdetails.Results.Contact.AccountId}, {!FinalSelectedAccount.Id} ) &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;AccountName\&quot;: \&quot;&quot; &amp; {!Account_Name} &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;AddressLine1\&quot;: \&quot;&quot; &amp; {!Address.street} &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;PartnerRole\&quot;: \&quot;&quot; &amp;{!PartnerRoleFinalLabel} &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;Country\&quot;: \&quot;&quot; &amp; {!Address.country} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;State\&quot;: \&quot;&quot; &amp; {!Address.province} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;City\&quot;: \&quot;&quot; &amp; {!Address.city} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;PostalCode\&quot;: \&quot;&quot; &amp; {!Address.postalCode}&amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;Website\&quot;: \&quot;&quot; &amp; {!User_Defined_Website} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;ContactFirstName\&quot;: \&quot;&quot; &amp; {!First_Name} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;ContactLastName\&quot;: \&quot;&quot; &amp; {!Last_Name} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;ContactEmail\&quot;: \&quot;&quot; &amp; {!Email.value} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;PreferredLanguage\&quot;: \&quot;&quot; &amp; {!Preferred_Language} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;ContactCountry\&quot;: \&quot;&quot; &amp; {!Address.country} &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;DuplicateInfo\&quot;: \&quot;&quot; &amp; null &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;SelectedRow\&quot;: &quot; &amp; IF(NOT(ISBLANK({!Get_Selected_Account_JSON})), {!Get_Selected_Account_JSON}, &quot;[]&quot;) &amp; &quot;,&quot; &amp;
&quot;\&quot;ContactDuplicateStatus\&quot;: \&quot;&quot; &amp;  {!contactDupStatus} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;AssociatedAccountIsIPA\&quot;: \&quot;&quot; &amp; IF({!AssociatedAccountIsIPA}, &apos;true&apos;, &apos;false&apos;) &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;SuppressEmail\&quot;: \&quot;&quot; &amp; IF({!Suppress_Email}, &apos;true&apos;, &apos;false&apos;) &amp;
&quot;\&quot; }&quot;</expression>
    </formulas>
    <formulas>
        <name>SubmitJSONUpdated</name>
        <dataType>String</dataType>
        <expression>&quot;{ \&quot;AccountID\&quot;: \&quot;&quot; &amp; {!Account_Id}  &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;AccountName\&quot;: \&quot;&quot; &amp; {!Account_Name} &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;AddressLine1\&quot;: \&quot;&quot; &amp; {!Address.street} &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;PartnerRole\&quot;: \&quot;&quot; &amp;{!PartnerRoleFinalLabel} &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;Country\&quot;: \&quot;&quot; &amp; {!Address.country} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;State\&quot;: \&quot;&quot; &amp; {!Address.province} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;City\&quot;: \&quot;&quot; &amp; {!Address.city} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;PostalCode\&quot;: \&quot;&quot; &amp; {!Address.postalCode}&amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;Website\&quot;: \&quot;&quot; &amp; {!User_Defined_Website} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;ContactFirstName\&quot;: \&quot;&quot; &amp; {!First_Name} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;ContactLastName\&quot;: \&quot;&quot; &amp; {!Last_Name} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;ContactEmail\&quot;: \&quot;&quot; &amp; {!Email.value} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;PreferredLanguage\&quot;: \&quot;&quot; &amp; {!Preferred_Language} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;ContactCountry\&quot;: \&quot;&quot; &amp; {!Contact_Country} &amp; &quot;\&quot;, &quot; &amp; 
&quot;\&quot;DuplicateInfo\&quot;: \&quot;&quot; &amp; null &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;SelectedRow\&quot;: &quot; &amp; IF(NOT(ISBLANK({!Get_Selected_Account_JSON})), {!Get_Selected_Account_JSON}, &quot;[]&quot;) &amp; &quot;,&quot; &amp;
&quot;\&quot;ContactDuplicateStatus\&quot;: \&quot;&quot; &amp;  {!contactDupStatus} &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;AssociatedAccountIsIPA\&quot;: \&quot;&quot; &amp; IF({!AssociatedAccountIsIPA}, &apos;true&apos;, &apos;false&apos;) &amp; &quot;\&quot;, &quot; &amp;
&quot;\&quot;SuppressEmail\&quot;: \&quot;&quot; &amp; IF({!Suppress_Email}, &apos;true&apos;, &apos;false&apos;) &amp;
&quot;\&quot; }&quot;</expression>
    </formulas>
    <formulas>
        <name>ToastMessage</name>
        <dataType>String</dataType>
        <expression>IF({!getEmbargoedCountriesBoolean.Results.EmbargoedCountry}, &apos;This registration was denied because the registrant identified their location as an embargoed country or their IP address is from an embargoed country. For more information please visit please visit https://goto.intel.com/gec-sanctioned-country-info&apos;, IF({!Gettheaccountdetails.Results.ExistingAccount},&apos;This contact is already part of the IPA Account - &apos;&amp;{!Gettheaccountdetails.Results.Account.Name}&amp;&apos; for the &apos;&amp;TEXT({!Gettheaccountdetails.Results.Contact.Core_IPA_PartnerRole__c}) &amp;&apos;Role&apos;,IF({!Gettheaccountdetails.Results.BlockedAccountContact},&apos;This account is blocked for IPA Registration&apos;,&apos;&apos;)))</expression>
    </formulas>
    <formulas>
        <name>ToastMode</name>
        <dataType>String</dataType>
        <expression>&apos;sticky&apos;</expression>
    </formulas>
    <formulas>
        <description>This value is derived in this flow</description>
        <name>ToastTitle</name>
        <dataType>String</dataType>
        <expression>IF( OR({!getEmbargoedCountriesBoolean.Results.EmbargoedCountry}, {!EmbargoedCotriesAccount.Results.EmbargoedCountry}), &apos;Embargoed Countries are not allowed&apos;, IF({!Gettheaccountdetails.Results.ExistingAccount},&apos;Existing Account&apos;,IF({!Gettheaccountdetails.Results.BlockedAccountContact},&apos;Blocked Account&apos;,&apos;&apos;)))</expression>
    </formulas>
    <formulas>
        <name>ToastVariant</name>
        <dataType>String</dataType>
        <expression>&apos;warning&apos;</expression>
    </formulas>
    <interviewLabel>Admin Registration {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>Admin Registration</label>
    <loops>
        <name>Create_Account_JSON</name>
        <label>Create Account JSON</label>
        <locationX>1106</locationX>
        <locationY>2738</locationY>
        <collectionReference>ConfirmedAccounts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>FinalSelectedActs</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Assign_AccountId_For_JSON</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Create_Contact_JSON</name>
        <label>Create Contact JSON</label>
        <locationX>1106</locationX>
        <locationY>2438</locationY>
        <collectionReference>ConfirmedContacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>FinalSelectedContacts</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Account_JSON</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Iterate_Over_Duplicate_Accounts</name>
        <label>Iterate Over Duplicate Accounts</label>
        <locationX>1766</locationX>
        <locationY>1406</locationY>
        <collectionReference>MatchingAccounts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Accounts_to_a_List</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Duplicate_Information_screen</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Account_Request_Queue</name>
        <label>Create Account Request Queue</label>
        <locationX>1898</locationX>
        <locationY>2678</locationY>
        <connector>
            <targetReference>NavigateToRecord</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Error</targetReference>
        </faultConnector>
        <inputReference>AQR</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_Log</name>
        <label>Create Log</label>
        <locationX>1634</locationX>
        <locationY>3578</locationY>
        <connector>
            <targetReference>FinalSubmissionError</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <stringValue>Admin Registration Flow Failed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>Admin Registration - Screen Flow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Log_Error</name>
        <label>Log Error</label>
        <locationX>2162</locationX>
        <locationY>2786</locationY>
        <connector>
            <targetReference>Fault_Message</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <stringValue>An Exception Occured with AQR Creation</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>Admin Registration : Flow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get if any existing ACR</description>
        <name>Check_existing_ACR</name>
        <label>Check existing ACR</label>
        <locationX>743</locationX>
        <locationY>866</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Existing_Active_ACR_present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_InActive_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Contact_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Check_existing_Contact.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Action</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_Account_Contact_Relationship__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Check_Existing_AQR</name>
        <label>Check Existing AQR</label>
        <locationX>2162</locationX>
        <locationY>2462</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Existing_Record_Present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AQR.Account_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Alternate_Language_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AQR.Core_Alternate_Language_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Address__CountryCode__s</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AQR.Address__CountryCode__s</elementReference>
            </value>
        </filters>
        <filters>
            <field>Address__Street__s</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AQR.Address__Street__s</elementReference>
            </value>
        </filters>
        <filters>
            <field>Address__City__s</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AQR.Address__City__s</elementReference>
            </value>
        </filters>
        <filters>
            <field>Address__StateCode__s</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AQR.Address__StateCode__s</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account_Create_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Check_existing_Contact</name>
        <label>Check existing Contact</label>
        <locationX>743</locationX>
        <locationY>758</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_existing_ACR</targetReference>
        </connector>
