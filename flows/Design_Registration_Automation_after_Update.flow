    <decisions>
        <name>All_Products_Are_Rejected</name>
        <label>All Products Are Rejected?</label>
        <locationX>578</locationX>
        <locationY>1679</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Reject_DR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Rejected_DRP_Ids</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>DRP_Ids</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_DR_Record_Types_Ids</targetReference>
            </connector>
            <label>Reject DR</label>
        </rules>
        <rules>
            <name>Resubmitted_DR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Re-Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Pending_Product_Cnt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_as_Approved</targetReference>
            </connector>
            <label>Resubmitted DR</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_DDI_Flag</name>
        <label>Check for DDI Flag</label>
        <locationX>798</locationX>
        <locationY>971</locationY>
        <defaultConnector>
            <targetReference>Iter_over_l5_Mappings</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>InEligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Iter_over_l5_Mappings.PCC_Product_MM_Attribute_Mapping__r.Eligible_for_DDI_Payment__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reject_Product_Record</targetReference>
            </connector>
            <label>InEligible?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_Submitted_Design</name>
        <label>Check for Submitted Design?</label>
        <locationX>1106</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Submitted</name>
            <conditionLogic>(1 AND 2 AND 3) AND (4  OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_Design_Registration_Status_Nm__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Partner_Account_Id__r.Core_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Partner_Account_Id__r.Core_Sub_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NAR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_All_DRP_Records</targetReference>
            </connector>
            <label>Submitted?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>EndCustomerName</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Core_End_Customer_Account_Id__c})), {!$Record.Core_End_Customer_Account_Id__r.Name},{!$Record.Core_End_Customer_Nm__c})</expression>
    </formulas>
    <formulas>
        <name>TableRowForRejection</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;tr&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Add_items_to_table.Name}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Add_items_to_table.Core_Product_Id__r.Name}+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px; text-align: center;&quot;&gt;&apos; + {!Add_items_to_table.Core_Partner_Tracking_Cd__c}+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + TEXT({!Add_items_to_table.Core_Design_Product_Status_Nm__c})+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Add_items_to_table.Core_Comment_Txt__c}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px ; width:150px;&quot;&gt;&apos; + TEXT({!Add_items_to_table.CreatedDate})+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; +&apos;&lt;a href=&quot;https://partner-admin.intel.com/s/core-design-registration-product/&apos; + {!Add_items_to_table.Id} + &apos;&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-family: Arial, sans-serif;&quot;&gt;link&lt;/a&gt;&apos; +
&apos;&lt;/td&gt;&lt;/tr&gt;&apos;</expression>
    </formulas>
