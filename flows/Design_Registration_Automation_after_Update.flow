    <textTemplates>
        <name>RejectionEmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;Hello {!$Record.Owner:User.FirstName},&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;The following Design Registration has been&amp;nbsp;&lt;/span&gt;&lt;strong style=&quot;font-size: 16px; color: rgb(0, 0, 0); font-family: Arial, sans-serif; background-color: rgb(255, 255, 255);&quot;&gt;Rejected&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;Registration Number:&lt;/strong&gt;&lt;span style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;{!$Record.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;Design Registration Name:&lt;/strong&gt;&lt;span style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;{!$Record.Core_Design_Registration_Nm__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;End Customer Name:&lt;/strong&gt;&lt;span style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;{!EndCustomerName}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;Rejection Reason:&lt;/strong&gt;&lt;span style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt; {!$Record.Core_Rejection_Reason_Nm__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;Rejection Comments: &lt;/strong&gt;&lt;span style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;{!$Record.Core_Rejection_Comment_Txt__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;{!table}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;For more details, you can access it by clicking on this&lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;a href=&quot;https://partner-admin.intel.com/s/core-design-registration/{!$Record.Id}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-family: Arial, sans-serif;&quot;&gt;link&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;Thank you.&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
