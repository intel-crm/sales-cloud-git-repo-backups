<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>EntityTypeAssign</name>
        <label>EntityTypeAssign</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>ErrorType</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>ENTITY_IS_LOCKED:</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ErrorScreen</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>FieldCustomValidationAssign</name>
        <label>FieldCustomValidationAssign</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>ErrorType</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>FIELD_CUSTOM_VALIDATION_EXCEPTION:</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ErrorScreen</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>InsufficientAccessAssign</name>
        <label>InsufficientAccessAssign</label>
        <locationX>578</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>ErrorType</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>INSUFFICIENT_ACCESS_OR_READONLY:</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ErrorScreen</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>ErrorTypeCheck</name>
        <label>ErrorTypeCheck</label>
        <locationX>446</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>FIELD_CUSTOM_VALIDATION_EXCEPTION</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>faultMsg</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>FIELD_CUSTOM_VALIDATION_EXCEPTION</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FieldCustomValidationAssign</targetReference>
            </connector>
            <label>FIELD_CUSTOM_VALIDATION_EXCEPTION</label>
        </rules>
        <rules>
            <name>ENTITY_IS_LOCKED</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>faultMsg</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>ENTITY_IS_LOCKED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EntityTypeAssign</targetReference>
            </connector>
            <label>ENTITY_IS_LOCKED</label>
        </rules>
        <rules>
            <name>INSUFFICIENT_ACCESS_OR_READONLY</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>faultMsg</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>INSUFFICIENT_ACCESS_OR_READONLY</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>InsufficientAccessAssign</targetReference>
            </connector>
            <label>INSUFFICIENT_ACCESS_OR_READONLY</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CustomValidation</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT(MID({!faultMsg}, 
FIND({!ErrorType}, {!faultMsg}), 
((FIND(&apos;You can look up ExceptionCode values&apos;, 
{!faultMsg}))-{!firstIndex})), LEN(MID({!faultMsg}, 
FIND({!ErrorType},{!faultMsg}), 
((FIND(&apos;You can look up ExceptionCode values&apos;, 
{!faultMsg}))-{!firstIndex})))-LEN({!ErrorType})))</expression>
    </formulas>
    <formulas>
        <name>fEntityLockedScreenMsg</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT(MID({!fFaultMessage}, FIND(&apos;ENTITY_IS_LOCKED&apos;, {!fFaultMessage}), ((FIND(&apos;You can look up ExceptionCode values&apos;, {!fFaultMessage}))-FIND(&apos;ENTITY_IS_LOCKED&apos;, {!fFaultMessage}))), LEN(MID({!fFaultMessage}, FIND(&apos;ENTITY_IS_LOCKED&apos;, {!fFaultMessage}), ((FIND(&apos;You can look up ExceptionCode values&apos;, {!fFaultMessage}))-FIND(&apos;ENTITY_IS_LOCKED&apos;, {!fFaultMessage}))))-17))</expression>
    </formulas>
    <formulas>
        <name>fFaultMessage</name>
        <dataType>String</dataType>
        <expression>{!faultMsg}</expression>
    </formulas>
    <formulas>
        <name>firstIndex</name>
        <dataType>Number</dataType>
        <expression>FIND({!ErrorType}, {!fFaultMessage})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>LastIndex</name>
        <dataType>Number</dataType>
        <expression>(FIND(&apos;You can look up ExceptionCode values&apos;, {!fFaultMessage}))-{!firstIndex}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>test</name>
        <dataType>Number</dataType>
        <expression>FIND({!ErrorType}, {!fFaultMessage})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core_FlowErrorHandling {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_FlowErrorHandling</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>ErrorScreen</name>
        <label>ErrorScreen</label>
        <locationX>446</locationX>
        <locationY>434</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>displayerror</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;color: rgb(255, 19, 19);&quot;&gt;You encountered some errors when trying to save this record:&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;color: rgb(2, 2, 2);&quot;&gt;{!CustomValidation}&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>ErrorTypeCheck</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>ErrorType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>faultMsg</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
