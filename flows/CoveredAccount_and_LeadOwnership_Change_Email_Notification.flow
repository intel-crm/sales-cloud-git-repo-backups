    <decisions>
        <description>for the workflow &quot; Core_Email_Notification_For_LeadOwnership_Change &quot;</description>
        <name>Core_Email_Notification_For_LeadOwnership_Change</name>
        <label>Core_Email_Notification_For_LeadOwnership_Change</label>
