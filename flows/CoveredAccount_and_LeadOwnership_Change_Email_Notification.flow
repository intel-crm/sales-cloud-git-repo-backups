    <decisions>
        <description>for the email trigger of &quot; Core_CoveredAccount_Email_Notification &quot; workflow</description>
        <name>Covered_Account_Email</name>
        <label>Covered Account Email</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Core_Email_Notification_For_LeadOwnership_Change</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CoveredAccountTriggerEmail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>F_Core_CoveredAccount_Email_Notification</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CoveredAccountLead_Email_Trigger</targetReference>
            </connector>
            <label>CoveredAccountTriggerEmail</label>
        </rules>
    </decisions>
    <description>for the following workflows 
1. Core_CoveredAccount_Email_Notification
2.Core_Email_Notification_For_LeadOwnership_Change</description>
    <environments>Default</environments>
    <formulas>
        <description>has the entry condition for the &quot; Core_CoveredAccount_Email_Notification &quot; Workflow</description>
        <name>F_Core_CoveredAccount_Email_Notification</name>
        <dataType>Boolean</dataType>
        <expression>OR(
     AND( ISNEW(), OR({!$Record.RecordType.Name} = &quot;Lead&quot;, {!$Record.RecordType.Name} = &quot;Sales Lead&quot;), 
	 OR(ISPICKVAL({!$Record.Status}, &quot;Marketing Qualified Lead&quot;),ISPICKVAL({!$Record.Status}, &quot;Sales Generated Lead&quot;)), 
     {!$Record.Core_Covered_account_owner__c}={!$Record.Core_Lead_Owner_Name__c}, {!$Record.Core_Is_Covered_Account__c}=true ),
	 AND( 
		 OR(ISCHANGED({!$Record.Core_Existing_Covered_Account__c}), ISCHANGED({!$Record.OwnerId})), 
		{!$Record.Core_Flag_on_Queue_or_User__c} =&quot;User&quot;,OR({!$Record.RecordType.Name} = &quot;Lead&quot;, {!$Record.RecordType.Name} = &quot;Sales Lead&quot;), 
		OR(ISPICKVAL({!$Record.Status}, &quot;Marketing Qualified Lead&quot;),ISPICKVAL({!$Record.Status}, &quot;Sales Generated Lead&quot;)),
		{!$Record.Core_Covered_account_owner__c}={!$Record.Core_Lead_Owner_Name__c}, {!$Record.Core_Is_Covered_Account__c}=true ))</expression>
    </formulas>
    <formulas>
        <description>for the &quot;  Core_Email_Notification_For_LeadOwnership_Change &quot;Lead Workflow</description>
        <name>F_Core_Email_Notification_For_LeadOwnership_Change</name>
        <dataType>Boolean</dataType>
        <expression>OR(
AND( OR({!$Record.RecordType.Name} = &quot;Lead&quot;, {!$Record.RecordType.Name} = &quot;Sales Lead&quot;),OR(ISPICKVAL({!$Record.Status}, &quot;Marketing Qualified Lead&quot;),
ISPICKVAL({!$Record.Status}, &quot;Sales Generated Lead&quot;)),
ISCHANGED({!$Record.OwnerId}), {!$Record.Core_Flag_on_Queue_or_User__c} =&quot;User&quot;,
OR({!$Record.Core_Covered_account_owner__c} &lt;&gt; {!$Record.Core_Lead_Owner_Name__c}, {!$Record.Core_Covered_account_owner__c} = null) ),

AND( OR({!$Record.RecordType.Name} = &quot;Lead&quot;, {!$Record.RecordType.Name} = &quot;Sales Lead&quot;),
ISPICKVAL( {!$Record.Status}, &quot;Sales Accepted Lead&quot; ), ISCHANGED({!$Record.OwnerId}),
{!$Record.Core_Flag_on_Queue_or_User__c} =&quot;User&quot; ))</expression>
    </formulas>
    <interviewLabel>CoveredAccount_and_ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CoveredAccount_and_LeadOwnership_Change_Email_Notification</label>
