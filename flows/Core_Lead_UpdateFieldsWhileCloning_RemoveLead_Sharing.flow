<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>C_SalesLead</name>
        <dataType>String</dataType>
        <value>
            <stringValue>0121J000000yaQ1QAI</stringValue>
        </value>
    </constants>
    <decisions>
        <description>For the Lead WF
&apos;Core_Lead_Unreachable&apos;</description>
        <name>Core_Lead_Unreachable</name>
        <label>Core_Lead_Unreachable</label>
        <locationX>303</locationX>
        <locationY>298</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Lead_UnreachableTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Unreachable</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FieldUpdateCore_Lead_Unreachable</targetReference>
            </connector>
            <label>Core_Lead_UnreachableTRUE</label>
        </rules>
    </decisions>
    <decisions>
        <description>for the Lead WF
&apos;Core_Remove_Current_Lead_Sharing&apos;</description>
        <name>Core_Remove_Current_Lead_Sharing</name>
        <label>Core_Remove_Current_Lead_Sharing</label>
        <locationX>571</locationX>
        <locationY>493</locationY>
        <defaultConnector>
            <targetReference>Core_Lead_Unreachable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Remove_Current_Lead_SharingTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Remove_Current_Sharing_Ind__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Remove_Current_Sharing_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FieldUpdateCore_Remove_Current_Lead_Sharing</targetReference>
            </connector>
            <label>Core_Remove_Current_Lead_SharingTRUE</label>
        </rules>
    </decisions>
    <decisions>
        <description>for the Lead WF 
&apos;Core_Updatefields_While_Cloning&apos;</description>
        <name>Core_Updatefields_While_Cloning</name>
        <label>Core_Updatefields_While_Cloning</label>
        <locationX>572</locationX>
        <locationY>284</locationY>
        <defaultConnector>
            <targetReference>Core_Remove_Current_Lead_Sharing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Updatefields_While_CloningTrue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>F_Core_Updatefields_While_Cloning</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FieldUpdatesCore_Updatefields_While_Cloning</targetReference>
            </connector>
            <label>Core_Updatefields_While_CloningTrue</label>
        </rules>
    </decisions>
    <description>For the Lead Workflows

&apos;Core_Remove_Current_Lead_Sharing&apos;
&apos;Core_Updatefields_While_Cloning&apos;
&apos;Core_Lead_Unreachable&apos;</description>
    <environments>Default</environments>
    <formulas>
        <name>F_Core_Exit_Date_SALFormula</name>
        <dataType>DateTime</dataType>
        <expression>IF( ISPICKVAL($Record.Status,&apos;Sales Accepted Lead&apos;) ,Now(),  $Record.Core_Exit_Date_SAL__c )</expression>
    </formulas>
    <formulas>
        <name>F_Core_Exit_Date_TALFormula</name>
        <dataType>DateTime</dataType>
        <expression>IF( ISPICKVAL($Record.Status,&apos;Tele Accepted Lead&apos;) ,Now(),  $Record.Core_Exit_Date_TAL__c )</expression>
    </formulas>
    <formulas>
        <name>F_Core_Unreachable_StageFormula</name>
        <dataType>String</dataType>
        <expression>Text($Record.Status)</expression>
    </formulas>
    <formulas>
        <name>F_Core_Updatefields_While_Cloning</name>
        <dataType>Boolean</dataType>
        <expression>OR( AND( ISCLONE(), $Profile.Name &lt;&gt; &quot;Eloqua Integrator&quot; , $Profile.Name &lt;&gt; &quot;Integration&quot; ,$Profile.Name &lt;&gt; &quot;Core Integration&quot;), AND( OR(ISNEW(),ISCLONE()), {!$Record.RecordTypeId} = &quot;0121J000000yaQ1QAI&quot; ) )</expression>
    </formulas>
    <interviewLabel>Core_Lead_Cloning_Lead_Sharing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Lead_UpdateFieldsWhileCloning_RemoveLead_Sharing</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
