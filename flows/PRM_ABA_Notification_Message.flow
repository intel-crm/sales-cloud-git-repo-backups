    <description>Send Notofocation messages to contacts when Solution Marketplace Enhanced Benefit/Solution Marketplace Basic Profile Benefit is provided to the OPID Account</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>IF( [PRM_AccountBenefitAssociation__c].PRM_Partner_Benefit_Id__r.Name = $Label.PRM_Solutions_Marketplace_Enhanced, $Label.PRM_Msgcd_Store_Front, $Label.PRM_Msgcd_Market )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_3832860281</name>
        <dataType>String</dataType>
        <expression>IF( {!myVariable_current.PRM_Partner_Benefit_Id__r.Name} = {!$Label.PRM_Solutions_Marketplace_Enhanced}, {!$Label.PRM_Msgcd_Store_Front}, {!$Label.PRM_Msgcd_Market} )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>If(OR([PRM_AccountBenefitAssociation__c].PRM_Partner_Benefit_Id__r.Name = $Label.PRM_Solutions_Marketplace_Enhanced, [PRM_AccountBenefitAssociation__c].PRM_Partner_Benefit_Id__r.Name = $Label.PRM_Solutions_Marketplace_Basic_Profile),AND([PRM_AccountBenefitAssociation__c].PRM_Account_Id__r.RecordType.DeveloperName = $Label.PRM_Partner_Account_Group_Record_Type,ISPICKVAL([PRM_AccountBenefitAssociation__c].PRM_Status_Nm__c ,&quot;Active&quot;)),False)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>If(OR({!myVariable_current.PRM_Partner_Benefit_Id__r.Name} = {!$Label.PRM_Solutions_Marketplace_Enhanced}, {!myVariable_current.PRM_Partner_Benefit_Id__r.Name} = {!$Label.PRM_Solutions_Marketplace_Basic_Profile}),AND({!myVariable_current.PRM_Account_Id__r.RecordType.DeveloperName} = {!$Label.PRM_Partner_Account_Group_Record_Type},ISPICKVAL({!myVariable_current.PRM_Status_Nm__c} ,&quot;Active&quot;)),False)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>If(OR([PRM_AccountBenefitAssociation__c].PRM_Partner_Benefit_Id__r.Name = $Label.PRM_Solutions_Marketplace_Enhanced, [PRM_AccountBenefitAssociation__c].PRM_Partner_Benefit_Id__r.Name = $Label.PRM_Solutions_Marketplace_Basic_Profile),AND([PRM_AccountBenefitAssociation__c].PRM_Account_Id__r.RecordType.DeveloperName = $Label.PRM_Partner_Account_Group_Record_Type,ISPICKVAL([PRM_AccountBenefitAssociation__c].PRM_Status_Nm__c ,&quot;Active&quot;)),False)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1_pmetrule</name>
        <dataType>Boolean</dataType>
        <expression>If(OR({!myVariable_old.PRM_Partner_Benefit_Id__r.Name} = {!$Label.PRM_Solutions_Marketplace_Enhanced}, {!myVariable_old.PRM_Partner_Benefit_Id__r.Name} = {!$Label.PRM_Solutions_Marketplace_Basic_Profile}),AND({!myVariable_old.PRM_Account_Id__r.RecordType.DeveloperName} = {!$Label.PRM_Partner_Account_Group_Record_Type},ISPICKVAL({!myVariable_old.PRM_Status_Nm__c} ,&quot;Active&quot;)),False)</expression>
    </formulas>
