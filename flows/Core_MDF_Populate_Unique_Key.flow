                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Unique_Key_with_CreatedDate_and_TransferType</targetReference>
            </connector>
            <label>Is Update</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CreatedDatetimeValue</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!CreatedDate})</expression>
    </formulas>
    <formulas>
        <name>SrcAcc_OpnBal_BgdtId_String</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_MDF_Source_Account__c}&amp;&quot;_&quot;&amp;text(floor({!$Record.Core_MDF_From_Account_Opening_Balance__c})) &amp;&quot;.&quot;&amp; lpad(text(({!$Record.Core_MDF_From_Account_Opening_Balance__c}-floor({!$Record.Core_MDF_From_Account_Opening_Balance__c}))*100),2,&quot;0&quot;)&amp;&quot;_&quot;&amp;{!$Record.Core_MDF_Partner_Marketing_Budget__c}</expression>
    </formulas>
    <formulas>
        <name>UniqueStringWithCreatedDate</name>
        <dataType>String</dataType>
        <expression>{!Unique_String}&amp;&quot;_&quot;&amp;TEXT({!$Record.CreatedDate})</expression>
    </formulas>
    <formulas>
        <name>UniqueStringWithCreatedDateAndTransferType</name>
        <dataType>String</dataType>
        <expression>{!Unique_String}&amp;&quot;_&quot;&amp;LEFT(TEXT({!$Record.CreatedDate}),LEN(TEXT({!$Record.CreatedDate}))-1)&amp;&quot;_&quot;&amp;TEXT({!$Record.Core_MDF_Transfer_Type__c})</expression>
    </formulas>
    <formulas>
        <name>UniqueStringWithNowAndTransferType</name>
        <dataType>String</dataType>
        <expression>{!Unique_String}&amp;&quot;_&quot;&amp;LEFT( TEXT( NOW() ),LEN ( TEXT ( NOW() ) ) -1)&amp;&quot;_&quot;&amp;TEXT({!$Record.Core_MDF_Transfer_Type__c})</expression>
    </formulas>
    <formulas>
        <name>UniqueStringWithToday</name>
        <dataType>String</dataType>
        <expression>{!Unique_String}&amp;&quot;_&quot;&amp;LEFT( TEXT( NOW() ),LEN ( TEXT ( NOW() ) ) -1)</expression>
    </formulas>
