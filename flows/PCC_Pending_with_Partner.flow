<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_the_Status</name>
        <label>Check the Status</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Not_Design_Accepted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pending_with_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PCC_Registration_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.PCC_Bypass_Automation</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_status_to_Pending_with_Partner</targetReference>
            </connector>
            <label>Pending with Partner</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>When</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Pending with Partner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pending with Partner</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Log_Entry</name>
        <label>Log Entry</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>Exception_For_Accepted_Status</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
