<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Document_Upload_Email</name>
        <label>Send Document Upload Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>PRM_SendDocumentUploadEmail</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>regRequestList</name>
            <value>
                <elementReference>RegRequestList</elementReference>
            </value>
        </inputParameters>
        <nameSegment>PRM_SendDocumentUploadEmail</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>is_Email_Sent_Successfully</assignToReference>
            <name>output</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_record_to_list_to_pass_as_parameter</name>
        <label>Add record to list to pass as parameter</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RegRequestList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>RegRequest</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Document_Upload_Email</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_email_is_already_sent</name>
        <label>Set email is already sent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Is_Email_Sent_Already</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>If the IPA admin has already sent email to Partner User for Uploading document, then do not send the email again to avoid spamming the Partner.</description>
        <name>Check_if_email_is_sent_already</name>
        <label>Check if email is sent already</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_record_to_list_to_pass_as_parameter</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Document_Upload_Log_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_email_is_already_sent</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>IPA Send Document Upload Email Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>IPA Send Document Upload Email Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the email log record of Document upload email for the corresponding registration request</description>
        <name>Get_existing_email_log</name>
        <label>Get existing email log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_email_is_sent_already</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_IPA_Registration_Request__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email_Template_Name__c</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>IPA Document Upload Email</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_EmailDeliverabilityStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PRM_ToEmailID__c</field>
            <operator>Contains</operator>
            <value>
                <elementReference>RegRequest.PRM_Email_ID__c</elementReference>
            </value>
        </filters>
        <object>PRM_EmailLog__c</object>
        <outputReference>Document_Upload_Log_Record</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Registration_Request_Record</name>
        <label>Get Registration Request Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_existing_email_log</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <outputReference>RegRequest</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>PRM_Email_ID__c</queriedFields>
        <queriedFields>PRM_Preferred_Language__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Registration_Request_Record</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>Document_Upload_Log_Record</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PRM_EmailLog__c</objectType>
    </variables>
    <variables>
        <name>Is_Email_Sent_Already</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>is_Email_Sent_Successfully</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>RegRequest</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>PRM_Registration_Request__c</objectType>
    </variables>
    <variables>
        <name>RegRequestList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
