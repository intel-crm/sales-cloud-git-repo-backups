<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>[22/Jan/25] Flow to populate the unique value combination of the Quota Setup and Territory Target update 12 Dec</description>
    <environments>Default</environments>
    <formulas>
        <name>CPT_QuotaSetup_and_TerritoryTarget</name>
        <dataType>String</dataType>
        <expression>{!$Record.CPT_Quota_Setup__r.Id} &amp; &apos; - &apos; &amp; {!$Record.CPT_Territory_Target__r.Id}</expression>
    </formulas>
    <interviewLabel>CPT Territory Assignment - Before Insert/Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CPT Territory Assignment - Before Insert/Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>...###</description>
        <name>CPT_Populate_Unique_Field_Value</name>
        <label>Populate Unique Field Value</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>CPT_Unique_Identifier__c</field>
            <value>
                <elementReference>CPT_QuotaSetup_and_TerritoryTarget</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CPT_Populate_Unique_Field_Value</targetReference>
        </connector>
        <object>CPT_Territory_Assignment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
