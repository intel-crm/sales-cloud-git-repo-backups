    <decisions>
        <name>CPT_Target_Record_Found</name>
        <label>Target Record Found?</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Target Found</defaultConnectorLabel>
        <rules>
            <name>Target_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CPT_Get_Target_Values.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPT_Copy_Target_Values</targetReference>
            </connector>
            <label>Target Found</label>
        </rules>
    </decisions>
    <description>[25/Nov/26] Flow to populate the unique value combination of the Quota Setup and Territory Target update</description>
    <ends>
