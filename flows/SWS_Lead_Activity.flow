    <decisions>
        <name>Check_Product_Interest</name>
        <label>Check Product Interest</label>
        <locationX>1238</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Different_product_interest</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_available_Product_Interest</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Product_Interest__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Product_Interest</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Related_campaign_member</targetReference>
            </connector>
            <label>Check available Product Interest</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Activity_status_is_Completed_or_Cancelled</name>
        <label>If Activity status is Completed or Cancelled</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Assign_Input_values_to_Activity_Record_with_new_status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CompletedActivity</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Activity_Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Completed</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Input_values_to_Activity_Record</targetReference>
            </connector>
            <label>Completed  Activity</label>
        </rules>
        <rules>
            <name>Cancelled_Activity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Activity_Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Cancelled</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Input_values_to_Activity_Record_with_cancelled</targetReference>
            </connector>
            <label>Cancelled Activity</label>
        </rules>
    </decisions>
