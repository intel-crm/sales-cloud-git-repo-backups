    <decisions>
        <name>PCC_Is_Partner_Account_Covered</name>
        <label>Is Partner Account Covered</label>
        <locationX>1612</locationX>
        <locationY>1271</locationY>
        <defaultConnector>
            <targetReference>get_external_record_link</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PCC_Covered_Partner_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner:User.Account.Core_Covered_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_internal_record_link</targetReference>
            </connector>
            <label>Covered Partner Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Send_Email_Alert_for_Approve_Or_Reject</name>
        <label>Send Email Alert for Approve Or Reject</label>
        <locationX>1282</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Status_is_Approved</name>
            <conditionLogic>1 AND 2 AND 4 AND (3 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Registration_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Deal Registration</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Id__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Message</targetReference>
            </connector>
            <label>If Status is Approved</label>
        </rules>
        <rules>
            <name>If_Status_is_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Registration_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Message_Rejected</targetReference>
            </connector>
            <label>If Status is Rejected</label>
        </rules>
        <rules>
            <name>If_Status_is_Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Expired</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Registration_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Message_Expired</targetReference>
            </connector>
            <label>If Status is Expired</label>
        </rules>
        <rules>
            <name>Deal_Status_is_approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Registration_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Registration</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Message_Approved_Deal</targetReference>
            </connector>
            <label>Deal Status is approved</label>
        </rules>
        <rules>
            <name>PCC_If_Deal_Status_is_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Registration_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Registration</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Message_Deal_Rejected</targetReference>
            </connector>
            <label>If Deal Status is Rejected</label>
        </rules>
        <rules>
            <name>If_Last_status_was_Resubmitted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Re-Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Registration_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Registration</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Message_Deal_Resubmitted</targetReference>
            </connector>
            <label>If Last status was Resubmitted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Send_Email_to_PSAM_or_Alternate_Approver</name>
        <label>Send Email to PSAM or Alternate Approver</label>
        <locationX>1414</locationX>
        <locationY>1487</locationY>
        <defaultConnector>
            <targetReference>Send_Email_Rejection_to_Approver_Account_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PCC_Send_Email_Rejection_to_Approver</targetReference>
            </connector>
            <label>Check Status</label>
        </rules>
    </decisions>
    <description>Runs when status is changed to  Approved or Rejected</description>
    <environments>Default</environments>
    <formulas>
        <name>currentyear</name>
        <dataType>String</dataType>
