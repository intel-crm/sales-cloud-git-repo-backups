    <status>Active</status>
    <textTemplates>
        <name>emailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Hello {!$Record.Owner:User.FirstName},&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;The following Design Registration has been&amp;nbsp;&lt;/span&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Approved&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Registration Number:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;&amp;nbsp;{!$Record.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Design Registration Name:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;&amp;nbsp;{!$Record.Core_Design_Registration_Nm__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;End Customer Name:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;{!EndCustomerName}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;&quot;&gt;Opportunity:&lt;/strong&gt;&lt;span style=&quot;font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 16px; color: rgb(0, 0, 0); font-family: Arial, sans-serif;&quot;&gt;Click&amp;nbsp;&lt;/span&gt;&lt;a href=&quot;https://intel--crmdevint3.sandbox.my.site.com/partneradmin/s/opportunity/{!$Record.Core_Opportunity_Id__c}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;here&lt;/a&gt;&amp;nbsp;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 16px; font-family: Arial, sans-serif;&quot;&gt;to view&lt;/span&gt;.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;{!table}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;It is the Intel Partner&apos;s responsibility to understand the export, customs, and sanction controls applicable to Intel Partner&apos;s company, project, and product and take all actions necessary to ensure compliance.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;For more details, you can access it by clicking on this&lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;a href=&quot;https://intel--crmdevint3.sandbox.my.site.com/partneradmin/s/core-design-registration/{!$Record.Id}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-family: Arial, sans-serif;&quot;&gt;link&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Thank you.&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>EmailBodyforExpiry</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Hello {!$Record.Owner:User.FirstName},&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;The following Design Registration has been&amp;nbsp;&lt;/span&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Expired&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Registration Number:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;&amp;nbsp;{!$Record.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Design Registration Name:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;&amp;nbsp;{!$Record.Core_Design_Registration_Nm__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;End Customer Name:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;&amp;nbsp;{!EndCustomerName}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Rejection Reason:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt; {!$Record.Core_Rejection_Reason_Nm__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;Rejection Comments: &lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-size: 12pt;&quot;&gt;{!$Record.Core_Rejection_Comment_Txt__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;{!table}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;For more details, you can access it by clicking on this&lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;a href=&quot;https://intel--devint3.sandbox.my.site.com/partneradmin/s/core-design-registration/{!$Record.Id}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-family: Arial, sans-serif;&quot;&gt;link&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Thank you.&lt;/span&gt;&lt;/p&gt;</text>
