    </formulas>
    <formulas>
        <name>EmailTableRowForRejection</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;tr&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!PCC_IterateOverDealDRP.Name}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!PCC_IterateOverDealDRP.Core_Product_Id__r.Name}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + TEXT({!PCC_IterateOverDealDRP.Core_Design_Product_Status_Nm__c})+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!PCC_IterateOverDealDRP.Core_Comment_Txt__c}+
