    <decisions>
        <name>Check_for_Account_Feedback_Records</name>
        <label>Check for Account Feedback Records</label>
        <locationX>1711</locationX>
        <locationY>1439</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Feedback_Records_exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ExistingAccountFeedbackRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_Feedback_Update</targetReference>
            </connector>
            <label>Account Feedback Records exists</label>
        </rules>
        <rules>
            <name>No_records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ExistingAccountFeedbackRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_new_Records_have_to_be_created</targetReference>
            </connector>
            <label>No records</label>
        </rules>
    </decisions>
