            </connector>
            <label>If present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Send_Email_to_Lead_owner</name>
        <label>Send Email to Lead owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Product_Interest_details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Sent_Email_to_users</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matching_Lead_to_convert.Owner:User.FirstName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Marketo</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Matching_Lead_to_convert.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Matching_Lead_to_convert.Core_Lead_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Disqualified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_Lead_owner1</targetReference>
            </connector>
            <label>Sent Email to users</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Locationanduser</name>
        <dataType>Boolean</dataType>
        <expression>CASESAFEID({!Get_Custom_setting_2.SetupOwnerId}) =CASESAFEID({!$User.Id})</expression>
    </formulas>
    <formulas>
        <name>twominago</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - (2/1440)</expression>
    </formulas>
    <formulas>
        <name>Username</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName}+&apos; &apos;+{!$User.LastName}</expression>
    </formulas>
