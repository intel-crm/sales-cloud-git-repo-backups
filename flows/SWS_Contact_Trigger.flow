    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <object>Contact</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>Contact_creation</name>
            <connector>
                <targetReference>Get_Matching_Lead_to_convert</targetReference>
            </connector>
            <label>Contact creation</label>
            <maxBatchSize>1</maxBatchSize>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>TaskDescription</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>We identified a Lead record linked to a Contact with the same email address, resulting in duplicate entries. To resolve this, automation has:
1. Converted the Lead and mapped it to the existing Contact.
2. Consolidated all product interest details under the Contact to maintain a complete engagement view.
Updated Product Interests now associated with the Contact:
{!Get_Matching_Lead_to_convert.Core_Product_Interest__c}</text>
    </textTemplates>
    <variables>
        <name>bypassRecord</name>
        <dataType>SObject</dataType>
