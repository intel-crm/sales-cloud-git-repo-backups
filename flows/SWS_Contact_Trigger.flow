    <decisions>
        <name>Check_custom_setting_present_or_not_2</name>
        <label>Check custom setting present or not 2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Update_existing_record_bypass</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Custom_setting_created_now</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Locationanduser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Custom_setting_2.CreatedDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>twominago</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_custom_setting_record</targetReference>
            </connector>
            <label>Custom setting created now</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_custom_setting_record_present_or_not</name>
        <label>Check custom setting record present or not</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_existing_record_bypass</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Custom_setting_not_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Custom_setting</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bypass_records</targetReference>
            </connector>
            <label>Custom setting not present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Lead_Owner_check</name>
        <label>Lead Owner check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Send_Email_to_Lead_owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Owner_is_queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matching_Lead_to_convert.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Lead_Owner</targetReference>
            </connector>
            <label>Owner is queue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Matching_lead_is_present</name>
        <label>Matching lead is present</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Lead not present</defaultConnectorLabel>
        <rules>
            <name>Lead_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matching_Lead_to_convert</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Lead_Owner_check</targetReference>
            </connector>
            <label>Lead present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Product_Interest_details</name>
        <label>Product Interest details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Custom_setting</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matching_Lead_to_convert.Core_Product_Interest__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
