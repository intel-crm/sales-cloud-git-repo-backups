<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>myWaitEvent_myWait_myRule_37_event_0_SA2</name>
        <label>Email to Creator and ISO</label>
        <locationX>242</locationX>
        <locationY>492</locationY>
        <actionName>Case.Core_IPS_Case_Close_Pending_Reminder_Notification_For_NAC</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Case.Core_IPS_Case_Close_Pending_Reminder_Notification_For_NAC</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>enterycheck</name>
        <label>enterycheck</label>
        <locationX>374</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>spiltformula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>myWaitEvent_myWait_myRule_37_event_0_SA1</targetReference>
            </connector>
            <label>yes</label>
        </rules>
    </decisions>
    <description>Migrated from the IPS Internal Notifications process using US78261 - NAC Close Pending - Reminder criteria.
This process builder deals with all internal notifications in IPS</description>
    <environments>Default</environments>
    <formulas>
        <name>spiltformula</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISBLANK({!$Record.Core_Intel_Sup_Owner__c}  ), FALSE,{!$Record.Core_Intel_Sup_Owner__r.IsActive=true})</expression>
    </formulas>
    <label>IPS Internal Notifications_2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>myWaitEvent_myWait_myRule_37_event_0_SA1</name>
        <label>Update Email Text</label>
        <locationX>242</locationX>
        <locationY>384</locationY>
        <connector>
            <targetReference>myWaitEvent_myWait_myRule_37_event_0_SA2</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_IPS_email_text__c</field>
            <value>
                <stringValue>IPS has Close-Pending Reminder on Case</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(

    NOT(IF(({!$User.ProfileId}={!$Label.Core_IPS_Data_Migration_ProfileId}),true,false)),
    {!$Record.Core_IPS_Is_Notification_Active__c} =true,    
    {!$Record.RecordType.DeveloperName} = {!$Label.Core_IPS_NoAssignedContactRecordType_Name} ,
	
	
	 
    AND( ISPICKVAL({!$Record.Status}, &apos;Open&apos;), 
		ISPICKVAL({!$Record.Core_Sub_Status__c}, &apos;Close-Pending&apos;)  
	),
	            
	AND(		
		({!$Record.CreatedById} &lt;&gt; {!$Record.OwnerId} ),
		({!$Record.CreatedById} &lt;&gt; {!$Record.Core_Case_Co_Owner__c} )
	),
	                
	/*Active user check on  case creator and  ISO*/ 
	OR( 
		IF(ISBLANK({!$Record.CreatedById}  ), FALSE,{!$Record.CreatedBy.IsActive}=true)
		
		
	) 
	
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>myWaitEvent_myWait_myRule_37_event_0</name>
            <connector>
                <targetReference>enterycheck</targetReference>
            </connector>
            <label>ScheduledPath_1</label>
            <offsetNumber>10</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Core_IPS_Date_Time_Close_Pending__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
