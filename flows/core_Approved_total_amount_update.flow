    </assignments>
    <constants>
        <name>Productionwin</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Production Win</stringValue>
        </value>
    </constants>
    <constants>
        <name>PW_approved</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Production Win Approved</stringValue>
        </value>
    </constants>
    <constants>
        <name>Win_approved_value</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Win Approved</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Checking_Stage</name>
        <label>Checking Stage</label>
        <locationX>754</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_design_win</name>
            <conditionLogic>1 OR (2 AND (3 OR 4))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_all_DW_related_products</targetReference>
            </connector>
            <label>If design win</label>
        </rules>
        <rules>
            <name>If_Production_Win</name>
            <conditionLogic>1 OR (2 AND (3 OR 4))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>if_deal_Oppty</targetReference>
            </connector>
            <label>If Production Win</label>
        </rules>
        <rules>
            <name>Not_DW_or_PW</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Open_stages</targetReference>
            </connector>
            <label>stage not DW or PW</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_2</name>
        <label>Decision 2</label>
        <locationX>270</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Get_all_sales_price_and_quantity_for_DW</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Decision_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_all_sales_price_and_quantity_for_DW.UnitPrice</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_all_sales_price_and_quantity_for_DW.Quantity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_DW_amount</targetReference>
            </connector>
            <label>Outcome 1 of Decision 2</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_3</name>
        <label>Decision 3</label>
        <locationX>1150</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>Get_all_sales_price_and_Quantity_for_PW</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Decision_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_all_sales_price_and_Quantity_for_PW.Core_PW_Quantity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_all_sales_price_and_Quantity_for_PW.Core_PW_Sales_Price__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_PW_amount</targetReference>
            </connector>
            <label>Outcome 1 of Decision 3</label>
        </rules>
    </decisions>
    <decisions>
        <name>if_deal_Oppty</name>
        <label>if deal Oppty</label>
        <locationX>622</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Get_all_PW_related_products</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_pw_deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Deal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_pw_amount_for_deal</targetReference>
            </connector>
            <label>if pw deal</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>core_Approved_total_amount_update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>core_Approved_total_amount_update</label>
    <loops>
        <name>Get_all_sales_price_and_quantity_for_DW</name>
        <label>Get all sales price and quantity for DW</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <collectionReference>Get_all_DW_related_products</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_2</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_total_DW_amount</targetReference>
        </noMoreValuesConnector>
    </loops>
