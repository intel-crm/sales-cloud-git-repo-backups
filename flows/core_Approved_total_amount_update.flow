<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Approved_DW_amount</name>
        <label>Approved DW amount</label>
        <locationX>138</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>total_design_win_amount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_all_sales_price_and_quantity_for_DW.Core_Approved_Total_Price__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_all_sales_price_and_quantity_for_DW</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Approved_PW_amount</name>
        <label>Approved PW amount</label>
        <locationX>1018</locationX>
        <locationY>863</locationY>
        <assignmentItems>
            <assignToReference>total_PW_amount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_all_sales_price_and_Quantity_for_PW.Core_PW_Approved_Total_Price__c</elementReference>
