    <description>Actions for Contact Creation</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>IF( 
	ISPICKVAL([Contact].Owner.UserType, &apos;PowerPartner&apos;),
	null,
	[Contact].OwnerId
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_5022267332</name>
        <dataType>String</dataType>
        <expression>IF( 
	ISPICKVAL({!myVariable_current.Owner.UserType}, &apos;PowerPartner&apos;),
	null,
	{!myVariable_current.OwnerId}
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>[Contact].CreatedById </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_3_myRule_1_A1_8771704073</name>
        <dataType>String</dataType>
        <expression>{!myVariable_current.CreatedById}</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>[Contact].RecordType.DeveloperName=&apos;Core_Intel_Contact&apos; &amp;&amp; [Contact].Core_IPS_Intel_Support_Owner__r.Id != $Label.PRM_IPARegistration_Integration_UserId </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>{!myVariable_current.RecordType.DeveloperName}=&apos;Core_Intel_Contact&apos; &amp;&amp; {!myVariable_current.Core_IPS_Intel_Support_Owner__r.Id} != {!$Label.PRM_IPARegistration_Integration_UserId}</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>!ISPICKVAL([Contact].CreatedBy.UserType , &apos;Standard&apos;) &amp;&amp; [Contact].Core_IPS_Intel_Support_Owner__r.Id = $Label.PRM_IPARegistration_Integration_UserId </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>!ISPICKVAL({!myVariable_current.CreatedBy.UserType} , &apos;Standard&apos;) &amp;&amp; {!myVariable_current.Core_IPS_Intel_Support_Owner__r.Id} = {!$Label.PRM_IPARegistration_Integration_UserId}</expression>
    </formulas>
