    <decisions>
        <description>Check if Account is turned Inactive.</description>
        <name>Account_turned_Inactive</name>
        <label>Account turned Inactive?</label>
        <locationX>842</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>NoInactiveAcc</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Inactive_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Acc_Details_from_Platform_Event.recordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>InactiveAccount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Channel_Program</targetReference>
            </connector>
            <label>Inactive Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_its_current_location_account</name>
        <label>Check if its current location account</label>
        <locationX>270</locationX>
        <locationY>1334</locationY>
        <defaultConnector>
            <targetReference>loop_affliliations_for_strategyname_of_intel</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>ifnot</defaultConnectorLabel>
        <rules>
            <name>if_current_deactivate_account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_affliliations_for_strategyname_of_intel.PRM_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>IntelAccID</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loop_affliliations_for_strategyname_of_intel.PRM_Active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_intel_accs_strategyname</targetReference>
            </connector>
            <label>if current deactivate account</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_if_OPID_contains_related_affiliations</name>
        <label>check if OPID contains related affiliations</label>
        <locationX>270</locationX>
        <locationY>1826</locationY>
        <defaultConnector>
            <targetReference>loop_affiliations_for_OPID</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>if not</defaultConnectorLabel>
        <rules>
            <name>if_yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_affiliations_for_OPID.PRM_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>opid_id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loop_affiliations_for_OPID.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>opidrecordtype</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>affNameOfLoc</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>loop_affiliations_for_OPID.PRM_Builder_Strategy__r.Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_inactive_status_to_affiliation</targetReference>
            </connector>
            <label>if yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PRM_RemoveIPAAttributionsUponeInactivingAcc {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PRM_RemoveIPAAttributionsUponeInactivingAcc</label>
    <loops>
        <description>Loop the list of ACMS to inactive</description>
        <name>Acm_to_Inactive</name>
        <label>Acm to Inactive</label>
        <locationX>50</locationX>
        <locationY>710</locationY>
        <collectionReference>Get_ACM_Records_To_Inactivate</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_inactive_status_to_Inactive</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>update_ACM_record</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>loop_affiliations_for_OPID</name>
        <label>loop affiliations for OPID</label>
        <locationX>50</locationX>
        <locationY>1718</locationY>
        <collectionReference>get_IPA_Affliation_records_to_inactive</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>check_if_OPID_contains_related_affiliations</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>update_affilitions</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>loop_affliliations_for_strategyname_of_intel</name>
        <label>loop affliliations for strategyname of intel</label>
        <locationX>50</locationX>
        <locationY>1226</locationY>
        <collectionReference>get_IPA_Affliation_records_to_inactive</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_if_its_current_location_account</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>loop_affiliations_for_OPID</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Entry</name>
        <label>Log Entry</label>
        <locationX>842</locationX>
        <locationY>2600</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <elementReference>logentry</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <elementReference>logOrigin</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <elementReference>logProject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <elementReference>logOrigin</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <elementReference>logSeverity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$System.OriginDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_sObjectId__c</field>
            <value>
                <elementReference>IntelAccID</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>When Account is inactivated then Related ACM&apos;s will be inactive</description>
        <name>Get_ACM_Records_To_Inactivate</name>
        <label>Get ACM Records To Inactivate</label>
        <locationX>50</locationX>
        <locationY>602</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Acm_to_Inactive</targetReference>
        </connector>
        <faultConnector>
            <targetReference>If_no_ACM_record_found</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>PRM_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Acc_Details_from_Platform_Event.accID</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Channel_Program_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Channel_Program.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PRM_AccountChannelMembership__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get Intel partner alliance program name</description>
        <name>Get_Channel_Program</name>
        <label>Get Channel Program</label>
        <locationX>50</locationX>
        <locationY>386</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Partner_Program_of_ACM</targetReference>
        </connector>
        <faultConnector>
            <targetReference>channelprogram_not_found</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>PRM_ChannelProgramName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ChannelProgram</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_IPA_Affliation_records_to_inactive</name>
        <label>get IPA Affliation records to inactive</label>
        <locationX>50</locationX>
        <locationY>1118</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>loop_affliliations_for_strategyname_of_intel</targetReference>
        </connector>
        <faultConnector>
            <targetReference>no_records</targetReference>
        </faultConnector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>PRM_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>IntelAccID</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>opid_id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PRM_IPA_Affiliation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>update_ACM_record</name>
