    <description>Update Parent Account, Record Type, IsPartner,  Re share account on owner change</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>$Label.Core_MDF_Dummy_Account_Owner_Id </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_8_myRule_7_A1_6060022985</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_Dummy_Account_Owner_Id}</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(

ISNEW(), 

[Account].RecordType.DeveloperName = 
$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name, 
	
	 
ISBLANK([Account].Core_MDF_Parent_Fund_Account__c.Core_MDF_CoMarketing_Ultimate_Account__c),

[Account].Core_MDF_Parent_Fund_Account__c.RecordType.DeveloperName = 
$Label.Core_MDF_Intel_Account_Record_Type_Developer_Name	

)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(

ISNEW(), 

{!myVariable_current.RecordType.DeveloperName} = 
{!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name}, 
	
	 
ISBLANK({!myVariable_current.Core_MDF_Parent_Fund_Account__r.Core_MDF_CoMarketing_Ultimate_Account__c}),

{!myVariable_current.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName} = 
{!$Label.Core_MDF_Intel_Account_Record_Type_Developer_Name}	

)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(NOT(ISNEW()) , [Account].RecordType.DeveloperName = &apos;Core_MDF_Co_Marketing&apos;, ISCHANGED([Account].OwnerId ) )

</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_10</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISNEW()) , {!myVariable_current.RecordType.DeveloperName} = &apos;Core_MDF_Co_Marketing&apos;, ISCHANGED({!myVariable_current.OwnerId} ) )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(

ISNEW(), 

[Account].RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name, 
	
	NOT(ISBLANK([Account].Core_MDF_Parent_Fund_Account__c.Core_MDF_CoMarketing_Ultimate_Account__c)),

[Account].Core_MDF_Parent_Fund_Account__c.RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name

)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(

ISNEW(), 

{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name}, 
	
	NOT(ISBLANK({!myVariable_current.Core_MDF_Parent_Fund_Account__r.Core_MDF_CoMarketing_Ultimate_Account__c})),

{!myVariable_current.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName} = {!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name}

)</expression>
    </formulas>
