    <description>Update Parent Account, Record Type, IsPartner,  Re share account on owner change</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(ISNEW(), [Account].RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISNEW(), {!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name} )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(ISCHANGED([Account].OwnerId),[Account].RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,False)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!myVariable_current.OwnerId}),{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name},False)</expression>
    </formulas>
