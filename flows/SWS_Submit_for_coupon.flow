    <decisions>
        <name>Check_Response</name>
        <label>Check Response</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Successfully_Submitted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Success</defaultConnectorLabel>
        <rules>
            <name>Failure</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>ResponseFromIDC</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ResponseFromIDC</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Response_Error_Screen</targetReference>
            </connector>
            <label>Failure</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validation</name>
        <label>Validation</label>
        <locationX>644</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MISSINGREQUIREDFIELDS</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Confirmation</targetReference>
            </connector>
            <label>Valid Request</label>
        </rules>
        <rules>
            <name>Not_a_valid_request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MISSINGREQUIREDFIELDS</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Valid_Field_Missing</targetReference>
            </connector>
            <label>Not a valid request</label>
        </rules>
    </decisions>
