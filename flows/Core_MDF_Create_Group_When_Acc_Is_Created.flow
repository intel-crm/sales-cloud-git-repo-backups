<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Core_MDF_Group_Id</name>
        <label>Assign Group Id</label>
        <locationX>513</locationX>
        <locationY>82</locationY>
        <assignmentItems>
            <assignToReference>Group_Record.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Core_MDF_Create_Group_Records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Update_Account_s_Group_Id_Field</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Core_MDF_Check_If_Program_is_IPA_or_Retail</name>
        <label>Check if Program is IPA or Retail</label>
        <locationX>180</locationX>
        <locationY>368</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Go_to_Group_Record_Creation</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Update_Account_Record.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Retail Marketing Funds</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Update_Account_Record.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Partner Alliance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Update_Account_Record.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Client CoMarketing Fund</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Create_Group_Records</targetReference>
            </connector>
            <label>Go to Group Record Creation</label>
        </rules>
    </decisions>
    <interviewLabel>Core_MDF_Create_Group_When_Acc_Is_Created {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Group When Retail Co-Marketing Account Is Created</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Create_Group_Records</name>
        <label>Create Group Records</label>
        <locationX>513</locationX>
        <locationY>368</locationY>
        <connector>
            <targetReference>Core_MDF_Group_Id</targetReference>
        </connector>
        <inputAssignments>
            <field>DeveloperName</field>
            <value>
                <elementReference>Group_Developer_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Group_name</elementReference>
            </value>
        </inputAssignments>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Core_MDF_Update_Account_s_Group_Id_Field</name>
        <label>Update Account&apos;s Group Id Field</label>
        <locationX>834</locationX>
        <locationY>81</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Update_Account_Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Group_Id__c</field>
            <value>
                <elementReference>Group_Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>62</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Core_MDF_Check_If_Program_is_IPA_or_Retail</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>Group_Developer_Name</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>Group_name</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>Group_Record</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Group</objectType>
    </variables>
    <variables>
        <name>Update_Account_Record</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Account</objectType>
    </variables>
</Flow>
