<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Sending Email for creating Marketing Support Requests</description>
        <name>Sending_Email_On_creation_of_Opportunity_support</name>
