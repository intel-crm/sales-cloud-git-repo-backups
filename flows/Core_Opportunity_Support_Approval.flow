    <actionCalls>
        <description>Once a record is submitted submit a record for approval</description>
        <name>Submit_Opportunity_Support_for_Approval</name>
        <label>Submit Opportunity Support for Approval</label>
        <locationX>614</locationX>
        <locationY>496</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>nextApproverIds</name>
            <value>
                <elementReference>Submit_Opportunity_Support_for_Approval.actorIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>Core_Opportunity_Support_Approval</stringValue>
            </value>
        </inputParameters>
        <nameSegment>submit</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>ApproveOrRejected</name>
        <label>ApproveOrRejected</label>
        <locationX>815</locationX>
        <locationY>351</locationY>
        <defaultConnector>
            <targetReference>check_Close_status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>update_end_if_Opp_Sup_closed_0</name>
            <conditionLogic>1 AND ( 2 OR  3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_ApprovedDate</targetReference>
            </connector>
            <label>update end if Opp Sup closed</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_Close_status</name>
        <label>check Close status</label>
        <locationX>1046</locationX>
        <locationY>355</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>update_end_if_Opp_Sup_closed</name>
            <conditionLogic>1 AND (2 OR 3 OR 5 ) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed : Support Provided</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed : Support Not Provided</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_Center_of_Excellence_Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_end_date</targetReference>
            </connector>
            <label>update end if Opp Sup closed</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_for_Approval_Submission</name>
        <label>check for Approval Submission</label>
        <locationX>610</locationX>
        <locationY>348</locationY>
        <defaultConnector>
            <targetReference>ApproveOrRejected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Submit_for_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>checkApprovalCondition</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>CRM_Marketing_Support</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_Opportunity_Support_for_Approval</targetReference>
            </connector>
            <label>Submit for Approval</label>
        </rules>
        <rules>
            <name>Send_Email_For_Marketing_Support_Creation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Marketing Support</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>MarketingSupportStatus</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CreatedDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>currentDateAndTime</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LastModifiedDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>currentDateAndTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Record_for_MS_Email</targetReference>
            </connector>
            <label>Send Email For Marketing Support Creation</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if a record of the public group for Marketing support Email Is Null</description>
        <name>Check_Record_for_MS_Email_Is_Null</name>
        <label>Check Record for MS Email Is Null</label>
        <locationX>213</locationX>
        <locationY>621</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Record_for_MS_Email_Not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_MS_Email_Group_Member</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sending_Email_On_creation_of_Opportunity_support</targetReference>
            </connector>
            <label>Check Record for MS Email Not null</label>
        </rules>
    </decisions>
    <description>adding Cancelled request to resubmit for Approval</description>
    <environments>Default</environments>
    <formulas>
        <name>checkApprovalCondition</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Core_Status__c}, &apos;Submitted&apos;) &amp;&amp;  ( ISNEW() || ISPICKVAL(PRIORVALUE({!$Record.Core_Status__c}),&apos;Rejected&apos;) || ISPICKVAL(PRIORVALUE({!$Record.Core_Status__c}),&apos;Cancelled&apos;))</expression>
    </formulas>
    <formulas>
        <name>currentDateAndTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT(NOW()))</expression>
    </formulas>
    <interviewLabel>Core_Opportunity_Support_Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Support Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
