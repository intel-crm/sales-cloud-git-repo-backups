    <decisions>
        <name>Check_Has_Business_Admin_User_Permission</name>
        <label>Check Has Business Admin User Permission</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Perform_Bulk_Update_Or_Insert_On_Quote_Or_Quote_Team2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>User_Have_Permission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetLoggedinUserPermissionSetBusinessAdmin</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>True</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Perform_Bulk_Update_Or_Insert_On_Quote_Or_Quote_Team_For_BA</targetReference>
            </connector>
            <label>User Have Permission</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricing_Check_for_Error_Outcomes</name>
        <label>Check for Error Outcomes</label>
        <locationX>182</locationX>
        <locationY>650</locationY>
        <defaultConnector>
            <targetReference>Pricing_Display_Success_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pricing_Error</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Pricing_Error_Indicator</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_Display_Error_Screen</targetReference>
            </connector>
            <label>Error?</label>
        </rules>
    </decisions>
    <description>Flow used to Bulk Update or Insert Quote&apos;s Account Executive or Sales Rep with the provided Account Executive Email Address or the Sales Rep Email Address respectively.</description>
    <environments>Default</environments>
    <formulas>
        <name>Pricing_Get_AE_User</name>
        <dataType>String</dataType>
        <expression>{!$User.Email}</expression>
    </formulas>
    <formulas>
        <name>Pricing_Get_FSE_User</name>
        <dataType>String</dataType>
        <expression>{!$User.Email}</expression>
    </formulas>
    <interviewLabel>Pricing Bulk AE Sales Rep Update Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Add/Update Account Executive or SDM/FSE</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Perform_Bulk_Update_Or_Insert_On_Quote_Or_Quote_Team2</name>
        <label>Perform Bulk Update Or Insert On Quote Or Quote Team</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Invoke_Batch_To_Update_Or_Insert_AE_SDM</targetReference>
        </connector>
        <fields>
            <name>Pricing_Bulk_Update_Tooltip2</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(23, 43, 77); font-size: 12px; background-color: rgb(255, 255, 255);&quot;&gt;If you are listed as an SDM/FSE or Account Executive on multiple quotes, use this functionality to replace yourself or to add your coverage.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Pricing_Select_AE_SalesRep2</name>
            <choiceReferences>Pricing_Account_Executive</choiceReferences>
            <choiceReferences>Pricing_Sales_Rep</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Your role</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Pricing_AE_Action_Inputs2</name>
            <choiceReferences>Pricing_AE_Update</choiceReferences>
            <choiceReferences>Pricing_AE_Insert</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Select the type of update</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Pricing_Select_AE_SalesRep2</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_Account_Executive</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Pricing_FSE_Action_Inputs2</name>
            <choiceReferences>Pricing_FSE_Update</choiceReferences>
            <choiceReferences>Pricing_FSE_Insert</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Select the type of update</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Pricing_Select_AE_SalesRep2</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_Sales_Rep</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Pricing_New_FSE_Email2</name>
            <dataType>String</dataType>
            <fieldText>Email address of SDM/FSE to add</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;{!Pricing_Email_Validation_Error_Msg}&lt;/p&gt;</errorMessage>
                <formulaExpression>AND(REGEX({!Pricing_New_FSE_Email2}, &quot;(\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)(;\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)*&quot;),CONTAINS({!Pricing_New_FSE_Email2},&quot;@intel.com&quot;))</formulaExpression>
            </validationRule>
            <visibilityRule>
                <conditionLogic>1 OR 2</conditionLogic>
                <conditions>
                    <leftValueReference>Pricing_FSE_Action_Inputs2</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_FSE_Insert</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Pricing_FSE_Action_Inputs2</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_FSE_Update</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Pricing_Old_FSE_Email2</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>$User.Email</elementReference>
            </defaultValue>
            <fieldText>Add the above SDM/FSE to this SDM&apos;s/FSE&apos;s quotes (email address)</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;{!Pricing_Email_Validation_Error_Msg}&lt;/span&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>AND(REGEX({!Pricing_Old_FSE_Email2}, &quot;(\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)(;\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)*&quot;),CONTAINS({!Pricing_Old_FSE_Email2},&quot;@intel.com&quot;))</formulaExpression>
            </validationRule>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Pricing_FSE_Action_Inputs2</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_FSE_Insert</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Pricing_New_AE_Email2</name>
            <dataType>String</dataType>
            <fieldText>Provide the New Account Executive Email</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;{!Pricing_Email_Validation_Error_Msg}&lt;/p&gt;</errorMessage>
                <formulaExpression>AND(REGEX({!Pricing_New_AE_Email2}, &quot;(\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)(;\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)*&quot;),CONTAINS({!Pricing_New_AE_Email2},&quot;@intel.com&quot;),({!$User.Email} &lt;&gt; {!Pricing_New_AE_Email2}))</formulaExpression>
            </validationRule>
            <visibilityRule>
                <conditionLogic>1 OR 2</conditionLogic>
                <conditions>
                    <leftValueReference>Pricing_AE_Action_Inputs2</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_AE_Insert</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Pricing_AE_Action_Inputs2</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_AE_Update</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <nextOrFinishButtonLabel>Perform Bulk Action</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
