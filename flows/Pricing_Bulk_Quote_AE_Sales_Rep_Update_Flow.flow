    <screens>
        <name>Perform_Bulk_Update_Or_Insert_On_Quote_Or_Quote_Team_For_BA</name>
        <label>Perform Bulk Update Or Insert On Quote Or Quote Team For BA</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
