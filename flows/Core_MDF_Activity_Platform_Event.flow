        </inputParameters>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>mohammad.hamzax.akhtar@intel.com</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
