    <decisions>
        <name>Approval_process_entry_criteria</name>
        <label>Approval process entry criteria</label>
        <locationX>1568</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Program_is_CCF_DCF</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4 OR  5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Client Co-Marketing Fund</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Data Center Co-Marketing Fund</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF+</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OEM CMP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Service Provider CMP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opal_Approval_Process</targetReference>
            </connector>
            <label>Program is CCF/DCF</label>
        </rules>
        <rules>
            <name>Program_is_RMF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Retail Marketing Funds</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RMF_Approval_Process</targetReference>
            </connector>
            <label>Program is RMF</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opal_Approval_Process</name>
        <label>Opal Approval Process</label>
        <locationX>446</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>POR</name>
            <conditionLogic>1 AND 2 AND (3 OR 4 OR 5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_Office_Check_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approval_Step_Completed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF+</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OEM CMP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Service Provider CMP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>POR_Email</targetReference>
            </connector>
            <label>POR</label>
        </rules>
        <rules>
            <name>Additional_Reviewer</name>
            <conditionLogic>1 AND (2 OR 3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Require_Additional_Review_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approval_Step_Completed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approval_Step_Completed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approval_Step_Completed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Additional_Reviewer_Email</targetReference>
            </connector>
            <label>Additional Reviewer</label>
        </rules>
        <rules>
            <name>Level_1_s_Manager</name>
            <conditionLogic>(1 OR 2 OR  3 OR 4) AND ((5 OR 6) OR (7 AND 8)) AND 9</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approval_Step_Completed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approval_Step_Completed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approval_Step_Completed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approval_Step_Completed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF+</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>OEM CMP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Service Provider CMP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Core_MDF_Opal_L1Mgr_ICThresholdCheck</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>L1_s_Manager_Email</targetReference>
            </connector>
            <label>Level 1&apos;s Manager</label>
        </rules>
    </decisions>
    <decisions>
        <name>RMF_Approval_Process</name>
        <label>RMF Approval Process</label>
        <locationX>1766</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Level_1_Manager_Approval_No_PCT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Fund_Request_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RequestedAmount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>25000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RequestedAmount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>250000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approval_Step_Completed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Price_reviewer_check_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>L1_Manager_No_PCT</targetReference>
            </connector>
            <label>Level 1 Manager Approval (No PCT)</label>
        </rules>
        <rules>
            <name>Level_1_Manager_Approval_With_PCT</name>
