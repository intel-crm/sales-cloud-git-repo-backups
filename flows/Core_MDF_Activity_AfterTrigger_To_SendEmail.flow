    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>1442</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Approval_process_entry_criteria</targetReference>
        </connector>
        <filterLogic>(1 OR 2 OR 3) AND (4 OR 5 OR (3 AND 6 AND 7)) AND 8</filterLogic>
        <filters>
            <field>Core_MDF_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Client Co-Marketing Fund</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Data Center Co-Marketing Fund</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Retail Marketing Funds</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Fund_Request_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Review</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Fund_Request_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Revision Required</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Fund_Request_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Activity_Closure_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>No Internal Approval</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Approval_Step_Completed__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>PartnerFundRequest</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
