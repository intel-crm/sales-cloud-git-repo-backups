    <environments>Default</environments>
    <formulas>
        <name>Core_MDF_Opal_L1Mgr_ICThresholdCheck</name>
        <dataType>Boolean</dataType>
        <expression>ROUND({!$Record.Core_MDF_Activity_Reimbursement_Amt_nbr__c},2) &gt;= VALUE({!$Label.Core_MDF_ManagerApprovalThreshold})</expression>
    </formulas>
    <interviewLabel>Core_MDF_Activity_AfterTrigger_To_SendEmail {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Activity_AfterTrigger_To_SendEmail</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
