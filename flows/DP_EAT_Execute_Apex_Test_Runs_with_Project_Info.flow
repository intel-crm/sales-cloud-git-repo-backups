        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_all_Test_classes</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filtering_to_be_enqueued_Test_Classes.Name</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Looping_all_PTCs.Name</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Loop_filtered_to_be_enqueued_test_class</targetReference>
        </connector>
