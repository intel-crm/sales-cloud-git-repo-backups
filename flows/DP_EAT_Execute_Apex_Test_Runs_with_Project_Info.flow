    <collectionProcessors>
        <name>Filtering_New_Test_Classes</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filtering New Test Classes</label>
        <locationX>448</locationX>
        <locationY>1790</locationY>
        <assignNextValueToReference>currentItem_Filtering_New_Test_Classes</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>ListofMatchingTestClasses</collectionReference>
        <conditionLogic>NOT(1)</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filtering_New_Test_Classes</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Loop_existing_Project_Test_Classes.Name</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Check_if_class_removed</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>Filtering_Test_Classes_with_Prefix</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filtering Test Classes with Prefix</label>
        <locationX>556</locationX>
        <locationY>878</locationY>
        <assignNextValueToReference>currentItem_Filtering_Test_Classes_with_Prefix</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_all_Test_classes</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filtering_Test_Classes_with_Prefix.Name</leftValueReference>
            <operator>StartsWith</operator>
            <rightValue>
                <elementReference>Loop_List_of_Prefixes</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Looping_Filtered_Test_classes_with_Prefix</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
