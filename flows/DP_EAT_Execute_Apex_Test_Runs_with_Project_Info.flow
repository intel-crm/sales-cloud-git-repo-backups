    <decisions>
        <name>Check_Counter</name>
        <label>Check Counter</label>
        <locationX>600</locationX>
        <locationY>4262</locationY>
        <defaultConnector>
            <targetReference>Loop_to_extract_Id_of_first_inserted_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>More than 1</defaultConnectorLabel>
        <rules>
            <name>Equal_to_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>counter</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Id_of_first_inserted_ATQI_and_increase_counter</targetReference>
            </connector>
            <label>Equal to 1</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_class_removed</name>
        <label>Check if class removed</label>
        <locationX>448</locationX>
        <locationY>1910</locationY>
        <defaultConnector>
            <targetReference>Loop_existing_Project_Test_Classes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_class_removed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ListofMatchingTestClasses</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Filtering_New_Test_Classes</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_existing_class_from_original_collection</targetReference>
            </connector>
            <label>If class removed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_job_is_already_Queued</name>
        <label>Check if job is already Queued</label>
        <locationX>491</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Job_already_Queued</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Project_Info_record.DP_EAT_Job_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Queued</stringValue>
                </rightValue>
            </conditions>
            <label>Job already Queued</label>
        </rules>
        <rules>
            <name>Job_not_already_Queued</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Project_Info_record.DP_EAT_Job_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Queued</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PrefixesString_variable_assignment</targetReference>
            </connector>
            <label>Job not already Queued</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_No_PTC_already_exist</name>
        <label>Check If No PTC already exist</label>
        <locationX>380</locationX>
        <locationY>1550</locationY>
        <defaultConnector>
            <targetReference>Loop_List_of_Matching_test_classes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If PTC do not already exist</defaultConnectorLabel>
        <rules>
            <name>If_PTC_already_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Project_Test_Classes</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_existing_Project_Test_Classes</targetReference>
            </connector>
            <label>If PTC already exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_send_email_is_checked</name>
        <label>Check if send email is checked</label>
        <locationX>182</locationX>
        <locationY>7286</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Email_checked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Project_Info_record.DP_EAT_Send_Email__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_Notification_with_Report_links</targetReference>
            </connector>
            <label>Send Email checked</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_PrefixesString_empty</name>
        <label>Is PrefixesString empty</label>
        <locationX>743</locationX>
        <locationY>518</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>prefixesString</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_all_Test_classes</targetReference>
            </connector>
            <label>If empty</label>
        </rules>
        <rules>
            <name>If_NOT_empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>prefixesString</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_in_List_of_Prefixes</targetReference>
            </connector>
            <label>If NOT empty</label>
        </rules>
    </decisions>
    <formulas>
        <name>dateTimeafterXMinutes</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} + {!Get_Project_Info_record.DP_EAT_Pause_Time_in_minutes__c}/1440</expression>
    </formulas>
    <formulas>
        <name>limitReached</name>
        <dataType>Boolean</dataType>
        <expression>MOD({!NoOfFail},{!loopLimit})==0</expression>
    </formulas>
    <formulas>
        <name>ProjectNameFilterValue</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!Get_Project_Info_record.Name}, &quot; &quot;, &quot;%20&quot;)</expression>
    </formulas>
    <formulas>
        <name>singlePrefix</name>
        <dataType>String</dataType>
        <expression>TRIM(SUBSTITUTE(LEFT({!prefixesString}, FIND(&quot;,&quot;, {!prefixesString})),&quot;,&quot;,&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>UnprocessedPrefixString</name>
        <dataType>String</dataType>
        <expression>TRIM(SUBSTITUTE({!prefixesString}, {!singlePrefix}+&quot;,&quot;,&quot;&quot; ))</expression>
    </formulas>
