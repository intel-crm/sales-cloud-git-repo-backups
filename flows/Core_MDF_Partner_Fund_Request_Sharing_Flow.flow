<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>This is to delete the PFR Share records for External Users.</description>
        <name>Core_MDF_Delete_PFR_Share_Records_For_External</name>
        <label>Delete PFR Share Records For External</label>
        <locationX>188</locationX>
        <locationY>304</locationY>
        <actionName>Core_MDF_CCP_GenericUtility</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Fetch_Account_User_Association</targetReference>
        </connector>
        <inputParameters>
            <name>accountId</name>
            <value>
                <elementReference>vChannelPartnerIdPriorValue</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>activityId</name>
            <value>
                <elementReference>vPFRId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_CCP_GenericUtility</nameSegment>
    </actionCalls>
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>This step is to add the PFR share record to the PFR Share Collection that will be used to create Share Records</description>
        <name>Core_MDF_Add_PFRShare_record_to_the_PFRShareCollection</name>
        <label>Add PFRShare record to the PFRShareCollection</label>
        <locationX>1133</locationX>
        <locationY>301</locationY>
        <assignmentItems>
            <assignToReference>soColl_PFRShare</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>so_PFRShare</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Assign_Empty_values_to_PFR_Share_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>This step is to clear the values in the PFR Share Record</description>
        <name>Core_MDF_Assign_Empty_values_to_PFR_Share_Record</name>
        <label>Assign Empty values to PFR Share Record</label>
        <locationX>890</locationX>
        <locationY>309</locationY>
        <assignmentItems>
            <assignToReference>so_PFRShare.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>so_PFRShare.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>so_PFRShare.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_through_the_Partner_Node_User_Mapping_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>This step is to assign values to the PFR Share record</description>
        <name>Core_MDF_Assign_the_values_to_the_so_PFRShare_record</name>
        <label>Assign the values to the so_PFRShare record</label>
        <locationX>884</locationX>
        <locationY>181</locationY>
        <assignmentItems>
            <assignToReference>so_PFRShare.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>vPFRId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>so_PFRShare.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>so_PNUMRecord.Core_MDF_User__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>so_PFRShare.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Add_PFRShare_record_to_the_PFRShareCollection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>This is used to check whether there are any users associated to the given Account, returned by the previous flow</description>
        <name>Core_MDF_Check_if_any_PNUM_records_exist</name>
        <label>Check if any PNUM records exist</label>
        <locationX>641</locationX>
        <locationY>149</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_soColl_PNUMRecods_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>soColl_PNUMRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Loop_through_the_Partner_Node_User_Mapping_Collection</targetReference>
            </connector>
            <label>Partner Node User Mapping Exists</label>
        </rules>
    </decisions>
    <decisions>
        <description>This decision is used to check whether any share records are to be created</description>
        <name>Core_MDF_Check_if_PFRShare_Collection_has_records</name>
        <label>Check if PFRShare Collection has records</label>
        <locationX>641</locationX>
        <locationY>427</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_soColl_PFRShare_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>soColl_PFRShare</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Create_PFRShare_Collection</targetReference>
            </connector>
            <label>Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_vChannelPartnerIdPriorValue_is_NOT_NULL</name>
        <label>Check if vChannelPartnerIdPriorValue is NOT NULL</label>
        <locationX>180</locationX>
        <locationY>31</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_vChannelPartnerIdPriorValue_is_NULL</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>vChannelPartnerIdPriorValue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vLengthOfvChannelPartnerIdPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Fetch_Account_User_Association</targetReference>
            </connector>
            <label>vChannelPartnerIdPriorValue is NULL</label>
        </rules>
        <rules>
            <name>Core_MDF_vChannelPartnerIdPriorValue_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vChannelPartnerIdPriorValue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vPFRId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Delete_PFR_Share_Records_For_External</targetReference>
            </connector>
            <label>vChannelPartnerIdPriorValue is NOT NULL</label>
        </rules>
    </decisions>
    <description>Flow to share the PFR records with the associated users.</description>
    <formulas>
        <name>vLengthOfvChannelPartnerIdPriorValue</name>
        <dataType>Number</dataType>
        <expression>LEN({!vChannelPartnerIdPriorValue})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core_MDF_Partner Fund Request Sharing Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Partner Fund Request Sharing Flow</label>
    <loops>
        <description>Loop through the Partner Node User Mapping Collection</description>
        <name>Core_MDF_Loop_through_the_Partner_Node_User_Mapping_Collection</name>
        <label>Loop through the Partner Node User Mapping Collection</label>
        <locationX>642</locationX>
        <locationY>301</locationY>
        <assignNextValueToReference>so_PNUMRecord</assignNextValueToReference>
        <collectionReference>soColl_PNUMRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_MDF_Assign_the_values_to_the_so_PFRShare_record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_MDF_Check_if_PFRShare_Collection_has_records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Create_PFRShare_Collection</name>
        <label>Create PFRShare Collection</label>
        <locationX>642</locationX>
        <locationY>550</locationY>
        <inputReference>soColl_PFRShare</inputReference>
    </recordCreates>
    <startElementReference>Core_MDF_Check_if_vChannelPartnerIdPriorValue_is_NOT_NULL</startElementReference>
    <status>Active</status>
    <subflows>
        <description>This flow is used to get the list of users associated to the given Account</description>
        <name>Fetch_Account_User_Association</name>
        <label>Fetch Account User Association</label>
        <locationX>448</locationX>
        <locationY>147</locationY>
        <connector>
            <targetReference>Core_MDF_Check_if_any_PNUM_records_exist</targetReference>
        </connector>
        <flowName>Core_MDF_Fetch_Account_User_Association</flowName>
        <inputAssignments>
            <name>vAccountId</name>
            <value>
                <elementReference>vAccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vOwnerId</name>
            <value>
                <elementReference>vOwnerId</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>soColl_PNUMRecords</assignToReference>
            <name>soColl_PNUMRecords</name>
        </outputAssignments>
    </subflows>
    <variables>
        <description>This will contain all the PFR Share records which have to be deleted.</description>
        <name>sCollPFRShareToBeDeleted</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundRequestShare</objectType>
    </variables>
    <variables>
        <name>so_PFRShare</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundRequestShare</objectType>
    </variables>
    <variables>
        <name>so_PNUMRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_Partner_Node_User_Mapping__c</objectType>
    </variables>
    <variables>
        <name>so_PNUMShare</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_Partner_Node_User_Mapping__Share</objectType>
    </variables>
    <variables>
        <name>soColl_PFRShare</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundRequestShare</objectType>
    </variables>
    <variables>
        <name>soColl_PNUMRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_Partner_Node_User_Mapping__c</objectType>
    </variables>
    <variables>
        <name>vAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <description>This will be used to denote the Prior Value of Channel Partner Id.</description>
        <name>vChannelPartnerIdPriorValue</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vOwnerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <description>This will contain the Id of the PFR record.</description>
        <name>vPFRId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
</Flow>
