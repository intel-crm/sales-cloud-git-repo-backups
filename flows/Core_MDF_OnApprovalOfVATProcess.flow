<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Once VAT is Approved, resume claim operation by releasing claim status from hold to its previous status</description>
        <name>callReleaseHold</name>
        <label>callReleaseHold</label>
        <locationX>176</locationX>
        <locationY>493</locationY>
        <actionName>Core_MDF_Claim_Utility</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>inputClaims</name>
            <value>
                <elementReference>varClaimRecordsCollection</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>releaseReason</name>
            <value>
                <elementReference>releaseReasonColection</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Claim_Utility</nameSegment>
    </actionCalls>
    <apiVersion>50.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assignReleaseHoldValues</name>
        <label>assignReleaseHoldValues</label>
        <locationX>176</locationX>
        <locationY>373</locationY>
        <assignmentItems>
            <assignToReference>varClaimRecordsCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varClaimRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>releaseReasonColection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varReleaseReason</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>callReleaseHold</targetReference>
        </connector>
    </assignments>
    <description>After VAT status is Approved resume claim operation</description>
    <formulas>
        <name>varReleaseReason</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_VAT_Hold}</expression>
    </formulas>
    <interviewLabel>ApprovedVATProcessResumeClaim {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OnApprovalOfVATProcess</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getClaimRecord</name>
        <label>getClaimRecord</label>
        <locationX>176</locationX>
        <locationY>253</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>assignReleaseHoldValues</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Claim_Id__r.Id</elementReference>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <outputReference>varClaimRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Status__c</queriedFields>
        <queriedFields>Core_MDF_Claim_Previous_Status__c</queriedFields>
        <queriedFields>Core_MDF_VAT_Hold_Ind__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getClaimRecord</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Status_Txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Claim_VAT_Info__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>releaseReasonColection</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varClaimRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>varClaimRecordsCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
</Flow>
