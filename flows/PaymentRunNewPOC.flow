<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>Co_Marketing</name>
        <choiceText>Co-Marketing</choiceText>
        <dataType>String</dataType>
    </choices>
    <choices>
        <name>IPA</name>
        <choiceText>IPA</choiceText>
        <dataType>String</dataType>
    </choices>
    <choices>
        <name>Retail_MDF</name>
        <choiceText>Retail MDF</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Retail MDF</stringValue>
        </value>
    </choices>
    <choices>
        <name>RMF</name>
        <choiceText>RMF</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>RMF</stringValue>
        </value>
    </choices>
    <choices>
        <name>RSA_MD</name>
        <choiceText>RSA MD</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>RSA MD</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Record_type_check</name>
        <label>Record type check</label>
        <locationX>314</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>other_record_types</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Record_type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Co_Marketing</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Record_type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>IPA</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IPA_Co_Marketing</targetReference>
            </connector>
            <label>other record types</label>
        </rules>
        <rules>
            <name>RMF_record_type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Record_type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>RMF</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Payment_run</targetReference>
            </connector>
            <label>RMF record type</label>
        </rules>
    </decisions>
    <description>poc to add account selection</description>
    <interviewLabel>PaymentRunNewPOC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PaymentRunNewPOC</label>
    <processMetadataValues>
