<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Core_DDR_Retire_Product workflow rule
Workflow rule description: Updates the Status to Retired one hour after the current date reaches the date specified in &apos;Retired As Of&apos; field.&quot;</description>
    <environments>Default</environments>
    <label>Core_DDR_Retire_Product</label>
    <migratedFromWorkflowRuleName>Core_DDR_Retire_Product</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update the Status field to Retired.</description>
        <name>ScheduledPath1Update</name>
        <label>ScheduledPath1Update</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <inputAssignments>
            <field>Core_Design_Product_Status_Nm__c</field>
            <value>
                <stringValue>Retired</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>NOT(ISBLANK({!$Record.Core_Retired_As_Of_Dt__c})) &amp;&amp;  NOT (ISPICKVAL({!$Record.Core_Design_Product_Status_Nm__c}, &apos;Retired&apos;))</filterFormula>
        <object>Core_Design_Registration_Product__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>ScheduledPath1</name>
            <connector>
                <targetReference>ScheduledPath1Update</targetReference>
            </connector>
            <label>ScheduledPath1</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>Core_Retired_As_Of_Dt__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
