<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Get_Global_Opid_name</name>
        <label>Get global Opid name</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>opidName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>globalOPIDName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_active_Cag.Core_Partner_Account_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_OPID_Account_Name</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>get_lob_opid_name</name>
        <label>get lob opid name</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>opidName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LobOPIDName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_active_Cag.Core_Partner_Account_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_OPID_Account_Name</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>is_UCD_Primary_account</name>
        <label>is UCD Primary account?</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>not Ucd Primary</defaultConnectorLabel>
        <rules>
            <name>UCD_Primary_account_Global</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_active_Cag.Primary_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Customer_Aggregation_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UNFD_GLBL_CUST</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_active_Cag</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Global_Opid_name</targetReference>
            </connector>
            <label>UCD Primary account Global</label>
        </rules>
        <rules>
            <name>UCD_Primary_account_LOB</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_active_Cag.Primary_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Customer_Aggregation_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UNFD_INTRMD_CUST</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_active_Cag</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_lob_opid_name</targetReference>
            </connector>
            <label>UCD Primary account LOB</label>
        </rules>
    </decisions>
    <description>Update 1PID name if Unified Global Customer Name changes for the UCD primary account.</description>
    <environments>Default</environments>
    <formulas>
        <name>globalOPIDName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_Unified_Global_Customer_Name__c}&amp;&apos; - Global&apos;</expression>
    </formulas>
    <formulas>
        <name>LobOPIDName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_Unified_Global_Customer_Name__c}&amp;&apos; - &apos;&amp;{!$Record.Name}</expression>
    </formulas>
    <interviewLabel>PRM_1PID Name Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PRM_1PID Name Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>create_log_entry</name>
        <label>create log entry</label>
        <locationX>1106</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <stringValue>1PID Name Update Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>1PID Name Update</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <stringValue>IPA</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <stringValue>1PID Name Update</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$System.OriginDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_active_Cag</name>
        <label>Get active Cag</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>is_UCD_Primary_account</targetReference>
        </connector>
        <faultConnector>
            <targetReference>create_log_entry</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Intel_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Inactive_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Account_Group_Member__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_OPID_Account_Name</name>
        <label>Update OPID Account Name</label>
        <locationX>314</locationX>
        <locationY>731</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>create_log_entry</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>opidName</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_active_Cag</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Unified_Global_Customer_Name__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>opidName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
