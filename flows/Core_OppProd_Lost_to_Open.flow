<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Lost_to_Open</name>
        <label>Lost to Open</label>
        <locationX>575</locationX>
        <locationY>346</locationY>
        <defaultConnector>
            <targetReference>Core_Lost_Sales_Price_c</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_status_changed_from_lost</name>
            <conditionLogic>((1 OR 2) AND (3 OR 4)) OR (5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Hold</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_OppProd_Check_Lost_to_Open_Flag</targetReference>
            </connector>
            <label>If status changed from lost</label>
        </rules>
        <rules>
            <name>If_Lost_to_Open_Flag_is_checked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lost_to_Open_Flag__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Lost to Open Flag is checked</label>
        </rules>
        <rules>
            <name>If_Status_is_lost_or_cancelled</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_OppProd_Claim_Date_Population</targetReference>
            </connector>
            <label>If Status is lost or cancelled</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>v_CurrentDate</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Core Lost to Win {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_OppProd_Lost_to_Open</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_Lost_Sales_Price_c</name>
        <label>Core_Lost_Sales_Price__c</label>
        <locationX>718</locationX>
        <locationY>545</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Lost_to_Open_Flag__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Lost_Sales_Price__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Lost_to_Open_Flag__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Core_OppProd_Check_Lost_to_Open_Flag</name>
        <label>Core_OppProd_Check_Lost_to_Open_Flag</label>
        <locationX>296</locationX>
        <locationY>416</locationY>
        <connector>
            <targetReference>Core_OppProd_Claim_Date_Clear</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Lost_to_Open_Flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UnitPrice</field>
            <value>
                <elementReference>$Record.Core_Lost_Sales_Price__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Core_OppProd_Claim_Date_Clear</name>
        <label>Core_OppProd_Claim_Date_Clear</label>
        <locationX>365</locationX>
        <locationY>630</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>On Hold</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Claim_Date__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Core_OppProd_Claim_Date_Population</name>
        <label>Core_OppProd_Claim_Date_Population</label>
        <locationX>521</locationX>
        <locationY>566</locationY>
        <inputAssignments>
            <field>Core_Claim_Date__c</field>
            <value>
                <elementReference>v_CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>402</locationX>
        <locationY>47</locationY>
        <connector>
            <targetReference>Lost_to_Open</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Core_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Lost_to_Open_Flag__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
