<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow is trigger to retry the failed CE records with &apos;User Record Not Available&apos;. retry will stop after 10mins</description>
    <environments>Default</environments>
    <formulas>
        <name>FaultMessage</name>
        <dataType>String</dataType>
        <expression>&apos;Flow failed for Contact &apos;+{!$Record.Core_Contact_Id__r.Email}</expression>
    </formulas>
    <formulas>
        <name>RetryCounter</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Core_Retrigger_Attempt__c}+1</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core Draco Retry for IPA DZP Failed CEs {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core Draco Retry for IPA DZP Failed CEs</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Log_Entry_record</name>
        <label>Create Log Entry record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <elementReference>FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>Flow Core Draco Retry for IPA DZP Failed CEs</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$System.OriginDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_sObjectId__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_Triggering_CE_Record</name>
        <label>Update Triggering CE Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Create_Log_Entry_record</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_Data_Loaded__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Retrigger_Attempt__c</field>
            <value>
                <elementReference>RetryCounter</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Selected__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1 AND 2 AND 4 AND 5 AND 6 AND (3 OR 7 OR 8)</filterLogic>
        <filters>
            <field>Core_Selected__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Complete</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Update_Reason__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>User Record Not Available</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status_of_Assignment_Failure__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed Assignment</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Display_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>IPA Developer Zone Standard Entitlement</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Retrigger_Attempt__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Core_Update_Reason__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>User Record Inactive</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Update_Reason__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>User record Inactive</stringValue>
            </value>
        </filters>
        <object>Core_Contact_Entitlement__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Reattempt_after_5_mins</name>
            <connector>
                <targetReference>Update_Triggering_CE_Record</targetReference>
            </connector>
            <label>Reattempt after 5 mins</label>
            <offsetNumber>5</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>LastModifiedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
