        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Severity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Low</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Log</targetReference>
        </connector>
    </assignments>
    <description>Will send alerts to Tech Team if DPA/ALN is in submitted state for more than 30 mins.</description>
    <environments>Default</environments>
    <interviewLabel>PSG_DPA_ALN_Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PSG DPA ALN Submitted Delay Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
