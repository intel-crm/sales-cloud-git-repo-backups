            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Details__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_Message__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Error while sending delay notification for DPA &amp; ALN submitted</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_sObjectId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LogEntry.Core_sObjectType__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>core_cpq_dpa_aln__c</stringValue>
