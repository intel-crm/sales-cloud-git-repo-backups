<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>To notify Tech Team for DPA/ALN in Submitted state for more than 30 minutes.</description>
        <name>Send_Email_Notification</name>
        <label>Send Email Notification</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <actionName>core_cpq_dpa_aln__c.PSG_DPA_ALN_Submitted_Notification</actionName>
        <actionType>emailAlert</actionType>
        <faultConnector>
            <targetReference>Log_Entry</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>core_cpq_dpa_aln__c.PSG_DPA_ALN_Submitted_Notification</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Log_Entry</name>
        <label>Log Entry</label>
        <locationX>572</locationX>
        <locationY>384</locationY>
        <assignmentItems>
