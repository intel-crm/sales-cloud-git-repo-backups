<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checking whether the file is available on the Audit document or not.</description>
        <name>Is_Valid_contentdocument_to_delete</name>
        <label>Is Valid contentdocument to delete?</label>
        <locationX>446</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>auditDocumentRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Delete_Content_Document</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This flow is used to delete orphan Content document records in daily basis and remove Content document id from AI Tracking record.</description>
    <environments>Default</environments>
    <formulas>
        <description>Used to hold the previous day&apos;s Date time.</description>
        <name>Core_MDF_forDT_PreviousDateTime</name>
        <dataType>DateTime</dataType>
        <expression>NOW()  - 1</expression>
    </formulas>
    <interviewLabel>AI Tracking Cleanup Batch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AI Tracking Cleanup Batch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Any error occur create Log entry record to track</description>
        <name>Core_MDF_Create_Log_Entry</name>
        <label>Create Log Entry</label>
        <locationX>314</locationX>
        <locationY>684</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>Flow.Core_MDF_AI_Log_Cleanup_Batch</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <stringValue>Consolidated Co-Marketing Program (CCP)</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Critical</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Support_Email__c</field>
            <value>
                <stringValue>ccptechsupport@intel.com</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Support_Link__c</field>
            <value>
                <stringValue>https://www.intel.com/content/www/us/en/homepage.html</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordDeletes>
        <description>Delete Content Document records</description>
        <name>Core_MDF_Delete_Content_Document</name>
        <label>Delete Content Document</label>
        <locationX>50</locationX>
        <locationY>468</locationY>
        <connector>
            <targetReference>Core_MDF_Update_AI_Log_Record</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Core_MDF_Create_Log_Entry</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Content_Document_Id__c</elementReference>
            </value>
        </filters>
        <object>ContentDocument</object>
    </recordDeletes>
    <recordLookups>
        <name>Fetch_the_valid_contentdocument_Id_to_delete</name>
        <label>Fetch the valid contentdocument Id to delete</label>
        <locationX>446</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Valid_contentdocument_to_delete</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Core_MDF_Create_Log_Entry</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Document_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Content_Document_Id__c</elementReference>
            </value>
        </filters>
        <object>Core_MDF_Audit_Document__c</object>
        <outputReference>auditDocumentRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Document_Id__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <description>Update processed AI Tracking record and remove Content document Id field as null</description>
        <name>Core_MDF_Update_AI_Log_Record</name>
        <label>Update AI Log Record</label>
        <locationX>50</locationX>
        <locationY>576</locationY>
        <faultConnector>
            <targetReference>Core_MDF_Create_Log_Entry</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_MDF_Content_Document_Id__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Fetch_the_valid_contentdocument_Id_to_delete</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Claim_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Content_Document_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_No_of_Days_Old_Nbr__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>Core_MDF_AI_Tracking__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-06-01</startDate>
            <startTime>06:20:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>auditDocumentIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>auditDocumentRecord</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_Audit_Document__c</objectType>
    </variables>
</Flow>
