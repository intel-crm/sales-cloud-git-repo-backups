<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Quote_or_DPA_ALN</name>
        <label>Quote or DPA/ALN</label>
        <locationX>555</locationX>
        <locationY>284</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Quote</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Quotefrombot</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetQlrecords</targetReference>
            </connector>
            <label>Quote</label>
        </rules>
        <rules>
            <name>DPA_ALN</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>DPA_ALN_Number_From_Bot</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_DPA_ALN_Lines</targetReference>
            </connector>
            <label>DPA/ALN</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PSG DPA ALN Lines For BOT {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PSG DPA ALN/ Quote Lines For BOT</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_DPA_ALN_Lines</name>
        <label>Get DPA ALN Lines</label>
        <locationX>354</locationX>
        <locationY>416</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <filterLogic>or</filterLogic>
        <filters>
            <field>core_cpq_DPA_ALN_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>DPA_ALN_Number_From_Bot</elementReference>
            </value>
        </filters>
        <filters>
            <field>core_cpq_sap_number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>DPA_ALN_Number_From_Bot</elementReference>
            </value>
        </filters>
        <object>core_cpq_dpa_aln_line__c</object>
        <outputReference>Get_Related_DPA_ALN_Lines</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>GetQlrecords</name>
        <label>GetQlrecords</label>
        <locationX>782</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <filterLogic>and</filterLogic>
        <filters>
            <field>core_cpq_quote_number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Quotefrombot</elementReference>
            </value>
        </filters>
        <object>SBQQ__QuoteLine__c</object>
        <outputReference>RelatedQLs</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>core_cpq_opn__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>458</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Quote_or_DPA_ALN</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>DPA_ALN_Lines_Record</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>core_cpq_dpa_aln_line__c</objectType>
    </variables>
    <variables>
        <name>DPA_ALN_Number_From_Bot</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Get_Related_DPA_ALN_Lines</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>core_cpq_dpa_aln_line__c</objectType>
    </variables>
    <variables>
        <name>Quotefrombot</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>RelatedQLs</name>
