    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Core_Opp_Approval</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Core_Opp_Approval</stringValue>
        </value>
    </constants>
    <constants>
        <name>Core_Opp_Approval_Partner_Led_Deal</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Core_Opp_Approval_Partner_Led_Deal</stringValue>
        </value>
    </constants>
    <constants>
        <name>Five_Million</name>
        <dataType>Currency</dataType>
        <value>
            <numberValue>5000000.0</numberValue>
        </value>
    </constants>
    <constants>
        <name>IntegrationUser</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Integration User</stringValue>
        </value>
    </constants>
    <constants>
        <name>Ten_Million</name>
        <dataType>Currency</dataType>
        <value>
            <numberValue>1.0E7</numberValue>
        </value>
    </constants>
    <constants>
        <name>Three_Million</name>
        <dataType>Currency</dataType>
        <value>
            <numberValue>3000000.0</numberValue>
        </value>
    </constants>
    <constants>
        <name>Twenty_Five_Million</name>
        <dataType>Currency</dataType>
        <value>
            <numberValue>2.5E7</numberValue>
        </value>
    </constants>
    <constants>
        <name>Twenty_Million</name>
        <dataType>Currency</dataType>
        <value>
            <numberValue>2.0E7</numberValue>
        </value>
    </constants>
    <constants>
        <name>UncoveredAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Uncovered Account</stringValue>
        </value>
    </constants>
    <decisions>
        <description>For the WF

 &quot;Core_Opp_Uncovered_Account_Notification &quot;</description>
        <name>Core_Opp_Uncovered_Account_Notification</name>
        <label>Core_Opp_Uncovered_Account_Notification</label>
        <locationX>624</locationX>
        <locationY>913</locationY>
        <defaultConnector>
            <targetReference>Submit_Opportunity_For_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_OwnerEQUALSIntegration_User_OR_Account_Account_OwnerEQUALSUncovered_Acco</name>
            <conditionLogic>(1 OR 2) AND (NOT(3 AND 4))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Core_Account_Owner__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>IntegrationUser</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Core_Account_Owner__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>UncoveredAccount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Coverage_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partner-Led Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Coverage_Type_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Registration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Opp_Uncovered_Account_Notification_Email_Alert</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Account OwnerEQUALSIntegration User) OR (Account: Account OwnerEQUALSUncovered Account)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Sent_Email_Alert_Based_ON_Compliance_Sub_Status</name>
        <label>Sent Email Alert Based ON &quot; Compliance Sub Status &quot;</label>
        <locationX>623</locationX>
        <locationY>649</locationY>
        <defaultConnector>
            <targetReference>Core_Opp_Uncovered_Account_Notification</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Compliance_Status_EQUALS_Approved_Approved_with_Guardrails</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Compliance_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Compliance_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved with Guardrails</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Compliance_Sub_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed by GEC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>For_Compliance_Approved</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Compliance Status EQUALS Approved / Approved with Guardrails</label>
        </rules>
        <rules>
            <name>Compliance_Sub_Status_EQUALS_AR_Owner_to_Respond_to_GEC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Compliance_Sub_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AR - Owner to Respond to GEC Clarifying Questions</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_For_Sub_Status_GEC</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Compliance Sub-Status EQUALS  AR - Owner to Respond to GEC</label>
        </rules>
    </decisions>
    <decisions>
        <name>Submit_Opportunity_For_Approval</name>
        <label>Submit Opportunity For Approval</label>
        <locationX>625</locationX>
        <locationY>1179</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Submit_For_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Prior_Value_Of_Submit_For_Approval</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Submit_For_Approval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Submit_For_Approval</targetReference>
            </connector>
            <label>Submit For Approval</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Core_Opp_MAG_Approved and GEC_Needs_Info Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Opp_MAG_Approved and GEC_Needs_Info Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>505</locationX>
        <locationY>281</locationY>
        <connector>
            <targetReference>Sent_Email_Alert_Based_ON_Compliance_Sub_Status</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Prior_Value_Of_Submit_For_Approval</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <elementReference>$Record__Prior.Core_Submit_For_Approval__c</elementReference>
        </value>
    </variables>
</Flow>
