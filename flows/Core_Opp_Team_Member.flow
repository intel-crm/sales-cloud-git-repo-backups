        </connector>
        <inputAssignments>
            <field>Core_Org__c</field>
            <value>
                <elementReference>$User.Department</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Core_OSC_Snapshot_c</name>
        <label>Update Core_OSC_Snapshot__c</label>
        <locationX>312</locationX>
        <locationY>646</locationY>
        <connector>
            <targetReference>Core_OppTeamMember_Notify_Member_On_Addition</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_OSC_Snapshot__c</field>
            <value>
                <elementReference>F_Core_Opp_TM_OSC_UpdateFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>454</locationX>
