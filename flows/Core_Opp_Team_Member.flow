    <description>has all the Workflows of Opp Team Member:
1. Core_OppTM_Set_Values_Upon_Creation                                      [ 1st decision block ]
2.Core_OppTeamMember_OSC_Update                                              [ 2nd decision block ]
3. Core_OppTeamMember_Notify_Member_On_Addition                   [ 3rd decision block ]</description>
    <environments>Default</environments>
    <formulas>
        <description>formula for field update of &quot; Core_OppTeamMember_OSC_Update &quot;</description>
        <name>F_Core_Opp_TM_OSC_UpdateFormula</name>
        <dataType>Number</dataType>
        <expression>IF($Record.User.Core_Is_OSC__c , 1,0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>formula for &quot; Core_OppTeamMember_Notify_Member_On_Addition &quot;</description>
        <name>F_Core_OppTeamMember_Notify_Member_On_Addition</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.CreatedById}  &lt;&gt;  {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <description>has the formula for &quot;Core_OppTeamMember_OSC_Update&quot;</description>
        <name>F_Core_OppTeamMember_OSC_Update</name>
        <dataType>Boolean</dataType>
        <expression>ISNULL( {!$Record.Core_OSC_Snapshot__c} )</expression>
    </formulas>
    <interviewLabel>Core_Opp_Team_Member {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Opp_Team_Member</label>
    <processMetadataValues>
