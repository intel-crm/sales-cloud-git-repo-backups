    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Account].Core_Account_Record_Type__c ==&quot;Intel Account&quot;,
OR(
ISCHANGED([Account].Core_Direct_Primary_Account_Id__c ),
ISCHANGED([Account].Core_Direct_Legal_Parent_Id__c ),
ISCHANGED([Account].Core_Direct_Pricing_Parent_Id__c )

)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.Core_Account_Record_Type__c} ==&quot;Intel Account&quot;,
OR(
ISCHANGED({!myVariable_current.Core_Direct_Primary_Account_Id__c} ),
ISCHANGED({!myVariable_current.Core_Direct_Legal_Parent_Id__c} ),
ISCHANGED({!myVariable_current.Core_Direct_Pricing_Parent_Id__c} )

)
)</expression>
    </formulas>
