<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_if_status_is_Stuck_in_Auto_Approval_status_for_more_that_6_Hours</name>
        <label>Check if status is Stuck in Auto Approval status for more that 6 Hours</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Request_is_in_Auto_Approval_status_for_more_that_6_hrs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Created_Date_Time__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>LastXHourDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Current_status_to_Open</targetReference>
            </connector>
            <label>Request is in Auto Approval status for more that 6 hrs</label>
        </rules>
    </decisions>
    <description>Revert request to Open Status if request is stuck in Auto Approval Pending for more that specified hours</description>
    <environments>Default</environments>
    <formulas>
        <description>Gives last X hours date</description>
        <name>LastXHourDate</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - (VALUE({!$Label.ER_Revert_After_x_Hours})/24)</expression>
    </formulas>
    <interviewLabel>Revert request to Open Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Revert registration request to Open Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Log_Entry</name>
        <label>Create Log Entry</label>
        <locationX>314</locationX>
        <locationY>468</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <stringValue>Error while updating registration request</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>SFDC</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <stringValue>Registration</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <stringValue>Revert registration request to Open Status</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Tags__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_Current_status_to_Open</name>
        <label>Update Current status to Open</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <faultConnector>
            <targetReference>Create_Log_Entry</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Assigned_To__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Current_Status__c</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Review_Note_txt__c</field>
            <value>
                <elementReference>ErrorMessage</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_status_is_Stuck_in_Auto_Approval_status_for_more_that_6_Hours</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Current_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Auto-Approval Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>Entitlement_Details__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-02-21</startDate>
            <startTime>02:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>$Label.ER_Revert_RegReq_Error</elementReference>
        </value>
    </variables>
</Flow>
