    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>$CustomMetadata.Sales_Retry_Count__mdt.Resubmit_to_SAP_Count.Sales_Value__c </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_12_myRule_11_0836179365</name>
        <dataType>Number</dataType>
        <expression>{!$CustomMetadata.Sales_Retry_Count__mdt.Resubmit_to_SAP_Count.Sales_Value__c}</expression>
        <scale>18</scale>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(ISPICKVAL([Order].Status, &apos;Draft&apos; ),
NOT(ISBLANK([Order].Sales_End_Customer_Account__c)),
NOT(ISBLANK([Order].SBQQ__Quote__c)),
[Order].Sales_End_Customer_Account__r.ParentId&lt;&gt;[Order].SBQQ__Quote__r.SBQQ__Account__c,
OR(ISNEW(),ISCHANGED([Order].Sales_End_Customer_Account__c),ISCHANGED([Order].SBQQ__Quote__c)))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISPICKVAL({!myVariable_current.Status}, &apos;Draft&apos; ),
NOT(ISBLANK({!myVariable_current.Sales_End_Customer_Account__c})),
NOT(ISBLANK({!myVariable_current.SBQQ__Quote__c})),
{!myVariable_current.Sales_End_Customer_Account__r.ParentId}&lt;&gt;{!myVariable_current.SBQQ__Quote__r.SBQQ__Account__c},
OR(ISNEW(),ISCHANGED({!myVariable_current.Sales_End_Customer_Account__c}),ISCHANGED({!myVariable_current.SBQQ__Quote__c})))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (
         OR
             ( 
              AND( 
                       ISNEW() , 
                       NOT(ISBLANK([Order].Sales_Contract_Id__c ))
               ),
               ISBLANK(PRIORVALUE([Order].Sales_Contract_Id__c))
          ),
          ISPICKVAL([Order].Type, &apos;Non Commercial Order&apos;) ,
          ISPICKVAL([Order].Status, &apos;Activated&apos;),
          ISPICKVAL([Order].Sales_Order_Sub_Type__c , &apos;Corporate Order&apos;),
          ISPICKVAL([Order].Sales_Contract_Id__r.Status, &apos;Draft&apos;)
 )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_19</name>
        <dataType>Boolean</dataType>
        <expression>AND (
         OR
             ( 
              AND( 
                       ISNEW() , 
                       NOT(ISBLANK({!myVariable_current.Sales_Contract_Id__c} ))
               ),
               ISBLANK(PRIORVALUE({!myVariable_current.Sales_Contract_Id__c}))
          ),
          ISPICKVAL({!myVariable_current.Type}, &apos;Non Commercial Order&apos;) ,
          ISPICKVAL({!myVariable_current.Status}, &apos;Activated&apos;),
          ISPICKVAL({!myVariable_current.Sales_Order_Sub_Type__c} , &apos;Corporate Order&apos;),
          ISPICKVAL({!myVariable_current.Sales_Contract_Id__r.Status}, &apos;Draft&apos;)
 )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
        ISCHANGED([Order].SBQQ__Quote__c ),
        NOT(ISBLANK([Order].SBQQ__Quote__c ) ),
        ISPICKVAL([Order].SBQQ__Quote__r.SBQQ__Type__c , &apos;Amendment&apos;),
        NOT(ISBLANK([Order].SBQQ__Quote__r.SBQQ__MasterContract__c )),
        ISPICKVAL([Order].SBQQ__Quote__r.Pricing_Quote_Program_Nm__c , &apos;PSG&apos;)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_24</name>
        <dataType>Boolean</dataType>
        <expression>AND(
        ISCHANGED({!myVariable_current.SBQQ__Quote__c} ),
        NOT(ISBLANK({!myVariable_current.SBQQ__Quote__c} ) ),
        ISPICKVAL({!myVariable_current.SBQQ__Quote__r.SBQQ__Type__c} , &apos;Amendment&apos;),
        NOT(ISBLANK({!myVariable_current.SBQQ__Quote__r.SBQQ__MasterContract__c} )),
        ISPICKVAL({!myVariable_current.SBQQ__Quote__r.Pricing_Quote_Program_Nm__c} , &apos;PSG&apos;)
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
        ISCHANGED([Order].SBQQ__Quote__c ),
        NOT(ISBLANK([Order].SBQQ__Quote__c ) ),
        NOT(ISPICKVAL([Order].SBQQ__Quote__r.SBQQ__Type__c , &apos;Amendment&apos;)),
        ISPICKVAL([Order].SBQQ__Quote__r.Pricing_Quote_Program_Nm__c , &apos;PSG&apos;),
        NOT(ISBLANK([Order].Sales_Amend_Contract__c ))
)  </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_26</name>
        <dataType>Boolean</dataType>
        <expression>AND(
        ISCHANGED({!myVariable_current.SBQQ__Quote__c} ),
        NOT(ISBLANK({!myVariable_current.SBQQ__Quote__c} ) ),
        NOT(ISPICKVAL({!myVariable_current.SBQQ__Quote__r.SBQQ__Type__c} , &apos;Amendment&apos;)),
        ISPICKVAL({!myVariable_current.SBQQ__Quote__r.Pricing_Quote_Program_Nm__c} , &apos;PSG&apos;),
        NOT(ISBLANK({!myVariable_current.Sales_Amend_Contract__c} ))
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(ISCHANGED([Order].Sales_Retry_Count__c) ,PRIORVALUE([Order].Sales_Retry_Count__c ) ==$CustomMetadata.Sales_Retry_Count__mdt.Resubmit_to_SAP_Count.Sales_Value__c ,
ISCHANGED([Order].Sales_status__c ),ISPICKVAL([Order].Sales_status__c , &apos;SAP Order Creation Failed&apos;) )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_9</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!myVariable_current.Sales_Retry_Count__c}) ,PRIORVALUE({!myVariable_current.Sales_Retry_Count__c} ) =={!$CustomMetadata.Sales_Retry_Count__mdt.Resubmit_to_SAP_Count.Sales_Value__c} ,
ISCHANGED({!myVariable_current.Sales_status__c} ),ISPICKVAL({!myVariable_current.Sales_status__c} , &apos;SAP Order Creation Failed&apos;) )</expression>
