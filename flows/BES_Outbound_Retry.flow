    <decisions>
        <name>Checking_Email_Send_to_Development_team</name>
        <label>Checking Email Send to Development team</label>
        <locationX>697</locationX>
        <locationY>371</locationY>
        <defaultConnector>
            <targetReference>Emil_send_to_support_team</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Criteria_For_Checking_Email_Send_to_Development_team</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Formula_for_Checking_Condition_for_Email_send_to_Development_Team</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_To_Tecnnical_Error_Notification</targetReference>
            </connector>
            <label>Criteria For Checking Email Send to Development team</label>
        </rules>
    </decisions>
    <decisions>
        <name>Email_send_to_support_team</name>
        <label>Email send to support team</label>
        <locationX>1378</locationX>
        <locationY>148</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Criteria_for_Email_send_to_support_team</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_IPS_Retry_Count__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_IPS_Eligible_for_retry__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_IPS_Outbound_Message_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_IPS_BES_JSONTriggerHandler</targetReference>
            </connector>
            <label>Criteria for Email send to support team</label>
        </rules>
    </decisions>
    <decisions>
        <name>Emil_send_to_support_team</name>
        <label>Emil send to support team</label>
        <locationX>578</locationX>
        <locationY>520</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Criteria_For_Emil_send_to_support_team</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Formula_for_Checking_Condition_for_Email_send_to_Support_Team</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Support_Team_Error_Notification</targetReference>
            </connector>
            <label>Criteria For Emil send to support team</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Formula_for_Checking_Condition_for_Email_send_to_Development_Team</name>
        <dataType>Boolean</dataType>
        <expression>AND(
CONTAINS({!$Record.Core_IPS_Error_Description__c},&apos;Class&apos;),
 {!$Record.Core_IPS_Eligible_for_retry__c}==False
)</expression>
    </formulas>
    <formulas>
        <name>Formula_for_Checking_Condition_for_Email_send_to_Support_Team</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!$Record.Core_IPS_Error_Description__c}, &quot;Class.&quot;))</expression>
    </formulas>
    <interviewLabel>BES Outbound Retry {!$Flow.CurrentDateTime}</interviewLabel>
    <label>BES Outbound Retry</label>
