    <decisions>
        <name>Accept_Prechedk</name>
        <label>Accept Prechedk</label>
        <locationX>512</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Is_Authorized</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Accepted_Precheck</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Accepted_By_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_deal_record_type</targetReference>
            </connector>
            <label>Accepted Precheck</label>
        </rules>
    </decisions>
    <decisions>
        <name>Condition_for_pre_check</name>
        <label>Condition for pre-check</label>
        <locationX>1766</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Update_DR_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>pre_check_completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Accepted_By_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>completed</targetReference>
            </connector>
            <label>pre-check completed?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Deal_or_Design_check</name>
        <label>Deal or Design check?</label>
        <locationX>1469</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_Deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PCC_Registration_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Registration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Accept_Prechedk</targetReference>
            </connector>
            <label>is Deal?</label>
        </rules>
        <rules>
            <name>is_Design</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PCC_Registration_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Registration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Condition_for_pre_check</targetReference>
            </connector>
            <label>is Design?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Authorized</name>
        <label>Is Authorized</label>
        <locationX>974</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>UnAuthorized_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Authorized</defaultConnectorLabel>
        <rules>
            <name>Authorized_user</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>userId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>recordId.Core_Accepted_By_Id__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>userId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>recordId.Core_Accepted_By_Id__r.DelegatedApproverId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Deal_Approval_Process_Actions</targetReference>
            </connector>
            <label>Authorized user</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
