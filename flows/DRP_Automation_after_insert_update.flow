<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>No_of_DRP_Records</name>
        <label>No of DRP Records</label>
        <locationX>446</locationX>
        <locationY>863</locationY>
        <assignmentItems>
            <assignToReference>NoOfRecords</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Check_if_All_Products_are_Rejected</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Filter_Rejected_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>No_of_Rejected_Records</name>
        <label>No of Rejected Records</label>
        <locationX>446</locationX>
        <locationY>1079</locationY>
        <assignmentItems>
            <assignToReference>NoOfRejectedRecords</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Filter_Rejected_Records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_the_Rejected_product_and_child_products_count</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Rejected_Records</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Rejected Records</label>
        <locationX>446</locationX>
        <locationY>971</locationY>
        <assignNextValueToReference>currentItem_Filter_Rejected_Records</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Check_if_All_Products_are_Rejected</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Rejected_Records.Core_Design_Product_Status_Nm__c</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <stringValue>Rejected</stringValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>No_of_Rejected_Records</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Check_L5_Attribute_Mapping_Records</name>
        <label>Check L5 Attribute Mapping Records</label>
        <locationX>908</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Records_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_L5_Attribute_Mappings</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_L5_Attribute_Mappings.PCC_Product_MM_Attribute_Mapping__r.Eligible_for_DDI_Payment__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Status_as_Rejected</targetReference>
            </connector>
            <label>Records present?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Region</name>
        <label>Check Region</label>
        <locationX>1271</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NAR_OR_EMEA</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Partner_Account_Id__r.Core_Sub_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NAR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Partner_Account_Region_Cd__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_L5_Attribute_Mappings</targetReference>
            </connector>
            <label>NAR OR EMEA</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_the_Rejected_product_and_child_products_count</name>
        <label>Check the Rejected product and child products count</label>
        <locationX>446</locationX>
        <locationY>1187</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Reject_the_DR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NoOfRecords</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>NoOfRejectedRecords</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reject_the_design</targetReference>
            </connector>
            <label>Reject the DR?</label>
        </rules>
        <rules>
            <name>Resubmitted_Design</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Pending_Product_Cnt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Re-Submitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_As_Approved</targetReference>
            </connector>
            <label>Resubmitted Design</label>
        </rules>
    </decisions>
    <description>This flow is created to reject the product and reject the design if all products are rejected.</description>
    <environments>Default</environments>
    <interviewLabel>DRP Automation - after insert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DRP Automation - after insert/update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Log_Entry</name>
        <label>Create Log Entry</label>
        <locationX>1106</locationX>
        <locationY>755</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>DRP Automation - after insert/update   - V1</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <stringValue>DDR</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_sObjectId__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Check_if_All_Products_are_Rejected</name>
        <label>Check if All Products are Rejected</label>
        <locationX>446</locationX>
        <locationY>755</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>No_of_DRP_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Design_Registration_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Design_Registration_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Design_Registration_Product__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_L5_Attribute_Mappings</name>
        <label>Get L5 Attribute Mappings</label>
        <locationX>908</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_L5_Attribute_Mapping_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PCC_Design_Registration_Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PCC_DDR_L5_Product_Mapping__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Reject_the_design</name>
        <label>Reject the design</label>
        <locationX>50</locationX>
        <locationY>1295</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Create_Log_Entry</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Design_Registration_Id__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Design_Registration_Status_Nm__c</field>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Rejection_Comment_Txt__c</field>
            <value>
                <stringValue>Automatically Rejected by the System as Product/s not eligible for DR payment.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Rejection_Reason_Nm__c</field>
            <value>
                <stringValue>Products not eligible for DR payment</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Workflow_Status__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <object>Core_Design_Registration__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Status_As_Approved</name>
        <label>Set Status As Approved</label>
        <locationX>578</locationX>
        <locationY>1295</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Design_Registration_Id__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Design_Registration_Status_Nm__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Workflow_Status__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <object>Core_Design_Registration__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_the_Status_as_Rejected</name>
        <label>Update the Status as Rejected</label>
        <locationX>446</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>Check_if_All_Products_are_Rejected</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_Comment_Txt__c</field>
            <value>
                <stringValue>Rejected as product is not payment eligible</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Design_Product_Status_Nm__c</field>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>1145</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Region</targetReference>
        </connector>
        <object>Core_Design_Registration_Product__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>currentItem_Filter_Rejected_Records</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_Design_Registration_Product__c</objectType>
    </variables>
    <variables>
        <name>NoOfRecords</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>NoOfRejectedRecords</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
