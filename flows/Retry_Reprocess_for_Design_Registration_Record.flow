<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>DDR_Retry</name>
        <label>DDR Retry</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <actionName>Core_DDR_Design_Handler_Utility</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>ids</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_DDR_Design_Handler_Utility</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>oppErrorMsg</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_UniqueOppo_Validation}</expression>
    </formulas>
    <interviewLabel>Design Registration Record Retry/Reprocess {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Retry/Reprocess for Design Registration Record</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 OR 2 OR 6 OR 7) AND (3 AND 4) AND 5 AND 8</filterLogic>
        <filters>
            <field>Core_Origin__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_DDR_Design_Handler.insertOppLineItems.OppLineItemInsert</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Origin__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_DDR_Design_Handler.insertApprovedLIsToExistingOpps.OppLineItemUpdate</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Retry_Counter__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Core_Retry_Counter__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Core_Message__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Successfully Inserted</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Origin__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opportunity Creation</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Origin__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_DDR_Design_Handler.insertOppLineItems_Exception</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Message__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>unable to obtain exclusive access to this record or 1 records</stringValue>
            </value>
        </filters>
        <object>Core_Log_Entry__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>After_5_Min</name>
            <connector>
                <targetReference>DDR_Retry</targetReference>
            </connector>
            <label>After 5 Min</label>
            <maxBatchSize>1</maxBatchSize>
            <offsetNumber>5</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>Core_Next_Scheduled_Run__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
