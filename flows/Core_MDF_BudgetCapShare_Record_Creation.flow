<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Core_MDF_Add_BudgetCapShare_record_to_the_BudgetCapShareCollection</name>
        <label>Add BudgetCapShare record to the BudgetCapShareCollection</label>
        <locationX>1037</locationX>
        <locationY>37</locationY>
        <assignmentItems>
            <assignToReference>soColl_BudgetCapShare</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>so_BudgetCapShare</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Assign_the_values_to_the_so_BudgetCapShare_record_0</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Core_MDF_Assign_the_values_to_the_so_BudgetCapShare_record</name>
        <label>Assign the values to the so_BudgetCapShare record</label>
        <locationX>1048</locationX>
        <locationY>199</locationY>
        <assignmentItems>
            <assignToReference>so_BudgetCapShare.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>vBudgetCapId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>so_BudgetCapShare.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>so_PGMRecord.Core_MDF_Group_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>so_BudgetCapShare.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Add_BudgetCapShare_record_to_the_BudgetCapShareCollection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Core_MDF_Assign_the_values_to_the_so_BudgetCapShare_record_0</name>
        <label>Assign the values to the so_BudgetCapShare record</label>
        <locationX>392</locationX>
        <locationY>54</locationY>
        <assignmentItems>
            <assignToReference>so_BudgetCapShare.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>so_BudgetCapShare.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>so_BudgetCapShare.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_through_the_Partner_Group_Mapping_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Core_MDF_Check_if_any_PGM_records_are_there</name>
        <label>Check if any PGM records are there</label>
        <locationX>232</locationX>
        <locationY>195</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_soColl_PGMRecods_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>soColl_PGMRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Loop_through_the_Partner_Group_Mapping_Collection</targetReference>
            </connector>
            <label>Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_BudgetCapShare_Collection_has_records</name>
        <label>Check if BudgetCapShare Collection has records</label>
        <locationX>385</locationX>
        <locationY>340</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_soColl_BudgetCapShare_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>soColl_BudgetCapShare</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Create_BudgetCapShare_Collection</targetReference>
            </connector>
            <label>Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsExternalGroup</name>
        <label>IsExternalGroup</label>
        <locationX>783</locationX>
        <locationY>202</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Loop_through_the_Partner_Group_Mapping_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckExternal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>so_PGMRecord.Core_MDF_Type_of_Access__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>External</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>so_BudgetCapRecord.Core_MDF_Budget_Status_txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Released</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Assign_the_values_to_the_so_BudgetCapShare_record</targetReference>
            </connector>
            <label>CheckExternal</label>
        </rules>
    </decisions>
    <description>This flow is used to create BudgetCapShare records when a BudgetCap record is created.</description>
    <environments>Default</environments>
    <interviewLabel>Core_MDF_BudgetCapSharingFlow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_BudgetCapSharingFlow</label>
    <loops>
        <name>Core_MDF_Loop_through_the_Partner_Group_Mapping_Collection</name>
        <label>Loop through the Partner Group Mapping Collection</label>
        <locationX>394</locationX>
        <locationY>199</locationY>
        <assignNextValueToReference>so_PGMRecord</assignNextValueToReference>
        <collectionReference>soColl_PGMRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>IsExternalGroup</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_MDF_Check_if_BudgetCapShare_Collection_has_records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Create_BudgetCapShare_Collection</name>
        <label>Create BudgetCapShare Collection</label>
        <locationX>387</locationX>
        <locationY>474</locationY>
        <inputReference>soColl_BudgetCapShare</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Core_MDF_Fetch_all_the_Partner_Group_Mapping_Records</name>
        <label>Fetch all the Partner Group Mapping Records</label>
        <locationX>125</locationX>
        <locationY>188</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Check_if_any_PGM_records_are_there</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vPGMAccountID</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vChannelProgram</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>External</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Group_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Inactive_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Core_MDF_Partner_Group_Mapping__c</object>
        <outputReference>soColl_PGMRecords</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Group_Name__c</queriedFields>
        <queriedFields>Core_MDF_Group_Id__c</queriedFields>
        <queriedFields>Core_MDF_Type_of_Access__c</queriedFields>
        <queriedFields>Core_MDF_Account__c</queriedFields>
        <sortField>Core_MDF_Type_of_Access__c</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Core_MDF_Fetch_all_the_Partner_Group_Mapping_Records</targetReference>
        </connector>
    </start>
    <status>Active</status>
