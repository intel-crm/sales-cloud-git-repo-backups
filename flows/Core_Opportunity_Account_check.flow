    <start>
        <locationX>452</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Opportunity_Count_check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Allow_Opportunity_Account_Edit__c</field>
            <operator>EqualTo</operator>
            <value>
