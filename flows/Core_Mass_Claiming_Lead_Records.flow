<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Adding_records_into_the_list</name>
        <label>Adding records into the list</label>
        <locationX>264</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>MassLead</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_IDs</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assigning_edit_access_to_user_who_claimed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assigning_edit_access_to_user_who_claimed</name>
        <label>Assigning edit access to user who claimed</label>
        <locationX>264</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>varR_LeadShare.LeadAccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varR_LeadShare.LeadId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_through_IDs.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varR_LeadShare.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoggedInUserId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assigning_mass_edit</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assigning_mass_edit</name>
        <label>Assigning mass edit</label>
        <locationX>264</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>varR_LeadShare1</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varR_LeadShare</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_IDs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assigning_partner_lead_owner_as_logged_in_users</name>
        <label>Assigning partner lead owner as logged-in users</label>
        <locationX>264</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>Loop_through_IDs.Core_Partner_Lead_Owner__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoggedInUserId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Adding_records_into_the_list</targetReference>
        </connector>
    </assignments>
    <description>Created this flow to mass claim leads from the list view page, replaced the existing claim button using this flow And Added Lead Sharing</description>
    <environments>Default</environments>
    <formulas>
        <name>LoggedInUserId</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!$User.Id})</expression>
    </formulas>
    <interviewLabel>Mass Claiming Lead Records {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>Mass Claiming Lead Records</label>
    <loops>
        <name>Loop_through_IDs</name>
        <label>Loop through IDs</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <collectionReference>Get_Unclaimed_New_Lead_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assigning_partner_lead_owner_as_logged_in_users</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_records_as_claimed</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Insert_Lead_Share</name>
        <label>Insert Lead Share</label>
        <locationX>176</locationX>
        <locationY>974</locationY>
        <connector>
            <targetReference>Success</targetReference>
        </connector>
        <inputReference>varR_LeadShare1</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Unclaimed_New_Lead_Records</name>
        <label>Get Unclaimed/New Lead Records</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_IDs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Lead_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Lead_State__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Unclaimed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>ids</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_records_as_claimed</name>
        <label>Update records as claimed</label>
        <locationX>176</locationX>
        <locationY>866</locationY>
        <connector>
            <targetReference>Insert_Lead_Share</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Msg</targetReference>
        </faultConnector>
        <inputReference>MassLead</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>Error_Msg</name>
        <label>Error Msg</label>
        <locationX>440</locationX>
        <locationY>974</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error</name>
            <fieldText>&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Success</name>
        <label>Success</label>
        <locationX>176</locationX>
        <locationY>1082</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>SUCCESS_MESSAGE</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;font-size: 11.36px; font-family: Arial, Helvetica, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Leads claimed successfully.&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Unclaimed_New_Lead_Records</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>ids</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>MassLead</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>varR_LeadShare</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>LeadShare</objectType>
    </variables>
    <variables>
        <name>varR_LeadShare1</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>LeadShare</objectType>
    </variables>
</Flow>
