<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Create_Renewal_Opportunity</name>
        <label>Create Renewal Opportunity</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <actionName>Core_Opportunity_RenewalController</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_if_VBS</targetReference>
        </connector>
        <faultConnector>
            <targetReference>DisplayErrorMsg</targetReference>
        </faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>originalOpportunityInput</name>
            <value>
                <elementReference>Get_Original_Opportunity</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_Opportunity_RenewalController</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>renewedOppId</assignToReference>
            <name>output</name>
        </outputParameters>
    </actionCalls>
    <actionCalls>
        <name>Navigate_To_the_new_Opp</name>
        <label>Navigate To the new Opp</label>
        <locationX>182</locationX>
        <locationY>974</locationY>
        <actionName>c:navigateToUrl</actionName>
        <actionType>component</actionType>
        <connector>
            <targetReference>FlowFinished</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>redirectURL</name>
            <value>
                <elementReference>url</elementReference>
            </value>
        </inputParameters>
        <nameSegment>c:navigateToUrl</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Renewed_Opp_Id_to_Original_Opp</name>
        <label>Assign Renewed Opp Id to Original Opp</label>
        <locationX>182</locationX>
        <locationY>758</locationY>
        <assignmentItems>
            <assignToReference>Get_Original_Opportunity.Core_Renewal_Opportunity_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>renewedOppId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Original_Opportunity</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_Design_win</name>
        <label>Check if Design win with contract start date</label>
        <locationX>512</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Renew_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>design_win</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Original_Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Original_Opportunity.CRM_VBS_Contract_Start_Date__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>Get_Original_Opportunity.CRM_VBS_Contract_Lifetime_in_Months__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Create_Renewal_Opportunity</targetReference>
            </connector>
            <label>Design win with contract start date</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_VBS</name>
        <label>Check if VBS</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Create_Linked_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_VBS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Original_Opportunity.Core_VBS_Potential__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Original_Opportunity.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR4 Contract Signed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Linked_Opportunity</targetReference>
            </connector>
            <label>Is VBS</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>url</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_260}) - 1)+&quot;/&quot;+{!renewedOppId}</expression>
    </formulas>
    <interviewLabel>Create Renewal Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Renewal Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Copy_1_of_Create_Linked_Opportunity</name>
        <label>Create Linked Opportunity(Non VBS)</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <connector>
            <targetReference>Assign_Renewed_Opp_Id_to_Original_Opp</targetReference>
        </connector>
        <inputAssignments>
            <field>CRM_Link_Reason__c</field>
            <value>
                <stringValue>SW &amp; Services Original -&gt;SW &amp; Services Renewal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_Linked_Opportunity__c</field>
            <value>
                <elementReference>renewedOppId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_Primary_Opportunity__c</field>
            <value>
                <elementReference>Get_Original_Opportunity.Id</elementReference>
            </value>
        </inputAssignments>
        <object>CRM_Linked_Opportunities__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Linked_Opportunity</name>
        <label>Create Linked Opportunity(VBS)</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <connector>
            <targetReference>Assign_Renewed_Opp_Id_to_Original_Opp</targetReference>
        </connector>
        <inputAssignments>
            <field>CRM_Link_Reason__c</field>
            <value>
                <stringValue>VBS Original -&gt;VBS Renewal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_Linked_Opportunity__c</field>
            <value>
                <elementReference>renewedOppId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_Primary_Opportunity__c</field>
            <value>
                <elementReference>Get_Original_Opportunity.Id</elementReference>
            </value>
        </inputAssignments>
        <object>CRM_Linked_Opportunities__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Original_Opportunity</name>
        <label>Get Original Opportunity</label>
        <locationX>512</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Design_win</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Original_Opportunity</name>
        <label>Update Original Opportunity</label>
        <locationX>182</locationX>
        <locationY>866</locationY>
        <connector>
            <targetReference>Navigate_To_the_new_Opp</targetReference>
        </connector>
        <inputReference>Get_Original_Opportunity</inputReference>
    </recordUpdates>
