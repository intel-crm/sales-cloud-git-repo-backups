<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>navigatetonewquote</name>
        <label>navigatetonewquote</label>
        <locationX>842</locationX>
        <locationY>566</locationY>
        <actionName>c:navigateToUrl</actionName>
        <actionType>component</actionType>
        <connector>
            <targetReference>Success</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>redirectURL</name>
            <value>
                <elementReference>Createnewquoteurl</elementReference>
            </value>
        </inputParameters>
        <nameSegment>c:navigateToUrl</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Quotes</name>
        <label>Check Quotes</label>
        <locationX>578</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Submitted_Approved</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Software_Services_Quote.SBQQ__Opportunity2__r.Core_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Software_Services_Quote.SBQQ__Opportunity2__r.Core_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Submitted_or_Approved</targetReference>
            </connector>
            <label>Opportunity Submitted/Approved</label>
        </rules>
        <rules>
            <name>Opp_Product_Status_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Software_Services_Quote.SBQQ__Opportunity2__r.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Opportunity_Products_with_Lost_Status.Opportunity.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Product_Lost</targetReference>
            </connector>
            <label>Opp Product Status Lost</label>
        </rules>
        <rules>
            <name>Quote_status_Accepted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Software_Services_Quote.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.SBQQ__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Accepted_Quote_Status</targetReference>
            </connector>
            <label>Quote status Accepted</label>
        </rules>
        <rules>
            <name>Quote_created_Successfully</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Software_Services_Quote.SBQQ__Opportunity2__r.Core_Approval_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Software_Services_Quote.SBQQ__Opportunity2__r.Core_Approval_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Software_Services_Quote.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.SBQQ__Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Software_Services_Quote.SBQQ__Opportunity2__r.Id</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Opportunity_Products_with_Lost_Status.Opportunity.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Software_Services_Quote</targetReference>
            </connector>
            <label>Quote created Successfully</label>
        </rules>
    </decisions>
    <description>Used in Clone Action on Quote object for Software &amp; Services Quotes</description>
    <environments>Default</environments>
    <formulas>
        <name>Createnewquoteurl</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND( &apos;/services&apos;, {!$Api.Partner_Server_URL_260})) &amp; {!NewQuoteId}</expression>
    </formulas>
    <formulas>
        <name>Expirydateadd14daysfromToday</name>
        <dataType>Date</dataType>
        <expression>IF({!Get_Software_Services_Quote.Pricing_SW_Expiry_Date__c} &lt; TODAY()+14, TODAY()+14, {!Get_Software_Services_Quote.Pricing_SW_Expiry_Date__c})</expression>
    </formulas>
    <formulas>
        <name>StartDatelessthanToday</name>
        <dataType>Date</dataType>
        <expression>IF({!Get_Software_Services_Quote.SBQQ__StartDate__c} &lt; TODAY(), TODAY(), {!Get_Software_Services_Quote.SBQQ__StartDate__c})</expression>
    </formulas>
    <interviewLabel>Pricing SW Clone Quote Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pricing SW Clone Quote Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
