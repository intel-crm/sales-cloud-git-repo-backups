            </connector>
            <label>ABT Approved</label>
        </rules>
        <rules>
            <name>ABT_not_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Query_Account_Business_Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
