    <description>This is used to create AccountShare record for Internal Account Managers group for a particular program.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(OR(ISNEW(),ISCHANGED([Account].OwnerId)),[Account].RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name, [Account].Core_MDF_Parent_Fund_Account__c.RecordType.DeveloperName = $Label.Core_MDF_Intel_Account_Record_Type_Developer_Name)
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR(ISNEW(),ISCHANGED({!myVariable_current.OwnerId})),{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name}, {!myVariable_current.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName} = {!$Label.Core_MDF_Intel_Account_Record_Type_Developer_Name})</expression>
    </formulas>
