            <value>
                <elementReference>$Record.Core_MDF_Bank_Doc_Hold_Ind__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>Claim</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>ClaimID</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
