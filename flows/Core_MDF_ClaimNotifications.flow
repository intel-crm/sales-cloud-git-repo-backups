    <environments>Default</environments>
    <formulas>
        <name>IntelVerifierIdValue</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_MDF_Intel_Verifier_Id__c}</expression>
    </formulas>
    <formulas>
        <name>IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>RecipientIdValue</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Core_MDF_Claim_Id__c})), IF(CONTAINS(TEXT({!$Record.CreatedBy.UserType}), $Label.Core_MDF_Partner_User_Type), 
{!$Record.CreatedById}, 
{!$Record.Core_MDF_Claim_Submitter_Id__c}
), 
{!$Record.OwnerId})</expression>
    </formulas>
    <formulas>
        <name>Subclaim_Recipient_Id</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS(TEXT({!$Record.CreatedBy.UserType}), $Label.Core_MDF_Partner_User_Type), 
{!$Record.CreatedById}, 
{!$Record.Core_MDF_Claim_Submitter_Id__c}
)</expression>
    </formulas>
