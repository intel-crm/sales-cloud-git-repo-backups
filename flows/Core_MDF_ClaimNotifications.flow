        <name>Core_MDF_Send_Notification_to_Payment_Admins</name>
        <label>Send Notification to Payment Admins</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_MDF_If_Claim_Status_is_On_Hold_For_Internal_Users</targetReference>
        </connector>
