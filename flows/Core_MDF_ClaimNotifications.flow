    <recordUpdates>
        <name>Cancel_Adj_Req</name>
        <label>Cancel Adj Req</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_37</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Adjustment_Claim_Nbr__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Adjustment_Status_nm__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Label.Core_MDF_Status_Cancelled</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Adjustment_Status_nm__c</field>
            <value>
                <elementReference>$Label.Core_MDF_Status_Cancelled</elementReference>
            </value>
        </inputAssignments>
        <object>Core_MDF_Adjustment_Request__c</object>
    </recordUpdates>
