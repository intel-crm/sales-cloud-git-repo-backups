<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>check_User_have_Opp_Access</name>
        <label>check User have Opp Access</label>
        <locationX>182</locationX>
        <locationY>839</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_check_User_have_Opp_Access_s</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opp_Share_records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.CRM_VBS_Team_member__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>create_Opp_Share</targetReference>
            </connector>
            <label>check User have Opp Access&apos;s</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_user_Is_shared</name>
        <label>check user Is shared</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Get_Opp_Share_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>User_Have_access_to_SOAR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_SOAR_sharing_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR__r.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.CRM_VBS_Team_member__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Share_SOAR_record</targetReference>
            </connector>
            <label>User Don&apos;t have access to SOAR</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>isCheckNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>SOAR sharing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SOAR sharing</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
