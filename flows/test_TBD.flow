                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_RSM_on_VAT_Invoice_Upload</targetReference>
            </connector>
            <label>RSM Reminder</label>
        </rules>
        <rules>
            <name>IPA_Account_Manager_Reminder</name>
            <conditionLogic>1 AND 2 AND (3 OR 4) AND 5 AND (6 OR 7)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_RSMReminderDate_Dtm__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>today</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_RSMRemNotificationSent_Ind__c</leftValueReference>
