    <decisions>
        <description>Differentiation between types can easily be determined via systemized subjects, which all end with &quot;from Sales Navigator&quot; and start with the type of activity - InMail/Message/Smart Link/Phone Call/Note</description>
        <name>Parse_LISN_Subject</name>
        <label>Parse LISN Subject</label>
        <locationX>1238</locationX>
        <locationY>311</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Parse_LISN_Subject_for_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>Message</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Message_TaskType</targetReference>
            </connector>
            <label>Parse LISN Subject for Message</label>
        </rules>
        <rules>
            <name>Parse_LISN_Subject_For_Call</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>Phone Call</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Call_TaskType</targetReference>
            </connector>
            <label>Parse LISN Subject For Call</label>
        </rules>
        <rules>
            <name>Parse_LISN_Subject_for_InMail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>InMail</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_InMail_TaskType</targetReference>
            </connector>
            <label>Parse LISN Subject for InMail</label>
        </rules>
        <rules>
            <name>Parse_Subject_for_Seismic_sent_via_LiveSend_to</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>sent via LiveSend to</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Seismic_LiveSend</targetReference>
            </connector>
            <label>Parse Subject for Seismic sent via LiveSend to</label>
        </rules>
        <rules>
            <name>Parse_Subject_for_Seismic_Downloaded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Downloaded</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Seismic_Download</targetReference>
            </connector>
            <label>Parse Subject for Seismic Downloaded</label>
        </rules>
        <rules>
            <name>Parse_Subject_for_Seismic_Added_to_Workspace</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Added to Workspace</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Seismic_Add_To_Workspace</targetReference>
            </connector>
            <label>Parse Subject for Seismic Added to Workspace</label>
        </rules>
        <rules>
            <name>Parse_Subject_for_Seismic_Added_to_Cart</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Added to Cart</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Seismic_Add_To_Cart</targetReference>
            </connector>
            <label>Parse Subject for Seismic Added to Cart</label>
        </rules>
        <rules>
            <name>Parse_Subject_for_Seismic_Posted_to_Chatter</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Posted to Chatter</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Seismic_Post_To_Chatter</targetReference>
            </connector>
            <label>Parse Subject for Seismic Posted to Chatter</label>
        </rules>
        <rules>
            <name>Parse_LISN_Subject_for_Connection_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>Connection Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_ConnectReq_TaskType</targetReference>
            </connector>
            <label>Parse LISN Subject for Connection Request</label>
        </rules>
    </decisions>
    <interviewLabel>Update Activity Fields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Activity Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>1112</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Parse_LISN_Subject</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <stringValue>from Sales Navigator</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <stringValue>sent via LiveSend to</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Added to Cart</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Added to Workspace</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <stringValue> Downloaded</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <stringValue> Posted to Chatter</stringValue>
            </value>
        </filters>
        <object>Task</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
