<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Call Release Hold</description>
        <name>Call_Release_Hold</name>
        <label>Call Release Hold</label>
        <locationX>654</locationX>
        <locationY>1211</locationY>
        <actionName>Core_MDF_Claim_Utility</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>inputClaims</name>
            <value>
                <elementReference>varClaimRecordsCollection</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>releaseReason</name>
            <value>
                <elementReference>releaseReasonCollection</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Claim_Utility</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Notify_Claim_Submitters_on_VAT_Rejection</name>
        <label>Notify Claim Submitters on VAT Rejection</label>
        <locationX>1062</locationX>
        <locationY>653</locationY>
        <actionName>Core_MDF_Claim_VAT_Info__c.Core_MDF_VAT_Rejection_Notification_to_Submitter</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Claim_VAT_Info__c.Core_MDF_VAT_Rejection_Notification_to_Submitter</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Send_Notification_to_Claim_Submitters</name>
        <label>Send Notification to Claim Submitters</label>
        <locationX>50</locationX>
        <locationY>660</locationY>
        <actionName>Core_MDF_Claim_VAT_Info__c.Core_MDF_NotifyClaimSubOnInvoiceDoc</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Claim_VAT_Info__c.Core_MDF_NotifyClaimSubOnInvoiceDoc</nameSegment>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assignReleaseHoldValues</name>
        <label>assignReleaseHoldValues</label>
        <locationX>653</locationX>
        <locationY>1011</locationY>
        <assignmentItems>
            <assignToReference>varClaimRecordsCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varClaimRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>releaseReasonCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varReleaseReason</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Call_Release_Hold</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Change Adjustment status to PAF</description>
        <name>Change_Adjustment_status_to_PAF</name>
        <label>Change Adjustment status to PAF</label>
        <locationX>344</locationX>
        <locationY>1016</locationY>
        <assignmentItems>
            <assignToReference>varClaimRecord.Core_MDF_VAT_Hold_Ind__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varClaimRecord.Core_MDF_Claim_Previous_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varClaimRecord.Core_MDF_Status__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varClaimRecord.Core_MDF_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending Available Fund</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Adjustment</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>To check whether the claim is an adjustment</description>
        <name>Adjustment_Claim</name>
        <label>Adjustment/Claim</label>
        <locationX>512</locationX>
        <locationY>844</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Adjustment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Adjustment</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_C_Type_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_Adjustment_status_to_PAF</targetReference>
            </connector>
            <label>Adjustment</label>
        </rules>
        <rules>
            <name>Claim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Claim</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_C_Type_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assignReleaseHoldValues</targetReference>
            </connector>
            <label>Claim</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_VerifyStatus</name>
        <label>Verify Status</label>
        <locationX>790</locationX>
        <locationY>436</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>When_Status_is_Pending_Documents</name>
            <conditionLogic>(1 OR 2) AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Case_Status_Pending_Document</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Owner:User.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Partner_User_Type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Core_MDF_Claim_Submitter_Id__r.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Partner_User_Type</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Notification_to_Claim_Submitters</targetReference>
            </connector>
            <label>When Status is Pending Documents</label>
        </rules>
        <rules>
            <name>When_Status_is_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getClaimRecord</targetReference>
            </connector>
            <label>When Status is Approved</label>
        </rules>
        <rules>
            <name>When_Status_is_Revision_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Revision Required</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Claim_Submitters_on_VAT_Rejection</targetReference>
            </connector>
            <label>When Status is Revision Required</label>
        </rules>
        <rules>
            <name>When_Status_is_Under_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Under Review</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Read_Document_Link_Record</targetReference>
            </connector>
            <label>When Status is Under Review</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>varReleaseReason</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_VAT_Hold}</expression>
    </formulas>
    <interviewLabel>Payment Doc Flow Approved {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Payment Doc Flow Approved</label>
    <loops>
        <name>Iterate_the_records</name>
        <label>Iterate the records</label>
        <locationX>1590</locationX>
        <locationY>842</locationY>
        <collectionReference>Read_Document_Link_Record</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_Owner_Id</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getClaimRecord</name>
        <label>getClaimRecord</label>
        <locationX>520</locationX>
        <locationY>653</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Adjustment_Claim</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Claim_Id__r.Id</elementReference>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <outputReference>varClaimRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Audit_Adjustment_Amount__c</queriedFields>
        <queriedFields>Core_MDF_Status__c</queriedFields>
        <queriedFields>Core_MDF_Claim_Previous_Status__c</queriedFields>
        <queriedFields>Core_MDF_Audit_Hold__c</queriedFields>
        <queriedFields>Core_MDF_ESD_Hold__c</queriedFields>
        <queriedFields>Core_MDF_Payment_Hold_ind__c</queriedFields>
        <queriedFields>Core_MDF_Criteria_Hold_Ind__c</queriedFields>
        <queriedFields>Core_MDF_Intel_Manual_Hold_Ind__c</queriedFields>
        <queriedFields>Core_MDF_Member_Manual_Hold_Ind__c</queriedFields>
        <queriedFields>Amount</queriedFields>
        <queriedFields>Core_MDF_VAT_Eligibility_Ind__c</queriedFields>
        <queriedFields>Core_MDF_VAT_Hold_Ind__c</queriedFields>
        <queriedFields>Core_MDF_Type_Txt__c</queriedFields>
        <queriedFields>Core_MDF_C_Type_Ind__c</queriedFields>
        <queriedFields>Core_MDF_Bank_Doc_Hold_Ind__c</queriedFields>
        <queriedFields>Core_MDF_Document_Hold_Ind__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Read_Document_Link_Record</name>
        <label>Read Document Link Record</label>
        <locationX>1590</locationX>
        <locationY>653</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Iterate_the_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsDeleted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ContentDocumentId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update Adjustment</description>
        <name>Update_Adjustment</name>
        <label>Update Adjustment</label>
        <locationX>352</locationX>
        <locationY>1209</locationY>
        <inputReference>varClaimRecord</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Update the FLAO user as record owner to lock the documents for delete by user</description>
        <name>Update_Owner_Id</name>
        <label>Update Owner Id</label>
        <locationX>1724</locationX>
        <locationY>994</locationY>
        <connector>
            <targetReference>Iterate_the_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Iterate_the_records.ContentDocumentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>OwnerId</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Label.Core_MDF_Dummy_Account_Owner_Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Label.Core_MDF_Dummy_Account_Owner_Id</elementReference>
            </value>
        </inputAssignments>
        <object>ContentDocument</object>
    </recordUpdates>
    <start>
        <locationX>672</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Core_MDF_VerifyStatus</targetReference>
        </connector>
        <object>Core_MDF_Claim_VAT_Info__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>releaseReasonCollection</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
