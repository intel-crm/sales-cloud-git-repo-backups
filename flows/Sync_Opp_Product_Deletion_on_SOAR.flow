<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Sync Opp Product Deletion on SOAR {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sync Opp Product Deletion on SOAR</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_SOAR_Product</name>
        <label>Delete SOAR Product</label>
        <locationX>176</locationX>
        <locationY>395</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_Opportunity_Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CRM_VBS_SOAR__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </filters>
        <object>CRM_VBS_Product__c</object>
    </recordDeletes>
    <recordLookups>
        <name>Get_SOAR_Record</name>
        <label>Get SOAR Record</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Delete_SOAR_Product</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_SOAR_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_SOAR_Record</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.Opportunity.Core_Opportunity_Coverage_Nm__c}, &apos;Intel-Led Opportunity&apos;) &amp;&amp; (OR(ISPICKVAL({!$Record.Opportunity.Core_VBS_Status__c} , &apos;Pending&apos;),ISPICKVAL({!$Record.Opportunity.Core_VBS_Status__c} , &apos;SOAR1 Qualified&apos;))) &amp;&amp; {!$Record.Opportunity.Core_VBS_Potential__c}</filterFormula>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
