<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Core_Lead_Unreachable workflow rule
Workflow rule description: &quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Exitt_Datee_MAQLFormula</name>
        <dataType>DateTime</dataType>
        <expression>IF( ISPICKVAL($Record.Status,&apos;Marketing Qualified Lead&apos;) ,Now(),  $Record.Core_Exit_Date_MAQL__c )</expression>
    </formulas>
    <formulas>
        <name>Core_Exxit_Datee_SALFormula</name>
        <dataType>DateTime</dataType>
        <expression>IF( ISPICKVAL($Record.Status,&apos;Sales Accepted Lead&apos;) ,Now(),  $Record.Core_Exit_Date_SAL__c )</expression>
    </formulas>
    <formulas>
        <name>Core_Unreachable_StageFormula</name>
        <dataType>String</dataType>
        <expression>Text($Record.Status)</expression>
    </formulas>
    <formulas>
        <name>Core_Unreachable_Start_DateFormula</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>ExitDateSGLFormula</name>
        <dataType>DateTime</dataType>
        <expression>IF( ISPICKVAL($Record.Status,&apos;Sales Generated Lead&apos;) ,Now(), {!$Record.SWS_Exit_Date_SGL__c} )</expression>
    </formulas>
    <label>Core_Lead_Unreachable</label>
    <migratedFromWorkflowRuleName>Core_Lead_Unreachable</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>Core_Exit_Date_MAQL__c</field>
            <value>
                <elementReference>Core_Exitt_Datee_MAQLFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Exit_Date_SAL__c</field>
            <value>
                <elementReference>Core_Exxit_Datee_SALFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Lead_State__c</field>
            <value>
                <stringValue>Terminated</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Lead_Sub_Status__c</field>
            <value>
                <stringValue>Unreachable</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Unreachable_Stage__c</field>
            <value>
                <elementReference>Core_Unreachable_StageFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Unreachable_Start_Date__c</field>
            <value>
                <elementReference>Core_Unreachable_Start_DateFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Unreachable_flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SWS_Exit_Date_SGL__c</field>
            <value>
                <elementReference>ExitDateSGLFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Lead_Sub_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Lead_Sub_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Unreachable</stringValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
