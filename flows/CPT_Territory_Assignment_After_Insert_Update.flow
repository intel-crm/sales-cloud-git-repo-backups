    <decisions>
        <name>Validate_OW_Selections_by_Plan</name>
        <label>Validate OW Selections by Plan</label>
        <locationX>490</locationX>
        <locationY>4139</locationY>
        <defaultConnector>
            <targetReference>Determine_OW_Allocation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Invalid_Deal_selection_for_Design_Plan</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>OW_Deal_Selection_Count</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CPT_Get_Quota_Setup.CPT_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>620</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CPT_Get_Quota_Setup.CPT_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>621</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invalid_OW_SubElement_Selection</targetReference>
            </connector>
            <label>Invalid Deal selection for Design Plan</label>
        </rules>
        <rules>
            <name>Invalid_Design_selection_for_Deal_Plan</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>OW_Design_Selection_Count</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CPT_Get_Quota_Setup.CPT_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>630</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CPT_Get_Quota_Setup.CPT_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>631</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Invalid_OW_SubElement_Selection</targetReference>
            </connector>
            <label>Invalid Design selection for Deal Plan</label>
        </rules>
    </decisions>
