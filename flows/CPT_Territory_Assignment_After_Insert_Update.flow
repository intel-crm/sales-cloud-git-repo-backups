    &quot;250&quot;, &quot;40%&quot;,
    &quot;330&quot;, &quot;20%&quot;,
    &quot;630&quot;, &quot;20%&quot;,
    &quot;650&quot;, &quot;20%&quot;,
    &quot;&quot;
