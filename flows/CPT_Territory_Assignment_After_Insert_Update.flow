        <name>END_ELEMENT_3</name>
        <locationX>50</locationX>
        <locationY>2255</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>CheckboxCount</name>
        <dataType>Number</dataType>
        <expression>IF({!varOEMSelected}, 1, 0)
+
IF({!varRetailSelected}, 1, 0)
+
IF({!varPartnerSelected}, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>CR_Plan_Supported</name>
        <dataType>Boolean</dataType>
        <expression>CASE(
    TEXT({!CPT_Get_Quota_Setup.CPT_Plan__c}),
    &quot;120&quot;, 1,
    &quot;122&quot;, 1,
    &quot;240&quot;, 1,
    &quot;250&quot;, 1,
    &quot;330&quot;, 1,
    &quot;331&quot;, 1,
    &quot;620&quot;, 1,
    &quot;630&quot;, 1,
    &quot;631&quot;, 1,
    &quot;640&quot;, 1,
    &quot;650&quot;, 1,
    0
) = 1</expression>
    </formulas>
    <formulas>
        <name>CR_Selection_Conflict</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(
        OR(
            ISPICKVAL({!CPT_Get_Quota_Setup.CPT_Plan__c}, &quot;120&quot;),
            ISPICKVAL({!CPT_Get_Quota_Setup.CPT_Plan__c}, &quot;122&quot;)
        ),
        {!varOEMSelected},
        {!varPartnerSelected}
    ),
    AND(
        ISPICKVAL({!CPT_Get_Quota_Setup.CPT_Plan__c}, &quot;240&quot;),
        {!varPartnerSelected},
        {!varRetailSelected}
    )
)</expression>
    </formulas>
    <formulas>
        <name>isRecordNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>OEMoneSelected</name>
        <dataType>String</dataType>
        <expression>IF({!varOEMSelected}, &quot;100%&quot;, &quot;0%&quot;)</expression>
    </formulas>
    <formulas>
        <name>OEMtwoselected</name>
        <dataType>String</dataType>
        <expression>IF({!varOEMSelected}, &quot;50%&quot;, &quot;0%&quot;)</expression>
    </formulas>
    <formulas>
        <name>Partneroneselected</name>
        <dataType>String</dataType>
        <expression>IF({!varPartnerSelected}, &quot;100%&quot;, &quot;0%&quot;)</expression>
    </formulas>
    <formulas>
        <name>Partnertwoselected</name>
        <dataType>String</dataType>
        <expression>IF({!varPartnerSelected}, &quot;50%&quot;, &quot;0%&quot;)</expression>
    </formulas>
    <formulas>
        <name>Percentage_BR_DCG</name>
        <dataType>String</dataType>
        <expression>CASE(
    TEXT({!CPT_Get_Quota_Setup.CPT_Plan__c}),
    &quot;250&quot;, &quot;40%&quot;,
    &quot;330&quot;, &quot;20%&quot;,
    &quot;630&quot;, &quot;20%&quot;,
    &quot;650&quot;, &quot;20%&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Percentage_OEM</name>
        <dataType>String</dataType>
        <expression>CASE(
    TEXT({!CPT_Get_Quota_Setup.CPT_Plan__c}),
    &quot;250&quot;, &quot;60%&quot;,
    &quot;330&quot;, &quot;30%&quot;,
    &quot;620&quot;, &quot;20%&quot;,
    &quot;630&quot;, &quot;40%&quot;,
    IF(
        NOT({!varOEMSelected}),
        &quot;0%&quot;,
        CASE(
            TEXT({!CPT_Get_Quota_Setup.CPT_Plan__c}),
            &quot;120&quot;, &quot;20%&quot;,
            &quot;122&quot;, &quot;40%&quot;,
            &quot;331&quot;,
                IF(
                    {!CPT_Get_Quota_Setup.CPT_Sales_Group__c} &lt;&gt; &quot;PRC&quot;,
                    &quot;50%&quot;,
                    &quot;0%&quot;
                ),
            &quot;631&quot;,
                IF(
                    {!CPT_Get_Quota_Setup.CPT_Sales_Group__c} &lt;&gt; &quot;PRC&quot;,
                    &quot;70%&quot;,
                    &quot;0%&quot;
                ),
            &quot;640&quot;,
                CASE(
                    {!CheckboxCount},
                    1, &quot;100%&quot;,
                    2, &quot;50%&quot;,
                    3, &quot;33.333%&quot;,
                    &quot;0%&quot;
                ),
            &quot;650&quot;,
                CASE(
                    {!CheckboxCount},
                    1, &quot;80%&quot;,
                    2, &quot;40%&quot;,
                    3, &quot;26.666%&quot;,
                    &quot;0%&quot;
                ),
            &quot;0%&quot;
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>Percentage_Partner</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT({!varPartnerSelected}),
    &quot;0%&quot;,
    CASE(
        TEXT({!CPT_Get_Quota_Setup.CPT_Plan__c}),
        &quot;120&quot;, &quot;20%&quot;,
        &quot;122&quot;, &quot;40%&quot;,
        &quot;240&quot;, &quot;100%&quot;,
        &quot;640&quot;,
            CASE(
                {!CheckboxCount},
                1, &quot;100%&quot;,
                2, &quot;50%&quot;,
                3, &quot;33.334%&quot;,
                &quot;0%&quot;
            ),
        &quot;650&quot;,
            CASE(
                {!CheckboxCount},
                1, &quot;80%&quot;,
                2, &quot;40%&quot;,
                3, &quot;26.668%&quot;,
                &quot;0%&quot;
            ),
        &quot;0%&quot;
    )
)</expression>
    </formulas>
    <formulas>
        <name>Percentage_Retail</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT({!varRetailSelected}),
    &quot;0%&quot;,
    CASE(
        TEXT({!CPT_Get_Quota_Setup.CPT_Plan__c}),
        &quot;240&quot;, &quot;100%&quot;,
        &quot;640&quot;,
            CASE(
                {!CheckboxCount},
                1, &quot;100%&quot;,
                2, &quot;50%&quot;,
                3, &quot;33.333%&quot;,
                &quot;0%&quot;
            ),
        &quot;650&quot;,
            CASE(
                {!CheckboxCount},
                1, &quot;80%&quot;,
                2, &quot;40%&quot;,
                3, &quot;26.666%&quot;,
                &quot;0%&quot;
            ),
        &quot;0%&quot;
    )
)</expression>
    </formulas>
    <formulas>
        <name>PercentageValue</name>
        <dataType>String</dataType>
        <expression>CASE(
   {!CheckboxCount},
   1, &apos;100%&apos;,
   2, &apos;50%&apos;,
   3, &apos;33.333%&apos;,
   &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>Plan_240_OEM</name>
        <dataType>String</dataType>
        <expression>IF(
   {!$Record.CPT_CR_OEM__c},  
   &apos;100%&apos;,
   &apos;0%&apos;
)</expression>
    </formulas>
    <formulas>
        <name>Plan_240_Partner</name>
        <dataType>String</dataType>
        <expression>IF(
   {!$Record.CPT_CR_Partner__c},  
   &apos;100%&apos;,
   &apos;0%&apos;
)</expression>
    </formulas>
    <formulas>
        <name>Plan_240_Retail</name>
        <dataType>String</dataType>
        <expression>IF(
   {!$Record.CPT_CR_Retail__c},  
   &apos;100%&apos;,
   &apos;0%&apos;
)</expression>
    </formulas>
    <formulas>
        <name>QS_OEM</name>
        <dataType>String</dataType>
        <expression>IF(
   {!$Record.CPT_CR_OEM__c},  
   {!PercentageValue},
   &apos;0%&apos;
)</expression>
    </formulas>
    <formulas>
        <name>QS_Partner</name>
        <dataType>String</dataType>
        <expression>IF(
    {!$Record.CPT_CR_Partner__c},
   {!PercentageValue},
   &quot;0%&quot;
)</expression>
    </formulas>
    <formulas>
        <name>QS_Retail</name>
        <dataType>String</dataType>
        <expression>IF(
   {!$Record.CPT_CR_Retail__c},
   {!PercentageValue},
   &quot;0%&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Retailoneselected</name>
        <dataType>String</dataType>
        <expression>IF({!varRetailSelected}, &quot;100%&quot;, &quot;0%&quot;)</expression>
    </formulas>
    <formulas>
        <name>Retailtwoselected</name>
        <dataType>String</dataType>
        <expression>IF({!varRetailSelected}, &quot;50%&quot;, &quot;0%&quot;)</expression>
    </formulas>
