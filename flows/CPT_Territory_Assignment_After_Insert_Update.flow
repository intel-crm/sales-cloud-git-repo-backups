    <description>[11/Nov/2026] Flow to copy the target values from target object into the assignment</description>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>754</locationX>
        <locationY>539</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_2</name>
        <locationX>446</locationX>
        <locationY>2447</locationY>
    </ends>
