    <formulas>
        <name>Percentage_OEM</name>
        <dataType>String</dataType>
        <expression>CASE(
    TEXT({!CPT_Get_Quota_Setup.CPT_Plan__c}),
    &quot;250&quot;, &quot;60%&quot;,
    &quot;330&quot;, &quot;60%&quot;,
    &quot;620&quot;, &quot;20%&quot;,
    &quot;630&quot;, &quot;60%&quot;,
    IF(
        NOT({!varOEMSelected}),
        &quot;0%&quot;,
        CASE(
            TEXT({!CPT_Get_Quota_Setup.CPT_Plan__c}),
            &quot;120&quot;, &quot;20%&quot;,
            &quot;122&quot;, &quot;40%&quot;,
            &quot;331&quot;,
                IF(
                    {!CPT_Get_Quota_Setup.CPT_Sales_Group__c} &lt;&gt; &quot;PRC&quot;,
                    &quot;70%&quot;,
                    &quot;0%&quot;
                ),
            &quot;631&quot;,
                IF(
                    {!CPT_Get_Quota_Setup.CPT_Sales_Group__c} &lt;&gt; &quot;PRC&quot;,
                    &quot;70%&quot;,
                    &quot;0%&quot;
                ),
            &quot;640&quot;,
                CASE(
                    {!CheckboxCount},
                    1, &quot;100%&quot;,
                    2, &quot;50%&quot;,
                    3, &quot;33.333%&quot;,
                    &quot;0%&quot;
                ),
            &quot;650&quot;,
                CASE(
                    {!CheckboxCount},
                    1, &quot;80%&quot;,
                    2, &quot;40%&quot;,
                    3, &quot;26.666%&quot;,
                    &quot;0%&quot;
