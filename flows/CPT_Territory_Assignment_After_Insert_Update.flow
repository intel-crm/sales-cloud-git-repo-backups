            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Territory_Assignment_Records.CPT_CR_Retail__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_3</targetReference>
            </connector>
            <label>Retail Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Iss_OEM_Selected</name>
