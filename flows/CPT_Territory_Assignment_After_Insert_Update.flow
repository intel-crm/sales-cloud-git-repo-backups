    <decisions>
        <name>BR_DCG_Default_Required</name>
        <label>BR DCG Default Required?</label>
        <locationX>930</locationX>
        <locationY>4613</locationY>
        <defaultConnector>
            <targetReference>Conflicting_CR_Selections</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Apply_BR_Default</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CPT_Get_Quota_Setup.CPT_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>250</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CPT_Get_Quota_Setup.CPT_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>330</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CPT_Get_Quota_Setup.CPT_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>630</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CPT_Get_Quota_Setup.CPT_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>650</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_BR_DCG_Default</targetReference>
            </connector>
            <label>Apply BR Default</label>
        </rules>
    </decisions>
