    <formulas>
        <name>CheckboxCount</name>
        <dataType>Number</dataType>
        <expression>IF({!varOEMSelected}, 1, 0)
+
IF({!varRetailSelected}, 1, 0)
+
IF({!varPartnerSelected}, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>CR_Plan_Supported</name>
        <dataType>Boolean</dataType>
        <expression>CASE(
    TEXT({!CPT_Get_Quota_Setup.CPT_Plan__c}),
    &quot;120&quot;, 1,
    &quot;122&quot;, 1,
    &quot;240&quot;, 1,
    &quot;250&quot;, 1,
    &quot;330&quot;, 1,
    &quot;331&quot;, 1,
    &quot;620&quot;, 1,
    &quot;621&quot;, 1,
    &quot;630&quot;, 1,
    &quot;631&quot;, 1,
    &quot;640&quot;, 1,
    &quot;650&quot;, 1,
    0
) = 1</expression>
    </formulas>
    <formulas>
        <name>CR_Selection_Conflict</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(
        OR(
            ISPICKVAL({!CPT_Get_Quota_Setup.CPT_Plan__c}, &quot;120&quot;),
            ISPICKVAL({!CPT_Get_Quota_Setup.CPT_Plan__c}, &quot;122&quot;)
        ),
        {!varOEMSelected},
        {!varPartnerSelected}
    ),
    AND(
        ISPICKVAL({!CPT_Get_Quota_Setup.CPT_Plan__c}, &quot;240&quot;),
        {!varPartnerSelected},
        {!varRetailSelected}
    )
)</expression>
    </formulas>
    <formulas>
        <name>isRecordNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
