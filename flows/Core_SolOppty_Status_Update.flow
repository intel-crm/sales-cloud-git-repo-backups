        <label>Assignment of child opptys status</label>
        <locationX>138</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>All_related_opptys.Core_Status_Update__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>AppendedStatus</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_in_the_list</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>IsChildOpptyFound</name>
        <label>IsChildOpptyFound</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_opptys</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>All_related_opptys</targetReference>
            </connector>
            <label>yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>AppendedStatus</name>
        <dataType>String</dataType>
        <expression>{!formatted_Status}+BR()+{!All_related_opptys.Core_Status_Update__c}</expression>
    </formulas>
    <formulas>
        <name>formatted_Status</name>
        <dataType>String</dataType>
        <expression>LPAD(TEXT(MONTH(TODAY())),2,&quot;0&quot;)&amp;&quot;/&quot;&amp;LPAD(TEXT(DAY (TODAY())),2,&quot;0&quot;)&amp;&quot;/&quot;&amp;TEXT(YEAR(TODAY()))+&quot; &quot;+{!$User.FirstName}+&quot; &quot;+{!$User.LastName}+&quot; : &quot;+{!$Record.Core_Status_Update__c}</expression>
    </formulas>
    <interviewLabel>Core_SolOppty_Status_Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_SolOppty_Status_Update</label>
    <loops>
        <name>All_related_opptys</name>
        <label>All related opptys</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <collectionReference>Get_Related_opptys</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assignment_of_child_opptys_status</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Child_Opptys_of_Solution_Group</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
