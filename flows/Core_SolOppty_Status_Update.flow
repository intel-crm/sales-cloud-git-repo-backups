            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>stamping_dates</name>
        <label>stamping dates</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Get_Related_opptys</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Status_Update__c</field>
            <value>
                <elementReference>formatted_Status</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Child_Opptys_of_Solution_Group</name>
        <label>Update Child Opptys of Solution Group</label>
        <locationX>50</locationX>
        <locationY>1055</locationY>
        <inputReference>StatusStore</inputReference>
