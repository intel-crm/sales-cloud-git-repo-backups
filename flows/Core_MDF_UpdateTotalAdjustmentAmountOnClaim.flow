<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>AdjAmountAssignment</name>
        <label>AdjAmountAssignment</label>
        <locationX>886</locationX>
        <locationY>286</locationY>
        <assignmentItems>
            <assignToReference>SumOfAdjRequestsAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_to_Adjustment_Requests.Core_MDF_Amount_Amt__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_to_Adjustment_Requests</targetReference>
        </connector>
    </assignments>
    <description>The Flow updates the sum of all adjustments requests amount field &quot;Total Adjustment Amount&quot; corresponding to Reference Claim</description>
    <interviewLabel>Core_MDF_Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_UpdateTotalAdjustmentAmountOnClaim</label>
    <loops>
        <name>Loop_to_Adjustment_Requests</name>
        <label>Loop to Adjustment Requests</label>
        <locationX>621</locationX>
        <locationY>187</locationY>
        <collectionReference>List_Of_Adjustment_Requests</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AdjAmountAssignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_TotalAdjField</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Adjustment_Records_wrt_Reference_Claim</name>
        <label>Get All Adjustment Records wrt Reference Claim</label>
        <locationX>444</locationX>
        <locationY>151</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_to_Adjustment_Requests</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Adjustment_Status_nm__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Reason_Cd__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Escalation</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Reference_Claim_Nbr__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Reference_Claim_Nbr__c</elementReference>
            </value>
        </filters>
        <object>Core_MDF_Adjustment_Request__c</object>
        <outputReference>List_Of_Adjustment_Requests</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Amount_Amt__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_TotalAdjField</name>
        <label>Update_TotalAdjField</label>
        <locationX>664</locationX>
        <locationY>402</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Reference_Claim_Nbr__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Total_Adjustment_Amt__c</field>
            <value>
                <elementReference>SumOfAdjRequestsAmount</elementReference>
            </value>
        </inputAssignments>
        <object>PartnerFundClaim</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_All_Adjustment_Records_wrt_Reference_Claim</targetReference>
        </connector>
        <object>Core_MDF_Adjustment_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>List_Of_Adjustment_Requests</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Core_MDF_Adjustment_Request__c</objectType>
    </variables>
    <variables>
        <name>SumOfAdjRequestsAmount</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
