                <leftValueReference>$Record.Account.Owner.Core_User_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>APJ</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Team_Geo_APJ__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Opportunity_Geo_APJ</targetReference>
            </connector>
            <label>Geo-APJ</label>
