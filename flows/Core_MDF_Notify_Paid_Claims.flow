<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>PaidValue</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Paid</stringValue>
        </value>
    </constants>
    <description>Notifications to be send once the claim is paid.</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_MDF_Last_Week_Date</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 7</expression>
    </formulas>
    <interviewLabel>Core_MDF_Notify_Paid_Claims {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Notify_Paid_Claims</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetHistory</name>
        <label>GetHistory</label>
        <locationX>506</locationX>
        <locationY>149</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>Core_MDF_Last_Week_Date</elementReference>
            </value>
        </filters>
        <filters>
            <field>Field</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_MDF_Status__c</stringValue>
            </value>
        </filters>
        <filters>
            <field>NewValue</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>PaidValue</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PartnerFundClaimHistory</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>78</locationX>
        <locationY>45</locationY>
        <connector>
            <targetReference>GetHistory</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <schedule>
            <frequency>Weekly</frequency>
            <startDate>2023-12-13</startDate>
            <startTime>04:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>currentItemFromSourceCollection</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>PaidClaims</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>PaidDataAssign</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>Recovery2</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Core_MDF_Recovery__c</objectType>
    </variables>
    <variables>
        <name>RecoveryWithClaims</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_Recovery__c</objectType>
    </variables>
    <variables>
        <name>StoreRecoveryClaims</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Core_MDF_Recovery__c</objectType>
    </variables>
</Flow>
