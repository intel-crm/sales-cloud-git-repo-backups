<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Contact_Established</name>
        <label>Check Contact Established</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Contact_Established</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_PAL_Entry_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Contact_Estb_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PAL</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Contact_Estb_Dt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Entrance_Date_Contact_Established</targetReference>
            </connector>
            <label>Contact Established</label>
        </rules>
        <rules>
            <name>Contacted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_PAL_Entry_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Entrance_Date_Contacted_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PAL</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Entrance_Date_Contacted</targetReference>
            </connector>
            <label>Contacted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Lead_Status</name>
        <label>Check Lead Status</label>
        <locationX>1106</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Lead_Status_Contacted</name>
            <conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contacted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Contact_Established</targetReference>
            </connector>
            <label>Lead Status Contacted</label>
        </rules>
        <rules>
            <name>Lead_Status_Qualified</name>
            <conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Prior_Lead_Status</targetReference>
            </connector>
            <label>Lead Status Qualified</label>
        </rules>
        <rules>
            <name>Lead_Status_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_record_create_or_Update</targetReference>
            </connector>
            <label>Lead Status New</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Prior_Lead_Status</name>
        <label>Check Prior Lead Status</label>
        <locationX>974</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Prior_Status_Contacted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contacted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Entrance_Date_PQL_Exit_Date_PAL</targetReference>
            </connector>
            <label>Prior Status Contacted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_record_create_or_Update</name>
        <label>Check record create or Update</label>
        <locationX>1502</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Create_or_Update</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CheckIsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Entrance_Date_PRL</targetReference>
            </connector>
            <label>Create or Update</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CheckIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>Date_Time_Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Partner_Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Partner_Lead_Entrance_Date_Related_Field_Updates</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Entrance_Date_Contact_Established</name>
        <label>Update Entrance Date Contact Established</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <inputAssignments>
            <field>Core_Contact_Estb_Dt__c</field>
            <value>
                <elementReference>Date_Time_Now</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Entrance_Date_Contacted</name>
        <label>Update Entrance Date Contacted</label>
        <locationX>314</locationX>
        <locationY>503</locationY>
        <inputAssignments>
            <field>Core_Entrance_Date_Contacted_Dt__c</field>
            <value>
                <elementReference>Date_Time_Now</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Entrance_Date_PQL_Exit_Date_PAL</name>
        <label>Update_Entrance_Date_PQL_Exit_Date_PAL</label>
        <locationX>842</locationX>
        <locationY>503</locationY>
        <inputAssignments>
            <field>Core_Exit_Date_Contacted_Dt__c</field>
            <value>
                <elementReference>Date_Time_Now</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Lead_State__c</field>
            <value>
                <stringValue>Converted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PAL_Exit_Dt__c</field>
            <value>
                <elementReference>Date_Time_Now</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_PQL_Entry_Dt__c</field>
            <value>
                <elementReference>Date_Time_Now</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>PQL</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Entrance_Date_PRL</name>
        <label>Update Entrance Date PRL</label>
        <locationX>1370</locationX>
        <locationY>503</locationY>
        <inputAssignments>
            <field>Core_PRL_Entry_Dt__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>PRL</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>980</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Lead_Status</targetReference>
        </connector>
        <filterFormula>AND({!$Record.RecordType.Name}=&apos;Partner Lead&apos;, OR(ISPICKVAL({!$Record.Core_Lead_Status__c}, &apos;New&apos;), ISPICKVAL({!$Record.Core_Lead_Status__c}, &apos;Contacted&apos;),ISPICKVAL({!$Record.Core_Lead_Status__c}, &apos;Qualified&apos;)))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
