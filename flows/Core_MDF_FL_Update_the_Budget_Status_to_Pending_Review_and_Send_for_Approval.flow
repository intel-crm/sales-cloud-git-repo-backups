            </conditions>
            <connector>
                <targetReference>Get_RMF_ASMO_LAR_Finance_Manager_Queue_Group</targetReference>
            </connector>
            <label>RMF ASMO LAR</label>
        </rules>
        <rules>
            <name>CCFB</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_CoMarketing_Budget_Record_type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_CCFB_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_CCFB_Finance_Managers</targetReference>
