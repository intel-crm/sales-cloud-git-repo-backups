    <recordUpdates>
        <name>Core_MDF_Update_the_Budget_Status_to_Pending_Review</name>
        <label>Update the Budget Status to Pending Review and IsIgnoreValidation to true</label>
        <locationX>615</locationX>
        <locationY>402</locationY>
        <connector>
            <targetReference>Check_whether_it_is_a_MDF_MDF_Budget_type</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Core_MDF_Log_Entry</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vBudgetId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Budget_Status__c</field>
            <value>
                <stringValue>Pending Review</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsIgnoreValidation</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>PartnerMarketingBudget</object>
    </recordUpdates>
    <recordUpdates>
        <description>To Update Ignore Validations to True for IPA Budget</description>
        <name>Update_Ignore_Validation_to_True</name>
        <label>Update Ignore Validation to True</label>
        <locationX>414</locationX>
        <locationY>641</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vBudgetId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>IsIgnoreValidation</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>PartnerMarketingBudget</object>
    </recordUpdates>
