<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Core_MDF_Submit_Budget_for_Approval</name>
        <label>Submit Budget for Approval</label>
        <locationX>320</locationX>
        <locationY>206</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>vBudgetId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <elementReference>fApprovalProcessId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>submit</nameSegment>
        <outputParameters>
            <assignToReference>vResultBudgetId</assignToReference>
            <name>entityId</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This will update the Budget Status to Pending Review and IsIgnoreValidation to true and submit it for Approval.</description>
    <formulas>
        <description>This will contain the Budget Approval Process Id.</description>
        <name>fApprovalProcessId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_Budget_Approval_Process}</expression>
    </formulas>
    <interviewLabel>Core_MDF_FL_Update_the_Budget_Status_to_Pending_Review_and_Send_for_Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_FL_Update_the_Budget_Status_to_Pending_Review_and_IsIgnoreValidation_to_true_and_Send_for_Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_MDF_Update_the_Budget_Status_to_Pending_Review</name>
        <label>Update the Budget Status to Pending Review and IsIgnoreValidation to true</label>
        <locationX>141</locationX>
        <locationY>207</locationY>
        <connector>
            <targetReference>Core_MDF_Submit_Budget_for_Approval</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vBudgetId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Budget_Status__c</field>
            <value>
                <stringValue>Pending Review</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsIgnoreValidation</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>PartnerMarketingBudget</object>
    </recordUpdates>
    <startElementReference>Core_MDF_Update_the_Budget_Status_to_Pending_Review</startElementReference>
    <status>Active</status>
    <variables>
        <description>This will contain the Budget Id.</description>
        <name>vBudgetId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <description>This will contain the Result of the Approval Process.</description>
        <name>vResultBudgetId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
</Flow>
