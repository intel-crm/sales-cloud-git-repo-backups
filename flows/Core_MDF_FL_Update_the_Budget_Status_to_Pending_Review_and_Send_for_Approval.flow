    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>To check whether the given budget belongs to RMF,CCFB,SPCF,OEMCMP,SPCMP or Legacy Budget Types</description>
        <name>Check_for_Other_Budget_Types</name>
        <label>Check for Other Budget Types</label>
        <locationX>925</locationX>
        <locationY>861</locationY>
        <defaultConnectorLabel>Other Budget Types</defaultConnectorLabel>
        <rules>
            <name>CCF_Non_MDF_MDF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_CoMarketing_Budget_Record_type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_CCF_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>MDF+</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_CCF_Finance_Manager_Queue_Group</targetReference>
            </connector>
            <label>CCF Non MDF/MDF+</label>
        </rules>
        <rules>
            <name>DCF_Non_MDF_MDF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_CoMarketing_Budget_Record_type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_DCF_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>MDF+</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_DCF_Finance_Manager_Queue_Group</targetReference>
            </connector>
            <label>DCF Non MDF/MDF+</label>
        </rules>
        <rules>
            <name>RMF_APJ</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Retail_Budget_Record_type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Partner__r.Core_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>APJ</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_RMF_APJ_Finance_Manager_Queue_Group</targetReference>
            </connector>
            <label>RMF APJ</label>
        </rules>
        <rules>
            <name>RMF_EMEA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Retail_Budget_Record_type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Partner__r.Core_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_RMF_EMEA_Finance_Manager_Queue_Group</targetReference>
            </connector>
            <label>RMF EMEA</label>
        </rules>
        <rules>
            <name>RMF_PRC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Retail_Budget_Record_type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Partner__r.Core_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PRC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_RMF_PRC_Finance_Manager_Queue_Group</targetReference>
            </connector>
            <label>RMF PRC</label>
        </rules>
        <rules>
            <name>RMF_ASMO_NAR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Retail_Budget_Record_type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Partner__r.Core_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ASMO</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Partner__r.Core_Sub_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NAR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_RMF_ASMO_NAR_Finance_Manager_Queue_Group</targetReference>
            </connector>
            <label>RMF ASMO NAR</label>
        </rules>
        <rules>
            <name>RMF_ASMO_LAR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Retail_Budget_Record_type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Partner__r.Core_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ASMO</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Partner__r.Core_Sub_Geo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>LAR</stringValue>
