    <decisions>
        <description>Check whether it is a MDF/MDF+ Budget type</description>
        <name>Check_whether_it_is_a_MDF_MDF_Budget_type</name>
        <label>Check whether it is a MDF/MDF+ Budget type</label>
        <locationX>926</locationX>
        <locationY>415</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Submit_Budget_for_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Budget Types</defaultConnectorLabel>
        <rules>
            <name>It_is_a_MDF_MDF_Budget_type</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Budget_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MDF+</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Client</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Datacenter</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Approval_process_for_MDF_MDF_Budget_Type</targetReference>
            </connector>
            <label>MDF/MDF+</label>
        </rules>
        <rules>
            <name>IPA_Account_Based</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_IPA_Technical_program_name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_IPA_AccountBased_RecType_DevName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Approval_process_for_IPA</targetReference>
            </connector>
            <label>IPA Account Based</label>
        </rules>
        <rules>
            <name>Core_MDF_EEF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_EEF_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Approval_Process_for_EEF</targetReference>
            </connector>
            <label>EEF</label>
        </rules>
        <rules>
            <name>Co_GTM_Program</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_GTM_program_name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approval_Process_for_Co_GTM</targetReference>
            </connector>
            <label>Co-GTM</label>
        </rules>
        <rules>
            <name>Core_MDF_Co_Inv</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_Inv_program_name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approval_Process_for_Co_Inv</targetReference>
            </connector>
            <label>Co-Inv</label>
        </rules>
    </decisions>
    <decisions>
        <description>To Check whether the given budget is an IPA Proposal Based Budget</description>
        <name>Check_whether_it_is_an_IPA_Proposal_Based_Budget</name>
        <label>Check whether it is an IPA Proposal Based Budget</label>
        <locationX>406</locationX>
        <locationY>407</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Update_the_Budget_Status_to_Pending_Review</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non IPA/CMDF Proposal Based Budget</defaultConnectorLabel>
        <rules>
            <name>Is_an_IPA_Proposal_Based_Budget</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Fetch_Budget.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_IPA_ProposalBased</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Ignore_Validation_to_True</targetReference>
            </connector>
            <label>Is an IPA Proposal Based Budget</label>
        </rules>
    </decisions>
    <description>This will update the Budget Status to Pending Review and IsIgnoreValidation to true and submit it for Approval.</description>
    <environments>Default</environments>
    <formulas>
        <name>Co_GTM_Budget_ApprovalProcessId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_Co_GTM_Budget_ApprovalProcess}</expression>
    </formulas>
    <formulas>
        <name>Co_Inv_Budget_ApprovalProcessId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_Co_Inv_Budget_ApprovalProcess}</expression>
    </formulas>
    <formulas>
        <name>EEF_ApprovalProcess_Name</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_EEF_ApprovalProcess}</expression>
    </formulas>
    <formulas>
        <description>This will contain the Budget Approval Process Id.</description>
        <name>fApprovalProcessId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_Budget_Approval_Process}</expression>
    </formulas>
    <formulas>
        <description>This will contain MDF/MDF+ Budget Type Approval process Id</description>
        <name>fBudgetTypeApprovalId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_Budget_Type_Approval_Process}</expression>
    </formulas>
    <formulas>
        <name>IPAApprovalProcess</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_IPA_AccBased_Budget_Approval}</expression>
    </formulas>
    <formulas>
        <name>varWaitToGetApproved</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} + 0.000000015</expression>
    </formulas>
    <interviewLabel>Core_MDF_FL_Update_the_Budget_Status_to_Pending_Review_and_Send_for_Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_FL_Update_the_Budget_Status_to_Pending_Review_and_IsIgnoreValidation_to_true_and_Send_for_Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Capture Error message from trigger and insert log entry</description>
        <name>Core_MDF_Log_Entry</name>
        <label>LogEntry</label>
        <locationX>615</locationX>
        <locationY>680</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <stringValue>An error has occurred in Flow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>Flow.Core_MDF_FL_Update_the_Budget_Status_to_Pending_Review_and_IsIgnoreValidation_to_true_and_Send_for_Approval</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <stringValue>Consolidated Co-Marketing Program (CCP)</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Critical</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Support_Email__c</field>
            <value>
                <stringValue>ccptechsupport@intel.com</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Support_Link__c</field>
            <value>
                <stringValue>https://www.intel.com/content/www/us/en/homepage.html</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
