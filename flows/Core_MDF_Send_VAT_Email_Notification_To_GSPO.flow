<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>callApexToSendEmail</name>
        <label>callApexToSendEmail</label>
        <locationX>1165</locationX>
        <locationY>208</locationY>
        <actionName>Core_MDF_EmailToGSPO</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>paymentRunId</name>
            <value>
                <elementReference>get_records_of_payment_run.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_EmailToGSPO</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>checkVATClaimCount</name>
        <label>checkVATClaimCount</label>
        <locationX>806</locationX>
        <locationY>412</locationY>
        <actionName>Core_MDF_VatUtility</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_Return_Type</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>paymentRunId</name>
            <value>
                <elementReference>get_records_of_payment_run.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_VatUtility</nameSegment>
        <outputParameters>
            <assignToReference>BooleanValue</assignToReference>
            <name>output</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>50.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_variable_to_List</name>
        <label>Assign variable to List</label>
        <locationX>614</locationX>
        <locationY>412</locationY>
        <assignmentItems>
            <assignToReference>paymentRunIdList</assignToReference>
            <operator>AddAtStart</operator>
            <value>
                <elementReference>get_records_of_payment_run.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>checkVATClaimCount</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>yesInput</name>
        <choiceText>&lt;span style=&quot;font-size: 20px;&quot;&gt;﻿Yes&lt;/span&gt;</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>false</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Check_Return_Type</name>
        <label>Check Return type</label>
        <locationX>798</locationX>
        <locationY>207</locationY>
        <defaultConnector>
            <targetReference>No_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IfReturnTypeIsTrue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>BooleanValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Confirmation</targetReference>
            </connector>
            <label>IfReturnTypeIsTrue</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_status_program_region_and_budget_type</name>
        <label>check status program region and budget type</label>
        <locationX>359</locationX>
        <locationY>413</locationY>
        <defaultConnector>
            <targetReference>NotCompletedEMEARetailMDFPaymentRun</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>status_program_region_and_budget_type_check</name>
            <conditionLogic>1 AND (((2 OR 6) AND 3 AND 4) OR ((6 OR 2) AND 5) OR 7)</conditionLogic>
            <conditions>
                <leftValueReference>get_records_of_payment_run.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_records_of_payment_run.Core_MDF_Geo_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_records_of_payment_run.Core_MDF_Budget_Type_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Retail MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_records_of_payment_run.Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Retail Marketing Funds</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_records_of_payment_run.Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Partner Alliance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_records_of_payment_run.Core_MDF_Geo_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>APJ</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_records_of_payment_run.Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CoGTM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_variable_to_List</targetReference>
            </connector>
            <label>status program region and budget type check</label>
        </rules>
    </decisions>
    <description>This flow will send email notification to GSPO, when Send/Resend notification button on Payment Run record will be clicked.</description>
    <environments>Default</environments>
    <interviewLabel>Core_MDF_Send_VAT_Email_Notification_To_GSPO {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Send_VAT_Email_Notification_To_GSPO</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>get_records_of_payment_run</name>
        <label>get records of payment run</label>
        <locationX>365</locationX>
        <locationY>214</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>check_status_program_region_and_budget_type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_Payment_Run__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Confirmation</name>
        <label>Confirmation</label>
        <locationX>1002</locationX>
        <locationY>204</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>callApexToSendEmail</targetReference>
        </connector>
        <fields>
            <name>display</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(88, 96, 110); font-family: &amp;quot;Open Sans&amp;quot;, -apple-system, system-ui, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; background-color: rgb(255, 255, 255); font-size: 14px;&quot;&gt;Are you sure you want to send notifications to &quot;gspo_ocr.invoice@intel.com&quot;? If yes, click on the Next button. If not, please close this&amp;nbsp;popup message.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>No_Record</name>
        <label>No Record</label>
        <locationX>601</locationX>
        <locationY>201</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NoVATInvoicesFound</name>
            <fieldText>&lt;p&gt;There were no VAT claims/adjustments in this payment run, therefore, there are no Payment documents to be sent to GSPO.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>NotCompletedEMEARetailMDFPaymentRun</name>
        <label>NotCompletedEMEARetailMDFPaymentRun</label>
        <locationX>134</locationX>
        <locationY>400</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ButtonNotAvl</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Calibri, sans-serif; font-size: 14.6667px; background-color: rgb(255, 255, 255);&quot;&gt;Notifications to GSPO can be sent only for EMEA /APJ based Retail MDF payment runs in completed status&lt;/span&gt;&lt;span style=&quot;color: rgb(88, 96, 110); font-family: &amp;quot;Open Sans&amp;quot;, -apple-system, system-ui, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>get_records_of_payment_run.Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Retail Marketing Funds</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>ButtonNotAvailable</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;Notifications to GSPO can be sent only for EMEA /APJ based payment runs in completed status&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Open Sans&amp;quot;, -apple-system, system-ui, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; color: rgb(88, 96, 110); background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>get_records_of_payment_run.Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                    <operator>NotEqualTo</operator>
                    <rightValue>
                        <stringValue>Retail Marketing Funds</stringValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>get_records_of_payment_run.Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                    <operator>NotEqualTo</operator>
                    <rightValue>
                        <stringValue>CoGTM</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>ButtonNotAvlble</name>
            <fieldText>&lt;h1&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;Notifications to GSPO can be sent only in completed status&lt;/span&gt;&lt;/h1&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
