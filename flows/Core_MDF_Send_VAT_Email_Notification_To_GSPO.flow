            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>get_records_of_payment_run.Core_MDF_Program_Id__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                    <operator>EqualTo</operator>
