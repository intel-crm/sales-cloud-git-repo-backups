    <description>Migrated from the: Core_Lead_Send_Email_To_Partners workflow rule
Workflow rule description: Workflow to send Email Notification to Partners when a new lead is assigned.&quot;</description>
    <environments>Default</environments>
    <label>Core_Lead_Send_Email_To_Partners_2</label>
    <migratedFromWorkflowRuleName>Core_Lead_Send_Email_To_Partners</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
