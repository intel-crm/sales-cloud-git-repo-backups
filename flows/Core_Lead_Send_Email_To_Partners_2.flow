    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterFormula>AND({!$Record.RecordType.DeveloperName} = &quot;Partner_Lead&quot;, {!$Record.Core_Notify_Owner__c} =true,
