<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Error_Message_for_contact</name>
        <label>Error Message for contact</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <customErrorMessages>
            <errorMessage>A duplicate contact with the same email is found.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Error_Message_for_lead</name>
        <label>Error Message for lead</label>
        <locationX>578</locationX>
        <locationY>647</locationY>
        <customErrorMessages>
            <errorMessage>A duplicate Lead with the same lead is found.
View here: {!Lead_Record_URL}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description>Get Lead based on Marketo User and Product</description>
        <name>Get_Lead_based_on_Marketo_User_and_Product</name>
        <label>Get Lead based on Marketo User and Product</label>
        <locationX>446</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Leads_based_on_new_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.Email</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>MarketoUserEmail</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_PSG_Lead__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Lead</targetReference>
            </connector>
            <label>Leads based on new Product</label>
        </rules>
        <rules>
            <name>Duplicate_Contact_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Duplicate_Contacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message_for_contact</targetReference>
            </connector>
            <label>Duplicate Contact found</label>
        </rules>
        <rules>
            <name>Duplicate_Lead_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Duplicate_Leads</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message_for_lead</targetReference>
            </connector>
            <label>Duplicate Lead found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Lead_Record_URL</name>
        <dataType>String</dataType>
        <expression>&quot;/&quot; &amp; {!Get_Duplicate_Leads.Id}</expression>
    </formulas>
    <interviewLabel>SWS_Core_Lead_Create_Duplicate_Leads {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SWS_Core_Lead_Create_Duplicate_Leads</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
