<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Republish_Contact</name>
        <label>Republish Contact</label>
        <locationX>802</locationX>
        <locationY>797</locationY>
        <actionName>Core_Draco_Misc_Functionalities</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Increment_the_Counter</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>calledFeature</name>
            <value>
                <elementReference>CalledFeatureConcat</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_Draco_Misc_Functionalities</nameSegment>
    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_value_to_CalledFeature</name>
        <label>Add value to CalledFeature</label>
        <locationX>583</locationX>
        <locationY>797</locationY>
        <assignmentItems>
            <assignToReference>CalledFeaturetoApex</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CalledFeatureConcat</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Republish_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_the_Counter</name>
        <label>Increment the Counter</label>
        <locationX>1059</locationX>
        <locationY>797</locationY>
        <assignmentItems>
            <assignToReference>ContactsCounter</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_for_number_of_contacts_Republished</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Counter_to_1</name>
        <label>Set Counter to 1</label>
        <locationX>582</locationX>
        <locationY>322</locationY>
        <assignmentItems>
            <assignToReference>ContactsCounter</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Across_Contact_Inputs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Counter_to_1_0</name>
        <label>Set Counter to 1</label>
        <locationX>1063</locationX>
        <locationY>307</locationY>
        <assignmentItems>
            <assignToReference>ContactsCounter</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Across_Contact_Inputs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Republish_OBM_Field</name>
        <label>Update Republish OBM Field</label>
        <locationX>582</locationX>
        <locationY>646</locationY>
        <assignmentItems>
            <assignToReference>Loop_Across_Contact_Inputs.Core_Republish_OBM_s__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_value_to_CalledFeature</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_for_number_of_contacts_Republished</name>
        <label>Check for number of contacts Republished</label>
        <locationX>1052</locationX>
        <locationY>632</locationY>
        <defaultConnector>
            <targetReference>Pause_for_1_hour</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>More than 50</defaultConnectorLabel>
        <rules>
            <name>Less_than_50</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContactsCounter</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Across_Contact_Inputs</targetReference>
            </connector>
            <label>Less than 50</label>
        </rules>
    </decisions>
    <description>This flow will republish the list of contacts received with set of 50 contacts republish every 1 hour of time frame.</description>
    <environments>Default</environments>
    <formulas>
        <name>CalledFeatureConcat</name>
        <dataType>String</dataType>
        <expression>&quot;RepublishContact:&quot; &amp; {!Loop_Across_Contact_Inputs.Id}</expression>
    </formulas>
    <interviewLabel>Republish List of Contacts {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Republish List of Contacts</label>
    <loops>
        <name>Loop_Across_Contact_Inputs</name>
        <label>Loop Across Contact Inputs</label>
        <locationX>582</locationX>
        <locationY>497</locationY>
        <collectionReference>ContactIDInput</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_Republish_OBM_Field</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>456</locationX>
        <locationY>89</locationY>
        <connector>
            <targetReference>Set_Counter_to_1</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>CalledFeaturetoApex</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>ContactIDInput</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>ContactsCounter</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <waits>
        <name>Pause_for_1_hour</name>
        <label>Pause for 1 hour</label>
        <locationX>1061</locationX>
        <locationY>460</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <name>X1_hour_paused</name>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>Set_Counter_to_1_0</targetReference>
            </connector>
            <eventType>AlarmEvent</eventType>
            <inputParameters>
                <name>AlarmTime</name>
                <value>
                    <elementReference>$Flow.CurrentDateTime</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffset</name>
                <value>
                    <numberValue>1.0</numberValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffsetUnit</name>
                <value>
                    <stringValue>Hours</stringValue>
                </value>
            </inputParameters>
            <label>1 hour paused</label>
        </waitEvents>
    </waits>
</Flow>
