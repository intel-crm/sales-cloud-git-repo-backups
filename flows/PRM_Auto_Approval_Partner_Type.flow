    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR
(AND( ISCHANGED([PRM_Registration_Request__c].RecordType.DeveloperName) ,
[PRM_Registration_Request__c].RecordType.DeveloperName = &apos;Account_Create_Request&apos;),

AND(ISNEW(),
([PRM_Registration_Request__c].RecordType.DeveloperName = &apos;Account_Create_Request&apos;)
) )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>OR
(AND( ISCHANGED({!myVariable_current.RecordType.DeveloperName}) ,
{!myVariable_current.RecordType.DeveloperName} = &apos;Account_Create_Request&apos;),

AND(ISNEW(),
({!myVariable_current.RecordType.DeveloperName} = &apos;Account_Create_Request&apos;)
) )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND([PRM_Registration_Request__c].PRM_Auto_Approve__c = TRUE,
[PRM_Registration_Request__c].PRM_Channel_Program_Level_txt__c &lt;&gt; &quot;PSG&quot;, (ISBLANK([PRM_Registration_Request__c].Entitlement_Details__c)))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_4</name>
        <dataType>Boolean</dataType>
        <expression>AND({!myVariable_current.PRM_Auto_Approve__c} = TRUE,
{!myVariable_current.PRM_Channel_Program_Level_txt__c} &lt;&gt; &quot;PSG&quot;, (ISBLANK({!myVariable_current.Entitlement_Details__c})))</expression>
    </formulas>
