<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the Core IPS RDC Provisioned User Activation Email Notification process using Check for Active External User with RDC priviledge criteria.
This process is configured to send automated email notification to RDC Support Team when an external user is activated with RDC Privileged access for IPS enabled contact.</description>
    <environments>Default</environments>
    <label>Core IPS RDC Provisioned User Activation Email Notification_1</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>330</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>myRule_1_A1</targetReference>
        </connector>
        <filterFormula>AND
(
     {!$Record.IsActive} = True ,
     OR(
          ISNEW() ,
          ISCHANGED({!$Record.IsActive})
          ) ,
     {!$Record.Profile.Name}= {!$Label.Core_IPS_Profile_Name} ,
     NOT(ISBLANK({!$Record.ContactId})) ,
     NOT(ISBLANK({!$Record.Core_Login_Id__c})) ,
     {!$Record.LastModifiedBy.FirstName} = &apos;AGS&apos;,
     {!$Record.LastModifiedBy.LastName} = &apos;API&apos;
)</filterFormula>
        <object>User</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>myRule_1_A1</name>
        <label>email Notification to RDC Support Team</label>
        <locationX>456</locationX>
        <locationY>371</locationY>
        <flowName>Core_IPS_flow_RDC_UserActivation_Email</flowName>
        <inputAssignments>
            <name>varUserName</name>
            <value>
                <elementReference>$Record.Username</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
