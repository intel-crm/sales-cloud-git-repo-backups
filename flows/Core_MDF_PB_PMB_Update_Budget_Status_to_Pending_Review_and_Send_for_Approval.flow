    <description>This process Builder will update Budget Status to Pending review on Budget Creation and Budget Update. After Status update, it will send the Budget for Approval.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (
ISNEW(),
OR(
[PartnerMarketingBudget].RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,
[PartnerMarketingBudget].RecordType.DeveloperName =
$Label.Core_MDF_Retail_Record_Type_Developer_Name )
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND (
ISNEW(),
OR(
{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name},
{!myVariable_current.RecordType.DeveloperName} =
{!$Label.Core_MDF_Retail_Record_Type_Developer_Name} )
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (
NOT($Permission.Core_MDF_FinanceManager ),
NOT(ISNEW()),
OR( 
	ISCHANGED([PartnerMarketingBudget].StartDate) 
	,ISCHANGED([PartnerMarketingBudget].EndDate) 
	,ISCHANGED([PartnerMarketingBudget].Amount)
	,AND(
		ISCHANGED([PartnerMarketingBudget].Core_MDF_Decrease_Budget_Amount_Amt__c ),
		(IF((ISPICKVAL([PartnerMarketingBudget].Core_MDF_Budget_Status__c, &quot;Rejected&quot;)),true, (([PartnerMarketingBudget].Core_MDF_Decrease_Budget_Amount_Amt__c ) &gt; 0)))
	)
    ),
OR(
[PartnerMarketingBudget].RecordType.DeveloperName = $Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name,
[PartnerMarketingBudget].RecordType.DeveloperName = $Label.Core_MDF_Retail_Record_Type_Developer_Name ) 
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND (
NOT({!$Permission.Core_MDF_FinanceManager} ),
NOT(ISNEW()),
OR( 
	ISCHANGED({!myVariable_current.StartDate}) 
	,ISCHANGED({!myVariable_current.EndDate}) 
	,ISCHANGED({!myVariable_current.Amount})
	,AND(
		ISCHANGED({!myVariable_current.Core_MDF_Decrease_Budget_Amount_Amt__c} ),
		(IF((ISPICKVAL({!myVariable_current.Core_MDF_Budget_Status__c}, &quot;Rejected&quot;)),true, (({!myVariable_current.Core_MDF_Decrease_Budget_Amount_Amt__c} ) &gt; 0)))
	)
    ),
OR(
{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name},
{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_Retail_Record_Type_Developer_Name} ) 
)</expression>
    </formulas>
    <interviewLabel>Core_MDF_PB_PMB_Update_Budget_Status_to_Pending_Review_and_Send_for_Approval-27_InterviewLabel</interviewLabel>
