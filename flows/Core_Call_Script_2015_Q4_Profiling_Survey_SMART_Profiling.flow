    <decisions>
        <name>Branded_System2</name>
        <label>Branded System?</label>
        <locationX>226</locationX>
        <locationY>153</locationY>
        <defaultConnector>
            <targetReference>Integration_DIY2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Yes_Branded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Which_type_of_products_are_you_selling_today</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Branded_System</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Branded_Systems</targetReference>
            </connector>
            <label>Yes Branded</label>
        </rules>
    </decisions>
    <decisions>
        <name>Embedded2</name>
        <label>Embedded?</label>
        <locationX>234</locationX>
        <locationY>362</locationY>
        <defaultConnector>
            <targetReference>Not_willing_able_to_share_profile</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Embedded</defaultConnectorLabel>
        <rules>
            <name>Yes_Embedded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Which_type_of_products_are_you_selling_today</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Embedded</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Embedded3</targetReference>
            </connector>
            <label>Yes Embedded</label>
        </rules>
    </decisions>
    <decisions>
        <name>Integration_DIY2</name>
        <label>Integration (DIY)?</label>
        <locationX>230</locationX>
        <locationY>255</locationY>
        <defaultConnector>
            <targetReference>Embedded2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Integration (DIY)</defaultConnectorLabel>
        <rules>
            <name>Yes_Integration_DIY</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Which_type_of_products_are_you_selling_today</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Integration_DIY</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Integration_DIY3</targetReference>
            </connector>
            <label>Yes Integration (DIY)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Not_willing_able_to_share_profile</name>
        <label>Not willing/able to share/profile</label>
        <locationX>239</locationX>
        <locationY>466</locationY>
        <defaultConnector>
            <targetReference>Call_Script_Complete</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No (no to not willing)</defaultConnectorLabel>
        <rules>
            <name>Yes_to_not_willing</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Which_type_of_products_are_you_selling_today</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Not_willing_to_share</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Which_type_of_products_are_you_selling_today</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Not_able_to_profile</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Not_willing_to_share_or_not_able_to_profile</targetReference>
            </connector>
            <label>Yes (to not willing)</label>
        </rules>
    </decisions>
    <interviewLabel>Call Script 2015 Q4 Profiling/Survey - SMART Profiling {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Call Script 2015 Q4 Profiling/Survey - SMART Profiling</label>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Save_Branded_Response</name>
        <label>Save Branded Response</label>
        <locationX>691</locationX>
        <locationY>150</locationY>
        <connector>
            <targetReference>Integration_DIY2</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>callScriptResponseId</elementReference>
            </value>
