    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>ISPICKVAL([Campaign].Core_MDF_Program__c , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
(ISCHANGED([Campaign].Core_MDF_Approval_Step_Counter_nbr__c ) &amp;&amp;
([Campaign].Core_MDF_Approval_Step_Counter_nbr__c == 1) ||
([Campaign].Core_MDF_Approval_Step_Counter_nbr__c == 0 &amp;&amp;
ISPICKVAL([Campaign].Status , &apos;Revision Required&apos;) &amp;&amp;
PRIORVALUE([Campaign].Core_MDF_Approval_Step_Counter_nbr__c) ==0 ))
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_12</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!myVariable_current.Core_MDF_Program__c} , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
(ISCHANGED({!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c} ) &amp;&amp;
({!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c} == 1) ||
({!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c} == 0 &amp;&amp;
ISPICKVAL({!myVariable_current.Status} , &apos;Revision Required&apos;) &amp;&amp;
PRIORVALUE({!myVariable_current.Core_MDF_Approval_Step_Counter_nbr__c}) ==0 ))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>ISPICKVAL([Campaign].Core_MDF_Program__c , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
ISCHANGED([Campaign].Status) &amp;&amp;
ISPICKVAL([Campaign].Status ,  &apos;Revision Required&apos;) &amp;&amp;
(TEXT(PRIORVALUE([Campaign].Status)) = &quot;Pending Review&quot; ||
TEXT(PRIORVALUE([Campaign].Status)) = &quot;Pending Approval&quot;)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_26</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!myVariable_current.Core_MDF_Program__c} , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
ISCHANGED({!myVariable_current.Status}) &amp;&amp;
ISPICKVAL({!myVariable_current.Status} ,  &apos;Revision Required&apos;) &amp;&amp;
(TEXT(PRIORVALUE({!myVariable_current.Status})) = &quot;Pending Review&quot; ||
TEXT(PRIORVALUE({!myVariable_current.Status})) = &quot;Pending Approval&quot;)</expression>
    </formulas>
