    <assignments>
        <description>Increment counter by 1</description>
        <name>Counter_1</name>
        <label>Counter+1</label>
        <locationX>990</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>CountOfClicks</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Fetch_Project_Info_before_enqueuing.DP_EAT_TestRunButtonCount__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CountOfClicks</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
