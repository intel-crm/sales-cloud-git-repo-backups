    <recordUpdates>
        <name>UpdateTestCountOnClick</name>
        <label>UpdateTestCountOnClick</label>
        <locationX>990</locationX>
        <locationY>398</locationY>
        <connector>
            <targetReference>If_Status_is_Not_Queued</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
