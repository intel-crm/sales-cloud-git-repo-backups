    <textTemplates>
        <name>emailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Hi,

The execution of selected test classes for {!Fetch_Project_Info_record.Name} is completed. Please visit the below Reports for detailed results:-

https://intel--crmdevsls3.lightning.force.com/lightning/r/Report/00O2D000000XlEEUA0/view?queryScope=userFolders&amp;fv0={!ProjectNameFilterValue}

https://intel--crmdevsls3.lightning.force.com/lightning/r/Report/00O2D000000XlEDUA0/view?queryScope=userFolders&amp;fv0={!ProjectNameFilterValue}</text>
    </textTemplates>
    <textTemplates>
