    <waits>
        <name>Time_Delay</name>
        <label>Time Delay</label>
        <locationX>611</locationX>
        <locationY>758</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <name>After_time_delay</name>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>Assign_log_results_params</targetReference>
            </connector>
            <eventType>AlarmEvent</eventType>
            <inputParameters>
                <name>AlarmTime</name>
                <value>
                    <elementReference>dateTimeafterXMinutes</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffset</name>
                <value>
                    <numberValue>0.0</numberValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffsetUnit</name>
                <value>
                    <stringValue>Hours</stringValue>
                </value>
            </inputParameters>
            <label>After time delay</label>
        </waitEvents>
    </waits>
</Flow>
