        <name>thankYouLabelTextTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;b style=&quot;font-size: 14.6667px;&quot;&gt;Thank you for completing our Quick Check Questionnaire!&amp;nbsp;Please check your email for a link to a more detailed Assessment.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;font-size: 14.6667px;&quot;&gt;In parallel, we will verify your solution architecture diagram and customer success story’s alignment to our key program criteria.&amp;nbsp;Within the next three business days, we will reach out to communicate any gaps.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;font-size: 14.6667px;&quot;&gt;Upon successful completion of the Assessment, we will have a live conversation with Intel industry representatives to conduct a final review.&lt;/b&gt;&lt;b style=&quot;font-size: 14.6667px; font-family: Arial, sans-serif;&quot;&gt;&lt;span class=&quot;ql-cursor&quot;&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>welcome_question_dref_tt</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>Submit Your Solution</text>
    </textTemplates>
    <textTemplates>
        <name>welcome_question_lref_tt</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;h1 style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Intel® IoT Market Ready Solutions (Intel® IMRS)&lt;span class=&quot;ql-cursor&quot;&gt;&lt;/span&gt;&lt;/b&gt;&lt;/h1&gt;</text>
    </textTemplates>
