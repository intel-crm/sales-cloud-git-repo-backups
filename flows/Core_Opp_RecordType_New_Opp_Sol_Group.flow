<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>NewOpportunity</name>
        <dataType>String</dataType>
        <value>
            <stringValue>012o0000000Gn16AAC</stringValue>
        </value>
    </constants>
    <constants>
        <name>NewSolutionGroup</name>
        <dataType>String</dataType>
        <value>
            <stringValue>012o0000000Gn17AAC</stringValue>
        </value>
    </constants>
    <constants>
        <name>Opportunity</name>
        <dataType>String</dataType>
        <value>
            <stringValue>012o0000000Gn18AAC</stringValue>
        </value>
    </constants>
    <constants>
        <name>SolutionGroup</name>
        <dataType>String</dataType>
        <value>
            <stringValue>012o0000000Gn19AAC</stringValue>
        </value>
    </constants>
    <decisions>
        <description>switch between new opportunity and new solution group</description>
        <name>Based_on_RecordType</name>
        <label>Based on RecordType</label>
        <locationX>576</locationX>
        <locationY>338</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_New_Solution_Group</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>NewSolutionGroup</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_to_Solution_Group</targetReference>
            </connector>
            <label>is New Solution Group?</label>
        </rules>
        <rules>
            <name>is_New_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>NewOpportunity</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_to_Opportunity</targetReference>
            </connector>
            <label>is New Opportunity?</label>
        </rules>
    </decisions>
    <description>To convert New Opportunity and New Solution Group to Opportunity and Solution Group instead.</description>
    <environments>Default</environments>
    <interviewLabel>Core Opp RecordType New Opp &amp; Sol. Group {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core Opp RecordType New Opp &amp; Sol. Group</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_to_Opportunity</name>
        <label>Update to Opportunity</label>
        <locationX>387</locationX>
        <locationY>408</locationY>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Opportunity</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_to_Solution_Group</name>
        <label>Update to Solution Group</label>
        <locationX>795</locationX>
        <locationY>408</locationY>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>SolutionGroup</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>457</locationX>
        <locationY>46</locationY>
        <connector>
            <targetReference>Based_on_RecordType</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012o0000000Gn17AAC</stringValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012o0000000Gn16AAC</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
