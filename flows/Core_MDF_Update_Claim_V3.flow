    <decisions>
        <name>checkCaseStatus</name>
        <label>checkCaseStatus</label>
        <locationX>1187</locationX>
        <locationY>79</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>ReviewCompleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Review Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Adjustment_Amount</targetReference>
            </connector>
            <label>Review Completed</label>
        </rules>
        <rules>
            <name>PICReviewCompleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PIC Review Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assignReleaseHoldValues</targetReference>
            </connector>
            <label>PIC Review Completed</label>
        </rules>
        <rules>
            <name>NonCompliantDenied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Review Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>PIC Review Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Claim_Status_as_Denied</targetReference>
            </connector>
            <label>NonCompliantDenied</label>
        </rules>
    </decisions>
