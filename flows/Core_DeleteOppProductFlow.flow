<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>OLI will get deleted after 15 mins to reduce the number of bad rows in KPI Process</description>
    <environments>Default</environments>
    <interviewLabel>Core_DeleteOppProductFlow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_DeleteOppProductFlow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>deleteProd</name>
        <label>deleteProd</label>
        <locationX>778</locationX>
        <locationY>444</locationY>
        <inputReference>$Record</inputReference>
    </recordDeletes>
    <start>
        <locationX>650</locationX>
        <locationY>48</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Delete In Progress (&lt;15 min)</stringValue>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>deleteProduct</name>
            <connector>
                <targetReference>deleteProd</targetReference>
            </connector>
            <label>deleteProduct</label>
            <maxBatchSize>10</maxBatchSize>
            <offsetNumber>15</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>LastModifiedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
