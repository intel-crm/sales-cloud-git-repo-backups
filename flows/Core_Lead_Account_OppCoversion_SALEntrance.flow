<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>C_LEAD</name>
        <dataType>String</dataType>
        <value>
            <stringValue>012o0000000Tr9EAAS</stringValue>
        </value>
    </constants>
    <constants>
        <name>C_SalesLEAD</name>
        <dataType>String</dataType>
        <value>
            <stringValue>0121J000000yaQ1QAI</stringValue>
        </value>
    </constants>
    <decisions>
        <description>for the LEAD WF

&apos;Core_Lead_TQL_Entrance&apos;</description>
        <name>Core_Lead_SAL_Entrance</name>
        <label>Core_Lead_SAL_Entrance</label>
        <locationX>182</locationX>
        <locationY>587</locationY>
        <defaultConnector>
            <targetReference>Core_Opportunity_Conversion_Unlock</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Lead_SAL_EntranceTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>F_Core_Lead_SAL_Entrance</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FieldUpdateCore_Lead_SAL_Entrance</targetReference>
            </connector>
            <label>Core_Lead_SALL_EntranceTRUE</label>
        </rules>
    </decisions>
    <decisions>
        <description>for the LEAD WF 
&apos; Core_Lead_to_Account_Conversion__FlagUpdate &apos;</description>
        <name>Core_Lead_to_Account_Conversion_FlagUpdate</name>
        <label>Core_Lead_to_Account_Conversion__FlagUpdate</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Core_Lead_SAL_Entrance</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Lead_to_Account_Conversion_FlagUpdateTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>F_Core_Lead_to_Account_Conversion_FlagUpdate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FieldUpdateCore_Lead_to_Account_Conversion_FlagUpdate</targetReference>
            </connector>
            <label>Core_Lead_to_Account_Conversion__FlagUpdateTRUE</label>
        </rules>
    </decisions>
    <decisions>
        <description>for the LEAD WF 

&apos;Core_Opportunity_Conversion_Unlock&apos;</description>
        <name>Core_Opportunity_Conversion_Unlock</name>
        <label>Core_Opportunity_Conversion_Unlock</label>
        <locationX>182</locationX>
        <locationY>887</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Opportunity_Conversion_UnlockTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>F_Core_Opportunity_Conversion_Unlock</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FieldUpdateCore_Opportunity_Conversion_Unlock</targetReference>
            </connector>
            <label>Core_Opportunity_Conversion_UnlockTRUE</label>
        </rules>
    </decisions>
    <description>For the LEAD WFs

&apos;Core_Lead_to_Account_Conversion__FlagUpdate&apos;
&apos;Core_Lead_TQL_Entrance&apos;  Now  SAL Entrance after Removal of TAL and TQL
&apos;Core_Opportunity_Conversion_Unlock&apos;
&apos;Core_Reject_flag_update&apos; --- removing this consition due to fast field update in flow and moving to new flow</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Reject_flag_updateCondition</name>
        <dataType>Boolean</dataType>
        <expression>AND(
OR({!$Record.RecordType.Name} = &quot;Sales Lead&quot;,{!$Record.RecordType.Name}=&quot;Lead&quot;),
ISPICKVAL({!$Record.Core_Lead_State__c}, &apos;In Pursuit&apos;),
ISPICKVAL({!$Record__Prior.Core_Lead_State__c}, &apos;Terminated&apos;),
NOT(ISPICKVAL({!$Record__Prior.Core_Lead_Status__c}, &apos;Unreachable&apos;)),
ISCHANGED({!$Record.Core_Lead_State__c})
)</expression>
    </formulas>
    <formulas>
        <description>for the Lead WF 
&apos;Core_Lead_TQL_Entrance&apos;   Now  SAL after removal of TAL TQL</description>
        <name>F_Core_Lead_SAL_Entrance</name>
        <dataType>Boolean</dataType>
        <expression>AND (  OR(ISPICKVAL(PRIORVALUE({!$Record.Status}), &quot;Marketing Qualified Lead&quot;),ISPICKVAL(PRIORVALUE({!$Record.Status}), &quot;Sales Generated Lead&quot;)),  ISPICKVAL({!$Record.Status}, &quot;Sales Accepted Lead&quot;), 
{!$Record.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;, ISCHANGED({!$Record.Status} ), OR( ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;Accepted&quot;), ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;Qualified&quot;) )  )</expression>
    </formulas>
    <formulas>
        <name>F_Core_Lead_to_Account_Conversion_FlagUpdate</name>
        <dataType>Boolean</dataType>
        <expression>OR( AND( OR({!$Record.RecordType.Name} = &quot;Sales Lead&quot;,{!$Record.RecordType.Name}=&quot;Lead&quot;), ISPICKVAL({!$Record.Status}, &quot;Sales Accepted Lead&quot;) ), AND( {!$Record.RecordType.Name}=&quot;Partner Lead&quot;  ) )</expression>
    </formulas>
    <formulas>
        <description>for the LEAD WF

&apos; Core_Opportunity_Conversion_Unlock &apos;</description>
        <name>F_Core_Opportunity_Conversion_Unlock</name>
        <dataType>Boolean</dataType>
        <expression>AND(   {!$Record.RecordType.DeveloperName} &lt;&gt; &apos;Partner_Lead&apos;,  
OR(   ISCHANGED({!$Record.Status}),   ISCHANGED({!$Record.Core_Lead_Status__c})  ),
OR(  ISPICKVAL({!$Record.Status}, &apos;Sales Accepted Lead&apos;),ISPICKVAL({!$Record.Status}, &apos;Marketing Qualified Lead&apos;),ISPICKVAL({!$Record.Status}, &apos;Sales Generated Lead&apos;)),  
ISPICKVAL({!$Record.Core_Lead_Status__c}, &apos;Accepted&apos;),  ISPICKVAL(PRIORVALUE({!$Record.Core_Lead_Status__c}), &apos;Disqualified&apos;) )</expression>
    </formulas>
    <interviewLabel>Core_Lead_Account/OppCoversion_TQLEntrance_RejectFlagUpdate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Lead_Account/OppCoversion_SALEntrance_RejectFlagUpdate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>FieldUpdateCore_Lead_SAL_Entrance</name>
        <label>FieldUpdateCore_Lead_SAL_Entrance</label>
        <locationX>50</locationX>
        <locationY>695</locationY>
        <connector>
            <targetReference>Core_Opportunity_Conversion_Unlock</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Entrance_Date_SAL__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Exit_Date_MAQL__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>FieldUpdateCore_Lead_to_Account_Conversion_FlagUpdate</name>
        <label>FieldUpdateCore_Lead_to_Account_Conversion__FlagUpdate</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <connector>
            <targetReference>Core_Lead_SAL_Entrance</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Lead_Conversion_Flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>FieldUpdateCore_Opportunity_Conversion_Unlock</name>
        <label>FieldUpdateCore_Opportunity_Conversion_Unlock</label>
        <locationX>50</locationX>
        <locationY>995</locationY>
        <inputAssignments>
            <field>Core_Lead_to_Opportunity_Conversion_flag__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_Lead_to_Account_Conversion_FlagUpdate</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.Status}) || ISCHANGED({!$Record.Core_Lead_Status__c}) || ISCHANGED({!$Record.Core_Lead_State__c})</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
