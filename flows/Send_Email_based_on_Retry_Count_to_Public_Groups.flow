    <description>Sends email alert to the public groups upon failure of case outbound for 3 times</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND( ISCHANGED([Core_IPS_BES_Error_Log__c].Core_IPS_Retry_Count__c), [Core_IPS_BES_Error_Log__c].Core_IPS_Retry_Count__c &gt;= 3 )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISCHANGED({!myVariable_current.Core_IPS_Retry_Count__c}), {!myVariable_current.Core_IPS_Retry_Count__c} &gt;= 3 )</expression>
    </formulas>
