    <description>Migrated from the Core_UpdateContactOwnertoInquiryOwnerOnChange process using multiple criteria.
Updates the inquiry owner to contact owner when contact owner changes</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_1_myRule_4_A1_1019303959</name>
        <dataType>String</dataType>
        <expression>Text({!$Record.Salutation}) +&quot; &quot;+ {!$Record.FirstName} +&quot; &quot;+ {!$Record.LastName }</expression>
    </formulas>
