    <processType>EvaluationFlow</processType>
    <recordLookups>
        <name>Get_Contact_Entitlement</name>
        <label>Get Contact Entitlement</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Checks_if_Entitlement_is_Complete</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Contact_Id__c</field>
            <operator>EqualTo</operator>
            <value>
