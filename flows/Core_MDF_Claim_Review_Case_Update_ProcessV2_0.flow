{!myVariable_current.Core_MDF_Claim_Submitter__r.IsActive} = True,
{!myVariable_current.Core_MDF_Channel_Program_txt__c} == {!$Label.Core_MDF_IPA_Program_Name}
)</expression>
    </formulas>
