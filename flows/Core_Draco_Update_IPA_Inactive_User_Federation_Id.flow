<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>User_Record_Check</name>
        <label>User Record Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_6</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>User_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_inactive_user_record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_inactive_user_record.Core_Federation_ID__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_Enterprise_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_User_Record</targetReference>
            </connector>
            <label>User Found</label>
        </rules>
    </decisions>
    <description>This flow is triggered when ever there is a change in enterprise Id on the contact. It updates UIOLI inactive user federation Id and username in case he IPA employee inactive contact</description>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_6</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_7</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_8</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>FaultMessage</name>
        <dataType>String</dataType>
        <expression>&apos;Flow failed for Contact &apos;+{!$Record.Email}</expression>
    </formulas>
    <formulas>
        <name>username</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_Enterprise_Id__c}+&apos;@intel.com.crm&apos;+IF({!$Label.Core_Draco_sandbox_environment}=&apos;Prod&apos;, &apos;&apos;,{!$Label.Core_Draco_sandbox_environment})</expression>
    </formulas>
    <interviewLabel>Core Draco Update IPA Inactive User Federation Id {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core Draco Update IPA Inactive User Federation Id</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Log_entry_record</name>
        <label>Create Log entry record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_7</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <elementReference>FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>Flow Core Draco Update IPA Inactive User Federation Id</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$System.OriginDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_sObjectId__c</field>
            <value>
                <elementReference>$Record.Contact_ID__c</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>get_inactive_user_record</name>
        <label>get inactive user record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>User_Record_Check</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Create_Log_entry_record</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Contact_ID__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_License_Reclaimed_on_Creation__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_User_Record</name>
        <label>Update User Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_8</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_entry_record</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_WWID__c</field>
            <value>
                <elementReference>$Record.Core_Enterprise_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FederationIdentifier</field>
            <value>
                <elementReference>$Record.Core_Enterprise_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Username</field>
            <value>
                <elementReference>username</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Users</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_5</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Enterprise_Id__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Enterprise_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>get_inactive_user_record</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
