    <assignments>
        <description>Assigning to PFA Share Record</description>
        <name>Core_MDF_Add_it_to_PFAShare_Record</name>
        <label>Add it to PFAShare Record</label>
        <locationX>41</locationX>
        <locationY>238</locationY>
        <assignmentItems>
            <assignToReference>PFAShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PFAId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PFAShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PGMRec.Core_MDF_Group_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PFAShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Add_sPFAShareTemp_to_sCollPFAShareToBeInserted</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Adding PFA Share Record to PFA Share List</description>
        <name>Core_MDF_Add_sPFAShareTemp_to_sCollPFAShareToBeInserted</name>
        <label>Add sPFAShareTemp to sCollPFAShareToBeInserted</label>
        <locationX>45</locationX>
        <locationY>401</locationY>
        <assignmentItems>
            <assignToReference>CollPFAShareToBeInserted</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>PFAShareTemp</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Make_the_PFAShare_Record_as_Blank</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Making PFA Share List Empty</description>
        <name>Core_MDF_Make_the_PFAShare_Record_as_Blank</name>
        <label>Make the PFAShare Record as Blank</label>
        <locationX>186</locationX>
        <locationY>402</locationY>
        <assignmentItems>
            <assignToReference>PFAShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PFAShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PFAShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_through_sCollPGMList</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>If List is Not Null</description>
        <name>Core_MDF_Check_if_sCollPFAShareToBeInserted_has_values</name>
        <label>Check if sCollPFAShareToBeInserted has values</label>
        <locationX>380</locationX>
        <locationY>222</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>sCollPFAShareToBeInserted_is_NOT_EMPTY</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CollPFAShareToBeInserted</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Insert_sCollPFAShareToBeInserted</targetReference>
            </connector>
            <label>sCollPFAShareToBeInserted is NOT EMPTY</label>
        </rules>
    </decisions>
    <decisions>
        <description>If List Is Not Null</description>
        <name>Core_MDF_Check_if_sCollPGMList_is_NOT_NULL</name>
        <label>Check if sCollPGMList is NOT NULL</label>
        <locationX>182</locationX>
        <locationY>52</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_sCollPGMList_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CollPGMList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Loop_through_sCollPGMList</targetReference>
            </connector>
            <label>sCollPGMList is NOT NULL</label>
        </rules>
    </decisions>
    <interviewLabel>PFA SubFlow Iterator {!$Flow.CurrentDateTime}</interviewLabel>
