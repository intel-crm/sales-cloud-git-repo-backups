<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>AssignByPassVariable</name>
        <label>AssignByPassVariable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>IsBypassUser</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CheckIfUserProfileCanBeBypassed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>ValidRecordTypeCheck</name>
        <label>ValidRecordType</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>IsValidRecordType</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ValidRecordType</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <description>Error Message : &apos;&apos;</description>
        <name>Copy_2_of_ErrorIntelCovered</name>
        <label>Copy 2 of ErrorIntelCovered</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>If Account Primary Coverage is Intel Covered and SalesGroup is other than Partner Led, Account level must be Level 1/2/3.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Custom_Error_Message_5</name>
        <label>Custom Error Message 5</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>If Account Primary Coverage is Intel Covered and SalesGroup is %Partner Led%, Account level can be No Level</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>ErrorIndirectCovered</name>
        <label>ErrorIndirectCovered</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>If account primary coverage is Indirect covered, account level must be &apos;Level3&apos;</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>ErrorIsNot_NotCoveredNoLevel</name>
        <label>ErrorIsNot_NotCoveredNoLevel</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Account Owner &apos;Uncovered account&apos; ,Primary Coverage can only be Not Covered &amp; Account Level can only be No Level</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>ErrorNoLevel</name>
        <label>ErrorNoLevel</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>If account primary coverage is Not covered, account level must be No Level</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description>Channels for Account Primary Coverage - Intel Covered, Indirect Covered, Not Covered</description>
        <name>Account_Primary_Coverage</name>
        <label>Account Primary Coverage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ItsIntelCovered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Account_Primary_Coverage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Covered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CoreSalesGroupDecisionIntelCovered</targetReference>
            </connector>
            <label>ItsIntelCovered</label>
        </rules>
        <rules>
            <name>ItsIndirectCovered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Account_Primary_Coverage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Indirect Covered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsLevel3</targetReference>
            </connector>
            <label>ItsIndirectCovered</label>
        </rules>
        <rules>
            <name>ItsNotCovered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Account_Primary_Coverage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not Covered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NoLevelAccount</targetReference>
            </connector>
            <label>ItsNotCovered</label>
        </rules>
    </decisions>
    <decisions>
        <name>ByPassUser</name>
        <label>ByPassUser</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>Dont_byPass_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsBypassUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsAccountOwnerUncovered</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkifRecordTypeisValid</name>
        <label>checkifRecordTypeisValid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>ValidRecordType</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckRecordType</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ValidRecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.RecordType.DeveloperName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ValidRecordTypeCheck</targetReference>
            </connector>
            <label>CheckRecordType</label>
        </rules>
    </decisions>
    <decisions>
        <name>CoreSalesGroupDecisionIntelCovered</name>
        <label>CoreSalesGroupDecisionIntelCovered</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsPartnerLed</name>
            <conditionLogic>1 AND 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Sales_Groups__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Partner Led</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Account_Level__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>NoLevel</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Custom_Error_Message_5</targetReference>
            </connector>
            <label>IsPartnerLed</label>
        </rules>
        <rules>
            <name>IsNotPartnerLed</name>
            <conditionLogic>(NOT(1)) AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Sales_Groups__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Partner Led</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Account_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NoLevel</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Account_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_ErrorIntelCovered</targetReference>
            </connector>
            <label>IsNotPartnerLed</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsAccountOwnerUncovered</name>
        <label>IsAccountOwnerUncovered</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Account_Primary_Coverage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsUncovered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner.FirstName</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Uncovered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsNotCovered</targetReference>
            </connector>
            <label>IsUncovered</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsByPassUserCheck</name>
        <label>IsByPassUser</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CheckIfUserProfileCanBeBypassed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsByPassUserTrue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckIfUserProfileCanBeBypassed.SetupOwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>runninguserprofileid</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignByPassVariable</targetReference>
            </connector>
            <label>IsByPassUser</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsLevel3</name>
        <label>IsLevel3</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AccLevel3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Account_Level__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Level3</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ErrorIndirectCovered</targetReference>
            </connector>
            <label>AccLevel3</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsNotCovered</name>
        <label>IsNotCoveredNoLevel</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsNotCoveredNoLevel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Account_Primary_Coverage__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Not Covered</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Account_Level__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>NoLevel</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ErrorIsNot_NotCoveredNoLevel</targetReference>
            </connector>
            <label>IsNotCoveredNoLevel</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsValidRecordTypeToProceed</name>
        <label>IsValidRecordTypeToProceed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ValidToProceed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsValidRecordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Account_Bypass_Validation_Rule</targetReference>
            </connector>
            <label>ValidToProceed</label>
        </rules>
    </decisions>
    <decisions>
        <name>NoLevelAccount</name>
        <label>NoLevelAccount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AccountNoLevel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Account_Level__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>NoLevel</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ErrorNoLevel</targetReference>
            </connector>
            <label>AccountNoLevel</label>
        </rules>
    </decisions>
    <description>Flow to Validate account Levels and primary coverage validations
-Added entry conditions for only fields for which error to be generated,</description>
    <environments>Default</environments>
    <formulas>
        <name>runninguserprofileid</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!$Profile.Id})</expression>
    </formulas>
    <interviewLabel>Core_Account_Primary_Coverage_And_Levels_Validations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Account_Primary_Coverage_And_Levels_Validations</label>
    <loops>
        <name>CheckIfUserProfileCanBeBypassed</name>
        <label>CheckIfUserProfileCanBeBypassed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Core_Account_Bypass_Validation_Rule</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>IsByPassUserCheck</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>ByPassUser</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>ValidRecordType</name>
        <label>ValidRecordType</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetRecordTypes</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>checkifRecordTypeisValid</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>IsValidRecordTypeToProceed</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Core_Account_Bypass_Validation_Rule</name>
        <label>Core Account Bypass Validation Rule</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CheckIfUserProfileCanBeBypassed</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>ByPass__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Bypass_Flow__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Account_Bypass_Validation_Rule__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetRecordTypes</name>
        <label>GetRecordTypes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>ValidRecordType</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4 OR 5)</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Mastered_Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Requested_Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Rejected_Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Inactive_Account</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetRecordTypes</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Core_Account_Primary_Coverage__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Level__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Sales_Groups__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Owner__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>IsBypassUser</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>IsValidRecordType</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
