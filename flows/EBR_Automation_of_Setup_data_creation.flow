        <locationX>578</locationX>
        <locationY>1487</locationY>
        <defaultConnector>
            <targetReference>Activate_Ent_Matrix_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Inactive Ent Matrix</defaultConnectorLabel>
        <rules>
            <name>Active_Ent_Matrix_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Entitlement_Matrix_Records.PRM_IsActive_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Active Ent Matrix Record</label>
        </rules>
    </decisions>
