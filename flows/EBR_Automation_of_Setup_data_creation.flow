<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Verify_BT_Record</name>
        <label>Verify BT Record</label>
        <locationX>1502</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Create_Business_Type_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>BT Not Found</defaultConnectorLabel>
        <rules>
            <name>BT_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>createdBT</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Verify_BT_Record_Status</targetReference>
            </connector>
            <label>BT Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_BT_Record_Status</name>
        <label>Verify BT Record Status</label>
        <locationX>1194</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Activate_BT_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Inactive BT</defaultConnectorLabel>
        <rules>
            <name>Active_BT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>createdBT.Is_Active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_EBR_Entitlement_RT_ID</targetReference>
            </connector>
            <label>Active BT</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_BT_Records</name>
        <label>Verify BT Records</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Create_Business_Type_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>BT Records Not Found</defaultConnectorLabel>
        <rules>
            <name>BT_Records_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>createdBT</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Existing_BT_Code_and_Name</targetReference>
            </connector>
            <label>BT Records Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Business_Type_Record</name>
        <label>Verify Business Type Record</label>
        <locationX>908</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Get_BT_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Create New BT Record</defaultConnectorLabel>
        <rules>
            <name>Existing_BT_Name_and_Code</name>
            <conditionLogic>(1 OR 4) AND (2 AND 3 AND 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Business_Types_Code__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Business_Types_Code__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Business_Types_Code__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_BT_Code_And_Name</targetReference>
            </connector>
            <label>Existing BT Name and Code</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Ent_Matrix_Record_status</name>
