    <decisions>
        <name>Verify_ALA_Association</name>
        <label>Verify ALA Association</label>
        <locationX>440</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>Loop_Partner_Agreements</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>ALA Not Exist</defaultConnectorLabel>
        <rules>
            <name>ALA_Already_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_AccountLegalAgreementAssociation</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_though_ALA_Association</targetReference>
            </connector>
            <label>ALA Already Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_LA</name>
        <label>Verify LA</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Get_Partner_Agreement_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>LA_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RegistrationRequestLAs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Get_single_LA</targetReference>
            </connector>
            <label>LA Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_LA_and_ALA</name>
        <label>Verify LA and ALA</label>
        <locationX>616</locationX>
        <locationY>1790</locationY>
        <defaultConnector>
            <targetReference>Assign_ALA_Variables</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>LA_and_ALA_matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ALA_List</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Partner_Agreements</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Partner_Agreements</targetReference>
            </connector>
            <label>LA and ALA matches</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>singleLA</name>
        <dataType>String</dataType>
        <expression>TRIM(                                                                                                         
SUBSTITUTE(
LEFT( {!RegistrationRequestLAs} , FIND(&quot;;&quot;,  {!RegistrationRequestLAs} )),
&quot;;&quot;,                                                                                          
&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>Updated_RegistrationRequest_LAs</name>
        <dataType>String</dataType>
        <expression>MID({!RegistrationRequestLAs},FIND(&quot;;&quot;,
{!RegistrationRequestLAs})+1,LEN({!RegistrationRequestLAs})-
LEN(LEFT({!RegistrationRequestLAs}, FIND(&quot;;&quot;,{!RegistrationRequestLAs})))+1)</expression>
    </formulas>
    <interviewLabel>ER_Account legalAgreement Association {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ER_Account legalAgreement Association</label>
