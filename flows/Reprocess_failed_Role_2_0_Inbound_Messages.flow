<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Reprocess_Apex_Method</name>
        <label>Reprocess Apex Method</label>
        <locationX>670</locationX>
        <locationY>325</locationY>
        <actionName>Core_IntegrationInboundMessageAGS</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Reprocess_IsActive_Check</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>Core_IntegrationInboundMessageAGS</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Reprocess_IsActive_Check</name>
        <label>Reprocess IsActive Check</label>
        <locationX>662</locationX>
        <locationY>537</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsActive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Reprocess_IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reprocess_Pause_Element</targetReference>
            </connector>
            <label>IsActive</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Reprocess_IsActive</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Core_Role2_0_Reprocessing__c.Is_Active__c}</expression>
    </formulas>
    <formulas>
        <name>Reprocess_PauseDateTime</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} + {!Reprocess_PauseFrequency} / 1440</expression>
    </formulas>
    <formulas>
        <name>Reprocess_PauseFrequency</name>
        <dataType>Number</dataType>
        <expression>{!$Setup.Core_Role2_0_Reprocessing__c.Reprocessing_Frequency__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Reprocess failed Role 2.0 Inbound Messages {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reprocess failed Role 2.0 Inbound Messages</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>543</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Reprocess_Apex_Method</targetReference>
        </connector>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2022-07-09</startDate>
            <startTime>07:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <waits>
        <name>Reprocess_Pause_Element</name>
        <label>Reprocess Pause Element</label>
        <locationX>920</locationX>
        <locationY>432</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <name>Pause_Path</name>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>Reprocess_Apex_Method</targetReference>
            </connector>
            <eventType>AlarmEvent</eventType>
            <inputParameters>
                <name>AlarmTime</name>
                <value>
                    <elementReference>Reprocess_PauseDateTime</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffset</name>
                <value>
                    <numberValue>0.0</numberValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffsetUnit</name>
                <value>
                    <stringValue>Hours</stringValue>
                </value>
            </inputParameters>
            <label>Pause Path</label>
        </waitEvents>
    </waits>
</Flow>
