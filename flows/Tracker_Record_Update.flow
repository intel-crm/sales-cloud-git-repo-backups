    <decisions>
        <name>ACR_Inactive</name>
        <label>ACR Inactive?</label>
        <locationX>314</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Inactive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_InActive_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Tracker_Records</targetReference>
            </connector>
            <label>Inactive?</label>
        </rules>
    </decisions>
    <description>Update Tracker records to inactive</description>
    <environments>Default</environments>
    <interviewLabel>Tracker Record Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Tracker Record Update</label>
    <loops>
        <name>Iterate_over_records</name>
        <label>Iterate over records</label>
        <locationX>50</locationX>
        <locationY>575</locationY>
        <collectionReference>Get_Tracker_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>inactivate_record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
