        <rules>
            <name>QL_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_the_quantity_from_apex.isQLThere</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Results_QL</targetReference>
            </connector>
            <label>QL Present</label>
        </rules>
    </decisions>
