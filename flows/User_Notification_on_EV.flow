    <decisions>
        <name>If_No_Entitlements</name>
        <label>If No Entitlements</label>
        <locationX>959</locationX>
        <locationY>862</locationY>
        <defaultConnectorLabel>Entitlements Absent</defaultConnectorLabel>
        <rules>
            <name>Entitlements_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Entitlement_Details</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sent_EV_Completion_Mail</targetReference>
            </connector>
            <label>Entitlements Present</label>
        </rules>
    </decisions>
    <decisions>
        <description>To loop across the entitlements and check for same Requester</description>
        <name>sameRequesterCheck</name>
        <label>sameRequesterCheck</label>
        <locationX>574</locationX>
        <locationY>1079</locationY>
        <defaultConnector>
            <targetReference>Send_Email_on_EV_Completion</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Different Requester</defaultConnectorLabel>
        <rules>
            <name>Same_Requester</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>firstRecordFlag</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RequesterVariable</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>LoopAcrossEntitlements.Core_Entitlement_Requester_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Same_Requester_Assign</targetReference>
            </connector>
            <label>Same Requester</label>
        </rules>
    </decisions>
    <description>Notify the users with Entitlement details on completion of EV</description>
    <interviewLabel>User Notification on EV {!$Flow.CurrentDateTime}</interviewLabel>
    <label>User Notification on EV</label>
    <loops>
        <name>LoopAcrossEntitlements</name>
        <label>LoopAcrossEntitlements</label>
        <locationX>584</locationX>
        <locationY>868</locationY>
        <collectionReference>Get_Entitlement_Details</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>sameRequesterCheck</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>If_No_Entitlements</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the required details of the entitlements assigned to the contact that triggered the flow</description>
        <name>Get_Entitlement_Details</name>
        <label>Get Entitlement Details</label>
        <locationX>584</locationX>
        <locationY>688</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopAcrossEntitlements</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Contact_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Grant Access</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Complete</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Selected__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Contact_Entitlement__c</object>
        <sortField>Core_Entitlement_Requester_Id__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>459</locationX>
        <locationY>343</locationY>
        <connector>
            <targetReference>Get_Entitlement_Details</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_IPA_Email_Verification_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <textTemplates>
        <description>This is Email Body of the EV confirmation mail</description>
        <name>EmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear {!RequesterName},&lt;/p&gt;&lt;p&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;The contact person &lt;/i&gt;&lt;b style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;&lt;i&gt;{!$Record.FirstName} {!$Record.LastName}&lt;/i&gt;&lt;/b&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt; at &lt;/i&gt;&lt;b style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;&lt;i&gt;{!$Record.Account.Name}&lt;/i&gt;&lt;/b&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt; that you entitled with following entitlements &lt;/i&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt; background-color: rgb(255, 255, 255); color: rgb(62, 62, 60);&quot;&gt;has completed their Email Verification on &lt;/i&gt;&lt;b style=&quot;font-family: Calibri, sans-serif; font-size: 11pt; background-color: rgb(255, 255, 255); color: rgb(62, 62, 60);&quot;&gt;&lt;i&gt;{!EVDate}&lt;/i&gt;&lt;/b&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt; background-color: rgb(255, 255, 255); color: rgb(62, 62, 60);&quot;&gt;.&lt;/i&gt;&lt;/p&gt;&lt;ol&gt;&lt;b&gt;{!EntitlementNameStatus}&lt;/b&gt;&lt;/ol&gt;&lt;p&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;They should be able to use the entitlement now.&lt;/i&gt;&lt;/p&gt;&lt;p&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;(&lt;/i&gt;&lt;b style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;&lt;i&gt;Note:&lt;/i&gt;&lt;/b&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt; Above Entitlement list is indicative. Please refer the Contact record for more details.)&lt;/i&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank You!&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>EmailBodyContactOwner</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear {!$Record.Owner.FirstName},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;The contact person &lt;/i&gt;&lt;b style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;&lt;i&gt;{!$Record.FirstName} {!$Record.LastName}&lt;/i&gt;&lt;/b&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt; at &lt;/i&gt;&lt;b style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;&lt;i&gt;{!$Record.Account.Name}&lt;/i&gt;&lt;/b&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt; that you created &lt;/i&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt; background-color: rgb(255, 255, 255);&quot;&gt;has completed their Email Verification on &lt;/i&gt;&lt;b style=&quot;font-family: Calibri, sans-serif; font-size: 11pt; background-color: rgb(255, 255, 255);&quot;&gt;&lt;i&gt;{!$Record.Core_IPA_Email_Verification_Date__c}.&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;i style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;They can be assigned with the entitlements now.&lt;/i&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank You!&lt;/p&gt;</text>
    </textTemplates>
