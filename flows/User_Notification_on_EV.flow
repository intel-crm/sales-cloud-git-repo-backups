        <locationX>833</locationX>
        <locationY>1075</locationY>
        <assignmentItems>
            <assignToReference>RequesterVariable</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopAcrossEntitlements.Core_Entitlement_Requester_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>RequesterName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopAcrossEntitlements.Core_Entitlement_Requester_Id__r.FirstName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>RequesterEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopAcrossEntitlements.Core_Entitlement_Requester_Id__r.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EVDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopAcrossEntitlements.Core_Contact_Id__r.Core_IPA_Email_Verification_Date__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Concatenate_Entitlements_02</targetReference>
        </connector>
    </assignments>
    <assignments>
