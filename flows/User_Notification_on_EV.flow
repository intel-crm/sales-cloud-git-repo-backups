    <apiVersion>52.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Clear_previous_Assignment</name>
        <label>Clear previous Assignment</label>
        <locationX>833</locationX>
        <locationY>1269</locationY>
        <assignmentItems>
            <assignToReference>EntitlementNameStatus</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Different_Requester_Assign</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Concatenate_Entitlements</name>
        <label>Concatenate Entitlements</label>
        <locationX>380</locationX>
        <locationY>868</locationY>
        <assignmentItems>
            <assignToReference>EntitlementNameStatus</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>&lt;li&gt;{!singleEntitlementName} (Status: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EntitlementNameStatus</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{!singleEntitlementStatus}) &lt;/li&gt;</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopAcrossEntitlements</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Concatenate_Entitlements_02</name>
        <label>Concatenate Entitlements 02</label>
        <locationX>833</locationX>
        <locationY>938</locationY>
        <assignmentItems>
            <assignToReference>EntitlementNameStatus</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>&lt;li&gt;{!singleEntitlementName} (Status: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EntitlementNameStatus</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{!singleEntitlementStatus}) &lt;/li&gt;</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopAcrossEntitlements</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign the variable into the different requester</description>
        <name>Different_Requester_Assign</name>
