<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Deactivate_User</name>
        <label>Deactivate User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.IsActive</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Title</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_User_Coverage</name>
        <label>Update User Coverage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_User_Coverage__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Job_Title_Mappings.Field_2__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Update_User_Coverage_to_Other</name>
        <label>Update User Coverage to Other</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_User_Coverage__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Other</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>User_Coverage_To_Balnk</name>
        <label>User Coverage To Balnk</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_User_Coverage__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Title</name>
        <label>Check Title</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Title_Changed</name>
            <conditionLogic>(1 OR 2)  AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Title</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Title</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Job_Title_Mappings</targetReference>
            </connector>
            <label>Title Changed</label>
        </rules>
        <rules>
            <name>Title_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Title</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Title</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>User_Coverage_To_Balnk</targetReference>
            </connector>
            <label>Title Blank</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Title_Found_in_Mappings</name>
        <label>Check Title Found in Mappings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_User_Coverage_to_Other</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Title_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Job_Title_Mappings</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_User_Coverage</targetReference>
            </connector>
            <label>If Title Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Status_In_Denodo_Inactive</name>
        <label>Status In Denodo Inactive</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Title</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Inactive_Statuus</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status_In_Denodo__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status_In_Denodo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>INACTIVE</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Deactivate_User</targetReference>
            </connector>
            <label>Inactive Statuus</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>User Coverage Mapping And LDO {!$Flow.CurrentDateTime}</interviewLabel>
    <label>User Coverage Mapping And LDO</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Job_Title_Mappings</name>
        <label>Job Title Mappings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Title_Found_in_Mappings</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Field_1__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Title</elementReference>
            </value>
        </filters>
        <filters>
            <field>Metadata_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_User_Job_Title_Mappings__mdt</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_CustomMetadata_Object__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Status_In_Denodo_Inactive</targetReference>
        </connector>
        <filterFormula>((ISNEW() &amp;&amp; NOT(ISBLANK({!$Record.Title}))) || ISCHANGED({!$Record.Title})  || (ISCHANGED({!$Record.Core_Status_In_Denodo__c}) &amp;&amp; {!$Record.Core_Status_In_Denodo__c} = &quot;INACTIVE&quot;))</filterFormula>
        <object>User</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>ListofTitleAndUserCoverage</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
