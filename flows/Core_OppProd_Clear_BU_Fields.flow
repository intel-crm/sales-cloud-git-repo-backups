<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>check_for_OppProd_Clear_Approval_BU_Field</name>
        <label>check for OppProd_Clear_Approval_BU_Field</label>
        <locationX>519</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_OppProd_Clear_Approval_BU_Fields</name>
            <conditionLogic>(1 AND (2 OR 3 OR 4 OR 5))  OR ( 6 AND NOT(2 OR 3 OR 4))</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Approved_Quantity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateRecords</targetReference>
            </connector>
            <label>Core_OppProd_Clear_Approval_BU_Fields</label>
        </rules>
        <rules>
            <name>Core_Update_Approval_Details</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Win</stringValue>
                </rightValue>
            </conditions>
            <label>Core_Update_Approval_Details</label>
        </rules>
    </decisions>
    <description>for the WF &quot; Core_OppProd_Clear_BU_Fields &quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Approved_Date</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.Opportunity.Core_Approved_Date__c}</expression>
    </formulas>
    <formulas>
        <name>Core_Commissionable</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Opportunity.Core_Commissionable__c})</expression>
    </formulas>
    <formulas>
        <name>F_TechicalApprovedOwner</name>
        <dataType>String</dataType>
        <expression>TRIM( {!$Record.Opportunity.Core_Technical_Owner__r.FirstName} + &quot; &quot; + {!$Record.Opportunity.Core_Technical_Owner__r.LastName} )</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>OpportunityOwnerName</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.Opportunity.Owner.FirstName}+&quot;&quot;+{!$Record.Opportunity.Owner.LastName})</expression>
    </formulas>
    <formulas>
        <name>TechnicalOwnerName</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.Opportunity.Core_Technical_Owner__r.FirstName}+&quot;&quot;+{!$Record.Opportunity.Core_Technical_Owner__r.LastName})</expression>
    </formulas>
    <formulas>
        <name>TotalPrice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.UnitPrice}*{!$Record.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core_OppProd_Clear_BU_Fields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_OppProd_Clear_BU_Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>UpdateRecords</name>
        <label>UpdateRecords</label>
        <locationX>526</locationX>
        <locationY>582</locationY>
        <inputAssignments>
            <field>Core_Approved_BU_Product_Segment__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_BU_Short_Name__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>401</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>check_for_OppProd_Clear_Approval_BU_Field</targetReference>
        </connector>
        <object>OpportunityLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
