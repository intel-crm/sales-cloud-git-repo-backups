                <stringValue>Core IPS flow RDC UserActivation Email</stringValue>
            </value>
        </processMetadataValues>
        <name>myRule_1_A1</name>
        <label>email Notification to RDC Support Team</label>
        <locationX>100</locationX>
        <locationY>200</locationY>
