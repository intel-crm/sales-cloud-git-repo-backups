    <decisions>
        <name>Check_for_AF_Stage</name>
        <label>Check for AF Stage</label>
        <locationX>3564</locationX>
        <locationY>1598</locationY>
        <defaultConnector>
            <targetReference>Assign_AccountFeedback_Records_to_AFList</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Country_Manager2</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Account_Feedback.Feedback_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Country Manager</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Country_Manager_Feedback_Field</targetReference>
            </connector>
            <label>Country Manager</label>
        </rules>
        <rules>
            <name>GM2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Account_Feedback.Feedback_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>GM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_GM_Feedback_Field</targetReference>
            </connector>
            <label>GM</label>
        </rules>
        <rules>
            <name>VP2</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Account_Feedback.Feedback_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>VP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Account_Feedback.Feedback_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_VP_Feedback_Field</targetReference>
            </connector>
            <label>DR/VP</label>
        </rules>
    </decisions>
