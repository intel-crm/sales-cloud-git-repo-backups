<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Notify Partner on Failed Rebate Claims</description>
        <name>Notify_Partner_on_Failed_Rebate_Claims</name>
        <label>Notify Partner on Failed Rebate Claims</label>
        <locationX>176</locationX>
        <locationY>1055</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>SenderEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <elementReference>SenderEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Rebate Claim Template Upload Status Update1</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>GetLink</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_the_Records_to_Table</name>
        <label>Add the Records to Table</label>
        <locationX>264</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>columnTable</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>addEachFailedRec</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Each_Failed_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>closeColumnTable</name>
        <label>closeColumnTable</label>
        <locationX>176</locationX>
        <locationY>947</locationY>
        <assignmentItems>
            <assignToReference>columnTable</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>&lt;/table&gt;</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Notify_Partner_on_Failed_Rebate_Claims</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_all_Failed_Records</name>
        <label>Store all Failed Records</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>listOfAllFailedRecs</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_all_Failed_Rebate_Claim_Records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>TableColumnRebateClaim</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>TableColumnRebateClaim</name>
        <label>startColumnTable</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>columnTable</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>columnHeader</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Each_Failed_Record</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>SenderEmail</name>
        <dataType>String</dataType>
        <value>
            <stringValue>sandhya.dayananda@intel.com</stringValue>
        </value>
    </constants>
    <environments>Default</environments>
    <formulas>
        <name>addEachFailedRec</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;tr&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Each_Failed_Record.PCC_Parent_Record__r.Name}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Each_Failed_Record.PCC_Quote_Line_Number__c}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Each_Failed_Record.PCC_Product__c}+ 
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Each_Failed_Record.PCC_Quantity__c}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Each_Failed_Record.PCC_Quote_Invoice_Number__c}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Each_Failed_Record.PCC_Invoice_Date__c}+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + TEXT({!Each_Failed_Record.PCC_Status__c})+
&apos;&lt;/td&gt;&lt;td style =&quot;padding: 10px;&quot;&gt;&apos; + {!Each_Failed_Record.PCC_Error_Message__c}+
&apos;&lt;/td&gt;&lt;/tr&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>recordLinkFormual</name>
        <dataType>String</dataType>
        <expression>{!$Label.PSG_IPA_Portal_URL}&amp;&quot;/rebate-claim-stage&quot;&amp;&quot;/&quot;&amp;{!$Record.Id}</expression>
    </formulas>
    <interviewLabel>PCC_RebateClaimEmailNotification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PCC_RebateClaimEmailNotifications</label>
    <loops>
        <name>Each_Failed_Record</name>
        <label>Each Failed Record</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <collectionReference>listOfAllFailedRecs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_the_Records_to_Table</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>closeColumnTable</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_all_Failed_Rebate_Claim_Records</name>
        <label>Get all Failed Rebate Claim Records</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Store_all_Failed_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PCC_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </filters>
        <filters>
            <field>PCC_Parent_Record__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PCC_Rebate_Claim_Stage__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_all_Failed_Rebate_Claim_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PCC_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PCC_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </filters>
        <object>PCC_Rebate_Claim_Stage__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>EmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Set EmailContent = &apos;Below are the Failed Rebates. Kindly correct the data and re-upload:&amp;lt;br/&amp;gt;&amp;lt;br/&amp;gt;&apos;;&lt;/p&gt;&lt;p&gt;Set EmailContent += &apos;&amp;lt;table border=&quot;1&quot;&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;th&amp;gt;Quote Line Number&amp;lt;/th&amp;gt;&amp;lt;th&amp;gt;Product&amp;lt;/th&amp;gt;&amp;lt;th&amp;gt;Quantity&amp;lt;/th&amp;gt;&amp;lt;th&amp;gt;Error Message&amp;lt;/th&amp;gt;&amp;lt;/tr&amp;gt;&apos;;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Loop {!Get_all_Failed_Rebate_Claim_Records} {&lt;/p&gt;&lt;p&gt;&amp;nbsp;&amp;nbsp;Set EmailContent += &apos;&amp;lt;tr&amp;gt;&apos;;&lt;/p&gt;&lt;p&gt;&amp;nbsp;&amp;nbsp;Set EmailContent += &apos;&amp;lt;td&amp;gt;&apos; + {!Get_all_Failed_Rebate_Claim_Records.PCC_Quote_Line_Number__c + &apos;&amp;lt;/td&amp;gt;&apos;;&lt;/p&gt;&lt;p&gt;&amp;nbsp;&amp;nbsp;Set EmailContent += &apos;&amp;lt;td&amp;gt;&apos; + {!Get_all_Failed_Rebate_Claim_Records.PCC_Product__c + &apos;&amp;lt;/td&amp;gt;&apos;;&lt;/p&gt;&lt;p&gt;&amp;nbsp;&amp;nbsp;Set EmailContent += &apos;&amp;lt;td&amp;gt;&apos; + {!Get_all_Failed_Rebate_Claim_Records.PCC_Quantity__c + &apos;&amp;lt;/td&amp;gt;&apos;;&lt;/p&gt;&lt;p&gt;&amp;nbsp;&amp;nbsp;Set EmailContent += &apos;&amp;lt;td&amp;gt;&apos; + {!Get_all_Failed_Rebate_Claim_Records.PCC_Error_Message__c + &apos;&amp;lt;/td&amp;gt;&apos;;&lt;/p&gt;&lt;p&gt;&amp;nbsp;&amp;nbsp;Set EmailContent += &apos;&amp;lt;/tr&amp;gt;&apos;;&lt;/p&gt;&lt;p&gt;}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Set EmailContent += &apos;&amp;lt;/table&amp;gt;&amp;lt;br/&amp;gt;Team Intel&apos;;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>EmailBodyContent</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;{!columnTable}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>EmailContent</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Set EmailContent = &apos;Below are the Failed Rebates. Kindly correct the data and re-upload:&amp;lt;br/&amp;gt;&amp;lt;br/&amp;gt;&apos;; Set EmailContent += &apos;&amp;lt;table border=&quot;1&quot;&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;th&amp;gt;Quote Line Number&amp;lt;/th&amp;gt;&amp;lt;th&amp;gt;Product&amp;lt;/th&amp;gt;&amp;lt;th&amp;gt;Quantity&amp;lt;/th&amp;gt;&amp;lt;th&amp;gt;Error Message&amp;lt;/th&amp;gt;&amp;lt;/tr&amp;gt;&apos;; Set EmailContent += &apos;&amp;lt;tr&amp;gt;&apos;; Set EmailContent += &apos;&amp;lt;td&amp;gt;&apos; + {!&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;PCC_Rebate_Claim_Stage__c&lt;/span&gt;.PCC_Quote_Line_Number__c} + &apos;&amp;lt;/td&amp;gt;&apos;; Set EmailContent += &apos;&amp;lt;td&amp;gt;&apos; + {!&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;PCC_Rebate_Claim_Stage__c&lt;/span&gt;.PCC_Product__c} + &apos;&amp;lt;/td&amp;gt;&apos;; Set EmailContent += &apos;&amp;lt;td&amp;gt;&apos; + {!&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;PCC_Rebate_Claim_Stage__c&lt;/span&gt;.PCC_Quantity__c} + &apos;&amp;lt;/td&amp;gt;&apos;; Set EmailContent += &apos;&amp;lt;td&amp;gt;&apos; + {!&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;PCC_Rebate_Claim_Stage__c&lt;/span&gt;.PCC_Error_Message__c} + &apos;&amp;lt;/td&amp;gt;&apos;; Set EmailContent += &apos;&amp;lt;/tr&amp;gt;&apos;; Set EmailContent += &apos;&amp;lt;/table&amp;gt;&amp;lt;br/&amp;gt;Team Intel&apos;;{!EmailContent}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>GetLink</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;strong style=&quot;color: rgb(221, 52, 52);&quot;&gt;ACTION REQUIRED !&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Hello {!$User.FirstName},&lt;/p&gt;&lt;p&gt;Your upload of Rebate Claims Template on {!$Record.CreatedDate} has FAILED.&lt;/p&gt;&lt;p&gt;Please click here to &lt;a href=&quot;https://intel--crmdevsls3.sandbox.lightning.force.com/builder_platform_interaction/%7B!recordLinkFormual%7D&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;view&lt;/a&gt; the details&lt;/p&gt;</text>
    </textTemplates>
