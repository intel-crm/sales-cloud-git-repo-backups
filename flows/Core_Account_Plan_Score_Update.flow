    <description>Helps to update the Account Plan Score based on the number of fields entered</description>
    <environments>Default</environments>
    <formulas>
        <name>Score_flow</name>
        <dataType>Number</dataType>
        <expression>(IF(NOT(ISBLANK({!CRM_Customer_Nm_dummy})), 1, 0)/2)*10</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Account Plan Score Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Plan Score Update</label>
