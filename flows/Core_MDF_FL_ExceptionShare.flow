    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Add the share record to the list</description>
        <name>Core_MDF_Assign_all_the_bank_share_record</name>
        <label>Assign all the exception share record</label>
        <locationX>984</locationX>
        <locationY>562</locationY>
        <assignmentItems>
            <assignToReference>sCollExceptionShareInsertList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>sExceptionShareTemp</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Assign_all_the_EAM_share_record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign the EAMShareTemp record to the List.</description>
        <name>Core_MDF_Assign_all_the_EAM_share_record</name>
        <label>Assign all the EAM share record</label>
        <locationX>804</locationX>
        <locationY>562</locationY>
        <assignmentItems>
            <assignToReference>sCollEAMShareList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>sEAMShareTemp</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Empty_the_EAM_Share_temp_variable</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign the values to the Exception Account Mapping Temp share record</description>
        <name>Core_MDF_Assign_the_value_to_EAM_Temp_share_record</name>
        <label>Assign the value to EAM Temp share record</label>
        <locationX>1124</locationX>
        <locationY>562</locationY>
        <assignmentItems>
            <assignToReference>sEAMShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>vExceptionAccountMappingId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sEAMShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>sPGM.Core_MDF_Group_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sEAMShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Assign_all_the_bank_share_record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>assign the values to the exception share record</description>
        <name>Core_MDF_Assign_the_value_to_Exception_share_record</name>
        <label>Assign the value to Exception share record</label>
        <locationX>1124</locationX>
        <locationY>429</locationY>
        <assignmentItems>
            <assignToReference>sExceptionShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>vExceptionId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sExceptionShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>sPGM.Core_MDF_Group_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sExceptionShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Assign_the_value_to_EAM_Temp_share_record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Core_MDF_Empty_the_EAM_Share_temp_variable</name>
