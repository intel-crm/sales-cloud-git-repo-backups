    <assignments>
        <description>Clear the share record values for the next iteration</description>
        <name>Core_MDF_Empty_the_Exception_Share_temp_variable</name>
        <label>Empty the Exception Share temp variable</label>
        <locationX>802</locationX>
        <locationY>411</locationY>
        <assignmentItems>
            <assignToReference>sExceptionShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sExceptionShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sExceptionShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
