        <locationX>684</locationX>
        <locationY>562</locationY>
        <assignmentItems>
            <assignToReference>sEAMShareTemp.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sEAMShareTemp.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sEAMShareTemp.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Empty_the_Exception_Share_temp_variable</targetReference>
        </connector>
