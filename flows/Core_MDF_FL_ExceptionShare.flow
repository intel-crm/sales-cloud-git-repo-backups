    <assignments>
        <description>Assign CCF Channel program Id</description>
        <name>Core_MDF_Get_CCF_Program_Name</name>
        <label>Get CCF Program Name</label>
        <locationX>543</locationX>
        <locationY>161</locationY>
        <assignmentItems>
            <assignToReference>vCCFChannelProgramId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fCCFProgramId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_Metadata</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign DCF Channel program Id</description>
        <name>Core_MDF_Get_DCF_Program_Name</name>
        <label>Get DCF Program Name</label>
        <locationX>129</locationX>
        <locationY>211</locationY>
        <assignmentItems>
            <assignToReference>vDCFChannelProgramId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fDCFProgramId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_Metadata</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign SPCF Channel program Id</description>
        <name>Core_MDF_Get_SPCF_Program_Name</name>
        <label>Get SPCF Program Name</label>
        <locationX>332</locationX>
        <locationY>157</locationY>
        <assignmentItems>
            <assignToReference>vSPCFChannelProgramId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fSPCFProgramId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_Metadata</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>check the exception and channel program</description>
        <name>Core_MDF_Align_Exception_Program_with_it_s_respective_values</name>
        <label>Align Exception Program with it&apos;s respective values</label>
        <locationX>221</locationX>
        <locationY>62</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Loop_Metadata</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_CCF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCPtemp.Core_MDF_Bank_Program_Value__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>vCCFExceptionProgram</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Get_CCF_Program_Name</targetReference>
            </connector>
            <label>CCF</label>
        </rules>
        <rules>
            <name>Core_MDF_DCF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCPtemp.Core_MDF_Bank_Program_Value__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>vDCFExceptionProgram</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Get_DCF_Program_Name</targetReference>
            </connector>
            <label>DCF</label>
        </rules>
        <rules>
            <name>Core_MDF_SPCF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCPtemp.Core_MDF_Bank_Program_Value__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>vSPCFExceptionProgram</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Get_SPCF_Program_Name</targetReference>
            </connector>
            <label>SPCF</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if Group Id is not Null for the PGM record.</description>
        <name>Core_MDF_Check_if_Group_Id_is_Not_NULL</name>
        <label>Check if Group Id is Not NULL</label>
        <locationX>1117</locationX>
        <locationY>280</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Loop_through_PGM_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Group_Id_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sPGM.Core_MDF_Group_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Assign_the_value_to_Exception_share_record</targetReference>
            </connector>
            <label>Group Id NOT NULL</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if the exception share list is not empty</description>
        <name>Core_MDF_ExceptionShare_List_NOT_EMPTY</name>
        <label>ExceptionShare List NOT EMPTY</label>
        <locationX>690</locationX>
        <locationY>90</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_ExceptionShare_List_is_NOT_EMPTY</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollExceptionShareInsertList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Insert_Exception_Share_to_Internal_Account_Manager</targetReference>
            </connector>
            <label>ExceptionShare List is NOT EMPTY</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if PGM list is empty</description>
        <name>Core_MDF_PGM_Not_NULL</name>
        <label>PGM Not NULL</label>
        <locationX>484</locationX>
        <locationY>289</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_PGM_NOT_NULL_Decision</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollPGMList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Loop_through_PGM_List</targetReference>
            </connector>
            <label>PGM NOT NULL</label>
        </rules>
    </decisions>
    <description>Share Exception and Exception Account Mapping records with the Internal Account Managers</description>
    <formulas>
        <description>Formula containing CCF Channel Program Id</description>
        <name>fCCFProgramId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_CCF_Channel_Program_Id}</expression>
    </formulas>
    <formulas>
        <name>fDCFProgramId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_DCF_Channel_Program_Id}</expression>
    </formulas>
    <formulas>
        <name>fSPCFProgramId</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_SPCF_Channel_Program_Id}</expression>
    </formulas>
    <interviewLabel>Core_MDF_Exception {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_FL_ExceptionShare</label>
    <loops>
        <description>Iterate over the loop to set the channel program Id</description>
        <name>Core_MDF_Loop_Metadata</name>
        <label>Loop Metadata</label>
        <locationX>247</locationX>
        <locationY>427</locationY>
        <assignNextValueToReference>sCPtemp</assignNextValueToReference>
        <collectionReference>sCPcollection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_MDF_Align_Exception_Program_with_it_s_respective_values</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_MDF_Fetch_PGM</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Core_MDF_Loop_through_PGM_List</name>
        <label>Loop through PGM List</label>
        <locationX>802</locationX>
        <locationY>277</locationY>
        <assignNextValueToReference>sPGM</assignNextValueToReference>
        <collectionReference>sCollPGMList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_MDF_Check_if_Group_Id_is_Not_NULL</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_MDF_ExceptionShare_List_NOT_EMPTY</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create Exception Account Mapping share records</description>
        <name>Core_MDF_Create_Exception_Account_Mapping_share_records</name>
        <label>Create Exception Account Mapping share records</label>
        <locationX>1142</locationX>
        <locationY>79</locationY>
        <inputReference>sCollEAMShareList</inputReference>
    </recordCreates>
    <recordCreates>
        <description>Insert the exception share list</description>
        <name>Core_MDF_Insert_Exception_Share_to_Internal_Account_Manager</name>
        <label>Insert Exception Share to Internal Account Manager</label>
        <locationX>983</locationX>
        <locationY>79</locationY>
        <connector>
            <targetReference>Core_MDF_Create_Exception_Account_Mapping_share_records</targetReference>
        </connector>
        <inputReference>sCollExceptionShareInsertList</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Fetch the PGM records based on account and channel program</description>
        <name>Core_MDF_Fetch_PGM</name>
        <label>Fetch PGM</label>
        <locationX>492</locationX>
        <locationY>436</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_PGM_Not_NULL</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4) AND 5 AND 6</filterLogic>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vCCFChannelProgramId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vDCFChannelProgramId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vSPCFChannelProgramId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Group_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Partner_Group_Mapping__c</object>
        <outputReference>sCollPGMList</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Group_Id__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>Get the channel program name and program name from BankProgram Entitlement Mapping metatdata</description>
        <name>Core_MDF_Fetch_Program_Mapping_Metadata</name>
        <label>Fetch Program Mapping Metadata</label>
        <locationX>51</locationX>
        <locationY>427</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Loop_Metadata</targetReference>
        </connector>
        <object>Core_MDF_ChannelProgram__mdt</object>
        <outputReference>sCPcollection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Bank_Program_Value__c</queriedFields>
        <queriedFields>Core_MDF_Technical_Program_Name__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_MDF_Fetch_Program_Mapping_Metadata</targetReference>
        </connector>
    </start>
