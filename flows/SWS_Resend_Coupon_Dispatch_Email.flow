            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recordId.SWS_Resend_Email_User_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>username</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Resend_Coupon_Email</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>username</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName}+ &quot; &quot; +{!$User.LastName}</expression>
    </formulas>
    <interviewLabel>SWS Resend Coupon Dispatch Email {!$Flow.CurrentDateTime}</interviewLabel>
