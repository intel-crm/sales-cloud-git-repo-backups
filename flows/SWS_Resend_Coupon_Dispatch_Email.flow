            </value>
        </inputParameters>
        <nameSegment>SWS_SendEmailController</nameSegment>
    </actionCalls>
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Details</name>
        <label>Add Details</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>RecordDetails</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>recordId.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>RecordDetails</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>SWS_SendCouponDetails</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recordId.SWS_resend_email_click_count__c</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recordId.SWS_Resend_Email_Timestamp__c</assignToReference>
            <operator>Assign</operator>
