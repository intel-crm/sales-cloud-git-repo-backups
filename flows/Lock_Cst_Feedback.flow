    <assignments>
        <name>Add_to_Acct_feedback_missing_collection</name>
        <label>Add to Acct feedback missing collection</label>
        <locationX>270</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>MissingCstFeedbackCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Customer_Feedback_Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cst_Feedbacks</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_to_Feedback_Collection</name>
        <label>Add to Feedback Collection</label>
        <locationX>534</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>CstFeedbackCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>CstFeedback</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Cst_Feedbacks</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Lock_Feedback</name>
        <label>Lock Feedback</label>
        <locationX>534</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>CstFeedback.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Cst_Feedbacks</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CstFeedback.Lock_Decision__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Feedback_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_any_acct_feedback_missing</name>
        <label>Check if any acct feedback missing</label>
        <locationX>402</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Lock_Feedback</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>default</defaultConnectorLabel>
        <rules>
            <name>Acct_feedbacks_missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Customer_Feedback_Record.Account_Feedback_Present__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_to_Acct_feedback_missing_collection</targetReference>
            </connector>
            <label>Acct feedbacks missing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_missing_acct_feedback_collection_has_values</name>
        <label>Check if missing acct feedback collection has values</label>
        <locationX>182</locationX>
        <locationY>950</locationY>
        <defaultConnector>
            <targetReference>Update_Feedbacks</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_missing_acct_feedback</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MissingCstFeedbackCollection</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Success_Msg</targetReference>
            </connector>
            <label>Has missing acct feedback</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Lock Cst Feedback {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lock Cst Feedback</label>
    <loops>
        <name>Loop_Cst_Feedbacks</name>
        <label>Loop Cst Feedbacks</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <collectionReference>ids</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Customer_Feedback_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_if_missing_acct_feedback_collection_has_values</targetReference>
        </noMoreValuesConnector>
    </loops>
