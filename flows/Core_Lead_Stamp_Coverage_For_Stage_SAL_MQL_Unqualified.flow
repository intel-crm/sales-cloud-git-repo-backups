<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Update_SQL_Coverage</name>
        <label>Update SQL Coverage</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>mainUpdate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Converted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsConverted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Qualified Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SQL_coverage</targetReference>
            </connector>
            <label>Converted</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Core_Coverage_MAQL_FastTrack1Formula</name>
        <dataType>String</dataType>
        <expression>IF(AND (TEXT(PRIORVALUE($Record.Status))=&quot;Marketing Qualified Lead&quot;, ISPICKVAL($Record.Status, &quot;Sales Accepted Lead&quot;), $Record.RecordType.Name = &quot;Lead&quot; ), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TAL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Coverage_MAQL_FastTrack2Formula</name>
        <dataType>String</dataType>
        <expression>IF(AND (TEXT(PRIORVALUE($Record.Status))=&quot;Marketing Qualified Lead&quot;, ISPICKVAL($Record.Status, &quot;Sales Accepted Lead&quot;), $Record.RecordType.Name = &quot;Lead&quot; ), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TQL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Coverage_TAL_SAL_FastTrackFormula</name>
        <dataType>String</dataType>
        <expression>IF(AND (TEXT(PRIORVALUE($Record.Status))=&quot;Tele Accepted Lead&quot;, ISPICKVAL($Record.Status, &quot;Sales Accepted Lead&quot;)), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TQL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_MQL_Lead_CoverageFormula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT(PRIORVALUE($Record.Status))=&quot;Marketing Qualified Lead&quot;, (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_MQL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_SALFormula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT(PRIORVALUE($Record.Status))=&quot;Sales Accepted Lead&quot;,  (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_SAL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_SQLFormula</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL($Record.Status,&apos;Sales Qualified Lead&apos;), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))), $Record.Core_Locked_SQL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_TAL_Lead_CoverageFormula</name>
        <dataType>String</dataType>
        <expression>IF(AND(TEXT(PRIORVALUE($Record.Status))=&quot;Tele Accepted Lead&quot;, ISCHANGED($Record.Status)), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TAL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_TQL_Lead_CoverageFormula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT(PRIORVALUE($Record.Status))=&quot;Tele Qualified Lead&quot;, (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TQL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_Unqualified_Lead_CoverageFormula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT(PRIORVALUE($Record.Status))=&quot;Unqualified&quot;,  (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_Unqualified_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>F_TAL</name>
        <dataType>String</dataType>
        <expression>IF(AND (TEXT(PRIORVALUE($Record.Status))=&quot;Marketing Qualified Lead&quot;, ISPICKVAL($Record.Status, &quot;Sales Accepted Lead&quot;), $Record.RecordType.Name = &quot;Lead&quot; ),
 (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))), 
IF(AND(TEXT(PRIORVALUE($Record.Status))=&quot;Tele Accepted Lead&quot;, ISCHANGED($Record.Status)), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,
TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TAL_Coverage__c) )</expression>
    </formulas>
    <formulas>
        <name>F_TQL</name>
        <dataType>String</dataType>
        <expression>IF(AND (TEXT(PRIORVALUE($Record.Status))=&quot;Marketing Qualified Lead&quot;, ISPICKVAL($Record.Status, &quot;Sales Accepted Lead&quot;), $Record.RecordType.Name = &quot;Lead&quot; ), 

(IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),


IF(AND (TEXT(PRIORVALUE($Record.Status))=&quot;Tele Accepted Lead&quot;, ISPICKVAL($Record.Status, &quot;Sales Accepted Lead&quot;)), 

(IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),


IF(TEXT(PRIORVALUE($Record.Status))=&quot;Tele Qualified Lead&quot;, (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,

TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TQL_Coverage__c)))</expression>
    </formulas>
    <formulas>
        <name>Update_Locked_SGL_Formula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT(PRIORVALUE($Record.Status))=&quot;Sales Generated Lead&quot;, (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,
  TEXT($Record.Owner:User.Core_User_Coverage__c))),{!$Record.SWS_Locked_SGL_Coverage__c})</expression>
    </formulas>
    <interviewLabel>Core_Lead_Stamp_Coverage_For_Stage_SAL_MQL_Unqualified {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Lead_Stamp_Coverage_For_Stage_SAL_MQL_Unqualified</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Core_Locked_MQL_Coverage__c</field>
            <value>
                <elementReference>Core_Update_MQL_Lead_CoverageFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Locked_Unqualified_Coverage__c</field>
            <value>
                <elementReference>Core_Update_Unqualified_Lead_CoverageFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SWS_Locked_SGL_Coverage__c</field>
            <value>
                <elementReference>Update_Locked_SGL_Formula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>SQL_coverage</name>
        <label>SQL coverage</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Core_Locked_SAL_Coverage__c</field>
            <value>
                <elementReference>Core_Update_SALFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Locked_SQL_Coverage__c</field>
            <value>
                <elementReference>Core_Update_SQLFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_SQL_Coverage</targetReference>
        </connector>
        <filterFormula>AND( OR( ISNEW(), ISCHANGED({!$Record.Status}), ISCHANGED({!$Record.IsConverted}) ), LEFT({!$Record.OwnerId}, 3) = &apos;005&apos;, OR( TEXT(PRIORVALUE({!$Record.Status}))=&quot;Unqualified&quot;, TEXT(PRIORVALUE({!$Record.Status}))=&quot;Sales Accepted Lead&quot;, TEXT(PRIORVALUE({!$Record.Status}))=&quot;Marketing Qualified Lead&quot;, ISPICKVAL({!$Record.Status},&quot;Sales Qualified Lead&quot;)) )</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
