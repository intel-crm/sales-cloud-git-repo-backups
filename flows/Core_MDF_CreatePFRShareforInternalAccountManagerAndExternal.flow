        <name>myDecision</name>
        <label>myDecision</label>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>default</defaultConnectorLabel>
        <rules>
            <name>myRule_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_myRule_1</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>myRule_1_A1</targetReference>
            </connector>
            <label>Check if it is New or the Owner Id is changed</label>
        </rules>
    </decisions>
    <description>This is used to share PFR records with External Users.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>IF( AND(NOT(ISNEW()), ISCHANGED([PartnerFundRequest].ChannelPartner.Id )) , PRIORVALUE([PartnerFundRequest].ChannelPartner.Id ),NULL) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_2681499936</name>
        <dataType>String</dataType>
        <expression>IF( AND(NOT(ISNEW()), ISCHANGED({!myVariable_current.ChannelPartner.Id} )) , PRIORVALUE({!myVariable_current.ChannelPartner.Id} ),NULL)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	OR(
		ISNEW(), 
		ISCHANGED([PartnerFundRequest].OwnerId ),
                ISCHANGED([PartnerFundRequest].ChannelPartner.Id ),
                ISCHANGED([PartnerFundRequest].Core_MDF_Region_nm__c),
                AND([PartnerFundRequest].RecordType.DeveloperName = $Label.Core_MDF_PFR_Retail, ISCHANGED([PartnerFundRequest].Core_MDF_Sub_Region_nm__c))
	),
	OR(
		[PartnerFundRequest].RecordType.DeveloperName = $Label.Core_MDF_PFR_Retail,
		NOT(
			ISBLANK([PartnerFundRequest].Campaign.Core_MDF_Account__c.Core_MDF_Parent_Fund_Account__c.Id)
		)	
	)	
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	OR(
		ISNEW(), 
		ISCHANGED({!myVariable_current.OwnerId} ),
                ISCHANGED({!myVariable_current.ChannelPartner.Id} ),
                ISCHANGED({!myVariable_current.Core_MDF_Region_nm__c}),
                AND({!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_PFR_Retail}, ISCHANGED({!myVariable_current.Core_MDF_Sub_Region_nm__c}))
	),
	OR(
		{!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_MDF_PFR_Retail},
		NOT(
			ISBLANK({!myVariable_current.Campaign.Core_MDF_Account__r.Core_MDF_Parent_Fund_Account__r.Id})
		)	
	)	
)</expression>
    </formulas>
    <interviewLabel>Core_MDF_CreatePFRShareforInternalAccountManagerAndExternal-19_InterviewLabel</interviewLabel>
    <label>Core_MDF_CreatePFRShareForExternal</label>
