<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Active_Inactive_count</name>
        <label>Assign Active/Inactive count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ActiveABPs</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Active_ABP_records</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>InactiveABPs</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Inactive_ABP_records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_CMFGroup</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Active_ABP_records</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Active ABP records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Active_ABP_records</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_ABP_records</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Active_ABP_records.ER_End_Date__c</leftValueReference>
            <operator>IsNull</operator>
            <rightValue>
                <booleanValue>true</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Inactive_ABP_records</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>Inactive_ABP_records</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Inactive ABP records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Inactive_ABP_records</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_ABP_records</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Inactive_ABP_records.ER_End_Date__c</leftValueReference>
            <operator>IsNull</operator>
            <rightValue>
                <booleanValue>false</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Assign_Active_Inactive_count</targetReference>
        </connector>
    </collectionProcessors>
    <customErrors>
        <name>Validation_error_for_Audit_record</name>
        <label>Validation error for Audit record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Audit tracking record cannot be deleted.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Verify_Audit_Record_Deletion</name>
        <label>Verify Audit Record Deletion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Post_Delete_Association_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Audit_Record_Deleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ER_End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Validation_error_for_Audit_record</targetReference>
            </connector>
            <label>Audit Record Deleted</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ENDDATE</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Account Business Partner Delete Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Business Partner Delete Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Post_Delete_Association_record</name>
        <label>Create Post Delete Association record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_ABP_records</targetReference>
        </connector>
        <inputAssignments>
            <field>CreatedById</field>
            <value>
                <elementReference>$Record.CreatedById</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_Account__c</field>
            <value>
                <elementReference>$Record.ER_Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_Active__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_Customer_Master_File_Grouping__c</field>
            <value>
                <elementReference>$Record.ER_Customer_Master_File_Grouping__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_End_Date__c</field>
            <value>
                <elementReference>ENDDATE</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_Start_Date__c</field>
            <value>
                <elementReference>$Record.ER_Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <object>ER_Account_Business_Partner__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_ABP_records</name>
        <label>Get ABP records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Active_ABP_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ER_Customer_Master_File_Grouping__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ER_Customer_Master_File_Grouping__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ER_Account_Business_Partner__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_CMFGroup</name>
        <label>Update CMFGroup</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ER_Customer_Master_File_Grouping__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ER_Active_Account_Business_Partners__c</field>
            <value>
                <elementReference>ActiveABPs</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_Inactive_Account_Business_Partners__c</field>
            <value>
                <elementReference>InactiveABPs</elementReference>
            </value>
        </inputAssignments>
        <object>ER_Customer_Master_File_Group__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Verify_Audit_Record_Deletion</targetReference>
        </connector>
        <object>ER_Account_Business_Partner__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>ActiveABPs</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>currentItem_Active_ABP_records</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ER_Account_Business_Partner__c</objectType>
    </variables>
    <variables>
        <name>currentItem_Inactive_ABP_records</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ER_Account_Business_Partner__c</objectType>
    </variables>
    <variables>
        <name>InactiveABPs</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
