)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_6</name>
        <dataType>Boolean</dataType>
        <expression>AND(
PRIORVALUE({!myVariable_current.PMP_Partner_Offering_Lifecycle_Status_Nm__c})=&apos;Admin Review&apos;,
ISPICKVAL({!myVariable_current.PMP_Partner_Offering_Lifecycle_Status_Nm__c},&apos;Admin Review&apos;),
ISBLANK(PRIORVALUE({!myVariable_current.PMP_Intel_Admin_Id__c})),
