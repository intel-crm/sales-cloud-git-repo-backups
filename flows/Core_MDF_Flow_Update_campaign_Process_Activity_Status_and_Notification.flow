    <decisions>
        <name>Cancel_MDF_RMF_Campaigns</name>
        <label>Cancel MDF/RMF Campaigns</label>
        <locationX>463</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Cancel_Proposalbased_Projectbased_campaign</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Cancel_MDF_RMF_Campaign</name>
            <conditionLogic>1 AND (2 OR 3 OR 4 OR 5 OR 6) AND 7</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Client_CoMarketing_Fund</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Data_Center_CoMarketing_Fund</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Service_Provider_CoMarketing_Fund</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Client_CoMarketing_Fund_Boost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Retail_Marketing_Funds</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Call_Approval_Removal</targetReference>
            </connector>
            <label>Cancel MDF/RMF Campaign</label>
        </rules>
    </decisions>
    <decisions>
        <name>Cancel_Proposalbased_Projectbased_campaign</name>
        <label>Cancel Proposal based/Project based campaign</label>
        <locationX>877</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Submit_IPA_Campaign_for_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Proposal_based_Project_based_campaign</name>
            <conditionLogic>(1 OR 4) AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Partner Alliance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CoGTM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recall_Approval</targetReference>
            </connector>
            <label>Proposal based/Project based campaign</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_CoGTM_Program_For_IUPGM</name>
