    <decisions>
        <name>Check_PFR_Status</name>
        <label>Check PFR Status</label>
        <locationX>1661</locationX>
        <locationY>971</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>In_Progress_Pending_Review_Records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_PFR_records.Core_MDF_Fund_Request_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In-Progress Revision Required</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>In_Progress_Pending_Review_PFR_records</targetReference>
            </connector>
            <label>In Progress Pending Review Records</label>
        </rules>
        <rules>
            <name>Pending_Review</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_PFR_records.Core_MDF_Fund_Request_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_PFR_records.Core_MDF_Fund_Request_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Revision Required</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pending_review_PFR_records</targetReference>
            </connector>
            <label>Pending Review</label>
        </rules>
    </decisions>
