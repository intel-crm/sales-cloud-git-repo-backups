    <environments>Default</environments>
    <formulas>
        <name>checkIPAnotification</name>
        <dataType>Boolean</dataType>
        <expression>(ISPICKVAL({!$Record.Core_MDF_Program__c} ,&apos;Intel Partner Alliance&apos;)) &amp;&amp; (ISPICKVAL({!$Record__Prior.Status},&apos;Pending Review&apos;))</expression>
    </formulas>
    <formulas>
        <name>currentTime_3m</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + (3/1440)</expression>
    </formulas>
    <formulas>
        <name>NotifyIPAOwnerOnTerminalRejection</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Core_MDF_Program__c} , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
ISCHANGED({!$Record.Status}) &amp;&amp;
ISPICKVAL({!$Record.Status} ,  &apos;Declined&apos;) &amp;&amp;
(TEXT({!$Record__Prior.Status}) = &quot;Pending Review&quot;) &amp;&amp;
{!$Record.Core_MDF_Terminal_Rejection_Ind__c} = true &amp;&amp;
{!$Record.Core_MDF_Proposal_Based_Ind__c} =true</expression>
    </formulas>
    <formulas>
        <name>NotifyUsersonProposalOrProjectRejection</name>
        <dataType>Boolean</dataType>
        <expression>(ISPICKVAL({!$Record.Core_MDF_Program__c} , &apos;Intel Partner Alliance&apos;) || ISPICKVAL({!$Record.Core_MDF_Program__c} , &apos;CoGTM&apos;)) &amp;&amp;
ISCHANGED({!$Record.Status}) &amp;&amp;
ISPICKVAL({!$Record.Status} ,  &apos;Revision Required&apos;) &amp;&amp;
(TEXT({!$Record__Prior.Status}) = &quot;Pending Review&quot; ||
TEXT({!$Record__Prior.Status}) = &quot;Pending Approval&quot;) &amp;&amp;
{!$Record.Core_MDF_Proposal_Based_Ind__c} =true</expression>
    </formulas>
    <formulas>
        <name>PendingApprovalCampaignProposalOrProjectBased</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Status},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!$Record.Status}),&apos;Pending Approval&apos;))&amp;&amp;
(ISPICKVAL({!$Record.Core_MDF_Program__c} ,&apos;Intel Partner Alliance&apos;)||ISPICKVAL({!$Record.Core_MDF_Program__c}, &apos;CoGTM&apos;)) &amp;&amp; 
(ISPICKVAL(PRIORVALUE({!$Record.Status}),&apos;Pending Review&apos;)||(ISPICKVAL({!$Record.Core_MDF_Program__c} ,&apos;Intel Partner Alliance&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!$Record.Core_MDF_Approval_Stage_nm__c}),&apos;L1 Approval&apos;))&amp;&amp; {!$Record.Core_MDF_Approval_Step_Counter_nbr__c} = 1))</expression>
    </formulas>
    <formulas>
        <name>RecipientIdValue</name>
        <dataType>String</dataType>
        <expression>{!$Record.OwnerId}</expression>
    </formulas>
    <formulas>
        <name>SetPFRasDeclinedonL1Approval_Rejection</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Core_MDF_Program__c} , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
(ISCHANGED({!$Record.Core_MDF_Approval_Step_Counter_nbr__c} ) &amp;&amp;
({!$Record.Core_MDF_Approval_Step_Counter_nbr__c} == 1) ||
({!$Record.Core_MDF_Approval_Step_Counter_nbr__c} == 0 &amp;&amp;
ISPICKVAL({!$Record.Status , &apos;Revision Required&apos;}) &amp;&amp;
{!$Record__Prior.Core_MDF_Approval_Step_Counter_nbr__c} ==0 ))</expression>
    </formulas>
    <formulas>
        <name>SubmitCoGTMCampaignForApproval</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Core_MDF_Program__c}, &apos;CoGTM&apos;) &amp;&amp;
(
    (
        ISPICKVAL({!$Record.Status}, &apos;Pending Review&apos;) &amp;&amp;
        NOT(ISPICKVAL({!$Record__Prior.Status}, &apos;Pending Review&apos;))
    )
)</expression>
    </formulas>
    <formulas>
        <name>SubmitIPACampaignforApproval</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Core_MDF_Program__c},&apos;Intel Partner Alliance&apos;) &amp;&amp; (((ISPICKVAL({!$Record.Status},&apos;Pending Review&apos;) &amp;&amp; Not(ISPICKVAL({!$Record__Prior.Status},&apos;Pending Review&apos;))) ||(ISPICKVAL({!$Record.Status},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL({!$Record__Prior.Status},&apos;Pending Approval&apos;)) &amp;&amp; {!$Record.Core_MDF_Approval_Step_Counter_nbr__c} = 1 &amp;&amp; Not(ISPICKVAL({!$Record__Prior.Core_MDF_Approval_Stage_nm__c},&apos;L1 Approval&apos;)))) || (ISPICKVAL({!$Record.Core_MDF_IPA_Approval_Status_nm__c},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL({!$Record__Prior.Core_MDF_IPA_Approval_Status_nm__c},&apos;Pending Approval&apos;)) &amp;&amp; {!$Record.Core_MDF_Approval_Step_Counter_nbr__c} != 0))</expression>
    </formulas>
