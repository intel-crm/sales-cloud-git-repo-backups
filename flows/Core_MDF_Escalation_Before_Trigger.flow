<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Approved_Amount</name>
        <label>Assign Approved Amount</label>
        <locationX>1194</locationX>
        <locationY>659</locationY>
        <assignmentItems>
            <assignToReference>Escalation_Amount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Approved_Amount_amt__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Escalation_Amount_Old</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record__Prior.Core_MDF_Approved_Amount_amt__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_whether_activity_is_Outcome_Based</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_TDI_to_Amount</name>
        <label>Assign TDI to Amount</label>
        <locationX>930</locationX>
        <locationY>659</locationY>
        <assignmentItems>
            <assignToReference>Escalation_Amount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Total_Dollar_Impact_amt__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_whether_activity_is_Outcome_Based</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Core_MDF_Error_Flag</name>
        <label>Error Flag</label>
        <locationX>1018</locationX>
        <locationY>1499</locationY>
        <assignmentItems>
            <assignToReference>hasAllocationViolation</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Loop_Outcome_Based_Account_Mappings</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Map_Scorecard_Fields_to_Escalation</name>
        <label>Map Scorecard Fields to Escalation</label>
        <locationX>50</locationX>
        <locationY>659</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_First_Attribution_Score_txt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>AttributionNumber</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_First_Engagement_Score_txt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>EngagementNumber</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_First_Manual_Recovery_nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ManualRecoveryAmountUSD</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_First_POP_Score_txt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Pop</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Scorecard_id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ScorecardId</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <name>Approved_Amount_Error</name>
        <label>Approved Amount Error</label>
        <locationX>798</locationX>
        <locationY>1967</locationY>
        <customErrorMessages>
            <errorMessage>Escalation cannot be approved as Escalation Amount is exceeding Activity Available Amount</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Escalation_Amount_Error</name>
        <label>Escalation Amount Error</label>
        <locationX>1062</locationX>
        <locationY>1967</locationY>
        <customErrorMessages>
            <errorMessage>Escalation cannot be created as Escalation Amount is exceeding Activity Available Amount</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_for_Approved_Amount_of_Escalation</name>
        <label>Check for Approved Amount of Escalation</label>
        <locationX>1062</locationX>
        <locationY>1859</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approved_Amount_greater_than_Allocation_Amount</name>
            <conditionLogic>((1 AND 7) OR 6) AND ((2 AND 3) OR (4 AND 5))</conditionLogic>
            <conditions>
                <leftValueReference>UpdatedEscAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>PFA_Available_Amount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Escalation_Status_nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Escalation_Status_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approved_Amount_amt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isAmountIncreased</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>hasAllocationViolation</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Is_Outcome_Based_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_Amount_Error</targetReference>
            </connector>
            <label>Approved Amount greater than Allocation Amount</label>
        </rules>
        <rules>
            <name>Check_for_Approved_Amount_while_Creation</name>
            <conditionLogic>1 AND ((2 AND 4) OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Escalation_Amount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>PFA_Available_Amount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>hasAllocationViolation</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Is_Outcome_Based_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Escalation_Amount_Error</targetReference>
            </connector>
            <label>Check for Approved Amount while Creation</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_new_Claim_Case_Escalation</name>
        <label>Check for new Claim Case Escalation</label>
        <locationX>182</locationX>
        <locationY>443</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Escalation_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Scorecard_records</targetReference>
            </connector>
            <label>New Escalation Record</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_record_status</name>
        <label>Check for record status</label>
        <locationX>1062</locationX>
        <locationY>551</locationY>
        <defaultConnector>
            <targetReference>Assign_Approved_Amount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_TDI_to_Amount</targetReference>
            </connector>
            <label>New Record</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_records</name>
        <label>Check for records</label>
        <locationX>1326</locationX>
        <locationY>443</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>check_late_claim_records</name>
            <conditionLogic>(1 OR 2 OR 3) AND 4 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Escalation_Status_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Approved_Amount_amt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Co_Marketing_Activity_id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Late_Claim_Budget_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_record_status</targetReference>
            </connector>
            <label>check late claim records</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_whether_activity_is_Outcome_Based</name>
        <label>Check whether activity is Outcome-Based</label>
        <locationX>1062</locationX>
        <locationY>851</locationY>
        <defaultConnector>
            <targetReference>Get_Allocation_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non-Outcome Based Activities</defaultConnectorLabel>
        <rules>
            <name>Outcome_Based_Campaign</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Co_Marketing_Activity_id__r.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_IPA_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Is_Outcome_Based_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Activity_Level_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Super Activity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Outcome_Based_Account_Mappings</targetReference>
            </connector>
            <label>Outcome-Based Campaign</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_Node_Allocation</name>
        <label>Check Node Allocation</label>
        <locationX>1150</locationX>
        <locationY>1391</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Loop_Outcome_Based_Account_Mappings</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Does not Exceed</defaultConnectorLabel>
        <rules>
            <name>Exceeds</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SplitAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varNodeAvailableAlloc</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Error_Flag</targetReference>
            </connector>
            <label>Exceeds</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Claim_Case_Review_Result</name>
        <label>If Claim Case Review Result</label>
        <locationX>754</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Check_for_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Late Claim</defaultConnectorLabel>
        <rules>
            <name>Claim_Case_Review_Result</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Case_ID_Number_id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Co_Marketing_Activity_id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_ID_Number_id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_new_Claim_Case_Escalation</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Claim Case Review Result</label>
        </rules>
    </decisions>
    <description>This flow is used to validate Escalation Amount against Activity Available Amount of Allocation for Late Claim Escalations and populate Scorecard Details for Claim Case Review Result Escalations</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Split_Greater_Than_Node_Allocation</name>
        <dataType>Boolean</dataType>
        <expression>{!SplitAmount}&gt;{!varNodeAvailableAlloc}</expression>
    </formulas>
    <formulas>
        <name>isAmountIncreased</name>
        <dataType>Boolean</dataType>
        <expression>IF(({!$Record.Core_MDF_Approved_Amount_amt__c} &gt;  {!$Record__Prior.Core_MDF_Approved_Amount_amt__c} ), true, false)</expression>
    </formulas>
    <formulas>
        <name>Late_Claim_Budget_Type</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Budget_Type_nm__c},&apos;MDF&apos;) || ISPICKVAL({!$Record.Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Budget_Type_nm__c},&apos;MDF+&apos;) ||
ISPICKVAL({!$Record.Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Budget_Type_nm__c},&apos;Cloud&apos;) ||
ISPICKVAL({!$Record.Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Budget_Type_nm__c},&apos;Retail MDF&apos;) ||
AND({!$Record.Core_MDF_Co_Marketing_Activity_id__r.RecordType.Name} =&apos;Intel Partner Alliance&apos;,OR({!$Record.Core_MDF_Co_Marketing_Activity_id__r.Core_MDF_Is_Outcome_Based_Ind__c}=TRUE ,{!$Record.Core_MDF_Co_Marketing_Activity_id__r.Campaign.Core_MDF_Proposal_Based_Ind__c} = False))</expression>
    </formulas>
    <formulas>
        <name>SplitAmount</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Core_MDF_Approved_Amount_amt__c}* ({!Core_MDF_Loop_Outcome_Based_Account_Mappings.Core_MDF_Percentage_pct__c}/100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>UpdatedEscAmount</name>
        <dataType>Currency</dataType>
        <expression>IF( AND({!Escalation_Amount} &lt;&gt; {!Escalation_Amount_Old},{!Escalation_Amount} &gt; {!Escalation_Amount_Old}),{!Escalation_Amount} - {!Escalation_Amount_Old}, {!Escalation_Amount})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core_MDF_Escalation_Before_Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Escalation_Before_Trigger</label>
    <loops>
        <description>Iterate over Outcome-Based Account Mapping Records</description>
        <name>Core_MDF_Loop_Outcome_Based_Account_Mappings</name>
        <label>Loop Outcome Based Account Mappings</label>
        <locationX>930</locationX>
        <locationY>1067</locationY>
        <collectionReference>Core_MDF_Outcome_Based_Account_Mappings</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_MDF_Fetch_Sub_Activity_records</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_for_Approved_Amount_of_Escalation</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Fetch Sub-Activities of a particular Super Activity</description>
        <name>Core_MDF_Fetch_Sub_Activity_records</name>
        <label>Fetch Sub- Activity records</label>
        <locationX>1150</locationX>
        <locationY>1175</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Get_Sub_Activity_Allocation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Core_MDF_Loop_Outcome_Based_Account_Mappings.Core_MDF_OutcomeBased_SubAct_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PartnerFundRequest</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get allocation id of sub activity</description>
        <name>Core_MDF_Get_Sub_Activity_Allocation</name>
        <label>Get Sub-Activity Allocation</label>
        <locationX>1150</locationX>
        <locationY>1283</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Check_Node_Allocation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Core_MDF_Fetch_Sub_Activity_records.AllocationId</elementReference>
            </value>
        </filters>
        <object>PartnerFundAllocation</object>
        <outputAssignments>
            <assignToReference>varNodeAvailableAlloc</assignToReference>
            <field>Core_MDF_Available_Activity_Alloc_Amt__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <description>Get Outcome-Based account mapping for Outcome-Based Campaign</description>
        <name>Core_MDF_Outcome_Based_Account_Mappings</name>
        <label>Get Outcome Based Account Mappings</label>
        <locationX>930</locationX>
        <locationY>959</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Loop_Outcome_Based_Account_Mappings</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Outcome_Based_CampaignId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Co_Marketing_Activity_id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Active_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_OutcomeBased_SubAct_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_MDF_Outcome_Account_Mapping__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Allocation_Id</name>
        <label>Get Allocation Id</label>
        <locationX>1194</locationX>
        <locationY>959</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_for_Approved_Amount_of_Escalation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Co_Marketing_Activity_id__r.AllocationId</elementReference>
            </value>
        </filters>
        <object>PartnerFundAllocation</object>
        <outputAssignments>
            <assignToReference>PFA_Available_Amount</assignToReference>
            <field>Core_MDF_Available_Activity_Alloc_Amt__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Scorecard_records</name>
        <label>Get Scorecard records</label>
        <locationX>50</locationX>
        <locationY>551</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Map_Scorecard_Fields_to_Escalation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Case_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Case_ID_Number_id__c</elementReference>
            </value>
        </filters>
        <object>Core_MDF_Scorecard__c</object>
        <outputAssignments>
            <assignToReference>AttributionNumber</assignToReference>
            <field>Core_MDF_Attribution_Nbr__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>EngagementNumber</assignToReference>
            <field>Core_MDF_Engagement_Nbr__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>ManualRecoveryAmountUSD</assignToReference>
            <field>Core_MDF_Manual_Recovery_Amount_USD_Amt__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>Pop</assignToReference>
            <field>Core_MDF_POP__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>ScorecardId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <start>
        <locationX>628</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>If_Claim_Case_Review_Result</targetReference>
