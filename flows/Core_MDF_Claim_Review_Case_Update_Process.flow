    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	NOT(ISNEW()),
	[Case].RecordType.DeveloperName =&quot;Core_MDF_Audit&quot;,
	ISCHANGED([Case].Core_MDF_Review_Case_Status__c),
ISPICKVAL(([Case].Core_MDF_Review_Case_Status__c),&apos;Non-compliant&apos;),
PRIORVALUE([Case].Core_MDF_Status__c)=$Label.Core_MDF_Case_Status_Pending_Document) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_11</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	NOT(ISNEW()),
	{!myVariable_current.RecordType.DeveloperName} =&quot;Core_MDF_Audit&quot;,
	ISCHANGED({!myVariable_current.Core_MDF_Review_Case_Status__c}),
ISPICKVAL(({!myVariable_current.Core_MDF_Review_Case_Status__c}),&apos;Non-compliant&apos;),
PRIORVALUE({!myVariable_current.Core_MDF_Status__c})={!$Label.Core_MDF_Case_Status_Pending_Document})</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Case].RecordType.DeveloperName =&quot;Core_MDF_Audit&quot;, ISCHANGED([Case].Core_MDF_Status__c),
ISPICKVAL(([Case].Core_MDF_Status__c),&apos;Cancelled&apos;), PRIORVALUE([Case].Core_MDF_Status__c)=$Label.Core_MDF_Case_Status_Pending_Document,
[Case].Core_MDF_Claim_Submitter__c.IsActive = True
)


 </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_18</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordType.DeveloperName} =&quot;Core_MDF_Audit&quot;, ISCHANGED({!myVariable_current.Core_MDF_Status__c}),
ISPICKVAL(({!myVariable_current.Core_MDF_Status__c}),&apos;Cancelled&apos;), PRIORVALUE({!myVariable_current.Core_MDF_Status__c})={!$Label.Core_MDF_Case_Status_Pending_Document},
{!myVariable_current.Core_MDF_Claim_Submitter__r.IsActive} = True
)</expression>
    </formulas>
