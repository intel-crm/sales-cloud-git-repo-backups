                    <stringValue>6</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Run_For_All_Accounts</name>
            <dataType>Boolean</dataType>
            <fieldText>Run For All Accounts</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;If this option is selected, all the accounts you have access to at the time of the scheduling/initiating the payment run will be included.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
