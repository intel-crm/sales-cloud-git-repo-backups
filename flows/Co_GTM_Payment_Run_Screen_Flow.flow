<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_comma</name>
        <label>Add comma</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCommaSeparatedAccounts</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>,</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCommaSeparatedAccounts</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_IUPGM_Records.Core_MDF_Account_id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_IUPGM_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Account_Id</name>
        <label>Assign Account Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCommaSeparatedAccounts</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_IUPGM_Records.Core_MDF_Account_id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_IUPGM_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>collect_Account_Id_s</name>
        <label>collect Account Id&apos;s</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>colAccountIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_IUPGM_Records.Core_MDF_Account_id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>check_varCommaSeparatedAccounts_data</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Final_Value_Assignment</name>
        <label>Final Value Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_Run_For_All_Accounts__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Run_For_All_Accounts</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_Start_Dt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Execution_Start_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_End_Dt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Execution_End_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_Payment_run_for_Accounts__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varSelectedAccounts</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_Payment_Nature_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Payment_Nature</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordTypeId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Payment_Run_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Final_Value_Assignment1</name>
        <label>Final Value Assignment1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_Run_For_All_Accounts__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Run_For_All_Accounts</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_Start_Dt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Execution_Start_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_End_Dt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Execution_End_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_Payment_run_for_Accounts__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCommaSeparatedAccounts</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.Core_MDF_Payment_Nature_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Payment_Nature</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunRecord.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordTypeId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Create_Payment_Run_Record</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Check_User_Access</name>
        <label>Check User Access</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Screen_For_Access</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User doesnt have access</defaultConnectorLabel>
        <rules>
            <name>User_has_Access</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_IUPGM_Records</targetReference>
            </connector>
            <label>User has Access</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_varCommaSeparatedAccounts_data</name>
        <label>check varCommaSeparatedAccounts data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_comma</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>varCommaSeparatedAccounts_is_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCommaSeparatedAccounts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_Id</targetReference>
            </connector>
            <label>varCommaSeparatedAccounts is null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_IUPGM_Records_Exists</name>
        <label>Does IUPGM Records Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Screen_For_No_IUPGM_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>IUPGM Records Doesn&apos;t Exists</defaultConnectorLabel>
        <rules>
            <name>IUPGM_Records_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_IUPGM_Records</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_IUPGM_Records</targetReference>
            </connector>
            <label>IUPGM Records Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validate_inputs</name>
        <label>Validate inputs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Final_Value_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Run for All Accounts is False</defaultConnectorLabel>
        <rules>
            <name>Validate_Account_Fields</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>Run_For_All_Accounts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSelectedAccounts</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Run_For_All_Accounts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSelectedAccounts</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Screen_For_Both_Account_Fields_Selected</targetReference>
            </connector>
            <label>Validate Account Fields</label>
        </rules>
        <rules>
            <name>Run_For_All_Accounts_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Run_For_All_Accounts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSelectedAccounts</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Final_Value_Assignment1</targetReference>
            </connector>
            <label>Run For All Accounts Selected</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>AccountChoices</name>
        <collectionReference>Get_Accounts</collectionReference>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>Account</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>PaymentNatureChoiceSet</name>
        <dataType>Multipicklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Core_MDF_Payment_Nature_nm__c</picklistField>
        <picklistObject>Core_MDF_Payment_Run__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <expression>MID(
  $Flow.FaultMessage,
  FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, $Flow.FaultMessage) + 
  LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;),
  FIND(&quot;. You can look up&quot;, $Flow.FaultMessage) - 
  (FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, $Flow.FaultMessage) + 
  LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;))
)</expression>
    </formulas>
    <formulas>
        <name>urlText</name>
        <dataType>String</dataType>
        <expression>&quot;/lightning/r/Core_MDF_Payment_Run__c/&quot; &amp; {!varPaymentRunRecord.Id} &amp; &quot;/view&quot;</expression>
    </formulas>
    <interviewLabel>Co-GTM Payment Run Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Co-GTM Payment Run Screen Flow Test</label>
    <loops>
        <name>Loop_Through_IUPGM_Records</name>
        <label>Loop Through IUPGM Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_IUPGM_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>collect_Account_Id_s</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Accounts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Payment_Run_Record</name>
        <label>Create Payment Run Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen_on_Insertion</targetReference>
        </faultConnector>
        <inputReference>varPaymentRunRecord</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Accounts</name>
        <label>Get Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Account_Based_Payment_Run</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>colAccountIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_IUPGM_Records</name>
        <label>Get IUPGM Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_IUPGM_Records_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_User_id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Active_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Program_nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CoGTM</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Role_nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_MDF_CCP_Internal_Co_GTM_Account_Manager</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_is_User_Active_ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_MDF_Int_Users_Partner_Geo_Mapping__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Account_Based_Payment_Run</name>
        <label>Account Based Payment Run</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Validate_inputs</targetReference>
        </connector>
