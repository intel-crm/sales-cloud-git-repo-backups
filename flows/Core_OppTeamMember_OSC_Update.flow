<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Core_OppTeamMember_OSC_Update workflow rule
Workflow rule description: Update Core_OSC_Snapshot upon team member creation.&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Opp_TM_OSC_UpdateFormula</name>
        <dataType>Number</dataType>
        <expression>IF($Record.User.Core_Is_OSC__c , 1,0)</expression>
        <scale>0</scale>
    </formulas>
    <label>Core_OppTeamMember_OSC_Update</label>
    <migratedFromWorkflowRuleName>Core_OppTeamMember_OSC_Update</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Field update for Core_OSC_Snapshot on OpportunityTeamMember object</description>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <inputAssignments>
            <field>Core_OSC_Snapshot__c</field>
            <value>
                <elementReference>Core_Opp_TM_OSC_UpdateFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
        <filterFormula>ISNULL( {!$Record.Core_OSC_Snapshot__c} )</filterFormula>
        <object>OpportunityTeamMember</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
