    <textTemplates>
        <name>PCC_SubmissionEmail</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;table class=&quot;ql-table-blob&quot; border=&quot;0&quot; width=&quot;550&quot;&gt;&lt;tbody&gt;&lt;tr valign=&quot;top&quot; height=&quot;400&quot;&gt;&lt;td style=&quot;background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;&quot;&gt;&lt;br&gt;&lt;br&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;Hello,&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;The following Change request has been submitted&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&lt;b&gt;Change Request Number:&lt;/b&gt; {!$Record.Name}&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;For more details, you can access it by clicking &lt;a href=&quot;{!PartnerRecordLink}&quot; style=&quot;white-space: pre;&quot;&gt; here  &lt;/a&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;&quot;&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;Thank you.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoPlainText&quot; style=&quot;color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;&quot;&gt;&lt;span style=&quot;font-family: sans-serif;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;&quot;&gt;&lt;span style=&quot;font-family: Calibri, sans-serif;&quot;&gt;_______________________________________________________________________&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;&quot;&gt;&lt;span style=&quot;color: rgb(102, 102, 102); font-family: &amp;quot;Intel Clear Light&amp;quot;, sans-serif; font-size: 7.5pt;&quot;&gt;This message contains Intel Confidential information and should be handled in accordance with your Non-Disclosure Agreement (NDA) with Intel. Access to this e-mail by anyone other than the intended recipient is unauthorized. If you are not the intended recipient (or responsible for delivery of the message to such person), you may not use, copy, distribute, or deliver this message or any part of its contents or take any action in reliance on it, and in such case, you should destroy this message.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;&quot;&gt;&lt;span style=&quot;color: rgb(102, 102, 102); font-family: &amp;quot;Intel Clear Light&amp;quot;, sans-serif; font-size: 7.5pt;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;&quot;&gt;&lt;span style=&quot;color: rgb(102, 102, 102); font-family: &amp;quot;Intel Clear Light&amp;quot;, sans-serif; font-size: 7.5pt;&quot;&gt;Copyright ©Intel Corporation. All rights reserved. Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054-1549 USA&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;, serif; font-size: 12pt;&quot;&gt;&lt;a href=&quot;http://www.intel.com/&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Intel Clear Light&amp;quot;, sans-serif; font-size: 7.5pt;&quot;&gt;www.intel.com&lt;/span&gt;&lt;/a&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(102, 102, 102); font-family: &amp;quot;Intel Clear Light&amp;quot;, sans-serif; font-size: 7.5pt;&quot;&gt;&amp;nbsp;(408) 765-8080&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</text>
