<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Share_Related_Opportunity</name>
        <label>Share Related Opportunity</label>
        <locationX>182</locationX>
        <locationY>839</locationY>
        <actionName>SWS_6SenseIntegrationBatch</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>accountId</name>
            <value>
                <elementReference>AccountID</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SWS_6SenseIntegrationBatch</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Does_Opportunity_Exist</name>
        <label>Does Opportunity Exist?</label>
        <locationX>314</locationX>
        <locationY>731</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Share_Related_Opportunity</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_It_Valid_Sharing</name>
        <label>Is It Valid Sharing?</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Get_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Share_the_Record</name>
            <conditionLogic>(1 AND 2 AND 3 AND 4) OR (1 AND 4 AND 5 )</conditionLogic>
            <conditions>
                <leftValueReference>AccountPrimaryCoverage</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Core_Account_Primary_Coverage__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Industry</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Defense and Space</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Industry</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Government</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Is_6Sense_Integration_BypassEnabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_6Sense_as_Valid</targetReference>
            </connector>
            <label>Share the Record</label>
        </rules>
        <rules>
            <name>Unshare_the_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Is_6Sense_Integration_Enabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_6Sense_As_Invalid</targetReference>
            </connector>
            <label>Unshare the Record</label>
        </rules>
    </decisions>
    <description>Flow to update 6Sense Enabled field to share record with Integration User</description>
    <environments>Default</environments>
    <interviewLabel>SWS Share Account With 6Sense {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SWS Share Account With 6Sense</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>314</locationX>
        <locationY>623</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_Opportunity_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>
            <numberValue>2.0</numberValue>
        </limit>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_6Sense_As_Invalid</name>
        <label>Update 6Sense As Invalid</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
        <inputAssignments>
            <field>Is_6Sense_Integration_Enabled__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_6Sense_as_Valid</name>
        <label>Update 6Sense as Valid</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
        <inputAssignments>
            <field>Is_6Sense_Integration_Enabled__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_It_Valid_Sharing</targetReference>
        </connector>
        <filterFormula>AND ( 
   OR(  
            ISCHANGED({!$Record.Industry}),
            ISCHANGED({!$Record.Is_6Sense_Integration_Enabled__c}),
            ISCHANGED({!$Record.Core_Account_Primary_Coverage__c}),
            ISCHANGED({!$Record.Core_Deactivated__c}),
            ISNEW()
    ),
    {!$Record.Core_Export_Compliance_Block__c} = false
 )</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>AccountID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>$Record.Id</elementReference>
        </value>
    </variables>
    <variables>
        <name>AccountPrimaryCoverage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Intel-led Account,Intel Covered</stringValue>
        </value>
    </variables>
</Flow>
