<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_Updatefields_While_Cloning</name>
        <label>Core_Updatefields_While_Cloning</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Country_Code_for_Leads_via_Grove_Outlook</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Fields_While_Cloning</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Core_Updatefields_While_Cloning_Entry_Formula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sales_Lead_Record_Type_Id</targetReference>
            </connector>
            <label>Update Fields While Cloning</label>
        </rules>
    </decisions>
    <decisions>
        <name>Update_Country_Code_for_Leads_via_Grove_Outlook</name>
        <label>Update Country Code for Leads via Grove Outlook</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Country_Code_via_Grove_Outlook</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>UpdateCountryCodeforLeadsviaGroveOutlook_EntryFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_value_from_Country_Code_Mapping</targetReference>
            </connector>
            <label>Update Country Code via Grove Outlook</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Core_Updatefields_While_Cloning_Entry_Formula</name>
        <dataType>Boolean</dataType>
        <expression>OR( AND( ISCLONE(), NOT(CONTAINS(LOWER({!$User.Username}), &quot;marketo&quot;)) , {!$Profile.Name} &lt;&gt; &quot;Integration&quot; ,{!$Profile.Name} &lt;&gt; &quot;Core Integration&quot;, {!$Profile.Name} &lt;&gt; &quot;Core_Integration_Minimal&quot;), AND( OR(ISNEW(),ISCLONE()), {!$Record.RecordType.Name} = &quot;Sales Lead&quot; ) )</expression>
    </formulas>
    <formulas>
        <name>UpdateCountryCodeforLeadsviaGroveOutlook_EntryFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF(AND(AND(LEN({!$Record.Country})&gt;1,{!$Record.Country}!=&apos;&apos;),{!$Record.RecordType.Name}=&apos;Sales Lead&apos; ) ,TRUE,FALSE)</expression>
    </formulas>
    <interviewLabel>SWS {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SWS_Flows_BeforeSave_Created</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Sales_Lead_Record_Type_Id</name>
        <label>Get Sales Lead Record Type Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>FieldUpdatesCore_Updatefields_While_Cloning</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sales Lead</stringValue>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </filters>
        <object>RecordType</object>
        <outputAssignments>
            <assignToReference>SalesLeadRecordTypeId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_value_from_Country_Code_Mapping</name>
        <label>Get value from Country Code Mapping</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Country_Code</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_Code__c</field>
            <operator>Contains</operator>
            <value>
                <elementReference>$Record.Core_CountryLabel__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_CountryLabel__c</elementReference>
            </value>
        </filters>
        <object>Core_Country_Code_Mapping__c</object>
        <outputAssignments>
            <assignToReference>v_3digitCountryCode</assignToReference>
            <field>ISO_Code__c</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <description>For the Lead WF 

&apos;Core_Updatefields_While_Cloning&apos;</description>
        <name>FieldUpdatesCore_Updatefields_While_Cloning</name>
        <label>FieldUpdatesCore_Updatefields_While_Cloning</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Country_Code_for_Leads_via_Grove_Outlook</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Lead_Priority__c</field>
            <value>
                <stringValue>Warm</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Lead_State__c</field>
            <value>
                <stringValue>In Pursuit</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>SalesLeadRecordTypeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SWS_Claimed_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Country_Code</name>
        <label>Update Country Code</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>CountryCode</field>
            <value>
                <elementReference>v_3digitCountryCode</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_Updatefields_While_Cloning</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>SalesLeadRecordTypeId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>holds the ISO Code for the related Country Name from Country Code Mapping</description>
        <name>v_3digitCountryCode</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
