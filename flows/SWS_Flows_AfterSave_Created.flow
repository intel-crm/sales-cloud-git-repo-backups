<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Lead_Conversion_Check</name>
        <label>Lead Conversion Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_LeadID_in_Registration_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Lead_Conversion</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Prospect__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_UpdateConversionCheckBox</targetReference>
            </connector>
            <label>Lead Conversion</label>
        </rules>
    </decisions>
    <decisions>
        <name>Update_LeadID_in_Registration_Records</name>
        <label>Update LeadID in Registration Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_LeadID_Records</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>0121J000000yaQ1QAI</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>012o0000000Tr9EAAS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Record_ID_from_the_Lead_Record</targetReference>
            </connector>
            <label>Update LeadID Records</label>
        </rules>
    </decisions>
    <description>combining

Lead Conversion Check
Update LeadID in Registration Records</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Converted_Date_Formula</name>
        <dataType>Date</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>SWS_Flows_AfterSave_Created {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SWS_Flows_AfterSave_Created</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Record_ID_from_the_Lead_Record</name>
        <label>Get Record ID from the Lead Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Registration_Record_from_email</targetReference>
        </connector>
        <filterLogic>1</filterLogic>
        <filters>
            <field>LastModifiedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Record.LastModifiedDate</elementReference>
            </value>
        </filters>
        <object>Lead</object>
        <outputAssignments>
            <assignToReference>var_Email</assignToReference>
            <field>Email</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>var_LeadID</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Registration_Record_from_email</name>
        <label>Get Registration Record from email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Registration_record_with_Lead_ID</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Email_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_Email</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PRM_Registration_Request__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Core_UpdateConversionCheckBox</name>
        <label>Core_UpdateConversionCheckBox</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_LeadID_in_Registration_Records</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Converted_Date__c</field>
            <value>
                <elementReference>Core_Converted_Date_Formula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Is_Converted_Chk__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Status_Pkt__c</field>
            <value>
                <stringValue>Converted</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Prospects__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Registration_record_with_Lead_ID</name>
        <label>Update Registration record with Lead ID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Email_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_Email</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>OwnerId</field>
        </inputAssignments>
        <object>PRM_Registration_Request__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Lead_Conversion_Check</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>var_Email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>var_LeadID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
