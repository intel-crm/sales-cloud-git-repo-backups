<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <description>LoginFlow_Banner</description>
        <name>LoginFlow_Banner</name>
        <dataType>String</dataType>
        <value>
            <stringValue>&lt;img src=&quot;/servlet/servlet.ImageServer?id=0151J000002ZLNd&amp;oid=00Dg0000006V1T1&amp;lastMod=1509033151000&quot; width=&quot;700&quot;&gt;</stringValue>
        </value>
    </constants>
    <constants>
        <description>LoginFlow_Forecast_Img_43_4</description>
        <name>LoginFlow_Forecast_Img_43_4</name>
        <dataType>String</dataType>
        <value>
            <stringValue>&lt;img src=&quot;/servlet/servlet.ImageServer?id=0151J000002ZIIz&amp;oid=00Dg0000006V1T1&amp;lastMod=1508913758000&quot;&gt;</stringValue>
        </value>
    </constants>
    <description>SalesCRM_Banner_WW43.4</description>
    <formulas>
        <description>LoginFlow_UserName</description>
        <name>LoginFlow_UserName</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName} + &apos; &apos; + {!$User.LastName}</expression>
    </formulas>
    <interviewLabel>SalesCRM_Banner_WW43.4 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SalesCRM_Banner_WW43.4</label>
    <processType>Flow</processType>
    <screens>
        <name>LoginFlow_SalesCRM_Banner_WW43_4</name>
        <label>LoginFlow_SalesCRM_Banner_WW43.4</label>
        <locationX>331</locationX>
        <locationY>230</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>LoginFlow_SalesCRMBanner</name>
            <fieldText>&lt;DIV ALIGN=&quot;CENTER&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;1&quot;&gt;{!LoginFlow_Banner}&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;CENTER&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;1&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Times New Roman&quot; STYLE=&quot;font-size:14px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Times New Roman&quot; STYLE=&quot;font-size:14px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt; &lt;BR/&gt; Hi {!LoginFlow_UserName} , &lt;/FONT&gt;&lt;/DIV&gt;&lt;BR/&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Times New Roman&quot; STYLE=&quot;font-size:14px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;B&gt;The 6 Quarter Product Schedule (6QPS) will be available in Salesforce on Thursday October 26th. This new functionality targets DCG Cloud and Communication Service Providers (CSP) Account Teams. We are piloting it with a few selected accounts, that will be contacted directly by DCG operations.&lt;/B&gt;&lt;/FONT&gt;&lt;/DIV&gt; &lt;BR/&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Times New Roman&quot; STYLE=&quot;font-size:14px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;6 Quarters Product Scheduling in Sales CRM (Salesforce) provides ramp up data used by the Cloud Tracker Tool (CTT) to manage the DCG Cloud business. Today Account Executives, with CSP opportunities, have to use both Sales CRM and CTT to track their pipeline. This enhancement provides a simple way for Field Sales to enter the first 6 quarters of product ramp data directly in the Sales CRM opportunity.&lt;/FONT&gt;&lt;/DIV&gt;&lt;BR/&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Times New Roman&quot; STYLE=&quot;font-size:14px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;B&gt;For all others, it is not mandatory to use the new 6QPS. This section can be minimized by just one click on the header.&lt;/B&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;CENTER&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;CENTER&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;{!LoginFlow_Forecast_Img_43_4}&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Times New Roman&quot; STYLE=&quot;font-size:14px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;BR/&gt;&lt;B&gt;More information, &lt;/B&gt;&lt;FONT COLOR=&quot;#0000FF&quot;&gt;&lt;A HREF=&quot;https://soco.intel.com/docs/DOC-2392222&quot; TARGET=&quot;_blank&quot;&gt;&lt;B&gt;&lt;U&gt;Trainings&lt;/U&gt;&lt;/B&gt;&lt;/A&gt;&lt;/FONT&gt;&lt;B&gt; and additional communications can be found at &lt;/B&gt;&lt;FONT COLOR=&quot;#0000FF&quot;&gt;&lt;A HREF=&quot;https://soco.intel.com/groups/cloud-crm&quot; TARGET=&quot;_blank&quot;&gt;&lt;B&gt;&lt;U&gt;SMG Sales CRM&lt;/U&gt;&lt;/B&gt;&lt;/A&gt;&lt;/FONT&gt;&lt;B&gt; Inside Blue group.For any additional questions, please contact &lt;/B&gt;&lt;FONT COLOR=&quot;#0000FF&quot;&gt;&lt;A HREF=&quot;mailto:parsa.naderi@intel.com&quot; TARGET=&quot;_blank&quot;&gt;&lt;B&gt;&lt;U&gt;Parsa Naderi&lt;/U&gt;&lt;/B&gt;&lt;/A&gt;&lt;B&gt;&lt;U&gt;.&lt;/U&gt;&lt;/B&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/DIV&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <startElementReference>LoginFlow_SalesCRM_Banner_WW43_4</startElementReference>
    <status>Obsolete</status>
</Flow>
