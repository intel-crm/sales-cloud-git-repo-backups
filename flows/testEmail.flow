    <decisions>
        <name>Is_Partner_or_PSAM</name>
        <label>Is Partner or PSAM?</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_To_Partner_Only</targetReference>
            </connector>
            <label>Is Partner</label>
        </rules>
        <rules>
            <name>Is_PSAM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Psam_Or_Partner_Email</targetReference>
            </connector>
            <label>Is PSAM</label>
        </rules>
    </decisions>
    <environments>Default</environments>
