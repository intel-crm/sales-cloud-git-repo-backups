    <decisions>
        <name>checkRenewed_Description</name>
        <label>checkRenewed Description</label>
        <locationX>502</locationX>
        <locationY>374</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RenewedDescriptionNotNull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loopOnLicesnes.Sales_Renewed_Description__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateLogtable</targetReference>
            </connector>
            <label>RenewedDescriptionNotNull</label>
        </rules>
        <rules>
            <name>RenewedDescriptionNull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loopOnLicesnes.Sales_Renewed_Description__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateLogTable2</targetReference>
            </connector>
            <label>RenewedDescriptionNull</label>
        </rules>
    </decisions>
