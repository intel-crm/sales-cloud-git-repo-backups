<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Adjustment Notification and Owner Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Adjustment Notification and Owner Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Test</name>
        <label>Test</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <inputAssignments>
            <field>Core_MDF_Comments_Txt__c</field>
            <value>
                <stringValue>flow testing</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Test</targetReference>
        </connector>
        <filterFormula>AND ((ISPICKVAL({!$Record.Core_MDF_Adjustment_Claim_Nbr__r.Core_MDF_Type_Txt__c},&apos;Adjustment&apos;)) , (!(ISPICKVAL({!$Record.Core_MDF_Reason_Cd__c},&apos;Escalation&apos;))))</filterFormula>
        <object>Core_MDF_Adjustment_Request__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
