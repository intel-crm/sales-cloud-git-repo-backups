        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>On_Status_change_BRE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Pricing_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Intel Field Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Further Intel Review</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Billing_Start_Day_change_BRE</targetReference>
            </connector>
            <label>On Status change BRE</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>BillingStartDate_After_BRE</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Record.Pricing_Approved_Start_Date_Dup_Dt__c}), MONTH({!$Record.Pricing_Approved_Start_Date_Dup_Dt__c}), DAY({!$Record.Pricing_Approved_Start_Date_Dup_Dt__c}) - {!No_O_Days_for_BRE})</expression>
