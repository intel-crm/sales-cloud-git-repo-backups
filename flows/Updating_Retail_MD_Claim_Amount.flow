<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Adding_claim_record_in_list_for_updating</name>
        <label>Adding claim record in list for updating</label>
        <locationX>1361</locationX>
        <locationY>387</locationY>
        <assignmentItems>
            <assignToReference>ClaimListToBeUpdated</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ClaimRec</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_claim_amount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Adding_claim_record_to_list_for_updatin_amount</name>
        <label>Adding claim record to list for updatin amount</label>
        <locationX>1078</locationX>
        <locationY>115</locationY>
        <assignmentItems>
            <assignToReference>ClaimRecordsToBeUpdatedWithReducedAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ClaimRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Looping_Claim_list_for_its_size_0</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Count all the claims associated with the payment Id</description>
        <name>Count_all_the_claims</name>
        <label>Count all the claims</label>
        <locationX>480</locationX>
        <locationY>320</locationY>
        <assignmentItems>
            <assignToReference>CountOfClaims</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Looping_Claim_list_for_its_size</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Getting total No of claims associated with that payment Id</description>
        <name>Getting_total_No_of_claims</name>
        <label>Getting total No of claims</label>
        <locationX>656</locationX>
        <locationY>56</locationY>
        <assignmentItems>
            <assignToReference>TotalNoOfClaims</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CountOfClaims</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Looping_Claim_list_for_its_size_0</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reducing_amount_from_claim</name>
        <label>Reducing amount from claim</label>
        <locationX>1357</locationX>
        <locationY>228</locationY>
        <assignmentItems>
            <assignToReference>ClaimRec.Amount</assignToReference>
            <operator>Subtract</operator>
            <value>
                <elementReference>Reductionamountfromclaim</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Adding_claim_record_in_list_for_updating</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>If the claim amount is greater than reduced amount, then we&apos;ll add this claim to another list from where we can directly reduce the amount.</description>
        <name>If_claim_amount_is_greater_than_reduced_amount</name>
        <label>If claim amount is greater than reduced amount</label>
        <locationX>1344</locationX>
        <locationY>61</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Check_if_claim_amount_is_greater_than_reduced_amount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimRecord.Amount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Reductionamountfromclaim</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Adding_claim_record_to_list_for_updatin_amount</targetReference>
            </connector>
            <label>Check if claim amount is greater than reduced amount</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_claim_list_is_not_null</name>
        <label>If claim list is not null</label>
        <locationX>266</locationX>
        <locationY>54</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Checking_claim_list</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AllClaimRecordsOfPaymentId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Looping_Claim_list_for_its_size</targetReference>
            </connector>
            <label>Checking claim list</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_claim_list_to_be_updated_is_not_null</name>
        <label>If claim list to be updated is not null</label>
        <locationX>777</locationX>
        <locationY>244</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Checkin_claim_list_to_be_updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimRecordsToBeUpdatedWithReducedAmount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_claim_amount</targetReference>
            </connector>
            <label>Checkin claim list to be updated</label>
        </rules>
    </decisions>
    <formulas>
        <name>Reductionamountfromclaim</name>
        <dataType>Number</dataType>
        <expression>{!ReducedPaidAmountValue}/{!TotalNoOfClaims}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Updating Retail MD Claim Amount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Updating Retail MD Claim Amount</label>
    <loops>
        <name>Looping_Claim_list_for_its_size</name>
        <label>Looping Claim list for its size</label>
        <locationX>481</locationX>
        <locationY>59</locationY>
        <assignNextValueToReference>ClaimRecord</assignNextValueToReference>
        <collectionReference>AllClaimRecordsOfPaymentId</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Count_all_the_claims</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Getting_total_No_of_claims</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Looping_Claim_list_for_its_size_0</name>
        <label>Looping Claim list to check its amount</label>
        <locationX>783</locationX>
        <locationY>56</locationY>
        <assignNextValueToReference>ClaimRecord</assignNextValueToReference>
        <collectionReference>AllClaimRecordsOfPaymentId</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>If_claim_amount_is_greater_than_reduced_amount</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>If_claim_list_to_be_updated_is_not_null</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Update_claim_amount</name>
        <label>Update claim amount</label>
        <locationX>1011</locationX>
        <locationY>242</locationY>
        <assignNextValueToReference>ClaimRec</assignNextValueToReference>
        <collectionReference>ClaimRecordsToBeUpdatedWithReducedAmount</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Reducing_amount_from_claim</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Claim_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Core_MDF_Get_claim_records</name>
        <label>Get claim records</label>
        <locationX>161</locationX>
        <locationY>52</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_claim_list_is_not_null</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Payment_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>PaymentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Payment</stringValue>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <outputReference>AllClaimRecordsOfPaymentId</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Amount</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Claim_Records</name>
        <label>Update Claim Records</label>
        <locationX>1020</locationX>
        <locationY>487</locationY>
        <inputReference>ClaimListToBeUpdated</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>51</locationY>
        <connector>
            <targetReference>Core_MDF_Get_claim_records</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>AllClaimRecordsOfPaymentId</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>ClaimListToBeUpdated</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>ClaimRec</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>ClaimRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>ClaimRecordsToBeUpdatedWithReducedAmount</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>ClaimRecordToBeAddedToListToUpdateAmount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>PartnerFundClaim</objectType>
    </variables>
    <variables>
        <name>CountOfClaims</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>PaymentId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>ReducedPaidAmountValue</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <description>Total no of claims associated with that payment</description>
        <name>TotalNoOfClaims</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
