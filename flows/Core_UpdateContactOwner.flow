    <description>Updates the inquiry owner to contact owner when contact owner changes</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>Text([Contact].Salutation) +&quot; &quot;+ [Contact].FirstName +&quot; &quot;+ [Contact].LastName </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_8_myRule_4_A1_5278184231</name>
        <dataType>String</dataType>
        <expression>Text({!myVariable_current.Salutation}) +&quot; &quot;+ {!myVariable_current.FirstName} +&quot; &quot;+ {!myVariable_current.LastName}</expression>
    </formulas>
