<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>This assignment will assign Account PSG Tier value to PSG-Tier 4 whenever the account record is triggered and Account PSG Tier field is blank</description>
        <name>Assign_Account_tier</name>
        <label>Assign Account tier</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_Account_PSG_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>PSG-Tier 4</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <description>This Flow will assign account PSG Tier field value if the account is PSG and PSG Tier field is Empty whenever record is created or updated.
Migrated from the: Update Default PSG Tier workflow rule
Workflow rule description: &quot;</description>
    <environments>Default</environments>
    <interviewLabel>Update Default PSG Tier {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Default PSG Tier</label>
    <migratedFromWorkflowRuleName>Update Default PSG Tier</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Account_tier</targetReference>
        </connector>
        <filterFormula>AND (   ISBLANK(TEXT({!$Record.Core_Account_PSG_Tier__c})),{!$Record.Core_PSG_Account__c} = true)</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
