                <rightValue>
                    <stringValue>Developer Zone Premier(CNDA required)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_IPA_Entitlement</targetReference>
            </connector>
            <label>Create IPA Entitlement</label>
        </rules>
    </decisions>
    <decisions>
        <name>IPA_Account</name>
