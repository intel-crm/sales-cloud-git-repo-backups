            <conditions>
                <leftValueReference>Get_Contact_Entitlement_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CE_Record_status</targetReference>
            </connector>
            <label>CE Record found</label>
        </rules>
    </decisions>
