    <assignments>
        <name>CE_Record_output</name>
        <label>CE Record output</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>CErecordoutput</assignToReference>
            <operator>Assign</operator>
