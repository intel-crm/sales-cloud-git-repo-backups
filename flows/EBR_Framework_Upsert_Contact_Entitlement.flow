        <locationX>644</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Create_Contact_Entitlement</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CE_Record_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact_Entitlement_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CE_Record_status</targetReference>
            </connector>
            <label>CE Record found</label>
        </rules>
    </decisions>
