<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Record_Type_Change</name>
        <label>Check Record Type Change</label>
        <locationX>608</locationX>
        <locationY>270</locationY>
        <defaultConnector>
            <targetReference>If_Region_Is_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Record Type Change</defaultConnectorLabel>
        <rules>
            <name>Record_Type_Changed_To_Intel_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Account_Record_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Account_Record_Type__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Group_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Group_ID_For_Record_Type_Change</targetReference>
            </connector>
            <label>Record Type Changed To Intel Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Region_Is_Changed</name>
        <label>If Region Is Changed</label>
        <locationX>608</locationX>
        <locationY>530</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Region_Changed_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Geo__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Group_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Global_Name_and_Id_To_Null</targetReference>
            </connector>
            <label>Region Changed True</label>
        </rules>
        <rules>
            <name>Region_Changed_False_Group_Name_Updated_Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Geo__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Group_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Group_Name__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Group_ID</targetReference>
            </connector>
            <label>Region Changed False &amp; Group Name Updated &amp; Not Null</label>
        </rules>
        <rules>
            <name>Group_Name_Is_Updated_to_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Group_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Group_Name__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Group_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Group_Id</targetReference>
            </connector>
            <label>Group Name Is Updated to Null</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>UCD ACM Account Umbrella Grouping {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UCD ACM Account Umbrella Grouping</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Group_ID</name>
        <label>Get Group ID</label>
        <locationX>619</locationX>
        <locationY>705</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Populate_Group_ID</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Group_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Group_Name__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Account_Umbrella_Grouping__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Group_Id__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Group_ID_For_Record_Type_Change</name>
        <label>Get Group ID For Record Type Change</label>
        <locationX>350</locationX>
        <locationY>400</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Populate_Group_ID_For_Record_Type_Change</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Group_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Group_Name__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Account_Umbrella_Grouping__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Group_Id__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Populate_Group_ID</name>
        <label>Populate Group ID</label>
        <locationX>618</locationX>
        <locationY>825</locationY>
        <inputAssignments>
            <field>Core_Group_Id__c</field>
            <value>
                <elementReference>Get_Group_ID.Core_Group_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Populate_Group_ID_For_Record_Type_Change</name>
        <label>Populate Group ID For Record Type Change</label>
        <locationX>350</locationX>
        <locationY>530</locationY>
        <inputAssignments>
            <field>Core_Group_Id__c</field>
            <value>
                <elementReference>Get_Group_ID_For_Record_Type_Change.Core_Group_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Remove_Group_Id</name>
        <label>Remove Group Id</label>
        <locationX>877</locationX>
        <locationY>405</locationY>
        <inputAssignments>
            <field>Core_Group_Id__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Global_Name_and_Id_To_Null</name>
        <label>Update Global Name and Id To Null</label>
        <locationX>385</locationX>
        <locationY>393</locationY>
        <inputAssignments>
            <field>Core_Group_Id__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Group_Name__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>490</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Check_Record_Type_Change</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Account</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
