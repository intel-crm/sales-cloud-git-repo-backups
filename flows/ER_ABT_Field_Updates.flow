<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Verify_Existing_ACM_Queue_Records</name>
        <label>Verify Existing ACM Queue Records</label>
        <locationX>270</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Create_ACM_Integration_Message_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_with_Success_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_ACM_Integration_Message_Queue_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Existing_ACM_Integration_Message_Queue_Records.Message_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Success</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Existing_Record_to_New</targetReference>
            </connector>
            <label>Record with Success Status</label>
        </rules>
        <rules>
            <name>Record_with_New_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_ACM_Integration_Message_Queue_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Existing_ACM_Integration_Message_Queue_Records.Message_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <label>Record with New Status</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Required_Business_Types</name>
        <label>Verify Required Business Types</label>
        <locationX>512</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Required_Business_Types</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Types__r.Business_Type_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Web Order Management</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Business_Types__r.Business_Type_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Electronic Services Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Business_Types__r.Business_Type_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EPS Verified Company</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_ACM_Integration_Message_Queue_Records</targetReference>
            </connector>
            <label>Required Business Types</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>ER_ABT Field Updates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ER_ABT Field Updates</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_ACM_Integration_Message_Queue</name>
        <label>Create ACM Integration Message Queue</label>
        <locationX>490</locationX>
        <locationY>647</locationY>
        <inputAssignments>
            <field>Content_Type__c</field>
            <value>
                <stringValue>A&amp;E Account Integration</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Content__c</field>
            <value>
                <elementReference>$Record.Account__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Custom_Filter__c</field>
            <value>
                <elementReference>$Record.Account__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Message_Status__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Module_Name__c</field>
            <value>
                <stringValue>A&amp;E ACM Integration</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Queue_Type__c</field>
            <value>
                <stringValue>Outbound</stringValue>
            </value>
        </inputAssignments>
        <object>ACM_Integration_Message_Queue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_ACM_Integration_Message_Queue_Records</name>
        <label>Get Existing ACM Integration Message Queue Records</label>
        <locationX>270</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Verify_Existing_ACM_Queue_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Content_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>A&amp;E Account Integration</stringValue>
            </value>
        </filters>
        <filters>
            <field>Custom_Filter__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Module_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>A&amp;E ACM Integration</stringValue>
            </value>
        </filters>
        <filters>
            <field>Queue_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Outbound</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ACM_Integration_Message_Queue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Existing_Record_to_New</name>
        <label>Update Existing Record to New</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Existing_ACM_Integration_Message_Queue_Records.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Message_Status__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <object>ACM_Integration_Message_Queue__c</object>
    </recordUpdates>
    <start>
        <locationX>386</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Verify_Required_Business_Types</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <object>Account_Business_Types__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
