<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Approved_AQR</name>
        <label>Approved AQR</label>
        <locationX>242</locationX>
        <locationY>384</locationY>
        <actionName>PRM_OPIDProcessUtility</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>approvedAqrRecords</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>PRM_OPIDProcessUtility</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>IntelAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Intel Account</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Intel_Account_Check</name>
        <label>Intel Account Check</label>
        <locationX>374</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Intel_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Requested_Account__r.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>IntelAccount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_AQR</targetReference>
            </connector>
            <label>Intel Account</label>
        </rules>
    </decisions>
    <description>Flow that will call an apex class for associating Non-ipa account to parents associated opid</description>
    <environments>Default</environments>
    <interviewLabel>Non IPA OPID Association {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OPID Intel Association Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>Account_Create_Request__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Associate_to_OPID</name>
            <connector>
                <targetReference>Intel_Account_Check</targetReference>
            </connector>
            <label>Associate to OPID</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
