<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adding the Content Link Single Variable created in the last step to the collection variable</description>
        <name>Add_New_Content_Doc_Link_To_Collection</name>
        <label>Add New Content Doc Link To Collection</label>
        <locationX>138</locationX>
        <locationY>863</locationY>
        <assignmentItems>
            <assignToReference>NewDocumentsLinkToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ContentDocumentLinkTemporary</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_On_Files</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assigning Content Document id which is basically the Unique File Id and Linked Entity id which in our case is the opportunity id.</description>
        <name>AssignLinkProperties</name>
        <label>AssignLinkProperties</label>
        <locationX>138</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>ContentDocumentLinkTemporary.ContentDocumentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_On_Files.ContentDocument.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ContentDocumentLinkTemporary.LinkedEntityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ContentDocumentLinkTemporary.Visibility</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>AllUsers</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_New_Content_Doc_Link_To_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checking if the associated Deal Reg has any existing Files or Not. we only need to move forward if any existing files are there.</description>
        <name>File_Exists</name>
        <label>File Exists?</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Deal_Reg_Files</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_On_Files</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Sync Attachment From Deal Reg With Opportunity On Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sync Attachment From Deal Reg With Opportunity On Create</label>
    <loops>
        <description>Looping on all existing files present in the deal reg</description>
        <name>Loop_On_Files</name>
        <label>Loop On Files</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <collectionReference>Get_Deal_Reg_Files</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AssignLinkProperties</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_New_Document_Links</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_New_Document_Links</name>
        <label>Create New Document Links</label>
        <locationX>50</locationX>
        <locationY>1055</locationY>
        <inputReference>NewDocumentsLinkToCreate</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Query all Existing Content Document Links Records for this Deal Reg</description>
        <name>Get_Deal_Reg_Files</name>
        <label>Get Deal Reg Files</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>File_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Respective_Deal_Reg_Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Getting respective deal reg associated with the opportunity</description>
        <name>Get_Respective_Deal_Reg_Record</name>
        <label>Get Respective Deal Reg Record</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Deal_Reg_Files</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Design_Registration_Id__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Design_Registration__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Respective_Deal_Reg_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Opportunity_Coverage_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Partner-Led Opportunity</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>ContentDocumentLinkTemporary</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentDocumentLink</objectType>
    </variables>
    <variables>
        <name>NewDocumentsLinkToCreate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentDocumentLink</objectType>
    </variables>
</Flow>
