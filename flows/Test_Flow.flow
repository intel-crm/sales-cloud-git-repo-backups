<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Test_assignment</name>
        <label>Test assignment</label>
        <locationX>865</locationX>
        <locationY>238</locationY>
        <assignmentItems>
            <assignToReference>Test_display_loop.Pricing_Quote_Line_Number__c</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>TestTextTemplate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Test_display_loop</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Pricing_Test</name>
        <label>Pricing_Test</label>
        <locationX>187</locationX>
        <locationY>267</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Test_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QuoteLinerecord.Pricing_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_approved_quote_lines</targetReference>
            </connector>
            <label>Test Outcome</label>
        </rules>
    </decisions>
    <interviewLabel>Test Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test Flow</label>
    <loops>
        <name>Test_display_loop</name>
        <label>Test display loop</label>
        <locationX>639</locationX>
        <locationY>259</locationY>
        <collectionReference>Get_approved_quote_lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Test_assignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>test_header</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_approved_quote_lines</name>
        <label>Get approved quote lines</label>
        <locationX>425</locationX>
        <locationY>281</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Test_display_loop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Pricing_Quote_Program_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Tender</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SBQQ__QuoteLine__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Pricing_Quote_Line_Number__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>test_header</name>
        <label>test header</label>
        <locationX>844</locationX>
        <locationY>30</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>showtext</name>
            <fieldText>&lt;p&gt;{!DisplayTextTemplate}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Pricing_Test</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>dislaytexttemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;quote line numbers====&amp;gt; {!Test_display_loop.Pricing_Quote_Line_Number__c}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>displaytext</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;{!DisplayTextTemplate}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>DisplayTextTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;{!Test_display_loop.Pricing_Quote_Line_Number__c}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>TestTextTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;{!Test_display_loop.Pricing_Quote_Line_Number__c}           {!Test_display_loop.Pricing_Status_Nm__c}&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>quotelinenumberlist</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>QuoteLinerecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SBQQ__QuoteLine__c</objectType>
    </variables>
</Flow>
