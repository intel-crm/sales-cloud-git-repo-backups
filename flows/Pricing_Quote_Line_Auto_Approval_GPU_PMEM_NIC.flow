<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Pricing_FSE_Approve_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>FSE Approve</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_FSE_Reject_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>FSE Reject</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_RPM_Approve_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>RPM Approve</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_RPM_Create_Deal_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>RPM Create Deal</stringValue>
        </value>
    </constants>
    <constants>
        <name>Pricing_RPM_Reject_Action</name>
        <dataType>String</dataType>
        <value>
            <stringValue>RPM Reject</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_for_Write_In_Product_for_PIFR_Approval_GPU</name>
        <label>Check for Write In Product for PIFR Approval GPU</label>
        <locationX>182</locationX>
        <locationY>611</locationY>
        <defaultConnector>
            <targetReference>RPM_Approval_for_PIFR_GPU_PMEM_NIC</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_not_Write_in_product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Other_Product_Nm__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Deal_for_PIFR_GPU_PMEM_NIC</targetReference>
            </connector>
            <label>is not Write in product</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricing_Check_for_FSE_Action</name>
        <label>Check for FSE Action</label>
        <locationX>512</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pricing_GPU_PMEM_NIC</name>
            <conditionLogic>1 AND (2 OR 3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Additional_Comments_Txt__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>#autoapprove</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_Program_Type_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Data Center GPU</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_Program_Type_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Optane™ PMem</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_Program_Type_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Optane™ SSD</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PIFR_Approval_GPU_PMEM_NIC</targetReference>
            </connector>
            <label>GPU PMEM NIC</label>
        </rules>
        <rules>
            <name>Auto_Reject</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Pricing_FSE_Reject_Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>#autoreject</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_PIFR_Rejection</targetReference>
            </connector>
            <label>Auto Reject</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricing_Check_for_QuoteLine_Status</name>
        <label>Check for QuoteLine Status</label>
        <locationX>809</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pending_Intel_Field_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Intel Field Review</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pricing_Check_for_FSE_Action</targetReference>
            </connector>
            <label>Pending Intel Field Review</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Quote Line Auto Approval GPU PMEM NIC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Line Auto Approval GPU PMEM NIC</label>
    <orchestratedStages>
        <name>Create_Deal_for_PIFR_GPU_PMEM_NIC</name>
        <label>Create Deal for PIFR GPU PMEM NIC</label>
        <locationX>50</locationX>
        <locationY>719</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Step_to_perform_Create_Deal_on_PIFR_Quoteline_GPU</name>
            <actionName>Pricing_auto_launch_flow_where_platform_event_calling</actionName>
            <actionType>stepBackground</actionType>
            <canAssigneeEdit>false</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>Pricing_Action</name>
                <value>
                    <elementReference>Pricing_RPM_Create_Deal_Action</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
