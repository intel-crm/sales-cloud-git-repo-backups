    <interviewLabel>Call Script 2015 Q4 Profiling/Survey - KA FF - General {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Call Script 2015 Q4 Profiling/Survey - KA FF - General</label>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Update_Response</name>
        <label>Update Response</label>
        <locationX>289</locationX>
        <locationY>210</locationY>
        <connector>
            <targetReference>Call_Script_Complete</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>callScriptResponseId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Answer_1__c</field>
            <value>
                <elementReference>Any_support_needed_from_Intel_to_help_you_with_your_business_project</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Answer_2__c</field>
            <value>
                <elementReference>KA_Findings_Outcome_of_the_Call2</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Question_1__c</field>
            <value>
                <stringValue>Any support needed from Intel to help you with your business/project this quarter?</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Question_2__c</field>
            <value>
                <stringValue>KA Findings - Outcome of the Call</stringValue>
            </value>
        </inputAssignments>
        <object>Core_Call_Script_Response__c</object>
    </recordUpdates>
    <screens>
        <name>Call_Script_Complete</name>
        <label>Call Script Complete</label>
        <locationX>112</locationX>
        <locationY>332</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Thank_You</name>
            <fieldText>Thank you for completing the call script questionnaire! Responses have been saved. You may close this window.</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Profiling_Survey_KA_Findings_and_Forecast_DIY_Profiling</name>
        <label>Profiling / Survey - KA Findings and Forecast - DIY Profiling</label>
        <locationX>105</locationX>
        <locationY>208</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Update_Response</targetReference>
        </connector>
        <fields>
            <name>Any_support_needed_from_Intel_to_help_you_with_your_business_project</name>
            <choiceReferences>Yes</choiceReferences>
            <choiceReferences>No</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Any support needed from Intel to help you with your business/project this quarter?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Blank3</name>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>KA_Findings_Outcome_of_the_Call2</name>
            <fieldText>KA Findings - Outcome of the Call</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <startElementReference>Create_Response_Record_if_Necessary</startElementReference>
    <status>Active</status>
    <subflows>
        <name>Create_Response_Record_if_Necessary</name>
        <label>Create Response Record if Necessary</label>
        <locationX>94</locationX>
        <locationY>100</locationY>
        <connector>
            <targetReference>Profiling_Survey_KA_Findings_and_Forecast_DIY_Profiling</targetReference>
        </connector>
        <flowName>Core_Call_Script_Response_Creation_if_None_Exists</flowName>
        <inputAssignments>
            <name>campaignId</name>
            <value>
                <elementReference>campaignId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>contactId</name>
            <value>
