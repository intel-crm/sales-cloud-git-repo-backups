            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BudgetShareRec.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_BudgetShareRec_to_BudgetShareList</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>check_if_external_PGM</name>
        <label>check if external PGM</label>
        <locationX>900</locationX>
        <locationY>494</locationY>
        <defaultConnector>
            <targetReference>Loop_for_PGM_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Dafault Outcome</defaultConnectorLabel>
        <rules>
            <name>is_External_PGM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_for_PGM_Records.Core_MDF_Type_of_Access__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>External</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isIgnoreExtBudgetSharing</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>so_BudgetRecord.Core_MDF_Budget_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Released</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_BudgetShareRec_Values</targetReference>
            </connector>
            <label>is External PGM</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Record_List_have_records</name>
        <label>Check if Record List have records</label>
        <locationX>1006</locationX>
        <locationY>50</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>BudgetShareList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_PMB_Share_Record</targetReference>
            </connector>
            <label>present</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Budget Sharing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Budget Sharing flow</label>
    <loops>
        <name>Loop_for_PGM_Records</name>
        <label>Loop for PGM Records</label>
        <locationX>899</locationX>
        <locationY>207</locationY>
        <collectionReference>PGM_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
