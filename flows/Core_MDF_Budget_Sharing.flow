            </value>
        </filters>
        <object>Core_MDF_ChannelProgram__mdt</object>
        <outputAssignments>
            <assignToReference>isIgnoreExtBudgetSharing</assignToReference>
            <field>Core_MDF_Ignore_External_Budget_Sharing__c</field>
        </outputAssignments>
    </recordLookups>
    <start>
