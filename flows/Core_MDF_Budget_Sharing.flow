            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BudgetShareRec.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BudgetShareRec.AccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_for_PGM_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_BudgetShareRec_Values</name>
        <label>Assign BudgetShareRec Values</label>
        <locationX>1633</locationX>
