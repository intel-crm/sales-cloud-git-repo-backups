    <decisions>
        <name>Check_Has_Payments</name>
        <label>Pending Payments Found?</label>
        <locationX>578</locationX>
        <locationY>890</locationY>
        <defaultConnector>
            <targetReference>Set_No_Payments_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Pending Payments</defaultConnectorLabel>
        <rules>
            <name>Has_Pending_Payments</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPendingPayments</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Init_Edited_Payments</targetReference>
            </connector>
            <label>Has Pending Payments</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Payment_Made_On</name>
        <label>Payment Made On Entered?</label>
        <locationX>270</locationX>
        <locationY>1838</locationY>
        <defaultConnector>
            <targetReference>Set_Payment_Date_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Payment Made On Missing</defaultConnectorLabel>
        <rules>
            <name>Payment_Made_On_Entered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Selected_Payments.Core_MDF_Payment_Made_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Prepare_Payment_Update</targetReference>
            </connector>
            <label>Payment Made On Entered</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Run_Eligible</name>
        <label>Payment Run Eligible?</label>
        <locationX>842</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Set_Run_Not_Eligible_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Eligible</defaultConnectorLabel>
        <rules>
            <name>Run_Is_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSelectedPaymentRun.Core_MDF_Program_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CoGTM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSelectedPaymentRun.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Pending_Payments</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Run_Selected</name>
        <label>Payment Run Selected?</label>
        <locationX>1106</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Set_Run_Required_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Selected</defaultConnectorLabel>
        <rules>
            <name>Run_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPaymentRunId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Selected_Payment_Run</targetReference>
            </connector>
            <label>Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Selection</name>
        <label>Payments Selected?</label>
        <locationX>314</locationX>
        <locationY>1622</locationY>
        <defaultConnector>
            <targetReference>Set_Selection_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nothing Selected</defaultConnectorLabel>
        <rules>
            <name>Payments_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSelectedPayments</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Selected_Payments</targetReference>
            </connector>
            <label>Payments Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_User_Access</name>
        <label>Check User Access</label>
        <locationX>1370</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Screen_No_Access</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Access</defaultConnectorLabel>
        <rules>
            <name>User_Has_Access</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Select_Run</targetReference>
            </connector>
            <label>User Has Access</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Volume</name>
        <label>Check Volume</label>
        <locationX>138</locationX>
        <locationY>2180</locationY>
        <defaultConnector>
            <targetReference>Update_Selected_Payments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Within Threshold (Sync)</defaultConnectorLabel>
        <rules>
            <name>Above_Threshold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSelectedCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>fSyncThreshold</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_Async_Update</targetReference>
            </connector>
            <label>Above Threshold (Async)</label>
        </rules>
    </decisions>
    <description>This is a screen flow to update payment status to Paid for bulk records.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmSaveErrorMessage</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS($Flow.FaultMessage, &quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;),
  MID(
    $Flow.FaultMessage,
    FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, $Flow.FaultMessage) + LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;),
    IF(
      CONTAINS($Flow.FaultMessage, &quot;. You can look up&quot;),
      FIND(&quot;. You can look up&quot;, $Flow.FaultMessage) -
        (FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, $Flow.FaultMessage) + LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;)),
      LEN($Flow.FaultMessage)
    )
  ),
  $Flow.FaultMessage
)</expression>
    </formulas>
    <formulas>
        <name>fSyncThreshold</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!rcdSyncThresholdConfig.Core_MDF_Value_Txt__c}), 50, VALUE({!rcdSyncThresholdConfig.Core_MDF_Value_Txt__c}))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Bulk Update Payment Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Bulk Update Payment Status</label>
    <loops>
        <name>Loop_Capture_Selected_Ids</name>
        <label>Loop Capture Selected Ids</label>
        <locationX>314</locationX>
        <locationY>1322</locationY>
        <collectionReference>varSelectedPayments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Selected_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Selection</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Selected_Payments</name>
        <label>Loop Selected Payments</label>
        <locationX>50</locationX>
        <locationY>1730</locationY>
        <collectionReference>varSelectedPayments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Payment_Made_On</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Sync_Threshold_Config</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Pending_Payments</name>
        <label>Get Pending Payments</label>
        <locationX>578</locationX>
        <locationY>782</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Has_Payments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Payment_Run_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varPaymentRunId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Payment_Status_Txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Payment</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Payment__c</object>
        <outputReference>varPendingPayments</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Core_MDF_AccountCompany_Txt__c</queriedFields>
        <queriedFields>Core_MDF_Paid_Amt__c</queriedFields>
        <queriedFields>Core_MDF_Currency_Cd_Txt__c</queriedFields>
        <queriedFields>Core_MDF_Geo_Txt__c</queriedFields>
        <queriedFields>Core_MDF_Payment_Status_Txt__c</queriedFields>
        <queriedFields>Core_MDF_Payment_Made_Dt__c</queriedFields>
        <queriedFields>Core_MDF_EFT_Nbr__c</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Get_Selected_Payment_Run</name>
        <label>Get Selected Payment Run</label>
        <locationX>842</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Run_Eligible</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varPaymentRunId</elementReference>
            </value>
        </filters>
        <object>Core_MDF_Payment_Run__c</object>
        <outputReference>varSelectedPaymentRun</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Core_MDF_Program_Txt__c</queriedFields>
        <queriedFields>Core_MDF_Status_Txt__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Sync_Threshold_Config</name>
        <label>Get Sync Threshold Config</label>
        <locationX>138</locationX>
        <locationY>2072</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Selected_Count</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Save_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>BULK_PAYMENT_SYNC_THRESHOLD</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Custom_Label_Configration__mdt</object>
        <outputReference>rcdSyncThresholdConfig</outputReference>
        <queriedFields>Core_MDF_Value_Txt__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Selected_Payments</name>
        <label>Update Selected Payments</label>
        <locationX>50</locationX>
        <locationY>2288</locationY>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Save_Error</targetReference>
        </faultConnector>
        <inputReference>varPaymentsToUpdate</inputReference>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
    <screens>
        <name>Screen_Async_Submitted</name>
        <label>Request Submitted</label>
        <locationX>314</locationX>
        <locationY>2396</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Async_Header</name>
            <fieldText>&lt;h3 style=&quot;text-align: center;&quot;&gt;Update Payment Status&lt;/h3&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Async_Msg</name>
            <extensionName>flowruntime:message</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>messageType</name>
                <value>
                    <stringValue>info</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>messageContent</name>
                <value>
                    <elementReference>tmplAsyncMsg</elementReference>
