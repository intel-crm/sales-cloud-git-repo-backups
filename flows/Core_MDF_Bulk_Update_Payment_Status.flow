        <label>Set Selection Error</label>
        <locationX>578</locationX>
        <locationY>1730</locationY>
        <assignmentItems>
            <assignToReference>varInlineError</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Please select at least one payment record before saving.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Screen_Error</targetReference>
        </connector>
