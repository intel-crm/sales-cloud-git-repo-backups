    <assignments>
        <name>Set_Selected_Count</name>
        <label>Set Selected Count</label>
        <locationX>138</locationX>
        <locationY>2180</locationY>
        <assignmentItems>
            <assignToReference>varSelectedCount</assignToReference>
            <operator>AssignCount</operator>
