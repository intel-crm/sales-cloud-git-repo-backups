    <assignments>
        <name>Set_Run_Not_Eligible_Error</name>
        <label>Set Run Not Eligible Error</label>
        <locationX>1106</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>varInlineError</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>The selected Payment Run is not an eligible Co-GTM / Completed run. Please choose a different Payment Run.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Screen_Error</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Run_Required_Error</name>
        <label>Set Run Required Error</label>
        <locationX>1370</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>varInlineError</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Please select a Payment Run before continuing.</stringValue>
