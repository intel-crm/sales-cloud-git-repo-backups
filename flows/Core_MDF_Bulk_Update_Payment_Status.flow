        <assignmentItems>
            <assignToReference>Loop_Selected_Payments.Core_MDF_Payment_Made_Dt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Selected_Payments.Core_MDF_Payment_Made_Dt__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Selected_Payments.Core_MDF_EFT_Nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Selected_Payments.Core_MDF_EFT_Nbr__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentsToUpdate</assignToReference>
            <operator>Add</operator>
