<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Submit_Async_Update</name>
        <label>Submit Async Update</label>
        <locationX>314</locationX>
        <locationY>2288</locationY>
        <actionName>Core_MDF_BulkPaymentStatusService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Screen_Async_Submitted</targetReference>
        </connector>
