            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Selected_Payments</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_No_Payments_Error</name>
        <label>Set No Payments Error</label>
        <locationX>842</locationX>
