        </connector>
    </assignments>
    <assignments>
        <name>Capture_Grid_State</name>
        <label>Capture Grid State</label>
        <locationX>314</locationX>
        <locationY>1214</locationY>
        <assignmentItems>
            <assignToReference>varSelectedPayments</assignToReference>
            <operator>Assign</operator>
            <value>
