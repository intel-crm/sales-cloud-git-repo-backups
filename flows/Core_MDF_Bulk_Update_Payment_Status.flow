            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSelectedPaymentIds</assignToReference>
            <operator>RemoveAll</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentsToUpdate</assignToReference>
            <operator>RemoveAll</operator>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Capture_Selected_Ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Clear_Inline_Error</name>
        <label>Clear Inline Error</label>
        <locationX>1106</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>varInlineError</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPaymentRunId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PaymentRunLookup.selectedId</elementReference>
            </value>
        </assignmentItems>
