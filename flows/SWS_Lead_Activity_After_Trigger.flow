    <decisions>
        <name>Check_product_is_present</name>
        <label>Check product is present</label>
        <locationX>974</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Error_message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product_interest</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SWS_Lead__r.Core_Product_Interest__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.SWS_Product_Interest__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_Activity_is_completed_or_cancelled</targetReference>
            </connector>
            <label>Product interest is present</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Activity_is_completed_or_cancelled</name>
        <label>If Activity is completed or cancelled</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Activity_is_completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SWS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Activity_Details_to_Update</targetReference>
            </connector>
            <label>Activity is completed</label>
        </rules>
        <rules>
            <name>Activity_is_Cancelled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SWS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SWS_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Activity_Details_to_Update2</targetReference>
            </connector>
            <label>Activity is Cancelled</label>
        </rules>
    </decisions>
    <environments>Default</environments>
