    <customErrors>
        <name>Error_message</name>
        <label>Error message</label>
        <locationX>1370</locationX>
        <locationY>431</locationY>
        <customErrorMessages>
            <errorMessage>The Selected Product is not present in the Related Lead&apos;s Product Interest Field.</errorMessage>
            <fieldSelection>SWS_Product_Interest__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Update_Error</name>
        <label>Update Error</label>
        <locationX>314</locationX>
