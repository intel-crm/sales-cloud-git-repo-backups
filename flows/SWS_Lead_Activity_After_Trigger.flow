    <assignments>
        <name>Add_Activity_Details_to_Update</name>
        <label>Add Activity Details to Update</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>$Record.SWS_Task_Closed_by__c</assignToReference>
            <operator>Assign</operator>
