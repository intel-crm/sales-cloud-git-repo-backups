<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Add the Ouput Collection of PNUM</description>
        <name>Add_the_Ouput_Collection_of_PNUM</name>
        <label>Add the Ouput Collection of PNUM</label>
        <locationX>497</locationX>
        <locationY>432</locationY>
        <assignmentItems>
            <assignToReference>soColl_PNUMRecords</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>PNUMSObject</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Each_PNUM_Entry_and_see_if_the_User_is_Active</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>isActive</name>
        <label>isActive</label>
        <locationX>500</locationX>
        <locationY>177</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Each_PNUM_Entry_and_see_if_the_User_is_Active</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>isActiveUser</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>UserIsActiveFlag</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_the_Ouput_Collection_of_PNUM</targetReference>
            </connector>
            <label>isActiveUser</label>
        </rules>
    </decisions>
    <formulas>
        <name>UserIsActiveFlag</name>
        <dataType>Boolean</dataType>
        <expression>{!PNUMSObject.Core_MDF_User__r.IsActive}</expression>
    </formulas>
    <interviewLabel>Fetch Account User Association {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fetch Account User Association</label>
    <loops>
        <name>Loop_Through_Each_PNUM_Entry_and_see_if_the_User_is_Active</name>
        <label>Loop Through Each PNUM Entry and see if the User is Active</label>
        <locationX>258</locationX>
        <locationY>229</locationY>
        <assignNextValueToReference>PNUMSObject</assignNextValueToReference>
        <collectionReference>soCollPNUMTemp</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>isActive</targetReference>
        </nextValueConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>This lookup is to get the list of users associated to a given Account in the Partner Node User Mapping Object</description>
        <name>Fetch_the_PNUM_records_for_given_Account</name>
        <label>Fetch the PNUM records for given Account</label>
        <locationX>255</locationX>
        <locationY>95</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Each_PNUM_Entry_and_see_if_the_User_is_Active</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_User__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>vOwnerId</elementReference>
            </value>
        </filters>
        <object>Core_MDF_Partner_Node_User_Mapping__c</object>
        <outputReference>soCollPNUMTemp</outputReference>
        <queriedFields>Core_MDF_Account__c</queriedFields>
        <queriedFields>Core_MDF_User__c</queriedFields>
    </recordLookups>
    <startElementReference>Fetch_the_PNUM_records_for_given_Account</startElementReference>
    <status>Active</status>
    <variables>
        <name>PNUMSObject</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_Partner_Node_User_Mapping__c</objectType>
    </variables>
    <variables>
        <name>soColl_PNUMRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Core_MDF_Partner_Node_User_Mapping__c</objectType>
    </variables>
    <variables>
        <name>soCollPNUMTemp</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_Partner_Node_User_Mapping__c</objectType>
    </variables>
    <variables>
        <name>soUserTempObject</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>
    <variables>
        <name>UserId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>PNUMSObject.Core_MDF_User__c</elementReference>
        </value>
    </variables>
    <variables>
        <name>vAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>0013D00000Yz53KQAR</stringValue>
        </value>
    </variables>
    <variables>
        <name>vOwnerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
</Flow>
