<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Create Error Log From Coveo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Error Log From Coveo</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Error_Log</name>
        <label>Create Error Log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Record.Details__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <elementReference>$Record.Message__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <elementReference>$Record.Origin__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <elementReference>$Record.Project__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <elementReference>$Record.Scope__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <elementReference>$Record.Severity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Record.When__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_sObjectType__c</field>
            <value>
                <elementReference>$Record.SObject_Type__c</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Error_Log</targetReference>
        </connector>
        <flowRunAsUser>TriggeringUser</flowRunAsUser>
        <object>Coveo_Exception_Handler__e</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Active</status>
</Flow>
