    <decisions>
        <name>if_Lead_Inquiry_is_not_Null</name>
        <label>if Lead Inquiry is not Null</label>
        <locationX>314</locationX>
        <locationY>311</locationY>
        <defaultConnectorLabel>Null</defaultConnectorLabel>
        <rules>
            <name>Check_Lead_Inquiry_Owner_Field</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Inquiries__r.Owner:User.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Email</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Check Lead Inquiry Owner Field</label>
        </rules>
        <rules>
            <name>Check_Contact_Inquiry_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Contact_Inquiries__r.Owner.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact_Email</targetReference>
            </connector>
            <label>Check Contact Inquiry Owner</label>
        </rules>
    </decisions>
    <environments>Default</environments>
