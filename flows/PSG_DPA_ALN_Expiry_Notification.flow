    <decisions>
        <description>Checks whether the submitter is there or not for the DPA record</description>
        <name>Submitter_Available_and_Active</name>
        <label>Submitter Available and Active</label>
        <locationX>996</locationX>
        <locationY>840</locationY>
        <defaultConnector>
            <targetReference>Loop_through_the_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Submitter_check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_the_records.core_cpq_disty_submitted_user__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_the_records.core_cpq_disty_submitted_user__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Loop_through_the_records.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DPA_email_notification_Disty</targetReference>
            </connector>
            <label>Submitter check</label>
        </rules>
    </decisions>
