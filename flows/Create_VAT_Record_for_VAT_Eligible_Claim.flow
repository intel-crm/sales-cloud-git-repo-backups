<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>50.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>If Vat Info exists</description>
        <name>If_Vat_Info_exists</name>
        <label>If Vat Info exists</label>
        <locationX>688</locationX>
        <locationY>373</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Vat_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_existing_Vat_Info_if_any</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>isVATReTrigging</targetReference>
            </connector>
            <label>Vat Exists</label>
        </rules>
        <rules>
            <name>Vat_does_not_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_existing_Vat_Info_if_any</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>isVATAmountZero</targetReference>
            </connector>
            <label>Vat does not exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>isVATAmountZero</name>
        <label>isVATAmountZero</label>
        <locationX>754</locationX>
        <locationY>493</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>VAT_Amount_Zero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_VAT_Amt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateClaim</targetReference>
            </connector>
            <label>VAT Amount Zero</label>
        </rules>
        <rules>
            <name>VAT_Amount_Greater_than_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_VAT_Amt__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Vat_Info_0</targetReference>
            </connector>
            <label>VAT Amount Greater than 0</label>
        </rules>
    </decisions>
    <decisions>
        <name>isVATReTrigging</name>
        <label>isVATReTrigging</label>
        <locationX>182</locationX>
        <locationY>493</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isVATReTriggingTrue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDFVATReTriggring__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateVATToPD</targetReference>
            </connector>
            <label>isVATReTriggingTrue</label>
        </rules>
    </decisions>
    <interviewLabel>Create VAT Record for VAT Eligible {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create VAT Record for VAT Eligible Claim</label>
    <processMetadataValues>
