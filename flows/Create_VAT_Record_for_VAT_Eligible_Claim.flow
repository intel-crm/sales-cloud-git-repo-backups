            </value>
        </inputAssignments>
        <object>Core_MDF_Claim_VAT_Info__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get existing Vat Info if any</description>
        <name>Get_existing_Vat_Info_if_any</name>
        <label>Get existing Vat Info if any</label>
        <locationX>688</locationX>
        <locationY>253</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_Vat_Info_exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Claim_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_Claim_VAT_Info__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>RemoveV ATHoldCheckbox and ResetClaimStatus</description>
        <name>updateClaim</name>
        <label>updateClaim</label>
        <locationX>490</locationX>
        <locationY>613</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Status__c</field>
            <value>
                <elementReference>$Record.Core_MDF_Claim_Previous_Status__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_VAT_Hold_Ind__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>PartnerFundClaim</object>
