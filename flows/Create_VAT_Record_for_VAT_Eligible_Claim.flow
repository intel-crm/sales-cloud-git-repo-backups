    <recordUpdates>
        <name>updateVATToPD</name>
        <label>updateVATToPD</label>
        <locationX>50</locationX>
        <locationY>613</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Claim_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Status_Txt__c</field>
            <value>
                <stringValue>Pending Documents</stringValue>
            </value>
        </inputAssignments>
        <object>Core_MDF_Claim_VAT_Info__c</object>
    </recordUpdates>
    <start>
        <locationX>562</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_existing_Vat_Info_if_any</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_VAT_Eligibility_Ind__c</field>
