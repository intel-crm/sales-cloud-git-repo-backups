    <decisions>
        <name>Check_Stage</name>
        <label>Check Stage</label>
        <locationX>660</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>Loop_through_Customer_Feedback_Recs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Stage_is_VP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Customer_Feedback_Recs.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>VP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_VP_Feedback_Field</targetReference>
            </connector>
            <label>Stage is VP</label>
        </rules>
        <rules>
            <name>Stage_is_CM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Customer_Feedback_Recs.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Country Manager</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_CM_Feedback_Field</targetReference>
            </connector>
            <label>Stage is CM</label>
        </rules>
        <rules>
            <name>Stage_is_GM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Customer_Feedback_Recs.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>GM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_GM_Feedback_Field</targetReference>
            </connector>
            <label>Stage is GM</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Stages_and_Approved_Rejected_Prepopulated</name>
        <label>Check Stages and Approved/Rejected Prepopulated</label>
        <locationX>660</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Check_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>VP_and_Prepopulated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Customer_Feedback_Recs.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>VP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Customer_Feedback_Recs.VP_Feedback__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_VP</targetReference>
            </connector>
            <label>VP and Prepopulated</label>
        </rules>
        <rules>
            <name>CMandPrepopulated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Customer_Feedback_Recs.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Customer_Feedback_Recs.CM_Feedback__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CM</targetReference>
            </connector>
            <label>CM and Prepopulated</label>
        </rules>
        <rules>
            <name>GM_and_Prepopulated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Customer_Feedback_Recs.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>GM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Customer_Feedback_Recs.GM_Feedback__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_GM</targetReference>
            </connector>
            <label>GM and Prepopulated</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Approve Reject Customer Feedback ScreenFlow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Approve Reject Customer Feedback ScreenFlow</label>
    <loops>
        <name>Loop_through_Customer_Feedback_Recs</name>
        <label>Loop through Customer Feedback Recs</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <collectionReference>Get_Customer_Feedback_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Stages_and_Approved_Rejected_Prepopulated</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Warning</targetReference>
        </noMoreValuesConnector>
    </loops>
