    <decisions>
        <name>Check_preapproved_or_rejected</name>
        <label>Check preapproved or rejected</label>
        <locationX>182</locationX>
        <locationY>1226</locationY>
        <defaultConnector>
            <targetReference>Update_Customer_Feedback_List_to_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Feedbacks_already_approved_or_rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>preApprovedIds</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Warning</targetReference>
            </connector>
            <label>Feedbacks already approved or rejected</label>
        </rules>
    </decisions>
