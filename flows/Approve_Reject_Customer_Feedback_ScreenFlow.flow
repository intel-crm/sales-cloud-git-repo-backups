    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Customer_Feedback_Records</name>
        <label>Get Customer Feedback Records</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_Customer_Feedback_Recs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>ids</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SPM_Customer_Feedback__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Customer_Feedback_Records</name>
        <label>Update Customer Feedback Records</label>
        <locationX>176</locationX>
        <locationY>1250</locationY>
        <connector>
            <targetReference>Updated_Successfully</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <inputReference>Get_Customer_Feedback_Records</inputReference>
    </recordUpdates>
    <screens>
        <name>Display_selected_record_ids</name>
        <label>Display selected record ids</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Get_Customer_Feedback_Records</targetReference>
        </connector>
        <fields>
            <name>Record_display</name>
            <fieldText>&lt;p&gt;Selected record ids area: {!ids}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
