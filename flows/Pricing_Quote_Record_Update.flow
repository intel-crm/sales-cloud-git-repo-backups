        <queriedFields>Pricing_Sales_Rep__c</queriedFields>
        <queriedFields>Pricing_Server_Deal_Type_Nm__c</queriedFields>
        <queriedFields>SBQQ__Quote__c</queriedFields>
        <sortField>SBQQ__Quote__c</sortField>
