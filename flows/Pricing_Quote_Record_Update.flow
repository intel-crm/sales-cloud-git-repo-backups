    <description>On Quote Record update Send notification and update twin fields on Quote Line</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISNEW())</expression>
    </formulas>
    <interviewLabel>Pricing Quote Record Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pricing Quote Record Update</label>
    <processMetadataValues>
