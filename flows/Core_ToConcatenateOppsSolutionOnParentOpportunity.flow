        <locationX>1790</locationX>
        <locationY>381</locationY>
        <assignmentItems>
            <assignToReference>TechnologyEnabled</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>For_each_opportunity_solution.Core_Technology_Enabled__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
