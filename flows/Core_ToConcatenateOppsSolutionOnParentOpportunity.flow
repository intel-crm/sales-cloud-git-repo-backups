        </connector>
    </assignments>
    <assignments>
        <name>Add_Semicolon_Technology_Enabled</name>
        <label>Add Semicolon Technology Enabled</label>
        <locationX>1628</locationX>
        <locationY>230</locationY>
        <assignmentItems>
            <assignToReference>TechnologyEnabled</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>;</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Save_Technology_Enabled</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Save_Application_Workload</name>
        <label>Save Application/Workload</label>
        <locationX>1919</locationX>
        <locationY>833</locationY>
        <assignmentItems>
            <assignToReference>Application_Workload</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>For_each_opportunity_solution.Core_Application_Workload__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>For_each_opportunity_solution</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Save_Industry_use_case</name>
        <label>Save Industry use case</label>
        <locationX>1338</locationX>
        <locationY>133</locationY>
        <assignmentItems>
            <assignToReference>IndustryUseCase</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{!For_each_opportunity_solution.Core_Industry_Use_Case_s__c.getLabel()}</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Technology_Enabled</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Save_Technology_Enabled</name>
