    </assignments>
    <assignments>
        <name>SemiColon_Applucation_Workload</name>
        <label>SemiColon Applucation Workload</label>
        <locationX>1968</locationX>
        <locationY>618</locationY>
        <assignmentItems>
            <assignToReference>Application_Workload</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>;</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Save_Application_Workload</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Application_Workload</name>
        <label>Check Application Workload</label>
        <locationX>1582</locationX>
        <locationY>622</locationY>
        <defaultConnector>
            <targetReference>SemiColon_Applucation_Workload</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unique Application Workload</defaultConnectorLabel>
        <rules>
            <name>Check_if_Null_Application_Workload</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Application_Workload</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Application_Workload</targetReference>
            </connector>
            <label>Check if Null Application Workload</label>
        </rules>
        <rules>
            <name>If_Duplicate_Application_Workload</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Application_Workload</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>For_each_opportunity_solution.Core_Application_Workload__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>For_each_opportunity_solution</targetReference>
            </connector>
            <label>If Duplicate Application Workload</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Industry_Use_Case</name>
        <label>Check Industry Use Case</label>
        <locationX>1053</locationX>
        <locationY>171</locationY>
        <defaultConnector>
            <targetReference>Add_SemiColon</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unique Industry Use Case</defaultConnectorLabel>
        <rules>
            <name>Check_If_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IndustryUseCase</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Industry_use_case</targetReference>
            </connector>
            <label>Check If Null</label>
        </rules>
        <rules>
            <name>If_Duplicate_Industry_Use_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IndustryUseCase</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>For_each_opportunity_solution.Core_Industry_Use_Case_s__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Technology_Enabled</targetReference>
            </connector>
            <label>If Duplicate Industry Use Case</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Technology_Enabled</name>
        <label>Check Technology Enabled</label>
        <locationX>1416</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Add_Semicolon_Technology_Enabled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unique Technology Enabled</defaultConnectorLabel>
        <rules>
            <name>Check_If_Null_Technology_Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TechnologyEnabled</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Technology_Enabled</targetReference>
            </connector>
            <label>Check If Null Technology Enabled</label>
        </rules>
        <rules>
            <name>If_Duplicate_Technology_Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TechnologyEnabled</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>For_each_opportunity_solution.Core_Technology_Enabled__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Application_Workload</targetReference>
            </connector>
            <label>If Duplicate Technology Enabled</label>
        </rules>
    </decisions>
    <description>This flow Is used for to concatenate Industry Use Case, Application/Workload and Technology Enabled details from all child Opportunity Solution on Parent Opportunity Record.</description>
    <environments>Default</environments>
    <interviewLabel>Core_ConcatenateOppsSolutionOnParentOpportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_ToConcatenateOppsSolutionOnParentOpportunity</label>
    <loops>
        <name>For_each_opportunity_solution</name>
        <label>For each opportunity solution</label>
        <locationX>670</locationX>
        <locationY>402</locationY>
        <collectionReference>Get_All_Opportunity_Solutions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Industry_Use_Case</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_Update_Parent_Opportunity</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>to get all related opportunity solutions with parent opportunity.</description>
        <name>Get_All_Opportunity_Solutions</name>
        <label>Get All Opportunity Solutions</label>
        <locationX>439</locationX>
        <locationY>383</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>For_each_opportunity_solution</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Opportunity__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity_Solution_Area__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Industry_Use_Case_s__c</queriedFields>
        <queriedFields>Core_Application_Workload__c</queriedFields>
        <queriedFields>Core_Technology_Enabled__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Core_Update_Parent_Opportunity</name>
        <label>Update Parent Opportunity</label>
        <locationX>427</locationX>
        <locationY>729</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Opportunity__r.Core_Opportunity_ID__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Concatenated_Application_workload__c</field>
            <value>
                <stringValue>{!Application_Workload.getLabel()}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Concatenated_Industry_use_case__c</field>
            <value>
                <stringValue>{!IndustryUseCase.getLabel()}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Concatenated_Technology_Enabled__c</field>
            <value>
                <stringValue>{!TechnologyEnabled.getLabel()}</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>144</locationX>
        <locationY>40</locationY>
        <connector>
            <targetReference>Get_All_Opportunity_Solutions</targetReference>
        </connector>
        <object>Opportunity_Solution_Area__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Application_Workload</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>IndustryUseCase</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>TechnologyEnabled</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
