<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Complete</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Complete</stringValue>
        </value>
    </constants>
    <constants>
        <name>EmployeeRelationship</name>
        <dataType>String</dataType>
        <value>
            <stringValue>a5p3b0000053BqlAAE</stringValue>
        </value>
    </constants>
    <constants>
        <name>IPAdatamigration</name>
        <dataType>String</dataType>
        <value>
            <stringValue>IPA Data Migration User</stringValue>
        </value>
    </constants>
    <constants>
        <name>IPAdatamigrationUserRecordId</name>
        <dataType>String</dataType>
        <value>
            <stringValue>0053b00000Cth1ZAAR</stringValue>
        </value>
    </constants>
    <description>This flow sets batch entitlements  to Success for contacts whose PCR is createdby IPA DataMigrationUser</description>
    <environments>Default</environments>
    <interviewLabel>PRM_PreventEntitlementsForPCRbyDataMigration {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PRM_PreventEntitlementsForPCRbyDataMigration</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_PCR</name>
        <label>Get PCR</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>set_status_to_Success</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Contact_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PRM_Contact_Id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Relationship_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>EmployeeRelationship</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_InActive_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Complete</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedById</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>IPAdatamigrationUserRecordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_Account_Contact_Relationship__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>set_status_to_Success</name>
        <label>set status to Success</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>PRM_Status_Nm__c</field>
            <value>
                <stringValue>Success</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Status_Reason_Txt__c</field>
            <value>
                <stringValue>Part of IPA DZP upload</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_PCR</targetReference>
        </connector>
        <object>PRM_Batch_Entitlement__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
