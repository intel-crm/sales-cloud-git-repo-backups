<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Verify_Preferred_Language</name>
        <label>Verify Preferred Language</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Preferred_Language_is_not_Blank</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Preferred_Language__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Preferred_Language__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Core_Preferred_Language__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_ERPM_Language_Code</targetReference>
            </connector>
            <label>Preferred Language is not Blank</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_3</name>
        <locationX>578</locationX>
        <locationY>431</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>50</locationX>
        <locationY>539</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>314</locationX>
        <locationY>647</locationY>
    </ends>
    <environments>Default</environments>
    <interviewLabel>Set ERPM Language Code {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set ERPM Language Code</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_log_entry</name>
        <label>Create log entry</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>END_ELEMENT_5</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>ERPM Language code update</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <stringValue>ACM</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <stringValue>Update Contact</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Tags__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_ERPM_Language_Code</name>
        <label>Update ERPM Language Code</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>END_ELEMENT_4</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_log_entry</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_eRPM_Language_Code__c</field>
            <value>
                <elementReference>$Record.Core_Preferred_Language__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Verify_Preferred_Language</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Preferred_Language__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
