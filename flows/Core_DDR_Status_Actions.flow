                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_Design_Registration__c.Core_DDR_Send_Open_Design_Notification</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>DealRegistrationRecordtype</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Deal Registration - Partner</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Deal_Check</name>
        <label>Deal Check</label>
        <locationX>182</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_for_Registration_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Registration_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Design Registration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Record_Type_and_Status</targetReference>
            </connector>
            <label>Check for Registration Type</label>
        </rules>
    </decisions>
    <decisions>
        <name>Deal_Registration_Check</name>
        <label>Deal Registration Check</label>
        <locationX>710</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Registration_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Registration_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Registration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Partner_Account_Owner_Email</targetReference>
            </connector>
            <label>Check Registration Type</label>
        </rules>
    </decisions>
    <description>Schedules record Abandonment and Email Alert for open designs</description>
    <environments>Default</environments>
    <interviewLabel>Core_DDR_Status_Actions {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_DDR_Status_Actions</label>
    <processMetadataValues>
