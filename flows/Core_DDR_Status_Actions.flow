            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Changes record type id to Design Registration - Locked
And Status to Abandoned</description>
        <name>Update_Record_Type_and_Status</name>
        <label>Update_Record_Type_and_Status</label>
        <locationX>50</locationX>
        <locationY>384</locationY>
        <inputAssignments>
            <field>Core_Design_Registration_Status_Nm__c</field>
            <value>
                <stringValue>Abandoned</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Design_Registration_Locked_Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>122</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND( NOT(ISPICKVAL({!$Record.Core_Design_Registration_Status_Nm__c}, &apos;Approved&apos;)) ,NOT(ISPICKVAL({!$Record.Core_Design_Registration_Status_Nm__c}, &apos;Cancelled&apos;)) , NOT(ISPICKVAL({!$Record.Core_Design_Registration_Status_Nm__c}, &apos;Rejected&apos;)) , 
NOT(ISPICKVAL({!$Record.Core_Design_Registration_Status_Nm__c}, &apos;Expired&apos;)) , 
NOT(ISPICKVAL({!$Record.Core_Design_Registration_Status_Nm__c}, &apos;Re-Submitted&apos;)) , ({!$Permission.PCC_Bypass_Automation}= False))</filterFormula>
        <object>Core_Design_Registration__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Schedule_Abandon_Process</name>
            <connector>
                <targetReference>Deal_Check</targetReference>
            </connector>
            <label>Schedule_Abandon_Process</label>
            <offsetNumber>180</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Open_Design_Remainder</name>
            <connector>
                <targetReference>Deal_Registration_Check</targetReference>
            </connector>
            <label>Open_Design_Remainder</label>
            <offsetNumber>30</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
