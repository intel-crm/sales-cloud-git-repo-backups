    <description>On Quote Record update Send notification and update twin fields on Quote Line</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
OR(
	[SBQQ__Quote__c].RecordType.DeveloperName  = &apos;Pricing_Tender_Quote_Edit&apos;,
	[SBQQ__Quote__c].RecordType.DeveloperName = &apos;Pricing_Tender_Quote_Submitted&apos;,
        [SBQQ__Quote__c].RecordType.DeveloperName = &apos;Pricing_Tender_Quote_ReadOnly&apos;
),
NOT(ISNEW()) ,
OR(
	ISCHANGED([SBQQ__Quote__c].SBQQ__Account__c ), 
	ISCHANGED([SBQQ__Quote__c].Pricing_Customer_Nm__c ), 
	ISCHANGED([SBQQ__Quote__c].Pricing_Project_Name_Nm__c ), 
	ISCHANGED([SBQQ__Quote__c].Pricing_Region_Nm__c ), 
	ISCHANGED([SBQQ__Quote__c].Pricing_Server_Deal_Type_Nm__c),
	ISCHANGED([SBQQ__Quote__c].Pricing_Intel_Sales_Rep_Email_Txt__c),
	ISCHANGED([SBQQ__Quote__c].Pricing_End_Customer_Country_Nm__c),
	ISCHANGED([SBQQ__Quote__c].SBQQ__PrimaryContact__c)
) 
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
OR(
	{!myVariable_current.RecordType.DeveloperName}  = &apos;Pricing_Tender_Quote_Edit&apos;,
	{!myVariable_current.RecordType.DeveloperName} = &apos;Pricing_Tender_Quote_Submitted&apos;,
        {!myVariable_current.RecordType.DeveloperName} = &apos;Pricing_Tender_Quote_ReadOnly&apos;
),
NOT(ISNEW()) ,
OR(
	ISCHANGED({!myVariable_current.SBQQ__Account__c} ), 
	ISCHANGED({!myVariable_current.Pricing_Customer_Nm__c} ), 
	ISCHANGED({!myVariable_current.Pricing_Project_Name_Nm__c} ), 
	ISCHANGED({!myVariable_current.Pricing_Region_Nm__c} ), 
	ISCHANGED({!myVariable_current.Pricing_Server_Deal_Type_Nm__c}),
	ISCHANGED({!myVariable_current.Pricing_Intel_Sales_Rep_Email_Txt__c}),
	ISCHANGED({!myVariable_current.Pricing_End_Customer_Country_Nm__c}),
	ISCHANGED({!myVariable_current.SBQQ__PrimaryContact__c})
) 
)</expression>
    </formulas>
