    <description>Sharing the Claim Review Case records on insert or change of owner</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>([Case].RecordType.DeveloperName = &apos;Core_MDF_Audit&apos; || [Case].RecordType.DeveloperName = &apos;Core_MDF_Audit_Closed&apos;) &amp;&amp; (ISNEW() || ISCHANGED([Case].OwnerId ))
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
