<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Notify_TAL</name>
        <label>Notify TAL</label>
        <locationX>606</locationX>
        <locationY>466</locationY>
        <actionName>Lead.Core_TAL_SLA_Expired_Alert</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Lead.Core_TAL_SLA_Expired_Alert</nameSegment>
    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_day_field</name>
        <label>Check day field</label>
        <locationX>324</locationX>
        <locationY>354</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Days_is_true</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_TAL</targetReference>
            </connector>
            <label>Days is true</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_day_field_weekend</name>
        <label>Check day field weekend</label>
        <locationX>876</locationX>
        <locationY>358</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Days_is_false</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_TAL</targetReference>
            </connector>
            <label>Days is false</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Core TAL One day Business and Weekend Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core TAL One day Business and Weekend Notify</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>490</locationX>
        <locationY>48</locationY>
        <filterFormula>AND(
		{!$Record.RecordType.DeveloperName} &lt;&gt; &quot;Partner_Lead&quot;,
		{!$Record.Days__c} =true,
		OR(	ISPICKVAL({!$Record.Core_Lead_Priority__c}, &apos;Hot&apos;),
			ISPICKVAL({!$Record.Core_Lead_Priority__c}, &apos;Warm&apos;),
			ISPICKVAL({!$Record.Core_Lead_Priority__c}, &apos;Cold&apos;)
			),
		OR(
			AND ( 
				ISCHANGED({!$Record.Status} ), 
				ISPICKVAL({!$Record__Prior.Status}, &quot;Marketing Qualified Lead&quot;), 
				ISPICKVAL({!$Record.Status}, &quot;Tele Accepted Lead&quot;)
				),
			ISPICKVAL({!$Record.Status}, &apos;Tele Accepted Lead&apos;)),
		{!$Record.Core_Having_Tasks__c}=false,
		{!$Record.Core_SLA_Listed_User__c}  =True,
		{!$Record.Core_Created_Post_NewLead_Process__c}=True,
		NOT( ISPICKVAL({!$Record.Core_Lead_Status__c} , &apos;Qualified&apos;)),
		OR(
			ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;New&quot;),
			ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;Accepted&quot;)
			)
	)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>One_Day_Core_Business_Day_Calculation_c</name>
            <connector>
                <targetReference>Check_day_field</targetReference>
            </connector>
            <label>One Day Core_Business_Day_Calculation__c</label>
            <offsetNumber>-1</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Core_Business_Day_Calculation__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>One_day_before_Weekend_Core_WeekEnd_SLA_Calculation</name>
            <connector>
                <targetReference>Check_day_field_weekend</targetReference>
            </connector>
            <label>One day before Weekend Core_WeekEnd_SLA_Calculation</label>
            <offsetNumber>-1</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Core_WeekEnd_SLA_Calculation__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
