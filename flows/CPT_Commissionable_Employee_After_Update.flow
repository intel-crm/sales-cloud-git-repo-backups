                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_QuotaSetup_Field_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CPT_BR_All_Assigned__c</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_BR_Plan_Default_Values</targetReference>
            </connector>
            <label>Check if it is BR All Field?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_CR_Fields</name>
        <label>Is CR Fields?</label>
        <locationX>2866</locationX>
        <locationY>1271</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_Quota_Setup_Plan_Defaults</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_CR_OEM_Field</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_QuotaSetup_Field_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CPT_CR_OEM_Assigned__c</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CR_OEM_Default_Value</targetReference>
            </connector>
            <label>Is CR - OEM Field ?</label>
        </rules>
        <rules>
            <name>Is_CR_Retail_Field</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_QuotaSetup_Field_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CPT_CR_Retail_Assigned__c</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CR_Retail_Default_Value</targetReference>
            </connector>
            <label>Is CR - Retail Field ?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_STG_Fields</name>
        <label>Is STG Field ?</label>
        <locationX>3438</locationX>
        <locationY>1271</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_Quota_Setup_Plan_Defaults</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_STG_Field_Default_Plan_Value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_QuotaSetup_Field_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CPT_Sales_Team_Goal_Assigned__c</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.Label</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>403</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_STG_Default_Value_and_Plan_Value</targetReference>
            </connector>
            <label>Is STG Field &amp; Default Plan Value ?</label>
        </rules>
    </decisions>
    <description>[24/Nov/25 08:00 PM] - Added the Default Value for the BR, CR &amp; MARVOL Fields + STG Default Value</description>
    <environments>Default</environments>
    <formulas>
        <description>Assign Default % Assigned Value for 601 Plan</description>
        <name>DefaultCRvaluefor_601</name>
        <dataType>String</dataType>
        <expression>IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;601&quot;, &quot;70%&quot;,
        &quot;0%&quot;
      )</expression>
    </formulas>
    <formulas>
        <description>Assign Default % Assigned Value for BR Plan</description>
        <name>DefaultValueforBRPlan</name>
        <dataType>String</dataType>
        <expression>IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;600&quot;, &quot;70%&quot;,
 IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;601&quot;, &quot;0%&quot;,
        &quot;0%&quot;      
  ))</expression>
    </formulas>
    <formulas>
        <description>Assign Default % Assigned value for CR Plan</description>
        <name>DefaultValueforCRPlan_101_202_301</name>
        <dataType>String</dataType>
        <expression>IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;101&quot;, &quot;50%&quot;,
  IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;301&quot;, &quot;50%&quot;,
    IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;202&quot;, &quot;70%&quot;,
        &quot;0%&quot;
      
    )
  )
)</expression>
    </formulas>
    <interviewLabel>CPT Commissionable Employee - After Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CPT Commissionable Employee - After Update</label>
    <loops>
        <description>iterate over each record</description>
        <name>CPT_Loop_Over_the_List_of_Quota_Setup_Records</name>
        <label>Loop Over the List of Quota Setup Records</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
