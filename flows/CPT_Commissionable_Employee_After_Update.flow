        <locationX>2338</locationX>
        <locationY>2129</locationY>
        <defaultConnector>
            <targetReference>CPT_Add_Quota_Setup_Records_to_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
