    <decisions>
        <name>Check_Quota_Setup_Field_Name</name>
        <label>Check Quota Setup Field Name</label>
        <locationX>3020</locationX>
        <locationY>1163</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_Quota_Setup_Plan_Defaults</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Billings_Revenue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_BR_All_Field</targetReference>
            </connector>
            <label>Billings Revenue</label>
        </rules>
        <rules>
            <name>Consumer_Revenue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_CR_Fields</targetReference>
            </connector>
            <label>Consumer Revenue</label>
        </rules>
        <rules>
            <name>Is_STG_Field</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>STG</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_STG_Fields</targetReference>
            </connector>
            <label>Is STG Field ?</label>
        </rules>
    </decisions>
    <decisions>
        <name>CPT_check_if_Job_is_Updated_or_Manager_is_Updated</name>
        <label>check if Job is Updated or Manager is Updated</label>
        <locationX>2074</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>CPT_Update_Plan_on_the_Quota_Setup_Object</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CPT_Manager_is_Updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CPT_Manager__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.CPT_Manager__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPT_Update_Quota_Setup_Record_Owner</targetReference>
            </connector>
            <label>Manager is Updated</label>
        </rules>
        <rules>
            <name>CPT_Manager_and_Plan_is_Updated</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CPT_Manager__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.CPT_Manager__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CPT_Sales_Compensation_Plan__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.CPT_Sales_Compensation_Plan__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPT_Update_Manager_and_Plan_Name</targetReference>
            </connector>
            <label>Manager and Plan is Updated</label>
        </rules>
    </decisions>
    <decisions>
        <name>CPT_check_if_records_to_update_is_not_empty</name>
        <label>check if records to update is not empty</label>
        <locationX>182</locationX>
        <locationY>1931</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CPT_Records_Not_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CPT_QuotaSetupUpdateRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPT_Update_the_Quota_Setup_Records</targetReference>
            </connector>
            <label>Records Not Empty</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_BR_All_Field</name>
        <label>Is BR All Field?</label>
        <locationX>2294</locationX>
        <locationY>1271</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_Quota_Setup_Plan_Defaults</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_it_is_BR_All_Field</name>
