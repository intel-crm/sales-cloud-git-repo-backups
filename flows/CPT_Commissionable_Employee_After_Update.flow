    <customErrors>
        <name>ErrorMessage</name>
        <label>ErrorMessage</label>
        <locationX>270</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>Plan cannot be updated because the associated Quota Setup is marked as Completed. Change the Quota Setup Stage to In Progress before updating the Employee Plan.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_if_Quota_Setup_is_Completed</name>
        <label>Check if Quota Setup is Completed</label>
        <locationX>1304</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>CPT_check_if_Job_is_Updated_or_Manager_is_Updated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Completed_and_Plan_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CPT_Sales_Compensation_Plan__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.CPT_Sales_Compensation_Plan__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ErrorMessage</targetReference>
            </connector>
            <label>Completed and Plan Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Quota_Setup_Field_Name</name>
        <label>Check Quota Setup Field Name</label>
        <locationX>3284</locationX>
        <locationY>1337</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_Quota_Setup_Plan_Defaults</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Billings_Revenue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_BR_DCG</targetReference>
            </connector>
            <label>Billings Revenue</label>
        </rules>
        <rules>
            <name>Consumer_Revenue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_CR_Fields</targetReference>
            </connector>
            <label>Consumer Revenue</label>
        </rules>
        <rules>
            <name>Is_PfR_Field</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DW</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_pfr_Fields</targetReference>
            </connector>
            <label>Is PfR Field ?</label>
        </rules>
    </decisions>
    <decisions>
        <name>CPT_check_if_Job_is_Updated_or_Manager_is_Updated</name>
        <label>check if Job is Updated or Manager is Updated</label>
        <locationX>2338</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Manager_AND_Plan_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CPT_Manager__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.CPT_Manager__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CPT_Sales_Compensation_Plan__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.CPT_Sales_Compensation_Plan__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPT_Update_Manager_and_Plan_Name</targetReference>
            </connector>
            <label>Manager AND Plan Changed</label>
        </rules>
        <rules>
            <name>Plan_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CPT_Sales_Compensation_Plan__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.CPT_Sales_Compensation_Plan__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPT_Update_Plan_on_the_Quota_Setup_Object</targetReference>
            </connector>
            <label>Plan Changed</label>
        </rules>
        <rules>
            <name>Manager_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CPT_Manager__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.CPT_Manager__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPT_Update_Quota_Setup_Record_Owner</targetReference>
            </connector>
            <label>Manager Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>CPT_check_if_records_to_update_is_not_empty</name>
        <label>check if records to update is not empty</label>
        <locationX>182</locationX>
        <locationY>2705</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CPT_Records_Not_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CPT_QuotaSetupUpdateRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPT_Update_the_Quota_Setup_Records</targetReference>
            </connector>
            <label>Records Not Empty</label>
        </rules>
    </decisions>
