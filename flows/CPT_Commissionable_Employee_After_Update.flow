    <environments>Default</environments>
    <formulas>
        <description>Assign Default % Assigned Value for 601 Plan</description>
        <name>DefaultCRvaluefor_601</name>
        <dataType>String</dataType>
        <expression>IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;601&quot;, &quot;70%&quot;,
        &quot;0%&quot;
      )</expression>
    </formulas>
    <formulas>
        <description>Assign Default % Assigned Value for BR Plan</description>
        <name>DefaultValueforBRPlan</name>
        <dataType>String</dataType>
        <expression>IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;600&quot;, &quot;70%&quot;,
 IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;601&quot;, &quot;0%&quot;,
        &quot;0%&quot;      
  ))</expression>
    </formulas>
    <formulas>
        <description>Assign Default % Assigned value for CR Plan</description>
        <name>DefaultValueforCRPlan_101_202_301</name>
        <dataType>String</dataType>
        <expression>IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;101&quot;, &quot;50%&quot;,
  IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;301&quot;, &quot;50%&quot;,
    IF(Text({!CPT_Loop_Over_the_List_of_Quota_Setup_Records.CPT_Plan__c}) = &quot;202&quot;, &quot;70%&quot;,
        &quot;0%&quot;
      
    )
