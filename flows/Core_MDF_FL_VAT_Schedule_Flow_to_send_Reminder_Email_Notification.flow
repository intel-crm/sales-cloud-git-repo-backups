    <decisions>
        <name>Check_if_user_is_active</name>
        <label>Check if user is active</label>
        <locationX>595</locationX>
        <locationY>377</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_user_active_or_license_reclaimed_is_true</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Owner:User.Partner_License_Reclaimed__c</leftValueReference>
                <operator>EqualTo</operator>
