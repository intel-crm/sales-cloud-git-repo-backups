                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Claim_Submitter_Reminder_Email_Alert</targetReference>
            </connector>
            <label>Check if user active or license reclaimed is true</label>
        </rules>
    </decisions>
