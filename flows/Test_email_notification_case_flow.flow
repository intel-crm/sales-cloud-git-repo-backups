    <start>
        <locationX>120</locationX>
        <locationY>75</locationY>
        <connector>
            <targetReference>Filter_based_on_record_Type</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <subflows>
        <name>Call_Claim_Update_Flow</name>
        <label>Call_Claim_Update_Flow</label>
        <locationX>1053</locationX>
        <locationY>844</locationY>
        <connector>
            <targetReference>Status_as_Cancelled</targetReference>
        </connector>
        <flowName>Core_MDF_Update_Claim_V4</flowName>
        <inputAssignments>
            <name>varCaseId</name>
