<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_email_notification</name>
        <label>Send email notification</label>
        <locationX>782</locationX>
        <locationY>787</locationY>
        <actionName>Case.Test_Email_Alert</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Call_Claim_Update_Flow</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Case.Test_Email_Alert</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Share_Claim_Review_Case</name>
        <label>Share Claim Review Case</label>
        <locationX>523</locationX>
        <locationY>473</locationY>
        <actionName>Core_MDF_ClaimReviewCaseShare</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>check_record_type</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseList</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_ClaimReviewCaseShare</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>check_case_status</name>
        <label>check case status</label>
        <locationX>944</locationX>
        <locationY>471</locationY>
        <defaultConnector>
            <targetReference>Status_as_Cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>check_casestatus</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Review_Case_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Review Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Review_Case_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_fields_on_closure</targetReference>
            </connector>
            <label>check casestatus</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_Contact_ID</name>
        <label>check Contact ID</label>
        <locationX>711</locationX>
        <locationY>461</locationY>
        <defaultConnector>
            <targetReference>check_case_status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>contact_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_Contact_As_null</targetReference>
            </connector>
            <label>contact not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_new_case_or_owner_changed</name>
        <label>check new case or owner changed</label>
        <locationX>518</locationX>
        <locationY>326</locationY>
        <defaultConnector>
            <targetReference>check_record_type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>check_new_case_or_ownerchanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>checkownerchangedornewcase</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Share_Claim_Review_Case</targetReference>
            </connector>
            <label>check new case or ownerchanged</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_record_type</name>
        <label>check record type</label>
        <locationX>709</locationX>
        <locationY>336</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Audit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Audit</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>check_Contact_ID</targetReference>
            </connector>
            <label>Core MDF Audit</label>
        </rules>
    </decisions>
    <decisions>
        <name>Filter_based_on_record_Type</name>
        <label>Filter based on record Type</label>
        <locationX>517</locationX>
        <locationY>175</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>core_MDF_record_type_filter</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Audit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Audit_Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>check_new_case_or_owner_changed</targetReference>
            </connector>
            <label>core MDF record type filter</label>
        </rules>
    </decisions>
    <decisions>
        <name>Status_as_Cancelled</name>
        <label>Status as Cancelled</label>
        <locationX>1156</locationX>
        <locationY>481</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_asCancelled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateCloseCaseRecordType</targetReference>
            </connector>
            <label>Status asCancelled</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>checkownerchangedornewcase</name>
        <dataType>Boolean</dataType>
        <expression>({!$Record.RecordType.DeveloperName} = &apos;Core_MDF_Audit&apos; || {!$Record.RecordType.DeveloperName} = &apos;Core_MDF_Audit_Closed&apos;) &amp;&amp; ((ISNEW() &amp;&amp; NOT({!$Record.Owner:User.Id} = {!$Label.Core_MDF_Dummy_Account_Owner_Id}))  || ISCHANGED({!$Record.OwnerId }))</expression>
    </formulas>
    <interviewLabel>Test email notification case flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test email notification case flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Case_fields_on_closure</name>
