        <locationX>1262</locationX>
        <locationY>617</locationY>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>$Label.Core_MDF_ClaimReviewCloseCaseRecordTypeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
