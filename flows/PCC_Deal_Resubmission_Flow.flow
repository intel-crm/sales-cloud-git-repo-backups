        <locationX>754</locationX>
        <locationY>1418</locationY>
        <collectionReference>Get_Pricebook_Entry_Record</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_if_Product_Id_Exists_on_PricebookEntry</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
