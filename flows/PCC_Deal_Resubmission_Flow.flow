    <decisions>
        <name>check_deal_eligible</name>
        <label>check deal eligible</label>
        <locationX>534</locationX>
        <locationY>818</locationY>
        <defaultConnector>
            <targetReference>Iterate_over_Deal_Product_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Deal_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Iterate_over_Deal_Product_Records.PCC_Deal_Eligible_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Deal_Eligible_value</targetReference>
            </connector>
            <label>Deal Eligible?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Opportunity_Exisits</name>
        <label>Check if Opportunity Exisits</label>
        <locationX>842</locationX>
        <locationY>386</locationY>
        <defaultConnector>
            <targetReference>Create_Log_Entry_for_OLI_Opportunity_Exisits</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Opportunity_is_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Deal_Details.Core_Opportunity_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Deal_Products</targetReference>
            </connector>
            <label>Opportunity is not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Product_Id_Exists_on_PricebookEntry</name>
        <label>Check if Product Id Exists on PricebookEntry</label>
        <locationX>974</locationX>
        <locationY>1526</locationY>
        <defaultConnector>
            <targetReference>Create_Log_Entry_for_OLI_Product_Id_on_PB</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product_Id_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_DRP_s.Core_Product_Id__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_through_Price_Pricebook_Entries.Product2Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Opportunity_Line_Item</targetReference>
            </connector>
            <label>Product Id Exists?</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_if_record_is_Inserted</name>
        <label>check if record is Inserted</label>
        <locationX>534</locationX>
        <locationY>2426</locationY>
        <defaultConnector>
            <targetReference>Create_Log_Entry_for_OLI_Check_if_OLIs_are_inserted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_ID_not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Iterate_Over_Inserted_OLis.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Deal_Product</targetReference>
            </connector>
            <label>If ID not Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Eligible_for_Quote_Update</name>
        <label>Eligible for Quote Update</label>
        <locationX>314</locationX>
        <locationY>3026</locationY>
        <defaultConnector>
            <targetReference>Fault_Message_NON_FI_Products</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DealEligible</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_stage_record_for_Quote_Update</targetReference>
            </connector>
            <label>is Eligible?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Subscribe_to_Re_submission_Event_Messages</name>
        <label>Subscribe to Re-submission Event Messages</label>
        <locationX>1238</locationX>
        <locationY>170</locationY>
        <defaultConnector>
            <targetReference>Create_Log_Entry_for_OLI_1st_Default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Resubmit_Event</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PCC_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resubmitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Object__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Record_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PCC_Error_Message__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Deal_Details</targetReference>
            </connector>
            <label>Is Resubmit Event?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CurrentYear</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(TODAY()))</expression>
    </formulas>
    <formulas>
        <name>resubmissionFaultMessage</name>
        <dataType>String</dataType>
        <expression>&apos;Resubmission-&apos;+{!FaultMessage}</expression>
    </formulas>
    <interviewLabel>PCC Deal Resubmission Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PCC Deal Resubmission Flow</label>
    <loops>
