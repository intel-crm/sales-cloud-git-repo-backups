            <assignToReference>OpportunityLineItemRecord.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Deal_Details.Core_Opportunity_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.Quantity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_through_DRP_s.Core_Full_Year_Qty__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.Product2Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_over_Deal_Product_Records.Core_Product_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.Failed_DDR_RecordID__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Deal_Details.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityLineItemRecord.PricebookEntryId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_through_Price_Pricebook_Entries.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Collect_all_Opportunity_Line_Items</targetReference>
        </connector>
    </assignments>
