        <connector>
            <targetReference>Send_ACR_Notification_Messages</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
{!$Record.PRM_Account_Id__r.RecordType.DeveloperName} = {!$Label.PRM_Intel_Account} , {!$Record.PRM_Account_Id__r.Core_Intel_Partner_Alliance_PartnerGroup__c} = true, {!$Record.PRM_InActive_Ind__c} = false, ISPICKVAL({!$Record.PRM_Status_Nm__c} ,&apos;Complete&apos;),
NOT(ISBLANK({!$Record.PRM_Contact_Id__c} )),
NOT(ISBLANK({!$Record.PRM_Account_Id__c} ))
)</filterFormula>
        <object>PRM_Account_Contact_Relationship__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
