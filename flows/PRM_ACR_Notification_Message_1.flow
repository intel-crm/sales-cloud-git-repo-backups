    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Send Notification messages to contacts when new ACR record is created or updated</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_3_myRule_1_A1_8512871295</name>
        <dataType>String</dataType>
        <expression>{!$Label.PRM_Msgcd_NewContact}</expression>
    </formulas>
    <interviewLabel>PRM_ACR_Notification_Message_1 {!$Flow.CurrentDateTime}</interviewLabel>
