<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Product_Cancel_Notification</name>
        <label>Send Product Cancel Notification</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <actionName>OpportunityLineItem.Core_DDR_Send_Product_Cancel_Notification</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>OpportunityLineItem.Core_DDR_Send_Product_Cancel_Notification</nameSegment>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>IF Opportunity: Channel Opportunity = True &amp;&amp; Tech Owner is not null, then only email should be sent</description>
        <name>Opportunity_Channel_Opportunity_True</name>
        <label>IF Opportunity: Channel Opportunity = True &amp;&amp; Tech Owner is not null</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IF_Opportunity_Channel_Opportunity_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_Channel_Opportunity_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.Owner.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Owner_Email_Opportunity_Core_Opportunity_Owner_r_Email</targetReference>
            </connector>
            <label>IF Opportunity: Channel Opportunity = True &amp;&amp; Tech Owner is not null</label>
        </rules>
    </decisions>
    <description>Trigger email to Technical Owner when Opportunity line item cancelled.
v2: adding is changed condition for status field.
v3: adding technical owner on oppty not null condition.
v8: Changing from Technical owner email to Opportunity Owner email</description>
    <environments>Default</environments>
    <interviewLabel>Core_DDR_Send_Email_On_Opportunity_Product_Cancellation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_DDR_Send_Email_On_Opportunity_Product_Cancellation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Opportunity_Owner_Email_Opportunity_Core_Opportunity_Owner_r_Email</name>
        <label>Opportunity Owner Email = Opportunity.Core_Opportunity_Owner__r.Email</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Send_Product_Cancel_Notification</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Opportunity_Owner_Email__c</field>
            <value>
                <elementReference>$Record.Opportunity.Owner.Email</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Opportunity_Channel_Opportunity_True</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
