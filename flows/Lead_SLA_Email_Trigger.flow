    <decisions>
        <name>Decide_lead_SLA</name>
        <label>Decide lead SLA</label>
        <locationX>1122</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>Loop_Lead_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Moved_to_In_Contact</name>
            <conditionLogic>1 AND 2 AND 3 AND 5 AND 6 AND 7 AND (4 OR 8)</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Lead_records.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Core_Lead_Sub_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Attempting Contact</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Core_Lead_Sub_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>In Contact</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Marketing Qualified Lead</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DaysSinceAttemptingContact</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>21.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.SWS_InContact_Email_Sent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Generated Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MQL_or_SGL</targetReference>
            </connector>
            <label>Not Moved to In Contact</label>
        </rules>
        <rules>
            <name>Not_Moved_to_SAL_Stage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Lead_records.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Core_Lead_Sub_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Contact</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Marketing Qualified Lead</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DaysSinceQualifiedIncontact</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Sales Accepted Lead</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.SWS_NotMovedtoSAL_Email_Sent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MQL_Qualified_Lead_not_in_SAL</targetReference>
            </connector>
            <label>Not Moved to SAL Stage</label>
        </rules>
        <rules>
            <name>SAL_No_Tasks</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Lead_records.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Accepted Lead</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Core_Lead_Sub_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Contact</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SALDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.SWS_Having_Tasks_in_SAL__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.SWS_No_Schedule__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SAL_SLA_Expired</targetReference>
            </connector>
            <label>SAL No Tasks</label>
        </rules>
        <rules>
            <name>Not_Converted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Lead_records.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Accepted Lead</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.IsConverted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DaysSinceSAL</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.SWS_NotConverted_Email_Sent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Lead_records.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_type_difference</targetReference>
            </connector>
            <label>Not Converted</label>
        </rules>
    </decisions>
    <decisions>
        <name>MQL_or_SGL</name>
        <label>MQL or SGL</label>
        <locationX>396</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>SGL_In_Contact_SLA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>SGL</defaultConnectorLabel>
        <rules>
            <name>MQL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Lead_records.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Marketing Qualified Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MQL_In_Contact_SLA</targetReference>
            </connector>
            <label>MQL</label>
        </rules>
    </decisions>
    <decisions>
        <name>Record_type_difference</name>
        <label>Record type difference</label>
        <locationX>1452</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>SGL_Not_Converted_in_30_days</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sales Lead</defaultConnectorLabel>
        <rules>
            <name>Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Lead_records.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SAL_Not_Converted_in_30_days</targetReference>
            </connector>
            <label>Lead</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DaysSinceAttemptingContact</name>
        <dataType>Number</dataType>
        <expression>TODAY() - DATEVALUE({!Loop_Lead_records.SWS_Claimed_Date__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>DaysSinceQualifiedIncontact</name>
        <dataType>Number</dataType>
        <expression>TODAY() - DATEVALUE({!Loop_Lead_records.SWS_QualifiedInContact_Date__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>DaysSinceSAL</name>
        <dataType>Number</dataType>
        <expression>TODAY() - DATEVALUE({!Loop_Lead_records.Core_Entrance_Date_SAL__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>SALCalculation</name>
        <dataType>Date</dataType>
        <expression>IF(AND(ISPICKVAL({!Loop_Lead_records.Status},&quot;Sales Accepted Lead&quot;),NOT(ISBLANK({!Loop_Lead_records.Core_Entrance_Date_SAL__c}))),
{!Loop_Lead_records.Core_Entrance_Date_SAL__c} + CASE(MOD( DATEVALUE({!Loop_Lead_records.Core_Entrance_Date_SAL__c} ) - DATE(1900,01,07), 7 ), 1,0,2,0,3,0,4,2,5,2, 0,0, 6, 1, 0) +2,
NULL)</expression>
    </formulas>
    <formulas>
        <name>SALDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!Loop_Lead_records.SWS_MQL_no_task_Calculation__c})</expression>
    </formulas>
    <interviewLabel>Lead SLA Email Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead SLA Email Trigger</label>
