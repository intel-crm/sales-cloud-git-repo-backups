    <decisions>
        <name>Check_if_claim_is_on_bank_hold</name>
        <label>Check if claim is on bank hold</label>
        <locationX>974</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_Bank_Document_Hold_is_True</name>
            <conditionLogic>(1  OR (6 AND 7)) AND 2 AND 3 AND (4 OR 8) AND 5</conditionLogic>
            <conditions>
                <leftValueReference>BankDocumentHoldInd</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimProgram</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimRegion</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>EmailTemplateName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Claim_Status_Denied</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>BankDocumentHoldInd</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimProgram</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Co-GTM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Queue_GroupId</targetReference>
            </connector>
            <label>Check if Bank Document Hold is True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_program_is_retail_ipa_cogtm</name>
        <label>Check if program is Retail or IPA or Co-GTM</label>
        <locationX>578</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_CP_is_Retail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimProgram</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Retail_Channel_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_RSM_on_Bank_Document_Hold</targetReference>
            </connector>
            <label>Check if Program is Retail</label>
        </rules>
        <rules>
            <name>Check_is_CP_is_IPA_or_cogtm</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>ClaimProgram</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_IPA_Technical_program_name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimRegion</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimProgram</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_GTM_program_name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_PGM_Group_Id</targetReference>
            </connector>
            <label>Check is Program is IPA or Co-GTM</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_IPA_or_Co_GTM_Program</name>
        <label>Check IPA or Co-GTM Program</label>
        <locationX>578</locationX>
        <locationY>674</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IPA_Notification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimProgram</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_IPA_Technical_program_name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Notification_to_IPA_MDF_Managers_0</targetReference>
            </connector>
            <label>IPA Notification</label>
        </rules>
        <rules>
            <name>Co_GTM_Notification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimProgram</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_GTM_program_name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Notification_to_Co_GTM_Managers</targetReference>
            </connector>
            <label>Co-GTM Notification</label>
        </rules>
    </decisions>
    <description>This is used to send notification to payment admins when claims is put on bank document hold</description>
    <environments>Default</environments>
    <interviewLabel>Claim Notification to Payment Admins on Bank Document Hold {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Claim Notification to Payment Admins on Bank Document Hold</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_PGM_Group_Id</name>
        <label>Get PGM Group Id</label>
        <locationX>578</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_IPA_or_Co_GTM_Program</targetReference>
        </connector>
        <filterLogic>(1 AND 2 AND 3 AND (4 OR 8)) AND (5 OR 6) AND 7</filterLogic>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Claim.Request.ChannelPartner.Core_MDF_CoMarketing_Ultimate_Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Claim.Request.ChannelPartner.Core_MDF_Channel_Program__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Region_cd__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ClaimRegion</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_BudgetType_nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Claim.Core_MDF_Budget_Type_Options_Nm__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_BudgetType_nm__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Inactive_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program_Name_Txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Label.Core_MDF_Co_GTM_program_name</elementReference>
            </value>
        </filters>
        <object>Core_MDF_Partner_Group_Mapping__c</object>
        <outputReference>IPAPGMRecords</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_BudgetType_nm__c</queriedFields>
        <queriedFields>Core_MDF_Group_Id__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Queue_GroupId</name>
        <label>Get Queue GroupId</label>
        <locationX>578</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Send_Notification_to_Payment_Admins</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ClaimProgram</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Payment_Admin_Queue_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ClaimRegion</elementReference>
            </value>
        </filters>
        <object>Core_MDF_ProgramGeoGroupMap__mdt</object>
        <outputAssignments>
            <assignToReference>QueueGroupId</assignToReference>
            <field>Core_MDF_Payment_Admin_Queue_Id__c</field>
        </outputAssignments>
    </recordLookups>
    <start>
