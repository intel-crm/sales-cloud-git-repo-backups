    <environments>Default</environments>
    <formulas>
        <name>Check_Distinguish_New_Lead</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  OR(
    ISNULL({!$Record.Core_lead_Id__c}),
    ISBLANK({!$Record.Core_lead_Id__c})
  ),
  OR(
    {!$Record.RecordType.Name} = &quot;Lead&quot;,
    {!$Record.RecordType.Name} = &quot;Sales Lead&quot;,
    {!$Record.RecordType.Name} = &quot;Partner Lead&quot;
  )
)</expression>
    </formulas>
    <formulas>
        <name>Check_Record_Type</name>
        <dataType>Boolean</dataType>
        <expression>OR(
{!$Record.RecordType.DeveloperName} = &quot;Lead&quot;,
{!$Record.RecordType.DeveloperName}= &quot;Sales_Lead&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Check_Reject_Flag</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  OR({!$Record.RecordType.Name} = &quot;Sales Lead&quot;, {!$Record.RecordType.Name} = &quot;Lead&quot;),
  ISPICKVAL({!$Record.Core_Lead_State__c}, &apos;In Pursuit&apos;),
  ISPICKVAL({!$Record__Prior.Core_Lead_State__c}, &apos;Terminated&apos;),
  NOT(ISPICKVAL({!$Record__Prior.Core_Lead_Status__c}, &apos;Unreachable&apos;)),
  ISCHANGED({!$Record.Core_Lead_State__c})
)</expression>
    </formulas>
    <formulas>
        <name>Check_State_Status_Change</name>
        <dataType>Boolean</dataType>
        <expression>OR(
ISCHANGED({!$Record.Core_Lead_Status__c}),
ISCHANGED({!$Record.OwnerId}),
{!$Record.IsConverted}=true
)</expression>
    </formulas>
    <formulas>
        <name>Core_Converted_Date_Formula</name>
        <dataType>Date</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>Core_Exitt_Datee_MAQLFormula</name>
        <dataType>DateTime</dataType>
        <expression>IF( ISPICKVAL($Record.Status,&apos;Marketing Qualified Lead&apos;) ,Now(),  $Record.Core_Exit_Date_MAQL__c )</expression>
    </formulas>
    <formulas>
        <name>Core_Exxit_Datee_SALFormula</name>
        <dataType>DateTime</dataType>
        <expression>IF( ISPICKVAL($Record.Status,&apos;Sales Accepted Lead&apos;) ,Now(),  $Record.Core_Exit_Date_SAL__c )</expression>
    </formulas>
    <formulas>
        <name>Core_Unreachable_StageFormula</name>
        <dataType>String</dataType>
        <expression>Text($Record.Status)</expression>
    </formulas>
    <formulas>
        <name>Core_Unreachable_Start_DateFormula</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>Email_Notification_Entry_Formula</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.RecordType.DeveloperName} =&quot;Lead&quot; || {!$Record.RecordType.DeveloperName} =&quot;Sales_Lead&quot;</expression>
    </formulas>
    <formulas>
        <name>ExitDateSGLFormula</name>
        <dataType>DateTime</dataType>
        <expression>IF( ISPICKVAL($Record.Status,&apos;Sales Generated Lead&apos;) ,Now(), {!$Record.SWS_Exit_Date_SGL__c} )</expression>
    </formulas>
    <formulas>
        <name>F_Core_CoveredAccount_Email_Notification</name>
        <dataType>Boolean</dataType>
        <expression>OR(
     AND( ISNEW(), OR({!$Record.RecordType.Name} = &quot;Lead&quot;, {!$Record.RecordType.Name} = &quot;Sales Lead&quot;), 
	 OR(ISPICKVAL({!$Record.Status}, &quot;Marketing Qualified Lead&quot;),ISPICKVAL({!$Record.Status}, &quot;Sales Generated Lead&quot;)), 
     {!$Record.Core_Covered_account_owner__c}={!$Record.Core_Lead_Owner_Name__c}, {!$Record.Core_Is_Covered_Account__c}=true ),
	 AND( 
		 OR(ISCHANGED({!$Record.Core_Existing_Covered_Account__c}), ISCHANGED({!$Record.OwnerId})), 
		{!$Record.Core_Flag_on_Queue_or_User__c} =&quot;User&quot;,OR({!$Record.RecordType.Name} = &quot;Lead&quot;, {!$Record.RecordType.Name} = &quot;Sales Lead&quot;), 
		OR(ISPICKVAL({!$Record.Status}, &quot;Marketing Qualified Lead&quot;),ISPICKVAL({!$Record.Status}, &quot;Sales Generated Lead&quot;)),
		{!$Record.Core_Covered_account_owner__c}={!$Record.Core_Lead_Owner_Name__c}, {!$Record.Core_Is_Covered_Account__c}=true ))</expression>
    </formulas>
    <formulas>
        <name>F_Core_Email_Notification_For_LeadOwnership_Change</name>
        <dataType>Boolean</dataType>
        <expression>OR(
AND( OR({!$Record.RecordType.Name} = &quot;Lead&quot;, {!$Record.RecordType.Name} = &quot;Sales Lead&quot;),OR(ISPICKVAL({!$Record.Status}, &quot;Marketing Qualified Lead&quot;),
ISPICKVAL({!$Record.Status}, &quot;Sales Generated Lead&quot;)),
ISCHANGED({!$Record.OwnerId}), {!$Record.Core_Flag_on_Queue_or_User__c} =&quot;User&quot;,
OR({!$Record.Core_Covered_account_owner__c} &lt;&gt; {!$Record.Core_Lead_Owner_Name__c}, {!$Record.Core_Covered_account_owner__c} = null) ),

AND( OR({!$Record.RecordType.Name} = &quot;Lead&quot;, {!$Record.RecordType.Name} = &quot;Sales Lead&quot;),
ISPICKVAL( {!$Record.Status}, &quot;Sales Accepted Lead&quot; ), ISCHANGED({!$Record.OwnerId}),
{!$Record.Core_Flag_on_Queue_or_User__c} =&quot;User&quot; ))</expression>
    </formulas>
    <formulas>
        <name>F_Core_Update_State_Terminated</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISCHANGED({!$Record.Core_Lead_Status__c}),ISPICKVAL({!$Record.Core_Lead_Status__c} , &apos;Disqualified&apos;) ,
{!$Record.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos; , NOT(ISCHANGED({!$Record.OwnerId})) )</expression>
    </formulas>
    <formulas>
        <name>F_Core_Update_State_To_InPursuit</name>
        <dataType>Boolean</dataType>
        <expression>OR( AND( ISCHANGED({!$Record.Core_Lead_Status__c}),OR(ISPICKVAL({!$Record.Core_Lead_Status__c} , &apos;Accepted&apos;), ISPICKVAL({!$Record.Core_Lead_Status__c} , &apos;Qualified&apos;)),
  OR(ISPICKVAL((PRIORVALUE({!$Record.Core_Lead_Status__c})), &apos;New&apos;), ISPICKVAL((PRIORVALUE({!$Record.Core_Lead_Status__c})), &apos;Disqualified&apos;)), 
  {!$Record.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;, NOT(ISCHANGED({!$Record.OwnerId})) ),  
  
  AND( ISCHANGED({!$Record.OwnerId}), LEFT(PRIORVALUE({!$Record.OwnerId}),3) == &apos;00G&apos; , LEFT({!$Record.OwnerId},3) == &apos;005&apos; , 
  {!$Record.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos; )  )</expression>
    </formulas>
    <formulas>
        <name>F_Core_Update_Task_flag_on_Lead</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  AND ( NOT(ISNULL({!$Record.Core_Entrance_Date_SAL__c})),  {!$Record.Core_Having_Tasks__c}=true, {!$Record.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;,
  OR(ISPICKVAL(PRIORVALUE({!$Record.Status}), &apos;Marketing Qualified Lead&apos;),ISPICKVAL(PRIORVALUE({!$Record.Status}), &apos;Sales Generated Lead&apos;))), 
  
  AND ( {!$Record.Core_Having_Tasks__c}=true, ISPICKVAL({!$Record.Status}, &apos;Sales Accepted Lead&apos;) ,
  {!$Record.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;, ISPICKVAL(PRIORVALUE({!$Record.Core_Lead_Status__c}), &apos;Disqualified&apos;),
  ISPICKVAL({!$Record.Core_Lead_Status__c}, &apos;Qualified&apos;) ) 
  )</expression>
    </formulas>
    <formulas>
        <name>F_ONCOVERT_Core_SQL_Converted_UserFormula</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName} +&apos; &apos;+{!$User.LastName}</expression>
    </formulas>
    <formulas>
        <name>getIDinFormated</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Id}, 14)</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>Lead_Update_Stage_Stage_Date_Time_Formula</name>
        <dataType>Boolean</dataType>
        <expression>(ISCHANGED({!$Record.Core_Lead_State__c}) || ISCHANGED({!$Record.Status}) )</expression>
    </formulas>
    <interviewLabel>SWS_Flows_After {!$Flow.CurrentDateTime}</interviewLabel>
