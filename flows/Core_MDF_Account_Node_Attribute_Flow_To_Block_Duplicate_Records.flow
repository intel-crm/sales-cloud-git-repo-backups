<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assigning_External_ID_to_a_variable</name>
        <label>Assigning External ID to a variable</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_External_ID__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GeneratedExternalID</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_existing_GL_records</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Error_message</name>
        <label>Error message</label>
        <locationX>50</locationX>
        <locationY>611</locationY>
        <customErrorMessages>
            <errorMessage>GL Record already exists for the selected Account.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_Existing_GL_records</name>
        <label>Check Existing GL records</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>Update_External_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_record_exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>existingRecordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_message</targetReference>
            </connector>
            <label>Account record exists</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>GeneratedExternalID</name>
        <dataType>String</dataType>
        <expression>{!$Record.RecordTypeId}&amp;{!$Record.Core_MDF_Program_id__c}&amp;{!$Record.Core_MDF_Account_id__c}</expression>
    </formulas>
    <interviewLabel>Account Node Attribute {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Node Attribute flow to block duplicate records</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_existing_GL_records</name>
        <label>Get existing GL records</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Existing_GL_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_External_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_External_ID__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012Dz000000H558IAC</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Account_Node_Attributes__c</object>
        <outputAssignments>
            <assignToReference>existingRecordId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_External_Id</name>
        <label>Update External Id</label>
        <locationX>314</locationX>
        <locationY>611</locationY>
        <inputAssignments>
            <field>Core_MDF_External_ID__c</field>
            <value>
                <elementReference>GeneratedExternalID</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assigning_External_ID_to_a_variable</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012Dz000000H558IAC</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Account_Node_Attributes__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>existingRecordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>existingRecordName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
