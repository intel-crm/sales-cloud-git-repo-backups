    <actionCalls>
        <name>Parse_PIPL_JSON_Content</name>
        <label>Parse PIPL JSON Content</label>
        <locationX>1513</locationX>
        <locationY>276</locationY>
        <actionName>UCD_ACM_PIPLConsentParser</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_Output_Data</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>jsonData</name>
            <value>
                <elementReference>$Record.Content__c</elementReference>
            </value>
        </inputParameters>
        <nameSegment>UCD_ACM_PIPLConsentParser</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Output_Data</name>
        <label>Check Output Data</label>
        <locationX>1513</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Set_Integration_message_queue_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Error</defaultConnectorLabel>
        <rules>
            <name>Data_Exists</name>
            <conditionLogic>1 AND 2</conditionLogic>
            <conditions>
                <leftValueReference>Parse_PIPL_JSON_Content.emailId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Parse_PIPL_JSON_Content.cnsntDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Records_from_Contact</targetReference>
            </connector>
            <label>Data Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Compare_Consent_Date_value</name>
        <label>Compare Consent Date value</label>
        <locationX>50</locationX>
        <locationY>816</locationY>
        <defaultConnector>
            <targetReference>Update_ACM_Integration_Message_Queu</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Set message Queue status</defaultConnectorLabel>
        <rules>
            <name>Update_PIPL_ConsentDate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Records_from_Contact.PIPL_Consent_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Parse_PIPL_JSON_Content.cnsntDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PIPL_Consent_Date_In_Contact</targetReference>
            </connector>
            <label>Update PIPL ConsentDate</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Contact_Record_Exists</name>
        <label>If Contact Record Exists</label>
        <locationX>864</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Update_ACM_Integration_Message_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Set ACM Integration Message Queue</defaultConnectorLabel>
        <rules>
            <name>Check_PIPL_Consent_Date_in_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Records_from_Contact.Email</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Parse_PIPL_JSON_Content.emailId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Records_from_Contact.MailingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CHN</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_PIPL_Consent_Date_Exists</targetReference>
            </connector>
            <label>Check PIPL Consent Date in Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_PIPL_Consent_Date_Exists</name>
        <label>If PIPL Consent Date Exists</label>
        <locationX>358</locationX>
        <locationY>708</locationY>
        <defaultConnector>
            <targetReference>Update_PIPL_Consent_Date_In_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Update PIPL Consent Date</defaultConnectorLabel>
        <rules>
            <name>If_Exists_Compare_the_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Records_from_Contact.PIPL_Consent_Date__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Compare_Consent_Date_value</targetReference>
            </connector>
            <label>If Exists Compare the Date</label>
        </rules>
    </decisions>
    <description>Process the Integration message and stores the PIPL consent date in Contact object.</description>
