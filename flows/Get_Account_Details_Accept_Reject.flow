    <decisions>
        <name>Check_CM_GM_VP</name>
        <label>Check CM/GM/VP</label>
        <locationX>1458</locationX>
        <locationY>650</locationY>
        <defaultConnector>
            <targetReference>Loop_through_Account_Feedback_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IF_GM_Approved_or_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isGMUpdated</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_GM_Records</targetReference>
            </connector>
            <label>IF GM Approved or Rejected</label>
        </rules>
        <rules>
            <name>IF_CM_Approved_or_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isCMUpdated</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_CM_Records</targetReference>
            </connector>
            <label>IF CM Approved or Rejected</label>
        </rules>
        <rules>
            <name>IF_VP_Approved_or_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isVPUpdated</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_VP_Records</targetReference>
            </connector>
            <label>IF VP Approved or Rejected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_RA</name>
        <label>Check if RA</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Get_Account_Feedback_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.CST_Regional_Admin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Security_Mapping_Regions_of_RA_manager</targetReference>
            </connector>
            <label>RA</label>
        </rules>
    </decisions>
    <decisions>
        <name>Filter_CM_Records</name>
        <label>Filter CM Records</label>
        <locationX>1238</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>Loop_through_Account_Feedback_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_User_is_Regional_Admin_2</name>
            <conditionLogic>1 AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.CST_Regional_Admin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>securtiyMappingRegionCollection</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_through_Account_Feedback_Records.Account_ID__r.CST_Region__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Account_Feedback_Records.Account_ID__r.Account_Owner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CM_Field_Regional_Admin</targetReference>
            </connector>
            <label>If User is Regional Admin</label>
        </rules>
        <rules>
            <name>CM_Records</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_Account_Feedback_Records.Account_ID__r.VP__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>UserID</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Account_Feedback_Records.Account_ID__r.TA_VP__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>UserID</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_through_Account_Feedback_Records.Account_ID__r.Account_Owner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CM_Field</targetReference>
            </connector>
            <label>CM Records</label>
        </rules>
    </decisions>
