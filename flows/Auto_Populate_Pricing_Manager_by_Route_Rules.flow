        <name>Invoke_Expression_Set_for_ASMO_Based_on_Quote_Program_Type</name>
        <label>Invoke Expression Set  for ASMO Based on Quote Program Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Invoke_Apex_Action_To_Assign_Pricing_Manager</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Quote_Program_of_Type_CCG</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Program_Type_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Client</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_Based_on_Market_Segment</targetReference>
            </connector>
            <label>Is Quote Program of Type CCG</label>
        </rules>
        <rules>
            <name>Is_Quote_Program_of_Type_DCG</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Program_Type_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Data Center</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_End_Customer_on_CSP_List</targetReference>
            </connector>
            <label>Is Quote Program of Type DCG</label>
        </rules>
    </decisions>
    <decisions>
        <name>Invoke_Expression_Set_for_EMEA_Based_on_Quote_Program_Type</name>
        <label>Invoke Expression Set for EMEA Based on Quote Program Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
