    <decisions>
        <name>Determine_Region_to_Invoke_Expression_Set</name>
        <label>Determine Region to Invoke Expression Set</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Invoke_Apex_Action_To_Assign_Pricing_Manager</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Region_ASMO</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Region_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ASMO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_for_ASMO_Based_on_Quote_Program_Type</targetReference>
            </connector>
            <label>Is Region ASMO</label>
        </rules>
        <rules>
            <name>Is_Region_EMEA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Region_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_for_EMEA_Based_on_Quote_Program_Type</targetReference>
            </connector>
            <label>Is Region EMEA</label>
        </rules>
        <rules>
            <name>Is_Region_APJ</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Region_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>APJ</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_for_APJ_Based_On_Quote_Program_Type</targetReference>
            </connector>
            <label>Is Region APJ</label>
        </rules>
        <rules>
            <name>Is_Region_PRC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Region_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PRC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_for_PRC_Based_On_Quote_Program_Type</targetReference>
            </connector>
            <label>Is Region PRC</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_the_Expression_Set_Based_on_Application_Type</name>
        <label>Determine the Expression Set Based on Application Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Invoke_Apex_Action_To_Assign_Pricing_Manager</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Invoke_Expression_Set_If_End_Customer_Not_in_CSP_List</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_End_Customer_on_CSP_List.isEndCustomerOnAnyList</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ASMO_DCG_Expression_Set_Route_Rule</targetReference>
            </connector>
            <label>Invoke Expression Set If End Customer Not in CSP  List</label>
        </rules>
        <rules>
            <name>Invoke_Final_Apex_Call_If_End_Customer_Is_In_CSP_List</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_End_Customer_on_CSP_List.isEndCustomerOnAnyList</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_RPM_Email_And_Other_Details</targetReference>
            </connector>
            <label>Invoke Apex Call If End Customer Is In CSP List</label>
        </rules>
    </decisions>
    <decisions>
        <name>Invoke_Expression_Set_Based_on_CR</name>
        <label>Invoke Expression Set Based on CR</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Invoke_Apex_Action_To_Assign_Pricing_Manager</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_CR_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_New_Change_Request_cb__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EMEA_DCG_Non_HPC_CR_Expression_Set_Route_Rule</targetReference>
            </connector>
            <label>Is CR True</label>
        </rules>
        <rules>
            <name>Is_CR_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Change_Request_cb__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_End_Customer_On_Exclusion_List</targetReference>
            </connector>
            <label>Is CR False</label>
