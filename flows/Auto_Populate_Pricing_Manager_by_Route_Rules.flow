    <decisions>
        <name>Invoke_Expression_Set_for_EMEA_Based_on_Quote_Program_Type</name>
        <label>Invoke Expression Set for EMEA Based on Quote Program Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Quote_Program_of_Type_EMEA_CCG</name>
