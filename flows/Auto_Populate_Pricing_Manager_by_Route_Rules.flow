    <description>This Flow is to auto populate the Pricing Manager on the quote when the status gets updated to PFIR</description>
    <environments>Default</environments>
    <formulas>
        <name>Pricing_Total_Requested_Quantity</name>
        <dataType>Number</dataType>
        <expression>VALUE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(TEXT({!$Record.SBQQ__Quote__r.Pricing_Overall_Quote_Quantity__c}), &quot;,&quot;, &quot;&quot;), &quot;(&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Auto Populate Pricing Manager {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Auto Populate Pricing Manager by Route Rules</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Quote_Line_Records</name>
        <label>Get Quote Line Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Determine_Region_to_Invoke_Expression_Set</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SBQQ__QuoteLine__c</object>
        <queriedFields>Id</queriedFields>
        <sortField>Pricing_Quote_Line_Number__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Quote_Line_Records</targetReference>
        </connector>
        <filterFormula>AND(TEXT({!$Record.SBQQ__Quote__r.Pricing_Quote_Program_Nm__c}) = &apos;Tender&apos;, TEXT({!$Record.Pricing_Status_Nm__c}) = &apos;Pending Further Intel Review&apos;, OR(ISNEW(), ISCHANGED({!$Record.Pricing_Status_Nm__c} )) )</filterFormula>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Is_EndCustomer_On_CSP_List</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
