    <decisions>
        <name>Determine_Region_to_Invoke_Expression_Set</name>
        <label>Determine Region to Invoke Expression Set</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Region_ASMO</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Region_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ASMO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_for_ASMO_Based_on_Quote_Program_Type</targetReference>
            </connector>
            <label>Is Region ASMO</label>
        </rules>
        <rules>
            <name>Is_Region_EMEA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Region_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_for_EMEA_Based_on_Quote_Program_Type</targetReference>
            </connector>
            <label>Is Region EMEA</label>
        </rules>
        <rules>
            <name>Is_Region_APJ</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Region_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>APJ</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_for_APJ_Based_On_Quote_Program_Type</targetReference>
            </connector>
            <label>Is Region APJ</label>
        </rules>
        <rules>
            <name>Is_Region_PRC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Region_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PRC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_for_PRC_Based_On_Quote_Program_Type</targetReference>
            </connector>
            <label>Is Region PRC</label>
        </rules>
    </decisions>
    <decisions>
        <name>Invoke_Expression_Set_Based_On_Application_Type</name>
        <label>Invoke Expression Set Based On Application Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Server_Deal_Type_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>HPC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EMEA_DCG_HPC_No_CR_Expression_Set_Route_Rule</targetReference>
            </connector>
            <label>Is Of HPC Application</label>
        </rules>
        <rules>
            <name>Is_of_Non_HPC_Application</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Server_Deal_Type_Nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>HPC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_End_Customer_On_Exclusion_List</targetReference>
            </connector>
            <label>Is of Non HPC Application</label>
        </rules>
    </decisions>
    <decisions>
        <name>Invoke_Expression_Set_Based_on_Change_Request</name>
        <label>Invoke Expression Set Based on Change Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_CR_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Change_Request_cb__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EMEA_DCG_CR_Expression_Set_Route_Rule</targetReference>
            </connector>
            <label>Is CR True</label>
        </rules>
        <rules>
            <name>Is_CR_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.Pricing_Change_Request_cb__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_Based_On_Application_Type</targetReference>
            </connector>
            <label>Is CR False</label>
        </rules>
    </decisions>
