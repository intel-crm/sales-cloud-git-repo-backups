    <description>This Flow is to auto populate the Pricing Manager on the quote when the status gets updated to PFIR</description>
    <environments>Default</environments>
    <formulas>
        <name>IsRoutingRuleTriggerSwitchEnabled</name>
        <dataType>Boolean</dataType>
        <expression>{!$CustomMetadata.Trigger_Execution__mdt.Pricing_RoutingRulesSwitch.Active__c}</expression>
    </formulas>
    <formulas>
        <name>Pricing_LogEntry_ErrorMessage</name>
        <dataType>String</dataType>
        <expression>{!$Label.Pricing_IQR_Support_Email_Subject} + &apos; &apos; +  &apos;SBQQ__QuoteLine__c&apos; + &apos; &apos; + &apos;sObject Id: &apos; +{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>Pricing_Total_Requested_Quantity</name>
        <dataType>Number</dataType>
        <expression>VALUE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(TEXT({!$Record.SBQQ__Quote__r.Pricing_Overall_Quote_Quantity__c}), &quot;,&quot;, &quot;&quot;), &quot;(&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Auto Populate Pricing Manager {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Auto Populate Pricing Manager by Route Rules</label>
