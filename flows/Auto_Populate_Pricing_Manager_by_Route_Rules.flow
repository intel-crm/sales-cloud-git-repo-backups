                <rightValue>
                    <stringValue>Data Center</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_Expression_Set_Based_on_Server_Deal_Type</targetReference>
            </connector>
            <label>Is Quote Program of Type EMEA DCG</label>
        </rules>
    </decisions>
    <decisions>
        <name>Invoke_Expression_Set_for_PRC_Based_On_Quote_Program_Type</name>
        <label>Invoke Expression Set for PRC Based On Quote Program Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Invoke_Apex_Action_To_Assign_Pricing_Manager</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Quote_Program_of_Type_PRC_DCG</name>
