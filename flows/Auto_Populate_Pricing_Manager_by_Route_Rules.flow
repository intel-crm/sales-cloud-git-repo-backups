        <queriedFields>Id</queriedFields>
        <sortField>Pricing_Quote_Line_Number__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
