    <decisions>
        <name>Is_Routing_Rules_Switch_Enabled</name>
        <label>Is Routing Rules Switch Enabled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Switch_On</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsRoutingRuleTriggerSwitchEnabled</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote_Line_Records</targetReference>
            </connector>
            <label>Switch On</label>
        </rules>
