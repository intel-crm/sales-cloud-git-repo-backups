    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Case].RecordType.DeveloperName =&quot;Core_MDF_Audit&quot;,   
ISPICKVAL(([Case].Core_MDF_Status__c),&apos;Pending Documents&apos;),
[Case].Core_MDF_Channel_Program_txt__c = $Label.Core_MDF_Retail_Channel_Program_Name
)</stringValue>
