    <recordLookups>
        <name>Get_Opp_Product</name>
        <label>Get Opp Product</label>
        <locationX>638</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_on_OLI</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CRM_VBS_SOAR_Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Lost</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Delete In Progress (&lt;15 min)</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_SOAR_Products</name>
        <label>Get SOAR Products</label>
        <locationX>638</locationX>
