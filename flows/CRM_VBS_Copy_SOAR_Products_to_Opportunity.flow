    <decisions>
        <name>checking_if_the_field_value_are_in_sync</name>
        <label>checking if the field value are in sync</label>
        <locationX>858</locationX>
        <locationY>1116</locationY>
        <defaultConnector>
            <targetReference>Loop_SOAR_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Field_value_changed_or_not</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_SOAR_Product.CRM_VBS_Write_In_Product_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Loop_SOAR_Product.CRM_VBS_Opportunity_Product__r.Core_Write_In_Product_Name__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_SOAR_Product.CRM_VBS_Vendor__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Loop_SOAR_Product.CRM_VBS_Opportunity_Product__r.Core_Vendor__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_SOAR_Product.CRM_VBS_Quantity__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Loop_SOAR_Product.CRM_VBS_Opportunity_Product__r.Quantity</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_SOAR_Product.CRM_VBS_UnitPrice__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Loop_SOAR_Product.CRM_VBS_Opportunity_Product__r.UnitPrice</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_existing_values_in_oli</targetReference>
            </connector>
            <label>Field value changed or not</label>
        </rules>
    </decisions>
    <decisions>
        <name>Matching_Existing_OLI_from_Existing_SOAR_Product</name>
        <label>Matching Existing OLI from Existing SOAR Product</label>
        <locationX>1012</locationX>
        <locationY>1008</locationY>
        <defaultConnector>
            <targetReference>Create_OLI</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_OLI_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Opportunity_Product_Ids</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_SOAR_Product.CRM_VBS_Opportunity_Product__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>checking_if_the_field_value_are_in_sync</targetReference>
            </connector>
            <label>if OLI Exist</label>
        </rules>
    </decisions>
    <environments>Default</environments>
