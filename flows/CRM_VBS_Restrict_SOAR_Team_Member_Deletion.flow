<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Cannot_Delete_OO_message</name>
        <label>Cannot Delete OO message</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <customErrorMessages>
            <errorMessage>Cannot delete Technical Owner (100%) or Opportunity Owner (100%) on SOAR Team.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Opp_DW_Error</name>
        <label>Opp DW Error</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <customErrorMessages>
            <errorMessage>SOAR Cannot be modified Once Contract is Signed or Opportunity is Closed.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>SOAR3_Error</name>
        <label>SOAR3 Error</label>
        <locationX>578</locationX>
        <locationY>395</locationY>
        <customErrorMessages>
            <errorMessage>SOAR Products/Team cannot be modified after SOAR VBS Decision is SOAR3 Approved.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>check_for_Delete_Validation</name>
        <label>check for Delete Validation</label>
        <locationX>512</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>getSOARShare</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_OO_Or_Technical_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>checkOOTCvalidation</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass_SOAR_DW_Check__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Cannot_Delete_OO_message</targetReference>
            </connector>
            <label>Is OO Or Technical Owner</label>
        </rules>
        <rules>
            <name>Opp_is_DW_PW</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 OR 5 OR 7) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR4 Contract Signed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass_SOAR_DW_Check__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opp_DW_Error</targetReference>
            </connector>
            <label>Opp is DW/PW/Lost</label>
        </rules>
        <rules>
            <name>SOAR3_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR3 Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Core_Opp_Bypass_Validation_Rule__c.Bypass_SOAR_DW_Check__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SOAR3_Error</targetReference>
            </connector>
            <label>SOAR3 Approved</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_Is_OTM_true</name>
        <label>check Is OTM true</label>
        <locationX>974</locationX>
        <locationY>911</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>OTM_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Is_Copy_OTM__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>check_In_OTM</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Opp_Share</targetReference>
            </connector>
            <label>OTM False</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_user_in_share</name>
        <label>check user in share</label>
        <locationX>974</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>check_In_OTM</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>user_is_present_in_SOAR_share</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getSOARShare</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_SOAR_sharing</targetReference>
            </connector>
            <label>user is present in SOAR share</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>checkOOTCvalidation</name>
        <dataType>Boolean</dataType>
        <expression>({!$Record.CRM_VBS_Team_member__c} == {!$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.OwnerId} &amp;&amp; ISPICKVAL({!$Record.CRM_VBS_Team_Role__c}, &apos;Opportunity Owner (100%)&apos;)) || ({!$Record.CRM_VBS_Team_member__c} == {!$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__r.Core_Technical_Owner__c} &amp;&amp; ISPICKVAL({!$Record.CRM_VBS_Team_Role__c}, &apos;Technical Owner (100%)&apos;))</expression>
    </formulas>
    <interviewLabel>Restrict SOAR Team Member Deletion {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Restrict SOAR Team Member Deletion</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_Opp_Share</name>
        <label>Delete Opp Share</label>
        <locationX>842</locationX>
        <locationY>1019</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UserOrGroupId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CRM_VBS_Team_member__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>OpportunityAccessLevel</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>All</stringValue>
            </value>
        </filters>
        <object>OpportunityShare</object>
    </recordDeletes>
    <recordDeletes>
        <name>Delete_SOAR_sharing</name>
        <label>Delete SOAR sharing</label>
        <locationX>842</locationX>
        <locationY>611</locationY>
        <connector>
            <targetReference>check_In_OTM</targetReference>
        </connector>
        <inputReference>getSOARShare</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>check_In_OTM</name>
        <label>check In OTM</label>
        <locationX>974</locationX>
        <locationY>803</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>check_Is_OTM_true</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CRM_VBS_SOAR__r.CRM_VBS_SOAR_Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>UserId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CRM_VBS_Team_member__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityTeamMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>getSOARShare</name>
        <label>getSOARShare</label>
        <locationX>974</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>check_user_in_share</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccessLevel</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>All</stringValue>
            </value>
        </filters>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CRM_VBS_SOAR__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>UserOrGroupId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CRM_VBS_Team_member__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CRM_VBS_SOAR__Share</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>386</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>check_for_Delete_Validation</targetReference>
        </connector>
        <object>CRM_VBS_SOAR_Team__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
