    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Lead_Assignment_Rules</targetReference>
        </connector>
        <filterFormula>AND(TEXT({!$Record__Prior.Status}) = &apos;Marketing Engaged Lead&apos;, TEXT({!$Record.Status}) = &apos;Marketing Qualified Lead&apos;, ISCHANGED({!$Record.Status}))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
