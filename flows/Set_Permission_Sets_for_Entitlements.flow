                <rightValue>
                    <elementReference>RMF_ClaimSubmitter_Entitlement</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_CCFB_Claim_Submitter_Contact_Entitlement</targetReference>
            </connector>
            <label>Retail Claim Submitter</label>
        </rules>
    </decisions>
