    <decisions>
        <description>Check CCFB User Permission Set is assigned</description>
        <name>Check_CCFB_User_Permission_Set_is_assigned</name>
        <label>Check CCFB User Permission Set is assigned</label>
        <locationX>2917</locationX>
        <locationY>349</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CCFB_User_Permission_Set_is_not_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vCCFBUserPermissionSet</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CCFB_User_Permission_Set_Assignment</targetReference>
            </connector>
            <label>CCFB User Permission Set is not exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_CCF_or_DCF_or_SPCF_or_CCFB</name>
        <label>Check If CCF or DCF or SPCF or CCFB</label>
        <locationX>2652</locationX>
        <locationY>520</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>CCF_User_Permission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EngagementTechnicalName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>CCFEngagementName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Wait_for_CCF_entitlement</targetReference>
            </connector>
            <label>CCF User Permission</label>
        </rules>
        <rules>
            <name>DCF_USER_Permission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EngagementTechnicalName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>DCFEngaggementName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Wait_for_DCF_entitlement</targetReference>
            </connector>
            <label>DCF USER Permission</label>
        </rules>
        <rules>
            <name>SPCF_User_Permission1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EngagementTechnicalName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>SPCFEngagementName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Wait_for_SPCF_entitlement</targetReference>
            </connector>
            <label>SPCF User Permission1</label>
        </rules>
        <rules>
            <name>CCFB_User_Permission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EngagementTechnicalName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>CCFB_Engagement_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Wait_for_CCFB_Entitlement</targetReference>
            </connector>
            <label>CCFB User Permission</label>
        </rules>
        <rules>
            <name>Retail_User_Permission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EngagementTechnicalName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>RetailEngagementName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Wait_for_Retail_Entitlement_0</targetReference>
            </connector>
            <label>Retail User Permission</label>
        </rules>
    </decisions>
