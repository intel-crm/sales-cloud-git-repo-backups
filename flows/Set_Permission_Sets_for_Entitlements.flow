<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Which_Entitlement</name>
        <label>Which Entitlement?</label>
        <locationX>271</locationX>
        <locationY>308</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Partner_Portal_DDR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EntitlementID</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>DDREntitlementID</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DDR_Permission_set_assignment</targetReference>
            </connector>
            <label>Partner Portal - DDR</label>
        </rules>
        <rules>
            <name>Partner_Portal_IPS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EntitlementID</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>IPSEntitlementID</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IPS_Permission_Set_Assignment</targetReference>
            </connector>
            <label>Partner Portal - IPS</label>
        </rules>
        <rules>
            <name>Partner_Portal_Leads</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EntitlementID</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>LeadsEntitlementID</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Leads_Permission_Set_Assignment</targetReference>
            </connector>
            <label>Partner Portal - Leads</label>
        </rules>
        <rules>
            <name>Partner_FAE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EntitlementID</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>PartnerFAEEntitlementID</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Partner_FAE_Permission_Set_Assignment</targetReference>
            </connector>
            <label>Partner FAE</label>
        </rules>
    </decisions>
    <description>Called from PB Flow A&amp;E Set Permission Sets for Contact Entitlements

Automatically sets permission sets for those entitlements which need them.  Also adds the user to DDR and Lead public groups respectively</description>
    <formulas>
        <name>DDREntitlementID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_Partner_Portal_DDR_ID}</expression>
    </formulas>
    <formulas>
        <name>DDRPermissionSetID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_DDR_Permission_Set_ID}</expression>
    </formulas>
    <formulas>
        <name>DDRPublicGroupID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_DDR_Public_Group_ID}</expression>
    </formulas>
    <formulas>
        <name>IPSEntitlementID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_Partner_Portal_IPS_Id}</expression>
    </formulas>
    <formulas>
        <name>IPSPermissionSetID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_IPS_Permission_Set_ID}</expression>
    </formulas>
    <formulas>
        <name>LeadsEntitlementID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_Partner_Portal_Leads_Id}</expression>
    </formulas>
    <formulas>
        <name>LeadsPermissionSetID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_Leads_Permission_Set_ID}</expression>
    </formulas>
    <formulas>
        <name>LeadsPublicGroupID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_Leads_Public_Group_ID}</expression>
    </formulas>
    <formulas>
        <name>PartnerFAEEntitlementID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_Partner_FAE_Entitlement_ID}</expression>
    </formulas>
    <formulas>
        <name>PartnerFAEPermissionSetID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_Partner_FAE_Permission_Set_ID}</expression>
    </formulas>
    <interviewLabel>Set Permission Sets for Entitlements {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Permission Sets and Groups for Entitlements</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Add_user_to_DDR_Group</name>
        <label>Add user to DDR Group</label>
        <locationX>31</locationX>
        <locationY>371</locationY>
        <assignRecordIdToReference>DDRGroupMemberID</assignRecordIdToReference>
        <inputAssignments>
            <field>GroupId</field>
            <value>
                <elementReference>DDRPublicGroupID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UserOrGroupId</field>
            <value>
                <elementReference>UserID</elementReference>
            </value>
        </inputAssignments>
        <object>GroupMember</object>
    </recordCreates>
    <recordCreates>
        <name>Add_user_to_Lead_Group</name>
        <label>Add user to Lead Group</label>
        <locationX>190</locationX>
        <locationY>584</locationY>
        <assignRecordIdToReference>LeadsGroupMemberID</assignRecordIdToReference>
        <inputAssignments>
            <field>GroupId</field>
            <value>
                <elementReference>LeadsPublicGroupID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UserOrGroupId</field>
            <value>
                <elementReference>UserID</elementReference>
            </value>
        </inputAssignments>
        <object>GroupMember</object>
    </recordCreates>
    <recordCreates>
        <name>DDR_Permission_set_assignment</name>
        <label>DDR Permission set assignment</label>
        <locationX>30</locationX>
        <locationY>233</locationY>
        <assignRecordIdToReference>PermissionSetID</assignRecordIdToReference>
        <connector>
            <targetReference>Add_user_to_DDR_Group</targetReference>
        </connector>
        <inputAssignments>
            <field>AssigneeId</field>
            <value>
                <elementReference>UserID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PermissionSetId</field>
            <value>
                <elementReference>DDRPermissionSetID</elementReference>
            </value>
        </inputAssignments>
        <object>PermissionSetAssignment</object>
    </recordCreates>
    <recordCreates>
        <name>IPS_Permission_Set_Assignment</name>
        <label>IPS Permission Set Assignment</label>
        <locationX>439</locationX>
        <locationY>474</locationY>
        <inputAssignments>
            <field>AssigneeId</field>
            <value>
                <elementReference>UserID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PermissionSetId</field>
            <value>
                <elementReference>IPSPermissionSetID</elementReference>
            </value>
        </inputAssignments>
        <object>PermissionSetAssignment</object>
    </recordCreates>
    <recordCreates>
        <name>Leads_Permission_Set_Assignment</name>
        <label>Leads Permission Set Assignment</label>
        <locationX>187</locationX>
        <locationY>473</locationY>
        <connector>
            <targetReference>Add_user_to_Lead_Group</targetReference>
        </connector>
        <inputAssignments>
            <field>AssigneeId</field>
            <value>
                <elementReference>UserID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PermissionSetId</field>
            <value>
                <elementReference>LeadsPermissionSetID</elementReference>
            </value>
        </inputAssignments>
        <object>PermissionSetAssignment</object>
    </recordCreates>
    <recordCreates>
        <name>Partner_FAE_Permission_Set_Assignment</name>
        <label>Partner FAE Permission Set Assignment</label>
        <locationX>485</locationX>
        <locationY>279</locationY>
        <inputAssignments>
            <field>AssigneeId</field>
            <value>
                <elementReference>UserID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PermissionSetId</field>
            <value>
                <elementReference>PartnerFAEPermissionSetID</elementReference>
            </value>
        </inputAssignments>
        <object>PermissionSetAssignment</object>
    </recordCreates>
    <recordLookups>
        <name>Lookup_User</name>
        <label>Lookup User</label>
        <locationX>271</locationX>
        <locationY>80</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Which_Entitlement</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContactID</elementReference>
            </value>
        </filters>
        <object>User</object>
        <outputAssignments>
            <assignToReference>UserID</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <startElementReference>Lookup_User</startElementReference>
    <status>Active</status>
