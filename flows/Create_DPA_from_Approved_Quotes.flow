    <decisions>
        <name>Check_BCGTDC</name>
        <label>Check BCGTDC</label>
        <locationX>929</locationX>
        <locationY>556</locationY>
        <defaultConnector>
            <targetReference>AssignIfBCGTDC</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes, BC is greater than DC</defaultConnectorLabel>
        <rules>
            <name>No_BC_is_not_greater_than_DC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_if_BC_GT_DC.price_brokencost_amt__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Check_if_BC_GT_DC.price_disty_cost_nbr__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_BC_GT_DC</targetReference>
            </connector>
            <label>No, BC is not greater than DC</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckForTPQuote</name>
        <label>CheckForTPQuote</label>
        <locationX>1810</locationX>
        <locationY>72</locationY>
        <defaultConnector>
            <targetReference>GetQuoteLinesIfNotTP</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If not TP Quote</defaultConnectorLabel>
        <rules>
            <name>If_TP_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QuoteType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Transfer Pricing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetQuoteLinesIfTP</targetReference>
            </connector>
            <label>If TP Quote</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckifBCGTDC</name>
        <label>CheckifBCGTDC</label>
        <locationX>1215</locationX>
        <locationY>404</locationY>
        <defaultConnector>
            <targetReference>ShowError</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes, BC is greater than DC</defaultConnectorLabel>
        <rules>
            <name>No_BC_is_not_GT_DC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckBCGTDC</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_DPA_records</targetReference>
            </connector>
            <label>No, BC is not GT DC</label>
        </rules>
    </decisions>
    <description>Creating DPA and DPA Lines.</description>
    <dynamicChoiceSets>
        <name>ActiveandApprovedQuotes</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>core_cpq_active_cb__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>SBQQ__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>SBQQ__Quote__c</object>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Create DPA from Approved Quotes {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create DPA from Approved Quotes</label>
