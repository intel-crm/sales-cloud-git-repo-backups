<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>if_OTM_is_present_in_SOAR_Team</name>
        <label>if OTM is present in SOAR Team?</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.UserId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Soar_Team.CRM_VBS_Team_member__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_SOAR_Team_Member</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>v1 : For Intel-Led Growth Opportunity and VBS potential is checked, whenever OTM is deleted, the flow will sync it to SOAR Team.</description>
    <environments>Default</environments>
    <interviewLabel>CRM_Sync OTM Deletion on SOAR {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CRM_Sync OTM Deletion on SOAR Team</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_SOAR_Team_Member</name>
        <label>Delete SOAR Team Member</label>
        <locationX>50</locationX>
        <locationY>611</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_SOAR__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CRM_VBS_Team_member__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.UserId</elementReference>
            </value>
        </filters>
        <object>CRM_VBS_SOAR_Team__c</object>
    </recordDeletes>
    <recordLookups>
        <name>Get_SOAR_Record</name>
        <label>Get SOAR Record</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Soar_Team</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_SOAR_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Soar_Team</name>
        <label>Get Soar Team</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>if_OTM_is_present_in_SOAR_Team</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_SOAR__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>CRM_VBS_Team_member__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.UserId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR_Team__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_SOAR_Record</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.Opportunity.Core_Opportunity_Coverage_Nm__c}, &apos;Intel-Led Opportunity&apos;) &amp;&amp; (OR(ISPICKVAL({!$Record.Opportunity.Core_VBS_Status__c} , &apos;Pending&apos;),ISPICKVAL({!$Record.Opportunity.Core_VBS_Status__c} , &apos;SOAR1 Qualified&apos;))) &amp;&amp; {!$Record.Opportunity.Core_VBS_Potential__c} &amp;&amp; {!$Record.User.IsActive} &amp;&amp; {!$Record.User.Core_User_Type__c}= &apos;Internal User&apos;</filterFormula>
        <object>OpportunityTeamMember</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
