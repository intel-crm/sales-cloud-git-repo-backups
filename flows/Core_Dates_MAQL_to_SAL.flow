<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Core_Dates_MAQL_to_SAL workflow rule
Workflow rule description: Exception Flow : The following fields should be stamped when the Lead Stage changes from &quot;Marketing Qualified Lead&quot; to &quot;Sales Accepted Lead&quot; for Record Type = Lead&quot;</description>
    <formulas>
        <name>Core_Entrance_Date_TALFormula</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <name>Core_Entrance_Date_TAPFormula</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <name>Core_Entrancee_Date_SALFormula</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <name>Core_Entrancee_Date_TQLFormula</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <name>Core_Exit_Date_MAQLFormula</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <name>Core_Exit_Datee_TALFormula</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <name>Core_Exitt_Date_TQLFormula</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <label>Core_Dates_MAQL_to_SAL</label>
    <migratedFromWorkflowRuleName>Core_Dates_MAQL_to_SAL</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Core_Entrance_Date_SAL__c</field>
            <value>
                <elementReference>Core_Entrancee_Date_SALFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Entrance_Date_TAL__c</field>
            <value>
                <elementReference>Core_Entrance_Date_TALFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Entrance_Date_TAP__c</field>
            <value>
                <elementReference>Core_Entrance_Date_TAPFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Entrance_Date_TQL__c</field>
            <value>
                <elementReference>Core_Entrancee_Date_TQLFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Exit_Date_MAQL__c</field>
            <value>
                <elementReference>Core_Exit_Date_MAQLFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Exit_Date_TAL__c</field>
            <value>
                <elementReference>Core_Exit_Datee_TALFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Exit_Date_TQL__c</field>
            <value>
                <elementReference>Core_Exitt_Date_TQLFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Lead_Status__c</field>
            <value>
                <stringValue>Accepted</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
        <filterFormula>AND (  ISPICKVAL(PRIORVALUE({!$Record.Status}), &quot;Marketing Qualified Lead&quot;),  ISPICKVAL({!$Record.Status}, &quot;Sales Accepted Lead&quot;),  {!$Record.RecordType.DeveloperName} =&apos;Lead&apos;, ISCHANGED({!$Record.Status} ), OR( ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;New&quot;), ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;Accepted&quot;) ) )</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
