<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Update_fields</name>
        <label>Update fields</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Claimed_date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimedLead</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_Claimed_Date</targetReference>
            </connector>
            <label>Update Claimed date</label>
        </rules>
        <rules>
            <name>Update_Qualified_In_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QualifiedInContact</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_QualifiedInContact_Date</targetReference>
            </connector>
            <label>Update Qualified In Contact</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ClaimedLead</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   AND(ISPICKVAL(PRIORVALUE({!$Record.Core_Lead_Status__c}), &apos;New&apos;), ISPICKVAL({!$Record.Core_Lead_Status__c} , &apos;Accepted&apos;)),
   AND(ISPICKVAL(PRIORVALUE({!$Record.Core_Lead_Sub_Status__c}) , &apos;Waiting to be Claimed&apos;), ISPICKVAL({!$Record.Core_Lead_Sub_Status__c} , &apos;Attempting Contact&apos;))
)</expression>
    </formulas>
    <formulas>
        <name>QualifiedInContact</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISPICKVAL({!$Record.Status}, &apos;Marketing Qualified Lead&apos;),
ISPICKVAL({!$Record.Core_Lead_Status__c} , &apos;Qualified&apos;),
ISPICKVAL({!$Record.Core_Lead_Sub_Status__c} , &apos;In Contact&apos;)
)</expression>
    </formulas>
    <interviewLabel>Update Lead for SLA {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Lead for SLA</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Populate_Claimed_Date</name>
        <label>Populate Claimed Date</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>SWS_Claimed_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Populate_QualifiedInContact_Date</name>
        <label>Populate QualifiedInContact Date</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>SWS_QualifiedInContact_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_fields</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Record.RecordType.Name} &lt;&gt; &apos;Partner Lead&apos;,
    OR(
        ISCHANGED({!$Record.Core_Lead_Status__c}),
        ISCHANGED({!$Record.Core_Lead_Sub_Status__c})
    )
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
