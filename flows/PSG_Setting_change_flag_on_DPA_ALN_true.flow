                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_DPA_ALN_instance</targetReference>
            </connector>
            <label>if change flag true</label>
        </rules>
    </decisions>
    <interviewLabel>PSG Setting change flag on DPA ALN true {!$Flow.CurrentDateTime}</interviewLabel>
