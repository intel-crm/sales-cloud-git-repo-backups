<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_if_claim_is_on_bank_hold</name>
        <label>Check if claim is on bank hold</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_Bank_Document_Hold_is_True</name>
            <conditionLogic>(1  OR (6 AND 7)) AND 2 AND 3 AND 4 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>BankDocumentHoldInd</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimProgram</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimRegion</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>EmailTemplateName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ClaimStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Claim_Status_Denied</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>BankDocumentHoldInd</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Check if Bank Document Hold is True</label>
        </rules>
    </decisions>
    <interviewLabel>Test(Claim Notification to Payment Admins on Bank Document Hold) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test(Claim Notification to Payment Admins on Bank Document Hold)</label>
