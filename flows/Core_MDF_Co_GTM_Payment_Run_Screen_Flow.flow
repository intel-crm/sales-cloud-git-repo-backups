    <environments>Default</environments>
    <formulas>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <expression>MID(
  $Flow.FaultMessage,
  FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, $Flow.FaultMessage) + 
  LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;),
  FIND(&quot;. You can look up&quot;, $Flow.FaultMessage) - 
  (FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, $Flow.FaultMessage) + 
  LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;))
)</expression>
    </formulas>
    <formulas>
        <name>FormattedAccountName</name>
        <dataType>String</dataType>
        <expression>&quot;• &quot; &amp;
SUBSTITUTE(
    {!varSemiColonSeparatedAccountName},
    &quot;;&quot;,
    BR() &amp; &quot;• &quot;
)</expression>
    </formulas>
    <formulas>
        <name>successMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Payment Run was created successfully. &quot; &amp;
&quot;&lt;a href=&apos;/lightning/r/Core_MDF_Payment_Run__c/&quot; &amp;
{!varPaymentRunRecord.Id} &amp;
&quot;/view&apos; target=&apos;_top&apos;&gt;Click here to view the Payment Run Record.&lt;/a&gt;&quot;</expression>
    </formulas>
    <interviewLabel>Co-GTM Payment Run Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Co-GTM Payment Run Screen Flow</label>
    <loops>
        <name>Loop_Through_IUPGM_Records</name>
        <label>Loop Through IUPGM Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_IUPGM_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>check_varSemiColonSeparatedAccounts_data</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Action</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Payment_Run_Record</name>
        <label>Create Payment Run Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen_on_Insertion</targetReference>
        </faultConnector>
        <inputReference>varPaymentRunRecord</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_IUPGM_Records</name>
        <label>Get IUPGM Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_IUPGM_Records_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_User_id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Active_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Program_nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CoGTM</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Role_nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_MDF_CCP_Internal_Co_GTM_Payment_Adm</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_is_User_Active_ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_MDF_Int_Users_Partner_Geo_Mapping__c</object>
        <sortField>Core_MDF_Account_Name_txt__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Original_Record</name>
        <label>Get Original Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Clone_Payment_Run</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_Payment_Run__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>Clone_Payment_Run</name>
        <label>Clone Payment Run</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Value_Assignment_for_Clone</targetReference>
        </connector>
        <fields>
            <name>Copy_1_of_HeaderDisplay2</name>
            <fieldText>&lt;h3 style=&quot;text-align: center;&quot;&gt;New Payment Run: Co-Engineering&lt;/h3&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Execution_Start_Date1</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>Get_Original_Record.Core_MDF_Start_Dt__c</elementReference>
            </defaultValue>
            <fieldText>Execution Start Date</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Execution_End_Date1</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>Get_Original_Record.Core_MDF_End_Dt__c</elementReference>
            </defaultValue>
            <fieldText>Execution End Date</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
