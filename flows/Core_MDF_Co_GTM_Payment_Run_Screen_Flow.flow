    <decisions>
        <name>Action</name>
        <label>Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>New_Payment_Run</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New</defaultConnectorLabel>
        <rules>
            <name>Clone</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Original_Record</targetReference>
            </connector>
            <label>Clone</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_User_Access</name>
        <label>Check User Access</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Screen_For_Access</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User doesnt have access</defaultConnectorLabel>
        <rules>
            <name>User_has_Access</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Core_MDF_CCP_Internal_Co_GTM_Payment_Adm</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_IUPGM_Records</targetReference>
            </connector>
            <label>User has Access</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_varSemiColonSeparatedAccounts_data</name>
        <label>check varSemiColonSeparatedAccounts data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_Semi_Colon</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>varSemiColonSeparatedAccounts_is_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSemiColonSeparatedAccounts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_Id</targetReference>
            </connector>
            <label>varSemiColonSeparatedAccounts is null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_IUPGM_Records_Exists</name>
        <label>Does IUPGM Records Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Screen_For_No_IUPGM_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>IUPGM Records Doesn&apos;t Exists</defaultConnectorLabel>
        <rules>
            <name>IUPGM_Records_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_IUPGM_Records</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_IUPGM_Records</targetReference>
            </connector>
            <label>IUPGM Records Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validate_inputs</name>
        <label>Validate inputs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>ConfirmationPopup</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Run for All Accounts is true</defaultConnectorLabel>
        <rules>
            <name>Validate_Account_Fields</name>
            <conditionLogic>(1 AND 2 AND 3) OR (4 AND 5 AND 6)</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Run_For_All_Accounts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSelectedAccounts</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Run_For_All_Accounts1</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSelectedAccounts1</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Screen_For_Both_Account_Fields_Selected</targetReference>
            </connector>
            <label>Validate Account Fields</label>
        </rules>
        <rules>
            <name>Run_For_All_Accounts_False_on_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Run_For_All_Accounts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSelectedAccounts</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Account_Assignment</targetReference>
            </connector>
            <label>Run For All Accounts False on New</label>
        </rules>
        <rules>
            <name>Run_For_All_Accounts_False_on_Clone</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Run_For_All_Accounts1</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varSelectedAccounts1</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clone_Account_Assignment</targetReference>
            </connector>
            <label>Run For All Accounts False on Clone</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>AccountChoices</name>
        <collectionReference>Get_IUPGM_Records</collectionReference>
