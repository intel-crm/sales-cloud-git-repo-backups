        <text>&lt;p&gt;Select either &apos;Run for All Accounts&apos; or choose one or more accounts from the &apos;Account&apos; list. These options cannot be used together, and one selection is required.&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>noAccessErrorMessage</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;You do not have permission to run Co-Engineering Payment.&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>NoIUPGMExistsError</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Payment cannot be run/scheduled as there are no accounts associated to the user.&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>SuccessMsg</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Payment Run was created successfully.&lt;/p&gt;</text>
    </textTemplates>
