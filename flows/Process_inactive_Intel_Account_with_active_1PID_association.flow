        </value>
    </constants>
    <constants>
        <name>logEntryNoAcmFound</name>
        <dataType>String</dataType>
        <value>
            <stringValue>No ACM record found to inactive</stringValue>
        </value>
    </constants>
    <constants>
        <name>logOrigin</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Process Inactive Intel Acc Flow</stringValue>
