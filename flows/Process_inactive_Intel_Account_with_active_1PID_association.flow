        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_SalesCloud_AccountID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_CAG_of_Inactive_Account.Core_Intel_Account_Id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>NewStatus</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_OnePartner_Inbound_Message__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_IPA_Affliation_records_to_inactive</name>
