    <constants>
        <description>Comment to be displayed on CAG and 1PID Account as part of deactivation process</description>
        <name>deactivateComment</name>
        <dataType>String</dataType>
        <value>
            <stringValue>UCD Primary Account Inactivated.</stringValue>
        </value>
    </constants>
    <constants>
        <description>Comment to be displayed on CAG as part of delinking process</description>
        <name>delinkComment</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Intel Account Inactivated.</stringValue>
        </value>
    </constants>
    <constants>
        <name>GlobalPAGGroupingMethod</name>
        <dataType>String</dataType>
        <value>
            <stringValue>GLBL</stringValue>
        </value>
    </constants>
    <constants>
        <description>Inactive Account Record Type</description>
        <name>InactiveAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Inactive Account</stringValue>
        </value>
    </constants>
    <constants>
        <description>Inbound for delink/deactivation with status = New already exists &amp; is waiting to be processed.</description>
        <name>inbExistsLogEntry</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Inbound for delink/deactivation with status as &apos;New&apos; already exists for this Inactive Intel Account &amp; is waiting to be processed.</stringValue>
        </value>
    </constants>
    <constants>
        <name>logentrychannelprogram</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Channel Program not found</stringValue>
        </value>
    </constants>
    <constants>
        <name>logEntryForUpdateACM</name>
        <dataType>String</dataType>
