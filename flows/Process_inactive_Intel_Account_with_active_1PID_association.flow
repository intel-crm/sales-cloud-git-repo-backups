    <recordLookups>
        <description>When Account is inactivated then Related ACM&apos;s will be inactive</description>
        <name>Get_ACM_Records_To_Inactivate</name>
        <label>Get ACM Records To Inactivate</label>
        <locationX>50</locationX>
        <locationY>818</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Acm_to_Inactive</targetReference>
        </connector>
        <faultConnector>
            <targetReference>If_no_ACM_record_found</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>PRM_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Acc_Details_from_Platform_Event.accID</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Channel_Program_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Channel_Program.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PRM_AccountChannelMembership__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get active CAG record of Inactive Intel Account</description>
        <name>Get_CAG_of_Inactive_Account</name>
        <label>Get active CAG of Inactive Intel Account</label>
        <locationX>710</locationX>
        <locationY>386</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Inactive_Account_IPA</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Account_Inactivated_is_NOT_Intel_Account</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Inactive_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Intel_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Acc_Details_from_Platform_Event.accID</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Account_Group_Member__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get Intel partner alliance program name</description>
        <name>Get_Channel_Program</name>
        <label>Get Channel Program</label>
        <locationX>50</locationX>
        <locationY>602</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Partner_Program_of_ACM</targetReference>
        </connector>
        <faultConnector>
            <targetReference>channelprogram_not_found</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>PRM_ChannelProgramName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ChannelProgram</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the existing delink / deactivation Inbound record which is in queue if any for this Account.</description>
        <name>Get_existing_Inbound</name>
