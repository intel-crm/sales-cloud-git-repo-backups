        <description>Status of Inbound Record = NEW</description>
        <name>NewStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>NEW</stringValue>
        </value>
    </constants>
    <constants>
        <name>NoActiveCAG</name>
