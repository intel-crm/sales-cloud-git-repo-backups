<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Get the Record Type, Record ID and Unified ID of the Record sent by platform event.</description>
        <name>Get_Acc_Details_from_Platform_Event</name>
        <label>Get Account Details</label>
        <locationX>1634</locationX>
        <locationY>170</locationY>
        <actionName>PRM_AccChange_ResponseParser</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Account_turned_Inactive</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>jsonData</name>
            <value>
                <elementReference>$Record.Message__c</elementReference>
            </value>
        </inputParameters>
        <nameSegment>PRM_AccChange_ResponseParser</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
