        </value>
    </constants>
    <constants>
        <name>Singleton</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>1.0</numberValue>
        </value>
    </constants>
    <constants>
        <description>Tracker Record Creation Failed</description>
        <name>trackerEntryFail</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Tracker Insertion Failed from Inactive Intel Acc Flow</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Check if Account is turned Inactive.</description>
        <name>Account_turned_Inactive</name>
        <label>Account turned Inactive?</label>
        <locationX>1634</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>NoInactiveAcc</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Inactive_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Acc_Details_from_Platform_Event.recordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>InactiveAccount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_CAG_of_Inactive_Account</targetReference>
            </connector>
            <label>Inactive Account</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if the Inactive Intel Account has any active CAG record.</description>
        <name>Active_CAG_available</name>
        <label>Active CAG available?</label>
        <locationX>710</locationX>
        <locationY>2858</locationY>
        <defaultConnector>
            <targetReference>Get_existing_Inbound</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Active CAG available</defaultConnectorLabel>
        <rules>
            <name>No_Active_CAG_available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_CAG_of_Inactive_Account.Core_Inactive_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Active_CAG_Found</targetReference>
            </connector>
            <label>No Active CAG available</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_its_current_location_account</name>
        <label>Check if its current location account</label>
        <locationX>270</locationX>
        <locationY>1550</locationY>
        <defaultConnector>
            <targetReference>loop_affliliations_for_strategyname_of_intel</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>ifnot</defaultConnectorLabel>
        <rules>
            <name>if_current_deactivate_account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_affliliations_for_strategyname_of_intel.PRM_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>IntelAccID</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loop_affliliations_for_strategyname_of_intel.PRM_Active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_intel_accs_strategyname</targetReference>
            </connector>
            <label>if current deactivate account</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_if_OPID_contains_related_affiliations</name>
        <label>check if OPID contains related affiliations</label>
        <locationX>270</locationX>
        <locationY>2042</locationY>
        <defaultConnector>
            <targetReference>loop_affiliations_for_OPID</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>if not</defaultConnectorLabel>
        <rules>
            <name>if_yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_affiliations_for_OPID.PRM_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>opid_id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loop_affiliations_for_OPID.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>opidrecordtype</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>affNameOfLoc</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>loop_affiliations_for_OPID.PRM_Builder_Strategy__r.Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_inactive_status_to_affiliation</targetReference>
            </connector>
            <label>if yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if any delink/ deactivation inbound is already created with status = NEW and is yet to be processed.</description>
        <name>Delink_Deactivate_Inbound_exists</name>
        <label>Delink/Deactivate Inbound exists?</label>
        <locationX>974</locationX>
        <locationY>3074</locationY>
        <defaultConnector>
            <targetReference>One_Partner_ID</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Inbound in Queue</defaultConnectorLabel>
        <rules>
            <name>Inbound_in_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_existing_Inbound.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>NewStatus</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Inbound_Exists_Log_Entry</targetReference>
            </connector>
            <label>Inbound in Queue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Inactive_Account_IPA</name>
        <label>Is Inactive Account IPA?</label>
        <locationX>710</locationX>
        <locationY>494</locationY>
        <defaultConnector>
            <targetReference>Active_CAG_available</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non IPA Inactive Account</defaultConnectorLabel>
        <rules>
            <name>IPA_Inactive_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_CAG_of_Inactive_Account.Core_Intel_Partner_Alliance_PartnerGroup__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Channel_Program</targetReference>
            </connector>
            <label>IPA Inactive Account</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if the Inactive Account is UCD Primary Account</description>
        <name>Is_Inactive_Account_UCD_Primary</name>
        <label>Is Inactive Account UCD Primary?</label>
        <locationX>1238</locationX>
        <locationY>3290</locationY>
        <defaultConnector>
            <targetReference>Create_Individual_Delink_Inbound</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not UCD Primary</defaultConnectorLabel>
        <rules>
            <name>UCD_Primary_Account</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_CAG_of_Inactive_Account.Primary_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Deactivation_Inbound</targetReference>
            </connector>
            <label>UCD Primary</label>
        </rules>
    </decisions>
    <description>Process active CAG records with Inactive Intel Accounts</description>
    <environments>Default</environments>
    <formulas>
        <description>1PID of the Partner Account</description>
        <name>onePartnerID</name>
        <dataType>Number</dataType>
        <expression>VALUE({!Get_CAG_of_Inactive_Account.Core_Partner_Account_Id__r.Core_OnePartnerID__c})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Inactive Intel Account - 1PID Association Process {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Process Inactive Intel Acc with Active 1PID</label>
    <loops>
        <description>Loop the list of ACMS to inactive</description>
        <name>Acm_to_Inactive</name>
        <label>Acm to Inactive</label>
        <locationX>50</locationX>
        <locationY>926</locationY>
        <collectionReference>Get_ACM_Records_To_Inactivate</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_inactive_status_to_Inactive</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>update_ACM_record</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>loop_affiliations_for_OPID</name>
        <label>loop affiliations for OPID</label>
        <locationX>50</locationX>
        <locationY>1934</locationY>
        <collectionReference>get_IPA_Affliation_records_to_inactive</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>check_if_OPID_contains_related_affiliations</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>update_affilitions</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>loop_affliliations_for_strategyname_of_intel</name>
        <label>loop affliliations for strategyname of intel</label>
        <locationX>50</locationX>
        <locationY>1442</locationY>
        <collectionReference>get_IPA_Affliation_records_to_inactive</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_if_its_current_location_account</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>loop_affiliations_for_OPID</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>For Inactive UCD Primary Account or a Singleton Account - Delink the entire hierarchy &amp; deactivate the 1PID account.
Set Core_Status_Effective_End_Date_Time__c = Now</description>
