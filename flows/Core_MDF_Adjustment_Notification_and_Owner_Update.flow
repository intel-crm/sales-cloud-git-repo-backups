    </actionCalls>
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check if Adjustment Claim is of type Adjustment then send Notification</description>
        <name>Check_if_Adjustment_Request_is_of_type_Adjustment_then_send_Notification</name>
        <label>Check if Adjustment Claim is of type Adjustment then send Notification</label>
        <locationX>197</locationX>
        <locationY>249</locationY>
        <defaultConnector>
            <targetReference>Check_if_Reference_Claim_Owner_is_Active_then_Change_Owner_of_Adjustment_Claim</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Notification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AdjustmentReq_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Adjustment</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ReferenceClaimOwner_isActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Adjustment_Creation_Notification_for_Adj_Req_from_Adjustment_Request</targetReference>
            </connector>
            <label>Send Notification</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if Reference Claim Owner is Active then Change Owner of Adjustment Claim</description>
        <name>Check_if_Reference_Claim_Owner_is_Active_then_Change_Owner_of_Adjustment_Claim</name>
        <label>Check if Reference Claim Owner is Active then Change Owner of Adjustment Claim</label>
        <locationX>461</locationX>
        <locationY>303</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Change_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ReferenceClaimOwner_isActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Adjustment_Claim_Owner</targetReference>
            </connector>
            <label>Change Owner</label>
        </rules>
    </decisions>
