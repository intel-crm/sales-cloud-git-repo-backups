    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check if Adjustment Claim is of type Adjustment then send Notification</description>
        <name>Check_if_Adjustment_Request_is_of_type_Adjustment_then_send_Notification</name>
        <label>Check if Adjustment Claim is of type Adjustment then send Notification</label>
        <locationX>578</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Notification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AdjustmentReq_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Adjustment</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ReferenceClaimOwner_isActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Check_if_Reference_Claim_Owner_is_External_Or_Internal_User</targetReference>
            </connector>
            <label>Send Notification</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_Reference_Claim_Owner_is_External_Or_Internal_User</name>
        <label>Check if Reference Claim Owner is External or Internal User</label>
        <locationX>314</locationX>
        <locationY>398</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Send_Email_Notification_to_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RefClaim_Owner_UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PowerPartner</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Adjustment_Creation_Notification_for_Adj_Req_from_Adjustment_Request</targetReference>
            </connector>
            <label>Send Email Notification to Partner</label>
        </rules>
        <rules>
            <name>Core_MDF_Send_Email_Notification_to_Internal_user</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RefClaim_Owner_UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Adjustment_Creation_Notification_for_Adj_Req_to_Internal_User</targetReference>
            </connector>
            <label>Send Email Notification to Internal user</label>
        </rules>
    </decisions>
