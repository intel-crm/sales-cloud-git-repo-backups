<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>In_Progress</name>
        <label>In-Progress</label>
        <locationX>610</locationX>
        <locationY>258</locationY>
        <defaultConnector>
            <targetReference>In_Progress_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>In_Progress_update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Label.Core_MDF_PFR_ProgramWise_InProgress</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Program_txt__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Label.Core_MDF_pfrInprogress</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Activity_Status_txt__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_campaign_record_as_claim_created</targetReference>
            </connector>
            <label>In-Progress update</label>
        </rules>
    </decisions>
    <decisions>
        <name>In_Progress_0</name>
        <label>In-Progress</label>
        <locationX>791</locationX>
        <locationY>271</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Revision_Required</name>
            <conditionLogic>(1 AND 2) OR (4 AND (2 OR 3))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_txt__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_GTM_program_name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Label.Core_MDF_PFR_Revision_Required</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Activity_Status_txt__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Label.Core_MDF_PFR_In_Progress_Revision_Required</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Activity_Status_txt__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Label.Core_MDF_IPA_Program_Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Program_txt__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_campaign_record_as_Revision_req</targetReference>
            </connector>
            <label>Revision Required</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Core_MDF_Activity_Platform_Event {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Activity_Platform_Event_OnCampaign</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>update_campaign_record_as_claim_created</name>
        <label>update campaign record as claim created</label>
        <locationX>618</locationX>
        <locationY>401</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Campaign_Id_txt__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Claims_Created_Ind__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Campaign</object>
    </recordUpdates>
    <recordUpdates>
        <name>update_campaign_record_as_Revision_req</name>
        <label>update campaign record as Revision req</label>
        <locationX>810</locationX>
        <locationY>399</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Campaign_Id_txt__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Revision Required</stringValue>
            </value>
        </inputAssignments>
        <object>Campaign</object>
    </recordUpdates>
    <start>
        <locationX>492</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>In_Progress</targetReference>
        </connector>
        <flowRunAsUser>TriggeringUser</flowRunAsUser>
        <object>Activity_Status_Changed__e</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Active</status>
</Flow>
