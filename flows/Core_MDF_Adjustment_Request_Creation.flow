<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Adjustment_Claim_to_Collection</name>
        <label>Add Adjustment Claim to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ClaimsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varAdjustmentClaim</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_All_Claims</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Reference_Claim_to_Collection</name>
        <label>Add Reference Claim to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ClaimsToUpdate</assignToReference>
