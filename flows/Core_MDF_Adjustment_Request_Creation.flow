        </assignmentItems>
        <connector>
            <targetReference>Adjustment_Claim_Update</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Adjustment_Claim_Update</name>
        <label>Adjustment Claim Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAdjustmentClaim.Amount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAdjustmentClaim.Core_MDF_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Adjustment_Claim_to_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Calculate_Updated_Reference_Amount</name>
        <label>Calculate Updated Reference Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varUpdatedReferenceAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varReferenceClaimAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUpdatedReferenceAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>formulaNegativeAdjustmentAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Deduct_Adjustment_From_Reference_Claim</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Calculate_Updated_Sub_Claim_Amount</name>
        <label>Calculate Updated Sub Claim Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varUpdatedSubClaimAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varSubClaimAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUpdatedSubClaimAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>formulaNegativeAdjustmentAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUpdatedSubClaimOffsetAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varSubClaimOffsetAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUpdatedSubClaimOffsetAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Core_MDF_Amount_Amt__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Deduct_Adjustment_From_Sub_Claim</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Deduct_Adjustment_From_Reference_Claim</name>
        <label>Deduct Adjustment From Reference Claim</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varReferenceClaimAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varUpdatedReferenceAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Reference_Claim_Amount_Zero</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Deduct_Adjustment_From_Sub_Claim</name>
        <label>Deduct Adjustment From Sub Claim</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSubClaimAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varUpdatedSubClaimAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Sub_Claim_Amount_Zero</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Map_Reference_Claim_Amount</name>
        <label>Map Reference Claim Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varReferenceClaimAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varReferenceClaim.Amount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>check_if_Sub_Claim_is_present</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Map_Sub_Claim_Amount</name>
        <label>Map Sub Claim Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSubClaimAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varSubClaim.Amount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSubClaimOffsetAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Sub_Claim_Id__r.Core_MDF_Total_SubClaim_Offset_Amt__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Adjustment_Claim</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reference_Claim_Status_to_Paid</name>
        <label>Reference Claim Status to Paid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varReferenceClaim.Core_MDF_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Reference_Claim_Update</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reference_Claim_Update</name>
        <label>Reference Claim Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varReferenceClaim.Amount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varReferenceClaimAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Reference_Claim_to_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Negative_Adjustment_Amount</name>
        <label>Set Negative Adjustment Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varNegativeAdjustmentAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaNegativeAdjustmentAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Calculate_Updated_Reference_Amount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Offset_Record_Field_Values</name>
        <label>Set Offset Record Field Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOffsetRecord.Core_MDF_Offset_Amount_Amt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varOffsetAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varOffsetRecord.Core_MDF_Offset_Claim_Nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varReferenceClaim.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varOffsetRecord.Core_MDF_Adjustment_Claim_Nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAdjustmentClaim.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varOffsetRecord.Core_MDF_Sub_Claim_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Sub_Claim_Id__r.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Offset_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Sub_Claim_Status_to_Paid</name>
        <label>Sub Claim Status to Paid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSubClaim.Core_MDF_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Sub_Claim_Update</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Sub_Claim_Update</name>
        <label>Sub Claim Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSubClaim.Amount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varSubClaimAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSubClaim.Core_MDF_Total_SubClaim_Offset_Amt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varUpdatedSubClaimOffsetAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Sub_Claim_to_Collection</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>c_CoreOrigin</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Adjustment Request Flow</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_Severity</name>
        <dataType>String</dataType>
        <value>
            <stringValue>High</stringValue>
        </value>
    </constants>
    <customErrors>
        <name>Adjustment_Amount_exceed_error</name>
        <label>Adjustment Amount exceed error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>{!$Label.Core_MDF_AdjAmt_greaterthan_Claim}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Offset_Creation_Error</name>
        <label>Offset Creation Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Publish_Error_Log</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>{!$Label.Core_MDF_ApplicationErrorMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Update_Claim_Error</name>
        <label>Update Claim Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Publish_Error_Log</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>{!$Label.Core_MDF_ApplicationErrorMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>check_if_Sub_Claim_is_present</name>
        <label>check if Sub Claim is present</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Adjustment_Claim</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sub Claim Doesn&apos;t Exists</defaultConnectorLabel>
        <rules>
            <name>Sub_Claim_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Sub_Claim_Id__r.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sub_Claim</targetReference>
            </connector>
            <label>Sub Claim Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Adjustment_amount_greater_than_Reference_claim_amount</name>
        <label>If Adjustment amount greater than Reference claim amount or Sub Claim amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Adjustment_Amount_exceed_error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Adjustment_amount_less_than_Reference_Claim_Amount</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Amount_Amt__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>varReferenceClaim.Amount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Sub_Claim_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Amount_Amt__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>varSubClaim.Amount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Sub_Claim_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Offset_Record_Field_Values</targetReference>
            </connector>
            <label>Adjustment amount less than Reference Claim Amount or Sub Claim Amount</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Reference_Claim_Amount_Zero</name>
        <label>Is Reference Claim Amount Zero?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Reference_Claim_Update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SetToPaid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varReferenceClaimAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reference_Claim_Status_to_Paid</targetReference>
            </connector>
            <label>SetToPaid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Reference_Claim_Paid</name>
        <label>Is Reference Claim Paid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Negative_Adjustment_Amount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Paid</defaultConnectorLabel>
        <rules>
            <name>Paid</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>varReferenceClaim.Core_MDF_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Sub_Claim_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Sub_Claim_Id__r.Core_MDF_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <label>Paid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Sub_Claim_Amount_Zero</name>
        <label>Is Sub Claim Amount Zero?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Sub_Claim_Update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SetSubClaimToPaid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSubClaimAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sub_Claim_Status_to_Paid</targetReference>
            </connector>
            <label>SetSubClaimToPaid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Sub_Claim_Exists1</name>
        <label>Sub Claim Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Adjustment_Claim_Update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Sub_Claim_Not_paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Sub_Claim_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Calculate_Updated_Sub_Claim_Amount</targetReference>
            </connector>
            <label>Sub Claim Not paid</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formulaNegativeAdjustmentAmount</name>
        <dataType>Number</dataType>
        <expression>- {!$Record.Core_MDF_Amount_Amt__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varOffsetAmount</name>
        <dataType>Number</dataType>
        <expression>-{!varAdjustmentClaim.Amount}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core_MDF_Adjustment_Request_Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Adjustment_Request_Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Offset_Record</name>
        <label>Create Offset Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Reference_Claim_Paid</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Offset_Creation_Error</targetReference>
        </faultConnector>
        <inputReference>varOffsetRecord</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Publish_Error_Log</name>
        <label>Publish Error Log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Core_MDF_Apex_Class_Name_Txt__c</field>
            <value>
                <stringValue>Core_MDF_Adjustment_Request_Creation</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_Exception_Message_Txt__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_Tag_txt__c</field>
            <value>
                <stringValue>Flow Error</stringValue>
            </value>
        </inputAssignments>
        <object>Core_MDF_Error_Logging__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Adjustment_Claim</name>
        <label>Get Adjustment Claim</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_Adjustment_amount_greater_than_Reference_claim_amount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Adjustment_Claim_Nbr__c</elementReference>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <outputReference>varAdjustmentClaim</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Status__c</queriedFields>
        <queriedFields>Amount</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Reference_Claim</name>
        <label>Get Reference Claim</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Map_Reference_Claim_Amount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Reference_Claim_Nbr__c</elementReference>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <outputReference>varReferenceClaim</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Status__c</queriedFields>
        <queriedFields>Amount</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Sub_Claim</name>
        <label>Get Sub Claim</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Map_Sub_Claim_Amount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Sub_Claim_Id__c</elementReference>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <outputReference>varSubClaim</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Status__c</queriedFields>
        <queriedFields>Amount</queriedFields>
        <queriedFields>Core_MDF_Total_SubClaim_Offset_Amt__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_All_Claims</name>
        <label>Update All Claims</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Update_Claim_Error</targetReference>
        </faultConnector>
        <inputReference>ClaimsToUpdate</inputReference>
    </recordUpdates>
    <start>
