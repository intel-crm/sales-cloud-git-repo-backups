            <value>
                <elementReference>varReferenceClaim</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Sub_Claim_Exists1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Sub_Claim_to_Collection</name>
        <label>Add Sub Claim to Collection</label>
        <locationX>0</locationX>
