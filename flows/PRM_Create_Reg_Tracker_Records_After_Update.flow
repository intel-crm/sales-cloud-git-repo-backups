        <defaultConnector>
            <targetReference>GetRegistrationRecord1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ExternalUserSateComplete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.External_User_State__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.External_User_State__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.External_User_State__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PRM_GetRegistrationRecord</targetReference>
            </connector>
            <label>ExternalUserSateComplete</label>
        </rules>
    </decisions>
