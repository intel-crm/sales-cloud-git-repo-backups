<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>Flowfaultmessage</name>
        <dataType>String</dataType>
        <expression>{!$Flow.FaultMessage}</expression>
    </formulas>
    <interviewLabel>CRM_VBS_SOAR3_Approved {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CRM_VBS_SOAR3_Approved</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_SOAR_records</name>
        <label>Get SOAR records</label>
        <locationX>660</locationX>
        <locationY>182</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SOAR3_approved</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_decision_value_to_SOAR3_approved</name>
        <label>Update decision value to SOAR3 approved</label>
        <locationX>659</locationX>
        <locationY>418</locationY>
        <faultConnector>
            <targetReference>Show_Error_on_screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CRM_VBS_SOAR_VBS_Decision__c</field>
            <value>
                <stringValue>SOAR3 Approved</stringValue>
            </value>
        </inputAssignments>
        <object>CRM_VBS_SOAR__c</object>
    </recordUpdates>
    <screens>
        <name>SOAR3_approved</name>
        <label>SOAR3 approved</label>
        <locationX>660</locationX>
        <locationY>290</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_decision_value_to_SOAR3_approved</targetReference>
        </connector>
        <fields>
            <name>SOAR3_confirmation</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(68, 68, 68); background-color: rgb(255, 255, 255);&quot;&gt;SOAR product and team will be synced to Opportunity. Please confirm to proceed.﻿&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Confirm</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>534</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Get_SOAR_records</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Show_Error_on_screen</name>
        <label>Show Error on screen</label>
        <locationX>903</locationX>
        <locationY>428</locationY>
        <flowName>Core_FlowErrorHandling</flowName>
        <inputAssignments>
            <name>faultMsg</name>
            <value>
                <elementReference>Flowfaultmessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
