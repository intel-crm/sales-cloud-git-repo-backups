    <decisions>
        <name>Check_Deal_or_Design</name>
        <label>Check Deal or Design</label>
        <locationX>1733</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>PCComplete</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_Deal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PCC_Registration_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Registration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Partner_Account</targetReference>
            </connector>
            <label>is Deal</label>
        </rules>
    </decisions>
    <decisions>
        <description>This step is to check whether PSAM is covered or uncovered</description>
        <name>Check_Partner_Account</name>
        <label>Check Partner Account</label>
        <locationX>1304</locationX>
        <locationY>782</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Partner_Account_Covered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Partner_Account_Id__r.Core_Covered_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approve_Process_Instance_Record</targetReference>
            </connector>
            <label>Partner Account Covered</label>
        </rules>
        <rules>
            <name>Partner_Account_Uncovered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Partner_Account_Id__r.Core_Covered_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approve_Process_Instance_Record_When_PSAM_Uncovered</targetReference>
            </connector>
            <label>Partner Account Uncovered</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Project</name>
        <label>Check Project</label>
        <locationX>2736</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>isAuthorized_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>is Deal</defaultConnectorLabel>
        <rules>
            <name>Is_Design</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PCC_Registration_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Deal Registration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Products_Record</targetReference>
            </connector>
            <label>Is Design?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Data_Quality_Check</name>
        <label>Data Quality Check?</label>
        <locationX>3922</locationX>
        <locationY>782</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>End_Customer_Account_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Yes</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Core_End_Customer_Account_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Core_End_Customer_Account_Id__r.Core_Covered_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Email_Addresses</targetReference>
            </connector>
            <label>End Customer Account Selected</label>
        </rules>
        <rules>
            <name>PSAM_covered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Partner_Account_Id__r.Core_Covered_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Yes</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approve_Process_Instance_Record_when_PSAM_covered</targetReference>
            </connector>
            <label>PSAM covered</label>
        </rules>
        <rules>
            <name>PSAM_Uncovered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Partner_Account_Id__r.Core_Covered_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Yes</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approve_Instance_Record</targetReference>
            </connector>
            <label>PSAM Uncovered</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_End_Customer_Account_Present</name>
        <label>Is End Customer Account Present</label>
        <locationX>3658</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Check_End_Customer_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is Present</defaultConnectorLabel>
        <rules>
            <name>Not_Present</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_End_Customer_Account_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Core_End_Customer_Account_RecordType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>InactiveAccount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>End_Customer_Check</targetReference>
            </connector>
            <label>Not Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_precheck_complete</name>
        <label>Is precheck complete?</label>
        <locationX>1393</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Check_Project</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Complete the precheck</defaultConnectorLabel>
        <rules>
            <name>precheck_complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Precheck Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PCcompleted</targetReference>
            </connector>
            <label>precheck complete</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Yes_Selected</name>
        <label>Is Yes Selected</label>
        <locationX>4450</locationX>
        <locationY>674</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Yes</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Data_Quality_Check</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>isAuthorized_User</name>
        <label>isAuthorized User?</label>
        <locationX>4450</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Unauthorized_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes1</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>userId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>recordId.Core_Accepted_By_Id__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>userId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>recordId.Core_Accepted_By_Id__r.DelegatedApproverId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_End_Customer_Account_Present</targetReference>
            </connector>
            <label>Yes?</label>
        </rules>
    </decisions>
