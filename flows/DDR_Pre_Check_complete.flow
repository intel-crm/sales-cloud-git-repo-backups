        <expression>TEXT(YEAR(TODAY()))</expression>
    </formulas>
    <formulas>
        <name>RunningDateTime</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>userId</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!$User.Id})</expression>
    </formulas>
    <formulas>
        <name>When</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
