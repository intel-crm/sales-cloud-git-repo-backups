<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_RelatedToID_to_update</name>
        <label>Assign RelatedToID to update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_and_Update_Reply_Emails.RelatedToId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Original_Email_Thread_identifier.RelatedToId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EmailMessageCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_and_Update_Reply_Emails</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_and_Update_Reply_Emails</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <interviewLabel>Update EmailMessage History {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update EmailMessage History</label>
    <loops>
        <name>Loop_and_Update_Reply_Emails</name>
        <label>Loop and Update Reply Emails</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Reply_Emails_Thread_identifier</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_RelatedToID_to_update</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_REPLY_Email_Messages_of_a_Thread</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Original_Email_Thread_identifier</name>
        <label>Get Original Email Thread identifier</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Reply_Emails_Thread_identifier</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ThreadIdentifier</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ThreadIdentifier</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EmailMessage</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ThreadIdentifier</queriedFields>
        <queriedFields>RelatedToId</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Reply_Emails_Thread_identifier</name>
        <label>Get Reply Emails Thread identifier</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_and_Update_Reply_Emails</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ThreadIdentifier</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ThreadIdentifier</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_Original_Email_Thread_identifier.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>EmailMessage</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ThreadIdentifier</queriedFields>
        <queriedFields>RelatedToId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_REPLY_Email_Messages_of_a_Thread</name>
        <label>Update REPLY Email Messages of a Thread</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>EmailMessageCollection</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Original_Email_Thread_identifier</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Source</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Einstein Activity Capture</stringValue>
            </value>
        </filters>
        <object>EmailMessage</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>EmailMessageCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>EmailMessage</objectType>
    </variables>
</Flow>
