<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Core_MDF_Submitting_for_Approval</name>
        <label>Submitting for Approval</label>
        <locationX>564</locationX>
        <locationY>1116</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>Core_MDF_Budget_CAP_Approval_Process_V1</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>submitterId</name>
            <value>
                <elementReference>GetCurrentLoggedInUser</elementReference>
            </value>
        </inputParameters>
        <nameSegment>submit</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_MDF_Change_in_Request_CAP_Amount</name>
        <label>Change in Request CAP Amount</label>
        <locationX>246</locationX>
        <locationY>872</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Send_to_Approval_Process</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Update_the_status_to_pending_review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_CCP_Budget_Cap</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Requested_Cap_amt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Update_status</targetReference>
            </connector>
            <label>Update the status to pending review</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Send_to_Approval_Process</name>
        <label>Send to Approval Process</label>
        <locationX>245</locationX>
        <locationY>1120</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Verify_condition_and_send_for_approval</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_CCP_Budget_Cap</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RequestedCAPGreaterThanZero</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RequestedCAPAmountChanges</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Submitting_for_Approval</targetReference>
            </connector>
            <label>Verify condition and send for approval</label>
        </rules>
    </decisions>
    <decisions>
        <description>Verify if the record is newly created or record type is CCP Budget cap</description>
        <name>Core_MDF_When_new_record_is_created_or_type_field_is_changed</name>
        <label>When new record is created or type field is changed</label>
        <locationX>247</locationX>
        <locationY>388</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Zero_Requested_Amount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Update_unique_key</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_CCP_Budget_Cap</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CheckForNewRecords</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Cap_Type_nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Populate_Unique_Key</targetReference>
            </connector>
            <label>Update unique key</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Zero_Requested_Amount</name>
        <label>Zero Requested Amount</label>
        <locationX>258</locationX>
        <locationY>657</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Change_in_Request_CAP_Amount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Update_approved_amount_and_status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Requested_Cap_amt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_IPA_Budget_Type_Cap</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Update_Status_and_Approved_Amount</targetReference>
            </connector>
            <label>Update approved amount and status</label>
        </rules>
    </decisions>
    <description>This flow is to manage status changes on Budget CAP, converted process builder &apos;Core_MDF_Budget_CAP_Status_changes&apos; into this flow</description>
    <environments>Default</environments>
    <formulas>
        <name>CalculatingBudgetChannelProgramKey</name>
        <dataType>String</dataType>
        <expression>({!$Record.Core_MDF_Budget_Name_id__r.Id}) &amp; (TEXT({!$Record.Core_MDF_Cap_Type_nm__c}))</expression>
    </formulas>
    <formulas>
        <name>CheckForNewRecords</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>GetCurrentLoggedInUser</name>
        <dataType>String</dataType>
        <expression>{!$User.Id}</expression>
    </formulas>
    <formulas>
        <name>IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>RequestedCAPAmountChanges</name>
        <dataType>Boolean</dataType>
        <expression>AND( ! (ISNEW()), ISCHANGED ({!$Record.Core_MDF_Requested_Cap_amt__c}))</expression>
    </formulas>
    <formulas>
        <name>RequestedCAPGreaterThanZero</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISNEW(), {!$Record.Core_MDF_Requested_Cap_amt__c}&gt;0)</expression>
    </formulas>
    <interviewLabel>Budget CAP Status changes {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Budget CAP Status change</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_MDF_Populate_Unique_Key</name>
        <label>Populate Unique Key</label>
        <locationX>571</locationX>
        <locationY>389</locationY>
        <connector>
            <targetReference>Core_MDF_Zero_Requested_Amount</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_MDF_Budget_Channel_Program_Key__c</field>
            <value>
                <elementReference>CalculatingBudgetChannelProgramKey</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Core_MDF_Update_status</name>
        <label>Update status</label>
        <locationX>572</locationX>
        <locationY>910</locationY>
        <connector>
            <targetReference>Core_MDF_Send_to_Approval_Process</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_MDF_Cap_Status_nm__c</field>
            <value>
                <elementReference>$Label.Core_MDF_Budget_Status_Pending_Review</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Core_MDF_Update_Status_and_Approved_Amount</name>
        <label>Update Status and Approved Amount</label>
        <locationX>565</locationX>
        <locationY>646</locationY>
        <inputAssignments>
            <field>Core_MDF_Approved_Cap_amt__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_Cap_Status_nm__c</field>
            <value>
                <elementReference>$Label.Core_MDF_Status_Approved</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>152</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Core_MDF_When_new_record_is_created_or_type_field_is_changed</targetReference>
        </connector>
        <object>Core_MDF_Budget_Cap__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
