    <description>Process Builder to send IPS notifications - External R4</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(       
             NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)), 
	     [Case].RecordType.developerName=
                                           $Label.Core_IPS_CaseCreateRecordType_Name,
		  
                  NOT( ISBLANK([Case].Core_IPS_Partner_Sup_Owner__c  )),
                  NOT(ISNULL([Case].Core_IPS_Partner_Sup_Owner__c  )) , 

                 [Case].Core_IPS_Is_Notification_Active__c = TRUE,
                 [Case].Core_IPS_Customer_Visible__c = TRUE,
              OR(    ISPICKVAL([Case].Status, &apos;New&apos;),
			  ISPICKVAL([Case].Status, &apos;Open&apos;)  ) ,
              ISCHANGED( [Case].Core_IPS_Partner_Sup_Owner__c )
               
   )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
