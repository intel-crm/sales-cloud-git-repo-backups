    <description>Migrated from the: Core_IPS_Update_ERPM_Status_For_Employee_Customer workflow rule
Workflow rule description: Update ERPM status to blank for Employee Customer.&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>CheckCoreIPSEmployeeCustomer</name>
        <dataType>Boolean</dataType>
        <expression>AND( {!$Record.Core_IPS_Employee_Customer__c} ,  OR( NOT(ISBLANK(TEXT({!$Record.Core_ERPM_Integration_Status__c}))),      NOT(ISNULL({!$Record.Core_ERPM_Status_Change_Date_Time__c} )),  NOT(ISBLANK(TEXT({!$Record.Core_AGS_Integration_Status__c}))),      NOT(ISNULL({!$Record.Core_AGS_Status_Change_Date_Time__c} )) ))</expression>
    </formulas>
    <formulas>
