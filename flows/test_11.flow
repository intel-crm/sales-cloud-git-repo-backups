    <recordUpdates>
        <description>This will update claim submitter reminder sent flag to true after sending email notification.</description>
        <name>Update_Claim_submitter_Reminder_flag</name>
        <label>Update Claim submitter Reminder flag</label>
        <locationX>171</locationX>
        <locationY>484</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_ClaimSubRemNotificationSent_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_ClaimSubmitterReminder_Dtm__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>today</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_ClaimSubRemNotificationSent_Ind__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Core_MDF_Claim_VAT_Info__c</object>
    </recordUpdates>
