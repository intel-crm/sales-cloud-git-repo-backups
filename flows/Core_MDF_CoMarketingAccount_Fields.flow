    <decisions>
        <name>If_RT_is_Co_Marketing_and_Parent_Fund_Account_s_RT_is_Intel</name>
        <label>If RT is Co-Marketing and Parent Fund Account&apos;s RT is Intel</label>
        <locationX>169</locationX>
        <locationY>255</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Parent_Fund_Account_s_RT_is_Intel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Account_Record.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Intel_Account_Record_Type_Developer_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assigning_Default_Values_to_Co_Marketing_Account</targetReference>
            </connector>
            <label>If Parent Fund Account&apos;s RT is Intel</label>
        </rules>
        <rules>
            <name>If_Parent_Fund_Account_s_RT_is_CoMarketing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Account_Record.Core_MDF_Parent_Fund_Account__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_Marketing_Record_Type_Developer_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assigning_Default_Values_to_Co_Marketing_Account_0</targetReference>
            </connector>
            <label>If Parent Fund Account&apos;s RT is CoMarketing</label>
        </rules>
    </decisions>
    <decisions>
        <name>To_Check_if_Account_is_created_by_External_user</name>
        <label>To Check if Account is created by External user</label>
        <locationX>205</locationX>
        <locationY>692</locationY>
        <defaultConnector>
            <targetReference>Update_Account_record_with_all_populated_values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Account_is_created_by_External_user</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Account_Record.CreatedBy.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_ReleaseHold_PartnerUserType</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_Owner_to_FLAO_User</targetReference>
            </connector>
            <label>If Account is created by External user</label>
        </rules>
    </decisions>
    <decisions>
        <name>To_Check_if_Its_an_Internal_User</name>
        <label>Validate If Internal User</label>
        <locationX>667</locationX>
        <locationY>846</locationY>
        <defaultConnector>
            <targetReference>Share_Account_with_Account_managers</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Internal_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Account_Record.CreatedBy.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PowerPartner</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_PNUM_record</targetReference>
            </connector>
            <label>External User</label>
        </rules>
    </decisions>
