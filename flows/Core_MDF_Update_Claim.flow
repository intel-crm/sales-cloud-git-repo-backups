<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>callReleaseHold</name>
        <label>callReleaseHold</label>
        <locationX>1015</locationX>
        <locationY>564</locationY>
        <actionName>Core_MDF_Claim_Utility</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>inputClaims</name>
            <value>
                <elementReference>varClaimRecordsCollection</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>releaseReason</name>
            <value>
                <elementReference>releaseReasonColection</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Claim_Utility</nameSegment>
    </actionCalls>
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assignReleaseHoldValues</name>
        <label>assignReleaseHoldValues</label>
        <locationX>1100</locationX>
        <locationY>437</locationY>
        <assignmentItems>
            <assignToReference>varClaimRecordsCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varClaimRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>releaseReasonColection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varReleaseReason</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>callReleaseHold</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>This block releases review hold for claim</description>
        <name>Core_MDF_Release_Review_Hold</name>
        <label>Release Review Hold</label>
        <locationX>526</locationX>
        <locationY>541</locationY>
        <assignmentItems>
            <assignToReference>varClaimRecord.Core_MDF_Audit_Hold__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>updateClaim_0</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>This block sets required attributes of Adjustment Requests and amount will be requested amount from reference claim</description>
        <name>Core_MDF_Set_Adjustment_Request_For_Non_Compliant</name>
        <label>Set Adjustment Request For Non-Compliant</label>
        <locationX>136</locationX>
        <locationY>183</locationY>
        <assignmentItems>
            <assignToReference>varAdjustmentRequestInstance.Core_MDF_Reference_Claim_Nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varClaimId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAdjustmentRequestInstance.Core_MDF_Reason_Cd__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAdjustmentRequestType</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAdjustmentRequestInstance.Core_MDF_Amount_Amt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varRequestedReimbursementAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Create_Adjustment_Request</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Adjustment_Amount</name>
        <label>Set Adjustment Amount</label>
        <locationX>1153</locationX>
        <locationY>187</locationY>
        <assignmentItems>
            <assignToReference>varClaimRecord.Core_MDF_Audit_Adjustment_Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCaseAdjustmentAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>assignReleaseHoldValues</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>This block sets required attributes of Adjustment Requests and amount will be Adjustment Amount From Case</description>
        <name>Set_Adjustment_Request</name>
        <label>Set Adjustment Request</label>
        <locationX>353</locationX>
        <locationY>426</locationY>
        <assignmentItems>
            <assignToReference>varAdjustmentRequestInstance.Core_MDF_Reference_Claim_Nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varClaimId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAdjustmentRequestInstance.Core_MDF_Amount_Amt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCaseAdjustmentAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAdjustmentRequestInstance.Core_MDF_Reason_Cd__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAdjustmentRequestType</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Create_Adjustment_Request</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Claim Adjustment Amount to be equal to Case Requested Amount when Claim is denied (US388028)</description>
        <name>Set_Claim_Status_as_Denied</name>
        <label>Set Claim Status as Denied</label>
        <locationX>827</locationX>
        <locationY>280</locationY>
        <assignmentItems>
            <assignToReference>varClaimRecord.Core_MDF_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Denied</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varClaimRecord.Core_MDF_Audit_Hold__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varClaimRecord.Core_MDF_Audit_Adjustment_Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varRequestedReimbursementAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>updateClaim_0</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>checkClaimId</name>
        <label>checkClaimId</label>
        <locationX>164</locationX>
        <locationY>52</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>NotNull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getClaimRecord</targetReference>
            </connector>
            <label>NotNull</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkClaimRecord</name>
        <label>checkClaimRecord</label>
        <locationX>470</locationX>
        <locationY>45</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Is_Claim_Paid</targetReference>
            </connector>
            <label>Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkReleaseHoldOrDenied</name>
        <label>checkReleaseHoldOrDenied</label>
        <locationX>908</locationX>
        <locationY>53</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>CompliantReleaseHold_0</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>varRequestedReimbursementAmount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varRequestedReimbursementAmount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Adjustment_Amount</targetReference>
            </connector>
            <label>CompliantReleaseHoldWithAdjustmentAmount</label>
        </rules>
        <rules>
            <name>NonCompliantDenied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non-compliant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Claim_Status_as_Denied</targetReference>
            </connector>
            <label>NonCompliantDenied</label>
        </rules>
        <rules>
            <name>CompliantReleaseHoldOnly</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assignReleaseHoldValues</targetReference>
            </connector>
            <label>CompliantReleaseHoldOnly</label>
        </rules>
    </decisions>
    <decisions>
        <description>This block contains 3 outcomes of claim review.</description>
        <name>Core_MDF_Claim_Review_Outcome</name>
        <label>Claim Review Outcome</label>
        <locationX>511</locationX>
        <locationY>237</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Compliant_With_No_Adjustment</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Release_Review_Hold</targetReference>
            </connector>
            <label>Compliant With No Adjustment</label>
        </rules>
        <rules>
            <name>Compliant_With_Adjustment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Adjustment_Request</targetReference>
            </connector>
            <label>Compliant With Adjustment</label>
        </rules>
        <rules>
            <name>Core_MDF_Non_compliant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non-compliant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Set_Adjustment_Request_For_Non_Compliant</targetReference>
            </connector>
            <label>Non-compliant</label>
        </rules>
    </decisions>
    <decisions>
        <description>This decision box will check weather the claim is paid or not</description>
        <name>Core_MDF_Is_Claim_Paid</name>
        <label>Is Claim Paid</label>
        <locationX>699</locationX>
        <locationY>54</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Claim_Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Claim_Review_Outcome</targetReference>
            </connector>
            <label>Claim Paid</label>
        </rules>
        <rules>
            <name>Core_MDF_Claim_Not_Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>checkReleaseHoldOrDenied</targetReference>
            </connector>
            <label>Claim Not Paid</label>
        </rules>
    </decisions>
    <description>Prepayment Actions:
 * Update Claim Adjustment Amount from Case when Case status is set as Complaint/Non Compliant
* Compliant updates, recordtypelabelupdate
* release Hold update
* CompliantReleaseHold changes
* When Claim is set to denied, update the Claim Adjustment amount to the Requested Amount (US388028)
* Adding logic to release Claim from Hold even if Compliant Case has 0 Reimbursement Amount

Post payment Actions:
*Create Adjustment Request Record for case outcome Non-Compliant/Compliant With Adjustment Amount.
* Release Hold update on Claim</description>
    <formulas>
        <description>This variable holds the type of adjustment request.</description>
        <name>varAdjustmentRequestType</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_Claim_Review_Results_Negative}</expression>
    </formulas>
    <formulas>
        <name>varReleaseReason</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_Audit_Hold}</expression>
    </formulas>
    <interviewLabel>Core_MDF_Update_Claim {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Update_Claim</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>This block creates the adjustment request.</description>
        <name>Core_MDF_Create_Adjustment_Request</name>
        <label>Create Adjustment Request</label>
        <locationX>108</locationX>
        <locationY>532</locationY>
        <connector>
            <targetReference>Core_MDF_Release_Review_Hold</targetReference>
        </connector>
        <inputReference>varAdjustmentRequestInstance</inputReference>
    </recordCreates>
    <recordLookups>
        <name>getClaimRecord</name>
        <label>getClaimRecord</label>
        <locationX>351</locationX>
        <locationY>43</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkClaimRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varClaimId</elementReference>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <outputReference>varClaimRecord</outputReference>
        <queriedFields>Core_MDF_Audit_Adjustment_Amount__c</queriedFields>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Status__c</queriedFields>
        <queriedFields>Core_MDF_Claim_Previous_Status__c</queriedFields>
        <queriedFields>Core_MDF_Audit_Hold__c</queriedFields>
        <queriedFields>Core_MDF_ESD_Hold__c</queriedFields>
        <queriedFields>Core_MDF_Payment_Hold_ind__c</queriedFields>
        <queriedFields>Core_MDF_Criteria_Hold_Ind__c</queriedFields>
        <queriedFields>Core_MDF_Intel_Manual_Hold_Ind__c</queriedFields>
        <queriedFields>Core_MDF_Member_Manual_Hold_Ind__c</queriedFields>
        <queriedFields>Amount</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>updateClaim_0</name>
        <label>updateClaim</label>
        <locationX>874</locationX>
        <locationY>541</locationY>
        <inputReference>varClaimRecord</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>checkClaimId</targetReference>
        </connector>
    </start>
