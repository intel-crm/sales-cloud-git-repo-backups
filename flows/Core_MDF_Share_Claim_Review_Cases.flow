    <decisions>
        <name>check_case_status</name>
        <label>check case status</label>
        <locationX>1415</locationX>
        <locationY>766</locationY>
        <defaultConnector>
            <targetReference>Status_as_Cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>check_casestatus</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Review_Case_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Review Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Review_Case_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_fields_on_closure</targetReference>
            </connector>
            <label>check casestatus</label>
        </rules>
    </decisions>
    <decisions>
