            </conditions>
            <conditions>
                <leftValueReference>excludedUserList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Claim_Submitter__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Call_Claim_Update_Flow</targetReference>
            </connector>
            <label>Unsubscribed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Program_to_notify_recovery_admins</name>
        <label>Determine Program to notify recovery admins</label>
        <locationX>964</locationX>
        <locationY>1337</locationY>
        <defaultConnector>
            <targetReference>Check_user_Active</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Notify_RMF_and_IPA_Ext_Recovery_Admins</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Retail Marketing Funds</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Partner Alliance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>notify_IPA_RMF_Ext_Recovery_Adm</targetReference>
            </connector>
            <label>Notify RMF and IPA Ext Recovery Admins</label>
        </rules>
        <rules>
            <name>Notify_CCF_DCF_EEF_Ext_Recovery_Admins</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Client CoMarketing Fund</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Data Center CoMarketing Fund</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Core_MDF_Channel_Program__r.Core_MDF_Technical_Program_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ecosystem Extension Fund</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_All_Access_Group_for_CCF_DCF_EEF</targetReference>
            </connector>
            <label>Notify CCF and DCF and EEF Ext Recovery Admins</label>
        </rules>
    </decisions>
