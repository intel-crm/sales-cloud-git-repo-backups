    <environments>Default</environments>
    <formulas>
        <name>checkownerchangedornewcase</name>
        <dataType>Boolean</dataType>
        <expression>({!$Record.RecordType.DeveloperName} = &apos;Core_MDF_Audit&apos; || {!$Record.RecordType.DeveloperName} = &apos;Core_MDF_Audit_Closed&apos;) &amp;&amp; ((ISNEW() &amp;&amp; NOT({!$Record.Owner:User.Id} = {!$Label.Core_MDF_Dummy_Account_Owner_Id}))  || ISCHANGED({!$Record.OwnerId }))</expression>
    </formulas>
    <formulas>
        <name>forB_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>RecipientIdValue</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_MDF_Claim_Submitter__c}</expression>
    </formulas>
    <interviewLabel>Core MDF Share Claim Review Cases on Insert or Owner Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core MDF Share Claim Review Cases</label>
    <loops>
        <name>Iterate_Over_Map</name>
        <label>Iterate Over Map</label>
        <locationX>592</locationX>
        <locationY>797</locationY>
        <collectionReference>excludedUsersWrapper</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
