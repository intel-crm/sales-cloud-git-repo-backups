            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateCloseCaseRecordType</targetReference>
            </connector>
            <label>Status asCancelled</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>checkownerchangedornewcase</name>
        <dataType>Boolean</dataType>
        <expression>({!$Record.RecordType.DeveloperName} = &apos;Core_MDF_Audit&apos; || {!$Record.RecordType.DeveloperName} = &apos;Core_MDF_Audit_Closed&apos;) &amp;&amp; ((ISNEW() &amp;&amp; NOT({!$Record.Owner:User.Id} = {!$Label.Core_MDF_Dummy_Account_Owner_Id}))  || ISCHANGED({!$Record.OwnerId }))</expression>
    </formulas>
    <formulas>
        <name>forB_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>ifNewSGPCase</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    $Record.RecordType.DeveloperName = &apos;Core_MDF_Audit&apos;,
    ISNEW(),
    TEXT($Record.Core_MDF_Claim_Lookup_Id__r.Core_MDF_Processing_Preference_nm__c) = &apos;Settle, then get paid&apos;
)</expression>
    </formulas>
    <formulas>
        <name>RecipientIdValue</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_MDF_Claim_Submitter__c}</expression>
    </formulas>
