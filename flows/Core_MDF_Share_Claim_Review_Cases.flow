    <decisions>
        <name>Check_user_Active</name>
        <label>Check user Active</label>
        <locationX>1839</locationX>
        <locationY>1338</locationY>
        <defaultConnector>
            <targetReference>Call_Claim_Update_Flow</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User Inactive</defaultConnectorLabel>
        <rules>
            <name>Check_if_user_is_active</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Submitter__r.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Submitter__r.Partner_License_Reclaimed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Whether_Claim_Submitter_is_Part_of_Excluded_List</targetReference>
            </connector>
            <label>Check if user is active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Whether_Claim_Submitter_is_Part_of_Excluded_List</name>
        <label>Check Whether Claim Submitter is Part of Excluded List</label>
        <locationX>1299</locationX>
        <locationY>1164</locationY>
        <defaultConnector>
            <targetReference>Recipient_Id_assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Subscribed</defaultConnectorLabel>
        <rules>
            <name>Unsubscribed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>excludedUserList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
