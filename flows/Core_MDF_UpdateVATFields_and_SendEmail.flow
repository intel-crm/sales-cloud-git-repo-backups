    <decisions>
        <description>To check whether the claim is an adjustment</description>
        <name>Adjustment_Claim</name>
        <label>Adjustment/Claim</label>
        <locationX>512</locationX>
        <locationY>943</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Adjustment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Claim_Adjustment_Type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_C_Type_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_Adjustment_status_to_PAF</targetReference>
            </connector>
            <label>Adjustment</label>
        </rules>
        <rules>
            <name>Claim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Claim_Type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_C_Type_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assignReleaseHoldValues</targetReference>
            </connector>
            <label>Claim</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_User_is_active</name>
        <label>Core MDF User is active</label>
        <locationX>178</locationX>
        <locationY>518</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_user_active_or_license_reclaimed_is_true</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Owner:User.Partner_License_Reclaimed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendNotification_to_Claim_Submitters</targetReference>
            </connector>
            <label>Check if user active or license reclaimed is true</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_User_is_Active_2</name>
        <label>Core MDF User is Active 2</label>
        <locationX>1017</locationX>
        <locationY>763</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>User_active_or_License_Reclaimed_is_true</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Owner:User.Partner_License_Reclaimed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NotifyClaim_Submitters_on_VAT_Rejection</targetReference>
            </connector>
            <label>User active or License Reclaimed is true</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_VerifyStatus</name>
        <label>Verify Status</label>
        <locationX>792</locationX>
        <locationY>534</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>When_Status_is_Pending_Documents</name>
            <conditionLogic>(1 OR 2) AND 3 AND (4 OR (5 AND 6))</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Case_Status_Pending_Document</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Owner:User.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Partner_User_Type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Core_MDF_Claim_Submitter_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Core_MDF_Claim_Submitter_Id__r.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Partner_User_Type</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_User_is_active</targetReference>
            </connector>
            <label>When Status is Pending Documents</label>
        </rules>
        <rules>
            <name>When_Status_is_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Status_Approved</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getClaimRecord</targetReference>
            </connector>
            <label>When Status is Approved</label>
        </rules>
        <rules>
            <name>When_Status_is_Revision_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_PFR_Status_RevisionRequired</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_User_is_Active_2</targetReference>
            </connector>
            <label>When Status is Revision Required</label>
        </rules>
        <rules>
            <name>When_Status_is_Under_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Case_Status_Under_Review</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Read_Document_Link_Record</targetReference>
            </connector>
            <label>When Status is Under Review</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>EffectiveClaimId</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISBLANK({!$Record.Core_MDF_Sub_Claim_Id__c})),
  {!$Record.Core_MDF_Sub_Claim_Id__r.Id},
  {!$Record.Core_MDF_Claim_Id__r.Id}
)</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>RecipientIdValue</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_MDF_Claim_Id__r.OwnerId}</expression>
    </formulas>
    <formulas>
        <name>varReleaseReason</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_VAT_Hold}</expression>
    </formulas>
    <interviewLabel>Update VAT fields and Send Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update VAT fields and Send Email</label>
    <loops>
        <name>Iterate_the_records</name>
        <label>Iterate the records</label>
        <locationX>1590</locationX>
        <locationY>941</locationY>
        <collectionReference>Read_Document_Link_Record</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_Owner_Id</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
