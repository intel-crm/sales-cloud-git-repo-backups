<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the Ask Commissions-Notification to case owner and created by when case comment is added V.2 process using CheckCommentIsCreatedByEndUserOrNot criteria.
When Case Comment is added by End User it will update Case Comment Id field on case object</description>
    <environments>Default</environments>
    <label>Ask Commissions-Notification to case owner and created by when case comment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>myRule_1_A1</name>
        <label>UpdateCaseCommentiD</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>Core_AAQC_Case_Comment_Id__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_AAQC_Latest_Case_Comment__c</field>
            <value>
                <elementReference>$Record.Core_AAQC_Comment__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Core_AAQC_Commissions_Case__r.Core_AAQC_Case__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>myRule_1_A1</targetReference>
        </connector>
        <filterFormula>({!$Record.CreatedById} =={!$Record.Core_AAQC_Commissions_Case__r.Core_AAQC_Case__r.CreatedById} &amp;&amp;{!$Record.Core_AAQC_Commissions_Case__r.Core_AAQC_Case__r.RecordType.DeveloperName} ==&apos;Core_AAQC_Case_recordType&apos;)</filterFormula>
        <object>Core_AAQC_Case_Comments__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
