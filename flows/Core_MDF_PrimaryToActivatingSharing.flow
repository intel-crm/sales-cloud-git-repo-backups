<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Share_Record_To_Final_List</name>
        <label>Add Share Record To Final List</label>
        <locationX>138</locationX>
        <locationY>971</locationY>
        <assignmentItems>
            <assignToReference>ActivatingAccountShareList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ActivatingAccountShare</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_IteratePGMRecords</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Core_MDF_CreateAccountShareForPrimaryActivating</name>
        <label>CreateAccountShareForActivatingPartner</label>
        <locationX>138</locationX>
        <locationY>863</locationY>
        <assignmentItems>
            <assignToReference>ActivatingAccountShare.AccountAccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ActivatingAccountShare.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Activating_Partner_Account_id__r.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ActivatingAccountShare.RowCause</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Manual</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ActivatingAccountShare.UserOrGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Core_MDF_IteratePGMRecords.Core_MDF_Group_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ActivatingAccountShare.OpportunityAccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>None</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ActivatingAccountShare.CaseAccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Share_Record_To_Final_List</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Core_MDF_Verify_Record</name>
        <label>Verify Record</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Not Present</defaultConnectorLabel>
        <rules>
            <name>DataIsPresent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Primary_Partner_Account_id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Activating_Partner_Account_id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_getPGMRecordsForActivatingPartner</targetReference>
            </connector>
            <label>Data Is Present</label>
        </rules>
    </decisions>
    <description>This flow will share the Activating Partner Account with the Primary Account PGM Groups.</description>
    <environments>Default</environments>
    <formulas>
        <name>Unique_ID</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_MDF_Primary_Partner_Account_id__c}&amp;{!$Record.Core_MDF_Activating_Partner_Account_id__c}</expression>
    </formulas>
    <interviewLabel>Core_MDF_PrimaryToActivatingSharing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_PrimaryToActivatingSharing</label>
    <loops>
        <name>Core_MDF_IteratePGMRecords</name>
        <label>IteratePGMRecords</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <collectionReference>PrimaryPGMRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_MDF_CreateAccountShareForPrimaryActivating</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_MDF_Insert_Share_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Insert_Share_Records</name>
        <label>Insert Share Records</label>
        <locationX>50</locationX>
        <locationY>1163</locationY>
        <inputReference>ActivatingAccountShareList</inputReference>
    </recordCreates>
    <recordLookups>
        <name>core_MDF_Get_Channel_Program_ID</name>
        <label>Get Channel Program ID</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Technical_Program_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Ecosystem Extension Fund</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_ChannelProgram__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Program_ID__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Core_MDF_getPGMRecordsForActivatingPartner</name>
        <label>getPGMRecordsForPrimaryPartner</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_IteratePGMRecords</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4) AND 5</filterLogic>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Primary_Partner_Account_id__r.Core_MDF_CoMarketing_Ultimate_Account__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Primary_Partner_Account_id__r.Core_MDF_Channel_Program__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>External</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Inactive_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Core_MDF_Partner_Group_Mapping__c</object>
        <outputReference>PrimaryPGMRecords</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Group_Id__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Record</name>
        <label>Update Record</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Core_MDF_Verify_Record</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_MDF_Channel_Program__c</field>
            <value>
                <elementReference>core_MDF_Get_Channel_Program_ID.Core_MDF_Program_ID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_MDF_Unique_ID__c</field>
            <value>
                <elementReference>Unique_ID</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>core_MDF_Get_Channel_Program_ID</targetReference>
        </connector>
        <object>Core_MDF_Partner_Mapping__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
