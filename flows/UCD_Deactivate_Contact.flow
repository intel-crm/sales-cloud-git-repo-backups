<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Identity</name>
        <label>Check Identity</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Deactivate</name>
            <conditionLogic>(1 AND 2) OR (1 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Enterprise_Id__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Login_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deleted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Login_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Downgrade to B2C</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact_Deactivate</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Deactivate</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_3</name>
        <locationX>578</locationX>
        <locationY>431</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>50</locationX>
        <locationY>539</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>314</locationX>
        <locationY>647</locationY>
    </ends>
    <environments>Default</environments>
    <interviewLabel>UCD Deactivate Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UCD Deactivate Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_log_entry</name>
        <label>Create log entry</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>END_ELEMENT_5</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>UCD Deactivate Contact flow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Project__c</field>
            <value>
                <stringValue>ACM</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <stringValue>Update Contact</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Tags__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
    </recordCreates>
    <recordUpdates>
        <name>Update_Contact_Deactivate</name>
        <label>Update Contact Deactivate</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>END_ELEMENT_4</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_log_entry</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_Deactivated__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Deactivation_Reason__c</field>
            <value>
                <stringValue>Contact Inactive</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Identity</targetReference>
        </connector>
        <filterLogic>1</filterLogic>
        <filters>
            <field>Core_Enterprise_Id__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
