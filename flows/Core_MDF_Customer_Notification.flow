<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Triggering customer notification after updating comments from Approval process instance to Campaign record</description>
        <name>Trigger_Customer_Notification</name>
        <label>Trigger Customer Notification</label>
        <locationX>937</locationX>
        <locationY>217</locationY>
        <actionName>Core_MDF_CampaignServiceHandler</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>cmp</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_CampaignServiceHandler</nameSegment>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Sending Customer notification by updating comment from Approval process to Campaign record. Separate flows is used due to schedule action is not available in run immediate path in flows.</description>
    <environments>Default</environments>
    <interviewLabel>Core MDF Customer Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core MDF Customer Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>490</locationX>
        <locationY>48</locationY>
        <filterFormula>ISCHANGED({!$Record.Status}) &amp;&amp; ISPICKVAL({!$Record.Status},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL({!$Record__Prior.Status},&apos;Pending Approval&apos;))&amp;&amp;
(ISPICKVAL({!$Record.Core_MDF_Program__c} ,&apos;Intel Partner Alliance&apos;) || ISPICKVAL({!$Record.Core_MDF_Program__c} ,&apos;Channel MDF&apos;)) &amp;&amp; 
(ISPICKVAL({!$Record__Prior.Status},&apos;Pending Review&apos;) || ( Not(ISPICKVAL({!$Record__Prior.Core_MDF_Approval_Stage_nm__c},&apos;L1 Approval&apos;))&amp;&amp; {!$Record.Core_MDF_Approval_Step_Counter_nbr__c} = 1))</filterFormula>
        <object>Campaign</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Customer_Notification_after_5mins</name>
            <connector>
                <targetReference>Trigger_Customer_Notification</targetReference>
            </connector>
            <label>Customer Notification after 5mins</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>Core_MDF_Approver_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
