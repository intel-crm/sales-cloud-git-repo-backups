<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>for the LEAD WF 

&apos;Core_Lead_Lead Rating &apos;</description>
        <name>Core_Lead_Lead_Rating</name>
        <label>Core_Lead_Lead Rating</label>
        <locationX>182</locationX>
        <locationY>587</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CNDARequest</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Conversion_Point__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>cNDA Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_fields_for_Core_Lead_Lead_Rating</targetReference>
            </connector>
            <label>CNDA Request</label>
        </rules>
    </decisions>
    <decisions>
        <description>for the WF&apos; Core_Lead_Update_State_On_Conversion &apos;</description>
        <name>Core_Lead_Update_State_On_Conversion</name>
        <label>Core_Lead_Update_State_On_Conversion</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Core_Lead_Lead_Rating</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_State_On_Conversion</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsConverted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Lead_Update_State_To_Converted</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Update_State_On_Conversion</label>
        </rules>
    </decisions>
    <description>---for the WFs ---

1.Core_Lead_Lead Rating
2.Core_Lead_Update_State_On_Conversion
3.Core_Lead_Update_Address_From_Existing_Account
4.Core_Lead_Update_Country_From_Existing_Account</description>
    <ends>
        <name>END_ELEMENT_3</name>
        <locationX>314</locationX>
        <locationY>695</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>50</locationX>
        <locationY>803</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <description>for the Workflow 

&apos; Core_Lead_Update_Country_From_Existing_Account &apos;</description>
        <name>F_Core_Lead_Update_Country_From_Existing_Account</name>
        <dataType>Boolean</dataType>
        <expression>OR (  AND ( ISNEW(),  NOT (ISBLANK({!$Record.Core_Existing_Covered_Account__c})) ), AND ( ISCHANGED({!$Record.Core_Existing_Covered_Account__c}),  NOT (ISBLANK({!$Record.Core_Existing_Covered_Account__c})) ) )</expression>
    </formulas>
    <interviewLabel>Core_Lead_Address_StateChanged_Rating {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Lead_Address_StateChanged_Rating</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_Lead_Update_State_To_Converted</name>
        <label>Core_Lead_Update_State_To_Converted</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <connector>
            <targetReference>Core_Lead_Lead_Rating</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Lead_State__c</field>
            <value>
                <stringValue>Converted</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_fields_for_Core_Lead_Lead_Rating</name>
        <label>Update fields for &apos;Core_Lead_Lead Rating&apos;</label>
        <locationX>50</locationX>
        <locationY>695</locationY>
        <connector>
            <targetReference>END_ELEMENT_4</targetReference>
        </connector>
        <inputAssignments>
            <field>Rating</field>
            <value>
                <stringValue>Hot</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_Lead_Update_State_On_Conversion</targetReference>
        </connector>
        <filterFormula>({!$Record.IsConverted}) || ({!$Record.Core_Lead_Conversion_Point__c} = &apos;cNDA Request&apos;) || (OR (  AND ( ISNEW(),  NOT (ISBLANK({!$Record.Core_Existing_Covered_Account__c})) ), AND ( ISCHANGED({!$Record.Core_Existing_Covered_Account__c}),  NOT (ISBLANK({!$Record.Core_Existing_Covered_Account__c})) ) ))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
