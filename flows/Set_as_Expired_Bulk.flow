            </value>
        </filters>
        <inputAssignments>
            <field>Core_Comment_Txt__c</field>
            <value>
                <elementReference>comments</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Design_Product_Status_Nm__c</field>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </inputAssignments>
        <object>Core_Design_Registration_Product__c</object>
