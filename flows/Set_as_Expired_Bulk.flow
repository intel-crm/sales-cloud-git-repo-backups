<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assign_drp_to_common_collection</name>
        <label>assign drp to common collection</label>
        <locationX>512</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>get_selected_drps</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>get_all_drp</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>If_no_drp_selected</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>listofeligibledrp</name>
        <label>listofeligibledrp</label>
        <locationX>270</locationX>
        <locationY>866</locationY>
        <assignmentItems>
            <assignToReference>FinalDRPIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>loop_through_records.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loop_through_records</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_drp_is_selected</name>
        <label>Check if drp is selected</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>get_all_drp</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>drps_selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ids</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_selected_drps</targetReference>
            </connector>
            <label>drps selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>FinalDRPListisEmpty</name>
        <label>FinalDRPListisEmpty</label>
        <locationX>182</locationX>
        <locationY>1142</locationY>
        <defaultConnector>
            <targetReference>Failure_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FinalDRPIds</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>comment_screen</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <name>if_conditions_meet</name>
        <label>if conditions meet</label>
        <locationX>402</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>loop_through_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>set_as_expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_through_records.Core_Design_Product_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>listofeligibledrp</targetReference>
            </connector>
            <label>set as expired</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_no_drp_selected</name>
        <label>If no drp selected</label>
        <locationX>380</locationX>
        <locationY>542</locationY>
        <defaultConnector>
            <targetReference>Error_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DRP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_selected_drps</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>loop_through_records</targetReference>
            </connector>
            <label>DRP</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Set as Expired Bulk {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set as Expired Bulk</label>
    <loops>
        <name>loop_through_records</name>
        <label>loop through records</label>
        <locationX>182</locationX>
        <locationY>650</locationY>
        <collectionReference>get_selected_drps</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>if_conditions_meet</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>FinalDRPListisEmpty</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>get_all_drp</name>
        <label>get all drp</label>
        <locationX>512</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>assign_drp_to_common_collection</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Design_Registration_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Design_Product_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Design_Registration_Product__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>get selected drps from ids</description>
        <name>get_selected_drps</name>
        <label>get selected drps</label>
        <locationX>248</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_no_drp_selected</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>ids</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Design_Registration_Product__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Copy_1_of_update_the_drp</name>
