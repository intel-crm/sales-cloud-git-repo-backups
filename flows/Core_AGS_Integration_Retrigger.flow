<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_AGS_Error_Message</name>
        <label>Assign AGS Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Var_AGS_Error_Message</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_AGS_Error_Messages.AGS_Error_Message__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_AGS_Message_In_Custom_Setting</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Valid_AGS_Flag_True</name>
        <label>Set Valid AGS Flag True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Is_Valid_AGS_Flag</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_AGS_Error_Messages</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_AGS_Valid_Flag</name>
        <label>Check AGS Valid Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>AGS Flag Is False</defaultConnectorLabel>
        <rules>
            <name>AGS_Flag_Is_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_Valid_AGS_Flag</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Triggering_Contact_Record</targetReference>
            </connector>
            <label>AGS Flag Is True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_AGS_Message_In_Custom_Setting</name>
        <label>Is AGS Message In Custom Setting</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_AGS_Error_Messages</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Valid AGS Message</defaultConnectorLabel>
        <rules>
            <name>Valid_AGS_Message</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_AGS_Integration_Message__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Var_AGS_Error_Message</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Valid_AGS_Flag_True</targetReference>
            </connector>
            <label>Valid AGS Message</label>
        </rules>
    </decisions>
    <decisions>
        <name>Record_Check</name>
        <label>Record Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_4</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>END_ELEMENT_4</targetReference>
            </connector>
            <label>Record present</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_6</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>FaultMessage</name>
        <dataType>String</dataType>
        <expression>&apos;Flow failed for Contact &apos;+{!$Record.Email}</expression>
    </formulas>
    <formulas>
        <name>RetryCountPlusOne</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Core_AGS_Retry_Count__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Contact_AGS_Integration_Retrigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core AGS Integration Retrigger Failed</label>
    <loops>
        <name>Loop_Through_AGS_Error_Messages</name>
        <label>Loop Through AGS Error Messages</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_AGS_Error_Messages</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_AGS_Error_Message</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_AGS_Valid_Flag</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Log_Entry_record</name>
        <label>Create Log Entry record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_5</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <elementReference>FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>Flow Core AGS Integration Retrigger</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$System.OriginDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_AGS_Error_Messages</name>
        <label>Get AGS Error Messages</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_AGS_Error_Messages</targetReference>
        </connector>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_Draco_Republish_Error_Message__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AGS_Error_Message__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Triggering_Contact_Record</name>
        <label>Update Triggering Contact Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_6</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_record</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Core_AGS_Retry_Count__c</field>
            <value>
                <elementReference>RetryCountPlusOne</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Republish_OBM_s__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Record_Check</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>Core_AGS_Integration_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Republish_OBM_s__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_AGS_Retry_Count__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <numberValue>4.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Core_AGS_Retry_Count__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Reattempt_After_5_Minutes</name>
            <connector>
                <targetReference>Get_AGS_Error_Messages</targetReference>
            </connector>
            <label>Reattempt After 5 Minutes</label>
            <offsetNumber>5</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>LastModifiedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Is_Valid_AGS_Flag</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>Is_Valid_Message_Found</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Stores AGS Error Message for comparison</description>
        <name>Var_AGS_Error_Message</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
