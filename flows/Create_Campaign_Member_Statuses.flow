        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Marketing_Campaign</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_Marketing_Campaign</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Executive_Event_Attended</targetReference>
            </connector>
            <label>Marketing Campaign</label>
        </rules>
    </decisions>
    <description>TWC3123-5661 Campaign Member Status needs to populate all the Campaign Member Status picklists when a Marketing Campaign is created</description>
