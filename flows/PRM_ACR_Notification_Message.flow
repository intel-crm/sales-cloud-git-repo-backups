    <description>Send Notification messages to contacts when new ACR record is created or updated</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>$Label.PRM_Msgcd_NewContact </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_7998022764</name>
        <dataType>String</dataType>
        <expression>{!$Label.PRM_Msgcd_NewContact}</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[PRM_Account_Contact_Relationship__c].PRM_Account_Id__r.RecordType.DeveloperName = $Label.PRM_Intel_Account , [PRM_Account_Contact_Relationship__c].PRM_Account_Id__r.Core_Intel_Partner_Alliance_PartnerGroup__c = true, [PRM_Account_Contact_Relationship__c].PRM_InActive_Ind__c = false, ISPICKVAL([PRM_Account_Contact_Relationship__c].PRM_Status_Nm__c ,&apos;Complete&apos;),
NOT(ISBLANK([PRM_Account_Contact_Relationship__c].PRM_Contact_Id__c )),
NOT(ISBLANK([PRM_Account_Contact_Relationship__c].PRM_Account_Id__c ))
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.PRM_Account_Id__r.RecordType.DeveloperName} = {!$Label.PRM_Intel_Account} , {!myVariable_current.PRM_Account_Id__r.Core_Intel_Partner_Alliance_PartnerGroup__c} = true, {!myVariable_current.PRM_InActive_Ind__c} = false, ISPICKVAL({!myVariable_current.PRM_Status_Nm__c} ,&apos;Complete&apos;),
NOT(ISBLANK({!myVariable_current.PRM_Contact_Id__c} )),
NOT(ISBLANK({!myVariable_current.PRM_Account_Id__c} ))
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[PRM_Account_Contact_Relationship__c].PRM_Account_Id__r.RecordType.DeveloperName = $Label.PRM_Intel_Account , [PRM_Account_Contact_Relationship__c].PRM_Account_Id__r.Core_Intel_Partner_Alliance_PartnerGroup__c = true, [PRM_Account_Contact_Relationship__c].PRM_InActive_Ind__c = false, ISPICKVAL([PRM_Account_Contact_Relationship__c].PRM_Status_Nm__c ,&apos;Complete&apos;),
NOT(ISBLANK([PRM_Account_Contact_Relationship__c].PRM_Contact_Id__c )),
NOT(ISBLANK([PRM_Account_Contact_Relationship__c].PRM_Account_Id__c ))
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1_pmetrule</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_old.PRM_Account_Id__r.RecordType.DeveloperName} = {!$Label.PRM_Intel_Account} , {!myVariable_old.PRM_Account_Id__r.Core_Intel_Partner_Alliance_PartnerGroup__c} = true, {!myVariable_old.PRM_InActive_Ind__c} = false, ISPICKVAL({!myVariable_old.PRM_Status_Nm__c} ,&apos;Complete&apos;),
NOT(ISBLANK({!myVariable_old.PRM_Contact_Id__c} )),
NOT(ISBLANK({!myVariable_old.PRM_Account_Id__c} ))
)</expression>
    </formulas>
