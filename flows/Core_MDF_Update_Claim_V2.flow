    <decisions>
        <name>checkClaimId</name>
        <label>checkClaimId</label>
        <locationX>390</locationX>
        <locationY>52</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>NotNull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getClaimRecord</targetReference>
            </connector>
            <label>NotNull</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkClaimRecord</name>
        <label>checkClaimRecord</label>
        <locationX>696</locationX>
        <locationY>45</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Is_Claim_Paid</targetReference>
            </connector>
            <label>Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkReleaseHoldOrDenied</name>
        <label>checkReleaseHoldOrDenied</label>
        <locationX>1197</locationX>
        <locationY>85</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>CompliantReleaseHold_0</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>varRequestedReimbursementAmount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varRequestedReimbursementAmount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Adjustment_Amount</targetReference>
            </connector>
            <label>CompliantReleaseHoldWithAdjustmentAmount</label>
        </rules>
        <rules>
            <name>NonCompliantDenied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non-compliant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Claim_Status_as_Denied</targetReference>
            </connector>
            <label>NonCompliantDenied</label>
        </rules>
        <rules>
            <name>CompliantPICReleaseHoldOnly</name>
            <conditionLogic>(1 OR 4) AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PIC Review Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Adjustment_Amount_2</targetReference>
            </connector>
            <label>Compliant/PIC - ReleaseHoldOnly</label>
        </rules>
    </decisions>
    <decisions>
        <name>ClaimVATOutcome</name>
        <label>Claim VAT Outcome</label>
        <locationX>519</locationX>
        <locationY>303</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsVATEligibleTrue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Adjustment_Request_1</targetReference>
            </connector>
            <label>IsVATEligibleTrue</label>
        </rules>
        <rules>
            <name>IsVATEligibleFalse</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Adjustment_Request</targetReference>
            </connector>
            <label>IsVATEligibleFalse</label>
        </rules>
    </decisions>
    <decisions>
        <description>This block contains 3 outcomes of claim review.</description>
        <name>Core_MDF_Claim_Review_Outcome</name>
        <label>Claim Review Outcome</label>
        <locationX>739</locationX>
        <locationY>234</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Compliant_With_No_Adjustment</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Release_Review_Hold</targetReference>
            </connector>
            <label>Compliant With No Adjustment</label>
        </rules>
        <rules>
            <name>Compliant_With_Adjustment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCaseAdjustmentAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ClaimVATOutcome</targetReference>
            </connector>
            <label>Compliant With Adjustment</label>
        </rules>
        <rules>
            <name>Core_MDF_Non_compliant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non-compliant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Set_Adjustment_Request_For_Non_Compliant</targetReference>
            </connector>
            <label>Non-compliant</label>
        </rules>
    </decisions>
    <decisions>
        <description>This decision box will check weather the claim is paid or not</description>
        <name>Core_MDF_Is_Claim_Paid</name>
        <label>Is Claim Paid</label>
        <locationX>925</locationX>
        <locationY>54</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Claim_Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Claim_Review_Outcome</targetReference>
            </connector>
            <label>Claim Paid</label>
        </rules>
        <rules>
            <name>Core_MDF_Claim_Not_Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>checkReleaseHoldOrDenied</targetReference>
            </connector>
            <label>Claim Not Paid</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is Claim Vat Eligible or Bank Document Eligible</description>
        <name>Core_MDF_Is_Vat_or_Bank_Document_Eligible</name>
        <label>Is Vat or Bank Document Eligible</label>
        <locationX>1309</locationX>
        <locationY>477</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Eligible</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Bank_Doc_Hold_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_Vat_and_Take_Action</targetReference>
            </connector>
            <label>Is Eligible</label>
        </rules>
        <rules>
            <name>Is_Not_Vat_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>callReleaseHold</targetReference>
            </connector>
            <label>Is Not Vat Eligible</label>
        </rules>
    </decisions>
