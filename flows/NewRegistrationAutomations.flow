<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Get_New_or_Updated_Record_ID</name>
        <label>Get New or Updated Record ID</label>
        <locationX>287</locationX>
        <locationY>280</locationY>
        <assignmentItems>
            <assignToReference>FlowVar_RecordID</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Record_ID</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>c_AE_Approved</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A&amp;E Approved</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_AE_Rejected</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A&amp;E Rejected</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_AEPending</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A&amp;E Pending</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_InsidesSalesApproved</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Insides Sales Approved</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_InsidesSalesPending</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Insides Sales Pending</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_InsidesSalesRejected</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Insides Sales Rejected</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_Open</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Open</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Get_Record_ID</name>
        <label>Get Record ID</label>
        <locationX>455</locationX>
        <locationY>282</locationY>
        <defaultConnector>
            <targetReference>Update_Status_Field_to_New</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Get_Record_ID_from_Registration_Obj</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FlowVar_RecordID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_New_Registration_record</targetReference>
            </connector>
            <label>Get Record ID from Registration Obj</label>
        </rules>
    </decisions>
    <interviewLabel>{!$User.FirstName}NewRegistrationAutomations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NewRegistrationAutomations</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_the_New_Registration_record</name>
        <label>Get the New Registration record</label>
        <locationX>693</locationX>
        <locationY>278</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Geo_field</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Country__c</elementReference>
            </value>
        </filters>
        <object>Country_Geo_Mapping__c</object>
        <outputAssignments>
            <assignToReference>Geo_Code</assignToReference>
            <field>Geo_Code__c</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_Geo_field</name>
        <label>Update Geo field</label>
        <locationX>832</locationX>
        <locationY>401</locationY>
        <inputAssignments>
            <field>Geo_Code__c</field>
            <value>
                <elementReference>Geo_Code</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Status_Field_to_New</name>
        <label>Update Status Field to New</label>
        <locationX>578</locationX>
        <locationY>436</locationY>
        <filterLogic>1 OR 2 OR 3</filterLogic>
        <filters>
            <field>Current_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>c_Open</elementReference>
            </value>
        </filters>
        <filters>
            <field>Current_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>c_AEPending</elementReference>
            </value>
        </filters>
        <filters>
            <field>Current_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>c_InsidesSalesPending</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PRM_Status__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>48</locationX>
        <locationY>32</locationY>
        <connector>
            <targetReference>Get_New_or_Updated_Record_ID</targetReference>
        </connector>
        <filterLogic>(1 AND 2) OR 3</filterLogic>
        <filters>
            <field>Country__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>Geo_Code__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Current_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>FlowVar_RecordID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <name>Geo</name>
        <dataType>Picklist</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Geo_Code</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <name>GeoCode</name>
        <dataType>Picklist</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>RecordID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
</Flow>
