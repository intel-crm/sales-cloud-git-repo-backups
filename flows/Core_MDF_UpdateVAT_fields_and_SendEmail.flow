    <decisions>
        <description>To check whether the claim is an adjustment</description>
        <name>Adjustment_Claim</name>
        <label>Adjustment/Claim</label>
        <locationX>578</locationX>
        <locationY>575</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Adjustment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Claim_Adjustment_Type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_C_Type_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_Adjustment_status_to_PAF</targetReference>
            </connector>
            <label>Adjustment</label>
        </rules>
        <rules>
            <name>Claim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Claim</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_C_Type_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaimRecord.Core_MDF_VAT_Eligibility_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assignReleaseHoldValues_0</targetReference>
            </connector>
            <label>Claim</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Verify_status</name>
        <label>Verify status</label>
        <locationX>886</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Pending_Document_Status</name>
            <conditionLogic>(1 OR 2) AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Case_Status_Pending_Document</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Owner:User.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Partner_User_Type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Core_MDF_Claim_Submitter_Id__r.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Partner_User_Type</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Sent_Notification_to_Claim_Submitters</targetReference>
            </connector>
            <label>Pending Document Status</label>
        </rules>
        <rules>
            <name>VAT_Approved_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Status_Approved</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Claim_Id__r.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getClaimRecord</targetReference>
            </connector>
            <label>VAT Approved Status</label>
        </rules>
        <rules>
            <name>Core_MDF_Revision_Required_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_PFR_Status_RevisionRequired</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Notify_Claim_Submitters_on_VAT_Rejection</targetReference>
            </connector>
            <label>Revision Required Status</label>
        </rules>
        <rules>
            <name>Core_MDF_Under_Review_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Case_Status_Under_Review</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Read_Document_Link_Record</targetReference>
            </connector>
            <label>Under Review Status</label>
        </rules>
    </decisions>
    <description>Merging flow &apos;Core_MDF_VAT_Approved&apos; , flow &apos;Claim VAT Document Owner Update&apos; and process builder &apos;Update VAT fields and Send Email&apos;</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>varReleaseReason</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_VAT_Hold}</expression>
    </formulas>
    <interviewLabel>Update VAT fields and Send Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update VAT fields and Send Email</label>
