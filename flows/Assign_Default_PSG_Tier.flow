    <description>Concatenate all the individual group tiers and display it in Account Tier.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>TEXT([Account].Core_Account_PSG_Tier__c )+
IF(ISPICKVAL([Account].Core_Account_ISG_Tier__c, &quot;&quot;), NULL,&quot;;&quot;+TEXT([Account].Core_Account_ISG_Tier__c )) + 
IF(ISPICKVAL([Account].Core_Account_CCG_Tier__c , &quot;&quot;), NULL,&quot;;&quot;+TEXT([Account].Core_Account_CCG_Tier__c )) + 
IF(ISPICKVAL([Account].Core_Account_DCG_Tier__c , &quot;&quot;), NULL,&quot;;&quot;+TEXT([Account].Core_Account_DCG_Tier__c )) + 
IF(ISPICKVAL([Account].Core_Account_GA_Tier__c, &quot;&quot;), NULL,&quot;;&quot;+TEXT([Account].Core_Account_GA_Tier__c)) + 
IF(ISPICKVAL([Account].Core_Account_IOTG_Tier__c , &quot;&quot;), NULL,&quot;;&quot;+TEXT([Account].Core_Account_IOTG_Tier__c )) + 
IF(ISPICKVAL([Account].Core_Account_NTG_Tier__c , &quot;&quot;), NULL,&quot;;&quot;+TEXT([Account].Core_Account_NTG_Tier__c )) + 
IF(ISPICKVAL([Account].Core_Account_RSG_Tier__c , &quot;&quot;), NULL,&quot;;&quot;+TEXT([Account].Core_Account_RSG_Tier__c ))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_7388999865</name>
        <dataType>String</dataType>
        <expression>TEXT({!myVariable_current.Core_Account_PSG_Tier__c} )+
IF(ISPICKVAL({!myVariable_current.Core_Account_ISG_Tier__c}, &quot;&quot;), NULL,&quot;;&quot;+TEXT({!myVariable_current.Core_Account_ISG_Tier__c} )) + 
IF(ISPICKVAL({!myVariable_current.Core_Account_CCG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!myVariable_current.Core_Account_CCG_Tier__c} )) + 
IF(ISPICKVAL({!myVariable_current.Core_Account_DCG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!myVariable_current.Core_Account_DCG_Tier__c} )) + 
IF(ISPICKVAL({!myVariable_current.Core_Account_GA_Tier__c}, &quot;&quot;), NULL,&quot;;&quot;+TEXT({!myVariable_current.Core_Account_GA_Tier__c})) + 
IF(ISPICKVAL({!myVariable_current.Core_Account_IOTG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!myVariable_current.Core_Account_IOTG_Tier__c} )) + 
IF(ISPICKVAL({!myVariable_current.Core_Account_NTG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!myVariable_current.Core_Account_NTG_Tier__c} )) + 
IF(ISPICKVAL({!myVariable_current.Core_Account_RSG_Tier__c} , &quot;&quot;), NULL,&quot;;&quot;+TEXT({!myVariable_current.Core_Account_RSG_Tier__c} ))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Account].RecordType.DeveloperName == &apos;Mastered_Account&apos; ,
OR(
ISNEW(),
ISCHANGED([Account].Core_Account_CCG_Tier__c ),
ISCHANGED([Account].Core_Account_DCG_Tier__c  ),
ISCHANGED([Account].Core_Account_GA_Tier__c  ),
ISCHANGED([Account].Core_Account_IOTG_Tier__c  ),
ISCHANGED([Account].Core_Account_ISG_Tier__c  ),
ISCHANGED([Account].Core_Account_NTG_Tier__c ),
ISCHANGED([Account].Core_Account_PSG_Tier__c ),
ISCHANGED([Account].Core_Account_RSG_Tier__c ),
ISCHANGED([Account].Core_PSG_Account__c)
)

)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordType.DeveloperName} == &apos;Mastered_Account&apos; ,
OR(
ISNEW(),
ISCHANGED({!myVariable_current.Core_Account_CCG_Tier__c} ),
ISCHANGED({!myVariable_current.Core_Account_DCG_Tier__c}  ),
ISCHANGED({!myVariable_current.Core_Account_GA_Tier__c}  ),
ISCHANGED({!myVariable_current.Core_Account_IOTG_Tier__c}  ),
ISCHANGED({!myVariable_current.Core_Account_ISG_Tier__c}  ),
ISCHANGED({!myVariable_current.Core_Account_NTG_Tier__c} ),
ISCHANGED({!myVariable_current.Core_Account_PSG_Tier__c} ),
ISCHANGED({!myVariable_current.Core_Account_RSG_Tier__c} ),
ISCHANGED({!myVariable_current.Core_PSG_Account__c})
)

)</expression>
    </formulas>
    <interviewLabel>Assign_Default_PSG_Tier-5_InterviewLabel</interviewLabel>
