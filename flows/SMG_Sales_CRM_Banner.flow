<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <description>LoginFlow_Banner</description>
        <name>LoginFlow_Banner</name>
        <dataType>String</dataType>
        <value>
            <stringValue>&lt;img src=&quot;/servlet/servlet.ImageServer?id=0151J000002ZLNd&amp;oid=00Do0000000aRcf&amp;lastMod=1509033151000&quot; width=&quot;700&quot;&gt;</stringValue>
        </value>
    </constants>
    <description>SMG Sales CRM Banner (Splash Screen during User Login)</description>
    <formulas>
        <description>Login_UserName</description>
        <name>Login_UserName</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName} + &apos; &apos; + {!$User.LastName}</expression>
    </formulas>
    <interviewLabel>SMG Sales CRM Banner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SMG Sales CRM Banner</label>
    <processType>Flow</processType>
    <screens>
        <description>SMG Sales CRM Banner (Splash Screen during User Login)</description>
        <name>SMG_Sales_CRM_Banner</name>
        <label>SMG Sales CRM Banner</label>
        <locationX>343</locationX>
        <locationY>110</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>SalesCRMBanner</name>
            <fieldText>&lt;DIV ALIGN=&quot;CENTER&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;1&quot;&gt;{!LoginFlow_Banner}&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Georgia&quot; STYLE=&quot;font-size:14px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;1&quot;&gt;&lt;B&gt; Hi {!Login_UserName} , &lt;/B&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Arial&quot; STYLE=&quot;font-size:12px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;0&quot;&gt;&lt;/FONT&gt;&lt;/DIV&gt;&lt;DIV ALIGN=&quot;LEFT&quot;&gt;&lt;FONT FACE=&quot;Georgia&quot; STYLE=&quot;font-size:15px&quot; COLOR=&quot;#000000&quot; LETTERSPACING=&quot;0&quot; KERNING=&quot;1&quot;&gt;&lt;B&gt;Commissions:&lt;/B&gt;&lt;FONT STYLE=&quot;font-size:14px&quot;&gt;&lt;B&gt; &lt;/B&gt;The new Ask Commissions tool launches in Sales CRM, Thursday December 14th.  Easily accessible through the Ask a Question tab in Salesforce you will receive, secure access to Global Commissions specialists and the ability to check status of your request at any time. &lt;FONT COLOR=&quot;#0033FF&quot;&gt;&lt;A HREF=&quot;http://goto/askcommissions&quot; TARGET=&quot;_blank&quot;&gt;&lt;U&gt;http://goto/askcommissions&lt;/U&gt;&lt;/A&gt;&lt;FONT STYLE=&quot;font-size:15px&quot; COLOR=&quot;#000000&quot;&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/DIV&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <startElementReference>SMG_Sales_CRM_Banner</startElementReference>
    <status>Active</status>
</Flow>
