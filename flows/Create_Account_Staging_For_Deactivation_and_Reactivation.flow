    <start>
        <locationX>1376</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Account_Staging_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Deactivated__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Business_Party_Id__c</field>
            <operator>IsNull</operator>
            <value>
