<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_For_Status_of_Existing_Staging_Record_and_Account_Flag</name>
        <label>Check For Status of Existing Staging Record and Account Flag</label>
        <locationX>842</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Cancel_Reactivation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Staging_Record.Core_Action__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DEACTIVATE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Of_Staging</targetReference>
            </connector>
            <label>Cancel Reactivation</label>
        </rules>
        <rules>
            <name>Cancel_Deactivation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Staging_Record.Core_Action__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>REACTIVATE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Of_ReActivation_Staging</targetReference>
            </connector>
            <label>Cancel Deactivation</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_To_Insert_Staging_Record_wrt_Deactivated_Flag</name>
        <label>Check To Insert Staging Record wrt Deactivated Flag</label>
        <locationX>2162</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Create_Reactivation_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Insert Reactivation</defaultConnectorLabel>
        <rules>
            <name>Insert_Deactivation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Deactivation_Record</targetReference>
            </connector>
            <label>Insert Deactivation</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Staging_Record_Exists_Already</name>
        <label>If Staging Record Exists Already</label>
        <locationX>1502</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Check_To_Insert_Staging_Record_wrt_Deactivated_Flag</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Staging Record Does Not Exist</defaultConnectorLabel>
        <rules>
            <name>Staging_Record_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Staging_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_For_Status_of_Existing_Staging_Record_and_Account_Flag</targetReference>
            </connector>
            <label>Staging Record Exists</label>
        </rules>
    </decisions>
    <environments>Default</environments>
