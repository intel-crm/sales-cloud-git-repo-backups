            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>F_Core_Ownership_Change_Within_One_Business_Day_of_Meeting_Task_TQL</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
