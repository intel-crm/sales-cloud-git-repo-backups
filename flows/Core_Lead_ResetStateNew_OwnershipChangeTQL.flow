    <description>For LEAD WFs

&apos; Core_Ownership_Change_Within_One_Business_Day_of_Meeting_Task_TQL &apos;
&apos; Core_Lead_Reset_Lead_State_New &apos;</description>
    <environments>Default</environments>
    <formulas>
        <description>for the LEAD WF
&apos;Core_Ownership_Change_Within_One_Business_Day_of_Meeting_Task_TQL&apos;</description>
        <name>F_Core_Ownership_Change_Within_One_Business_Day_of_Meeting_Task_TQL</name>
        <dataType>Boolean</dataType>
        <expression>AND(  {!$Record.RecordType.DeveloperName} &lt;&gt; &quot;Partner_Lead&quot;,  ISCHANGED({!$Record.OwnerId}),  NOT(ISNULL({!$Record.Core_Meeting_Due_Date__c})),   ISPICKVAL({!$Record.Status}, &apos;Tele Qualified Lead&apos;) )</expression>
    </formulas>
    <formulas>
        <name>F_NULLDATETIME</name>
        <dataType>DateTime</dataType>
        <expression>NULL</expression>
    </formulas>
