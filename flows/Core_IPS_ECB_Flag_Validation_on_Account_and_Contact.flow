<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>change the Status to Core_Status__c = InActive</description>
        <name>Deactivate_Project_Member</name>
        <label>Deactivate Project Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Fetch_Project_Members.Core_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Inactive</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Fetch_Project_Members.Add_as_Case_Interested_Party__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Fetch_Project_Members</targetReference>
        </connector>
    </assignments>
    <description>Once the ECB flag on the Account is activated the related Contacts will be changed to IPS de-active (Core_IPS_Active = False)</description>
    <environments>Default</environments>
    <interviewLabel>Core IPS ECB Flag Validation on Account and Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core IPS ECB Flag Validation on Account and Contact</label>
    <loops>
        <name>Fetch_Project_Members</name>
        <label>Fetch Project Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Related_Project_members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Deactivate_Project_Member</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Premier_Support_Project_Member</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Related_Project_members</name>
        <label>Related Project members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Fetch_Project_Members</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_IPS_Contact_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>IsDeleted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Core_IPS_Project_Member__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>If ECB Flag on Account is Checked then the related contacts status will be change to IPS Deactivate state</description>
        <name>Related_Contacts_IPS_Deactivate</name>
        <label>Related Contacts IPS Deactivate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Related_Project_members</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_IPS_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Deactivated__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_IPS_Active__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_IPS_By_Pass_Validation__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Contacts</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Update Premier Support Project Member (Core_IPS_Project_Member__c)</description>
        <name>Update_Premier_Support_Project_Member</name>
        <label>Update Premier Support Project Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Fetch_Project_Members</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Related_Contacts_IPS_Deactivate</targetReference>
        </connector>
        <filterFormula>{!$Record__Prior.Core_Export_Compliance_Block__c}=false &amp;&amp; ISCHANGED({!$Record.Core_Export_Compliance_Block__c}) &amp;&amp; {!$Record.Core_Export_Compliance_Block__c} = true &amp;&amp; {!$Record.Core_Deactivated__c}=false</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
