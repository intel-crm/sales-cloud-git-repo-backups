    <description>Automate the lead stage change</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Lead].RecordType.DeveloperName &lt;&gt; &quot;Partner_Lead&quot;,
ISCHANGED([Lead].Status ), 
ISPICKVAL(PRIORVALUE([Lead].Status), &quot;Marketing Qualified Lead&quot;), 
ISPICKVAL([Lead].Status, &quot;Tele Accepted Lead&quot;), 
OR(
ISPICKVAL([Lead].Core_Lead_Status__c , &quot;New&quot;),
ISPICKVAL([Lead].Core_Lead_Status__c , &quot;Accepted&quot;)
))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordType.DeveloperName} &lt;&gt; &quot;Partner_Lead&quot;,
ISCHANGED({!myVariable_current.Status} ), 
ISPICKVAL(PRIORVALUE({!myVariable_current.Status}), &quot;Marketing Qualified Lead&quot;), 
ISPICKVAL({!myVariable_current.Status}, &quot;Tele Accepted Lead&quot;), 
OR(
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &quot;New&quot;),
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &quot;Accepted&quot;)
))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Lead].RecordType.DeveloperName &lt;&gt; &quot;Partner_Lead&quot;,
ISCHANGED([Lead].Status ),
ISPICKVAL(PRIORVALUE([Lead].Status), &quot;Tele Accepted Lead&quot;),
ISPICKVAL([Lead].Status, &quot;Tele Qualified Lead&quot;),
OR(
ISPICKVAL([Lead].Core_Lead_Status__c , &quot;Accepted&quot;),
ISPICKVAL([Lead].Core_Lead_Status__c , &quot;Qualified&quot;)
))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordType.DeveloperName} &lt;&gt; &quot;Partner_Lead&quot;,
ISCHANGED({!myVariable_current.Status} ),
ISPICKVAL(PRIORVALUE({!myVariable_current.Status}), &quot;Tele Accepted Lead&quot;),
ISPICKVAL({!myVariable_current.Status}, &quot;Tele Qualified Lead&quot;),
OR(
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &quot;Accepted&quot;),
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &quot;Qualified&quot;)
))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Lead].RecordType.DeveloperName &lt;&gt; &quot;Partner_Lead&quot;, 
ISCHANGED([Lead].Status ),
ISPICKVAL(PRIORVALUE([Lead].Status), &quot;Tele Qualified Lead&quot;), 
ISPICKVAL([Lead].Status, &quot;Sales Accepted Lead&quot;),
OR(
ISPICKVAL([Lead].Core_Lead_Status__c , &quot;Accepted&quot;),
ISPICKVAL([Lead].Core_Lead_Status__c , &quot;Qualified&quot;)
))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordType.DeveloperName} &lt;&gt; &quot;Partner_Lead&quot;, 
ISCHANGED({!myVariable_current.Status} ),
ISPICKVAL(PRIORVALUE({!myVariable_current.Status}), &quot;Tele Qualified Lead&quot;), 
ISPICKVAL({!myVariable_current.Status}, &quot;Sales Accepted Lead&quot;),
OR(
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &quot;Accepted&quot;),
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &quot;Qualified&quot;)
))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(
AND(
[Lead].RecordType.DeveloperName = &quot;Lead&quot;, 
ISCHANGED([Lead].Status ),
ISPICKVAL(PRIORVALUE([Lead].Status), &quot;Marketing Qualified Lead&quot;), 
ISPICKVAL([Lead].Status, &quot;Sales Accepted Lead&quot;),
OR(
ISPICKVAL([Lead].Core_Lead_Status__c , &quot;New&quot;),
ISPICKVAL([Lead].Core_Lead_Status__c , &quot;Accepted&quot;)
)),
AND(
[Lead].RecordType.DeveloperName = &quot;Sales_Lead&quot;, 
ISCHANGED([Lead].Status ),
ISPICKVAL(PRIORVALUE([Lead].Status), &quot;Tele Accepted Lead&quot;), 
ISPICKVAL([Lead].Status, &quot;Sales Accepted Lead&quot;),
ISPICKVAL([Lead].Core_Lead_Status__c , &quot;Accepted&quot;)
)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_7</name>
        <dataType>Boolean</dataType>
        <expression>OR(
AND(
{!myVariable_current.RecordType.DeveloperName} = &quot;Lead&quot;, 
ISCHANGED({!myVariable_current.Status} ),
ISPICKVAL(PRIORVALUE({!myVariable_current.Status}), &quot;Marketing Qualified Lead&quot;), 
ISPICKVAL({!myVariable_current.Status}, &quot;Sales Accepted Lead&quot;),
OR(
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &quot;New&quot;),
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &quot;Accepted&quot;)
)),
AND(
{!myVariable_current.RecordType.DeveloperName} = &quot;Sales_Lead&quot;, 
ISCHANGED({!myVariable_current.Status} ),
ISPICKVAL(PRIORVALUE({!myVariable_current.Status}), &quot;Tele Accepted Lead&quot;), 
ISPICKVAL({!myVariable_current.Status}, &quot;Sales Accepted Lead&quot;),
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &quot;Accepted&quot;)
)
)</expression>
    </formulas>
