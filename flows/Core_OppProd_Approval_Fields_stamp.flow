<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>OppProd_clear_Approval_field_stamp</name>
        <label>OppProd_clear_Approval_field_stamp</label>
        <locationX>661</locationX>
        <locationY>361</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Update_Approval_Details</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Win Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateApprovalDetails</targetReference>
            </connector>
            <label>Core_Update_Approval_Details</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>OpportunityOwnerName</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.Opportunity.Owner.FirstName}+&quot;&quot;+{!$Record.Opportunity.Owner.LastName})</expression>
    </formulas>
    <formulas>
        <name>TechnicalOwnerName</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.Opportunity.Core_Technical_Owner__r.FirstName}+&quot;&quot;+{!$Record.Opportunity.Core_Technical_Owner__r.LastName})</expression>
    </formulas>
    <formulas>
        <name>TotalPrice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.UnitPrice}*{!$Record.Quantity}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Core_Approved_Total_Price__c {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_OppProd_Approval_Fields_stamp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>UpdateApprovalDetails</name>
        <label>UpdateApprovalDetails</label>
        <locationX>958</locationX>
        <locationY>335</locationY>
        <inputAssignments>
            <field>Core_Approved_By__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Approved_By__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Commissionable__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Commissionable__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Approved_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Decision_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.CloseDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_List_Price__c</field>
            <value>
                <elementReference>$Record.ListPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Opportunity_Owner__c</field>
            <value>
                <elementReference>OpportunityOwnerName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Quantity__c</field>
            <value>
                <elementReference>$Record.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Sales_Price__c</field>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Technical_Owner__c</field>
            <value>
                <elementReference>TechnicalOwnerName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Total_Price__c</field>
            <value>
                <elementReference>TotalPrice</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>543</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>OppProd_clear_Approval_field_stamp</targetReference>
        </connector>
        <object>OpportunityLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
