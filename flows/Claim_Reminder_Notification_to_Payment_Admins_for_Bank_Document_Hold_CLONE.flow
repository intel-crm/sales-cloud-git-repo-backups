    <apiVersion>51.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_if_program_is_Retail</name>
        <label>Check if program is Retail or Channel MDF</label>
        <locationX>446</locationX>
        <locationY>516</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_CP_is_Retail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Retail_Channel_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reminder_Notification_to_RSM</targetReference>
            </connector>
            <label>Check if CP is Retail</label>
        </rules>
        <rules>
            <name>Check_if_CP_is_Channel_MDF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_ChannelMDF_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_PGM_Group_Id_For_CMDF</targetReference>
            </connector>
            <label>Check if CP is Channel MDF</label>
        </rules>
        <rules>
            <name>Check_if_CP_is_IPA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_IPA_Technical_program_name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_PGM_Group_Id_For_IPA</targetReference>
            </connector>
            <label>Check if CP is IPA</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Reminder_Date</name>
        <label>Check Reminder Date</label>
        <locationX>776</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>default outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Reminder_Date_Less_Than_Equals_Today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Payment_Admin_Reminder_Date_Dtm__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>TodaysDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendReminderNotificationToPaymentAdmin</targetReference>
            </connector>
            <label>Check Reminder Date Less Than Equals Today</label>
        </rules>
    </decisions>
    <formulas>
        <name>TodaysDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Claim Reminder Notification to Payment Admins for Bank Document Hold CLONE {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Claim Reminder Notification to Payment Admins for Bank Document Hold CLONE</label>
    <processMetadataValues>
