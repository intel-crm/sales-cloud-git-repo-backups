<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Pleaseentertherejectionreason</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Please Enter The Rejection Reason</stringValue>
        </value>
    </constants>
    <description>Flow to Reject a Lead used by Partner Users. It asks for Rejection Reason, Rejection Comments. Updates Lead Stage to &apos;Partner Qualified Lead, Lead State to &apos;Rejected&apos;, Partner Lead Owner to current user, Rejection Reason, Rejection Comments on the Lead record.</description>
    <dynamicChoiceSets>
        <name>RejectionReasonPicklist</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Core_System_Partner_Rejection_Reason__c</picklistField>
        <picklistObject>Lead</picklistObject>
    </dynamicChoiceSets>
    <interviewLabel>Reject Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reject Lead</label>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Update_rejection_reason</name>
        <label>Update rejection reason</label>
        <locationX>488</locationX>
        <locationY>281</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vaLeadID</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Lead_State__c</field>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Partner_Lead_Owner__c</field>
            <value>
                <elementReference>Currentuser</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Rejection_Comments__c</field>
            <value>
                <elementReference>Rejection_Comments1</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Rejection__c</field>
            <value>
                <elementReference>Rejection_reasons</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Partner Qualified Lead</stringValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <screens>
        <name>Rejection_reasons_Popup_Screen</name>
        <label>Rejection reasons Popup Screen</label>
        <locationX>494</locationX>
        <locationY>160</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Update_rejection_reason</targetReference>
        </connector>
        <fields>
            <name>Displaytext</name>
            <fieldText>{!Pleaseentertherejectionreason}</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Rejection_reasons</name>
            <choiceReferences>RejectionReasonPicklist</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Rejection reasons</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Rejection_Comments1</name>
            <fieldText>Rejection Comments</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <startElementReference>Rejection_reasons_Popup_Screen</startElementReference>
    <status>Active</status>
    <variables>
        <name>Currentuser</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vaLeadID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
