<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Pleaseentertherejectionreason</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Please Enter The Rejection Reason</stringValue>
        </value>
    </constants>
    <constants>
        <name>Reject_Lead_Validation_Error</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Hi there!!! Unfortunately you cannot claim or make changes to a rejected lead. But there are many other unrejected leads to choose from.</stringValue>
        </value>
    </constants>
    <constants>
        <name>Rejection_Success</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Lead is rejected successfully.</stringValue>
        </value>
    </constants>
    <decisions>
        <name>IsValidLead</name>
        <label>IsValidLead</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LeadState</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Terminated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_rejection_reason</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
        <rules>
            <name>If_No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LeadState</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Terminated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reject_Lead_Validation</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>Flow to Reject a Lead used by Partner Users. It asks for Rejection Reason, Rejection Comments. Updates Lead Stage to &apos;Partner Qualified Lead, Lead State to &apos;Rejected&apos;, Partner Lead Owner to current user, Rejection Reason, Rejection Comments on the Lead record.</description>
    <dynamicChoiceSets>
        <name>RejectionReasonPicklist</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Core_Rejection__c</picklistField>
        <picklistObject>Lead</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Reject Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reject Lead</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Update_rejection_reason</name>
        <label>Update rejection reason</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>Rejection_Successful</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vaLeadID</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_Lead_State__c</field>
            <value>
                <stringValue>Terminated</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Lead_Status__c</field>
            <value>
                <stringValue>Disqualified</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Rejection_Comments__c</field>
            <value>
                <elementReference>Rejection_Comments1</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Rejection__c</field>
            <value>
                <elementReference>Rejection_reasons</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <screens>
        <name>Reject_Lead_Validation</name>
        <label>Reject Lead Validation</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Reject_Lead_Validation_Error_Msg</name>
            <fieldText>&lt;p&gt;{!Reject_Lead_Validation_Error}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Rejection_reasons_Popup_Screen</name>
        <label>Rejection reasons Popup Screen</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>IsValidLead</targetReference>
        </connector>
        <fields>
            <name>Displaytext</name>
            <fieldText>{!Pleaseentertherejectionreason}</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Rejection_reasons</name>
            <choiceReferences>RejectionReasonPicklist</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Rejection reasons</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Rejection_Comments1</name>
            <fieldText>Rejection Comments</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Rejection_Successful</name>
        <label>Rejection Successful</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Rejected</name>
            <fieldText>&lt;p&gt;{!Rejection_Success}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Rejection_reasons_Popup_Screen</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>Currentuser</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LeadState</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vaLeadID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
