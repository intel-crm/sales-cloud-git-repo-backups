        <fields>
            <name>Pricing_Old_Account_Executive_Email</name>
            <dataType>String</dataType>
            <fieldText>Provide the Old Account Executive Email</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;{!Pricing_Email_Validation_Error_Msg}&lt;/p&gt;</errorMessage>
                <formulaExpression>AND(REGEX( {!Pricing_Old_Account_Executive_Email} , &quot;(\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)(;\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)*&quot;),CONTAINS({!Pricing_Old_Account_Executive_Email},&quot;@intel.com&quot;))</formulaExpression>
            </validationRule>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Pricing_Select_the_type_of_update</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_Account_Excecutive_Update</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Pricing_New_Account_Executive_Email</name>
            <dataType>String</dataType>
            <fieldText>Provide the New Account Executive Email</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;{!Pricing_Email_Validation_Error_Msg}&lt;/p&gt;</errorMessage>
                <formulaExpression>AND(REGEX( {!Pricing_New_Account_Executive_Email} , &quot;(\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)(;\\s*[a-zA-Z0-9+._-]+@[a-zA-Z]+\\.[a-zA-Z]{2,3}(\\.[a-zA-Z]{2,2})?\\s*)*&quot;),CONTAINS({!Pricing_New_Account_Executive_Email},&quot;@intel.com&quot;),({!Pricing_Old_Account_Executive_Email} &lt;&gt; {!Pricing_New_Account_Executive_Email}))</formulaExpression>
            </validationRule>
            <visibilityRule>
                <conditionLogic>or</conditionLogic>
                <conditions>
                    <leftValueReference>Pricing_Select_the_type_of_update</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_Account_Excecutive_Update</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Pricing_Select_the_type_of_update</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Pricing_Account_Executive_Insertion</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
