    <description>Stamp the user coverage value if opportunity closed and set null when opportunity reopen from closed.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>IF( 
OR( 
ISPICKVAL([Opportunity].StageName , &quot;Design Win&quot;), 
ISPICKVAL([Opportunity].StageName, &quot;Production Win&quot;), 
ISPICKVAL([Opportunity].StageName, &quot;Production Lost&quot;), 
ISPICKVAL([Opportunity].StageName, &quot;Production Cancelled&quot;), 
ISPICKVAL([Opportunity].StageName, &quot;Lost&quot;), 
ISPICKVAL([Opportunity].StageName, &quot;Cancelled&quot;) 
), 
(IF(ISBLANK (TEXT([Opportunity].Owner.Core_User_Coverage__c )),&apos;Other&apos;,TEXT([Opportunity].Owner.Core_User_Coverage__c ))) , &quot;&quot;)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_6245898254</name>
        <dataType>String</dataType>
        <expression>IF( 
OR( 
ISPICKVAL({!myVariable_current.StageName} , &quot;Design Win&quot;), 
ISPICKVAL({!myVariable_current.StageName}, &quot;Production Win&quot;), 
ISPICKVAL({!myVariable_current.StageName}, &quot;Production Lost&quot;), 
ISPICKVAL({!myVariable_current.StageName}, &quot;Production Cancelled&quot;), 
ISPICKVAL({!myVariable_current.StageName}, &quot;Lost&quot;), 
ISPICKVAL({!myVariable_current.StageName}, &quot;Cancelled&quot;) 
), 
(IF(ISBLANK (TEXT({!myVariable_current.Owner.Core_User_Coverage__c} )),&apos;Other&apos;,TEXT({!myVariable_current.Owner.Core_User_Coverage__c} ))) , &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR( 
AND( 
ISCHANGED([Opportunity].StageName ), 
OR( 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Qualify&quot;, 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Define&quot;, 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Develop&quot;, 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Design&quot; 
), 
OR( 
ISPICKVAL([Opportunity].StageName,&quot;Design Win&quot;), 
ISPICKVAL([Opportunity].StageName,&quot;Production Win&quot;), 
ISPICKVAL([Opportunity].StageName,&quot;Production Lost&quot;), 
ISPICKVAL([Opportunity].StageName,&quot;Production Cancelled&quot;), 
ISPICKVAL([Opportunity].StageName,&quot;Lost&quot;), 
ISPICKVAL([Opportunity].StageName,&quot;Cancelled&quot;) 
) 
), 
AND( 
ISCHANGED([Opportunity].StageName), 
OR( 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Design Win&quot;, 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Production Win&quot;, 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Production Lost&quot;, 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Production Cancelled&quot;, 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Lost&quot;, 
TEXT(PRIORVALUE([Opportunity].StageName))=&quot;Cancelled&quot; 
), 
OR( 
ISPICKVAL([Opportunity].StageName,&quot;Qualify&quot;), 
ISPICKVAL([Opportunity].StageName,&quot;Define&quot;), 
ISPICKVAL([Opportunity].StageName,&quot;Develop&quot;), 
ISPICKVAL([Opportunity].StageName,&quot;Design&quot;) 
) 
) 
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>OR( 
AND( 
ISCHANGED({!myVariable_current.StageName} ), 
OR( 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Qualify&quot;, 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Define&quot;, 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Develop&quot;, 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Design&quot; 
), 
OR( 
ISPICKVAL({!myVariable_current.StageName},&quot;Design Win&quot;), 
ISPICKVAL({!myVariable_current.StageName},&quot;Production Win&quot;), 
ISPICKVAL({!myVariable_current.StageName},&quot;Production Lost&quot;), 
ISPICKVAL({!myVariable_current.StageName},&quot;Production Cancelled&quot;), 
ISPICKVAL({!myVariable_current.StageName},&quot;Lost&quot;), 
ISPICKVAL({!myVariable_current.StageName},&quot;Cancelled&quot;) 
) 
), 
AND( 
ISCHANGED({!myVariable_current.StageName}), 
OR( 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Design Win&quot;, 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Production Win&quot;, 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Production Lost&quot;, 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Production Cancelled&quot;, 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Lost&quot;, 
TEXT(PRIORVALUE({!myVariable_current.StageName}))=&quot;Cancelled&quot; 
), 
OR( 
ISPICKVAL({!myVariable_current.StageName},&quot;Qualify&quot;), 
ISPICKVAL({!myVariable_current.StageName},&quot;Define&quot;), 
ISPICKVAL({!myVariable_current.StageName},&quot;Develop&quot;), 
ISPICKVAL({!myVariable_current.StageName},&quot;Design&quot;) 
) 
) 
)</expression>
    </formulas>
