            <name>Core_Email_Notify</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Retry_Counter__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Send_Email</targetReference>
            </connector>
            <label>Email Notify</label>
        </rules>
    </decisions>
