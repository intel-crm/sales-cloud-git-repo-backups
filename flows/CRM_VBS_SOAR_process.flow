    <decisions>
        <name>Check_if_Qb_resource_is_present</name>
        <label>Check if Qb resource is present</label>
        <locationX>974</locationX>
        <locationY>1055</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>QB_Resource_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_QB_Resource__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_VBS_status_to_Qualified</targetReference>
            </connector>
            <label>QB Resource present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_VBS_Offering_changed</name>
        <label>Check if VBS Offering changed</label>
        <locationX>2294</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>check_QB_Resource</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>VBS_Offering_or_Decision_Is_Changed</name>
            <conditionLogic>(1 AND 2) OR 3 OR 4 OR 5 OR 6 OR 7 OR 8</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Primary_VBS_Offering_Category__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Primary_VBS_Offering_Category__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Contract_Start_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Contract_Lifetime_in_Months__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Total_Contract_Value__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Annual_Recurring_Revenue__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Other_Notes__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_VBS_Offering_is_not_Other_and_Other_Notes_is_not_blank</targetReference>
            </connector>
            <label>VBS Offering or Decision Is Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_is_New_record</name>
        <label>check is New record</label>
        <locationX>1656</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_new_record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>checkifISNEW</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_SOAR1_Stage</targetReference>
            </connector>
            <label>is new record</label>
        </rules>
        <rules>
            <name>for_Updated_records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>checkifISNEW</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_VBS_Offering_changed</targetReference>
            </connector>
            <label>for Updated records</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_Old_QB_present</name>
        <label>check Old QB present</label>
        <locationX>2096</locationX>
        <locationY>3443</locationY>
        <defaultConnector>
            <targetReference>Opp_Share_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_Old_QB_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.CRM_VBS_QB_Resource__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getOldQBOppshare</targetReference>
            </connector>
