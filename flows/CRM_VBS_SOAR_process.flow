    <decisions>
        <name>check_SOAR1_Decision</name>
        <label>check SOAR1 Decision</label>
        <locationX>1634</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>Update_Offering</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Decision_SOAR1_unqualified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR1 Un-qualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Oppo_as_Unqualified</targetReference>
            </connector>
            <label>Decision SOAR1 unqualified</label>
        </rules>
        <rules>
            <name>Decision_SOAR1_Qualified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR1 Qualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Opp_as_Qualified</targetReference>
            </connector>
            <label>Decision SOAR1 Qualified</label>
        </rules>
        <rules>
            <name>Decision_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR3 Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Opp_as_Approved</targetReference>
            </connector>
            <label>Decision Approved</label>
        </rules>
        <rules>
            <name>Decision_Denied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR3 Denied</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Opp_as_Denied</targetReference>
            </connector>
            <label>Decision Denied</label>
        </rules>
        <rules>
            <name>Decision_Contract_Not_Signed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR4 Contract Not Signed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_SOAR_Contract_Fields</targetReference>
            </connector>
            <label>Decision Contract Not Signed</label>
        </rules>
        <rules>
            <name>Decision_Contract_Signed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR4 Contract Signed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>SOAR3 Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Oppo_as_Contract_Signed</targetReference>
            </connector>
            <label>Decision Contract Signed</label>
        </rules>
        <rules>
            <name>Decision_Contract_Signed_from_SOAR3_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR4 Contract Signed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_SOAR_VBS_Decision__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Oppo_as_Contract_Signed_from_SOAR3_Approved</targetReference>
            </connector>
            <label>Decision Contract Signed from SOAR3 Approved</label>
        </rules>
    </decisions>
