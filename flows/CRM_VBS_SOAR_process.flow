[TWC3123-6131] - Added SOAR prefix in activities subject.
[TWC3123-6298] - Syncing &apos;Other Notes&apos; from SOAR to Oppty.</description>
    <environments>Default</environments>
    <formulas>
        <name>checkifISNEW</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>SOAR1Step1SLA</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CreatedDate}+ 14</expression>
    </formulas>
    <formulas>
        <name>SOAR1Step3SLA</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CreatedDate}+ 28</expression>
    </formulas>
    <formulas>
        <name>SOAR3SLA6week</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CreatedDate} + 42</expression>
    </formulas>
    <formulas>
        <name>SOAR_SLA_10Week</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CreatedDate} + 70</expression>
    </formulas>
    <formulas>
        <name>SOAR_SLA_8Week</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CreatedDate} + 56</expression>
    </formulas>
