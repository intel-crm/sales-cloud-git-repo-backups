    <decisions>
        <name>Switch_on_Owner</name>
        <label>Switch on Owner</label>
        <locationX>515</locationX>
        <locationY>437</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Check_If_Owner_isBlank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Goal_Owner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Update_DealOwner_to_CreatedByUser</targetReference>
            </connector>
            <label>Core_Check_If_Owner_isBlank</label>
        </rules>
        <rules>
            <name>Core_Goal_CheckIfOwnerNotBlank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Goal_Owner__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Goal_UpdateOwnertoCustomOwner_notBlank</targetReference>
            </connector>
            <label>Core_Goal_CheckIfOwnerNotBlank</label>
        </rules>
    </decisions>
    <description>for the process builder &quot; Update_the_Owner_to_CreatedBy_user_if_it_is_left_blank_Flow &quot;</description>
