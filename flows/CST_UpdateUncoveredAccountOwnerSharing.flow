    <decisions>
        <name>check_if_new_account_owner_is_active</name>
        <label>check if new account owner is active</label>
        <locationX>182</locationX>
        <locationY>1439</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CST_Account_Owner_Id__r.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_Owners_WWID</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
