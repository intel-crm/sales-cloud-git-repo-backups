                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_customer_categories</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>v2-added CST_Account_Owner_Id__c field in place of Account_Owner__c.
v3-added Account Detail Ids in Apex Action
v4-modified entry criteria
v5/v6-added customer category account owner append logic
v7-modified customer category account owner append logic</description>
    <environments>Default</environments>
    <formulas>
        <name>NewAccountOwnersCustomerCategory</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Loop_through_customer_categories.Account_Owners__c}), {!UserNameFormula}, 
{!Loop_through_customer_categories.Account_Owners__c} + &apos;,&apos; +{!UserNameFormula})</expression>
    </formulas>
    <formulas>
        <name>UserNameFormula</name>
        <dataType>String</dataType>
        <expression>{!$Record.CST_Account_Owner_Id__r.FirstName}+&apos; &apos;+{!$Record.CST_Account_Owner_Id__r.LastName}</expression>
    </formulas>
    <interviewLabel>CST_UpdateUncoveredAccountOwnerSharing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CST_UpdateUncoveredAccountOwnerSharing</label>
    <loops>
