        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Customer_categorys_of_Account_s_customer_and_category</leftValueReference>
                <operator>IsNull</operator>
