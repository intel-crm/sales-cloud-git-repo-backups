<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_OppProd_Save_Key_Values_Upon_Approval</name>
        <label>Core_OppProd_Save_Key_Values_Upon_Approval</label>
        <locationX>990</locationX>
        <locationY>479</locationY>
        <defaultConnector>
            <targetReference>Opportunity_Line_items_updates</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Opp_Prod_Key_Value_approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_all_the_key_fields</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Update Opp Prod Key Value approval</label>
        </rules>
    </decisions>
    <decisions>
        <name>Open_to_Lost_step_1</name>
        <label>Open to Lost step 1</label>
        <locationX>616</locationX>
        <locationY>359</locationY>
        <defaultConnector>
            <targetReference>Core_OppProd_Save_Key_Values_Upon_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Open_to_Lost_Step_1_is_true</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CoreOppProdOpentoLostStep1</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lost_Sales_Price_UnitPrice</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Open to Lost Step 1 is true</label>
        </rules>
        <rules>
            <name>If_Open_to_Lost_Step_1_is_false</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CoreOppProdOpentoLostStep1</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lost_Sales_Price_UnitPrice</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Open to Lost Step 1 is false</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opportunity_Line_items_updates</name>
        <label>Opportunity Line items updates</label>
        <locationX>990</locationX>
        <locationY>815</locationY>
        <defaultConnector>
            <targetReference>If_New_record_with_Pending_status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_OppProd_BU_Values_Upon_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Core_OppProd_BU_Values_Upon_Approval</label>
        </rules>
        <rules>
            <name>Core_OppProd_Open_to_Lost_Step_1</name>
            <conditionLogic>((1 OR 2) AND 3) OR ( 4 AND (5 OR 6) OR 7 OR 8 )</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_OppProd_Lost_Price_as_Sales_Price</targetReference>
            </connector>
            <label>Core_OppProd_Open_to_Lost_Step_1</label>
        </rules>
        <rules>
            <name>Core_OppProd_Open_to_Lost_Step_2</name>
            <conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Core_OppProd_Open_to_Lost_Step_2</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CoreOppProdOpentoLostStep1</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISNEW() = True, OR( ISPICKVAL(Core_Status__c, &quot;Lost&quot;), ISPICKVAL(Core_Status__c, &quot;Cancelled&quot;), ISPICKVAL(Core_Status__c, &quot;Deleted&quot;) ), AND( ISPICKVAL(PRIORVALUE (Core_Status__c), &quot;Lost&quot;) = False, ISPICKVAL(PRIORVALUE (Core_Status__c), &quot;Cancelled&quot;) = False, ISPICKVAL(PRIORVALUE (Core_Status__c), &quot;Deleted&quot;) = False, OR( ISPICKVAL(Core_Status__c, &quot;Lost&quot;), ISPICKVAL(Core_Status__c, &quot;Cancelled&quot;), ISPICKVAL(Core_Status__c, &quot;Deleted&quot;) )))</expression>
    </formulas>
    <formulas>
        <name>FormulaCoreOppProdOpentoLostStep2</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISNEW(), 
	Core_Lost_Sales_Price__c &lt;&gt; 0, 
		ISCHANGED(Core_Lost_Sales_Price__c) )</expression>
    </formulas>
    <formulas>
        <name>IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>NEW()</expression>
    </formulas>
    <interviewLabel>Opportunity Line Item Update -2 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Line Item Update -2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Core_OppProd_Lost_Price_as_Sales_Price</name>
        <label>Core_OppProd_Lost_Price_as_Sales_Price</label>
        <locationX>858</locationX>
        <locationY>935</locationY>
        <inputAssignments>
            <field>Core_Lost_Sales_Price__c</field>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>If_New_record_with_Pending_status</name>
        <label>If New record with Pending status</label>
        <locationX>1386</locationX>
        <locationY>935</locationY>
        <inputAssignments>
            <field>Core_Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_all_the_key_fields</name>
        <label>Update all the key fields</label>
        <locationX>858</locationX>
        <locationY>599</locationY>
        <inputAssignments>
            <field>Core_Approved_By__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Approved_By__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.Core_Approved_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Approved_Decision_Date__c</field>
            <value>
                <elementReference>$Record.Opportunity.CloseDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Lost_Sales_Price_UnitPrice</name>
        <label>Update Lost Sales Price = UnitPrice</label>
        <locationX>616</locationX>
        <locationY>1367</locationY>
        <inputAssignments>
            <field>Core_Lost_Sales_Price__c</field>
            <value>
                <elementReference>$Record.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>490</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Open_to_Lost_step_1</targetReference>
        </connector>
        <object>OpportunityLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>InvalidDraft</status>
</Flow>
