        <label>Filter External Accounts to Selected</label>
        <locationX>6954</locationX>
        <locationY>890</locationY>
        <assignNextValueToReference>currentItem_Filter_External_Accounts_to_Selected</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_External_Account_for_Account</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_External_Accounts_to_Selected.Id</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>ServiceExternalId</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Get_External_Contact_for_Account_Case_Creation</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Based_On_Product_Externa_Id</name>
        <label>Based On Product Externa Id</label>
        <locationX>3614</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Get_External_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If External Id Not There</defaultConnectorLabel>
        <rules>
            <name>If_External_Id_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>productExternalId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Environment_Question</targetReference>
            </connector>
            <label>If External Id Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Branch_Based_on_Num_Ext_Contacts</name>
        <label>Branch Based on Num Ext Contacts</label>
        <locationX>1370</locationX>
        <locationY>566</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Zero_Ext_Contacts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExternalContacts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_RecordType</targetReference>
            </connector>
            <label>Zero Ext Contacts</label>
        </rules>
        <rules>
            <name>One_Ext_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExternalContacts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_External_Contact</targetReference>
            </connector>
            <label>One Ext Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_EQ_Exist_for_this_Product</name>
        <label>Check If EQ Exist for this Product</label>
        <locationX>3614</locationX>
        <locationY>1058</locationY>
        <defaultConnector>
            <targetReference>Get_Environment_Answers</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Language_Not_English_AND_EQ_Not_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>StoreExternalIdOfQuestion</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>serviceContactLanguage</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>English</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Default_Value_to_English</targetReference>
            </connector>
            <label>If Language Not English AND EQ Not Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Count_No_Of_External_Account</name>
        <label>Count No Of External Account</label>
        <locationX>6670</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Multiple_External_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>More Than One</defaultConnectorLabel>
        <rules>
            <name>Zero_External_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExteranalAccounts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <label>Zero External Account</label>
        </rules>
        <rules>
            <name>Single_External_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExteranalAccounts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Service_Id</targetReference>
            </connector>
            <label>Single External Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Based_On_Current_Transaction_Of_LWC</name>
        <label>Decision Based On Current Transaction Of LWC</label>
        <locationX>4954</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Connected_Callback_With_AAQ</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CurrentScreenOfLWC</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ConnectedCallback</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CalloutFrom</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AAQ</stringValue>
