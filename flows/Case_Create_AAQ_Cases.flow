                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case_RecordType</targetReference>
            </connector>
            <label>Create Case</label>
        </rules>
        <rules>
            <name>Create_Environment_Detail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CurrentScreenOfLWC</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CreateEnvironmentDetail</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case_Detail</targetReference>
            </connector>
            <label>Create Environment Detail</label>
        </rules>
        <rules>
            <name>Connected_Callback_With_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CurrentScreenOfLWC</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ConnectedCallback</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CalloutFrom</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Label_Account</targetReference>
            </connector>
            <label>Connected Callback With Account</label>
        </rules>
        <rules>
            <name>Product_Selected_With_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CurrentScreenOfLWC</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ProductSelected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CalloutFrom</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Product_for_Account</targetReference>
            </connector>
