                <leftValueReference>CurrentScreenOfLWC</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ProductSelected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CalloutFrom</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ExternalId</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Based_On_Product_Externa_Id</targetReference>
            </connector>
            <label>Product Selected With External Id</label>
        </rules>
        <rules>
            <name>CreateCase</name>
