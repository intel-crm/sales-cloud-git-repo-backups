<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_MDF_Check_if_the_new_account_is_comarketing</name>
        <label>Check if the new account is comarketing</label>
        <locationX>697</locationX>
        <locationY>181</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Go_to_Group_Creation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Record_Type.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Create_Group_record</targetReference>
            </connector>
            <label>Go to Group Creation</label>
        </rules>
    </decisions>
    <formulas>
        <name>Co_Marketing_Record_Type_Name</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_Co_Marketing_Record_Type_Name}</expression>
    </formulas>
    <interviewLabel>Create Group and Stamp Group Id on Comarketing Accounts {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Group and Stamp Group Id on Comarketing Accounts</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Create_Group_record</name>
        <label>Create Group record</label>
        <locationX>943</locationX>
        <locationY>177</locationY>
        <assignRecordIdToReference>group_Id</assignRecordIdToReference>
        <connector>
            <targetReference>Core_MDF_Update_Group_ID_Account_Record</targetReference>
        </connector>
        <inputAssignments>
            <field>DeveloperName</field>
            <value>
                <stringValue>Core_MDF_{!accountId_Text}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
        <object>Group</object>
    </recordCreates>
    <recordLookups>
        <name>Core_MDF_get_Record_Type_For_Co_Marketing_Account</name>
        <label>get Record Type For Co Marketing Account</label>
        <locationX>508</locationX>
        <locationY>179</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Check_if_the_new_account_is_comarketing</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Co_Marketing_Record_Type_Name</elementReference>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account</stringValue>
            </value>
        </filters>
        <object>RecordType</object>
        <outputReference>Record_Type</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Core_MDF_Update_Group_ID_Account_Record</name>
        <label>Update Group Id On Account Record</label>
        <locationX>1147</locationX>
        <locationY>177</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Group_Id__c</field>
            <value>
                <elementReference>group_Id</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>112</locationY>
        <connector>
            <targetReference>Core_MDF_get_Record_Type_For_Co_Marketing_Account</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <textTemplates>
        <name>accountId_Text</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
