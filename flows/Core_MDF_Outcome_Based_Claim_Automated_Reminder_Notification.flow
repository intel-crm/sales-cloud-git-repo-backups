    <decisions>
        <name>Check_CreatedDate_Diffrence</name>
        <label>Check CreatedDate Diffrence</label>
        <locationX>838</locationX>
        <locationY>394</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CreatedDateEquals5</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DateDiffCheck</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendEmailtoClaimOwn</targetReference>
            </connector>
            <label>CreatedDateEquals5</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DateDiffCheck</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) &lt;&gt; TODAY(),
  AND(WEEKDAY(TODAY()) &gt;= 2, WEEKDAY(TODAY()) &lt;= 6),
  MOD(
    (
      (5 * FLOOR((TODAY() - DATE(1900, 1, 8)) / 7) + MIN(5, MOD(TODAY() - DATE(1900, 1, 8), 7))) -
      (5 * FLOOR((DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) - DATE(1900, 1, 8)) / 7) + MIN(5, MOD(DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) - DATE(1900, 1, 8), 7)))
    ),
    5
  ) = 0
)</expression>
    </formulas>
    <formulas>
        <name>DateDiffrrence</name>
        <dataType>Number</dataType>
        <expression>(5 * FLOOR((TODAY() - DATE(1900, 1, 8)) / 7) + MIN(5, MOD(TODAY() - DATE(1900, 1, 8), 7))) -
(5 * FLOOR((DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) - DATE(1900, 1, 8)) / 7) + MIN(5, MOD(DATEVALUE({!GetClaimHistoryRecords.CreatedDate}) - DATE(1900, 1, 8), 7)))</expression>
        <scale>0</scale>
    </formulas>
