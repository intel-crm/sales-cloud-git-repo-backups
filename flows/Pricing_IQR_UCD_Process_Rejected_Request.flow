    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>MyDeals_Failed_Requests</name>
        <label>MyDeals Failed Requests</label>
        <locationX>233</locationX>
        <locationY>1025</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>MyDeals_Failed_Requests_schedule</name>
            <conditionLogic>4 AND 1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Failed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_Retry_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_Retry_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_Message_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Tender</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Process_failed_Records</targetReference>
            </connector>
            <label>MyDeals Failed Requests schedule</label>
        </rules>
    </decisions>
    <decisions>
        <name>MyDeals_UCD_Outcome</name>
        <label>MyDeals UCD Outcome</label>
        <locationX>120</locationX>
        <locationY>494</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>MyDeals_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Message_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Tender</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Process_Outbound</targetReference>
            </connector>
            <label>MyDeals Outcome</label>
        </rules>
        <rules>
            <name>UCD_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Message_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UnifiedEndCustomer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_UCD_Response_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Survivor Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetSurvivorAccountIds</targetReference>
            </connector>
            <label>UCD Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>Process_Outbound</name>
        <label>Process Outbound</label>
        <locationX>122</locationX>
        <locationY>826</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_First_Payload</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricing_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_Retry_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricing_Retry_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Make_Callout_on_Pending</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Send First Payload</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Pricing IQR UCD Process Rejected Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pricing IQR UCD Process Rejected Request</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>MyDeals_UCD_Outcome</targetReference>
        </connector>
        <filterLogic>(1 AND (2 OR 3)) OR (4 AND 5 AND 6)</filterLogic>
        <filters>
            <field>Pricing_Message_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Tender</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Message_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>UnifiedEndCustomer</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_UCD_Response_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Survivor Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Pricing_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Successful</stringValue>
            </value>
        </filters>
        <object>Pricing_Integration_Staging__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Mydeals_Retry_failed</name>
            <connector>
                <targetReference>MyDeals_Failed_Requests</targetReference>
            </connector>
            <label>Mydeals Retry failed</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>Pricing_Retry_Time_Stamp__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
