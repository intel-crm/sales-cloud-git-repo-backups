    </variables>
    <variables>
        <name>ClaimBatchRecToBeUpdated</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Core_MDF_Claim_Batch_Stage__c</objectType>
    </variables>
    <variables>
        <name>ListOfClaimBatchRecordsId</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
