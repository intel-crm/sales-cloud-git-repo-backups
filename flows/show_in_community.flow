<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>50.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Adding_claim_batch_record</name>
        <label>Adding claim batch record</label>
        <locationX>810</locationX>
        <locationY>620</locationY>
        <assignmentItems>
            <assignToReference>ClaimBatchRecToBeUpdated</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_over_claim_batch_reords_to_get_its_id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_over_claim_batch_reords_to_get_its_id</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>update_status_to_submitted</name>
        <label>update status to submitted</label>
        <locationX>656</locationX>
        <locationY>627</locationY>
        <assignmentItems>
            <assignToReference>Loop_over_claim_batch_reords_to_get_its_id.Core_MDF_Processing_Status_Nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Adding_claim_batch_record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>check_claim_batch_record_is_not_null</name>
        <label>check claim batch record is not null</label>
        <locationX>639</locationX>
        <locationY>253</locationY>
        <defaultConnector>
            <targetReference>No_failed_records_for_retry_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If it is null</defaultConnectorLabel>
        <rules>
            <name>if_it_is_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_claim_batch_record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateClaimBatchRecord</targetReference>
            </connector>
            <label>if it is not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_for_failed_records</name>
        <label>check for failed records</label>
        <locationX>427</locationX>
        <locationY>454</locationY>
        <defaultConnector>
            <targetReference>No_failed_records_for_retry</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_there_are_any_failed_records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>claimBatchRecordList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_over_claim_batch_reords_to_get_its_id</targetReference>
            </connector>
            <label>if there are any failed records</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_record_ID</name>
        <label>check record ID</label>
        <locationX>166</locationX>
        <locationY>250</locationY>
        <defaultConnector>
            <targetReference>get_claim_batch_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>If it is claim batch  Record Id</defaultConnectorLabel>
        <rules>
            <name>If_it_is_claim_batch_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>a4O</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_claim_batch_records_from_claim_batch</targetReference>
            </connector>
            <label>If it is claim batch Id</label>
        </rules>
    </decisions>
    <interviewLabel>show in community {!$Flow.CurrentDateTime}</interviewLabel>
    <label>show in community</label>
    <loops>
        <name>Loop_over_claim_batch_reords_to_get_its_id</name>
        <label>Loop over claim batch reords to get its id</label>
        <locationX>657</locationX>
        <locationY>452</locationY>
        <collectionReference>claimBatchRecordList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>update_status_to_submitted</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_all_claim_Batch_records_of_claim_batch</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>get_claim_batch_record</name>
        <label>get claim batch record</label>
        <locationX>441</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>check_claim_batch_record_is_not_null</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Processing_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_Claim_Batch_Stage__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Processing_Status_Nm__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_claim_batch_records_from_claim_batch</name>
        <label>get claim batch records from claim batch</label>
        <locationX>178</locationX>
        <locationY>452</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>check_for_failed_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Batch_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Processing_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Claim_Batch_Stage__c</object>
        <outputReference>claimBatchRecordList</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Processing_Status_Nm__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_all_claim_Batch_records_of_claim_batch</name>
        <label>Update all claim Batch records of claim batch</label>
        <locationX>930</locationX>
        <locationY>456</locationY>
        <connector>
            <targetReference>Show_success_message_to_user</targetReference>
        </connector>
        <inputReference>ClaimBatchRecToBeUpdated</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateClaimBatchRecord</name>
        <label>Update claim batch record</label>
        <locationX>953</locationX>
        <locationY>252</locationY>
        <connector>
            <targetReference>Show_success_message_to_user</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_claim_batch_record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Processing_Status_Nm__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <object>Core_MDF_Claim_Batch_Stage__c</object>
    </recordUpdates>
    <screens>
        <name>No_failed_records_for_retry</name>
        <label>No failed records for retry</label>
        <locationX>430</locationX>
        <locationY>667</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NoFailedRecordMsg</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(62, 62, 60);&quot;&gt;{!$Label.Core_MDF_No_Failed_Claim_Batch_Records_Message}&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
