    <decisions>
        <description>for the Lead WF 

&apos;Core_Partner_Claim&apos;</description>
        <name>Core_Partner_Claim</name>
        <label>Core_Partner_Claim</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Core_Reject_PartnerLead_On_Terminated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Partner_ClaimTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>F_PartnerClaim</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FieldUpdateCore_Partner_Claim</targetReference>
            </connector>
            <label>Core_Partner_ClaimTRUE</label>
        </rules>
    </decisions>
    <decisions>
        <description>for the LEAD WF 

&apos; Core_Reject_PartnerLead_On_Terminated&apos;</description>
        <name>Core_Reject_PartnerLead_On_Terminated</name>
        <label>Core_Reject_PartnerLead_On_Terminated</label>
        <locationX>314</locationX>
        <locationY>731</locationY>
        <defaultConnector>
            <targetReference>Bypass_Validation_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Reject_PartnerLead_On_TerminatedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_State__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Terminated</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Lead_State__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FieldUpdateCore_Reject_PartnerLead_On_Terminated</targetReference>
            </connector>
            <label>Core_Reject_PartnerLead_On_TerminatedTRUE</label>
        </rules>
    </decisions>
    <decisions>
        <name>Partner_Lead_status_Qualified</name>
        <label>Partner Lead status Qualified</label>
        <locationX>314</locationX>
        <locationY>1139</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Qualified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead</targetReference>
            </connector>
            <label>Qualified</label>
        </rules>
    </decisions>
    <description>For the LEAD WFs 

1.Core_Partner_Claim
2.Core_Reject_PartnerLead_On_Terminated</description>
    <environments>Default</environments>
    <formulas>
        <description>the Entry Condition for the Lead WF 

&apos; Core_Partner_Claim &apos;</description>
        <name>F_PartnerClaim</name>
        <dataType>Boolean</dataType>
        <expression>AND(  {!$Record.RecordType.Name} = &apos;Partner Lead&apos;,  ISCHANGED({!$Record.Core_Partner_Lead_Owner__c}),  PRIORVALUE({!$Record.Core_Partner_Lead_Owner__c})=Null,  {!$Record.Core_Partner_Lead_Owner__c} &lt;&gt; Null, ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;New&quot;), NOT(ISPICKVAL({!$Record.Core_Lead_State__c} , &quot;Terminated&quot;)) )</expression>
    </formulas>
    <interviewLabel>Core_Partner_LEAD_One {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Partner_LEAD_One</label>
