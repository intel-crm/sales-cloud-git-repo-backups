    <screens>
        <name>Screen_Case_Creation_Failed</name>
        <label>Case Creation Failed</label>
        <locationX>842</locationX>
        <locationY>1514</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Display_Case_Creation_Failed</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;Error - case creation failed. Please try again.&lt;/span&gt;&lt;/p&gt;</fieldText>
