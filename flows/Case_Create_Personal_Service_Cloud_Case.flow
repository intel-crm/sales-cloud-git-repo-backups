        </inputAssignments>
        <inputAssignments>
            <field>Name__c</field>
            <value>
                <stringValue>{!$User.FirstName} {!$User.LastName}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId__c</field>
            <value>
                <stringValue>0120P0000001trhQAA</stringValue>
            </value>
        </inputAssignments>
        <object>Account_External__x</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
