<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Count_Ext_Contacts</name>
        <label>Count Ext Contacts</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>numExternalContacts</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Query_External_Contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Branch_Based_on_Num_Ext_Contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Case_Create_Acct_ID_values</name>
        <label>Set Case Create Acct ID values</label>
        <locationX>314</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>localExternalAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_External_Account_2.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>serviceAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_External_Account_2.ExternalId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>serviceContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_External_Contact.ExternalId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_External_Product</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Case_Create_Acct_ID_values_2</name>
        <label>Set Case Create Acct ID values</label>
        <locationX>50</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>localExternalAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_External_Account.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>serviceAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_External_Account.ExternalId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>serviceContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Copy_1_of_Get_External_Contact_again.ExternalId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_External_Product</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_New_Case_Values</name>
        <label>Set New Case Values</label>
        <locationX>314</locationX>
        <locationY>1298</locationY>
        <assignmentItems>
            <assignToReference>newCase.RecordTypeId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>caseRecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.AccountId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>serviceAccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>serviceContactId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Origin__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Subject__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>enteredSubject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Description__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>enteredDescription</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCase.Product__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_External_Product.ExternalId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Case</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>Sales_CRM_Salesforce</name>
        <choiceText>Sales CRM (Salesforce)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Sales CRM (Salesforce)</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Branch_Based_on_Num_Ext_Contacts</name>
        <label>Branch Based on Num Ext Contacts</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Screen_Multiple_Contacts_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Multiple Ext Contacts</defaultConnectorLabel>
        <rules>
            <name>Zero_Ext_Contacts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExternalContacts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_External_Account_Record</targetReference>
            </connector>
            <label>Zero Ext Contacts</label>
        </rules>
        <rules>
            <name>One_Ext_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExternalContacts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_External_Contact</targetReference>
            </connector>
            <label>One Ext Contact</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>ProductChoiceSet</name>
        <dataType>String</dataType>
        <displayField>Name__c</displayField>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Name__c</field>
            <operator>Contains</operator>
            <value>
                <elementReference>SelectedOption</elementReference>
            </value>
        </filters>
        <object>Product2__x</object>
        <sortField>Name__c</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>ExternalId</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>redirectUrlCase</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;--c.visualforce.com&quot;, {!$Api.Partner_Server_URL_540}) - 1) &amp; &quot;lightning/r/Case__x/&quot; &amp; {!newCase.Id} &amp; &quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>updatedDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Case created from SALES CLOUD by &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot; (&quot; &amp; {!$User.Email} &amp; &quot;, WWID: &quot; &amp; {!$User.Core_WWID__c} &amp; &quot;)&quot; &amp; BR() &amp; BR() &amp; &quot;Entered Description:&quot; &amp; BR() &amp; {!updatedDescription}</expression>
    </formulas>
    <interviewLabel>Case - Create Personal Service Cloud Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - Create Personal Service Cloud Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
