    </loops>
    <loops>
        <name>Loop_Get_Contacts</name>
        <label>Loop Get Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetContacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Contact_Ids</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Contact_role_records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Opportunity_from_Team_members</name>
        <label>Loop Opportunity from Team members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>OpptyIds2</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Oppty_as_both_contact_role_and_team_member</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_Contact_role_Opportunities</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Oppty_team_member_collection</name>
        <label>Loop Oppty team member collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetOpportunityTeam</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Opportunity_IDs</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_Contact_role_Opportunities</targetReference>
        </noMoreValuesConnector>
    </loops>
