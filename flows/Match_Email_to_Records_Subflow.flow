    <decisions>
        <name>CC_Address_Null_Check</name>
        <label>CC Address Null Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SplitString_CCAddress</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Null_CC_Email_Address</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Sub_ccAdressList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Sub_ccAdressList</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SplitString_FromEmails</targetReference>
            </connector>
            <label>Null CC Email Address</label>
        </rules>
    </decisions>
    <decisions>
        <name>Oppty_as_both_contact_role_and_team_member</name>
        <label>Oppty as both contact role and team member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Opportunity_from_Team_members</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Oppty_Equals</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Opportunity_from_Team_members</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Contact_role_Opportunities</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Final_Opportunity</targetReference>
            </connector>
            <label>Oppty Equals for both</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_Details_verification</name>
        <label>User Details verification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Get_Opty_Team_based_on_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_User_based_on_Email_address</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Each_User</targetReference>
            </connector>
            <label>Get Opty Team based on User</label>
        </rules>
    </decisions>
    <description>Match Email to Records Subflow</description>
    <environments>Default</environments>
    <interviewLabel>Match Email to Records Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Match Email to Records Subflow</label>
    <loops>
        <name>Get_Each_User</name>
        <label>Get Each User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_User_based_on_Email_address</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_User_Ids</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Opportunity_Team_Member_based_on_Email_address</targetReference>
        </noMoreValuesConnector>
