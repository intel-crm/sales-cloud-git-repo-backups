    <decisions>
        <name>Check_Record_Validation</name>
        <label>Check Record Validation</label>
        <locationX>633</locationX>
        <locationY>7169</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_Valid_for_Approval</name>
            <conditionLogic>1  OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PSG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IQR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Entitlement_Details__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Assign_Values_to_Registration_record</targetReference>
            </connector>
            <label>Record Valid for Approval</label>
        </rules>
        <rules>
            <name>IQR_Assign_Entitlement_Detail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IQR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Entitlement_Details__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Account_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_IQR_Matrix_Record_by_Account</targetReference>
            </connector>
            <label>IQR Assign Entitlement Detail</label>
        </rules>
    </decisions>
