        <name>Verify_Contact_Salesforce_ID_is_Empty_and_Same</name>
        <label>Verify Contact Salesforce ID is Empty and Same</label>
        <locationX>319</locationX>
        <locationY>4643</locationY>
        <defaultConnector>
            <targetReference>Assigning_IsDuplicate_to_True</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Empty_and_Same</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Contact_Salesforce_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Contact_Salesforce_Id__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Duplicate_Registration_Record.PRM_Contact_Salesforce_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_IsDuplicate_to_True</targetReference>
            </connector>
            <label>Not Empty and Same</label>
        </rules>
        <rules>
            <name>Not_Empty_and_Not_Same</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Contact_Salesforce_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Contact_Salesforce_Id__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Duplicate_Registration_Record.PRM_Contact_Salesforce_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Verify_IsDuplicate</targetReference>
            </connector>
            <label>Not Empty and Not Same</label>
        </rules>
    </decisions>
