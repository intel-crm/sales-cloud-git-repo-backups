    <description>This flow covers the logic for Auto approval, Reject Duplicates, Legal Agreements check, Profile Response check, Set Language and Assign Matching Contact.</description>
    <environments>Default</environments>
    <formulas>
        <name>last1Day</name>
        <dataType>Date</dataType>
        <expression>TODAY() -1</expression>
    </formulas>
    <formulas>
        <name>one_Response</name>
        <dataType>String</dataType>
        <expression>TRIM(                                                                                                         
SUBSTITUTE(
LEFT({!profile_Response} , FIND(&quot;}&quot;,  {!profile_Response})),
&quot;}&quot;,                                                                                          
&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>questioncodeF</name>
        <dataType>String</dataType>
        <expression>TRIM(SUBSTITUTE(REVERSE(LEFT(REVERSE(LEFT({!singleResponse}, FIND(&quot; | &quot;,{!singleResponse}))),FIND(&quot;:&quot;, REVERSE(LEFT({!singleResponse}, FIND(&quot; | &quot;,{!singleResponse})))))),&quot;:&quot;,&quot; &quot;))</expression>
    </formulas>
    <formulas>
        <name>responseValueF</name>
        <dataType>String</dataType>
        <expression>TRIM(SUBSTITUTE(REVERSE(LEFT(REVERSE({!singleResponse}),FIND(&quot;:&quot;, REVERSE({!singleResponse})))),&quot;:&quot;,&quot; &quot;))</expression>
    </formulas>
    <formulas>
        <name>singleLA</name>
        <dataType>String</dataType>
        <expression>TRIM(                                                                                                         
SUBSTITUTE(
LEFT( {!RegistrationRequest_LAs} , FIND(&quot;;&quot;,  {!RegistrationRequest_LAs} )),
&quot;;&quot;,                                                                                          
&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>Updated_RegistrationRequest_LAs</name>
        <dataType>String</dataType>
        <expression>MID({!RegistrationRequest_LAs},FIND(&quot;;&quot;,
{!RegistrationRequest_LAs})+1,LEN({!RegistrationRequest_LAs})-
LEN(LEFT({!RegistrationRequest_LAs}, FIND(&quot;;&quot;,{!RegistrationRequest_LAs})))+1)</expression>
    </formulas>
    <formulas>
        <name>UpdatedProfileresponse</name>
        <dataType>String</dataType>
        <expression>MID({!profile_Response},FIND(&quot;}&quot;,
{!profile_Response})+1,LEN({!profile_Response})-
LEN(LEFT({!profile_Response}, FIND(&quot;}&quot;,{!profile_Response})))+1)</expression>
    </formulas>
    <interviewLabel>EBR Framework Reg Request Before Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EBR Framework Reg Request Before Flow</label>
    <loops>
        <name>Loop_through_trigger_metadata_records</name>
