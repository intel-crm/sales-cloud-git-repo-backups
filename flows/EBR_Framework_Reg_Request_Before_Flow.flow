        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_metadata_labels_to_List</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Verify_ER_SetEVAndLanguage_Trigger_Label</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
