OR(
{!$Record.Core_Having_Tasks__c}=false,
AND(
ISCHANGED({!$Record.Status} ),
ISPICKVAL({!$Record__Prior.Status}, &quot;Tele Qualified Lead&quot;))
),
{!$Record.Core_Having_Tasks__c}=false,
{!$Record.Core_Created_Post_NewLead_Process__c}=True,
{!$Record.Core_SLA_Listed_User__c} =True,
ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;Accepted&quot;),
NOT (ISPICKVAL({!$Record.Core_Lead_Status__c}, &quot;Converted&quot;)),
NOT (ISPICKVAL({!$Record.Status}, &quot;Sales Qualified Lead&quot;))
)</expression>
    </formulas>
