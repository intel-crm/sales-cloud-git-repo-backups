    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>One Business Day SAL SLA</description>
        <name>One_Business_Day_SAL_SLA_Check</name>
        <label>One Business Day SAL SLA Check</label>
        <locationX>610</locationX>
        <locationY>383</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>One_Business_Day_SAL_Check_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SAL_Email_Trigger_date_update</targetReference>
            </connector>
            <label>One Business Day SAL Check Outcome</label>
        </rules>
        <rules>
            <name>One_Business_weekend_SAL_Check_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SAL_Weekend_Email_Trigger_date_update</targetReference>
            </connector>
            <label>One Business  weekend  SAL Check Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Four Buisness Day weekend record TAL SLA</description>
        <name>FormulaFourBuisnessDayweekendrecordTALSLA</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.RecordType.DeveloperName} &lt;&gt; &quot;Partner_Lead&quot;,
{!$Record.Days__c} =false,
ISPICKVAL({!$Record.Core_Lead_Priority__c}, &apos;Cold&apos;),
OR(ISPICKVAL({!$Record.Status}, &apos;Tele Accepted Lead&apos;),
AND(
ISCHANGED({!$Record.Status} ), 
ISPICKVAL({!$Record__Prior.Status}, &quot;Marketing Qualified Lead&quot;), 
ISPICKVAL({!$Record.Status}, &quot;Tele Accepted Lead&quot;))),
{!$Record.Core_Having_Tasks__c}=false,
{!$Record.Core_SLA_Listed_User__c}  =True,
{!$Record.Core_Created_Post_NewLead_Process__c}=True,
NOT( ISPICKVAL({!$Record.Core_Lead_Status__c} , &apos;Qualified &apos;)),
OR(
ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;New&quot;),
ISPICKVAL({!$Record.Core_Lead_Status__c} , &quot;Accepted&quot;)
)
)</expression>
    </formulas>
    <formulas>
        <description>Four Business Day MQL SLA</description>
