<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_To_Temp_Budget_And_Claim_Count_To_0</name>
        <label>Assign To Temp Budget And Claim Count To 0</label>
        <locationX>869</locationX>
        <locationY>583</locationY>
        <assignmentItems>
            <assignToReference>varTempExistingBudget</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varExistingBudget</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varClaimTotalAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTempCorpAllocation</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCorpAllocation</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Budget_Released</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Create_Budget_Offset_Collection</name>
        <label>Create Budget Offset Collection</label>
        <locationX>1066</locationX>
        <locationY>57</locationY>
        <assignmentItems>
            <assignToReference>varBudgetOffsetRecord.Core_MDF_Adjustment_Claim_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAdjClaim.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBudgetOffsetRecord.Core_MDF_Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAdjClaim.Amount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBudgetOffsetRecord.Core_MDF_Budget_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAdjClaim.BudgetId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Budget_Offset_Collection_0</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Create_Budget_Offset_Collection_0</name>
        <label>Create Budget Offset Collection</label>
        <locationX>866</locationX>
        <locationY>57</locationY>
        <assignmentItems>
            <assignToReference>varBudgetOffsetCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varBudgetOffsetRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Adjustment_Claims</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Create_Claim_Total_Amount</name>
        <label>Create  Claim Total Amount</label>
        <locationX>1164</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>varClaimTotalAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varClaimTotalAmountFormula</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Claim_Amount_Is_Less_Than_Available_Allocation_Amount</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Budget_Already_Queried</name>
        <label>Is Budget Already Queried</label>
        <locationX>680</locationX>
        <locationY>405</locationY>
        <defaultConnector>
            <targetReference>Fetch_Budget</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAdjClaim.BudgetId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varTempExistingBudget.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Budget_Released</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if budget is released or not</description>
        <name>Is_Budget_Released</name>
        <label>Is Budget Released?</label>
        <locationX>996</locationX>
        <locationY>410</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Adjustment_Claims</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTempExistingBudget.Core_MDF_Budget_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Released</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Claim_Total_Amount</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check Claim Amount Is Less Than Available Allocation Amount</description>
        <name>Is_Claim_Amount_Is_Less_Than_Available_Allocation_Amount</name>
        <label>Is Claim Amount Is Less Than Available Allocation Amount</label>
        <locationX>1065</locationX>
        <locationY>210</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Adjustment_Claims</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimTotalAmount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>varTempCorpAllocation.Core_MDF_Available_Allocation_Amount__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Budget_Offset_Collection</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>varClaimTotalAmountFormula</name>
        <dataType>Currency</dataType>
        <expression>({!varAdjClaim.Amount} ) * (-1)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core_MDF_LongLivingAdjustment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_LongLivingAdjustment</label>
    <loops>
        <description>Loop Through Adjustment Claims</description>
        <name>Loop_Through_Adjustment_Claims</name>
        <label>Loop Through Adjustment Claims</label>
        <locationX>721</locationX>
        <locationY>186</locationY>
        <assignNextValueToReference>varAdjClaim</assignNextValueToReference>
        <collectionReference>varExistingAdjClaims</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Budget_Already_Queried</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Budget_Offset</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Budget_Offset</name>
        <label>Create Budget Offset</label>
        <locationX>594</locationX>
        <locationY>50</locationY>
        <inputReference>varBudgetOffsetCollection</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Fetch Adjustment Claims whose date difference &gt; 120</description>
        <name>Fetch_Adjustment_Claims</name>
        <label>Fetch Adjustment Claims</label>
        <locationX>390</locationX>
        <locationY>338</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Adjustment_Claims</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Claim_Date_Difference_Nbr__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Available Fund</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_Txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Adjustment</stringValue>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <outputReference>varExistingAdjClaims</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>BudgetId</queriedFields>
        <queriedFields>Amount</queriedFields>
        <sortField>BudgetId</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <recordLookups>
        <description>Fetch Allocation Record</description>
        <name>Fetch_Allocation</name>
        <label>Fetch Allocation</label>
        <locationX>706</locationX>
        <locationY>581</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_To_Temp_Budget_And_Claim_Count_To_0</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BudgetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varExistingBudget.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>ChannelPartnerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varExistingBudget.Core_MDF_Budget_Partner__c</elementReference>
            </value>
        </filters>
        <object>PartnerFundAllocation</object>
        <outputReference>varCorpAllocation</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Available_Allocation_Amount__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Fetch_Budget</name>
        <label>Fetch Budget</label>
        <locationX>548</locationX>
        <locationY>543</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Fetch_Allocation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAdjClaim.BudgetId</elementReference>
            </value>
        </filters>
        <object>PartnerMarketingBudget</object>
        <outputReference>varExistingBudget</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_Budget_Partner__c</queriedFields>
        <queriedFields>Core_MDF_Budget_Status__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>273</locationY>
        <connector>
            <targetReference>Fetch_Adjustment_Claims</targetReference>
        </connector>
    </start>
