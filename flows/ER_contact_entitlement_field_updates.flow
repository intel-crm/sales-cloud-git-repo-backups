    <decisions>
        <name>verify_ACM_record_already_exists</name>
        <label>verify ACM record already exists</label>
        <locationX>974</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>Assign_ACMrecord_to_list</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_ACM_record_matching</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContactACMrecordlist</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Get_Existing_ACM_Integration_Message_Queue_Records.Custom_Filter__c</elementReference>
                </rightValue>
            </conditions>
            <label>New ACM record matching</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Entitlement_type</name>
        <label>Verify Entitlement type</label>
        <locationX>1205</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Business_type_Code</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Entitlement_Id__r.Business_Types_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Web Order Management</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Entitlement_Id__r.Business_Types_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Electronic Services Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Entitlement_Id__r.Business_Types_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EPS Verified Company</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_ACM_Integration_Message_Queue_Records</targetReference>
            </connector>
            <label>Business type Code</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Existing_ACM_Queue_Records</name>
        <label>Verify Existing ACM Queue Records</label>
        <locationX>512</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>verify_ACM_record_already_exists</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_with_Success_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_ACM_Integration_Message_Queue_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Existing_ACM_Integration_Message_Queue_Records.Message_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Success</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Existing_Record_to_New</targetReference>
            </connector>
            <label>Record with Success Status</label>
        </rules>
        <rules>
            <name>Record_with_New_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_ACM_Integration_Message_Queue_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Existing_ACM_Integration_Message_Queue_Records.Message_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <label>Record with New Status</label>
        </rules>
    </decisions>
    <decisions>
        <name>VerifyInsertUpdateConditions</name>
        <label>VerifyInsertUpdateConditions</label>
        <locationX>1683</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>InsertUpdateComditions</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Selected__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Verify_Entitlement_type</targetReference>
            </connector>
            <label>InsertUpdateComditions</label>
        </rules>
    </decisions>
