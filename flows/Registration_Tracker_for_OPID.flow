<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Registration_Records</name>
        <label>Has Registration Records ?</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>No Registration Records</defaultConnectorLabel>
        <rules>
            <name>Registration_Records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Registration_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Registration_Tracker_Record</targetReference>
            </connector>
            <label>Registration Records</label>
        </rules>
    </decisions>
    <decisions>
        <name>Registration_Tracker</name>
        <label>Registration Tracker</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Tracker records exist</defaultConnectorLabel>
        <rules>
            <name>Tracker_records_does_not_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_OPID_Tracker_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Registration_Record</targetReference>
            </connector>
            <label>Tracker records does not exist</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Registration Tracker {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Registration Tracker for OPID</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Registration_Tracker_Record</name>
        <label>Create Registration Tracker Record</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <faultConnector>
            <targetReference>Log_Entry</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>PRM_Active__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Email__c</field>
            <value>
                <elementReference>Get_Registration_Record.PRM_Email_ID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Registration_Type__c</field>
            <value>
                <elementReference>Get_Registration_Record.PRM_Registration_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Registration__c</field>
            <value>
                <elementReference>Get_Registration_Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Step_Number__c</field>
            <value>
                <numberValue>15.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Stage__c</field>
            <value>
                <stringValue>54</stringValue>
            </value>
        </inputAssignments>
        <object>PRM_Registration_Tracker__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Log_Entry</name>
        <label>Log_Entry</label>
        <locationX>314</locationX>
        <locationY>863</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>Registration Tracker for OPID</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <stringValue>Registration Tracker for OPID</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$System.OriginDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>we are trying to check if the reg. tracker record with stage opid assigned is already existing</description>
        <name>Get_OPID_Tracker_Records</name>
        <label>Get OPID Tracker Records</label>
        <locationX>578</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Registration_Tracker</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PRM_Location_Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Stage__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>OPID Assigned</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_Registration_Tracker__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>We are getting latest approved registration request.</description>
        <name>Get_Registration_Record</name>
        <label>Get Registration Record</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Registration_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Salesforce_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PRM_Location_Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_Registration_Request__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>452</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_OPID_Tracker_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>OPID Updates</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Milestone__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>OPID_ASSOCIATED</stringValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Completed__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PRM_Tracker__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>logEntry</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>Tracker_created_failed</stringValue>
        </value>
    </variables>
    <variables>
        <name>Tracker_not_created</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
