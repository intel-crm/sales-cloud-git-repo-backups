<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Extracted_Picklist_Values_to_a_List</name>
        <label>Add Extracted Picklist Values to a List</label>
        <locationX>1194</locationX>
        <locationY>1127</locationY>
        <assignmentItems>
            <assignToReference>ExtractedCountryPicklistValues</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Remove_Semicolon_One_Picklist_Value</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Extract_Picklist_Values</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>APJ_Region_Assignment</name>
        <label>APJ Region Assignment</label>
        <locationX>578</locationX>
        <locationY>803</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Region_Name_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>APJ</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>ASMO_Region_Assignment</name>
        <label>ASMO Region Assignment</label>
        <locationX>314</locationX>
        <locationY>803</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Region_Name_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>ASMO</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Country_Field_to_a_Variable</name>
        <label>Assign Country Field to a Variable</label>
        <locationX>1062</locationX>
        <locationY>803</locationY>
        <assignmentItems>
            <assignToReference>Country_MultiSelect_Picklist_Values</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Country_Name_nm__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Format_Multiselect_Picklist_Values</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Geo</name>
        <label>Assign Geo</label>
        <locationX>1018</locationX>
        <locationY>1343</locationY>
        <assignmentItems>
            <assignToReference>MultiRegion</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>RegionList</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_on_Country_Geo_Mapping_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Update the Spending Targets Record Name field with Spending Target&apos;s Name and Spending Targets Version Record Name field with Spending Targets Version&apos;s Name</description>
        <name>Backend_Field_Assignment</name>
        <label>Backend Field Assignment</label>
        <locationX>875</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Spending_Version_Record_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Spending_Targets_Version__r.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Spending_Targets_Record_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Spending_Targets_Version__r.Core_MDF_Spending_Targets__r.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Record_Type</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>EMEA_Region_Assignment</name>
        <label>EMEA Region Assignment</label>
        <locationX>50</locationX>
        <locationY>803</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Region_Name_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>EMEA</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Extract_Picklist_Values</name>
        <label>Extract Picklist Values</label>
        <locationX>1194</locationX>
        <locationY>1235</locationY>
        <assignmentItems>
            <assignToReference>Formatted_Picklist_Values</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Remove_One_Picklist_Value</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Check_all_Values_are_Parsed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Format_Multiselect_Picklist_Values</name>
        <label>Format Multiselect Picklist Values</label>
        <locationX>1062</locationX>
        <locationY>911</locationY>
        <assignmentItems>
            <assignToReference>Formatted_Picklist_Values</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Picklist_Value_Add_Semicolon</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_all_Values_are_Parsed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Specific_Country_Assignment</name>
        <label>Specific Country Assignment</label>
        <locationX>930</locationX>
        <locationY>1535</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Region_Name_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>MultiRegion</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_all_Values_are_Parsed</name>
        <label>Check all Values are Parsed</label>
        <locationX>1062</locationX>
        <locationY>1019</locationY>
        <defaultConnector>
            <targetReference>Add_Extracted_Picklist_Values_to_a_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non Parsed</defaultConnectorLabel>
        <rules>
            <name>Parsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Formatted_Picklist_Values</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Country_Geo_Mapping_records</targetReference>
            </connector>
            <label>Parsed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_Backend_Fields</name>
        <label>Check for Backend Fields</label>
        <locationX>1007</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Check_Record_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Fields_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Spending_Targets_Record_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Spending_Version_Record_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Backend_Field_Assignment</targetReference>
            </connector>
            <label>If Fields Empty</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Record_Type</name>
        <label>Check Record Type</label>
        <locationX>1007</locationX>
        <locationY>587</locationY>
        <defaultConnectorLabel>IPA Record Type</defaultConnectorLabel>
        <rules>
            <name>Non_IPA_Record_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_IPA_RecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Country_Name_nm__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Country_Check</targetReference>
            </connector>
            <label>Non IPA Record Type</label>
        </rules>
    </decisions>
    <decisions>
        <name>Country_Check</name>
        <label>Country Check</label>
        <locationX>556</locationX>
        <locationY>695</locationY>
        <defaultConnector>
            <targetReference>Assign_Country_Field_to_a_Variable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Country Selected</defaultConnectorLabel>
        <rules>
            <name>All_Other_EMEA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Country_Name_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>All Other EMEA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EMEA_Region_Assignment</targetReference>
            </connector>
            <label>All Other EMEA</label>
        </rules>
        <rules>
            <name>All_Other_ASMO</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Country_Name_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>All Other ASMO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ASMO_Region_Assignment</targetReference>
            </connector>
            <label>All Other ASMO</label>
        </rules>
        <rules>
            <name>All_Other_APJ</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Country_Name_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>All Other APJ</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>APJ_Region_Assignment</targetReference>
            </connector>
            <label>All Other APJ</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Picklist_Value_Add_Semicolon</name>
        <dataType>String</dataType>
        <expression>{!Country_MultiSelect_Picklist_Values} + &quot;;&quot;</expression>
    </formulas>
    <formulas>
        <name>RegionList</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!MultiRegion}), {!Loop_on_Country_Geo_Mapping_Records.Core_MDF_Geo__c},
IF(CONTAINS({!MultiRegion}, {!Loop_on_Country_Geo_Mapping_Records.Core_MDF_Geo__c}),{!MultiRegion}, ({!MultiRegion} &amp; &apos;;&apos; &amp;{!Loop_on_Country_Geo_Mapping_Records.Core_MDF_Geo__c}))
)</expression>
    </formulas>
    <formulas>
        <name>Remove_One_Picklist_Value</name>
        <dataType>String</dataType>
        <expression>TRIM(
     SUBSTITUTE({!Formatted_Picklist_Values}, {!Remove_Semicolon_One_Picklist_Value}+&quot;;&quot;, &quot;&quot;)
 )</expression>
    </formulas>
    <formulas>
        <name>Remove_Semicolon_One_Picklist_Value</name>
        <dataType>String</dataType>
        <expression>TRIM( 
     LEFT(
              {!Formatted_Picklist_Values} , 
              FIND(
                     &quot;;&quot;,{!Formatted_Picklist_Values}
             ) - 1
       ) 
 )</expression>
    </formulas>
    <interviewLabel>Core_MDF_TargetSettingLineItem_Record_Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_TargetSettingLineItem_Record_Update_Flow</label>
    <loops>
        <name>Loop_on_Country_Geo_Mapping_Records</name>
        <label>Loop on Country Geo Mapping Records</label>
        <locationX>930</locationX>
        <locationY>1235</locationY>
        <collectionReference>Country_Geo_Mapping_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Geo</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Specific_Country_Assignment</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Country_Geo_Mapping_records</name>
        <label>Get Country Geo Mapping records</label>
        <locationX>930</locationX>
        <locationY>1127</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_on_Country_Geo_Mapping_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>MasterLabel</field>
            <operator>In</operator>
            <value>
                <elementReference>ExtractedCountryPicklistValues</elementReference>
            </value>
        </filters>
        <object>Core_MDF_CCP_Country_Geo_Mapping__mdt</object>
        <outputReference>Country_Geo_Mapping_Records</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>MasterLabel</queriedFields>
        <queriedFields>Core_MDF_Geo__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>881</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_Backend_Fields</targetReference>
        </connector>
        <object>Core_MDF_Target_Setting_Line_Item__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Country_Geo_Mapping_Records</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_CCP_Country_Geo_Mapping__mdt</objectType>
    </variables>
    <variables>
        <name>Country_MultiSelect_Picklist_Values</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>ExtractedCountryPicklistValues</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Formatted_Picklist_Values</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>MultiRegion</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
