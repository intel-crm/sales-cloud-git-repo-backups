    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>check_account_reject_status</name>
        <label>check account reject status</label>
        <locationX>281</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>check_account_request_is_null</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>rejected_status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>error_for_rejected_status</targetReference>
            </connector>
            <label>rejected status</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_account_request_is_null</name>
        <label>check account request  is null</label>
        <locationX>512</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Rejection_Reason_Input_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>request_flow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Requested_Account__r.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Process</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>status_check</targetReference>
            </connector>
            <label>request flow</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Request_Status</name>
        <label>Check Request Status</label>
        <locationX>710</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Error_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Request_Status_Value</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Approval</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Request.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reuse</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Values</targetReference>
            </connector>
            <label>Request Status Value</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>AccountLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_260})) &amp; {!recordId}</expression>
    </formulas>
    <formulas>
        <name>PlatformHeader</name>
        <dataType>String</dataType>
        <expression>
&apos;{&apos;+
&apos;CustomerProcessEngagement:&apos;+TEXT({!Get_Account_Request.Customer_Process_Engagement__c}) +&apos;,&apos; +
&apos;CustomerAggregationType:&apos; +TEXT({!Get_Account_Request.Customer_Aggregation_Type__c})+
&apos;}&apos;</expression>
    </formulas>
    <formulas>
        <name>UpdateACMRecord</name>
        <dataType>String</dataType>
        <expression>
&apos;{&apos;+
&apos;status:&apos;+TEXT({!Get_Account_Request.Status__c}) +&apos;,&apos; +
&apos;AQId:&apos; +{!Get_Account_Request.Id} +
&apos;}&apos;</expression>
    </formulas>
    <interviewLabel>Requested Rejected Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Requested Rejected Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Records_1</name>
        <label>Create Records 1</label>
        <locationX>578</locationX>
        <locationY>782</locationY>
        <connector>
            <targetReference>Show_Rejected_Message</targetReference>
        </connector>
        <inputAssignments>
            <field>Headers__c</field>
