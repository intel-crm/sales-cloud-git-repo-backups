    <decisions>
        <name>Check_if_OLI_exists_in_SOAR_Products</name>
        <label>Check if OLI exists in SOAR Products</label>
        <locationX>1298</locationX>
        <locationY>924</locationY>
        <defaultConnector>
            <targetReference>Loop_through_SOAR_Products</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_through_SOAR_Products.CRM_VBS_Opportunity_Product__r.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_through_OLI.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Boolean_variable</targetReference>
            </connector>
            <label>If exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Opp_is_Lost</name>
        <label>Check if Opp is Lost</label>
        <locationX>770</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Opp_is_Lost</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Potential__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR1 Qualified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Products</targetReference>
            </connector>
            <label>Opp is Lost</label>
        </rules>
    </decisions>
    <decisions>
        <name>Create_SOAR_Product_if_record_does_not_exist</name>
        <label>Create SOAR Product if record does not exist</label>
        <locationX>1078</locationX>
        <locationY>1308</locationY>
        <defaultConnector>
