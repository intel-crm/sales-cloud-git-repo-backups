        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Boolean_variable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>If_exists</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_SOAR_Product</targetReference>
            </connector>
            <label>Check Boolean variable</label>
        </rules>
    </decisions>
    <description>Create SOAR Products when Opportunity is Lost</description>
    <environments>Default</environments>
    <interviewLabel>SOAR Product Creation when Opp Lost {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SOAR Product Creation when Opp Lost</label>
