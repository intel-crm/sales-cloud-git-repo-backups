    <assignments>
        <name>Core_MDF_Add_vAccountShareTemp_to_sCollAccountShareToBeInserted</name>
        <label>Add vAccountShareTemp to sCollAccountShareToBeInserted</label>
        <locationX>739</locationX>
        <locationY>392</locationY>
        <assignmentItems>
            <assignToReference>sCollAccountShareToBeInserted</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>sAccountShareTemp</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Core_MDF_Add_it_to_AccountShare_Record_0</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Core_MDF_Check_if_sCollAccountShareToBeInserted_has_values</name>
        <label>Check if sCollAccountShareToBeInserted has values</label>
        <locationX>89</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_sCollAccountShareToBeInserted_is_NOT_EMPTY</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollAccountShareToBeInserted</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Insert_sCollAccountShareToBeInserted</targetReference>
            </connector>
            <label>sCollAccountShareToBeInserted is NOT EMPTY</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_sCollPGMList_is_NOT_NULL</name>
        <label>Check if sCollPGMList is NOT NULL</label>
        <locationX>514</locationX>
        <locationY>164</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_sCollPGMList_is_NOT_NULL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sCollPGMList</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Loop_through_sCollPGMList</targetReference>
            </connector>
            <label>sCollPGMList is NOT NULL</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_the_Record_Type_of_the_Parent_Fund_Account_is_Co_Marketing</name>
        <label>Check if the Record Type of the Parent Fund Account is Co-Marketing</label>
        <locationX>94</locationX>
        <locationY>46</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_if_RT_is_Co_Marketing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vCoMarketingRecordTypeBln</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vCoMarketingUltimateAccount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_the_PGM_records</targetReference>
            </connector>
            <label>if RT is Co-Marketing</label>
        </rules>
        <rules>
            <name>Core_MDF_if_RT_is_Intel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vCoMarketingRecordTypeBln</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_the_PGM_records_0</targetReference>
            </connector>
            <label>if RT is Intel</label>
        </rules>
    </decisions>
    <interviewLabel>Core_MDF_CreateAccountShareForInternalAccountManagers {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_CreateAccountShareForInternalAccountManagers</label>
    <loops>
        <name>Core_MDF_Loop_through_sCollPGMList</name>
        <label>Loop through sCollPGMList</label>
        <locationX>513</locationX>
        <locationY>276</locationY>
        <assignNextValueToReference>sPGM</assignNextValueToReference>
        <collectionReference>sCollPGMList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_MDF_Add_it_to_AccountShare_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Core_MDF_Check_if_sCollAccountShareToBeInserted_has_values</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Insert_sCollAccountShareToBeInserted</name>
        <label>Insert sCollAccountShareToBeInserted</label>
        <locationX>90</locationX>
        <locationY>403</locationY>
        <inputReference>sCollAccountShareToBeInserted</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Core_MDF_Fetch_the_PGM_records</name>
        <label>Fetch the PGM records</label>
        <locationX>516</locationX>
        <locationY>46</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Check_if_sCollPGMList_is_NOT_NULL</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vCoMarketingUltimateAccount</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vProgram</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Group_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Partner_Group_Mapping__c</object>
        <outputReference>sCollPGMList</outputReference>
        <queriedFields>Core_MDF_Group_Id__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Core_MDF_Fetch_the_PGM_records_0</name>
        <label>Fetch the PGM records</label>
        <locationX>92</locationX>
        <locationY>164</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Core_MDF_Check_if_sCollPGMList_is_NOT_NULL</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vParentFundAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vProgram</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Group_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_of_Access__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Partner_Group_Mapping__c</object>
        <outputReference>sCollPGMList</outputReference>
        <queriedFields>Core_MDF_Group_Id__c</queriedFields>
    </recordLookups>
    <startElementReference>Core_MDF_Check_if_the_Record_Type_of_the_Parent_Fund_Account_is_Co_Marketing</startElementReference>
