    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 AND 2) OR (3 AND 4 AND 5) OR (6 AND 5 AND 4)</filterLogic>
        <filters>
            <field>Core_VBS_Potential__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_VBS_Potential__c</field>
            <operator>EqualTo</operator>
