    <decisions>
        <name>check_Only_For_DW_or_Contracted_Singed</name>
        <label>check Only For DW or Contracted Singed</label>
        <locationX>451</locationX>
        <locationY>1524</locationY>
        <defaultConnector>
            <targetReference>Update_Bypass_to_false</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DW_or_Contract_Signed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR4 Contract Signed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Team_Members</targetReference>
            </connector>
            <label>DW or Contract Signed</label>
        </rules>
    </decisions>
