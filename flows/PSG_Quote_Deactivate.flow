    <apiVersion>52.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>active_or_not</name>
        <label>active or not</label>
        <locationX>539</locationX>
        <locationY>370</locationY>
        <defaultConnector>
            <targetReference>Errormessage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isactive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Deactivate</targetReference>
            </connector>
            <label>if active</label>
        </rules>
        <rules>
            <name>if_not_active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isactive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.PSG_Internal_Biz_Ops</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>activate_record</targetReference>
            </connector>
            <label>if not active</label>
        </rules>
        <rules>
            <name>if_not_active_and_not_BO</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isactive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.PSG_Internal_Biz_Ops</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Does_not_have_permission</targetReference>
            </connector>
            <label>if not active and not BO</label>
        </rules>
    </decisions>
