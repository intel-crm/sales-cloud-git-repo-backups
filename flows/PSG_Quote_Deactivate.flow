    <actionCalls>
        <name>email_to_delegates_bo_and_disty</name>
        <label>email to delegates,bo and disty</label>
        <locationX>333</locationX>
        <locationY>1251</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>Emailbody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>delegtaed_user_email_id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>quote deactivated</stringValue>
