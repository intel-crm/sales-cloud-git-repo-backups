<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Call_Proactive_Alert_Method</name>
        <label>Call Proactive Alert Method</label>
        <locationX>676</locationX>
        <locationY>533</locationY>
        <actionName>Core_ProactiveAlertAandEFailures</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Pause_for_required_time</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>Core_ProactiveAlertAandEFailures</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>IsStartedToday</name>
        <label>IsStartedToday</label>
        <locationX>959</locationX>
        <locationY>307</locationY>
        <defaultConnectorLabel>StartedYesterday</defaultConnectorLabel>
        <rules>
            <name>StartedToday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FlowStartDateOnly</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Proactive_Alert</targetReference>
            </connector>
            <label>StartedToday</label>
        </rules>
    </decisions>
    <decisions>
        <name>Send_Proactive_Alert</name>
        <label>Send Proactive Alert</label>
        <locationX>671</locationX>
        <locationY>318</locationY>
        <defaultConnector>
            <targetReference>Pause_for_required_time</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>IsActive False</defaultConnectorLabel>
        <rules>
            <name>IsActive_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SendAlertBoolean</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Call_Proactive_Alert_Method</targetReference>
            </connector>
            <label>IsActive True</label>
        </rules>
    </decisions>
    <description>This flow triggers the Proactive Alerts when A&amp;E flow is broken due to any external system issue.</description>
    <environments>Default</environments>
    <formulas>
        <name>AlertPauseDateTime</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} + {!SendAlertFrequency}/1440</expression>
    </formulas>
    <formulas>
        <name>AlertPauseDateTimeNew</name>
        <dataType>DateTime</dataType>
        <expression>now()-((60-{!SendAlertFrequency})/1440)</expression>
    </formulas>
    <formulas>
        <name>FlowStartDateOnly</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!FlowStartDateTime})</expression>
    </formulas>
    <formulas>
        <name>SendAlertBoolean</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Core_AE_Proactive_Alerts__c.Send_Proactive_Alert__c}</expression>
    </formulas>
    <formulas>
        <name>SendAlertFrequency</name>
        <dataType>Number</dataType>
        <expression>{!$Setup.Core_AE_Proactive_Alerts__c.Alert_Frequency__c}</expression>
        <scale>3</scale>
    </formulas>
    <interviewLabel>Proactive Alert Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Proactive Alert Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>553</locationX>
        <locationY>47</locationY>
        <connector>
            <targetReference>Send_Proactive_Alert</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2022-08-10</startDate>
            <startTime>00:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>FlowStartDateTime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>$Flow.InterviewStartTime</elementReference>
        </value>
    </variables>
    <waits>
        <name>Pause_for_required_time</name>
        <label>Pause for required time</label>
        <locationX>968</locationX>
        <locationY>525</locationY>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <name>Pause_Element</name>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>IsStartedToday</targetReference>
            </connector>
            <eventType>AlarmEvent</eventType>
            <inputParameters>
                <name>AlarmTime</name>
                <value>
                    <elementReference>AlertPauseDateTimeNew</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffset</name>
                <value>
                    <numberValue>1.0</numberValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffsetUnit</name>
                <value>
                    <stringValue>Hours</stringValue>
                </value>
            </inputParameters>
            <label>Pause Element</label>
        </waitEvents>
    </waits>
</Flow>
