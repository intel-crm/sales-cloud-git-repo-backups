    <start>
        <locationX>584</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Feedback_and_Assign_the_Coverage</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.Feedback__c})</filterFormula>
        <object>SPM_Account_Feedback__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
