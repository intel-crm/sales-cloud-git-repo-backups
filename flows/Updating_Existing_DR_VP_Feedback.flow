<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Retain_existing_Value_for_Change_Ownership_If_value_exist</name>
        <label>Retain existing Value for Change Ownership If value exist</label>
        <locationX>1106</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>NewAccountPrimaryCoverage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record__Prior.Coverage_Type__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Feedback_type</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Coverage_as_Intel_led</name>
        <label>Update Coverage as Intel led</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>NewAccountPrimaryCoverage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Intel Led</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Feedback_type</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Coverage_as_Not_Covered</name>
        <label>Update Coverage as Not Covered</label>
        <locationX>578</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>NewAccountPrimaryCoverage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Uncovered</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Feedback_type</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Coverage_as_Other_led</name>
        <label>Update Coverage as Other led</label>
        <locationX>842</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>NewAccountPrimaryCoverage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Other-led Account</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Feedback_type</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Coverage_as_Partner_led</name>
        <label>Update Coverage as Partner led</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>NewAccountPrimaryCoverage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Partner Led</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Feedback_type</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Feedback_and_Assign_the_Coverage</name>
        <label>Check Feedback and Assign the Coverage</label>
        <locationX>710</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Feedback_type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Feedback_is_Change_to_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Feedback__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Change to Partner</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Coverage_as_Partner_led</targetReference>
            </connector>
            <label>If Feedback is Change to Partner</label>
        </rules>
        <rules>
            <name>If_Feedback_is_Add_to_Intel_Led</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Feedback__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Add to Intel led</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Coverage_as_Intel_led</targetReference>
            </connector>
            <label>If Feedback is Add to Intel Led</label>
        </rules>
        <rules>
            <name>If_Feedback_is_Change_to_Uncovered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Feedback__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Change to Uncovered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Coverage_as_Not_Covered</targetReference>
            </connector>
            <label>If Feedback is Change to Uncovered</label>
        </rules>
        <rules>
            <name>If_Feedback_is_Change_to_Other_Led</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Feedback__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Change to Other Led</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Coverage_as_Other_led</targetReference>
            </connector>
            <label>If Feedback is Change to Other Led</label>
        </rules>
        <rules>
            <name>If_Feedback_is_Change_Ownership_and_has_Prior_Value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Coverage_Type__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Feedback__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Change Ownership</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Retain_existing_Value_for_Change_Ownership_If_value_exist</targetReference>
            </connector>
            <label>If Feedback is Change Ownership and has Prior Value</label>
        </rules>
    </decisions>
    <decisions>
        <name>Feedback_type</name>
        <label>Feedback type</label>
        <locationX>710</locationX>
        <locationY>587</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DR</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Feedback_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Existing_Record_for_DR</targetReference>
            </connector>
            <label>DR</label>
        </rules>
        <rules>
            <name>VP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Feedback_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>VP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Existing_Record_for_VP</targetReference>
            </connector>
            <label>VP</label>
        </rules>
    </decisions>
    <description>Added Change to Other led in Decision
Added Change Ownership to retain existing value</description>
    <environments>Default</environments>
    <interviewLabel>Updating Existing DR/VP Feedback {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Updating Existing DR/VP Feedback</label>
    <processMetadataValues>
