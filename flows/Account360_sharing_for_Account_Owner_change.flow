    <actionCalls>
        <description>To delete the Account360 Objects sharing for the old Owner</description>
        <name>To_delete_the_sharing_for_the_old_Owner</name>
        <label>To delete the sharing for the old Owner</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>Account360_DeleteSharing</actionName>
        <actionType>apex</actionType>
