<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Get_the_incoming_record_details</name>
        <label>Get the incoming record details</label>
        <locationX>395</locationX>
        <locationY>224</locationY>
        <assignmentItems>
            <assignToReference>v_ProfessionValue</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PRM_Profession__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>v_Email</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PRM_Email_ID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>v_PhoneNumber</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.PRM_Person_Phone_Number__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_if_the_request_is_for_2nd_step</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_the_request_is_for_2nd_step</name>
        <label>Check if the request is for 2nd step</label>
        <locationX>542</locationX>
        <locationY>321</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_Profession_and_Phone_number_filled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>v_ProfessionValue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Record</targetReference>
            </connector>
            <label>Has Profession and Phone number filled</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Get_records_has_records</name>
        <label>If Get records has records</label>
        <locationX>745</locationX>
        <locationY>119</locationY>
        <defaultConnectorLabel>No, Record Not Found</defaultConnectorLabel>
        <rules>
            <name>Yes_Record_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>v_ExistingRecordID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Incoming_Record</targetReference>
            </connector>
            <label>Yes, Record Found</label>
        </rules>
    </decisions>
    <interviewLabel>Tie up data to existing record {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Tie up data to existing record</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Existing_Record</name>
        <label>Get Existing Record</label>
        <locationX>650</locationX>
        <locationY>190</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_Get_records_has_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Email_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>v_Email</elementReference>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <outputAssignments>
            <assignToReference>v_CurrentStatus</assignToReference>
            <field>Current_Status__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>v_ExistingRecordID</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>v_PhoneNumber</assignToReference>
            <field>PRM_Person_Phone_Number__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>v_ProfessionValue</assignToReference>
            <field>PRM_Profession__c</field>
        </outputAssignments>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordUpdates>
        <name>Update_Incoming_Record</name>
        <label>Update Incoming Record</label>
        <locationX>875</locationX>
        <locationY>225</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Email_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>v_Email</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PRM_Person_Phone_Number__c</field>
            <value>
                <elementReference>v_PhoneNumber</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Profession__c</field>
            <value>
                <elementReference>v_ProfessionValue</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>30</locationX>
        <locationY>26</locationY>
        <connector>
            <targetReference>Get_the_incoming_record_details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Entitlement_Details__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PRM_Profession__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>v_CurrentStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>v_Email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>v_ExistingRecordID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>v_PhoneNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>v_ProfessionValue</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>v_RecID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
