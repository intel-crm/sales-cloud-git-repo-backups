    <decisions>
        <description>Added this condition so that EEF Budgets are not shared with external User PGM groups</description>
        <name>Check_for_EEF_Program</name>
        <label>Check for EEF Program</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_CreateBudgetShareRecords</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Program Other than EEF</defaultConnectorLabel>
        <rules>
            <name>EEF_Program</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_EEF_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Call_budgetCapShare_method</targetReference>
            </connector>
            <label>EEF Program</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Call_budgetCapShare_method</name>
        <label>Call budgetCapShare method</label>
        <locationX>226</locationX>
        <locationY>923</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Just_execute_when_a_New_Budget_record_of_type_CoMarketing_is_created</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_CallingBudgetCapShareMethod</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Budget_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_BudgetStatus</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_BudgetCapShareForExternalUsers</targetReference>
            </connector>
            <label>CallingBudgetCapShareMethod</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_If_Co_Inv_Program</name>
        <label>Check If Co-Inv Program</label>
        <locationX>182</locationX>
        <locationY>1931</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_CreateOrUpdateAllocationRecordWhenBudgetIsReleased</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Programs (Create Allocation)</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_IsCoInvProgram</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Co_Inv_program_name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Update_Budget_Amount_For_CoInv</targetReference>
            </connector>
            <label>Co-Inv Program (Skip Allocation, Update Budget Only)</label>
        </rules>
    </decisions>
