        <expression>IF(ISPICKVAL({!$Record.Core_MDF_Budget_Status__c},&quot;TEXT({!$Label.Core_MDF_Status_Rejected})&quot;), true, {!$Record.Core_MDF_Decrease_Budget_Amount_Amt__c}&gt;0)</expression>
