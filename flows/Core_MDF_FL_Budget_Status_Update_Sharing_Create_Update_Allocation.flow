        <dataType>Number</dataType>
        <expression>IF(AND(NOT(ISNULL({!$Record.Core_MDF_Decrease_Budget_Amount_Amt__c})),{!$Record.Core_MDF_Decrease_Budget_Amount_Amt__c}&gt;0,{!$Record.Amount}&gt;={!$Record.Core_MDF_Decrease_Budget_Amount_Amt__c}), {!$Record.Amount}-{!$Record.Core_MDF_Decrease_Budget_Amount_Amt__c}, {!$Record.Amount})</expression>
        <scale>2</scale>
    </formulas>
