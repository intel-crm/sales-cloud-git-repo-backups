<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_AO_Active</name>
        <label>Check AO Active</label>
        <locationX>275</locationX>
        <locationY>684</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Owner_active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Owner.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task_On_Account</targetReference>
            </connector>
            <label>Account Owner active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_OO_Active</name>
        <label>Check OO Active</label>
        <locationX>275</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Check_AO_Active</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Owner_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task_Opp</targetReference>
            </connector>
            <label>Check Owner Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Renewal_Created_for_design_win</name>
        <label>Check Renewal Created for design win</label>
        <locationX>473</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>check_conditions</name>
            <conditionLogic>(1 AND 2 AND 3 AND 4 AND 11) AND (7 OR (5 AND (6 OR 8 OR 9 OR 10)))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Renewal_Opportunity_Id__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design Win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Contract_Start_Date__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Opportunity_Coverage_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel-Led Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Potential__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR4 Contract Signed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Potential__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR1 Un-qualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR3 Denied</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR4 Contract Not Signed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_VBS_Contract_Lifetime_in_Months__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Check_OO_Active</targetReference>
            </connector>
            <label>check conditions</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>TaskDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()+7</expression>
    </formulas>
    <formulas>
        <name>TaskName</name>
        <dataType>String</dataType>
        <expression>&quot;Opportunity Due for Renewal - &quot;+{!$Record.Name}</expression>
    </formulas>
    <interviewLabel>Create Task For Renew Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Task For Renew Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Task_On_Account</name>
        <label>Create Task On Account</label>
        <locationX>143</locationX>
        <locationY>792</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>TaskDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Activity_Source__c</field>
            <value>
                <stringValue>Automated</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Task_Type__c</field>
            <value>
                <elementReference>TaskName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.Account.Owner.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>TaskName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Task_Opp</name>
        <label>Create Task On Opportunity</label>
        <locationX>143</locationX>
        <locationY>492</locationY>
        <connector>
            <targetReference>Check_AO_Active</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>TaskDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Activity_Source__c</field>
            <value>
                <stringValue>Automated</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Task_Type__c</field>
            <value>
                <elementReference>TaskName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.Owner.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>TaskName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 AND 2 AND 3 AND 4 AND 11) AND (7 OR (5 AND (6 OR 8 OR 9 OR 10)))</filterLogic>
        <filters>
            <field>Core_Renewal_Opportunity_Id__c</field>
            <operator>EqualTo</operator>
        </filters>
        <filters>
            <field>CRM_VBS_Contract_Start_Date__c</field>
            <operator>NotEqualTo</operator>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Design Win</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Opportunity_Coverage_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel-Led Opportunity</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_VBS_Potential__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_VBS_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>SOAR4 Contract Signed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_VBS_Potential__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_VBS_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>SOAR1 Un-qualified</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_VBS_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>SOAR3 Denied</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_VBS_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>SOAR4 Contract Not Signed</stringValue>
            </value>
        </filters>
        <filters>
            <field>CRM_VBS_Contract_Lifetime_in_Months__c</field>
            <operator>NotEqualTo</operator>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Run_6_mnths_from_CED</name>
            <connector>
                <targetReference>Check_Renewal_Created_for_design_win</targetReference>
            </connector>
            <label>Run 6 mnths from CED</label>
            <offsetNumber>-6</offsetNumber>
            <offsetUnit>Months</offsetUnit>
            <recordField>Core_Contract_End_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
