<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>c_AE_ApprovedStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A&amp;E Approved</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_AE_PendingStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A&amp;E Pending</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_AE_RejectedStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A&amp;E Rejected</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_InsideSalesPendingStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Insides Sales Pending</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_InsidesSalesApprovedStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Insides Sales Approved</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_InsidesSalesRejected</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Insides Sales Rejected</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_Open</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Open</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_if_current_status_value_is_changed_to_Pending</name>
        <label>Check if current status value is changed to Pending</label>
        <locationX>465</locationX>
        <locationY>226</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_current_status_value_is_Pending</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>c_Open</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_pending_timestamp</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Check if current status value is Pending</label>
        </rules>
        <rules>
            <name>Check_if_current_status_changed_from_pending_to_approved</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_AE_ApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_On_current_status_is_approved</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Check if current status changed from pending to approved</label>
        </rules>
        <rules>
            <name>Check_if_current_status_changed_from_pending_to_rejected</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_AE_RejectedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesRejected</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_on_Current_Status_is_Rejected</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Check if current status changed from pending to rejected</label>
        </rules>
        <rules>
            <name>Change_only_the_status_corresponding_to_current_status_value</name>
            <conditionLogic>1 OR 2 OR 3</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_Open</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_only</targetReference>
            </connector>
            <label>Change only the status corresponding to current status value</label>
        </rules>
        <rules>
            <name>Change_only_the_status_for_approved_in_current_status</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_ApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Only_Status_to_Approved</targetReference>
            </connector>
            <label>Change only the status for approved in current status</label>
        </rules>
        <rules>
            <name>Change_only_the_status_if_rejected_in_current_status</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_RejectedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesRejected</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_only_the_status_field_to_Rejected</targetReference>
            </connector>
            <label>Change only the status if rejected in current status</label>
        </rules>
    </decisions>
    <formulas>
        <name>CurrentTimeStamp</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Check for Current Status and Update Status and TimeStamp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Check for Current Status and Update Status and TimeStamp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_On_current_status_is_approved</name>
        <label>Update On current status is approved</label>
        <locationX>1100</locationX>
        <locationY>445</locationY>
        <inputAssignments>
            <field>ActualApprover__c</field>
            <value>
                <stringValue>{!$User.FirstName} {!$User.LastName}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Approved_Timestamp__c</field>
            <value>
                <elementReference>CurrentTimeStamp</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Status__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_on_Current_Status_is_Rejected</name>
        <label>Update on Current Status is Rejected</label>
        <locationX>1163</locationX>
        <locationY>175</locationY>
        <inputAssignments>
            <field>ActualApprover__c</field>
            <value>
                <stringValue>{!$User.FirstName} {!$User.LastName}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Approved_Timestamp__c</field>
            <value>
                <elementReference>CurrentTimeStamp</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Status__c</field>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Only_Status_to_Approved</name>
        <label>Update Only Status to Approved</label>
        <locationX>712</locationX>
        <locationY>579</locationY>
        <inputAssignments>
            <field>PRM_Status__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_only_the_status_field_to_Rejected</name>
        <label>Update only the status field to Rejected</label>
        <locationX>989</locationX>
        <locationY>548</locationY>
        <inputAssignments>
            <field>PRM_Status__c</field>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_pending_timestamp</name>
        <label>Update pending timestamp</label>
        <locationX>1093</locationX>
        <locationY>50</locationY>
        <inputAssignments>
            <field>PRM_Status__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pending_TimeStamp__c</field>
            <value>
                <elementReference>CurrentTimeStamp</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Status_only</name>
        <label>Update Status only</label>
        <locationX>1123</locationX>
        <locationY>319</locationY>
        <inputAssignments>
            <field>PRM_Status__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>181</locationY>
        <connector>
            <targetReference>Check_if_current_status_value_is_changed_to_Pending</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Current_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PRM_Registration_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_RecordID</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
