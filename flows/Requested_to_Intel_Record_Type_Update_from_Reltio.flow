    <decisions>
        <name>Record_Type_Check</name>
        <label>Record Type Check</label>
        <locationX>842</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Intel_Account_Flow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mastered_Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested_Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Request_Records</targetReference>
            </connector>
            <label>Intel Account Flow</label>
        </rules>
        <rules>
            <name>Rejected_Account_Flow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected_Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested_Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Field_Definition</targetReference>
            </connector>
            <label>Rejected Account Flow</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>IsRequested</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Core_Account_Record_Type__c} = &apos;Requested Account&apos;</expression>
    </formulas>
    <formulas>
        <name>requestLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_260})) &amp; {!Get_Account_Request_Queue_Record.Id}</expression>
    </formulas>
    <interviewLabel>Record Type Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UCD ACM Requested to Intel Or Rejected Record Type Update from Reltio</label>
    <processMetadataValues>
        <name>BuilderType</name>
