    <recordLookups>
        <name>Get_Account_Request_Queue_Record</name>
        <label>Get Account Request Queue Record</label>
        <locationX>842</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Record_Type_Check</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_for_Get_Account_Request_Queue</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Requested_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>In Process</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account_Create_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>To get the field definition of the picklist field &apos;Core_Account_Request_Rejection_Reason__c&apos;
Purpose: This gets the ID for our specific picklist field.</description>
        <name>Get_Field_Definition</name>
        <label>Get Field Definition</label>
        <locationX>578</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_picklist_Info</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_for_getting_field_definition</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QualifiedApiName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core_Account_Request_Rejection_Reason__c</stringValue>
            </value>
        </filters>
        <filters>
            <field>EntityDefinitionId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>FieldDefinition</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>This retrieves the list of available picklist options for our field.</description>
        <name>Get_picklist_Info</name>
        <label>Get picklist Info</label>
        <locationX>578</locationX>
        <locationY>647</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Account_Request_Queue_Status</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_for_getting_picklist_Info</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EntityParticleId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Field_Definition.DurableId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Value</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_Account_Request_Rejection_Reason__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PicklistValueInfo</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Account_Request_Queue_Status</name>
        <label>Update Account Request Queue Status</label>
        <locationX>578</locationX>
        <locationY>755</locationY>
        <connector>
            <targetReference>Account_Request_Rejection_Email</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_for_Update_Request_Queue_Status</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Account_Request_Queue_Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Rejected_Reason__c</field>
            <value>
                <elementReference>Get_picklist_Info.Label</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Request_Flow_Status__c</field>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </inputAssignments>
        <object>Account_Create_Request__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Request_Records</name>
        <label>Update Request Records</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Approval_Email</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Log_Entry_for_Update_Request_Records</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Account_Request_Queue_Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Request_Flow_Status__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <object>Account_Create_Request__c</object>
    </recordUpdates>
    <start>
        <locationX>716</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Account_Request_Queue_Record</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1 AND (2 OR 3) AND (4 AND 5)</filterLogic>
        <filters>
            <field>Core_Business_Party_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Rejected Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Reference_Source_Name__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>MyDeals</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Account_Reference_Source_Name__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>IQR</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>EmailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Your account create request {!requestLink} has been approved. &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;Regards,&lt;br&gt;Account and Contact Management Team&lt;/br&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>RejectionEmailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;p&gt;Hi {!Get_Account_Request_Queue_Record.Requestor_Name__c},&lt;/p&gt;&lt;p&gt;Your&amp;nbsp;new account create request has not been approved due to certain criteria entered is not meeting standards for creation. To view the specific reason for the rejection, review the Account Request URL link below and see the Rejected Reason field.&lt;/p&gt;&lt;p&gt;If you believe this is an error, you can utilize the chatter feature within your account request URL to clarify questions with operations team, OR submit a new account request with revised account information.&lt;/p&gt;&lt;p&gt;{!requestLink}&lt;/p&gt;
Regards,&lt;br&gt;Account and Contact Management Team.&lt;/br&gt;</text>
    </textTemplates>
    <variables>
        <name>AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>Recipient</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>RequestedAccount</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Requested_Account</stringValue>
        </value>
    </variables>
    <variables>
        <name>RequestId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>RequestorName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>RequestRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account_Create_Request__c</objectType>
    </variables>
</Flow>
