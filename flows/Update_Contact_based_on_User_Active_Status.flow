<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Contact_Id</name>
        <label>Assign Contact Id</label>
        <locationX>296</locationX>
        <locationY>528</locationY>
        <assignmentItems>
            <assignToReference>ContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record__Prior.ContactId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_user_IsActive</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_User_Status_1</name>
        <label>Assign User Status 1</label>
        <locationX>839</locationX>
        <locationY>411</locationY>
        <assignmentItems>
            <assignToReference>User_Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Status</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_User_Status_2</name>
        <label>Assign User Status 2</label>
        <locationX>849</locationX>
        <locationY>622</locationY>
        <assignmentItems>
            <assignToReference>User_Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Status</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_User_Status_3</name>
        <label>Assign User Status 3</label>
        <locationX>846</locationX>
        <locationY>808</locationY>
        <assignmentItems>
            <assignToReference>User_Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Status</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Contact</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_user_IsActive</name>
        <label>Check user IsActive</label>
        <locationX>579</locationX>
        <locationY>627</locationY>
        <defaultConnector>
            <targetReference>Assign_User_Status_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User IsActive FALSE</defaultConnectorLabel>
        <rules>
            <name>User_IsActive_TRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_User_Status_2</targetReference>
            </connector>
            <label>User IsActive TRUE</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_contactId_present</name>
        <label>Is Contact ID present</label>
        <locationX>578</locationX>
        <locationY>412</locationY>
        <defaultConnector>
            <targetReference>Assign_User_Status_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contact Id Not Present</defaultConnectorLabel>
        <rules>
            <name>Contact_Id_is_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Contact_Id</targetReference>
            </connector>
            <label>Contact Id is Present</label>
        </rules>
    </decisions>
    <interviewLabel>Update Contact based on User Active Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Contact based on User Active Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>458</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Is_contactId_present</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>User</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <subflows>
        <name>Update_Contact</name>
        <label>Update Contact</label>
        <locationX>1109</locationX>
        <locationY>622</locationY>
        <flowName>Update_Contact_Sub_flow</flowName>
        <inputAssignments>
            <name>ContactId</name>
            <value>
