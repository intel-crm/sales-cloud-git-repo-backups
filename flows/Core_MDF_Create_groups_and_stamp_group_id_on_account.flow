<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_ASMO_Account</name>
        <label>Is ASMO Account?</label>
        <locationX>565</locationX>
        <locationY>266</locationY>
        <defaultConnector>
            <targetReference>Create_groups</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_account_geo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccountRegion</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ASMO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_groups_0</targetReference>
            </connector>
            <label>Check account geo</label>
        </rules>
    </decisions>
    <formulas>
        <name>GroupName_Geo</name>
        <dataType>String</dataType>
        <expression>&quot;Core_MDF_&quot;&amp;{!programAbrvtdName}&amp;&quot;_&quot;&amp;{!TrimAcctName}&amp;&quot;_&quot;&amp;{!AccountRegion}</expression>
    </formulas>
    <formulas>
        <name>GroupName_GeoSubgeo</name>
        <dataType>String</dataType>
        <expression>&quot;Core_MDF_&quot;&amp;{!programAbrvtdName}&amp;&quot;_&quot;&amp;{!TrimAcctName}&amp;&quot;_&quot;&amp;{!GroupName_Geo}&amp;{!GroupName_GeoSubgeo}</expression>
    </formulas>
    <interviewLabel>Create groups and stamp group id on account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create groups and stamp group id on account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_groups</name>
        <label>Create groups</label>
        <locationX>310</locationX>
        <locationY>268</locationY>
        <assignRecordIdToReference>GroupId</assignRecordIdToReference>
        <inputAssignments>
            <field>DeveloperName</field>
            <value>
                <elementReference>GroupName_Geo</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>GroupName_Geo</elementReference>
            </value>
        </inputAssignments>
        <object>Group</object>
    </recordCreates>
    <recordCreates>
        <name>Create_groups_0</name>
        <label>Create groups</label>
        <locationX>898</locationX>
        <locationY>265</locationY>
        <assignRecordIdToReference>GroupId</assignRecordIdToReference>
        <inputAssignments>
            <field>DeveloperName</field>
            <value>
                <elementReference>GroupName_GeoSubgeo</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>GroupName_GeoSubgeo</elementReference>
            </value>
        </inputAssignments>
        <object>Group</object>
    </recordCreates>
    <recordLookups>
        <name>get_metadata_record</name>
        <label>get metadata record</label>
        <locationX>573</locationX>
        <locationY>83</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_ASMO_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountProgram</elementReference>
            </value>
        </filters>
        <object>Core_MDF_ChannelProgram__mdt</object>
        <outputAssignments>
            <assignToReference>programAbrvtdName</assignToReference>
            <field>Core_MDF_Program_Name__c</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>28</locationX>
        <locationY>61</locationY>
        <connector>
            <targetReference>get_metadata_record</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>AccountProgram</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>AccountRegion</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>AccountSubRegion</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>It will store group id which will be stamped on the account record</description>
        <name>GroupId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>programAbrvtdName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>TrimAcctName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
