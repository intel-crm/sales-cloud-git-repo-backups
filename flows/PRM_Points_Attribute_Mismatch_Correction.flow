    <decisions>
        <name>Is_Eligible</name>
        <label>Is Eligible?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Optin_or_Status_Dates_populated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Points_Not_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Not_Eligible_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Not_ELigible_or_Status_Date_Populated</targetReference>
            </connector>
            <label>Points Not Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Not_ELigible_or_Status_Date_Populated</name>
        <label>Is Not ELigible or Status Date Populated?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>NotElig_and_Status_no_chnage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>not_eligible_date_not_populated</name>
            <conditionLogic>(1 OR 2 )AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Not_Eligible_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Not_Eligible_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_Date_to_Not_Eligible_Date</targetReference>
            </connector>
            <label>not eligible date not populated</label>
        </rules>
        <rules>
            <name>status_date_not_populated_NotEligPopulated</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Not_Eligible_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Not_Eligible_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Not_Eligible_Date_to_Status_Date</targetReference>
            </connector>
            <label>status date not populated</label>
        </rules>
        <rules>
            <name>NotEligible_and_Status_date_not_popluated</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Not_Eligible_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Not_Eligible_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_oldest_ACM_Record_NotElig</targetReference>
            </connector>
            <label>NotEligible and Status date not popluated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Optin_or_Status_Dates_populated</name>
        <label>Is Optin or Status Dates populated?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Optin_and_Status_to_Original_value</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Optin</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Opt_in_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Opt_in_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_Date_to_Optin_Date</targetReference>
            </connector>
            <label>Optin Date not populated</label>
        </rules>
        <rules>
            <name>Status_Date_not_populated</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Opt_in_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Opt_in_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Optin_Date_to_Status_Date</targetReference>
            </connector>
            <label>Status Date not populated</label>
        </rules>
        <rules>
            <name>Optin_and_Status_not_populated</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Opt_in_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Points_Opt_in_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PRM_Point_Status_Dt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_oldest_ACM_Record_Optin</targetReference>
            </connector>
            <label>Optin and Status not populated</label>
        </rules>
    </decisions>
    <description>Scheduled flow to run weekly for correcting points attribute mismatches</description>
    <environments>Default</environments>
    <formulas>
        <name>NotEligibledatesFromACMcreation</name>
        <dataType>String</dataType>
        <expression>&quot;Points Not Eligible and Points Status Field Updated from Oldest Approved ACM creation date, record id: &quot;+{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>PointsNotEligibleUpdatedfromPointStatus</name>
        <dataType>String</dataType>
        <expression>&quot;Points Not Eligible date is updated from Points Status date, record id: &quot;+{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>PointsOptinAndStatusUpdatedFromOldestACM</name>
        <dataType>String</dataType>
        <expression>&quot;Points Optin and Points Status Updated from Oldest Approved ACM, record id: &quot;+{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>PointsOptinDateUpdatedfromPointsStatus</name>
        <dataType>String</dataType>
        <expression>&quot;Points Optin Date is updated from Points Status field, record id: &quot;+{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>PointsStatusUpdatedfromPointsOptin</name>
        <dataType>String</dataType>
        <expression>&quot;Points Status field updated from Points Optin Fields, record id: &quot;+{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>PointstatusupdatedfromNotEligible</name>
        <dataType>String</dataType>
        <expression>&quot;The Point Status fields updated based on Points Not eligible field, record id:&quot;+ {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>UpdateFailedForPointsAttributes</name>
        <dataType>String</dataType>
        <expression>&quot; The update failed for record: &quot;+{!$Record.Id}+&quot; . Error: &quot;+{!$Flow.FaultMessage}</expression>
    </formulas>
    <interviewLabel>Points Attribute Mismatch Correction {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Points Attribute Mismatch Correction</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>DQ_Log_creation</name>
        <label>DQ Log creation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>LogEntryRecordCreationFailed</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>PRM_Apex_Class_Name__c</field>
            <value>
                <elementReference>FlowName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Message__c</field>
            <value>
                <elementReference>logMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PRM_Object_Name__c</field>
            <value>
                <elementReference>ObjectName</elementReference>
            </value>
        </inputAssignments>
        <object>PRM_IPA_DQ_Logs__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Log_Entry_for_failure</name>
        <label>Log Entry for failure</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>FaultLogMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <elementReference>FlowName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <elementReference>FlowName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <elementReference>Medium</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>get_oldest_ACM_Record_NotElig</name>
        <label>get oldest ACM Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_as_ACM_createddate</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Get_ACM_error</targetReference>
        </faultConnector>
