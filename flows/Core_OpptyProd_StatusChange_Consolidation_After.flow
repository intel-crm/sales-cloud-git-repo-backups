<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Error_Type_VR</name>
        <label>Error Type - VR</label>
        <locationX>314</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>ErrorType</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>FIELD_CUSTOM_VALIDATION_EXCEPTION</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>VR_Error</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_all_other_OLI_to_Cancelled</name>
        <label>Update all other OLI to Cancelled</label>
        <locationX>5594</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>Iterate_through_each_Opportunity.Core_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OLIStatus</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Iterate_through_each_Opportunity</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_through_each_Opportunity</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>default_fault_msg</name>
        <label>default fault msg</label>
        <locationX>578</locationX>
        <locationY>755</locationY>
        <customErrorMessages>
            <errorMessage>{!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>VR_Error</name>
        <label>VR Error</label>
        <locationX>314</locationX>
        <locationY>863</locationY>
        <customErrorMessages>
            <errorMessage>{!CustomValidation}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_if_SalesLostPrice_is_updated</name>
        <label>Check if SalesLostPrice is updated</label>
        <locationX>3570</locationX>
        <locationY>1547</locationY>
        <defaultConnector>
            <targetReference>SP_0_PSP_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>For PL/PC</defaultConnectorLabel>
        <rules>
            <name>For_L_C</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lost_Sales_Price__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_PW_Lost_Price__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SP_0_PSP_blank</targetReference>
            </connector>
            <label>For L/C</label>
        </rules>
    </decisions>
    <decisions>
        <description>1-Flow : Core_OppProd_Claim_Date_Clear, Core_OppProd_Clear_Approval_Fields_BU_Fields-v1,Core_OppProd_Clear_BU_Fields
2-Flow : Core_OppProd_Lost_to_Open_Steps
3/4-Flow :  Core_OppProd_Save_Key_Values_Upon_Approval and sync PW Fields, Core_OppProd_Update_Approved_User_Id, Core_OppProd_BU_Values_Upon_Approval,</description>
        <name>DW_conditions_check</name>
        <label>DW conditions check</label>
        <locationX>1106</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_changedTo_Pending_Hold</name>
            <conditionLogic>((1 AND 4) OR 2) AND 3 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Hold</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.CRM_IsLowTouchAdmin_Chk__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_DW_claim_date_DW_Approval_Fields</targetReference>
            </connector>
            <label>Status -&gt;Pending/Hold</label>
        </rules>
        <rules>
            <name>Pending_Win_Sub</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Win Submitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_DW_Claim_Date</targetReference>
            </connector>
            <label>Pending-&gt;Win Sub</label>
        </rules>
        <rules>
            <name>Win_Sub_Win_App</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Win Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Win Submitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PopulateDWApprovalDetails</targetReference>
            </connector>
            <label>Win Sub-&gt;Win App</label>
        </rules>
        <rules>
            <name>PWSub_App_Win_App</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Win Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Production Win </stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Clear_PW_Claim_Date</targetReference>
            </connector>
            <label>PW Sub/App-&gt;Win App</label>
        </rules>
    </decisions>
    <decisions>
        <name>Error_Type_Check</name>
        <label>Error Type Check</label>
        <locationX>446</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>default_fault_msg</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>FIELD_CUSTOM_VALIDATION_EXCEPTION</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Flow.FaultMessage</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>FIELD_CUSTOM_VALIDATION_EXCEPTION</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Type_VR</targetReference>
            </connector>
            <label>FIELD_CUSTOM_VALIDATION_EXCEPTION</label>
        </rules>
    </decisions>
    <decisions>
        <description>Flow : Core_OppProd_Open_to_LostOrPW_Step_1and2</description>
        <name>Open_to_Lost_check</name>
        <label>Open to Lost check</label>
        <locationX>2778</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PL_PC_L_C</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_PW_Claim_Date</targetReference>
            </connector>
            <label>PL/PC-&gt;L/C</label>
        </rules>
        <rules>
            <name>PL_PC_L_C_L_C</name>
            <conditionLogic>1 AND NOT(2 or 3) AND (4 or 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lost_Price</targetReference>
            </connector>
            <label>!(PL/PC/L/C)-&gt;L/C</label>
        </rules>
    </decisions>
    <decisions>
        <name>OpptyProd_Status_Check</name>
        <label>OpptyProd Status Check</label>
        <locationX>3570</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Design</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 ) AND 5 AND 6 AND 7</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Hold</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Win Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Win Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.Core_Sales_CRM_PartnerLed_LowTouch_Admin_Access</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DW_conditions_check</targetReference>
            </connector>
            <label>Design</label>
        </rules>
        <rules>
            <name>Lost_Cancelled</name>
            <conditionLogic>1 AND (2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.CRM_IsLowTouchAdmin_Chk__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_DW_Approval_Details</targetReference>
            </connector>
            <label>Lost/Cancelled</label>
        </rules>
        <rules>
            <name>Production</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Production</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.CRM_IsLowTouchAdmin_Chk__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PW_conditions_check</targetReference>
            </connector>
            <label>Production</label>
        </rules>
        <rules>
            <name>Pending_to_PW_for_Low_Touch</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.CRM_IsLowTouchAdmin_Chk__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PW_Approval_Details</targetReference>
            </connector>
            <label>Pending to PW for Low Touch</label>
        </rules>
    </decisions>
    <decisions>
        <description>1/2-Flow : Core_OppProd_Save_Key_Values_For_PW
3-Flow : Core_OppProd_Production_Claim_Date_Update
4-Flow : Core_OppProd_Open_to_LostOrPW_Step_1and2</description>
        <name>PW_conditions_check</name>
        <label>PW conditions check</label>
        <locationX>4274</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Win_App_PW_Sub</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Win Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_PW_claim_date</targetReference>
            </connector>
            <label>Win App-&gt;PW Sub</label>
        </rules>
        <rules>
            <name>PW_Sub_PW_App</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_PW_Approval_Details</targetReference>
            </connector>
            <label>PW Sub-&gt;PW App</label>
        </rules>
        <rules>
            <name>PL_PC_L_C_PL_PC</name>
            <conditionLogic>1 AND NOT(2 or 3) AND (4 or 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lost_Price</targetReference>
            </connector>
            <label>!(PL/PC/L/C)-&gt;PL/PC</label>
        </rules>
    </decisions>
    <decisions>
        <description>Given Oppty is PW.
Update PW and DW Approval Fields for all OLI as they will be changed to PWA</description>
        <name>Update_PW_Approval_Details</name>
        <label>Update PW Approval Details</label>
        <locationX>5462</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PW_and_DW_Approval_Fields</name>
            <conditionLogic>1 AND (2 OR 3 OR 4) AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Opportunity_Production_Win_Approval_Details</targetReference>
            </connector>
            <label>Oppty is PWA Update PW and DW Approval Fields</label>
        </rules>
        <rules>
            <name>Opportunity_is_in_Open_stages</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4) AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualify</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Define</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Develop</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Production Win Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_OLIs_based_on_this_opp_id</targetReference>
            </connector>
            <label>Opportunity is in Open stages</label>
        </rules>
    </decisions>
    <description>Consolidated these flows which had status change as main triggering point-
Core_OppProd_Clear_Approval_Fields_BU_Fields-v1
Core_OppProd_Production_Claim_Date_Update
Core_OppProd_Open_to_LostOrPW_Step_1and2
Core_OppProd_Save_Key_Values_For_PW
Core_OppProd_BU_Values_Upon_Approval
Core_OppProd_Clear_BU_Fields
Core_OppProd_Update_Approved_User_Id
Core_OppProd_Claim_Date_Clear
Core_OppProd_Save_Key_Values_Upon_Approval and sync PW Fields</description>
    <environments>Default</environments>
    <formulas>
        <name>bypass</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!$Record.Core_BypassFlow__c})</expression>
    </formulas>
    <formulas>
        <name>core_commisionable</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Opportunity.Core_Commissionable__c})</expression>
    </formulas>
    <formulas>
        <name>CustomValidation</name>
        <dataType>String</dataType>
        <expression>TRIM(right({!customValidationMsg} , (LEN( {!customValidationMsg}) - 1)))</expression>
    </formulas>
    <formulas>
        <name>customValidationMsg</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT(MID({!$Flow.FaultMessage}, 
FIND({!ErrorType},{!$Flow.FaultMessage}), 
((FIND(&apos;You can look up ExceptionCode values&apos;, 
{!$Flow.FaultMessage}))-{!firstIndex})), LEN(MID({!$Flow.FaultMessage}, 
FIND({!ErrorType},{!$Flow.FaultMessage}), 
((FIND(&apos;You can look up ExceptionCode values&apos;, 
{!$Flow.FaultMessage}))-{!firstIndex})))-LEN({!ErrorType})))</expression>
    </formulas>
    <formulas>
        <name>DWtotalprice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.UnitPrice}*{!$Record.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>firstIndex</name>
        <dataType>Number</dataType>
        <expression>FIND({!ErrorType}, {!$Flow.FaultMessage})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>OpportunityOwner</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.Opportunity.Owner.FirstName}+&quot;&quot;+{!$Record.Opportunity.Owner.LastName})</expression>
    </formulas>
    <formulas>
        <name>PWtotalprice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Core_PW_Sales_Price__c}*{!$Record.Core_PW_Quantity__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TechnicalOwner</name>
        <dataType>String</dataType>
        <expression>IF ( {!$Record.Opportunity.Core_Technical_Owner__c} != NULL, TRIM( {!$Record.Opportunity.Core_Technical_Owner__r.FirstName} + &quot; &quot; + {!$Record.Opportunity.Core_Technical_Owner__r.LastName}),&apos; &apos;)</expression>
    </formulas>
