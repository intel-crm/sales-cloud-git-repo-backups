<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>SetDRPRecCount</name>
        <label>Set DRP Rec Count</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>DRPRecCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>GetDRPRec</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>checkDRPCount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>UpdatePricingStartEndDate</name>
        <label>Update Pricing Start/End Date</label>
        <locationX>138</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>LoopDRPRecords.PCC_Quote_Line_Pricing_Start_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PCC_Pricing_Start_Date__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LoopDRPRecords.PCC_Quote_Line_Pricing_End_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PCC_Pricing_End_Date__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_DRP_Records</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>Draft</name>
        <dataType>String</dataType>
        <value>
            <stringValue>DRAFT</stringValue>
        </value>
    </constants>
    <decisions>
        <name>checkDRPCount</name>
        <label>check DRP Count</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CountGreaterThanZero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DRPRecCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LoopDRPRecords</targetReference>
            </connector>
            <label>Count Greater Than Zero</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Update Pricing Start/End Date on DRP {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Pricing Start/End Date on DRP</label>
    <loops>
        <name>LoopDRPRecords</name>
        <label>LoopDRPRecords</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <collectionReference>GetDRPRec</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>UpdatePricingStartEndDate</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetDRPRecords</name>
        <label>Get DRP Records</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SetDRPRecCount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Design_Registration_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Design_Registration_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Active_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PCC_Deal_Eligible_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_Design_Product_Status_Nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <object>Core_Design_Registration_Product__c</object>
        <outputReference>GetDRPRec</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>PCC_Quote_Line_Pricing_Start_Date__c</queriedFields>
        <queriedFields>PCC_Quote_Line_Pricing_End_Date__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_DRP_Records</name>
        <label>Update_DRP_Records</label>
        <locationX>138</locationX>
        <locationY>863</locationY>
        <connector>
            <targetReference>LoopDRPRecords</targetReference>
        </connector>
        <inputReference>LoopDRPRecords</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetDRPRecords</targetReference>
        </connector>
        <filterFormula>AND(TEXT({!$Record.Core_Design_Registration_Status_Nm__c})==&apos;DRAFT&apos;,
CONTAINS({!$Record.RecordType.DeveloperName},&apos;Deal&apos;),
OR(ISCHANGED({!$Record.PCC_Pricing_Start_Date__c}),ISCHANGED({!$Record.PCC_Pricing_End_Date__c})),
AND(({!$Record.PCC_Pricing_Start_Date__c} &gt;=TODAY()) ,({!$Record.PCC_Pricing_Start_Date__c}&lt;={!$Record.PCC_Pricing_End_Date__c}),({!$Record.PCC_Pricing_End_Date__c}&gt;={!$Record.PCC_Pricing_Start_Date__c}),({!$Record.PCC_Pricing_End_Date__c}&gt;=TODAY())))</filterFormula>
        <object>Core_Design_Registration__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>DRPRecCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>GetDRPRec</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_Design_Registration_Product__c</objectType>
    </variables>
</Flow>
