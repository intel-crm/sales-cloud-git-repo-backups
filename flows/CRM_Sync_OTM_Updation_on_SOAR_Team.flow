<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Intel-Led Opportunity and VBS Potential is True and VBS Status either Pending or SOAR1 Qualified</description>
        <name>Check_SOAR_conditions</name>
        <label>Check SOAR conditions?</label>
        <locationX>374</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>1 AND 2 AND (3 OR 4) AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_Opportunity_Coverage_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel-Led Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_VBS_Potential__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity.Core_VBS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOAR1 Qualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.User.Core_User_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internal User</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_SOAR_Record</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>v1 : For Intel-Led Growth Opportunity and VBS potential is checked, whenever OTM is updated, the flow will sync it to SOAR Team.</description>
    <environments>Default</environments>
    <interviewLabel>CRM_Sync OTM Updation on SOAR Team {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CRM_Sync OTM Updation on SOAR Team</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_SOAR_Record</name>
        <label>Get SOAR Record</label>
        <locationX>242</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_SOAR_Team</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_SOAR_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_SOAR_Team</name>
        <label>Get SOAR Team</label>
        <locationX>242</locationX>
        <locationY>492</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Bypass_True</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CRM_VBS_Team_member__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.UserId</elementReference>
            </value>
        </filters>
        <filters>
            <field>CRM_VBS_SOAR__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOAR_Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CRM_VBS_SOAR_Team__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Bypass_False</name>
        <label>Update Bypass = False</label>
        <locationX>242</locationX>
        <locationY>816</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Bypass_SOAR_DW_Check__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Bypass_SOAR_DW_Check__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Core_Opp_Bypass_Validation_Rule__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Bypass_True</name>
        <label>Update Bypass = True</label>
        <locationX>242</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Update_SOAR_Team_Member</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Bypass_SOAR_DW_Check__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Bypass_SOAR_DW_Check__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Core_Opp_Bypass_Validation_Rule__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_SOAR_Team_Member</name>
        <label>Update SOAR Team Member</label>
        <locationX>242</locationX>
        <locationY>708</locationY>
        <connector>
            <targetReference>Update_Bypass_False</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOAR_Team.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CRM_VBS_Description_of_Contribution__c</field>
            <value>
                <elementReference>$Record.Core_Description_of_Contribution__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CRM_VBS_Team_Role__c</field>
            <value>
                <elementReference>$Record.TeamMemberRole</elementReference>
            </value>
        </inputAssignments>
        <object>CRM_VBS_SOAR_Team__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Core_Description_of_Contribution__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>TeamMemberRole</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>OpportunityTeamMember</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Check_SOAR_conditions</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
