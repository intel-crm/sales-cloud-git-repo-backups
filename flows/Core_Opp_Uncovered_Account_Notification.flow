    <decisions>
        <name>Core_Opp_Uncovered_Account_Notification</name>
        <label>Core_Opp_Uncovered_Account_Notification</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_OwnerEQUALSIntegration_User_OR_Account_Account_OwnerEQUALSUncovered_Acco</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Core_Account_Owner__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Integration User</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Core_Account_Owner__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Uncovered Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Opp_Uncovered_Account_Notification_Email_Alert</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Account OwnerEQUALSIntegration User) OR (Account: Account OwnerEQUALSUncovered Account)</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Core_Opp_Uncovered_Account_Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Opp_Uncovered_Account_Notification</label>
    <processMetadataValues>
