    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Ask_Commissions_Updating_Fields_based_on_Record_Types</name>
        <label>Ask Commissions-Updating Fields based on Record Types</label>
        <locationX>771</locationX>
        <locationY>407</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Record_type_is_Core_AAQC_Case_recordType</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ask Commissions Case</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Record</targetReference>
            </connector>
            <label>If Record type is Core AAQC Case recordType</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Core AAQC Requested For field Upd and to Share Record with FAE Back To SetupHelp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core AAQC Requested For field Upd and to Share Record with FAE Back To SetupHelp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
