<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Count_Ext_Accounts</name>
        <label>Count Ext Accounts</label>
        <locationX>270</locationX>
        <locationY>614</locationY>
        <assignmentItems>
            <assignToReference>numExternalAccounts</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Query_External_Accounts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Branch_Based_on_Num_Ext_Accounts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Local_External_Id_2</name>
        <label>Set Local External Id</label>
        <locationX>490</locationX>
        <locationY>974</locationY>
        <assignmentItems>
            <assignToReference>localExternalId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Account_Choice_Set</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Filter_External_Accounts_to_Selected</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Output_Vars</name>
        <label>Set Output Vars</label>
        <locationX>358</locationX>
        <locationY>1430</locationY>
        <assignmentItems>
            <assignToReference>localExternalId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_First_Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>serviceAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_First_Record.ExternalId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_First_Record</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_External_Accounts_to_Selected</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter External Accounts to Selected</label>
        <locationX>490</locationX>
        <locationY>1094</locationY>
        <assignNextValueToReference>currentItem_Filter_External_Accounts_to_Selected</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Query_External_Accounts</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_External_Accounts_to_Selected.Id</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>localExternalId</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Get_First_Record</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Branch_Based_on_Num_Ext_Accounts</name>
        <label>Branch Based on Num Ext Accounts</label>
        <locationX>270</locationX>
        <locationY>734</locationY>
        <defaultConnector>
            <targetReference>Multiple_Ext_Accounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Multiple Ext Accounts</defaultConnectorLabel>
        <rules>
            <name>Zero_Ext_Accounts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExternalAccounts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Service_Cloud_Accounts</targetReference>
            </connector>
            <label>Zero Ext Accounts</label>
        </rules>
        <rules>
            <name>One_Ext_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExternalAccounts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_First_Record</targetReference>
            </connector>
            <label>One Ext Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Debug_Mode_1</name>
        <label>Debug Mode?</label>
        <locationX>270</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>Query_External_Accounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Debug_Mode_ON_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>debugMode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Entered_the_flow</targetReference>
            </connector>
            <label>Debug Mode ON</label>
        </rules>
    </decisions>
    <description>Determines which Service Cloud account corresponds to a Sales Cloud account. If none, displays a message and halts execution. If multiple, allows the user to select.</description>
    <dynamicChoiceSets>
        <name>Account_Choice_Set</name>
        <collectionReference>Query_External_Accounts</collectionReference>
        <dataType>String</dataType>
        <displayField>Name__c</displayField>
        <object>Account_External__x</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>testFormula</name>
        <dataType>String</dataType>
        <expression>&quot;Enterprise: &quot; &amp; {!$Api.Enterprise_Server_URL_540} &amp; &quot; | Partner: &quot; &amp; {!$Api.Partner_Server_URL_540} &amp; &quot; | FULL URL: &quot; &amp; LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;.my.&quot;, {!$Api.Partner_Server_URL_540}) - 1) &amp; &quot;.lightning.force.com/lightning/r/Case__x/&quot; &amp; {!recordId} &amp; &quot;/related/Cases_External_Account__r/view&quot;</expression>
    </formulas>
    <interviewLabel>Case - Determine Service Cloud Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - Determine Service Cloud Account</label>
    <loops>
        <name>Get_First_Record</name>
        <label>Get First Record</label>
        <locationX>270</locationX>
        <locationY>1310</locationY>
        <collectionReference>Query_External_Accounts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Output_Vars</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Query_External_Accounts</name>
        <label>Query External Accounts</label>
        <locationX>270</locationX>
        <locationY>494</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Ext_Accounts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account_External__x</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name__c</queriedFields>
        <queriedFields>Core_CIM_ID_c__c</queriedFields>
        <queriedFields>ExternalId</queriedFields>
        <sortField>Account__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>Entered_the_flow</name>
        <label>Entered the flow</label>
        <locationX>138</locationX>
        <locationY>278</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Query_External_Accounts</targetReference>
        </connector>
        <fields>
            <name>Entered_Flow</name>
            <fieldText>&lt;p&gt;You have entered the flow!&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;Record ID: {!recordId}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Test Formula: {!testFormula}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Multiple_Ext_Accounts</name>
        <label>Multiple Ext Accounts</label>
        <locationX>490</locationX>
        <locationY>854</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Local_External_Id_2</targetReference>
        </connector>
        <fields>
            <name>Multiple_Accounts</name>
            <fieldText>&lt;p&gt;Multiple Service Cloud accounts have been linked to this Sales Cloud account. Select the correct one to proceed.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Select_a_Service_Cloud_account</name>
            <choiceReferences>Account_Choice_Set</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Select a Service Cloud account</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>No_Service_Cloud_Accounts</name>
        <label>No Service Cloud Accounts</label>
        <locationX>50</locationX>
        <locationY>854</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Ext_Accounts</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;color: rgb(255, 0, 0);&quot;&gt;No Service Cloud accounts found for this Sales Cloud account!&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;There are no external accounts linked to this Sales Cloud account, via the &quot;Sales Cloud Id&quot; field in Service Cloud. You may either:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Find the correct account, with the linkage already established&lt;/li&gt;&lt;li&gt;Contact Data Ops to create the account and/or linkage in Service Cloud&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Finish</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>144</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Debug_Mode_1</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>currentItem_Filter_External_Accounts_to_Selected</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account_External__x</objectType>
    </variables>
    <variables>
        <name>debugMode</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>localExternalId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>numExternalAccounts</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>serviceAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
