                <elementReference>Core_MDF_Severity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>Core_MDF_When</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_sObjectId__c</field>
            <value>
                <elementReference>Core_MDF_sObjectId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_sObjectType__c</field>
            <value>
                <elementReference>Core_MDF_sObjectType</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
    </recordCreates>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
