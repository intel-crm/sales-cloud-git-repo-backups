                <elementReference>Core_MDF_Details</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <elementReference>Core_MDF_Message</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
