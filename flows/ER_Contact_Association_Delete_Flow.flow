<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Error_for_Audit_Record</name>
        <label>Error for Audit Record</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <customErrorMessages>
            <errorMessage>Audit tracking record cannot be deleted.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Verify_Audit_Record_Deletion</name>
        <label>Verify Audit Record Deletion</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Create_Post_Delete_Association_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Audit_Record_Deleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ER_End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_for_Audit_Record</targetReference>
            </connector>
            <label>Audit Record Deleted</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>EndDate</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Contact Association Delete Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Association Delete Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Post_Delete_Association_record</name>
        <label>Create Post Delete Association record</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>ER_Active__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_Contact__c</field>
            <value>
                <elementReference>$Record.ER_Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_Created_By__c</field>
            <value>
                <elementReference>$Record.ER_Created_By__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_Customer_Master_File_Group__c</field>
            <value>
                <elementReference>$Record.ER_Customer_Master_File_Group__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_End_Date__c</field>
            <value>
                <elementReference>EndDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ER_StartDate__c</field>
            <value>
                <elementReference>$Record.ER_StartDate__c</elementReference>
            </value>
        </inputAssignments>
        <object>ER_ContactGroupAssociation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Verify_Audit_Record_Deletion</targetReference>
        </connector>
        <object>ER_ContactGroupAssociation__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
