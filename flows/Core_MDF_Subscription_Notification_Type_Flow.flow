<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Show_Duplicate_Error_Message</name>
        <label>Show Duplicate Error Message</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <customErrorMessages>
            <errorMessage>An active record already exists for this combination 
 of Application, Module, and Notification Type.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>DuplicateRecordsExists</name>
        <label>Duplicate Records Exists</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Decision_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Subscription_Records.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Duplicate_Error_Message</targetReference>
            </connector>
            <label>Outcome 1 of Decision 1</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Subscription Notification Type {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subscription Based Notifications</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Existing_Subscription_Records</name>
        <label>Get Existing Subscription Records</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DuplicateRecordsExists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Object_API_nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Object_API_nm__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Notification_Type_API_nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Notification_Type_API_nm__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Project_Application_nm__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Project_Application_nm__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_MDF_Subscription_Notification_Type__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Subscription_Records</targetReference>
        </connector>
        <object>Core_MDF_Subscription_Notification_Type__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
