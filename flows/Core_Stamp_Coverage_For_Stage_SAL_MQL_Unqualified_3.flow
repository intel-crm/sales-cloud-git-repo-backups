    <start>
        <locationX>144</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>PRIORVALUE_AS_TAL_MQL_SAL_TQL_Unqualified</targetReference>
        </connector>
        <filterFormula>AND( OR( ISNEW(), ISCHANGED({!$Record.Status}) ), LEFT({!$Record.OwnerId}, 3) = &apos;005&apos;, OR( TEXT(PRIORVALUE({!$Record.Status}))=&quot;Unqualified&quot;, TEXT(PRIORVALUE({!$Record.Status}))=&quot;Sales Accepted Lead&quot;, TEXT(PRIORVALUE({!$Record.Status}))=&quot;Marketing Qualified Lead&quot;, TEXT(PRIORVALUE({!$Record.Status}))=&quot;Tele Qualified Lead&quot;,TEXT(PRIORVALUE({!$Record.Status}))=&quot;Tele Accepted Lead&quot; ) )</filterFormula>
        <object>Lead</object>
