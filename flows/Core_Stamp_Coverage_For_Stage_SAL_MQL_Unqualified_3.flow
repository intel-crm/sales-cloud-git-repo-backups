    <description>Migrated from the: Core_Stamp_Coverage_For_Stage_SAL_MQL_Unqualified workflow rule
Workflow rule description: &quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Coverage_MAQL_FastTrack1Formula</name>
        <dataType>String</dataType>
        <expression>IF(AND (TEXT(PRIORVALUE($Record.Status))=&quot;Marketing Qualified Lead&quot;, ISPICKVAL($Record.Status, &quot;Sales Accepted Lead&quot;), $Record.RecordType.Name = &quot;Lead&quot; ), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TAL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Coverage_MAQL_FastTrack2Formula</name>
        <dataType>String</dataType>
        <expression>IF(AND (TEXT(PRIORVALUE($Record.Status))=&quot;Marketing Qualified Lead&quot;, ISPICKVAL($Record.Status, &quot;Sales Accepted Lead&quot;), $Record.RecordType.Name = &quot;Lead&quot; ), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TQL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Coverage_TAL_SAL_FastTrackFormula</name>
        <dataType>String</dataType>
        <expression>IF(AND (TEXT(PRIORVALUE($Record.Status))=&quot;Tele Accepted Lead&quot;, ISPICKVAL($Record.Status, &quot;Sales Accepted Lead&quot;)), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TQL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_MQL_Lead_CoverageFormula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT(PRIORVALUE($Record.Status))=&quot;Marketing Qualified Lead&quot;, (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_MQL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_SALFormula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT(PRIORVALUE($Record.Status))=&quot;Sales Accepted Lead&quot;,  (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_SAL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_TAL_Lead_CoverageFormula</name>
        <dataType>String</dataType>
        <expression>IF(AND(TEXT(PRIORVALUE($Record.Status))=&quot;Tele Accepted Lead&quot;, ISCHANGED($Record.Status)), (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TAL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_TQL_Lead_CoverageFormula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT(PRIORVALUE($Record.Status))=&quot;Tele Qualified Lead&quot;, (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_TQL_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>Core_Update_Unqualified_Lead_CoverageFormula</name>
        <dataType>String</dataType>
        <expression>IF(TEXT(PRIORVALUE($Record.Status))=&quot;Unqualified&quot;,  (IF(ISBLANK (TEXT($Record.Owner:User.Core_User_Coverage__c)),&apos;Other&apos;,TEXT($Record.Owner:User.Core_User_Coverage__c))),$Record.Core_Locked_Unqualified_Coverage__c)</expression>
    </formulas>
    <formulas>
        <name>LockedTALCoverage_With_Status_change</name>
        <dataType>String</dataType>
        <expression>IF(AND(TEXT(PRIORVALUE({!$Record.Status}))=&quot;Tele Accepted Lead&quot;, ISCHANGED({!$Record.Status})), (IF(ISBLANK (TEXT({!$Record.Owner:User.Core_User_Coverage__c})),&apos;Other&apos;,TEXT({!$Record.Owner:User.Core_User_Coverage__c}))),{!$Record.Core_Locked_TAL_Coverage__c})</expression>
    </formulas>
    <formulas>
        <description>PRIORVALUE AS TAL</description>
        <name>PRIORVALUE_TAL</name>
        <dataType>Boolean</dataType>
        <expression>PRIORVALUE({!$Record.Status})=&apos;Tele Accepted Lead&apos;  &amp;&amp; ISCHANGED({!$Record.Status})</expression>
    </formulas>
    <formulas>
        <name>TALandStatusChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL(({!$Record__Prior.Status}),&quot;Tele Accepted Lead&quot;) &amp;&amp; ISCHANGED({!$Record.Status})</expression>
    </formulas>
    <label>Core_Stamp_Coverage_For_Stage_SAL_MQL_Unqualified_3</label>
