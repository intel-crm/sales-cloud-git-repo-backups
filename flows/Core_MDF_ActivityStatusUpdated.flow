    <description>Used to send out an email alert and bell icon notification to activity creator(external/internal) when the activity status has been updated</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>PRIORVALUE([PartnerFundRequest].Core_MDF_Fund_Request_Status__c ) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_3_myRule_1_A1_8013382724</name>
        <dataType>String</dataType>
        <expression>PRIORVALUE({!myVariable_current.Core_MDF_Fund_Request_Status__c} )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(

OR(ISNEW(),
AND($Permission.Core_MDF_CCP_Internal_Retail_Marketing_GEO_Approver,
ISCHANGED([PartnerFundRequest].Core_MDF_Start_Date__c))
),

[PartnerFundRequest].Core_MDF_Start_Date__c &lt; TODAY(),
ISCHANGED([PartnerFundRequest].Core_MDF_Fund_Request_Status__c),
ISPICKVAL(([PartnerFundRequest].Core_MDF_Fund_Request_Status__c),&apos;Closed&apos;),
ISPICKVAL(([PartnerFundRequest].Core_MDF_Region_cd__c),&apos;APJ&apos;),
ISPICKVAL(([PartnerFundRequest].Core_MDF_Activity_Closure_Type__c) ,&apos;No Internal Approval&apos;)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_15</name>
        <dataType>Boolean</dataType>
        <expression>AND(

OR(ISNEW(),
AND({!$Permission.Core_MDF_CCP_Internal_Retail_Marketing_GEO_Approver},
ISCHANGED({!myVariable_current.Core_MDF_Start_Date__c}))
),

{!myVariable_current.Core_MDF_Start_Date__c} &lt; TODAY(),
ISCHANGED({!myVariable_current.Core_MDF_Fund_Request_Status__c}),
ISPICKVAL(({!myVariable_current.Core_MDF_Fund_Request_Status__c}),&apos;Closed&apos;),
ISPICKVAL(({!myVariable_current.Core_MDF_Region_cd__c}),&apos;APJ&apos;),
ISPICKVAL(({!myVariable_current.Core_MDF_Activity_Closure_Type__c}) ,&apos;No Internal Approval&apos;)
)</expression>
    </formulas>
