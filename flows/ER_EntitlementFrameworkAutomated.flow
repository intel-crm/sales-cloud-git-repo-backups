<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_data_to_Contact</name>
        <label>Assign data to Contact</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>createContactRecord.FirstName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_First_Name__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.LastName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Last_Name__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.Email</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Email_ID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.Phone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Person_Phone_Number__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.Core_Profession__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Profession__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.MailingCountry</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Contact_Country__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.MailingCountryCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Contact_Country__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.Core_Preferred_Language__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Preferred_Language__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.Core_Preferred_Language__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Preferred_Language__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.Core_Login_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Contact_Login_ID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Account_ID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.Core_Login_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Email_ID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.Core_Enterprise_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Enterprise_ID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createContactRecord.Core_Profession__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Profession__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Contact</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_for_New_registration_record_readyness</name>
        <label>Check for New registration record readyness</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Registration_record_not_ready_screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_ready_for_utomation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_New_Registration_record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Welcome_screen</targetReference>
            </connector>
            <label>Record ready for utomation</label>
        </rules>
    </decisions>
    <description>This flow is triggered by clicking the button &apos;Initiate Auto Creation&apos; on new registration record.</description>
    <environments>Default</environments>
    <interviewLabel>EntitlementFrameworkAutomated {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ER_EntitlementFrameworkAutomated</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_CBT</name>
        <label>Create CBT</label>
        <locationX>50</locationX>
        <locationY>782</locationY>
        <inputAssignments>
            <field>Business_Types__c</field>
            <value>
                <elementReference>Get_New_Registration_record.Entitlement_Details__r.Core_AGS_Role_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>Create_Contact</elementReference>
            </value>
        </inputAssignments>
        <object>Contact_Business_Types__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Contact</name>
        <label>Create Contact</label>
        <locationX>50</locationX>
        <locationY>674</locationY>
        <connector>
            <targetReference>Create_CBT</targetReference>
        </connector>
        <inputReference>createContactRecord</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Core_Country_Metadata</name>
        <label>Get Core Country Metadata</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_data_to_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_New_Registration_record.PRM_Contact_Country__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Core_Country_Code_Mapping__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_New_Registration_record</name>
        <label>Get New Registration record</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_for_New_registration_record_readyness</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>PRM_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_Registration_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Registration_record_not_ready_screen</name>
        <label>Registration record not ready screen</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>NotReadyMessage</name>
            <fieldText>&lt;p&gt;This registration record is not ready for automation, please make sure all approvals are done, then click this button.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Welcome_screen</name>
        <label>Welcome screen</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Get_Core_Country_Metadata</targetReference>
        </connector>
        <fields>
            <name>welcometext</name>
            <fieldText>&lt;p&gt;This process will automatically create contact, assign entitlements. Please click next if you want to proceed&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_New_Registration_record</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>createContactRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
