    <description>This will update unit price as well as display warning message incase of price mismatch</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND( ISPICKVAL([OrderItem].Order.Sales_Order_Reason__c , &apos;Non Stocking Order&apos; ),
OR(AND(ISBLANK(PRIORVALUE([OrderItem].Sales_Contact__c)),NOT(ISBLANK([OrderItem].Sales_Contact__c))),
AND(ISNEW(),NOT(ISBLANK([OrderItem].Sales_Contact__c))),ISCHANGED([OrderItem].Sales_Contact__c), ISCHANGED([OrderItem].Order.Sales_Order_Reason__c),
ISCHANGED([OrderItem].Quantity)))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_13</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISPICKVAL({!myVariable_current.Order.Sales_Order_Reason__c} , &apos;Non Stocking Order&apos; ),
OR(AND(ISBLANK(PRIORVALUE({!myVariable_current.Sales_Contact__c})),NOT(ISBLANK({!myVariable_current.Sales_Contact__c}))),
AND(ISNEW(),NOT(ISBLANK({!myVariable_current.Sales_Contact__c}))),ISCHANGED({!myVariable_current.Sales_Contact__c}), ISCHANGED({!myVariable_current.Order.Sales_Order_Reason__c}),
ISCHANGED({!myVariable_current.Quantity})))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
ISPICKVAL([OrderItem].Order.Status, &apos;Draft&apos; ),
NOT(ISBLANK([OrderItem].Order.SBQQ__Quote__c ) ), 			
OR(
([OrderItem].Sales_Broken_Price_Amt__c &lt;&gt; [OrderItem].SBQQ__QuoteLine__r.price_brokencost_amt__c  )		
,
OR(
AND(
ISBLANK([OrderItem].SBQQ__QuoteLine__r.price_suggested_resale_amt__c),
([OrderItem].Sales_Suggested_Resale_Price__c &lt;&gt; 0)
),
([OrderItem].Sales_Suggested_Resale_Price__c &lt;&gt; [OrderItem].SBQQ__QuoteLine__r.price_suggested_resale_amt__c )		
)
)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_9</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISPICKVAL({!myVariable_current.Order.Status}, &apos;Draft&apos; ),
NOT(ISBLANK({!myVariable_current.Order.SBQQ__Quote__c} ) ), 			
OR(
({!myVariable_current.Sales_Broken_Price_Amt__c} &lt;&gt; {!myVariable_current.SBQQ__QuoteLine__r.price_brokencost_amt__c}  )		
,
OR(
AND(
ISBLANK({!myVariable_current.SBQQ__QuoteLine__r.price_suggested_resale_amt__c}),
({!myVariable_current.Sales_Suggested_Resale_Price__c} &lt;&gt; 0)
),
({!myVariable_current.Sales_Suggested_Resale_Price__c} &lt;&gt; {!myVariable_current.SBQQ__QuoteLine__r.price_suggested_resale_amt__c} )		
)
)
)</expression>
    </formulas>
