        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Email_to_Creator_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_email_to_Owner</targetReference>
            </connector>
            <label>Send Email to Creator/Owner</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_manager_email_not_blank</name>
