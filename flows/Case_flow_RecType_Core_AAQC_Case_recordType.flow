    <decisions>
        <name>Check_Status_and_send_mail</name>
        <label>Check Status and send mail</label>
        <locationX>578</locationX>
        <locationY>1523</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Status_Awaiting_Resolution_Confirmation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Resolution Confirmation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_for_Requester_Awaiting_resolution_confirmation</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Status Awaiting Resolution Confirmation</label>
        </rules>
        <rules>
            <name>If_Status_Awaiting_Requestor_s_Info</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Requestor’s Info</stringValue>
                </rightValue>
            </conditions>
