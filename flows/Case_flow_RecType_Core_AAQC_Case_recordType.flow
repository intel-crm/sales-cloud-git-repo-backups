    <decisions>
        <name>Check_Case_comment_added</name>
        <label>Check Case comment added</label>
        <locationX>578</locationX>
        <locationY>1223</locationY>
        <defaultConnector>
            <targetReference>Check_Status_and_send_mail</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_comment_added</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_AAQC_Case_Comment_Id__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notification_to_Owner_when_case_comment_added</targetReference>
            </connector>
            <label>If comment added</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Status_Updated</name>
