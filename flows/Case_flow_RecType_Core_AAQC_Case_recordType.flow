        <rules>
            <name>If_OwnerId_Updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
