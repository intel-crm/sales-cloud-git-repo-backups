<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Lock_or_Unlock</name>
        <label>Lock or Unlock</label>
        <locationX>584</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_User_s_Profile_name_contains_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner:User.Profile.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Partner</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>c_Core_DDR_Design_Locked_Record_Type_ID</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_RecordType_to_Design_Registration_Partner</targetReference>
            </connector>
            <label>If User&apos;s Profile name contains Partner</label>
        </rules>
        <rules>
            <name>If_user_s_Profile_Name_does_not_contain_Partner</name>
            <conditionLogic>(NOT (1)) AND 2 AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner:User.Profile.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Partner</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>c_Core_DDR_Design_Locked_Record_Type_ID</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Design</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Record_Type_to_Design_Registration_Intel</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If user&apos;s Profile Name does not contain Partner</label>
        </rules>
    </decisions>
    <description>Lock or unlock record based on Owner Profile</description>
    <environments>Default</environments>
    <formulas>
        <name>c_Core_DDR_Design_Locked_Record_Type_ID</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_DDR_Design_Locked_Record_Type_ID}</expression>
    </formulas>
    <interviewLabel>Core_DDR_Lock_Unlock {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_DDR_Lock_Unlock</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Record_Type_to_Design_Registration_Intel</name>
        <label>Update Record Type to Design Registration - Intel</label>
        <locationX>584</locationX>
        <locationY>443</locationY>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>v_RecId_DesignRegistrationIntel</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_RecordType_to_Design_Registration_Partner</name>
        <label>Update RecordType to Design Registration - Partner</label>
        <locationX>320</locationX>
        <locationY>443</locationY>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>V_RecId_DesignRegistrationPartner</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>458</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Lock_or_Unlock</targetReference>
        </connector>
        <filterFormula> AND ( NOT({!$Record.RecordTypeId} = {!$Label.Core_DDR_Design_Locked_Record_Type_ID}) , {!$Permission.PCC_Bypass_Automation} = False,{!$Record.RecordType.DeveloperName} &lt;&gt; &apos;PCC_Deal_Registration_Partner&apos; )</filterFormula>
        <object>Core_Design_Registration__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>v_RecId_DesignRegistrationIntel</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>0121J000000U30sQAC</stringValue>
        </value>
    </variables>
    <variables>
        <name>V_RecId_DesignRegistrationPartner</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>0121J000000U314QAC</stringValue>
        </value>
    </variables>
</Flow>
