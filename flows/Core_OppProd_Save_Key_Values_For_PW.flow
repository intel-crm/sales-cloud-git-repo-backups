    <decisions>
        <name>If_Is_Changed_Product_Qty</name>
        <label>If Is Changed Product Qty</label>
        <locationX>986</locationX>
        <locationY>2039</locationY>
        <defaultConnector>
            <targetReference>If_Is_Changed_Production_Sales_Price</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PW_Qty_Change</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_PW_Quantity__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_PW_Quantity__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Quantity</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_PW_Quantity__c</leftValueReference>
                <operator>GreaterThan</operator>
