    <decisions>
        <name>Check_Status_of_Product</name>
        <label>Check Status of Product</label>
        <locationX>337</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Assigning_PW_and_Unit_Price_as_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Checking_Status_of_Product</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lost_Price_Salesprice</targetReference>
            </connector>
            <label>Checking Status of Product</label>
        </rules>
    </decisions>
