        <rules>
            <name>checking_prior_status_value_and_new_status_value1</name>
            <conditionLogic>1 AND 2 AND 3 AND 4 AND 5 AND (6 OR 7 OR 8 OR 9 OR 10)</conditionLogic>
            <conditions>
