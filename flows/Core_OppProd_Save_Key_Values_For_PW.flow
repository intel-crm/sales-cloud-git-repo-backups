            <conditions>
                <leftValueReference>$Record.Core_PW_Sales_Price__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Records_Sales_Price_and_Total_Sales_Price</targetReference>
            </connector>
            <label>Update the Sales Price and Total Sales Price</label>
        </rules>
    </decisions>
    <description>To populate PW related values in opportunity products</description>
    <environments>Default</environments>
    <formulas>
        <name>Core_Approved_Date</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.Opportunity.Core_Approved_Date__c}</expression>
    </formulas>
    <formulas>
        <name>Core_Commissionable</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Opportunity.Core_Commissionable__c})</expression>
    </formulas>
    <formulas>
        <name>errorMessageText</name>
        <dataType>String</dataType>
        <expression>MID({!$Flow.FaultMessage}, FIND(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION: &apos;, {!$Flow.FaultMessage}) + LEN(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION: &apos;), FIND(&apos;. You can look up ExceptionCode&apos;, {!$Flow.FaultMessage}) - FIND(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION: &apos;, {!$Flow.FaultMessage}) - LEN(&apos;FIELD_CUSTOM_VALIDATION_EXCEPTION: &apos;))</expression>
    </formulas>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>PWTotalPrice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Core_Lost_Sales_Price__c}*{!$Record.Core_PW_Quantity__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TotalPrice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Core_PW_Sales_Price__c}*{!$Record.Core_PW_Quantity__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core_OppProd_Save_Key_Values_For_PW {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_OppProd_Save_Key_Values_For_PW</label>
    <loops>
        <name>Iterate_through_each_Opportunity</name>
        <label>Iterate through each Opportunity</label>
        <locationX>854</locationX>
        <locationY>1439</locationY>
        <collectionReference>Get_OLIs_based_on_this_opp_id</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_all_other_OLI_to_Cancelled</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_OLI_status_to_Cancelled</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the OLIs</description>
        <name>Get_OLIs_based_on_this_opp_id</name>
        <label>Get OLIs based on this opp id</label>
        <locationX>854</locationX>
        <locationY>1331</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Iterate_through_each_Opportunity</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND (4 OR 5)</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Production Win Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>On Hold</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
