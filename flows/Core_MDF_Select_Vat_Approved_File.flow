<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Call_method_to_update_File_Name_as_Approved</name>
        <label>Call method to update File Name as Approved</label>
        <locationX>991</locationX>
        <locationY>455</locationY>
        <actionName>Core_MDF_Vat_Utility</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>fileName</name>
            <value>
                <elementReference>Selected_File_Name</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_Vat_Utility</nameSegment>
    </actionCalls>
    <apiVersion>50.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Get_the_File_Name</name>
        <label>Get the File Name</label>
        <locationX>670</locationX>
        <locationY>441</locationY>
        <assignmentItems>
            <assignToReference>FileNames</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_the_content_file_name.ContentDocument.Title</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>FilePicklist</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_the_content_file_name.ContentDocument.Title</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_the_Content_Document_Ids</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>choice2</name>
        <choiceText>{!choice2}</choiceText>
        <dataType>String</dataType>
        <value>
            <elementReference>filename</elementReference>
        </value>
    </choices>
    <choices>
        <name>FileList</name>
        <choiceText>{!FileNames}</choiceText>
        <dataType>String</dataType>
        <value>
            <elementReference>FileList</elementReference>
        </value>
    </choices>
    <choices>
        <name>FilePicklistChoice</name>
        <choiceText>{!FilePicklist}</choiceText>
        <dataType>String</dataType>
        <value>
            <elementReference>FilePicklist</elementReference>
        </value>
    </choices>
    <choices>
        <name>picklist1</name>
        <choiceText>{!Get_the_content_file_name.ContentDocument.Title}</choiceText>
        <dataType>String</dataType>
        <value>
            <elementReference>Get_the_content_file_name.ContentDocument.Title</elementReference>
        </value>
    </choices>
    <description>Select Vat Approved File</description>
    <dynamicChoiceSets>
        <name>filerecordlist</name>
        <dataType>String</dataType>
        <displayField>Title</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_the_content_file_name.ContentDocumentId</elementReference>
            </value>
        </filters>
        <object>ContentDocument</object>
        <valueField>Title</valueField>
    </dynamicChoiceSets>
    <interviewLabel>Select Vat Approved File {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Select Vat Approved File</label>
    <loops>
        <description>Get the content file name</description>
        <name>Get_the_content_file_name</name>
        <label>Get the content file name</label>
        <locationX>129</locationX>
        <locationY>356</locationY>
        <collectionReference>ContentDocumentLinkList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_the_File_Name</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Select_Vat_Approved_File</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Get the Content Document Ids</description>
        <name>Get_the_Content_Document_Ids</name>
        <label>Get the Content Document Ids</label>
        <locationX>251</locationX>
        <locationY>177</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_the_content_file_name</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>ContentDocumentLink</object>
        <outputReference>ContentDocumentLinkList</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>ContentDocumentId</queriedFields>
    </recordLookups>
    <screens>
