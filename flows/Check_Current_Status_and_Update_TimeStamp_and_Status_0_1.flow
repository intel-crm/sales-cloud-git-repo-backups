<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>c_AE_ApprovedStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A&amp;E Approved</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_AE_PendingStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A&amp;E Pending</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_AE_RejectedStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A&amp;E Rejected</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_InsideSalesPendingStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Insides Sales Pending</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_InsidesSalesApprovedStatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Insides Sales Approved</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_InsidesSalesRejected</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Insides Sales Rejected</stringValue>
        </value>
    </constants>
    <constants>
        <name>c_Open</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Open</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_if_current_status_approved_by_AE_or_Sales</name>
        <label>Check if current status approved by AE or Sales</label>
        <locationX>274</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IF_Current_Status_is_AE_Approved_Or_Rejected</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_ApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_AE_RejectedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Updated_AE_Approved_Or_Rejected_TimeStamp</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>IF Current Status is AE Approved Or Rejcted</label>
        </rules>
        <rules>
            <name>IF_Current_Status_is_Sales_Approved_Or_Rejcted</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>c_InsidesSalesApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesRejected</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sales_Approved_Or_Rejected_TimeStamp</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>IF Current Status is Sales Approved Or Rejcted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_the_current_status_value_is_changed</name>
        <label>Check the current status value is changed?</label>
        <locationX>751</locationX>
        <locationY>359</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_current_status_value_is_Pending</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>c_Open</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_pending_timestamp</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Check if current status value is Pending</label>
        </rules>
        <rules>
            <name>Check_if_current_status_is_Open_to_approved</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>c_Open</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_AE_ApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_ApprovedRejected_Timestamp_and_Status_If_Open_to_Approved</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Check if current status is Open to approved</label>
        </rules>
        <rules>
            <name>Check_if_current_status_changed_from_pending_to_approved</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_AE_ApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_On_current_status_is_approved</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Check if current status changed from pending to approved</label>
        </rules>
        <rules>
            <name>If_CurrentStatus_changed_from_AE_Pending_to_Sales_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>check_who_has_updated_AE_or_Sales</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If CurrentStatus changed from AE_Pending to Sales Pending</label>
        </rules>
        <rules>
            <name>Check_if_current_status_changed_from_pending_to_rejected</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_AE_RejectedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesRejected</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_on_Current_Status_is_Rejected</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Check if current status changed from pending to rejected</label>
        </rules>
        <rules>
            <name>Change_only_the_status_corresponding_to_current_status_value</name>
            <conditionLogic>1 OR 2 OR 3</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_Open</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_only</targetReference>
            </connector>
            <label>Change only the status corresponding to current status value</label>
        </rules>
        <rules>
            <name>Change_only_the_status_for_approved_in_current_status</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_ApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesApprovedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Only_Status_to_Approved</targetReference>
            </connector>
            <label>Change only the status for approved in current status</label>
        </rules>
        <rules>
            <name>Change_only_the_status_if_rejected_in_current_status</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_RejectedStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>c_InsidesSalesRejected</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_only_the_status_field_to_Rejected</targetReference>
            </connector>
            <label>Change only the status if rejected in current status</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_who_has_updated_AE_or_Sales</name>
        <label>check who has updated AE or Sales</label>
        <locationX>849</locationX>
        <locationY>730</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IF_AE_Pending</name>
            <conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>c_AE_PendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_AE_Pending_TimeStamp</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>IF AE Pending</label>
        </rules>
        <rules>
            <name>IF_Sales_Pending</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>c_InsideSalesPendingStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Current_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sales_Pending_TimeStamp</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>IF Sales Pending</label>
        </rules>
    </decisions>
