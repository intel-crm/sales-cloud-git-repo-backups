    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!$Record.Core_AGS_Integration_Status__c} ) ,OR(
ISPICKVAL({!$Record.Core_AGS_Integration_Status__c} , &apos;Failed&apos;) ,
ISPICKVAL({!$Record.Core_AGS_Integration_Status__c} , &apos;Successful&apos;) 

))</expression>
    </formulas>
