<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_all_contact_ids</name>
        <label>Assign all contact ids</label>
        <locationX>138</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>allContactIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>collect_all_contact_ids.Contact.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>collect_all_contact_ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_counter_for_opened_opportunities</name>
        <label>Assign counter for opened opportunities</label>
        <locationX>578</locationX>
        <locationY>1271</locationY>
        <assignmentItems>
            <assignToReference>openOpportunityCounter</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>check_all_opportinities_for_all_contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_3</name>
        <label>Assignment 3</label>
        <locationX>358</locationX>
        <locationY>1655</locationY>
        <assignmentItems>
            <assignToReference>UpdatedContactids</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>check_all_contacts_from_jnction_obj.ContactId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>check_all_contacts_from_jnction_obj</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>check_all_opprotunies_having_closed_stage</name>
        <label>check all opprotunies having closed stage</label>
        <locationX>710</locationX>
        <locationY>1163</locationY>
        <defaultConnector>
            <targetReference>check_all_opportinities_for_all_contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>opportunity_stage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>check_all_opportinities_for_all_contacts.Opportunity.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>check_all_opportinities_for_all_contacts.ContactId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>collect_all_contact_ids.ContactId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_counter_for_opened_opportunities</targetReference>
            </connector>
            <label>opportunity stage</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_closed_opprotunities</name>
        <label>check closed opprotunities</label>
        <locationX>490</locationX>
        <locationY>1547</locationY>
        <defaultConnector>
            <targetReference>check_all_contacts_from_jnction_obj</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>opportunity_count</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>openOpportunityCounter</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_3</targetReference>
            </connector>
            <label>opportunity count</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_opportinity_stage_name</name>
        <label>check opportinity stage name</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>close_stage_in_opportinity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualify</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_opportunity_contact_role_records</targetReference>
            </connector>
            <label>close stage in opportinity</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Contact marketing flag update on opportunity stage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact marketing flag update on opportunity stage</label>
    <loops>
        <name>check_all_contacts_from_jnction_obj</name>
        <label>check all contacts from jnction obj</label>
        <locationX>50</locationX>
        <locationY>947</locationY>
        <collectionReference>get_opportunity_contact_role_records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>check_all_opportinities_for_all_contacts</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_conatct_marketing_field</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>check_all_opportinities_for_all_contacts</name>
        <label>check all opportinities for all contacts</label>
        <locationX>490</locationX>
        <locationY>1055</locationY>
        <collectionReference>get_opportinity_records_from_contactids</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>check_all_opprotunies_having_closed_stage</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>check_closed_opprotunities</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
