    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Core_MDF_Document_Request_Notifications workflow rule
Workflow rule description: This workflow rule is used to send notifications to claim submitter to upload documents before the due date
Reminders on 15th,25th day of document submission due date.&quot;</description>
    <environments>Default</environments>
    <label>Core_MDF_Document_Request_Notifications</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Claim_Status_to_Denied</name>
        <label>Update Claim Status to Denied</label>
        <locationX>314</locationX>
        <locationY>288</locationY>
        <connector>
            <targetReference>Core_MDF_Legacy_Document_Submission_Window_Closed</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_MDF_Status__c</field>
            <value>
                <stringValue>Denied</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Core_MDF_DocUploadRequestImmediateAlert</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Documents</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Legacy_Claim_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Core_MDF_0_Hours_After_Doc_Sub_Due_Date</name>
            <connector>
                <targetReference>Update_Claim_Status_to_Denied</targetReference>
            </connector>
            <label>0 Hours After Doc Sub Due Date</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>Core_MDF_Doc_Hold_Doc_Sub_Due_Date_Dtm__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Core_MDF_15_Days_Before_Doc_Sub_Due_Date</name>
            <connector>
                <targetReference>Core_MDF_DocUploadRequestBefore15DaysAlert</targetReference>
            </connector>
            <label>15 Days Before Doc Sub Due Date</label>
            <offsetNumber>-15</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Core_MDF_Doc_Hold_Doc_Sub_Due_Date_Dtm__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Core_MDF_5_Days_Before_Doc_Sub_Due_Date</name>
            <connector>
                <targetReference>Core_MDF_DocUploadRequestBefore5DaysAlert</targetReference>
            </connector>
            <label>5 Days Before Doc Sub Due Date</label>
            <offsetNumber>-5</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Core_MDF_Doc_Hold_Doc_Sub_Due_Date_Dtm__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
