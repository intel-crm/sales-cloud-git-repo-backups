        {!myVariable_current.Core_MDF_Ineffective_Selection_ind__c} == false,
	{!myVariable_current.Core_MDF_ESD_Hold_Indicator__c},
	ISCHANGED({!myVariable_current.Core_MDF_ESD_Hold_Indicator__c})
)</expression>
    </formulas>
