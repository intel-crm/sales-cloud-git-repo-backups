    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	[Core_MDF_Bank__c].Core_MDF_ESD_Update__c == true, 
        [Core_MDF_Bank__c].Core_MDF_Ineffective_Selection_ind__c == false,
	[Core_MDF_Bank__c].Core_MDF_ESD_Hold_Indicator__c,
	ISCHANGED([Core_MDF_Bank__c].Core_MDF_ESD_Hold_Indicator__c)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
