    <decisions>
        <name>Check_Quota_Setup_Field_Name</name>
        <label>Check Quota Setup Field Name</label>
        <locationX>1480</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_Quota_Setup_Plan_Defaults</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Billings_Revenue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_BR_DCG_Field</targetReference>
            </connector>
            <label>Billings Revenue</label>
        </rules>
        <rules>
            <name>Consumption_Revenue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CR_Uses_Territory_Allocation</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_CR_Fields</targetReference>
            </connector>
            <label>Consumption Revenue</label>
        </rules>
        <rules>
            <name>Wins</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DW</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Wins_field</targetReference>
            </connector>
            <label>Wins</label>
        </rules>
        <rules>
            <name>OW</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OW</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_OW_Field</targetReference>
            </connector>
            <label>OW</label>
        </rules>
    </decisions>
