    <decisions>
        <name>Check_Quota_Setup_Field_Name</name>
        <label>Check Quota Setup Field Name</label>
        <locationX>996</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Billings_Revenue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_BR_All_Field</targetReference>
            </connector>
            <label>Billings Revenue</label>
        </rules>
        <rules>
            <name>Consumer_Revenue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_CR_Fields</targetReference>
            </connector>
            <label>Consumer Revenue</label>
        </rules>
        <rules>
            <name>Sales_Team_Goal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Quota_Setup_Plan_Defaults.CPT_Sales_KPI_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>STG</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_STG_Field_Default_Plan</targetReference>
            </connector>
            <label>Sales Team Goal</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_STG_Field_Default_Plan</name>
