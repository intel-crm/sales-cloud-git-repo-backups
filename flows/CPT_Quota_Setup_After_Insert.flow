    <description>[24/Nov/25] [08:00 PM] Flow to populate the plan on the quota setup record whenever the new record is created + Default Value + Test Case</description>
    <environments>Default</environments>
    <interviewLabel>CPT Quota Setup - After Insert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CPT Quota Setup - After Insert</label>
    <loops>
        <name>Loop_Over_Quota_Setup_Plan_Defaults</name>
        <label>Loop Over Quota Setup Plan Defaults</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <collectionReference>Get_Quota_Setup_Plan_Defaults</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Quota_Setup_Field_Name</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Quota_Setup_Fields_with_Default_Value</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quota_Setup_Plan_Defaults</name>
        <label>Get Quota Setup Plan Defaults</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Over_Quota_Setup_Plan_Defaults</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CPT_Plan__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>CPT_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CPT_Quota_Setup_Plan_Default__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>CPT_Populate_Plan_Value</name>
        <label>Populate Plan Value &amp; Owner</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Get_Quota_Setup_Plan_Defaults</targetReference>
        </connector>
        <inputAssignments>
            <field>CPT_Plan__c</field>
            <value>
                <elementReference>$Record.CPT_Employee__r.CPT_Sales_Compensation_Plan__r.CPT_Plan_Number__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.CPT_Employee__r.CPT_Manager__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Quota_Setup_Fields_with_Default_Value</name>
        <label>Update Quota Setup Fields with Default Value</label>
        <locationX>50</locationX>
        <locationY>1331</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CPT_Check_if_Employee_Record_has_Plan</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CPT_Employee__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>CPT_Quota_Setup__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>AssignDefaultPlanRecordsList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>CPT_Quota_Setup__c</objectType>
    </variables>
</Flow>
