    <description>[Vats 25/nov/2026] Flow to populate the plan on the quota setup record whenever the new record is created + Default Value</description>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>490</locationX>
        <locationY>431</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_6</name>
        <locationX>182</locationX>
        <locationY>2039</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>CR_Uses_Territory_Allocation</name>
        <dataType>Boolean</dataType>
        <expression>CASE(
    TEXT({!$Record.CPT_Plan__c}),
    &quot;120&quot;, 1,
    &quot;122&quot;, 1,
    &quot;240&quot;, 1,
    &quot;250&quot;, 1,
    &quot;330&quot;, 1,
    &quot;331&quot;, 1,
    &quot;620&quot;, 1,
    &quot;630&quot;, 1,
    &quot;631&quot;, 1,
    &quot;640&quot;, 1,
    &quot;650&quot;, 1,
    0
) = 1</expression>
    </formulas>
    <formulas>
        <name>Fixed_BR_DCG_Percentage</name>
        <dataType>String</dataType>
        <expression>CASE(
    TEXT({!$Record.CPT_Plan__c}),
    &quot;250&quot;, &quot;40%&quot;,
    &quot;330&quot;, &quot;20%&quot;,
    &quot;630&quot;, &quot;20%&quot;,
    &quot;650&quot;, &quot;20%&quot;,
    &quot;0%&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Initial_CR_OEM_Percentage</name>
        <dataType>String</dataType>
        <expression>CASE(
    TEXT({!$Record.CPT_Plan__c}),
    &quot;250&quot;, &quot;60%&quot;,
    &quot;330&quot;, &quot;30%&quot;,
    &quot;620&quot;, &quot;20%&quot;,
    &quot;630&quot;, &quot;40%&quot;,
    &quot;0%&quot;
)</expression>
    </formulas>
    <interviewLabel>CPT Quota Setup - After Insert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CPT Quota Setup - After Insert</label>
    <loops>
        <name>Loop_Over_Quota_Setup_Plan_Defaults</name>
