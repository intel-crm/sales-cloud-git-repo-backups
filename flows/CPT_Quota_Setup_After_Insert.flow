            </connector>
            <label>Is STG Field &amp; Default Plan Value ?</label>
        </rules>
    </decisions>
    <decisions>
        <description>...###</description>
        <name>CPT_Check_if_Employee_Record_has_Plan</name>
        <label>Check if Employee Record has Plan</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CPT_Employee_has_the_Plan</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CPT_Employee__r.CPT_Sales_Compensation_Plan__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPT_Populate_Plan_Value</targetReference>
            </connector>
            <label>Employee has the Plan</label>
        </rules>
    </decisions>
