<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Final_Values_Assignment</name>
        <label>Final Values Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAdjustment.Core_MDF_Reason_Cd__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Adjustment_Reason</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAdjustment.Core_MDF_Amount_Amt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Adjustment_Amount_USD</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAdjustment.Core_MDF_Adjustment_Status_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAdjustment.Core_MDF_Sub_Claim_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Account_node</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Adjustment_Request</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Reference_Claim_Id</name>
        <label>Set Reference Claim Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAdjustment.Core_MDF_Reference_Claim_Nbr__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedReferenceClaimId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Claim_Details</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>update_Selected_Reference_Claim</name>
        <label>update Selected Reference Claim</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>selectedRefClaim.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Claim_Details.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>selectedRefClaim.Core_MDF_Has_Sub_Claims_Ind__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Claim_Details.Core_MDF_Has_Sub_Claims_Ind__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>selectedRefClaim.Title</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Claim_Details.Title</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>selectedRefClaim.Core_MDF_Claim_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Claim_Details.Core_MDF_Claim_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Has_Sub_Claims</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>update_Selected_Reference_Claim_for_Non_IPA</name>
        <label>update Selected Reference Claim for Non IPA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>selectedRefClaim.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Claim_Details.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>selectedRefClaim.Title</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Claim_Details.Title</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>selectedRefClaim.Core_MDF_Has_Sub_Claims_Ind__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>selectedRefClaim.Core_MDF_Claim_Id__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Has_Sub_Claims</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Ref_Claim_Prog</name>
        <label>Check Ref Claim Prog</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>update_Selected_Reference_Claim_for_Non_IPA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non IPA</defaultConnectorLabel>
        <rules>
            <name>IPA_Account_Plan</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Claim_Details.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Partner Alliance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Claim_Details.Core_MDF_Budget_Type_Options_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Account Plan</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_Selected_Reference_Claim</targetReference>
            </connector>
            <label>IPA Account Plan</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_User_Access</name>
        <label>check User Access</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>ErrorScreenForAccess</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>AccessNotPresent</defaultConnectorLabel>
        <rules>
            <name>AccessPresent</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Core_MDF_FinanceMgr_FinanceUser_ClaimCaseRev_ClaimCaseMgr</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.CCP_L3_Maintenance</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Claim_Adjustment_Request</targetReference>
            </connector>
            <label>AccessPresent</label>
        </rules>
    </decisions>
    <decisions>
        <name>DoesSubClaimsExists</name>
        <label>DoesSubClaimsExists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Screen_for_Sub_Claims_Not_Present</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sub Claims Doesn&apos;t Exists</defaultConnectorLabel>
        <rules>
            <name>Sub_Claims_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sub_Claim</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Final_Screen</targetReference>
            </connector>
            <label>Sub Claims Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Sub_Claims</name>
        <label>Has Sub Claims</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Final_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Sub Claims</defaultConnectorLabel>
        <rules>
            <name>Has_Sub_Claims_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>refClaimHasSubClaims</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sub_Claim</targetReference>
            </connector>
            <label>Has Sub Claims</label>
        </rules>
        <rules>
            <name>if_Ref_Claim_is_a_Sub_Claim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>refClaimIsSubClaim</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ErrorScreenForSubClaimSelection</targetReference>
            </connector>
            <label>if Ref Claim is a Sub Claim</label>
        </rules>
    </decisions>
    <decisions>
        <name>is_Ref_Claim_Name_Selected</name>
        <label>is Ref Claim Name Selected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>ErrorScreenForRefClaimNameSelection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Selected</defaultConnectorLabel>
        <rules>
            <name>Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>referenceClaimIdIsBlank</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Reference_Claim_Id</targetReference>
            </connector>
            <label>Selected</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>AccountNameCollection</name>
        <collectionReference>Get_Sub_Claim</collectionReference>
        <dataType>String</dataType>
        <displayField>Core_MDF_Account_Name_nm__c</displayField>
        <object>PartnerFundClaim</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>AdjustmentReason</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Core_MDF_Reason_Cd__c</picklistField>
        <picklistObject>Core_MDF_Adjustment_Request__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>AdjustmentStatus</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Core_MDF_Adjustment_Status_nm__c</picklistField>
        <picklistObject>Core_MDF_Adjustment_Request__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>FinalErrorMessage</name>
        <dataType>String</dataType>
        <expression>MID(
  $Flow.FaultMessage,
  FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, $Flow.FaultMessage) + 
  LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;),
  FIND(&quot;. You can look up&quot;, $Flow.FaultMessage) - 
  (FIND(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;, $Flow.FaultMessage) + 
  LEN(&quot;FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;))
)</expression>
    </formulas>
    <formulas>
        <name>refClaimHasSubClaims</name>
        <dataType>Boolean</dataType>
        <expression>{!selectedRefClaim.Core_MDF_Has_Sub_Claims_Ind__c}</expression>
    </formulas>
    <formulas>
        <name>refClaimIsSubClaim</name>
        <dataType>Boolean</dataType>
        <expression>{!selectedRefClaim.Core_MDF_Claim_Id__c} != null</expression>
    </formulas>
    <formulas>
        <name>referenceClaimIdIsBlank</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!selectedReferenceClaimId})</expression>
    </formulas>
    <formulas>
        <name>successMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Claim Adjustment Request was created successfully. &quot; &amp;
&quot;&lt;a href=&apos;/lightning/r/Core_MDF_Adjustment_Request__c/&quot; &amp;
{!varAdjustment.Id} &amp;
&quot;/view&apos; target=&apos;_top&apos;&gt;Click here to view the Claim Adjustment Request Record.&lt;/a&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>urlText</name>
        <dataType>String</dataType>
        <expression>&quot;/lightning/r/Core_MDF_Adjustment_Request__c/&quot; &amp; {!varAdjustment.Id} &amp; &quot;/view&quot;</expression>
    </formulas>
    <interviewLabel>Claim Adjustment Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Claim Adjustment Screen Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Adjustment_Request</name>
        <label>Create Adjustment Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <inputReference>varAdjustment</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Claim_Details</name>
        <label>Get Claim Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Ref_Claim_Prog</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAdjustment.Core_MDF_Reference_Claim_Nbr__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PartnerFundClaim</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Sub_Claim</name>
        <label>Get Sub Claim</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DoesSubClaimsExists</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4) AND 5 AND 6</filterLogic>
        <filters>
            <field>Core_MDF_Claim_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>selectedRefClaim.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Payment Due</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Available Fund</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Hold</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Type_Txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Claim</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_VAT_Opt_In__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Service Invoice to Intel (VAT may apply)</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PartnerFundClaim</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>DefaultMode</runInMode>
