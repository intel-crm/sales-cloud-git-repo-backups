        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Call_Script__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>callScriptId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Campaign__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>campaignId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_Contact__c</field>
            <operator>EqualTo</operator>
