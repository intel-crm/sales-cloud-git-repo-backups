    <decisions>
        <description>Verify Partner or PSAM</description>
        <name>Verify_Partner_or_PSAM</name>
        <label>Verify Partner or PSAM</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_Partner</targetReference>
            </connector>
            <label>Is Partner ?</label>
        </rules>
        <rules>
            <name>Is_PSAM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_PSAM</targetReference>
            </connector>
            <label>Is PSAM ?</label>
        </rules>
    </decisions>
    <description>Send Email to Partner or PSAM</description>
    <environments>Default</environments>
    <interviewLabel>PCC_RebateClaimFailureEmail {!$Flow.CurrentDateTime}</interviewLabel>
