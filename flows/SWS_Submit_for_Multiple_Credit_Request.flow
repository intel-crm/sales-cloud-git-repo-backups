    <decisions>
        <name>Check_for_Selected_option</name>
        <label>Check for Selected option</label>
        <locationX>930</locationX>
        <locationY>1058</locationY>
        <defaultConnector>
            <targetReference>Coupon_Details_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Same coupons selected</defaultConnectorLabel>
        <rules>
            <name>Unique_coupons_selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Please_choose_the_required_option</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Unique_Coupons</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Generate_Unique_Coupons_For_Each_Request</targetReference>
            </connector>
            <label>Unique coupons selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_selected_record_count</name>
        <label>check selected record count</label>
        <locationX>1084</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default outcome</defaultConnectorLabel>
        <rules>
            <name>record_count_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ids</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ids</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MessageScreen</targetReference>
            </connector>
            <label>record count null</label>
        </rules>
        <rules>
            <name>record_greater_than_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ids</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ids</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.SWS_IDC_Business_Ops</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Request</targetReference>
            </connector>
            <label>record greater than 0</label>
        </rules>
        <rules>
            <name>User_with_no_access</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.SWS_IDC_Business_Ops</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message</targetReference>
            </connector>
            <label>User with no access</label>
        </rules>
    </decisions>
