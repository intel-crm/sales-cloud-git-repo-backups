<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Extracted_Picklist_Values_to_a_List</name>
        <label>Add Extracted Picklist Values to a List</label>
        <locationX>666</locationX>
        <locationY>1427</locationY>
        <assignmentItems>
            <assignToReference>ExtractedCountryPicklistValues</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Remove_Semicolon_One_Picklist_Value</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Extract_Picklist_Values</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Blank_value_to_Host_Region</name>
        <label>Assign Blank value to Host Region</label>
        <locationX>732</locationX>
        <locationY>2111</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_HostRegion_txt__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Country_Field_to_a_Variable</name>
        <label>Assign Country Field to a Variable</label>
        <locationX>534</locationX>
        <locationY>1103</locationY>
        <assignmentItems>
            <assignToReference>Country_MultiSelect_Picklist_Values</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Country_Region_nm__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Format_Multiselect_Picklist_Values</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Exception_Status</name>
        <label>Assign Exception Status</label>
        <locationX>110</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Exception_Status_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending Review</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Expose_Externally_ind__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_for_Co_GTM_Exception_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Set status of exception to draft</description>
        <name>Assign_Exception_Status_Darft</name>
        <label>Assign Exception Status - Darft</label>
        <locationX>374</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Exception_Status_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Expose_Externally_ind__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_for_Co_GTM_Exception_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Geo</name>
        <label>Assign Geo</label>
        <locationX>490</locationX>
        <locationY>1643</locationY>
        <assignmentItems>
            <assignToReference>Country_Region</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Region_Country</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_on_Country_Geo_Mapping_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Region_Field</name>
        <label>Assign Region Field</label>
        <locationX>402</locationX>
        <locationY>1835</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Region_txt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Country_Region</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Blank_value_to_Host_Region</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Region_with_all_geos</name>
        <label>Assign Region with all geos</label>
        <locationX>930</locationX>
        <locationY>1103</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Region_txt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>All_Country_Region</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Blank_value_to_Host_Region</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Extract_Picklist_Values</name>
        <label>Extract Picklist Values</label>
        <locationX>666</locationX>
        <locationY>1535</locationY>
        <assignmentItems>
            <assignToReference>Formatted_Picklist_Values</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Remove_One_Picklist_Value</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Check_all_Values_are_Parsed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Format_Multiselect_Picklist_Values</name>
        <label>Format Multiselect Picklist Values</label>
        <locationX>534</locationX>
        <locationY>1211</locationY>
        <assignmentItems>
            <assignToReference>Formatted_Picklist_Values</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Picklist_Value_Add_Semicolon</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_all_Values_are_Parsed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Select_All_Country_to_True</name>
        <label>Set Select All Country to True</label>
        <locationX>50</locationX>
        <locationY>887</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Select_All_Country_ind__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Set status to pending review</description>
        <name>Set_status_as_pending_review</name>
        <label>Set status as pending review</label>
        <locationX>638</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Exception_Status_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending Review</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_for_Co_GTM_Exception_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_all_Values_are_Parsed</name>
        <label>Check all Values are Parsed</label>
        <locationX>534</locationX>
        <locationY>1319</locationY>
        <defaultConnector>
            <targetReference>Add_Extracted_Picklist_Values_to_a_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Parsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Formatted_Picklist_Values</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Country_Geo_Mapping_Records</targetReference>
            </connector>
            <label>Parsed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_based_on_All_Country</name>
        <label>Check based on All Country</label>
        <locationX>732</locationX>
        <locationY>995</locationY>
        <defaultConnector>
            <targetReference>Assign_Region_with_all_geos</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Select All Country is True</defaultConnectorLabel>
        <rules>
            <name>Select_All_Country_is_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Select_All_Country_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Country_Field_to_a_Variable</targetReference>
            </connector>
            <label>Select All Country is False</label>
        </rules>
    </decisions>
    <decisions>
        <description>For Co-GTM Program set Select all country value always to true</description>
        <name>Check_for_Co_GTM_Exception_Record</name>
        <label>Check for Co-GTM Exception Record</label>
        <locationX>506</locationX>
        <locationY>779</locationY>
        <defaultConnector>
            <targetReference>Check_for_IPA_Exception_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Programs</defaultConnectorLabel>
        <rules>
            <name>Co_GTM_Program</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Co_GTM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Select_All_Country_to_True</targetReference>
            </connector>
            <label>Co-GTM Program</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_IPA_Exception_Record</name>
        <label>Check for IPA Exception Record</label>
        <locationX>963</locationX>
        <locationY>887</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Region</name>
            <conditionLogic>(1 OR (2 AND (3 OR 4))) AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_MDF_Country_Region_nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Country_Region_nm__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_MDF_Select_All_Accounts_ind__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Select_All_Accounts_ind__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Select_All_Accounts_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Intel_Partner_Alliance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_based_on_All_Country</targetReference>
            </connector>
            <label>Update Region</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_New_Record</name>
        <label>Check for New Record</label>
        <locationX>506</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Check_if_all_account_is_true_when_status_is_draft</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Exception_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Exception_status_to_Draft_or_Pending_Review</targetReference>
            </connector>
            <label>New Exception Record</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if all account is true when status is draft</description>
        <name>Check_if_all_account_is_true_when_status_is_draft</name>
        <label>Check if all account is true when status is draft</label>
        <locationX>770</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Check_for_Co_GTM_Exception_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>All_Account_as_true_and_status_as_draft</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Select_All_Accounts_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Exception_Status_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_status_as_pending_review</targetReference>
            </connector>
            <label>All Account as true and status as draft</label>
        </rules>
    </decisions>
    <decisions>
        <description>Set status to draft if all account is false while creating an exception</description>
        <name>Set_Exception_status_to_Draft_or_Pending_Review</name>
        <label>Set Exception status to Draft or Pending Review</label>
        <locationX>242</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Assign_Exception_Status_Darft</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Set_Status_to_Draft</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Select_All_Accounts_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Exception_Status</targetReference>
            </connector>
            <label>Set Status to Pending Review</label>
        </rules>
    </decisions>
    <description>Populates Region and Host Region field for IPA Exceptions</description>
    <environments>Default</environments>
    <formulas>
        <name>Picklist_Value_Add_Semicolon</name>
        <dataType>String</dataType>
        <expression>{!Country_MultiSelect_Picklist_Values} + &quot;;&quot;</expression>
    </formulas>
    <formulas>
        <name>Region_Country</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Country_Region}), {!Loop_on_Country_Geo_Mapping_Records.Core_MDF_Geo__c},
IF(CONTAINS({!Country_Region}, {!Loop_on_Country_Geo_Mapping_Records.Core_MDF_Geo__c}),{!Country_Region}, ({!Country_Region} &amp; &apos;,&apos; &amp;{!Loop_on_Country_Geo_Mapping_Records.Core_MDF_Geo__c}))
)</expression>
    </formulas>
    <formulas>
        <name>Remove_One_Picklist_Value</name>
        <dataType>String</dataType>
        <expression>TRIM(
     SUBSTITUTE({!Formatted_Picklist_Values}, {!Remove_Semicolon_One_Picklist_Value}+&quot;;&quot;, &quot;&quot;)
 )</expression>
    </formulas>
    <formulas>
        <name>Remove_Semicolon_One_Picklist_Value</name>
        <dataType>String</dataType>
        <expression>TRIM( 
     LEFT(
              {!Formatted_Picklist_Values} , 
              FIND(
                     &quot;;&quot;,{!Formatted_Picklist_Values}
             ) - 1
       ) 
 )</expression>
    </formulas>
    <interviewLabel>Core_MDF_Exception_Before_Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_MDF_Exception_Before_Trigger</label>
    <loops>
        <name>Loop_on_Country_Geo_Mapping_Records</name>
        <label>Loop on Country Geo Mapping Records</label>
        <locationX>402</locationX>
        <locationY>1535</locationY>
        <collectionReference>Country_Geo_Mapping_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Geo</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Assign_Region_Field</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Country_Geo_Mapping_Records</name>
        <label>Get Country Geo Mapping Records</label>
        <locationX>402</locationX>
        <locationY>1427</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_on_Country_Geo_Mapping_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>MasterLabel</field>
            <operator>In</operator>
            <value>
                <elementReference>ExtractedCountryPicklistValues</elementReference>
            </value>
        </filters>
        <object>Core_MDF_CCP_Country_Geo_Mapping__mdt</object>
        <outputReference>Country_Geo_Mapping_Records</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>MasterLabel</queriedFields>
        <queriedFields>Core_MDF_Geo__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>380</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_New_Record</targetReference>
        </connector>
        <object>Core_MDF_Exception__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>All_Country_Region</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>EMEA,PRC,ASMO,APJ,INDIA</text>
    </textTemplates>
    <variables>
        <name>Country_Geo_Mapping_Records</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_CCP_Country_Geo_Mapping__mdt</objectType>
    </variables>
    <variables>
        <name>Country_MultiSelect_Picklist_Values</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Country_Region</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>ExtractedCountryPicklistValues</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Formatted_Picklist_Values</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
