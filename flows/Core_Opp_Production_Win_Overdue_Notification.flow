<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>sp1Core_Opp_Send_Production_Win_Overdue_Notification_EmailAlert</name>
        <label>Opportunity.Core_Opp_Send_Production_Win_Overdue_Notification_EmailAlert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Opportunity.Core_Opp_Send_Production_Win_Overdue_Notification_EmailAlert</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Opportunity.Core_Opp_Send_Production_Win_Overdue_Notification_EmailAlert</nameSegment>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Core_Opp_Production_Win_Overdue_Notification workflow rule
Workflow rule description: US54796:OPPTY Production Tracking: Production Win Notification - Send notification (Production Win Overdue Notification) to Opportunity Owner and copy the Opportunity Owner&apos;s Manager when it is 7 days after the First Customer Ship Date.&quot;</description>
    <label>Core_Opp_Production_Win_Overdue_Notification</label>
    <migratedFromWorkflowRuleName>Core_Opp_Production_Win_Overdue_Notification</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updates the &quot;System Owners Manager&quot; field with the email of Owner&apos;s Manager.</description>
        <name>mainUpdate</name>
        <label>mainUpdate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Core_System_Owners_Manager__c</field>
            <value>
                <elementReference>$Record.Owner.Manager.Email</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>mainUpdate</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Design Win</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Opportunity_Type__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Design</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Product_Segment__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Embedded</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>ScheduledPath1</name>
            <connector>
                <targetReference>sp1Core_Opp_Send_Production_Win_Overdue_Notification_EmailAlert</targetReference>
            </connector>
            <label>ScheduledPath1</label>
            <offsetNumber>7</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Core_First_Customer_Ship_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
