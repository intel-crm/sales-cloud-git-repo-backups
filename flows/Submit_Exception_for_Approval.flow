    <decisions>
        <description>Check For IPA Program</description>
        <name>Check_For_IPA_Program</name>
        <label>Check For IPA Program</label>
        <locationX>182</locationX>
        <locationY>575</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Email_Notification_For_IPA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Intel_Partner_Alliance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approver_Email_Notification</targetReference>
            </connector>
            <label>Email Notification For IPA</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check For IPA Program</description>
        <name>Check_For_IPA_Program_Clone</name>
        <label>Check For IPA Program Clone</label>
        <locationX>622</locationX>
        <locationY>695</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Email_Notification_for_IPA_Clone</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Intel_Partner_Alliance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approver_Email_Notification_Clone</targetReference>
            </connector>
            <label>Email Notification for IPA Clone</label>
        </rules>
    </decisions>
    <decisions>
        <name>Submit_Exception_for_Review</name>
        <label>Submit Exception for Review</label>
        <locationX>688</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Exception_is_New_and_Status_is_Pending_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Exception_Creation_to_Launch_Ap</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_Exception_For_Approval</targetReference>
            </connector>
            <label>If Exception is New and Status is Pending Review</label>
        </rules>
        <rules>
            <name>If_Exception_is_Cloned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Exception_Clone_Launch_AP</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Excption_Status_On_Clone</targetReference>
            </connector>
            <label>If Exception is Cloned</label>
        </rules>
        <rules>
            <name>If_Exception_Status_is_changes_to_Approved_Denied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Exception_Status_is_changes_to_Approved_Denied</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Exception_Approvers_Comment</targetReference>
            </connector>
            <label>If Exception Status is changes to Approved/Denied</label>
        </rules>
    </decisions>
    <description>Flow to trigger approval process</description>
    <environments>Default</environments>
    <formulas>
        <name>Exception_Clone_Launch_AP</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISNEW(),NOT(ISPICKVAL({!$Record.Core_MDF_Exception_Status_nm__c}, &apos;Pending Review&apos;)))</expression>
    </formulas>
    <formulas>
        <name>Exception_Creation_to_Launch_Ap</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISNEW(),ISPICKVAL({!$Record.Core_MDF_Exception_Status_nm__c}, &apos;Pending Review&apos;))</expression>
    </formulas>
    <formulas>
        <description>If Exception Status is changes to Approved/Denied</description>
        <name>Exception_Status_is_changes_to_Approved_Denied</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISNEW()),ISCHANGED({!$Record.Core_MDF_Exception_Status_nm__c}),OR(ISPICKVAL({!$Record.Core_MDF_Exception_Status_nm__c}, &apos;Approved&apos;),ISPICKVAL({!$Record.Core_MDF_Exception_Status_nm__c}, &apos;Denied&apos;)))</expression>
    </formulas>
    <interviewLabel>Submit Exception for Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Submit Exception for Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Excption_Status_On_Clone</name>
        <label>Update_Excption_Status_On_Clone</label>
        <locationX>622</locationX>
        <locationY>455</locationY>
        <connector>
            <targetReference>Submit_exception_for_approval_clone</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_MDF_Exception_Status_nm__c</field>
            <value>
