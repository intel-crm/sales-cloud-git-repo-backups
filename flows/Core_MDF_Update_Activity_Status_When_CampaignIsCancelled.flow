    <decisions>
        <name>Submit_Intel_MDF_Proposal_Based_Campaign_for_Approval</name>
        <label>Submit Intel MDF Proposal Based Campaign for Approval</label>
        <locationX>1229</locationX>
        <locationY>559</locationY>
        <defaultConnector>
            <targetReference>Set_PFR_as_Declined_on_L1_Approval_Rejection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Submit_Intel_MDF_Proposal_Based_Campaign_forApproval</name>
            <conditionLogic>1 AND ((2 AND 3) OR (4 AND 5)) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Channel_MDF</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_IPA_Approval_Status_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Approval</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_IPA_Priority_nm__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Proposal_Based_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Proposal_Submit</targetReference>
            </connector>
            <label>Submit Intel MDF Proposal Based Campaign forApproval</label>
        </rules>
    </decisions>
    <decisions>
        <name>Submit_IPA_Campaign_for_Approval</name>
        <label>Submit IPA Campaign for Approval</label>
        <locationX>1019</locationX>
        <locationY>447</locationY>
        <defaultConnector>
            <targetReference>Submit_Intel_MDF_Proposal_Based_Campaign_for_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Submit_IPA_Campaign_forApproval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SubmitIPACampaignforApproval</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_IPA_Campaign_For_Approval_process</targetReference>
            </connector>
            <label>Submit IPA Campaign forApproval</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>checkIPAnotification</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Status},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL({!$Record__Prior.Status},&apos;Pending Approval&apos;))&amp;&amp;
(ISPICKVAL({!$Record.Core_MDF_Program__c} ,&apos;Intel Partner Alliance&apos;)||ISPICKVAL({!$Record.Core_MDF_Program__c} ,&apos;Channel MDF&apos;)) &amp;&amp; (ISPICKVAL({!$Record__Prior.Status},&apos;Pending Review&apos;)||(Not(ISPICKVAL({!$Record__Prior.Core_MDF_Approval_Stage_nm__c},&apos;L1 Approval&apos;))&amp;&amp; {!$Record.Core_MDF_Approval_Step_Counter_nbr__c} = 1))</expression>
    </formulas>
    <formulas>
        <name>NotifyCMDFUsersonProposalRejection</name>
        <dataType>Boolean</dataType>
        <expression>(ISPICKVAL({!$Record.Core_MDF_Program__c} , &apos;Channel MDF&apos;) &amp;&amp; {!$Record.Core_MDF_Proposal_Based_Ind__c} == true)  &amp;&amp;
ISCHANGED({!$Record.Status}) &amp;&amp;
ISPICKVAL({!$Record.Status} ,  &apos;Revision Required&apos;) &amp;&amp;
(TEXT(PRIORVALUE({!$Record.Status})) = &quot;Pending Review&quot; ||
TEXT(PRIORVALUE({!$Record.Status})) = &quot;Pending Approval&quot;)</expression>
    </formulas>
    <formulas>
        <name>NotifyIPAUsersonProposalRejection</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Core_MDF_Program__c} , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
ISCHANGED({!$Record.Status}) &amp;&amp;
ISPICKVAL({!$Record.Status} ,  &apos;Revision Required&apos;) &amp;&amp;
(TEXT(PRIORVALUE({!$Record.Status})) = &quot;Pending Review&quot; ||
TEXT(PRIORVALUE({!$Record.Status})) = &quot;Pending Approval&quot;)</expression>
    </formulas>
    <formulas>
        <name>PendingApprovalIPACampaign</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Status},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!$Record.Status}),&apos;Pending Approval&apos;))&amp;&amp;
(ISPICKVAL({!$Record.Core_MDF_Program__c} ,&apos;Intel Partner Alliance&apos;)||ISPICKVAL({!$Record.Core_MDF_Program__c} ,&apos;Channel MDF&apos;)) &amp;&amp; (ISPICKVAL(PRIORVALUE({!$Record.Status}),&apos;Pending Review&apos;)||(Not(ISPICKVAL(PRIORVALUE({!$Record.Core_MDF_Approval_Stage_nm__c}),&apos;L1 Approval&apos;))&amp;&amp; {!$Record.Core_MDF_Approval_Step_Counter_nbr__c} = 1))</expression>
    </formulas>
    <formulas>
        <name>SetPFRasDeclinedonL1Approval_Rejection</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Core_MDF_Program__c} , &apos;Intel Partner Alliance&apos;)  &amp;&amp;
(ISCHANGED({!$Record.Core_MDF_Approval_Step_Counter_nbr__c} ) &amp;&amp;
({!$Record.Core_MDF_Approval_Step_Counter_nbr__c} == 1) ||
({!$Record.Core_MDF_Approval_Step_Counter_nbr__c} == 0 &amp;&amp;
ISPICKVAL({!$Record.Status , &apos;Revision Required&apos;}) &amp;&amp;
PRIORVALUE({!$Record.Core_MDF_Approval_Step_Counter_nbr__c}) ==0 ))</expression>
    </formulas>
    <formulas>
        <name>SubmitIPACampaignforApproval</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Core_MDF_Program__c},&apos;Intel Partner Alliance&apos;) &amp;&amp; (((ISPICKVAL({!$Record.Status},&apos;Pending Review&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!$Record.Status}),&apos;Pending Review&apos;))) ||(ISPICKVAL({!$Record.Status},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!$Record.Status}),&apos;Pending Approval&apos;)) &amp;&amp; {!$Record.Core_MDF_Approval_Step_Counter_nbr__c} = 1 &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!$Record.Core_MDF_Approval_Stage_nm__c}),&apos;L1 Approval&apos;)))) || (ISPICKVAL({!$Record.Core_MDF_IPA_Approval_Status_nm__c},&apos;Pending Approval&apos;) &amp;&amp; Not(ISPICKVAL(PRIORVALUE({!$Record.Core_MDF_IPA_Approval_Status_nm__c}),&apos;Pending Approval&apos;))))</expression>
    </formulas>
