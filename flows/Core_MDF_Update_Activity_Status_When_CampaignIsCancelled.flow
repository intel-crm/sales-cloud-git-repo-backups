    <decisions>
        <name>Cancel_IPA_Campaign</name>
        <label>Cancel IPA Campaign</label>
        <locationX>824</locationX>
        <locationY>441</locationY>
        <defaultConnector>
            <targetReference>Submit_IPA_Campaign_for_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Cancel_IPACampaign</name>
            <conditionLogic>(1 OR (4 AND 5)) AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Partner Alliance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Proposal_Based_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Channel MDF</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recall_Approval</targetReference>
            </connector>
            <label>Cancel IPACampaign</label>
        </rules>
    </decisions>
    <decisions>
        <name>Cancel_MDF_RMF_Campaigns</name>
        <label>Cancel MDF/RMF Campaigns</label>
        <locationX>620</locationX>
        <locationY>434</locationY>
        <defaultConnector>
