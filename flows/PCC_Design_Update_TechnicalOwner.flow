    <status>Active</status>
    <textTemplates>
        <name>PCC_EmailBody_To_EndCstAccOwner</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;Hello,&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;The following Design Registration has been&amp;nbsp;&lt;/span&gt;&lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&gt;Assigned&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;to you&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&gt;Registration Number:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;{!recordId.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&gt;Design Registration Name:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;{!recordId.Core_Design_Registration_Nm__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&gt;Partner Account:&amp;nbsp;&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;{!recordId.Core_Partner_Account_Nm__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&gt;End Customer Name:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;{!EndCstName}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&gt;End Customer Country:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;{!EnsCstCountry}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&gt;End Customer State:&lt;/strong&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&amp;nbsp;{!EndCstState}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;For more details, you can access it by clicking on this &lt;a href=&quot;{!GET_InternalLink.Value__c}{!recordId}&quot;&gt;link&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;Thank you.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Calibri, sans-serif;&quot;&gt;_______________________________________________________________________&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 7.5pt; font-family: &amp;quot;Intel Clear Light&amp;quot;, sans-serif; color: rgb(102, 102, 102);&quot;&gt;This message contains Intel Confidential information and should be handled in accordance with your Non-Disclosure Agreement (NDA) with Intel. Access to this e-mail by anyone other than the intended recipient is unauthorized. If you are not the intended recipient (or responsible for delivery of the message to such person), you may not use, copy, distribute, or deliver this message or any part of its contents or take any action in reliance on it, and in such case, you should destroy this message.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 7.5pt; font-family: &amp;quot;Intel Clear Light&amp;quot;, sans-serif; color: rgb(102, 102, 102);&quot;&gt;Copyright ©Intel Corporation. All rights reserved. Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054-1549 USA&amp;nbsp;&lt;/span&gt;&lt;a href=&quot;http://www.intel.com/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 7.5pt; font-family: &amp;quot;Intel Clear Light&amp;quot;, sans-serif;&quot;&gt;www.intel.com&lt;/a&gt;&lt;span style=&quot;font-size: 7.5pt; font-family: &amp;quot;Intel Clear Light&amp;quot;, sans-serif; color: rgb(102, 102, 102);&quot;&gt;&amp;nbsp;(408) 765-8080&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>PCC_EmailBody_To_EndCstAccOwner_ifLookUP</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;p&gt;&amp;lt;p&amp;gt;&amp;lt;span style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;Hello,&amp;lt;/span&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;p&amp;gt;&amp;lt;br&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;p&amp;gt;&amp;lt;span style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;The following Design Registration has been&amp;amp;nbsp;&amp;lt;/span&amp;gt;&amp;lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;Assigned&amp;lt;/strong&amp;gt;&amp;lt;span style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;&amp;amp;nbsp;to you&amp;lt;/span&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;p&amp;gt;&amp;lt;br&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;p&amp;gt;&amp;lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;Registration Number:&amp;lt;/strong&amp;gt;&amp;lt;span style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;&amp;amp;nbsp;{!recordId.Name}&amp;lt;/span&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;p&amp;gt;&amp;lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;Design Registration Name:&amp;lt;/strong&amp;gt;&amp;lt;span style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;&amp;amp;nbsp;{!recordId.Core_Design_Registration_Nm__c}&amp;lt;/span&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;p&amp;gt;&amp;lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;Partner Account:&amp;amp;nbsp;&amp;lt;/strong&amp;gt;&amp;lt;span style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;{!recordId.Core_Partner_Account_Nm__c}&amp;lt;/span&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;p&amp;gt;&amp;lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;End Customer Name:&amp;lt;/strong&amp;gt;&amp;lt;span style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;&amp;amp;nbsp;{!recordId.PCC_EndCustomerAcc_Mapping__r.Name}&amp;lt;/span&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;p&amp;gt;&amp;lt;strong style=&quot;font-family: Arial, sans-serif;&quot;&amp;gt;End Customer Country:&amp;lt;/strong&amp;gt;&amp;lt;span style=&quot;font-family: Arial, sans