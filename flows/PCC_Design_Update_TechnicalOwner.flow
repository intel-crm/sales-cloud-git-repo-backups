    <decisions>
        <name>Check_the_status_of_DR_and_EndCstAccount</name>
        <label>Check the status of DR and EndCstAccount</label>
        <locationX>1106</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>DR_is_Eligible_for_Change_technical_owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DR_is_eligible_for_TransferOwnership</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.Core_Design_Registration_Status_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Design accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.Core_Product_Group_Nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Embedded/IOT</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ConsumeUserDetailsFromApprover</targetReference>
            </connector>
            <label>DR is eligible for TransferOwnership</label>
        </rules>
    </decisions>
    <decisions>
        <name>PCC_CheckUserType</name>
        <label>PCC_CheckUserType</label>
        <locationX>578</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>ShowIfUserSelectedIsNotInternal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_User_is_Internal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_DDR_PS.assigneeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>PCC_GetUser.recordId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Technical_Owner</targetReference>
            </connector>
            <label>If User is Internal</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>EndCstName</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!recordId.PCC_EndCustomerAcc_Mapping__r.Name})),{!recordId.PCC_EndCustomerAcc_Mapping__r.Name},{!recordId.Core_End_Customer_Nm__c})</expression>
    </formulas>
    <formulas>
        <name>EndCstState</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!recordId.PCC_EndCustomerAcc_Mapping__c})),{!recordId.PCC_EndCustomerAcc_Mapping__r.PCC_End_Customer_State_Nm__c},{!recordId.Core_End_Customer_Country_Subdivision_Nm__c})</expression>
    </formulas>
    <formulas>
        <name>EnsCstCountry</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK(TEXT({!recordId.PCC_EndCustomerAcc_Mapping__r.PCC_End_Customer_Account_Id__r.BillingCountryCode}))),TEXT({!recordId.PCC_EndCustomerAcc_Mapping__r.PCC_End_Customer_Account_Id__r.BillingCountryCode}),TEXT({!recordId.PCC_End_Customer_Country__c}))</expression>
    </formulas>
