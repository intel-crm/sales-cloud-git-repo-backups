    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND( 
    NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)),
    [Case].Core_IPS_Is_Notification_Active__c = TRUE,
              
OR(
   ([Case].RecordType.developerName = $Label.Core_IPS_CaseCreateRecordType_Name),
   ([Case].RecordType.developerName = $Label.Core_IPS_GECRecordTypeName),
   ([Case].RecordType.developerName = $Label.Core_IPS_NoAssignedContactRecordType_Name)
),                                                    
                 
OR(ISPICKVAL([Case].Status, &apos;New&apos;), ISPICKVAL([Case].Status, &apos;On Hold&apos;)
),

ISNEW( ),

IF(LEFT([Case].OwnerId, 3) == &apos;005&apos;  , TRUE, NOT(CONTAINS($Label.Core_IPS_Case_Q_Exclude_Asgnmt_Email , [Case].Owner:Queue.DeveloperName ))) ,


/*user active checks on  case OwnerId field added by karthick- US113974*/ 
IF(BEGINS([Case].OwnerId, &quot;005&quot;), [Case].Owner:User.IsActive=true, TRUE)

) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND( 
    NOT(IF(({!$User.ProfileId}={!$Label.Core_IPS_Data_Migration_ProfileId}),true,false)),
    {!myVariable_current.Core_IPS_Is_Notification_Active__c} = TRUE,
              
OR(
   ({!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_IPS_CaseCreateRecordType_Name}),
   ({!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_IPS_GECRecordTypeName}),
   ({!myVariable_current.RecordType.DeveloperName} = {!$Label.Core_IPS_NoAssignedContactRecordType_Name})
),                                                    
                 
OR(ISPICKVAL({!myVariable_current.Status}, &apos;New&apos;), ISPICKVAL({!myVariable_current.Status}, &apos;On Hold&apos;)
),

ISNEW( ),

IF(LEFT({!myVariable_current.OwnerId}, 3) == &apos;005&apos;  , TRUE, NOT(CONTAINS({!$Label.Core_IPS_Case_Q_Exclude_Asgnmt_Email} , {!myVariable_current.Owner:Queue.DeveloperName} ))) ,


/*user active checks on  case OwnerId field added by karthick- US113974*/ 
IF(BEGINS({!myVariable_current.OwnerId}, &quot;005&quot;), {!myVariable_current.Owner:User.IsActive}=true, TRUE)

)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND( 

              NOT(IF(($User.ProfileId=$Label.Core_IPS_Data_Migration_ProfileId),true,false)),

                [Case].Core_IPS_Is_Notification_Active__c = TRUE,
  
         NOT(ISPICKVAL([Case].Core_Sub_Status__c,&apos;Close-Pending&apos;) ), 
  
	 OR(
  
               ([Case].RecordType.developerName=
                                                          $Label.Core_IPS_NoAssignedContactRecordType_Name ),
                 ([Case].RecordType.developerName 
                                                         =$Label.Core_IPS_CaseCreateRecordType_Name),
                 ([Case].RecordType.developerName= 
                                                           $Label.Core_IPS_ClosedCase_RecordType_Name),
                 ([Case].RecordType.developerName=
                                                                           $Label.Core_IPS_GECRecordTypeName) ),


	    OR( ISPICKVAL([Case].Status, &apos;New&apos;),
	            ISPICKVAL([Case].Status, &apos;Open&apos;),
                    ISPICKVAL([Case].Status, &apos;On Hold&apos;)  ) ,
      
              
	        AND(   
                            ISCHANGED([Case].Core_Latest_Comment_Time_Stamp__c),
                             NOT(ISBLANK([Case].Core_Latest_Comment_Time_Stamp__c))
                               
	              ),
                    
                    
             ISPICKVAL([Case].Core_Latest_Case_Comment_Type__c , &apos;Public to Customers&apos; ),

	     /*Active user check on  case owner,co-owner ISO, Co-Owner and interested parties*/ 
	OR(    
		IF(BEGINS([Case].OwnerId, &quot;005&quot;), [Case].Owner:User.IsActive=true, TRUE),
		IF(ISBLANK([Case].Core_Intel_Sup_Owner__c  ), FALSE,[Case].Core_Intel_Sup_Owner__c.IsActive=true),
		IF(ISBLANK([Case].Core_Case_Co_Owner__c ), FALSE, [Case].Core_Case_Co_Owner__c.IsActive=true ),
		[Case].Core_IPS_Count_Int_Interested_Parties__c  &gt; 0 
	)  
  
   ) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_11</name>
        <dataType>Boolean</dataType>
        <expression>AND( 

              NOT(IF(({!$User.ProfileId}={!$Label.Core_IPS_Data_Migration_ProfileId}),true,false)),

                {!myVariable_current.Core_IPS_Is_Notification_Active__c} = TRUE,
  
         NOT(ISPICKVAL({!myVariable_current.Core_Sub_Status__c},&apos;Close-Pending&apos;) ), 
  
	 OR(
  
               ({!myVariable_current.RecordType.DeveloperName}=
                                                          {!$Label.Core_IPS_NoAssignedContactRecordType_Name} ),
                 ({!myVariable_current.RecordType.DeveloperName} 
                                                         ={!$Label.Core_IPS_CaseCreateRecordType_Name}),
                 ({!myVariable_current.RecordType.DeveloperName}= 
                                                           {!$Label.Core_IPS_ClosedCase_RecordType_Name}),
                 ({!myVariable_current.RecordType.DeveloperName}=
                                                                           {!$Label.Core_IPS_GECRecordTypeName}) ),


	    OR( ISPICKVAL({!myVariable_current.Status}, &apos;New&apos;),
	            ISPICKVAL({!myVariable_current.Status}, &apos;Open&apos;),
                    ISPICKVAL({!myVariable_current.Status}, &apos;On Hold&apos;)  ) ,
      
              
	        AND(   
                            ISCHANGED({!myVariable_current.Core_Latest_Comment_Time_Stamp__c}),
                             NOT(ISBLANK({!myVariable_current.Core_Latest_Comment_Time_Stamp__c}))
                               
	              ),
                    
                    
             ISPICKVAL({!myVariable_current.Core_Latest_Case_Comment_Type__c} , &apos;Public to Customers&apos; ),

	     /*Active user check on  case owner,co-owner ISO, Co-Owner and interested parties*/ 
	OR(    
		IF(BEGINS({!myVariable_current.OwnerId}, &quot;005&quot;), {!myVariable_current.Owner:User.IsActive}=true, TRUE),
		IF(ISBLANK({!myVariable_current.Core_Intel_Sup_Owner__c}  ), FALSE,{!myVariable_current.Core_Intel_Sup_Owner__r.IsActive}=true),
		IF(ISBLANK({!myVariable_current.Core_Case_Co_Owner__c} ), FALSE, {!myVariable_current.Core_Case_Co_Owner__r.IsActive}=true ),
		{!myVariable_current.Core_IPS_Count_Int_Interested_Parties__c}  &gt; 0 
	)  
  
   )</expression>
