   ISPICKVAL({!myVariable_old.Status}, &apos;Open&apos;)
   ),

ISCHANGED({!myVariable_old.Core_Case_Co_Owner__c} ),


({!myVariable_old.OwnerId} &lt;&gt; {!myVariable_old.Core_Case_Co_Owner__c}),

             	                


/*Null checks and user active checks on  case owner, Core_Case_Co_Owner__c field added by karthick- US113974*/ 
OR(
        IF(BEGINS({!myVariable_old.OwnerId}, &quot;005&quot;), {!myVariable_old.Owner:User.IsActive}=true, TRUE),
   
         IF(ISBLANK({!myVariable_old.Core_Case_Co_Owner__c} ), FALSE, {!myVariable_old.Core_Case_Co_Owner__r.IsActive}=true )
)


)</expression>
