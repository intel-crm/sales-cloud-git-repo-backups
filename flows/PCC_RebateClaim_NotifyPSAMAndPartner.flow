            <value>
                <elementReference>RecordName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>EmailTemplatePSAM</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Send_Email_to_PSAMs_and_Partner</name>
        <label>Send Email to PSAMs and Partner</label>
        <locationX>490</locationX>
        <locationY>971</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Iterate_on_Partner_Contact</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>EmailId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>RecordName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>EmailContentPSAMContacts</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Contact_Email</name>
        <label>Add Contact Email</label>
        <locationX>490</locationX>
        <locationY>863</locationY>
        <assignmentItems>
            <assignToReference>EmailId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_on_Partner_Contact.Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Email_to_PSAMs_and_Partner</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Verify_if_Partner_or_PSAM</name>
        <label>Verify if Partner or PSAM</label>
        <locationX>358</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_Partners</targetReference>
            </connector>
            <label>Is Partner ?</label>
        </rules>
        <rules>
            <name>Is_PSAM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_PSAM</targetReference>
            </connector>
            <label>Is PSAM ?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PCC_RebateClaim_NotifyPSAMAndPartner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PCC_RebateClaim_NotifyPSAMAndPartner</label>
    <loops>
        <name>Iterate_on_Partner_Contact</name>
        <label>Iterate on Partner Contact</label>
        <locationX>402</locationX>
        <locationY>755</locationY>
        <collectionReference>Get_Partner_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Contact_Email</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
