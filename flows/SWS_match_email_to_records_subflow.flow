    <decisions>
        <name>Check_Opportunities_based_on_Contact</name>
        <label>Check Opportunities based on Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_User_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Assign_Emails_based_on_Opportunity_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Sub_Opportunity_basedon_Contacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
