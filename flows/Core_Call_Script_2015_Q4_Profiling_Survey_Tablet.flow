    <decisions>
        <name>Selling_Tablet</name>
        <label>Selling Tablet?</label>
        <locationX>105</locationX>
        <locationY>311</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Yes_Selling_Tablet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Are_you_selling_Tablet</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Yes</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Profiling_Survey_Tablet_Profiling2</targetReference>
            </connector>
            <label>Yes - Selling Tablet</label>
        </rules>
        <rules>
            <name>No_Not_Selling_Tablet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Are_you_selling_Tablet</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>No</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Profiling_Survey_Tablet_Profiling3</targetReference>
            </connector>
            <label>No - Not Selling Tablet</label>
        </rules>
    </decisions>
