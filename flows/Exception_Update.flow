<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Extracted_Picklist_Values_to_a_List</name>
        <label>Add Extracted Picklist Values to a List</label>
        <locationX>314</locationX>
        <locationY>1127</locationY>
        <assignmentItems>
            <assignToReference>ExtractedCountryPicklistValues</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Remove_Semicolon_One_Picklist_Value</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Extract_Picklist_Values</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Blank_value_to_Host_Region</name>
        <label>Assign Blank value to Host Region</label>
        <locationX>380</locationX>
        <locationY>1811</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_HostRegion_txt__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Country_Field_to_a_Variable</name>
        <label>Assign Country Field to a Variable</label>
        <locationX>182</locationX>
        <locationY>803</locationY>
        <assignmentItems>
            <assignToReference>Country_MultiSelect_Picklist_Values</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Core_MDF_Country_Region_nm__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Format_Multiselect_Picklist_Values</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Exception_Status</name>
        <label>Assign Exception Status</label>
        <locationX>743</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Exception_Status_nm__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending Review</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_for_IPA_Exception_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Host_Region_Field</name>
        <label>Assign Host Region Field</label>
        <locationX>842</locationX>
        <locationY>1019</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_HostRegion_txt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account.Core_Geo__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Region_txt__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Region_Field</name>
        <label>Assign Region Field</label>
        <locationX>50</locationX>
        <locationY>1535</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Region_txt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Country_Region</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Blank_value_to_Host_Region</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Region_with_all_geos</name>
        <label>Assign Region with all geos</label>
        <locationX>578</locationX>
        <locationY>803</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDF_Region_txt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>All_Country_Region</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Blank_value_to_Host_Region</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Value</name>
        <label>Assign Value</label>
        <locationX>138</locationX>
        <locationY>1343</locationY>
        <assignmentItems>
            <assignToReference>Country_Region</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Region_Country</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_on_Country_Geo_Mapping_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Extract_Picklist_Values</name>
        <label>Extract Picklist Values</label>
        <locationX>314</locationX>
        <locationY>1235</locationY>
        <assignmentItems>
            <assignToReference>Formatted_Picklist_Values</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Remove_One_Picklist_Value</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Check_all_Values_are_Parsed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Format_Multiselect_Picklist_Values</name>
        <label>Format Multiselect Picklist Values</label>
        <locationX>182</locationX>
        <locationY>911</locationY>
        <assignmentItems>
            <assignToReference>Formatted_Picklist_Values</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Picklist_Value_Add_Semicolon</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_all_Values_are_Parsed</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_all_Values_are_Parsed</name>
        <label>Check all Values are Parsed</label>
        <locationX>182</locationX>
        <locationY>1019</locationY>
        <defaultConnector>
            <targetReference>Add_Extracted_Picklist_Values_to_a_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Parsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Formatted_Picklist_Values</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Country_Geo_Mapping_Records</targetReference>
            </connector>
            <label>Parsed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_based_on_All_Country</name>
        <label>Check based on All Country</label>
        <locationX>380</locationX>
        <locationY>695</locationY>
        <defaultConnector>
            <targetReference>Assign_Region_with_all_geos</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Select All Country is True</defaultConnectorLabel>
        <rules>
            <name>Select_All_Country_is_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Select_All_Country_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Country_Field_to_a_Variable</targetReference>
            </connector>
            <label>Select All Country is False</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_IPA_Exception_Record</name>
        <label>Check for IPA Exception Record</label>
        <locationX>875</locationX>
        <locationY>587</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Region</name>
            <conditionLogic>(1 OR (2 AND (3 OR 4))) AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_MDF_Country_Region_nm__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Country_Region_nm__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_MDF_Select_All_Accounts_ind__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Select_All_Accounts_ind__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Select_All_Accounts_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Intel_Partner_Alliance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_based_on_All_Country</targetReference>
            </connector>
            <label>Update Region</label>
        </rules>
        <rules>
            <name>Update_Host_Region</name>
            <conditionLogic>(1 OR (2 AND 3)) AND 4 AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_MDF_Account_id__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Core_MDF_Account_id__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Account_id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Select_All_Accounts_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program_nm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core_MDF_Intel_Partner_Alliance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_IPA_Channel_Program_Id</targetReference>
            </connector>
            <label>Update Host Region</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_New_Record</name>
        <label>Check for New Record</label>
        <locationX>875</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Check_for_IPA_Exception_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Exception_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Exception_Status</targetReference>
            </connector>
            <label>New Exception Record</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Geo_Not_Null</name>
        <label>Check Geo Not Null</label>
        <locationX>974</locationX>
        <locationY>911</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Geo_not_null_and_All_Acc_equals_false</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.Core_Geo__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Select_All_Accounts_ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Host_Region_Field</targetReference>
            </connector>
            <label>Geo not null and All Acc equals false</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Picklist_Value_Add_Semicolon</name>
        <dataType>String</dataType>
        <expression>{!Country_MultiSelect_Picklist_Values} + &quot;;&quot;</expression>
    </formulas>
    <formulas>
        <name>Region_Country</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Country_Region}), {!Loop_on_Country_Geo_Mapping_Records.Core_MDF_Geo__c},
IF(CONTAINS({!Country_Region}, {!Loop_on_Country_Geo_Mapping_Records.Core_MDF_Geo__c}),{!Country_Region}, ({!Country_Region} &amp; &apos;,&apos; &amp;{!Loop_on_Country_Geo_Mapping_Records.Core_MDF_Geo__c}))
)</expression>
    </formulas>
    <formulas>
        <name>Remove_One_Picklist_Value</name>
        <dataType>String</dataType>
        <expression>TRIM(
     SUBSTITUTE({!Formatted_Picklist_Values}, {!Remove_Semicolon_One_Picklist_Value}+&quot;;&quot;, &quot;&quot;)
 )</expression>
    </formulas>
    <formulas>
        <name>Remove_Semicolon_One_Picklist_Value</name>
        <dataType>String</dataType>
        <expression>TRIM( 
     LEFT(
              {!Formatted_Picklist_Values} , 
              FIND(
                     &quot;;&quot;,{!Formatted_Picklist_Values}
             ) - 1
       ) 
 )</expression>
    </formulas>
    <interviewLabel>Exception Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Exception Update</label>
    <loops>
        <name>Loop_on_Country_Geo_Mapping_Records</name>
        <label>Loop on Country Geo Mapping Records</label>
        <locationX>50</locationX>
        <locationY>1235</locationY>
        <collectionReference>Country_Geo_Mapping_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Value</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Assign_Region_Field</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>974</locationX>
        <locationY>803</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Geo_Not_Null</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Parent_Fund_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Account_id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Channel_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_IPA_Channel_Program_Id.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_Geo__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Country_Geo_Mapping_Records</name>
        <label>Get Country Geo Mapping Records</label>
        <locationX>50</locationX>
        <locationY>1127</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_on_Country_Geo_Mapping_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>MasterLabel</field>
            <operator>In</operator>
            <value>
                <elementReference>ExtractedCountryPicklistValues</elementReference>
            </value>
        </filters>
        <object>Core_MDF_CCP_Country_Geo_Mapping__mdt</object>
        <outputReference>Country_Geo_Mapping_Records</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>MasterLabel</queriedFields>
        <queriedFields>Core_MDF_Geo__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_IPA_Channel_Program_Id</name>
        <label>Get IPA Channel Program Id</label>
        <locationX>974</locationX>
        <locationY>695</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Technical_Program_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Partner Alliance</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ChannelProgram</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>749</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_New_Record</targetReference>
        </connector>
        <object>Core_MDF_Exception__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>All_Country_Region</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>EMEA,PRC,ASMO,APJ</text>
    </textTemplates>
    <variables>
        <name>Country_Geo_Mapping_Records</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Core_MDF_CCP_Country_Geo_Mapping__mdt</objectType>
    </variables>
    <variables>
        <name>Country_MultiSelect_Picklist_Values</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Country_Region</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>ExtractedCountryPicklistValues</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Formatted_Picklist_Values</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
