<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_CM_Feedback</name>
        <label>Add CM Feedback</label>
        <locationX>528</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>FeedbackRec.CM_Feedback__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_GM_Feedback</name>
        <label>Add GM Feedback</label>
        <locationX>792</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>FeedbackRec.GM_Feedback__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_to_Collection</name>
        <label>Add to Collection</label>
        <locationX>660</locationX>
        <locationY>866</locationY>
        <assignmentItems>
            <assignToReference>FeedbackCollectionForUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>FeedbackRec</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Feedback</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_VP_Feedback</name>
        <label>Add VP Feedback</label>
        <locationX>264</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>FeedbackRec.VP_Feedback__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Current_Feedback_Rec</name>
        <label>Assign Current Feedback Rec</label>
        <locationX>660</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>FeedbackRec.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Through_Each_Feedback</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Feedback_Rec</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Stage</name>
        <label>Check Stage</label>
        <locationX>660</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Add_to_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>VP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Feedback_Rec.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>VP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_VP_Feedback</targetReference>
            </connector>
            <label>VP</label>
        </rules>
        <rules>
            <name>Country_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FeedbackRec.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Country Manager</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_CM_Feedback</targetReference>
            </connector>
            <label>Country Manager</label>
        </rules>
        <rules>
            <name>GM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FeedbackRec.Customer_ID__r.RCStage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>GM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_GM_Feedback</targetReference>
            </connector>
            <label>GM</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Approve Cst Feedback {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Approve Cst Feedback</label>
    <loops>
        <name>Loop_Through_Each_Feedback</name>
        <label>Loop Through Each Feedback</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <collectionReference>ids</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Current_Feedback_Rec</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Feedback_Rec</name>
        <label>Get Feedback Rec</label>
        <locationX>660</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Stage</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>FeedbackRec.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SPM_Customer_Feedback__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Selected_Cst_Feedback</name>
        <label>Get Selected Cst Feedback</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Each_Feedback</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>ids</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SPM_Customer_Feedback__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Feedback</name>
        <label>Update Feedback</label>
        <locationX>660</locationX>
        <locationY>974</locationY>
        <connector>
            <targetReference>Loop_Through_Each_Feedback</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Error</targetReference>
        </faultConnector>
        <inputReference>FeedbackCollectionForUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Selected_Cst_Feedback</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <subflows>
        <name>Handle_Error</name>
        <label>Handle Error</label>
        <locationX>1232</locationX>
        <locationY>1082</locationY>
        <flowName>Core_FlowErrorHandling</flowName>
        <inputAssignments>
            <name>faultMsg</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>FeedbackCollectionForUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SPM_Customer_Feedback__c</objectType>
    </variables>
    <variables>
        <name>FeedbackRec</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SPM_Customer_Feedback__c</objectType>
    </variables>
    <variables>
        <name>ids</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
