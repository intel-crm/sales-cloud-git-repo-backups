<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Preserve_Previous_Website_Value</name>
        <label>Preserve Previous Website Value</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Core_MDM_Website__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record__Prior.Core_MDM_Website__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_if_Website_is_Being_Set_to_Null</name>
        <label>Check if Website is Being Set to Null</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Website_Being_Nullified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDM_Website__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_MDM_Website__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Preserve_Previous_Website_Value</targetReference>
            </connector>
            <label>Website Being Nullified</label>
        </rules>
    </decisions>
    <description>Restrict UCD Url from being set to null if Primary Website URL in Reltio is chagned to null</description>
    <environments>Default</environments>
    <interviewLabel>UCD_ACM_RestrictUnifiedCustomerUrl {!$Flow.CurrentDateTime}</interviewLabel>
    <label>UCD_ACM_RestrictUnifiedCustomerUrl</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_Website_is_Being_Set_to_Null</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Account_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Intel Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDM_Website__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
