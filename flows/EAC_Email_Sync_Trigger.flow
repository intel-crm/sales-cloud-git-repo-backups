    <environments>Default</environments>
    <interviewLabel>EAC Email Sync Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EAC Email Sync Trigger</label>
    <loops>
        <name>Get_Each_User</name>
        <label>Get Each User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_User_based_on_Email_address</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
