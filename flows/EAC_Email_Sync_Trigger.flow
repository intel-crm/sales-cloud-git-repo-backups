    <decisions>
        <name>Based_on_opportunity_count</name>
        <label>Based on opportunity count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_RelatedtoID_Single_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Greater_than_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpptyCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_final_opportunities</targetReference>
            </connector>
            <label>Greater than 1</label>
        </rules>
        <rules>
            <name>Equals_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpptyCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Opportunity_collection</targetReference>
            </connector>
            <label>Equals 1</label>
        </rules>
    </decisions>
    <decisions>
        <name>CC_Address_Null_Check</name>
        <label>CC Address Null Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>From_To_CC_Email_Concat</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Null_CC_Email_Address</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CcAddress</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CcAddress</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CcAddress</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>From_To_Email_Concat</targetReference>
            </connector>
            <label>Null CC Email Address</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_opportunity_team_member_present_or_not</name>
