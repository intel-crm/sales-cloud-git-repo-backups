    <decisions>
        <name>Exit_Loop_after_populating_account_ID</name>
        <label>Exit Loop after populating account ID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Contacts_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Skip_Loop_after_first_run</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SkipLoop</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_ID</targetReference>
            </connector>
            <label>Skip Loop after first run</label>
        </rules>
    </decisions>
    <decisions>
        <name>From_To_and_CC_are_present</name>
        <label>From,To and CC are present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
