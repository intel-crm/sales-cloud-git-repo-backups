<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Auto</name>
        <label>Check Auto</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approval_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IPA_Auto_Approval.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IPA_Auto_Approval_Criteria_Flow.Outputs.outputRequestId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Auto_Approve_Request</targetReference>
            </connector>
            <label>Approval Pending</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Source</name>
        <label>Check Source</label>
        <locationX>380</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IPA_request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PRM_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IPA - Portal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IPA_Auto_Approval</targetReference>
            </connector>
            <label>IPA request</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>EBR Auto Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EBR Auto Approval</label>
    <orchestratedStages>
