    <apiVersion>50.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assignReleaseHoldValues</name>
        <label>assignReleaseHoldValues</label>
        <locationX>754</locationX>
        <locationY>493</locationY>
        <assignmentItems>
            <assignToReference>varClaimRecordsCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varClaimRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>releaseReasonColection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varReleaseReason</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>callReleaseHold</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_VAT_Invoice_Status</name>
        <label>Check VAT Invoice Status</label>
        <locationX>666</locationX>
        <locationY>253</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pending_Documents_Or_Revision_Required</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Documents</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Revision Required</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>checking_second_reminder_notification_is_checked_or_not</targetReference>
            </connector>
            <label>Pending Documents Or Revision Required</label>
        </rules>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getClaimRecord</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
    </decisions>
    <decisions>
        <name>checking_second_reminder_notification_is_checked_or_not</name>
        <label>checking second reminder notification is checked or not</label>
        <locationX>314</locationX>
        <locationY>373</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>if_5th_day_reminder_notification_is_checked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_SecondRemNotificationSent_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_RSM_Managers</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>if 5th day reminder notification is checked</label>
        </rules>
        <rules>
            <name>if_5th_day_reminder_notification_is_unchecked_and_status_in_Pending_Docs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_SecondRemNotificationSent_Ind__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Status_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Documents</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>X3rd_day_reminder_added_to_check</targetReference>
            </connector>
            <label>if 5th day reminder notification is UNCHECKED and status in Pending Docs</label>
        </rules>
    </decisions>
    <formulas>
        <name>Set_Document_Requested_Date_to_Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>varReleaseReason</name>
        <dataType>String</dataType>
        <expression>{!$Label.Core_MDF_VAT_Hold}</expression>
    </formulas>
    <interviewLabel>VAT_Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>VAT_Invoice_Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getClaimRecord</name>
        <label>getClaimRecord</label>
        <locationX>754</locationX>
        <locationY>373</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>assignReleaseHoldValues</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Core_MDF_Claim_Id__c</elementReference>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <outputReference>varClaimRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Core_MDF_VAT_Hold_Ind__c</queriedFields>
        <queriedFields>Core_MDF_Status__c</queriedFields>
        <queriedFields>Core_MDF_Claim_Previous_Status__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>540</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_VAT_Invoice_Status</targetReference>
        </connector>
        <filterLogic>1 OR  2</filterLogic>
        <filters>
            <field>Core_MDF_Status_Txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Documents</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Status_Txt__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Revision Required</stringValue>
            </value>
        </filters>
        <object>Core_MDF_Claim_VAT_Info__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <textTemplates>
        <name>Documentation_Needed_for_Claim</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>VAT Documentation Needed for Claim # {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Claim_Ref_Number__c}</text>
    </textTemplates>
    <textTemplates>
        <name>Notify_Claim_Submitters_on_VAT_invoice</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Label.Core_MDF_EmailTemp_StatusUpdate_DearMember}

Your claim has been selected for a VAT Invoice review. Please submit the documents for your claim.

Claim # : {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Claim_Ref_Number__c}
Activity Name: {!$Record.Core_MDF_Claim_Id__r.Request.Title}
Campaign Name: {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Campaign_Id__r.Name} {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Criteria_Hold_Ref_No_Txt__c}
Activity Type: {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Activity_Types__c}
Country / Region: {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Country_Location_nm__c}
Document Submission Link: &lt;a href=&quot;{!$Label.Core_MDF_PFRCommunityLink}{!$Record.Id}&quot;&gt;{!$Record.Name}&lt;/a&gt;

Thank you,
Intel Global Partner Marketing Team</text>
    </textTemplates>
    <textTemplates>
        <name>Notify_Claim_Submitters_on_VAT_Invoice_Issues</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Dear Member,

Your claim has been selected for a VAT Invoice review or needs documentation in addition to your original submission. Please submit documents for your claim by the due date.
Claim # {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Claim_Ref_Number__c}
Activity Name: {!$Record.Core_MDF_Claim_Id__r.Request.Title}
Campaign Name: {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Campaign_Id__r.Name}
Activity Type: {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Activity_Types__c}
Country / Region: {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Country_Location_nm__c}
Document Submission Link: &lt;a href=&quot;{!$Label.Core_MDF_PFRCommunityLink}{!$Record.Id}&quot;&gt;{!$Record.Name}&lt;/a&gt;

Thank you,
Intel Global Partner Marketing Team</text>
    </textTemplates>
    <textTemplates>
        <name>Recipient_Email_Id</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.Core_MDF_Claim_Id__r.Owner:User.Email}</text>
    </textTemplates>
    <textTemplates>
        <name>RecipientType</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>InternalUsers</text>
    </textTemplates>
    <textTemplates>
        <name>SubjectforRSMManagerNotification</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Final Reminder:VAT Documentation Needed for Claim # {!$Record.Core_MDF_Claim_Id__r.Core_MDF_Claim_Ref_Number__c}</text>
    </textTemplates>
    <textTemplates>
        <name>TemplateforRSMNotification</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Dear Member,

Your claim has been selected for a VAT Invoice review. Please submit the documents for your claim.

