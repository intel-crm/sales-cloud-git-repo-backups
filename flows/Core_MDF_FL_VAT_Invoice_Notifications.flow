    <actionCalls>
        <name>X3rd_day_reminder_added_to_check</name>
        <label>3rd day reminder added to check</label>
        <locationX>314</locationX>
        <locationY>493</locationY>
        <actionName>Core_MDF_Claim_VAT_Info__c.Core_MDF_NotifyClaimSubOnInvoiceReminder</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Notify_Claim_Submitters_on_VAT_Invoice_Upload_0_0_0</targetReference>
        </connector>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
