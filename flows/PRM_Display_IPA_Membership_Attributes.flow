<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>edit</name>
        <choiceText>edit</choiceText>
        <dataType>String</dataType>
    </choices>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>is_the_account_Intel</name>
        <label>is the account Intel?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_PRM_IPAMembership_Attributes_Intel</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>OPID account</defaultConnectorLabel>
        <rules>
            <name>Intel_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>accountrecordId.Core_Account_Record_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Intel Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PRM_IPAMembership_Attributes_Intel</targetReference>
            </connector>
            <label>Intel Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>is_there_a_IPA_Membership_record</name>
        <label>is there a IPA Membership record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>noPRM_IPAMEMbership_Attributes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IPA_Membership_record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_IPA_Membership_Attributes</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>is_the_account_Intel</targetReference>
            </connector>
            <label>IPA Membership record</label>
        </rules>
    </decisions>
    <description>Screen flow to display IPA Membership Attributes on Account Flexi Pages</description>
    <environments>Default</environments>
    <formulas>
        <name>ipaMembershipLink</name>
        <dataType>String</dataType>
        <expression>MID({!$Api.Partner_Server_URL_160}, 1, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_160})) &amp; &quot;lightning/r/PRM_IPAMembership_Attributes__c/&quot; &amp;{!get_IPA_Membership_Attributes.Id} &amp; &quot;/view&quot;</expression>
    </formulas>
    <interviewLabel>PRM_Display IPA Membership Attributes {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PRM IPA Membership Attribute Details</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>create_Log_entry</name>
        <label>create Log entry</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Copy_1_of_PRM_IPAMembership_Attributes_Intel</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Details__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Message__c</field>
            <value>
                <stringValue>update of IPA Membership Attributes failed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Origin__c</field>
            <value>
                <stringValue>IPA Membership Attribute update</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Scope__c</field>
            <value>
                <stringValue>IPA Membership Attribute update</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_Severity__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Core_When__c</field>
            <value>
                <elementReference>$System.OriginDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Core_Log_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>get_IPA_Membership_Attributes</name>
        <label>get IPA Membership Attributes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>is_there_a_IPA_Membership_record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PRM_Account_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>accountrecordId.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PRM_IPAMembership_Attributes__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>update_IPA_Membership_Attributes</name>
        <label>update IPA Membership Attributes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Copy_1_of_PRM_IPAMembership_Attributes_Intel</targetReference>
        </connector>
        <faultConnector>
            <targetReference>create_Log_entry</targetReference>
        </faultConnector>
        <inputReference>get_IPA_Membership_Attributes</inputReference>
    </recordUpdates>
