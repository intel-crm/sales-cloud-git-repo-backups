<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Redirect_to_Cases_Related_List</name>
        <label>Redirect to Cases Related List</label>
        <locationX>633</locationX>
        <locationY>1466</locationY>
        <actionName>c:navigateToUrl</actionName>
        <actionType>component</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>redirectURL</name>
            <value>
                <elementReference>redirectUrl</elementReference>
            </value>
        </inputParameters>
        <nameSegment>c:navigateToUrl</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Count_Ext_Contacts</name>
        <label>Count Ext Contacts</label>
        <locationX>1018</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>numExternalContacts</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Query_External_Contacts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Branch_Based_on_Num_Ext_Contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_localExternalId</name>
        <label>Set localExternalId</label>
        <locationX>1018</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>localExternalId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_External_Account_Record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_redirectUrl_for_My_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_localExternalId_to_recordId</name>
        <label>Set localExternalId to recordId</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>localExternalId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_redirectUrl</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_redirectUrl</name>
        <label>Set redirectUrl</label>
        <locationX>248</locationX>
        <locationY>842</locationY>
        <assignmentItems>
            <assignToReference>redirectUrl</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>redirectUrlFormulaAccount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Debug_Mode_2</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_redirectUrl_for_My_Cases</name>
        <label>Set redirectUrl for My Cases</label>
        <locationX>1018</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>redirectUrl</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>redirectUrlFormulaMyCases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Debug_Mode_2</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Any_Accounts</name>
        <label>Any Accounts?</label>
        <locationX>446</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Set_redirectUrl</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes, Account</defaultConnectorLabel>
        <rules>
            <name>No_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>localExternalId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>No Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Branch_Based_on_Num_Ext_Contacts</name>
        <label>Branch Based on Num Ext Contacts</label>
        <locationX>1018</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Screen_Multiple_Service_Cloud_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Multiple Ext Contacts</defaultConnectorLabel>
        <rules>
            <name>Zero_Ext_Contacts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExternalContacts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_No_Service_Cloud_Contact_Record</targetReference>
            </connector>
            <label>Zero Ext Contacts</label>
        </rules>
        <rules>
            <name>One_Ext_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numExternalContacts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_External_Contact_again</targetReference>
            </connector>
            <label>One Ext Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_recordId_passed_in</name>
        <label>Check if recordId passed in</label>
        <locationX>633</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Query_External_Contacts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Record ID - My Cases</defaultConnectorLabel>
        <rules>
            <name>Yes_Record_ID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_xID_passed_in</targetReference>
            </connector>
            <label>Yes, Record ID</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_xID_passed_in</name>
        <label>Check if xID passed in</label>
        <locationX>248</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Determine_Service_Cloud_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Account ID</defaultConnectorLabel>
        <rules>
            <name>Yes_External_Acct_ID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>x</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_localExternalId_to_recordId</targetReference>
            </connector>
            <label>Yes, External Acct ID</label>
        </rules>
    </decisions>
    <decisions>
        <name>Debug_Mode_2</name>
        <label>Debug Mode?</label>
        <locationX>633</locationX>
        <locationY>1166</locationY>
        <defaultConnector>
            <targetReference>Redirect_to_Cases_Related_List</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Debug_Mode_ON_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>debugMode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Redirect_will_happen_here</targetReference>
            </connector>
            <label>Debug Mode ON</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>redirectUrlFormulaAccount</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;.my.&quot;, {!$Api.Partner_Server_URL_540}) - 1) &amp; &quot;.lightning.force.com/lightning/r/Case__x/&quot; &amp; {!localExternalId} &amp; &quot;/related/Cases3__r/view&quot;</expression>
    </formulas>
    <formulas>
        <name>redirectUrlFormulaMyCases</name>
        <dataType>String</dataType>
        <expression>&quot;intel--crmdevsls3.sandbox.lightning.force.com/lightning/r/Case__x/&quot; &amp; {!localExternalId} &amp; &quot;/related/Cases3__r/view&quot;</expression>
    </formulas>
    <formulas>
        <name>testFormula</name>
        <dataType>String</dataType>
        <expression>&quot;Enterprise: &quot; &amp; {!$Api.Enterprise_Server_URL_540} &amp; &quot; | Partner: &quot; &amp; {!$Api.Partner_Server_URL_540} &amp; &quot; | FULL URL: &quot; &amp; LEFT({!$Api.Partner_Server_URL_540}, FIND(&quot;.my.&quot;, {!$Api.Partner_Server_URL_540}) - 1) &amp; &quot;.lightning.force.com/lightning/r/Case__x/&quot; &amp; {!recordId} &amp; &quot;/related/Cases_External_Account__r/view&quot;</expression>
    </formulas>
    <interviewLabel>Case - View Service Cloud Cases {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - View Service Cloud Cases</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_External_Account_Record</name>
        <label>Get External Account Record</label>
        <locationX>1018</locationX>
        <locationY>674</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_localExternalId</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ExternalId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_External_Contact_again.AccountId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account_External__x</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ExternalId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_External_Contact_again</name>
        <label>Get External Contact (again)</label>
        <locationX>1018</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_External_Account_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Email</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact__x</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Query_External_Contacts</name>
        <label>Query External Contacts</label>
        <locationX>1018</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Ext_Contacts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Email</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact__x</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>Redirect_will_happen_here</name>
        <label>* Redirect will happen here *</label>
        <locationX>501</locationX>
        <locationY>1274</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Redirect_to_Cases_Related_List</targetReference>
        </connector>
        <fields>
            <name>Redirect_Explanation</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;background-color: var(--lwc-colorBackgroundInput,rgb(255, 255, 255)); color: var(--lwc-colorTextWeak,rgb(68, 68, 68)); font-family: var(--lwc-fontFamily,-apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;); font-size: var(--lwc-fontSize3,0.8125rem);&quot;&gt;Here, we will redirect to the case related list for the external account ID: {!localExternalId}, showing the cases.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://help.salesforce.com/s/articleView?id=sf.flow_concepts_finish_override.htm&amp;amp;type=5&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;This approach&lt;/a&gt; will be used to do the redirect.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Redirect URL: {!redirectUrl}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Multiple_Service_Cloud_Contacts</name>
        <label>Multiple Service Cloud Contacts</label>
        <locationX>1282</locationX>
        <locationY>566</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Multiple_Contacts</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;color: rgb(255, 0, 0);&quot;&gt;Error: multiple Service Cloud contacts found with your email address!&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please contact Intel Customer Support at &lt;em&gt;[add another channel here]&lt;/em&gt; to help resolve the issue.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;/lightning/n/Ask_a_Question&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Back to Ask a Question&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_No_Service_Cloud_Contact_Record</name>
        <label>No Service Cloud Contact Record</label>
        <locationX>754</locationX>
        <locationY>566</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_No_Contact</name>
            <fieldText>&lt;p&gt;No Service Cloud contact record detected with your email address. This means you haven&apos;t created any personal cases yet.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;/lightning/n/Ask_a_Question&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Back to Ask a Question&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>507</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_recordId_passed_in</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Determine_Service_Cloud_Account</name>
        <label>Determine Service Cloud Account</label>
        <locationX>446</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>Any_Accounts</targetReference>
        </connector>
        <flowName>Case_Determine_Service_Cloud_Account</flowName>
        <inputAssignments>
            <name>debugMode</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>localExternalId</assignToReference>
            <name>localExternalId</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>debugMode</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>localExternalId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>numExternalContacts</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>redirectUrl</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
