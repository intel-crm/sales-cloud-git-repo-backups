<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <interviewLabel>Create Group For Inserted Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Group For Inserted Account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Core_MDF_Create_Group_record</name>
        <label>Create Group record</label>
        <locationX>478</locationX>
        <locationY>172</locationY>
        <assignRecordIdToReference>group_Id</assignRecordIdToReference>
        <connector>
            <targetReference>Core_MDF_Update_Account_Record</targetReference>
        </connector>
        <inputAssignments>
            <field>DeveloperName</field>
            <value>
                <stringValue>Core_MDF_{!accountId_Text}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
        <object>Group</object>
    </recordCreates>
    <recordUpdates>
        <name>Core_MDF_Update_Account_Record</name>
        <label>Update Account Record</label>
        <locationX>650</locationX>
        <locationY>172</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Core_MDF_Group_Id__c</field>
            <value>
                <elementReference>group_Id</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>105</locationY>
        <connector>
            <targetReference>Core_MDF_Create_Group_record</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <textTemplates>
        <name>accountId_Text</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>{!$Record.Id}</text>
    </textTemplates>
    <variables>
        <name>group_Id</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
