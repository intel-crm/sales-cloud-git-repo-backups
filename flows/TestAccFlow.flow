    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Core_MDF_Is_Program_Retail</name>
        <label>Is SubGeo Present</label>
        <locationX>786</locationX>
        <locationY>371</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_GeoBased_Sharing_Not_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsGeoBasedReq</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Fetch_the_PGM_record</targetReference>
            </connector>
            <label>If GeoBased Sharing Not Required</label>
        </rules>
        <rules>
            <name>If_GeoBased_Sharing_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsGeoBasedReq</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_Check_for_SubGeo</targetReference>
            </connector>
            <label>If GeoBased Sharing Required</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_SubGeo_Check</name>
        <label>SubGeo Check</label>
        <locationX>1422</locationX>
        <locationY>133</locationY>
        <defaultConnector>
            <targetReference>Core_MDF_Fetch_the_PGM_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_SubGeo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClaimActivityAllocationRecordtypeMappingRecord.Core_MDF_Region_cd__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>vRegionv</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_PGM_Records</targetReference>
            </connector>
            <label>If SubGeo</label>
        </rules>
    </decisions>
