    <description>This process is used to invoke Escalation approval based on Budget, Case and Claim</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND([Core_MDF_Escalation__c].RecordType.DeveloperName=&apos;Core_MDF_Budget&apos;,
	ISPICKVAL([Core_MDF_Escalation__c].Core_MDF_Escalation_Status_nm__c ,&apos;Pending Review&apos;),
	OR(ISNEW(),ISCHANGED([Core_MDF_Escalation__c].Core_MDF_Escalation_Status_nm__c ))
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND({!myVariable_current.RecordType.DeveloperName}=&apos;Core_MDF_Budget&apos;,
	ISPICKVAL({!myVariable_current.Core_MDF_Escalation_Status_nm__c} ,&apos;Pending Review&apos;),
	OR(ISNEW(),ISCHANGED({!myVariable_current.Core_MDF_Escalation_Status_nm__c} ))
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND([Core_MDF_Escalation__c].RecordType.DeveloperName=&apos;Core_MDF_Late_Claim&apos;,
	ISPICKVAL([Core_MDF_Escalation__c].Core_MDF_Escalation_Status_nm__c ,&apos;Pending Review&apos;),
	OR(ISNEW(),ISCHANGED([Core_MDF_Escalation__c].Core_MDF_Escalation_Status_nm__c ))
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND({!myVariable_current.RecordType.DeveloperName}=&apos;Core_MDF_Late_Claim&apos;,
	ISPICKVAL({!myVariable_current.Core_MDF_Escalation_Status_nm__c} ,&apos;Pending Review&apos;),
	OR(ISNEW(),ISCHANGED({!myVariable_current.Core_MDF_Escalation_Status_nm__c} ))
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND([Core_MDF_Escalation__c].RecordType.DeveloperName=&apos;Core_MDF_Claim_Case_Review_Result&apos;,
	ISPICKVAL([Core_MDF_Escalation__c].Core_MDF_Escalation_Status_nm__c ,&apos;Pending Review&apos;),
	OR(ISNEW(),ISCHANGED([Core_MDF_Escalation__c].Core_MDF_Escalation_Status_nm__c ))
)
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
