    <recordUpdates>
        <name>Update_Lead_Or_Contact_owner_email</name>
        <label>Update Lead Or Contact owner email</label>
        <locationX>130</locationX>
        <locationY>443</locationY>
        <connector>
            <targetReference>Check_if_Lead_or_Contact</targetReference>
        </connector>
        <inputAssignments>
            <field>Core_Lead_Contact_Owner_Email__c</field>
