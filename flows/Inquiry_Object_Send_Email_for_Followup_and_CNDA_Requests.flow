        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>328</locationX>
        <locationY>47</locationY>
        <connector>
            <targetReference>Check_if_Lead_Contact_email_is_updated</targetReference>
        </connector>
        <filterFormula>IF((  ISNEW() &amp;&amp; 
   TEXT ( {!$Record.Core_Inquiry_Type_Pkt__c}   ) = &apos;Asked for Follow-up&apos;  ||
   TEXT ( {!$Record.Core_Inquiry_Type_Pkt__c}   ) = &apos;CNDA Request&apos;  ||
   TEXT ( {!$Record.Core_Inquiry_Type_Pkt__c}   ) = &apos;Requested Quote&apos;  ||
   TEXT ( {!$Record.Core_Inquiry_Type_Pkt__c}   ) = &apos;Sales Approved&apos; 
)
||
 ( ISCHANGED(   {!$Record.Core_Inquiry_Type_Pkt__c} )  
&amp;&amp;
ISPICKVAL({!$Record.Core_Inquiry_Type_Pkt__c} ,  &apos;Asked for Follow-up&apos;) ||
ISPICKVAL({!$Record.Core_Inquiry_Type_Pkt__c} ,  &apos;CNDA Request&apos; ) ||
ISPICKVAL({!$Record.Core_Inquiry_Type_Pkt__c} ,  &apos;Requested Quote&apos; ) ||
ISPICKVAL({!$Record.Core_Inquiry_Type_Pkt__c} ,  &apos;Sales Approved&apos;  ) 
 ), TRUE,FALSE)</filterFormula>
        <object>Core_Inquiry__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
