    <decisions>
        <name>Check_if_Lead_Contact_email_is_updated</name>
        <label>Check if Lead/Contact email is updated</label>
        <locationX>395</locationX>
        <locationY>376</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Lead_Contact_owner_Email_is_not_there</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Contact_Owner_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Or_Contact_owner_email</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>If Lead Contact owner Email is not there</label>
        </rules>
        <rules>
            <name>If_Lead_Contact_owner_Email_is_there</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Contact_Owner_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_Lead_or_Contact</targetReference>
            </connector>
            <label>If Lead Contact owner Email is there</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Lead_or_Contact</name>
        <label>Check if Lead or Contact</label>
        <locationX>399</locationX>
        <locationY>600</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Lead_Inquiries__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_for_Lead</targetReference>
            </connector>
            <label>If Lead</label>
        </rules>
        <rules>
            <name>If_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Contact_Inquiries__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_for_Contact</targetReference>
            </connector>
            <label>If Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Send_Email_for_Contact</name>
        <label>Send Email for Contact</label>
        <locationX>471</locationX>
        <locationY>869</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Email_for_Followup_Contact</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Asked for Follow-up</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested Quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Inquiry_Asked_For_Contact_Follow_Up</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Send Email for Followup Contact</label>
        </rules>
        <rules>
            <name>Send_Email_for_CNDA_Request_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CNDA Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Inquiry_CNDA_Request_Contact</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Send Email for CNDA Request Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Send_Email_for_Lead</name>
        <label>Send Email for Lead</label>
        <locationX>324</locationX>
        <locationY>873</locationY>
        <defaultConnectorLabel>No Criteria was met.</defaultConnectorLabel>
        <rules>
            <name>Send_Email_for_Followup</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Asked for Follow-up</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested Quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
