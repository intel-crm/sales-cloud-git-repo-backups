            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Send Email for Followup</label>
        </rules>
        <rules>
            <name>Send_Email_for_CNDA_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Inquiry_Type_Pkt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CNDA Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_Inquiry_CNDA_Request_Lead</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Send Email for CNDA Request</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>cf_Core_Lead_Contact_Owner_Email_UpdationFormula</name>
        <dataType>String</dataType>
        <expression>IF( $Record.Core_Lead_Inquiries__c &lt;&gt; NULL, IF($Record.Core_Lead_Inquiries__r.Owner:User.Email&lt;&gt; NULL, $Record.Core_Lead_Inquiries__r.Owner:User.Email, null),IF($Record.Core_Contact_Inquiries__c &lt;&gt; NULL, IF($Record.Core_Contact_Inquiries__r.Owner.Email&lt;&gt; NULL, $Record.Core_Contact_Inquiries__r.Owner.Email,null),null))</expression>
    </formulas>
    <formulas>
        <name>logicforfetchingleadorcontactowneremail</name>
        <dataType>String</dataType>
        <expression>IF( $Record.Core_Lead_Inquiries__c &lt;&gt; NULL, IF($Record.Core_Lead_Inquiries__r.Owner:User.Email&lt;&gt; NULL, $Record.Core_Lead_Inquiries__r.Owner:User.Email, null),IF($Record.Core_Contact_Inquiries__c &lt;&gt; NULL, IF($Record.Core_Contact_Inquiries__r.Owner.Email&lt;&gt; NULL, $Record.Core_Contact_Inquiries__r.Owner.Email,null),null))</expression>
    </formulas>
    <interviewLabel>Inquiry Object Send Email for Followup and CNDA Requests {!$Flow.CurrentDateTime}</interviewLabel>
