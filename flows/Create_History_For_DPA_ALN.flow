    <constants>
        <name>Approvedstatus</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Approved</stringValue>
        </value>
    </constants>
    <decisions>
        <name>checkIfHistoryExist</name>
        <label>checkIfHistoryExist</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_If_History_Record_is_present_or_not</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getHistoryDetails</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getHistoryDetails.core_cpq_status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Approvedstatus</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assignRecordForTheExistingRecord</targetReference>
            </connector>
            <label>Check If History Record is present or not</label>
        </rules>
        <rules>
            <name>Create_New_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getHistoryDetails</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.core_cpq_status_txt__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.core_cpq_extend_expire__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assignRecordForTheFirstTime</targetReference>
            </connector>
            <label>Create New Record</label>
        </rules>
    </decisions>
