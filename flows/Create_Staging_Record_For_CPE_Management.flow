            </connector>
            <label>Insert Staging Record For CPE</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opportunity_Account_Flag_Based_CPE_s_Check</name>
        <label>Opportunity Account Flag Based CPE&apos;s Check</label>
        <locationX>1150</locationX>
        <locationY>1739</locationY>
        <defaultConnector>
            <targetReference>Sales_KPI_CPE_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>IPA CPE Does Not Exists</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Account_CPE_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_For_Existing_Staging_Record_As_Status_New.Account_Action_Refrence__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SLS_PPLN</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Flag_As_True_For_Opportunity_Account_Exists</targetReference>
            </connector>
            <label>Opportunity Account CPE Exists</label>
