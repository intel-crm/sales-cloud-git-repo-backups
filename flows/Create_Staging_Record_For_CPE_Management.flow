            <label>Default CPE Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Flag_Based_CPE_s_Check</name>
        <label>IPA Flag Based CPE Check</label>
        <locationX>1150</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>Co_Marketing_Flag_Based_CPE_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>IPA CPE Does Not Exists</defaultConnectorLabel>
        <rules>
            <name>Check_For_IPA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_For_Existing_Staging_Record_As_Status_New.Account_Action_Refrence__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PTNR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Flag_For_IPA_Exists</targetReference>
            </connector>
            <label>IPA CPE Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Null_Check_For_Business_Types_Collection</name>
        <label>Null Check For Business Types Collection</label>
        <locationX>930</locationX>
        <locationY>6971</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Insert_Staging_Record_For_CPE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccountBusinessTypeCollection</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
