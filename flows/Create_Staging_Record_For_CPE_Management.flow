    <decisions>
        <name>B2B_Flag_Based_CPE_Check</name>
        <label>B2B Flag Based CPE Check</label>
        <locationX>1150</locationX>
        <locationY>1439</locationY>
        <defaultConnector>
            <targetReference>Opportunity_Account_Flag_Based_CPE_s_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>B2B CPE Does Not Exists</defaultConnectorLabel>
        <rules>
            <name>B2B_CPE_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_For_Existing_Staging_Record_As_Status_New.Account_Action_Refrence__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ACCS_ENTTL</stringValue>
                </rightValue>
            </conditions>
            <connector>
