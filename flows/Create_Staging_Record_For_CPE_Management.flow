    </decisions>
    <decisions>
        <name>Sales_KPI_CPE_Check</name>
        <label>Sales KPI CPE Check</label>
        <locationX>1150</locationX>
        <locationY>2039</locationY>
        <defaultConnector>
            <targetReference>Check_For_Existing_Staging_Record_As_Status_New</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sales KPI CPE Does Not Exists</defaultConnectorLabel>
        <rules>
            <name>Sales_KPI_CPE_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_For_Existing_Staging_Record_As_Status_New.Account_Action_Refrence__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SLS_KPI_HOST</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Sales_KPI_Flag</targetReference>
            </connector>
            <label>Sales KPI CPE Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Which_CPE_Needs_To_be_Inserted</name>
        <label>Which Program CPE Needs To be Inserted</label>
        <locationX>930</locationX>
        <locationY>2831</locationY>
        <defaultConnector>
            <targetReference>Check_If_XWalk_is_Moved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_For_Program_Based_CPE</name>
            <conditionLogic>(((1 OR 2 OR 3 OR 4 OR 5) OR (6 AND 7 )) AND 8)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Intel_Partner_Alliance_PartnerGroup__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_CoMarketingActive__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Is_Opportunity_Account__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_B2B_Entitlement__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Sales_Groups__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Business_Party_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mastered_Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_For_Add_Or_Delete_IPA_Acc_CPE</targetReference>
            </connector>
            <label>Check For Program Based CPE</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Add_Sales_KPI_CPE</name>
        <dataType>Boolean</dataType>
        <expression>AND(CONTAINS($Label.UCD_Salesgroup_Value, TEXT({!$Record.Core_Sales_Groups__c}))
,NOT(CONTAINS($Label.UCD_Salesgroup_Value, TEXT({!$Record__Prior.Core_Sales_Groups__c}))))</expression>
    </formulas>
    <formulas>
        <name>Delete_Sales_KPI_CPE</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(CONTAINS($Label.UCD_Salesgroup_Value, TEXT({!$Record.Core_Sales_Groups__c})))
,CONTAINS($Label.UCD_Salesgroup_Value, TEXT({!$Record__Prior.Core_Sales_Groups__c})))</expression>
    </formulas>
