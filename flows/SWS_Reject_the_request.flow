            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recordId.SWS_Rejected_On__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Request</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
