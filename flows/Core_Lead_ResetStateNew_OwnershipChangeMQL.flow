    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>FieldUpdatesCore_Lead_Reset_Lead_State_New</targetReference>
        </connector>
        <filterFormula> AND( {!$Record.RecordType.DeveloperName} &lt;&gt; &quot;Partner_Lead&quot;,  ISCHANGED({!$Record.OwnerId} ))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
