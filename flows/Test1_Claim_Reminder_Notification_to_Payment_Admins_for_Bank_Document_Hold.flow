<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Reminder_Notification_to_RSM</name>
        <label>Reminder Notification to RSM</label>
        <locationX>50</locationX>
        <locationY>636</locationY>
        <actionName>Core_MDF_DetermineEmailRecipients</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>groupId</name>
            <value>
                <elementReference>$Record.Request.ChannelPartner.Core_MDF_Group_Id__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>permissionSetName</name>
            <value>
                <elementReference>$Label.Core_MDF_Retail_Account_Manager_Permission_Set</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipients</name>
            <value>
                <elementReference>InternalUsers</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendDiff</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>templateName</name>
            <value>
                <elementReference>$Label.Core_MDF_ReminderEmailToPayAdmin</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_DetermineEmailRecipients</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>SendReminderNotificationToPaymentAdmin</name>
        <label>SendReminderNotificationToPaymentAdmin</label>
        <locationX>182</locationX>
        <locationY>396</locationY>
        <actionName>Core_MDF_ClaimReminderNotification</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_if_program_is_Retail</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>claimRecords</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_MDF_ClaimReminderNotification</nameSegment>
    </actionCalls>
    <apiVersion>51.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_if_program_is_Retail</name>
        <label>Check if program is Retail</label>
        <locationX>182</locationX>
        <locationY>516</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_CP_is_Retail</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Retail_Channel_Program_Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reminder_Notification_to_RSM</targetReference>
            </connector>
            <label>Check if CP is Retail</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Reminder_Date</name>
        <label>Check Reminder Date</label>
        <locationX>380</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>default outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Reminder_Date_Less_Than_Equals_Today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Payment_Admin_Reminder_Date_Dtm__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>TodaysDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendReminderNotificationToPaymentAdmin</targetReference>
            </connector>
            <label>Check Reminder Date Less Than Equals Today</label>
        </rules>
    </decisions>
    <formulas>
        <name>TodaysDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Test Claim Reminder Notification to Payment Admins for Bank Document Hold {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test Claim Reminder Notification to Payment Admins for Bank Document Hold</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Reminder_Date</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_MDF_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Hold</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Payment_Admin_Reminder_Date_Dtm__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Bank_Doc_Hold_Ind__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Core_MDF_Audit_Hold__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>PartnerFundClaim</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2021-02-18</startDate>
            <startTime>01:38:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>ClaimProgram</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>InternalUsers</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>InternalUsers</stringValue>
        </value>
    </variables>
</Flow>
