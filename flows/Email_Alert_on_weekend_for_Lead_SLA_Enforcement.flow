    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>DATETIMEVALUE([Lead].Core_WeekEnd_SLA_Calculation__c) -1

</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_16_myRule_15_A1_6499680025</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!myVariable_current.Core_WeekEnd_SLA_Calculation__c}) -1</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
[Lead].RecordType.DeveloperName &lt;&gt; &quot;Partner_Lead&quot;,
NOT(
OR(
ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Accepted&apos;),
ISPICKVAL([Lead].Core_Lead_Status__c , &apos;Rejected&apos;)
)
),

[Lead].Days__c =false,
[Lead].Core_SLA_Listed_User__c  =True,
[Lead].Core_Created_Post_NewLead_Process__c=True,
ISPICKVAL([Lead].Status, &apos;Marketing Qualified Lead&apos;),
ISPICKVAL([Lead].Core_Lead_Priority__c, &apos;Hot&apos;)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!myVariable_current.RecordType.DeveloperName} &lt;&gt; &quot;Partner_Lead&quot;,
NOT(
OR(
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Accepted&apos;),
ISPICKVAL({!myVariable_current.Core_Lead_Status__c} , &apos;Rejected&apos;)
)
),

{!myVariable_current.Days__c} =false,
{!myVariable_current.Core_SLA_Listed_User__c}  =True,
{!myVariable_current.Core_Created_Post_NewLead_Process__c}=True,
ISPICKVAL({!myVariable_current.Status}, &apos;Marketing Qualified Lead&apos;),
ISPICKVAL({!myVariable_current.Core_Lead_Priority__c}, &apos;Hot&apos;)
)</expression>
