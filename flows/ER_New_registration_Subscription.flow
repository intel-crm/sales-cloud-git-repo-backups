            </value>
        </assignmentItems>
        <connector>
            <targetReference>verify_subscriptions</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Verify_contact_subscription_records</name>
        <label>Verify contact subscription records</label>
        <locationX>440</locationX>
        <locationY>1190</locationY>
        <defaultConnector>
            <targetReference>loop_through_partner_subscription</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Contact_subscriptions_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_contact_subscriptions</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>loop_through_contact_subscription</targetReference>
            </connector>
            <label>Contact subscriptions found</label>
        </rules>
    </decisions>
    <decisions>
        <name>verify_PS_and_CS</name>
        <label>verify PS and CS</label>
        <locationX>616</locationX>
        <locationY>1790</locationY>
        <defaultConnector>
            <targetReference>assign_Variables_to_Contact_Subscription</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PS_and_CS_matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>contactsubscriptionlist</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>loop_through_partner_subscription</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>loop_through_partner_subscription</targetReference>
            </connector>
            <label>PS and CS matches</label>
        </rules>
    </decisions>
    <decisions>
        <name>verify_subscriptions</name>
        <label>verify subscriptions</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Get_Partner_Subscriptions</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>subscription_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>partnersubscription</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Get_single_PS</targetReference>
            </connector>
            <label>subscription found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>singlePS</name>
        <dataType>String</dataType>
        <expression>TRIM(                                                                                                         
SUBSTITUTE(
LEFT( {!partnersubscription} , FIND(&quot;;&quot;,  {!partnersubscription} )),
&quot;;&quot;,                                                                                          
&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>updatedpartnersubscription</name>
        <dataType>String</dataType>
        <expression>MID({!partnersubscription},FIND(&quot;;&quot;,
{!partnersubscription})+1,LEN({!partnersubscription})-
LEN(LEFT({!partnersubscription}, FIND(&quot;;&quot;,{!partnersubscription})))+1)</expression>
    </formulas>
    <interviewLabel>ER New registration Subscription {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ER New registration Subscription</label>
    <loops>
        <name>loop_through_contact_subscription</name>
        <label>loop through contact subscription</label>
        <locationX>332</locationX>
        <locationY>1298</locationY>
        <collectionReference>get_contact_subscriptions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
