        </connector>
    </assignments>
    <assignments>
        <name>Assign_Partner_subscription_to_variable</name>
        <label>Assign Partner subscription to variable</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignmentItems>
            <assignToReference>partnersubscription</assignToReference>
            <operator>Assign</operator>
            <value>
