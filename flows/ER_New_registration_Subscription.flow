    <assignments>
        <name>Update_PS</name>
        <label>Update PS</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>partnersubscription</assignToReference>
            <operator>Assign</operator>
            <value>
