<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Active_user_exist_safe_to_send_email</name>
        <label>Active user exist safe to send email</label>
        <locationX>794</locationX>
        <locationY>916</locationY>
        <assignmentItems>
            <assignToReference>out_IsSafeToEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Active_user_exist_safe_to_send_email_0</name>
        <label>Active user exist safe to send email</label>
        <locationX>967</locationX>
        <locationY>1017</locationY>
        <assignmentItems>
            <assignToReference>out_IsSafeToEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Assign User IDs (Inside the Member Loop)</description>
        <name>Assign_User_ID</name>
        <label>Assign_User_ID</label>
        <locationX>198</locationX>
        <locationY>693</locationY>
        <assignmentItems>
            <assignToReference>colUserIDs</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Members.UserOrGroupId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Members</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>No_active_user_exists_don_t_send_email</name>
        <label>No active user exists don&apos;t send email</label>
        <locationX>1308</locationX>
        <locationY>996</locationY>
        <assignmentItems>
            <assignToReference>out_IsSafeToEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>If Any Case Co Owner Or Intel Support Owner Active</description>
        <name>Any_Case_Co_Owner_Or_Intel_Support_Owner_Active</name>
        <label>Any Case Co Owner Or Intel Support Owner Active</label>
        <locationX>1097</locationX>
        <locationY>914</locationY>
        <defaultConnector>
            <targetReference>No_active_user_exists_don_t_send_email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Active Users -No Email Alert</defaultConnectorLabel>
        <rules>
            <name>If_Any_Case_Co_Owner_Or_Intel_Support_Owner_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Case_Co_Owner_Or_Intel_Support_Owner_check</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Active_user_exist_safe_to_send_email_0</targetReference>
            </connector>
            <label>If Any Case Co Owner Or Intel Support Owner Active</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if Active Users Exist</description>
        <name>Check_for_Active_Users</name>
        <label>Check_for_Active_Users</label>
        <locationX>883</locationX>
        <locationY>698</locationY>
        <defaultConnector>
            <targetReference>Case_Co_Owner_Or_Intel_Support_Owner_check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Check Case Co Owner and Intel Support Owner</defaultConnectorLabel>
        <rules>
            <name>Active_Users_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Users</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Active_user_exist_safe_to_send_email</targetReference>
            </connector>
            <label>Active Users Exist</label>
        </rules>
    </decisions>
    <description>Check if Active Users Exist- 
1.Case Owner Queue has any active user or not
OR
2.Case co-owner is active or not
OR
3.Intel support owner is active or not. If no one is active then email alert will not trigger</description>
    <environments>Default</environments>
    <interviewLabel>Core_Ips_CaseQueueUserActiveOrNot {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Ips_CaseQueueUserActiveOrNot</label>
    <loops>
        <description>Loop to Extract User IDs</description>
        <name>Loop_Members</name>
        <label>Loop_Members</label>
        <locationX>473</locationX>
        <locationY>695</locationY>
        <collectionReference>Get_All_Members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_User_ID</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Active_Users</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Check Case Co Owner and Intel Support Owner is active or not</description>
        <name>Case_Co_Owner_Or_Intel_Support_Owner_check</name>
        <label>Case Co Owner Or Intel Support Owner check</label>
        <locationX>1095</locationX>
        <locationY>746</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Case_Co_Owner_Or_Intel_Support_Owner_Active</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND 3</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RelatedUserCaseCoOwner</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RelatedUserIntelSupportOwner</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Fetch Active Users Only</description>
        <name>Get_Active_Users</name>
        <label>Get_Active_Users</label>
        <locationX>724</locationX>
        <locationY>697</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_for_Active_Users</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>colUserIDs</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get All Queue Members</description>
        <name>Get_All_Members</name>
        <label>Get_All_Members</label>
        <locationX>302</locationX>
        <locationY>549</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Members</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>GroupId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Dynamic_Queue.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>GroupMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get the Dynamic Queue ID</description>
        <name>Get_Dynamic_Queue</name>
        <label>Get_Dynamic_Queue</label>
        <locationX>436</locationX>
        <locationY>446</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_All_Members</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>in_OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>498</locationX>
        <locationY>116</locationY>
        <connector>
            <targetReference>Get_Dynamic_Queue</targetReference>
        </connector>
    </start>
    <status>Active</status>
