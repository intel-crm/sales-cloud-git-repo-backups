    <environments>Default</environments>
    <formulas>
        <name>Alias</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Core_Contact_Id__r.FirstName}, 5)</expression>
    </formulas>
    <formulas>
        <name>FaultMessage</name>
        <dataType>String</dataType>
        <expression>&apos;Flow failed for Contact &apos;+{!$Record.Core_Contact_Id__r.Email}</expression>
    </formulas>
    <formulas>
        <name>userName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Core_Contact_Id__r.Core_Enterprise_Id__c}+&apos;@intel.com.crm&apos;+IF({!$Label.Core_Draco_sandbox_environment}=&apos;Prod&apos;, &apos;&apos;,{!$Label.Core_Draco_sandbox_environment})</expression>
    </formulas>
