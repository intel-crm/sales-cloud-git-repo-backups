<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Unauthorised</name>
        <label>Unauthorised?</label>
        <locationX>572</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Error_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>unauthorised1</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Flow.FaultMessage</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>ENTITY_IS_LOCKED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Flow.FaultMessage</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>INSUFFICIENT_ACCESS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>error_screen_2</targetReference>
            </connector>
            <label>unauthorised</label>
        </rules>
    </decisions>
    <description>Update Change Request Status</description>
    <environments>Default</environments>
    <interviewLabel>Update Change Request Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PCC Update Change Request Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Update_Status</name>
        <label>Update Status</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>button</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Unauthorised</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PCC_Approval_Status__c</field>
            <value>
                <stringValue>Review in Progress</stringValue>
            </value>
        </inputAssignments>
        <object>PCC_Deal_Change_Request__c</object>
    </recordUpdates>
