    <description>This is used to Update the Compliance Status and Compliance SubStatus  based on MINDS</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(
AND(
ISPICKVAL([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c,&quot;No&quot;),
ISBLANK(TEXT([Opportunity].Core_Compliance_Status__c)),
ISBLANK(TEXT([Opportunity].Core_Compliance_Sub_Status__c))
),
AND(
ISPICKVAL([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c,&quot;No&quot;),
ISPICKVAL(PRIORVALUE([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c), &quot;Yes&quot;),
ISCHANGED([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c)
)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>OR(
AND(
ISPICKVAL({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c},&quot;No&quot;),
ISBLANK(TEXT({!myVariable_current.Core_Compliance_Status__c})),
ISBLANK(TEXT({!myVariable_current.Core_Compliance_Sub_Status__c}))
),
AND(
ISPICKVAL({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c},&quot;No&quot;),
ISPICKVAL(PRIORVALUE({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c}), &quot;Yes&quot;),
ISCHANGED({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c})
)
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(
AND(
ISPICKVAL([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c,&quot;yes&quot;),
ISBLANK(TEXT([Opportunity].Core_Compliance_Status__c)),
ISBLANK(TEXT([Opportunity].Core_Compliance_Sub_Status__c)),
[Opportunity].Core_Account_Country__c =&quot;USA&quot;
),
AND(
ISPICKVAL([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c,&quot;Yes&quot;),
ISPICKVAL(PRIORVALUE([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c), &quot;No&quot;),
ISCHANGED([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c),
[Opportunity].Core_Account_Country__c =&quot;USA&quot;
)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>OR(
AND(
ISPICKVAL({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c},&quot;yes&quot;),
ISBLANK(TEXT({!myVariable_current.Core_Compliance_Status__c})),
ISBLANK(TEXT({!myVariable_current.Core_Compliance_Sub_Status__c})),
{!myVariable_current.Core_Account_Country__c} =&quot;USA&quot;
),
AND(
ISPICKVAL({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c},&quot;Yes&quot;),
ISPICKVAL(PRIORVALUE({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c}), &quot;No&quot;),
ISCHANGED({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c}),
{!myVariable_current.Core_Account_Country__c} =&quot;USA&quot;
)
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(
AND(
ISPICKVAL([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c,&quot;yes&quot;),
ISBLANK(TEXT([Opportunity].Core_Compliance_Status__c)),
ISBLANK(TEXT([Opportunity].Core_Compliance_Sub_Status__c)),
[Opportunity].Core_Account_Country__c !=&quot;USA&quot;
),
AND(
ISPICKVAL([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c,&quot;Yes&quot;),
ISPICKVAL(PRIORVALUE([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c), &quot;No&quot;),
ISCHANGED([Opportunity].Core_Military_Aerospace_Govmt_End_Use__c),
[Opportunity].Core_Account_Country__c !=&quot;USA&quot;
)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>OR(
AND(
ISPICKVAL({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c},&quot;yes&quot;),
ISBLANK(TEXT({!myVariable_current.Core_Compliance_Status__c})),
ISBLANK(TEXT({!myVariable_current.Core_Compliance_Sub_Status__c})),
{!myVariable_current.Core_Account_Country__c} !=&quot;USA&quot;
),
AND(
ISPICKVAL({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c},&quot;Yes&quot;),
ISPICKVAL(PRIORVALUE({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c}), &quot;No&quot;),
ISCHANGED({!myVariable_current.Core_Military_Aerospace_Govmt_End_Use__c}),
{!myVariable_current.Core_Account_Country__c} !=&quot;USA&quot;
)
)</expression>
    </formulas>
