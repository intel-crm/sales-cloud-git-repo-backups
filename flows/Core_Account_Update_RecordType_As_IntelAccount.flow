<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Update_Account_RecordType_as_Intel_Account</name>
        <label>Update Account RecordType as Intel Account</label>
        <locationX>50</locationX>
        <locationY>551</locationY>
        <assignmentItems>
            <assignToReference>$Record.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_IntelAccountRecordtypeId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_If_Core_Deactivated_is_Changed_and_Equlas_False</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_core_Account_Intel_Record_Type</name>
        <label>Update core Account Intel Record Type</label>
        <locationX>50</locationX>
        <locationY>887</locationY>
        <assignmentItems>
            <assignToReference>$Record.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_IntelAccountRecordtypeId</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <constants>
        <name>con_AccountIntelUltimateDevName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Core_Account_Intel_Ultimate</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_IntelAccountDevName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Mastered_Account</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_MasteredAccount</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Mastered_Account</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_MDFCoMarketingDevname</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Core_MDF_Co_Marketing</stringValue>
        </value>
    </constants>
    <constants>
        <name>con_PartnerAccountGroupDevName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Core_Partner_Account_Group</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_If_Core_Deactivated_is_Changed_and_Equlas_False</name>
        <label>Check If Core Deactivated is Changed and Equlas False</label>
        <locationX>182</locationX>
        <locationY>767</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_Deactivated_value_is_changed_and_Equals_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Deactivated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>con_PartnerAccountGroupDevName</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>con_MasteredAccount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>con_AccountIntelUltimateDevName</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>con_MDFCoMarketingDevname</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_core_Account_Intel_Record_Type</targetReference>
            </connector>
            <label>Core Deactivated value is changed and Equals False</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Export_Complaince_is_Changed_and_Equals_True</name>
        <label>Check If Export Complaince is Changed and Equals True</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Check_If_Core_Deactivated_is_Changed_and_Equlas_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Export_Complaince_is_Changed_and_Equals_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_Export_Compliance_Block__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_RecordType_as_Intel_Account</targetReference>
            </connector>
            <label>Export Complaince is Changed and Equals True</label>
        </rules>
    </decisions>
    <description>Update Account RecordType as Intel Account</description>
    <environments>Default</environments>
    <interviewLabel>Core_ Account_Update_RecordType_As_IntelAccount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core_Account_Update_RecordType_As_IntelAccount</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Intel_Account_RecordType</name>
        <label>Get Intel Account RecordType</label>
        <locationX>182</locationX>
        <locationY>311</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Export_Complaince_is_Changed_and_Equals_True</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>con_MasteredAccount</elementReference>
            </value>
        </filters>
        <object>RecordType</object>
        <outputAssignments>
            <assignToReference>var_IntelAccountRecordtypeId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Intel_Account_RecordType</targetReference>
        </connector>
        <filterFormula>OR(AND( PRIORVALUE({!$Record.Core_Export_Compliance_Block__c})= TRUE, ISCHANGED( {!$Record.Core_Export_Compliance_Block__c})),AND( ISCHANGED({!$Record.Core_Deactivated__c}), PRIORVALUE({!$Record.Core_Deactivated__c}) = TRUE, {!$Record.Core_Deactivated__c} = FALSE, {!$Record.RecordType.DeveloperName}=&apos;Core_Partner_Account_Group&apos;,{!$Record.RecordType.DeveloperName}=&apos;Mastered_Account&apos;,{!$Record.RecordType.DeveloperName}=&apos;Core_Account_Intel_Ultimate&apos;,{!$Record.RecordType.DeveloperName}=&apos;Core_MDF_Co_Marketing&apos;))</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_IntelAccountRecordtypeId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
