<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>DDR_Opp_Retry</name>
        <label>DDR Opp Retry</label>
        <locationX>308</locationX>
        <locationY>288</locationY>
        <actionName>Core_DDR_OppRetry</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>ids</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Core_DDR_OppRetry</nameSegment>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Retry DDR for Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Retry DDR for Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>1 AND 2 AND (3 AND 4)</filterLogic>
        <filters>
            <field>Core_Message__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Successfully Inserted</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Origin__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opportunity Creation</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Retry_Counter__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Core_Retry_Counter__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </filters>
        <object>Core_Log_Entry__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>After_5_min</name>
            <connector>
                <targetReference>DDR_Opp_Retry</targetReference>
            </connector>
            <label>After 5 min</label>
            <offsetNumber>2</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>Core_Next_Scheduled_Run__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
