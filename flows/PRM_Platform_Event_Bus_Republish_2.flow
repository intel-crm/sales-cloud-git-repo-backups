<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Execute_PEB_Batch_1</name>
        <label>Execute PEB Batch 1</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <actionName>PRM_Email_Log_PlatformEventBus_Republish</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>PRM_Email_Log_PlatformEventBus_Republish</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Execute_PEB_Batch_2</name>
        <label>Execute PEB Batch 2</label>
        <locationX>440</locationX>
        <locationY>276</locationY>
        <actionName>PRM_Email_Log_PlatformEventBus_Republish</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>PRM_Email_Log_PlatformEventBus_Republish</nameSegment>
    </actionCalls>
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Check for failed EmailLog Records criteria.
Republish Failed Platform Event records</description>
    <environments>Default</environments>
    <interviewLabel>PRM_Platform Event Bus_Republish_2 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PRM_Platform Event Bus_Republish_2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Core_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>failed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Core_Object_API_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PRM_EmailLog__c</stringValue>
            </value>
        </filters>
        <object>Core_Platform_Event_Log__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>ScheduledPath_1</name>
            <connector>
                <targetReference>Execute_PEB_Batch_1</targetReference>
            </connector>
            <label>ScheduledPath1</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>ScheduledPath_2</name>
            <connector>
                <targetReference>Execute_PEB_Batch_2</targetReference>
            </connector>
            <label>ScheduledPath_2</label>
            <offsetNumber>2</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
