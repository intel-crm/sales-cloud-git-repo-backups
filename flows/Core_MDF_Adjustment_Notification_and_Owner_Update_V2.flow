    <decisions>
        <description>Check if Adjustment Claim is of type Adjustment then send Notification</description>
        <name>Check_if_Adjustment_Request_is_of_type_Adjustment_then_send_Notification</name>
        <label>Check if Adjustment Claim is of type Adjustment then send Notification</label>
        <locationX>1758</locationX>
        <locationY>243</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Notification</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Adjustment_Claim_Nbr__r.Core_MDF_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Claim_Adjustment_Type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Reference_Claim_Nbr__r.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Reference_Claim_Nbr__r.Owner:User.Partner_License_Reclaimed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recipient_Id_Assignment</targetReference>
            </connector>
            <label>Send Notification</label>
        </rules>
    </decisions>
    <decisions>
        <name>Core_MDF_Check_if_Reference_Claim_Owner_is_External_Or_Internal_User</name>
        <label>Check if Reference Claim Owner is External or Internal User</label>
        <locationX>2095</locationX>
        <locationY>438</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_MDF_Send_Email_Notification_to_Partner</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Reference_Claim_Nbr__r.Owner:User.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PowerPartner</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Reference_Claim_Nbr__r.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Reference_Claim_Nbr__r.Owner:User.Partner_License_Reclaimed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_AdjustmentCreation_Notification_for_Adj_Req_from_Adjustment_Request</targetReference>
            </connector>
            <label>Send Email Notification to Partner</label>
        </rules>
        <rules>
            <name>Core_MDF_Send_Email_Notification_to_Internal_user</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Reference_Claim_Nbr__r.Owner:User.UserType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Reference_Claim_Nbr__r.Owner:User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Reference_Claim_Nbr__r.Owner:User.Partner_License_Reclaimed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Core_MDF_AdjustmentCreation_Notification_for_Adj_Req_to_Internal_User</targetReference>
            </connector>
            <label>Send Email Notification to Internal user</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Adjustment_type_and_Reason</name>
        <label>Verify Adjustment type and Reason</label>
        <locationX>1229</locationX>
        <locationY>386</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_records_if_Adjustment_type_is_Adjustment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Adjustment_Claim_Nbr__r.Core_MDF_Type_Txt__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_Claim_Adjustment_Type</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Core_MDF_Reason_Cd__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Core_MDF_AdjReq_EscalationType</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Reference_Claim_Owner_email_into_Adjustment_Req_Object</targetReference>
            </connector>
            <label>Update records if Adjustment type is Adjustment</label>
        </rules>
    </decisions>
    <description>Merging the flow &apos;Adjustment Notification and Owner Update&apos; process builder and &apos;Adjustment Notification and Owner Update&apos; flow</description>
    <environments>Default</environments>
