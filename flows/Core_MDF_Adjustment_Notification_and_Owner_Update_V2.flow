    <assignments>
        <name>Recipient_Id_Assignment</name>
        <label>Recipient Id Assignment</label>
        <locationX>2211</locationX>
        <locationY>215</locationY>
        <assignmentItems>
            <assignToReference>RecipientId</assignToReference>
            <operator>Add</operator>
