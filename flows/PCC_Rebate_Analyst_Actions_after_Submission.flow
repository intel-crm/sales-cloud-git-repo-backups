    <environments>Default</environments>
    <formulas>
        <name>Getthenumberofdays</name>
        <dataType>Number</dataType>
        <expression>today()-DATEVALUE({!$Record.PCC_Submission_Date__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>tablerow</name>
        <dataType>String</dataType>
        <expression>&apos; &lt;tr&gt;&lt;td class=&quot;t1&quot;&gt;&apos;+{!Loop_over_Rebate_Claim_records.Name}+
&apos;&lt;/td&gt;&lt;td class=&quot;t1&quot;&gt;&apos;+TEXT(DATEVALUE({!Loop_over_Rebate_Claim_records.PCC_Submission_Date__c}))+
&apos;&lt;/td&gt;&lt;td class=&quot;t1&quot;&gt;&apos;+{!Loop_over_Rebate_Claim_records.PCC_Partner__r.Name}+
&apos;&lt;/td&gt;&lt;td class=&quot;t1&quot;&gt;&apos;+TEXT({!Loop_over_Rebate_Claim_records.PCC_Claim_Status__c})+
&apos;&lt;/td&gt;&lt;/tr&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>varConditionDate</name>
        <dataType>Date</dataType>
        <expression>{!Today} - 7</expression>
    </formulas>
    <interviewLabel>Rebate Analyst Actions after Submission {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Rebate Analyst Actions after Submission</label>
