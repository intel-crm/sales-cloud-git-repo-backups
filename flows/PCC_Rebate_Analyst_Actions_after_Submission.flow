    <recordLookups>
        <name>Get_Rebate_Claims</name>
        <label>Get Rebate Claims</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_column_to_table</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PCC_Claim_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Claim Submitted</stringValue>
            </value>
        </filters>
        <filters>
            <field>PCC_Submission_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>varConditionDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PCC_Rebate_Claim__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
