	@isTest static void testDoPut_OpportunityValidationsError() {
   		List<Opportunity> lstOpp = [select id,Name from Opportunity Where Name='OpportunityPutAPITest' limit 1];
        List<OpportunityLineItem> lstOppItms = [select id from OpportunityLineItem Where OpportunityId =: lstOpp[0].Id];
        DateTime d = Date.Today();
		String dateStr =  d.format('MM/dd/yyyy') ;
        system.runAs(Core_Test_Utility.systemAdminUser){
            test.startTest();            
            RestRequest request = (RestRequest)System.jSON.deserialize(REQUEST_TEMPLATE, RestRequest.class);
            request.requestUri = '/services/apexrest/v1.0/opportunity';
            request.httpMethod = 'PUT';
            request.addHeader('Content-Type', 'application/json');
            request.requestBody = Blob.valueOf('{"opportunityId":"'+lstOpp[0].Id+'","stage":"Production Win","decisionDate":"'+dateStr+'","statusUpdate":"PQR 45678","competitiveArchitecture":"ASIC-1","architectureConversion":"true","volume":-10,"IntelPlatform":"Agilex1","productionEndDate":"'+dateStr+'","firstCustomerShipDate":"'+dateStr+'","manufacturingRegion":"ASMO-ASIA","opportunityProducts":[{"status":"Lost","salesPrice":-111,"quantity":1.23,"opportunityProductId":"' +lstOppItms[0].Id+'" }],"opportunityPoP":[{"fileRefNo":"002","title":"comm.png","data":""}]}');
            RestContext.request = request;
            RestResponse res = new RestResponse();
            RestContext.response= res;
            Core_SalesCRM_RestAPI_Response restResponse = Core_RestAPI_Opportunities.doPut();
            system.assert(restResponse!=null);
            test.stopTest();
        }    
    }
                                               
