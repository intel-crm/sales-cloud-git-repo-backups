	@isTest static void testDoPut_OpportunityValidationsSuccess() {
        Id newOppRecTypeId = [select Id from RecordType where DeveloperName = 'Core_Design_Opportunity' limit 1][0].Id;
        Account acct = [Select id from Account where name ='TestAccountKPI' LIMIT 1];
        Profile prf = [SELECT id, Name FROM Profile WHERE Name='Sales Rep-BB'];
        User usr = [SELECT id, Name, isActive FROM User WHERE ProfileId = :prf.Id AND isActive = true AND Core_Employee_Type_Code__c='EMP' and Core_User_Type__c != 'External User' LIMIT 1];
        List<Core_Design_Registration__c> lstDR = [select id,Name from Core_Design_Registration__c Where Core_Design_Registration_Nm__c='OpportunityDR' limit 1];
        List<Core_Design_Registration_Product__c> lstDRProd = [select id,Name from Core_Design_Registration_Product__c LIMIT 1];
        Opportunity opp = new Opportunity(Name = 'OpportunityPutAPITest2', RecordTypeId = newOppRecTypeId,core_approval_status__c = 'Not Submitted',Core_Design_Registration_Id__c = lstDR[0].Id,
                                          AccountId = acct.Id,Core_Commissionable__c = 'Yes',Core_Technical_Owner__c=usr.id,
                                          StageName = 'Qualify', CloseDate = System.Date.today()+1);
        Product2 p = new Product2(Name = 'Test Product',IsActive = true,Core_Design_Registration_Eligible_Ind__c = true,Core_Avail_for_New_Designs__c = true,Core_Sales_Visible_Flag__c = true);
        insert p;
        PricebookEntry pbe = new PricebookEntry(Product2Id = p.Id, Pricebook2Id = Test.getStandardPricebookId(),
                                                UnitPrice = 0, IsActive = true);
        System.runAs(Core_Test_Utility.systemAdminUser) {
            insert opp;
            insert pbe;
        }
        
        OpportunityTeamMember otm = new OpportunityTeamMember (OpportunityId = opp.Id,UserId = usr.id,TeamMemberRole = 'Team Member');
        insert otm;
        
        List<OpportunityLineItem> oppForKPIItems = new List<OpportunityLineItem>();
        oppForKPIItems.add(new OpportunityLineItem(OpportunityId = opp.Id, PricebookEntryId = pbe.Id,
                                                   UnitPrice = 0, Quantity = 10, Core_Competitor__c = 'Acer', Core_Competitor_Product__c = 'AMD Athlon', Core_Design_Registration_Product_Id__c = lstDRProd[0].Id));
        System.runAs(Core_Test_Utility.systemAdminUser) {
            insert oppForKPIItems;
        }

        DateTime dt = Date.Today().addDays(10);
		String dateStr = dt.format('MM/dd/yyyy');
        system.runAs(Core_Test_Utility.systemAdminUser){
            test.startTest();            
            RestRequest request = (RestRequest)System.jSON.deserialize(REQUEST_TEMPLATE, RestRequest.class);
            request.requestUri = '/services/apexrest/v1.0/opportunity';
            request.httpMethod = 'PUT';
            request.addHeader('Content-Type', 'application/json');
            request.requestBody = Blob.valueOf('{"opportunityId":"'+opp.Id+'","stage":"Define","decisionDate":"'+dateStr+'","statusUpdate":"PQR 45678","competitiveArchitecture":"ASIC","architectureConversion":"true","volume":10,"IntelPlatform":"Agilex","productionEndDate":"'+dateStr+'","firstCustomerShipDate":"'+dateStr+'","manufacturingRegion":"ASMO","opportunityProducts":[{"status":"Pending","salesPrice":111,"quantity":10,"opportunityProductId":"' +oppForKPIItems[0].Id+'" }],"opportunityPoP": []}');
            RestContext.request = request;
            RestResponse res = new RestResponse();
            RestContext.response= res;
            Core_SalesCRM_RestAPI_Response restResponse = Core_RestAPI_Opportunities.doPut();
            system.assert(restResponse!=null);
            test.stopTest();
        }    
