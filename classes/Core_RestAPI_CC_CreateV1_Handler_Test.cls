    //This method is to validate passing profile ID return label names
    @isTest  public static  void test_getAuthr(){
        
        Map<String,ID> profiles = new Map<String,ID>();
        List<Profile> ProfileList = [select id, name from Profile where name='Partner' OR name='IPS Agent' OR name='IPS External Customer' OR name='Integration' OR name='IPS Data Migration'  OR name='Data Ops'  ];
        for(Profile prf : ProfileList){
        profiles.put(prf.name, prf.id);//mapping the fields profile name ,profile id
        }
        Core_RestAPI_TestUtilities.setupCustomSetting();
        Core_RestAPI_CC_CreateV1_Handler.getAuthr(Profiles.get('Partner'));
        Core_RestAPI_CC_CreateV1_Handler.getAuthr(Profiles.get('Data Ops'));         
        Core_RestAPI_CC_CreateV1_Handler.getAuthr(Profiles.get('IPS Data Migration')); 
        Core_RestAPI_CC_CreateV1_Handler.getAuthr(Profiles.get('Integration'));
        Core_RestAPI_CC_CreateV1_Handler.getAuthr(Profiles.get('IPS External Customer'));
        System.assertNotEquals(null,  Core_RestAPI_CC_CreateV1_Handler.getAuthr(Profiles.get('IPS External Customer')));
        }
