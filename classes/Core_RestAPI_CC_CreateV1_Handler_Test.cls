    //This method is to create case comments using Rest Response
    @isTest public static void test_CreateCaseComments(){
        List<Case> caseObj=[select casenumber,Subject from Case where Subject='Post TestSubject' AND casenumber!= null ];  
        RestRequest  request = (RestRequest)System.jSON.deserialize(Core_RestAPI_TestUtilities.REQUEST_TEMPLATE, RestRequest.class);
        request.httpMethod = 'POST';
        RestContext.request = request; 
        request.resourcePath ='/services/apexrest/v1.0/cases/'+caseObj[0].casenumber+'/comments'; 
        request.requestURI='/v1.0/cases/'+caseObj[0].casenumber+'/comments';
        Core_RestAPI_CC_CreateV1_Wrapper objWrapper=new Core_RestAPI_CC_CreateV1_Wrapper();
                
        objWrapper.comment='do post comment';
        Core_RestAPI_CaseCommentsV1.doPost(objWrapper);
        Core_RestAPI_CC_CreateV1_Handler objhandler = new Core_RestAPI_CC_CreateV1_Handler(System.now(), 'Core_RestAPI_CaseAttachmentsV1',objWrapper); 
        Core_RestAPI_Response response=objhandler.createCaseComments(); 
        System.assertEquals('200', response.code);
    } 
