    global void execute(Database.BatchableContext bc, List<OpportunityTeamMember> lstTeamMembers) {

        List<OpportunityTeamMember> lstUpdate = new List<OpportunityTeamMember>() ;
        OpportunityTeamMember oppTmCur ;
        for (OpportunityTeamMember curOppTm :lstTeamMembers)
        {
            oppTmCur = new OpportunityTeamMember() ;
            oppTmCur.Id = curOppTm.Id ;
            if (curOppTm.User.Core_Is_OSC__c == true)
                oppTmCur.Core_OSC_Snapshot__c = 1;
            else
                oppTmCur.Core_OSC_Snapshot__c = 0;
            lstUpdate.Add(oppTmCur) ;
        }
        update lstUpdate;
    }
    
