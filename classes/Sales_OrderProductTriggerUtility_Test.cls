            TriggerHandler.bypass('QuoteTriggerHandler');
            ql.SBQQ__Quote__c = q.Id;
            ql.SBQQ__PricebookEntryId__c =standardPrice.Id;
            ql.SBQQ__Product__c = p.Id;
            TriggerHandler.bypass('QuoteTriggerHandler');
