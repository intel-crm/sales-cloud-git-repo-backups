    public class innerClass implements Comparable{
        public string firstName{get;set;}
        public string lastName{get;set;}
        public string increment{get;set;}
        public innerClass(String firstN, String lastN,String incre){
            firstName = firstN;
            lastName = lastN;	
            increment=incre;
        }
        
        public integer compareTo(Object recordTocompare){
            //	return firstName.compareTo(((innerClass)recordTocompare).firstName) ;
            
            innerClass that = (innerClass) recordTocompare;
            Integer c = this.firstName.compareTo(that.firstName);
            Integer l = this.lastName.compareTo(that.lastName);  
            if (c != 0) {
                return c;
            } else if(l != 0){
                return l;
            }else{
                return this.increment.compareTo(that.increment);
            }            
        }
    }
