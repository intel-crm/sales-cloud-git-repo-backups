    /* ------------------------------------------------------------------------------------------------------------------   
* list<UCD_CIMConnector.ElectronicAddress> wrapper class is used to prepare the body for getting the response from CIM
* -------------------------------------------------------------------------------------------------------------------*/
    public static list<UCD_CIMConnector.ElectronicAddress> mapElectronicAddressDetails(UCD_AccountInfoWrapper acc,BusinessOrganization busOrg ){
        list<UCD_CIMConnector.ElectronicAddress> elecAddrList= new list<UCD_CIMConnector.ElectronicAddress>();
        if(acc.companyWebsite!=null){
            UCD_CIMConnector.ElectronicAddress elecAddr= new UCD_CIMConnector.ElectronicAddress();
            elecAddr.ElectronicAddressTypeCd=System.Label.UCD_ELECADDR;
            elecAddr.ElectronicAddressTxt=acc.companyWebsite;
            elecAddrList.add(elecAddr);
            busOrg.ElectronicAddress=elecAddrList;
        }
        return elecAddrList;
    }
    /* ------------------------------------------------------------------------------------------------------------------   
* PopulateRequestDetails wrapper class is used to prepare the body for getting the response from CIM
* -------------------------------------------------------------------------------------------------------------------*/
    public static PopulateRequestDetails mapRequestDetails(UCD_AccountInfoWrapper acc,BusinessOrganization busOrganization ){
        UCD_CIMConnector.PopulateRequestDetails requestDetail = new UCD_CIMConnector.PopulateRequestDetails();
        requestDetail.BusinessOrganization = busOrganization;
        if (acc.rcdLimit==null){
            acc.rcdLimit=cimMdt.PRM_Max_Records__c;
        }
        if(acc.searchScore==null){
            acc.searchScore=string.valueof(cimMdt.PRM_Min_Score__c);   
        }
        requestDetail.MaximumNumberOfRecordsToReturn = acc.rcdLimit;
        requestDetail.CallingSourceSystem = cimMdt.PRM_Calling_System__c;
        requestDetail.MandatoryFieldRestrictionLevel = Integer.valueOf(cimMdt.PRM_Restriction_Level__c);
        requestDetail.IncludeDefaultAttributesForSourceTypes = False;
        requestDetail.AsynchronousRequestId = cimMdt.PRM_Async_Id__c;
        return requestDetail;
    }
    /* ------------------------------------------------------------------------------------------------------------------   
* Below HTTP request is prepared by setting values from custom Metadata and also setting the method as POST
* -------------------------------------------------------------------------------------------------------------------*/
    public static HttpRequest createHttpRequest(Http http){
        HttpRequest req = new HttpRequest();
        req.setHeader('Content-Type','application/json');
        req.setHeader('API_KEY', cimMdt.API_Key__c);
        req.setEndpoint('callout:PRM_CIM_Callout_Credentials');
        req.setMethod('POST');
        req.setTimeout(Integer.valueOf(System.Label.PRM_Timeout));
        return req;
    }
