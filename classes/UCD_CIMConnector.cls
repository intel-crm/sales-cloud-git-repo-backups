    /* ------------------------------------------------------------------------------------------------------------------   
* sortCIMIDs accepts the map of cim id and search score(integer) and returns the result in descending order
* -------------------------------------------------------------------------------------------------------------------*/
    public static List<String> sortCIMIDs(Map<String,Integer> cimSearchScoreMap){
        List<String> cimIdasKey = new List<String>();
        MAP<Integer , List<String>>  reverseMap =  new MAP<Integer , List<String>>();
        List<String> tempL = new List<String>();
        for(String k : cimSearchScoreMap.KeySet()){
            if(reverseMap.containsKey(cimSearchScoreMap.get(k))){ 
                tempL =reverseMap.get(cimSearchScoreMap.get(k));
               // tempL.add(k);
            }  
            else{
                tempL = new List<String>();
              //  tempL.add(k);
            }
            tempL.add(k);
            reverseMap.put(cimSearchScoreMap.get(k) , tempL);
        }
        cimIdasKey.addAll(cimSearchScoreMap.keySet());
        Set<Integer> finalSet = reverseMap.keySet();
        List<Integer> FinalList = new List<Integer>();
        FinalList.addall(finalSet);
        finalList.sort();
        List<Integer> sortedScores = new List<Integer>();
        List<String> sortedKey = new List<String>();
        for(Integer i = finalList.size()-1; i>=0;i--){
            sortedKey.addAll(reverseMap.get(finalList.get(i)));  
        }
        return sortedKey;
    }
    /* ------------------------------------------------------------------------------------------------------------------   
* getDupStatus accepts the search score(integer) and returns the string based on the search score
* -------------------------------------------------------------------------------------------------------------------*/
    public static String getDupStatus(Decimal score){
        String dupeStatus;
        if(score>=82){
            dupeStatus='FullDup';
        }else if(score>=55 && score<82){
            dupeStatus='PartDup';
        }else{
            dupeStatus='NoDup';
        }
        return dupeStatus;
    }
