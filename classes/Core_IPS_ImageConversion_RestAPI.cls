    public static String getBase64URLImgConvert(String richTextAreaString){
        richTextAreaString ='test image richTextAreaString<img src="data:image/png;base64,"></img> ';
        String strFolderId = '00lo0000000xUqeAAE';
        List<Document> docList= new List<Document>();
        List<String> allimgString = richTextAreaString.split('<img ');
        System.debug(allimgString );
        List <String> AllImageUrls = new List<String>(); 
        String FinalString ='';
        For(String str: allimgString ){
            String pngBase64 = str.substringBetween('src="data:image/png;base64,','"');
            String jpgBase64 = str.substringBetween('src="data:image/jpg;base64,','"');
            String gifBase64 = str.substringBetween('src="data:image/gif;base64,','"');
            Document doc = new Document();
            
            if(!String.isBlank(pngBase64)){
                doc.Type = 'png';
                doc.Body = EncodingUtil.base64Decode(pngBase64);
                doc.Name = 'BackendSystemPNGPic';
            }
            if(!String.isBlank(jpgBase64)){
                doc.Type = 'jpg';
                doc.Body = EncodingUtil.base64Decode(jpgBase64);
                doc.Name = 'BackendSystemJPGPic';
            }
            if(!String.isBlank(gifBase64)){
                doc.Type = 'gif';
                doc.Body = EncodingUtil.base64Decode(jpgBase64);
                doc.Name = 'BackendSystemJPGPic';
            }
            doc.FolderId = strFolderId;
            docList.add(doc);
        }
        if(docList.size()>0){
            insert docList;
            String fullFileURL = URL.getSalesforceBaseUrl().toExternalForm() +'/' + docList[0].id;
            system.debug('fullFileURL'+fullFileURL);
        }
        
        return FinalString;
    }
