    public static Core_CIM_Staging__c createCimStage(String xmlString){
        String xmlName = 'CIM_Message';
        ContentVersion conVer = new ContentVersion();
        conVer.ContentLocation = 'S';
        conVer.PathOnClient = xmlName + '.xml';
        conVer.Title = xmlName;
        conVer.VersionData = blob.valueOf(xmlString);
        insert conVer;
        
        Core_CIM_Staging__c cimStage = new Core_CIM_Staging__c();
        cimStage.Core_Source_System__c = 'CIM';
        cimStage.Core_Retry_Counter__c = 0;
        cimStage.Core_Status__c = 'Pending';
        cimStage.Core_ContentVersion_ID__c = conVer.Id;
        insert cimStage;
        
        return cimStage;
    }
    
    public static List<Account> createAccount(Integer size) {
        List <Account> accountList = new List <Account> ();
        For(integer i = 0; i <size; i++) {
            Account accountInstance = new Account();
            accountInstance.name = 'Test ' + i;
            accountInstance.BillingCountryCode = 'USA';
            accountInstance.BIllingStateCode = 'AL';
            accountInstance.BillingCity = 'Alabama';
            accountInstance.BillingStreet = 'test';
            accountInstance.Core_Sales_Groups__c = 'CCG Sales Group';
            accountList.add(accountInstance);
        }
        return accountList;
    }
    
    public static Core_CIM_Staging__c getCIMStageDetails(String cimStageId){
        return [select Id, Core_Is_Invalid_Record__c, Core_ContentVersion_ID__c, Core_Status__c, Core_CIM_Message_Type__c, Core_CIM_Event_Type__c, Core_Message_ID__c, Core_CIM_ID__c, Core_Failure_Reason__c, Core_Error_Description__c from Core_CIM_Staging__c where Id =: cimStageId];
    }
