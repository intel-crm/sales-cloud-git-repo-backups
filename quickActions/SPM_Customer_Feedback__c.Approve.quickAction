<?xml version="1.0" encoding="UTF-8"?>
<QuickAction xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldOverrides>
        <field>CM_Feedback__c</field>
        <formula>IF(SPM_Customer_Feedback__c.Customer_ID__r.RCStage__c == &apos;Country Manager&apos;,&apos;Approved&apos;,&apos;&apos;)</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Feedback_Type__c</field>
        <formula>SPM_Customer_Feedback__c.Customer_ID__r.RCStage__c</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>GM_Feedback__c</field>
        <formula>IF(SPM_Customer_Feedback__c.Customer_ID__r.RCStage__c == &apos;GM&apos;,&apos;Approved&apos;,&apos;&apos;)</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>VP_Feedback__c</field>
        <formula>IF(SPM_Customer_Feedback__c.Customer_ID__r.RCStage__c == &apos;VP&apos; || SPM_Customer_Feedback__c.Customer_ID__r.RCStage__c == &apos;DR&apos;,&apos;Approved&apos;,&apos;&apos;)</formula>
    </fieldOverrides>
    <label>Approve</label>
    <optionsCreateFeedItem>false</optionsCreateFeedItem>
    <quickActionLayout>
        <layoutSectionStyle>TwoColumnsLeftToRight</layoutSectionStyle>
        <quickActionLayoutColumns/>
        <quickActionLayoutColumns/>
    </quickActionLayout>
    <successMessage>Your decision has been saved successfully! Please do not forget to check the New Customers tab and provide feedback.</successMessage>
    <type>Update</type>
</QuickAction>
