<apex:page standardController="AccountPlan" >
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        .logo {
            width: 100px;
            height: auto;
        }
        .content {
            margin-top: 20px;
        }
        .section {
            margin-bottom: 20px;
        }
        .section h3 {
            margin-bottom: 10px;
        }
        .chart-placeholder {
            height: 200px;
            width: 100%;
            background-color: #f0f0f0;
            text-align: center;
            line-height: 200px;
            font-size: 14px;
            color: #888;
        }
    </style>
    
    <!-- Header Section -->
    <div class="header">
        <h2>Salesforce Report</h2>
    </div>

    <!-- Record Details Section -->
    <div class="content">
        <div class="section">
            <h3>Account Plan Details</h3>
            <p><strong>Plan Name:</strong> {!AccountPlan.Name}</p>
            <p><strong>Account:</strong> {!AccountPlan.Account.Name}</p>
            <p><strong>Owner:</strong> {!AccountPlan.Owner.Name}</p>
        </div>
        <img src="data:image/png;base64," alt="Dashboard Image" style="max-width: 100%; height: auto;" />
    
     
    </div>
</apex:page>