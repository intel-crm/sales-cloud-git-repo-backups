        </apex:outputPanel>
        <apex:outputPanel layout="none">
            .answer8 .selectradio-input td:nth-child(3) input[type="radio"]+label:before { content:url('{!$Resource.Core_IPS_NeutralEmoji}')} 
        </apex:outputPanel>
        <apex:outputPanel layout="none">
            .answer8 .selectradio-input td:nth-child(1) input[type="radio"]+label:before { content:url('{!$Resource.Core_IPS_HappyEmoji}')}
        </apex:outputPanel>
