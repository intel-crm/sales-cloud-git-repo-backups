    </style>
    <apex:includeScript value="{!URLFOR($Resource.Core_IPS_Survey,'jquery1124min.js')}"/>
    <script>function setFocusOnLoad() {}
    </script>
    <div class="mainContent {!SUBSTITUTE(surveyType,' ','_')}" style=" display: flex;"> 
        <apex:form >
            <!-- Survey Logo --> 
            <div class="logocontainer">                
                <apex:image value="{!$Resource[logoImageResource]}" rendered="{!NOT(ISBLANK(logoImageResource))}"/>
            </div>
            
            <apex:pageMessages escape="false"></apex:pageMessages>
            <!-- Sneha US288043 Survey question is getting displayed twice in the feedback section 
                                        if 'Submit' button is clicked more than once START-->
            <apex:actionstatus id="status1">
                <apex:facet name="start">
                    <div class="waitingSearchDiv" id="el_loading" style="background-color: #fbfbfb; height: 5000%;opacity:0.65;width:100%;">
                        <div class="waitingHolder" style="top: 74.2px; width: 91px;">
                            <img class="waitingImage" src="/img/loading.gif" title="Please Wait..." />
                            <span class="waitingDescription">Please Wait...</span>
                        </div>
                    </div>
                </apex:facet>
            </apex:actionstatus>
            <!-- US288043 END-->
            <apex:outputPanel >       
                <div class="subsection" >
                    <!-- Header -->
                    <div class="surveyheader" >                        
                        <apex:outputText value="{!$Label[surveyHeaderLabel]}" escape="false" rendered="{!NOT(ISBLANK(surveyHeaderLabel))}">
                            <apex:param value="{!casenumber}"></apex:param>
                        </apex:outputText>
                                       
                    <apex:pageBlockSection >
                    <apex:variable value="{!0}" var="index"/>
                    <!-- List of Questions -->
                    <apex:dataTable cellpadding="5" cellspacing="0" value="{!lstQuestions}" var="ques" styleClass="surveyQuesTable">
                        <apex:column >
                            <apex:variable value="{!index+1}" var="index"/>
                            <div class="ques_ans_wrap qa_wrap{!ques.orderNo}" style=" display: flex;">
                                <div class="question_wrap ques{!ques.orderNo} "  >                                    
                                    {!index}.&nbsp;&nbsp;
                                    <apex:outputText value="{!ques.question}" />                                
                                </div>
            
                                
                                <div class="answer_wrap answer{!ques.orderNo} {!IF(ques.isRequired,'required','')}">
                                    <div class="float-left slds-p-left_xx-large">
                                        <!-- Answer Inputs-->                               
                                        <apex:outputPanel rendered="{!ques.answerType=='textarea'}" layout="block">
                                            <apex:inputTextarea value="{!ques.answer}" cols="50" rows="5" html-maxlength="5000" styleClass="textarealong-input input-answer"/>
                                        </apex:outputPanel>
                                        
                                        <apex:selectList rendered="{!ques.answerType=='picklist'}" value="{!ques.answer}" size="1" styleClass="picklist-input input-answer">
                                            <apex:selectOptions value="{!ques.options}"></apex:selectOptions>
                                        </apex:selectList>  
                                        
                                        <apex:selectRadio rendered="{!ques.answerType=='rowselect'}" value="{!ques.answer}" styleClass="selectradio-input">
                                            <apex:selectOptions value="{!ques.options}"></apex:selectOptions>
                                        </apex:selectRadio>
                                        
                                        <apex:outputPanel rendered="{!ques.answerType=='freetext'}" layout="block" styleClass="text-input">
                                            <apex:inputText value="{!ques.answer}" styleClass="input-answer"/>
                                        </apex:outputPanel> 
                                    </div>
                                    <!-- Added as part of US107855 - Amritesh -->
                                    <div class="float-left valign-top">
                                        <apex:outputPanel rendered="{!ques.isRequired}" layout="none"><br/>&nbsp;&nbsp;<font color="red">*required</font></apex:outputPanel>   
                                        <apex:outputPanel styleClass="custom_errmsg" layout="none" rendered="{!NOT(ISBLANK(ques.errorMsg))}">
                                            <apex:outputText value="{! HTMLENCODE(ques.errorMsg)}" escape="false" />
                                        </apex:outputPanel>
                                    </div>
                                </div>
                            </div>
                        </apex:column>                        
                    </apex:dataTable>  
                        </apex:pageBlockSection>
                    </div>
                </div>
                
                <!-- Submit Button -->
                <div class="buttonContainer">      
                    <!-- Sneha US288043 Survey question is getting displayed twice in the feedback section 
                                        if 'Submit' button is clicked more than once START-->
                    
                        <apex:actionFunction name="submitFn" action="{!captureSurvey}" 
        oncomplete="buttonsEnabled(true);" status="status1" rerender="None"></apex:actionFunction>
                    <!-- US288043 changes END-->
                    <apex:commandButton value="Submit" styleClass="submitbutton" onclick="isSubmit=true; return validate_input(event)">
                        
                    </apex:commandButton>
                    &nbsp;&nbsp;&nbsp;&nbsp;
                    <apex:commandButton value="  Skip  " action="{!skipToCase}" onclick="isSubmit=true; return skiptocase()"/>
                </div>
                
                <!-- Footer -->
                <div class="surveyfooter">
                    <apex:outputText value="{!$Label[surveyFooterLabel]}" escape="false" rendered="{!NOT(ISBLANK(surveyFooterLabel))}"/>                   
                </div>
                
            </apex:outputPanel>
            
            <apex:outputPanel rendered="{!displayWarning}">
                <br/>
                <apex:commandButton value="Submit" action="{!captureSurvey}" styleClass="submitbutton" />
                &nbsp;&nbsp;&nbsp;&nbsp;
                <apex:commandButton value="  Back  " action="{!backfromWarning}"/>
            </apex:outputPanel>
            
            <apex:outputPanel rendered="{!isError && $CurrentPage.Parameters.caid!=null}">
                <br/><br/>
                <apex:commandButton action="{!skipToCase}" value="Go to Case >>"/>
            </apex:outputPanel>
        </apex:form>
    </div>
    
    <script>
   function buttonsEnabled(enabled) {
        // retrieve all of the buttons or links on the page
        // with the css class of btn
        var $buttons = jQuery('.btn');
        if (enabled === false) {
            // add the btnDisabled class to give it the look of being disabled
            // add the disabled attribute to actually disable interactability
            $buttons.toggleClass('btnDisabled', true).attr('disabled', 'disabled');
        } else {
            // remove the css class and the disabled attribute
            $buttons.toggleClass('btnDisabled', false).attr('disabled', null);
        } 
    }
    var isSubmit = false;
    window.onbeforeunload = function(evt) {
        
        if(isSubmit) {
            return undefined;
        }
        var message = '{!$Label.Core_IPS_Skip_Survey_Confirmation_Message}';
        if (typeof evt == 'undefined') {
            evt = window.event;
        }
        if (evt) {
            evt.returnValue = message;
        }
        return message;
    }
    
    function validate_input(event) {    
        /* Updated US107855 - Amritesh -start */    
        //validate if required input are not filled
        event.preventDefault();
        var isRequiredEmpty = false;
        // US288043 changes START
      
        if($(".answer_wrap.required").length>0) { 
            if($(".answer_wrap.required .selectradio-input").find("input[type='radio']:checked").length==0) {
                isRequiredEmpty = true;
                alert('{!$Label.Core_IPS_Survey_Question_Required_Message}');
                isSubmit = false;
                return false;
            }
        }
        $(".answer_wrap.required .input-answer").each(function(index) {
            if($(this).val()=='' || $(this).val()==null) {
                isRequiredEmpty = true;
                alert('{!$Label.Core_IPS_Survey_Question_Required_Message}');
                isSubmit = false;            
                return false;
            }
        });        
        if(isRequiredEmpty) {
            isSubmit = false;
            return false;
        }
        /* Updated US107855 - Amritesh - end */
        //validate if any input is not filled
        var isAnyFilled = false;
        $(".input-answer").each(function(){
            if($(this).val()!='' && $(this).val()!=null) {
                isAnyFilled = true;
            }
        });
        if($(".selectradio-input").find("input[type='radio']:checked").length>0) {
            isAnyFilled = true;
        }
        if(!isAnyFilled) {
            var conf = window.confirm("{!$Label.Core_IPS_Survey_Empty_Answer_Warning}");
            if(!conf) {
                isSubmit = false;
            }
            return conf;
        }
        buttonsEnabled(false);
          submitFn();
        // US288043 changes END
        return isAnyFilled;
    }
    
    function skiptocase() {
        var conf = confirm('{!$Label.Core_IPS_Skip_Survey_Confirmation_Message}');
        if(!conf) {
            isSubmit = false;
        }
        return conf;
    }
    </script>
        
