<apex:page standardController="lead" >

<flow:interview name="Reject_Lead" finishLocation="/{!Lead.Id}" buttonLocation="bottom" >
    <apex:param name="vaLeadID" value="{!Lead.Id}" />
    <apex:param name="Currentuser" value="{!$User.Id}"/>    
</flow:interview>
   
<apex:form >
   <div align="center" draggable="false" >
   <apex:commandButton value="Cancel" action="{!cancel}"/ >
   </div>
</apex:form>

</apex:page>