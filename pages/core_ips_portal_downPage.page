        <apex:image value="{!$Resource.intel_sales_downtime_logo}" style="width: 5%;"/>
    </div>
    <div>  
        <center>  
            <div style="padding-top:3%;">
                <h3 style="color: #261aee; font-family: sans-serif; font-size: 20px; text-decoration: underline; text-underline-position: under;">
                    {!$Label.Welcome_to_intel_premier_support_header}
                </h3>
            </div>        
            <div style="width: 55%; padding-top: 1%; padding-left: 4%; text-align: left;">
                <p style="color :#ff0000; font-family: sans-serif; font-size: 15px;">
                    {!$Label.Core_IPS_Downtime_Information} <a href="{!$Label.Core_IPS_Downtime_Email_Link}" id="UProfile_hlProfile" style="text-decoration: none;" target="_blank">{!$Label.Core_IPS_Downtime_Email}</a>
