<apex:page standardController="Core_Opportunity_Features__c" extensions="Core_OppDescriptiveFeaturesController" showHeader="true" tabStyle="Opportunity" title="{!$Label.Core_OppDescriptiveFeaturesTitle}">
    <apex:form >
    <apex:sectionHeader title="Descriptive Features Edit" subtitle="{!sOppName}"/>
    <apex:pageMessages ></apex:pageMessages>
    <apex:pageBlock >
    <br/>
    <apex:pageBlockSection title="Header" columns="2" collapsible="false" >
        <apex:repeat value="{!lstPlatformSelectListWrapper}" var="wrap">
            <apex:pageblocksectionItem >
                {!wrap.sSelectedValue}
                <apex:selectList value="{!wrap.sSelectedValue}" size="1" id="values" >
                    <apex:selectOptions value="{!wrap.lstPlatformOptions}" />
                        <apex:actionSupport event="onchange" action="{!Core_GetFeature}" reRender="thePageBlock" status="counterStatus"/>
                        <apex:actionstatus id="counterStatus">
            <apex:facet name="start">
                <img src="/img/loading32.gif" style="position:relative;left:52%;top:3px;height:20px;width:20px;"/>
            </apex:facet>
        </apex:actionstatus>

                </apex:selectList>
            </apex:pageblocksectionItem>
        </apex:repeat>
        </apex:pageBlockSection> 
        <br/>      
    <apex:pageBlockSection title="Features" id="thePageBlock" collapsible="false">
           <apex:repeat value="{!lstSelectListWrapper}" var="wrap">
                    <apex:pageblocksectionItem rendered="{!!wrap.bIsMultiSelect}">
                        {!wrap.sSelectedValue}
                        <apex:selectList value="{!wrap.sSelectedValue}" size="1" id="valuess" multiselect="false">
                              <apex:selectOptions value="{!wrap.lstPlatformOptions}" />
                        </apex:selectList>
                      </apex:pageblocksectionItem>
                      <apex:pageblocksectionItem rendered="{!wrap.bIsMultiSelect}">
                        {!wrap.sSelectedValue}
                        <c:Core_MultiselectController leftLabel="Available Values"
                            leftOptions="{!wrap.lstPlatformOptions}"
                            rightLabel="Selected Values"
                            rightOptions="{!wrap.lstSelectPlatformOptions}"
                            size="4"
                            width="230px" />
                    </apex:pageblocksectionItem>
                </apex:repeat>
    </apex:pageBlockSection>
    <br/>
    <apex:pageBlockButtons location="Bottom">
         <apex:commandButton value="Save" action="{!saveUpdatedRecord}" />
         <apex:commandButton value="Cancel" action="{!ReturntoOpp}" />
    </apex:pageBlockButtons>
  </apex:pageBlock>
 </apex:form> 
</apex:page>