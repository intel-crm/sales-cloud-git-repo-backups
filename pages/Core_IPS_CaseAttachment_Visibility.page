                <apex:commandButton value="Attach File-Private To Intel" onclick="privatefileInConsole(); return false;"  rendered="{!OR( AND(($Profile.Name !=$Label.Core_IPS_External_Customer_Profile),($Profile.Name!=partnerVal),($Profile.Name !=$Label.Core_IPS_Partner_AE_ProfileName),(Case.RecordType.developerName !=$Label.Core_IPS_ClosedCase_RecordType_Name),(Case.RecordType.developername!=$Label.Core_IPS_GECRecordTypeName)),AND(($Profile.Name == $Label.Core_IPS_Production_Support_IPS_Profile),(Case.RecordType.developerName ==$Label.Core_IPS_ClosedCase_RecordType_Name))) }">    <!-- Added Partner/Partner Agent Profile Too By Prem  -->
                    <!-- Added Partner Profile Too By Prem  -->
                    <apex:param name="privateParameter" value="{!case.id}"/>
                </apex:commandbutton>
                
                
                <apex:commandButton value="Attach File-Private To Intel" onclick="partnerAgentPrivateFileURL(); return false;"  rendered="{!OR( AND(($Profile.Name !=$Label.Core_IPS_External_Customer_Profile),($Profile.Name!=partnerVal),($Profile.Name ==$Label.Core_IPS_Partner_AE_ProfileName),(Case.RecordType.developerName !=$Label.Core_IPS_ClosedCase_RecordType_Name),(Case.RecordType.developername!=$Label.Core_IPS_GECRecordTypeName)),AND(($Profile.Name == $Label.Core_IPS_Production_Support_IPS_Profile),(Case.RecordType.developerName ==$Label.Core_IPS_ClosedCase_RecordType_Name))) }">
                    <!-- Added Partner Profile Too By Prem  -->
                    <apex:param name="privateParameter" value="{!case.id}"/>
