    <script>
    var url = location.href;
    var match = url.match(/&inline=1/);
    if (match != null) { 
        var newUrl = url.replace(/&inline=1/, '');
        //window.top.location=newUrl;--priority 1 violation top is blacklisted
        window.parent.location=newUrl;
    }
    /* Added By Prem For GEC Check */
    function CheckGEC(){
        if('{!Case.Core_IPS_GEC_Flag__c}'=='true'){ 
            // GEC flag checked true. 
            if('{!$Label.Core_IPS_MAG_Support_Org}'==('{!JSENCODE( Case.Core_IPS_Product_Org1__c ) }').substr(0, 15)){ 
                // Equal Support org Id with custom label "Core_IPS_MAG_Support_Org" 
                alert("{!JSENCODE($Label.Core_IPS_GEC_FileAttach_Message)}"); 
                return false;
            }
        }
        return true;
    }
    
    //Added by Aparna on 3/5/2018 for DE36696,DE36701-Release 3
    function openAttachment(recId) {
        var redirectUrl = recId;
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingTabId(function(enclosingResult) {
                sforce.console.getEnclosingPrimaryTabId(function(primaryResult) {
                    sforce.console.openSubtab(primaryResult.id, redirectUrl, true, '', null);
                });
            });
        } else {
            //window.top.location = '/' + redirectUrl;--priority 1 violation top is blacklisted
            window.parent.location = '/' + redirectUrl;
        }
    }
    
    function openUploadedBy(recId) {
        var redirectUrl = recId;
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingTabId(function(enclosingResult) {
                sforce.console.getEnclosingPrimaryTabId(function(primaryResult) {
                    sforce.console.openSubtab(primaryResult.id, redirectUrl, true, '', null);
                });
            });
        } else {
            //window.top.location = '/' + redirectUrl;--priority 1 violation top is blacklisted
            window.parent.location = '/' + redirectUrl;
        }
    }
    
    
    function listInConsole(){
        
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingTabId(function(enclosingResult) {
                sforce.console.getEnclosingPrimaryTabId(function(primaryResult) {
                    sforce.console.openSubtab(primaryResult.id, '{!$Label.Core_IPS_AttachmentPage}?id={!JSENCODE(caseid)}&list=full', true, 'Case: {!JSENCODE(case.CaseNumber)}', null);
                });
            });
        } else {
            window.open('{!$Label.Core_IPS_AttachmentPage}?id={!JSENCODE(caseid)}&list=full','_blank');
        }
        
    }
    
    function privatefileInConsole(){
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingTabId(function(enclosingResult) {
                sforce.console.getEnclosingPrimaryTabId(function(primaryResult) {
                    sforce.console.openPrimaryTab(primaryResult.id, '{!JSENCODE(privateFileURL)}', true, 'Case: {!JSENCODE(case.CaseNumber)}', null);
                });
            });
        } else {
            //window.top.location ='{!privateFileURL}';--priority 1 violation top is blacklisted
            window.parent.location ='{!JSENCODE(privateFileURL)}';
        }
    }
    
    function publicfileInConsole(){
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingTabId(function(enclosingResult) {
                sforce.console.getEnclosingPrimaryTabId(function(primaryResult) {
                    sforce.console.openPrimaryTab(primaryResult.id, '{!JSENCODE(publicFileURL)}', true, 'Case: {!JSENCODE(case.CaseNumber)}', null);
                });
            });
        } else {
            //window.top.location = '{!JSENCODE(publicFileURL)}';--priority 1 violation top is blacklisted
            window.parent.location = '{!JSENCODE(publicFileURL)}';
        }
    }
    
    //Added by Aparna on 26/4/2018 for US104151 for R4.2
    function partnerfileInConsole(){
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingTabId(function(enclosingResult) {
                sforce.console.getEnclosingPrimaryTabId(function(primaryResult) {
                    sforce.console.openPrimaryTab(primaryResult.id, '{!JSENCODE(partnerFileURL) }', true, 'Case: {!JSENCODE(case.CaseNumber)}', null);
                });
            });
        } else {
            //window.top.location ='{!JSENCODE(partnerFileURL)}';--priority 1 violation top is blacklisted
            window.parent.location ='{!JSENCODE(partnerFileURL)}';
        }
    }
    //end by Aparna on 26/4/2018 for US104151
    //Added By Prem 
     function publicURL(){  
     var gecCheck=CheckGEC();
     if(gecCheck)
         //window.top.location ='{!JSENCODE(publicURL)}';--priority 1 violation top is blacklisted
         window.parent.location ='{!JSENCODE(publicURL)}';    
    }
    
    function privateToPartnerURL(){
    //Added by Geetha as per US106618
     if('{!$Profile.Name}' != '{!$Label.Core_IPS_Partner_AE_ProfileName}'){
         var gecCheck=CheckGEC();
         if(gecCheck)
             //window.top.location ='{!JSENCODE(privateToPartnerURL)}';--priority 1 violation top is blacklisted
             window.parent.location ='{!JSENCODE(privateToPartnerURL)}';
     }else{
             //window.top.location ='{!JSENCODE(privateToPartnerURL)}';--priority 1 violation top is blacklisted  
            window.parent.location ='{!JSENCODE(privateToPartnerURL)}'; 
         }
    }
    //End 
    
    function Refreshpage() {
        if(sforce.console.isInConsole())
        {window.parent.location.reload(true);} 
        else {
            window.parent.location.reload(true);}
        
    };
    
    function editinConsole(recId){
        var redirectUrl = recId;
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingTabId(function(enclosingResult) {
                sforce.console.getEnclosingPrimaryTabId(function(primaryResult) {
                    sforce.console.openSubtab(primaryResult.id, '/' +redirectUrl+'/e?retURL={!$Label.Core_IPS_ViewCasePage}?id={!JSENCODE(caseid)}', true, '', null);
                });
            });
        } else {
            //window.top.location ='/' +redirectUrl+'/e?retURL={!$Label.Core_IPS_ViewCasePage}?id={!caseid}';--priority 1 violation top is blacklisted
            window.parent.location ='/' +redirectUrl+'/e?retURL={!$Label.Core_IPS_ViewCasePage}?id={!JSENCODE(caseid)}';
        }
    }   
    // End by Aparna on 3/5/2018 for DE36696,DE36701-Release 3
    
    /* Added By Prem To fix with Partner Agent button  */
    function partnerAgentPrivateFileURL() {
        //window.top.location = '{!JSENCODE(partnerAgentPrivateFileURL)}';--priority 1 violation top is blacklisted
        window.parent.location = '{!JSENCODE(partnerAgentPrivateFileURL)}';
    }
    
    function partnerAgentPublicFileURL(){
    //Added by Geetha as per US106618
     if('{!$Profile.Name}' != '{!$Label.Core_IPS_Partner_AE_ProfileName}'){
         var gecCheck=CheckGEC();
         if(gecCheck)
             //window.top.location = '{!JSENCODE(partnerAgentPublicFileURL)}';--priority 1 violation top is blacklisted
            window.parent.location = '{!JSENCODE(partnerAgentPublicFileURL)}';
     }else{
            //window.top.location = '{!JSENCODE(partnerAgentPublicFileURL)}';--priority 1 violation top is blacklisted
            window.parent.location = '{!JSENCODE(partnerAgentPublicFileURL)}';
     } 
    }
    /* End  */
    
    //Added by Aparna on 1/3/2018 for US95439-Release 4 
    function openLinkFile() {
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingTabId(function(enclosingResult) {
                sforce.console.getEnclosingPrimaryTabId(function(primaryResult) {
                    sforce.console.openPrimaryTab(primaryResult.id, '{!$Label.Core_IPS_LinktoCase_Page}?id={!caseid}', true, 'Case: {!JSENCODE(case.CaseNumber)}', null);
                });
            });
        } else {
            //Below If condition is added  for US99044 by Raj Kommera
            if('{!$Profile.Name}' == '{!$Label.Core_IPS_Partner_AE_ProfileName}'){
                //window.top.location = '{!$Label.Core_IPS_AE_LinktoCase_Page}?id={!JSENCODE(caseid)}';--priority 1 violation top is blacklisted
                window.parent.location = '{!$Label.Core_IPS_AE_LinktoCase_Page}?id={!JSENCODE(caseid)}';
            }
            else{
                //window.top.location = '{!$Label.Core_IPS_LinktoCase_Page}?id={!caseid}';--priority 1 violation top is blacklisted
                window.parent.location = '{!$Label.Core_IPS_LinktoCase_Page}?id={!JSENCODE(caseid)}';
            }
        }
    }
    //End by Aparna on 1/3/2018 for US95439-Release 4
    
    
    </script>
    
