        var uiTheme = "{!JSENCODE($User.UIThemeDisplayed)}";
        if(uiTheme == 'Theme4d'){               
             $Lightning.use("c:core_IPS", function() {
                $Lightning.createComponent("c:caseAttachmentList",
                                           { 
                                               recordId : "{!$CurrentPage.parameters.id}"
                                           },
                                           "attachmentComponentId",
                                           function(component) {
                                           });
            });     
        }
    </script>
     <style>
        .slds-scope .slds-card{border:none!important;}
