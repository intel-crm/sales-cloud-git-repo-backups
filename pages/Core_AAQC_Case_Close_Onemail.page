<apex:page standardController="Case" extensions="Core_AAQC_Case_Close_Onemail" showheader="false" sidebar="false" >
<apex:slds />
<apex:form id="theFormId">
<apex:image id="Logo" style="width:100%;height:50%;" value="https://intel--c.na74.content.force.com/servlet/servlet.ImageServer?id=0153F000000F2QC&oid=00D3F0000000Nmr&lastMod=1543355524000" />    
<apex:pageBlock >
    <apex:pageBlockButtons id="buttonSessionId" location="top">
            <apex:actionStatus id="spinnerStatus">
                <apex:facet name="start">
                    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.25; z-index: 1000; background-color: black;">
                        &nbsp;
                    </div>
                    <div style="position: fixed; left: 0; top: 0; bottom: 0; right: 0; z-index: 1001; margin: 15% 50%">
                        <div style="display: inline-block; padding: 2px; background-color: #fff; width: 125px;">
                            <img src="/img/loading.gif" style="float: left; margin: 8px;" />
                            <span style="display: inline-block; padding: 10px 0px;">Please Wait...</span>
                        </div>
                    </div>
                </apex:facet>
            </apex:actionStatus>
                    <b><apex:outputLabel value="{!$Label.Core_AAQC_Case_Close_Message}"/></b> &nbsp;&nbsp;
            <apex:commandButton value="Yes" styleClass="slds-button slds-button_brand" action="{!redirectYes}" status="spinnerStatus"/>
            <apex:commandButton value="No" styleClass="slds-button slds-button_neutral" action="{!redirectNo}" status="spinnerStatus"/>
    </apex:pageBlockButtons>
    <apex:pageBlockSection id="caseInfoId" title="Case Information" columns="1" collapsible="false">

                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel > Resolution Type</apex:outputLabel>
                    <apex:outputPanel >
                        <apex:outputField value="{!objCase.Core_AAQC_Resolution_Type__c}"/>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem> 
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Case Number</apex:outputLabel>
                    <apex:outputPanel >
                        <apex:outputField value="{!objCase.CaseNumber}"/>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Resolution comment</apex:outputLabel>
                    <apex:outputPanel >
                        <apex:outputText value="{!if((objComInquiry != null && objComInquiry.size>0),objComInquiry[0].Core_AAQC_Resolution_Comments__c,'')}" />
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Last Case Comment</apex:outputLabel>
                    <apex:outputPanel >
                        <apex:outputText value="{!resolutionComment}" />
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
                

      </apex:pageBlockSection>
</apex:pageBlock>
</apex:form>    
</apex:page>