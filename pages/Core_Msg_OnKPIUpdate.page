Vf page Name:  Core_Msg_OnKPIUpdate
Version     : 1.0 
Created Date: 19/12/2018
Description : Display a warning message on Opportunity detail section below the Pre Submit Check field.
* Developer                   Date                   Description
* ----------------------------------------------------------------------------                 
* Sougata Sarkar           19/12/2018               Initial Revision

--->
<apex:page standardController="Opportunity" showHeader="false" applyHtmlTag="false"> 
    <apex:form >
        <apex:outputPanel rendered="true">
            <apex:outputPanel rendered="{!$User.UITheme == 'Theme3'}">
                <div  style="font-weight:bold;color:orange;margin-left:35%;">{!$Label.Core_Msg_OnKPIUpdate_Label}</div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!$User.UITheme != 'Theme3'}">
                <div  style="font-weight:bold;color:orange;">{!$Label.Core_Msg_OnKPIUpdate_Label}</div>
            </apex:outputPanel>
        </apex:outputPanel>
    </apex:form>
</apex:page>