<apex:page standardController="Opportunity" showHeader="false" applyHtmlTag="false"> 
    <apex:form >
        <apex:outputPanel rendered="true">
            <apex:outputPanel rendered="{!$User.UITheme == 'Theme3'}">
                <div  style="font-weight:bold;color:blue;font-size:10px;">{!$Label.Core_Msg_OnKPIUpdate_Label}: <a href="http:goto/matchingKPIs" target="_blank">goto/matchingKPIs</a> for details</div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!$User.UITheme != 'Theme3'}">
                <div  style="font-weight:bold;color:blue;font-size:10px;">{!$Label.Core_Msg_OnKPIUpdate_Label}: <a href="http:goto/matchingKPIs" target="_blank">goto/matchingKPIs</a> for details</div>
            </apex:outputPanel>
        </apex:outputPanel>
    </apex:form>
</apex:page>