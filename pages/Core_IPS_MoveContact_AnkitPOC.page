<apex:page extensions="Core_IPS_MoveContact_AnkitPOC" standardController="Contact" sidebar="false" id="pgid"
           standardStylesheets="{!$User.UITheme == 'Theme3'}" lightningStylesheets="{!$User.UITheme != 'Theme3'}">
    <apex:outputPanel rendered="{!$User.UITheme != 'Theme3'}">
        <apex:slds />
    </apex:outputPanel>
    <apex:includeScript value="{!URLFOR($Resource.Core_Jquery)}"/>
    <style type="text/css">
        .customPopup {
        	background-color: white; border-width: 1px; border-style: solid; z-index: 9999; left: 50%; border-radius:6px; padding:11px; position: absolute; width: 600px; margin-left: -240px; top:100px;
        }
        .popupBackground{ background-color:black; opacity: 0.20; filter: alpha(opacity = 20); position: absolute; width: 100%; height: 100%; top: 0; left: 0; z-index: 9998; } 
        .closeButton {
        	float: right;
        }
        
        }
    </style>
    <style>
        .errorMessageInline{
            position: relative;
            font-size: 12px;
            font-family: Arial;
            color: #fc4c02;
            font-weight: bold;
        }
        .tdBgColor{
            bgcolor:#A3E4D7
        }
        .pbTitle{
                display: inherit;
        }
        .btns {
            width:125px;
            margin:0 auto;
        }
        body .btns input.btn {
           margin-right: 10px;
           padding: 5px 10px;
                
         }
         .contactBlock .tertiaryPalette {
            background-color: #ffc !important;
            color:#27282e !important;
         }
    </style>
    
    <script type="text/javascript"> 
    
    $ = jQuery.noConflict();
    //Validation for Contact and Account fields on clicking on save cases
    function validateSave(){
        var callFun = true;
        var keepCaseExists = false;
        var MoveCasesExists = false;
        var caseCount = '{!caseCount}';
        var hasAccessToAcctSelection = '{!hasAccessToAcctSelection}';
        if(hasAccessToAcctSelection == 'false'){
            $('[id$=errorMessage]').text('User do not have the permission to perform the operation. Only Data Ops can perform the change');
            return false;
        }
        
        $('[id$=chkbxKeepCases]').each(function(){
            console.log(this.checked);
            if(this.checked == true){
                keepCaseExists = true;
            }
            if(this.checked == true){
                MoveCasesExists = true;
            }
        });
        $('[id$=chkbxKeepCasesRows]').each(function(){
            console.log(this.checked);
            if(this.checked == true){
                keepCaseExists = true;
            }
        });

        
        if(keepCaseExists == true && $('[id$=conId]').val() == '' && caseCount > 0 ){
            $('[id$=errorMessage]').text('Please Select Contact');
            callFun = false; 
        }
        if(MoveCasesExists == true && $('[id$=accId]').val() == ''){
            $('[id$=errorMessage]').text('Please Select Account');
            callFun = false;
        }
        if($('[id$=accId]').val() == ''){
            $('[id$=errorMessage]').text('Please Select Account');
            callFun = false;
        }
        if(callFun == true){
            saveCases(); 
        }
        return  callFun;
    }
    //End of Validation for Contact and Account fields on clicking on save cases
    //Code for override contact lookup
    function openLookup(baseURL, width, modified, searchParam){
        var originalbaseURL = baseURL;
        var originalwidth = width;
        var originalmodified = modified;
        var originalsearchParam = searchParam;
        
        var lookupType = baseURL.substr(baseURL.length-3, 3);
        if (modified == '1') 
            baseURL = baseURL + searchParam;
        
        var isCustomLookup = false;
        
        // Following "001" is the lookup type for Account object so change this as per your standard or custom object
        if(lookupType == "003"){
            
            var urlArr = baseURL.split("&");
            console.log('==urlArr='+urlArr);
            var txtId = '';
            if(urlArr.length > 2) {
                urlArr = urlArr[1].split('=');
                txtId = urlArr[1];
            }
            console.log('===came here==='+lookupType);
            // Following is the url of Custom Lookup page. You need to change that accordingly
            baseURL = "/apex/Core_CustomContactLookup?txt=" + txtId+'&conaccid='+'{!currContact.Accountid}';
            
            // Following is the id of apex:form control "myForm". You need to change that accordingly
            baseURL = baseURL + "&frm=" + escapeUTF("{!$Component.myForm}");
            if (modified == '1') {
                baseURL = baseURL + "&lksearch=" + searchParam;
            }
            
            // Following is the ID of inputField that is the lookup to be customized as custom lookup
            console.log(txtId.indexOf('conId'));
            if(txtId.indexOf('conId') > -1 ){
                isCustomLookup = true;
            }
        }
        
        if(isCustomLookup == true){
            openPopup(baseURL, "lookup", 350, 480, "width="+width+",height=480,toolbar=no,status=no,directories=no,menubar=no,resizable=yes,scrollable=no", true);
        }
        else {
            if (modified == '1') originalbaseURL = originalbaseURL + originalsearchParam;
            openPopup(originalbaseURL, "lookup", 350, 480, "width="+originalwidth+",height=480,toolbar=no,status=no,directories=no,menubar=no,resizable=yes,scrollable=no", true);
        } 
    }
    //Code for override contact lookup
    </script>
    
    <apex:form >
        <!--<apex:actionFunction action="{!updateCasesOnSave}" name="saveCases"></apex:actionFunction> -->
        <!-- <apex:actionFunction action="{!cancelPage}" name="callCancel"></apex:actionFunction> -->
        <apex:sectionHeader title="Account : {!currContact.Account.Name}" subtitle="{!currContact.Name}"/>
        
        <apex:pageBlock >
            <apex:pageMessages escape="false"></apex:pageMessages>
            <apex:pageBlockButtons location="top" id="pbBtns" >
                  <apex:outputPanel id="buttonPanel" layout="block" rendered="{!NOT(gecCaseFound)}" style="text-align: center;">
                    <apex:outputLabel rendered="{!hasAccessToAcctSelection}" > Identify the Account to move the selected Contact to: &nbsp;
                        <apex:inputField value="{!targetAccount.AccountId}" id="accId" styleClass="slds-is-open"/>
                    </apex:outputLabel>
                    
               
                     <!--<input type="Button" class="btn" value=" Save " onClick="validateSave();" />&nbsp;&nbsp;&nbsp; -->
                    <apex:commandButton action="{!updateCasesOnSave}" value=" Save " onClick="return  validateSave();"  rendered="{!(hasAccessToAcctSelection)}" styleClass="slds-button slds-button_neutral"></apex:commandButton>&nbsp;&nbsp;&nbsp;
                    <apex:commandButton action="{!updateCasesOnSave}" value=" Save " onClick="return  false;"  rendered="{!NOT(hasAccessToAcctSelection)}" disabled="true" styleClass="slds-button slds-button_neutral"></apex:commandButton>&nbsp;&nbsp;&nbsp;
                    <!-- <input type="Button" class="btn" value="Cancel" onClick="callCancel();"/>&nbsp;&nbsp;&nbsp; -->
                    <apex:commandButton action="{!cancel}" value="Cancel "  styleClass="slds-button slds-button_neutral"></apex:commandButton>
                    <span id="errorMessage" class="errorMessageInline"></span>
                    <apex:commandButton action="{!cancelPage}" value=" Cancel " rendered="{!gecCaseFound}"  styleClass="slds-button slds-button_neutral"></apex:commandButton>
                </apex:outputPanel>    
            </apex:pageBlockButtons>
            <apex:outputPanel id="popup" >
                <apex:outputPanel styleClass="popupBackground" layout="block" rendered="{!displayPopUp}"/> 
                <apex:outputPanel id="popInnerOutputPnl" styleClass="customPopup" layout="block" rendered="{!displayPopUp}" style="text-align:center;">
                    <apex:pageBlockSection title="Warning Message" collapsible="false"/>
                    <apex:outputPanel rendered="{!$User.UITheme == 'Theme3'}">
                        <br/>
                    </apex:outputPanel>
                    <apex:outputtext value="{!moveAccoutWarningMessage}" escape="false"/><br/><br/>
                    <div class="btns" style="{!IF($User.UITheme == 'Theme3', 'display:block;', 'display:none;')}">
                            <apex:commandButton value="Cancel" title="Close the popup"  action="{!closePopup}" styleClass="closeButton slds-button slds-button_neutral"  rerender="accId,popup"/> <!--action="{!closePopup}-->
                            <apex:commandButton value="Ok"  action="{!moveAccountchange}"  styleClass="closeButton slds-button slds-button_neutral" />
                    </div>
                    <apex:outputPanel rendered="{!$User.UITheme != 'Theme3'}">
                        <div style="display:inline;">
                            <apex:commandButton value="Ok"  action="{!moveAccountchange}"  styleClass="slds-button slds-button_neutral" />
                        </div>
                        <div style="display:inline;">
                            <apex:commandButton value="Cancel" title="Close the popup"  action="{!closePopup}" styleClass="slds-button slds-button_neutral"  rerender="accId,popup"/> <!--action="{!closePopup}-->
                        </div>
                    </apex:outputPanel>
                </apex:outputPanel>
            </apex:outputPanel>
            <apex:pageblockSection columns="1" >
            <apex:outputPanel rendered="{!(hasAccessToAcctSelection )}" >
                <apex:outputLabel rendered="{!casesWithOUTprojectId.size > 0}" > Select to transfer Cases to another Contact (on the original Account):
                            <apex:inputCheckbox value="{!keepCases}"  id="chkbxKeepCases" style="vertical-align:middle;margin-left: 5px;" >
                                <apex:actionSupport event="onchange" reRender="caseTable1, caseTable2"/>
                            </apex:inputCheckbox>
                 </apex:outputLabel>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <apex:outputLabel rendered="{!casesWithOUTprojectId.size > 0}" >  Identify the Contact to transfer the Cases to: &nbsp;
                        <apex:inputField value="{!contactLookUp.ContactId}" id="conId"/>
                    </apex:outputLabel>
            </apex:outputPanel>     
            </apex:pageblockSection>
           
            
        </apex:pageBlock>
    </apex:form>
</apex:page>