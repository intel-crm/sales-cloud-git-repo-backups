<apex:page id="thePage" title="Opportunity Clone" docType="html-5.0" sidebar="true" standardStylesheets="true"
           standardController="Opportunity" extensions="Core_Opportunity_Clone_Controller">

    <apex:includeScript value="{!$Resource.Core_Jquery}"/>  
    <apex:includeScript value="{!$Resource.Core_JqueryUIBlock}"/> 
        
    <style>
        .sectionLabel
        {
            font-size: 18px;        
        }
        .searchAndClear
        {
            float: left; 
            margin-left: 40%;
        }
                
        .lightWeightDivider
        {
            border-width: 1px; 
            border-style: solid; 
            border-color: #EEEEEE;            
        }
    
        .heavyWeightDivider
        {
            border-width: 2px; 
            border-style: solid;
        }
        
        .searchMessageStyle
        {
            width: 400px;
        }
                
        .spin
        {
            position:relative;
            left:52%;
            top:3px;
            height:20px;
            width:20px;
        }        
    </style>
    
    <apex:form id="theForm">
        <br/>
        <apex:panelGrid columns="2">
            <apex:outputPanel style="float:left">
                <img src="/s.gif" alt="Opportunity" class="pageTitleIcon" title="Opportunity"/>
            </apex:outputPanel>
            <apex:outputPanel style="float:left">
                <apex:outputText style="font-size:0.9em;font-weight:bold;" value="New Opportunity"/>
                <br/>
                <apex:outputText style="font-size:22px;" value="Clone of {!currentOpportunity.Name}"/>
            </apex:outputPanel>
        </apex:panelGrid>
        <br/>       

        <apex:pageMessages />        
        <!-- Section to show the error message if does not enter search criteria -->
        <apex:outputPanel id="errorMessage" rendered="{!searchShowMessage}">
            <apex:outputPanel styleClass="searchMessageStyle" layout="block">
                <br/>
                    <apex:pageMessage escape="true" title="{!searchMessage}" severity="{!searchSeverity}" strength="1" ></apex:pageMessage>
                <br/>
            </apex:outputPanel>
        </apex:outputPanel>

        <apex:pageBlock id="thePageBlock" tabStyle="Opportunity" rendered="{!searchShowPage}">

            <apex:outputPanel >
                <apex:outputLabel style="font-Size:12px">Please unselect any items you don’t want to copy to the new opportunity.</apex:outputLabel>
                <br/>
            </apex:outputPanel>

            <hr class="lightWeightDivider" style="margin-top: 10px;"/>

            <apex:outputpanel id="relatedListPanel">                
                <apex:pageBlockSection title="CLONE Related Lists"  rendered="{!showOppFeatures || showOppPartner || showOpportunityProductOption}">
                    <table class="declarativeFilterTable">
                        <apex:pageBlockSection columns="2" html-style="width:500px; margin-top:-8px; margin-bottom:-8px">
                            <apex:outputLabel style="font-weight: bold">Related List</apex:outputLabel>
                            <apex:outputLabel style="font-weight: bold">Selected</apex:outputLabel>
                        </apex:pageBlockSection>          
                    
                        <apex:pageBlockSection columns="2" html-style="width:500px; margin-top:-8px; margin-bottom:-8px" rendered="{!showOppFeatures}">
                            <apex:pageblockSectionItem dataStyle="max-width:70px" labelStyle="max-width:0px">
                                <apex:outputLabel >Descriptive Features</apex:outputLabel>
                            </apex:pageblockSectionItem>                           
                            <apex:pageblockSectionItem dataStyle="max-width:70px" labelStyle="max-width:0px">
                                <apex:inputCheckbox style="margin-left:16px" value="{!opportunityFeaturesSelected}">
                                    <apex:actionSupport event="onclick" action="{!toggleDisplay}" reRender="descFeaturePanel"/>
                                </apex:inputCheckbox>
                            </apex:pageblockSectionItem>                           
                        </apex:pageBlockSection>     

                        <!--  The line feed needed to be outside of the previous block  -->
                        <apex:pageBlockSection columns="1" rendered="{!showOppFeatures}">
                            <br/>                                     
                        </apex:pageBlockSection>     


                        <apex:pageBlockSection columns="2" html-style="width:500px; margin-top:-8px; margin-bottom:-8px" rendered="{!showOppPartner}">
                            <apex:pageblockSectionItem dataStyle="max-width:70px" labelStyle="max-width:0px">
                                <apex:outputLabel >Opportunity Partners</apex:outputLabel>
                            </apex:pageblockSectionItem>                           
                            <apex:pageblockSectionItem dataStyle="max-width:70px" labelStyle="max-width:0px">
                                <apex:inputCheckbox style="margin-left:16px" value="{!opportunityPartnersSelected}">
                                    <apex:actionSupport event="onclick" action="{!toggleDisplay}" reRender="oppPartnerPanel"/>
                                </apex:inputCheckbox>
                            </apex:pageblockSectionItem>                           
                        </apex:pageBlockSection>     

                        <!--  The line feed needed to be outside of the previous block  -->
                        <apex:pageBlockSection columns="1" rendered="{!showOppPartner}">
                            <br/>                                     
                        </apex:pageBlockSection>     
                                        
                        <apex:pageBlockSection columns="2" html-style="width:500px; margin-top:-8px; margin-bottom:-8px" rendered="{!showOpportunityProductOption}">
                            <apex:pageblockSectionItem dataStyle="max-width:70px" labelStyle="max-width:0px">
                                <apex:outputLabel >Opportunity Products</apex:outputLabel>
                            </apex:pageblockSectionItem>                           
                            <apex:pageblockSectionItem dataStyle="max-width:70px" labelStyle="max-width:0px">
                                <apex:inputCheckbox style="margin-left:16px" value="{!opportunityProductSelected}">
                                    <apex:actionSupport event="onclick" action="{!toggleDisplay}" reRender="oppProductPanel"/>
                                </apex:inputCheckbox>
                            </apex:pageblockSectionItem>                           
                        </apex:pageBlockSection>     

                        <!--  The line feed needed to be outside of the previous block  -->
                        <apex:pageBlockSection columns="1" rendered="{!showOpportunityProductOption}">
                            <br/>                                     
                        </apex:pageBlockSection>     
                                 
                    </table>            
                </apex:pageBlockSection>            
            </apex:outputpanel>

            <apex:outputpanel id="oppTeamPanel">
                <apex:pageBlockSection title="CLONE Opportunity Team Members" Columns="1" rendered="{!opportunityTeamSelected}">
                    <apex:pageBlockTable value="{!lstSelectOppTeam}" var="lc" border="1" width="200%"> 
                        <apex:column style="width:40px">
                            <apex:facet name="header">Clone</apex:facet>
                            <apex:InputCheckbox value="{!lc.memberSelected}" disabled="{!lc.readOnly}"/>
                        </apex:column>                
                        <apex:column >
                            <apex:facet name="header">Team Member</apex:facet>
                            <apex:outputText value="{!lc.name}"/>
                        </apex:column> 
                        <apex:column >
                            <apex:facet name="header">Access Level</apex:facet>
                            <apex:outputText value="{!lc.opportunityAccessLevel}"/>
                        </apex:column>
                        <apex:column >
                            <apex:facet name="header">Member Role</apex:facet>
                            <apex:outputText value="{!lc.teamMemberRole}"/>
                        </apex:column>                
                        <apex:column >
                            <apex:facet name="header">Team Member Region</apex:facet>
                            <apex:outputText value="{!lc.core_Team_Member_Geo}"/>
                        </apex:column>                
                    </apex:pageBlockTable> 
                </apex:pageBlockSection>            
            </apex:outputpanel>

            <apex:outputPanel id="inactiveOppTeamPanel">
                <apex:pageBlockSection title="NOT COPIED - Inactive Opportunity Team Members" Columns="1" rendered="{!showInactiveOppTeam && opportunityTeamSelected}">
                    <apex:pageBlockTable value="{!lstInactiveOppTeam}"  var="lc" border="1" width="200%"> 
                        <apex:column >
                            <apex:facet name="header">Team Member</apex:facet>
                            <apex:outputText value="{!lc.User.Name}"/>
                        </apex:column>
                        <apex:column >
                            <apex:facet name="header">Member Role</apex:facet>
                            <apex:outputText value="{!lc.TeamMemberRole}"/>
                        </apex:column>
                        <apex:column >
                            <apex:facet name="header">Team Member Region</apex:facet>
                            <apex:outputText value="{!lc.Core_Team_Member_Geo__c}"/>
                        </apex:column>                
                        <apex:column >
                            <apex:facet name="header">Status</apex:facet>
                            <apex:outputText value="Inactive"/>                            
                        </apex:column>                
                    </apex:pageBlockTable> 
                </apex:pageBlockSection>            
            </apex:outputPanel>

            <hr class="heavyWeightDivider colorChoice primaryPalette"/>

            <apex:outputpanel id="descFeaturePanel">
                <apex:pageBlockSection title="NOT COPIED - Inactive Descriptive Features" Columns="1" rendered="{!showInactiveOppFeatures && opportunityFeaturesSelected}">
                    <apex:pageBlockTable value="{!lstInactiveOppFeatures}"  var="lc" border="1" width="200%"> 
                        <apex:column >
                            <apex:facet name="header">Feature Type</apex:facet>
                            <apex:outputText value="{!lc.Core_Feature_Type__c}"/>
                        </apex:column>
                        <apex:column >
                            <apex:facet name="header">Feature Name</apex:facet>
                            <apex:outputText value="{!lc.Core_Feature_Name__c}"/>
                        </apex:column>
                        <apex:column >
                            <apex:facet name="header">Status</apex:facet>
                            <apex:outputText value="Inactive"/>                            
                        </apex:column>                
                    </apex:pageBlockTable> 
                </apex:pageBlockSection>            
            </apex:outputpanel>

            <apex:outputPanel id="oppPartnerPanel">
                <apex:pageBlockSection title="NOT COPIED - Opportunity Partner (Vendor or Inactive)" Columns="1" rendered="{!showInactiveOppPartner && opportunityPartnersSelected}">
                    <apex:pageBlockTable value="{!lstInactiveOppPartner}"  var="lc" border="1" width="200%"> 
                        <apex:column >
                            <apex:facet name="header">Partner</apex:facet>
                            <apex:outputText value="{!lc.Core_Partner__r.Name}"/>
                        </apex:column>
                        <apex:column >
                            <apex:facet name="header">Partner Role</apex:facet>
                            <apex:outputText value="{!lc.Core_Partner_Role__c}"/>
                        </apex:column>
                        <apex:column >
                            <apex:facet name="header">Partner Type</apex:facet>
                            <apex:outputText value="{!lc.Core_Partner_Type__c}"/>
                        </apex:column>                
                        <apex:column >
                            <apex:facet name="header">Partner Program</apex:facet>
                            <apex:outputText value="{!lc.Core_Partner_Program__c}"/>
                        </apex:column>                
                        <apex:column >
                            <apex:facet name="header">Status</apex:facet>
                            <apex:outputText value="Inactive" rendered="{!lc.Core_Partner__r.Core_Deactivated__c = true}"/>                            
                            <apex:outputText value="Active"   rendered="{!lc.Core_Partner__r.Core_Deactivated__c = false}"/>                            
                        </apex:column>                
                    </apex:pageBlockTable> 
                </apex:pageBlockSection>            
            </apex:outputPanel>


            <apex:outputPanel id="oppProductPanel">
                <apex:pageBlockSection title="NOT COPIED - Inactive Opportunity Products" Columns="1" rendered="{!showInactiveOppProduct && opportunityProductSelected}">
                    <apex:pageBlockTable value="{!lstInactiveOppProduct}"  var="lc" border="1" width="200%"> 
                        <apex:column >
                            <apex:facet name="header">Name</apex:facet>
                            <apex:outputText value="{!lc.Name}"/>
                        </apex:column>
                        <apex:column >
                            <apex:facet name="header">Type</apex:facet>
                            <apex:outputText value="{!lc.Core_Product_Type__c}"/>
                        </apex:column>
                        <apex:column >
                            <apex:facet name="header">Quantity</apex:facet>
                            <apex:outputText value="{!lc.Quantity}"/>
                        </apex:column>                
                        <apex:column >
                            <apex:facet name="header">Total Price</apex:facet>
                            <apex:outputText value="{!lc.TotalPrice}"/>
                        </apex:column>                
                        <apex:column >
                            <apex:facet name="header">Product Status</apex:facet>
                            <apex:outputText value="{!lc.Core_Status__c}"/>
                        </apex:column>                
                        <apex:column >
                            <apex:facet name="header">Status</apex:facet>
                            <apex:outputText value="Inactive"/>                            
                        </apex:column>                
                    </apex:pageBlockTable> 
                </apex:pageBlockSection>            
            </apex:outputPanel>

            <br/>
            <br/>

            <!--  SEARCH AND CANCEL BUTTONS  -->                      
            <apex:outputPanel >
                <div class="searchAndClear">
                    <apex:commandButton id="continueButton" value="Continue" status="counterStatus" action="{!continueClone}"/> 
                    <apex:actionstatus id="counterStatus">
                        <apex:facet name="start">
                            <apex:image url="/img/loading32.gif" width="20" />
                        </apex:facet>
                    </apex:actionstatus>                  
                    <apex:commandButton id="cancelButton" value="Cancel" action="{!cancelClone}"/> 
                </div>
            </apex:outputPanel>
            <br/>
            <br/>
        </apex:pageBlock>
        <apex:outputPanel rendered="{!!searchShowPage}">
            <hr class="heavyWeightDivider colorChoice primaryPalette"/>
            <div class="searchAndClear">
                <apex:commandButton id="returnButton" value="Return" action="{!cancelClone}"/> 
            </div>
        </apex:outputPanel>
    </apex:form>
</apex:page>