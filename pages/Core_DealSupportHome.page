        <script type='text/javascript'> 
            function setFocusOnLoad() {};
            function openOrderSeed(url){
                if (isIE()) { // bypass checks because ie cant make cross domain requests without relaxing security
                    openPopup(url);
                }
                else{
                    var http = new XMLHttpRequest();
                    try
                    {
                      http.open('GET', '{!$Label.Core_Intel_Network_Resource}', false);
                      http.send();
                      openPopup(url);
                    }
                    catch (error)
                    {
                      alert('An error has occured. Please make sure you are on the Intel network');
                    }
                }
            }
            function openPopup(url){
                newWin=window.open(url, 'Popup','height=500,width=1000,left=100,top=100,scrollbars=yes,toolbar=no,status=no, resizable=yes');
                if (window.focus) 
                {
                newWin.focus();
                }
            }
            function isIE() {
              var ua = window.navigator.userAgent;
              var msie = ua.indexOf("MSIE ");
              return (msie > -1 || !!navigator.userAgent.match(/Trident.*rv\:11\./));
            }
            function runOnEnter(ev) 
            { 
                if (window.event && window.event.keyCode == 13 || ev.which == 13) 
                { 
                    applyFilters(); 
                    return false; 
                } 
                else 
                { 
                    return true; 
                } 
            } 
       </script> 
