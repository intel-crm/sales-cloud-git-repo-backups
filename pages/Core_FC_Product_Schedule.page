<apex:page standardController="Opportunity" extensions="Core_FC_ProductSchedule_ExtController" action="{!deleteAllBlankQuantity}">
    <style type="text/css">
        .opportunityBlock{
            width:100%;
        }
    </style>
    
    <apex:slds />    
    <apex:form >
        <apex:outputPanel id="showMigrateLink">
            <apex:pagemessages id="errMsg"/>
            <apex:commandLink value="{!$Label.Core_FC_Migrate6QPS}" action="{!migrate6QPSMethod}" rendered="{!oliPresentFlag}" style="margin-left:2%;"/>
        </apex:outputPanel>
        <apex:pageBlock id="pb1" rendered="{!qtrNameList.size > 0}">        
            <apex:pageblockSection collapsible="false" columns="1"> 
                <apex:outputPanel id="table1">
                    <apex:pageblockTable value="{!forecastTable}" var="fc" style="width:101%;margin-left:-1em;" rendered="{!NOT(editAll)}" columnsWidth="50%,12%,11%,4%,4%,4%,4%,4%,4%,5%,4%">
                        <apex:column headerValue="Product Name">
                            <apex:outputLink value="/{!fc.fcObjList[0].Core_Opp_Line_Item_RecordID__c}" target="_blank">
                                {!fc.fcObjList[0].Core_Opp_FC_Product__r.Name}
                            </apex:outputLink>
                        </apex:column>
                        <apex:column headerValue="Vendor" value="{!fc.fcObjList[0].Core_FC_Vendor__c}"/>
                        <apex:column headerValue="" >{!$Label.Core_FC_ForecastQuantity}</apex:column>                   
                        <apex:column headerValue="{!qtrNameList[0]}" value="{!fc.fcObjList[0].Core_Opp_FC_Quantity__c}"/>
                        <apex:column headerValue="{!qtrNameList[1]}" value="{!fc.fcObjList[1].Core_Opp_FC_Quantity__c}"/>                    
                        <apex:column headerValue="{!qtrNameList[2]}" value="{!fc.fcObjList[2].Core_Opp_FC_Quantity__c}"/>                    
                        <apex:column headerValue="{!qtrNameList[3]}" value="{!fc.fcObjList[3].Core_Opp_FC_Quantity__c}"/>                    
                        <apex:column headerValue="{!qtrNameList[4]}" value="{!fc.fcObjList[4].Core_Opp_FC_Quantity__c}"/>                    
                        <apex:column headerValue="{!qtrNameList[5]}" value="{!fc.fcObjList[5].Core_Opp_FC_Quantity__c}"/>
                        <apex:column headerValue="{!$Label.Core_FC_ForecastedQuantity}" value="{!fc.fcObjList[0].Core_FC_4Q_Shed_Quantity__c}"/>
                        <apex:column headerValue="{!$Label.Core_FC_LastModifiedDate}" value="{!fc.fcObjList[0].Core_FC_Last_Modified_Date__c}"/>
                    </apex:pageblockTable>
                    <apex:pageblockTable value="{!forecastTable}" var="fc" style="width:101%;margin-left:-1em;" rendered="{!editAll}" columnsWidth="50%,12%,11%,4%,4%,4%,4%,4%,4%,5%,4%">
                        <apex:column headerValue="Product Name">
                            <apex:outputLink value="/{!fc.fcObjList[0].Core_Opp_Line_Item_RecordID__c}" target="_blank">
                                {!fc.fcObjList[0].Core_Opp_FC_Product__r.Name}
                            </apex:outputLink>
                        </apex:column>
                        <apex:column headerValue="Vendor" value="{!fc.fcObjList[0].Core_FC_Vendor__c}"/>
                        <apex:column headerValue="" >{!$Label.Core_FC_ForecastQuantity}</apex:column>                   
                        <apex:column headerValue="{!qtrNameList[0]}"><apex:inputText value="{!fc.viewQuantityList[0]}" style="width:90%;"/></apex:column>
                        <apex:column headerValue="{!qtrNameList[1]}"><apex:inputText value="{!fc.viewQuantityList[1]}" style="width:90%;"/></apex:column>
                        <apex:column headerValue="{!qtrNameList[2]}"><apex:inputText value="{!fc.viewQuantityList[2]}" style="width:90%;"/></apex:column>
                        <apex:column headerValue="{!qtrNameList[3]}"><apex:inputText value="{!fc.viewQuantityList[3]}" style="width:90%;"/></apex:column>
                        <apex:column headerValue="{!qtrNameList[4]}"><apex:inputText value="{!fc.viewQuantityList[4]}" style="width:90%;"/></apex:column>
                        <apex:column headerValue="{!qtrNameList[5]}"><apex:inputText value="{!fc.viewQuantityList[5]}" style="width:90%;"/></apex:column>
                        <apex:column headerValue="{!$Label.Core_FC_ForecastedQuantity}" value="{!fc.fcObjList[0].Core_FC_4Q_Shed_Quantity__c}"/>
                        <apex:column headerValue="{!$Label.Core_FC_LastModifiedDate}" value="{!fc.fcObjList[0].Core_FC_Last_Modified_Date__c}"/>
                    </apex:pageblockTable>                  
                </apex:outputPanel>                
            </apex:pageblockSection>
            <apex:pageblockButtons location="top">
                <apex:outputPanel id="addPanel" >
                    <apex:actionStatus id="mySaveStatus2"> 
                        <apex:facet name="stop"> 
                            <apex:commandbutton value="Add Quarter" id="addQtrButton" action="{!addQuarterMethod}" rendered="{!NOT(editAll)}" status="mySaveStatus2" rerender="table1,savePanel,addPanel,pm2" title="{!$Label.Core_FC_AddQuarterMsg}" alt="{!$Label.Core_FC_AddQuarterMsg}"/>
                        </apex:facet> 
                        <apex:facet name="start">
                            <apex:outputPanel id="pm2">
                            <apex:commandbutton value="Adding..." disabled="true" id="addQtrButton1" action="{!addQuarterMethod}" rendered="{!NOT(editAll)}" status="mySaveStatus2" rerender="table1,savePanel,addPanel" title="{!$Label.Core_FC_AddQuarterMsg}" alt="{!$Label.Core_FC_AddQuarterMsg}"/>
                            </apex:outputPanel>
                        </apex:facet>
                    </apex:actionStatus>
                    <!--<apex:commandbutton value="Add Quarter" id="addQtrButton" action="{!addQuarterMethod}" rendered="{!NOT(editAll)}" rerender="table1,savePanel,addPanel" title="{!$Label.Core_FC_AddQuarterMsg}" alt="{!$Label.Core_FC_AddQuarterMsg}"/>-->
                    <apex:actionStatus id="mySaveStatus3"> 
                        <apex:facet name="stop"> 
                            <apex:commandButton value="Edit All Schedule Quantity" id="editButton" action="{!editAllMethod}" rendered="{!NOT(editAll)}" status="mySaveStatus3" rerender="table1,savePanel,addPanel,pm3"/>
                        </apex:facet> 
                        <apex:facet name="start">
                            <apex:outputPanel id="pm3">
                            <apex:commandButton value="Editing..." id="editButton1" disabled="true" action="{!editAllMethod}" rendered="{!NOT(editAll)}" status="mySaveStatus3" rerender="table1,savePanel,addPanel"/>
                            </apex:outputPanel>
                        </apex:facet>
                    </apex:actionStatus>
                    <!--<apex:commandButton value="Edit All Schedule Quantity" id="editButton" action="{!editAllMethod}" rendered="{!NOT(editAll)}" rerender="table1,savePanel,addPanel"/>-->
                </apex:outputPanel>  
                <apex:outputPanel id="savePanel" >
                    <apex:commandButton value="Save All" id="saveButton" action="{!saveAllMethod}" rendered="{!editAll}"/>
                    <apex:actionStatus id="mySaveStatus1"> 
                        <apex:facet name="stop"> 
                            <apex:commandButton value="Cancel" id="cancelButton" action="{!cancelMethod}" rendered="{!editAll}" status="mySaveStatus1" rerender="table1,savePanel,addPanel,errMsg,pm1"/>
                        </apex:facet> 
                        <apex:facet name="start">
                            <apex:outputPanel id="pm1">
                            <apex:commandButton value="Cancelling..." disabled="true" id="cancelButton1" action="{!cancelMethod}" rendered="{!editAll}" status="mySaveStatus1" rerender="table1,savePanel,addPanel,errMsg"/> 
                            </apex:outputPanel>
                        </apex:facet>
                    </apex:actionStatus>
                    <!--<apex:commandButton value="Cancel" id="cancelButton" action="{!cancelMethod}" rendered="{!editAll}" rerender="table1,savePanel,addPanel,errMsg"/>-->
                    <apex:commandButton value="Clear all Schedules" action="{!clearQuantities}" rendered="{!editAll}" rerender="table1,savePanel,addPanel,errMsg"/>
                </apex:outputPanel>                
            </apex:pageblockButtons>
        </apex:pageBlock>
    </apex:form>
</apex:page>