<apex:page standardController="Opportunity" extensions="Core_FC_ProductSchedule_ExtController" action="{!deleteAllBlankQuantity}" id="fcPage" applyHtmlTag="false" showHeader="false" lightningStylesheets="false">
    <style type="text/css">
        .opportunityBlock{
        width:100%;
        }
        .tableHeader{background-color:greenyellow}
    </style>
    
    <apex:variable value="{!0.00}" var="total1"/>
    <apex:variable value="{!0.00}" var="total2"/>
    <apex:variable value="{!0.00}" var="total3"/>
    <apex:variable value="{!0.00}" var="total4"/>
    <apex:variable value="{!0.00}" var="total5"/>
    <apex:variable value="{!0.00}" var="total6"/>
    <apex:variable value="{!0.00}" var="sumRevenue"/>
    <apex:slds />
    <apex:form >
        <apex:outputPanel rendered="{!isForecastAvailable}" id="reloadOpp">
            <div class="demo-only" style="padding-left: 20px;padding-top: 20px;padding-bottom: 20px;">
                <nav role="navigation" aria-label="Breadcrumbs">
                    <apex:actionStatus id="cancelForecast">
                        <apex:facet name="stop">
                            <apex:commandLink action="{!cancelRecentFC}" oncomplete="redirectToOpp();" rendered="{!isNewPage}" status="cancelForecast" rerender="reloadOpp">Opportunity : {!opptyObj1.Name}</apex:commandLink>
                        </apex:facet>
                        <apex:facet name="start">
                            <apex:outputText value="Loading..." style="margin-left:2%;"/>
                        </apex:facet>
                    </apex:actionStatus>
                </nav>
            </div>
        </apex:outputPanel>
        <apex:outputPanel id="showMigrateLink">
            <apex:pagemessages id="errMsg"/>
            <!--<apex:commandLink value="{!$Label.Core_FC_Migrate6QPS}" action="{!migrate6QPSMethod}" rendered="{!oliPresentFlag}" style="margin-left:2%;"/>-->
            <!--Ashwin -- Added fix to make sure the records are getting created only once-->
            <apex:actionStatus id="saveStatus">
                <apex:facet name="stop">
                    <apex:commandLink value="{!$Label.Core_FC_Migrate6QPS}" action="{!migrate6QPSMethod}" oncomplete="redirectToOpp();" status="saveStatus" rerender="showMigrateLink" style="margin-left:2%;" rendered="{!oliPresentFlag}"/>
                </apex:facet>
                <apex:facet name="start">
                    <apex:outputText value="Migrating..." style="margin-left:2%;"/>
                </apex:facet>
            </apex:actionStatus>
        </apex:outputPanel>
        <apex:pageBlock id="pb1" rendered="{!qtrNameList.size > 0}">             
