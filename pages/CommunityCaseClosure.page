<apex:page standardController="Case" sidebar="false" extensions="CommunityCaseClosureController">
    <apex:form id="errorButtons" rendered="{!showError}" style="max-width:800px">
        <apex:outputPanel >
            <div style="margin-left:-20px">
                <apex:pageMessages />
            </div>    
        </apex:outputPanel>    
        <hr class="lightWeightDivider"/>            
        <apex:commandButton value="Return" action="{!CancelOperation}" immediate="true" />                
    </apex:form>
        
    <apex:form >
        <apex:pageBlock rendered="{!showError == false}">
            <apex:pageBlockSection title="Reason for Case Closure" columns="1" >
                <apex:pageBlockSectionItem >   
                    <apex:OutputLabel value="Reason for Case Closure" />               
                    <apex:inputfield value="{!newCase.Core_Closure_Comment__c}" required="true" style="width:50%; height:150px" />                   
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <apex:pageBlockButtons >
                <apex:commandButton value="Submit" action="{!RequestCaseClosure}"/>
                <apex:commandButton value="Cancel" action="{!CancelOperation}" immediate="true" />
            </apex:pageBlockButtons>
        </apex:pageBlock>
    </apex:form>           
</apex:page>