<apex:page standardController="Lead"  rendered="{!$User.UITheme != 'Theme4d'}" > 
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    
    <apex:form >
        <apex:outputPanel rendered="{!AND(Lead.Core_Lead_State__c=='Unclaimed', Lead.Core_Lead_Status__c=='New', Lead.Status!='Rejected')}">
            <div>
                <p style="text-align: center;"><b style="font-size: 12px; color: rgb(230, 0, 0);">{!$Label.Core_Unclaimed_Lead_Message}</b></p>                
            </div>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!Lead.Status=='Rejected'}">
            <h2 style="font-weight:bold;font-size:large;text-align: -webkit-center;">
                <apex:pageMessage id="msg" escape="0" summary="{!$Label.Core_PartnerLead_Rejected}" severity="WARNING" strength="2"/>
            </h2>
        </apex:outputPanel>
    </apex:form>
    
</apex:page>