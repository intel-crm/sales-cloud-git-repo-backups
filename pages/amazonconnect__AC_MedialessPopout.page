<apex:page id="AC_MedialessPopout" showHeader="false" sideBar="false" docType="html-5.0" applyHtmlTag="false">
  <apex:includeScript value="{!URLFOR($Resource.amazonconnect__Vendor, '/connect-streams.js')}" />
  <html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">

  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- // code to add origin trial on the page required to resolve chrome's storage partition issue -->
    <meta http-equiv="origin-trial" content="Apc8pO8JGSLKZOkQf8NfSRklYVLkT+dvbMIj6kiVHMH0XbsXr9l0lOAfVurJHlbSiVBqgeVxbjgl3tamPLlATw8AAAB6eyJvcmlnaW4iOiJodHRwczovL2ZvcmNlLmNvbTo0NDMiLCJmZWF0dXJlIjoiRGlzYWJsZVRoaXJkUGFydHlTdG9yYWdlUGFydGl0aW9uaW5nIiwiZXhwaXJ5IjoxNzI1NDA3OTk5LCJpc1N1YmRvbWFpbiI6dHJ1ZX0=" />
    
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
      (() => {
        const SALESFORCE_TAB_CHECK_TIME = 20000;

        let logoutUrl = '';
        function getConnectProps() {
          const props = JSON.parse(localStorage.getItem('CONNECT_PROPS'));
          return props;
        }

        function getValInProps(val, defaultVal) {
          return getConnectProps()[val] || defaultVal;
        }

        function getConnectCCPUrl(instance, ccpPath) {
          let baseUrl = '';
          if (!instance.includes('.com') && !instance.includes('.aws')) {
              baseUrl = `https://${instance}.awsapps.com/connect`;
          } else if (instance.includes('.awsapps.com')) {
              baseUrl = `${instance}/connect`;
          } else {
              baseUrl = instance;
          }
          return `${baseUrl}/${ccpPath}`;
        }

        window.onload = function () {
          // Close the window if another one is already open.
          if (localStorage.getItem('MEDIALESS_OPEN')) window.close();

          const bc = new BroadcastChannel('heartbeat');
          bc.postMessage({ type: 'HEARTBEAT' });
          setInterval(() => {
            bc.postMessage({ type: 'HEARTBEAT' });
          }, 1000);

          bc.addEventListener('message', async (e) => {
            console.log(JSON.stringify(e.data));
            if (e.data.type === 'REQUEST_HEARTBEAT') {
              console.log("REQUEST_HEARTBEAT received");
              bc.postMessage({ type: 'HEARTBEAT' });
              console.log("REQUEST_HEARTBEAT: heartbeat sent");
            }
          });

          let thereIsOngoingCall = false;
          let streamJsNotInitialized = true;
          let checkingIfReload = false;

          // Get the ccpConfig
          const ccpConfig = JSON.parse(getValInProps('REGIONAL_CCP_CONFIG', '{}'));

          // Initialize the CCP
          const container = document.getElementById('ccpPanel');
          // We want this to always be true because the pop out should control the media
          ccpConfig['softphone']['allowFramedSoftphone'] = true;

          connect.core.initCCP(container, ccpConfig);

          // Set a flag that medialess is opened.
          localStorage.setItem('MEDIALESS_OPEN', 'true');
          // Remove the flag when page is closed
          window.addEventListener('beforeunload', async () => {
            localStorage.removeItem('MEDIALESS_OPEN');
            bc.close();
          });

          connect.core.getEventBus().subscribe(connect.EventType.TERMINATED, () => {
            window.close();
          });

          // agent initialized 
          connect.agent(async (agent) => {
            streamJsNotInitialized = false;
            logoutUrl = getValInProps('connectLogoutUrl', '');

            connect.contact((contact) => {
              contact.onIncoming(() => {
                localStorage.setItem('CONTACT_ONGOING', 'true');
                window.focus();
              });
              contact.onConnecting(() => {
                localStorage.setItem('CONTACT_ONGOING', 'true');
                window.focus();
              });
              contact.onEnded(() => {
                localStorage.removeItem('CONTACT_ONGOING');
              });
            });

            // Poll for the main window.
            setInterval(() => {
              // We want to wait till streams is initialized
              if (streamJsNotInitialized) return;
              // if agent has any contact, we do not want to close the medialess ccp
              // even if there are no medialess tabs open
              if(agent.getContacts().length !== 0) return;
              
              // if there are no salesforce tabs open, then wait 20 seconds before checking again to see if any salesforce tabs are
              // opened (ex: reload). If not, then close the medialess page.
              if (window.opener === null && parseInt(localStorage.getItem('MEDIALESS_TABS', '0')) <= 0 && !checkingIfReload) {
                console.log('[CTI ADAPTER] Checking if Media Popout should be closed');
                checkingIfReload = true;
                setTimeout(async () => {
                  if ((parseInt(localStorage.getItem('MEDIALESS_TABS', '0') ) <= 0) && (agent.getContacts().length === 0)) {
                    console.log('[CTI ADAPTER] Closing Popout because Salesforce Tab is closed');                   
                    window.close();
                  }
                  checkingIfReload = false;
                }, SALESFORCE_TAB_CHECK_TIME);
              }
            }, 1000);

            agent.onStateChange((agentStateData) => {
              if (agentStateData.newState === 'Logout') {
                window.close();
              }
            })
          });
        }
      })();
    </script>
  </head>

  <body>
    <div id="softphoneContainer" class="slds-hide flex-container" target="_top">
      <div id="ccpPanel" style="height: 100vh"></div>
    </div>
  </body>

  </html>
</apex:page>