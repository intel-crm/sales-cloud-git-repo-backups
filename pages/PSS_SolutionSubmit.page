                    <script>
                    /* To auto adjust height of iframe based on contents */
                    let elem = document.querySelector('#ArdiraSurvey_SurveyResponder');
                    let iframes = window.parent.document.getElementsByTagName('iframe');
                    if(iframes && iframes.length > 0) {
                        for(let i = 0; i < iframes.length; i++) {
                            let frameName = iframes[i].getAttribute("name");
                            if(frameName && frameName.includes("vfFrameId_")) {
                                vfPageIframe = iframes[i];
                            }
                        }
                    }
                    let scrollY;
                    setInterval(function(){
                        if(elem && vfPageIframe){
                            scrollY = window.parent.pageYOffset || window.parent.document.documentElement.scrollTop;
                            vfPageIframe.height = '500px';
                            let rectHeight = elem.offsetHeight;
                            if(rectHeight && rectHeight < 500){
                                rectHeight = 500;
                            }
                            // If survey internally highlight specific area then it behaves weird in iframe integration so add below code to adjust it accordingly (e.g: Repeated section focused add new row)
                            /*if(document.documentElement.scrollTop > 0) {
                                                                                                  scrollY += document.documentElement.scrollTop;
                                                                                                  window.scrollTo(0, 0);
                                                                                           }*/
                            vfPageIframe.height = rectHeight + 'px';
                            if(scrollY) {
                                window.parent.scrollTo(0, scrollY);
                            }
                        } else {
                            elem = document.querySelector('#ArdiraSurvey_SurveyResponder');
                        }
                    },2000);
                    /* End code for To auto adjust height of iframe based on contents */
                    let timeRef;
                window.parent.document.addEventListener('scroll', function(e) {
                    preventScroll = true;
                    if(timeRef) {
                     clearTimeout(timeRef);
                    }
                    timeRef = setTimeout(()=>{
                        preventScroll = false;
                    }, 500);
                });
                    /* For scroll top on click of next, previous, submit and thank you button */
                    document.addEventListener("svevent_nextbuttonclicked", handler, false);
                    document.addEventListener("svevent_previousbuttonclicked", handler, false);
                    document.addEventListener("svevent_submitbuttonclicked", handler, false);
                    document.addEventListener("svevent_thankyoubuttonclicked", handler, false);
                    document.addEventListener("svevent_thankyouquestionclicked", handler, false);
                    document.addEventListener("svevent_scrolltotop", scrollToTop, false);
                // Below event will bring the user at the top of the page.
                function handler(event){
                   window.parent.document.body.scrollIntoView(true);
                }
               /* scroll up to top when modal dialog open */
                function scrollToTop(event) {
                       scrollY = 0;
                      window.parent.scrollTo(0, scrollY);
