    function checkEmployee(name,isSelected,val)      //Shashwat Changes
    {
        if(name !='Employee' && name !='Partner Admin' && name !='Partner Admin Delegate'){
            var entitlementAndBenifits = JSON.parse('{!entBenifitsMap}');
            let lstOfEntitlementForSuppressSoftPopups='{!lstOfEntitlementForSuppressSoftPopups}';
            for (let key in entitlementAndBenifits) {
                if (entitlementAndBenifits.hasOwnProperty(key)) 	{
                    value = entitlementAndBenifits[key];
                    if(value!='' && key==name && isSelected == 'false' && val.checked && !lstOfEntitlementForSuppressSoftPopups.includes(name))
                    {
                        var sd = new SimpleDialog("Test"+Dialogs.getNextId(), false);
                        sd.createDialog();             
                        sd.setWidth(500);
                        window.parent.sd = sd;   
                        sd.setContentInnerHTML("<p align='center'><b><i> Please De-Select the selected Entitlement if not required</i></b></p><p align='left'>"+name+" Entitlement can only be granted if ACCOUNT/OPID has any one of the following benefit(s)  <div class='benifitsClass'></div></p><p align='center'><br /><button class='btn' onclick='callSaveMethod();'>Ok</button></p> </p>");   
                        sd.show(); 
                        for (let val in value) {
                            let list = document.createElement('li');
                            list.innerText=value[val];
                            document.querySelector('.benifitsClass').appendChild(list);
                        }    }
                    
                }
                
            }
            
        }
        
        
        var sd = new SimpleDialog("Test"+Dialogs.getNextId(), false);
        //changes made by sonali for employee removal popup issue fix  
        
        if(name == 'Employee' && isSelected == 'true'  && !val.checked){              
            sd.createDialog();             
            sd.setWidth(500);
            window.parent.sd = sd;   
            sd.setContentInnerHTML("<p align='center'></p><p align='left'>Removal of the employee will remove the user from the Intel® Partner Alliance Program. Are you sure you want to proceed?</p><p align='center'><br /><button class='btn' onclick='callSaveMethod();'>Yes</button> <button class='btn' onclick='closeModal2();'>No</button></p> </p>");    
            sd.show(); 
            
        }
        
      
        
        
        
