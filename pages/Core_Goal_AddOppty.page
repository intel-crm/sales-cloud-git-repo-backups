                    </apex:facet>     
                </font>-->
                <!--<apex:pageMessages id="errors" />
                <apex:pageBlockTable id="pbt1" value="{!QueriedOppty}" var="oppObj" width="100%" columnsWidth="5%,25%,10%,20%,20%,15%,20%">
                    <apex:column >
                        <apex:facet name="header"> 
                            <apex:inputCheckbox id="checkBox1">
                                <apex:actionSupport event="onclick" onsubmit="checkAll(this)" action="{!getSelected}" reRender="debug"/>
                            </apex:inputCheckbox>
                        </apex:facet>
                        <apex:inputCheckbox value="{!oppObj.selected}" id="checkedone" styleClass="CheckBoxInfo">
                            <apex:actionSupport event="onclick" action="{!getSelected}" reRender="debug"/>
                        </apex:inputCheckbox>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header">
                            <apex:commandLink value="Opportunity Name" action="{!toggleSort}" rerender="pbt1,debug">
                                <apex:param name="sortField" value="Name" assignTo="{!sortField}"/>
                            </apex:commandLink>
                        </apex:facet>
                        <apex:commandLink value="{!oppObj.opp.Name}" action="/{!oppObj.opp.Id}" target="_blank"/>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header">
                            <apex:commandLink value="Stage" action="{!toggleSort}" rerender="pbt1,debug">
                                <apex:param name="sortField" value="StageName" assignTo="{!sortField}"/>
                            </apex:commandLink>
                        </apex:facet>
                        <apex:outputField value="{!oppObj.opp.StageName}"/>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header">
                            <apex:commandLink value="Owner Full Name" action="{!toggleSort}" rerender="pbt1,debug">
                                <apex:param name="sortField" value="Owner.Name" assignTo="{!sortField}"/>
                            </apex:commandLink>
                        </apex:facet>
                        <apex:outputField value="{!oppObj.opp.Owner.Name}"/>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header">
                            <apex:commandLink value="Technical Owner" action="{!toggleSort}" rerender="pbt1,debug">
                                <apex:param name="sortField" value="Core_Technical_Owner__r.Name" assignTo="{!sortField}"/>
                            </apex:commandLink>
                        </apex:facet>
                        <apex:outputField value="{!oppObj.opp.Core_Technical_Owner__r.Name}"/>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header">
                            <apex:commandLink value="Account Name" action="{!toggleSort}" rerender="pbt1,debug">
                                <apex:param name="sortField" value="Account.Name" assignTo="{!sortField}"/>
                            </apex:commandLink>
                        </apex:facet>
                        <apex:outputField value="{!oppObj.opp.Account.Name}"/>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header">
                            <apex:commandLink value="Decision Date" action="{!toggleSort}" rerender="pbt1,debug">
                                <apex:param name="sortField" value="CloseDate" assignTo="{!sortField}"/>
                            </apex:commandLink>
                        </apex:facet>
                        <apex:outputField value="{!oppObj.opp.CloseDate}"/>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header">
                            <apex:commandLink value="Approved Date" action="{!toggleSort}" rerender="pbt1,debug">
                                <apex:param name="sortField" value="Core_Approved_Date__c" assignTo="{!sortField}"/>
                            </apex:commandLink>
                        </apex:facet>
                        <apex:outputField value="{!oppObj.opp.Core_Approved_Date__c}"/>
                    </apex:column>
                </apex:pageBlockTable>
                <apex:panelGrid columns="8">                  
                    <apex:selectList value="{!size}" multiselect="false" size="1" onchange="refreshPageSize();">
                        <apex:selectOptions value="{!paginationSizeOptions}"/>
                    </apex:selectList>
                     
                    <apex:commandButton status="fetchStatus" reRender="pbId2" value="First" action="{!first}" disabled="{!!setCon.hasPrevious}" title="First Page" oncomplete="UncheckAll(); return true;"/> 

                    <apex:commandButton status="fetchStatus" reRender="pbId2" value="Previous" action="{!previous}" disabled="{!!setCon.hasPrevious}" title="Previous Page" oncomplete="UncheckAll(); return true;"/> 

                    <apex:commandButton status="fetchStatus" reRender="pbId2" value="Next" action="{!next}" disabled="{!!setCon.hasNext}" title="Next Page" oncomplete="UncheckAll(); return true;"/>

                    <apex:commandButton status="fetchStatus" reRender="pbId2" value="Last" action="{!last}" disabled="{!!setCon.hasNext}" title="Last Page" oncomplete="UncheckAll(); return true;"/> 

                    <apex:outputText >{!(setCon.pageNumber * size)+1-size}-{!IF((setCon.pageNumber * size)>noOfRecords, noOfRecords,
                         (setCon.pageNumber * size))} of {!noOfRecords}
                    </apex:outputText> 
                           
                    <apex:outputPanel >                      
                        <apex:actionStatus id="fetchStatus" >
                            <apex:facet name="start" >
                              <img src="/img/loading.gif" />                    
                            </apex:facet>
                        </apex:actionStatus>
                    </apex:outputPanel>
                </apex:panelGrid>  
            </apex:pageBlockSection>
        </apex:pageBlock>
        
        <apex:pageBlock title="Selected Opportunities" id="debug" tabstyle="Opportunity">
