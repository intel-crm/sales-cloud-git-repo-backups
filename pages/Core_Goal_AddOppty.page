                                        <div class="waitingHolder" style="top: 74.2px; width: 91px;">
                                            <img class="waitingImage" src="/img/loading.gif" title="Please Wait..." />
                                            <span class="waitingDescription">Please Wait...</span>
                                        </div>
                                    </div>
                                </apex:facet>
                            </apex:actionstatus>
                        </apex:outputPanel>
                        <apex:outputLabel ><b>Filter By Additional Fields:</b></apex:outputLabel><br/><br/>
                        <apex:outputPanel id="out1">
                            <apex:panelGrid columns="4" id="png1" columnClasses="col1, col2, col3" width="50%"> 
                                <apex:outputText value="Opportunity Name" style="margin-left: 9%;"/>
                                <apex:selectList value="{!selOpptyNameOp}" multiselect="false" size="1">
                                    <apex:selectOptions value="{!Operators}"/>
                                </apex:selectList>
                                <apex:inputText value="{!selOpptyName}" id="opptyNameInput" style="width: 100%;"/>
                                <apex:outputText value="AND" style="margin-left: 9%;"/>
                                
                                <apex:outputText value="Opportunity Owner" style="margin-left: 9%;"/>
                                <apex:selectList value="{!selOpptyOwnerOp}" multiselect="false" size="1">
                                    <apex:selectOptions value="{!Operators}"/>
                                </apex:selectList>
                                <apex:inputText value="{!selOpptyOwner}" id="opptyOwnerInput" style="width: 100%;"/>
                                <apex:outputText value="AND" style="margin-left: 9%;"/>
                                
                                <apex:outputText value="Technical Owner" style="margin-left: 9%;"/>
                                <apex:selectList value="{!selTechOwnerOp}" multiselect="false" size="1">
                                    <apex:selectOptions value="{!Operators}"/>
                                </apex:selectList>
                                <apex:inputText value="{!selTechOwner}" id="techOwnerInput" style="width: 100%;"/>
                                <apex:outputText value="AND" style="margin-left: 9%;"/>
                                
                                <apex:outputText value="Account Name" style="margin-left: 9%;"/>
                                <apex:selectList value="{!selAccNameOp}" multiselect="false" size="1">
                                    <apex:selectOptions value="{!Operators}"/>
                                </apex:selectList>
                                <apex:inputText value="{!selAccName}" id="accNameInput" style="width: 100%;"/>
                                <apex:outputText value="AND" style="margin-left: 9%;"/>
                            </apex:panelGrid>                           
                        </apex:outputPanel>
                        <apex:pageBlockButtons location="bottom">
                            <div draggable="false" >
                                <apex:commandButton value="Search" action="{!searchMethod}" rerender="pbId2,errors,out" status="status"/>
                            </div>
                        </apex:pageBlockButtons>
                        
                        
                    </apex:pageBlock>   

                </td>
            </tr>
        </table>
        <apex:pageBlock id="pbId2" tabstyle="Opportunity">
            <apex:pageBlockSection id="pbs1" collapsible="false" columns="1" title="Opportunities" >
                <!--<font>
