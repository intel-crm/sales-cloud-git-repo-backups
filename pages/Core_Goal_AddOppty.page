    <apex:form id="fm">
    <apex:actionFunction name="refreshPageSize" action="{!refreshPageSize}" status="fetchStatus" reRender="pbId2,debug"/>
    <apex:pageBlock title="Find Opportunity" id="pbId1" tabstyle="Opportunity">  
        <table width="100%" border="0">
            <tr>
                <td width="200" valign="top">
                    <apex:pageBlock title="Specify Filter Criteria:" id="criteria">
                        <apex:outputLabel ><b>Filter By Owner:</b></apex:outputLabel>
                        <apex:selectRadio value="{!selOwnerFilter}" layout="pageDirection">
                            <apex:selectOptions value="{!items}"/>
                            <apex:actionSupport event="onchange" rerender="out,pbId2,debug" status="status" action="{!changeQuery}" oncomplete="UncheckAll(); return true;"/>
