<apex:page controller="Core_IPS_Project_Controller"> 
    <apex:includeScript value="{!$Resource.Core_IPS_Jquery11}"/>
    <apex:includeScript value="{!Urlfor($Resource.Core_IPS_DataTable,'jquery-ui.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.Core_IPS_DataTable,'jquery.dataTables.js')}"/>
    <apex:stylesheet value="{!URLFOR($Resource.Core_IPS_DataTable,'jquery.dataTables.css')}" />
    <apex:stylesheet value="{!URLFOR($Resource.Core_IPS_Page_Loading_Animation, 'spinner.css')}"/>
    
    <apex:includeScript value="{!URLFOR($Resource.Core_IPS_Page_Loading_Animation, 'spinner.js')}"/>
    <script type="text/javascript">
        function selectAllCheckboxes(obj,receivedInputID){
            var inputCheckBox = document.getElementsByTagName("input");
            for(var i=0; i<inputCheckBox.length; i++){
                if(inputCheckBox[i].id.indexOf(receivedInputID)!=-1){
                    inputCheckBox[i].checked = obj.checked;
                }
            }
        }
        

        function redirecttoparent(){
            backtoparentpage();
        }

     $( document ).ready(function(){     
         $(".TblMember").DataTable();
         $(".TblExtMem").DataTable({
             paginate: false,
             scrollY: 150,
             bFilter: true
             });
     }); 
     
    </script>
    
    <div class="splashStatus" id="splashDiv">
        <div class="circle"><img src="{!URLFOR($Resource.Core_IPS_Page_Loading_Animation, 'spinner.gif')}"/></div>
        <div class="txt">{!$Label.Core_IPS_Load_gif_Text}</div>
    </div>
 <apex:form >
 <apex:actionStatus id="splashStatus" onstart="startSplash();" onstop="endSplash(); "/>
 <apex:actionFunction name="backtoparentpage" action="{!redirecttoparent}" />
 <apex:pageBlock id="upperpgblck">
      <apex:pageblockSection title="Existing Members" rendered="{!displayExistingMembers}" columns="1">
          <apex:pageblockTable value="{!existingMembers}" var="ipsMem" Styleclass="TblMem">
              <apex:column value="{!ipsMem.Core_IPS_Contact__r.firstName}"/>
              <apex:column value="{!ipsMem.Core_IPS_Contact__r.lastName}"/>
          </apex:pageblockTable>
      </apex:pageblockSection>
 </apex:pageBlock>
 <apex:pageBlock id="pgblck">
      <apex:pageblockButtons >
          <apex:commandButton value="Add" action="{!add}" rerender="pgblck,upperpgblck" status="splashStatus" />
          <apex:commandButton value="Add & Done" action="{!addAndDone}" rerender="pgblck,upperpgblck" status="splashStatus" oncomplete="redirecttoparent()"/>
          <apex:commandButton value="Cancel" action="{!cancel}"/>
      </apex:pageblockButtons>
      <apex:pageblockSection Title="Add Members" rendered="{!displayAddMemberSection}" columns="1">
          <apex:pageblockTable value="{!contWrapperList}" var="memWrap" styleclass="TblMember">
              <apex:column >
                  <apex:facet name="header">
                      <apex:inputCheckbox onclick="selectAllCheckboxes(this,'inputId')"/>
                  </apex:facet>

                  <apex:inputCheckbox value="{!memWrap.selected}" id="inputId">

                            </apex:inputCheckbox>
              </apex:column>
              <apex:column headerValue="First Name">
                  <apex:outPutText value="{!memWrap.con.firstName}"/>
              </apex:column>
              <apex:column headerValue="Last Name">
                  <apex:outPutText value="{!memWrap.con.lastName}"/>
              </apex:column>
              <apex:column headerValue="Account Name">
                  <apex:outPutText value="{!memWrap.con.account.name}"/>
              </apex:column>
          </apex:pageblockTable>
          </apex:pageblockSection>
          <apex:pageBlockSection Title="Add Members" rendered="{!NOT(displayAddMemberSection)}" columns="1">
              <apex:pageBlockSectionItem >
                  <apex:outputLabel value="There are no more members to add"/>
              </apex:pageBlockSectionItem>
          </apex:pageBlockSection>
      
  </apex:pageBlock>
  </apex:form>
  <div class="lightbox"></div>
</apex:page>