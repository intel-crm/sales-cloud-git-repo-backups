------------------------------------------------------------------------------->
<apex:page standardController="Case" showHeader="false" applyHtmlTag="false">
    <style>
        .norecords{display:none;}
        .pbHeader table{ padding:0 !important; border-bottom-width:0 !important;}
        .pbHeader{border-bottom-width:0 !important;}
    </style>
    <div class="bRelatedList">        
        <apex:pageBlock title="Survey Feedback" mode="detail">        
            <apex:variable value="{!0}" var="surveyResponseCount"/>
            <table cellpadding="0" cellspacing="0" class="list surveyResponseTable">
                <tr class="headerRow">
                    <!--th>{!$ObjectType.Core_IPS_Response__c.fields.Name.Label}</th-->
                    <th>{!$ObjectType.Core_IPS_Response__c.fields.Core_IPS_Question__c.Label}</th>
                    <th>{!$ObjectType.Core_IPS_Response__c.fields.Core_IPS_Answer__c.Label}</th>
                    <th>{!$ObjectType.Core_IPS_Response__c.fields.CreatedDate.Label}</th>
                </tr>
                <apex:repeat value="{!Case.Core_IPS_Responses__r}" var="response">
                    <apex:outputPanel layout="none" rendered="{!response.Core_IPS_Question_Master__r.RecordType.DeveloperName=='Survey'}">
                        <tr class="dataRow">
                            <!--td> <apex:outputField value="{!response.Name}"/> </td-->
                            <td> <apex:outputField value="{!response.Core_IPS_Question__c}"/> </td>
                            <td> <apex:outputField value="{!response.Core_IPS_Answer__c}"/> </td>
                            <td> 
                                <apex:outputField value="{!response.CreatedDate}"/> 
                                <apex:variable value="{!surveyResponseCount+1}" var="surveyResponseCount"/>
                            </td>
                        </tr>
                    </apex:outputPanel>
                </apex:repeat>
            </table>
            <apex:outputPanel styleClass="norecords">No records to display</apex:outputPanel>
            <apex:outputPanel rendered="{!surveyResponseCount==0}">
                <style> 
                    .surveyResponseTable { display:none; } 
                    .norecords { display:block; }
                </style>
            </apex:outputPanel>
        </apex:pageBlock>
    </div>
</apex:page>