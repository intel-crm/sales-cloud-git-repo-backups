                        </apex:outputPanel>
                        <apex:actionRegion >
                            <apex:outputPanel id="subCategory">
                                <apex:outputPanel styleClass="requiredInput" id="SubCategorySelect" layout="block" rendered="{!subCategoryOptions.size>1 }">
                                    <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!subCategoryOptions.size>1  }"/> 
                                    
                                    <!-- Added disabled="{!isClosed} by Sugandha for User Story US83594 Iteration 6 -->  
                                    <!-- Added JqueryDropdown class names by Karthick for User Story US80350 Iteration 7 --> 
                                    <apex:selectList value="{!subCategorySelected}" size="1" disabled="{!isClosed}"  styleClass="{!IF(!isClosed,'cust-combobox custom-combobox', '')}">
                                        <apex:selectOptions value="{!subCategoryOptions}"/>  
                                        <apex:actionSupport event="onchange" action="{!getEnvironmentDets}" reRender="none" status="status1" oncomplete="BindEvent();"/>
                                    </apex:selectList>
                                </apex:outputPanel>
                                
                            </apex:outputPanel>
                            
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    
                </apex:pageblockSection>
            </apex:outputpanel> 
                
                <!-- Ends here -->
                
            </apex:pageblockSection>
            
            <!-- Visualforce component for Environment Detail Questions - Amritesh - US8534 - 12/18/2017  -->
            <c:Core_IPS_Case_Creation_EDQ_Section displayEnvDetails="{!displayEnvDetails}" selectedProductId="{!selectedProductId}"
                                                  selectedSAProductId="{!selectedSAProductId}" subCategorySelected="{!subCategorySelected}"
                                                  envDetails="{!envDetails}" subCatenvDetList="{!subCatenvDetList}"/>
            
            <apex:pageBlockButtons >
                
                <input type="button" value="Cancel" class="btn" onclick="fnConfirmBox();"/> 
                <apex:commandButton id="saveButton" value="Submit" action="{!saveCaseDetails}" onclick="showSpinner()"/>             
            </apex:pageBlockButtons>
        </apex:pageblock>
    </apex:form>
    
    <apex:PageBlock rendered="{!if(OR(AND(mode ='edit',isEditable),mode!='edit'),false,true)}">
        <span style="color:red;align:center;">You have insufficient privilege to edit the Case.</span>
    </apex:PageBlock>
    
</apex:page>