<apex:page controller="Core_AAQC_LookupController" sidebar="false" showheader="false"  action="{!pageLoad}" cache="FALSE">
<script language="javascript">
   function fillIn(name, id)
   {
      var winMain=window.opener;
      
      if (null==winMain)
      {
         winMain=window.parent.opener;
      }
      var ele=winMain.document.getElementById('{!$CurrentPage.parameters.namefield}');
      ele.value=name;
      
      ele=winMain.document.getElementById('{!$CurrentPage.parameters.idfield}');
      ele.value=id;
      
      CloseWindow();
   }

   function CloseWindow()
   {
      var winMain=window.opener;
      if (null==winMain)
      {
         winMain=window.parent.opener;
      }
      winMain.closeLookupPopup();
   }
</script>
    <apex:slds />
    <apex:form id="form" > 
        <div style="width 100%">
            <apex:pageBlock title="Lookup" id="block">
                <apex:pageBlockSection id="section">
                    Enter search text and click Go<br/>
                    <apex:inputText value="{!searchString}" id="searchStringId"/> 
                    <apex:commandButton value="Go" action="{!getRecords}"/>
                </apex:pageBlockSection>
            </apex:pageBlock>
        <button type="button" onclick="CloseWindow();" rerender="showmsg">Close Window</button>
        </div>
    </apex:form>
    <apex:pageMessages id="showmsg"></apex:pageMessages>
    <apex:pageBlock rendered="{!if((lstOfProfileUsesr!= null && lstOfProfileUsesr.size>0),TRUE,FALSE)}">
        <apex:pageBlockSection columns="1">
            <apex:pageBlockTable value="{!lstOfProfileUsesr}" var="userAndProfile">
                <apex:column headerValue="User Name">
                    <apex:outputLink value="#" onclick="fillIn('{!JSENCODE(userAndProfile.Name)}', '{!JSENCODE(userAndProfile.id)}')">{!JSENCODE(userAndProfile.Name)}</apex:outputLink>       
                </apex:column>
                <apex:column headerValue="Profile Name">
                    <apex:outputText value="{!userAndProfile.Profile.Name}"></apex:outputText>
                </apex:column>
            </apex:pageBlockTable>    
        </apex:pageBlockSection>
    </apex:pageBlock> 
    <apex:pageBlock rendered="{!if((lstOfMngerAndUser!= null && lstOfMngerAndUser.size>0),TRUE,FALSE)}">
        <apex:pageBlockSection columns="1">
            <apex:pageBlockTable value="{!lstOfMngerAndUser}" var="userAndManager">
                <apex:column headerValue="User Name">
                    <apex:outputLink value="#" onclick="fillIn('{!JSENCODE(userAndManager.Name)}', '{!JSENCODE(userAndManager.id)}')">{!JSENCODE(userAndManager.Name)}</apex:outputLink>       
                </apex:column>
                <apex:column headerValue="Manager Name">
                    <apex:outputText value="{!userAndManager.Manager.Name}"></apex:outputText>
                </apex:column>
            </apex:pageBlockTable>    
        </apex:pageBlockSection>
    </apex:pageBlock>
</apex:page>