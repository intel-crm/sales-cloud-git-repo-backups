<apex:page controller="TestDisplayQueryList">
<apex:pageBlock title="My Content">
  <apex:pageBlockTable value="{!Records}" var="Record">
   <apex:column >
    <apex:facet name="header">Name</apex:facet>
    <apex:outputText value="{!Record.Name}"/>
   </apex:column>
   <apex:column >
    <apex:facet name="header">Username</apex:facet>
       <apex:outputLink value="/{!Record.id}">{!Record.Username}</apex:outputLink>
   </apex:column>
  </apex:pageBlockTable>
</apex:pageBlock>
</apex:page>