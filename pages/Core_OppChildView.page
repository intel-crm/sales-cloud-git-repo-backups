<apex:page standardController="opportunity" extensions="Core_OppChildViewController" sidebar="false">
    
    <apex:form >
        
        <!-- Insert style sheet references here -->
        <apex:stylesheet value="/sCSS/25.0/sprites/1342034628000/Theme3/default/gc/versioning.css" />
        <apex:stylesheet value="/sCSS/25.0/sprites/1342034628000/Theme3/default/gc/extended.css" />
        <!-- End stylesheet references -->
        
        <!-- Hidden fields that we need in the VF page, to refer to them in our Apex code, avoiding a SOQL query -->
        <apex:outputField value="{!opportunity.Name}" rendered="false" />
        <apex:outputField value="{!opportunity.AccountId}" rendered="false" />
        
        <span style="position:relative;left:30.4%;z-index:1">
            <!-- "New Opportunity" button, which needs to use onclick Javascript to open in the top-level frame instead of the VF section -->
            <apex:commandButton action="{!newOpp}" value="New Opportunity" id="newButton"
                                onclick="window.top.location.href='{!newOppUrl}'"/>
            &nbsp; &nbsp;
            
            <!-- "Add Existing Opportunity" lookup window - this needs to bind to the Solution Group field, even though
				it won't actually be stored there, just because we need a self-relationship lookup field on Opportunity -->
            <apex:outputLabel for="existing__opp" value="Add Existing:"
                              style="font-weight:bold;color:rgb(74, 74, 86);font-size: 11px" />&nbsp;
            <apex:inputField id="existing__opp" value="{!opportunity.Core_Solution_Group__c}" />
            
            <!-- We'll override the save method to flip how the the parent/child relationship is saved -->
            <apex:commandButton value=" Save " action="{!save}"/>            
        </span>
        
        <!-- Main Tab panel -->
        <apex:tabPanel switchType="client" selectedTab="tabOpps" id="theTabPanel" tabClass="activeTab" inactiveTabClass="inactiveTab" style="position:relative;top:-20px">
            
            <!-- Tab 1 - Child opportunities -->
            <apex:tab label="Opportunities" name="tabOpps" id="tabOpps">
                <apex:pageBlock >
                    <!-- Display child opportunities in a table if there are one or more -->
                    <style>
                        body .pbBody table.list tr th {
							border-width: 1px 0px 0px 0px;
                            padding: 4px 2px 4px 5px;
                        }
                    </style>
					<apex:variable value="{!0.00}" var="totalAmount"/>
                    <apex:pageBlockTable value="{!childOpps}" var="childOpp" rendered="{!!ISNULL(childOpps)}">
                        <apex:column headerValue="Opportunity Name">
                            <apex:outputLink value="/{!childOpp.Id}" target="_top">{!childOpp.Name}</apex:outputLink>
                        </apex:column>
                        <apex:column value="{!childOpp.StageName}"/>
                        <apex:column headerValue="Amount">
                            <apex:outputField value="{!childOpp.Amount}"/>
                            <apex:variable var="totalAmount" value="{!totalAmount + NULLVALUE(childOpp.Amount, 0)}"/>
                            <apex:facet name="footer">Total: $<span id="totalAmt"></span></apex:facet>
                        </apex:column>
                        <apex:column value="{!childOpp.TotalOpportunityQuantity}"/>
                        <apex:column value="{!childOpp.CloseDate}"/>
                        <apex:column headerValue="Products">
                            <apex:repeat value="{!childOpp.OpportunityLineItems}" var="lineItem">
                                <li>{!lineItem.Product2.Name}</li>
                            </apex:repeat>
                        </apex:column>
                    </apex:pageBlockTable>
                    <script>
                    	if (document.getElementById('totalAmt')) {
                            document.getElementById('totalAmt').innerHTML = '{!totalAmount}';
                        }
                    </script>
                    
                    <!-- If no sub-oppportunities, display a message -->
                    <apex:outputLabel rendered="{!ISNULL(childOpps)}">
                        <br/>There are no opportunities yet in this solution group<br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp;
                    </apex:outputLabel>
                </apex:pageBlock>
            </apex:tab>
            
            <!-- Tab 2 - Features -->
            <apex:tab label="Features" name="tabFeatures" id="tabFeatures"> 
                <apex:pageBlock >
                    <!-- Display features in a table if there are one or more -->
                    <apex:pageBlockTable value="{!childOpps}" var="childOpp" rendered="{!!ISNULL(childOpps)}">
                        <apex:column headerValue="Opportunity Name">
                            <apex:outputLink value="/{!childOpp.Id}" target="_top">{!childOpp.Name}</apex:outputLink>
                        </apex:column>
                        <apex:column headerValue="Features" width="50%">
                            <apex:dataTable value="{!childOpp.Opportunity_Features__r}" var="oppFeature" border="1" width="100%">
                                <apex:column value="{!oppFeature.Core_Feature_Type__c}" width="50%"/>
                                <apex:column value="{!oppFeature.Core_Feature_Name__c}" width="50%"/>
                            </apex:dataTable>
                        </apex:column>
                    </apex:pageBlockTable>
                    
                    <!-- If no sub-oppportunities, display a message -->
                    <apex:outputLabel rendered="{!ISNULL(childOpps)}">
                        <br/>There are no opportunities yet in this solution group<br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp;
                    </apex:outputLabel>
                </apex:pageBlock>
            </apex:tab>
            
            <!-- Tab 3 - Team members -->
            <apex:tab label="Teams" name="tabTeam" id="tabTeam">
                <apex:pageBlock >
                    <!-- Display team members in a table if there are one or more -->
                    <apex:pageBlockTable value="{!childOpps}" var="childOpp" rendered="{!!ISNULL(childOpps)}">
                        <apex:column headerValue="Opportunity Name">
                            <apex:outputLink value="/{!childOpp.Id}" target="_top">{!childOpp.Name}</apex:outputLink>
                        </apex:column>
                        <apex:column headerValue="Team Members">
                            <apex:repeat value="{!childOpp.OpportunityTeamMembers}" var="oppTeamMember">
                                <a href="/{!oppTeamMember.User.Id}" target="_top">{!oppTeamMember.Name}</a>,
                            </apex:repeat>
                        </apex:column>
                    </apex:pageBlockTable>
                    
                    <!-- If no sub-oppportunities, display a message -->
                    <apex:outputLabel rendered="{!ISNULL(childOpps)}">
                        <br/>There are no opportunities yet in this solution group<br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp;
                    </apex:outputLabel>
                </apex:pageBlock>
            </apex:tab>            
        </apex:tabPanel>
        
    </apex:form>
    
</apex:page>