<apex:page standardController="opportunity" extensions="Core_OppChildViewController" sidebar="false" lightningStylesheets="{!$User.UITheme != 'Theme3'}">
    
    <apex:includeLightning />
    <apex:slds rendered="{!$User.UITheme != 'Theme3'}"/>
    <apex:form >
        <div id="lightning"></div>
        <!-- Insert style sheet references here -->
        <apex:stylesheet value="/sCSS/25.0/sprites/1342034628000/Theme3/default/gc/versioning.css" />
        <apex:stylesheet value="/sCSS/25.0/sprites/1342034628000/Theme3/default/gc/extended.css" />
        <!-- End stylesheet references -->
        
        <!-- Hidden fields that we need in the VF page, to refer to them in our Apex code, avoiding a SOQL query -->
        <apex:outputField value="{!opportunity.Name}" rendered="false" />
        <apex:outputField value="{!opportunity.AccountId}" rendered="false" />
        
        <span style="position:relative;left:30.4%;z-index:1">
            <!-- "New Opportunity" button, which needs to use onclick Javascript to open in the top-level frame instead of the VF section -->
            
           
            <apex:outputPanel rendered="{!$User.UITheme =='Theme3'}">            
                <apex:commandButton action="{!setIsNewOppClickedTotrue}" value="New Opportunity" id="newButton"/>
                              <!--  onclick="window.top.location.href='{!newOppUrl}'"/> -->
            </apex:outputPanel>
            <!-- lightning -Theme4d—Modern “Lightning Experience” Salesforce theme-->
            <apex:outputPanel rendered="{!$User.UITheme !='Theme3'}">    
                    
               <apex:commandButton action="{!setIsNewOppClickedTotrue}" value="New Opportunity" id="newButton1" styleClass="slds-button slds-button_neutral"/>
                              
            </apex:outputPanel>
            <apex:outputPanel id="RecordTypeSelect" styleClass="customPopup" layout="block" rendered="{!isNewOppClicked}">
            
            <apex:pageBlock title="Select a Record Type">
                <apex:outputText value="{!selectedRecordType2}" />
            <apex:pageBlockSection columns="2">
            <apex:selectList value="{!selectedRecordType}"  multiselect="false" size="1" styleClass="sbox ">
                <apex:actionSupport event="onchange" action="{!setSelectedRecordType2}"/> 
                <apex:selectOptions value="{!recordTypeOptions}"/>
            </apex:selectList> <br/>
           <apex:pageBlockSection columns="1"> 
           <apex:pageblockSectionItem >
           <apex:commandButton action="{!newOpp}" value="Ok" id="selectRecordType" onclick="LightningPageInvoke('{!solutionGroup}','{!JSENCODE(accId)}','{!JSENCODE(selectedRecordType2)}');" styleClass="slds-button slds-m-left_medium slds-button_neutral"/>
           <apex:commandButton value="Cancel" action="{!newOpp}" styleClass="slds-button slds-button_neutral"/>
        </apex:pageblockSectionItem>
        </apex:pageBlockSection> 
        <script>
            function LightningPageInvoke(opp,acc,recTypeId){
               if((typeof sforce != 'undefined') && sforce && (!!sforce.one)){
                    sforce.one.createRecord('Opportunity',recTypeId,{ 
                     AccountId : acc,
                     Core_Solution_Group__c : opp
                     });
               }
            else
                window.top.location.href='{!newOppUrl}';
            
            }
            
        </script>
        
        <style>
        .customPopup {
        background-color: white;
            border-width: 2px;
            z-index: 9999;
            padding:10px;
            position: absolute;
            left: 50%;
            width: 652px;
            margin-left: -250px;
            top:50px;
        }
        
        .sbox { max-width: 100%; }
        </style>
            </apex:pageBlockSection>
            </apex:pageBlock>
           </apex:outputPanel> 
            <!-- "Add Existing Opportunity" lookup window - this needs to bind to the Solution Group field, even though
                it won't actually be stored there, just because we need a self-relationship lookup field on Opportunity -->
            <apex:outputLabel for="existing__opp" value="Add Existing:"
                              style="font-weight:bold;color:rgb(74, 74, 86);font-size: 11px" />&nbsp;
            <apex:inputField id="existing__opp" value="{!opportunity.Core_Solution_Group__c}" />
            
            <!-- We'll override the save method to flip how the the parent/child relationship is saved -->
            <apex:commandButton value=" Save " action="{!save}" styleClass="slds-button slds-button_neutral"/>            
        </span>
        &nbsp;&nbsp;&nbsp;<br/>
        <apex:outputPanel >
        </apex:outputPanel>
        <!-- Main Tab panel -->
        <apex:tabPanel switchType="client" selectedTab="tabOpps" id="theTabPanel" tabClass="activeTab" inactiveTabClass="inactiveTab" >
            
            <!-- Tab 1 - Child opportunities -->
            <apex:tab label="Opportunities" name="tabOpps" id="tabOpps" styleClass="slds-tabs__item slds-text-heading--label slds-active">
                <apex:pageBlock >
                    <!-- Display child opportunities in a table if there are one or more -->
                    <style>
                        body .pbBody table.list tr th {
                            border-width: 1px 0px 0px 0px;
                            padding: 4px 2px 4px 5px;
                        }
                    </style>
                    <apex:variable value="{!0.00}" var="totalAmount"/>
                    <apex:pageBlockTable value="{!childOpps}" var="childOpp" rendered="{!!ISNULL(childOpps)}">
                        <apex:column headerValue="Opportunity Name">
                            <apex:outputLink value="/{!childOpp.Id}" target="_parent">{!childOpp.Name}</apex:outputLink>
                        </apex:column>
                        <apex:column value="{!childOpp.StageName}"/>
                        <apex:column headerValue="Amount">
                            <apex:outputField value="{!childOpp.Amount}"/>
                            <apex:variable var="totalAmount" value="{!totalAmount + NULLVALUE(childOpp.Amount, 0)}"/>
                            <apex:facet name="footer">Total: $<span id="totalAmt"></span></apex:facet>
                        </apex:column>
                        <apex:column value="{!childOpp.TotalOpportunityQuantity}"/>
                        <apex:column value="{!childOpp.CloseDate}"/>
                        <apex:column headerValue="Products">
                            <apex:repeat value="{!childOpp.OpportunityLineItems}" var="lineItem">
                                <li>{!lineItem.Product2.Name}</li>
                            </apex:repeat>
                        </apex:column>
                    </apex:pageBlockTable>
                    <script>
                        if (document.getElementById('totalAmt')) {
                            document.getElementById('totalAmt').textContent = '{!totalAmount}';
                        }
                    </script>
                    
                    <!-- If no sub-oppportunities, display a message -->
                    <apex:outputLabel rendered="{!ISNULL(childOpps)}">
                        <br/>There are no opportunities yet in this solution group<br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp;
                    </apex:outputLabel>
                </apex:pageBlock>
            </apex:tab>
            
            <!-- Tab 2 - Features -->
            <apex:tab label="Features" name="tabFeatures" id="tabFeatures" styleClass="slds-tabs__item slds-text-heading--label slds-active"> 
                <apex:pageBlock >
                    <!-- Display features in a table if there are one or more -->
                    <apex:pageBlockTable value="{!childOpps}" var="childOpp" rendered="{!!ISNULL(childOpps)}">
                        <apex:column headerValue="Opportunity Name">
                            <apex:outputLink value="/{!childOpp.Id}" target="_top">{!childOpp.Name}</apex:outputLink>
                        </apex:column>
                        <apex:column headerValue="Features" width="50%">
                            <apex:dataTable value="{!childOpp.Opportunity_Features__r}" var="oppFeature" border="1" width="100%">
                                <apex:column value="{!oppFeature.Core_Feature_Type__c}" width="50%"/>
                                <apex:column value="{!oppFeature.Core_Feature_Name__c}" width="50%"/>
                            </apex:dataTable>
                        </apex:column>
                    </apex:pageBlockTable>
                    
                    <!-- If no sub-oppportunities, display a message -->
                    <apex:outputLabel rendered="{!ISNULL(childOpps)}">
                        <br/>There are no opportunities yet in this solution group<br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp;
                    </apex:outputLabel>
                </apex:pageBlock>
            </apex:tab>
            
            <!-- Tab 3 - Team members -->
            <apex:tab label="Teams" name="tabTeam" id="tabTeam" styleClass="slds-tabs__item slds-text-heading--label slds-active">
                <apex:pageBlock >
                    <!-- Display team members in a table if there are one or more -->
                    <apex:pageBlockTable value="{!childOpps}" var="childOpp" rendered="{!!ISNULL(childOpps)}">
                        <apex:column headerValue="Opportunity Name">
                            <apex:outputLink value="/{!childOpp.Id}" target="_top">{!childOpp.Name}</apex:outputLink>
                        </apex:column>
                        <apex:column headerValue="Team Members">
                            <apex:repeat value="{!childOpp.OpportunityTeamMembers}" var="oppTeamMember">
                                <a href="/{!oppTeamMember.User.Id}" target="_top">{!oppTeamMember.Name}</a>,
                            </apex:repeat>
                        </apex:column>
                    </apex:pageBlockTable>
                    
                    <!-- If no sub-oppportunities, display a message -->
                    <apex:outputLabel rendered="{!ISNULL(childOpps)}">
                        <br/>There are no opportunities yet in this solution group<br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp; <br/> &nbsp;
                    </apex:outputLabel>
                </apex:pageBlock>
            </apex:tab>            
        </apex:tabPanel>
        
    </apex:form>
    
</apex:page>