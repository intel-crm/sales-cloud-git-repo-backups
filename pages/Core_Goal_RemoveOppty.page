<apex:page controller="Core_Goal_addOpptyControllerExt" action="{!populateOpptyList}">
    <script type="text/javascript">
        function checkAll(cb){
            var inputElem = document.getElementsByTagName("input");
            for(var i=0; i<inputElem.length; i++)
            {
                if(inputElem[i].id.indexOf("checkedone")!=-1)
                    inputElem[i].checked = cb.checked;
            }
        }    
    </script>
    <apex:form >
        <apex:pageMessages id="errors" />
       <apex:pageBlock title="Removing Opportunities from Deal Win Goal">
            <apex:pageBlockButtons location="Bottom">
                <apex:commandButton action="{!updateOppty}" value="Confirm"/>
                <apex:commandButton value="Cancel" action="{!cancelAdd}"/>
            </apex:pageBlockButtons>
            <table width="100%" border="0">
                <tr>
                    <td valign="top">
                        <apex:pageBlock id="results">
                            <apex:pageBlockTable value="{!removeOppty}" var="opty">                        
                                <apex:column >                                
                                    <apex:facet name="header">                                         
                                        <apex:inputCheckbox >
                                                <apex:actionSupport event="onclick" onsubmit="checkAll(this)" rerender="results"/>
                                        </apex:inputCheckbox>                                        
                                    </apex:facet>
                                    <apex:inputCheckbox value="{!opty.selected}" id="checkedone">
                                            <!--<apex:actionSupport event="onclick" action="{!GetSelected2}" rerender="results"/>-->
                                    </apex:inputCheckbox>
                                
                                </apex:column>
                                <apex:column value="{!opty.opp.Name}"/>
                                <apex:column value="{!opty.opp.StageName}"/>
                                <apex:column value="{!opty.opp.Account.name}"/>
                            </apex:pageBlockTable>
                        </apex:pageBlock>
                    </td>
                </tr>
            </table>
        </apex:pageBlock>
    </apex:form>    
</apex:page>