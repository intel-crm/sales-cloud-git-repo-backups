    }
    function reset(){
       ResetProduct(); 
       return false;
    }
    
    function showSpinner()
    {
       document.getElementById('opaque').style.display='block';
       var popUp = document.getElementById('spinner');
      
       popUp.style.display = 'block';
    } 
    
    function clearHiddenfields(obj)
    {
     
     if(obj=='Contact')
     {
       if($(".InputContact").val().length==0)
       {
      
        $("input[object='contact']").val('');
        //strContactId = '';
       }
     }
     if(obj=='Project')
     {
       if($(".InputProject").val().length==0)
       {
      
        $("input[object='project']").val('');
       }
     }
     if(obj=='Product')
     {
       if($(".InputProduct").val().length==0)
       {
      
        $("input[object='product']").val('');
       }
     }
     if(obj=='SAProduct')
