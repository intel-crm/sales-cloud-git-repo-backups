    <script>
    var newWin=null;
   var strProductId = "{!selectedProductId}"; 
    var strContactId = "{!selectedContactId}"; 
    var strSAProductId = "{!selectedSAProductId}";
   // enterPress function prevents the Default loading whenever user press Enter Key when lookup Text field is on-focused
    function enterPress(event, name, id, relatedId, object,relatedId2){
        if(event.keyCode==13){
            // for other browsers
            if(event.preventDefault){ 
                event.preventDefault();
            }
            // for IE Browser 
            else{
                event.returnValue=false;
            }
            openLookupPopup(name, id, relatedId, object,relatedId2);
        }      
    }
   
   function onKeyPress(name, id, relatedId, object,relatedId2){
       
        if(event.keyCode == 13){
            alert(event.keyCode);
            var url;
            if(relatedId!=null && relatedId2!=null)
                url="/apex/Core_IPS_Custom_Lookup?namefield=" + name + "&idfield=" + id + "&relatedId=" + document.getElementById(relatedId).value+ "&object=" +object+"&relatedId2="+document.getElementById(relatedId2).value+"&queryParam="+document.getElementById(name).value;
            else if(relatedId!=null && relatedId!='NA')
                url="/apex/Core_IPS_Custom_Lookup?namefield=" + name + "&idfield=" + id + "&relatedId=" + document.getElementById(relatedId).value+ "&object=" +object+"&queryParam="+document.getElementById(name).value;                    
            else
                url="/apex/Core_IPS_Custom_Lookup?namefield=" + name + "&idfield=" + id+"&queryParam="+document.getElementById(name).value;                    
            newWin=window.open(url, 'Popup','height=500,width=600,left=100,top=100,resizable=no,scrollbars=yes,toolbar=no,status=no');
            if (window.focus) 
            {
                //window.opener.blur();
                newWin.focus();
                //alert(newWin.focus);
            }
                
            return false;
            //return false;
        }
        return false;
   }
   
    function openLookupPopup(name, id, relatedId, object,relatedId2)
    {
     
        var url;
        if(relatedId!=null && relatedId2!=null)
            url="/apex/Core_IPS_Custom_Lookup?namefield=" + name + "&idfield=" + id + "&relatedId=" + document.getElementById(relatedId).value+ "&object=" +object+"&relatedId2="+document.getElementById(relatedId2).value+'&queryParam='+document.getElementById(name).value;
        else if(relatedId!=null && relatedId!='NA')
            url="/apex/Core_IPS_Custom_Lookup?namefield=" + name + "&idfield=" + id + "&relatedId=" + document.getElementById(relatedId).value+ "&object=" +object+'&queryParam='+document.getElementById(name).value;                    
        else
            url="/apex/Core_IPS_Custom_Lookup?namefield=" + name + "&idfield=" + id +'&queryParam=' + document.getElementById(name).value;                    
        newWin=window.open(url, 'Popup','height=500,width=600,left=100,top=100,resizable=no,scrollbars=yes,toolbar=no,status=no');
        if (window.focus) 
        {
            newWin.focus();
            //alert(newWin.focus);
        }    
        return false;
    }
                  
    function closeLookupPopup()
    {
       if (null!=newWin)
       {
          newWin.close();
       }  
    }
    
    function callParentPageForGECFields(id){
        if(id.substring(0,3) == '003'){
        //gecrender(id);
        }
    }
    function updProjListBasedOnSelectedProd(id){  
    console.log('>>>>>>>>>>>>>>>>' + id);
    
     if(id.substring(0,3)=='02i')
     {
       
        strProductId = id;
     }
     if(id.substring(0,3)=='003')
     {
       
        strContactId = id;
     }
     if(id.substring(0,3)=='a21')
     {
     
       strSAProductId = id;
     }
    }
        
    function callParentPage(name){
        
                  console.log('name' + name);
                  
                   
         if(name=='Product')
