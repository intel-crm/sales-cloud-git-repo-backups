    }
    
    
    function fnConfirmBox()
    {
       $( "#dialog-confirm" ).dialog({
          resizable: false,
          height:170,
          modal: true,
          buttons: {
            "Ok": function() {
              ConfirmBox();
              $( this ).dialog( "close" );
            },
            Cancel: function() {
              $( this ).dialog( "close" );
            }
          }
        });  
    }
    
    
    
    
    </script>
    
    
    
    
    
    
    
    
    
