                                <apex:facet name="start"><apex:image url="/img/loading32.gif" styleClass="imageFilterLoading"/></apex:facet>
                            </apex:actionstatus>
                        </apex:pageblocksection>
                        
                        <!-- Table for rendering Samples grid view -->
                        <apex:pageBlockTable value="{!lstFilteredSamples}" var="sample" id="samplesTable"  frame="box" columns="13"
                                             columnsWidth="2%,2%,2%,16%,5%,5%,5%,2%,2%,6%,8%,5%,5%" rendered="{!bSamplesRenderFlag}">
                            <apex:column >
                                <apex:actionstatus id="sampleExpansionStatus">
                                    <apex:facet name="start">
                                        <apex:image url="/img/loading32.gif" height="12" width="12"/>
                                    </apex:facet>
                                </apex:actionstatus>
                                <apex:commandLink status="sampleExpansionStatus" reRender="samplesPanel" action="{!toggleRendering}">
                                    <apex:image url="{!URLFOR($Resource.Core_CollapsibleImages, 'CollapsibleV2.png')}" width="10" height="10" rendered="{!sample.bRenderCSection}"/>   
                                    <apex:image url="{!URLFOR($Resource.Core_CollapsibleImages, 'UpsideCollapsibleV2.png')}" width="10" height="10" rendered="{!NOT(sample.bRenderCSection)}"/>
                                    <apex:param name="renderToggle" value="{!!sample.bRenderCSection}" assignTo="{!sample.bRenderCSection}"/>
                                </apex:commandLink>
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre"><apex:facet name="header"><div Class="alignCentre">
                                Request<br/> ID #</div></apex:facet>
                                <apex:commandlink onclick="openSalesSupportPopup('{!viewSampleURL}' + 'RequestId='+{!sample.RequestID});return false;" value="{!sample.RequestID}" />
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre"><apex:facet name="header"><div Class="alignCentre">
                                Line
                                </div></apex:facet><apex:outputText value="{!sample.Line}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre"><apex:facet name="header"><div Class="alignCentre">
                                Product Name
                                </div></apex:facet><apex:outputText value="{!sample.RequestedMM}"/>,
                                <apex:outputText value="{!sample.RequestedEPMName}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre"><apex:facet name="header"><div Class="alignCentre">
                                Requested<br/> Delivery Date
                                </div></apex:facet><apex:outputText value="{!sample.RDD}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre"><apex:facet name="header"><div Class="alignCentre">
                                Request<br/> Status
                                </div></apex:facet><apex:outputText value="{!sample.Status}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre"><apex:facet name="header"><div Class="alignCentre">
                                Requester
                                </div></apex:facet><apex:outputText value="{!sample.Requester}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre"><apex:facet name="header"><div Class="alignCentre">
                                Requested<br/> Quantity
                                </div></apex:facet><apex:outputText value="{!sample.RequestQty}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre"><apex:facet name="header"><div Class="alignCentre">
                                Approved<br/> Quantity
                                </div></apex:facet><apex:outputText value="{!sample.ApprovedQty}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre" rendered="{!IF(sOppRecName != NULL || sWWID != NULL, true,false)}">
                                <apex:facet name="header"><div Class="alignCentre">
                                    Account<br/> Name
                                    </div></apex:facet><apex:outputText value="{!sample.GridViewAccountName}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre" rendered="{!IF(sAcctRecName != NULL || sWWID != NULL, true,false)}">
                                <apex:facet name="header"><div Class="alignCentre">
                                    Opportunity Name
                                    </div></apex:facet><apex:outputText value="{!sample.GridViewOpportunityName}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre" rendered="{!IF(sAcctRecName != NULL || sWWID != NULL, true,false)}">
                                <apex:facet name="header"><div Class="alignCentre">
                                    Opportunity<br/> Stage
                                    </div></apex:facet><apex:outputText value="{!sample.GridViewOpportunityStage}"/></apex:column>
                            
                            <apex:column styleClass="alignCentre"><apex:facet name="header"><div Class="alignCentre">
                                Approver
                                </div></apex:facet><apex:outputText value="{!sample.ApproverName}"/></apex:column>
                            
                            <!-- Use a seperate section to render sub section --> 
                            <apex:column breakBefore="true" width="1250" colspan="14">
                                
                                <apex:outputPanel styleClass="samplesDetailPanel" >
                                    <apex:pageBlockSection columns="3" rendered="{!sample.bRenderCSection}" >
                                        
                                        <apex:pageBlockSectionItem rendered="{!sample.bRenderCSection}"> 
                                            <apex:outputPanel styleClass="samplesDetailPanelColumn"> 
                                                <apex:pageBlockSection title="Product Detail" columns="1" collapsible="false"  >
                                                    
                                                    <b>Approved Product</b><br/>
                                                    <apex:outputText value="{!sample.ApprovedMM}, {!sample.ApprovedEPMName}" rendered="{!!ISBLANK(TRIM(sample.ApprovedMM))}"/>&nbsp;<br/>  
                                                    <b>Approved Qty</b><br/>
                                                    <apex:outputText value="{!sample.ApprovedQty}" /><br/> 
                                                    <b>Approver Email</b><br/>
                                                    <apex:outputText value="{!sample.ApproverEmail}" /><br/>
                                                    <b>Product Detail</b><br/>
                                                    {!(IF(trim(sample.ApprovedEPMName)!='',sample.ApprovedEPMName,sample.RequestedEPMName))}<br/>
                                                    Socket: {!sample.Socket}<br/>
                                                    Media: {!sample.Media}<br/>
                                                    Stepping: {!sample.Stepping}<br/>
                                                    MM: {!(IF(trim(sample.ApprovedMM)!='',sample.ApprovedMM,sample.RequestedMM))}<br/>
                                                    QDF# {!sample.QDF}<br/>
                                                    Ships in Boxes of {!sample.BoxQuantity}
                                                    
                                                </apex:pageBlockSection>
                                            </apex:outputPanel> 
                                            
                                        </apex:pageBlockSectionItem>
                                        
                                        <apex:pageBlockSectionItem rendered="{!sample.bRenderCSection}">   
                                            <apex:outputPanel styleClass="samplesDetailPanelColumn">
                                                <apex:pageBlockSection title="Shipping Information" columns="1" collapsible="false" >
                                                    
                                                    <b>Shipping To</b><br/>
                                                    {!sample.Contact}<br/>{!sample.ShiptoCustomerName}<br/>{!sample.StreetAddress1}<br/>{!sample.StreetAddress2}<br/>
                                                    {!sample.City}<br/>{!sample.StateName}<br/>{!sample.Zipcode}<br/>{!sample.Country}<br/><br/>
                                                    <b>Date Shipped</b><br/>
                                                    <apex:outputText value="{!sample.ActualShipDtm}" /><br/>
                                                    <b>Shipment Tracking #</b><br/>
                                                    <apex:outputText value="{!sample.TrackingIdForCarrier1Txt} {!sample.TrackingIdForCarrier2Txt} " />
                                                    
                                                </apex:pageBlockSection>
                                            </apex:outputPanel>
                                            
                                        </apex:pageBlockSectionItem>
                                        
                                        <apex:pageBlockSectionItem rendered="{!sample.bRenderCSection}">   
                                            <apex:outputPanel styleClass="samplesDetailPanelColumn"> 
                                                <apex:pageBlockSection title="Notes" columns="1" collapsible="false"> 
                                                    
                                                    <b>On Behalf Of</b> <br/><apex:outputText value="{!sample.OBO}" /><br/>
                                                    <br/><apex:outputText value="<b>Account CIM ID</b><br/><br/>{!sample.DetailViewCIMIDs}" escape="false" rendered="{!IF(sOppRecName != NULL || sWWID != NULL, true, false)}" /><br/>
                                                    <br/><apex:outputText value="<b>Opportunity ID</b><br/><br/>{!sample.DetailViewOppIDs}" escape="false" rendered="{!IF(sAcctRecName != NULL || sWWID != NULL, true, false)}" />
                                                    
                                                </apex:pageBlockSection>
                                            </apex:outputPanel>
                                        </apex:pageBlockSectionItem> 
                                        
                                    </apex:pageBlockSection>
                                </apex:outputPanel>  
                            </apex:column>    
                            
                        </apex:pageBlockTable>
                        
                    </apex:outputPanel>
                    
                </apex:tab> 
                
                
                <apex:tab label="IT@Intel" name="tabITIntel" id="tabITIntel" labelWidth="120"
                          onTabEnter="clickTab('tabITIntel','','');">
                    
                    <iframe id="gridFrame0" scrolling="auto" height="600" width="100%" frameborder="0"
                            src="/apex/gblite__Grid?gname=IT Intel Sales Support Requests&sh=0&ro=0&sbb=0">
                    </iframe>
                </apex:tab>
                
                <!--Intel Altera Phase1: 
Below method is used for showing the PSG Quote History associated with Opportunity. --> 
                <apex:tab label="PSG Quotes" name="tabPSGQuote" id="tabPSGQuote"  labelWidth="120" onTabEnter="clickTab('tabPSGQuote','{!$Component.pageblk.pgBlkPSGQuoteTbl}','');"  rendered="{!bPSGQuoteTabVisible}">
                    <apex:outputPanel id="psgQuoteHistoryPnl" >
                        <apex:actionFunction name="pullPSGQuote" action="{!pullPSGQuoteHistory}" reRender="psgQuoteHistoryPnl" status="samplePSGQuoteLoadStatus"/>
                        <apex:actionstatus id="samplePSGQuoteLoadStatus">
                            <apex:facet name="start"><apex:image url="/img/loading32.gif" styleClass="imageTabLoading"/></apex:facet>
                        </apex:actionstatus>
                        <div  class="PSGQuoteSection"> 
                            <apex:outputPanel rendered="{!bPSGQuoteProcessingInfoDisp}">
                                <div id="section-1" class="PSGQuoteSection1">
                                    <apex:outputText value="{!$Label.Core_PSG_Quote_Request_Process_Message}" />
                                </div>
                            </apex:outputPanel>
                            
                            <div id="section-Heading" class="PSGQuoteSectionHeading"> <b>PSG Quote history </b> </div>
                            <div id="section-2" >
                                
                                <apex:outputPanel >
                                    
                                    <apex:pageBlockTable value="{!lstPSGQuoteGenarationHistory}" var="item" id="pgBlkPSGQuoteTbl" border="1px">
                                        <apex:column headerValue="RFQ ID" style="width:20%"> <apex:outputLink value="{!item.Core_Quote_URL__c}" target="_blank" id="quoteURL">{!item.Core_RFQ_ID__c}</apex:outputLink> </apex:column>
                                        <apex:column headerValue="Quote Creation Date" value="{!item.CreatedDate}" style="width:20%" />
                                        <apex:column headerValue="Status" value="{!item.Core_Message_Status__c}"  style="width:60%"/>
                                    </apex:pageBlockTable> 
                                    <div id="MessageDiv" class="PSGMessageDivSection"> 
                                        <apex:outputText rendered="{!bPSGQuoteHistoryExist}" value="{!$Label.Core_PSG_History_No_Record_Found}" /> 
                                    </div>
                                </apex:outputPanel>
                            </div>
                        </div>
                    </apex:outputPanel>
                </apex:tab> 
                
                <!-- SSG Support Request Grid Buddy Flow Changes Start -->
                <!-- Display if User Navigates from Account Record -->
                <apex:tab label="{!$Label.Core_SSR_Support_Request}" name="tabDRDSSR" id="tabDRDSSR1" labelWidth="180"
                          onTabEnter="clickTab('tabDRDSSR','','');" rendered="{!sAcctId != ''}">
                    <iframe id="gridFrame0" scrolling="auto" height="600" width="100%" frameborder="0"
                            src="/apex/gblite__Grid?gname=Software Expert Support&sh=0&ro=0&sbb=0&fpf=core_opportunity__r.AccountId&fpv={!sAcctId}">
                    </iframe>
                </apex:tab>
                
                <!-- Display if User Navigates from Opportunity Record -->
                <apex:tab label="{!$Label.Core_SSR_Support_Request}" name="tabDRDSSR" id="tabDRDSSR2" labelWidth="180"
                          onTabEnter="clickTab('tabDRDSSR','','');" rendered="{!sOppId != ''}"> 
                    <iframe id="gridFrame0" scrolling="auto" height="600" width="100%" frameborder="0"
                            src="/apex/gblite__Grid?gname=Software Expert Support&sh=0&ro=0&sbb=0&fpf=core_opportunity__c&fpv={!sOppId}">
                    </iframe>                  
                </apex:tab>
                
                 <!-- Display if User Navigates from Sales Support Tab -->
                <apex:tab label="{!$Label.Core_SSR_Support_Request}" name="tabDRDSSR" id="tabDRDSSR3" labelWidth="180"
                          onTabEnter="clickTab('tabDRDSSR','','');" rendered="{!AND(sOppId == '',sAcctId=='')}">  
                    <iframe id="gridFrame0" scrolling="auto" height="600" width="100%" frameborder="0"
                            src="/apex/gblite__Grid?gname=Software Expert Support&sh=0&ro=0&sbb=0&fpf=createdById&fpv={!userId}">
                    </iframe>
                </apex:tab>
                 <!-- SSG Support Request Grid Buddy Flow Changes End -->
                
            </apex:tabPanel>
        </apex:pageBlock>
    </apex:form>
