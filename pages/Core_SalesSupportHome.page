<!--**************************************************************************************
Apex Page Name:  Core_SalesSupportHome
Version     : 1.0 
Created Date: 01 JUN 2015
Function    : Copy of Core_DealSupportHomeClone page, refactored for release 2.0. This
will be Seeds + Samples + other sales support request types. For Seeds and Samples,
users can view/request them based on Opportunity ID or Account ID or WWID.
Modification Log :
* Developer               Date                   Description
* ----------------------------------------------------------------------------                 
* Srikant Joshi           Jul 11, 2014           Original Version
* Harshith M L            Jul 20, 2014           Table alignment, URL updates for Webservice
* Srikant Joshi           Feb 18, 2015           Added the CSS Style and Javascript to the static resource
* Dave Hood               Jun 01, 2015           Copied from Core_DealSupportHomeClone & updated for JAD
* Derek Lindblom          Oct 07, 2015           Added IT@Intel for custom engagement
* Dave Hood               Jan 11, 2016           Performance optimization and small tweaks to IT@Intel tab appearance/behavior
* Accenture               Dec 5 , 2016            PSG Sales functionality
* Rangesh Kona            Aug 1st, 2017          Sales Support Request - SMG/DRD Integration
* Ashwin Dash             Jul 24, 2018           US103400 : Update SSG Support Request to Software Expert Support
**************************************************************************************** -->
<apex:page controller="Core_SalesSupportHomeController" sidebar="true" showHeader="true" docType="html-5.0" tabStyle="Core_Sales_Support__tab"
           standardStylesheets="true" title="{!$Label.Core_SalesSupportViewTitle}" lightningStylesheets="true">
    <!-- Insert style sheet references here -->
    <apex:stylesheet value="{!URLFOR($Resource.Core_SalesSupportHomeCSS)}" />
    <apex:stylesheet value="/sCSS/25.0/sprites/1342034628000/Theme3/default/gc/versioning.css" />
    <apex:stylesheet value="/sCSS/25.0/sprites/1342034628000/Theme3/default/gc/extended.css" />
 
    <!-- End stylesheet references -->
    
    <!-- Javascript includes and code -->
    <apex:includeScript value="{!URLFOR($Resource.Core_SalesSupportHomeJS)}" />
    
    <script language="javascript">
    // Fix issue with jQuery conflicts with tabPanel (http://salesforce.stackexchange.com/questions/23159/using-jquery-with-apextabpanel-in-visualforce)
    // Needs to be here - won't work in javscript include
    if ('jQuery' in window) jQuery.noConflict();
    
    /* 01/10/16 DH: This code added an onLoad event handler that loaded either Seeds or Samples *after* the rest of the page was loaded,
    to allow users to use the top part of the page immediately (ordering Seeds/Samples). However, it's even faster to do it when
    "DOMContentLoaded" event is triggered, since that doesn't need to wait for iframes (like IT@Intel) to load. So commenting the onLoad
    code out for now. Can add it back if we see browser issues with the other approach.
    
    function pullSeeds() {}
    function pullSamples() {}
    addLoadEvent('{!sCurrentTab}');
    */
    
    function loadTab() {
        console.log('**** inside load tab****');
        if (document.getElementById('initialSeedsLoadingImage')) {
            image = document.getElementById('initialSeedsLoadingImage');
            image.parentNode.removeChild(image);
        }
        if (document.getElementById('initialSamplesLoadingImage')) {
            image = document.getElementById('initialSamplesLoadingImage');
            image.parentNode.removeChild(image);
        }
        console.log('**** current  tab**** {!sCurrentTab}');
        if ('{!sCurrentTab}' == 'tabSeeds')
            clickTab('tabSeeds','{!$Component.pageblk.seedsTable}','{!$Component.pageblk.seedsMessages}');
        else if ('{!sCurrentTab}' == 'tabSamples')
            clickTab('tabSamples','{!$Component.pageblk.samplesTable}','{!$Component.pageblk.samplesMessages}');
    }
    document.addEventListener( "DOMContentLoaded", loadTab, false );
    </script>
    
    <apex:outputPanel >
        <table>
            <tr>
                <td class="gridtable2">
                    <apex:image value="{!$Resource.Core_PencilIcon}" styleClass="gridtable2" />
                </td>
                <td class="gridtable">
                    <apex:outputText styleClass="outputPn1" value="{!IF(sWWID == NULL,$Label.Core_Sales_Support,'')}"/><br/>
                    <apex:outputText styleClass="outputPn2" value="{!IF(sWWID != NULL,$Label.Core_Sales_Support,IF(sOppRecName != null,sOppRecName,sAcctRecName))}" />
                </td>
            </tr>
        </table>
        <br/>       
    </apex:outputPanel>
    
    <apex:outputPanel rendered="{!NOT(bUserHasAccess)}">
        <br/>
        <apex:pageMessage severity="INFO" title="Access Denied" summary="User doesn't have access to view the page." strength="2"></apex:pageMessage>
    </apex:outputPanel>
    
    <!-- SSG Support Request Changes Start -->
    <apex:outputPanel rendered="{!showNavigationErrorMessage}" id="InCorrectNavigation">
        <apex:pageMessage severity="FATAL" title="Error" summary="{!$Label.Core_SSR_Navigation_Error}" strength="2"></apex:pageMessage>
    </apex:outputPanel>
    
    <apex:outputPanel rendered="{!showNoAccessMessage}" id="UserHasNoAccess">
        <apex:pageMessage severity="FATAL" title="Error" summary="{!$Label.Core_SSR_User_Access_Error}" strength="2"></apex:pageMessage>
    </apex:outputPanel>   
    <!-- SSG Support Request Changes End -->
    
    <apex:outputPanel rendered="{!bAccountWithNoCIMID}">
        <br/>
        <apex:pageMessage severity="INFO" title="Account is not mastered" strength="2"
                          summary="This account has not been mastered, so has no CIM ID, and cannot have Sales Support requests placed against it."></apex:pageMessage>
    </apex:outputPanel>
    
    <apex:form >
        
        <!--apex:actionFunction action="{!loadFirstTab}" name="loadTab" reRender="theTabPanel"/-->
        
        <!-- Intel Altera Phase1:
Code added on 12-5-2016.Calls the controller for Quote creation   -->
        <apex:actionFunction name="processOpportuntyQuote" action="{!createPSGQuoteonSiebel}" rerender="pnlRequestTypeSection,theTabPanel" oncomplete="loadTab()"/> 
        <apex:actionFunction name="processSSGRequest" action="{!processSSGRequest}"></apex:actionFunction>
        
        <apex:pageBlock tabStyle="Core_Sales_Support__tab" id="pageblk" rendered="{!bUserHasAccess && NOT(bAccountWithNoCIMID)}">
            <apex:outputPanel id="pnlRequestTypeSection" >
                
                <div style="margin-top:12px; font-weight:bold; font-size: 1.22em">
                    Select Sales Support Request Type
                </div>
                <br/>
                <!-- Intel Altera Phase1:
Code added on 12-5-2016.Used for displaying the notification message on quote creation process  
-->
                <apex:pageMessages rendered="{!NOT(bOpportunityValidForQuoteCreation)}"/>
                <apex:outputLabel for="existing__opp" value="Sales Support Request Type"
                                  style="font-weight:bold;color:rgb(74, 74, 86);font-size: 11px" />&nbsp;&nbsp;&nbsp;
                
                <apex:selectList id="salesSupportRequestType" size="1">
                    <!--apex:selectOption itemLabel="IT@Intel" itemValue="IT@Intel"/-->
                    <apex:selectOption itemLabel="Order Seed" itemValue="Order Seed"/>
                    <apex:selectOption itemLabel="Request Sample" itemValue="Request Sample"/>
                    <apex:selectOption itemLabel="IT@Intel" itemValue="IT@Intel"/>
                    
                    <!-- Intel Altera Phase1:
code added on 12-5-2016 
-->
                    <apex:selectOption rendered="{!IF($Profile.Name == 'BU Account Collaborator',FALSE,bSalesSupportHomePageAccessible)}" itemLabel="{!$Label.Core_PSG_Quote_Label}" itemValue="{!$Label.Core_PSG_Quote_Label}"/> 
                    
                    
                    <apex:selectOption itemLabel="{!$Label.Core_SSR_Support_Request}" itemValue="{!$Label.Core_SSR_Create_SSR}"/>  
                    
                    
                </apex:selectList>
                
                <!-- Button for Ordering Seeds or Samples -->
                <apex:commandButton value="Continue"
                                    onClick="newRequest('{!$Component.pageblk.salesSupportRequestType}', '{!sOppId}',
                                             '{!JSENCODE(sOppRecName)}',
                                             '{!sAcctId}', '{!orderSeedsURL}', '{!requestSamplesURL}', '{!UserRegion}', '{!UIthemedisplayed}',
                                             '{!$Label.Core_Intel_Network_Resource}', '{!$Label.Core_IntelNetworkError}'); return false" /> 
                &nbsp;
                <br/><br/>
                
                <h3 class="recordTypesHeading">Available Sales Support Request Types</h3>
<table class="recordTypeInfo infoTable" border="0" cellpadding="0" cellspacing="0">
                    <tr class="headerRow"><TH class="recordTypeName" scope="col">Request Type</TH><TH class="recordTypeDescription" scope="col">Description</TH></tr>
                    <tr><TH class="recordTypeName" scope="row">Order Seed</TH><td class="recordTypeDescription">Commercial/Prototype Devices (powered by Intel Demo Depot)&nbsp; <apex:outputLink value="https://salescrm.intel.com/opportunity-management/seeds/" style="color:blue" target="new">Learn More</apex:outputLink></td></tr>
                    <tr class="last"><TH class="recordTypeName" scope="row">Request Sample</TH><td class="recordTypeDescription">Components (powered by My Samples/SMS) &nbsp; <apex:outputLink value="https://salescrm.intel.com/opportunity-management/managing-samples/" style="color:blue"  target="new">Learn More</apex:outputLink></td></tr>
                    <tr><TH class="recordTypeName" scope="row">IT @ Intel</TH><td class="recordTypeDescription">Request IT @ Intel Support for Opportunities &nbsp; <apex:outputLink value="http://salescrm.intel.com/opportunity-management/partnering-with-itintel/" style="color:blue"  target="new">Learn More</apex:outputLink></td></tr>
                    
                    
                    
                    <!-- Intel Altera Phase1:
This Table row will be added only if the user has the access to the Sales support page 
-->
                    <tr rendered="{!bSalesSupportHomePageAccessible}"><TH class="recordTypeName" scope="row">{!$Label.Core_PSG_Quote_Label}</TH><td class="recordTypeDescription" width="600px"> Request a PSG quote to be created in Siebel</td></tr>
                    
                    <tr><TH class="recordTypeName" scope="row">{!$Label.Core_SSR_Support_Request}</TH><td class="recordTypeDescription">Get expert software support from SSG and CVCG teams for competitive and/or strategic Opportunities.&nbsp; <apex:outputLink value="http://salescrm.intel.com/opportunity-management/ssg-sales-support/" style="color:blue"  target="new">Learn More</apex:outputLink></td></tr>
                    
                </table>                
                <br/><br/>
            </apex:outputPanel> 
            <apex:tabPanel switchType="client" value="{!sCurrentTab}" id="theTabPanel" tabClass="activeTab" inactiveTabClass="inactiveTab" styleClass="recordName">
                
                <apex:tab label="Seeds" name="tabSeeds" id="tabSeeds" labelWidth="120"
                          onTabEnter="clickTab('tabSeeds','{!$Component.pageblk.seedsTable}','{!$Component.pageblk.seedsMessages}');">
                    <apex:actionFunction name="pullSeeds" action="{!pullSeeds}" reRender="seedsPanel" status="seedsTabLoadStatus"/>
                    
                    <apex:actionstatus id="seedsTabLoadStatus" > 
                        <apex:facet name="start"><apex:image url="/img/loading32.gif" styleClass="imageTabLoading"/></apex:facet>
                    </apex:actionstatus>
                    
                    <img id="initialSeedsLoadingImage" src="/img/loading32.gif" class="imageTabLoading"/>
                    
                    <apex:outputPanel id="seedsPanel">
                        
                        <apex:actionFunction name="applySeedsFilters" action="{!filterSeeds}" reRender="seedsPanel" status="seedsFilterStatus"/>
                        
                        <br/>
                        <apex:pageMessages rendered="{!bSeedsErrorFlag}" id="seedsMessages"/>
                        
                        <apex:outputPanel rendered="{!NOT(bSeedsRenderFlag)}">
                            <br/><br/><br/><br/>
                        </apex:outputPanel>
                        
                        <apex:pageBlockSection title="{!$Label.Core_Section_Seeds_Section}" collapsible="false" rendered="{!bSeedsRenderFlag}">
                            <apex:panelGrid columns="10"> 
                                
                                <apex:inputText value="{!sSeedSearch[0]}"  size="{!IF(sWWID != NULL,7,8)}" html-placeholder="Order No" 
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"/>
                                
                                <apex:inputText value="{!sSeedSearch[1]}" size="{!IF(sWWID != NULL,37,41)}" html-placeholder="Product Name" 
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"/> 
                                
                                <apex:inputText value="{!sSeedSearch[2]}" size="{!IF(sWWID != NULL,8,10)}"  html-placeholder="Estimated Ship Date"  
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"/> 
                                
                                <apex:inputText value="{!sSeedSearch[3]}" size="{!IF(sWWID != NULL,8,10)}" html-placeholder="Delivery Date"  
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"/>
                                
                                <apex:inputText value="{!sSeedSearch[4]}" size="{!IF(sWWID != NULL,12,14)}" html-placeholder="Delivery Status"  
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"/> 
                                
                                <apex:inputText value="{!sSeedSearch[5]}" size="{!IF(sWWID != NULL,8,10)}" html-placeholder="Pickup Date" 
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"/> 
                                
                                <apex:inputText value="{!sSeedSearch[6]}" size="{!IF(sWWID != NULL,8,10)}" html-placeholder="Requester"  
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"/>
                                
                                <apex:inputText value="{!sSeedSearch[7]}" size="{!IF(sWWID != NULL,6,7)}" html-placeholder="Req. Qty"  
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"/>
                                
                                <apex:inputText value="{!sSeedSearch[8]}" size="{!IF(sWWID != NULL,15,IF(sOppRecName!= NULL,19,0))}" html-placeholder="Account Name" 
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"
                                                rendered="{!IF(sOppRecName!= NULL || sWWID != NULL, true,false)}"/>
                                
                                <apex:inputText value="{!sSeedSearch[9]}" size="{!IF(sWWID != NULL,15,IF(sAcctRecName != NULL,19,0))}" html-placeholder="Opportunity Name"  
                                                styleClass="{!IF(sWWID != NULL,'userSeedFilter','accountSeedFilter')}" onkeypress="return runOnEnter(event, 'Seeds');"
                                                rendered="{!IF(sAcctRecName != NULL || sWWID != NULL, true,false)}"/>
                                
                            </apex:panelGrid>
                            
                            <br/>
                            <apex:commandButton action="{!filterSeeds}" reRender="seedsPanel" value="Apply Filters" status="seedsFilterStatus" styleClass="filterButton" />
                            <apex:actionstatus id="seedsFilterStatus">
                                <apex:facet name="start"><apex:image url="/img/loading32.gif" styleClass="imageFilterLoading"/></apex:facet>
                            </apex:actionstatus>
                        </apex:pageblocksection>
                        
                        <!-- Table for rendering Seeds grid view -->
                        <apex:pageBlockTable value="{!lstFilteredSeeds}" var="seed" id="seedsTable"  frame="box" columns="11"
                                             columnsWidth="2%,2%,16%,5%,5%,6%,5%,5%,3%,8%,8%" rendered="{!bSeedsRenderFlag}">
                            <apex:column >
                                <apex:actionstatus id="expansionStatus">
                                    <apex:facet name="start">
                                        <apex:image url="/img/loading32.gif" height="12" width="12"/>
                                    </apex:facet>
                                </apex:actionstatus>
                                <apex:commandLink status="expansionStatus" reRender="seedsPanel" action="{!toggleRendering}">
                                    <apex:image url="{!URLFOR($Resource.Core_CollapsibleImages, 'CollapsibleV2.png')}" width="10" height="10" rendered="{!seed.bRenderCSection}"/>   
                                    <apex:image url="{!URLFOR($Resource.Core_CollapsibleImages, 'UpsideCollapsibleV2.png')}" width="10" height="10" rendered="{!NOT(seed.bRenderCSection)}"/>
                                    <apex:param name="renderToggle" value="{!!seed.bRenderCSection}" assignTo="{!seed.bRenderCSection}"/>
                                </apex:commandLink> 
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        Demo Deport<br/>
                                        Order #
                                    </div>
                                </apex:facet>
                                <apex:commandlink onclick="openSalesSupportPopup('{!viewSeedURL}' + 'WONo='+{!seed.OrderNumber});return false;" value="{!seed.OrderNumber}" />
                            </apex:column>
                            
                            <apex:column styleClass="alignCentreProductName">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        {!$Label.Core_ProductName}
                                    </div>
                                </apex:facet>
                                <apex:outputText value="{!seed.productname}" />
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        Estimated<br/>
                                        Ship Date
                                    </div>
                                </apex:facet>
                                <apex:outputText value="{!seed.EstimatedShipDate}" />
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        Requested<br/>
                                        Delivery Date
                                    </div>
                                </apex:facet>
                                
                                <apex:outputText value="{!seed.RequestedDeliveryDate}"/>
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        {!$Label.Core_DeliverStatus}
                                    </div>
                                </apex:facet>
                                
                                <apex:outputText value="{!seed.lineItemStatus}"/>
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        {!$Label.Core_PickupDate}
                                    </div>
                                </apex:facet>
                                
                                <apex:outputText value="{!seed.returnPickupDate}"/>
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        {!$Label.Core_Requestor}
                                    </div>
                                </apex:facet>
                                
                                <apex:outputText value="{!seed.Requestor}"/>
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        Requested<br/>
                                        Quantity
                                    </div>
                                </apex:facet>
                                <apex:outputText value="{!seed.RequestedQty}" />
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre" rendered="{!IF(sOppRecName != NULL || sWWID != NULL, true,false)}">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        {!$Label.Core_Account_Name}
                                    </div>
                                </apex:facet>
                                <apex:outputText value="{!seed.AccountName}"/>
                            </apex:column>
                            
                            <apex:column styleClass="alignCentre" rendered="{!IF(sAcctRecName != NULL || sWWID != NULL, true,false)}">
                                <apex:facet name="header">
                                    <div Class="alignCentre">
                                        {!$Label.Core_Opportunity_Name}
                                    </div>
                                </apex:facet>
                                <apex:outputText value="{!seed.OpportunityName}"/>
                            </apex:column>
                            
                            <!-- Use a separate section to render sub section --> 
                            <apex:column breakBefore="true"  id="theColmn" width="1250" colspan="14">
                                <apex:outputPanel styleClass="alignOutputPanel" >
                                    <apex:pageBlockSection columns="3" rendered="{!seed.bRenderCSection}" >
                                        
                                        <apex:pageBlockSectionItem rendered="{!seed.bRenderCSection}"> 
                                            <apex:outputPanel styleClass="alignOutputPanel1"> 
                                                <apex:pageBlockSection title="{!$Label.Core_Section_Seed_Detail}" columns="1" collapsible="false"  >
                                                    
                                                    <b>{!$Label.Core_ItemsSent}</b><br/><apex:outputText value="{!seed.productName}" id="username" html-placeholder="Enter a value"/><br/>  
                                                    <b>{!$Label.Core_QuantitySent}</b><br/><apex:outputText value="{!seed.shippedQty}"  html-placeholder="Enter a value"/><br/>
                                                    <b>{!$Label.Core_ProductDetail}</b><br/><apex:outputText value="{!seed.productDesc}{!seed.productListDesc}" escape="false" />
                                                    
                                                </apex:pageBlockSection>
                                            </apex:outputPanel> 
                                            
                                        </apex:pageBlockSectionItem>
                                        
                                        <apex:pageBlockSectionItem rendered="{!seed.bRenderCSection}">   
                                            <apex:outputPanel styleClass="alignOutputPanel1">
                                                <apex:pageBlockSection title="{!$Label.Core_Section_Shipping_Detail}" columns="1" collapsible="false" >
                                                    
                                                    <b>{!$Label.Core_ShippingTo}</b><br/>{!seed.attentionName}<br/>
                                                    {!seed.companyName}<br/>{!seed.streetAddress1}<br/>{!seed.streetAddress2}
                                                    <br/>{!seed.City}<br/>{!seed.State}<br/>{!seed.Zipcode}<br/>{!seed.Country}<br/><br/>
                                                    <b>{!$Label.Core_DateShipped}</b><br/><apex:outputText value="{!seed.actualShipDate}" html-placeholder="Enter a value"/><br/>
                                                    <b>{!$Label.Core_OrderStatus}</b><br/><apex:outputText value="{!seed.orderStatus}" html-placeholder="Enter a value" />
                                                    
                                                </apex:pageBlockSection>
                                            </apex:outputPanel>
                                            
                                        </apex:pageBlockSectionItem>
                                        
                                        <apex:pageBlockSectionItem rendered="{!seed.bRenderCSection}">   
                                            <apex:outputPanel styleClass="alignOutputPanel1"> 
                                                <apex:pageBlockSection title="{!$Label.Core_Section_Notes}" columns="1" collapsible="false"> 
                                                    
                                                    <b>{!$Label.Core_Section_Notes}</b> <br/><apex:outputText value="{!seed.notes}"  html-placeholder="{!$Label.Core_EnterValue}" /><br/>
                                                    <b>{!$Label.Core_Submitter}</b> <br/><apex:outputText value="{!seed.Submitter}"  html-placeholder="{!$Label.Core_EnterValue}" /><br/>
                                                    <br/><apex:outputText value="<b>{!$Label.Core_Account_ID_Name}</b><br/><br/>{!seed.AccountID}"  escape="false" rendered="{!IF(sOppRecName != NULL || sWWID != NULL, true,false)}" /><br/>
                                                    <br/><apex:outputText value="<b>{!$Label.Core_Opportunity_ID_Name}</b><br/><br/>{!seed.OpportunityID}"  escape="false" rendered="{!IF(sAcctRecName != NULL || sWWID != NULL, true,false)}" />
                                                    
                                                </apex:pageBlockSection>
                                            </apex:outputPanel>
                                        </apex:pageBlockSectionItem> 
                                        
                                    </apex:pageBlockSection>
                                </apex:outputPanel>  
                                <!-- </apex:outputPanel> --> 
                            </apex:column>    
                            
                        </apex:pageBlockTable>
                        
                    </apex:outputPanel>
                    
                </apex:tab>
                
                <apex:tab label="Samples" name="tabSamples" id="tabSamples" labelWidth="120"
                          onTabEnter="clickTab('tabSamples','{!$Component.pageblk.samplesTable}','{!$Component.pageblk.samplesMessages}');">
                    <apex:actionFunction name="pullSamples" action="{!pullSamples}" reRender="samplesPanel" status="samplesTabLoadStatus"/>
                    
                    <apex:actionstatus id="samplesTabLoadStatus">
                        <apex:facet name="start"><apex:image url="/img/loading32.gif" styleClass="imageTabLoading"/></apex:facet>
                    </apex:actionstatus>
                    
                    <img id="initialSamplesLoadingImage" src="/img/loading32.gif" class="imageTabLoading"/>
                    
                    <apex:outputPanel id="samplesPanel">
                        
                        <apex:actionFunction name="applySamplesFilters" action="{!filterSamples}" reRender="samplesPanel" status="samplesFilterStatus"/>
                        
                        <br/>
                        <apex:pageMessages rendered="{!bSamplesErrorFlag}" id="samplesMessages"/>
                        
                        <apex:outputPanel rendered="{!NOT(bSamplesRenderFlag)}">
                            <br/><br/><br/><br/>
                        </apex:outputPanel>
                        
                        <apex:pageBlockSection title="Request Detail" collapsible="false" rendered="{!bSamplesRenderFlag}">
                            <apex:panelGrid columns="12"> 
                                
                                <apex:inputText value="{!sSampleSearch[0]}" size="3" html-placeholder="Req. ID#" 
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples'));"/>
                                
                                <apex:inputText value="{!sSampleSearch[1]}" size="2" html-placeholder="Line #" 
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');"/>
                                
                                <apex:inputText value="{!sSampleSearch[2]}" size="{!IF(sWWID != NULL,34,IF(sAcctRecName != NULL,37,43))}" html-placeholder="Product Name" 
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');"/>
                                
                                <apex:inputText value="{!sSampleSearch[3]}" size="{!IF(sWWID != NULL,9,IF(sAcctRecName != NULL,10,11))}" html-placeholder="Delivery Date"  
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');"/>
                                
                                <apex:inputText value="{!sSampleSearch[4]}" size="{!IF(sWWID != NULL,8,IF(sAcctRecName != NULL,9,10))}" html-placeholder="Status"  
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');"/> 
                                
                                <apex:inputText value="{!sSampleSearch[5]}" size="{!IF(sWWID != NULL,8,IF(sAcctRecName != NULL,8,11))}" html-placeholder="Requester"  
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');"/>
                                
                                <apex:inputText value="{!sSampleSearch[6]}" size="{!IF(sWWID != NULL,4,IF(sAcctRecName != NULL,5,6))}" html-placeholder="Req. Qty"  
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');"/>
                                
                                <apex:inputText value="{!sSampleSearch[7]}" size="{!IF(sWWID != NULL,4,IF(sAcctRecName != NULL,5,6))}" html-placeholder="Appr. Qty"  
