                                <apex:inputText value="{!sSampleSearch[8]}" size="{!IF(sWWID != NULL,11,IF(sOppRecName != NULL,13,''))}" html-placeholder="Account Name" 
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');"
                                                rendered="{!IF(sOppRecName!= NULL || sWWID != NULL, true,false)}"/>
                                
                                <apex:inputText value="{!sSampleSearch[9]}" size="{!IF(sWWID != NULL,15,IF(sAcctRecName != NULL,15,''))}" html-placeholder="Opportunity Name" 
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');" 
                                                rendered="{!IF(sAcctRecName!= NULL || sWWID != NULL, true,false)}"/>
                                
                                <apex:inputText value="{!sSampleSearch[10]}" size="{!IF(sWWID != NULL,9,IF(sAcctRecName != NULL,16,''))}" html-placeholder="Opportunity Stage"  
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');"
                                                rendered="{!IF(sAcctRecName != NULL || sWWID != NULL, true,false)}"/>
                                
                                <apex:inputText value="{!sSampleSearch[11]}" size="{!IF(sWWID != NULL,8,IF(sAcctRecName != NULL,8,18))}" html-placeholder="Approver"  
                                                styleClass="{!IF(sWWID != NULL,'userSampleFilter','accountSampleFilter')}" onkeypress="return runOnEnter(event, 'Samples');"/>
                                
                            </apex:panelGrid>
                            
                            <br/>
                            <apex:commandButton action="{!filterSamples}" reRender="samplesPanel" value="Apply Filters" status="samplesFilterStatus" styleClass="filterButton" />
