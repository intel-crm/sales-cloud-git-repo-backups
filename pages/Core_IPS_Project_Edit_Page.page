<apex:page standardController="Core_IPS_Project__c" extensions="Core_IPS_Project_Edit_Detail_Controller" id="pgid" > <!-- action="{!redirectEditPage}"-->
    <style>
        .requiredLegend .requiredText {
            color: #fff;
        }
        .requiredLegend .requiredText:before {
            content:'*';
        }
    </style>
   <!-- Start -- US240396---26-Dec-18 added the fields and conditions for PSO--by Orion vamsi-->
     <script>
       function callBackEnd(){
           var selVal = document.getElementById('pgid:fmid:pb1:pbsid:pbsiId:sbox').selectedIndex;
           var finalVal = document.getElementById('pgid:fmid:pb1:pbsid:pbsiId:sbox').options[selVal].value;
           document.getElementById("pgid:fmid:pb1:pbsid:onee").value =finalVal; 
       }
   </script>
    <apex:form id="fmid">
         <apex:actionFunction name="actionFun" action="{!fieldUpdate}"/>
    <!-- End -- US240396---26-Dec-18 added the fields and conditions for PSO--by Orion vamsi-->
        <apex:outputPanel >
            <apex:sectionHeader title="{!$Label.Core_IPS_Premier_Support_Project_Edit}" subtitle="{!Core_IPS_Project__c.Name}" />
        </apex:outputPanel>
        <apex:pageBlock id="pb1" mode="Edit" title="{!$Label.Core_IPS_Premier_Support_Project_Edit}" >
            <apex:pageBlockButtons >
                <apex:commandButton action="{!Save}" value="{!$Label.Core_IPS_Save}" />
                <apex:commandButton action="{!saveNew}" value="{!$Label.Core_IPS_Save_New}" rerender="msgId"/>
                <apex:commandButton action="{!Cancel}" value="{!$Label.Core_IPS_Cancel}" />
            </apex:pageBlockButtons>   
            <apex:pageMessages id="msgId" ></apex:pageMessages>   
            <apex:outputPanel >
                <apex:pageBlockSection columns="2" title="{!$Label.Core_IPS_Information}" id="pbsid" >
                    <apex:inputField value="{!Core_IPS_Project__c.Name}" required="true"/>
                    <apex:inputField value="{!Core_IPS_Project__c.Core_Project_Description__c}"/>
                    <apex:outputField value="{!Core_IPS_Project__c.Core_MPNDA__c}"/>
                    <apex:outputField value="{!Core_IPS_Project__c.Core_IPS_Project_ID__c}"/>
                    <apex:inputField value="{!Core_IPS_Project__c.Core_Status__c}"/>
                    <!--Start --US240404--26-Dec-18 for Disabling InterestedParty checkbox by Popcornapps-->
                    <apex:pageBlockSectionItem helpText="{!$Label.Core_IPS_Enable_Members_as_Interested_Parties_Help_Text}">
                        <apex:outputLabel >{!$Label.Core_IPS_Enable_Members_as_Interested_Parties}</apex:outputLabel>
                        <apex:inputCheckbox value="{!Core_IPS_Project__c.Core_IPS_EnableMemberasInterestedParties__c}" disabled="{!isEmailOptCheck}"/>
                    </apex:pageBlockSectionItem>
                    <!--End --US240404--26-Dec-18 for Disabling InterestedParty checkbox by Popcornapps-->
                    <apex:inputField value="{!Core_IPS_Project__c.Core_IPS_Remove_Notification_Details__c}"/>
                    <!-- Start -- US240396---26-Dec-18 added the fields and conditions for PSO--by Orion vamsi-->
                   <apex:pageBlockSectionItem id="pbsiId" rendered="{!fieldDisplay}">
                 <apex:outputlabel value="{!$Label.Core_IPS_Project_Partner_Support_Owner}"/>
                 <apex:selectList size="1" value="{!selectedVal}" onchange="callBackEnd()" id="sbox">
                   <apex:selectOptions value="{!userList}" ></apex:selectOptions>
                    </apex:selectList>
                </apex:pageBlockSectionItem>
                <apex:inputHidden value="{!Core_IPS_Project__c.Core_IPS_Partner_Support_Owner__c}" id="onee"  />
                <!-- End -- US240396---26-Dec-18 added the fields and conditions for PSO--by Orion vamsi-->
                    </apex:pageBlockSection> 
                    </apex:outputPanel>
        </apex:pageBlock>
    </apex:form>
</apex:page>