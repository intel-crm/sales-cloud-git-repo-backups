<apex:page standardController="Core_IPS_Assigned_Environment_Variables__c"  action="{!getAssignedEnvironmentVariables}" extensions="Core_EnvironmentVariablesController">
<apex:includeScript value="{!$Resource.Core_IPS_Jquery11}"/>

   <script> var previousOnload = window.onload; window.onload = function() { if (previousOnload) { previousOnload(); } 
        checkboxes = document.getElementsByTagName("input");
       
        size = (checkboxes.length-6)/3;
        
        for(i=0;i<size;i++){
                checkbox2 = "page:form:pageSection:table:"+i+":checkbox2";
                checkbox3 = "page:form:pageSection:table:"+i+":checkbox3";
                document.getElementById(checkbox2).disabled=true;
                document.getElementById(checkbox3).disabled=true;
                
            } } </script>
    <script language="javascript">
        
        function enableRequiredAndAgentOnly(val1,val2,val3) {
            if(document.getElementById(val1).checked){
                document.getElementById(val2).disabled=false;
                document.getElementById(val3).disabled=false;
            }else{
                document.getElementById(val2).disabled=true;
                document.getElementById(val3).disabled=true;
            }
        }
        // A $( document ).ready() block.
$( document ).ready(function() {
    $("select").change(function(){
    
       if($(this).val() == 'Inactive')
       {
         $(".pbBody").prepend("<span id='msgSpan' style='color:red;align:center;'>Are you sure? Once set to Inactive, changing the status back to Active will require a KTBR request!<br/>All children objects (Subcategories and Env Details if configured) will be set to Inactive as well.</span>");
       }
       else
       {
         $(".pbBody").find("#msgSpan").remove();
       }
    
    });
});

    </script>
     
   <apex:form id="form">
   <apex:pageblock id="ErrMessSec" rendered="{!(ErrorMessage != null)}">
   <div align="center">
   <apex:commandButton action="{!cancel}" value="Exit" />
   </div>
   <div align="center">
   <apex:outputLabel value="{!ErrorMessage}" style="font-weight:bold"/> 
   </div>
   
   </apex:pageblock>
  
  <apex:pageblock rendered="{!(ErrorMessage == null)}">
  <apex:pageBlockButtons >
  <apex:commandButton value="Save" action="{!saveEvn}"/>
  <apex:commandButton value="Cancel" action="{!cancel}"/>
  </apex:pageBlockButtons>
  <apex:pageBlockSection >  
  <apex:repeat value="{!$ObjectType.Core_IPS_Assigned_Environment_Variables__c.FieldSets.Environment_Details_Edit_FieldSet}" var="Evn">  
  
  <apex:pageBlockSectionItem rendered="{!if(Evn.required,true,false)}" >
    <apex:outputLabel value="{!Evn.Label}"></apex:outputLabel>
    <apex:inputfield value="{!aev[Evn]}"  required="{!AND(Evn.required,Evn.type <>'boolean')}" ></apex:inputfield>
   </apex:pageBlockSectionItem>
   <apex:pageBlockSectionItem rendered="{!if(Evn.required,false,true)}" >
    <apex:outputLabel value="{!Evn.Label}"></apex:outputLabel>
    <apex:outputfield value="{!aev[Evn]}"  ></apex:outputfield>
   </apex:pageBlockSectionItem>
</apex:repeat> 
</apex:pageBlockSection> 
   </apex:pageblock>
  </apex:form>
</apex:page>