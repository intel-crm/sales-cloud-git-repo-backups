<apex:page standardController="Account" extensions="Core_Territory_Members_By_Account" showHeader="false">
  <apex:form >
      <apex:pageBlock >
          <apex:pageBlockSection columns="1">
              <apex:PageBlockTable value="{!items}" var="item" columnsWidth="20%,20%,60%">
                  <apex:column >
                      <apex:facet name="header">Territory</apex:facet>
                      <apex:outputLink value="/{!item.Territory2Id}"><apex:outputField value="{!item.Territory2Id}"/></apex:outputLink>
                  </apex:column>
                  <apex:column >
                      <apex:facet name="header">Member</apex:facet>
                      <apex:outputField value="{!item.UserId}"/>
                  </apex:column>
                  <apex:column >
                      <apex:facet name="header">Role</apex:facet>
                      <apex:outputField value="{!item.RoleInTerritory2}"/>
                  </apex:column>
              </apex:PageBlockTable>              
          </apex:pageBlockSection>
      </apex:pageBlock>
  </apex:form>
</apex:page>