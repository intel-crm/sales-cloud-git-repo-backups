<apex:page controller="CoveoV2.ProvisioningController" docType="html-5.0" sidebar="false">
  <c:AdminCheck >
    <apex:includeScript value="{!URLFOR($Resource.CoveoV2__jquery, 'jquery.min.js')}" />
    <apex:includeScript value="{!URLFOR($Resource.CoveoV2__underscore, 'underscore-min.js')}" />
    <apex:includeScript value="{!URLFOR($Resource.CoveoV2__assets, 'js/provisioning.bundle.js')}" />

    <apex:stylesheet value="{!URLFOR($Resource.CoveoV2__assets, 'legacy/css/setup.css')}" />
    <apex:stylesheet value="{!URLFOR($Resource.CoveoV2__styleguide, 'css/CoveoStyleGuide.css')}" />
    <apex:stylesheet value="{!URLFOR($Resource.CoveoV2__assets, 'css/provisioning.style.css')}" />
    <link href="https://fonts.googleapis.com/css?family=Lato" rel="stylesheet"></link>

    <div id="body" class="coveo-styleguide">
      <div id="wrapper" class="modal-backdrop closed"></div>
      <div id="header" class="bg-ebony-clay">

        <div id="title-section">
          <div class='coveo-logo'>
            <img src="{!URLFOR($Resource.assets, 'legacy/img/setup/coveo_horizontal_white.svg')}" />
          </div>
          <span id="forsalesforce" class="text-medium-grey">FOR SALESFORCE</span>
          <span id="setup" class="text-green">Setup</span>
        </div>

        <div class="flex right row">
        <div id="region-switch-section" class="flex-column">
            <span class="text-white inline-block">
              Current Region
              <br />
              <a href="https://docs.coveo.com/en/2976/" target="_blank" class="underline text-white">What is Multi-Region ?</a>
            </span>

            <select id="region-selector" class="m1"></select>
          </div>

          <div id="version-switch-section" class="flex-column"></div>
        </div>

      </div>
      <div id="content" class="bg-pure-white shadow-card">

        <h1 class="text-dark-grey caps bold center">CONFIGURE COVEO FOR SALESFORCE</h1>

        <hr />
        <div class="center py2">
          <button id="btn-create" class="btn mod-secondary button caps">Create a new Coveo Organization</button>
          <button id="btn-link" class="btn mod-secondary button caps">Link to an existing Coveo Organization</button>
        </div>
        <div id="create-org-page" style="display: none">
          <h2 id="content_title" class="center caps p2">select your edition</h2>
          <div class="flex">
            <div id="version-boxes" class="flex mx-auto"></div>
            <div id="create-org" class="flex-column">
              <div id="create-org-name" class="box box-create spaced-box p2">
                <div class="input-field form-group validate">
                  <input id="val-org-name" type="text" value="" required="true" />
                  <label data-invalid-message="You must enter an organization name.">Organization name</label>
                </div>
              </div>
              <div id="create-org-sources" class="box box-create spaced-box p2">
                <p class="">Select the Salesforce sources that you wish to index</p>
                <div class="p1">
                  <label class="coveo-checkbox-label">
                    <input id="ck_create_std" type="checkbox" class="coveo-checkbox" value="standard" />
                    <button type="button"></button>
                    <span class="label">Salesforce standard objects</span>
                  </label>
                  <br />
                  <apex:outputPanel rendered="{!getIsKnowledge}">
                    <label class="coveo-checkbox-label py1">
                      <input id="ck_create_knowledge" type="checkbox" class="coveo-checkbox" value="knowledge" />
                      <button type="button"></button>
                      <span class="label">Salesforce knowledge base</span>
                    </label>
                    <br />
                  </apex:outputPanel>
                </div>
              </div>
              <div id="create-org-action">
                <label class="coveo-checkbox-label block right-align py2 mt1">
                  <input id="ck_accept_terms" type="checkbox" class="coveo-checkbox" value="accept" required="true" />
                  <button type="button"></button>
                  <span class="label">I have read and agree to the
                    <a href="https://www.coveo.com/en/support/terms-agreements" target="_blank">Terms of Service</a> and
                    <a href="https://www.coveo.com/privacy" target="_blank">Privacy Policy</a>.</span>
                </label>
                <button id="btn-create-action" type="button" disabled="true" class="btn mod-primary mod-small right caps">Create</button>
              </div>
            </div>
          </div>
          <div class="center py2">
            <a id="btn-help-me-choose" class="btn mod-secondary caps mod-small px1" href="https://developers.coveo.com/x/JAovAg" target="_blank">Help me choose</a>
          </div>
        </div>
      </div>
      <!-- Sub Link -->
      <div class="center mx-auto footer py2" style="margin-top: 80px; margin-bottom: 20px">
        <h2 class="text-dark-grey caps bold">Additional Resources</h2>
        <hr />
        <div class="flex p2">
          <a id="btn-online-help" href="https://www.coveo.com/go?dest=cloudhelp&lcid=9&context=2" target="_blank" class="flex-fixed-size">
            <div>
              <div class="circle-footer bg-light-grey">
                <img src="{!URLFOR($Resource.assets, 'img/GettingStarted/documentation.svg')}" />
              </div>
              <h3 class="text-dark-grey bold py1">Online Help</h3>
              <p class="text-dark-grey break-word">Read our official product documentation</p>
            </div>
          </a>
          <a id="btn-answers" href="https://answers.coveo.com/" target="_blank" class="flex-fixed-size">
            <div>
              <div class="circle-footer  bg-light-grey">
                <img src="{!URLFOR($Resource.assets, 'img/GettingStarted/q_and_a.svg')}" />
              </div>
              <h3 class="text-dark-grey bold py1">Answers</h3>
              <p class="text-dark-grey break-word">Find answers from our staff on our Q&amp;A forum</p>
            </div>
          </a>
        </div>
      </div>
      <button id="errorTrigger" class="js-modal-trigger" data-modal="prompt-warning" style="display:none">Prompt warning</button>
      <div class="modal-container mod-prompt" id="prompt-warning">
        <div class="modal-content">
          <header class="modal-header mod-warning">
            <h1>Error</h1>
            <span class="small-close js-modal-close">
              <svg width="512" height="512" viewBox="0 0 512 512" class="icon fill-pure-white">
                <path d="M480.002 96l-64-63.998-160 159.998-160-160-64 63.998L192.004 256l-160 159.998 64 64 160-159.998 159.994 159.994 64-64L320.003 256"></path>
              </svg>
            </span>
          </header>
          <div class="modal-body mod-header-padding">
            <div id="errorMesssage" class="pompt-message"></div>
          </div>
          <footer class="modal-footer">
            <button class="btn js-modal-close">Ok</button>
          </footer>
        </div>
      </div>
    </div>

    <script>
      function modalHandler() {
        var backdrop = $('.modal-backdrop');

        $('.js-modal-trigger').each(function (i, modalTrigger) {
          var modal = $('#' + modalTrigger.getAttribute('data-modal'));
          var modalPrompt = $('#' + modalTrigger.getAttribute('data-modal') + 'Prompt');

          var closeButton = modal.find('.js-modal-close');
          var promptCloseButton = modalPrompt.find('.js-modal-close');

          function removeModal() {
            modal.removeClass('opened');

            backdrop.addClass('closed');

            backdrop.off('click', removeModal);
          }

          function removePrompt() {
            modalPrompt.removeClass('opened');

            modal.find('.prompt-backdrop').addClass('closed');

            backdrop.off('click', removePrompt);

            backdrop.on('click', removeModal);
          }

          $(modalTrigger).on('click', function () {
            modal.addClass('opened');

            backdrop.removeClass('closed');

            if (modalPrompt.length > 0) {
              modalPrompt.addClass('opened');

              backdrop.on('click', removePrompt);
            } else {
              backdrop.on('click', removeModal);
            }
          });

          closeButton.on('click', function (event) {
            event.stopPropagation();
            removeModal();
          });

          promptCloseButton.on('click', function (event) {
            event.stopPropagation();
            removePrompt();
          });
        });
      }

      modalHandler();
    </script>

    <script>
      // Set timeout to maximum allowed values becauses some calls to platforms can take quite a long time, 30 seconds (the default timeout) is cutting it short. 
      Visualforce.remoting.timeout = 120000;

      var salesforceContext = {
        pageName: 'provisioning',
        currentPageURL: '{!JSENCODE($CurrentPage.URL)}',
        currentUserTraits: JSON.parse('{!JSENCODE(getCurrentUserTraitsJson)}'),
        packageVersion: '{!JSENCODE(getPackageVersion)}',
        namespace: '{!JSENCODE(getCurrentNamespace)}',
        redirect_uri: "{!getRedirectUrl}",
        platformUri: "{!getPlatformUri}",
        defaultOrganizationName: "{!$Organization.Name}",
        refreshTokenUrl: "{!getSalesforceRefreshTokenGuidUrl}",
        redirect_to: "{!$Page.GettingStarted}",
        oAuthUri: "{!getOAuthUri}",
        PlatformVersion: "{!PlatformVersion}",
        canCreateOrg: {!canCreateOrg      
},
        regions: {!getRegions},

      toggleBetweenPlatforms: function toggleBetweenPlatforms(callback) {
        Visualforce.remoting.Manager.invokeAction(
          '{!$RemoteAction.ProvisioningController.toggleBetweenPlatforms}',
          callback
        );
      },

      changeRegion: function changeRegion(regionName, regionEndpoint, callback) {
        Visualforce.remoting.Manager.invokeAction(
          '{!$RemoteAction.ProvisioningController.changeRegion}',
          regionName,
          regionEndpoint,
          callback
        );
      },

      linkOrganization: function linkOrganization(code, callback) {
        Visualforce.remoting.Manager.invokeAction(
          '{!$RemoteAction.ProvisioningController.linkToOrganization}',
          code,
          callback
        );
      },
      updateIndexlessHandshake: function updateIndexlessHandshake(callback) {
        Visualforce.remoting.Manager.invokeAction(
          '{!$RemoteAction.ProvisioningController.updateIndexlessHandshake}',
          callback
        );
      },
      createOrganization: function createOrganization(organizationName, organizationTemplate, createStandard, createKnowledge, refreshGuid, callback) {
        Visualforce.remoting.Manager.invokeAction(
          '{!$RemoteAction.ProvisioningController.createOrganization}',
          organizationName,
          organizationTemplate,
          createStandard,
          createKnowledge,
          refreshGuid,
          callback
        );
      }
        }
      var telemetry = new Coveo.ProvisioningTelemetry(salesforceContext);
      window.setupPanel = new Coveo.ProvisioningPanel(document.getElementById("content"), salesforceContext, telemetry);
    </script>
  </c:AdminCheck>
</apex:page>