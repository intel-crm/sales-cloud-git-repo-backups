<apex:page standardController="Opportunity" extensions="Core_OppApproveChecklistCont" lightningStylesheets="true" showHeader="true"> 
<apex:includeLightning />
  <style>
  tr.spaceUnder>td {
    padding-bottom: 1em;
  }
  .pbHeader{
    width: 134%;
  }
  .slds-scope table {
  width:70%;
  margin-left:15%;
  }
  .pbTitle{
  font-size:14px;
  }
</style>
<script type="text/javascript">
            
function closewindow(){
       self.close();
}
</script>
<apex:slds />
<apex:form id="theForm" >          
            <apex:outputPanel style="float:left">  
               <apex:image value="{!$Resource.Core_SearchIcon}" width="50px;"/>      
              
                <apex:commandLink target="_self"  action="{!cancel}" value="{!opportunity.Name}" style="font-size:16px;font-weight:bold;text-decoration:underline;"/>  
              </apex:outputPanel>       
<apex:pageBlock title="Design Opportunity Approval Checklist – Recommendation" Rendered="{!Pageblocksectionredender}">

    <html>
    <head>
    </head>

    <body>

    <table width="75%">
        <tr>
            <th><u>Field Name</u></th>
            <th><u>Indicator</u></th>
            <th><u>Field Description</u></th>
        </tr>
        <br/>
        <tr class="spaceUnder" >
        <td width="10%"><br/><b>BU Short Name</b></td>
        <td ><br/>
            <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!NOT(BUShortName)}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!BUShortName}" style="margin-top:-2px; margin-left: 12px;"/>          
        </td>
        <td  width="660px"><br/>Please check if there is a BU on the Product Line Item assigned for commissions. The system usually supplements the missing BU within 24 hours. Should that not happen, submit an Ask a Question. <b>There is no submission for approval possible when the BU Short Name is missing.</b>
        </td>
        </tr>

        <tr class="spaceUnder">
        <td width="10%"><b>MINDS</b></td>
        <td >    
            <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!NOT(MAGFlag)}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!MAGFlag}" style="margin-top:-2px; margin-left: 12px;"/>       
        </td>
        <td width="660px" >Compliance Status does NOT imply or confer government authorization for any transaction. Intel parties must work within defined <a href="https://salescrm.intel.com/training-and-help/opportunity-management/minds-opp-handling/#guardrails" target="_blank">guardrails.</a> <a href="https://www.intel.com/content/www/us/en/distributor/ddr-training/mag.html " target="_blank">Non-Intel parties</a> are responsible for compliance with any applicable trade regulations.<b> There is no submission for opportunity possible with a red compliance indicator.</b></td>
        </tr>

        <tr class="spaceUnder">
        <td width="14%"><b>Write In Products</b></td>
        <td> 
            <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!NOT(WriteInProducts)}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!WriteInProducts}" style="margin-top:-2px; margin-left: 12px;"/>
        </td>
        <td width="660px" >Please insert the correct Intel product from the product list before submitting for approval. If the product you are looking for is not found in the pick-list, submit an Ask a Question. <b>There is no submission for approval possible with a write-in product.</b></td>
        </tr>

        <tr class="spaceUnder">
        <td width="16%"><b>Proof of Performance</b></td>
        <td>
            <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!NOT(Note_Attachmentsize) && Opportunity.Core_Commissionable__c == 'Yes'}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Yellow}" width="20" height="18"  rendered="{!NOT(Note_Attachmentsize) && Opportunity.Core_Commissionable__c == 'No'}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!Note_Attachmentsize}" style="margin-top:-2px; margin-left: 12px;"/>      
        </td>
        <td width="660px" >Please attach a note or document labeled "Proof or Performance" or "POP" prior to submit for approval, that meets the requirements as detailed <a href="https://goto/POPTraining" target="_blank">here</a>.</td>

        </tr>
        <tr class="spaceUnder">
            <td width="16%"><br/><br/><b>Competitive/Architecture Conversion </b></td>
        <td> <br/><br/>
            <apex:image value="{!$Resource.Checklist_Yellow}" width="20" height="18"  rendered="{!Opportunity.Core_Competitive_Architecture__c== null || Opportunity.Core_Competitive_Architecture__c == '' }" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!Opportunity.Core_Competitive_Architecture__c != null || Opportunity.Core_Competitive_Architecture__c != ''}" style="margin-top:-2px; margin-left: 12px;"/>     
        </td>
        <td width="660px" > <br/><br/> Please enter the competitor’s name and select the conversion box if your opportunity is competing against another supplier, and if it is converting from another architecture to IA.</td>
        </tr>

        <tr class="spaceUnder">
        <td width="14%"><b>Opportunity Description </b></td>
        <td> 
            <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!Opportunity.Description == null || Opportunity.Description == ''}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!Opportunity.Description != null || Opportunity.Description != ''}" style="margin-top:-2px; margin-left: 12px;"/>
        </td>
        <td width="660px" > Please ensure that you provide a brief description of the opportunity (what it is and what it is used for).</td>
        </tr>

        <tr class="spaceUnder">
        <td width="14%"><b>Status Update</b></td>
        <td> 
            <apex:image value="{!$Resource.Checklist_Yellow}" width="20" height="18"  rendered="{!Opportunity.Core_Status_Update__c == null || Opportunity.Core_Status_Update__c == ''}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!Opportunity.Core_Status_Update__c != null || Opportunity.Core_Status_Update__c != ''}" style="margin-top:-2px; margin-left: 12px;"/>  
        </td>
        <td width="660px" >Please add the current date and a brief overview of the current status of the opportunity before you submit it for approval. This will help facilitate the approval procedure. </td>
        </tr>

        <tr class="spaceUnder">
        <td width="14%"><b> Descriptive Features </b></td>
        <td> 
            <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!Not(DescriptiveFeature)}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!DescriptiveFeature}" style="margin-top:-2px; margin-left: 12px;"/>  
        </td>
        <td width="660px" >Please enter the required descriptive features (for ISG, choose Intel platform value ISG for required fields). </td>
        </tr>

        <tr class="spaceUnder">
        <td width="14%"><b>First Customer Ship Date </b></td>
        <td> 
            <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!NOT(firstCustomerShipDate)}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!firstCustomerShipDate}" style="margin-top:-2px; margin-left: 12px;"/>            
        </td>
        <td width="660px" > Please check that the date is not in the past and reflects the customer’s planned production schedule. </td>
        </tr>

        <tr class="spaceUnder">
        <td width="14%"><b>Production End Date  </b></td>
        <td>
            <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!NOT(ProductionDate)}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!ProductionDate}" style="margin-top:-2px; margin-left: 12px;"/>         
        </td>
        <td width="660px" > Please enter the estimated Production End Date to the best of your knowledge provided by your customer. The date should always be in the future and after the First Customer Ship Date. </td>
        </tr>

        <tr class="spaceUnder">
        <td width="14%"><b>Partner </b></td>
        <td>
           <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!NOT(Opptypartnersize)}" style="margin-top:-2px; margin-left: 12px;"/>
           <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!Opptypartnersize}" style="margin-top:-2px; margin-left: 12px;"/>     
        </td>
        <td width="660px" > Please enter the partners if you collaborate with 3rd parties on your opportunity.</td>
        </tr>

        <tr class="spaceUnder">
        <td width="14%"><b> Manufacturing Region </b></td>
        <td>
          <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  rendered="{!Opportunity.Core_Manufacturing_Geo__c == null || Opportunity.Core_Manufacturing_Geo__c == ''}" style="margin-top:-2px; margin-left: 12px;"/>
          <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!Opportunity.Core_Manufacturing_Geo__c != null || Opportunity.Core_Manufacturing_Geo__c != ''}"  style="margin-top:-2px; margin-left: 12px;"/>    
        </td>
        <td width="660px" > Please specify in which region the manufacturing/billings will occur.</td>
        </tr>
        
        <tr class="spaceUnder">
        <td width="14%"><b> Volume </b></td>
        <td>  
           <apex:image value="{!$Resource.Checklist_Yellow}" width="20" height="18"  rendered="{!Opportunity.Core_Volume__c == null}" style="margin-top:-2px; margin-left: 12px;"/>
           <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  rendered="{!Opportunity.Core_Volume__c != null}" style="margin-top:-2px; margin-left: 12px;"/>    
        </td>
        <td width="660px" > Please enter the number of sets / customer products expected to be sold, especially when there are multiple components in one product application. </td>
        </tr>
        
        <tr class="spaceUnder">
          <td width="14%"><b> Exclude from KPIs </b></td>
          <td>
           <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18" rendered="{!NOT(ExludeKPIflag)}" style="margin-top:-2px; margin-left: 12px;"/>
            <apex:image value="{!$Resource.Checklist_Yellow}" width="20" height="18"  rendered="{!ExludeKPIflag}"  style="margin-top:-2px; margin-left: 12px;"/>    
          </td>
          <td width="660px" >If the indicator is yellow, you have checked the ‘Exclude from KPI’ box and therefore this opportunity will not receive KPI credit </td>
        </tr>
        
        
        <!-- Added -->
        <tr class="spaceUnder">
            <td width="16%"><br/><br/><b><u>LEGEND:</u></b></td>
            <td> <br/><br/>
                <apex:image value="{!$Resource.Checklist_Red}" width="20" height="18"  style="margin-top:-2px; margin-left: 12px;"/>
            </td>
            <td width="660px" ><br/><br/><b> Required or important per description.</b> </td>
        </tr> 
        
        <tr class="spaceUnder">
            <td width="16%"><b> </b></td>
            <td> 
                <apex:image value="{!$Resource.Checklist_Yellow}" width="20" height="18"  style="margin-top:-2px; margin-left: 12px;"/>
            </td>
            <td width="660px" ><b> Recommended to have this information.</b> </td>
        </tr> 
        
        <tr class="spaceUnder">
            <td width="16%"><b> </b></td>
            <td> 
                <apex:image value="{!$Resource.Checklist_Green}" width="20" height="18"  style="margin-top:-2px; margin-left: 12px;"/>
            </td>
            <td width="660px" ><b> Data is complete. </b></td>
        </tr> 
        
    </table>
    </body>
    </html>
    
    <apex:pageBlockButtons location="bottom">
      <apex:commandButton value="Close"  action="{!cancel}" onclick="closewindow();return false" style="margin-left:-13%;" rendered="{!$User.UIThemeDisplayed=='Theme3'}"/>
      <apex:commandButton value="Back to Opportunity"  action="{!cancel}" style="margin-left:-55%;" rendered="{!$User.UIThemeDisplayed !='Theme3'}"/>
    </apex:pageBlockButtons>
    
</apex:pageBlock>

