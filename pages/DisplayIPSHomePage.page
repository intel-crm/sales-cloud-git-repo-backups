<apex:page standardController="StoringHTMLText__c"  extensions="ImageController" recordSetVar="CSObj">
 <apex:form >
    <apex:pageBlock >
        <apex:pageBlockTable value="{!CSObj}" var="a"> 
        <apex:column value="{!a.Text__c}"/>
        </apex:pageBlockTable> 
        <apex:image url="{!imageURL}" width="1500" height="300"/>
       
    </apex:pageBlock> 
 </apex:form>
  
</apex:page>