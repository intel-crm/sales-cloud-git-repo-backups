                    <apex:outputtext rendered="{!total_size>list_size && searched = false }"> Showing Page # {!pageNumber} of {!totalPages}</apex:outputtext>    
                    </div>                  
              </apex:outputpanel>
       </apex:pageBlockSection>
       
     </apex:pageblock>
   </apex:actionRegion> 
  </apex:form>
</apex:page>