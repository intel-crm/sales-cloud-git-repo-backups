function ToggleMoreOption(FlagAdvanceSearch)
     {
         $("#tblAdvanceSearch").toggle(FlagAdvanceSearch);   
         console.log($("#tblAdvanceSearch"));
         
         if(FlagAdvanceSearch)     {
        
         $(this).html('Collapse');
         FlagAdvanceSearch = false;
         } 
         else
         {
         $(this).html('Expand');
         FlagAdvanceSearch = true;
         }
     }   
    function createTable(TableID,cols,result,divId)
    {
               $("#"+TableID).show();
               $("#"+divId).show();
               
               $("#"+TableID).DataTable({
               "bDestroy": true,
               "responsive": true,
               "aaData": result,
               "bFilter" :false,
                "aoColumns": cols
               
               });
                $("#spanPleaseWait").hide();
    }

