<apex:page controller="Core_AccountPlan_PDFController" showHeader="true">
    <apex:stylesheet value="{!$Resource.Core_AccountPlanPDFStyle}" />
    <script src="{!URLFOR($Resource.chartJs)}"></script>
    <canvas id="chartCanvas" width="600" height="300"></canvas>
    
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('chartCanvas').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: {!labels},
                    datasets: [{
                        label: 'Amount by Year',
                        data: {!data},
                        backgroundColor: 'rgba(153, 102, 255, 0.5)'
                    }]
                },
                options: {
                    responsive: false,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
            
            setTimeout(function () {
                const imgData = chart.toBase64Image();
                window.location.href = '/apex/ChartPdfPage?img=' + encodeURIComponent(imgData);
            }, 1500);
        });
    </script>
    <!--{!labels}
{!data}
<apex:image url="{!dynamicUrl}"/>-->
    <p>{!record.Name}</p>
    <div class="row">
        <div class="cell">
            <table class="custom-table">
                <tr>
                    <th colspan="2" style="text-align: center;background-color:#3a71c9;color:white">Customer Overview</th>
                </tr>
            </table>
            
            <table class="custom-table2"> 
                <tr class="bgcolor1">
                    <td ><strong>Market Cap</strong></td>
                    <td>
                        <apex:outputText rendered="{!NOT(ISBLANK(record.Core_Market_Cap__c))}" value="${!record.Core_Market_Cap__c}" />
                    </td>
                </tr>
                <tr class="bgcolor2">
                    <td ><strong>Account Revenue</strong></td>
                    <td>
                        <apex:outputText rendered="{!NOT(ISBLANK(record.Core_Account_Revenue__c))}" value="${!record.Core_Account_Revenue__c}" />
                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td ><strong>Net Income</strong></td>
                    <td>
                        <apex:outputText rendered="{!NOT(ISBLANK(record.Core_Net_Income__c))}" value="${!record.Core_Net_Income__c}" />
                    </td>
                </tr>
                <tr class="bgcolor2"> 
                    <td ><strong>Cash and Investments</strong></td>
                    <td>
                        <apex:outputText rendered="{!NOT(ISBLANK(record.Core_Cash_Investments__c))}" value="${!record.Core_Cash_Investments__c}" />
                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td ><strong>Debt long term</strong></td>
                    <td>
                        <apex:outputText rendered="{!NOT(ISBLANK(record.Core_Debt_long_term__c))}" value="${!record.Core_Debt_long_term__c}" />
                    </td>
                </tr>
                <tr class="bgcolor2">
                    <td ><strong>Price/Earnings</strong></td>
                    <td>
                        <apex:outputText rendered="{!NOT(ISBLANK(record.Core_Price_Earnings__c))}" value="${!record.Core_Price_Earnings__c}" />
                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td ><strong>Gross Margin</strong></td>
                    <td>
                        <apex:outputText rendered="{!NOT(ISBLANK(record.Core_Gross_Margin__c))}" value="${!record.Core_Gross_Margin__c}" />
                    </td>
                </tr>
                <tr class="bgcolor2">
                    <td ><strong>Employees</strong></td>
                    <td>{!record.Core_Employees__c}</td>
                </tr>
                <tr class="bgcolor1">
                    <td ><strong>Financial Year</strong></td>
                    <td>{!record.CRM_Financial_Year__c}</td>
                </tr>
                <tr class="bgcolor2">
                    <td ><strong>Account Revenue Comments</strong></td>
                    <td>{!record.Core_Account_Revenue_Comments__c}</td>
                </tr>
                
            </table>
            
        </div>
        <div class="cell">
            <table class="custom-table">
                <tr>
                    <th colspan="2" style="text-align: center;background-color:#3a71c9;color:white">Account Revenue</th>
                </tr>
                
                
                
            </table >
            <div>
                    <apex:image url="{!imageUrl}" width="600px"/>

                
                    <apex:image url="{!URLENCODE($CurrentPage.parameters.imgData)}" width="600px"/>

                <iframe 
                        src="https://intel--crmdevsls3.sandbox.lightning.force.com/lightning/r/Report/00ODf000000Ylu4MAC/view" 
                        width="100%" 
                        height="800px" 
                        frameborder="0">
                </iframe>
            </div>
            <!--<div>
             <img src="{!URLENCODE($CurrentPage.parameters.img)}" width="400" height="300"/>   
            </div>-->

            <table class="custom-table2">
                <tr>
                    <th>Year</th>
                    <th>BU</th>
                    <th>Amount</th>
                </tr>
                <apex:repeat value="{!intelAccountPlanRevRecords}" var="item">
                    <tr>
                        <td>{!item.CRM_Year__c}</td>
                        <td>{!item.CRM_BU__c}</td>
                        <td>{!item.CRM_Account_Potential_Revenue__c}</td>
                    </tr>
                </apex:repeat>
            </table>
        </div>
        <div class="cell">
            <table class="custom-table">
                <tr>
                    <th colspan="2" style="text-align: center;background-color:#3a71c9;color:white">Hot Buttons</th>
                </tr>                
                
            </table >
            <ul>
                <apex:repeat value="{!hotButtonRecords}" var="item">
                    <li>{!item.CRM_Description__c}</li>
                </apex:repeat>
            </ul>
        </div>  
    </div>
    <div class="row">
        <div class="cell">
            <table class="custom-table">
                <tr>
                    <th colspan="2" style="text-align: center;background-color:#3a71c9;color:white">Relationship Assessment</th>
                </tr>
            </table>
            
            <div>
                <p><strong>Relationship Map Comments:</strong></p>
                <apex:outputText value="{!Relationship_Map_Comments}" escape="false" />
                
            </div>
            
        </div>
        <div class="cell">
            <table class="custom-table">
                <tr>
                    <th colspan="2" style="text-align: center;background-color:#3a71c9;color:white">Transformational Opportunities</th>
                </tr>                
                
            </table >
            <table class="custom-table2">
                <tr>
                    <th>Name</th>
                    <th>Amount</th>
                    <th>Decision Date</th>
                    <th>Stage</th>
                </tr>
                <apex:repeat value="{!oppRecords}" var="item">
                    <tr>
                        <td>{!item.Name}</td>
                        <td>
                            <apex:outputText rendered="{!NOT(ISBLANK(item.Amount))}" value="${!item.Amount}" />
                        </td>
                        <td>
                            <apex:outputText value="{0, date, dd/MM/yyyy}">
                                <apex:param value="{!item.CloseDate}" />
                            </apex:outputText>
                        </td>
                        <td>{!item.StageName}</td>
                    </tr>
                </apex:repeat>
            </table>
            <div>
                <p><strong>Comments:</strong></p>
                <apex:outputText value="{!TransformationalComments}" escape="false" />
                
            </div>
        </div>
        <div class="cell">
            <table class="custom-table">
                <tr>
                    <th colspan="2" style="text-align: center;background-color:#3a71c9;color:white">Customer Objectives and Intel Values</th>
                </tr>                
                
            </table >
            <ul>
                <li>                  
                    <p><strong>Customer Objectives:</strong></p><apex:outputText value="{!record.Core_Customer_Objectives__c}" escape="false" />
                </li>
                <li>
                    <p><strong>Intel Values:</strong></p>
                    <apex:outputText value="{!CRM_Intel_Values}" escape="false" />
                </li>
            </ul>
        </div>  
    </div>
    
</apex:page>