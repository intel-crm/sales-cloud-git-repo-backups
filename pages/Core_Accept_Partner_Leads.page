<apex:page standardController="Lead" recordSetVar="leads" extensions="Core_Accept_Partner_Leads_Ctrl" action="{!acceptPartnerLeads}">
    <apex:slds />
    <apex:includeLightning />

    <script>
    $Lightning.use("c:Core_Accept_Partner_Lead_App", function() {
        $Lightning.createComponent("c:Core_Accept_Partner_Lead",
                                   { 
                                       showMessage		: '{!alertMessage}',
                                       listViewUrl		: '{!retUrl}'
                                   },
                                   "lightning",
                                   function(cmp) {
                                       document.getElementById('loading').style.display = 'none';
                                   });
    });
    </script>
    <div id="loading">
        <div role="status" class="slds-spinner slds-spinner_large slds-spinner_brand">
            <span class="slds-assistive-text">Loading...</span>
            <div class="slds-spinner__dot-a"></div>
            <div class="slds-spinner__dot-b"></div>
        </div>
    </div>
    <div id="lightning" />
</apex:page>