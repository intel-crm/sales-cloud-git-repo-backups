<apex:page controller="Core_OpportunityCreate_SalesAssistCtrl">
    <apex:form >
        <apex:outputPanel rendered="true">
            <script type="text/javascript">
            new function() { redirectForLex('{!JSENCODE(recordTypeId)}', '{!JSENCODE(accId)}', '{!JSENCODE(description)}', '{!isLex}'); };
            function redirectForLex(recType, accountName, descrip, lexAccess) {
                if(lexAccess == 'true'){
                    sforce.one.createRecord('Opportunity', recType , {
                        AccountId : accountName,
                        Description : descrip
                    });
                }
            }
            </script>
        </apex:outputPanel>
    </apex:form>
</apex:page>