<apex:page controller="Core_IPS_ContactLinkController" >
    <apex:sectionHeader title="Contacts" subtitle="Home" />
       <apex:pageBlock title="List of Contacts" >
           <apex:outputPanel layout="block" style="overflow:auto;height:250px" >
               <apex:pageblockSection title="Contact Information" columns="1" >
                   <apex:pageBlockTable value="{!con}" var="contact" >
                            <apex:column value="{!contact.FirstName}"/>
                            <apex:column value="{!contact.LastName}"/>
                            <apex:column value="{!contact.Email}"/>
                    </apex:pageBlockTable>
               </apex:pageblockSection>
           </apex:outputPanel>
        </apex:pageBlock>
</apex:page>