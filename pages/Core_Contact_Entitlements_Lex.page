    function redirectToContact(){
        sforce.one.navigateToSObject("{!JSENCODE(idContact)}","VIEW");
    }
    
    function checkEmployee(name,isSelected,val)
    { 
        
        if(name !='Employee' && name !='Partner Admin' && name !='Partner Admin Delegate' &&val.checked){
            // Logging map object to console
            var entitlementAndBenifits = JSON.parse('{!entBenifitsMap}');
             let lstOfEntitlementForSuppressSoftPopups='{!lstOfEntitlementForSuppressSoftPopups}';
            for (let key in entitlementAndBenifits) {
                if(entitlementAndBenifits.hasOwnProperty(key)) {
                    value = entitlementAndBenifits[key];
                    if(value!='' && key==name && isSelected == 'false' && val.checked && !lstOfEntitlementForSuppressSoftPopups.includes(name)){
                        var ele =document.getElementById("newPopupId");
                        var modalHtml ='<div id="myModal" class="slds-modal slds-fade-in-open"><div class="slds-modal__container"><div class="slds-modal__content slds-p-around_medium benifitsClass"><p style="color:red;font-size:15px;text-align: center;">'+
                            '<b><i> Please De-Select the selected Entitlement if not required</i></b></p>'+
                            '<p>'+name+' Entitlement can only be granted if ACCOUNT/OPID has any one of the following benefit(s)</p></div>'+
                            '<div class="slds-modal__footer">'+
                            '<div class="slds-align_absolute-center"><button class="slds-button slds-button_brand" onclick="callSaveMethod2()">Ok</button></div></div></div></div>'+
                            '<div class="slds-backdrop slds-backdrop_open"></div>';
                        ele.innerHTML +=modalHtml; 
                        for (let val in value) {
                            let list = document.createElement('li');
                            list.innerText=value[val];
                            document.querySelector('.benifitsClass').appendChild(list);
                        }
                    }
                }
            }
        }
        //Employee Removal Popup issue Fix code change added by Sonali ----Start
        if(name == 'Employee' && isSelected == 'true'){
            document.getElementById('myEmpModal').style.display = 'block';                        
        }
        
    }
    
    function checkACR(name, acrCount, acrPA, acrPAD, val){
    	if(((name == 'Employee' && acrCount == 0)||(name == 'Partner Admin' && acrPA == 0)||(name == 'Partner Admin Delegate' && acrPAD == 0)) && val.checked){
        	document.getElementById('acrId').style.display = 'block';
        }
        /*  if(name == 'Partner Admin' && acrPA == 0 && val.checked){
        	document.getElementById('acrId').style.display = 'block';
        }
        if(name == 'Partner Admin Delegate' && acrPAD == 0 && val.checked){
        	document.getElementById('acrId').style.display = 'block';
        }*/
    }
    //Shashwat changes END-------------------
    /*----------popup for US751531--changes made by sonali -------------*/
    function showPop(){
        callOnSave();
    }
    
    //popup for US751531---added by sonali
    function callSaveMethod(){
        
          document.getElementById('myModal').style.display = 'none';
        document.getElementById('myEmpModal').style.display = 'none';//Sonali -----employee removal popup issue 
        callOnSave();
    }
    function callSaveMethod2(){
        document.getElementById('acrId').style.display = 'none';
        var modalContainer = document.getElementById('newPopupId');
        modalContainer.innerHTML = '';
    }
    //Shashwat Changes End
    //popup for US751531---added by sonali
    var entitlement = [];
    function checkCustomer(subcategory,name,isSelected){
        if(subcategory == 'Intel Quote Request' && isSelected == 'false'){
            if(!entitlement.includes(name)){
                entitlement.push(name);
            }else{
                entitlement.splice(entitlement.indexOf(name),1);
            }
        }
    }
    
    //popup for US751531---added by sonali
    function closeModal() {
        document.getElementById('confirmModal').style.display = 'none';
        document.getElementById('myEmpModal').style.display = 'none';////Sonali -----employee removal popup issue
        callApexMethod();
    }
    
     //Shashwat Changes Start-------
     function closeModal2() {
         
         location.reload(true);
     }
     //Shashwat Changes End------- 
    //confirmation popup for US751531---added by sonali
    function openConfirmPopup() { 
        document.getElementById('myModal').style.display = 'none';
        document.getElementById('confirmModal').style.display = 'block';        
    }
    </script>
