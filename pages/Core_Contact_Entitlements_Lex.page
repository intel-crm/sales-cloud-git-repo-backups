    $(document).ready(function() {
        var allData = document.getElementsByClassName('helpButton')
        for (var i = 0; i < allData.length; i++) {
            var mapHelpTextData = sfdcPage.inlineHelpMap;
            var helpTextId = document.getElementsByClassName('helpButton')[i].id;
            var helpText = helpTextId.substring(0, helpTextId.length - 6);
            // console.log(helptext + "::" + helptextId + "::" + mapHelpTextData[helptext]);
            if (mapHelpTextData[helpText] == '') {
                var helpTextObj = document.getElementById(helpTextId);
                var helpTextObjList = helpTextObj.childNodes[1].remove();
            }
        }
     
        var searchListElem = document.getElementsByClassName('apexpageBlockOuterTableSearch')
        var collapseAllSections = function(){
            
            var elemsToToggle = $(this).parent().parent().children('.apexpageBlockTable');
            $(this).find('.headerPlusMinusIcon').html('+');
            
            if($(elemsToToggle).is(":visible")){
                $(elemsToToggle).hide();
            }
        };
        var expandAllSections = function(){            
            var elemsToToggle = $(this).parent().parent().children('.apexpageBlockTable');
            $(this).find('.headerPlusMinusIcon').html('-');
            $(elemsToToggle).show();
        };
        
         if($(searchListElem).is(":visible")){
            $('div.headerIconColumn').each(expandAllSections);
             document.getElementById('collapsebutton').innerHTML = 'Collapse All';
        } else {
       	    $('div.headerIconColumn').each(collapseAllSections);
            document.getElementById('collapsebutton').innerHTML = 'Expand All';
        }
        
        $( "#collapsebutton" ).click(function() {
            var elemsToToggle = $(this).parent().parent().children('.apexpageBlockTable');
            var isExpand = document.getElementById('collapsebutton').innerHTML =='Expand All';
            if(isExpand){
                 $('div.headerIconColumn').each(expandAllSections);
                $("html, body").animate({ scrollTop: $(this).offset().top }, 500);
                document.getElementById('collapsebutton').innerHTML = 'Collapse All';
            } else {
           		 $('div.headerIconColumn').each(collapseAllSections);
                $("html, body").animate({ scrollTop: $(this).offset().top }, 500);
                document.getElementById('collapsebutton').innerHTML = 'Expand All';
            }
            
        });
        $('div.headerIconColumn').click(function(){
            var elemsToToggle = $(this).parent().parent().children('.apexpageBlockTable');
            
            if($(elemsToToggle).is(":visible")){//Hide the entitlement section
                $(elemsToToggle).hide();
                $(this).find('.headerPlusMinusIcon').html('+');
            }else{//Show the entitlement section
                $('div.headerIconColumn').each(collapseAllSections);
                $(elemsToToggle).show();
                $(this).find('.headerPlusMinusIcon').html('-');
                $("html, body").animate({ scrollTop: $(this).offset().top }, 500);
            }
        });
        document.getElementById('spinner').className += ' slds-hide';
    });
    
    /*Stop spinner after the page load---Start---Part of GEC functionality*/   // om added spinner
    $( window ).load(function() {
    	document.getElementById('spinner').className += ' slds-hide';
    });
    /*Stop spinner after the page load---End*/
    
