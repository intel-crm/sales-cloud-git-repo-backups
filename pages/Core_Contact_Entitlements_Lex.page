    <apex:includeScript value="{!$Resource.Core_Jquery}" />
    <script>
    $(document).ready(function() {
        var allData = document.getElementsByClassName('helpButton')
        for (var i = 0; i < allData.length; i++) {
            var mapHelpTextData = sfdcPage.inlineHelpMap;
            var helpTextId = document.getElementsByClassName('helpButton')[i].id;
            var helpText = helpTextId.substring(0, helpTextId.length - 6);
            // console.log(helptext + "::" + helptextId + "::" + mapHelpTextData[helptext]);
            if (mapHelpTextData[helpText] == '') {
                var helpTextObj = document.getElementById(helpTextId);
                var helpTextObjList = helpTextObj.childNodes[1].remove();
            }
        }
    });
    
    var isClicked = true;
    function submitPage() {
        //Call the action function
        if(isClicked == true){
            isClicked  = false;
            return true;
        }else{
            return false;
        }
    }
    // Disabling Price Masking Checkbox
    function DisableCheckBox(id){
        //jQuery('#'+id).prop('readonly', true);
        document.getElementById(id).disabled ='false';
        return false;
    }
    
    function EnableCheckBox(id){
        document.getElementById(id).disabled ='true';
        return false;
    }
    
    function showHelpText(data, id){
        $Lightning.use("c:Core_AppForHelpText", function() {
            $Lightning.createComponent("lightning:helptext",
                                       { content : data },
                                       id,
                                       function(cmp) {
                                           // do some stuff
                                       });
        });
    }
    
    function redirectToContact(){
        sforce.one.navigateToSObject("{!idContact}","VIEW");
    }
    </script>
    
