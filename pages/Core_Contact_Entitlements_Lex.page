    <script>
    var flagcheck = {!blnIsValid};
    console.log("flagCheck-->"+flagcheck)
    if(flagcheck)
     $Lightning.use("c:Core_GrantAccess_Banner", function() {
        console.log('in lwc00');
         
          $Lightning.createComponent("c:core_GrantAccessBanner",
            {
                recordId : '{!JSENCODE($CurrentPage.parameters.id)}'
            },
              "bannerCompId",
              function(cmp) {
                  
                console.log("lwc was called");
              }
          );
