<apex:page standardController="Opportunity"  > 
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <apex:form >
        <apex:outputPanel rendered="{!Opportunity.Core_Compliance_Status__c=='Approved with Guardrails'}">
            <apex:outputPanel rendered="{!$User.UITheme == 'Theme3'}">
                <div  style="font-weight:bold;color:orange;">By working this opportunity, you agree to comply with the regulatory requirements described at 
                    <a href="https://salescrm.intel.com/training-and-help/opportunity-management/minds-opp-handling/#guardrails" target="_blank" style="font-weight:bold;color:orange;">goto/mindssalesguardrails.</a>
                    Non-Intel owners refer to this <a href="https://www.intel.com/content/www/us/en/distributor/ddr-training/mag.html" target="_blank" style="font-weight:bold;color:orange;">site.</a>                
                    </div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!$User.UITheme != 'Theme3'}">
                 <div  style="font-weight:bold;color:orange;position:fixed;top:0;bottom:0;left:0;right:0;">By working this opportunity, you agree to comply with the regulatory requirements described at  
                     <a href="https://salescrm.intel.com/training-and-help/opportunity-management/minds-opp-handling/#guardrails" target="_blank" style="font-weight:bold;color:orange;">goto/mindssalesguardrails.</a>
                    Non-Intel owners refer to this <a href="https://www.intel.com/content/www/us/en/distributor/ddr-training/mag.html" target="_blank" style="font-weight:bold;color:orange;">site.</a>                
                    </div>
            </apex:outputPanel>
        </apex:outputPanel>
    </apex:form>
</apex:page>