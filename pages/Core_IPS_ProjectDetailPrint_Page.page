<apex:page Controller="Core_IPS_ProjectDetailPrint_Ctrl" showHeader="false" sidebar="false" applyHtmlTag="false" applyBodyTag="false" renderAs="pdf">
    <head style="padding-right: 200px">    
        <meta http-equiv="Content-Type" content="text/html;charset=UTF-8" />    
        <style type="text/css" media="print">
            html{
            font-family: Arial, Helvetica, sans-serif;
            }
            @page {
            size: A6 landscape;
            }
            .toolbar{
            padding-right: 200px;
            }
            body{
            width:100%;
            height:100%;
            margin:0;
            padding:0;
            /*line-height:1rem;*/
            font-family: Arial, Helvetica, sans-serif;
            font-size:13px;
            padding-right: 200px
            }
            td span div{
            white-space: pre-line !important;
            padding-right: 20px;
            }
            
        </style>    
    </head>
    <div style="font-family: Arial Unicode MS; font-size:10px;  padding-right: 20px"> 
        
        <apex:form >    
            <apex:pageBlock title="Project Detials">
                <apex:pageBlockSection >
                    <table style="table-layout: fixed; width: 60%;">
                        <tr>
                            <td style="width: 1px;"><apex:outputfield value="{!projRecord.Name}"/></td>            
                        </tr>
                        <tr>
                            <td><apex:outputfield value="{!projRecord.Core_Project_Description__c}"/></td>
                        </tr>
                        <tr>
                            <td><apex:outputfield value="{!projRecord.Core_MPNDA__c}"/></td>
                        </tr>
                        <tr>
                            
                            <td><apex:outputfield value="{!projRecord.Core_IPS_Project_ID__c}"/></td>
                            
                        </tr>
                        <tr>
                            <td><apex:outputfield value="{!projRecord.Core_Status__c}"/></td>
                        </tr>
                        <tr>
                            <td><apex:outputfield value="{!projRecord.Core_IPS_EnableMemberasInterestedParties__c}"/></td>
                        </tr>
                    </table>
                    
                </apex:pageBlockSection>
            </apex:pageBlock>
            
            <apex:pageBlock title="Cases">
                <apex:dataTable value="{!AllCaseRecordsUnderProject}"  var="cs" style="table-layout: fixed;">
                    <apex:column style="overflow: hidden; text-overflow: ellipsis; padding-right: 20px; padding-top: 10px; padding-bottom: 20px" value="{!cs.CaseNumber}" headerValue="Case Number"/>
                     <apex:column style="overflow: hidden; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.Status}" headerValue="Status"/>
                    <apex:column style="overflow: hidden; width: 280px; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.Subject}" headerValue="Subject"/>
                    <apex:column style="overflow: hidden; width:100px; text-overflow: ellipsis; padding-right: 20px; padding-left: 30px; padding-bottom: 20px" value="{!cs.CreatedDate}" headerValue="Created Date"/>
                    <apex:column style="overflow: hidden; width:100px; text-overflow: ellipsis; padding-right: 20px; padding-left: 30px; padding-bottom: 20px" value="{!cs.LastModifiedDate}" headerValue="Last Modified"/>
                </apex:dataTable>
             </apex:pageBlock>
             <apex:pageBlock title="Intel® Products">
                <apex:dataTable value="{!ChildIpsProductsToProject}" var="cs" style="table-layout: fixed;">
                    <apex:column style="overflow: hidden; width:120px; text-overflow: ellipsis; padding-right: 20px; padding-top: 10px; padding-bottom: 20px" value="{!cs.Core_Supported_Product_Name__c}" headerValue="Intel® Product Name"/> 
                     <apex:column style="overflow: hidden; width:120px; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.Core_IPS_Product_Status__c}" headerValue="Status"/>
                    <apex:column style="overflow: hidden; width: 120px; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.Product_Application__c}" headerValue="Product Focus Area"/>
                </apex:dataTable>
            </apex:pageBlock>
            
             <apex:pageBlock title="Premier Support Project Members">
                <apex:dataTable value="{!ExistingProjectMembers}" var="cs" style="table-layout: fixed;">
                    <apex:column style="overflow: hidden; width:100px; text-overflow: ellipsis; padding-right: 20px; padding-top: 10px; padding-bottom: 20px" value="{!cs.Name}" headerValue="Premier support AutoNumber"/>
                     <apex:column style="overflow: hidden; width:100px; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.Core_IPS_ContactName__c}" headerValue="Contact Name"/>
                     <apex:column style="overflow: hidden; width:100px; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.Core_IPS_Contact__r.Account.Name}" headerValue="Status"/>
                    <apex:column style="overflow: hidden; width: 100px; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.Core_Status__c}" headerValue="Product Focus Area"/>
                     <apex:column style="overflow: hidden; width:100px; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.CreatedBy.Contact.Name}" headerValue="Created By"/>
                     <apex:column style="overflow: hidden; width:100px; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.CreatedDate}" headerValue="Created Date"/>
                     <apex:column style="overflow: hidden; width:100px; text-overflow: ellipsis; padding-right: 20px; padding-bottom: 20px" value="{!cs.Add_as_Case_Interested_Party__c}" headerValue="Add as Case Interested Party"/>
                </apex:dataTable>
            </apex:pageBlock>

        </apex:form>
    </div>   
</apex:page>