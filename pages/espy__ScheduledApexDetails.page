                <div class="tour1 tour4"></div>
                <!--<c:BM_sidepane />-->
                <c:BM_header />
                <div class="page-content inset" data-spy="scroll" >
                    <div class="" style="margin-left:2px;margin-right:0px;">
                        <div class="row ">
                            <div class="col-md-3">
                                <div class="panel panel-default tour2">
                                    <div class="panel-heading  panel-header" >
                                        <h3 class="panel-title">Scheduled Batches</h3>
                                    </div>
                                    <div class="panel-body text-container" id="scheduled-batches" >
                                        <apex:repeat value="{!ScheduledBatchJobList}" var="ex" rendered="true">
                                            <div class='issue issue_e1' id="{!ex.name}"  onclick="navigateTomethod('{!ex.name}');">
                                                <span style="padding-left:6px"> {!ex.name} </span>
                                            </div>
                                        </apex:repeat>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-9">
                               <apex:outputPanel id="details" rendered="true">
                                    <div class="row">
                                        <script>console.log('{!TotalJobItemss}'+'{!processedd}');</script>
                                        <div class="col-md-3 reduce-pad">
                                            <div class="panel info-bg shadow-header text-right">
                                                <div class="panel-body">
                                                    <div class="huge card-text-white">{! IF(TotalJobItemss != null, TotalJobItemss,0)}</div>
                                                    <div class="card-text-white">TotalJobItems</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 reduce-pad">
                                            <div class="panel  success-bg shadow-header text-right">
                                                <div class="panel-body">
                                                    <div class="huge card-text-white">{! IF(Statuss!= null, Statuss,0)}</div>
                                                    <div class="card-text-white">Status</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 reduce-pad">
                                            <div class="panel danger-bg shadow-header text-right">
                                                <div class="panel-body">
                                                    <div class="huge card-text-white">{! IF(failuree != null, failuree,0)}</div>
                                                    <div class="card-text-white">Failure</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 reduce-pad">
                                            <div class="panel  warning-bg shadow-header text-right">
                                                <div class="panel-body" style="line-height: 24px;">
                                                    <div class="huge1 card-text-white">{! IF(NextFireTimee != null, LEFT(TEXT(NextFireTimee),19),'--NA')}</div>
                                                    <div class="card-text-white">Next Fire Time</div>
                                                </div>
                                            </div>
                                        </div>
                                     </div>
                                    <div class="row">
                                        <div class="col-md-12" style="padding-right: 12px;padding-left: 12px;">
                                            <div class="panel panel-default tour3">
                                                <div class="panel-heading panel-header" >
                                                    <h3 class='panel-title'>
                                                        <span class="badge info-bg"> Scheduler </span>{!schbatchclassname} &nbsp; &nbsp;
                                                        <span class="badge default-bg"> Batch Class </span> {!batchclassname} &nbsp; &nbsp;
                                                        <apex:commandButton action="{!Reschedule}"  value="Re-scheduler"  styleClass="btn" oncomplete="RescheduleClass('{!schbatchclassname}','{!CronExpressn}');" rendered="{! IF(batchCountOnNotesJSON == null, true,false)}"/>
                                                        <apex:commandButton action="{!Deletescheduler}" value="De-Scheduler" styleClass="btn" oncomplete="DescheduleClass('{!schbatchclassname}','{!CronExpressn}');" rendered="{! IF(batchCountOnNotesJSON == null, false,true)}"/>
                                        
                                                    </h3>
                                                </div>
                                                <div class="panel-body">
                                                    <apex:outputPanel rendered="{! IF(batchCountOnNotesJSON !=null, true,false)}">
