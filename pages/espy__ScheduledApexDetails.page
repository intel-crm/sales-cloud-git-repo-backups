    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <body >
        <apex:form id="theForm">
         <script>
             function DescheduleClass(clsname,cron) {
                var answer = confirm("Do You Want to De-Schedule Class :"+ clsname)
                 if (answer){
                    document.getElementById('{!$Component.theForm}').elements['{!$Component.hiddenField2}'].value = clsname;
                    document.getElementById('{!$Component.theForm}').elements['{!$Component.hiddenField3}'].value = cron;
                    deschedulecls();
                  }
              }
          </script>
          <script>
              function RescheduleClass(clsname,cron) {
                     var answer = confirm("Do You Want to Re-Schedule Class : "+ clsname)
                     if (answer){
                         document.getElementById('{!$Component.theForm}').elements['{!$Component.hiddenField}'].value = clsname;
                         document.getElementById('{!$Component.theForm}').elements['{!$Component.hiddenField1}'].value = cron;
                         reschedulecls();
                     }
                }
          </script>
           <script>
                function showpopup(showerr,ErrorMsg){
                    if(showerr){
                        if(ErrorMsg!='')
                           alert(ErrorMsg);
                        else 
                           alert('Process Completed');
                           window.location.reload();
                    }
                }
          </script>
         
            <apex:inputHidden value="{!inputValue}" id="hiddenField"/>
            <apex:inputHidden value="{!inputValue2}" id="hiddenField1"/>
            <apex:actionFunction action="{!rescheduleclass}" name="reschedulecls" oncomplete="showpopup('{!showerr}','{!ErrorMsg}');"/>
            <apex:inputHidden value="{!inputValue3}" id="hiddenField2"/>
            <apex:inputHidden value="{!inputValue4}" id="hiddenField3"/>
            <apex:actionFunction action="{!descheduleclass}" name="deschedulecls" oncomplete="showpopup('{!showerr}','{!ErrorMsg}');"/>
