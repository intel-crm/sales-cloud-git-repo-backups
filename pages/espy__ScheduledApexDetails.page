    <apex:outputPanel id="updateBatchLogMapScript">
        <script>
        function drawChart4batchLogMap(){        
            var batchLogMap = '{!batchCountOnNotesJSON}';
            var batchLogMap_jsonObj= JSON.parse(batchLogMap);
            //console.log('batchLogMap : '+batchLogMap + '---json--')
            var batchLogMap_labels = []; // ["Red", "Blue", "Yellow", "Green", "Purple", "Orange"];
            var batchLogMap_data =  []; //[12, 19, 3, 5, 2, 3];
            for(var key in batchLogMap_jsonObj){
                batchLogMap_labels.push(key);
                batchLogMap_data.push(batchLogMap_jsonObj[key]);
            }            
            var options = {
              type: 'line',
              data: {
                labels: batchLogMap_labels,
                datasets: [
                    {
                      label: 'Frequency',
                      data: batchLogMap_data,
                      borderWidth: 4,
                      pointBorderWidth: 8,
                      pointRadius: 4,
                      pointHoverRadius: 6,
                      pointHoverBorderWidth: 10,
                      backgroundColor: 'rgba(82, 190, 128, 0.83)'
                    }
                    ]
              },
              options: {
                scales: {
                    xAxes: [{
                        ticks: {
                            min:60,
                            // Show all labels
                            autoSkip: false,                            
                            callback: function(tick) {
                                var characterLimit = 10;
                                if (tick.length >= characterLimit) {
                                   return tick.slice(0, tick.length).substr(0, characterLimit);
                                }
                                return tick;
                            }
                        }
                    }],
                    yAxes: [{
                    ticks: {
                        beginAtZero:true,
                        reverse: false
                    }
                  }]
                },
                tooltips: {
                    callbacks: {
                        title: function(tooltipItem){
                            return this._data.labels[tooltipItem[0].index].substr(0,10);
                        }
                    }
                }
              }
            }
            var ctx = document.getElementById('lastLogs').getContext('2d');
            new Chart(ctx, options);
        }
    </script>
    </apex:outputPanel>
