<!---
/**************************************************************************************
Vf page Name:  Core_Oppty_PreSubmitCheck
Version     : 1.0 
Created Date: 5/7/2017
Description : inline vf page embedded in opportunity page field as 'Pre-Submit Check'  redirect to the pre checklist vf
(User Story US64737)my opportunity does not meet the entry criteria for approval submission, so users are aware of any missing data and our pipeline data is more consistent and accurate
* Developer                   Date                   Description
* ----------------------------------------------------------------------------                 
* Rajesh infy Team            16/6/2017               Initial Revision

--->
<apex:page standardController="Opportunity" extensions="Core_OppApproveChecklistCont"  lightningStylesheets="true"> 
<apex:form id="theForm" > 
<apex:outputPanel rendered="{!$User.UIThemeDisplayed == 'Theme3'}"> 
     <apex:outputLink target="_blank" value="{!$Page.Core_OppApproveChecklist}?id={!opportunity.id}" rendered="{!ListtoReview}" title="Link to the checklist of opportunity input needed before submitting for approval" style="font-weight:bold; color:black;margin-left:-1%"> List to Review Before Approval</apex:outputLink> <!-- <span style= "font-weight:bold;color:black;margin-left: 3%;" > </span>  -->
    <apex:outputLink target="_blank" value="{!$Page.Core_OppApproveChecklist}?id={!opportunity.id}" rendered="{!ARReviewtheList}" title="Link to the checklist of opportunity input needed before submitting for approval" style="font-weight:bold;color:red;margin-left:-1%">AR: Review the List</apex:outputLink>
    <apex:outputLink target="_blank"   value="{!$Page.Core_OppApproveChecklist}?id={!opportunity.id}" rendered="{!Completeflag}" title="Link to the checklist of opportunity input needed before submitting for approval" style="font-weight:bold;color:green;margin-left:-1%">Complete</apex:outputLink>
    <apex:outputLink target="_blank"   value="{!$Page.Core_OppApproveChecklist}?id={!opportunity.id}" rendered="{!Approvedflag}" title="Link to the checklist of opportunity input needed before submitting for approval" style="font-weight:bold;color:black;margin-left:-1%">Approved</apex:outputLink>
    <apex:outputLink target="_blank"   value="{!$Page.Core_OppApproveChecklist}?id={!opportunity.id}" rendered="{!noLinkflag}" ></apex:outputLink>
</apex:outputPanel>
<apex:outputPanel rendered="{!$User.UIThemeDisplayed !='Theme3'}">
    <apex:outputLink target="_self"  value="/one/one.app#/alohaRedirect/apex/Core_OppApproveChecklist?id={!opportunity.id}"   rendered="{!ListtoReview}" title="Link to the checklist of opportunity input needed before submitting for approval" style="font-weight:bold; color:black;margin-left:-1%"> List to Review Before Approval</apex:outputLink> <!-- <span style= "font-weight:bold;color:black;margin-left: 3%;" > </span>  -->
    <apex:outputLink target="_self"  value="/one/one.app#/alohaRedirect/apex/Core_OppApproveChecklist?id={!opportunity.id}"   rendered="{!ARReviewtheList}" title="Link to the checklist of opportunity input needed before submitting for approval" style="font-weight:bold;color:red;margin-left:-1%">AR: Review the List</apex:outputLink>
    <apex:outputLink target="_self"  value="/one/one.app#/alohaRedirect/apex/Core_OppApproveChecklist?id={!opportunity.id}"   rendered="{!Completeflag}" title="Link to the checklist of opportunity input needed before submitting for approval" style="font-weight:bold;color:green;margin-left:-1%">Complete</apex:outputLink>
    <apex:outputLink target="_self"  value="/one/one.app#/alohaRedirect/apex/Core_OppApproveChecklist?id={!opportunity.id}"   rendered="{!Approvedflag}" title="Link to the checklist of opportunity input needed before submitting for approval" style="font-weight:bold;color:black;margin-left:-1%">Approved</apex:outputLink>
    <apex:outputLink target="_self"  value="/one/one.app#/alohaRedirect/apex/Core_OppApproveChecklist?id={!opportunity.id}"   rendered="{!noLinkflag}" ></apex:outputLink>
 </apex:outputPanel>
 </apex:form>
</apex:page>