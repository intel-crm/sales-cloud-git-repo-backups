       </apex:pageBlock>
     
       <!--Added by Geetha as per user story US92077-->
       <style type="text/css">

        .popup
        {
            background-color: white;
            border-width: 2px;
            border-style: solid;
            z-index: 9999;
            left: 50%;
            padding:10px;
            position: absolute;
            width: 800px;
           
            margin-left: -400px;
            top:80px;
        }
        .popup1
        {
           
            width: 500px;
            height: 300px;
        }
        .popupBg
        {
            background-color:black;
            opacity: 0.20;
            filter: alpha(opacity = 70);
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 9998;
        }
        .closeButton {
           
             position: absolute;
             right: 7px;
             background: white;
             top: 2px;
           
       }
      .test .apexp{
       overflow:scroll;
       height:300px;
       }

    </style>
        <apex:outputPanel id="popup" >
         <apex:outputPanel styleClass="popupBg" layout="block" rendered="{!displayPopUp}" />
            <apex:outputPanel styleClass="popup test"  layout="block" rendered="{!displayPopUp}" >
              <apex:commandLink value="Close" action="{!closePopup}" rerender="popup" styleClass="closeButton"/>
                
                  <apex:pageBlock title="List of Contacts"  >
                   
                     <apex:pageblockSection title="Contact Information" collapsible="false" columns="1"  >
                     
                        <apex:pageBlockTable value="{!con}" var="contact"  >
                            <apex:column value="{!contact.FirstName}"/>
                            <apex:column value="{!contact.LastName}"/>
                            <apex:column value="{!contact.Email}"/>
                        </apex:pageBlockTable>
                        
                      </apex:pageblockSection>
                     
                    </apex:pageBlock> 
                    
            </apex:outputPanel>
        </apex:outputPanel>
      
