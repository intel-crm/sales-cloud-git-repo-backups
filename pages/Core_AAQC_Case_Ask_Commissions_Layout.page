<apex:page standardController="Case" extensions="Core_AAQC_Case_Ask_Commissions_CNTLR">
<!-- Added integrity and cross origin attributes as suggested by semgrep tool as part of TWC4767-3971: KIIT: Semgrep Scan Results>-->     
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.0/jquery.min.js" integrity="sha384-XxcvoeNF5V0ZfksTnV+bejnCsJjOOIzN6UVwF85WBsAnU3zeYh5bloN+L4WLgeNE" crossorigin="anonymous"></script>

<apex:sectionHeader subtitle="New Case" title="Case Edit"/>
<!-- Code start Added as a part of US76746 --> 
<script>
 var newWin=null;
    function openLookupPopup(name, id)
    {
        var url="/apex/Core_AAQC_Custom_Lookup?namefield=" + name + "&idfield=" + id +"&queryParam=" + document.getElementById(name).value;
        newWin=window.open(url, 'Popup','height=500,width=600,left=100,top=100,resizable=no,scrollbars=yes,toolbar=no,status=no');
        if (window.focus){
            newWin.focus();
        }
        return false;
    }
       
 function closeLookupPopup()
 {
    if (null!=newWin)
    {
       newWin.close();
    }  
 }
</script>
<!-- Code End Added as a part of US76746 --> 
