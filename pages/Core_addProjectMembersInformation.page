<apex:page standardStylesheets="true" sidebar="true" showHeader="true" applyBodyTag="false"
           docType="html-5.0" controller="Core_IPS_AddProjectMember_Controller" id="pageId" title="Add Project Members">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <!--link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" type="text/css"/-->
        <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.3.11/angular.min.js">
        </script>
        <!--script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.2.19/angular.min.js" type="text/javascript">
        </script-->
        <script src="https://angular-ui.github.io/bootstrap/ui-bootstrap-tpls-0.10.0.js" type="text/javascript">
        </script>
        <apex:includeScript value="/support/console/41.0/integration.js" />
        <apex:stylesheet value="{!URLFOR($Resource.Core_IPS_Page_Loading_Animation, 'spinner.css')}"/>
        <apex:includeScript value="{!URLFOR($Resource.Core_IPS_Page_Loading_Animation, 'jquery.min.js')}"/>
        <apex:includeScript value="{!URLFOR($Resource.Core_IPS_Page_Loading_Animation, 'spinner.js')}"/>
        <style>            
            .bPageBlock .table {
                border-collapse : collapse;
                width:100%;
            }
            .bPageBlock .table td{            
                background: #fff;
            }
            .bPageBlock .table tr td, .bPageBlock .table tr th, .hoverDetail .bPageBlock .table tr td, .hoverDetail .bPageBlock .table tr th {
                border: 1px solid #ddd;
                padding: 3px 2px 4px 4px;
                color: #333;            
            }
            .table-hover tbody tr:hover td {
                background-color: #cfeef8;         
            }
        </style>
           
            <script>
            var demoApp =angular.module('demoApp', []);
            
            demoApp.controller('DemoCtrl',function ($scope,$filter) {
                $scope.currentPage = 0;
                $scope.currentPage1 = 0;
                $scope.pageSizes = [5,10,25,50];
                $scope.pageSizes1 = [5,10,25,50];
                $scope.itemsPerPage = 10;
                $scope.itemsPerPage1 = 10;
                $scope.pageSize = 10;
                $scope.pageSize1 = 10;
                $scope.lst = [];
                $scope.ProjectMemberList1 = [];
                $scope.pagedItems = [];
                $scope.myAddProjectDiv = true;
                $scope.myAddProjectDiv1 = true;
                $scope.lstAllProjectMemberList = [];
                $scope.ProjectMemberList = {!lstProjectMemberWrapperInfo};
                //document.getElementById('pageId').style.display = 'block';
                $scope.existProjectMemberInfo = {!lstExistingProjectMembers};
                //document.getElementById('pageId').style.display = 'none';
                
                //setTimeout(function() { $scope.myCheckBoxesControl(); }, 5000);
                
                $scope.lstFilterItems = [];
                //myFun();
                $scope.myCheckBoxesControl = function(){
                    for (var i = 0; i < $scope.ProjectMemberList.length; i++) {
                        if (i % $scope.itemsPerPage === 0) {
                            $scope.pagedItems[Math.floor(i / $scope.itemsPerPage)] = [ $scope.ProjectMemberList[i] ];
                        } else {
                            $scope.pagedItems[Math.floor(i / $scope.itemsPerPage)].push($scope.ProjectMemberList[i]);
                        }                        
                    }
                };
                
                for (var i = 0; i < $scope.ProjectMemberList.length; i++) {
                    if (i % $scope.itemsPerPage === 0) {
                        $scope.pagedItems[Math.floor(i / $scope.itemsPerPage)] = [ $scope.ProjectMemberList[i] ];
                    } else {
                        $scope.pagedItems[Math.floor(i / $scope.itemsPerPage)].push($scope.ProjectMemberList[i]);
                    }                    
                }
                
                $scope.sort = function(keyname){
                    $scope.sortKey = keyname;   //set the sortKey to the param passed
                    $scope.reverse = !$scope.reverse; //if true make it false and vice versa
                };
                
                $scope.change = function(list, active){
                    if (active)
                        $scope.lst.push(list);
                    else
                        $scope.lst.splice($scope.lst.indexOf(list), 1);                    
                };
                
                $scope.perPage = function () {
                    $scope.myCheckBoxesControl(); 
                    $scope.numberOfPages();
                };
                
                $scope.perPage1 = function () {
                    $scope.numberOfPages1();
                };
                
                $scope.numberOfPages=function(){                    
                    var myFilteredData = $filter('filter')($scope.ProjectMemberList,$scope.search_notes);
                    return Math.ceil(myFilteredData.length/$scope.itemsPerPage);                
                }
                
                $scope.numberOfPages1 = function(){
                    var myFilteredData = $filter('filter')($scope.existProjectMemberInfo,'');
                    return Math.ceil(myFilteredData.length/$scope.itemsPerPage1);                    
                }
                
                var getAllSelected = function () {
                    //$scope.lstPerPageList = [];
                    var selectedItems = $scope.pagedItems[$scope.currentPage].filter(function (item) {                        
                        return item.selected;
                    });
                    return selectedItems.length === $scope.pagedItems[$scope.currentPage].length;
                }
                
                $scope.searchResults = function(){
                    $scope.currentPage = 0;
                    var myFilteredData = $filter('filter')($scope.ProjectMemberList,$scope.search_notes);
                    return Math.ceil(myFilteredData.length/$scope.itemsPerPage); 
                }
                
                var setAllSelected = function (value) {
                    angular.forEach($scope.pagedItems[$scope.currentPage], function (item) {
                        item.selected = value;
                    });
                }
                
                $scope.allSelected = function (value) {                    
                    if (value!=undefined) {                        
                        return setAllSelected(value);
                    } else {
                        //$scope.lstAllProjectMemberList = [];
                        return getAllSelected();
                    }
                }
                
                $scope.AddProjectMembers = function(){   
                    //added for US279984
                    startSplash();
                    
                    insertProjectMembers(window.location.href);                    
                };
                
                function insertProjectMembers(url) {
                    
                    //console.log(JSON.stringify($scope.ProjectMemberList1));
                    $scope.ProjectMemberList1.length = 0;
                    for (var i=0;i<$scope.ProjectMemberList.length;i++)
                    {
                        var userId;                 
                        if($scope.ProjectMemberList[i].selected){                            
                            if($scope.ProjectMemberList[i].user!=null){
                                userId = $scope.ProjectMemberList[i].user.Id;
                                $scope.ProjectMemberList1.push({Core_IPS_Contact__c:$scope.ProjectMemberList[i].contactId,Core_User__c:userId,
                                                            core_ips_project__c:'{!$currentpage.parameters.projectId}',Core_Status__c:'Active',Core_Selective_Member__c:true}); 
                            }
                            /*else{
                                userId = null;
                            }*/ 
                        }                         
                    }                    
                    /*
                    for(var i=0;i<$scope.lst.length;i++){
                        var userId;                 
                        if($scope.lst[i].selected){                            
                            if($scope.lst[i].user!=null){
                                userId = $scope.lst[i].user.Id;
                            } 
                            $scope.ProjectMemberList1.push({Core_IPS_Contact__c:$scope.lst[i].contactId,Core_User__c:userId,
                                                            core_ips_project__c:'{!$currentpage.parameters.projectId}',Core_Status__c:'Active',Core_Selective_Member__c:true});                         
                        
                        else{
                                userId = null;
                            }
                        }
                        else{
                            break;
                        }                         
                    }
                    */
                    console.log('>>> lst Length : ' + $scope.lst.length);
                    //console.log($scope.lst);
                    
                    console.log('>>> ProjectMemberList1 Length : ' + $scope.ProjectMemberList1.length);
                    //console.log($scope.ProjectMemberList1);
                    
                    if($scope.ProjectMemberList1==null || $scope.ProjectMemberList1==''){
                        alert('Please select at least one Project Member');
                        //added for US279984
                    endSplash();
                        
                    } else{     
                        //return; //testing
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.Core_IPS_AddProjectMember_Controller.insertProjectMembers}',
                            $scope.ProjectMemberList1,
                            function(result, event) {
                                console.log(result);
                                //console.log('*****Event'+JSON.stringify(event));
                                //console.log('*****ProjectMember'+JSON.stringify($scope.ProjectMemberList1));
                                if(event.status) {  
                                    //added by sugandha
                                    if (result == 'exception') {
                                        alert('You are not authorized to add a Project Members that are from Accounts that you do not own, or are not on its Account Team.');
                                        //added for US279984
                                        endSplash();
                                      } 
                                    //end                                  
                                    //window.location.reload();
                                    //successCallBackFunc();
                                    //start modified by Aayushi 13/04/2018 DE37602
                                    else if (sforce.console.isInConsole() && url!=window.location.href) { //Checks that it is in console 
                                        console.log('in console'+url);
                                        window.open(url+'?isdtp=vw','_self'); 
                                    }else{ 
                                        window.open(url,'_self'); 
                                    }
                                    //end
                                } else {                                
                                    alert('Could not add project Memebrs, Please try Again !!');
                                    //added for US279984
                                    endSplash();
                                }
                            });
                    }
                }                
                
                
                $scope.AddAndDoneProjectMembers = function(){                    
                    //added for US279984
                    startSplash();
                    insertProjectMembers("/{!$currentpage.parameters.projectId}");                    
                };
                
            });
            
            function redirectProjectPage(){
                if (sforce.console.isInConsole()){
                    //added for US279984
                    startSplash();
                window.open("/"+'{!$currentpage.parameters.projectId}'+'?isdtp=vw',"_self");
                    }
                
                else{
                    //added for US279984
                    startSplash();
                window.open("/"+'{!$currentpage.parameters.projectId}',"_self");
                    }
            }
            
            //We already have a limitTo filter built-in to angular,
            //let's make a startFrom filter
            demoApp.filter('startFrom', function() {
                return function(input, start) {
                    if (!input || !input.length) { return; }
                    start = +start; //parse to int
                    return input.slice(start);
                }
            });            
            
            </script>
            
        </head>
        
    <body class="container" ng-controller="DemoCtrl" ng-cloak="true" ng-app="demoApp">
        <div class="splashStatus" id="splashDiv">
            <div class="circle"><img src="{!URLFOR($Resource.Core_IPS_Page_Loading_Animation, 'spinner.gif')}"/></div>
            <div class="txt">Please Wait...</div>
        </div> 
            <!-- Existing Members Section -->
           
            <div style="background-color:#fff;" ng-show="existProjectMemberInfo.length">
                
                <apex:pageblock >
                    <apex:pageblocksection title="Existing Members" columns="1">
                        <apex:pageBlockSectionItem >
                            <div class="form-group">
                                Show&nbsp;
                                <select ng-model="itemsPerPage1" ng-change="perPage1()" ng-options="(size) for size in pageSizes1"></select>
                                &nbsp;entries
                            </div>
                            <div style="margin:10px 0px 8px 0px;">                                    
                                <table class="table table-hover table-striped table-bordered table-responsive">
                                    <tr class="tablewrapClass">
                                        <th><h6><b>First Name</b></h6></th>
                                        <th><h6><b>Last Name</b></h6></th>
                                        <th><h6><b>Email</b></h6></th>    <!--added by Aayushi US119231-->
                                        <th><h6><b>Account Name</b></h6></th>
                                    </tr>
                                    <tr ng-repeat="existprojectMember in existProjectMemberInfo | startFrom:currentPage1*itemsPerPage1 | limitTo:itemsPerPage1">                                        
                                        <td>{{existprojectMember.Core_IPS_Contact__r.FirstName}}</td>
                                        <td>{{existprojectMember.Core_IPS_Contact__r.LastName}}</td>
                                        <td>{{existprojectMember.Core_IPS_Contact__r.Email}}</td>  <!--added by Aayushi US119231-->
                                        <td>{{existprojectMember.Core_IPS_Contact__r.Account.Name}}</td>
                                    </tr>
                                </table>
                            </div>       
                            <div>                                
                                <div style="width: 30%;float: left;">
                                    Showing {{((currentPage1+1)*itemsPerPage1)-itemsPerPage1+1}} to {{(currentPage1+1)*itemsPerPage1 > existProjectMemberInfo.length ? existProjectMemberInfo.length : (currentPage1+1)*itemsPerPage1 }} of {{existProjectMemberInfo.length}} entries
                                </div>                                
                                <div style="width:12%;float: right;">
                                    <button ng-disabled="currentPage1 == 0" ng-click="currentPage1=currentPage1-1" class="{{currentPage1 == 0 ? 'btnDisabled' : 'btn'}}"> 
                                        Previous
                                    </button>
                                    <span class=" center-block" style="padding:0 7px;">{{currentPage1+1}}/{{numberOfPages1()}}</span>
                                    <button ng-disabled="(currentPage1 + 1) == numberOfPages1()" ng-click="currentPage1=currentPage1+1" class="{{(currentPage1 + 1) == numberOfPages1() ? 'btnDisabled' : 'btn'}}">
                                        Next
                                    </button>
                                </div>
                            </div>
                        </apex:pageBlockSectionItem>
                    </apex:pageblocksection>
                </apex:pageblock>                       
            </div>          
            
            <!-- Add New Members Section -->
            <div>            
                <apex:pageblock rendered="{!isError}">
                    <apex:pageBlockButtons >
                        <button onclick="redirectProjectPage();">
                            <b>Back to Project</b>
                        </button>
                    </apex:pageBlockButtons>
                    <apex:outputText style="color:red;font-weight:bold;" value="{!errorMsg}"></apex:outputText>
                </apex:pageblock>
                <apex:pageblock rendered="{!NOT(isError)}">                
                    <div class="message infoM4"><img alt="INFO" class="msgIcon" src="/s.gif" title="INFO" /> 
                        &nbsp; Only IPS Active Contact enabled as Community user are listed below
                    </div>
                    <apex:pageblocksection title="Add Members" columns="1">
                        <apex:pageBlockSectionItem >
                            <!-- Actions Div -->
                            <div style="height:20px;"> 
                                <div class="form-group" style="width:30%;float:left;">
                                    Show&nbsp;                                
                                    <select ng-model="itemsPerPage" ng-change="perPage()" ng-options="(size) for size in pageSizes"></select>
                                    &nbsp;entries
                                </div>    
                                
                                <div style="width:30%;float:left;">
                                    <button ng-click="AddProjectMembers();">
                                        <b>Add</b>
                                    </button>
                                    &nbsp;
                                    <button ng-click="AddAndDoneProjectMembers();" >
                                        <b>Add and Done</b>
                                    </button>
                                    &nbsp;
                                    <button onclick="redirectProjectPage();">
                                        <b>Cancel</b>
                                    </button>
                                </div>                 
                                
                                <div class="form-group" style="width:30%;float:right;text-align:right;">
                                    Search:
                                    <input type="text" id="txtNotessearch" ng-model="search_notes" class="form-control input-sm" ng-change="searchResults()" />                                
                                </div>
                            </div>
                            
                            <!-- Table Div -->
                            <div style="margin:10px 0px;">
                                <table class="table table-hover table-striped table-bordered table-responsive">
                                    <tr class="tablewrapClass">
                                        <th width="30px;"><input type="checkbox" ng-model="allSelected" ng-change="myProjectInfo(this.checked)" ng-model-options="{getterSetter: true}"/>
                                        </th>
                                        <th ng-click="sort('conFirstName')">FirstName &nbsp;<span class="glyphicon sort-icon" ng-show="sortKey=='conFirstName'" ng-class="{'glyphicon-chevron-up':reverse,'glyphicon-chevron-down':!reverse}" ></span>
                                        </th>
                                        <th ng-click="sort('conLastName')">LastName &nbsp;<span class="glyphicon sort-icon" ng-show="sortKey=='conLastName'" ng-class="{'glyphicon-chevron-up':reverse,'glyphicon-chevron-down':!reverse}"></span>
                                        </th>
                                        <th ng-click="sort('conEmail')">Email &nbsp;<span class="glyphicon sort-icon" ng-show="sortKey=='conEmail'" ng-class="{'glyphicon-chevron-up':reverse,'glyphicon-chevron-down':!reverse}"></span>
                                        </th>
                                        <th ng-click="sort('accountName')">AccountName &nbsp;<span class="glyphicon sort-icon" ng-show="sortKey=='accountName'" ng-class="{'glyphicon-chevron-up':reverse,'glyphicon-chevron-down':!reverse}"></span>
                                        </th>
                                    </tr>
                                    <tr ng-repeat="projectMember in ProjectMemberList  | filter:search_notes | startFrom:currentPage*itemsPerPage | limitTo:itemsPerPage  | orderBy:sortKey:reverse"> 
                                        <td><input type="checkbox" ng-model="projectMember.selected"  ng-change="change(projectMember, projectMember.selected)" id="{{projectMember.contactId}}" /></td>         
                                        <td>{{projectMember.conFirstName}}</td>
                                        <td>{{projectMember.conLastName}}</td>
                                        <td>{{projectMember.conEmail}}</td>
                                        <td>{{projectMember.accountName}}</td>
                                    </tr>                        
                                </table>
                            </div>
                            
                            <!-- Table Controls -->
                            <div>                            
                                <div style="width: 30%;float: left;">
                                    Showing {{((currentPage+1)*itemsPerPage)-itemsPerPage+1}} to {{(currentPage+1)*itemsPerPage > ProjectMemberList.length ? ProjectMemberList.length : (currentPage+1)*itemsPerPage }} of {{ProjectMemberList.length}} entries
                                </div>
                                
                                <div style="width:30%;float:left;">
                                    <button ng-click="AddProjectMembers();">
                                        <b>Add</b>
                                    </button>
                                    &nbsp;
                                    <button ng-click="AddAndDoneProjectMembers();">
                                        <b>Add and Done</b>
                                    </button>
                                    &nbsp;
                                    <button onclick="redirectProjectPage();">
                                        <b>Cancel</b>
                                    </button>
                                </div>    
                                
                                <div style="width:12%;float:right;">
                                    <button ng-disabled="currentPage == 0" ng-click="currentPage=currentPage-1" class="{{currentPage == 0 ? 'btnDisabled' : 'btn'}}"> 
                                        Previous
                                    </button>
                                    <span class=" center-block" style="padding:0 7px;">{{currentPage+1}}/{{numberOfPages()}}</span>
                                    <button ng-disabled="(currentPage + 1) == numberOfPages()" ng-click="currentPage=currentPage+1" class="{{(currentPage + 1) == numberOfPages() ? 'btnDisabled' : 'btn'}}">
                                        Next
                                    </button>
                                </div>
                            </div>
                        </apex:pageBlockSectionItem>
                    </apex:pageblocksection>
                </apex:pageblock>
            </div>
        <!--modified for US279984-->
        <div class="lightbox"></div>
    </body>
</apex:page>