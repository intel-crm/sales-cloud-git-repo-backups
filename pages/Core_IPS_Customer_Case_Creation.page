                    </apex:pageBlockSectionItem>
                    <!-- Added section item for closed case by Sugandha for User Story US83594 Iteration 6 -->
                    <apex:pageBlockSectionItem helptext="{!$ObjectType.Case.fields[f].InlineHelpText}" rendered="{!isClosed}">
                        <apex:outputLabel value="{!f.label}"/>
                        <apex:outputField value="{!cs[f.fieldPath]}"/>
                    </apex:pageBlockSectionItem>
                </apex:repeat>
                <!--Added by geetha as per US98246-->
                <apex:outputPanel styleClass="owner"> 
                    <apex:pageBlockSection >
                        <apex:pageBlockSectionItem rendered="{!IF((contains($Label.Core_IPS_Partner_AE_Profile_Id,LEFT($Profile.Id,15)) || isPartnerFAE),true,false)}">
                            <apex:outputLabel value="Partner Support Owner"/>
                            <apex:outputField id="supportOwner" value="{!cs.Core_IPS_Partner_Sup_Owner__c}" />
                        </apex:pageBlockSectionItem>
                    </apex:pageBlockSection>
                </apex:outputPanel> 
                <!--Ended by geetha as per US98246-->
                
                <apex:pageBlockSectionItem rendered="{!(isPartnerAgent || isPartnerFAE)}" id="targetCustaccountSec" >
                    <apex:outputLabel value="Partner Supported Account"/>
                    <!-- Added disabled="{!isClosed} by Geetha for User Story US95437 Iteration 8 -->
                    <apex:outputPanel styleClass="requiredInput" layout="block" ><!--//RK Changes for US104046-->
                        <apex:outputPanel styleClass="requiredBlock" layout="block" id="styleReq" rendered="{!(mode!='edit') && (selectedProject!= '' &&selectedProject!= null)}"  /><!--//RK Changes for US104046|| Rendering this required red bar for IPS Agent Partner and DFAE when case has a Project ||&& (selectedProject!= '') -->
                        <apex:selectList id="targetCustaccount" styleclass="targetCustaccount" label="Partner Supported Account" value="{!selectedAccountId}" size="1" disabled="{!isClosed}" required="true" >  
                            <apex:selectOptions value="{!IPSParentAccountList}"/>
                        </apex:selectList>
                    </apex:outputPanel><!--//RK Changes for US104046--> 
                </apex:pageBlockSectionItem> 
                
            </apex:pageblockSection>
            <apex:outputpanel id="ProductDetails1" > 
                <apex:pageblockSection title="Product/Project Info" columns="1" rendered="{!IF(OR(AND(platformOptions != null,platformOptions.size>1),AND(categoryOptions!=null,categoryOptions.size>1)),TRUE,FALSE)}">
                    <apex:pageBlockSectionItem rendered="{!categoryOptions.size>1}">
                        <apex:outputLabel value="Case Category:" for="category" />
                        <apex:actionRegion >
                            <apex:outputPanel styleClass="requiredInput" rendered="{!categoryOptions.size>1}" layout="block">
                                <apex:outputPanel styleClass="requiredBlock" layout="block"/>
                                <apex:selectList value="{!categorySelected}" rendered="{!!isClosed}" size="1" id="category" styleClass="{!IF(!isClosed,'cust-combobox custom-combobox', '')}">
                                    <apex:selectOptions value="{!categoryOptions}"/> 
                                    <apex:actionSupport event="onchange" action="{!getEnvDetails}" reRender="none" status="stid" oncomplete="BindEvent();"/> 
                                </apex:selectList>
                                <apex:selectList value="{!categorySelected}"  disabled="true" rendered="{!isClosed}" size="1" id="category1" >
                                    <apex:selectOptions value="{!categoryOptions}"/> 
                                </apex:selectList> 
                            </apex:outputPanel>               
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <apex:pageBlockSectionItem id="stid" >
                        <apex:outputPanel id="subCategoryName">
                            <apex:outputLabel value="Case Subcategory: " rendered="{!subCategoryOptions.size > 1}"/>                       
                        </apex:outputPanel>        
                        <apex:actionRegion >                               
                            <apex:outputPanel id="subCategory">  
                                <apex:outputPanel styleClass="requiredInput" layout="block" rendered="{!AND(categoryOptions.size > 1,subCategoryOptions.size > 1)}"> 
                                    <apex:outputPanel styleClass="requiredBlock" layout="block"/>
                                    <!-- Added disabled="{!isClosed'} by Sugandha for User Story US83594 Iteration 6 -->
                                    <apex:selectList value="{!subCategorySelected}" rendered="{!!isClosed}" size="1" id="subCategoryList" styleClass="{!IF(!isClosed,'cust-combobox custom-combobox ', '')}">
                                        <apex:selectOptions value="{!subCategoryOptions}" />  
                                        <apex:actionSupport event="onchange" action="{!getEnvironmentDets}" reRender="none" status="status1" oncomplete="BindEvent();"/>
                                    </apex:selectList>
                                    <apex:selectList value="{!subCategorySelected}" disabled="true" rendered="{!isClosed}"  size="1" id="subCategoryList1" >
                                        <apex:selectOptions value="{!subCategoryOptions}" />  
                                    </apex:selectList>
                                </apex:outputPanel>
                            </apex:outputPanel>
                        </apex:actionRegion> 
                    </apex:pageBlockSectionItem>
                    <!-- Add Platform Name Functionality-- Raj changes Begin--> 
                    <apex:pageBlockSectionItem rendered="{!displayPlatform && isPartnerAgent}" >
                        <apex:outputLabel value="Select Platform:" for="platform"/>
                        <apex:actionRegion >
                            <apex:outputPanel styleClass="requiredInput" layout="block" rendered="{!platformOptions.size>1}">
                                <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!platformOptions.size>1}"/> 
                                <apex:selectList value="{!platformSelected}" size="1" id="platform" disabled="{!isClosed}">
                                    <apex:selectOptions value="{!platformOptions}"/> 
                                </apex:selectList>
                            </apex:outputPanel>
                        </apex:actionRegion>
                    </apex:pageBlockSectionItem>
                    <!-- End Platform  name changes -->
                    <apex:inputHidden value="{!selectedProductId}" id="targetProdId" rendered="{!AND(IF(mode=='edit',true,false),isAgent,Not(displaySelfAssigned))}"/>
                    <apex:inputHidden value="{!selectedContactId}" id="targetId" rendered="{!AND(IF(mode=='edit',true,false),isAgent,Not(displaySelfAssigned))}"/>
                    <apex:inputHidden value="{!selectedProjId}"   id="targetProjId" rendered="{!AND(IF(mode=='edit',true,false),isAgent,Not(displaySelfAssigned))}"/>
                </apex:pageblockSection>
            </apex:outputpanel>
            <apex:outputPanel id="environment2">
                <!-- Added by Prem as part of Altera CX-->
                <c:Core_IPS_Case_Creation_EDQ_Section displayEnvDetails="{!displayEnvDetails}" selectedProductId="{!selectedProductId}"
                                                      selectedSAProductId="{!selectedSAProductId}" subCategorySelected="{!subCategorySelected}"
                                                      envDetails="{!envDetails}" subCatenvDetList="{!subCatenvDetList}"/>
            </apex:outputPanel>   
            <apex:pageBlockButtons >
                <!--<apex:commandButton value="Cancel" onclick="return confirm('You will lose all your changes. Are you sure you want to Cancel?');" action="{!CancelAction}" />-->
                <input type="button" value="Cancel" class="btn" onclick="fnConfirmBox();"/>                          
                <apex:commandButton value="Submit" action="{!saveCaseDetails}" onclick="showSpinner();"/>                     
            </apex:pageBlockButtons>
        </apex:pageblock>
        <apex:outputPanel id="popup" >
            <apex:outputPanel styleClass="popupBg" layout="block" rendered="{!displayPopUp}" />
            <apex:outputPanel styleClass="popup test"  layout="block" rendered="{!displayPopUp}" >
                <apex:commandLink value="Close" action="{!closePopup}" rerender="popup" styleClass="closeButton"/>
                <apex:pageBlock title="List of Contacts"  >
                    <apex:pageblockSection title="Contact Information" collapsible="false" columns="1"  >
                        <apex:pageBlockTable value="{!con}" var="contact">
                            <apex:column value="{!contact.FirstName}"/>
                            <apex:column value="{!contact.LastName}"/>
                            <apex:column value="{!contact.Email}"/>
                        </apex:pageBlockTable>
                    </apex:pageblockSection>
                </apex:pageBlock> 
            </apex:outputPanel>
        </apex:outputPanel>
        <!--Ended by Geetha as per user story US78568-->  
    </apex:form>
    <apex:PageBlock rendered="{!if(OR(AND(mode ='edit',isEditable),mode!='edit'),false,true)}">
        <span style="color:red;align:center;">You have insufficient privilege to edit the Case.</span>
    </apex:PageBlock>
    <apex:PageBlock rendered="{!if(AND(mode=='edit',case.Core_IPS_Customer_Visible__c=false),true,false)}">
        <span style="font-weight: bold; font-size: 12pt;">Data Not Available</span><br/><br/>
        The data you were trying to access could not be found. It may be due to another user deleting the data or a system error. If you know the data is not deleted but cannot access it, please look at our <a href="javascript:openPopupFocusEscapePounds('https://help.salesforce.com/apex/htdoor?body=%2Ftrain%2FonlineSupport.jsp&amp;loc=support&amp;language=en_US&amp;release=210.16.4&amp;instance=CS92&amp;showSplash=true', 'Help', 1024, 768, 'width=1024,height=768,resizable=yes,toolbar=yes,status=yes,scrollbars=yes,menubar=yes,directories=no,location=yes,dependant=no', false, false);" title="support (New Window)">support</a> page.
    </apex:PageBlock>
    <script>
        $.each($("select[id*=caseCustomerDetail]"), function( index, value ) { 
          if(value[0].innerHTML=='--None--'){value[0].innerHTML='--Select--';}
        });
    </script>
</apex:page>