        <name>Core_MDF_Scorecard_Explanation2_PV8</name>
    </customLabels>
    <customLabels>
        <label>A solicitação recebeu uma pontuação zero em uma ou mais de três categorias de pontuação (Atribuição, POP, Engajamento).</label>
