        </dashboardFilterOptions>
        <dashboardFilterOptions>
            <operator>includes</operator>
            <values>3SO</values>
        </dashboardFilterOptions>
        <name>Sales Segments</name>
    </dashboardFilters>
    <dashboardType>SpecifiedUser</dashboardType>
    <description>Note:- Influencer Sales and Compute &amp; Embedded numbers include OSC.</description>
