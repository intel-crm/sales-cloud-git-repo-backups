    <colorPalette>unity</colorPalette>
    <dashboardChartTheme>light</dashboardChartTheme>
    <dashboardColorPalette>unity</dashboardColorPalette>
    <dashboardFilters>
        <dashboardFilterOptions>
            <operator>between</operator>
            <values>1/1/2020</values>
            <values>12/31/2020</values>
        </dashboardFilterOptions>
        <dashboardFilterOptions>
            <operator>between</operator>
            <values>1/1/2021</values>
            <values>12/31/2021</values>
        </dashboardFilterOptions>
        <name>Year Select</name>
    </dashboardFilters>
    <dashboardFilters>
        <dashboardFilterOptions>
            <operator>includes</operator>
            <values>Enterprise High Perf Compute (Off-Prem),Enterprise High Perf Compute (On-Prem)</values>
        </dashboardFilterOptions>
        <dashboardFilterOptions>
            <operator>includes</operator>
            <values>Enterprise Analytics (Off-Prem),Enterprise Analytics (On-Prem)</values>
        </dashboardFilterOptions>
        <dashboardFilterOptions>
            <operator>includes</operator>
            <values>Enterprise DC Cloud Modernization</values>
        </dashboardFilterOptions>
        <dashboardFilterOptions>
            <operator>equals</operator>
