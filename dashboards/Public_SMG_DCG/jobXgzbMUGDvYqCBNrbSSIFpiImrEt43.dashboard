        </dashboardFilterOptions>
        <dashboardFilterOptions>
            <operator>equals</operator>
            <values>Comms Infrastructure</values>
        </dashboardFilterOptions>
        <name>KPI Select</name>
    </dashboardFilters>
    <dashboardFilters>
        <dashboardFilterOptions>
            <operator>includes</operator>
            <values>DCG-E&amp;G</values>
        </dashboardFilterOptions>
        <dashboardFilterOptions>
