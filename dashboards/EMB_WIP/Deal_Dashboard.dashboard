    <dashboardType>SpecifiedUser</dashboardType>
    <description>Sample Dashboard that adds a BU Short Name filter.  BU Short Name filter will change KPI Product Group Results and Solution Area Results.  Note that Solution Area KPI&apos;s do not add the BU Short Name as a Filter and only use Solution Area.</description>
    <isGridLayout>false</isGridLayout>
    <leftSection>
