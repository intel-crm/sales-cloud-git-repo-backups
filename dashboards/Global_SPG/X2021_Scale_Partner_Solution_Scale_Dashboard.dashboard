<?xml version="1.0" encoding="UTF-8"?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
    <backgroundEndColor>#FFFFFF</backgroundEndColor>
    <backgroundFadeDirection>Diagonal</backgroundFadeDirection>
    <backgroundStartColor>#FFFFFF</backgroundStartColor>
    <dashboardFilters>
        <dashboardFilterOptions>
            <operator>equals</operator>
            <values>APJ</values>
        </dashboardFilterOptions>
        <dashboardFilterOptions>
            <operator>equals</operator>
            <values>ASMO</values>
        </dashboardFilterOptions>
        <dashboardFilterOptions>
            <operator>equals</operator>
            <values>EMEA</values>
        </dashboardFilterOptions>
        <dashboardFilterOptions>
            <operator>equals</operator>
            <values>PRC</values>
        </dashboardFilterOptions>
        <name>Opportunity Region</name>
    </dashboardFilters>
    <dashboardFilters>
        <dashboardFilterOptions>
            <operator>includes</operator>
            <values>DCG-Comms</values>
        </dashboardFilterOptions>
        <name>Account BU Focus</name>
    </dashboardFilters>
    <dashboardFilters>
        <dashboardFilterOptions>
            <operator>contains</operator>
            <values>network -,visual cloud -</values>
        </dashboardFilterOptions>
        <name>Solution Detail</name>
    </dashboardFilters>
    <dashboardType>SpecifiedUser</dashboardType>
    <description>2021 Solution &amp; Scale dashboard:  Key scale partners identified in SFDC PARTNER Field.  For Network/Visual Cloud uses cases, set Solution Detail dashboard filter.</description>
    <isGridLayout>false</isGridLayout>
    <leftSection>
