    <dashboardType>SpecifiedUser</dashboardType>
    <description>Data in this report shows adherence to lead &quot;first touch&quot; SLA (7 days) and lead disposition (opportunity or rejection in 60 days) globally and by field sales and Online Sales Groups</description>
    <isGridLayout>false</isGridLayout>
    <leftSection>
        <columnSize>Wide</columnSize>
        <components>
            <autoselectColumnsFromReport>false</autoselectColumnsFromReport>
            <chartAxisRange>Auto</chartAxisRange>
