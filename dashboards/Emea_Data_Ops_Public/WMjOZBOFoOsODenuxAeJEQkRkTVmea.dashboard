                    <richTextContent>[{\&amp;quot;insert\&amp;quot;:\&amp;quot;This report \&amp;quot;},{\&amp;quot;attributes\&amp;quot;:{\&amp;quot;color\&amp;quot;:\&amp;quot;#020821\&amp;quot;},\&amp;quot;insert\&amp;quot;:\&amp;quot;\u2192\&amp;quot;},{\&amp;quot;attributes\&amp;quot;:{\&amp;quot;align\&amp;quot;:\&amp;quot;center\&amp;quot;},\&amp;quot;insert\&amp;quot;:\&amp;quot;\\n\&amp;quot;},{\&amp;quot;insert\&amp;quot;:\&amp;quot;is capturing Accounts that have an \&amp;quot;},{\&amp;quot;attributes\&amp;quot;:{\&amp;quot;bold\&amp;quot;:true},\&amp;quot;insert\&amp;quot;:\&amp;quot;empty account plan\&amp;quot;},{\&amp;quot;attributes\&amp;quot;:{\&amp;quot;align\&amp;quot;:\&amp;quot;center\&amp;quot;},\&amp;quot;insert\&amp;quot;:\&amp;quot;\\n\&amp;quot;},{\&amp;quot;insert\&amp;quot;:\&amp;quot;(= no attachment and no document link provided).\&amp;quot;},{\&amp;quot;attributes\&amp;quot;:{\&amp;quot;align\&amp;quot;:\&amp;quot;center\&amp;quot;},\&amp;quot;insert\&amp;quot;:\&amp;quot;\\n\&amp;quot;},{\&amp;quot;insert\&amp;quot;:\&amp;quot;It does \&amp;quot;},{\&amp;quot;attributes\&amp;quot;:{\&amp;quot;underline\&amp;quot;:true},\&amp;quot;insert\&amp;quot;:\&amp;quot;not\&amp;quot;},{\&amp;quot;insert\&amp;quot;:\&amp;quot; consider other Account Plans which might exist on that Account.\&amp;quot;},{\&amp;quot;attributes\&amp;quot;:{\&amp;quot;align\&amp;quot;:\&amp;quot;center\&amp;quot;},\&amp;quot;insert\&amp;quot;:\&amp;quot;\\n\&amp;quot;},{\&amp;quot;insert\&amp;quot;:\&amp;quot;As a result, some of the Accounts that come up in this report might have another Account Plan created which does meet the criteria - in which case, you don\&amp;#39;t need to take any action on the empty account plan.\&amp;quot;},{\&amp;quot;attributes\&amp;quot;:{\&amp;quot;align\&amp;quot;:\&amp;quot;center\&amp;quot;},\&amp;quot;insert\&amp;quot;:\&amp;quot;\\n\&amp;quot;}]</richTextContent>
