<?xml version="1.0" encoding="UTF-8"?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
    <backgroundEndColor>#DDDDDD</backgroundEndColor>
    <backgroundFadeDirection>TopToBottom</backgroundFadeDirection>
    <backgroundStartColor>#FFFFFF</backgroundStartColor>
    <dashboardFilters>
        <name>Decision Date</name>
    </dashboardFilters>
    <dashboardFilters>
        <name>Sales Segments</name>
    </dashboardFilters>
    <dashboardFilters>
        <name>Account Geo</name>
    </dashboardFilters>
    <dashboardType>SpecifiedUser</dashboardType>
    <description>Dashboard components show &quot;My team&apos;s team-selling and their opportunities&quot; based on the filter in the underlying report. To see &quot;All Opportunities&quot; or &quot;My Opportunities,&quot; clone the dashboard and point components to reports with a different filter setting.</description>
    <isGridLayout>false</isGridLayout>
    <leftSection>
        <columnSize>Wide</columnSize>
        <components>
            <autoselectColumnsFromReport>true</autoselectColumnsFromReport>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Funnel</componentType>
            <dashboardFilterColumns>
                <column>CLOSE_DATE</column>
            </dashboardFilterColumns>
            <dashboardFilterColumns>
                <column>Opportunity.Core_Sales_Segments__c</column>
            </dashboardFilterColumns>
            <dashboardFilterColumns>
                <column>Account.Core_Geo__c</column>
            </dashboardFilterColumns>
            <displayUnits>Auto</displayUnits>
            <drillEnabled>false</drillEnabled>
            <drillToDetailEnabled>false</drillToDetailEnabled>
            <enableHover>true</enableHover>
            <expandOthers>false</expandOthers>
            <footer>Shows open opportunities. Does not include opportunities where “stage&quot; is equal to Production Win, Lost, or Cancelled.</footer>
            <groupingSortProperties/>
            <header>Venture Projects Pipeline</header>
            <legendPosition>Bottom</legendPosition>
            <report>APJ_SEA_Sales_Team/X2015_Venture_projects_pipeline</report>
            <showPercentage>false</showPercentage>
            <showValues>true</showValues>
            <sortBy>RowLabelAscending</sortBy>
            <sortLegendValues>false</sortLegendValues>
            <title>2015 Venture Projects Pipeline</title>
            <useReportChart>false</useReportChart>
        </components>
    </leftSection>
    <middleSection>
        <columnSize>Wide</columnSize>
        <components>
            <autoselectColumnsFromReport>true</autoselectColumnsFromReport>
            <componentType>Gauge</componentType>
            <dashboardFilterColumns>
                <column>CLOSE_DATE</column>
            </dashboardFilterColumns>
            <dashboardFilterColumns>
                <column>Opportunity.Core_Sales_Segments__c</column>
            </dashboardFilterColumns>
            <dashboardFilterColumns>
                <column>Account.Core_Geo__c</column>
            </dashboardFilterColumns>
            <displayUnits>Auto</displayUnits>
            <gaugeMax>6.4E7</gaugeMax>
            <gaugeMin>0.0</gaugeMin>
            <groupingSortProperties/>
            <header>Design Win Performance</header>
            <indicatorBreakpoint1>3.2E7</indicatorBreakpoint1>
            <indicatorBreakpoint2>5.0E7</indicatorBreakpoint2>
            <indicatorHighColor>#54C254</indicatorHighColor>
            <indicatorLowColor>#C25454</indicatorLowColor>
            <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
            <report>APJ_SEA_Sales_Team/Venture_Design_Won1</report>
            <showPercentage>false</showPercentage>
            <showRange>false</showRange>
            <showTotal>true</showTotal>
            <showValues>false</showValues>
            <title>2015 Venture DW Performance</title>
        </components>
    </middleSection>
    <owner>10648198@intel.com.crm</owner>
    <rightSection>
        <columnSize>Wide</columnSize>
        <components>
            <autoselectColumnsFromReport>false</autoselectColumnsFromReport>
            <chartAxisRange>Auto</chartAxisRange>
            <chartSummary>
                <aggregate>Sum</aggregate>
                <axisBinding>y</axisBinding>
                <column>AMOUNT</column>
            </chartSummary>
            <componentType>BarStacked</componentType>
            <dashboardFilterColumns>
                <column>CLOSE_DATE</column>
            </dashboardFilterColumns>
            <dashboardFilterColumns>
                <column>Opportunity.Core_Sales_Segments__c</column>
            </dashboardFilterColumns>
            <dashboardFilterColumns>
                <column>Account.Core_Geo__c</column>
            </dashboardFilterColumns>
            <displayUnits>Auto</displayUnits>
            <drillEnabled>false</drillEnabled>
            <drillToDetailEnabled>false</drillToDetailEnabled>
            <enableHover>true</enableHover>
            <expandOthers>false</expandOthers>
            <groupingColumn>Opportunity.Core_Product_Application__c</groupingColumn>
            <groupingColumn>Opportunity.Core_Product_Application__c</groupingColumn>
            <groupingSortProperties/>
            <header>Product Application and stage w Amount</header>
            <legendPosition>Bottom</legendPosition>
            <report>Archives/Venture_project_by_application</report>
            <showPercentage>false</showPercentage>
            <showValues>false</showValues>
            <sortBy>RowValueDescending</sortBy>
            <sortLegendValues>false</sortLegendValues>
            <title>Product Application and Stage w/ Amount</title>
            <useReportChart>false</useReportChart>
        </components>
    </rightSection>
    <runningUser>10648198@intel.com.crm</runningUser>
    <textColor>#000000</textColor>
    <title>2015 Venture Project Pipelines</title>
    <titleColor>#000099</titleColor>
    <titleSize>14</titleSize>
</Dashboard>
