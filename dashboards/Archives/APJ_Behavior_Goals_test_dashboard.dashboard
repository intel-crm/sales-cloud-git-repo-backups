            <enableHover>true</enableHover>
            <expandOthers>false</expandOthers>
            <footer>Shows opportunities with future and past due decision dates. Excludes &quot;Win Submitted&quot; or &quot;Flag for Deletion&quot; status. Program goal of &gt;95% oppty with future decision dates.</footer>
            <groupingColumn>User.Core_User_Geo__c</groupingColumn>
            <groupingColumn>Opportunity.Core_Opportunity_Past_Due__c</groupingColumn>
            <groupingSortProperties/>
            <legendPosition>Bottom</legendPosition>
