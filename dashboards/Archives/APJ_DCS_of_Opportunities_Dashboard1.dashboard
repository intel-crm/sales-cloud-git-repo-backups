        <dashboardFilterOptions>
            <operator>includes</operator>
            <values>3SO</values>
        </dashboardFilterOptions>
        <name>Sales Segments</name>
    </dashboardFilters>
    <dashboardType>SpecifiedUser</dashboardType>
    <description>Note:- Influencer Sales and Embedded numbers are overall APJ numbers including OSC.</description>
