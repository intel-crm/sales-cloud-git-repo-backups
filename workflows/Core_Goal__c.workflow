<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Core_Goal_Rejection_Notification</fullName>
        <description>Core_Goal_Rejection_Notification</description>
        <protected>false</protected>
        <recipients>
            <field>Core_Goal_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Core_Rejection_Notification_Goal</template>
    </alerts>
    <fieldUpdates>
        <fullName>Core_Goal_CleanOppAtApproval</fullName>
        <field>Core_Goal_Opportunities_at_Approval__c</field>
        <name>Core_Goal_CleanOppAtApproval</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Null</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_MakeClaimDateBlank</fullName>
        <field>Core_Goal_Claim_Date__c</field>
        <name>Core_Goal_MakeClaimDateBlank</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Null</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_SetAcceptedDatetoNull</fullName>
        <field>Core_Goal_Accept_Date__c</field>
        <name>Core_Goal_SetAcceptedDatetoNull</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Null</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_Set_Approved_By_to_CurrentUser</fullName>
        <field>Core_Goal_Approved_By__c</field>
        <formula>$User.FirstName + &apos; &apos; + $User.LastName</formula>
        <name>Core_Goal_Set_Approved_By_to_CurrentUser</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_Set_Approved_By_to_Null</fullName>
        <field>Core_Goal_Approved_By__c</field>
        <name>Core_Goal_Set_Approved_By_to_Null</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Null</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_Set_Approved_Date_to_Null</fullName>
        <field>Core_Goal_Approved_Date__c</field>
        <name>Core_Goal_Set_Approved_Date_to_Null</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Null</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_Set_Approved_Date_to_Today</fullName>
        <field>Core_Goal_Approved_Date__c</field>
        <formula>TODAY()</formula>
        <name>Core_Goal_Set_Approved_Date_to_Today</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_Set_Status_to_Accepted</fullName>
        <field>Core_Goal_Status__c</field>
        <literalValue>Accepted</literalValue>
        <name>Core_Goal_Set_Status_to_Accepted</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_Set_Status_to_Approved</fullName>
        <field>Core_Goal_Status__c</field>
        <literalValue>Approved</literalValue>
        <name>Core_Goal_Set_Status_to_Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_Set_Status_to_Submitted</fullName>
        <field>Core_Goal_Status__c</field>
        <literalValue>Submitted</literalValue>
        <name>Core_Goal_Set_Status_to_Submitted</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_UpdateAcceptedDate</fullName>
        <field>Core_Goal_Accept_Date__c</field>
        <formula>TODAY()</formula>
        <name>Core_Goal_UpdateAcceptedDate</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_UpdateStatus_Draft</fullName>
        <description>Update the status to draft</description>
        <field>Core_Goal_Status__c</field>
        <literalValue>Draft</literalValue>
        <name>Core_Goal_UpdateStatus_Draft</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_Update_Claim_Date</fullName>
        <field>Core_Goal_Claim_Date__c</field>
        <formula>TODAY()</formula>
        <name>Core_Goal_Update_Claim_Date</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Goal_cloneChangeStatus</fullName>
        <field>Core_Goal_Status__c</field>
        <literalValue>Draft</literalValue>
        <name>Core_Goal_cloneChangeStatus</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Core_Goal_OnCreateEdit_UpdateAcceptedDate</fullName>
        <actions>
            <name>Core_Goal_UpdateAcceptedDate</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Core_Goal__c.Core_Goal_Name__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Goal__c.Core_Goal_Status__c</field>
            <operation>equals</operation>
            <value>Accepted</value>
        </criteriaItems>
        <description>update the accepted date to the date when Status was changed to Accepted</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Core_Goal_OnCreateEdit_acceptedDateBlank</fullName>
        <actions>
            <name>Core_Goal_SetAcceptedDatetoNull</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Core_Goal__c.Core_Goal_Name__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Goal__c.Core_Goal_Status__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Goal__c.Core_Goal_Status__c</field>
            <operation>equals</operation>
            <value>Draft,Cancelled</value>
        </criteriaItems>
        <description>when status changes to Draft clear out the Accepted date</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Core_Goal_OnCreate_UpdateStatus</fullName>
        <actions>
            <name>Core_Goal_UpdateStatus_Draft</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Core_Goal__c.Core_Goal_Name__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>update the status to Draft on creation of any deal win goal record</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
