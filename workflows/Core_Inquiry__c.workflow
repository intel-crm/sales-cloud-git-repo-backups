    <fieldUpdates>
        <fullName>Core_Update_Name</fullName>
        <description>This is to update the Inquiry name to Inquiry type of the record</description>
        <field>Name</field>
        <formula>TEXT(Core_Inquiry_Type_Pkt__c)</formula>
        <name>Core_Update_Name</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>update_Field</fullName>
        <field>Core_Inquiry_Notes_Txt__c</field>
        <formula>TEXT(123)</formula>
        <name>update Field</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Core_Inquiry_Asked_For_Lead_Follow_Up</fullName>
        <actions>
            <name>Core_Inquiry_Asked_For_Lead_Follow_Up</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <formula>Core_Lead_Inquiries__c != NULL &amp;&amp;
(OR(
ISPICKVAL( Core_Inquiry_Type_Pkt__c , &apos;Asked for Follow-up&apos;),
ISPICKVAL( Core_Inquiry_Type_Pkt__c , &apos;Requested Quote&apos;),
ISPICKVAL( Core_Inquiry_Type_Pkt__c , &apos;Sales Approved&apos;)
)) &amp;&amp; Core_Lead_Contact_Owner_Email__c != NULL</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Core_Inquiry_Entrance_Date_New</fullName>
        <actions>
            <name>Core_Inquiry_Entrance_Date_New</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>AND ( ISCHANGED( Core_Inquiry_Status_Pkt__c ), ISPICKVAL(Core_Inquiry_Status_Pkt__c , &quot;New&quot;), ISPICKVAL(PRIORVALUE(Core_Inquiry_Status_Pkt__c ), &quot;Reviewed&quot;) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Core_Inquiry_Entrance_Date_Reviewed</fullName>
        <actions>
            <name>Core_Inquiry_Entrance_Date_Reviewed</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>AND ( ISCHANGED( Core_Inquiry_Status_Pkt__c ), ISPICKVAL(Core_Inquiry_Status_Pkt__c , &quot;Reviewed&quot;), ISPICKVAL(PRIORVALUE(Core_Inquiry_Status_Pkt__c ), &quot;New&quot;) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Core_Inquiry_Status_On_Creation</fullName>
        <actions>
            <name>Core_Inquiry_Entrance_Date_New_Record</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Core_Inquiry_Record_Creation_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Core_Inquiry_Record_Creation_Status</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Core_Inquiry__c.Core_Inquiry_Date_Dte__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Core_Inquiry_name_update</fullName>
        <actions>
            <name>Core_Update_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>Evaluate the rule when a record is created, and every time it&apos;s edited</description>
        <formula>OR(
Core_Lead_Inquiries__c &lt;&gt; NULL,
Core_Contact_Inquiries__c &lt;&gt; NULL
)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>test Inquiry</fullName>
        <actions>
            <name>update_Field</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Core_Inquiry__c.Core_Inquiry_Type_Pkt__c</field>
            <operation>equals</operation>
            <value>Requested Quote</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Inquiry__c.Core_Inquiry_Type_Pkt__c</field>
            <operation>equals</operation>
            <value>Sales Approved</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
