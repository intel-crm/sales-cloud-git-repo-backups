<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Core_SM_Rejection_Notification</fullName>
        <description>Core_SM_Rejection_Notification</description>
        <protected>false</protected>
        <recipients>
            <field>Core_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>test_m/Core_Rejection_Notification_Solution_Milestone</template>
    </alerts>
    <fieldUpdates>
        <fullName>Core_SM_Set_Approved_By_to_CurrentUser</fullName>
        <description>Sets the &apos;Approved By&apos; field to CURRENT_USER</description>
        <field>Core_Approved_By__c</field>
        <formula>$User.FirstName  +  &apos; &apos; + $User.LastName</formula>
        <name>Core_SM_Set_Approved_By_to_CurrentUser</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_Set_Approved_By_to_Null</fullName>
        <description>Sets the &apos;Approved By&apos; field to NULL</description>
        <field>Core_Approved_By__c</field>
        <name>Core_SM_Set_Approved_By_to_Null</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Null</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_Set_Approved_Date_to_Null</fullName>
        <description>Sets the &apos;Milestone Approved Date&apos; field to NULL</description>
        <field>Core_Milestone_Approved_Date__c</field>
        <name>Core_SM_Set_Approved_Date_to_Null</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Null</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_Set_Approved_Date_to_Today</fullName>
        <description>Sets the &apos;Milestone Approved Date&apos; field to TODAY</description>
        <field>Core_Milestone_Approved_Date__c</field>
        <formula>TODAY()</formula>
        <name>Core_SM_Set_Approved_Date_to_Today</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_Set_Claim_Date_to_Null</fullName>
        <description>Sets the &apos;Milestone Claim Date&apos; field to NULL</description>
        <field>Core_Milestone_Claim_Date__c</field>
        <name>Core_SM_Set_Claim_Date_to_Null</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Null</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_Set_Claim_Date_to_Today</fullName>
        <description>Sets the &apos;Milestone Claim Date&apos; field to TODAY</description>
        <field>Core_Milestone_Claim_Date__c</field>
        <formula>TODAY()</formula>
        <name>Core_SM_Set_Claim_Date_to_Today</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_Set_Status_to_Approved</fullName>
        <description>Sets the &apos;Status&apos; field to &apos;Approved&apos;</description>
        <field>Core_Status__c</field>
        <literalValue>Approved</literalValue>
        <name>Core_SM_Set_Status_to_Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_Set_Status_to_Pending</fullName>
        <description>Sets the &apos;Status&apos; field to &apos;Pending&apos;</description>
        <field>Core_Status__c</field>
        <literalValue>Pending</literalValue>
        <name>Core_SM_Set_Status_to_Pending</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_Set_Status_to_Submitted</fullName>
        <description>Sets the &apos;Status&apos; field to &apos;Submitted for Approval&apos;</description>
        <field>Core_Status__c</field>
        <literalValue>Submitted for Approval</literalValue>
        <name>Core_SM_Set_Status_to_Submitted</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_reset_Commissionable</fullName>
        <field>Core_Approved_Milestone_Commissionable__c</field>
        <name>Core_SM_reset_Commissionable</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Null</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_SM_set_Commissiionable</fullName>
        <field>Core_Approved_Milestone_Commissionable__c</field>
        <formula>TEXT(Core_Milestone_Commissionable__c)</formula>
        <name>Core_SM_set_Commissiionable</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <flowActions>
        <fullName>Core_SM_Clone_Milestone_Owner</fullName>
        <description>Flow trigger is called to update the owner of a Opportunity Milestone to Cloner not the user who created the original milestone. This will help in proper flow of the commissions to the new user who clones the milestone.</description>
        <flow>Core_Flow_ClonedMilestoneOwner</flow>
        <flowInputs>
            <name>ClonerId</name>
            <value>{!$User.Id}</value>
        </flowInputs>
        <flowInputs>
            <name>MilestoneId</name>
            <value>{!Id}</value>
        </flowInputs>
        <label>Core_SM_Clone_Milestone_Owner</label>
        <language>en_US</language>
        <protected>false</protected>
    </flowActions>
    <flowActions>
        <fullName>Core_SM_Default_Milestone_Owner</fullName>
        <flow>DefaultSolutionMilestoneOwner</flow>
        <flowInputs>
            <name>CreatedBy</name>
            <value>{!$User.Id}</value>
        </flowInputs>
        <flowInputs>
            <name>MilestoneID</name>
            <value>{!Id}</value>
        </flowInputs>
        <label>Core_SM_Default_Milestone_Owner</label>
        <language>en_US</language>
        <protected>false</protected>
    </flowActions>
    <rules>
        <fullName>Core_SM_Default_Milestone_Owner</fullName>
        <actions>
            <name>Core_SM_Default_Milestone_Owner</name>
            <type>FlowAction</type>
        </actions>
        <active>true</active>
        <description>Populate Solution Milestone Owner (Default to the current user)</description>
        <formula>Core_Opportunity__r.Name != &apos;&apos; &amp;&amp; !ISCLONE()</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Core_SM_Make_Owner_Of_A_Cloned_Milestone_the_Cloner</fullName>
        <actions>
            <name>Core_SM_reset_Commissionable</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Core_SM_Clone_Milestone_Owner</name>
            <type>FlowAction</type>
        </actions>
        <active>true</active>
        <description>When a user clones a milestone, s/he becomes the owner of the newly created milestone automatically.</description>
        <formula>ISCLONE()</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Core_SM_New_Milestone</fullName>
        <actions>
            <name>Core_SM_Set_Status_to_Pending</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Core_Solution_Milestone__c.CreatedById</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>Sets the initial Status to Pending</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Core_SM_Status_Changed_to_Cancelled</fullName>
        <actions>
            <name>Core_SM_Set_Approved_By_to_Null</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Core_SM_Set_Approved_Date_to_Null</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Core_SM_Set_Claim_Date_to_Today</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Core_SM_reset_Commissionable</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Core_Solution_Milestone__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>Cancelled</value>
        </criteriaItems>
        <description>Sets the Claim Date to Today. Resets the Approved Date, Approved By.</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Core_SM_Status_Changed_to_Pending</fullName>
        <actions>
            <name>Core_SM_Set_Approved_By_to_Null</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Core_SM_Set_Approved_Date_to_Null</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Core_SM_Set_Claim_Date_to_Null</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Core_SM_reset_Commissionable</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Core_Solution_Milestone__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>Pending</value>
        </criteriaItems>
        <description>Resets the Claim Date, Approved Date, Approved By.</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
