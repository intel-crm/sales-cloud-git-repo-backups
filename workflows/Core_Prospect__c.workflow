    <rules>
        <fullName>Core_Assign_Prospect_To_Queue</fullName>
        <actions>
            <name>Core_Assign_to_Queue</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <failedMigrationToolVersion>238.8.2</failedMigrationToolVersion>
