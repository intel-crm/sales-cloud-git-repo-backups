<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Pricing_SW_10DaysRemainder</fullName>
        <description>Pricing_SW_10DaysRemainder</description>
        <protected>false</protected>
        <recipients>
            <field>Pricing_sw_Quote_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderAddress>wsm-postmaster@intel.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>Pricing_SW_Email_Templates/Pricing_SW_ExpiryIn10days</template>
    </alerts>
    <alerts>
        <fullName>Pricing_SW_14DaysRemainder</fullName>
        <description>Pricing_SW_14DaysRemainder</description>
        <protected>false</protected>
        <recipients>
            <field>Pricing_sw_Quote_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderAddress>wsm-postmaster@intel.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>Pricing_SW_Email_Templates/Pricing_SW_ExpiryIn14days</template>
    </alerts>
    <alerts>
        <fullName>Pricing_SW_3DaysRemainder</fullName>
        <description>Pricing_SW_3DaysRemainder</description>
        <protected>false</protected>
        <recipients>
            <field>Pricing_sw_Quote_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderAddress>wsm-postmaster@intel.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>Pricing_SW_Email_Templates/Pricing_SW_ExpiryIn3days</template>
    </alerts>
    <alerts>
        <fullName>Pricing_SW_7DaysRemainder</fullName>
        <description>Pricing_SW_7DaysRemainder</description>
        <protected>false</protected>
        <recipients>
            <field>Pricing_sw_Quote_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderAddress>wsm-postmaster@intel.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>Pricing_SW_Email_Templates/Pricing_SW_ExpiryIn7days</template>
    </alerts>
    <alerts>
        <fullName>Pricing_SW_quote_denied_notifications</fullName>
        <description>Pricing SW quote denied notification</description>
        <protected>false</protected>
        <recipients>
            <field>Pricing_sw_Quote_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderAddress>wsm-postmaster@intel.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>Pricing_SW_Email_Templates/Pricing_SW_QuoteExpiredNotification</template>
    </alerts>
    <rules>
        <fullName>Notify CP Quote Owner prior to expiry date</fullName>
        <active>false</active>
        <criteriaItems>
            <field>SBQQ__Quote__c.core_cpq_quote_type_nm__c</field>
            <operation>equals</operation>
            <value>Contract Pricing</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.core_cpq_active_cb__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__Status__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <description>Send email to quote owner whenever contract pricing quote is nearing to expiry date</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <offsetFromField>SBQQ__Quote__c.core_cpq_pricing_end_date_dt__c</offsetFromField>
            <timeLength>-10</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
        <workflowTimeTriggers>
            <offsetFromField>SBQQ__Quote__c.core_cpq_pricing_end_date_dt__c</offsetFromField>
            <timeLength>-40</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Send email to sos when quote is created by disty</fullName>
        <active>false</active>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__Status__c</field>
            <operation>equals</operation>
            <value>New</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.core_cpq_requestor_nm__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.core_cpq_send_email__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.core_cpq_origin_txt__c</field>
            <operation>contains</operation>
            <value>Disty</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
