<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Core_AAQ_Closed_Email_to_Submitter</fullName>
        <description>Core_AAQ_Closed_Email_to_Submitter</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <recipients>
            <field>Core_Support_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>test_m/Core_Support_Request_Closed_Status_Email_Alert_to_Submitter</template>
    </alerts>
    <alerts>
        <fullName>Core_AAQ_In_Progress_Email_to_Submitter</fullName>
        <description>Core_AAQ_In_Progress_Email_to_Submitter</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <recipients>
            <field>Core_Support_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>test_m/Core_Support_Request_In_Progress_Status_Email_Alert_to_Submitter</template>
    </alerts>
    <alerts>
        <fullName>Core_AAQ_New_Support_Request_Email_to_Submitter</fullName>
        <description>Core_AAQ_New_Support_Request_Email_to_Submitter</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>test_m/Core_Support_Request_New_Status_Email_Alert_to_Submitter</template>
    </alerts>
    <alerts>
        <fullName>Core_AAQ_On_Hold_Email_to_Submitter</fullName>
        <description>Core_AAQ_On_Hold_Email_to_Submitter</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <recipients>
            <field>Core_Support_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>test_m/Core_Support_Request_On_Hold_Status_Email_Alert_to_Submitter</template>
    </alerts>
    <alerts>
        <fullName>Core_AAQ_On_Support_Owner_Update_Email_to_New_Owner</fullName>
        <description>Core_AAQ_On_Support_Owner_Update_Email_to_New_Owner</description>
        <protected>false</protected>
        <recipients>
            <field>Core_Support_Owner__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Core_MDF/Core_Support_Request_Support_Owner_Change_Email_Alert_to_New_Owner</template>
    </alerts>
    <rules>
        <fullName>Core_AAQ_Closed_Status</fullName>
        <actions>
            <name>Core_AAQ_Closed_Email_to_Submitter</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Core_Ask_A_Question__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>Closed</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Core_AAQ_In_Progress_Status</fullName>
        <actions>
            <name>Core_AAQ_In_Progress_Email_to_Submitter</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Core_Ask_A_Question__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>In Progress</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Core_AAQ_New_Status</fullName>
        <actions>
            <name>Core_AAQ_New_Support_Request_Email_to_Submitter</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Core_Ask_A_Question__c.OwnerId</field>
            <operation>notEqual</operation>
            <value>Support Requests</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Core_AAQ_On_Hold_Status</fullName>
        <actions>
            <name>Core_AAQ_On_Hold_Email_to_Submitter</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Core_Ask_A_Question__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>On Hold</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Core_AAQ_On_Support_Owner_Change</fullName>
        <actions>
            <name>Core_AAQ_On_Support_Owner_Update_Email_to_New_Owner</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <formula>AND(NOT(ISBLANK(Core_Support_Owner__c)), ISCHANGED(Core_Support_Owner__c))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
