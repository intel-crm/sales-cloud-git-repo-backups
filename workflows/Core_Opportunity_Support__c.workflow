<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>CRM_Sending_Email_On_creation_of_Opportunity_support</fullName>
        <description>Sending Email On creation of Opportunity support</description>
        <protected>false</protected>
        <recipients>
            <recipient>Opportunity_Support_email_alert</recipient>
            <type>group</type>
        </recipients>
        <senderAddress>wsm-postmaster@intel.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>unfiled$public/Marketing_Support_Request_Submitted</template>
    </alerts>
    <alerts>
        <fullName>Core_Email_on_Rejection_Opportunity_Support</fullName>
        <description>Email to be sent to Approvers once the opportunity is Rejected</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <recipients>
            <type>owner</type>
        </recipients>
        <recipients>
            <field>Core_Approver_1__c</field>
            <type>userLookup</type>
        </recipients>
        <recipients>
            <field>Core_Approver_2__c</field>
            <type>userLookup</type>
        </recipients>
        <recipients>
            <field>Core_Approver_3__c</field>
            <type>userLookup</type>
        </recipients>
        <recipients>
            <field>Core_Approver_4__c</field>
            <type>userLookup</type>
        </recipients>
        <recipients>
            <field>Core_Approver_5__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>unfiled$public/Core_Opportunity_Support_Rejection_Email_Template</template>
    </alerts>
