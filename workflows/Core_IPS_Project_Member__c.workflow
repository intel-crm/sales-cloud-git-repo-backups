    <fieldUpdates>
        <fullName>Core_IPS_setProvisioningDate_Null</fullName>
        <description>Sets the Provisioning Date to Null</description>
        <field>Core_IPS_Provisioning_Date__c</field>
        <name>Core_IPS_setProvisioningDate_Null</name>
        <notifyAssignee>false</notifyAssignee>
