<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Account_Team_Approval_Notification_to_the_requester</fullName>
        <description>Account Team Approval Notification to the requester</description>
        <protected>false</protected>
        <recipients>
            <field>Core_Requestor__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>test_m/Account_Team_Request_Approval</template>
    </alerts>
    <alerts>
        <fullName>Account_Team_Rejection_Notification_to_the_requester</fullName>
        <description>Account Team Rejection Notification to the requester</description>
        <protected>false</protected>
        <recipients>
            <field>Core_Requestor__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>test_m/Account_Team_Request_Rejection</template>
    </alerts>
    <alerts>
        <fullName>Core_Change_Request_Territory_Notification</fullName>
        <description>Core_Change_Request_Territory_Notification</description>
        <protected>false</protected>
        <senderType>DefaultWorkflowUser</senderType>
        <template>test_m/Core_Territory_Request_Notification</template>
    </alerts>
    <alerts>
        <fullName>Core_Change_Request_Update</fullName>
        <description>Core_Change_Request_Update</description>
        <protected>false</protected>
        <recipients>
            <type>accountOwner</type>
        </recipients>
        <recipients>
            <type>creator</type>
        </recipients>
        <recipients>
            <field>LastModifiedById</field>
            <type>userLookup</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>test_m/Change_Request_Update</template>
    </alerts>
    <alerts>
        <fullName>Core_Change_Request_to_Data_Ops</fullName>
        <description>Core_Change_Request_to_Data_Ops</description>
        <protected>false</protected>
        <senderType>DefaultWorkflowUser</senderType>
        <template>test_m/New_Account_Creation_Data_Ops</template>
    </alerts>
    <fieldUpdates>
        <fullName>Core_Change_Request_Account_Owner_Submit</fullName>
        <description>Account Owner saves CR record, auto submitted to DG</description>
        <field>Core_Status__c</field>
        <literalValue>Submitted to Data Governance</literalValue>
        <name>Core_Change_Request_Account_Owner_Submit</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Change_Request_Status_Approved</fullName>
        <field>Core_Status__c</field>
        <literalValue>Approved</literalValue>
        <name>Core_Change_Request_Status_Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Change_Request_Status_Data_Governan</fullName>
        <field>Core_Status__c</field>
        <literalValue>Submitted to Data Governance</literalValue>
        <name>Core_Change_Request_Status_Data_Governan</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Core_Change_Request_Status_Rejected</fullName>
        <field>Core_Status__c</field>
        <literalValue>Rejected</literalValue>
        <name>Core_Change_Request_Status_Rejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Core_Change_Request_Owner_Change</fullName>
        <actions>
            <name>Core_Change_Request_Account_Owner_Submit</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>User.Core_Account_Owner__c</field>
            <operation>equals</operation>
            <value>TRUE</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Core_Change_Request_Territory_Request</fullName>
        <actions>
            <name>Core_Change_Request_Territory_Notification</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Core_Change_Request__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>Update Territory Request</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Core_Change_Request_Update</fullName>
        <actions>
            <name>Core_Change_Request_Update</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Core_Change_Request__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Change_Request__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
