    <labels>
        <fullName>Core_IntegrationReportMsgBody</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Core_IntegrationReportMsgBody</shortDescription>
        <value>&lt;p&gt;&lt;strong style=&quot;color: rgb(0, 112, 192);&quot;&gt;Monitoring Report: A&amp;amp;E integration monitoring report and the failures impacting contact entitlement assignment and user access.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Following is the gist of the current ERPM/AGS Integration status&apos; of contacts that went through the integration during past reportDays days.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;Org: CloudCRM - DevINT&lt;/span&gt;&lt;/p&gt;&lt;p&gt;reportGist&lt;/p&gt;&lt;p&gt;Following error have been recorded in this period from ERPM/AGS Integration failures. &lt;span style=&quot;font-family: Calibri, sans-serif; font-size: 11pt;&quot;&gt;Please go through the details of the attachment and take appropriate action.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Errors:&lt;/p&gt;&lt;p&gt;ErrorName&lt;/p&gt;&lt;p&gt;&lt;em&gt;This is an auto-generated email from A&amp;amp;E team, if any questions please contact &lt;/em&gt;&lt;a href=&quot;mailto:team.draco@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;team.draco@intel.com&lt;/em&gt;&lt;/a&gt;&lt;em&gt; &lt;/em&gt;&lt;/p&gt;</value>
    </labels>
