    </labels>
    <labels>
        <fullName>Core_MAG_Q3</fullName>
        <categories>Core_MAGQuestionnaireController</categories>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Core_MAG_Q3</shortDescription>
        <value>3. Does this opportunity include technical support such as design-in, co-development, design reviews, schematic reviews, layout reviews, “bring-up”, troubleshooting, bug fixes, software optimization, hardware integration, performance analysis, testing, etc.? Enter Yes or No</value>
    </labels>
    <labels>
