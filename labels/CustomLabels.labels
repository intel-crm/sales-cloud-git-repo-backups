        <value>SELECT Id, Sales_License_Activation_Code__c, Sales_License_Product__c, Sales_License_Product__r.Name, Sales_License_Maintenance_Exp_Dt__c, Sales_License_Host_Node_Id__r.Sales_Computer_Name_Txt__c, Sales_License_Order__r.Sales_Order_Reason__c, Sales_License_Primary_Admin_Contact__c, Sales_License_Web_Display_Flag__c, Sales_License_Product__r.Core_Product_Ext_Attribute_Id__r.Core_Prod_Tool_Type_Nm__c,
Sales_License_Expiration_Date_Dt__c, Sales_License_Lic_User_Contact_ID__c, Sales_License_Status__c, Sales_Tool_License_Type__c,                                             Sales_License_Order_Product__r.Product2.Core_Product_Ext_Attribute_Id__r.Core_SW_Prod_Expiration_Duration_Nbr__c,                                           Sales_License_Order_Product__r.Product2.Core_Product_Ext_Attribute_Id__r.Core_SW_Lic_Maintenance_Duration_Nbr__c,   Sales_License_Order_Product__r.Product2.Core_Product_Ext_Attribute_Id__r.Core_SW_Prod_Temporary_Lic_Allowed_Ind__c,</value>
