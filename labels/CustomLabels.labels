    <labels>
        <fullName>Core_MAG_Q5</fullName>
        <categories>Core_MAGQuestionnaireController</categories>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Core_MAG_Q5</shortDescription>
        <value>5. Does this opportunity include collateral for the End Customer that is new, unique, exclusive, or purpose-built, such as item information or software not available to other item users, electronic design kits modified for this opportunity, features designed for this opportunity, etc.? Enter Yes or No</value>
    </labels>
    <labels>
