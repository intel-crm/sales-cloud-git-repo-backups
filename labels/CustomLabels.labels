        <value>SELECT Name,SBQQ__Product__c,SBQQ__Quote__r.Name,Pricing_End_Date_dt__c,Pricing_Quote_Line_Number__c,Pricing_Processor_Number_Nm__c,Pricing_Other_Product_Nm__c,Pricing_OEM_System_Model_Nm__c,Pricing_Single_System_Price_Amt__c,Pricing_OEM_Standard_Unit_Price_Amt__c,Pricing_Req_Discounted_Unit_Price__c,Pricing_Consumption_Platform__c,Pricing_Consumption_Sale_Geo__c,Pricing_Consumption_Country__c,Pricing_Consumption_Region__c,Pricing_Competitor_OEM_Nm__c,Pricing_Competitor_System_Model_Nm__c,Pricing_Competetor_Product__r.Name,Pricing_Other_Competitor_Product_Nm__c,Pricing_Comp_Unit_Price_Amt__c,Pricing_Product_Nm__c,SBQQ__ProductName__c,Pricing_Status_Nm__c,Pricing_Approved_Start_Date_Dup_Dt__c,Pricing_Approved_End_Date_Dup_Dt__c,Pricing_Approved_Unit_Dup_Qty__c,Pricing_ECAP_Price_Dup_Amt__c,Pricing_Revised_Pricing_Start_Date_D_dt__c,Pricing_Billing_End_Date_Dt__c,Pricing_Billing_Start_Date_Dt__c,Pricing_Form_Factor_Nm__c,Pricing_Performance_Metric_Nm__c,pricing_core_count__c,</value>
