    <labels>
        <fullName>Pricing_RestAPI_ClientGetQuoteLineQuery1</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Get Client QuoteLine Query</shortDescription>
        <value>SELECT Name,SBQQ__Product__c,SBQQ__Quote__r.Name,Pricing_End_Date_dt__c,Pricing_Quote_Line_Number__c,Pricing_Processor_Number_Nm__c,Pricing_Other_Product_Nm__c,Pricing_OEM_System_Model_Nm__c,Pricing_Single_System_Price_Amt__c,Pricing_OEM_Standard_Unit_Price_Amt__c,Pricing_Req_Discounted_Unit_Price__c,Pricing_Consumption_Platform__c,Pricing_Consumption_Sale_Geo__c,Pricing_Consumption_Country__c,Pricing_Consumption_Region__c,Pricing_Competitor_OEM_Nm__c,Pricing_Competitor_System_Model_Nm__c,Pricing_Competetor_Product__r.Name,Pricing_Other_Competitor_Product_Nm__c,Pricing_Comp_Unit_Price_Amt__c,Pricing_Product_Nm__c,SBQQ__ProductName__c,Pricing_Status_Nm__c,Pricing_Approved_Start_Date_Dup_Dt__c,Pricing_Approved_End_Date_Dup_Dt__c,Pricing_Approved_Unit_Dup_Qty__c,Pricing_ECAP_Price_Dup_Amt__c,Pricing_Revised_Pricing_Start_Date_D_dt__c,Pricing_Billing_End_Date_Dt__c,Pricing_Billing_Start_Date_Dt__c,Pricing_Form_Factor_Nm__c,Pricing_Performance_Metric_Nm__c,pricing_core_count__c,</value>
    </labels>
    <labels>
        <fullName>Pricing_RestAPI_ClientGetQuoteLineQuery2</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Get Client QuoteLine Query2</shortDescription>
        <value>Pricing_Total_Volume_Qty__c,Pricing_Ready_for_Review_cb__c,Pricing_Additional_Comments_Txt__c,Pricing_Unit_Qty__c,Pricing_Additional_T_C_s_Txt__c,Pricing_Request_Discount_Unit_Price_qty__c,Pricing_comp_Product_Provider_nm__c,Pricing_Change_Request_cb__c,Pricing_Deal_RFQ_Dup_Id__c,Pricing_New_Quantity_qty__c,Pricing_Last_Submitted_Date_dt__c,Pricing_Last_Approved_Date_dt__c,Pricing_Last_Submitted_By_Id__c,Pricing_Last_Submitted_By_Id__r.Name,Pricing_Reference_Quote_Line_Nbr__c,Pricing_Reference_Quote_Line_Nbr__r.Pricing_Quote_Line_Number__c,SBQQ__Quote__c,Pricing_New_Change_Request_cb__c,Pricing_Program_Type_Nm__c,Pricing_Write_In_Performance_Metric_Nm__c,Pricing_Intel_SKU_Performance_Nbr__c,Pricing_Comp_SKU_Performance_Nbr__c,Pricing_Rejection_Reason__c,CreatedBy.Email,Pricing_Lost_Reason_Nm__c,Pricing_Rejection_Comments_nm__c,Pricing_Start_Date_dt__c,Pricing_Consumption_Segment__c,pricing_TDP__c FROM SBQQ__QuoteLine__c WHERE id =:quoteLineId {{accCheck}} order by CreatedDate asc</value>
    </labels>
    <labels>
        <fullName>Pricing_RestAPI_ClientGetQuoteLineQuery3</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Get Client QuoteLine Query3</shortDescription>
        <value>Pricing_Original_Submitted_Date_dt__c,Pricing_Payable_Quantity__c,SBQQ__Source__c,</value>
    </labels>
    <labels>
        <fullName>Pricing_RestAPI_CommentCodes_Query</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Pricing_RestAPI_CommentCodes_Query</shortDescription>
        <value>Select Pricing_Question__c, Label,Pricing_Answer__c, Pricing_Business_Unit__c, Pricing_Comment_Ref_Id__c, Pricing_Required_Ind__c from Core_CPQ_Tender_Comments__mdt ORDER BY Label</value>
    </labels>
    <labels>
        <fullName>Pricing_RestAPI_Competitor_Prodcuts_Query</fullName>
        <categories>IQR</categories>
        <language>en_US</language>
        <protected>false</protected>
