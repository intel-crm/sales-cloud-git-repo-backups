    <labels>
        <fullName>Pricing_QuoteLine_AutoRejection_Query</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Pricing_QuoteLine_AutoRejection_Query</shortDescription>
        <value>SELECT Id,Pricing_Status_Nm__c,Pricing_Reference_Quote_Line_Nbr__c, SBQQ__Quote__c, Pricing_Last_Submitted_Date_dt__c,Pricing_Change_Request_cb__c,Pricing_pm_approval_comments_nm__c,Pricing_Rejection_Comments_nm__c,Pricing_Rejection_Reason__c FROM SBQQ__QuoteLine__c  WHERE SBQQ__Quote__r.Pricing_Bid_Dt__c &lt; LAST_N_DAYS:180 AND Pricing_Last_Submitted_Date_dt__c &lt; LAST_N_DAYS:180 AND Pricing_Quote_Program_Nm__c = &apos;Tender&apos; AND (Pricing_Status_Nm__c= &apos;Pending Intel Field Review&apos; OR Pricing_Status_Nm__c=&apos;Pending Further Intel Review&apos;) AND Pricing_Integration_Status_Nm__c = &apos;&apos; ORDER By SBQQ__Quote__c</value>
    </labels>
