    <labels>
        <fullName>Sales_Email_Failure_Body</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Sales_Email_Failure_Body</shortDescription>
        <value>&lt;html&gt;&lt;body&gt;&lt;table style=&quot;background-color:#0071c5;&quot; width=&quot;75%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;padding-left:30px; padding-top:15px;border: 10px;border:none;&quot;&gt;&lt;div style=&quot;color:white; &quot;&gt;
&lt;h1  style =&quot;font-family: Arial,Helvetica,sans-serif; font-size: 30px; font-weight: 400;&quot;&gt;Order Sync Failed &lt;/h1&gt;&lt;/div&gt;&lt;/td&gt;  
&lt;td align=&quot;right&quot; style=&quot;border:none;padding-right:25px;&quot;&gt;&lt;img src=&quot;{0}&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;br&gt;&lt;/br&gt;  
&lt;table width=&quot;75%&quot; style=&quot;border-collapse: collapse;fontStyle&quot;&gt;&lt;tr&gt;&lt;td style=&quot;borderStyle&quot;&gt;
&lt;p&gt;We would like to inform you that your order has failed to update from SAP to Salesforce. Due to this failure this order is currently in read only mode. The relevant IT team has been notified to take corrective action for the same.&lt;/p&gt;
&lt;p&gt;Please note that at this point there is no action to be taken on your part. IT will send you an update once the issue has been rectified and this order record has been updated with the relevant information from SAP.&lt;/p&gt;
&lt;/table&gt;&lt;/body&gt;&lt;/html&gt;</value>
    </labels>
    <labels>
        <fullName>Sales_Email_Failure_Body1</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Sales_Email_Failure_Body1</shortDescription>
        <value>&lt;html&gt;&lt;body&gt;
&lt;p&gt;Following are the order details:&lt;/p&gt;
&lt;ul style=&quot;font-size: 15px;&quot;&gt;
&lt;li style=&quot;font-size: 15px;&quot;&gt;Order Number: {2}&lt;/li&gt;
&lt;li style=&quot;font-size: 15px;&quot;&gt;Account Name: {1}&lt;/li&gt;&lt;/ul&gt;
&lt;table width=&quot;75%&quot; style=&quot;border-collapse: collapse;fontStyle&quot;&gt;&lt;tr&gt;&lt;td style=&quot;borderStyle&quot;&gt;
&lt;p&gt;&lt;b&gt;NOTE : If this issue is not resolved in the next 24 hours, please submit a ticket at &lt;/b&gt;&lt;a href=&quot;https://intel.service-now.com/aem?id=aem_create_incident&amp;route=ea4ca1021b37c15035ffb912cd4bcbf0&quot;&gt;it.intel.com&lt;/a&gt;&lt;/p&gt;
&lt;p&gt;Regards,&lt;br&gt;Intel IT&lt;/p&gt;
&lt;/table&gt;&lt;/body&gt;&lt;/html&gt;</value>
    </labels>
    <labels>
        <fullName>Sales_Email_Failure_Subject</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Sales Email Failure Subject</shortDescription>
        <value>Order Sync Failed</value>
    </labels>
    <labels>
        <fullName>Sales_Email_Failure_Subject1</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Sales_Email_Failure_Subject1</shortDescription>
        <value>PSG Order &amp; Licensing - Order Sync Failed Order Number:</value>
    </labels>
    <labels>
        <fullName>Sales_Email_Sync_Failure_Body</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Sales Email Sync Failure Body</shortDescription>
        <value>&lt;html&gt;&lt;body&gt;&lt;table style=&quot;background-color:#0071c5;&quot; width=&quot;75%&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;padding-left:30px; padding-top:15px;border: 10px;border:none;&quot;&gt;&lt;div style=&quot;color:white; &quot;&gt;  
&lt;h1  style =&quot;font-family: Arial,Helvetica,sans-serif; font-size: 30px; font-weight: 400;&quot;&gt;Order Sync Failed &lt;/h1&gt;&lt;/div&gt;&lt;/td&gt;  
&lt;td align=&quot;right&quot; style=&quot;border:none;padding-right:25px;&quot;&gt;&lt;img src=&quot;{0}&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;br&gt;&lt;/br&gt;  
&lt;/body&gt;&lt;/html&gt;</value>
    </labels>
    <labels>
        <fullName>Sales_Email_Sync_Failure_Body1</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Sales Email Sync Failure Body1</shortDescription>
        <value>&lt;html&gt;&lt;body&gt;&lt;table width=&quot;75%&quot; style=&quot;border-collapse: collapse;fontStyle&quot;&gt;&lt;tr&gt;&lt;td style=&quot;borderStyle&quot;&gt;      
&lt;p&gt;This notice is to inform you that your order sync from SAP to Salesforce has failed.&lt;/p&gt;  &lt;/body&gt; &lt;/html&gt;
&lt;ul style=&quot;font-size: 15px;&quot;&gt;   
&lt;li style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Account Name: &lt;/b&gt;{1}&lt;/li&gt;   
&lt;li style=&quot;font-size: 15px;&quot;&gt;Order Number &lt;b&gt;{2}&lt;/b&gt; has failed to sync due to the error - {3}.&lt;/li&gt;&lt;/ul&gt;   
&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;For support from IT, please submit a ticket via &lt;a href=&quot;https://intel.service-now.com/aem?id=aem_create_incident&amp;route=ea4ca1021b37c15035ffb912cd4bcbf0&quot;&gt;it.intel.com&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt; 
&lt;/table&gt;</value>
    </labels>
