    <labels>
        <fullName>Sales_ChatbotLicenseQuery2</fullName>
        <categories>Sales</categories>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Sales_ChatbotLicenseQuery2</shortDescription>
        <value>Sales_License_Product__r.SBQQ__SubscriptionTerm__c,
Sales_License_Order_Product__r.Product2.Core_Product_Ext_Attribute_Id__r.Core_SW_Prod_Max_Rehost_Cnt__c,                                        Sales_License_Order_Product__r.Product2.Core_Product_Ext_Attribute_Id__r.Core_SW_Lic_Rehostable_Ind__c,Sales_License_Order_Product__r.SBQQ__SubscriptionTerm__c,                                         Sales_License_Avbl_Rehost_Nbr__c,Sales_License_Available_Temp_Licenses__c,Sales_License_Quantity__c, Sales_License_Product_OPN__c
FROM Sales_License__c where Sales_License_Activation_Code__c in :licenseActivationCodeSet</value>
    </labels>
