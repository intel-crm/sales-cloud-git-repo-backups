        <value>CreatedBy.Name,CreatedDate,LastModifiedBy.Name,LastModifiedDate,(SELECT id,Product2.Name,Core_Design_Registration_Product_Id__c,TotalPrice,Core_Status__c,Quantity,Core_Competitor__c,Core_Competitor_Product__c,UnitPrice,Core_Loss_Cancel_Reason__c,CreatedBy.Name,CreatedDate,LastModifiedBy.Name,LastModifiedDate from OpportunityLineItems) from Opportunity where id =:opportunityId</value>
