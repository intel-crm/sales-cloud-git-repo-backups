    <labels>
        <fullName>Core_MDF_ClaimEzy_Prompt1</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Core_MDF_ClaimEzy_Prompt1</shortDescription>
        <value>{&quot;messages&quot;: [{&quot;role&quot;: &quot;system&quot;,&quot;content&quot;:&quot;Please extract the following information from the provided invoice details. Ensure that the output format for each piece of information is as specified. Invoice information is provided in three backticks and if information not found return Not Provided for that attribute. If the currency code is not explicitly mentioned look for currency symbol before amount and get currency code accordingly. Invoice Amount should not include tax amount. Invoice number may also have been mentioned as Activity Number or Bill No in invoice information. Consider Tax attribute if tax is explicitly mentioned only. Invoice Information:&apos;&apos;&apos;{{{rawData}}}&apos;&apos;&apos;. If the information is not present in three backticks, don&apos;t generate any example information. Output Format:</value>
    </labels>
    <labels>
        <fullName>Core_MDF_ClaimEzy_Prompt2</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Core_MDF_ClaimEzy_Prompt2</shortDescription>
        <value>Invoice Number: XXX (Replace XXX with the generated Invoice number or &apos;Not Provided&apos; text)Invoice Amount: $11111 (Replace 11111 with the generated amount or &apos;Not Provided&apos; text)Invoice Date: DD/MM/YYYY (Replace DD with date,MM with month and YYYY with generated year or &apos;Not Provided&apos; text)Tax: $XXX (Replace XXX with the generated tax or &apos;Not Provided&apos; text)Currency Code: XXX(Replace XXX with the generated currency code or &apos;Not Provided&apos; text). All the amount fields should return in US amount format&quot;}],&quot;temperature&quot;: 0.7,&quot;top_p&quot;: 0.95,&quot;frequency_penalty&quot;: 0,&quot;presence_penalty&quot;: 0,&quot;max_tokens&quot;: 800,&quot;stop&quot;: null}</value>
    </labels>
