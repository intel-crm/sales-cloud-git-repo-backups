    </labels>
    <labels>
        <fullName>Sales_OrderProduct_Query2</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Sales_OrderProduct_Query2</shortDescription>
        <value>OriginalOrderItemId,SBQQ__QuoteLine__c,SBQQ__OrderedQuantity__c,Sales_Parent_Order_Item_Id_Txt__c, SBQQ__PriceDimension__c, SBQQ__PriceSchedule__c, SBQQ__PricingMethod__c, SBQQ__ProductSubscriptionType__c, SBQQ__ProrateMultiplier__c, Quantity, SBQQ__QuotedListPrice__c, SBQQ__QuotedQuantity__c,SBQQ__RequiredBy__c, SBQQ__RevisedOrderProduct__c, Sales_RU_Guard_Id_Txt__c, Sales_RU_Node_Id_Txt__c, Sales_SAP_LAC_Rule_Txt__c, SBQQ__SegmentIndex__c, SBQQ__SegmentKey__c, SBQQ__DimensionType__c, SBQQ__ShippingAccount__c,Sales_Status__c,SBQQ__Subscription__c,SBQQ__SubscriptionPricing__c,SBQQ__SubscriptionTerm__c,SBQQ__SubscriptionType__c,Sales_Suggested_Resale_Price__c,SBQQ__TaxCode__c,SBQQ__TermDiscountSchedule__c,SBQQ__TerminatedDate__c,TotalPrice, Order.SBQQ__Quote__c, Sales_Training_No_Txt__c,UnitPriceForceOverride__c,UnitPrice,SBQQ__UpgradedSubscription__c,PricebookEntryId FROM OrderItem WHERE Orderid = : originalRecId</value>
