        <value>SELECT id,name,stagename,Account.Name,Core_Opportunity_Owner_Geo__c,Core_Design_Registration_Id__c,Core_Design_Registration_Id__r.Name,CloseDate,Probability,Core_Opportunity_Type__c,Owner.Name,Core_Technical_Owner__r.Name,Core_Product_Segment__c,Core_Product_Application__c,Amount,Core_Consumption_Market__c,Core_Competitive_Architecture__c,Core_Status_Update__c,Core_Architecture_Conversion__c,Core_Loss_Cancel_Reason__c,Core_Loss_Cancel_Details__c,Description,Core_Intel_Platform__c,Core_Volume__c,Core_First_Customer_Ship_Date__c,Core_Production_End_Date__c,Core_Manufacturing_Geo__c,Core_Military_Aerospace_Govmt_End_Use__c,Core_Compliance_Comments__c,Core_Compliance_Status__c,Core_Compliance_Sub_Status__c,CreatedBy.Name,CreatedDate,LastModifiedBy.Name,LastModifiedDate from Opportunity where id =:opportunityId</value>
    </labels>
    <labels>
        <fullName>Core_RestAPI_OpportunityQuery</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Core RestAPI OpportunityQuery</shortDescription>
        <value>SELECT id,name,stagename,Account.Name,Core_Opportunity_Owner_Geo__c,Core_Design_Registration_Id__c,Core_Design_Registration_Id__r.Name,CloseDate,Probability,Core_Opportunity_Type__c,Owner.Name,Core_Technical_Owner__r.Name,Core_Product_Segment__c,Core_Product_Application__c,Amount,Core_Consumption_Market__c,Core_Competitive_Architecture__c,Core_Status_Update__c,Core_Architecture_Conversion__c,Core_Loss_Cancel_Reason__c,Core_Loss_Cancel_Details__c,Description,Core_Intel_Platform__c,Core_Volume__c,Core_First_Customer_Ship_Date__c,Core_Production_End_Date__c,Core_Manufacturing_Geo__c,Core_Military_Aerospace_Govmt_End_Use__c,Core_Compliance_Comments__c,Core_Compliance_Status__c,Core_Compliance_Sub_Status__c,</value>
    </labels>
