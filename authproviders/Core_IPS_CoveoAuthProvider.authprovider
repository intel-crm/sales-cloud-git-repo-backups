<?xml version="1.0" encoding="UTF-8"?>
<AuthProvider xmlns="http://soap.sforce.com/2006/04/metadata">
    <customMetadataTypeRecord>Core_IPS_APIAuthSettingPlugin__mdt.Core_IPS_CoveoAuthProvider</customMetadataTypeRecord>
    <executionUser>ips.pam.integration.user@intel.com.crm</executionUser>
    <friendlyName>Core_IPS_CoveoAuthProvider</friendlyName>
    <includeOrgIdInIdentifier>false</includeOrgIdInIdentifier>
