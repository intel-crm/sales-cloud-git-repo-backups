<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Audit Rules</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;Use the below format for saving rules:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;2021-07-13 00:00:00&lt;/b&gt;&amp;nbsp;for Date fields: Activity Start Date, Activity End Date, Ad Run Start Date, Ad Run End Date&lt;/li&gt;&lt;li&gt;Currency code like&amp;nbsp;&lt;b&gt;USD, INR&lt;/b&gt;&amp;nbsp;for Invoice/Receipt Currency&amp;nbsp;&amp;nbsp;&lt;/li&gt;&lt;li&gt;Fill&amp;nbsp;&lt;b&gt;ID Field&lt;/b&gt;&amp;nbsp;for Account, Activity fields.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;i&gt;Open Account/Activity and get the 18 digit ID from the URL as shown in the screenshot&lt;/i&gt;&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <delayDays>1</delayDays>
        <displayType>DockedComposer</displayType>
        <header>Audit Rules</header>
        <image>Account_ID</image>
        <imageAltText>Get the Account ID</imageAltText>
        <imageLocation>Bottom</imageLocation>
        <isPublished>true</isPublished>
        <masterLabel>Audit Rules</masterLabel>
        <publishedDate>2021-08-19</publishedDate>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2021-08-19</startDate>
        <targetPageKey1>Core_MDF_Audit_Rules_Engine__c</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <timesToDisplay>12</timesToDisplay>
        <title>Creating Audit Rules</title>
        <uiFormulaRule>
            <booleanFilter>(1 AND 2) AND (3 OR 4 OR 5 OR 6)</booleanFilter>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.Core_MDF_ClaimCaseReviewerManager}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.Core_MDF_CCP_Internal_Claim_Case_Reviewer_Manager}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_ccp - core access</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_it admin</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>Admin</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_comarketing support l2</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>SpecificPermissions</userAccess>
        <userProfileAccess>SpecificProfiles</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
