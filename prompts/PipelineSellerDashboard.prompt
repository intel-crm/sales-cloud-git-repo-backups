<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Pipeline Seller Dashboard</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/reporting/seller-manager-dashboard/#Seller_Dashboard</actionButtonLink>
        <body>&lt;p&gt;Seller Dashboard is a&amp;nbsp;quick, easy to read dashboard that provides specific data that is key information being discussed during your weekly Pipeline Reviews.&amp;nbsp;It shows opportunities where you are the Opportunity Owner.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Filters&lt;/strong&gt;: All of these filters are multi select and can be organized in many different outputs depending on the focus of the conversation.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Graphs&lt;/strong&gt;: Reminder that you can click on a section of a graph to filter content based on that metric.&amp;nbsp;The data in the Quick Reference and Tables section will also be filtered on that metric. You can reset the data by clicking the same section or use the dashboard refresh button.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Tables&lt;/strong&gt;: You can open/access the Opportunity by clicking on the opportunity name.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestion&lt;/em&gt;&lt;/a&gt;&lt;em&gt;s are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Pipeline Seller Dashboard</description>
        <displayType>DockedComposer</displayType>
        <header>Pipeline</header>
        <isPublished>true</isPublished>
        <masterLabel>Pipeline Seller Dashboard</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>home</targetPageKey1>
        <targetPageType>standard__namedPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Seller Dashboard</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
