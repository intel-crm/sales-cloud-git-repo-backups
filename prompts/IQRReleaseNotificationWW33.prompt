<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>IQR Release Notification WW33 2021</masterLabel>
    <promptVersions>
        <actionButtonLabel>What&apos;s New</actionButtonLabel>
        <actionButtonLink>https://salescrm.intel.com/ww33-2021-release-update</actionButtonLink>
        <body>&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-family: &amp;quot;Intel Clear&amp;quot;, sans-serif;&quot;&gt;In the August IQR release, did you know we...&lt;/span&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-family: &amp;quot;Intel Clear&amp;quot;, sans-serif;&quot;&gt;Added a new field called Intel Response Requested By Date. This is the date by which Intel should respond to the quote request.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-family: &amp;quot;Intel Clear&amp;quot;, sans-serif;&quot;&gt;Repurposed Bid Decision Date and renamed it to Proposal Due Date. This&amp;nbsp;is the date&amp;nbsp;that the&amp;nbsp;OEM’s proposal is due to the end customer.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-family: &amp;quot;Intel Clear&amp;quot;, sans-serif;&quot;&gt;Updated the Effective Pricing Start Date logic for our regional pricing managers.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-family: &amp;quot;Intel Clear&amp;quot;, sans-serif;&quot;&gt;Have enabled our OEMs to update their nicknames used in Chatter.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-family: &amp;quot;Intel Clear&amp;quot;, sans-serif;&quot;&gt;More details can be found on the &quot;&lt;/span&gt;&lt;a href=&quot;https://salescrm.intel.com/ww33-2021-release-update&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: rgb(46, 116, 181);&quot;&gt;What&apos;s New&lt;/a&gt;&quot; page.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-family: Candara, sans-serif; font-size: 10.5pt;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</body>
        <customApplication>Pricing_Intel_Quote_Request</customApplication>
        <delayDays>1</delayDays>
        <displayType>DockedComposer</displayType>
        <endDate>2021-09-06</endDate>
        <header>Welcome to Intel Quote Request</header>
        <isPublished>false</isPublished>
        <masterLabel>IQR Release Notification WW33 2021</masterLabel>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2021-08-12</startDate>
        <targetPageKey1>SBQQ__Quote__c</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <timesToDisplay>1</timesToDisplay>
        <title>IQR New Features</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
