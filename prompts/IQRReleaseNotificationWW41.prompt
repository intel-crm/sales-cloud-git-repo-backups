<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>IQR Release Notification WW41</masterLabel>
    <promptVersions>
        <actionButtonLabel>Customer Data Governance</actionButtonLabel>
        <actionButtonLink>https://salescrm.intel.com/intel-quote-request-home/tenders-iqr-home/tenders-iqr-overview/tenders-iqr-overview-customer-data-governance/</actionButtonLink>
        <body>&lt;p&gt;The End Customer list in IQR is not populated with accounts from Salesforce and is instead a list of end customers for which the OEM has previously submitted a tender. &lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Reminder: Check the End Customer drop down list before accepting a Write In End Customer entry. If the End Customer already exists, select the drop-down option, and save the change.&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;p&gt;You can learn more by visiting the &lt;a href=&quot;https://salescrm.intel.com/intel-quote-request-home/tenders-iqr-home/tenders-iqr-overview/tenders-iqr-overview-customer-data-governance/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Customer Data Governance&lt;/a&gt; section on the IQR Training website.&lt;/p&gt;</body>
        <customApplication>Pricing_Intel_Quote_Request</customApplication>
        <delayDays>1</delayDays>
        <displayType>DockedComposer</displayType>
        <endDate>2022-12-01</endDate>
        <header>Welcome to Intel Quote Request</header>
        <isPublished>false</isPublished>
        <masterLabel>IQR Release Notification WW41</masterLabel>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2022-10-06</startDate>
        <targetPageKey1>SBQQ__Quote__c</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <timesToDisplay>1</timesToDisplay>
        <title>Did you know…</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
