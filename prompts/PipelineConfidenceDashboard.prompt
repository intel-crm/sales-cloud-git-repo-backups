<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Pipeline Confidence Dashboard</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/pipeline-management/pipeline-confidence-commit/#Pipeline_Confidence_Dashboard</actionButtonLink>
        <body>&lt;p&gt;Pipeline Confidence is defined as the &lt;strong&gt;confidence level that your Opportunities are on track to close in the current quarter&lt;/strong&gt;. High Confidence &amp;amp; Low Confidence Opportunities.&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;p&gt;The Pipeline Confidence Dashboard provides a graphical display of your confidence rating and a breakdown of the Pipeline Confidence for your opportunities.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Confidence rating is displayed as a percentage representing the number of high confidence opportunities. High confidence opportunities:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Have Products assigned&lt;/li&gt;&lt;li&gt;Are in the later sales stages&lt;/li&gt;&lt;li&gt;Have less than 3 pushes&lt;/li&gt;&lt;li&gt;Are not past due&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Metrics can be viewed by Sales Group, Manager, or Opportunity Owner.&amp;nbsp;An opportunity summary table is provided to easily identify which opportunities are contributing to the metrics.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Pipeline Confidence Dashboard</description>
        <displayType>DockedComposer</displayType>
        <header>Pipeline</header>
        <isPublished>true</isPublished>
        <masterLabel>Pipeline Confidence Dashboard</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>home</targetPageKey1>
        <targetPageType>standard__namedPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Pipeline Confidence Dashboard</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
