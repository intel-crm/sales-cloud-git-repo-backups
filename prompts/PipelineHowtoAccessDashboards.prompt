<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Pipeline How to Access Dashboards</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/reporting/analytics-dashboard-navigation-and-functionality/</actionButtonLink>
        <body>&lt;p&gt;There are 3 different ways to access the Analytics Studio dashboards where the Pipeline Management Dashboard, Seller/Manager Dashboards and Product Analysis dashboards are provided:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Home tab&lt;/strong&gt;: In the Pipeline Management Dashboard section, click the graph icon.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;App Launcher Menu&lt;/strong&gt;: Using the App Launcher to search and select Analytics Studio.&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrm.intel.com/training-and-help/salescrm-functionality/salesforce-tabs/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Add a Custom tab&lt;/a&gt;: You can create a custom tab for easy access on the menu.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Pipeline How to Access Dashboards</description>
        <displayType>DockedComposer</displayType>
        <header>Pipeline Reporting</header>
        <isPublished>true</isPublished>
        <masterLabel>Pipeline How to Access Dashboards</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>home</targetPageKey1>
        <targetPageType>standard__namedPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Accessing Analytics Studio</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
