<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Opportunities Introduction to POP</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-practices-policies/proof-of-performance-pop/</actionButtonLink>
        <body>&lt;p&gt;Once you are ready to claim a Win, you must &lt;strong&gt;attach your proofs in the Notes and Attachments section&lt;/strong&gt; for either a Deal or Design Win.&lt;strong&gt;&amp;nbsp;Attachments must be labeled&lt;/strong&gt; in English, with “POP,” “pop,” or “Proof of Performance” in the name.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;For Deal, Design and Consumption Revenue (6QPS) POP Guidelines, refer &lt;a href=&quot;https://salescrm.intel.com/training-and-help/opportunity-management/proof-of-performance-2/#consumptionrevpop&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;POP training&lt;/a&gt;.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
