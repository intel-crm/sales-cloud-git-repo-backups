        <body>&lt;p&gt;123&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;img src=&quot;https://intel--CRMDEVCCP--c.documentforce.com/servlet/rtaImage?refid=0EMg0000000r8xU&quot; alt=&quot;image.png&quot;&gt;&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <delayDays>1</delayDays>
        <displayType>DockedComposer</displayType>
