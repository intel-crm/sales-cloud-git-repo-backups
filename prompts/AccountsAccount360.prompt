<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Accounts Account 360</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/account-contact-management/account-360/</actionButtonLink>
        <body>&lt;p&gt;Account 360 is a comprehensive view that displays metrics and key performance measures on the Account. It provides Account Teams with a “story” and a vantage point of the Account as a whole.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The information is organized into the following key areas:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;News&lt;/strong&gt;: Displays News that is specific to the account (under the Account News), as well as Industry News that is relevant to an account. The &lt;strong&gt;News &lt;/strong&gt;tab can help initiate a conversation with a customer to help further deepen the relationship.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Sales Insights&lt;/strong&gt;: On the &lt;strong&gt;Sales Insights&lt;/strong&gt; tab, view products or topics customer contacts are most engaged with, see if they viewed a product/topic for the first time or even had some other sort of engagement with that product/topic on Intel.com.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Pipeline and Opportunity Overview&lt;/strong&gt;: Displays opportunity information in a graph format for the account such as Open Opportunities At Risk, All Open Opportunities, Historical Opportunities, etc.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Customer Intelligence&lt;/strong&gt;: Displays 3rd party data about the customer, the Voice of Customer (VoC) Dashboard, and open Support Case data. Included are HG Insights that show&amp;nbsp;Company Overview information and the company’s Total IT Spend, Customer Experience Survey data (not included for all accounts) in the form of the VoC Dashboard, and Open Support and Sales Support Case information in a graphical format.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Briefs/Plans&lt;/strong&gt;: Within the &lt;strong&gt;Brief/Plans&lt;/strong&gt; tab, view the Account Status, Account Plans and Executive Meeting Briefs.&amp;nbsp;All content under this tab is visible to the account team hierarchy and Executive Level Team members. Activities created from Briefs/Plans are tied to the Plan/Brief, not the Account record. &lt;/li&gt;&lt;li&gt;&lt;strong&gt;Revenue&lt;/strong&gt;: The &lt;strong&gt;Revenue&lt;/strong&gt; tab displays revenue data in a graph format for the account. Revenue data for 4 sources is included. These sources are &lt;em&gt;Branded Sales&lt;/em&gt;, &lt;em&gt;Distributor Sales Out&lt;/em&gt;, &lt;em&gt;Net Revenue&lt;/em&gt; and &lt;em&gt;Retail/Consumer Sales&lt;/em&gt; (coming soon).&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Accounts Account 360</description>
        <displayType>DockedComposer</displayType>
        <header>Accounts</header>
        <isPublished>true</isPublished>
        <masterLabel>Accounts Account 360</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>Account</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Account 360</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
