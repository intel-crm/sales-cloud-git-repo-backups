<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>PSG Quote Help</masterLabel>
    <promptVersions>
        <body>PSG quotes are requested to negotiate end customer pricing for PSG products</body>
        <customApplication>PSG_Quote_Request</customApplication>
        <delayDays>1</delayDays>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>TopLeft</displayPosition>
        <displayType>FloatingPanel</displayType>
        <endDate>2023-07-26</endDate>
        <isPublished>true</isPublished>
        <masterLabel>PSG Quote Help Step 1</masterLabel>
        <publishedDate>2023-07-17</publishedDate>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2023-07-14</startDate>
        <stepNumber>1</stepNumber>
        <targetPageKey1>SBQQ__Quote__c</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <timesToDisplay>12</timesToDisplay>
        <title>PSG Quote</title>
        <uiFormulaRule>
            <booleanFilter>1 AND 2 AND 3</booleanFilter>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.PSG_Internal_Biz_Manager}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.PSG_Internal_Biz_Ops}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.PSG_Internal_SOS}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>SpecificPermissions</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>There are four types of quotes: Design win, Budgetary, Contract pricing and transfer pricing</body>
        <customApplication>PSG_Quote_Request</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>TopCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <isPublished>false</isPublished>
        <masterLabel>PSG Quote Help Step 2</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>2</stepNumber>
        <targetPageKey1>SBQQ__Quote__c</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>PSG Quote</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
