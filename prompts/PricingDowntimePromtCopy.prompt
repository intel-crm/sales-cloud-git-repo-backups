<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Pricing Downtime Promt Copy</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;Intel Quote Request will be down on 23rd Dec 2020, Wednesday from 7:00 AM to 8:00 PM IST for the upcoming release. Please plan your activities accordingly.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;IQR Tech Team!&lt;/p&gt;</body>
        <customApplication>Pricing_Intel_Quote_Request</customApplication>
        <delayDays>1</delayDays>
        <displayType>DockedComposer</displayType>
        <endDate>2021-01-02</endDate>
        <header>Intel Quote Request Down on 23rd Dec</header>
        <isPublished>true</isPublished>
        <masterLabel>Pricing Downtime Promt Copy</masterLabel>
        <publishedDate>2020-12-27</publishedDate>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2020-12-23</startDate>
        <targetPageKey1>SBQQ__Quote__c</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme1</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>10</timesToDisplay>
        <title>INTEL QUOTE REQUEST DOWN ON 23rd DEC</title>
        <uiFormulaRule>
            <booleanFilter>(1 AND 2) AND (3)</booleanFilter>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.Pricing_Tender_Regional_Pricing_Manager}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.Tender_Account_Executive}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_sales rep-bb</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>SpecificPermissions</userAccess>
        <userProfileAccess>SpecificProfiles</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
