<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Accounts Edit an Account</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/account-contact-management/edit-an-account/</actionButtonLink>
        <body>&lt;p&gt;The preferred method to request account changes (including account deactivation) is via &lt;a href=&quot;https://salescrm.intel.com/support-and-help-2/#tab-id-6&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Ask a Question&lt;/a&gt;. Click the&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt; &lt;/span&gt;&lt;strong style=&quot;color: rgb(255, 255, 255);&quot;&gt;Ask a Question&lt;/strong&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt; tab, then click the &lt;/span&gt;&lt;strong style=&quot;color: rgb(255, 255, 255);&quot;&gt;Sales CRM&lt;/strong&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt; &lt;/span&gt;button. To expedite your request, please include the following:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Updated Account Address (&lt;strong&gt;Account ID&lt;/strong&gt;, new address, proof of new address)&lt;/li&gt;&lt;li&gt;Updated Territory (&lt;strong&gt;Account ID&lt;/strong&gt;, Territory to be added or removed, permission from Territory owner)&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Account name changes can also be requested, but the requested change must match either the &lt;strong&gt;Account Legal Name&lt;/strong&gt; or the &lt;strong&gt;Trade Style Name&lt;/strong&gt; (D&amp;amp;B Information Section). If neither field matches, but a link can be provided that documents the name change, the request will be escalated for research &amp;amp; confirmation.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Accounts Edit an Account</description>
        <displayType>DockedComposer</displayType>
        <header>Accounts</header>
        <isPublished>true</isPublished>
        <masterLabel>Accounts Edit an Account</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>Account</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Edit an Account</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
