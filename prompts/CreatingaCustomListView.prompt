<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Creating a Custom List View</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;This walkthrough will show you how to create and customize a list view. Select &lt;strong&gt;Next&lt;/strong&gt; to view the steps. You can &lt;strong&gt;Dismiss&lt;/strong&gt; the walkthrough at any time.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>BottomCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Custom List View Step 1</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2026-09-02</startDate>
        <stepNumber>1</stepNumber>
        <targetPageKey1>home</targetPageKey1>
        <targetPageType>standard__namedPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Creating a Custom List View</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Select a record type, such as &lt;strong&gt;Accounts&lt;/strong&gt;, &lt;strong&gt;Contacts&lt;/strong&gt;, &lt;strong&gt;Opportunities&lt;/strong&gt;, or &lt;strong&gt;Cases&lt;/strong&gt;, from the navigation bar to access its list views.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Custom List View Step 2</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;sfdc:TabDefinition.standard-Account&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>2</stepNumber>
        <targetPageKey1>Account</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Select a Record Type</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Select the &lt;strong&gt;List View dropdown&lt;/strong&gt; to view the available list views for the current object, such as &lt;strong&gt;Accounts&lt;/strong&gt;, &lt;strong&gt;Contacts&lt;/strong&gt;, or &lt;strong&gt;Opportunities&lt;/strong&gt;.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <elementRelativePosition>RightCenter</elementRelativePosition>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Custom List View Step 3</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;50e27b43761f49d99bf31a503ed4e21a&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>3</stepNumber>
        <targetPageKey1>Account</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>View Available List Views</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Select the &lt;strong&gt;List View Controls&lt;/strong&gt; icon, then select &lt;strong&gt;Clone&lt;/strong&gt; to customize the current list view or &lt;strong&gt;New&lt;/strong&gt; to create a list view based on your requirement.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Custom List View Step 4</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;91241ab164f648939490c41660a6c8f0&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>4</stepNumber>
        <targetPageKey1>Account</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Open List View Controls</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Create a recognizable new name for your view. Choose whether the list view is visible only to you or available to other users, then select &lt;strong&gt;Save&lt;/strong&gt; to create the list view and continue to the filter settings.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>MiddleCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Custom List View Step 5</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>5</stepNumber>
        <targetPageKey1>Account</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Choose the Visibility and Save</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Select the &lt;strong&gt;Funnel&lt;/strong&gt; icon to access the filter options. Regardless of whether you are cloning or creating a new view, you can choose and edit multiple value types for each filter.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Custom List View Step 6</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;58d41ca6d96f4fc7bdee56144c65510e&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>6</stepNumber>
        <targetPageKey1>Account</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Add Filter Criteria</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Select the &lt;strong&gt;List View Controls&lt;/strong&gt; icon, then select &lt;strong&gt;Select Fields to Display&lt;/strong&gt;. Use the arrows to add, remove, or reorder the visible fields, then select &lt;strong&gt;Save&lt;/strong&gt;.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Custom List View Step 7</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;91241ab164f648939490c41660a6c8f0&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>7</stepNumber>
        <targetPageKey1>Account</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Customize the Displayed Fields</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Select the &lt;strong&gt;List View Controls&lt;/strong&gt; icon, then select &lt;strong&gt;Sharing Settings&lt;/strong&gt;. Choose whether the list view is visible only to you or available to other users. Your custom list view is now ready and displays the records &amp;amp; fields based on your selections.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>TopCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Custom List View Step 8</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>8</stepNumber>
        <targetPageKey1>Account</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Optional: Update the Sharing Setting</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
