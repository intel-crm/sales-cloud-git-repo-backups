<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>CustomListView</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;Do you know!! we can create our own custom list we. Please watch the video&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <delayDays>2</delayDays>
        <displayType>DockedComposer</displayType>
        <endDate>2020-04-30</endDate>
        <header>List View</header>
        <isPublished>false</isPublished>
        <masterLabel>CustomListView</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2020-04-23</startDate>
        <targetPageKey1>PartnerFundClaim</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <timesToDisplay>30</timesToDisplay>
        <title>Claim Custom List View</title>
        <uiFormulaRule>
            <booleanFilter>1 OR 2</booleanFilter>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>Admin</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_it admin</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>SpecificProfiles</userProfileAccess>
        <versionNumber>1</versionNumber>
        <videoLink>https://www.youtube.com/embed/Ko-gcObzTVo.</videoLink>
    </promptVersions>
</Prompt>
