<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Contacts Create a Contact</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/account-contact-management/create-or-edit-account-contacts/</actionButtonLink>
        <body>&lt;p&gt;Contacts are associated with accounts created in Sales CRM. If the account does not exist, it will need to be created before the contact is created. Contacts can be created from the page for an account, from the &lt;strong&gt;Contacts &lt;/strong&gt;tab, or from other locations.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;From the &lt;strong&gt;Contacts &lt;/strong&gt;home page,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Click the &lt;strong&gt;New &lt;/strong&gt;button. The &lt;em&gt;New Contact&lt;/em&gt; window opens.&lt;/li&gt;&lt;li&gt;Enter as much business-relevant information as you can about your new contact. Minimum requirements for a contact are &lt;strong&gt;First Name&lt;/strong&gt;, &lt;strong&gt;Last Name&lt;/strong&gt;, &lt;strong&gt;Account Name&lt;/strong&gt;, and &lt;strong&gt;Email&lt;/strong&gt;.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Save&lt;/strong&gt;. The contact is now created and associated with an account as a primary contact (direct relationship).&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Contacts Create a Contact</description>
