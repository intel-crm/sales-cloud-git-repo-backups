<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Opportunities Edit/Update an Opportunity</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/opportunity-management/edit-or-update-an-opportunity/</actionButtonLink>
        <body>&lt;p&gt;There are multiple edit options:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Pencil Icon&lt;/strong&gt;: Best used when editing 1-3 fields&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Edit button&lt;/strong&gt;: Best used when editing multiple fields.&amp;nbsp;Will open a popup window with all fields available for updating.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Edit options in related sections&lt;/strong&gt;: Each related section will have specific edit options.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Another editing option is to use &lt;a href=&quot;https://salescrm.intel.com/training-and-help/opportunity-management/opportunity-mgmt-grid-view/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Grid View&lt;/a&gt;.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
