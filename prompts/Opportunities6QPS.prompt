<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Opportunities 6QPS</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/opportunity-management/6-quarter-production-scheduling-6qps/</actionButtonLink>
        <body>&lt;p&gt;&lt;strong&gt;How to Change the 6QPS Start Quarter:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Use Start Quarter prior to submission and/or approval of 6QPS results because changing Start Quarter resets the forecast to default (0).&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Click &lt;strong&gt;Select Start Quarter&lt;/strong&gt;.&lt;/li&gt;&lt;li&gt;The &lt;em&gt;Select Start Quarter &lt;/em&gt;window is provided. Choose a different start quarter by clicking the &lt;strong&gt;Select Start Quarter &lt;/strong&gt;dropdown and selecting an option.&amp;nbsp;Click on the &lt;strong&gt;Select No. of Quarters &lt;/strong&gt;and choose.&amp;nbsp;When completed, click &lt;strong&gt;Ok&lt;/strong&gt;. NOTE: A range of up to 20 quarters is possible&lt;/li&gt;&lt;li&gt;A warning message is provided identifying the start quarter for your production schedule and that the scheduled quantity and revenue will be reset. Click &lt;strong&gt;Yes &lt;/strong&gt;to apply or &lt;strong&gt;No &lt;/strong&gt;to cancel.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Add Quarter without truncating quarters:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To add an additional quarter to the end of your product timeline:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Click &lt;strong&gt;Add Quarter&lt;/strong&gt;.&lt;/li&gt;&lt;li&gt;The &lt;em&gt;Add Quarter &lt;/em&gt;window is provided. Confirm the addition of the quarter.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Save&lt;/strong&gt;. The newly added quarter will show to the right of the original set of quarters.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Opportunities 6QPS instruction</description>
        <displayType>DockedComposer</displayType>
        <header>Opportunities</header>
        <isPublished>true</isPublished>
        <masterLabel>Opportunities 6QPS</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>Opportunity</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>6QPS</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
