<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>SBR Account Creation Request From New Opportunity Page - Design Opportunity</masterLabel>
    <promptVersions>
        <actionButtonLabel>New Account Request</actionButtonLabel>
        <actionButtonLink>https://intel--crmdevint3.sandbox.lightning.force.com/lightning/n/Search_Account_SBR</actionButtonLink>
        <body>&lt;p&gt;Any new account request should go through Accounts &amp;gt; select New Request&lt;/p&gt;</body>
        <delayDays>1</delayDays>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <elementRelativePosition>RightCenter</elementRelativePosition>
        <isPublished>false</isPublished>
        <masterLabel>SBR Account Creation Request From New Opportunity Page - Design Opportunity</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;sfdc:RecordField.Opportunity.AccountId&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;flexipage_fieldSection&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2023-08-01</startDate>
        <targetPageKey1>Opportunity</targetPageKey1>
        <targetPageKey2>new</targetPageKey2>
        <targetPageKey3>{&quot;navigationLocation&quot;:&quot;LIST_VIEW&quot;,&quot;nooverride&quot;:&quot;1&quot;,&quot;useRecordTypeCheck&quot;:&quot;1&quot;,&quot;onRecordTypeSelection&quot;:false}</targetPageKey3>
        <targetPageType>standard__objectPage</targetPageType>
        <targetRecordType>Opportunity.Core_Design_Opportunity</targetRecordType>
        <timesToDisplay>30</timesToDisplay>
        <title>STOP! Use an existing Account</title>
        <uiFormulaRule>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.UCD_Account_Request_Guidance}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>SpecificPermissions</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
