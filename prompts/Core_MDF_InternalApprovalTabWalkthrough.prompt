<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>CCP Internal Approval Tab Walkthrough</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;Click to expand or contract the list&amp;nbsp;of items&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <delayDays>1</delayDays>
        <description>CCP Internal Approval Tab Walkthrough</description>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>TopLeft</displayPosition>
        <displayType>FloatingPanel</displayType>
        <isPublished>true</isPublished>
        <masterLabel>CCP Internal Approval Tab Walkthrough Step 1</masterLabel>
        <publishedDate>2023-04-15</publishedDate>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2023-04-15</startDate>
        <stepNumber>1</stepNumber>
        <targetPageKey1>Core_MDF_Approval_Requests</targetPageKey1>
        <targetPageType>standard__navItemPage</targetPageType>
        <timesToDisplay>5</timesToDisplay>
        <title>View Details</title>
        <uiFormulaRule>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.Core_MDF_ApprovalTabGuidance}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>SpecificPermissions</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Click the checkbox to select a&amp;nbsp;single item to approve&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>MiddleCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <isPublished>false</isPublished>
        <masterLabel>CCP Internal Approval Tab Walkthrough Step 2</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>2</stepNumber>
        <targetPageKey1>Core_MDF_Approval_Requests</targetPageKey1>
        <targetPageType>standard__navItemPage</targetPageType>
        <title>Select Items</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;For single approvals, click&amp;nbsp;the“Approve” or “Reject” button&amp;nbsp;here&amp;nbsp;​&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>MiddleRight</displayPosition>
        <displayType>FloatingPanel</displayType>
        <isPublished>false</isPublished>
        <masterLabel>CCP Internal Approval Tab Walkthrough Step 3</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>3</stepNumber>
        <targetPageKey1>Core_MDF_Approval_Requests</targetPageKey1>
        <targetPageType>standard__navItemPage</targetPageType>
        <title>Single Operation</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;You can enter comments for&amp;nbsp;approval or rejection as needed.&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>BottomRight</displayPosition>
        <displayType>FloatingPanel</displayType>
        <isPublished>false</isPublished>
        <masterLabel>CCP Internal Approval Tab Walkthrough Step 4</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>4</stepNumber>
        <targetPageKey1>Core_MDF_Approval_Requests</targetPageKey1>
        <targetPageType>standard__navItemPage</targetPageType>
        <title>Provide Comment</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Click the“Approve” or “Reject”&amp;nbsp;button here for bulk approvals​&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>MiddleCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <isPublished>false</isPublished>
        <masterLabel>CCP Internal Approval Tab Walkthrough Step 5</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>5</stepNumber>
        <targetPageKey1>Core_MDF_Approval_Requests</targetPageKey1>
        <targetPageType>standard__navItemPage</targetPageType>
        <title>Bulk Operation</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Select up to 10 items of the same module&amp;nbsp;type to approve.&amp;nbsp;“Module” refers to an&amp;nbsp;activity, campaign, or proposal.&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>MiddleCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <isPublished>false</isPublished>
        <masterLabel>CCP Internal Approval Tab Walkthrough Step 6</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>6</stepNumber>
        <targetPageKey1>Core_MDF_Approval_Requests</targetPageKey1>
        <targetPageType>standard__navItemPage</targetPageType>
        <title>Bulk Selection</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
