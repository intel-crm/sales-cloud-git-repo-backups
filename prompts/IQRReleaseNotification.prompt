<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>IQR Release Notification WW29 2021</masterLabel>
    <promptVersions>
        <actionButtonLabel>What&apos;s New</actionButtonLabel>
        <actionButtonLink>https://salescrm.intel.com/ww29-2021-release-update/</actionButtonLink>
        <body>&lt;p&gt;IQR has recently released some great new features we thought you may be interested in.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;The End Customer field has been changed from a free text field to a drop down list… end customer names must be unified (standardized) before quote lines can be marked as Won.&lt;/li&gt;&lt;li&gt;Regional Pricing Managers can&amp;nbsp;reject a quote line after the deal has been created and prior to approval.&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/li&gt;&lt;li&gt;Both internal &amp;amp; external IQR users, can opt in / out of email notifications and ...&lt;/li&gt;&lt;li&gt;Did you know quote letters are sent automatically? Once approved, the quote letter will be&amp;nbsp;emailed&amp;nbsp;to the&amp;nbsp;Primary Contact&amp;nbsp;and&amp;nbsp;Submitter&amp;nbsp;at the OEM&amp;nbsp;(if the account/end customer region is enabled), FSEs/SDMs,&amp;nbsp;and Pricing&amp;nbsp;Managers for the quote.&amp;nbsp;&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;To learn more click the &lt;b&gt;What&apos;s New&lt;/b&gt; button.&lt;/p&gt;</body>
        <customApplication>Pricing_Intel_Quote_Request</customApplication>
        <delayDays>1</delayDays>
        <displayType>DockedComposer</displayType>
        <endDate>2021-08-13</endDate>
        <header>Welcome to Intel Quote Request</header>
        <isPublished>false</isPublished>
        <masterLabel>IQR Release Notification WW29 2021</masterLabel>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2021-07-14</startDate>
        <targetPageKey1>SBQQ__Quote__c</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <timesToDisplay>1</timesToDisplay>
        <title>IQR New Features</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
