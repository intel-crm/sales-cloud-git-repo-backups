<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Contacts Related Contacts (Direct/indirect)</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/account-contact-management/create-or-edit-account-contacts/#Add_a_Contact_Relationship_to_an_Account</actionButtonLink>
        <body>&lt;p&gt;&lt;strong&gt;Direct/Primary Relationship&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;When a contact is created, it is connected to an account - it has a primary/direct relationship to the account. There can only be one primary/direct contact for an account.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Indirect Relationships&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;You can associate a contact to multiple accounts, referred to as indirect relationships. Indirect relationships do not show up on accounts as contacts.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To associate a contact to an account,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;From the &lt;strong&gt;Contact &lt;/strong&gt;&lt;em&gt;details &lt;/em&gt;page, &lt;strong&gt;Related Accounts&lt;/strong&gt; section, click the drop-down arrow and select &lt;strong&gt;Add Relationship&lt;/strong&gt;. The &lt;em&gt;New Account Contact Relationship &lt;/em&gt;window opens.&lt;/li&gt;&lt;li&gt;Select the Account to which you want to create the relationship. You can select a role, but it is not required.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Save&lt;/strong&gt;.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Contacts Related Contacts (Direct/indirect)</description>
        <displayType>DockedComposer</displayType>
        <header>Contacts</header>
        <isPublished>true</isPublished>
        <masterLabel>Contacts Related Contacts (Direct/indirect)</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>Contact</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Related Contacts (Direct/indirect)</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
