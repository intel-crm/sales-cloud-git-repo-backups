<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Accounts Create or Edit a Contact</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/account-contact-management/create-or-edit-account-contacts/</actionButtonLink>
        <body>&lt;p&gt;&lt;strong&gt;Create a Contact&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Contacts are associated with accounts created in Sales CRM. If the account does not exist, it will need to be created before the contact is created. Contacts can be created from the page for an account, from the &lt;strong&gt;Contacts&lt;/strong&gt; tab, or from other locations.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;From the &lt;em&gt;Contacts&lt;/em&gt; home page,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Click the &lt;strong&gt;New&lt;/strong&gt; button. The &lt;em&gt;New Contact&lt;/em&gt; page opens.&lt;/li&gt;&lt;li&gt;Enter as much business-relevant information as you can about your new contact. Minimum requirements for a contact are &lt;strong&gt;First Name&lt;/strong&gt;, &lt;strong&gt;Last Name&lt;/strong&gt;, &lt;strong&gt;Account Name&lt;/strong&gt;, and &lt;strong&gt;Email&lt;/strong&gt;.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Save&lt;/strong&gt;. The contact is now created and associated with an account as a primary or &lt;em&gt;direct relationship&lt;/em&gt;.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Contacts can also be associated with an account or multiple accounts. This is referred to as an indirect relationship. Indirect relationships do not show up on accounts as contacts.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To associate a contact to an account,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;From the &lt;em&gt;Contact&lt;/em&gt; details page, &lt;strong&gt;Related Accounts&lt;/strong&gt; section, click the drop-down arrow and select &lt;strong&gt;Add Relationship&lt;/strong&gt;. The &lt;em&gt;New Account Contact Relationship&lt;/em&gt; pop-up window opens.&lt;/li&gt;&lt;li&gt;Select the &lt;strong&gt;Account&lt;/strong&gt; to which you want to create the relationship. You can select a role, but it is not required.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Save&lt;/strong&gt;.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Edit a Contact&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;There are multiple ways you can edit a contact. Note that in order to edit the Contact, you must be the Contact Owner or the Account Owner, otherwise, please submit the edit request through &lt;a href=&quot;https://salescrm.intel.com/support-and-help-2/#tab-id-6&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Ask A Question&lt;/a&gt;.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To edit a contact from the &lt;strong&gt;Contacts&lt;/strong&gt; tab/&lt;em&gt;Contact&lt;/em&gt; home page,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Click the drop-down arrow associated with the contact you want to edit and select &lt;strong&gt;Edit&lt;/strong&gt;. The &lt;em&gt;Contact&lt;/em&gt; details page opens.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Edit&lt;/strong&gt; to make all editable fields available, or click the pencil icon on a field.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Save&lt;/strong&gt; when finished making edits.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Accounts Create or Edit a Contact</description>
        <displayType>DockedComposer</displayType>
        <header>Accounts</header>
        <isPublished>true</isPublished>
        <masterLabel>Accounts Create or Edit a Contact</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
