<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Opportunities Create an Opportunity</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/opportunity-management/create-a-new-opportunity/</actionButtonLink>
        <body>&lt;ol&gt;&lt;li&gt;From the &lt;em&gt;Opportunity &lt;/em&gt;tab, select &lt;strong&gt;New Opportunity&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;Choose between either &lt;strong&gt;Design &lt;/strong&gt;or &lt;strong&gt;Deal &lt;/strong&gt;Opportunity and click &lt;strong&gt;Next&lt;/strong&gt;.&lt;/li&gt;&lt;li&gt;Search and select the&lt;strong&gt; Account Name&lt;/strong&gt;.&amp;nbsp;In the Stage dropdown select &lt;strong&gt;Qualify&lt;/strong&gt;.&lt;/li&gt;&lt;li&gt;Complete the following REQUIRED fields: &lt;strong&gt;MINDS, Opportunity Name&lt;/strong&gt; (unique), &lt;strong&gt;Decision Date, Opportunity type&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Save&lt;/strong&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Opportunity Naming Conventions&lt;/strong&gt;:&lt;/p&gt;&lt;p&gt;When naming your opportunities, it is important to follow a standard convention in order to avoid vague names that are hard to identify, or names that reveal secret or sensitive information.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Create an Opportunity (Basic Opportunity/Qualify)</description>
        <displayType>DockedComposer</displayType>
        <header>Opportunities</header>
        <isPublished>true</isPublished>
        <masterLabel>Opportunities Create an Opportunity</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>Opportunity</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Create an Opportunity</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
        <videoLink>https://players.brightcove.net/4090876643001/syp9wqx20_default/index.html?videoId=6327550392112</videoLink>
    </promptVersions>
</Prompt>
