<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Contacts Manage Contacts Roles - Opportunity</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/account-contact-management/create-or-edit-account-contacts/#AccountOpportunity_Contact_Role</actionButtonLink>
        <body>&lt;p&gt;Contacts that are associated with an account opportunity can be assigned a Contact Role, which denotes how the contact is associated with an account opportunity. A role can be selected for both direct/primary and indirect contacts.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To add and edit &lt;strong&gt;Contact Roles&lt;/strong&gt; from an &lt;strong&gt;Opportunity&lt;/strong&gt;,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;From the &lt;strong&gt;Opportunity &lt;/strong&gt;&lt;em&gt;details &lt;/em&gt;page, navigate to the &lt;strong&gt;Contact Roles&lt;/strong&gt; section, click the top drop-down arrow and select &lt;strong&gt;Edit Contact Roles&lt;/strong&gt;.&lt;/li&gt;&lt;li&gt;The &lt;em&gt;Edit Contact Roles&lt;/em&gt; window opens. From here, you can add a contact with a contact role to the opportunity or change a contact’s role as it pertains to that opportunity.&lt;/li&gt;&lt;li&gt;When finished editing the information,&amp;nbsp;click &lt;strong&gt;Save&lt;/strong&gt;.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Contact roles include&lt;/strong&gt;:&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Business Decision Maker&lt;/li&gt;&lt;li&gt;Champion&lt;/li&gt;&lt;li&gt;Distributor Technical Owner&lt;/li&gt;&lt;li&gt;Influencer&lt;/li&gt;&lt;li&gt;Ratifier&lt;/li&gt;&lt;li&gt;Technical Decision Maker&lt;/li&gt;&lt;li&gt;User&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Contacts Manage Contacts Roles from an Opportunity</description>
        <displayType>DockedComposer</displayType>
        <header>Contacts</header>
        <isPublished>true</isPublished>
        <masterLabel>Contacts Manage Contacts Roles - Opportunity</masterLabel>
