<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Creating a Sales Generated Lead</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;Lead management enables sellers to capture, qualify, and progress leads in Sales CRM. Effective lead management helps ensure timely follow-up, visibility into lead activity, and accurate customer information throughout the sales cycle.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>MiddleCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Sales Generated Lead Step 1</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2026-08-24</startDate>
        <stepNumber>1</stepNumber>
        <targetPageKey1>home</targetPageKey1>
        <targetPageType>standard__namedPage</targetPageType>
        <themeColor>Theme1</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Lead Management in Sales CRM</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;In this process, sellers will create a lead record, select the appropriate record type, enter the required information, and save the record.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>MiddleCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Sales Generated Lead Step 2</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>2</stepNumber>
        <targetPageKey1>home</targetPageKey1>
        <targetPageType>standard__namedPage</targetPageType>
        <title>Lead Creation Process Overview</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Create a new &lt;strong&gt;Lead&lt;/strong&gt; by navigating to the status bar and clicking on to Leads Tab.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Sales Generated Lead Step 3</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;sfdc:TabDefinition.standard-Lead&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>3</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Click Leads Tab</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Select &lt;strong&gt;New &lt;/strong&gt;to create a new &lt;strong&gt;Lead Record.&lt;/strong&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Sales Generated Lead Step 4</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;sfdc:StandardButton.Lead.New&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>4</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Create a New Lead Record</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;To continue creating the Lead, select the &lt;strong&gt;Sales Lead Record Type&lt;/strong&gt; in the &lt;strong&gt;New Lead&lt;/strong&gt; window.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Important:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Select Sales Lead for Sales Generated Leads (SGLs) and Marketing Lead for Marketing Generated Leads (MGLs).&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>BottomLeft</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Sales Generated Lead Step 5</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>5</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>new</targetPageKey2>
        <targetPageKey3>{&quot;navigationLocation&quot;:&quot;LIST_VIEW&quot;,&quot;nooverride&quot;:&quot;1&quot;,&quot;useRecordTypeCheck&quot;:&quot;1&quot;,&quot;onRecordTypeSelection&quot;:true}</targetPageKey3>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Select Sales Lead Record Type</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Complete the required &lt;strong&gt;Lead&lt;/strong&gt; information by entering all &lt;strong&gt;mandatory fields&lt;/strong&gt; and &lt;strong&gt;validating&lt;/strong&gt; the &lt;strong&gt;lead details&lt;/strong&gt; before saving the record.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>BottomLeft</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Sales Generated Lead Step 6</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>6</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>new</targetPageKey2>
        <targetPageKey3>{&quot;navigationLocation&quot;:&quot;LIST_VIEW&quot;,&quot;nooverride&quot;:&quot;1&quot;,&quot;useRecordTypeCheck&quot;:&quot;1&quot;,&quot;onRecordTypeSelection&quot;:false}</targetPageKey3>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Complete Lead Information</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Complete creating a &lt;strong&gt;Lead&lt;/strong&gt; by reviewing the lead information and saving the record.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Sales Generated Lead Step 7</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;sfdc:StandardButton.Lead.SaveEdit&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>7</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>new</targetPageKey2>
        <targetPageKey3>{&quot;navigationLocation&quot;:&quot;LIST_VIEW&quot;,&quot;nooverride&quot;:&quot;1&quot;,&quot;useRecordTypeCheck&quot;:&quot;1&quot;,&quot;onRecordTypeSelection&quot;:false}</targetPageKey3>
        <targetPageType>standard__objectPage</targetPageType>
        <title>Save the Lead Record</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;The &lt;strong&gt;Lead&lt;/strong&gt; has been successfully created and is ready for the next stage of engagement.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Click Finish to exit the walkthrough.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>MiddleCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Creating a Sales Generated Lead Step 8</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>8</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <title>A Lead is Created</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
