<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Dashboards Follow or Subscribe to a Dashboard</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/reporting/follow-or-subscribe-to-reports-or-dashboards/</actionButtonLink>
        <body>&lt;p&gt;&lt;strong&gt;Follow a Dashboard&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;When you follow a Dashboard you will receive notifications in Chatter any time an update is made to the dashboard itself. This can be helpful if you don&apos;t own the Dashboard.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To follow a Dashboard,&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Open the Dashboard you want to follow.&lt;/li&gt;&lt;li&gt;Click the &lt;strong&gt;+ Follow&lt;/strong&gt; button.&lt;/li&gt;&lt;li&gt;The button changes to a checkmark to confirm you are following the Dashboard.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Subscribe to a Dashboard&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;The Subscribe option can be used to set up an automatic, recurring refresh for Dashboard data, along with the option of receiving an email each time a refresh takes place.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To subscribe to a Dashboard,&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Open the Dashboard you want to subscribe to.&lt;/li&gt;&lt;li&gt;Click the &lt;strong&gt;Subscribe&lt;/strong&gt; button. The&lt;em&gt; Edit Subscription&lt;/em&gt; window will open.&lt;/li&gt;&lt;li&gt;Select the frequency, days, and time you want the data to refresh.&lt;/li&gt;&lt;li&gt;In the &lt;strong&gt;Recipients&lt;/strong&gt; section, choose whether you’d like to receive email notifications each time the dashboard is updated, as well as who should receive the email.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Save&lt;/strong&gt;.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Dashboards Follow or Subscribe to a Dashboard</description>
        <displayType>DockedComposer</displayType>
        <header>Dashboards</header>
        <isPublished>true</isPublished>
        <masterLabel>Dashboards Follow or Subscribe to a Dashboard</masterLabel>
        <publishedDate>2024-02-01</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>Dashboard</targetPageKey1>
        <targetPageKey2>home</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Follow or Subscribe to a Dashboard</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
