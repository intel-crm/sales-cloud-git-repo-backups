<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>WW05 IUPGM Changes Docked Prompt</masterLabel>
    <promptVersions>
        <body>&lt;ul&gt;&lt;li&gt;&lt;strong&gt;&lt;u&gt;CCP Internal IPA Finance User&lt;/u&gt; Role : &lt;/strong&gt; This role is removed and merged into CCP Internal IPA Regional Budget Loader role.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;CCP Internal IPA Budget Loader: &lt;/strong&gt;Renamed to CCP Internal IPA Regional Budget Loader role.&lt;/li&gt;&lt;/ul&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <delayDays>1</delayDays>
        <displayType>DockedComposer</displayType>
        <header>Important Notes</header>
        <isPublished>true</isPublished>
        <masterLabel>WW05 IUPGM Changes Docked Prompt</masterLabel>
        <publishedDate>2023-02-03</publishedDate>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2023-02-03</startDate>
        <targetPageKey1>Core_MDF_Int_Users_Partner_Geo_Mapping__c</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <timesToDisplay>1</timesToDisplay>
        <title>IPA Role Changes</title>
        <uiFormulaRule>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_ccp - core access</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>SpecificProfiles</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
