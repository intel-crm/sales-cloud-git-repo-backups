<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Qualify/Disqualify a Sales Generated Lead</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;Open the &lt;strong&gt;Sales Generated Lead (SGL)&lt;/strong&gt; record to review ownership, qualification, and account coverage information.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>BottomCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 1</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2026-08-25</startDate>
        <stepNumber>1</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme1</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Open the Lead Record</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Search for and select the covered account associated with the company on the lead record.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;What to Verify:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;1. The correct covered account is selected.&lt;/p&gt;&lt;p&gt;2. The account is successfully associated to the lead.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 2</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;scope&quot;:{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;sfdc:RecordField.Lead.Core_Existing_Covered_Account__c&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;e749965136cc4d4d9fc02c6f9c4a08b7&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;force_detailPanel&quot;}},&quot;version&quot;:2,&quot;interactions&quot;:[{&quot;unless&quot;:{&quot;css&quot;:&quot;[aria-selected=true]&quot;},&quot;scope&quot;:{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;detailTabTab&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;flexipage_tabset&quot;}},&quot;type&quot;:&quot;click&quot;}]}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>2</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>Edit Covered Account Lookup</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Verify that the Covered Account Owner is &lt;strong&gt;automatically populated&lt;/strong&gt; after the covered account is saved.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Note:&lt;/strong&gt; If no matching account is found, continue nurturing the lead until the appropriate account owner can be identified.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 3</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;scope&quot;:{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;sfdc:RecordField.Lead.Core_Covered_account_owner__c&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;e749965136cc4d4d9fc02c6f9c4a08b7&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;force_detailPanel&quot;}},&quot;version&quot;:2,&quot;interactions&quot;:[{&quot;unless&quot;:{&quot;css&quot;:&quot;[aria-selected=true]&quot;},&quot;scope&quot;:{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;detailTabTab&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;flexipage_tabset&quot;}},&quot;type&quot;:&quot;click&quot;}]}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>3</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>Review the Account Owner</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Assign the lead to the account owner associated with the covered account to ensure proper ownership alignment.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Note: &lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Use the &lt;strong&gt;Change Owner&lt;/strong&gt; option to assign the covered account owner and send a notification email to the new owner. &lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <elementRelativePosition>LeftCenter</elementRelativePosition>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 4</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;force_highlightsPanel&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>4</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>Update Lead Ownership</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;A lead can be advanced to &lt;strong&gt;Sales Accepted Lead (SAL) &lt;/strong&gt;when required contact information, including:&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Name&lt;/li&gt;&lt;li&gt;Company Name&lt;/li&gt;&lt;li&gt;Job Function&lt;/li&gt;&lt;li&gt;Street Address&lt;/li&gt;&lt;li&gt;City&lt;/li&gt;&lt;li&gt;ZIP/Postal Code&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;has been completed, sufficient PACTT information has been gathered and validated, and the project is expected to begin within the approved qualification timeframe.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Note:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Leads should only be advanced when the information collected supports continued sales engagement.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <displayType>DockedComposer</displayType>
        <experience>Lightning</experience>
        <header>Assess Lead Qualification</header>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 5</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>5</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>Determine SAL Eligibility</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Set the Lead Sub Status to &lt;strong&gt;In Contact&lt;/strong&gt; once contact has been established with the lead and qualification activities have begun.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 6</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;scope&quot;:{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;sfdc:RecordField.Lead.Core_Lead_Sub_Status__c&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;e749965136cc4d4d9fc02c6f9c4a08b7&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;force_detailPanel&quot;}},&quot;version&quot;:2,&quot;interactions&quot;:[{&quot;unless&quot;:{&quot;css&quot;:&quot;[aria-selected=true]&quot;},&quot;scope&quot;:{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;detailTabTab&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;flexipage_tabset&quot;}},&quot;type&quot;:&quot;click&quot;}]}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>6</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>Edit Lead Sub Status</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Record outreach attempts and successful customer interactions throughout the qualification process under the &lt;strong&gt;&lt;em&gt;Activity tab&lt;/em&gt;&lt;/strong&gt;.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 7</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;activityTabTab&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;flexipage_tabset&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>7</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>Click the Activity Tab</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;This process applies to qualified Sales Generated Leads (SGLs) that have been assessed using the PACTT framework and contain the required contact information. Sellers will determine whether the lead should advance to the &lt;strong&gt;Sales Accepted Lead (SAL)&lt;/strong&gt; stage or be &lt;strong&gt;disqualified&lt;/strong&gt; based on qualification findings and opportunity readiness.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Important:&lt;/p&gt;&lt;p&gt;Disqualify a Sales Generated Lead &lt;strong&gt;(SGL)&lt;/strong&gt; when qualification requirements cannot be met, the opportunity is not suitable for further pursuit, or the lead cannot progress through the sales process.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Set the &lt;strong&gt;Lead Status&lt;/strong&gt; to &lt;strong&gt;Disqualified&lt;/strong&gt; to indicate that the lead will not continue through the sales process. Select the appropriate reason for disqualification and save the record.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Valid Lead Sub Status values for SGLs:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Already Engaged With Intel&lt;/li&gt;&lt;li&gt;Not Target Profile&lt;/li&gt;&lt;li&gt;Rep Inactivity&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <displayType>DockedComposer</displayType>
        <experience>Lightning</experience>
        <header>Determine Lead Disposition</header>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 8</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>8</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>Evaluate Lead Outcome</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Ensure that the required business and qualification information is complete before advancing the lead to the Sales Accepted Lead (SAL) stage.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Note:&lt;/p&gt;&lt;p&gt;Advance the lead only when qualification findings support progression to the SAL stage. Otherwise, skip it.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayPosition>BottomCenter</displayPosition>
        <displayType>FloatingPanel</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 9</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>9</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>Confirm Lead Readiness</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
    <promptVersions>
        <body>&lt;p&gt;Select &lt;strong&gt;Claim&lt;/strong&gt; to qualify the lead and advance it to the &lt;strong&gt;SAL&lt;/strong&gt; stage. Upon successful completion, a success message appears and the Lead Stage is automatically updated.&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <dismissButtonLabel>Dismiss</dismissButtonLabel>
        <displayType>Targeted</displayType>
        <experience>Lightning</experience>
        <isPublished>false</isPublished>
        <masterLabel>Qualify/Disqualify a Sales Generated Lead Step 10</masterLabel>
        <referenceElementContext>{&quot;scope&quot;:{&quot;scope&quot;:{&quot;attributes&quot;:{&quot;id&quot;:&quot;sfdc:QuickAction.Lead.Core_Claim&quot;}},&quot;attributes&quot;:{&quot;id&quot;:&quot;force_highlightsPanel&quot;}},&quot;version&quot;:2}</referenceElementContext>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <stepNumber>10</stepNumber>
        <targetPageKey1>Lead</targetPageKey1>
        <targetPageKey2>view</targetPageKey2>
        <targetPageType>standard__recordPage</targetPageType>
        <title>Click the Claim Button</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
