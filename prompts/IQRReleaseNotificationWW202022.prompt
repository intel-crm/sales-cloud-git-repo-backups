<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>IQR Release Notification WW20 2022</masterLabel>
    <promptVersions>
        <actionButtonLabel>What&apos;s New</actionButtonLabel>
        <actionButtonLink>https://salescrm.intel.com/ww18-2023-release-update/</actionButtonLink>
        <body>&lt;p&gt;The WW18&apos;23 KTBE release is now live! In this release we have deployed multiple new features with a focus on reporting standardization and tool usability improvements. Some release highlights include updates to our cancellation process and a reason for rejection drop down list. For full release details, please visit the&lt;a href=&quot;https://salescrm.intel.com/intel-quote-request-home/tenders-iqr-home&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt; IQR Training Home Page&lt;/a&gt;&amp;nbsp;&lt;/p&gt;</body>
        <delayDays>1</delayDays>
        <displayType>DockedComposer</displayType>
        <endDate>2023-08-01</endDate>
        <header>Welcome to Intel Quote Request</header>
        <isPublished>true</isPublished>
        <masterLabel>IQR Release Notification WW20 2022</masterLabel>
        <publishedDate>2023-05-04</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2023-05-04</startDate>
        <targetPageKey1>SBQQ__Quote__c</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <timesToDisplay>1</timesToDisplay>
        <title>Did you know?!?</title>
        <uiFormulaRule>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.Pricing_IQR_Tender_User}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>SpecificPermissions</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
