<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Acct Transfer</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;Hi!! Account  Transfer is used to transfer funds between accounts belonging to given budget.&lt;/p&gt;</body>
        <customApplication>Core_MDF_CoMarketing</customApplication>
        <delayDays>2</delayDays>
        <displayType>DockedComposer</displayType>
        <endDate>2020-04-30</endDate>
        <header>Account Transfer</header>
        <isPublished>false</isPublished>
        <masterLabel>Acct Transfer</masterLabel>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2020-04-24</startDate>
        <targetPageKey1>Account_Transfer</targetPageKey1>
        <targetPageType>standard__navItemPage</targetPageType>
        <timesToDisplay>30</timesToDisplay>
        <title>Fund Transfer Between Accounts</title>
        <uiFormulaRule>
            <booleanFilter>(1 AND 2) AND (3 OR 4 OR 5)</booleanFilter>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.Core_MDF_FinanceManager}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.Core_MDF_FinanceMgr_FinanceUser_ClaimCaseRev_ClaimCaseMgr}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_ccp - core access</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>Admin</rightValue>
            </criteria>
            <criteria>
                <leftValue>{!$User.Profile.Key}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>custom_it admin</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>SpecificPermissions</userAccess>
        <userProfileAccess>SpecificProfiles</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
