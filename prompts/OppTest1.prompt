<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>OppTest1</masterLabel>
    <promptVersions>
        <body>&lt;p&gt;Please click on finish button.   &lt;/p&gt;</body>
        <delayDays>1</delayDays>
        <displayType>DockedComposer</displayType>
        <endDate>2023-07-26</endDate>
        <header>Testing docking Promo</header>
        <isPublished>true</isPublished>
        <masterLabel>OppTest1 Step 1</masterLabel>
        <publishedDate>2023-07-17</publishedDate>
        <shouldDisplayActionButton>false</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2023-07-16</startDate>
        <stepNumber>1</stepNumber>
        <targetPageKey1>Opportunity</targetPageKey1>
        <targetPageKey2>list</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme1</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>10</timesToDisplay>
        <title>Docking promo</title>
        <uiFormulaRule>
