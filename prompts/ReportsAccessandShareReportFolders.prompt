<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Reports Access and Share Report Folders</masterLabel>
    <promptVersions>
        <actionButtonLabel>More Information</actionButtonLabel>
        <actionButtonLink>https://salescrmtraining.intel.com/sales-tools/sales-crm/reporting/access-and-share-report-folders/</actionButtonLink>
        <body>&lt;p&gt;If you are the manager of a Report Folder, it is your responsibility to manage access to a report. Access levels include:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Editor&lt;/strong&gt;: Can edit the reports in the folder&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Viewer&lt;/strong&gt;: Can only view reports in the folder&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Note that public reports may be accessed by all internal users.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To share/provide access to a Report,&lt;/p&gt;&lt;ol&gt;&lt;li&gt;From the &lt;strong&gt;Reports&lt;/strong&gt; tab, locate the Report on the page, scroll to the far right and click the drop down menu.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Share&lt;/strong&gt;. The &lt;em&gt;Share folder&lt;/em&gt; window will open.&lt;/li&gt;&lt;li&gt;In the &lt;strong&gt;Share With&lt;/strong&gt; field, make sure that the &lt;em&gt;Users&lt;/em&gt; option is selected. Select the &lt;strong&gt;Names&lt;/strong&gt; field to locate and select a user to share the folder with. Multiple users can be selected.&lt;/li&gt;&lt;li&gt;Use the &lt;strong&gt;Access&lt;/strong&gt; field to select the level of access for each user being added.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Share&lt;/strong&gt;.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://goto.intel.com/in-app-feedback&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;em&gt;Feedback and additional training topic suggestions&lt;/em&gt;&lt;/a&gt;&lt;em&gt; are always welcome and reviewed quarterly.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</body>
        <customApplication>standard__LightningSales</customApplication>
        <delayDays>1</delayDays>
        <description>Reports Access and Share Report Folders</description>
        <displayType>DockedComposer</displayType>
        <header>Reports</header>
        <isPublished>true</isPublished>
        <masterLabel>Reports Access and Share Report Folders</masterLabel>
        <publishedDate>2024-02-02</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>false</shouldIgnoreGlobalDelay>
        <startDate>2023-05-10</startDate>
        <targetPageKey1>Report</targetPageKey1>
        <targetPageKey2>home</targetPageKey2>
        <targetPageType>standard__objectPage</targetPageType>
        <themeColor>Theme2</themeColor>
        <themeSaturation>Dark</themeSaturation>
        <timesToDisplay>1</timesToDisplay>
        <title>Access and Share Report Folders</title>
        <userAccess>Everyone</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
