<aura:component implements="forceCommunity:availableForAllPageTypes" controller="PMP_SearchMarketplaceController">
    
    <aura:attribute name="catChilds" type="object[]" />
    <aura:attribute name="isDataReady" type="boolean" default="false"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    
 
    
    <div class="bg-white">
        <aura:if isTrue="{!v.isDataReady}">
            <ul class="wrapper">
            	<li class="parentCat"><u>Categories</u></li><br></br>
            <aura:iteration items="{!v.catChilds}" var="item" indexVar="idx">
                <aura:if isTrue="{!item.url}">
                	
                   <li> <div class="{!'ctLevel-'+item.categoryLevel}">
                    <c:IntelLink title="{!item.Name}" recordId="{!item.Id}" objectApiName="{!item.objectApiName}" label="{!item.Name}"/>
                    </div></li><br></br>
                    <aura:set attribute="else">
                    <li class="parentCat"><u>{!item.Name}</u></li><br></br>
                    </aura:set>
                </aura:if>
                
            </aura:iteration>
            <br></br>
        </ul>
        </aura:if>
        
        
    </div> 
    
</aura:component>