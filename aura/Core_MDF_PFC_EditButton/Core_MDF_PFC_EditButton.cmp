<!-- Component Used to Show the Edit Button on the Community for Partner Fund Claim-->
<aura:component
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride"
    access="global" controller="Core_MDF_PartnerFundClaim_Edit">
    <!-- Handler function for fetching value on the load of the component -->
    <aura:handler name="init" value="{!this}" action="{!c.checkObjectPermission}" />

    <!-- Attribute Initialization -->
    <aura:attribute type="Boolean" name="CheckEdit" Default="false"
        description="Controls the rendering of the edit component on click of the button" />
    <aura:attribute type="Boolean" name="objectEditPermission" Default="false"
        description="Checks the permission for the CRUD user" />
    <aura:attribute name="recordId" type="String" default="" />

    <!--Onclick Of the Button To Open the Edit page -->
    <aura:if isTrue="{!v.CheckEdit}">
        <c:Core_MDF_PFC_EditSwitch recordId="{!v.recordId}" />
    </aura:if>

    <!-- Show Edit Button Only if the object has CRUD Permission -->
    <aura:if isTrue="{!v.objectEditPermission}">
        <div class="slds-float--right">
            <lightning:button aura:id="editButton" label="{!$Label.c.Core_MDF_Edit}" title="Edit"
                onclick="{!c.handleClick }" />
        </div>
    </aura:if>
</aura:component>