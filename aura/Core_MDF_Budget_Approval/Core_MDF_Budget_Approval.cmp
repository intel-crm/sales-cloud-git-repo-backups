<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes" 
                access="global" Controller="Core_MDF_Budget_Approval">
    
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="buttonToBeVisible" type="Boolean" default="false" />
    <aura:attribute name="showApprovalCommentSection" type="Boolean" default="false" />
    <aura:attribute name="btnValue" type="String" />
    <aura:attribute name="commentType" type="String" />
    <aura:attribute name="approvalComments" type="String" default="" />
    <aura:attribute name="budgetMapInstance" type="Map" default="{}" />
    <aura:attribute name="loadSpinner" type="Boolean" default="false" />
    
    <!-- Onload of the Page the values to be loaded  -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <aura:if isTrue="{!v.buttonToBeVisible}">
       <lightning:layoutItem flexibility="grow" size="12" mediumDeviceSize="12" largeDeviceSize="12">
           <lightning:card>
           <div align="center">
               <!--<p id="header23" class="slds-text-heading small headings"> Approval Request</p>
               <br></br>-->
               <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}" value="{!$Label.c.Core_MDF_Retail_Approve}" 
                                 onclick="{!c.approvalAction}" />
               <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}" value="{!$Label.c.Core_MDF_Retail_Reject}" 
                                 onclick="{!c.approvalAction}" />
           </div>
           </lightning:card>
       </lightning:layoutItem>
    </aura:if>
    <aura:if isTrue="{!v.showApprovalCommentSection}">
        <div role="dialog" tabindex="-1" aria-labelledby="header43" class="slds-modal slds-modal_small slds-slide-up-saving">
            <div class="slds-modal__container">
                <!-- Heading (Header of the Modal) -->
                <div class="slds-modal__header">
                    <lightning:buttonIcon iconName="utility:close" class="slds-button slds-modal__close slds-button_icon-border slds-button_icon-large" variant="bare" onclick="{! c.closeModal }"  alternativeText="Close" />
                    <!--<button class="slds-button slds-modal__close slds-button-icon-inverse" title="Close" onclick="{!c.closeModal}">
                        X<span class="slds-assistive-text"></span>
                    </button>-->
                    <h1 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!v.commentType}</h1>
                </div>
                <div class="slds-modal__content slds-p-around--medium">
                    <lightning:textarea required="false" maxlength ="1000" value="{!v.approvalComments}" />
                    <p class="slds-var-m-top_xx-small commentsLimitColor">{!$Label.c.Core_MDF_Comments_CharLimit}</p>
                </div>
                <div class="slds-modal__footer">
                    <lightning:button class="slds-button slds-button--neutral" onclick="{!c.closeModal}">{!$Label.c.Core_MDF_Cancel}</lightning:button>
                    <lightning:button class="slds-button slds-button--brand" onclick="{!c.callApprovalProcessAndUpdateField}" disabled="{!v.disablebuttonName}">{!$Label.c.Core_MDF_Save}</lightning:button>
                    <aura:if isTrue="{!v.loadSpinner}">
                        <lightning:spinner alternative-text="Loading" size="large"></lightning:spinner>
                    </aura:if>
                </div>
            </div>
        </div>
        <div aura:id="backdropIdForNewRecord" class="slds-backdrop slds-backdrop--open"></div>
    </aura:if>
</aura:component>