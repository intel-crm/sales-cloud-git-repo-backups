<aura:component extends="c:MarketplaceRedux" implements="forceCommunity:availableForAllPageTypes">
    <aura:set attribute="storeName" value="Settings" />
    <aura:attribute name="data" type="Object" description="Offering Data"/>
    <aura:attribute name="breadcrumbData" type="object[]" description="Breadcrumb Data"/>
    <aura:attribute name="modalOpen" type="Boolean" default="false" description="Internal component state"/>
    <aura:attribute name="scale" type="string" description="Internal component state"/>
    <aura:attribute name="width" type="integer" description="Internal component state"/>
    <aura:attribute name="height" type="integer" description="Internal component state"/>
    <aura:attribute name="styleTransform" type="string" description="Internal component state"/>
    
    <aura:attribute name="offeringId" type="Id" />
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <div aura:id="offferingDetail">
        <aura:if isTrue="{! !empty(v.appState.Settings.currentScreenSize)}">
            <aura:if isTrue="{!v.appState.Settings.currentScreenSize == 'desktop'}">
                <div aura:id="outerContainer" class="outerContainer" onclick="{!c.handleClick}">
                    <div aura:id="innerContent" class="scaledInnerContainer" >
                        <div class="marquee">
                            
                            <!--								<c:MarketplaceL3Marquee
          previewMode="true"
          displayType="product"
          product="{!v.data.productDetails}"
          partner="{!v.data.partnerDetails}"
          showSignIn="false"
          lastUpdatedDate="12/12/18"
          breadcrumbData="{!v.breadcrumbData}"
         />-->
                            
                            
                            <c:MarketplaceL3Marquee
                                                    previewMode="true"
                                                    displayType="product"
                                                    showSignIn="false"
                                                    recordId="{!v.offeringId}"
                                                    analyticsPageType="OfferingDetailPage"
                                                    />
                            
                            
                        </div>
                        <div class="slds-p-horizontal_xx-large">
                            <c:MarketplaceProductDetail previewMode="true" offeringId="{!v.offeringId}"/>
                        </div>
                    </div>
                </div>
                <aura:set attribute="else">
                    <div class="slds-p-horizontal_medium slds-p-vertical_large">
                        <span  onclick="{!c.handleToggleModal}"><c:IntelButton class="largeMobile" >Show Mobile Preview</c:IntelButton></span>
                    </div>
                    <div class="create-offering-overlay slds-hide" aura:id="overlay">
                        <div class="create-offering close-heading">
                            <h3 class="heading-28 color-white">Preview</h3>
                            <a class="close" href="#" aria-label="Close" onclick="{!c.handleToggleModal}">
                                <lightning:icon class="icn" iconName="utility:close" size="small" />
                            </a>
                        </div>
                        <div class="body create-offering-body">
                            <div class="marquee">
                                <!--<c:MarketplaceL3Marquee
           previewMode="true"
           displayType="product"
           product="{!v.data.productDetails}"
           partner="{!v.data.partnerDetails}"
           showSignIn="true"
           lastUpdatedDate="12/12/18"
           breadcrumbData="{!v.breadcrumbData}"
          />-->
                                <c:MarketplaceL3Marquee
                                                        previewMode="true"
                                                        displayType="product"
                                                        showSignIn="false"
                                                        recordId="{!v.offeringId}"	
                                                        />
                            </div>
                            <c:MarketplaceProductDetail previewMode="true"  offeringId="{!v.offeringId}"/>
                        </div>
                    </div>
                </aura:set>
            </aura:if>
        </aura:if>
        
        
        
        
    </div>
    
</aura:component>