                                                        <label class="slds-form-element__label slds-no-flex">{!$Label.c.Core_MDF_ActivityReimbursementRate}</label>
                                                    </div>
                                                    <div class="slds-col">
                                                        <div><lightning:helptext iconName="utility:info" content="{!$Label.c.Core_MDF_Act_Reimb_Rate_help_text}" /></div>
                                                    </div>
                                                </div>
                                                <lightning:input aura:id="NewForm" type="text" variant = "label-hidden"
                                                                 required="false" name="ActivityReimbursementRate" value="{!v.ActReimbursementRt}" onchange="{!c.calcContribution}" onblur = "{!c.addPercentage}" onclick = "{!c.removePercentage}" 
                                                                 disabled="{!(v.externalper == true || v.isPropBasedOutcomeCampActRR ? 'true' : v.pfrFieldEditablity.Core_MDF_Reimbursement_Rate_txt__c)}"/>
                                                
                                            </aura:if>
                                        </aura:if>
