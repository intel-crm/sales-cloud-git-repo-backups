                                                <p class='red-fc'><lightning:formattedText  value="{!v.actReimbErrorMsg}"/></p>    
                                                
                                            </aura:if>
                                            
                                        </lightning:layoutItem>
                                        <!--Indu IPA Proposal -->
                                       <!--Maximum Intel Investment field-->
                                      <lightning:layoutItem padding="around-small" flexibility="grow" size="5" smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5">
    <aura:if isTrue="{!and(v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType,v.isPropBasedCampaign)}">
        <aura:if isTrue="{!(!empty(v.pfrFieldVisibility))}">
            <lightning:input aura:id="NewForm" type="number" formatter="{!v.budgetCurrency == 'USD' ? 'currency' : ''}" step="any" min="0" label="{!$Label.c.Core_MDF_Maximum_Intel_Investment}" required="true" name="MaximumIntelInvestment" value="{!v.maximumIntelInvestment}" onchange="{!c.calculateMaxIntelInvestment}" disabled="{!v.pfrFieldEditablity.Core_MDF_Maximum_Intel_Investment_amt__c}"/>
            <aura:if isTrue="{!v.showErrorMsgForMaxIntelInvest}"><p class="red-fc">{!v.ErrorMsgForMaxIntelInvest}</p></aura:if>
        </aura:if>
        <aura:set attribute="else">
            <aura:if isTrue="{!(!empty(v.pfrFieldVisibility))}">
                <lightning:input aura:id="IntelContribution" type="number" step="0.01" label="{!$Label.c.Core_MDF_IntelContribution}" required="false" name="Contribution" value="{!v.IPAIntelContri}" disabled="true"/>
            </aura:if>
        </aura:set>
    </aura:if>
</lightning:layoutItem>
                                       <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                      largeDeviceSize="1"></lightning:layoutItem>
                                <aura:set attribute="else">
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                      largeDeviceSize="1"></lightning:layoutItem>
                                <!-- Currency Field-->
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5"
                                                      largeDeviceSize="5">
                                    <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Budget_Currency_cd__c}">
                                        <lightning:select aura:id="BudgetCurrency456" name="BudgetCurrency" value="{!v.budgetCurrency}"
                                                          label="{!$Label.c.Core_MDF_Budget_Currency}" 
                                                          disabled="{!(v.pfrFieldEditablity.Core_MDF_Budget_Currency_cd__c|| v.disableCurrency)}" 
                                                          onchange="{!c.calculateBudgetAmount}" class ="elementLabel" >
                                            <aura:iteration items="{!v.currMap}" var="item">
                                                <aura:if isTrue="{!((not(empty(v.newPFR.Id))) || (v.checkCloneAttribute))}"><!-- Edit and Clone to get the data from PFR  -->
                                                    <option value="{!item.key}" selected="{!item.key == v.newPFR.Core_MDF_Budget_Currency_cd__c}">
                                                        {!item.value}
                                                    </option>
                                                    <aura:set attribute="else"><!-- For New, USD is default  -->
                                                        <option value="{!item.key}" selected="{!item.key == 'USD'}">
                                                            {!item.value}
                                                        </option>
                                                    </aura:set>
                                                </aura:if>
                                            </aura:iteration>
                                        </lightning:select>
                                    </aura:if>
                                </lightning:layoutItem>
                                <!--Activity Spending Limit Local field-->
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
