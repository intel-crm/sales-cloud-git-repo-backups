                                        <lightning:input aura:id="IntelContribution" type="number" step="0.01" label="{!$Label.c.Core_MDF_IntelContribution}" required="false" name="Contribution" value="{!v.IPAIntelContri}" disabled="true" />
                                    </aura:if>
                                </lightning:layoutItem>
                                
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                      largeDeviceSize="1"></lightning:layoutItem>
                                </aura:set>
