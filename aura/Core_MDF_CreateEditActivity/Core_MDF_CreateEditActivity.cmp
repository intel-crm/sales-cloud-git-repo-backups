                                        <lightning:input aura:id="BudgetAmount" type="number" label="{!$Label.c.Core_MDF_Budget_Amount}" required="true" name="BudgetAmount" onchange = "{!c.calculateBudgetAmount}" value="{!v.BudgetLocal}" min="0" step="any" disabled="{!v.pfrFieldEditablity.Core_MDF_Budget_Amount_Local_amt__c}" />
                                     <aura:if isTrue="{!v.showErrorMsgForSpendingLimit}">
                                                <p class= "red-fc">{!v.ErrorMsgForSpendingLimit}</p>  
                                               </aura:if>
                                    </aura:if>
                                    
                                </lightning:layoutItem>
