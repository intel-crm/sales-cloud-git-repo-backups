                                                             required="false" name="ActivityReimbursementRate" value="{!v.ActReimbursementRt}" onchange="{!c.calcContribution}" onblur = "{!c.addPercentage}" onclick = "{!c.removePercentage}" 
                                                             disabled="{!(v.externalper == true ?'true':v.pfrFieldEditablity.Core_MDF_Reimbursement_Rate_txt__c)}"/>
                                            
                                        </aura:if>
                                        <aura:if isTrue = "{!v.actReimbRateError}">
                                            <p class='red-fc'><lightning:formattedText  value="{!v.actReimbErrorMsg}"/></p>    
                                            
