                            <!--Priority Field for IPA-->
                            <aura:if isTrue="{!and(v.pfrFieldVisibility.Core_MDF_Priority_nm__c,!empty(v.selectedFocusArea,v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType))}"> 
