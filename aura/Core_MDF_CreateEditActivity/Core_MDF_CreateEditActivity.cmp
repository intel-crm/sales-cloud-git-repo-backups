    <aura:attribute name="recordApplicableForActivityRules" type="Boolean" default ="true" />
    <aura:attribute name="checkbudgetcondition" type="Boolean" default ="false" />
    <aura:attribute name="checkfileuploadcondition" type="Boolean" default ="false" />
    
    <!-- Atrribute to store the userpermissions for AM,CR and External  -->
    <aura:attribute name="userperMap" type="Map" default="{}"/>
    <aura:attribute name="fileexceptionper" type="Boolean" default="false"/>
    <aura:attribute name="auditorper" type="Boolean" default="false"/>
    <aura:attribute name="externalper" type="Boolean" default="false"/>
    <aura:attribute name="accmgrper" type="Boolean" default="false"/>
    <aura:attribute name="retailgeouserper" type="Boolean" default="false"/>
    <aura:attribute name="ipaApproverPer" type="Boolean" default="false" /> 
    <aura:attribute name="ipaAcctMgr" type="Boolean" default="false" /> 
    <aura:attribute name="rmfexternalper" type="Boolean" default="false" />
    <aura:attribute name="ipaL2Approver" type="Boolean" default="false" />
    <aura:attribute name="userWithoutAccess" type="Boolean" default="false"/>
    <aura:attribute name="isActivityReviewRequired" type="Boolean" default="false" />
    <aura:attribute name="isUserCurrentIPAApprover" type="Boolean" default="false" />
    <aura:attribute name="popVisible" type="Boolean" default="false" />
    <aura:attribute name="existingIntelOwner" type="String" default="" />
    <aura:attribute name="existingMemberActivityOwner" type="String" default=""/>
    <aura:attribute name="existingMemberActivityOwnerId" type="String" default=""/>
    <!-- Variable Reimbursement Rate changes-->
    <aura:attribute name="incentive" type="String" default="" />
    <aura:attribute name="incentiveCriteriaId" type="String" />
    <aura:attribute name="vrQuestion" type="String" default="" />
    <aura:attribute name="vrOptInQuestion" type="String" default="" />
    <aura:attribute name="cmpgnStatus" type="String" default="Draft" />
    <!-- SPIF Attributes start -->
    <aura:attribute name="isSPIFSecAvailable" type="Boolean" default="false" />
    <aura:attribute name="isSPIFSecReadOnly" type="Boolean" default="true" />
    <aura:attribute name="segmentString" type="String" default="" />
    <aura:attribute name="tacticMetricsValues" type="Map" default="{}" />
    <aura:attribute name="mode" type="String" default="" />
    <aura:attribute name="isSPIFSecModified" type="Boolean" default="false" />
    <!-- SPIF Attributes end -->
    <aura:attribute name="checkGeoLeadMetricSecEditability" type="Boolean" default="false" />
    <aura:attribute name="activityClosureType" type="String" default="" />
    <aura:attribute name="disableRSMMetricEditability" type="Boolean" default="false" />
    <aura:attribute name="selAvailableBudget" type="String" default="" description="Stores the Budget Type selected from campaign" />
    <!-- Sneha -->
    
    <!-- OPAL Attributes starts-->
    <aura:attribute name="isBTSelAtCampaign" type="Boolean" default="false" description="To check whether the Budget type is selected at Campaign or not"/>
    <aura:attribute name="selBudgetType" type="String" default="" description="Stores the Budget Type selected from campaign" />
    <aura:attribute name="selectedFocusArea" type="String" default="" description="Stores the Focus Area selected from campaign" />
    <aura:attribute name="selectedSalesMotionValues" type="String" default="" description="Stores the sales motion selected from campaign" />
    <aura:attribute name="selectedIPAPriority" type="String" default="" description="Stores the priority selected from campaign" />
    <aura:attribute name="doInitCheck" type="Boolean" default="false" description="to determine method called from doInit" />
    <aura:attribute name="budgetTypeVal" type="String[]" description="Map used for Global key Map value pair for Budget Type" />
    <aura:attribute name="isCCFDCFRecType" type="Boolean" default="false" />
    <aura:attribute name="singleBudgetType" type="Boolean" default="false" description="Set to true if only one Budget Type is selected at Campaign" />
    <aura:attribute name="FlexiReimbursementAmt" type="String" default="" description="Flexible Reimbursement Amount" />
    <aura:attribute name="isBudgetTypeFlexible" type="Boolean" default="false" />
    <aura:attribute name="reimbursementRatePickValues" type="String[]" description="Stores the Reimbursement rate picklist values"/> 
    <aura:attribute name="disableRRPercent" type="Boolean" default="false" />
    <aura:attribute name="isOpalActivity" type="Boolean" default="false" />
    <aura:attribute name="competetiveElement" type="String" default="false" />
    <aura:attribute name="incentivePercent" type="String" default="false" />
    <aura:attribute name="ActivityCategoriesMain" type="String[]" description="to store activity categories"/>
    <!--To Control Goverment Question for Event Activity Type -->
    <aura:attribute name="hideCompetitiveQuest" type="boolean" default="false" />
    <aura:attribute name="isOPALApprover" type="Boolean" default="false" />
    <aura:attribute name="newRRValue" type="Integer" default="" description="Stores the new Reimbursement Rate percent calculated value" />
    <!-- OPAL Attributes Ends-->
    <aura:attribute name="isOwnerInactive" type="Boolean" default="false" />
    <aura:attribute name="isExtActSubmitterInactive" type="Boolean" default="false" />	
    <aura:attribute name="isAdditionalReviewReqd" type="Boolean" default="false" />
    <aura:attribute name="isLoggedInUserLevelOneApprover" type="Boolean" default="false" />
    <aura:attribute name="opalAccountManagers" type="Boolean" default="false"/>
    <aura:attribute name="priceReviewersPer" type="Boolean" default="false"/>
    <aura:attribute name="hasIUPGMRecord" type="Boolean" default="false"/>
    <aura:attribute name="userId" type="String" />
    <aura:attribute name="approvalStage" type="String" />
    <aura:attribute name="budgetAvailableFlag" type="Boolean" default="false" />
    <aura:attribute name="clonedCampaignRecord" type="Campaign"/>
    <!-- To check Opportunity Id is valid -->
     <aura:attribute name="isInvalidOppId" type="boolean" default="false"
                    description="To check opportunity id is SF Id" />
    <!--To Check activity creation Access -->
      <aura:attribute name="hasCreateAccess" type="boolean" default="false"
                    description="To check if user has create access " />
    <!--// [IPA MDF] - Campaign - Clone a Proposal - Activity Section -->
    <aura:attribute name="pfrCloneCheck" type="boolean" default ="false" />
    <aura:attribute name="metricCloneVal" type="String" default ="" />
    <aura:registerEvent name="ipaActRecClone" type="c:Core_MDF_IPAActivityClone" />
    <aura:attribute name="updatedBuSplit" type="String" default = "" />
    <aura:attribute name="ActReimbursementRt" type="String" default="" description="Activity Reimbursement Rate" />
    <aura:attribute name="IPAIntelContri" type="Integer" default="" 
                    description="Stores the intel contribution amount"/>
    <!--Indu IPA Proposal -->
    <aura:attribute name="maximumIntelInvestment" type="Decimal" default=""
                    description="Stores Maximum Intel Investment"/>
    <aura:attribute name="showErrorMsgForMaxIntelInvest" type="Boolean" default="false"/>
    <aura:attribute name="ErrorMsgForMaxIntelInvest" type="String" default=""/>
    <aura:attribute name="showIPAProposalEditWarning" type="Boolean" default="false"/>
    <aura:attribute name="lockIPAProposalCurrency" type="Boolean" default="false"/>
    <aura:attribute name="actReimbRateError" type="boolean" default="false"/>
    <aura:attribute name="actReimbErrorMsg" type="String" default="" description = "Stores Activity Reimbursement Rate field validation error message "/>
    <aura:attribute type="PartnerFundRequest" name="pfrCloneOnCampaign"
                    description="Stores the actualy field value of PFR object before Editing the record "></aura:attribute>
    <!--  [IPA MDF] - Campaign - Clone a Proposal - Activity Section e end-->
    <aura:attribute name="activityAmount" type="Decimal" />
    <aura:attribute name="isActivityLayout" type="Boolean" default="false" />
    <aura:attribute name="isEditPlanned" type="Boolean" default="false" />
    <aura:attribute name="isIntEditPlanned" type="Boolean" default="false" />
    <aura:attribute name="isActivityCreationOnCampaign" type="Boolean" default="false"/>
    <aura:attribute name="countryValidation" type="Boolean" default="false"/>
    <aura:attribute name="campPfrDateMismatch" type="Boolean" default="false"/>
    <aura:attribute name="activityCreationStartTime" type="Long" default="" description="This attribute holds the Start time when user is creating activity"/>
    <lightning:navigation aura:id="navService"/>
    <!-- POP and Attribution attribute-->
    <aura:attribute name="isAttributionReqVisible" type="Boolean" default="false" description="Controls the visibility of Attribution Requirements field"/>
    <aura:attribute name="isPOPReqVisible" type="Boolean" default="false" description="Controls the visibility of POP Requiremnets field"/>
    <!-- Handler for on change event of above attributes and fields on the form -->
    <aura:handler name="change" value="{!v.recordtypeName}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.SelCategory}" action="{!c.resetActivtyType}" />
    <aura:handler name="change" value="{!v.competetiveElement}" action="{!c.resetIntelContribution}" />
    <aura:handler name="change" value="{!v.incentivePercent}" action="{!c.resetIntelContribution}" />
     <aura:handler name="change" value="{!v.selectedTacticsOptions}" action="{!c.handlePCTApprovalChange}"/><!---PCT Added-->
    <!-- Commented below line as part of US901407 to remove field Dependencies  -->
    <aura:handler name="change" value="{!v.SelProductType}" action="{!c.resetBrand}" />
    <aura:handler name="change" value="{!v.selectedFocusArea}" action="{!c.focusAreaChange}" /> 
    <aura:handler name="change" value="{!v.selectedEcosystemPartnerOptions}" action="{!c.onEcosystemPartnerChange}" />
    <aura:handler name="change" value="{!v.selectedInitiativeOptions}" action="{!c.onInitiativesChange}" />
    <aura:handler name="change" value="{!v.selectedBrandOptions}" action="{!c.onBrandChange}" />
    <aura:handler name="change" value="{!v.selectedIndPartnerOption}" action="{!c.onIndustryPartnerChange}" />
    <aura:handler name="change" value="{!v.selectedTargetAudienceOptions}" action="{!c.onTargetAudienceChange}" /> 
    <aura:handler name="change" value="{!v.SelProductType}" action="{!c.onProductChange}" />
    <aura:handler name="change" value="{!v.SelPriority}" action="{!c.onPriorityChange}" /> 
    <aura:handler name="change" value="{!v.selectedLookUpRecord}" action="{!c.resetPicklistValues}" />
    <aura:handler name="change" value="{!v.SelActivityType}" action="{!c.resetActTypeDepAttributes}" />
    <aura:handler name="change" value="{!v.selectedSubTypeOptions}" action="{!c.getKPIAttributes}" />
    <aura:handler name="change" value="{!v.selActivityEventName}" action="{!c.onEventNameChange}" />
    <aura:handler name="change" value="{!v.selectedPartner}" action="{!c.resetAccountattributes}" />
    <aura:handler name="change" value="{!v.countryFilter}" action="{!c.filterCountry}" />
    <aura:handler name="change" value="{!v.brandFilter}" action="{!c.filterBrand}" />
    <aura:handler name="change" value="{!v.approverFilter}" action="{!c.filterApprover}" />
    <aura:handler name="change" value="{!v.extActSubmitterFilter}" action="{!c.filterExtActSubmitter}"/>
    <!-- Fetch selected Country values and reset CPLed when a country value is selected or changed-->
    <aura:handler name="change" value="{!v.selectedCountryOptions}" action="{!c.setCtryResetCPLed}"/>
    <aura:handler name="change" value="{!v.selectedApproverOptions}" action="{!c.setApprover}"/>
    <aura:handler name="change" value="{!v.selectedExtActSubmitterOptions}" action="{!c.setExtActSubmitter}"/>
    <aura:handler name="change" value="{!v.selectedLookUpRecord}" action="{!c.setFocusAreaOnCampchange}"/>
    <!-- Variable Reimbursement Rate changes-->
    <aura:handler name="change" value="{!v.SelBrand}" action="{!c.resetonBrandChange}" />
    <aura:handler name="change" value="{!v.selBudgetType}" action="{!c.budgetTypeChangeOPAL}" />
    <!--OPAL Ends-->
    <!-- [Opal - CCF/DCF] - [OOC - P6] - Replace "Channel Partner" with "Industry Partner"-->
    <aura:handler name="change" value="{!v.selectedIndPartnerOptions}" action="{!c.indPartnerChange}" />
    <!-- BU Split
    <aura:handler name="change" value="{!v.buSplitSelectedList}" action="{!c.busplitOnChange}" />-->
    <!--SPIF Amount -->
    <aura:handler name="change" value="{!v.SelReimbursementRate}" action="{!c.calcContribution}" />
    <!-- test code for KPI read only begins -->
    <!--<aura:handler event="force:refreshView" action="{!c.customSave}" />-->
    <!-- Event Handler For the PickList component values change -->
    <aura:handler name="PicValue" event="c:Core_MDF_PickListChangeEvent" action="{!c.SetOtherCPValue}"/>   
    <!-- Onload of the Page the values to be loaded on New and Edit Scenario -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <!-- Event Handler For the ELC Popup -->
    <aura:handler name="ButtonClickEvent" event="c:Core_MDF_PopupButtonClick" action="{!c.hidePopup}"/>
    <!-- Event Handler For the File Update -->
    <aura:handler name="fileuploadcheck" event="c:Core_MDF_Activity_Upload_File_Event" action="{!c.uploadfile}"/>
    <!-- Event Handler For Question rendering -->
    <aura:handler name="dynamicQuestionEvt" event="c:Core_MDF_DynamicQuestionEvent" action="{!c.questions}"/>
    <aura:handler name="change" value="{!v.selectedKPIOptions}" action="{!c.onKPIChange}"/>
    <!--Event Handler for Activity tactics field-->
    <aura:handler name="change" value="{!v.selectedTacticsOptions}" action="{!c.onTacticsChange}"/>
    <!-- Variable Reimbursement Rate changes-->
    <aura:attribute name="renderVRQuestion" type="boolean" default="false" />
    <aura:attribute name="vrdata" type="List" default="" description="Stores the PFR VR data from server side" />
    
    <!-- RecordTypeSelectorComp called after save is completed -->
    <aura:attribute name="isPropBasedCampaign" type="boolean" default="false" />
    <!--Akash-RR% -->
    <aura:attribute name="isPropBasedOutcomeCampaign" type="boolean" default="false" />
    <aura:attribute name="isPropBasedOutcomeCampActRR" type="boolean" default="false" />
    <aura:attribute name="updateSelected" type="boolean" default="false" />
    <aura:attribute name="updatedCampPicklistValues" type="object" description="Stores the updated fields and picklist values of campaign record."/>
    <aura:attribute name="updatedCampaignObj" type="Object" />
    <aura:attribute name="updatedCampBudgetType" type="String"/>
    <aura:attribute name="isClearedOnClone" type="boolean" default="false" />
    <aura:attribute name="isDecimalApplicable" type="boolean" default="false" />
    <aura:attribute name="latestCategoryValues" type="String[]" description="Stores the latest values of Activity Category from Custom Setting" />
    <aura:attribute name="oldStartDate" type="Date" description="Stores the latest values of Activity Category from Custom Setting" />
    <aura:attribute name="showStartDateError" type="Boolean" default="false" />
    <aura:if isTrue = "{!v.showSpinner}" >
        <lightning:spinner alternativeText="Loading" size="large" class = "slds-is-fixed"></lightning:spinner>
        <div class="slds-spinner">
        </div>
    </aura:if>    
    <aura:if isTrue = "{!v.showIntelOwnerSpinner}" >  
        <lightning:spinner alternativeText="Loading" size="large"></lightning:spinner>      
    </aura:if>
    
    <aura:if isTrue="{!and(v.isSaveandNew,v.checkSaveComplete)}">
        
        <aura:if isTrue="{!v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType}">
            <c:Core_MDF_PFR_RecordTypeSelectorComp checkCommunityAttribute="{!v.checkNewCommunityAttribute}" isCampaignUrl="true" recordId="{!v.selectedLookUpRecord.Id}" campaignObject="{!v.selectedLookUpRecord}" checkSaveandNew="{!v.isSaveandNew}" />
            <aura:set attribute="else">
                <c:Core_MDF_PFR_RecordTypeSelectorComp checkCommunityAttribute="{!v.checkNewCommunityAttribute}" campaignObject="{!v.selectedLookUpRecord}" checkSaveandNew="{!v.isSaveandNew}" isActivityCreatedFromCamp="{!v.isActivityLayout}" />
            </aura:set>
        </aura:if>
        
        <aura:set attribute="else">         
            <div id="pivot"></div>
            <!-- Page Starts Here -->
            <!-- PAGE HEADER -->
            <!-- Popup Message when someone tries to edit the Activity -->
            <aura:if isTrue="{!v.isClosedActivity}">
                <div aura:id="modalIdForCommuntityRecord" role="dialog" tabindex="-1" aria-labelledby="header43" class="slds-modal slds-slide-up-saving slds-modal_small">
                    <div class="slds-modal__container">
                        <!-- Heading (Header of the Modal) -->
                        <div class="slds-modal__header">
                            <lightning:buttonIcon iconName="utility:close" class="slds-button slds-modal__close slds-button_icon-border slds-button_icon-large" variant="bare" onclick="{! c.closeModalClosedActivtiy }"  alternativeText="Close" />
                            <!--<button class="slds-button slds-modal__close slds-button-icon-inverse" title="Close" onclick="{!c.closeModalClosedActivtiy}">
                                X<span class="slds-assistive-text">{!$Label.c.Core_MDF_Cancel}</span>
                            </button>-->
                        </div>
                        <div class="slds-modal__content slds-p-around--medium">
                            <div class="slds-card slds-align_absolute-center"   >
                                <lightning:icon iconName="utility:error" variant="error"/>
                                <div class="slds-p-around_medium slds-align_absolute-center">{!$Label.c.Core_MDF_Close_Activity_Error}</div>
                            </div>
                        </div>
                        <div class="slds-modal__footer">
                            <lightning:button variant="neutral" label="{!$Label.c.Core_MDF_Cancel}" onclick="{!c.closeModalClosedActivtiy}"/>
                        </div>
                    </div>
                </div>
                <div aura:id="backdropIdForNewRecord" class="slds-backdrop slds-backdrop--open"></div>
            </aura:if>
            
            <lightning:layout class="slds-page-header slds-page-header--object-home" aura:id="header">
                <lightning:layoutItem>
                    <lightning:icon iconName="standard:partner_fund_request" class="icn" alternativeText="My Activities"/>
                </lightning:layoutItem>
                <lightning:layoutItem padding="horizontal-small">
                    <div class="page-section page-header">
                        <h1 class="slds-text-heading--label">{!$Label.c.Core_MDF_Activity_Creation_Page_Header}</h1>
                        <h2 class="slds-text-heading--medium">My {!$Label.c.Core_MDF_Activity_Creation_Page_Header}</h2>
                    </div>
                </lightning:layoutItem>
            </lightning:layout>
            <!-- / PAGE HEADER -->
            <!--Indu IPA Proposal -->
            <aura:if isTrue="{!and(v.mode == 'edit', v.showIPAProposalEditWarning)}">
                <div class="maxIntelInvestWarning">{!$Label.c.Core_MDF_IPA_Proposal_Edit_Warning}</div>
            </aura:if>
            <!--Error Messages-->
            <aura:if isTrue="{!empty(v.message)}">
                <div ></div> 
                <aura:set attribute="else">
                    <div align="center"><c:Core_MDF_ErrorMessage type="{!v.messageType}" message="{!v.message}" /></div>   
                </aura:set>
            </aura:if> 
            <!--Event and ELC Popup-->
            <aura:if isTrue="{!v.ShowEventPopup}">
                <c:Core_MDF_ELCPopup EventMessage="{!v.EventMessage}" AgreeLabel="{!v.AgreeButtonLabel}" DisagreeLabel="{!v.DisagreeButtonLabel}" PopupType="{!v.PopupType}"/>
                
            </aura:if>
            
            
            <div class="slds-card">
                <div class="slds-p-around_large">
                    <form class="slds-form--stacked">
                        <!-- Status Section -->
                        <aura:if isTrue="{!v.checkStatusAttribute}">
                            <lightning:layout class="slds-page-header slds-page-header--object-home">
                                <lightning:layoutItem padding="horizontal-small">
                                    <div class="page-section page-header">
                                        <h1 class="slds-text-heading--label">{!$Label.c.Core_MDF_ActivityStatusSection}</h1>
                                    </div>
                                </lightning:layoutItem>
                            </lightning:layout>
                            <!-- Fund Request Status Field-->
                            <lightning:layout horizontalAlign="spread" multipleRows="true">
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>                       
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5" largeDeviceSize="5">
                                    <aura:if isTrue="{!(v.CurrentStatus != $Label.c.Core_MDF_PFRStatus)}">
                                        <lightning:select name="SelectStatus" label="{!$Label.c.Core_MDF_StatusLabelValue}" value="{!v.SelectedStatus}" disabled="{!v.pfrFieldEditablity.Core_MDF_Fund_Request_Status__c}" class ="elementLabel">
                                            <option text="{!v.CurrentStatusLabel}" value=""></option>
                                            <aura:iteration items="{!v.StatusLabel}" var="i">
                                                <option text="{!i.label}" value="{!i.value}"></option>
                                            </aura:iteration>
                                        </lightning:select>
                                        <aura:set attribute="else">
                                            <lightning:select name="SelectStatus" label="{!$Label.c.Core_MDF_StatusLabelValue}" value="{!v.SelectedStatus}" disabled="{!v.pfrFieldEditablity.Core_MDF_Fund_Request_Status__c}" class ="elementLabel">
                                                <option text="{!v.CurrentStatusLabel}" value=""></option>
                                            </lightning:select>   
                                        </aura:set>
                                    </aura:if>    
                                </lightning:layoutItem>
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5" largeDeviceSize="5"></lightning:layoutItem>                       
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                            </lightning:layout>
                        </aura:if>
                        <!-- DETAIL SECTION HEADER -->
                        
                        <lightning:layout class="slds-page-header slds-page-header--object-home">
                            <lightning:layoutItem padding="horizontal-small">
                                <div class="page-section page-header">
                                    <h1 class="slds-text-heading--label">{!$Label.c.Core_MDF_Activity_Creation_Detail_Section}</h1>
                                </div>
                            </lightning:layoutItem>
                        </lightning:layout>
                        
                        <!-- NAME AND DESCRIPTION FIELD -->	
                        
                        <lightning:layout horizontalAlign="spread" multipleRows="true">
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem> 
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5" largeDeviceSize="5">
                                <!--ACTIVITY NAME FIELD for IPA/CMDF-->  
                                <lightning:input aura:id="NewForm" label="{!$Label.c.Core_MDF_A_description_of_the_activity_to_be_performed}" name="Title"  value="{!v.newPFR.Title}" required="true" disabled="{!v.pfrFieldEditablity.Title}"/> 
                            </lightning:layoutItem>  
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5" largeDeviceSize="5">
                             	<aura:if isTrue="{!v.recordtypeDeveloperName != $Label.c.Core_MDF_PFR_DescriptionRepositionRequiredRecordType}">  
                                    <!-- DESCRIPTION FIELD for IPA/CMDF -->
                                    <lightning:textarea aura:id="NewForm" label="{!$Label.c.Core_MDF_Activity_Description}" required="true" name="Description" value="{!v.newPFR.Core_MDF_Activity_Description__c}" disabled="{!v.pfrFieldEditablity.Core_MDF_Activity_Description__c}" />
                                    <aura:set attribute="else">
                                        <lightning:textarea aura:id="NewForm" label="{!$Label.c.Core_MDF_Activity_Description}"
                                                            required="false" name="Description" value="{!v.newPFR.Core_MDF_Activity_Description__c}"
                                                            disabled="{!v.pfrFieldEditablity.Core_MDF_Activity_Description__c}" />
                                    </aura:set>
                                </aura:if>
                            </lightning:layoutItem>  
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem> 
                        </lightning:layout>
                        
                        <!-- START DATE AND END DATE FIELD -->
                        
                        <lightning:layout horizontalAlign="spread" multipleRows="true">
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                  largeDeviceSize="1"></lightning:layoutItem>
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5"
                                                  largeDeviceSize="5">
                                <lightning:input aura:id="NewForm" type="date" label="{!$Label.c.Core_MDF_Start_Date}" required="true"
                                                 name="startDate" onchange="{!c.createAdditionalfilter}" value="{!v.newPFR.Core_MDF_Start_Date__c}"
                                                 disabled="{!v.pfrFieldEditablity.Core_MDF_Start_Date__c}" />
                                <aura:if isTrue="{!v.showStartDateError}">
                                <div class="slds-form-element__help slds-text-color_error">
                                    {!$Label.c.Core_MDF_AccountPlan_ErrorStartDate}
                                    <a href="javascript:void(0);" onclick="{!c.openOutcomeBasedCampaign}" class="slds-text-link">
                                        {!$Label.c.Core_MDF_AccountPlan_ErrorStartDateLink}
                                    </a>
                                </div>
                            </aura:if>
                            </lightning:layoutItem>
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5"
                                                  largeDeviceSize="5">
                                <lightning:input aura:id="NewForm" type="date" label="{!$Label.c.Core_MDF_End_Date}" required="true"
                                                 name="endDate" onchange="{!c.createNewAdditionalfilter}" value="{!v.newPFR.Core_MDF_End_Date__c}"
                                                 disabled="{!v.pfrFieldEditablity.Core_MDF_End_Date__c}" />
                            </lightning:layoutItem>
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                  largeDeviceSize="1"></lightning:layoutItem>
                        </lightning:layout>
                        <!--IPA Changes-->
                            <aura:if isTrue="{!(v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType)}">
                            <lightning:layout horizontalAlign="spread" multipleRows="true">
                                <!-- [IPA MDF] - Campaign - Clone a Proposal - Activity Section  added pfrCloneCheck to hide fields -->
                                <!-- CAMPAIGN AND  ACCOUNT FIELDS FOR IPA/CMDF -->
                                <aura:if isTrue="{!v.pfrCloneCheck == false}">
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                          largeDeviceSize="1"></lightning:layoutItem>
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5"
                                                          largeDeviceSize="5">
                                        <aura:if isTrue="{!v.pfrFieldEditablity.CampaignId}">
                                             <lightning:input  type="text" label="{!$Label.c.Core_MDF_Campaign}"
                                                         value="{!v.selectedLookUpRecord.Name}" disabled="true" />
                                             <aura:set attribute="else">
                                        <c:Core_Intel_customLookup objectAPIName="campaign" selectedRecord="{!v.selectedLookUpRecord}"
                                                                   sAdditionalFilter="{!v.additionalFilter}" label="{!$Label.c.Core_MDF_Campaign}"
                                                                   IconName="standard:campaign" disabled="{!v.pfrFieldEditablity.CampaignId}" />

                                       </aura:set>
                                        </aura:if>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5"
                                                          largeDeviceSize="5">
                                        <lightning:input aura:id="NewForm" type="text" label="{!$Label.c.Core_MDF_PFR_Account}"
                                                         value="{!v.selectedLookUpRecord.Core_MDF_Account__r.Name}" disabled="true" />
                                        <aura:if isTrue="{!and(v.isShowAllocationAmt,v.selectedLookUpRecord.Id!=null)}">
                                            <p class="blue-fc">{!v.showAllocationAmtMsg}</p>
                                        </aura:if>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                          largeDeviceSize="1"></lightning:layoutItem>
                                </aura:if>
                            </lightning:layout>
                            
                            
                            <aura:if isTrue="{!v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType}">
                                <lightning:layout horizontalAlign="spread" multipleRows="true">
                                <aura:if isTrue="{!v.isPropBasedCampaign == false}">
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>        
                                <!--Budget Type-->
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="2" mediumDeviceSize="2" largeDeviceSize="2">
                                            <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Budget_Type_nm__c}">
                                                <lightning:input aura:id="NewForm" type="text" label="{!$Label.c.Core_MDF_Budget_Type}"
                                                                 disabled="true" value="{!v.selectedLookUpRecord.localizedBudType}" />
                                            
                                            </aura:if>
                                        </lightning:layoutItem>
                                <!--  Available Budget --> 
                                <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Budget_Type_nm__c}">
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                                    <lightning:select aura:id="availableBudget" name="Available Budget" value="{!v.selAvailableBudget}" label="{!$Label.c.Core_MDF_Available_Budget_Label}" required="true" onchange = "{!c.saveBudget}" disabled="{!OR(v.disabledMap.availableBudget,v.pfrFieldEditablity.BudgetId)}" >
                                        <option value="">{!$Label.c.Core_MDF_PFR_None_Translation}</option>
                                        <aura:iteration items="{!v.budgetStr}" var="item">
                                            <option value="{!item.key}"  selected="{!item.key==v.selAvailableBudget}">
                                                {!item.value}
                                            </option>                           
                                        </aura:iteration>                           
                                    </lightning:select>
                                    <aura:if isTrue="{! v.showBudgetErrorMsg}">
                                                    <div class="slds-p-bottom-small">
                                                        <p class='red-fc'>{!$Label.c.Core_MDF_No_Available_Budgets_Warning}</p>
                                                    </div>
                                    </aura:if>
                                </lightning:layoutItem>
								
                                        </aura:if>
                                        <aura:set attribute="else">
                                         <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>        
                                                <!--Budget Type-->
                                                <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5" largeDeviceSize="5">
                                                    <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Budget_Type_nm__c}">
                                                            <lightning:input aura:id="NewForm" type="text" label="{!$Label.c.Core_MDF_Budget_Type}"
                                                                             disabled="true" value="{!v.selectedLookUpRecord.localizedBudType}" />
                                                            
                                                    </aura:if>
                                                </lightning:layoutItem>
                                                </aura:set>
                                        </aura:if>
                                        <!-- Focus Area Related changes **Starts-->
                                        <aura:if isTrue="{!v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType}">
                                            <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Focus_Area_nm__c}">
                                                <!--Focus area field-->
                                            <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5" largeDeviceSize="5">
                                                    <c:Core_MDF_Picklist aura:id="focusArea" objName="PartnerFundRequest" fldName="Core_MDF_Focus_Area_nm__c" 
                                                                         ParentId="{!v.selectedLookUpRecord.Id}" ParentfldName="Core_MDF_Focus_Area_nm__c" 
                                                                         recTypeName="{!v.recordtypeName}" selectedValue="{!v.selectedFocusArea}" isRequired="true"
                                                                         recTypeDevName="{!v.recordtypeDeveloperName}" dispLabel="{!$Label.c.Core_MDF_Focus_Area_title}"
                                                                         options="{!v.AllFocusAreaOptions}" disabled="{!v.pfrFieldEditablity.Core_MDF_Focus_Area_nm__c}"
                                                                         labelValueMap="{!v.apitoLabelConvert}" IsClone="{!v.checkCloneAttribute}" fetchPicklistValuesFromCampaign="false" />                  
                                                </lightning:layoutItem>
                                                <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                                      largeDeviceSize="1"></lightning:layoutItem>
                                            </aura:if>
                                        </aura:if>
                                        <!-- ENDS-->
                                   
                                </lightning:layout> 
                            </aura:if> 
                            <!--clone start-->
                            <lightning:layout horizontalAlign="spread" multipleRows="true">
                                <aura:if isTrue="{!v.pfrCloneCheck == true}">
                                    <aura:if isTrue="{!(v.selectedLookUpRecord.Core_MDF_Proposal_Based_Ind__c) || (v.newPFR.Core_MDF_Proposal_Based_Ind__c)}">
                                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                largeDeviceSize="1"></lightning:layoutItem>
                                        <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5" largeDeviceSize="5">
                                        <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Budget_Amount_Local_amt__c}">
                                           <lightning:input aura:id="BudgetAmount" type="number" formatter="{!v.budgetCurrency == 'USD' ? 'currency' : ''}" label="{!if(and(v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType,v.isPropBasedCampaign),$Label.c.Core_MDF_Activity_Total_Investment,$Label.c.Core_MDF_Budget_Amount)}" required="true" name="BudgetAmount" onchange = "{!c.calculateBudgetAmount}" value="{!v.BudgetLocal}" min="0" step="any" disabled="{!v.pfrFieldEditablity.Core_MDF_Budget_Amount_Local_amt__c}" /> 
                                           <aura:if isTrue="{!v.showErrorMsgForSpendingLimit}">
                                               <p class= "red-fc">{!v.ErrorMsgForSpendingLimit}</p>  
