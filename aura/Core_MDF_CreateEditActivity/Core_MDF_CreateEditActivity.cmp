                            <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5" largeDeviceSize="5">   
                                <aura:if isTrue="{!v.pfrFieldVisibility.Core_MDF_ActivityCategory__c}">
                                   <aura:if isTrue="{!v.FieldValuesFromCampaign.Core_MDF_ActivityCategory__c}">
                                        <c:Core_MDF_Picklist aura:id="activityCat" objName="PartnerFundRequest" fldName="Core_MDF_ActivityCategory__c" 
