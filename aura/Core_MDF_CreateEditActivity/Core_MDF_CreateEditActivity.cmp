<!-- This Component is for storing PFR Record Value on New and Edit Record Creation and is called from RecordTypeSelector Component -->
<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,lightning:actionOverride" 
                access="global" 
                Controller="Core_MDF_PartnerFundRequestCreatePage">
    
    <aura:html tag="style">        
        .slds-modal__container{
        max-width: 70rem !important;
        width:95% !important;
        height:90% !important;
        }
    </aura:html>
    <aura:html tag="style">.toastMessage.forceActionsText{
        white-space : pre-line !important;}
    </aura:html>
    
    <!-- [IPA - Budget CAP]  - [OOC - P8] - Internal Account Manager/External - Validation Reimbursement Amount against Budget CAP-->    
    <aura:attribute name="chkBdgtCpExcd" type="boolean" default ="false" />
    <!-- Record ID and Country Options for Country Multi Select -->
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="vrQuestionList" type="String[]" />
    <aura:attribute name="selectedCountryOptions" type="List" default="[]" description="This attribute holds the selected value for Country Multi Select"/>
    <aura:attribute name="selectedInitiativeOptions" type="List" default="[]" description="This attribute holds the selected value for Initiatives Multi Select"/>
    <aura:attribute name="selectedEcosystemPartnerOptions" type="List" default="[]" description="This attribute holds the selected value for Eco System Multi Select"/>
   
    <aura:attribute name="selectedBrandOptions" type="List" default="[]" description="This attribute holds the selected value for Brand Multi Select"/>
    <aura:attribute name="selectedApproverOptions" type="List" default="[]" description="This attribute holds the selected value for Approver Multi Select"/>
    <aura:attribute name="selectedExtActSubmitterOptions" type="List" default="[]" description="This attribute holds the selected value for Submitter Multi Select"/>
    <aura:attribute name="AllCountryOptions" type="List" default="[]" description="This attribute holds all Country values for Country Multi Select"/>
    <aura:attribute name="selectedKPIOptions" type="List" default="[]" description="This attribute holds the selected value for Marketing KPI Multi Select"/>
    <aura:attribute name="AllBrandOptions" type="List" default="[]"
                    description="This attribute holds all Brand values for Brand Multi Select" />
    <aura:attribute name="AllTargetAudienceOptions" type="List" default="[]"
                    description="This attribute holds all Target values for Target Multi Select" />
    <aura:attribute name="selectedTargetAudienceOptions" type="List" default="[]"
                    description="This attribute holds all Target values for Target Multi Select" />
    <aura:attribute name="SelectedEcoPartnerValue" type="List" default="[]"
                    description="This attribute holds all EcoPartner values for EcoPartner Multi Select" />
    <!-- PCT Approval Checkbox Attribute -->
    <aura:attribute name="showPCTApprovalCheckbox" type="Boolean" default="false" description="Show PCT Approval checkbox when Incentive is selected"/>
    <aura:attribute name="AllInitiativeOptions" type="List" default="[]"
                    description="This attribute holds all Initiative values for Initiative Multi Select" />
     <aura:attribute name="AllKPIOptions" type="List" default="[]"
                    description="This attribute holds all Initiative values for Marketing Key Performance Indicator Multi Select" />
    <aura:attribute name="AllFocusAreaOptions" type="List" default="[]" description="This attribute holds all Focus Area values for Focus Multi Select"/>
    <aura:attribute name="AllEcosystemPartner" type="List" default="[]" description="This attribute holds Ecopartner Area values for Focus Multi Select"/>
   
  
    <aura:attribute name="BrandPicklistValues" type="String"
                    description="Stores the Brand values of the activity" />
    <aura:attribute name="audiencePicklistValues" type="String"
                    description="Stores the Audience values of the activity" />
    <aura:attribute name="initiativePicklistValues" type="String"
                    description="Stores the Initiatives values of the activity" />
    <aura:attribute name="kpiPicklistValues" type="String"
                    description="Stores the KPI values of the activity" />
    <aura:attribute name="AllApproverOptions" type="List" default="[]" description="This attribute holds all Country values for Approver Multi Select"/>
    <aura:attribute name="AllExtActSubmitterOptions" type="List" default="[]" description="This attribute holds all values for Submitter Multi Select"/>
    <aura:attribute name="AllCountryOptionsMain" type="List" default="[]" description="This attribute holds all Country values for Country Multi Select"/>
    <!-- BU Split Avaliable list Technical [IPA] BU Mapping % Splits - Enable BU Splits at Activity -->
    <aura:attribute name="buSplitAvaliableList" type="List" default="[]"
                    description="This attribute holds all BU Split avaliable values" />
    <aura:attribute name="buSplitSelectedList" type="List" default="[]"
                    description="This attribute holds all BU Split selected values" />
    <aura:attribute name="showBuSplitSection" type="Boolean" default="false" />
    <!-- <aura:attribute type="Core_MDF_BU_Splits__mdt" name="metadataBuSplitMap" default=""
                    description="Stores the metadata values from the server side"></aura:attribute> -->
    <aura:attribute name="buSplitList" type="List" default="[]"
                    description="This attribute holds all BU Split selected values" />
    <!--<aura:attribute name="storedBuPercentList" type="List" default="[]"
                    description="" />-->
    <!-- <aura:attribute name="buPercentError" type="Boolean" default="false" />-->
	<aura:attribute name="isMultiPicklist" type="Boolean" default="false"/>
    <aura:attribute name="nexInd" type="Boolean" default="false" />
    <aura:attribute name="isEMEARegion" type="Boolean" default="false" />
    <aura:attribute name="defaultBUPercent" type="String" default="" />
    <aura:attribute name="defaultBU" type="String" default="" />
    <aura:attribute name="busplitTotalPercentage" type="Integer" />
    <aura:attribute name="intelContribution" type="Double" />
    <aura:attribute name="showBUSPlitMultiselect" type="boolean" default="false"/>
    <aura:attribute name="buSplitWholeNumError" type="boolean" default="false"/>
    <aura:attribute name="isShowAllocationAmt" type="Boolean" default="false" />
    <aura:attribute name="isShowClassificationField" type="Boolean" default="false" />
    <aura:attribute name="showAllocationAmtMsg" type="String" default="" />
    <!-- BU Split Avaliable list Technical [IPA] BU Mapping % Splits - Enable BU Splits at Activity -->
    <!-- Attributes for Reimbursement Rate -->
    <aura:attribute name="ReimbursementRateVal" type="String[]" description="Stores the selected Target Audience value from the form"/> 
    <aura:attribute name="SelReimbursementRate" type="String" default = "" description="Stores the selected Target Audience value from the form"/> 
    <aura:attribute name="campaignBudgetList" type="List" default="[]"
                    description="This attribute Campaign Budget Records" />
    
    <aura:attribute name ="budgetStr" type ="String" />
    <!-- Subtype Multiselect -->
    <aura:attribute type="String[]" name="activityFieldSetList" default=""
                    description="Stores the field Info"></aura:attribute>
    <aura:attribute name="rsmActivityReviewerper" type="Boolean" default="false" />
    <aura:attribute name="selectedSubTypeOptions" type="List" default="[]"
                    description="This attribute holds the selected value for Sub type Multi Select" />
    <aura:attribute name="activityMultiSubTypeVal" type="List" default="[]"
                    description="This attribute holds all values for Sub type Multi Select" />
    <aura:attribute name="activityMultiSelSubType" type="Map" description="to store Multi Sub type values" />
    <!--[Opal - CCF/DCF] - [OOC - P6] - Replace "Channel Partner" with "Industry Partner"-->
    <aura:attribute name="activityMultiIndPartnerVal" type="List"  default="[]"
                    description="This attribute holds all values for Industry partner Multi Select" />
    <aura:attribute name="selectedIndPartnerOptions" type="List" default="[]"
                    description="This attribute holds the selected value for Industry partner Multi Select" />
    <aura:attribute name="selectedIndPartnerOption" type="List" default="[]"
                    description="This attribute holds the selected value for Industry partner Multi Select" />
    <aura:attribute name="IsOtherIP" type="boolean" default="false"
                    description="Check whether its other than regular Industry partner" />
    <aura:attribute name="SelOtherIndustryPartner" type="String" default=""
                    description="Stores the other Industry partner value from the form" />
    <aura:attribute name="stopMethodExecution" type="Boolean" default ="false" />               
    <aura:attribute name="componentAttributes" type="Object" />
    <aura:attribute name="isSaveDisable" type="Boolean" default ="false" />
    <aura:attribute name="isSaveandNewDisable" type="Boolean" default ="false" />
    <aura:attribute name="isSaveandNew" type="Boolean" default ="false" 
                    description="Stores the value on click of Save and New button"/>
    <aura:attribute name="isClosedActivity" type="Boolean" default ="false" />
    <aura:attribute type="String" name="communityRecordId" default=""/>
    <aura:attribute name="checkCommunityAttribute" type="Boolean" default ="false" />
    <aura:attribute name="checkNewCommunityAttribute" type="Boolean" default ="false" />
    <aura:attribute name="checkSaveComplete" type="Boolean" default ="false" 
                    description="Stores the value when Save is completed onclick of Save and New"/>
    <aura:attribute name="showBudgetErrorMsg" type="Boolean" default="false" />
    <aura:attribute name="showBudgetTypeFields" type="Boolean" default="false" />
    <aura:attribute name="showErrorMsgForSpendingLimit" type="Boolean" default="false" />
    <aura:attribute name="ErrorMsgForSpendingLimit" type="String" default="" />
    <aura:attribute name="startDate" type="date"/>
    <aura:attribute name="endDate" type="date"/>
    <aura:attribute name="disableCurrency" type="Boolean" default="false" 
                    description = "used for disabling the currency field while onchange "/>
	<!--Domain Type Attributes-->
    <aura:attribute name="SelDomainType" type="String" default="" description="Stores the selected Domain Type value"/>
	<aura:attribute name="DomainTypeOptions" type="String[]" description="Stores the options for Domain Type picklist"/>
	<aura:attribute name="isDomainTypeVisible" type="Boolean" default="false" description="Controls the visibility of Domain Type picklist"/>
    <!-- Attribute Initialization-->
    <aura:attribute type="PartnerFundRequest" name="newPFR" 
                    default="{Name:'', 
                             RequestedAmount:0,
                             ChannelPartner:null,
                             Core_MDF_Competitive_Elements__c:'',
                             Core_MDF_Government_Nexus__c:'',
                             Core_MDF_ofPagesEligible__c:'',
                             Core_MDF_pagespayingfor__c:''}"
                    description="Stores the field value of PFR object on Create and Edit of the record "></aura:attribute>
    <aura:attribute type="PartnerFundRequest" name="oldPFR" 
                    description="Stores the actualy field value of PFR object before Editing the record "></aura:attribute>
    <aura:attribute name="SelMarketValue" type="String" default="" 
                    description="Stores the selected market value from the form"/>
    <aura:attribute name="BudgetLocal" type="Integer" default="" 
                    description="Stores the local budget from the form"/>
    <aura:attribute name="budgetCurrency" type="String" default="USD"
                    description="The local currency used for budget "/>
    <aura:attribute name="budgetCurrencyOld" type="String" default="USD"
                    description="The local currency used for budget "/>
    
    <aura:attribute name="createdDateClone" type="Boolean" default ="false" />
    <aura:attribute name="BudgetException" type="boolean" default="false" 
                    description="Set to true if any Exception from method called"/>
    <aura:attribute name="JointContent" type="boolean" default="false"
                    description="Joint Content for SPCF RecordType"/>
    <aura:attribute name="SelCategory" type="String" default="" 
                    description="Stores the selected Activity Category value from the form"/>
    <aura:attribute name="SelActivityType" type="String" default="" 
                    description="Stores the selected Activity Type value from the form"/>
    <!-- subtype single select -->					
    <aura:attribute name="selActivitySubType" type="String" default=""
                    description="Stores the selected Activity Sub Type value from the form" />
    <aura:attribute name="selActivityEventName" type="String" default=""
                    description="Stores the selected Event Name value from the form" />
    <aura:attribute name="selActivityClassification" type="String" default=""
                    description="Stores the selected Activity Sub Type value from the form" />
    <aura:attribute name="activityInApproval" type="Boolean" default=""
                    description="Stores true if Activity in Approval" />
    <aura:attribute name="selectedInitiatives" type="List" default="[]" 
                    description="Stores the Initiatives selected from campaign" />
    <aura:attribute name="SelProductType" type="List" default="[]" 
                    description="Stores the selected Product Type value from the form"/>
    <aura:attribute name="SelBrand" type="String" default="" 
                    description="Stores the selected Brand value from the form"/>	
    <aura:attribute name="SelTargetAudience" type="String" default="" 
                    description="Stores the selected Target Audience value from the form"/> 
    <aura:attribute name="SelPriority" type="String" default="" 
                    description="Stores the selected priority value from the form"/>
    <aura:attribute name="selectedLookUpRecord" type="Campaign" default="{'sobjectType':'Campaign',Id:null, Name:''}" 
                    description="Stores the selected Campaign value from the form"/>
    <aura:attribute name="selectedPartner" type="sObject" default="{Id:null, Name:''}" 
                    description="Stores the selected Account(Channel Partner) value from the form"/>	
    <aura:attribute name="additionalFilter" type="String" default="" 
                    description="To add the constructed filter based on startdate and enddate for displaying the lookup(Account and Campaign) values"/>
    <aura:attribute name="currMap" type="String[]" description="Map used for Global key Map value pair for currency "/>
    <aura:attribute name="currBTMap" type="String[]" description="Map used for Global key Map value pair for Budget Type"/>
    <aura:attribute name="PriorType" type="String[]" description="Map used for Global key Map value pair for Priority Type"/>
    
    <!-- RecordType Attributes to Store RecordType ID, Name and DeveloperName -->
    
    <aura:attribute name="recordtype" type="String" default="" 
                    description="Stores the recordtypeID from the parent component"/>
    <aura:attribute name="campriority" type="String" default=""
                    description="Stores the Priority from campaign"/>
    <aura:attribute name="campriorityValue" type="Boolean" default="false"
                    description="Stores the Priority from campaign"/>
    <aura:attribute name="recordtypeName" type="String" default="" 
                    description="Stores the recordtypeName from the parent component"/>                
    <aura:attribute name="programName" type="String" default="" 
                    description="Stores the recordtypeName from the parent component"/>
    <aura:attribute name="recordtypeDeveloperName" type="String" default="" 
                    description="Stores the recordtypeName from the parent component"/>
    <aura:attribute name="messageType" type="String" default="" 
                    description="To fetch the Type of message from custom error message component"/>
    <aura:attribute name="message" type="String" default="" 
                    description="To get the message from error message component"/>
    <!-- Below are the attribute defined for the Popups in the component -->
    <aura:attribute name="ShowEventPopup" type="boolean" default="false" 
                    description="To diable or enable Event Popup"/>
    <aura:attribute name="EventMessage" type="String" default="" 
                    description="It contains the content of popup"/>
    <aura:attribute name="AgreeButtonLabel" type="String" default="" 
                    description="It contains the button labels"/>
    <aura:attribute name="DisagreeButtonLabel" type="String" default="" 
                    description="It contains the button labels"/>
    <aura:attribute name="PopupType" type="String" 
                    description="It contains the type of popup"/>
    
    <aura:attribute name="fieldNameCurrency" type="String" default="Core_MDF_Budget_Currency_cd__c" access="global" description="Used to fetch the Global Picklist Value in Controller NZ" />
    <!-- Attribute to control status section in the UI (Status Section Should be shown in Edit Scenario Only) -->
    <aura:attribute name="checkStatusAttribute" type="Boolean" default ="True" />
    <aura:attribute name="activityOwner" type="String" default="" access="global"  description="Used to fetch the Activity Owner for Internal User" ></aura:attribute>
    <aura:attribute name="activityOwnerId" type="Id" default="" access="global"  description="Used to fetch the Activity Owner for Internal User" ></aura:attribute>
    <aura:attribute name="activityExtOwner" type="String" default="" access="global"  description="Used to fetch the Activity Owner for External User" ></aura:attribute>
    <aura:attribute name="activityExtOwnerId" type="Id" default="" access="global"  description="Used to fetch the Activity Owner for External User" ></aura:attribute>
    <!-- Attribute to Store Clone Button Variable -->
    <aura:attribute name="checkCloneAttribute" type="Boolean" default ="false" />
    <aura:attribute name="checkCloneRecordId" type="String" default ="" />
