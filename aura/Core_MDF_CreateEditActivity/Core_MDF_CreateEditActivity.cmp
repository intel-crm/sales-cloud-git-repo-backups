                                        </aura:if>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5"
                                        largeDeviceSize="5">
                                        <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Budget_Currency_cd__c}">
