                                        <aura:if isTrue="{!(!empty(v.pfrFieldVisibility))}">
                                            <lightning:input aura:id="NewForm" type="number" label="{!$Label.c.Core_MDF_Campaign_Reimbursement_Amount}" disabled="true"
                                                value="{!v.selectedLookUpRecord.Core_MDF_Reimbursement_Amount_Amt__c}" />
                                        </aura:if>
