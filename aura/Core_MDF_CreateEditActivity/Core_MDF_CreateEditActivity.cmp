                                                        </div>
                                                    </div>
                                                    <lightning:input aura:id="NewForm" type="text" variant = "label-hidden"
                                                                     disabled="true" value="{!v.selectedLookUpRecord.Core_MDF_ReimbursementRate_pct__c}" />
                                                </aura:if>
                                            </div>
                                            <aura:set attribute="else">
                                                <!--Campaign Reimbursement Rate field for internal-->
                                                <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Campaign_Reimbursement_Rate_txt__c}">
                                                    <div class="slds-grid">
                                                        <div class="slds-col">
                                                            <label class="slds-form-element__label slds-no-flex">{!$Label.c.Core_MDF_CampaignReimbursementRate}</label>
                                                        </div>
                                                        <div class="slds-col">
                                                            <div><lightning:helptext iconName="utility:info" content="{!$Label.c.Core_MDF_Camp_ReimbursementRate_Help_Text}" /></div>
                                                        </div>
                                                    </div>
                                                    <lightning:input aura:id="NewForm" type="text" variant = "label-hidden"
                                                                     disabled="true" value="{!v.selectedLookUpRecord.Core_MDF_ReimbursementRate_pct__c}" />
                                                </aura:if>
                                            </aura:set>
                                        </aura:if>
                                    </lightning:layoutItem>
                                    
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5"
                                                          largeDeviceSize="5">
                                        <!--Activity Reimbursement Rate field-->
