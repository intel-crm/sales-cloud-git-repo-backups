                                <!--cloneEnd-->
                                <aura:if isTrue="{!v.pfrCloneCheck == false}">
                                    <aura:if isTrue="{!(v.selectedLookUpRecord.Core_MDF_Proposal_Based_Ind__c) || (v.newPFR.Core_MDF_Proposal_Based_Ind__c)}">
                                     <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                              largeDeviceSize="1"></lightning:layoutItem>
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5" largeDeviceSize="5">
                                        <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Budget_Amount_Local_amt__c}">
                                            <lightning:input aura:id="BudgetAmount" type="number" formatter="{!v.budgetCurrency == 'USD' ? 'currency' : ''}" label="{!if(and(v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType,v.isPropBasedCampaign),$Label.c.Core_MDF_Activity_Total_Investment,$Label.c.Core_MDF_Budget_Amount)}" required="true" name="BudgetAmount" onchange = "{!c.calculateBudgetAmount}" value="{!v.BudgetLocal}" min="0" step="any" disabled="{!v.pfrFieldEditablity.Core_MDF_Budget_Amount_Local_amt__c}" /> 
                                            <aura:if isTrue="{!v.showErrorMsgForSpendingLimit}">
                                                <p class= "red-fc">{!v.ErrorMsgForSpendingLimit}</p>  
                                            </aura:if>
                                        </aura:if>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5"
                                                      largeDeviceSize="5">
                                    <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Budget_Currency_cd__c}">
                                        <lightning:select aura:id="BudgetCurrency456" name="BudgetCurrency" value="{!v.budgetCurrency}"
                                                          label="{!$Label.c.Core_MDF_Budget_Currency}" 
                                                          disabled="{!or(or(v.pfrFieldEditablity.Core_MDF_Budget_Currency_cd__c, v.disableCurrency), v.lockIPAProposalCurrency)}"
                                                          onchange="{!c.calculateBudgetAmount}" class ="elementLabel" >
                                            <aura:if isTrue="{!and(v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType,v.isPropBasedCampaign)}">
    <aura:iteration items="{!v.currMap}" var="item">
        <aura:if isTrue="{!or(item.key == 'USD',and(v.mode == 'edit',and(not(v.pfrCloneCheck),item.key == v.oldPFR.Core_MDF_Budget_Currency_cd__c)))}">
            <option value="{!item.key}" selected="{!item.key == v.budgetCurrency}">{!item.value}</option>
        </aura:if>
    </aura:iteration><!--Indu IPA Proposal -->
    <aura:set attribute="else">
        <aura:iteration items="{!v.currMap}" var="item">
            <aura:if isTrue="{!or(not(empty(v.newPFR.Id)),v.checkCloneAttribute)}">
                <option value="{!item.key}" selected="{!item.key == v.newPFR.Core_MDF_Budget_Currency_cd__c}">{!item.value}</option>
                <aura:set attribute="else"><option value="{!item.key}" selected="{!item.key == 'USD'}">{!item.value}</option></aura:set>
            </aura:if>
        </aura:iteration>
    </aura:set>
</aura:if><!--Indu IPA Proposal -->
                                        </lightning:select>
                                    </aura:if>
                                </lightning:layoutItem>
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                              largeDeviceSize="1" />
                                <aura:set attribute="else">
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                                          largeDeviceSize="1"></lightning:layoutItem>
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="5" mediumDeviceSize="5"
                                                          largeDeviceSize="5">
                                        <aura:if isTrue ="{!or(or(v.isActivityCreationOnCampaign,v.externalper),v.checkCloneAttribute)}">
