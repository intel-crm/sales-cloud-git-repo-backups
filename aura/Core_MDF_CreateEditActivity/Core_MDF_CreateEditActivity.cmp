                                </aura:if>
                                
                            </lightning:layout>
                            
                            <lightning:layout horizontalAlign="spread" multipleRows="true">		  
                                <aura:if isTrue="{!(v.selectedLookUpRecord.Core_MDF_Proposal_Based_Ind__c) || (v.newPFR.Core_MDF_Proposal_Based_Ind__c)}">
                                    <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                                        largeDeviceSize="1"></lightning:layoutItem>
                                        <!--Activity Reimbursement Rate field-->
                                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="2.5" largeDeviceSize="2.5">
                                            <!--Reimbursement Rate IPA Proposal -->
                                                <c:Core_Intel_customPicklist objName="PartnerFundRequest"
                                                                                fldName="Core_MDF_Reimbursement_Rate_pct__c" ParentId="" recTypeName="{!v.recordtypeName}"
                                                                                ParentfldName="" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                                                selectedValue="{!v.SelReimbursementRate}" options="{!v.ReimbursementRateVal}"
                                                                                 dispLabel="{!$Label.c.Core_MDF_Reimbursement_Rate_Label}" disabled="{!if( and( v.recordtypeDeveloperName ==  $Label.c.Core_MDF_IPA_RecordType, v.isPropBasedCampaign ),if( and(  v.mode == 'edit', and( not(v.checkCloneAttribute),  not(v.pfrCloneCheck)  )  ), or( or( v.externalper, v.pfrFieldEditablity.Core_MDF_Reimbursement_Rate_txt__c ), v.SelReimbursementRate ==  $Label.c.Core_MDF_BudgetType_RRate100 ), true ), v.disableRRPercent)}" />
                                            
                                        </lightning:layoutItem>
                                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                                        <!--Akash-RR% -->
                                        
					                    <aura:if isTrue="{!and( and( not(v.externalper), not(v.isPropBasedOutcomeCampaign) ), not( and( v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType, v.isPropBasedCampaign ) ))}">
                                            <aura:if isTrue ="{!v.pfrFieldVisibility.Core_MDF_Reimbursement_Rate_txt__c}">
                                                <div class="slds-grid">
