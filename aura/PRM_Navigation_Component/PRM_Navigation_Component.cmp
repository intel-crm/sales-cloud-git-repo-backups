<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global" >
    <button  class="slds-button" onclick="{! c.redirect }"  >
        <span class="slds-badge"><lightning:Icon iconName="utility:back" size="xx-small"/>&nbsp;&nbsp;Go Back</span>
    </button>
</aura:component>