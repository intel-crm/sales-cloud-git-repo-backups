<aura:component controller="Core_MDF_ConfirmationPopUpController" implements="flexipage:availableForRecordHome,force:hasRecordId,force:hasSObjectName,force:lightningQuickAction" access="global" >
	<aura:attribute name="objectName" type="string"/>
    <aura:attribute name="recordId" type="string"/>
    <aura:attribute name="actionName" type="string"/>
    <aura:attribute name="message" type="string"/>
    
    <aura:attribute name="showDialog" type="boolean"/>
    <aura:attribute name="isProcessing" type="boolean" default="false"/>
	<aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
   
	<aura:if isTrue="{!v.showDialog}">    
        <div role="dialog" class="slds-modal slds-fade-in-open popUpCls">
            <div class="slds-modal__container">
                <header class="slds-modal__header">
                    <h1 class="slds-text-heading--medium">Confirmation</h1>
                </header>
                <div class="slds-modal__content slds-p-around--medium">
                    <center><b>{!v.message}</b></center>
                </div>
                <footer class="slds-modal__footer">
                    <lightning:button name='No' label='No' onclick='{!c.handleConfirmNo}'/>
                    <lightning:button variant="brand" name='Yes' label='Yes' onclick='{!c.handleConfirmYes}'/>
                </footer>
            </div>
        </div>
        <div class="slds-backdrop slds-backdrop--open"></div>
    </aura:if>
    <aura:if isTrue="{!v.isProcessing}">
        <lightning:spinner alternativeText="Loading"/>
    </aura:if>
	
   
        
</aura:component>