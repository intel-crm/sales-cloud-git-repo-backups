		<p>Structure of galleryData items:</p>
<pre>[
		{
			thumbnailURL: '', // thumbnail on paging
			imageURL: '', // main gallery image
			type:'image', // types can either be 'image' or 'video'
			imgAlt: '' // image alt text
		},
		{
			thumbnailURL: '',
			imageURL: '', // image on video type is used on gallery non overlay display
			videoURL: 'https://archive.org/download/ace_200911_04/00130d67f8ea0c43de91d30cdc13386c.mts-mp430-272.MP4',
			type:'video',
			imgAlt: ''
		}
	]
	</pre>
