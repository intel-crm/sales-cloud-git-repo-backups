<aura:component extends="c:MarketplaceRedux" implements="forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable" controller="PMP_SearchEditStoreFrontController">
    
    <!--  <aura:attribute name="devUploadRecordId" type="String" default="{!$Label.c.ISG_EditStorefront_DEV_UploadRecordId}" /> -->
    
    <aura:set attribute="storeName" value="Settings" />
    
    <aura:attribute name="isOpen" type="boolean" default="false" description="Opens the edit storefront modal" />
    <aura:attribute name="isLocked" type="Boolean" default="false" description="The edit storefront modal is locked because changes have already been submitted" />
    <aura:attribute name="partnerId" type="String" description="The Id for the partner object being edited" />
    <aura:attribute name="currentStep" type="Integer" default="0" description="This is the current step in the form and can be set to enter the form on a specific step" />
    <aura:attribute name="firstSubmission" type="Boolean" default="true" description="Is this the first time using the form and submitting the offering?" />
    <aura:attribute name="isGuest" type="Boolean" default="false" />
    <aura:attribute name="showModal" type="boolean" default="false"/><!-- Added by Megha as part of US619896-->
    <aura:attribute name="isFromLink" type="boolean" default="false"/><!-- Added by Subash as part of US619896-->
    
    <!-- other internal attributes -->
    <aura:attribute name="activeStep" type="Integer" default="6" description="Internal (this form does not keep track of 'pristine' steps in the form" />
    <aura:attribute name="steps" type="Object[]" description="Internal" />
    <aura:attribute name="stepLabels" type="string[]" description="Internal" />
    <aura:attribute name="onstepchange" type="Object" description="Internal" />
    <aura:attribute name="onTabChange" type="Object" description="Internal" />
    <aura:attribute name="modalHeading" type="String" description="Internal" />
    <aura:attribute name="currentStepHeading" type="String" default="" description="Internal" />
    <aura:attribute name="formTouched" type="Boolean" default="false" />
    <aura:attribute name="formValid" type="Boolean" default="false" />
    <aura:attribute name="formErrorMsgs" type="String[]" />
    <aura:attribute name="closeModalCallback" type="Object" description="Internal" />
    
    <aura:attribute name="stepLoading" type="boolean" default="false" />
    <aura:attribute name="nextButtonDisabled" type="Boolean" default="false" />
    
    <!-- step attributes (form data) -->
    <aura:attribute name="logoCheck" type="Boolean" description="Internal"  default="true"/> 
    <aura:attribute name="hasLogo" type="Boolean" default="false" description="Internal" />
    <aura:attribute name="logourl" type="string" description="Internal" />
    <aura:attribute name="workingCopyId" type="String" description="Internal" />
    <aura:attribute name="formData" type="Object" description="Internal" />
    <aura:attribute name="logo" type="Object[]" description="Internal" />
    <aura:attribute name="additionalLogos" type="object[]" description="Internal" />
    <aura:attribute name="showAdditionalUploader" type="Boolean" default="false" description="Internal" />
    <aura:attribute name="descriptionData" type="Object" description="Internal" />
    
    <aura:attribute name="appOptions" type="Object[]" description="Internal" />
    <aura:attribute name="indOptions" type="Object[]" description="Internal"/>
    <aura:attribute name="isFirstDraft" type="Boolean" />
    <aura:attribute name="currentStatus" type ="String" default = ""/>
    
    <aura:attribute name="regionsSelected" type="string[]" description="Internal" />
    <aura:attribute name="regionOptions" type="Object[]" description="Internal" />
    <aura:attribute name="regionsSelectedAll" type="boolean" description="Internal" />
    
    <aura:attribute name="applicationsSelected" type="string[]" description="Internal" />
    <aura:attribute name="applicationOptions" type="Object[]" description="Internal" />
    <aura:attribute name="applicationError" type="Boolean" default="false" />
    
    <aura:attribute name="industryOptions" type="Object[]" />
    <aura:attribute name="industryError" type="Boolean" default="false" />
    
    <aura:attribute name="regionLearnMoreUrl" type="string" description="Internal" />
    <aura:attribute name="languageLearnMoreUrl" type="string" description="Internal" />
    <aura:attribute name="regionError" type="Boolean" default="false" />
    <aura:attribute name="resources" type="object[]" description="Internal" />
    <aura:attribute name="resourcesError" type="Boolean" default="false" />
    <aura:attribute name="resourcesMax" type="Integer" default="5" />
    <aura:attribute name="resourceTypeOptions" type="Object[]" description="Internal" />
    <aura:attribute name="summaryData" type="Object"/>
    
    <aura:attribute name="errorInputs" type="Object[]" description="Internal"/>
    <aura:attribute name="showErrors" type="boolean" default="false" description="Internal"/>
    <aura:attribute name="leadSettings" type="boolean" description="internal boolean to showcase Lead gen settings" />
    <aura:attribute name="onLeadGenDataUpdate" type="object" description="Internal set from controller data" />
    <aura:attribute name="isAdmin" type="Boolean" default="false" />
    <aura:attribute name="isProfileAdmin" type="Boolean" default="false" />
    <aura:attribute name="urlMatchingPattern" type="string" default="^(https:\/\/)?([\da-z\.-]+)\.([a-z\.]{2,6})([\/\w \.-]*)*\/?$" />      <!-- Javascript regular expression for email check -->
    <aura:attribute name="isregionsSelected" type="boolean" description="regions" default = "false"/>
    <aura:attribute name="selectedOptions" type="object[]" />
    <aura:attribute name="selectedIndus" type="object[]" />
    <aura:attribute name="selectedApps" type="object[]" />
    <!-- <aura:attribute name="logourl" type="string" description="Internal" />-->
    <!-- Admin Review Attributes -->
    <aura:attribute name="loggedInAdmin" type="string"/>
    <aura:attribute name="admins" type="Object[]"/>
    <aura:attribute name="statusList" type="Object[]"/>
    <aura:attribute name="submittedBy" type="string" default="Parter Admin"/>
    <aura:attribute name="submittedOn" type="string" default="20-May-2019"/>
    <aura:attribute name="isPublishedCopyDraft" type="boolean" />
    
    <!-- messages -->
    <aura:attribute name="messageFromIntel" type="string" description="Internal" />
    <aura:attribute name="messageFromIntelMore" type="String" description="Internal" />
    <aura:attribute name="showMoreMsg" type="boolean" default="false" description="Internal" />
    <aura:attribute name="updateFormCallback" type="Object" description="Internal" />
    <aura:attribute name="showSpinner" type="String" default="false" description="Internal" />
    <aura:attribute name="isIntelAdmin" type="Boolean" default="false" />
    <!-- change and event handlers -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.currentStep}" action="{!c.handleStepChange}" />
    <aura:handler name="change" value="{!v.isOpen}" action="{!c.handleFormOpen}" />
    <!--  <aura:handler name="change" value="{!v.additionalLogos}" action="{!c.handleAdditionalLogosChange}" />-->
    
    <aura:handler event="c:MarketplacePageEvent" action="{!c.handlePageEvent}" />
    
    
    
    <div>
        
        <aura:if isTrue="{!v.isOpen}">
            <c:MarketplaceModal aura:id="modal" heading="{!v.modalHeading}" isOpen="{!v.isOpen}" useSlimMobileHeader="true" closeModalCallback="{!v.closeModalCallback}" >
                <div class="{!join(' ', 'fullHeight', v.state.currentScreenSize == 'mobile' ? 'bgWhite' : 'bgGray')}">
                    <div class="modalContainer">
                        <aura:if isTrue="{!v.showSpinner}">
                            <lightning:spinner alternativeText="Loading..." />
                        </aura:if>
                        <aura:if isTrue="{!!v.isFromLink}">
                        <aura:if isTrue="{!or(v.isLocked, v.currentStep == v.steps.length)}">
                            <!-- LOCKED (already submitted / just submitted) progress display -->
                            <h5 class="locked-state-heading heading-24 color-dark-gray">{!$Label.c.PMP_Storefront_ProfileSubmitted}</h5><!--As per copy Deck changes-->
                            
                            <c:MarketplaceStorefrontSubmitProgressIndicator isLocked="{!v.isLocked}" isIntelAdmin="{!v.isIntelAdmin}" />
                        </aura:if>
                        <!--FORM Lead Gen Settings-->
                       <!-- <aura:if isTrue="{!and(v.isLocked, v.currentStep == 6,!v.isIntelAdmin)}">-->
                            
                        <aura:if isTrue="{!and( v.currentStep == 6,!v.isIntelAdmin)}">
                            <!-- <aura:if isTrue="{!or(v.isLocked, v.currentStep == 6)}">-->
                            <!--<aura:if isTrue="{!or(v.isStep2)}">-->
                            <aura:if isTrue="{!v.leadSettings}">
                                <div class="slds-m-top_x-large">
                                    <c:MarketplaceLeadGenSettings aura:id="leadGenStep" partnerId="{!v.partnerId}" hasAccess="true" hideButtons="true" 
                                                                  onDataUpdatedCallback="{!v.onLeadGenDataUpdate}" />
                                </div>
                            </aura:if>
                        </aura:if> 
                        <!-- <aura:if isTrue="{!and(!v.isLocked, v.currentStep != v.steps.length)}">-->
                        <aura:if isTrue="{!and(!v.isLocked, v.currentStep lt v.steps.length)}">
                            <lightning:layout multipleRows="true" class="slds-p-horizontal_medium">
                                <!-- FORM STEPS PROGRESS BAR -->
                                <lightning:layoutItem size="12" class="{!(v.state.currentScreenSize == 'mobile' ? 'slds-p-horizontal_medium ' : 'bgGray ') + 'progressLayoutItem'}">
                                    <aura:if isTrue="{!not(empty(v.steps))}">
                                        <aura:if isTrue="{!or(v.isPublishedCopyDraft, v.isIntelAdmin)}" >
                                            <div class="progressBarContainer">  <!--activeStep="{!v.steps.length}"-->
                                                <c:MarketplaceCreateProductProgressBar aura:id="progress"
                                                                                       activeStep="{!v.activeStep}" 
                                                                                       currentStep="{!v.currentStep}"
                                                                                       currentStepValid="true"
                                                                                       pathLabels="{!v.steps}"
                                                                                       onchange="{!v.onstepchange}" />
                                            </div>
                                            <aura:set attribute="else">
                                                <lightning:layoutItem size="12" class="{!(v.state.currentScreenSize == 'mobile' ? '' : 'bgGray ') + 'progressLayoutItem'}">
                                                    <c:MarketplaceTabset aura:id="tabset" initialTab="{!v.currentStep}" onTabChange="{!v.onTabChange}">
                                                        <aura:iteration items="{!v.steps}" var="step">
                                                            <c:MarketplaceTab label="{!step}"></c:MarketplaceTab>
                                                        </aura:iteration>
                                                    </c:MarketplaceTabset>
                                                </lightning:layoutItem>
                                            </aura:set>
                                        </aura:if>
                                        
                                    </aura:if>
                                </lightning:layoutItem>
                                <lightning:layoutItem size="12" class="{!(v.state.currentScreenSize == 'mobile' ? 'bgWhite slds-m-top_medium ' : 'bgGray ') + 'headerLayoutItem'}">
                                    
                                    <h1 class="h4 heading-24">{!v.currentStepHeading}</h1>
                                    <div class="slds-p-top_small">
                                        <span class="color-red slds-m-right_xxx-small">*</span>&nbsp;{!$Label.c.PMP_Create_Offering_Form_Required}
                                    </div>
                                </lightning:layoutItem>
                                <lightning:layoutItem size="12" mediumDeviceSize="8" class="formLayoutItem">
                                    <a aura:id="formAnchor" id="formAnchor"></a>
                                    <form aura:id="form" onsubmit="{!c.handleFormSubmit}">
                                        <!-- FORM STEPS -->
                                        <!-- STEP 1: LOGO -->
                                        <aura:if isTrue="{!v.currentStep == 0}">
                                            <div class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-vertical_large'), 'bgWhite')}">
                                                <h2 class="{!join(' ', 'h4', (v.state.currentScreenSize == 'mobile' ? 'slds-p-horizontal_medium' : 'slds-p-horizontal_large'))}">
                                                    {!$Label.c.PMP_Edit_Offering_Form_Storefront_Logo}
                                                </h2>
                                                
                                                <div id="logoScrollId" class="{!v.state.currentScreenSize == 'mobile' ? '' : 'slds-m-horizontal_small'}">
                                                    <aura:if isTrue="{!v.workingCopyId}">
                                                        <c:MarketplaceFormImageUploader aura:id="uploader1"
                                                                                        recordIdForUpload="{!v.workingCopyId}"
                                                                                        required="true"
                                                                                        label="{!$Label.c.PMP_Edit_Storefront_Logo_Label}"
                                                                                        maxUploads="1"
                                                                                        disclaimer1="{!$Label.c.PMP_Form_Image_Uploader_Logo_Disclaimer1}"
                                                                                        errorMessage="{!$Label.c.PMP_Edit_Storefront_Logo_Required}" 
                                                                                        method = "{!c.handleLogoCheck}"
                                                                                        livesInsideModal="true"
                                                                                        updateFormCallback="{!v.updateFormCallback}"        />
                                                    </aura:if>
                                                </div>
                                            </div>
                                            <!--      <div class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? 'slds-m-top_medium slds-p-vertical_medium' : 'slds-m-top_x-large slds-p-vertical_large  slds-m-bottom_medium'), 'bgWhite')}">
                                                <h2 class="{!join(' ', 'h4', (v.state.currentScreenSize == 'mobile' ? 'slds-p-horizontal_medium' : 'slds-p-horizontal_large'))}">
                                                    {!$Label.c.PMP_Edit_Storefront_Additional_Logos}
                                                </h2>
                                                <p class="{!'slds-m-vertical_small ' + (v.state.currentScreenSize == 'mobile' ? 'slds-m-left_medium' : 'slds-m-left_large')}">
                                                    {!$Label.c.PMP_Edit_Storefront_Additional_Logos_des}
                                                </p>
                                                  
                                                <aura:if isTrue="{!v.showAdditionalUploader}">
                                                    <div class="{!v.state.currentScreenSize == 'mobile' ? '' : 'slds-m-horizontal_x-small'}">
                                                        <c:MarketplaceFormImageUploader aura:id="uploader2"
                                                                                recordIdForUpload="{!v.devUploadRecordId}"
                                                                                acceptableFormats="['.eps','.svg','.ai']"
                                                                                disclaimer2="{!$Label.c.PMP_Form_Image_Uploader_Vector_Disclaimer2}"
                                                                                disclaimer3=""
                                                                                label="{!$Label.c.PMP_Edit_Storefront_Additional_Logo_Label}"
                    livesInsideModal="true                                      livesInsideModal="true"
                                                                                updateFormCallback="{!v.updateFormCallback}"	 />
                                                    </div>
                                                    <aura:set attribute="else">
                                                        <div class="{!'slds-m-top_medium ' + (v.state.currentScreenSize == 'mobile' ? 'slds-m-left_medium' : 'slds-m-left_large')}">
                                                            <span onclick="{!c.handleUploadAdditional}">
                                                                <c:IntelButton class="gray inline">
                                                                    <lightning:icon iconName="utility:add" class="iconSizeNormal iconDarkGray slds-m-right_small" />
                                                                    <span>{!$Label.c.PMP_Edit_Storefront_Additional_Files_Btn}</span>
                                                                </c:IntelButton>
                                                            </span>
                                                        </div>
                                                    </aura:set>
                                                </aura:if>
                                            </div>			-->
                                        </aura:if>
                                        
                                        
                                        <!-- STEP 2: COMPANY DESCRIPTION -->
                                        <aura:if isTrue="{!v.currentStep == 1}">
                                            <div class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-around_medium'), 'bgWhite')}">
                                                <div id="langScrollId" >
                                                	<c:MarketplaceFormDropdown aura:id="dropdown" label="{!$Label.c.PMP_Edit_Storefront_Description_Lang_Label}" required="true" value="{!v.descriptionData.language}" options="{!v.descriptionData.languageOptions}" updateFormCallback="{!v.updateFormCallback}" disabled = "{!v.currentStatus =='Update Required'}"/>
                                                </div>
                                                  
                                                <!--Learn More link Commented since not required -->
                                                <!-- <p class="slds-p-horizontal_medium slds-p-bottom_medium mTopSmallNeg">
                                                    <a href="{!v.languageLearnMoreUrl}">
                                                        {!$Label.c.PMP_Edit_Storefront_Language_LearnMoreLink}
                                                        <lightning:icon iconName="utility:chevronright" class="slds-m-left_xxx-small iconSizeSmall iconBlue" />
                                                    </a>
                                                </p>  --> 
                                                <div id="tagScrollId" >
                                                	<c:MarketplacePartnerFormInputText aura:id="textInput" label="{!$Label.c.PMP_Edit_Storefront_Description_Tagline_Label}" required="true" maxLength="50" value="{!v.descriptionData.tagline}" updateFormCallback="{!v.updateFormCallback}" />
                                                
                                                </div>
                                                <div id="descScrollId">
                                                	<c:MarketplaceFormRichTextEditor aura:id="rtInput" label="{!$Label.c.PMP_Edit_Storefront_Description_Des_Label}" required="true" value="{!v.descriptionData.description}" formats="['bold','italic','underline','strike','list','indent','clean']" updateFormCallback="{!v.updateFormCallback}" />
                                            
                                                </div>
                                                </div>
                                        </aura:if>
                                        
                                        <!-- STEP 3: COMPANY DETAILS -->
                                        <aura:if isTrue="{!v.currentStep == 2}">
                                            <div id="indScrollId" class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? 'slds-p-around_medium' : 'slds-p-around_large'), 'bgWhite')}">
                                                <p><span class="color-red">*</span>{!$Label.c.PMP_Industry}</p><br/>
                                                <aura:if isTrue="{!not(empty(v.industryOptions))}">
                                                    <aura:iteration items="{!v.industryOptions}" var="option">
                                                        <lightning:input class="regionOption" type="checkbox" checked="{!option.checked}" label="{!option.label}" value="{!option.value}" onchange="{!c.handleIndustryChange}" />
                                                        <aura:if isTrue="{!option.checked}">
                                                            <aura:if isTrue="{!not(empty(option.children))}">
                                                                <c:MarketplaceFormDropdown aura:id="industryDropdown" readOnly="true" value="{!option.selections}" allowMultipleOptions="true" options="{!option.children}" updateFormCallback="{!v.updateFormCallback}" />
                                                            </aura:if>
                                                        </aura:if>
                                                    </aura:iteration>
                                                </aura:if>
                                                <aura:if isTrue="{!v.industryError}">
                                                    <div class="textColorRed slds-p-vertical_medium">
                                                        {!$Label.c.PMP_Edit_Storefront_Industry_Error}
                                                    </div>
                                                </aura:if>
                                            </div>
                                            <div id="appScrollId" class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? 'slds-p-around_medium' : 'slds-p-around_large'), 'bgWhite')}">
                                                <p><span class="color-red">*</span>{!$Label.c.PMP_application}</p><br/>
                                                <aura:iteration items="{!v.applicationOptions}" var="option">
                                                    <lightning:input class="regionOption" type="checkbox" checked="{!option.checked}" label="{!option.label}" value="{!option.value}" onchange="{!c.handleApplicationChange}" />
                                                    <aura:if isTrue="{!option.checked}">
                                                        <aura:if isTrue="{!not(empty(option.children))}">
                                                            <c:MarketplaceFormDropdown aura:id="applicationDropdown" readOnly="true" value="{!option.selections}" allowMultipleOptions="true" options="{!option.children}" updateFormCallback="{!v.updateFormCallback}" />
                                                        </aura:if>
                                                    </aura:if>
                                                </aura:iteration>
                                                <aura:if isTrue="{!v.applicationError}">
                                                    <div class="textColorRed slds-p-vertical_medium">
                                                        {!$Label.c.PMP_Edit_Storefront_Application_Error}
                                                    </div>
                                                </aura:if>
                                            </div>
                                            <div id="regScrollId" class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? 'slds-p-around_medium' : 'slds-p-around_large'), 'bgWhite')}">
                                                <p><span class="color-red">*</span> {!$Label.c.PMP_Edit_Storefront_Geo_Top}</p>
                                                <p class="pSmallText">{!$Label.c.PMP_Edit_Storefront_Geo_Sub}</p>
                                                <!-- Learn More link Commented since not required -->
                                                <!--    <p class="slds-p-vertical_medium">
                                                    <a href="{!v.regionLearnMoreUrl}">
                                                        {!$Label.c.PMP_Edit_Storefront_Geo_LearnMoreLink}
                                                        <lightning:icon iconName="utility:chevronright" class="slds-m-left_xxx-small iconSizeSmall iconBlue" />
                                                    </a>
                                                </p> -->
                                                <lightning:input aura:id="selectAllRegionCheckbox" class="slds-m-bottom_medium regionOption"
                                                                 type="checkbox" checked="{!v.regionsSelectedAll}" onchange="{!c.handleRegionChangeAll}" label="{!$Label.c.PMP_Select_All}" />
                                                <aura:iteration items="{!v.regionOptions}" var="option">
                                                    <lightning:input class="regionOption" type="checkbox" checked="{!option.checked}" label="{!option.label}" value="{!option.value}" onchange="{!c.handleRegionChange}" />
                                                    <aura:if isTrue="{!option.checked}">
                                                        <c:MarketplaceFormDropdown   aura:id="regionDropdown" readOnly="true" value="{!option.selections}" allowMultipleOptions="true" options="{!option.children}" updateFormCallback="{!v.updateFormCallback}" />
                                                    </aura:if>
                                                </aura:iteration>
                                                <aura:if isTrue="{!v.regionError}">
                                                    <div class="textColorRed slds-p-vertical_medium">
                                                        {!$Label.c.PMP_Edit_Storefront_Geo_Error}
                                                    </div>
                                                </aura:if>
                                            </div>
                                        </aura:if>
                                        
                                        <!-- STEP 4: COMPANY RESOURCES -->
                                        <aura:if isTrue="{!v.currentStep == 3}">
                                            <div id="resScrollId" class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_small slds-p-bottom_medium'), 'bgWhite')}">
                                                <p class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? 'slds-p-horizontal_medium slds-m-bottom_small' : 'slds-p-horizontal_large'), 'slds-p-top_medium')}">
                                                    {!$Label.c.PMP_Edit_Storefront_Resources_Top}
                                                </p>
                                                
                                                <aura:iteration items="{!v.resources}" var="resource" indexVar="index">
                                                    <div id="{!'resource' + index}" class="{!join(' ', (index lt (v.resourcesMax - 1) ? 'slds-p-vertical_small borderBottom' : 'slds-p-vertical_small'), v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-horizontal_small')}">
                                                        <div class="slds-p-horizontal_small">
                                                            <h4>{!$Label.c.PMP_Edit_Storefront_Resources_Res} {!index + 1}
                                                                <span data-idx="{!index}" class="delete-wrapper" onclick="{!c.handleDeleteResource}">
                                                                    <lightning:icon iconName="utility:delete" size="xx-small" alternativeText="delete" />
                                                                </span>
                                                            </h4>
                                                        </div>
                                                        <lightning:layout multipleRows="true">
                                                            <lightning:layoutItem size="12" largeDeviceSize="6" class="slds-p-vertical_small slds-p-horizontal_medium">
                                                                <lightning:input aura:id="resource" type="text" label="{!$Label.c.PMP_Edit_Storefront_Resources_Name_Label}" value="{!resource.title}" required="true" onchange="{!c.handleChange}" maxlength="50" minlength="0"/>
                                                            </lightning:layoutItem>
                                                        </lightning:layout>
                                                        <lightning:layout multipleRows="true">
                                                            <lightning:layoutItem size="12" largeDeviceSize="6" class="slds-p-vertical_small slds-p-horizontal_medium">
                                                                <lightning:select aura:id="resource" label="{!$Label.c.PMP_Edit_Storefront_Resources_Type_Label}" required="true" messageWhenValueMissing="A dropdown value is required." value="{!resource.type}" onchange="{!c.handleDropdownChange}">
                                                                    <option value="">{!$Label.c.PMP_Edit_Storefront_Resources_Type_Placeholder}</option>
                                                                    <aura:iteration var="option" items="{!v.resourceTypeOptions}">
                                                                        <option value="{!option.value}">{!option.label}</option>
                                                                    </aura:iteration>
                                                                </lightning:select>
                                                            </lightning:layoutItem>
                                                            <lightning:layoutItem size="12" largeDeviceSize="6" class="slds-p-vertical_small slds-p-horizontal_medium">
                                                                <lightning:input aura:id="resource" type="url" label="{!$Label.c.PMP_Edit_Storefront_Resources_URL_Label}" value="{!resource.url}" pattern="{!v.urlMatchingPattern}" required="true" onblur="{!c.handleChange}" onchange="{!c.handleChange}" />
                                                            </lightning:layoutItem>
                                                        </lightning:layout>
                                                    </div>
                                                </aura:iteration>
                                                
                                                <aura:if isTrue="{!v.resources.length lt v.resourcesMax}">
                                                    <div class="{!(v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large')  + ' slds-m-top_large slds-m-bottom_small fullWidth'}">
                                                        <span onclick="{! c.handleAddResource }">
                                                            <c:IntelButton class="gray inline" aura:id="addResourceBtn">
                                                                <lightning:icon iconName="utility:add" class="iconSizeNormal iconDarkGray slds-m-right_small" />
                                                                <span>{!$Label.c.PMP_Edit_Storefront_Resources_Add_Btn}</span>
                                                            </c:IntelButton>
                                                        </span>
                                                    </div>
                                                    
                                                </aura:if>
                                                <!-- <span class="error">errormessage</span> -->
                                            </div>
                                        </aura:if>
                                        
                                        <!-- STEP 5: SUMMARY -->
                                        <aura:if isTrue="{!v.currentStep == 4}">
                                            
                                            <div class="{!join(' ', 'slds-m-bottom_medium', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">
                                                <h2 class="{!join(' ', 'summarySection', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">
                                                    <span>{!$Label.c.PMP_Edit_Storefront_Logo}</span>
                                                    
                                                    <aura:if isTrue="{!and(v.summaryData.logo.isUpdated, !v.isFirstDraft)}"><span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span></aura:if>
                                                </h2>
                                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium slds-p-top_medium' : 'slds-m-horizontal_large slds-p-top_medium'}">
                                                    <aura:if isTrue="{!v.hasLogo}">
                                                        
                                                        <img class="logoImg" src="{!v.logourl}"  />
                                                        <aura:set attribute="else">
                                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;
                                                                <a class="error-link textColorRed" data-tab="logo" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>
                                                            </p>
                                                        </aura:set>
                                                    </aura:if>       
                                                </div>
                                            </div>
                                            <div class="{!join(' ', 'slds-m-bottom_medium', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">
                                                <h2 class="{!join(' ', 'summarySection', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">
                                                    <span>{!$Label.c.PMP_Edit_Storefront_Company_Description}</span>
                                                    <aura:if isTrue="{!and(v.summaryData.description.isUpdated, !v.isFirstDraft)}"><span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span></aura:if>
                                                </h2>
                                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'}">
                                                    
                                                    <aura:if isTrue="{!v.summaryData.description.isValid}"> 
                                                        
                                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Description_Lang_Label}</p>
                                                        <p class="pSmallText">{!v.summaryData.description.language}</p>
                                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Description_Tagline_Label}</p>
                                                        <p class="pSmallText">{!v.summaryData.description.tagline}</p>
                                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Description_Des_Label}</p>
                                                        <p class="pSmallText"><ui:outputRichText value="{!v.summaryData.description.description}" class="summary-richtext"/></p>
                                                        
                                                        <aura:set attribute="else">
                                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;
                                                                <a class="error-link textColorRed" data-tab="description" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>
                                                            </p>
                                                        </aura:set> 
                                                    </aura:if> 
                                                </div>
                                            </div>
                                            <div class="{!join(' ', 'slds-m-bottom_medium', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">
                                                <h2 class="{!join(' ', 'summarySection', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">
                                                    <span>{!$Label.c.PMP_Edit_Storefront_Company_Details}</span> 
                                                    <aura:if isTrue="{!and(v.summaryData.companyDetail.isUpdated, !v.isFirstDraft)}"> <span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span>  </aura:if> 
                                                </h2>
                                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'}">
                                                    <aura:if isTrue="{!v.summaryData.companyDetail.isValid}"> 
                                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Industry}</p>
                                                        <aura:iteration items="{!v.summaryData.companyDetail.industries}" var="region">
                                                            <p class="pSmallText">{!region.label}</p>
                                                            <p class="pSmallText">
                                                                <aura:iteration items="{!region.children}" var="childRegion" indexVar="idxc">
                                                                    <span>{!childRegion.label}</span>
                                                                    <aura:if isTrue="{!idxc lt (region.children.length - 1)}">,&nbsp;</aura:if>
                                                                </aura:iteration>
                                                            </p> 
                                                        </aura:iteration>
                                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_application}</p>
                                                        <aura:iteration items="{!v.summaryData.companyDetail.applications}" var="region">
                                                            <p class="pSmallText">{!region.label}</p>
                                                            <p class="pSmallText">
                                                                <aura:iteration items="{!region.children}" var="childRegion" indexVar="idxc">
                                                                    
                                                                    <span>{!childRegion.label}</span>
                                                                    
                                                                    <aura:if isTrue="{!idxc lt (region.children.length - 1)}">,&nbsp;</aura:if>
                                                                </aura:iteration>
                                                            </p> 
                                                        </aura:iteration>
                                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Geo_Top}</p>
                                                        <aura:iteration items="{!v.summaryData.companyDetail.regions}" var="region">
                                                            <p class="pSmallText">{!region.label}</p>
                                                            <p class="pSmallText">
                                                                <aura:iteration items="{!region.children}" var="childRegion" indexVar="idxc">
                                                                    
                                                                    <span>{!childRegion.label}</span>
                                                                    
                                                                    <aura:if isTrue="{!idxc lt (region.children.length - 1)}">,&nbsp;</aura:if>
                                                                </aura:iteration>
                                                            </p> 
                                                        </aura:iteration>
                                                        
                                                        
                                                        <aura:set attribute="else">
                                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;
                                                                <a class="error-link textColorRed" data-tab="regions" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>
                                                            </p>
                                                        </aura:set>
                                                    </aura:if>  
                                                </div>
                                            </div>
                                            <div class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">
                                                <h2 class="{!join(' ', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">
                                                    <span>{!$Label.c.PMP_Resources}</span>
                                                    <aura:if isTrue="{!and(v.summaryData.resources.isUpdated, !v.isFirstDraft)}"><span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span></aura:if>
                                                </h2>
                                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'}">
                                                    <aura:if isTrue="{!v.summaryData.resources.isValid}"> 
                                                        <table class="slds-m-top_small">
                                                            <thead>
                                                                <tr>
                                                                    <th class="slds-p-vertical_xx-small">{!$Label.c.PMP_Edit_Storefront_Resources_Type_Label}</th>
                                                                    <th class="slds-p-vertical_xx-small">{!$Label.c.PMP_Edit_Storefront_Resources_Res}</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <aura:iteration items="{!v.summaryData.resources.all}" var="resource" indexVar="index">
                                                                    <tr>
                                                                        <td class="slds-p-vertical_xx-small">
                                                                            <p class="pSmallText">{!resource.type}</p>
                                                                        </td>
                                                                        <td class="slds-p-vertical_xx-small">
                                                                            <p class="pSmallText">
                                                                                <c:psMpLink externalUrl="{!resource.url}" label="{!resource.title}"></c:psMpLink> 
                                                                                <!-- <p class="pSmallText">{!resource.title}</p> -->
                                                                            </p>
                                                                        </td>
                                                                    </tr>
                                                                </aura:iteration>
                                                                
                                                                
                                                            </tbody>
                                                        </table>
                                                        <aura:set attribute="else">
                                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;
                                                                <a class="error-link textColorRed" data-tab="resources" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>
                                                            </p>
                                                        </aura:set>
                                                    </aura:if>
                                                </div>
                                            </div>
                                        </aura:if>
                                        
                                        <!-- Step 5: Admin Review -->
                                        <!-- <aura:if isTrue="{!and(!v.isLocked, !v.isAdmin, v.currentStep == 7)}">-->
                                        <aura:if isTrue="{!and(v.isIntelAdmin, v.currentStep == 5)}">
                                            <!-- <aura:if isTrue="{!v.currentStep == 5}">-->
                                            <div class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-around_medium'), 'bgWhite')}">
                                              <form> 
                                                    <lightning:layout multipleRows="true" >
                                                        <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                                            <aura:if isTrue="{!v.loggedInAdmin}">
                                                                <c:MarketplaceFormDropdown aura:id="dropdown" label="{!$Label.c.PMP_Select_Admin}" value="{!v.loggedInAdmin}" options="{!v.admins}" updateFormCallback="{!v.updateFormCallback}"/>  
                                                            </aura:if>
                                                        </lightning:layoutItem>
                                                        <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                                            
                                                            <aura:if isTrue="{!v.currentStatus}">
                                                                <c:MarketplaceFormDropdown aura:id="dropdown" label="{!$Label.c.PMP_Edit_Storefront_Storefront_Status}" value="{!v.currentStatus}" options="{!v.statusList}" updateFormCallback="{!v.updateFormCallback}"/>  
                                                            </aura:if>
                                                        </lightning:layoutItem>
                                                    </lightning:layout><br/><br/>
                                                    <lightning:layout horizontalAlign="left" verticalAlign="start" >
                                                        <lightning:layoutItem flexibility="auto" padding="around-medium">
                                                            <div class="other-admin-font"> {!$Label.c.PMP_Assigned_to_Admin}:
                                                                {!v.loggedInAdmin}
                                                            </div>
                                                        </lightning:layoutItem>
                                                    </lightning:layout>
                                                    <br/><br/>
                                                    <lightning:layout horizontalAlign="left">
                                                        <lightning:layoutItem flexibility="auto" padding="around-medium">
                                                            <div class="admin-partner-font">{!$Label.c.PMP_Edit_Storefront_Changes_Sub_on}</div>
                                                            {!v.submittedOn}
                                                        </lightning:layoutItem>
                                                        <lightning:layoutItem flexibility="auto" padding="around-medium">
                                                            <div class="admin-partner-font">{!$Label.c.PMP_Edit_Storefront_Changes_Sub_by}</div>
                                                            {!v.submittedBy}
                                                        </lightning:layoutItem>
                                                    </lightning:layout>
                                              </form>  
                                            </div>
                                        </aura:if>
                                        
                                        <!-- END STEPS -->
                                        
                                    </form>
                                    <aura:if isTrue="{!v.showErrors}">
                                        <p class="bold slds-p-top_small">{!$Label.c.PMP_Toast_Notification_Copy}</p>
                                        <ul>
                                            <aura:iteration items="{!v.errorInputs}" var="item">
                                                <li><a class="error-link textColorRed" id="{!item.name}" onclick="{!c.handleErrorClick}">{!item.label}</a></li>
                                            </aura:iteration>
                                        </ul>
                                    </aura:if>
                                </lightning:layoutItem>
                                <aura:if isTrue="{!!v.isFirstDraft}">
                                    <lightning:layoutItem size="12" mediumDeviceSize="4" class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? 'bgWhite' : 'bgWhite'), 'messageLayoutItem')}">
                                        <aura:if isTrue="{!v.workingCopyId}">   
                                            <c:MarketplaceMessaging isPartner="true" heading="{!$Label.c.PMP_Messaging_MessagesAboutStorefront}" recordId="{! v.workingCopyId }" />
                                        </aura:if>
                                    </lightning:layoutItem> 
                                </aura:if>    
                                
                            </lightning:layout>
                        </aura:if>
                        
                        <aura:if isTrue="{!and(v.currentStep == v.steps.length-1, v.formErrorMsgs.length gt 0)}">
                            <div class="slds-p-horizontal_medium slds-p-top_large" >
                                <p><b>{!$Label.c.PMP_Edit_Storefront_Address_Issues}</b></p>
                                <aura:iteration items="{!v.formErrorMsgs}" var="msg">
                                    <p class="textColorRed slds-p-vertical_xxx-small">{!msg}</p>
                                </aura:iteration>
                            </div>
                        </aura:if>
                        </aura:if>
                    </div>
                    <!-- prev / next / close buttons -->
                    <!-- mobile -->
                    <aura:if isTrue="{!and(v.state.currentScreenSize == 'mobile', !v.isFromLink)}">
                        <aura:if isTrue="{!v.leadSettings}">
                            <!--<p class="slds-p-horizontal_xx-large help-text">{!$Label.c.PMP_Storefront_ProfilePopUp_Footer} <c:IntelLink url="{!$Label.c.PMP_Intel_Profile_Url}" openInBlank="true">{!$Label.c.PMP_Storefront_ProfilePopUp_FooterLink}&nbsp;<lightning:icon iconName="utility:new_window" class="modal brand" size="xx-small"></lightning:icon></c:IntelLink></p>--><!--Custom label Changes-->
                            <p class="slds-p-horizontal_xx-large help-text"><lightning:formattedRichText value="{!$Label.c.PMP_Storefront_FooterIntelLink}"/>&nbsp;<lightning:icon iconName="utility:new_window" class="modal brand" size="xx-small"></lightning:icon></p>
                        </aura:if>
                        <lightning:layout class="slds-p-around_medium slds-text-align_center step-button-group">
                            <aura:if isTrue="{!v.isFirstDraft}">
                                <aura:if isTrue="{!or(v.isLocked, v.currentStep eq v.steps.length)}">
                                    <lightning:layoutItem flexibility="auto">
                                        <div onclick="{!c.handleClose}">
                                            <c:IntelButton disabled="false" class="nextButton" label="{!$Label.c.PMP_Edit_Storefront_Close_Btn}" />
                                        </div>
                                    </lightning:layoutItem>  <!-- Close X  buttton of the modal ends -->
                                    <aura:set attribute="else">
                                        <aura:if isTrue="{!v.currentStep gt 0}">
                                            <lightning:layoutItem flexibility="auto" class="slds-p-right_small">
                                                <div onclick="{!c.handlePrevStep}">
                                                    <c:IntelButton disabled="false" class="prevButton gray" label="{!$Label.c.PMP_Edit_Storefront_Previous_Btn}" />
                                                </div>
                                            </lightning:layoutItem>
                                        </aura:if>  <!-- Previous button ends -->
                                        <lightning:layoutItem flexibility="auto">
                                            <div onclick="{!c.handleNextStep}">
                                                <aura:if isTrue="{!v.currentStep lt v.steps.length-1}">
                                                    <span onclick="{!c.handleClose}" class="slds-m-right_medium cancelButton">
                                                        <c:IntelButton disabled="false" class="prevButton gray">
                                                            {!$Label.c.Core_PMP_Cancel}
                                                        </c:IntelButton>
                                                    </span>
                                                    <c:IntelButton class="nextButton">
                                                        {!$Label.c.PMP_Edit_Storefront_Next_Btn}
                                                    </c:IntelButton>
                                                    <aura:set attribute="else">
                                                        <aura:if isTrue="{!v.currentStatus == 'Update Required'}">
                                                            <c:IntelButton disabled="{!!v.formValid}" class="nextButton tooltip">
                                                                {!$Label.c.PMP_Edit_Storefront_Resubmit_Btn_sm}
                                                            </c:IntelButton>
                                                            <!-- <aura:set attribute ="else">
                                                                <c:IntelButton disabled="{!!v.formValid}" class="nextButton tooltip">
                                                                    {!$Label.c.PMP_Edit_Storefront_Submit_Btn}
                                                                </c:IntelButton>
                                                            </aura:set>-->
                                                        </aura:if>
                                                        
                                                    </aura:set>
                                                </aura:if>
                                            </div>  <!-- next button, cancel button & submit button block ends -->
                                        </lightning:layoutItem>
                                    </aura:set>
                                </aura:if>
                                
                                <aura:set attribute="else">
                                    <aura:if isTrue="{!or(v.isLocked, v.currentStep eq v.steps.length)}">
                                        <lightning:layoutItem flexibility="auto">
                                            <!--<div onclick="{!c.handleNextStep}">
                                                <c:IntelButton disabled="false" class="nextButton" label="{!$Label.c.PMP_Edit_Storefront_Close_Btn}" />
                                            </div>-->
                                            <span onclick="{!c.handleNextStep}">
                                                <c:IntelButton disabled="false" class="nextButton">
                                                    {!$Label.c.PMP_Edit_Storefront_ProceedToStep_Btn}
                                                </c:IntelButton>
                                            </span>
                                        </lightning:layoutItem>
                                        <aura:set attribute="else">
                                            <aura:if isTrue="{!or(v.isLocked, v.currentStep eq v.steps.length)}">
                                                <aura:if isTrue="{!v.isProfileAdmin}">
                                                    
                                                    <span onclick="{!c.handleNextStep}">
                                                        <c:IntelButton disabled="false" class="nextButton">
                                                            {!$Label.c.PMP_Edit_Storefront_ProceedToStep_Btn}
                                                        </c:IntelButton>
                                                    </span>
                                                    
                                                    <aura:set attribute="else">
                                                        <span onclick="{!c.handleClose}" class="slds-m-left-small slds-size_12-of-12">
                                                            <c:IntelButton disabled="false" class="nextButton">
                                                                {!$Label.c.PMP_Edit_Storefront_Close_Btn}
                                                            </c:IntelButton>
                                                        </span>                                              
                                                    </aura:set>
                                                </aura:if>
                                            </aura:if> 
                                            <!--Not First Submission - Edit Buttons-->
                                            <aura:if isTrue="{!!v.firstSubmission}">
                                                <aura:if isTrue="{!v.currentStep lt 4}">
                                                    <span onclick="{!c.handleGoToSummary}" class="slds-m-right_x-small slds-size_6-of-12">
                                                        <c:IntelButton disabled="false" class="prevButton gray">
                                                            {!$Label.c.PMP_Summary_Label}
                                                        </c:IntelButton>
                                                    </span>
                                                    <span onclick="{!c.handleSubmitEdits}" class="slds-m-left-small slds-size_6-of-12">
                                                        <c:IntelButton disabled="{!!v.formValid}" class="nextButton">
                                                            {!$Label.c.PMP_Summary_SubmitEdits_Label}
                                                        </c:IntelButton>
                                                    </span>
                                                    <aura:set attribute="else">
                                                        <aura:if isTrue="{!v.currentStep eq 4}">
                                                            <span onclick="{!c.handleClose}" class="slds-m-right_medium slds-size_6-of-12">
                                                                <c:IntelButton disabled="false" class="prevButton gray">
                                                                    {!$Label.c.Core_PMP_Cancel}
                                                                </c:IntelButton>
                                                            </span>
                                                            <span onclick="{!c.handleSubmitEdits}" class="slds-m-left-small slds-size_6-of-12">
                                                                <c:IntelButton disabled="{!!v.formValid}" class="nextButton">
                                                                    {!$Label.c.PMP_Summary_SubmitEdits_Label}
                                                                </c:IntelButton>
                                                            </span>
                                                        </aura:if>
                                                    </aura:set>
                                                </aura:if>
                                            </aura:if>
                                        </aura:set>
                                        
                                    </aura:if>
                                    
                                </aura:set>
                            </aura:if>
                            
                        </lightning:layout>
                        <div style="height: 50px;">
                            <!-- spacer -->
                        </div>
                        
                        <!-- desktop buttons -->
                        <aura:set attribute="else">
                            <aura:if isTrue="{!!v.isFromLink}">
                            <aura:if isTrue="{!v.leadSettings}">
                               <!-- <p class="slds-p-horizontal_xx-large help-text">{!$Label.c.PMP_Storefront_ProfilePopUp_Footer}&nbsp;<c:IntelLink url="{!$Label.c.PMP_Intel_Profile_Url}" openInBlank="true">{!$Label.c.PMP_Storefront_ProfilePopUp_FooterLink}&nbsp;<lightning:icon iconName="utility:new_window" class="modal brand" size="xx-small"></lightning:icon></c:IntelLink></p>--><!--Custom Label Changes-->
                                <p class="slds-p-horizontal_xx-large help-text"><lightning:formattedRichText value="{!$Label.c.PMP_Storefront_FooterIntelLink}"/>&nbsp;<lightning:icon iconName="utility:new_window" class="modal brand" size="xx-small"></lightning:icon></p>
                            </aura:if>
                            <div class="desktop-action-buttons slds-p-vertical_x-small slds-text-align_right slds-p-horizontal_xx-large">
                                <!--<aura:if isTrue="{!and(v.currentStep eq 6, v.isAdmin)}">-->
                                <aura:if isTrue="{!and(v.currentStep eq 6, !v.isIntelAdmin)}">
                                    <span onclick="{!c.handleClose}">
                                        <c:IntelButton disabled="false" class="nextButton">
                                            {!$Label.c.PMP_Storefront_Save_and_Close}
                                        </c:IntelButton>
                                    </span>
                                </aura:if>
                                <aura:if isTrue="{!v.isFirstDraft}">
                                    <aura:if isTrue="{!or(v.isLocked, v.currentStep eq v.steps.length)}">
                                        <aura:if isTrue="{!v.isProfileAdmin}">
                                            <span onclick="{!c.handleNextStep}">
                                                <c:IntelButton disabled="false" class="nextButton">
                                                    {!$Label.c.PMP_Edit_Storefront_ProceedToStep_Btn}
                                                </c:IntelButton>
                                            </span>   
                                            <aura:set attribute="else">
                                                <span onclick="{!c.handleClose}">
                                                    <c:IntelButton disabled="false" class="nextButton">
                                                        {!$Label.c.PMP_Edit_Storefront_Close_Btn}
                                                    </c:IntelButton>
                                                </span> <!-- Close X  buttton of the modal ends -->
                                            </aura:set>
                                        </aura:if>
                                        <aura:set attribute="else">
                                            <aura:if isTrue="{!and(v.currentStep gt 0, v.currentStep lt 4)}">
                                                <span onclick="{!c.handlePrevStep}" class="slds-m-right_medium">
                                                    <c:IntelButton disabled="false" class="prevButton gray">
                                                        {!$Label.c.PMP_Edit_Storefront_Previous_Btn}
                                                    </c:IntelButton>
                                                </span>
                                            </aura:if> <!-- Previous button ends -->  
                                            <span onclick="{!c.handleNextStep}">
                                                <aura:if isTrue="{!v.currentStep lt v.steps.length-1}">
                                                    <span onclick="{!c.handleClose}" class="slds-m-right_medium cancelButton">
                                                        <c:IntelButton disabled="false" class="prevButton gray">
                                                            {!$Label.c.Core_PMP_Cancel}
                                                        </c:IntelButton>
                                                    </span>
                                                    <c:IntelButton class="nextButton">
                                                        {!$Label.c.PMP_Edit_Storefront_Next_Btn}
                                                    </c:IntelButton>
                                                    <aura:set attribute="else">
                                                        <aura:if isTrue="{!!v.leadSettings}">
                                                        <span onclick="{!c.handleClose}" class="slds-m-right_medium cancelButton">
                                                            <c:IntelButton disabled="false" class="prevButton gray">
                                                                {!$Label.c.Core_PMP_Cancel}
                                                            </c:IntelButton>
                                                        </span>
                                                        </aura:if>
                                                        <aura:if isTrue="{!v.currentStatus == 'Update Required'}">
                                                            <c:IntelButton disabled="{!!v.formValid}" class="nextButton">
                                                                {!$Label.c.PMP_Edit_Storefront_Resubmit_Btn_sm}
                                                            </c:IntelButton>
                                                            <aura:set attribute ="else">
                                                                <aura:if isTrue="{!!v.leadSettings}">
                                                                    <c:IntelButton disabled="{!!v.formValid}" class="nextButton">
                                                                        {!$Label.c.PMP_Edit_Storefront_Submit_Btn}
                                                                    </c:IntelButton>
                                                                </aura:if>
                                                                
                                                            </aura:set>
                                                        </aura:if>
                                                        
                                                    </aura:set>
                                                </aura:if> <!-- next button, cancel button & submit button block ends -->
                                            </span>
                                        </aura:set>
                                    </aura:if>
                                    
                                    <aura:set attribute="else">
                                        <aura:if isTrue="{!and(v.isIntelAdmin, v.currentStep eq 5)}">
                                            <span onclick="{!c.handleNextStep}">
                                            <aura:if isTrue="{!v.currentStatus == 'Update Required'}">
                                                <c:IntelButton disabled="{!!v.formValid}" class="nextButton">
                                                    {!$Label.c.PMP_Edit_Storefront_Resubmit_Btn_sm}
                                                </c:IntelButton>
                                                <aura:set attribute ="else">
                                                   <!-- <aura:if isTrue="{!!v.leadSettings}">-->
                                                        <c:IntelButton disabled="{!!v.formValid}" class="nextButton">
                                                            {!$Label.c.PMP_Edit_Storefront_Submit_Btn}
                                                        </c:IntelButton>
                                                   <!-- </aura:if>-->
                                                    
                                                </aura:set>
                                            </aura:if>
                                            </span>
                                        </aura:if>
                                        <aura:if isTrue="{!or(v.isLocked, v.currentStep eq v.steps.length)}">                                            
                                            <span onclick="{!c.handleClose}">
                                                <c:IntelButton disabled="false" class="nextButton">
                                                    {!$Label.c.PMP_Edit_Storefront_Close_Btn}
                                                </c:IntelButton>
                                            </span>
                                            <aura:set attribute="else">
                                                <aura:if isTrue="{!v.currentStep lt 4}">
                                                    <span onclick="{!c.handleClose}" class="slds-m-right_medium cancelButton">
                                                        <c:IntelButton disabled="false" class="prevButton gray">
                                                            {!$Label.c.Core_PMP_Cancel}  
                                                        </c:IntelButton>
                                                    </span>
                                                    <span onclick="{!c.handleGoToSummary}" class="slds-m-right_medium">
                                                        <c:IntelButton disabled="false" class="prevButton gray">
                                                            {!$Label.c.PMP_Summary_Label}
                                                        </c:IntelButton>
                                                    </span>
                                                    <span onclick="{!c.handleSubmitEdits}" class="slds-m-right_medium">
                                                        <c:IntelButton disabled="{!!v.formValid}" class="nextButton">
                                                            {!$Label.c.PMP_Summary_SubmitEdits_Label}
                                                        </c:IntelButton>
                                                    </span>
                                                    <aura:set attribute="else">
                                                       <aura:if isTrue="{!v.currentStep eq 4}"> 
                                                            <span onclick="{!c.handleClose}" class="slds-m-right_medium cancelButton">
                                                                <c:IntelButton disabled="false" class="prevButton gray">
                                                                    {!$Label.c.Core_PMP_Cancel}
                                                                </c:IntelButton>
                                                            </span>
                                                            <span onclick="{!c.handleSubmitEdits}" class="slds-m-right_medium">
                                                                <c:IntelButton disabled="{!!v.formValid}" class="nextButton">
                                                                    {!$Label.c.PMP_Summary_SubmitEdits_Label}
                                                                </c:IntelButton>
                                                            </span>
                                                      </aura:if>  
                                                    </aura:set>
                                                </aura:if>
                                            </aura:set>
                                        </aura:if>
                                        
                                    </aura:set>
                                    
                                </aura:if>                                
                            </div>
                            </aura:if>
                        </aura:set>
                    </aura:if>
                    <aura:if isTrue="{!v.isFromLink}">      	
                        <div class="slds-var-m-around_medium"> 	
                            <div class="{!join(' ', 'slds-m-bottom_medium', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">            	
                                <h2 class="{!join(' ', 'summarySection', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">          	
                                    <span>{!$Label.c.PMP_Edit_Storefront_Logo}</span>            	
                                    
                                    <aura:if isTrue="{!and(v.summaryData.logo.isUpdated, !v.isFirstDraft)}"><span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span></aura:if>          	
                                </h2> 	
                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium slds-p-top_medium' : 'slds-m-horizontal_large slds-p-top_medium'}">             	
                                    <aura:if isTrue="{!v.hasLogo}">         	
                                        
                                        <img class="logoImg" src="{!v.logourl}"  />              	
                                        <aura:set attribute="else">            	
                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;    	
                                                <a class="error-link textColorRed" data-tab="logo" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>           	
                                            </p>     	
                                        </aura:set>            	
                                    </aura:if>                    	
                                </div>               	
                            </div>    	
                            <div class="{!join(' ', 'slds-m-bottom_medium', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">            	
                                <h2 class="{!join(' ', 'summarySection', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">          	
                                    <span>{!$Label.c.PMP_Edit_Storefront_Company_Description}</span>         	
                                    <aura:if isTrue="{!and(v.summaryData.description.isUpdated, !v.isFirstDraft)}"><span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span></aura:if>          	
                                </h2> 	
                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'}">        	
                                    
                                    <aura:if isTrue="{!v.summaryData.description.isValid}">        	
                                        
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Description_Lang_Label}</p>    	
                                        <p class="pSmallText">{!v.summaryData.description.language}</p>            	
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Description_Tagline_Label}</p> 	
                                        <p class="pSmallText">{!v.summaryData.description.tagline}</p> 	
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Description_Des_Label}</p>      	
                                        <p class="pSmallText"><ui:outputRichText value="{!v.summaryData.description.description}" class="summary-richtext"/></p>              	
                                        
                                        <aura:set attribute="else">            	
                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;    	
                                                <a class="error-link textColorRed" data-tab="description" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>           	
                                            </p>     	
                                        </aura:set>            	
                                    </aura:if>    	
                                </div>               	
                            </div>    	
                            <div class="{!join(' ', 'slds-m-bottom_medium', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">            	
                                <h2 class="{!join(' ', 'summarySection', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">          	
                                    <span>{!$Label.c.PMP_Edit_Storefront_Company_Details}</span>   	
                                    <aura:if isTrue="{!and(v.summaryData.companyDetail.isUpdated, !v.isFirstDraft)}"> <span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span>  </aura:if>        	
                                </h2> 	
                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'}">        	
                                    <aura:if isTrue="{!v.summaryData.companyDetail.isValid}"> 	
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Industry}</p>     	
                                        <aura:iteration items="{!v.summaryData.companyDetail.industries}" var="region">             	
                                            <p class="pSmallText">{!region.label}</p>          	
                                            <p class="pSmallText"> 	
                                                <aura:iteration items="{!region.children}" var="childRegion" indexVar="idxc">              	
                                                    <span>{!childRegion.label}</span> 	
                                                    <aura:if isTrue="{!idxc lt (region.children.length - 1)}">,&nbsp;</aura:if>      	
                                                </aura:iteration>        	
                                            </p>     	
                                        </aura:iteration> 	
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_application}</p> 	
                                        <aura:iteration items="{!v.summaryData.companyDetail.applications}" var="region">         	
                                            <p class="pSmallText">{!region.label}</p>          	
                                            <p class="pSmallText"> 	
                                                <aura:iteration items="{!region.children}" var="childRegion" indexVar="idxc">              	
                                                    
                                                    <span>{!childRegion.label}</span> 	
                                                    
                                                    <aura:if isTrue="{!idxc lt (region.children.length - 1)}">,&nbsp;</aura:if>      	
                                                </aura:iteration>        	
                                            </p>     	
                                        </aura:iteration> 	
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Geo_Top}</p>  	
                                        <aura:iteration items="{!v.summaryData.companyDetail.regions}" var="region">  	
                                            <p class="pSmallText">{!region.label}</p>          	
                                            <p class="pSmallText"> 	
                                                <aura:iteration items="{!region.children}" var="childRegion" indexVar="idxc">              	
                                                    
                                                    <span>{!childRegion.label}</span> 	
                                                    
                                                    <aura:if isTrue="{!idxc lt (region.children.length - 1)}">,&nbsp;</aura:if>      	
                                                </aura:iteration>        	
                                            </p>     	
                                        </aura:iteration> 	
                                        
                                        
                                        <aura:set attribute="else">            	
                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;    	
                                                <a class="error-link textColorRed" data-tab="regions" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>           	
                                            </p>     	
                                        </aura:set>            	
                                    </aura:if>    	
                                </div>               	
                            </div>    	
                            <div class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">    	
                                <h2 class="{!join(' ', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">         	
                                    <span>{!$Label.c.PMP_Resources}</span>  	
                                    <aura:if isTrue="{!and(v.summaryData.resources.isUpdated, !v.isFirstDraft)}"><span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span></aura:if>          	
                                </h2> 	
                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'}">        	
                                    <aura:if isTrue="{!v.summaryData.resources.isValid}">           	
                                        <table class="slds-m-top_small"> 	
                                            <thead>              	
                                                <tr>  	
                                                    <th class="slds-p-vertical_xx-small">{!$Label.c.PMP_Edit_Storefront_Resources_Type_Label}</th>     	
                                                    <th class="slds-p-vertical_xx-small">{!$Label.c.PMP_Edit_Storefront_Resources_Res}</th>    	
                                                </tr> 	
                                            </thead>            	
                                            <tbody>              	
                                                <aura:iteration items="{!v.summaryData.resources.all}" var="resource" indexVar="index">                	
                                                    <tr>              	
                                                        <td class="slds-p-vertical_xx-small">         	
                                                            <p class="pSmallText">{!resource.type}</p>     	
                                                        </td>      	
                                                        <td class="slds-p-vertical_xx-small">         	
                                                            <p class="pSmallText">              	
                                                                <c:psMpLink externalUrl="{!resource.url}" label="{!resource.title}"></c:psMpLink>                 	
                                                                <!-- <p class="pSmallText">{!resource.title}</p> -->  	
                                                            </p>   	
                                                        </td>      	
                                                    </tr>            	
                                                </aura:iteration>        	
                                                
                                                
                                            </tbody>            	
                                        </table>  	
                                        <aura:set attribute="else">            	
                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;    	
                                                <a class="error-link textColorRed" data-tab="resources" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>           	
                                            </p>     	
                                        </aura:set>            	
                                    </aura:if>    	
                                </div>               	
                            </div>    	
                        </div>        	
                    </aura:if>
                </div>
            </c:MarketplaceModal>    
        </aura:if>
        
    </div>
    
</aura:component>