                                                <p class="pSmallText">{!v.partner.state}</p>
                                            </lightning:layoutItem>
                                        </lightning:layout>
                                        <lightning:layout multipleRows="true">
                                            <lightning:layoutItem size="12" largeDeviceSize="6">
                                                <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Country}</p>
                                                <p class="pSmallText">{!v.partner.country}</p>
                                            </lightning:layoutItem>
                                            <lightning:layoutItem size="12" largeDeviceSize="6">
                                                <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Zip_Code}</p>
                                                <p class="pSmallText">{!v.partner.postalCode}</p>
                                            </lightning:layoutItem>
                                        </lightning:layout>
                                        <!--END OF US686697-->
                                        <aura:set attribute="else">
                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;
                                                <a class="error-link textColorRed" data-tab="logo" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>
                                            </p>
                                        </aura:set>
                                    </aura:if>       
                                </div>              	
                            </div>    	
                            <div class="{!join(' ', 'slds-m-bottom_medium', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">            	
                                <h2 class="{!join(' ', 'summarySection', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">          	
                                    <span>{!$Label.c.PMP_Edit_Storefront_Company_Description}</span>
                                    
                                    <aura:if isTrue="{!and(v.summaryData.description.isUpdated, !v.isFirstDraft)}"><span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span></aura:if>          	
                                </h2> 	
                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'}">        	
                                    
                                    <aura:if isTrue="{!v.summaryData.description.isValid}">        	
                                        
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Description_Lang_Label}</p>    	
                                        <p class="pSmallText">{!v.summaryData.description.language}</p>            	
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Description_Tagline_Label}</p> 	
                                        <p class="pSmallText">{!v.summaryData.description.tagline}</p> 	
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Description_Des_Label}</p>      	
                                        <p class="pSmallText"><ui:outputRichText value="{!v.summaryData.description.description}" class="summary-richtext"/></p>              	
                                        
                                        <aura:set attribute="else">            	
                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;    	
                                                <a class="error-link textColorRed" data-tab="description" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>           	
                                            </p>     	
                                        </aura:set>            	
                                    </aura:if>    	
                                </div>               	
                            </div>    	
                            <div class="{!join(' ', 'slds-m-bottom_medium', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">            	
                                <h2 class="{!join(' ', 'summarySection', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">          	
                                    <span>{!$Label.c.PMP_Edit_Storefront_Company_Details}</span>   	
                                    <aura:if isTrue="{!and(v.summaryData.companyDetail.isUpdated, !v.isFirstDraft)}"> <span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span>  </aura:if>        	
                                </h2> 	
                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'}">        	
                                    <aura:if isTrue="{!v.summaryData.companyDetail.isValid}"> 	
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Industry}</p>     	
                                        <aura:iteration items="{!v.summaryData.companyDetail.industries}" var="region">             	
                                            <p class="pSmallText">{!region.label}</p>          	
                                            <p class="pSmallText"> 	
                                                <aura:iteration items="{!region.children}" var="childRegion" indexVar="idxc">              	
                                                    <span>{!childRegion.label}</span> 	
                                                    <aura:if isTrue="{!idxc lt (region.children.length - 1)}">,&nbsp;</aura:if>      	
                                                </aura:iteration>        	
                                            </p>     	
                                        </aura:iteration> 	
                                        <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_application}</p> 	
                                        <aura:iteration items="{!v.summaryData.companyDetail.applications}" var="region">         	
                                            <p class="pSmallText">{!region.label}</p>          	
                                            <p class="pSmallText"> 	
                                                <aura:iteration items="{!region.children}" var="childRegion" indexVar="idxc">              	
                                                    
                                                    <span>{!childRegion.label}</span> 	
                                                    
                                                    <aura:if isTrue="{!idxc lt (region.children.length - 1)}">,&nbsp;</aura:if>      	
                                                </aura:iteration>        	
                                            </p>     	
                                        </aura:iteration> 
                                        <aura:if isTrue="{!!v.isDistributor}"><!--Added by Subash for US697109-->
                                            <p class="slds-m-top_medium slds-m-bottom_xx-small">{!$Label.c.PMP_Edit_Storefront_Geo_Top}</p>  	
                                            <aura:iteration items="{!v.summaryData.companyDetail.regions}" var="region">  	
                                                <p class="pSmallText">{!region.label}</p>          	
                                                <p class="pSmallText"> 	
                                                    <aura:iteration items="{!region.children}" var="childRegion" indexVar="idxc">
                                                        <aura:if isTrue="{!childRegion.checked}">
                                                            <span>{!childRegion.label}</span>
                                                            <aura:if isTrue="{!idxc lt (region.children.length - 1)}">,&nbsp;
                                                                <aura:set attribute="else">
                                                                    ,&nbsp;
                                                                </aura:set>
                                                            </aura:if>
                                                            <aura:iteration items="{!childRegion.children}" var="subchildRegion" indexVar="idxc1">
                                                                <aura:if isTrue="{!subchildRegion.checked}">
                                                                    <span>{!subchildRegion.label}</span>
                                                                    <aura:if isTrue="{!idxc1 lt (childRegion.children.length - 1)}">,&nbsp;</aura:if>
                                                                    <aura:if isTrue="{!idxc1 eq (childRegion.children.length - 1)}"> <br/> </aura:if>
                                                                </aura:if>
                                                            </aura:iteration>
                                                        </aura:if>
                                                    </aura:iteration>
                                                    
                                                </p>     	
                                            </aura:iteration> 	
                                        </aura:if>
                                        
                                        <aura:set attribute="else">            	
                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;    	
                                                <a class="error-link textColorRed" data-tab="regions" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>           	
                                            </p>     	
                                        </aura:set>            	
                                    </aura:if>    	
                                </div>               	
                            </div>    	
                            <div class="{!join(' ', (v.state.currentScreenSize == 'mobile' ? '' : 'slds-p-top_medium slds-p-bottom_large'), 'bgWhite')}">    	
                                <h2 class="{!join(' ', 'borderBottom', 'h5', (v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'))}">         	
                                    <span>{!$Label.c.PMP_Edit_Storefront_Company_Resources}</span>  	
                                    <aura:if isTrue="{!and(v.summaryData.resources.isUpdated, !v.isFirstDraft)}"><span class="updatedText">{!$Label.c.PMP_Summary_Updated_Label}</span></aura:if>          	
                                </h2> 	
                                <div class="{!v.state.currentScreenSize == 'mobile' ? 'slds-m-horizontal_medium' : 'slds-m-horizontal_large'}">        	
                                    <aura:if isTrue="{!v.summaryData.resources.isValid}">           	
                                        <table class="slds-m-top_small"> 	
                                            <thead>              	
                                                <tr>  	
                                                    <th class="slds-p-vertical_xx-small">{!$Label.c.PMP_Edit_Storefront_Resources_Type_Label}</th>     	
                                                    <th class="slds-p-vertical_xx-small">{!$Label.c.PMP_Edit_Storefront_Resources_Res}</th>    	
                                                </tr> 	
                                            </thead>            	
                                            <tbody>              	
                                                <aura:iteration items="{!v.summaryData.resources.all}" var="resource" indexVar="index">                	
                                                    <tr>              	
                                                        <td class="slds-p-vertical_xx-small">         	
                                                            <p class="pSmallText">{!resource.type}</p>     	
                                                        </td>      	
                                                        <td class="slds-p-vertical_xx-small">         	
                                                            <p class="pSmallText">              	
                                                                <c:psMpLink externalUrl="{!resource.url}" label="{!resource.title}"></c:psMpLink>                 	
                                                                <!-- <p class="pSmallText">{!resource.title}</p> -->  	
                                                            </p>   	
                                                        </td>      	
                                                    </tr>            	
                                                </aura:iteration>        	                                                
                                            </tbody>            	
                                        </table>  	
                                        <aura:set attribute="else">            	
                                            <p class="slds-p-vertical_small textColorRed">{!$Label.c.PMP_Summary_ContentError_Label}&nbsp;    	
                                                <a class="error-link textColorRed" data-tab="resources" href="javascript:void(0);" onclick="{!c.handleGoBack}">{!$Label.c.PMP_Summary_ContentTryAgainError_Label}</a>           	
                                            </p>     	
                                        </aura:set>            	
                                    </aura:if>    	
                                </div>               	
                            </div>    	
                        </div>        	
                    </aura:if>
                </div>
            </c:MarketplaceModal>    
        </aura:if>
        
    </div>
    
</aura:component>