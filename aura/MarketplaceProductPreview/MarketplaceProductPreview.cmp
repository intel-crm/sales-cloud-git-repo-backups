<aura:component controller="MarketplaceCreateProductController" implements="forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable">
    
    <aura:attribute name="recordId" type="string" default="a3s0n0000002BnzAAE"/>
    <aura:attribute name="debugMode" type="Boolean" default="true" />

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.pageReference}" action="{!c.onPageReferenceChange}"/>
    
    <p>Record Id: {! v.recordId }</p>

    <c:MarketplaceCreateProductPreview aura:id="offeringPreview" />
	
</aura:component>