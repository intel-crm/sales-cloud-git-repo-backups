<aura:component controller="Core_MDF_PartnerFundClaim" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,lightning:actionOverride,force:lightningQuickActionWithoutHeader,force:hasRecordId">
    
    <ltng:require styles="{!$Resource.Core_MDF_SLDS262 + '/styles/salesforce-lightning-design-system.css'}" />
    
    <aura:handler name="updateLookupIdEvent" event="c:Core_MDF_UpdateLookupId" action="{!c.updateLookUpId}" />
    <aura:handler name="clearLookupIdEvent" event="c:Core_MDF_ClearLookupId" action="{!c.clearLookUpId}" />
    <aura:handler name="change" value="{!v.simpleNewClaim.RequestId}" action="{!c.fetchActivityDetails}" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.duplicateClaimList}" action="{!c.openDuplicateModel}" />
    <aura:attribute name="isDuplicate" type="boolean" default="false" />
    <!-- Attribute to Store Member user -->    
    <aura:attribute name="isPartner" type="boolean" default="false"/>
    <!-- Attributes currentStep showes Create Claim -->
    <aura:attribute name="currentStep" type="string"/>
    <aura:attribute name="isOkDisabled" type="boolean" default="false" />
    <aura:attribute name="isPortal" type="boolean" default="false"/>
    <aura:attribute name="ObjectName" type="String" default="PartnerFundClaim" access="global" />
    <aura:attribute name="fieldName" type="String" default="Core_MDF_Currency__c" access="global" />
    <aura:attribute name="simpleNewClaim" type="PartnerFundClaim" default="{ 'sobjectType': 'PartnerFundClaim',
                                                                           'Description':'',
                                                                           'Amount':'',
                                                                           'Title':''
                                                                           }" />
    <aura:attribute name="duplicateClaimList" type="PartnerFundClaim" default="{ 'sobjectType': 'PartnerFundClaim',
                                                                               'Title':'',
                                                                               'Id':''
                                                                               }" />
    <aura:attribute name="isReqEditVisible" type="boolean"/>
    <aura:attribute name="activitySearchString" type="string" default="" />
    <aura:attribute name="activitySearchCriteria" type="String"/>
    <aura:attribute name="activityRecordTypeDevName" type="string" default="" />
    <aura:attribute name="isClaimEdit" type="boolean" />
    <!--Attribute to check current user is CCR or CCRM -->
    <aura:attribute name="isUserClaimCaseReviewerOrManager" type="boolean" />
    <!--Attirbute to store escalation ID-->
    <aura:attribute name="escalationNoSearchString" type="String"/>
    <!--Attribute to Store Clone Button Variable-->
    <aura:attribute name="isCloneClaim" type="Boolean"  description=" tells if it is clone record"/>
    <!--Flag to check current updated claim country existance into fetched acitivity countries-->
    <aura:attribute name="isClaimCountryAvailInAct" type="Boolean"/>
    <aura:attribute name="countryList" type="List" />
    <!--Flag to check current updated claim bank existance into fetched bank mapping values-->
    <aura:attribute name="isBankMappedWithAcnt" type="Boolean"/>
    <aura:attribute name="bankObjectList" type="List" />
    <aura:attribute name="recordtypeDeveloperName" type="String" default="" description="Stores the recordtypeDeveloperName from the parent component" />
    <aura:attribute name="currList" type="List" />
    <aura:attribute name="bankAccountId" type="string" default="" />
    <!--Attribute to hold activity countries-->
    <aura:attribute name="activityCountries" type="string"/>
    <aura:method name="validateClaimForm" action = "{!c.validateClaimFormFields}"/>
     <!--Event to get error message-->
    <aura:registerEvent name="DisplayErrorMessageEvent" type="c:Core_MDF_DisplayGenericErrorEvent"/>
    <!--To hold activity record id, in case claim create from activity-->
    <aura:attribute name="activityRecId" type="Id"/>
    <!-- store create permission and activity details-->
    <aura:attribute name="createClaimWrapper" type="Object" />
    <!--Setting true , if activity status is In-Progress or Planned -->
    <aura:attribute name="isValidActivityToCreateClaim" type="boolean"/>
    <!--Attribute to hold sobjectID coming from lookup cmp-->
    <aura:attribute name="sObjectId" type="Id"/>
    <aura:attribute name="activityStatusList" type="String[]" />
    <!--Added 2 attributes escActivityId, escalationId to create Claim from Escalation-->
    <aura:attribute name="escActivityId" type="string" default="" />
    <aura:attribute name="escalationId" type="string" default= "" />
    <!--Attribute to hold escalation objectID coming from lookup cmp-->
    <aura:attribute name="escObjectId" type="Id"/>
    <aura:handler name="change" value="{!v.simpleNewClaim.Core_MDF_Escalation_Id__c}" action="{!c.fetchEscalationDetails}" />
    <!--handle edit on status-->
    <aura:attribute name="isClaimEditable" type="boolean"/>
    <aura:attribute name="isAuditUser" type="boolean" default="false" />
    <aura:attribute name="isClaimNegativeType" type="boolean"/>
    <aura:attribute name="claimFromActivityErrorMsg" type="String"/>
    <!--Attribute to check weather Claim is can be Audited or Not -->    
    <aura:attribute name="StrightToPayDisabled" type="Boolean" description="Conditionally disabling the StraightToPay functionality"/>
    
    
    <!-- Display the new claim form -->
    <div class="slds-grid slds-wrap">
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="claimTitle" name="Title" label="{!$Label.c.Core_MDF_Title}"
                             required="true" maxlength = "255" value="{!v.simpleNewClaim.Title}" title="{!$Label.c.Core_MDF_Title_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <aura:if isTrue="{!v.isReqEditVisible}">
                <lightning:input aura:id="ActIdEdit" name="ActivityIdEdit" label="{!$Label.c.Core_MDF_Request}"
                                 value="{!v.activitySearchString}" disabled="true" />
                <aura:set attribute="else">
                    <c:Core_MDF_LightningSObjectLookUp aura:id="activityId" label="{!$Label.c.Core_MDF_Request}"
                                                       pluralLabel="{!$Label.c.Core_MDF_Request}" sObjectAPIName="PartnerFundRequest"
                                                       instanceId="activityId" helpText="{!$Label.c.Core_MDF_Activity_Activity_Name_Help}"
                                                       listIconSVGPath="/resource/Core_MDF_SLDS262/icons/standard-sprite/svg/symbols.svg#client"
                                                       listIconClass="slds-icon-standard-user" searchString="{!v.activitySearchString}"
                                                       returnFields="Title,Core_MDF_Activity_Number__c" required="true"
                                                       filterCriteria="{!'(Title LIKE \'%' + v.activitySearchString + '%\' OR Core_MDF_Activity_Number__c LIKE \'%' + v.activitySearchString + '%\') AND ChannelPartner.Core_MDF_Active_Ind__c=true AND ' + v.activitySearchCriteria + ' AND RecordType.DeveloperName = \'' + v.activityRecordTypeDevName + '\'' }" />
                    
                </aura:set>
            </aura:if>
        </div>
        
        <aura:if isTrue="{!v.isUserClaimCaseReviewerOrManager}">
            <!--When claim is in Edit and While Create if Acty id is null-->
            <aura:if isTrue="{!or(v.isClaimEdit ,(empty(v.simpleNewClaim.RequestId)))}">
                <div class="slds-col slds-size_1-of-2 slds-p-around_small">
                    <lightning:input aura:id="ActIdEdit" name="EscalationIdEdit" label="{!$Label.c.Core_MDF_EscalationId}"
                                     value="{!v.escalationNoSearchString}" disabled="true" />
                </div>
                <div class="slds-col slds-size_1-of-2 slds-p-around_small">
                    <lightning:input type="checkbox" label="{!$Label.c.Core_MDF_To_Be_Audited}"
                                     checked="{!v.simpleNewClaim.Core_MDF_To_Be_Audited_Ind__c}"
                                     name="{!$Label.c.Core_MDF_To_Be_Audited}" aura:id="toBeAudited" 
                                     title="{!$Label.c.Core_MDF_Straight_to_Pay_Help}"
                                     style=" padding-top: 30px;"
                                     disabled="{!v.StrightToPayDisabled}"
                                     class="slds-p-vertical_small"/>                                    
                    
                </div>
                <aura:set attribute="else">
                    <div class="slds-col slds-size_1-of-2 slds-p-around_small">
                        <c:Core_MDF_LightningSObjectLookUp aura:id="escalationId" label="{!$Label.c.Core_MDF_EscalationId}"
                                                           pluralLabel="{!$Label.c.Core_MDF_EscalationId}" sObjectAPIName="Core_MDF_Escalation__c"
                                                           instanceId="escalationId" helpText="{!$Label.c.Core_MDF_EscalationId_Help}"
                                                           listIconSVGPath="/resource/Core_MDF_SLDS262/icons/standard-sprite/svg/symbols.svg#client"
                                                           listIconClass="slds-icon-standard-user" searchString="{!v.escalationNoSearchString}"
                                                           returnFields="Core_MDF_Escalation_Name_txt__c,Name,Core_MDF_Total_Dollar_Impact_amt__c"
                                                           filterCriteria="{!'(Name LIKE \'%' + v.escalationNoSearchString + '%\' OR Core_MDF_Escalation_Name_txt__c LIKE \'%' + v.escalationNoSearchString + '%\') AND Core_MDF_Co_Marketing_Activity_id__c = \'' + v.simpleNewClaim.RequestId + '\' AND Core_MDF_Escalation_Status_nm__c = \'Approved\''}" />
                    </div>
                    <div class="slds-col slds-size_1-of-2 slds-p-around_small">
                        <lightning:input type="checkbox" label="{!$Label.c.Core_MDF_To_Be_Audited}"
                                         checked ="{!v.simpleNewClaim.Core_MDF_To_Be_Audited_Ind__c}"
                                         name = "{!$Label.c.Core_MDF_To_Be_Audited}" aura:id="toBeAudited" 
                                         title="{!$Label.c.Core_MDF_Straight_to_Pay_Help}"
                                         style = " padding-top: 30px;"/>
                    </div>
                </aura:set>
            </aura:if> 
        </aura:if>
        
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="ActAccountCompany" name="Core_MDF_AccountCompany__c" label="{!$Label.c.Core_MDF_AccountCompany}"
                             value="{!v.simpleNewClaim.Core_MDF_AccountCompany__c}" disabled="true" title="{!$Label.c.Core_MDF_Account_Company_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="ActAccountNode" name="ChannelPartner" label="{!$Label.c.Core_MDF_ChannelPartner}"
                             value="{!v.simpleNewClaim.ChannelPartner}" disabled="true" title="{!$Label.c.Core_MDF_Account_Node_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:select value="{!v.simpleNewClaim.Core_MDF_Country_Location_nm__c}" aura:id="ActCountryLocation" name="Core_MDF_Country_Location_nm__c"
                              label="{!$Label.c.Core_MDF_CountryLocation}" required="true" title="{!$Label.c.Core_MDF_Country_Help}">                                    
                <!-- cloned & Edit changes-->
                <aura:if isTrue="{!or((and(empty(v.simpleNewClaim.Id),!v.isCloneClaim,!v.isClaimCountryAvailInAct)) , !v.isClaimCountryAvailInAct)}">
                    <option value="">{!$Label.c.Core_MDF_Select}</option>
                </aura:if>
                <aura:iteration items="{!v.countryList}"  var="item">
                    <option value="{!item.value}" selected="{!item.selected}"> 
                        {!item.value} 
                    </option>
                </aura:iteration>
            </lightning:select>
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="ActReimbursementPer" name="Core_MDF_Reimbursement_Percent__c"
                             label="{!$Label.c.Core_MDF_Reimbursement_Percent}" value="{!v.simpleNewClaim.Core_MDF_Reimbursement_Percent__c}"
                             disabled="true" title="{!$Label.c.Core_MDF_Reimbursement_Percent_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="ActCategory" name="Core_MDF_Activity_Category__c" label="{!$Label.c.Core_MDF_ActivityCategory}"
                             value="{!v.simpleNewClaim.Core_MDF_Activity_Category__c}" disabled="true" title="{!$Label.c.Core_MDF_Act_Category_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="ActTypes" name="Core_MDF_Activity_Types__c" label="{!$Label.c.Core_MDF_Activity_Types}"
                             value="{!v.simpleNewClaim.Core_MDF_Activity_Types__c}" disabled="true" title="{!$Label.c.Core_MDF_Act_Type_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input type="date" aura:id="ActStartDate" name="Core_MDF_Activity_Start_Date__c"
                             label="{!$Label.c.Core_MDF_Activity_Start_Date}" value="{!v.simpleNewClaim.Core_MDF_Activity_Start_Date__c}"
                             disabled="true" title="{!$Label.c.Core_MDF_Act_Start_Date_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input type="date" aura:id="ActEndDate" name="Core_MDF_Activity_End_Date__c"
                             label="{!$Label.c.Core_MDF_Activity_End_Date}" value="{!v.simpleNewClaim.Core_MDF_Activity_End_Date__c}"
                             disabled="true" title="{!$Label.c.Core_MDF_Act_End_Date_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="ActBrands" name="Core_MDF_Brand__c" label="{!$Label.c.Core_MDF_Brands}"
                             value="{!v.simpleNewClaim.Core_MDF_Brand__c}" disabled="true" title="{!$Label.c.Core_MDF_Act_Brand_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="ActTargetAudiance" name="Core_MDF_Target_Audience__c" label="{!$Label.c.Core_MDF_TargetAudience}"
                             value="{!v.simpleNewClaim.Core_MDF_Target_Audience__c}" disabled="true" title="{!$Label.c.Core_MDF_Act_Target_Aud_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="claimActStartDate" type="Date" name="Core_MDF_Actual_Activity_Start_Run_Date__c"
                             label="{!$Label.c.Core_MDF_Actual_Activity_Start_Run_Date}" required="true" value="{!v.simpleNewClaim.Core_MDF_Ad_Run_Start_Date__c}"
                             title="{!$Label.c.Core_MDF_Ad_Run_Start_Date_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="claimActEndDate" type="Date" name="Core_MDF_Actual_Activity_End_Run_Date__c"
                             label="{!$Label.c.Core_MDF_Actual_Activity_End_Run_Date}" required="true" value="{!v.simpleNewClaim.Core_MDF_Ad_Run_End_Date__c}"
                             title="{!$Label.c.Core_MDF_Ad_Run_End_Date_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="claimMediaVehicle" name="Core_MDF_Media_Vehicle__c" label="{!$Label.c.Core_MDF_Media_Vehicle}"
                             required="true" maxlength= "255" value="{!v.simpleNewClaim.Core_MDF_Media_Vehicle__c}" title="{!$Label.c.Core_MDF_Media_Vehicle_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:select value="{!v.simpleNewClaim.Core_MDF_Bank__c}" aura:id="claimBank" name="Core_MDF_Bank__c"
                              label="{!$Label.c.Core_MDF_Bank}" required="true" title="{!$Label.c.Core_MDF_Bank_Help}">                                    
                <!-- cloned & Edit changes-->
                <aura:if isTrue="{!or(and(empty(v.simpleNewClaim.Id),!v.isCloneClaim ),!v.isBankMappedWithAcnt)}">
                    <option value="">{!$Label.c.Core_MDF_Select}</option>
                </aura:if>
                <aura:iteration items="{!v.bankObjectList}" var="item">
                    <option value="{!item.value.Core_MDF_Bank__r.Id}" selected="{!item.selected}">
                        {!item.value.Core_MDF_Bank__r.Name} -
                        {!item.value.Core_MDF_Bank__r.Core_MDF_Bank_Alias_Name__c} -
                        {!item.value.Core_MDF_Bank__r.Core_MDF_Bank_Status__c} 
                    </option>
                </aura:iteration>
            </lightning:select>
        </div>
        <aura:if isTrue="{!or(v.recordtypeDeveloperName == $Label.c.Core_MDF_Claim_SPCF_Program,v.activityRecordTypeDevName == $Label.c.Core_MDF_PFR_SPCF)}">
            <div class="slds-col slds-size_1-of-2 slds-p-around_small">
                <lightning:input aura:id="claimNoOfImpressions" name="Core_MDF_NoOfImpressions_Nbr__c" value="{!v.simpleNewClaim.Core_MDF_NoOfImpressions_Nbr__c}"
                                 label="{!$Label.c.Core_MDF_NoOfImpressions}" required="true" title="{!$Label.c.Core_MDF_NoOfImpressions_Help}" type="number" min="0"/>
            </div>
            <div class="slds-col slds-size_1-of-2 slds-p-around_small">
                <lightning:input aura:id="claimNoOfEngagements" name="Core_MDF_NoOfEngagements_Nbr__c" value="{!v.simpleNewClaim.Core_MDF_NoOfEngagements_Nbr__c}"
                                 label="{!$Label.c.Core_MDF_NoOfEngagements}" required="true" title="{!$Label.c.Core_MDF_NoOfEngagements_Help}" type="number" min="0"/>
            </div>
            <div class="slds-col slds-size_1-of-2 slds-p-around_small">
                <lightning:input aura:id="claimNoOfLeads" name="Core_MDF_NoOfLeads_Nbr__c" value="{!v.simpleNewClaim.Core_MDF_No_of_Leads_nbr__c}"
                                 label="{!$Label.c.Core_MDF_NoOfLeads}" required="true" title="{!$Label.c.Core_MDF_NoOfLeads_Help}" type="number" min="0"/>
            </div>
            <div class="slds-col slds-size_1-of-2 slds-p-around_small">
                <lightning:input aura:id="claimNoOfTrialActivations" name="Core_MDF_NoOfTrialActivations_Nbr__c" value="{!v.simpleNewClaim.Core_MDF_NoOfTrialActivations_Nbr__c}"
                                 label="{!$Label.c.Core_MDF_NoOfTrialActivations}" required="true" title="{!$Label.c.Core_MDF_NoOfTrialActivations_Help}" type="number" min="0"/>
            </div>
        </aura:if>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small"> <!--slds-p-left_medium-->
            <lightning:input aura:id="claimInvoiceDate" type="Date" name="Core_MDF_Invoice_Date__c"
                             label="{!$Label.c.Core_MDF_Invoice_Date}" required="true" value="{!v.simpleNewClaim.Core_MDF_Invoice_Date__c}"
                             title="{!$Label.c.Core_MDF_Invoice_Date_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="claimInvoiceNo" name="Core_MDF_Invoice_Number__c" label="{!$Label.c.Core_MDF_Invoice_Number}"
                             required="true" maxlength= "255" value="{!v.simpleNewClaim.Core_MDF_Invoice_Number__c}" title="{!$Label.c.Core_MDF_Invoice_Number_Help}" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:select value="{!v.simpleNewClaim.Core_MDF_Currency__c}" aura:id="claimCurrency"
                              name="Core_MDF_Currency__c" label="{!$Label.c.Core_MDF_Core_MDF_Currency}" required="true"
                              title="{!$Label.c.Core_MDF_Invoice_Receipt_Currency_Help}">                                    
                <!--Clone & Edit changes-->
                <aura:if isTrue="{!(and(empty(v.simpleNewClaim.Id),!v.isCloneClaim ))}">
                    <option value="">{!$Label.c.Core_MDF_Select}</option>
                    <aura:set attribute="else">
                        <option value="{!v.simpleNewClaim.Core_MDF_Currency__c}">{!v.simpleNewClaim.Currency_Label}</option>
                    </aura:set>
                </aura:if>
                <aura:iteration items="{!v.currList}" var="item" indexVar="key">
                    <option value="{!item.key}">
                        {!item.value}
                    </option>
                </aura:iteration>
            </lightning:select>
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input type="number" aura:id="claimInvoiceAmntLocal" name="Core_MDF_Total_Invoice_Amount_Local__c"
                             label="{!$Label.c.Core_MDF_Total_Invoice_Amount_Local}" required="true" value="{!v.simpleNewClaim.Core_MDF_Total_Invoice_Amount_Local__c}"
                             title="{!$Label.c.Core_MDF_Total_Invoice_Amount_Local_Help}" min="0" step="any"/>
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="claimOtherCostsNotReimbursableLocal" type="number" name="Core_MDF_OtherCostsnotReimbursable_Local__c"
                             label="{!$Label.c.Core_MDF_OtherCostsnotReimbursable_Local}" required="true" value="{!v.simpleNewClaim.Core_MDF_OtherCostsnotReimbursable_Local__c}"
                             title="{!$Label.c.Core_MDF_Other_Costs_not_Reimbursable_Local_Help}" min="0" step="any" />
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:input aura:id="claimTaxesLocal" type="number" name="Core_MDF_Taxes_Local__c"
                             label="{!$Label.c.Core_MDF_Taxes_Local}" required="true" value="{!v.simpleNewClaim.Core_MDF_Taxes_Local__c}"
                             title="{!$Label.c.Core_MDF_Taxes_Local_Help}" min="0" step="any"/>
        </div>
        <div class="slds-col slds-size_1-of-2 slds-p-around_small">
            <lightning:textarea aura:id="claimComments" name="Core_MDF_Claim_Comments__c" value="{!v.simpleNewClaim.Core_MDF_Claim_Comments__c}"
                                label="{!$Label.c.Core_MDF_Description}" maxlength="255" title="{!$Label.c.Core_MDF_Claim_Comments_Help}" />
        </div>
    </div>
    <!--Duplicate Check Modal-->
    <aura:if isTrue="{!v.isDuplicate}">
        <div class="demo-only">
            <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-describedby="modal-content-id-1"
                     class="slds-modal slds-fade-in-open">
                <div class="slds-modal__container width">
                    <header class="slds-modal__header">
                        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!$Label.c.Core_MDF_DuplicateConfHeader}</h2>
                    </header>
                    <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                        <p>{!$Label.c.Core_MDF_DuplicateConfText}</p>
                        <div>
                            <aura:iteration items="{!v.duplicateClaimList}" var="item">
                                <aura:if isTrue="{!v.isPortal}">
                                    <a href="{!'../'+item.Id}" target="_blank" class="slds-p-left_xx-small slds-text-color_success">{!item.Title}</a>
                                    <aura:set attribute="else">
                                        <a href="{!'/'+item.Id}" target="_blank" class="slds-p-left_xx-small slds-text-color_success">{!item.Title}</a>
                                    </aura:set>
                                </aura:if>
                            </aura:iteration>
                        </div>
                    </div>
                    <footer class="slds-modal__footer">
                        <button class="slds-button slds-button_neutral" onclick="{!c.closeDuplicateModel}">{!$Label.c.Core_MDF_Cancel_Button}</button>
                        <button class="slds-button slds-button_brand" disabled="{!v.isOkDisabled}" onclick="{!c.handleDuplicateClick}">{!$Label.c.Core_MDF_Ok_Button}</button>
                    </footer>
                </div>
            </section>
            <div class="slds-backdrop slds-backdrop_open"></div>
        </div>
    </aura:if>
</aura:component>