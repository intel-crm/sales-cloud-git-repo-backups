<aura:component controller="PMP_SearchMarketplaceController" extends="c:MarketplaceRedux" implements="forceCommunity:availableForAllPageTypes,force:hasRecordId,flexipage:availableForRecordHome"><!-- Controller added by Nikhil -->
    <aura:attribute name="storeName" type="string" default="Settings" /> 
    <aura:attribute name="loading" type="boolean" default="true" />
    <aura:attribute name="isPartnerHasValue" type="Boolean" default="false" />
     <aura:attribute name="companyResourceHasValue" type="Boolean" default="false" />
    <aura:attribute name="partnerDetailsHasValue" type="Boolean" default="false" />
    <aura:attribute name="partner" type="object" />
     <aura:attribute name="companyInformation" type="object" />
      <aura:attribute name="companyResources" type="object[]" />
    <aura:attribute name="leadSettings" type="object" />
    <aura:attribute name="tagline" type="string" />
    <aura:attribute name="introSection" type="string" required="true" default=""/>
    <aura:attribute name="moreSection" type="string" required="true" default=""/>
    <aura:attribute name="mobileListing" type="object[]" />
    <aura:attribute name="companyArticles" type="object[]" />
    <aura:attribute name="userDetails" type="object" />
    <aura:attribute name="dataObj" type="Object"/>
    <aura:attribute name="languageLabel" type="String" default="" />
    <aura:attribute name="onLeadGenDataUpdate" type="object" />
    <aura:attribute name="displayType" type="string" default="partner" />
    <!--changes as a part of US613071[Merging]-->
    <aura:attribute name="partnerType" type="string" default="Enhanced" description="Can be 'basic', 'create-profile','create-storefront','upgraded-profile','upgraded-storefront','marketing'" />
    <aura:attribute name="editMode" type="boolean" default="false" description="Show pencil icons and shows edit tabset in modal" />
    <!--<aura:attribute name="publishedStatus" type="string" default="Published" description="Can be 'none', 'submitted-under-review', 'submitted-needs-edits', 'published'" />-->
    <aura:attribute name="publishedStatus" type="string"/>
    
    <aura:attribute name="isIntelAdmin" type="boolean" default="false" />
    <aura:attribute name="isSamePartnerUser" type="boolean" default="false" />
    <aura:attribute name="hasLeadGenAccess" type="boolean" default="false" />
    <aura:attribute name="hasAccess" type="boolean" default="false" />
    <aura:attribute name="isGuest" type="boolean" default="false" />
    <aura:attribute name="isLocked" type="boolean" default="false" />
    <!-- IPA2.0 + US TWC4497-1631 -->
    <aura:attribute name="showManageOffering" type="boolean" default="false" />
    <aura:attribute name="showEditPencil" type="boolean" default="false" />
    <aura:attribute name="showLeadGeneration" type="boolean" default="false" />
    <aura:attribute name="currentStatus" type="String"/>
    <aura:attribute name="isUpdateRequired" type="boolean" default="false" /> 
    <aura:attribute name="statusUpdateDate" type="String"/>
    <aura:attribute name="initialUpdateDate" type="String"/>
    <aura:attribute name="publishedDate" type="String"/>
    <aura:attribute name="onActiveTab" type="object"/>
    <aura:attribute name="id" type="string"/>
    <aura:attribute name="recordId" type="string"/>
    <aura:attribute name="title" type="string"/>
    <aura:attribute name="partnername" type="string"/>
    <aura:attribute name="viewalllabel" type="String" />
    <aura:attribute name="showContactPartner" type="boolean" default="false"/>
    <aura:attribute name="mdaId" type="String" default="" />
    <aura:attribute name="showCompanyResourceAndArticle" type="boolean" default="false"/>
    <aura:attribute name="showCompanyResourceAndArticleforEnhanced" type="boolean" default="false"/>
    <aura:attribute name="showMoreSection" type="boolean" default="false"/>
    
    <!--Added by Subash for guided setup and a welcome note US620593-->
    <aura:attribute name="isMarkettingSpecialist" type="boolean" default="false"/>
    <aura:attribute name="isPartnerAdmin" type="boolean" default="false"/>
    <aura:attribute name="showEnhancedPopup" type="boolean" default="false"/>
    <!-- IPA2.0 + US TWC4497-1631 -->
    <!-- <aura:attribute name="isOfferingEditor" type="boolean" default="false"/> -->
    <aura:attribute name="isEnhancedUser" type="boolean" default="false"/>
    <lightning:navigation aura:id="navLink"/>    
    <!--End-->
    <!--For Event Banner US749105 -->
    <aura:attribute name="showEventBanner" type="boolean" default="false"/>
    
   <!-- Added to check poupulating the Dynamic customlabel  values on notifications-->
    <aura:attribute name="dynSave" type="String" default="{!$Label.c.PMP_Edit_Storefront_Notification_Save}" />
    <aura:attribute name="dynUpdate" type="String" default="{!$Label.c.PMP_Edit_Storefront_Notification_Update}" />
    <aura:attribute name="dynRejected" type="String" default="{!$Label.c.PMP_Edit_Storefront_Notification_Rejected}" />
    <!-- End -->
    
    <aura:attribute name="isLdrOeEmployee" type="boolean" default="true"/>
    <aura:attribute name="showScrapeBanner" type="Boolean" default="false"/>
    <!--AI Scrape Banner-->
    <aura:if isTrue="{!v.showScrapeBanner}">
    <div class="slds-notify slds-text-align_center">
     <span class="slds-text-heading_small" style="font-weight: bold; color: #080707;">
         {!$Label.c.PMP_StorefrontAIBanner}                                                        
    </span>
        </div>
         </aura:if>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <aura:if isTrue="{!v.loading}">
        <lightning:spinner class="mainSpinner" alternativeText="..." />
    </aura:if>
    
    <!-- styleguide editstorefront modal open change listener ONLY do not use in integration -->
    <aura:attribute name="editStorefrontModalOpen" type="boolean" default="false" description="Internal set from controller data" />
    <aura:handler name="change" value="{!v.editStorefrontModalOpen}" action="{!c.handleEditStorefrontIsModalClose}" />
    
    <!--Storefront Notifications for different status -->
    <aura:if isTrue="{!v.hasAccess}">
        <aura:if isTrue="{!v.currentStatus == 'Admin Review'}"> 
            <!-- after update required edit -->
            <aura:if isTrue="{!not(v.isUpdateRequired)}">    
            <span><c:MarketplaceStorefrontNotificationsBanner type="lock"    
                                                          message="{!$Label.c.PMP_Edit_Storefront_Notification_Profile_Submission}"    
                                                          openEditStorefront="true"         
                                                          editStorefrontStep="0" 
                                                          textLinkLabel="{!$Label.c.PMP_Edit_Storefront_your_more_submission}">         
            <c:IntelLink class="notificationLink" url="javascript:void(0)"></c:IntelLink>              
            </c:MarketplaceStorefrontNotificationsBanner></span>  
        </aura:if>
        <aura:if isTrue="{!v.isUpdateRequired}">
            <!--<span><c:MarketplaceStorefrontNotificationsBanner type="save"
                                                              message="{! v.dynSave+' ' +  v.initialUpdateDate+'.'}"/></span>-->
            <span><c:MarketplaceStorefrontNotificationsBanner type="lock"
                                                              message="{!$Label.c.PMP_Edit_Storefront_Notification_Lock}"
                                                              openEditStorefront="true"         
                                                              editStorefrontStep="0" 
                                                              textLinkLabel="{!$Label.c.PMP_Edit_Storefront_your_more_submission}">
            <c:IntelLink class="notificationLink" url="javascript:void(0)"></c:IntelLink>              
            </c:MarketplaceStorefrontNotificationsBanner>
            </span>
        </aura:if>
    </aura:if> 
        <aura:if isTrue="{!and(v.publishedStatus == 'Draft', v.currentStatus == 'Update Required')}">       
        <span><c:MarketplaceStorefrontNotificationsBanner type="redo"
                                                              message="{!$Label.c.PMP_Edit_Storefront_Notification_Redo}"
                                                              openEditStorefront="true"
                                                              editStorefrontStep="0"
                                                              textLinkLabel="{!$Label.c.PMP_Edit_Storefront_Update_Now}">
            <c:IntelLink class="notificationLink" url="javascript:void(0)"></c:IntelLink>              
            </c:MarketplaceStorefrontNotificationsBanner></span>  
        </aura:if>
       <!--  <aura:if isTrue="{!not(v.currentStatus == 'Draft')}"> -->
       
        
        <!--<aura:if isTrue="{!and(v.partner,v.currentStatus == 'Update Required')}">
         
          <span><c:MarketplaceStorefrontNotificationsBanner type="save"
                                                              message="{!v.dynSave+' ' +  v.initialUpdateDate+'.'}" /></span>
           <span><c:MarketplaceStorefrontNotificationsBanner type="lock"
                                                              message="{!$Label.c.PMP_Edit_Storefront_Notification_Lock}" /></span>
            <span><c:MarketplaceStorefrontNotificationsBanner type="redo"
                                                              message="{!$Label.c.PMP_Edit_Storefront_Notification_Redo}"
                                                              openEditStorefront="true"
                                                              editStorefrontStep="0"
                                                              textLinkLabel="{!$Label.c.PMP_Edit_Storefront_Update_Now}"/></span>
        </aura:if>-->
        
        <!--<aura:if isTrue="{!and(v.isUpdateRequired,v.currentStatus == 'Admin Review')}">
		    <span><c:MarketplaceStorefrontNotificationsBanner type="save"
                                                              message="{!v.dynSave+' ' +  v.initialUpdateDate+'.'}" /></span>
            <span><c:MarketplaceStorefrontNotificationsBanner type="lock"
                                                              message="{!$Label.c.PMP_Edit_Storefront_Notification_Lock}" />               
            </span>
           <span><c:MarketplaceStorefrontNotificationsBanner type="redo"
                                                          message="{!$Label.c.PMP_Edit_Storefront_Notification_Redo}"/></span>            
            <span><c:MarketplaceStorefrontNotificationsBanner type="save" 
                                                message="{!v.dynUpdate+' '+ v.statusUpdateDate+'.'}" /> </span>
        </aura:if>-->
         <!--New Notifications- Approved & Rejected-->
         <aura:if isTrue="{!v.currentStatus == 'Approved'}">
            <span><c:MarketplaceStorefrontNotificationsBanner type="save"
                                                              message="{! $Label.c.PMP_Edit_Storefront_Notification_Published+' ' +  v.publishedDate+', '+ $Label.c.PMP_Edit_Storefront_Notification_LastEdited+' ' +v.initialUpdateDate+'.'}" /></span>
         </aura:if>
         <aura:if isTrue="{!v.currentStatus == 'Rejected'}">
            <span><c:MarketplaceStorefrontNotificationsBanner type="save"
                                                              message="{!v.dynRejected+' ' +  v.statusUpdateDate+'.'}" /></span>
         </aura:if>
        <!--End of New Notifications-->
       </aura:if>
         <aura:if isTrue="{!v.currentStatus == 'Draft'}">
            <span><c:MarketplaceStorefrontNotificationsBanner type="save"
                                                              message="Your storefront is in draft state" /></span>
         </aura:if>
    <!-- </aura:if> -->
    <!--Storefront Notifications for different status End -->
     <!--Storefront Event Banner -->
    <aura:if isTrue="{!v.showEventBanner}">
    	<c:ipaBannerCarousel/>
    </aura:if>
    <!-- event banner end -->
    
    <c:MarketplaceEditStorefrontForm isOpen="false" currentStep="0" partnerId="{!v.recordId}" isIntelAdmin ="{!v.isIntelAdmin}"/>
    
   
     
             
    <!-- RF has given LWC version for IntelTextBlock named psMpTextBlock and will need a LWC merge -->
    
    <!-- Basic profile section starts -->
     <!-- <c:psMpStartModal isProfileAdmin="{!true}" 
        isOpen="{!true}"
        buttonEventParams="0"              
        onclickbutton="{!c.handleOpenStorefrontForm}"
        ></c:psMpStartModal> -->
  <aura:if isTrue="{!v.partnerType == 'BFTMKTPLBC'}">
       <!-- Create Profile Type - ADMIN -->
   <!--   <aura:if isTrue="{!v.partnerType == 'upgraded-profile'}">-->
      <!-- US613694 changes start -->
     <!--   <c:psMpStartModal  
        buttonEventParams="0" 
        onclickbutton="{!c.handleOpenStorefrontForm}"></c:psMpStartModal>-->
      
      
    <!--  </aura:if> -->
  
                <!-- Create Profile Type - MARKETING -->
      <!-- <aura:if isTrue="{!v.partnerType == 'marketing'}"> -->
      
      <aura:if isTrue="{!and(v.hasAccess == true,v.currentStatus == 'Draft')}">
       
       <aura:if isTrue="{!v.isMarkettingSpecialist == true}">
                                                
                <c:psMpStartModal isProfileMarketingSpecialist="{!true}"
                isOpen="{!true}" 
                buttonEventParams="0" 
                onclickbutton="{!c.handleOpenStorefrontForm1}"></c:psMpStartModal>
               
          </aura:if>
         <aura:if isTrue="{!v.isPartnerAdmin == true}"> 
              <c:psMpStartModal isProfileAdmin="{!true}" 
            isOpen="{!true}"
            buttonEventParams="0"              
            onclickbutton="{!c.handleOpenStorefrontForm}"
            ></c:psMpStartModal>
      </aura:if>
     <!-- </aura:if> -->
      </aura:if> 
        <!-- If Section when the status is published -->
       <!--<aura:if isTrue="{!v.publishedStatus == 'Published'}">--> <!--need to comment this line for showing overview for all sections or close this if before lightning layout-->
       <aura:if isTrue="{!not(v.currentStatus == 'Draft')}">   
       <aura:if isTrue="{!v.appState.Settings.currentScreenSize == 'mobile'}">
                
                <aura:if isTrue="{!v.showContactPartner}">
                    <div class="slds-p-around_medium bg-charcoal slds-m-top_medium">
                        <c:MarketplaceContactPartner label="{!$Label.c.PMP_Contact_Partner}" isLoggedIn="{!!v.isGuest}"  dataObj="{!v.dataObj}" languagePreference="{!v.languageLabel}"   theme="mobile"/>                
                    </div>
                </aura:if>
                
            </aura:if> 
           <!--</aura:if>--> 
            <!--<div class="padding-desktop-top-large"> 
          <c:MarketplacePromotionCarousel class="padding-desktop-top-large padding-mobile-top-large" promotionData="{!v.partner.promotion}"/>
          Commented By Prabuddh, Since Promotion Carousel is not MVP       
      </div> -->
            <!-- below line is updated as part of the story US788273-->
            <lightning:layout class="{! v.showEventBanner ? 'slds-p-bottom_medium padding-top-small x-large' : 'slds-p-bottom_medium padding-top x-large'}" multipleRows="true">
                <lightning:layoutItem class="padding-mobile-around-small padding-desktop-right-small padding-desktop-vertical-small"
                                      size="12" mediumDeviceSize="9">
                    <!--<aura:if isTrue="{!or(v.loading, !v.partner)}">                                                  
                        <lightning:spinner class="mainSpinner" alternativeText="Loading..."/>                                                   
                    </aura:if> -->
                    <aura:if isTrue="{!v.isPartnerHasValue}"> 
                        <aura:if isTrue="{!v.appState.Settings.currentScreenSize == 'desktop'}">
                            <c:IntelStickyTabSet aura:id="isgtabs">
                               
                                <c:IntelStickyTab label="{!$Label.c.PMP_L3_Partner_Detail_Overview}" aura:id="StickyTab0">
                                    <h2 class="heading-28 slds-p-top_x-large slds-p-bottom_medium">{!$Label.c.PMP_L3_Partner_Detail_Overview}
                                        <c:MarketplaceEditPencilCmp currentStep="1" visible="{!v.showEditPencil}" partnerId = "{!v.recordId}" isLocked = "{!v.isLocked}"/>
                                    </h2>  
                                    
                                    <c:IntelTextBlock
                                                      class="slds-p-around_medium slds-m-bottom_large bg-white"
                                                      tagline="{!v.tagline}"
                                                      introSection="{!v.introSection}"
                                                      moreSection="{!v.moreSection}"
                                                      showMoreSection="{!v.showMoreSection}"
                                                      />
                                </c:IntelStickyTab>
                                
                                
                                <!--Added Company Resource-->
                                <aura:if isTrue="{!v.showCompanyResourceAndArticle}">
                                    <aura:if isTrue="{!v.appState.Settings.currentScreenSize == 'desktop'}">
                                       <aura:if isTrue="{!v.companyResourceHasValue}">
                                            <div class="whiteBg slds-m-bottom_large">
                                                <h3 class="heading-16 slds-p-vertical_medium slds-p-horizontal_medium">{!$Label.c.PMP_Edit_Storefront_Company_Resources}
                                                    <c:MarketplaceEditPencilCmp currentStep="3" visible="{!v.showEditPencil}" partnerId = "{!v.recordId}" isLocked = "{!v.isLocked}"/>
                                                </h3>
                                                
                                                <c:MarketplaceResourceList Header="{!$Label.c.PMP_Company_Resources}" resouceList="{!v.companyResources}" mdaId="{!v.mdaId}"/>
                                                
                                            </div>
                                        </aura:if>    
                                        <aura:set attribute="else">
                                            <aura:if isTrue="{!v.companyResourceHasValue}">
                                                <c:IntelHubSpoke
                                                                 headline="{!$Label.c.PMP_Edit_Storefront_Company_Resources}"
                                                                 class="slds-m-bottom_medium"
                                                                 >
                                                    <div class="slds-p-around_medium">
                                                        
                                                        <c:MarketplaceResourceList Header="{!$Label.c.PMP_Company_Resources}" resouceList="{!v.companyResources}" mdaId="{!v.mdaId}"/>
                                                        
                                                    </div>
                                                </c:IntelHubSpoke>
                                            </aura:if>    
                                        </aura:set>
                                        
                                    </aura:if>
                                    
                                    
                                </aura:if>
                                
                                <aura:iteration items="{!v.partner.categories}" var="category" indexVar="i" >
                                    <c:IntelStickyTab label="{!category.label}" aura:id="StickyTab1">
                                        <h2 class="heading-28 slds-p-top_x-large slds-p-bottom_medium">{!category.label}
                                            <!-- IPA2.0 + US TWC4497-1631 -->
                                            <!-- <aura:if isTrue="{!v.showManageOffering}">
                                                <c:IntelLink class="manageOfferingLink" objectApiName="PMP_Partner_Offering__c">
                                                    <c:IntelButton class="inline">{!$Label.c.PMP_Manage_Offerings}</c:IntelButton>
                                                </c:IntelLink>
                                            </aura:if> -->
                                        </h2>
                                        
                                        <div class="">
                                            <c:MarketplaceCardList results="{!category.entries}"  displayByPartner="false" displayAttributes="true" showAddToCompare="true" displayType="list" cardType="product" displayCardDescription="true"/>
                                        </div>
                                        <div class="sectionFooter slds-text-align_right">
                                            <!--<a href="{!category.viewAllLinkUrl}">{!category.viewAllLabel + '&nbsp;('+category.count+')'}<lightning:icon iconName="utility:chevronright"
                                                                                                                                                class="cursor icon-xx-small slds-m-left_xx-small link-caret"
                                                                                                                                                size="x-small"/></a> -->
                                            <c:IntelLink objectApiName="PMP_Category__c" recordId="{!category.searchParams.cat}" isFilterApplied = "true" filterName="PartnerA-Z" filterId = "{!v.recordId}">{!format($Label.c.PMP_All_Category_Results,category.viewAllLabel,category.label,category.count)}<lightning:icon iconName="utility:chevronright"
                                                                                                                                                                                                                                class="cursor icon-xx-small slds-m-left_xx-small link-caret"
                                                                                                                                                                                                                                size="x-small"/></c:IntelLink>
                                        </div>
                                    </c:IntelStickyTab>
                                </aura:iteration>
                                
                            </c:IntelStickyTabSet>
                            
                            <aura:set attribute="else">
                                 <p>overview332</p>
                                <h2 class="heading-28 slds-p-top_x-large slds-p-bottom_medium">{!$Label.c.PMP_L3_Partner_Detail_Overview}
                                    <c:MarketplaceEditPencilCmp currentStep="1" visible="{!v.showEditPencil}" partnerId = "{!v.recordId}" isLocked = "{!v.isLocked}"/>
                                </h2>
                                
                                <c:IntelTextBlock
                                                  class="slds-p-around_medium slds-m-bottom_large bg-white"
                                                  tagline="{!v.tagline}"
                                                  introSection="{!v.introSection}"
                                                  moreSection="{!v.moreSection}"
                                                  showMoreSection="{!v.showMoreSection}"
                                                  />
                                <div class="slds-p-top_x-small slds-p-bottom_large">
                                    <!-- IPA2.0 + US TWC4497-1631 -->
                                    <!-- <aura:if isTrue="{!v.showManageOffering}">
                                        <c:IntelLink class="manageOfferingFullWidth" objectApiName="PMP_Partner_Offering__c">
                                            <c:IntelButton class="fullWidth">{!$Label.c.PMP_Manage_Offerings}</c:IntelButton>
                                        </c:IntelLink>
                                    </aura:if> -->
                                </div>
                                <c:MarketplaceSimpleCardList  data="{!v.mobileListing}" />
                            </aura:set>
                            
                        </aura:if>
                        
                    </aura:if>
                    
                </lightning:layoutItem>
                
                <lightning:layoutItem class="padding-desktop-right-none" padding="around-small" size="12" mediumDeviceSize="3"><!--Merge Changes[11/13]-->
                    <aura:if isTrue="{! !empty(v.partner.partnerDetails)}">
                               <!-- Updated the padding from slds-m-bottom_small to slds-m-bottom_large as part of the US-US788273-->
                            <div class="slds-m-bottom_large">
                                <div class="whiteBg card-heading-padding">
                                    <h3 class="heading-16">{!$Label.c.PMP_CompanyInformation}</h3>
                                </div>
                                <!--Added title as false to not show in storefront by Nikhil -->
                              <c:MarketplacePartnerCard
                                                              minHeight="0"
                                                              id="{! v.recordId}"
                                                              displayType="card"
                                                              imageUrl="{! v.partner.partnerDetails.imageUrl}"
                                                              title="false"   
                                                              description="{! v.partner.partnerDetails.description}"
                                                              attributes="{! v.partner.partnerDetails.attributes}"
                                                              dataObj="{! v.partner.partnerDetails}"
                                                              displayContactPartner="false"                                                             
                                                              displayAttributes="true"
                                                              editEnabled="{!v.showEditPencil}"
                                                              mdaId="{!v.mdaId}"
                                                              enableAttributeCountLimit="false"
                                                              
                                                              />
                              
                             <!--  <c:MarketplacePartnerCard
                                                          minHeight="0"
                                                          id="{!v.recordId}"
                                                          displayType="card"
                                                          imageUrl="{!v.dataObj.imageUrl}"
                                                          title="false"   
                                                          description="{!v.dataObj.description}"
                                                          attributes="{!v.dataObj.attributes}"
                                                          dataObj="{!v.dataObj}"
                                                          displayContactPartner="false"
                                                          displayAttributes="true"
                                                          editEnabled="{!v.showEditPencil}"
                                                          mdaId="{!v.mdaId}"
                                                          enableAttributeCountLimit="false"
                                                          />-->
                                


                            </div>
                        </aura:if>
                      <!--  <aura:if isTrue="{! or(v.showLeadGeneration, v.isIntelAdmin)}">                                                            
                            <aura:if isTrue="{!v.isSamePartnerUser}">
                                <c:MarketplaceLeadGenSettings partnerId="{!v.recordId}" hasAccess="{!v.hasLeadGenAccess}" />                                           
                            </aura:if>                                            
                        </aura:if>   --> 

						
                        <aura:if isTrue="{!v.partner}">
                        <aura:if isTrue="{!v.appState.Settings.currentScreenSize == 'desktop'}">
                            
                            <!--US519720 - Prabuddh , button implemented in the below block --> 
                            <aura:if isTrue="{!v.showContactPartner}">
                                <div class="slds-m-bottom_large">
                                    <c:MarketplaceContactPartner label="{!$Label.c.PMP_Contact_Partner}" isLoggedIn="{!!v.isGuest}"  dataObj="{!v.dataObj}" languagePreference="{!v.languageLabel}"   theme="large"/>                                  
                                </div>
                            </aura:if>
                            
                        </aura:if>
                        
                        
                        
                        <aura:if isTrue="{!v.showCompanyResourceAndArticleforEnhanced}">
                            <!--Added for Company Resource-->
                            <aura:if isTrue="{!v.appState.Settings.currentScreenSize == 'desktop'}">
                                <aura:if isTrue="{! !empty(v.partner.companyResources)}">
                                    <div class="whiteBg slds-m-bottom_large">
                                        <h3 class="heading-16 slds-p-vertical_medium slds-p-horizontal_medium">{!$Label.c.PMP_Edit_Storefront_Company_Resources}
                                            <c:MarketplaceEditPencilCmp currentStep="3" visible="{!v.showEditPencil}" partnerId = "{!v.recordId}" isLocked = "{!v.isLocked}"/>
                                        </h3>
                                        
                                        <c:MarketplaceResourceList Header="{!$Label.c.PMP_Company_Resources}" resouceList="{!v.partner.companyResources}" mdaId="{!v.mdaId}"/>
                                        
                                    </div>
                                </aura:if>    
                                <aura:set attribute="else">
                                    <aura:if isTrue="{!not(empty(v.partner.companyResources))}">
                                        <c:IntelHubSpoke
                                                         headline="{!$Label.c.PMP_Edit_Storefront_Company_Resources}"
                                                         class="slds-m-bottom_medium"
                                                         >
                                            <div class="slds-p-around_medium">
                                                
                                                <c:MarketplaceResourceList Header="{!$Label.c.PMP_Company_Resources}" resouceList="{!v.partner.companyResources}" mdaId="{!v.mdaId}"/>
                                                
                                            </div>
                                        </c:IntelHubSpoke>
                                    </aura:if>    
                                </aura:set>
                                
                            </aura:if>
                        </aura:if>
                        <!-- Added for Company Articles : Prabuddh (US365271) -->      
                        <aura:if isTrue="{!v.appState.Settings.currentScreenSize == 'desktop'}">
                            <aura:if isTrue="{!not(empty(v.companyArticles))}">
                                <div class="slds-m-bottom_large">
                                    <div class="whiteBg">
                                        <h3 class="heading-16 slds-p-vertical_medium slds-p-horizontal_medium">{!$Label.c.PMP_Company_Articles}</h3>                        
                                        <c:MarketplaceArticleList articleList="{!v.companyArticles}" mdaId="{!v.mdaId}" Header="{!$Label.c.PMP_Company_Articles}"/>
                                    </div>    
                                    <div class="sectionFooter slds-text-align_right">
                                        <a href="{!v.viewalllabel}" target="_blank">View All<lightning:icon iconName="utility:chevronright"
                                                                                                            class="cursor icon-xx-small slds-m-left_xxx-small link-caret" size="x-small" /></a>
                                    </div>
                                </div>
                            </aura:if>    
                            <aura:set attribute="else">
                                <aura:if isTrue="{!not(empty(v.companyArticles))}">
                                    <c:IntelHubSpoke
                                                     headline="{!$Label.c.PMP_Company_Articles}"
                                                     class="slds-m-bottom_medium"
                                                     >
                                        <div class="slds-p-around_medium">
                                            <c:MarketplaceArticleList articleList="{!v.companyArticles}" mdaId="{!v.mdaId}" Header="{!$Label.c.PMP_Company_Articles}"/>
                                        </div>
                                        <div class="slds-p-around_medium grayBg">
                                            <a href="{!$Label.c.PMP_ViewAll}">{!$Label.c.PMP_ViewAll}<lightning:icon iconName="utility:chevronright"
                                                                                                                     class="cursor icon-xx-small slds-m-left_xxx-small link-caret" size="x-small" /></a>
                                        </div>
                                    </c:IntelHubSpoke>
                                </aura:if>
                            </aura:set>
                            
                        </aura:if>
                        
                    </aura:if>    
                </lightning:layoutItem>
            </lightning:layout>
            <!--Else section when the status is draft -->
            <aura:set attribute="else">
                
                <!--Create Profile Type Desktop-->
                <lightning:layout class="slds-p-bottom_medium  padding-desktop-top-small " multipleRows="true">
                    <lightning:layoutItem class="padding-mobile-around-small padding-desktop-vertical-small padding-desktop-right-small mainContainer"
                                          size="12" mediumDeviceSize="9">
                        <aura:if isTrue="{!v.appState.Settings.currentScreenSize == 'desktop'}">
                            <!--<aura:if isTrue="{!v.loading}">
                                <lightning:spinner class="mainSpinner" alternativeText="..." />
                            </aura:if>
                            -->
                            <h2 class="heading-28 slds-p-bottom_medium">{!$Label.c.PMP_L3_Partner_Detail_Overview}</h2>
                            <div class="whiteBg slds-m-bottom_large">
                               <!--<aura:if isTrue="{!or(v.currentStatus == 'submitted-under-review', v.publishedStatus == 'submitted-needs-edits')}">-->
                               <aura:if isTrue="{!v.publishedStatus == 'Draft'}">
                                       <aura:if isTrue="{!v.isLdrOeEmployee==true}">
                                            <c:psMpSimpleContentCard  heading="" 
                                                                 imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}" 
                                                                 tagline="{!$Label.c.PMP_Storefront_DescribeYourCompany}"
                                                                 buttonAccessibilityLabel="{!$Label.c.PMP_Storefront_DescribeYourCompany}">
                                           </c:psMpSimpleContentCard>
                                       
                                        <aura:set attribute="else">
                                   <c:psMpSimpleContentCard  heading="" 
                                                                 imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}" 
                                                                 tagline="{!$Label.c.PMP_Storefront_DescribeYourCompany}"
                                                                 buttonAccessibilityLabel="{!$Label.c.PMP_Storefront_DescribeYourCompany}"
                                                                 buttonLabel="{!$Label.c.PMP_StartNow}" 
                                                                 buttonEventParams="1"
                     
                                                                 onclickbutton="{!c.handleOpenStorefrontForm1}"></c:psMpSimpleContentCard>
                                           </aura:set>
                                       </aura:if>

                                       
                                    <aura:set attribute="else">
                                            <c:psMpSimpleContentCard  heading="" 
                                                                 imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                                     tagline="{!$Label.c.PMP_ProfileBeingReviewed}" />
                                    </aura:set>
                                </aura:if>
                            </div>
                            <div class="whiteBg slds-m-bottom_large">
                                               <aura:if isTrue="{!v.publishedStatus == 'Draft'}">
                                    <aura:if isTrue="{!v.isLdrOeEmployee==true}">
                                         <c:psMpSimpleContentCard  heading="{!$Label.c.PMP_Edit_Storefront_Company_Resources}" 
                                                                 imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                                 tagline="{!$Label.c.PMP_Storefront_Add_Your_Company_Resources}" 
                                                                 buttonAccessibilityLabel="{!$Label.c.PMP_Storefront_Add_Your_Company_Resources}"
                                                                  ></c:psMpSimpleContentCard>
                                   <aura:set attribute="else">
                                         <c:psMpSimpleContentCard  heading="{!$Label.c.PMP_Edit_Storefront_Company_Resources}" 
                                                                 imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                                 tagline="{!$Label.c.PMP_Storefront_Add_Your_Company_Resources}" 
                                                                 buttonAccessibilityLabel="{!$Label.c.PMP_Storefront_Add_Your_Company_Resources}"
                                                                 buttonLabel="{!$Label.c.PMP_StartNow}" 
                                                                 buttonEventParams="3" 
                                                                 onclickbutton="{!c.handleOpenStorefrontForm1}"></c:psMpSimpleContentCard>
                                        </aura:set>
                                   </aura:if>
                                    <aura:set attribute="else">
                                      
                                          <c:psMpSimpleContentCard  heading="{!$Label.c.PMP_Edit_Storefront_Company_Resources}" 
                                                             imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                             tagline="{!$Label.c.PMP_CompanyResourcesBeingReviewed}" 
                                                             onclickbutton="{!c.handleOpenStorefrontForm1}"></c:psMpSimpleContentCard>
                                                                        
                                    </aura:set>
                 
                                
                               </aura:if>
                            </div>
                            <aura:set attribute="else">
                                 <p>overview573</p>
                                <h2 class="heading-28 slds-p-top_large slds-p-bottom_medium">{!$Label.c.PMP_L3_Partner_Detail_Overview}</h2>
                                <div class="whiteBg slds-m-bottom_large">
                                   <!-- <aura:if isTrue="{!or(v.publishedStatus == 'submitted-under-review', v.publishedStatus == 'submitted-needs-edits')}">-->
                                   <p>line 573{!v.publishedStatus}{!v.isLdrOeEmployee}</p>                
                                   <aura:if isTrue="{!v.publishedStatus == 'Draft'}">
                                                        <p>line 574{!v.publishedStatus}{!v.isLdrOeEmployee}</p>
                                         <aura:if isTrue="{!v.isLdrOeEmployee==true}">
                                              <c:psMpSimpleContentCard  heading="" 
                                                                     imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                                     tagline="{!$Label.c.PMP_Storefront_DescribeYourCompany}"
                                                                     buttonAccessibilityLabel="{!$Label.c.PMP_Storefront_DescribeYourCompany}"
                                                                       ></c:psMpSimpleContentCard>
                                        
                                        <aura:set attribute="else">
                                           <c:psMpSimpleContentCard  heading="" 
                                                                     imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                                     tagline="{!$Label.c.PMP_Storefront_DescribeYourCompany}"
                                                                     buttonAccessibilityLabel="{!$Label.c.PMP_Storefront_DescribeYourCompany}"
                                                                     buttonLabel="{!$Label.c.PMP_StartNow}" 
                                                                     buttonEventParams="1" 
                                                                     onclickbutton="{!c.handleOpenStorefrontForm1}"></c:psMpSimpleContentCard>
                                             </aura:set>
                                        </aura:if>

                                        <aura:set attribute="else">
                                           <c:psMpSimpleContentCard  heading="" 
                                                                 imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                                 tagline="{!$Label.c.PMP_ProfileBeingReviewed}" 
                                                                 onclickbutton="{!c.handleOpenStorefrontForm1}"></c:psMpSimpleContentCard>
                                          
                                          
                                        </aura:set>
                                    </aura:if>
                                </div>
                            </aura:set>
                        </aura:if>
                        
                    </lightning:layoutItem>
                    <lightning:layoutItem class="padding-desktop-right-none padding-desktop-bottom-none" padding="around-small" size="12" mediumDeviceSize="3">
                        
                      <!--  <aura:if isTrue="{! or(v.showLeadGeneration, v.isIntelAdmin)}">                                                            
                            <aura:if isTrue="{!v.isSamePartnerUser}">
                                <c:MarketplaceLeadGenSettings partnerId="{!v.recordId}" hasAccess="{!v.hasLeadGenAccess}" />                                           
                            </aura:if>                                            
                        </aura:if> -->
                        
                        <!-- removed contact partner (create) -->
                        
                        <aura:if isTrue="{! !empty(v.partner.partnerDetails)}">
                            <div>
                                <div class="whiteBg card-heading-padding">
                                    <h3 class="heading-16">{!$Label.c.PMP_CompanyInformation}</h3>
                                </div>
                           <!-- Updated the padding from slds-p-bottom_small to slds-p-bottom_large as part of the US-US788273-->
                                <div class="slds-p-bottom_large">
                                    <c:MarketplacePartnerCard
                                                              minHeight="0"
                                                              id="{! v.recordId}"
                                                              displayType="card"
                                                              imageUrl="{! v.partner.partnerDetails.imageUrl}"
                                                              title="false"   
                                                              description="{! v.partner.partnerDetails.description}"
                                                              attributes="{! v.partner.partnerDetails.attributes}"
                                                              dataObj="{! v.partner.partnerDetails}"
                                                              displayContactPartner="false"                                                             
                                                              displayAttributes="true"
                                                              editEnabled="{!v.showEditPencil}"
                                                              mdaId="{!v.mdaId}"
                                                              enableAttributeCountLimit="false"
                                                              
                                                              />
                                                               <!-- IPA2.0 + US TWC4497-1631 -->
                                                          <!-- displayAllCompanyOffering="false" -->
                                </div>
                            </div>
                        </aura:if>
                        
                        <!-- Create Profile Type Mobile-->
                        <aura:if isTrue="{!v.appState.Settings.currentScreenSize != 'desktop'}">
                            <div class="whiteBg slds-m-top_large">
                                <c:IntelHubSpoke headline="{!$Label.c.PMP_Edit_Storefront_Company_Resources}">
                                    <!--<aura:if isTrue="{!v.publishedStatus == 'submitted-under-review'}">-->
                                                    <aura:if isTrue="{!v.publishedStatus == 'Draft'}">
                                       <aura:if isTrue="{!v.isLdrOeEmployee==true}">
                                            <c:psMpSimpleContentCard  heading="{!$Label.c.PMP_Edit_Storefront_Company_Resources}" 
                                                                     imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                                     tagline="{!$Label.c.PMP_Storefront_Add_Your_Company_Resources}"
                                                                     buttonAccessibilityLabel="{!$Label.c.PMP_Storefront_Add_Your_Company_Resources}"></c:psMpSimpleContentCard>
                                         <aura:set attribute="else">
                                       <c:psMpSimpleContentCard  heading="{!$Label.c.PMP_Edit_Storefront_Company_Resources}" 
                                                                     imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                                     tagline="{!$Label.c.PMP_Storefront_Add_Your_Company_Resources}"
                                                                     buttonAccessibilityLabel="{!$Label.c.PMP_Storefront_Add_Your_Company_Resources}"
                                                                     buttonLabel="{!$Label.c.PMP_StartNow}"
                                                                     buttonEventParams="3" 
                                                                     onclickbutton="{!c.handleOpenStorefrontForm1}"></c:psMpSimpleContentCard>
                                           </aura:set>
                                        </aura:if>
                                        <aura:set attribute="else">
                                               <c:psMpSimpleContentCard  heading="{!$Label.c.PMP_Edit_Storefront_Company_Resources}" 
                                                                 imageUrl="{!$Resource.ISG_EmptyChipGraphic_Large_SVG}"  
                                                                 tagline="{!$Label.c.PMP_CompanyResourcesBeingReviewed}" 
                                                                 onclickbutton="{!c.handleOpenStorefrontForm1}"></c:psMpSimpleContentCard>
                                           
                                        </aura:set>
                                    </aura:if>
                                </c:IntelHubSpoke>
                            </div>
                        </aura:if>
                    </lightning:layoutItem>
                </lightning:layout>
            </aura:set>
      </aura:if> 
    </aura:if>
    <!-- Basic profile section ends -->
      <!-- Enhanced storefront section starts -->
  
    <!-- Enhanced storefront section ends -->
  </aura:component>