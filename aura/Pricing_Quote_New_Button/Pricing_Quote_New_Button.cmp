<aura:component
  implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride"
  access="global">
  <lightning:layout horizontalAlign="spread" multipleRows="true">
    <lightning:layoutItem flexibility="grow" size="12" smallDeviceSize="12" mediumDeviceSize="12" largeDeviceSize="12">
      <div class="slds-align_absolute-center">
        <lightning:button label="New Quote" title="New" onclick="{! c.handleClick }" />
         
      </div>
    </lightning:layoutItem>
  </lightning:layout>
</aura:component>