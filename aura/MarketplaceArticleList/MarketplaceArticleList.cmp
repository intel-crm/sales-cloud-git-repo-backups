<aura:component >
    
    <aura:attribute name="articleList" type="Object[]" required="true" default="[]" ></aura:attribute>
	
    <ul class="resourceList">
	<aura:iteration items="{!v.articleList}" var="item" indexVar="idx">
			<li class="slds-p-around_medium">
					<h4 class="heading-14">{! item.publishedDate} </h4>
                <!--<p><c:IntelLink url="{!item.linkUrl}" openInBlank="{! item.openInNewTab}">{! item.title}</c:IntelLink></p>-->
                <p><c:IntelLink url="{!item.link}" >{! item.title}</c:IntelLink></p>

			</li>
	</aura:iteration>
	</ul>
    
</aura:component>