<aura:component>
    <aura:attribute name="startDate" type="String"/>
    <aura:attribute name="onContinue" type="Aura.Action"/>
    <aura:attribute name="onCancel" type="Aura.Action"/>

    <div class="slds-modal slds-fade-in-open" style="display:block; position:fixed; top:0; left:0; width:100%; height:100%; z-index:1000; background-color: rgba(0,0,0,0.5);">
        <div class="slds-modal__container" style="margin: 10% auto; max-width: 400px;">
            <header class="slds-modal__header">
                <h2 class="slds-text-heading--medium">Enter Start Date</h2>
            </header>
            <div class="slds-modal__content slds-p-around_medium">
                <lightning:input type="date" label="Start Date" value="{!v.startDate}" />
            </div>
            <footer class="slds-modal__footer">
                <lightning:button label="Cancel" onclick="{!v.onCancel}" variant="neutral"/>
                <lightning:button label="Continue" onclick="{!v.onContinue}" variant="brand"/>
            </footer>
        </div>
    </div>
</aura:component>