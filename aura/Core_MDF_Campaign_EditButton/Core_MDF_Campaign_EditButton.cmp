<!-- Component Used to Show the Edit Button on the Community -->
<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride" access="global" controller ="Core_MDF_Campaign_QuickActionController">
    <aura:attribute type="Boolean" name="CheckEdit" Default="false" description="Controls the rendering of the edit component on click of the button" />
    <aura:attribute type="Boolean" name="objectEditPermission" Default="false" description="Checks the permission for the CRUD user" />
    <aura:attribute name="recordId" type="Id" default="" />
    <aura:attribute name="recordTypeId" type="Id" default="" />
    <aura:attribute name="recordTypeName" type="String" default="" />
    <aura:attribute name="recordTypeDeveloperName" type="String" default="" />
    <aura:attribute name="campaignStatus" type="String" default="" />
    <aura:attribute name="mode" type="String" default="" />
    <aura:attribute name="fieldSetName" type="String" default="" />    
    <aura:attribute name="recordInfoLoaded" type="Boolean" default="false"/>
    <aura:attribute name="fieldSetLoaded" type="Boolean" default="false"/>
    <aura:attribute name="proposalBasedIndicator" type="Boolean" default="false"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/> 
    <aura:handler name="change" value="{!v.recordInfoLoaded}" action="{!c.fetchFieldSetInfo}" />
    
    <!--Onclick Of the Button To Open the Create Edit Component Page -->
    <aura:if isTrue ="{!and(v.CheckEdit, v.fieldSetLoaded)}" >
        <div aura:id="modalIdForCommuntityRecord" role="dialog" tabindex="-1" aria-labelledby="header43" class="slds-modal slds-slide-up-saving slds-modal_large"><!--class="slds-modal slds-fade-in-open slds-modal_large"-->
            <div class="slds-modal__container">
                <!-- Heading (Header of the Modal) -->
                <div class="slds-modal__header">
                    <button class="slds-button slds-button_icon slds-modal__close" title="Close" onclick="{!c.closeModal}">
                        <lightning:icon iconName="utility:close" alternativeText="Close" size="small" />
                        <span class="slds-assistive-text">{!$Label.c.Core_MDF_Cancel}</span>
                    </button>
                </div>
                <div class="slds-modal__content slds-p-around--medium">
                    <c:core_MDF_Create_Campaign recordId="{!v.recordId}" mode="{!v.mode}" recordTypeId="{!v.recordTypeId}" recordTypeName="{!v.recordTypeName}" recordTypeDeveloperName="{!v.recordTypeDeveloperName}" objectApiName="Campaign" fieldSetName="{!v.fieldSetName}" status="{!v.campaignStatus}"></c:core_MDF_Create_Campaign>
                </div>
                <div class="slds-modal__footer"></div>
            </div>
        </div>
        <div aura:id="backdropIdForNewRecord" class="slds-backdrop slds-backdrop--open"></div>
    </aura:if>
    <!-- Show New Button Only if the object has CRUD Permission -->
    <aura:if isTrue="{!v.objectEditPermission}">
        <div class="slds-float--right">
            <lightning:button label="{!$Label.c.Core_MDF_Edit}" title="{!$Label.c.Core_MDF_Edit}" onclick="{!c.handleClick}"/>
        </div>
    </aura:if>
</aura:component>