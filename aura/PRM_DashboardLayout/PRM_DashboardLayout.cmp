<aura:component implements="forceCommunity:layout" description="Marquee w/ full body content area"
                access="global" controller="PRM_DashboardTabVisibilityController">
    <aura:attribute name="manageOfferingBar" type="Aura.Component[]" required="false"></aura:attribute> 
    <aura:attribute name="marquee" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="mainFullWidth" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="main" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab1" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab2" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab3" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab4" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab5" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab6" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab7" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab8" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab9" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="tab10" type="Aura.Component[]" required="false"></aura:attribute>
    <!-- <aura:attribute name="renewalc" type="string" required="false"></aura:attribute>
    <aura:attribute name="renewalc2" type="string" required="false"></aura:attribute>
    <aura:attribute name="renewalc3" type="string" required="false"></aura:attribute> -->
    <!-- IPA2.0 TWC727-3135 -->
    <aura:attribute name="yesno" type="string" required="false"></aura:attribute> 
    <aura:attribute name="blade1" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="blade2" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="blade3" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="blade4" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="sidebar" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="ctabar" type="Aura.Component[]" required="false" />
    <aura:attribute name="offeringbutton" type="Aura.Component[]" required="false" />
    <aura:attribute name="faqWhite" type="Aura.Component[]" required="false" />
    <aura:attribute name="custombutton" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="partnerList" type="Object[]"/>
    <aura:attribute name="showSpinner" type="boolean" default = "false"/>
    <!-- <aura:attribute name="showRenewal" type="boolean" default = "false"/> -->
    <!-- IPA2.0 TWC727-3135 -->
    <aura:attribute name="showManageStorefrontBtn" type="boolean" default = "false"/>
    <aura:attribute name="showManageManagePartnerBtn" type="boolean" default = "false"/>
    <!--Created by Megha as part of US528777-->
    <aura:attribute name="showLeadTab" type="boolean" default="false"/>
    <aura:attribute name="showTabs" type="boolean" default="false"/>
    <aura:attribute name="showPartnerKeyMetricsExtTab" type="string" default=" "/>
    <!-- Created by Manjula as part of US528775/US602030-->
    <!--<aura:attribute name="showPartnerKeyMetricsTab" type="boolean" default="false"/>IPA2.0-TWC729-8064-->
    <!--<aura:attribute name="showOfferingTab" type="boolean" default="false"/> IPA2.0-TWC729-8064-->
    <!--<aura:attribute name="showOfferingSection" type="boolean" default="false"/>IPA2.0-TWC729-8064-->
    <!--<aura:attribute name="showSolutionSection" type="boolean" default="false"/>IPA2.0-TWC729-8064-->
    <!--<aura:attribute name="showPartnerTab" type="boolean" default="false"/> IPA2.0-TWC729-8064-->
    <aura:attribute name="showAccountActivityTab" type="boolean" default="false"/>
    <aura:attribute name="showSalesTab" type="boolean" default="false"/>
    <aura:attribute name="showTrainingTab" type="boolean" default="false"/>
    <aura:attribute name="dashboard1" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="dashboard2" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="dashboard12" type="Aura.Component[]" required="false"></aura:attribute>
    
    <aura:attribute name="showManageOfferings" type="boolean" default="true" />
    <aura:attribute name="showManageLeads" type="boolean" default="true" />
    <aura:attribute name="showManagedPartners" type="boolean" default="true" />
    
    <aura:attribute name="showPointsTab" type="boolean" default="false" />
    <aura:attribute name="showPointsTab1PIDSection" type="boolean" default="false" />
    <aura:attribute name="showPointsTabLocationSection" type="boolean" default="false" />
    <aura:attribute name="showDQFlag" type="boolean" default="false" />
    
    <!--<aura:attribute name="showOfferingKeyMetricsTab" type="boolean" default="false"/> IPA2.0-TWC729-8064-->
    <aura:attribute name="showPartnerKeyMetricsTabExternalUsers" type="boolean" default="false"/>
    
    <aura:attribute name="showWarrantyTab" type="boolean" default="false"/>
    <aura:attribute name="showvx" type="List"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    

    <div>       
        <div class="marquee">
            {!v.marquee}
        </div>
        
        <div class="container">
            <aura:if isTrue="{!v.showTabs}">
                <c:MarketplaceTabset aura:id="isgtabs" class="lightestGrayBg slds-m-vertical_xx-large">
                    <!-- IPA2.0 TWC727-3135 -->
                    <!-- <aura:if isTrue="{!and(v.showRenewal, $Label.c.PRM_ShowIPARenewalTab)}">
                        <c:MarketplaceTab label="{!$Label.c.PRM_Renewallbl}" renderOnFirstOpen="true">
                            <div class="container" align="right"> <div class="bg-blade-even">
                               <lightning:button variant="brand" label="Renewal" onclick="{!c.partnerURL}" />
                                </div></div>
                            <div class="slds-p-vertical_small"><lightning:formattedRichText value="{!v.renewalc}"></lightning:formattedRichText></div>
                            <c:prm_renewalDashboard vxdynamiccont="{!v.showvx}"></c:prm_renewalDashboard>
                             <div class="slds-p-vertical_small"><lightning:formattedRichText value="{!v.renewalc2}"></lightning:formattedRichText></div>
                              <lightning:layout >
                                    <lightning:layoutItem padding="around-small"> 
                                    <div style="border:solid black;  width: 60px;height: 40px;  padding-top: 10px;" align="center"><p style="font-family: Salesforce Sans; font-size:12px; font-weight:bold;" align="center">{!v.yesno}</p></div> 
                                          </lightning:layoutItem>  
                                          <lightning:layoutItem padding="around-small"> 
                                    <div class="header-column"><lightning:formattedRichText style="font-family: Salesforce Sans; font-size:12px;" value="{!$Label.c.PRM_Renewal_Yes_No_criteria}"></lightning:formattedRichText></div>
                                          </lightning:layoutItem>
                               </lightning:layout>
                        </c:MarketplaceTab>
                    </aura:if>  
                    -->
                    <aura:if isTrue="{!v.showSalesTab}">
                        <c:MarketplaceTab label="{!$Label.c.PRM_Sales}" renderOnFirstOpen="true">
                            <div class="container">
                                {!$Label.c.PRM_Dashboard_Verbiage_Text}<a href="{!$Label.c.PRM_Dashboard_Verbiage_Link}">&nbsp;{!$Label.c.PRM_Dashboard_Verbiage_Support}</a>.<br></br>                         
                            </div>
                            
                            <div class="slds-p-vertical_small">{!v.dashboard1}</div>
                            
                        </c:MarketplaceTab>
                    </aura:if>
                    
                    <aura:if isTrue="{!v.showTrainingTab}">
                        <c:MarketplaceTab label="{!$Label.c.PRM_Training}" renderOnFirstOpen="true">
                            <div class="container slds-grid slds-wrap">
                                <div class="slds-col slds-size_9-of-12">
                        {!$Label.c.PRM_Dashboard_Verbiage_Text}<a  href="{!$Label.c.PRM_Dashboard_Verbiage_Link}"  onmouseover="{!c.changeFocusColor}" onmouseout="{!c.changeFocusColor}" onfocus="{!c.changeFocusColor}" onblur="{!c.changeFocusColor}">&nbsp;{!$Label.c.PRM_Dashboard_Verbiage_Support}</a>.
                                </div>
                                <div class="slds-col slds-size_3-of-12">
                                <span onmouseover="{!c.changeFocusBackgroundColor}" onmouseout="{!c.changeFocusBackgroundColor}">
                            <lightning:button  class="slds-float_right" variant="brand" label="{!$Label.c.PRM_Partner_University}" onclick="{! c.partnerUniversity }"  onfocus="{!c.changeFocusBackgroundColor}" onblur="{!c.changeFocusBackgroundColor}"/>
                                </span>
                                </div>
                            </div>
                            <div class="slds-p-vertical_small"> {!v.dashboard2}
                                {!v.dashboard12}
                            </div><br></br>             
                        </c:MarketplaceTab>
                    </aura:if>
                    
                    <aura:if isTrue="{!v.showAccountActivityTab}">
                        <c:MarketplaceTab label="{!$Label.c.PRM_Account_Activity}" renderOnFirstOpen="true">
                            <div class="container" align="right">  <div class="bg-blade-even">
                                <lightning:button variant="brand" label="{!$Label.c.PRM_Manage_Mem_profile}" onclick="{!c.manageMembership}" />
                                </div></div>
                            <div class="slds-p-vertical_small">{!v.tab6}</div>
                        </c:MarketplaceTab>
                    </aura:if>                    
            <!-- New Tab for Points -->
                    <aura:if isTrue="{!v.showPointsTab}">
                        <c:MarketplaceTab label="{!$Label.c.prm_Points_tab_lbl}" renderOnFirstOpen="true">
                            <div class="container slds-grid slds-wrap">   
                                <div class="slds-col slds-size_10-of-12">
                                    <Aura:if isTrue="{!v.showDQFlag}">
                                        {!$Label.c.PRM_Dashboard_IPA_Metrics}<a href="{!$Label.c.PRM_Dashboard_IPA_Metrics_SupportLink}">&nbsp;{!$Label.c.PRM_Dashboard_Verbiage_Support}</a>&nbsp;{!$Label.c.PRM_Dashboard_IPA_Metrics2}
                                     </Aura:if>
                                </div>
                                 <div class="slds-col slds-size_2-of-12">
                                    <lightning:button variant="brand" class="slds-float_right" label="{!$Label.c.prm_manage_points_btn_lbl}" onclick="{!c.pointsURL}" />
                                </div>
                            </div>
                           <Aura:if isTrue="{!v.showPointsTabLocationSection}">
                                <div class="slds-p-vertical_small">{!v.tab7}</div>
                            </Aura:if>
                        </c:MarketplaceTab>
                    </aura:if>
                    <!-- New Tab for Warranty -->
                    <aura:if isTrue="{!v.showWarrantyTab}">
                        <c:MarketplaceTab label="{!$Label.c.PRM_Warranty_Tab_Lbl}" renderOnFirstOpen="true">
                            <div class="container" align="right">  <div class="bg-blade-even">
                                <lightning:button variant="brand" label="{!$Label.c.PRM_Manage_Warranty_Btn}" onclick="{!c.warrantyURL}" />
                                </div></div>
                            <div class="slds-p-vertical_small">{!v.tab10}</div>
                        </c:MarketplaceTab>
                    </aura:if> 

                    <!--Created by Megha as part of US528775-->
                    <!--IPA2.0-TWC729-8064--><!--<aura:if isTrue="{!v.showPartnerKeyMetricsTab}">
                        <c:MarketplaceTab label="{!$Label.c.PMP_Marketplace_KeyMetrics}" renderOnFirstOpen="true">
                            <div class="container" align="right"> <div class="bg-blade-even">     
                                <aura:if isTrue="{!v.showManageStorefrontBtn}">                                        
                                    <lightning:button variant="brand" label="{!$Label.c.PMP_Manage_Storefront}" onclick="{!c.storefrontURL}" />
                                </aura:if>     
                                <aura:if isTrue="{!v.showManageManagePartnerBtn}">
                                    <lightning:button variant="brand" label="{!$Label.c.PMP_Manage_Marketplace_Partners}" onclick="{!c.partnerURL}" />
                                </aura:if>
                                
                                </div></div>
                            <div class="slds-p-vertical_small">{!v.tab1}</div>
                        </c:MarketplaceTab>                        
                    </aura:if>-->
                    <!--Added by Manjula as part of US528777-->
                    <aura:if isTrue="{!v.showLeadTab}">
                        <c:MarketplaceTab label="{!$Label.c.PMP_Marketplace_Leads}" renderOnFirstOpen="true">
                            <div class="container" align="right">	<div class="bg-blade-even">
                                <lightning:button variant="brand" label="{!$Label.c.PMP_ManageOffering_Manage_Leads}" onclick="{!c.leadURL}" />
                                </div></div>
                            <div class="slds-p-vertical_small">{!v.tab2}</div>
                        </c:MarketplaceTab>
                    </aura:if>
                    <!--Added by Manjula as part of US528775-->
                    <!--IPA2.0-TWC729-8064-->
                    <!--<aura:if isTrue="{!v.showOfferingTab}">
                        
                        <c:MarketplaceTab label="{!$Label.c.PMP_Marketplace_OfferingsandSolutions}" renderOnFirstOpen="true">
                            <aura:if isTrue="{!v.showOfferingSection}">  
                                <div class="container" align="right"><div class="bg-blade-even">
                                    <lightning:button variant="brand" label="{!$Label.c.PMP_ManageOffering_Manage_Marketplace_Offerings}" onclick="{!c.offeringURL}" />
                                    </div></div>
                                <div class="container" align="right">  
                                </div>
                                <div class="slds-p-vertical_small">{!v.tab3}</div> 
                            </aura:if>-->
                            <!--  Start      As part of US912166: Ge-TM - explore on Dashboard to support Get to Market initiative
          Add Manage Solution button and New bashboard section  -->			
                        <!--    <aura:if isTrue="{!v.showSolutionSection}"> 
                                <div class="container" align="right">
                                    <div class="bg-blade-even">
                                        <lightning:button variant="brand" label="{!$Label.c.PMP_ManageSolution_Manage_Marketplace_Solutions}" onclick="{!c.SolutionURL}" /> 
                                    </div>
                                </div>
                                <div class="slds-p-vertical_small">{!v.tab8}</div>
                            </aura:if>   -->
                            <!--                   End of US912166              -->
                        <!--</c:MarketplaceTab>-->
                        <!--IPA2.0-TWC729-8064--><!--<aura:if isTrue="{!v.showOfferingKeyMetricsTab}">
                            <c:MarketplaceTab label="{!$Label.c.PMP_Marketplace_Offerings_KeyMetrics}" renderOnFirstOpen="true">
                                
                                <div class="container" align="right"><div class="bg-blade-even">
                                    <lightning:button variant="brand" label="{!$Label.c.PMP_ManageOffering_Manage_Marketplace_Offerings}" onclick="{!c.offeringURL}" />
                                    </div></div>
                                <div class="slds-p-vertical_small">{!v.tab4}</div>
                            </c:MarketplaceTab>
                        </aura:if>   -->   
                    <!--</aura:if>-->
                    <!--Added by Manjula as part of US602030-->
                    <!--IPA2.0-TWC729-8064--><!--<aura:if isTrue="{!v.showPartnerTab}">
                        <c:MarketplaceTab label="{!$Label.c.PMP_Marketplace_Partners}" renderOnFirstOpen="true">
                            <div class="container" align="right"> <div class="bg-blade-even">
                                <lightning:button variant="brand" label="{!$Label.c.PMP_Manage_Marketplace_Partners}" onclick="{!c.partnerURL}" />
                                </div></div>
                            <div class="slds-p-vertical_small">{!v.tab5}</div>
                        </c:MarketplaceTab>
                    </aura:if>-->
                    
                </c:MarketplaceTabset>
            </aura:if>    
        </div>
        <div class="bg-white">
            <div class="container">
                {!v.faqWhite}
            </div>
        </div>
    </div>
</aura:component>