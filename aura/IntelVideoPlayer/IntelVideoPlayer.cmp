<aura:component>

    <aura:attribute name="videoResource" type="string" required="true" description="A reference to the static resource mp4 file." />
    <aura:attribute name="width" type="string" default="500" />
    <aura:attribute name="videoType" type="string" default="brightcove" description="Can be 'brightcove' or 'video/mp4'" />
    <aura:attribute name="controls" type="string" default="controls" />
    <aura:attribute name="modal" type="Boolean" default="false" />
    <aura:attribute name="modalIsOpen" type="Boolean" default="false" />

    <aura:method name="play" action="{!c.handlePlay}" />
    <aura:method name="pause" action="{!c.handlePause}" />

    <!-- NOT IN MODAL -->
    <aura:if isTrue="{!!v.modal}">
        <aura:if isTrue="{!v.videoType == 'video/mp4'}">
            <video id="video" aura:id="video" controls="{!v.controls}" width="{!v.width}">
                <source src="{!v.videoResource}" type="{!v.videoType}" />
                $Label.c.PMP_Video_Error_Msg
            </video>
        </aura:if>

        <aura:if isTrue="{!v.videoType == 'brightcove'}">
            <div style="position: relative; display: block; max-width: 100%; ">
                <div class="modalWidth" style="padding-top: 56.25%;">
                    <iframe src="{!v.videoResource}"
                            allowfullscreen="true"
                            webkitallowfullscreen="true"
                            mozallowfullscreen="true"
                            allow="encrypted-media" />
                </div>
            </div>
        </aura:if>

        <aura:set attribute="else">
            
            <c:MarketplaceModal isOpen="{!v.modalIsOpen}" fitToContent="true">
                <div class="videoContainer modal">
                    <div class="videoSize">

                        <aura:if isTrue="{!v.videoType == 'video/mp4'}">
                            <video id="video" aura:id="video" controls="{!v.controls}" width="{!v.width}">
                                <source src="{!v.videoResource}" type="{!v.videoType}" />
                                $Label.c.PMP_Video_Error_Msg
                            </video>
                        </aura:if>

                        <aura:if isTrue="{!v.videoType == 'brightcove'}">
                            <div style="position: relative; display: block; max-width: 100%; max-height: 100%;">
                                <div class="modalWidth" style="padding-top: 56.25%;">
                                    <iframe src="{!v.videoResource}"
                                            allowfullscreen="true"
                                            webkitallowfullscreen="true"
                                            mozallowfullscreen="true"
                                            allow="encrypted-media" />
                                </div>
                            </div>
                        </aura:if>

                    </div>
                </div>
            </c:MarketplaceModal>

        </aura:set>
    </aura:if>

</aura:component>