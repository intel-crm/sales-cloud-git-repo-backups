<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    <!--Boolean attribute to indicate if modal is open or not 
       default value is false as modal is closed when page is loaded 
    -->
    <aura:html tag="style">
        <!--To increase modal size when called from claim batch record-->
        .modalcontainer{
        --sds-c-modal-sizing-border :1px;        	
        --sds-c-modal-content-color-background : #F3F2F2;
        max-width: 80% !important ;
        width : 80% !important ; 
        }
    </aura:html>    
    <aura:attribute name="isModalOpen" type="boolean" default="false"/>
    <!-- Onload of the Page the values to be loaded  -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <div class="slds-m-around_xx-large">
        
        <!--Use aura:if tag to display/hide popup based on isModalOpen value -->
        <aura:if isTrue="{!v.isModalOpen}">
            
            <!-- Modal/Popup Box starts here-->
            <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                <div class="slds-modal__container modalcontainer">
                    <!-- Modal/Popup Box Header Starts here>
                    <header class="slds-modal__header slds-modal__header_empty">                        
                    </header>-->
                    <!--Modal/Popup Box Body Starts here-->
                    <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                        <p>There may not be enough budget to support your proposal, please await a reply from your Intel Contact.
                            
                        </p>
                    </div>
                    <!--Modal/Popup Box Footer Starts here-->
                    <footer class="slds-modal__footer">                        
                        <lightning:button variant="brand"
                                          label="OK"
                                          title="OK"
                                          onclick="{!c.submitDetails}"/>
                    </footer>
                </div>
            </section>
            
        </aura:if>
    </div>
</aura:component>