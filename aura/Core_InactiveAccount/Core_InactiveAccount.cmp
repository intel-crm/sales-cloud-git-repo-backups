<aura:component controller="Core_InactiveAccountonOpp" implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global" >
    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="isOppInactive" type="Boolean" default= "false"/>
    <aura:attribute name="onCheckOppAcc" type="Boolean" default= "false"/>
    
    <aura:attribute name="isVendor" type="Boolean" default= "false"/>
    <aura:attribute name="onCheckVendor" type="Boolean" default= "false"/>
    <aura:attribute name="quarterMisALign" type="Boolean" default="false"/>
    <aura:attribute name="isOppPartner" type="Boolean" default= "false"/>
    <aura:attribute name="onCheckOppPartner" type="Boolean" default= "false"/>
    <aura:handler name="init" value="this" action="{!c.doInit}"/>
     <aura:attribute name="record" type="Object" />
    <aura:attribute name="simpleRecord" type="Object" />
    <aura:attribute name="recordError" type="String" />
    <force:recordData aura:id="recordLoader"
                      recordId="{!v.recordId}"
                      targetError="{!v.recordError}"
                      targetRecord="{!v.record}"
                      targetFields="{!v.simpleRecord}"
                      layoutType="FULL"
                      recordUpdated="{!c.handleRecordUpdated}" />

	<aura:handler name="change" value="{!v.record}" action="{!c.handleRecordUpdated}" />
