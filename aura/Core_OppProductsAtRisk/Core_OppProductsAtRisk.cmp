<aura:component controller="Core_OppProductsAtRisk_Ctrl" implements="force:lightningQuickActionWithoutHeader,force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId" access="global" >
    
    <!--aura attribute-->
    <aura:attribute name="noneValue" type="String" default="-------"/>
    <aura:attribute name="loaded" type="Boolean" default="false" />
    <aura:attribute name="oppRecord" type="Opportunity"/>
    <aura:attribute name="atRiskCreatedDate" type="String"/>
    <aura:attribute name="oppProductList" type="List"/>
    <aura:attribute name="oppProductListDummy" type="List"/>
    <aura:attribute name="riskReason1" type="List"/>
    <aura:attribute name="riskReason2" type="List"/>
    <aura:attribute name="riskPriority" type="List"/>
    <aura:attribute name="riskCategory" type="List"/>
    
    <aura:attribute name="depnedentFieldMap" type="map"/>
    
    <!--aura handler-->
    <aura:handler name="init" value="this" action="{!c.doInit}"/>
    <aura:handler event="force:refreshView" action="{!c.doInit}"/>
    
    <aura:if isTrue="{!!v.loaded}">
        <lightning:spinner variant="brand" alternativeText="Loading" />
    </aura:if>
    <div class="slds-grid slds-wrap">
        <div class="TopButtonCls">
            <lightning:button label="Save" title="Save" onclick="{!c.saveAction}" disabled="{!!v.oppRecord.Core_At_Risk__c}"/>
            <lightning:button label="Cancel" title="Cancel" onclick="{!c.cancelAction}" disabled="{!!v.oppRecord.Core_At_Risk__c}"/>
        </div>
        
        <div class="AtRiskCheckboxCls">
            <div>
                <label class="slds-form-element__label LabelCls">At Risk(Opportunity)</label>
                <lightning:input type="checkbox" checked="{!v.oppRecord.Core_At_Risk__c}" class="ValueCls" disabled="true"/>
            </div>
            <div>
                <label class="slds-form-element__label LabelCls">At Risk Created Date</label>
                <lightning:formattedDateTime value="{!v.atRiskCreatedDate}" class="ValueCls" timeZone="America/Los_Angeles"/>
            </div>
        </div>
        
        <aura:if isTrue="{!not(empty(v.oppProductList))}">
            <table class="slds-table slds-table_bordered">
                <thead>
                    <tr class="TrCls">
                        <th class="Th1Cls">Product</th>
                        <th class="Th2Cls">BU</th>
                        <th class="Th3Cls">At Risk</th>
                        <th class="Th4Cls">Risk Reason 1</th>
                        <th class="Th5Cls">Risk Reason 2</th>
                        <th class="Th7Cls">Risk Priority</th>
                        <th class="Th8Cls">Risk Category</th>
                        <th class="Th9Cls">Risk Status</th>
                    </tr>
                </thead>
                <tbody>
                    <aura:iteration items="{!v.oppProductList}" var="oppProduct" indexVar="index">
                        <tr class="TrCls">
                            <td class="Th1Cls Td1Cls">{!oppProduct.productName}</td>
                            <td class="Th2Cls Td2Cls">{!oppProduct.buShortName}</td>
                            <td class="Th3Cls Td2Cls">
                                <lightning:input type="checkbox" tabindex="{!index}" name="atRiskCheck" checked="{!oppProduct.atRisk}" onchange="{!c.setAtRiskInOpportunity}" disabled="{!oppProduct.isDisabled}"/>
                            </td>
                            <td class="Th4Cls">
                                <lightning:select value="{!oppProduct.riskReason1}" title="{!if(oppProduct.riskReason1 != v.noneValue,oppProduct.riskReason1,'')}" disabled="{!!oppProduct.atRisk}">
                                    <aura:iteration items="{!v.riskReason1}" var="option">
                                        <option text="{!option}" value="{!option}" selected="{!if(option == oppProduct.riskReason1,true,false)}"/>
                                    </aura:iteration>
                                </lightning:select>
                            </td>
                            <td class="Th5Cls">
                                <lightning:select value="{!oppProduct.riskReason2}" title="{!if(oppProduct.riskReason2 != v.noneValue,oppProduct.riskReason2,'')}" disabled="{!!oppProduct.atRisk}">
                                    <aura:iteration items="{!v.riskReason2}" var="option">
                                        <option text="{!option}" value="{!option}" selected="{!if(option == oppProduct.riskReason2,true,false)}"/>
                                    </aura:iteration>
                                </lightning:select>
                            </td>
                            <td class="Th7Cls">
                                <lightning:select value="{!oppProduct.riskPriority}" title="{!if(oppProduct.riskPriority != v.noneValue,oppProduct.riskPriority,'')}" disabled="{!!oppProduct.atRisk}">
                                    <aura:iteration items="{!v.riskPriority}" var="option">
                                        <option text="{!option}" value="{!option}" selected="{!if(option == oppProduct.riskPriority,true,false)}"/>
                                    </aura:iteration>
                                </lightning:select>
                            </td>
                            <td class="Th8Cls">
                                <lightning:select value="{!oppProduct.riskCategory}" title="{!if(oppProduct.riskCategory != v.noneValue,oppProduct.riskCategory,'')}" tabindex="{!index}" onchange="{!c.onRiskCategoryChange}" disabled="{!!oppProduct.atRisk}">
                                    <aura:iteration items="{!v.riskCategory}" var="option">
                                        <option text="{!option}" value="{!option}" selected="{!if(option == oppProduct.riskCategory,true,false)}"/>
                                    </aura:iteration>
                                </lightning:select>
                            </td>
                            <td>
                                <lightning:select value="{!oppProduct.riskStatus}" title="{!if(oppProduct.riskStatus != v.noneValue,oppProduct.riskStatus,'')}" disabled="{!if(or(oppProduct.riskCategory == null, oppProduct.riskCategory == v.noneValue),true,false)}">
                                    <aura:iteration items="{!oppProduct.riskStatusValues}" var="option">
                                        <option text="{!option}" value="{!option}" selected="{!if(option == oppProduct.riskStatus,true,false)}"/>
                                    </aura:iteration>
                                </lightning:select>
                            </td>
                        </tr>
                    </aura:iteration>
                </tbody>
            </table>
            <div class="slds-form-element__label SupportReqCls">
                <lightning:textarea name="supportReq" label="Risk Detail" value="{!v.oppRecord.Core_Support_Requested__c}"/>
            </div>
        </aura:if>
        
        <div class="BelowButtonCls">
            <lightning:button label="Save" title="Save" onclick="{!c.saveAction}" disabled="{!!v.oppRecord.Core_At_Risk__c}"/>
            <lightning:button label="Cancel" title="Cancel" onclick="{!c.cancelAction}" disabled="{!!v.oppRecord.Core_At_Risk__c}"/>
        </div>
    </div>
</aura:component>