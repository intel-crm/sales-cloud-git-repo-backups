<aura:component  controller="Account_Hierarchy_TreeGrid_1" implements="flexipage:availableForAllPageTypes,force:appHostable" >
    
    <aura:attribute name="gridColumns" type="list" />
    <aura:attribute name="gridData" type="Object" />
    <aura:attribute name="gridExpandedRows" type="List" access="PRIVATE" />
    <aura:attribute name="gridOriginalData" type="Object"/>
    <aura:attribute name="accountNameSearchText" type="String" />
    <aura:attribute name="channelProgramSearchText" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <div class="slds-box" style="background-color:white;">
        <div class="slds-box"> 
            <table>
                <tr style="display: inline-block;">
                    
                    <td>
                        <table style="vertical-align:top">
                            <tr>
                                <td style="padding:10px;font-size:20px;font-weight:bold;">
                                    Account Hierarchy
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <table style="width:100%;margin-top:10px;">
                <tr>
                    
                    <td width="10%" style="text-align:right;vertical-align:center;">
                        <b>Account Name:&nbsp;&nbsp;</b> 
                    </td>
                    <td width="15%">
                        <ui:inputText  value="{!v.accountNameSearchText}" class="slds-input textwidth"/>
                    </td>
                    <td width="2%"></td>
                    <td width="10%">
                        &nbsp;<button class="slds-button slds-button--brand" Label="Search" onclick="{!c.fetchRecords}">Search</button>
                    </td>
                </tr>
            </table>
        </div><br/>
        <aura:iteration items="{!v.gridData}" var="accData">
            <div class="slds-box " style="background-color:White;"> 
                <lightning:treeGrid  
                                    columns="{! v.gridColumns }"
                                    data="{!v.accData}"
                                    keyField="name"
                                    aura:id="mytree" />
            </div>
        </aura:iteration>
        
    </div>
</aura:component>