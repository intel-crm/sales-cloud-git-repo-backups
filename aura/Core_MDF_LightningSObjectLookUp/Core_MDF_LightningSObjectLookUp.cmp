<aura:component controller="Core_MDF_LookupSObjectController" implements="lightning:availableForFlowScreens" access="global">
   <!--<ltng:require styles="{!$Resource.Core_MDF_SLDS262 + '/styles/salesforce-lightning-design-system.css'}" />-->
    <!-- Attributes -->
    <aura:attribute name="sObjectAPIName" type="String" required="true" 
                    description="The API name of the SObject to search" />
    <aura:attribute name="instanceId" type="String" required="true" 
                    description="An id to identify the instance the component" />
    <aura:attribute name="label" type="String" required="true" 
                    description="The label to assign to the lookup, eg: Account" />
    <aura:attribute name="helpText" type="String" required="false" 
                    description="The helpText to assign to the field" />
    <aura:attribute name="required" type="Boolean" required="false" 
                    description="Indicates the lookup is required or not" />
    <aura:attribute name="pluralLabel" type="String" required="true" 
                    description="The plural label to assign to the lookup, eg: Accounts" />
    <aura:attribute name="listIconSVGPath" type="String" default="{!$Resource.Core_MDF_SLDS262 + '/icons/custom-sprite/svg/symbols.svg#custom11'}"
                    description="The static resource path to the svg icon to use." />
    <aura:attribute name="listIconClass" type="String" default="slds-icon-custom-11" 
                    description="The SLDS class to use for the icon." />
    <aura:attribute name="returnFields" type="String" required="false" 
                    description="The coma seprated API name(s) of the fields to returned" default="id,name"/>
    <aura:attribute name="filterCriteria" type="String" required="false" 
                    description="Where Clause " default=""/>
    <aura:attribute name="searchFields" type="String" required="false"
                    description="Comma-separated fields to search. For example: Title,Core_MDF_Claim_Ref_Number__c." />
    <aura:attribute name="selectedId" type="String" access="global"
                    description="The selected record Id for Flow output." />
    <aura:attribute name="searchString" type="String" 
                    description="The search string to find." />
    <aura:attribute name="matches" type="Core_MDF_LookupSObjectController.Result[]"
                    description="The resulting matches returned by the Apex controller." />
    <aura:attribute name="labelClass" type="String" required="false" default="slds-form-element__label"
                    description="The style class to be assigned to label text" />
    <!--added by VB - IGHF-->
    <aura:attribute name="staticResourceForSearch" type="string"/>
    <aura:attribute name="staticResourceForClose" type="string"/>


	<aura:handler name="init" value="{!this}" action="{!c.doInit}" /> 
    <aura:method name="clearLookupPill" action="{!c.clear2}" description="Runs the init method again "/>
    <aura:method name="select2" action="{!c.select2}" description="Runs the init method again "/>
    <!-- Events -->
    <aura:registerEvent name="updateLookupIdEvent" type="c:Core_MDF_UpdateLookupId"/>    
    <aura:registerEvent name="clearLookupIdEvent" type="c:Core_MDF_ClearLookupId"/>   
    
    <!-- Lookup Markup : See https://www.lightningdesignsystem.com/components/lookups -->
    <div class="slds"> 
        <div aura:id="lookup-div" class="slds-lookup" data-select="single" data-scope="single" data-typeahead="true">
            <!-- This is the Input form markup -->
            <div class="slds-form-element slds-var-m-left_small">
                <label class="{!v.labelClass}" for="lookup" title="{!v.helpText}">
                    <aura:if isTrue="{!v.required}">
                        <abbr class="slds-required" title="required">*</abbr></aura:if>
                    {!v.label}</label>
                <div class="slds-form-element__control slds-input-has-icon slds-input-has-icon_right">
					<aura:if isTrue="{!v.searchString != ''}">
                        <div aura:id="lookup-icons" onclick="{!c.clear}">
                            <lightning:icon class="closeIcon" iconName="utility:close" alternativeText="close" size="x-small" />
                        </div>
                        <aura:set attribute="else">
                            <!--<c:Core_MDF_svgIcon class="slds-input__icon" xlinkHref="{!$Resource.Core_MDF_SLDS262 +'/icons/utility-sprite/svg/symbols.svg#search'}" />-->
                            <!--<lightning:icon class="searchIcon" iconName="utility:Search" alternativeText="Search" size="x-small" />-->
                            <lightning:icon class="slds-input__icon slds-show" iconName="utility:search" size="x-small" alternativeText="search"/> 
                        </aura:set>
                    </aura:if>
                    <!-- This markup is for when an item is currently selected -->
                    <div aura:id="lookup-pill" class="slds-pill-container slds-hide">
                        <span class="slds-pill slds-pill_bare">
                            <span class="slds-pill__label">
                                <!--<c:Core_MDF_svgIcon class="{!'slds-icon ' + v.listIconClass + ' slds-icon_small'}" xlinkHref="{!$Resource.Core_MDF_SLDS262 + '/icons/utility-sprite/svg/symbols.svg#close'}" />-->
                                <lightning:icon class="slds-icon slds-icon-standard-user slds-icon_small" iconName="standard:client" size="small" alternativeText="User"/>&nbsp;{!v.searchString}
                            </span>
                            <button aura:id="clearIcon" class="slds-button slds-button_icon-bare" onclick="{!c.clear}">
                                <!--<c:Core_MDF_svgIcon class="slds-button__icon" xlinkHref="{!$Resource.Core_MDF_SLDS262 + '/icons/utility-sprite/svg/symbols.svg#close'}" />-->
                                <lightning:icon class="closeIcon" iconName="utility:close" alternativeText="Remove" size="x-small" />
                                <!--<span class="slds-assistive-text">Remove</span>-->
                            </button>
                        </span>
                    </div> 
                    <!-- This markup is for when searching for a string -->
                   <ui:inputText aura:id="lookup" value="{!v.searchString}" class="slds-input" updateOn="keyup" keyup="{!c.search}" /> 
                </div>
            </div>
            <!-- This is the lookup list markup. Initially it's hidden -->
            <div aura:id="lookuplist" class="slds-lookup__menu slds-hide" role="listbox">
                <div class="slds-lookup__item">
                    <button class="slds-button">
                        <!--<c:Core_MDF_svgIcon class="slds-icon slds-icon-text-default slds-icon_small" xlinkHref="{!$Resource.Core_MDF_SLDS262 +'/icons/utility-sprite/svg/symbols.svg#search'}" />-->
                        <lightning:icon iconName="utility:search" size="small" alternativeText="search"/> 
                        &quot;{!v.searchString}&quot; in {!v.pluralLabel}
                    </button>
                </div>
                <ul aura:id="lookuplist-items" class="slds-lookup__list dropdownStyle" role="presentation">
                    <aura:iteration items="{!v.matches}" var="match">
                        <li class="slds-lookup__item">
                            <span id="{!globalId + '_id_' + match.objectId}" role="option" onclick="{!c.select}">
                                <!--<c:Core_MDF_svgIcon class="{!'slds-icon ' + v.listIconClass + ' slds-icon_small'}" xlinkHref="{!v.listIconSVGPath}" />-->
                                <lightning:icon class="slds-icon slds-icon-standard-user slds-icon_small" iconName="standard:client" size="small" alternativeText="User"/>{!match.objectLabel} 
                            </span>
                        </li>
                    </aura:iteration>
                </ul>
            </div>
        </div>
    </div>
</aura:component>