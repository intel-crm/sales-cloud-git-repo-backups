<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,lightning:actionOverride,force:lightningQuickAction" controller="PRM_Retrigger_Emaillog_Utility" access="global">
    
    <aura:attribute name="message" type="String"/>
    <aura:attribute name="recordId" type="Id"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <div class="slds-align_absolute-center">
        	{!v.message}
    </div>
    
</aura:component>