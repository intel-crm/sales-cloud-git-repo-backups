<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    <!--attributes -->
    <aura:attribute name="res" type="Object" />
    <aura:attribute name="saveResponse" type="List" />
    <aura:attribute name="deleteResponse" type="List" />
    <aura:attribute name="objResponse" type="PRM_Profile_Responses__c" default="{'sobjectType':'PRM_Profile_Responses__c', 'PRM_Response_Txt__c':'', 'PRM_Account_Id__c':'', 'PRM_Profile_Questions_Id__c':'', 'PRM_Profile_Answer_Id__c':''}"/>
    <aura:attribute name="recordId" type="String" default=""/>
    <aura:attribute name="multiResponse" type="String" default=""/>
    <aura:attribute name="isDisable" type="Boolean" default="false"/>
    <aura:attribute name="DisclaimerValue" type="Boolean" default="false"/>
    <aura:attribute name="booleanResponse" type="Boolean"/>
    
    <!--handlers -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:handler name="change" value="{!v.res.response.PRM_Response_Txt__c}"  action="{!c.handleValueChange}"/>
   

    <!-- DOM Starts here -->
    <tr class="slds-hint-parent">
                    <th data-label="question" scope="row">
                        <div class="slds-truncate" title="question">
                            {!v.res.question.PRM_Question_Display_Txt__c }                           
                        </div>
                    </th>
                    <td data-label="Answer">
                        <aura:if isTrue="{!v.res.question.PRM_Question_Type_Nm__c == 'Text'}">
                            <lightning:input value="{!v.res.response.PRM_Response_Txt__c}" required="true" disabled="{!v.isDisable}"/>
                            <aura:set attribute="else">
                                <aura:if isTrue="{!v.res.question.PRM_Question_Type_Nm__c == 'Picklist'}">
                                    <lightning:select aura:id="InputSelect" value="{!v.res.response.PRM_Response_Txt__c}" disabled="{!v.isDisable}">
                                        <option text="--None--"/>
                                        <aura:iteration items="{!v.res.answers}"  var="val">  
                                            <option text="{!val.PRM_Answer_Display_Txt__c}" />
                                        </aura:iteration> 
                                    </lightning:select>
                                    <aura:set attribute="else">
                                        <aura:if isTrue="{!v.res.question.PRM_Question_Type_Nm__c == 'Textarea'}">
                                            <lightning:textarea aura:id="comments"  value="{!v.res.response.PRM_Response_Txt__c}" rows="3" disabled="{!v.isDisable}"/>
                                            <aura:set attribute="else">
                                                <aura:if isTrue="{!v.res.question.PRM_Question_Type_Nm__c == 'Boolean'}">
                                                    <lightning:input type="checkbox" aura:id="checkbox" value = "{!v.res.response.PRM_Response_Txt__c}" disabled="{!v.isDisable}"/>
                                                    <!--lightning:input type="checkbox" checked="{!v.booleanResponse}" value="{!v.res.response.PRM_Response_Txt__c}" disabled="{!v.isDisable}"/>-->
													<!--lightning:input type="checkbox" checked="{!v.res.response.PRM_Response_Txt__c}" value="{!v.res.response.PRM_Response_Txt__c}" disabled="{!v.isDisable}"/>-->
                                                    <aura:set attribute="else">
                                                        <aura:if isTrue="{!v.res.question.PRM_Question_Type_Nm__c == 'Multiselect'}">
                                                            <ui:inputSelect multiple="true" class="multiple" aura:id="InputSelectMultiple" value="{!v.multiResponse}" change="{!c.handleMultiChange}" disabled="{!v.isDisable}">
                                                                <aura:iteration items="{!v.res.answers}"  var="val">  
                                                                    <ui:inputSelectOption text="{!val.PRM_Answer_Display_Txt__c}" />
                                                                </aura:iteration> 
                                                            </ui:inputSelect>
                                                        </aura:if>
                                                    </aura:set>		
                                                </aura:if>
                                            </aura:set>		
                                        </aura:if>
                                    </aura:set>									                                    
                                </aura:if>
                            </aura:set>
                        </aura:if>
                    </td>
                </tr>
    <!-- DOM ends here -->
</aura:component>