    <aura:handler name="init" value="{!this}" action="{!c.init}"/>    
    <h2> In to navigation comp</h2>
    <aura:if isTrue="{!v.truthy}">
   
 <div>
        <c:core_OppurtunitySupportButton/>
 </div>
</aura:if> 
</aura:component>