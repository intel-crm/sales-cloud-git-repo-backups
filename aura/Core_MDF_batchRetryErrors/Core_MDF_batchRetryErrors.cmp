<aura:component controller="Core_MDF_SubmitLogForRetry" implements="force:hasRecordId,force:lightningQuickAction" >
    
    <aura:attribute name="recordId" type="Id"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <p>Submitting for Retry</p>
    
</aura:component>