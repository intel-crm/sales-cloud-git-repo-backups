<aura:component implements="lightning:actionOverride,force:hasSObjectName"
                access="global">

    <aura:attribute name="flowName" type="String"/>

    <aura:handler name="init"
                  value="{!this}"
                  action="{!c.doInit}"/>

    <lightning:overlayLibrary aura:id="overlayLib"/>

</aura:component>