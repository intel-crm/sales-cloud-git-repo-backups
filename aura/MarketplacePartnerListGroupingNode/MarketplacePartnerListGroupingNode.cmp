<aura:component extends="c:MarketplaceRedux"  >
    <aura:set attribute="storeName" value="Search" /><!--Added as part of code merge [09/15]-->
	<!--<aura:attribute name="storeName" type="string" default="Search" />--><!--Commented as part of code merge [09/15]-->

	<aura:attribute name="label" type="string" default=""/>
	<aura:attribute name="id" type="string" default=""/>
	<aura:attribute name="contextualFilterId" type="string" default=""/>
	<aura:attribute name="open" type="boolean" default="false"/>
	<aura:attribute name="children" type="object[]" default="[]"/>

	<aura:handler name="init" value="{!this}" action="{!c.doInit}" />


	<div class="cursor">
		<div class="slds-m-bottom_xx-small node">
			<a href="#" class="color-dark-gray" onclick="{!c.handleToggleOpenPartnerGroup}">
				<span class="toggleIcon">
					<lightning:icon
						class="slds-m-right_xx-small cursor"
						iconName="{!v.open ? 'utility:dash' : 'utility:add'}" />
				</span>
				<span class="nodeTitle">{!v.label}</span>&nbsp;
				<span class="{!('' + v.children.length == '0') ? 'textSuperLight' : 'textLight'}">({!v.children.length})</span>
			</a>
			<aura:if isTrue="{!v.open}">
				<div class="level2 slds-p-vertical_x-small">
					<aura:iteration items="{!v.children}" var="item" indexVar="i">
						<c:MarketplaceSearchContextualFilter
								id="{!item.value}"
								name="{!item.label}"
								count="{!item.count}"
								children="{!item.children}"
								selectedList="{!v.state.selectedDraftFilters}"
								selectedListId="{!v.contextualFilterId}"
								display="checkbox"
								applyToDraft="true"								
							/>
						</aura:iteration>
					</div>
			</aura:if>
		</div>
	</div>
</aura:component>