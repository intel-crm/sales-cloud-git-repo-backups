<aura:component>

    <aura:attribute name="radio" type="Object" />
    <aura:attribute name="name" type="String" />
    <aura:attribute name="onchange" type="Object" />
    <aura:attribute name="disabled" type="Boolean" default="false" />

    <lightning:input aura:id="input"
                     class="{!join(' ', 'slds-p-vertical_xxx-small', 'slds-m-vertical_xxx-small', v.radio.highlight ? 'highlight' : '')}"
                     name="{!v.name}"
                     checked="{!v.radio.isSelected}"
                     disabled="{!or(v.disabled, v.radio.disabled)}"
                     type="radio"
                     label="{!v.radio.label}"
                     value="{!v.radio.value}"
                     onchange="{!c.handleChange}" />

    <aura:iteration items="{!v.radio.children}" var="child">
        <div class="slds-p-left_large">
            <c:MarketplaceFormRadioChild name="{!v.name + '__child'}"
                                 disabled="{!v.disabled}"
                                 radio="{!child}"
                                 onchange="{!v.onchange}" />
        </div>

    </aura:iteration>
</aura:component>