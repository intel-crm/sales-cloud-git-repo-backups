                    <ui:inputSelect label="Operator" class="slds-input" value="{!v.approvalCriteria.Core_MDF_Operator_4__c}">
                        <aura:iteration items="{!v.operatorOptions}" var="item">
                            <option text="{!item.label}" value="{!item.value}" selected="{!item.value == v.approvalCriteria.Core_MDF_Operator_4__c}"/>
