                <td style="width:27%;padding: 0 8px 8px 0;">
                    <ui:inputSelect label="Operator" class="slds-input" value="{!v.approvalCriteria.Core_MDF_Operator_6__c}">
                        <aura:iteration items="{!v.operatorOptions}" var="item">
