            <tr>
                <td style="width:27%;padding: 0 8px 8px 0;">
                    <ui:inputSelect label="Field" class="slds-input"  value="{!v.approvalCriteria.Core_MDF_Field_Name_5__c}">
                        <aura:iteration items="{!v.options}" var="item">
                            <option text="{!item.label}" value="{!item.value}" selected="{!item.value == v.approvalCriteria.Core_MDF_Field_Name_5__c}"/>
