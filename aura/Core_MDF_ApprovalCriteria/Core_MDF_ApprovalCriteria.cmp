                </td>
                <td style="width:27%;padding: 0 8px 8px 0;">
                    <ui:inputSelect label="Operator" class="slds-input" value="{!v.approvalCriteria.Core_MDF_Operator_5__c}">
                        <aura:iteration items="{!v.operatorOptions}" var="item">
                            <option text="{!item.label}" value="{!item.value}" selected="{!item.value == v.approvalCriteria.Core_MDF_Operator_5__c}"/>
                        </aura:iteration>
                    </ui:inputSelect>            
                </td>
                <td style="width:27%;padding: 0 8px 8px 0;">				
                    <lightning:input label ="Value" value="{!v.approvalCriteria.Core_MDF_Value_5__c}" />
                </td>
            </tr><br></br> 
            
            <h3>Approval Criteria 6</h3>
            <tr>
                <td style="width:27%;padding: 0 8px 8px 0;">
                    <ui:inputSelect label="Field" class="slds-input"  value="{!v.approvalCriteria.Core_MDF_Field_Name_6__c}">
                        <aura:iteration items="{!v.options}" var="item">
                            <option text="{!item.label}" value="{!item.value}" selected="{!item.value == v.approvalCriteria.Core_MDF_Field_Name_6__c}"/>
