                    <ui:inputSelect label="Field" class="slds-input"  value="{!v.approvalCriteria.Core_MDF_Field_Name_9__c}">
                        <aura:iteration items="{!v.options}" var="item">
                            <option text="{!item.label}" value="{!item.value}" selected="{!item.value == v.approvalCriteria.Core_MDF_Field_Name_9__c}"/>
