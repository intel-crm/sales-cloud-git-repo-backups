<aura:component
  access="global"
  implements="flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes"
  Controller="Core_MDF_PartnerFundRequestCreatePage"
>
  <aura:attribute
    type="PartnerFundRequest"
    name="newPFRq"
    default="{Core_MDF_Incentive_Opted_In_ind__c:'',Core_MDF_Incentive_Question_ind__c:''}"
  ></aura:attribute>
  <aura:attribute
    name="IncentiveQuestionLbl"
    type="String"
    description="Localised label for Incentive Question"
  />
  <aura:attribute
    name="IncentiveOptInLbl"
    type="String"
    description="Localised label for Incentive Opt In Question"
  />
  <aura:registerEvent
    name="dynamicQuestionEvt"
    type="c:Core_MDF_DynamicQuestionEvent"
  />
  <aura:attribute
    name="disabled"
    type="Boolean"
    default="false"
    description="Conditionally disabling the questions functionality"
  />

  <aura:attribute type="boolean" name="showVR" default="false" />
  <aura:attribute type="boolean" name="showVROptIn" default="false" />
  <aura:attribute
    type="PartnerfundRequest[]"
    name="VRdata"
    default=""
    description="Stores the PFR VR data from server side"
  ></aura:attribute>
  <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

  <aura:if isTrue="{!v.showVR}">
    <div class="slds-card">
      <div class="slds-p-around_large">
        <lightning:layout horizontalAlign="spread" multipleRows="true">
          <lightning:layoutItem
            padding="around-small"
            flexibility="grow"
            size="3"
            mediumDeviceSize="3"
            largeDeviceSize="3"
          ></lightning:layoutItem>

          <lightning:layoutItem
            padding="around-small"
            flexibility="grow"
            size="3"
            mediumDeviceSize="3"
            largeDeviceSize="3"
          >
            <lightning:select
              value="{!v.newPFRq.Core_MDF_Incentive_Question_ind__c}"
              required="true"
              name="Incentive Question"
              label="{!v.IncentiveQuestionLbl}"
              disabled="{!v.disabled}"
              onchange="{!c.handleResponse}"
            >
              <option value="No">{!$Label.c.Core_MDF_DQNo}</option>
              <option value="Yes">{!$Label.c.Core_MDF_DQYes}</option>
            </lightning:select>
          </lightning:layoutItem>

          <lightning:layoutItem
            padding="around-small"
            flexibility="grow"
            size="3"
            mediumDeviceSize="3"
            largeDeviceSize="3"
          >
            <aura:if isTrue="{!v.showVROptIn}">
              <lightning:select
                value="{!v.newPFRq.Core_MDF_Incentive_Opted_In_ind__c}"
                required="true"
                name="Incentive Opt In"
                label="{!$Label.c.Core_MDF_VRInc_OptIn_Question}"
                disabled="{!v.disabled}"
                onchange="{!c.loadQuestion}"
              >
                <option value="No">{!$Label.c.Core_MDF_DQNo}</option>
                <option value="Yes">{!$Label.c.Core_MDF_DQYes}</option>
              </lightning:select>
            </aura:if>
          </lightning:layoutItem>

          <lightning:layoutItem
            padding="around-small"
            flexibility="grow"
            size="3"
            mediumDeviceSize="3"
            largeDeviceSize="3"
          ></lightning:layoutItem>
        </lightning:layout>
      </div>
    </div>
  </aura:if>
</aura:component>