<aura:component access="global" implements="flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes"
                Controller="Core_MDF_PartnerFundRequestCreatePage">
    <aura:attribute type="PartnerFundRequest" name="newPFRq"
                    default="{Core_MDF_Incentive_Opted_In_ind__c:'',Core_MDF_Incentive_Question_ind__c:''}"></aura:attribute>
    <aura:attribute name="IncentiveQuestionLbl" type="String" description="Localised label for Incentive Question" />
    <aura:attribute name="IncentiveOptInLbl" type="String" description="Localised label for Incentive Opt In Question" />
    <aura:registerEvent name="dynamicQuestionEvt" type="c:Core_MDF_DynamicQuestionEvent" />
    <aura:attribute name="disabled" type="Boolean" default="false"
                    description="Conditionally disabling the questions functionality" />
    
    <aura:attribute type="boolean" name="showVR" default="false" />
    <aura:attribute type="boolean" name="showVROptIn" default="false" />
    <aura:attribute type="PartnerfundRequest[]" name="VRdata" default=""
                    description="Stores the PFR VR data from server side"></aura:attribute>
    
    <aura:attribute name="vrQuestionList" type="String[]" />  
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <aura:if isTrue="{!v.showVR}">
        <aura:iteration items="{!v.vrQuestionList}" var="item"> 
            <div class="slds-card">
                <div class="c-container">
                    <lightning:layout horizontalAlign="center" multipleRows="true">
                        <aura:if isTrue="{!item.pmemIncentive}">
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="12" smallDeviceSize="12" mediumDeviceSize="5" largeDeviceSize="5">
                                <lightning:select value="{!v.newPFRq.Core_MDF_Incentive_Question_ind__c}" required="true"
                                                  name="Core_MDF_Incentive_Question_ind__c" label="{!v.IncentiveQuestionLbl}" disabled="{!v.disabled}"
                                                  onchange="{!c.handleResponse}">
                                    <option value="No">{!$Label.c.Core_MDF_DQNo}</option>
                                    <option value="Yes">{!$Label.c.Core_MDF_DQYes}</option>
                                </lightning:select>
                            </lightning:layoutItem>
                             </aura:if>  
                            <aura:if isTrue="{!item.otherIncentive}">
                                <lightning:layoutItem padding="around-small" flexibility="grow" size="12" smallDeviceSize="12" mediumDeviceSize="5" largeDeviceSize="5">     
                                  <lightning:select value="{!item.answer}" required="true" onchange="{!c.loadQuestion}" name="Core_MDF_Incentive_Opted_In_ind__c"
                                                      label="{!item.question}" disabled = "{!v.disabled}">
                                        <option value="No">{!$Label.c.Core_MDF_DQNo}</option>
                                        <option value="Yes">{!$Label.c.Core_MDF_DQYes}</option>
                                    </lightning:select> 
                                </lightning:layoutItem>
                            </aura:if>
                    </lightning:layout>
                </div>
            </div>
        </aura:iteration>
    </aura:if> 
    
</aura:component>