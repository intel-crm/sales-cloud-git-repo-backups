<aura:component
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,lightning:actionOverride"
    access="global" Controller="Core_MDF_PartnerFundRequestCreatePage">

    <aura:html tag="style">
        .slds-modal__container{
        max-width: 70rem !important;
        width:95% !important;
        }
        .budget-table-container {
            margin-top: 1rem;
            border: 1px solid #d8dce6;
            border-radius: 4px;
            padding: 1rem;
            background-color: #f7f9fb;
        }
        .budget-table {
            width: 100%;
            border-collapse: collapse;
        }
        .budget-table thead {
            background-color: #e5e7eb;
        }
        .budget-table th,
        .budget-table td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 1px solid #d8dce6;
        }
        .budget-table th {
            font-weight: 600;
            color: #333;
        }
        .budget-table tbody tr:hover {
            background-color: #f0f1f3;
        }
        .percentage-input {
            width: 180px;
        }
        .amount-wrapper {
            display: flex;
            align-items: center;
        }
        .currency-prefix {
            margin-right: 0.25rem;
            font-weight: 600;
        }
        .budget-table th:nth-child(2),
        .budget-table td:nth-child(2) {
            width: 230px;
        }
        .budget-table th:nth-child(3),
        .budget-table td:nth-child(3) {
            width: 70px;
            text-align: center;
        }
        .budget-select {
            width: 100%;
            padding: 0.5rem;
            border: 1px solid #bfbfbf;
            border-radius: 4px;
            font-size: 0.875rem;
        }
        .action-button {
            margin-right: 0.5rem;
        }
        .total-row {
            background-color: #fffbea;
            font-weight: 600;
        }
        .validation-error {
            color: #c23030;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }
        .success-message {
            color: #2e7d32;
            font-size: 0.875rem;
        }
        .info-box {
            background-color: #e8f4fd;
            border: 1px solid #b3d9f7;
            border-radius: 4px;
            padding: 0.75rem;
            margin-top: 0.75rem;
            font-size: 0.875rem;
        }
        .error-box {
            background-color: #fdecea;
            border: 1px solid #f5c6cb;
            border-radius: 4px;
            padding: 0.75rem;
            margin-top: 0.75rem;
            font-size: 0.875rem;
            color: #c23030;
        }
        .disabled-input {
            background-color: #f3f3f3;
            cursor: not-allowed;
        }
        .remaining-positive {
            color: #2e7d32;
            font-weight: 600;
        }
        .remaining-negative {
            color: #c23030;
            font-weight: 600;
        }
    </aura:html>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Essential Record and UI Control Attributes                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="showSpinner" type="Boolean" default="false" />
    <aura:attribute name="mode" type="String" default="create" />
    <aura:attribute name="checkCloneAttribute" type="Boolean" default="false" />
    <aura:attribute name="checkCloneRecordId" type="String" default="" />
    <aura:attribute name="showPCTApprovalCheckbox" type="Boolean" default="false"
        description="Show PCT Approval checkbox when Incentive is selected" />
    <aura:attribute name="isAdditionalReviewReqd" type="Boolean" default="false" />
    <aura:attribute name="isLoggedInUserLevelOneApprover" type="Boolean" default="false" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- RecordType Attributes                                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <aura:attribute name="recordtype" type="String" default="" description="RecordType ID" />
    <aura:attribute name="recordtypeName" type="String" default="" description="RecordType Name" />
    <aura:attribute name="recordtypeDeveloperName" type="String" default="" description="RecordType Developer Name" />
    <aura:attribute name="checkNewCommunityAttribute" type="Boolean" default="false" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Reference to parent component                               -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <aura:attribute name="parentComponent" type="Object" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Core PFR Object Attributes                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <aura:attribute type="PartnerFundRequest" name="newPFR" default="{
        Title:'',
        RequestedAmount:0,
        Core_MDF_Start_Date__c:'',
        Core_MDF_End_Date__c:'',
        Core_MDF_Activity_Description__c:'',
        Core_MDF_Budget_Type_nm__c:'',
        Core_MDF_Maximum_Intel_Investment_amt__c:0,
        Core_MDF_Activity_Reimbursement_Amt_nbr__c:0,
        Core_MDF_Priority_nm__c:'',
        Core_MDF_Outcome_Region_nm__c:'',
        Core_MDF_Country_nm__c:'',
        Core_MDF_TargetAudience_nm__c:'',
        Core_MDF_ProductType__c:'',
        Core_MDF_Is_Outcome_Based_Ind__c:true,
        Core_MDF_Skip_PCT_Approval_ind__c:false,
        Core_MDF_Attribution_Variance_Pos_txt__c:null,
        Core_MDF_Attribution_Variance_Neg_txt__c:null
    }" description="Stores the field values of the PFR record being created" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Account Lookup                                              -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <aura:attribute name="selectedAccount" type="Account" default="{'sobjectType':'Account',Id:null, Name:''}" />
    <aura:attribute name="additionalAccFilter" type="String" default=""
        description="Additional filter for account lookup" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Selected Values                                             -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <aura:attribute name="selectedFocusArea" type="String" default="" />
    <aura:attribute name="SelPriority" type="String" default="" />
    <aura:attribute name="SelRegion" type="String" default="" />
    <aura:attribute name="countryFilter" type="String" default="" />
    <aura:attribute name="showOtherEcosystemPartner" type="Boolean" default="false" />
    <aura:attribute name="selectedEcosystemPartnerOptions" type="List" default="[]" />
    <aura:attribute name="ecosystemAllocations" type="List" default="[]" />
    <aura:attribute name="selectedInitiativeOptions" type="List" default="[]" />
    <aura:attribute name="selectedBrandOptions" type="List" default="[]" />
    <aura:attribute name="selectedTechnologyOptions" type="List" default="[]" />
    <aura:attribute name="selectedOutcomeMetricOptions" type="List" default="[]" />
    <aura:attribute name="selectedOutcomeTypeOptions" type="List" default="[]" />
    <aura:attribute name="selectedMarketingOutcomeMetricOptions" type="List" default="[]" />
    <aura:attribute name="selectedBusinessOutcomeMetricOptions" type="List" default="[]" />
    <aura:attribute name="selectedMarketingBrandOptions" type="List" default="[]" />
    <aura:attribute name="selectedMarketingTechnologyOptions" type="List" default="[]" />
    <aura:attribute name="selectedBusinessBrandOptions" type="List" default="[]" />
    <aura:attribute name="selectedBusinessTechnologyOptions" type="List" default="[]" />
    <aura:attribute name="marketingOtherBrandsTechnologies" type="String" default="" />
    <aura:attribute name="businessOtherBrandsTechnologies" type="String" default="" />
    <aura:attribute name="isLoadingOutcomePurpose" type="Boolean" default="false" />
    <aura:attribute name="selectedTacticsOptions" type="List" default="[]" />
    <aura:attribute name="selectedMeasurementApproachOptions" type="List" default="[]" />
    <aura:attribute name="isSPIFSecAvailable" type="Boolean" default="false" />
    <aura:attribute name="segmentString" type="String" default="" />
    <aura:attribute name="showBudgetErrorMsg" type="Boolean" default="false" />
    <aura:attribute name="showErrorMsgForMaxIntelInvest" type="Boolean" default="false" />
    <aura:attribute name="ErrorMsgForMaxIntelInvest" type="String" default="" />
    <aura:attribute name="showErrorMsgForSpendingLimit" type="Boolean" default="false" />
    <aura:attribute name="ErrorMsgForSpendingLimit" type="String" default="" />
    <aura:attribute name="priority1Error" type="String" default="" />
    <aura:attribute name="showPriority1Error" type="Boolean" default="false" />
    <aura:attribute name="selectedCountryOptions" type="List" default="[]" />
    <aura:attribute name="selectedTargetAudienceOptions" type="List" default="[]" />
    <aura:attribute name="selectedProductTypeOptions" type="List" default="[]" />
    <aura:attribute name="marketingOutcomeMetricOptions" type="List" default="[]" />
    <aura:attribute name="businessOutcomeMetricOptions" type="List" default="[]" />
    <aura:attribute name="activityTacticsOptions" type="List" default="[]" />
    <aura:attribute name="measurementApproachOptions" type="List" default="[]" />
    <aura:attribute name="tacticMetricsValues" type="List" default="[]" />
    <aura:attribute name="ContentDocumentIds" type="List" default="[]" />
    <aura:attribute name="ActivityNodeAccValues" type="List" default="[]" />
    <aura:attribute name="isInitialRecordLoad" type="Boolean" default="false" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Option Maps / Dependent Picklists                           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <aura:attribute name="apitoLabelConvert" type="Map" />
    <aura:attribute name="focusArea" type="Map" />
    <aura:attribute name="focusAreaDependent" type="List" default="[]" />
    <aura:attribute name="AllFocusAreaOptions" type="List" default="[]" />

    <aura:attribute name="priority" type="Map" />
    <aura:attribute name="priorityDependent" type="List" default="[]" />
    <aura:attribute name="priorityValues" type="List" default="[]" />

    <aura:attribute name="regions" type="Map" />
    <aura:attribute name="regionDependants" type="List" default="[]" />
    <aura:attribute name="regionvalues" type="List" default="[]" />

    <aura:attribute name="CountryPicklistValues" type="Map" />
    <aura:attribute name="CountryDependants" type="List" default="[]" />
    <aura:attribute name="AllCountryOptions" type="List" default="[]" />
    <aura:attribute name="AllCountryOptionsMain" type="List" default="[]" />

    <aura:attribute name="audiencePicklistValues" type="Map" />
    <aura:attribute name="MultiTargetAudienceValues" type="List" default="[]" />
    <aura:attribute name="AllTargetAudienceOptions" type="List" default="[]" />

    <aura:attribute name="ProductTypes" type="Map" />
    <aura:attribute name="ProductTypeDependent" type="List" default="[]" />
    <aura:attribute name="ProductTypeValues" type="List" default="[]" />

    <aura:attribute name="MultiBrandTypes" type="Map" />
    <aura:attribute name="MultiBrandValues" type="List" default="[]" />
    <aura:attribute name="AllBrandOptions" type="List" default="[]" />

    <aura:attribute name="initiativePicklistValues" type="Map" />
    <aura:attribute name="MultiInitiativeValues" type="List" default="[]" />
    <aura:attribute name="AllInitiativeOptions" type="List" default="[]" />

    <aura:attribute name="MultiEcoPartnerTypes" type="Map" />
    <aura:attribute name="MultiEcoPartnerValues" type="List" default="[]" />
    <aura:attribute name="AllEcosystemPartner" type="List" default="[]" />

    <aura:attribute name="technologies" type="Map" />
    <aura:attribute name="technologiesDependant" type="List" default="[]" />
    <aura:attribute name="AllTechnologyOptions" type="List" default="[]" />

    <aura:attribute name="outcomes" type="Map" />
    <aura:attribute name="outcomesDependants" type="List" default="[]" />
    <aura:attribute name="outcomeMetricOptions" type="List" default="[]" />

    <aura:attribute name="measurementApproachPicklistValues" type="Map" />
    <aura:attribute name="measurementApproachValues" type="List" default="[]" />

    <aura:attribute name="budgetTypeVal" type="List" default="[]" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Budget Allocation Table Attributes                          -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <aura:attribute name="availableBudgets" type="List" default="[]" />
    <aura:attribute name="budgetAllocations" type="List" default="[]" />
    <aura:attribute name="budgetValidationError" type="String" default="" />
    <aura:attribute name="totalPercentageAllocation" type="Decimal" default="0" />
    <aura:attribute name="totalAllocatedAmount" type="Decimal" default="0" />
    <aura:attribute name="remainingAmount" type="Decimal" default="0" />
    <aura:attribute name="showBudgetTable" type="Boolean" default="false" />
    <aura:attribute name="budgetHelpMessage" type="String" default="" />
    <aura:attribute name="isShowAllocationAmt" type="Boolean" default="false" />
    <aura:attribute name="showAllocationAmtMsg" type="String" default="" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Navigation                                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <lightning:navigation aura:id="navService" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Event Handlers                                              -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.SelRegion}" action="{!c.onRegionChange}" />
    <aura:handler name="change" value="{!v.SelPriority}" action="{!c.handlePriority1Change}" />
    <aura:handler name="change" value="{!v.countryFilter}" action="{!c.filterCountry}" />
    <aura:handler name="change" value="{!v.selectedCountryOptions}" action="{!c.onCountryChange}" />
    <aura:handler name="change" value="{!v.selectedTargetAudienceOptions}" action="{!c.onTargetAudienceChange}" />
    <aura:handler name="change" value="{!v.selectedProductTypeOptions}" action="{!c.onProductTypeChange}" />
    <aura:handler name="change" value="{!v.selectedInitiativeOptions}" action="{!c.onInitiativeChange}" />
    <aura:handler name="change" value="{!v.selectedEcosystemPartnerOptions}" action="{!c.onEcoPartnerChange}" />
    <aura:handler name="change" value="{!v.selectedMarketingOutcomeMetricOptions}" action="{!c.onMarketingOutcomeMetricChange}" />
    <aura:handler name="change" value="{!v.selectedBusinessOutcomeMetricOptions}" action="{!c.onBusinessOutcomeMetricChange}" />
    <aura:handler name="change" value="{!v.selectedMarketingBrandOptions}" action="{!c.onMarketingBrandChange}" />
    <aura:handler name="change" value="{!v.selectedMarketingTechnologyOptions}" action="{!c.onMarketingTechnologyChange}" />
    <aura:handler name="change" value="{!v.selectedBusinessBrandOptions}" action="{!c.onBusinessBrandChange}" />
    <aura:handler name="change" value="{!v.selectedBusinessTechnologyOptions}" action="{!c.onBusinessTechnologyChange}" />
    <aura:handler name="change" value="{!v.selectedTacticsOptions}" action="{!c.onTacticsChange}" />
    <aura:handler name="change" value="{!v.selectedMeasurementApproachOptions}" action="{!c.onMeasurementApproachChange}" />
    <aura:handler name="change" value="{!v.selectedAccount}" action="{!c.resetAccountattributes}" />
    <aura:handler name="change" value="{!v.newPFR.Core_MDF_Budget_Type_nm__c}" action="{!c.onBudgetTypeChange}" />

    <!-- Spinner -->
    <aura:if isTrue="{!v.showSpinner}">
        <lightning:spinner alternativeText="Loading" size="large" class="slds-is-fixed" />
    </aura:if>

    <div class="slds-p-around_medium">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: DETAILS                                        -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <h3 class="slds-text-heading_small slds-m-bottom_small">Details</h3>
        <lightning:layout horizontalAlign="spread" multipleRows="true">

            <!-- Title -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <lightning:input
                    aura:id="NewForm"
                    label="{!$Label.c.Core_MDF_Name}"
                    name="Title"
                    value="{!v.newPFR.Title}"
                    required="true" />
            </lightning:layoutItem>

            <!-- Account Lookup -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <c:Core_Intel_customLookup
                    objectAPIName="Account"
                    selectedRecord="{!v.selectedAccount}"
                    label="{!$Label.c.Core_MDF_Account}"
                    IconName="standard:account"
                    disabled="false" />
            </lightning:layoutItem>

            <!-- Start Date -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <lightning:input
                    type="date"
                    aura:id="NewForm"
                    label="{!$Label.c.Core_MDF_Start_Date}"
                    value="{!v.newPFR.Core_MDF_Start_Date__c}"
                    required="true"
                    onchange="{!c.onDateChange}" />
            </lightning:layoutItem>

            <!-- End Date -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <lightning:input
                    type="date"
                    aura:id="NewForm"
                    label="{!$Label.c.Core_MDF_End_Date}"
                    value="{!v.newPFR.Core_MDF_End_Date__c}"
                    required="true"
                    onchange="{!c.onDateChange}" />
            </lightning:layoutItem>

            <!-- Activity Description -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                mediumDeviceSize="5" largeDeviceSize="5">
                <lightning:textarea
                    aura:id="NewForm"
                    label="{!$Label.c.Core_MDF_Activity_Description_Outcome_Based}"
                    name="Description"
                    value="{!v.newPFR.Core_MDF_Activity_Description__c}"
                    required="true" />
            </lightning:layoutItem>

            <!-- Budget Type -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <c:Core_MDF_Picklist
                    aura:id="BudgetTypeField"
                    objName="PartnerFundRequest"
                    fldName="Core_MDF_Budget_Type_nm__c"
                    isRequired="true"
                    recTypeName="{!v.recordtypeName}"
                    selectedValue="{!v.newPFR.Core_MDF_Budget_Type_nm__c}"
                    dispLabel="{!$Label.c.Core_MDF_Budget_Type}"
                    recTypeDevName="{!v.recordtypeDeveloperName}"
                    options="{!v.budgetTypeVal}"
                    fetchPicklistValuesFromCampaign="false" />
            </lightning:layoutItem>

            <!-- Total Investment -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <lightning:input
                    type="number"
                    formatter="currency"
                    step="0.01"
                    label="{!$Label.c.Core_MDF_Activity_Total_Investment}"
                    value="{!v.newPFR.RequestedAmount}"
                    onchange="{!c.onTotalInvestmentChange}" />
            </lightning:layoutItem>

            <!-- Maximum Intel Investment -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <lightning:input
                    type="number"
                    formatter="currency"
                    step="0.01"
                    label="{!$Label.c.Core_MDF_Maximum_Intel_Investment}"
                    value="{!v.newPFR.Core_MDF_Maximum_Intel_Investment_amt__c}"
                    onchange="{!c.onMaxIntelInvestmentChange}" />
            </lightning:layoutItem>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- BUDGET ALLOCATION TABLE                             -->
            <!-- ═══════════════════════════════════════════════════ -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="12">
                <h4 class="slds-text-heading_small slds-m-bottom_small">
                    {!$Label.c.Core_MDF_Available_Budget_Label}
                </h4>

                <aura:if isTrue="{!v.showBudgetTable}">
                    <div class="budget-table-container">
                        <table class="budget-table">
                            <thead>
                                <tr>
                                    <th>Budget Name</th>
                                    <th>Amount</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <aura:iteration items="{!v.budgetAllocations}" var="allocation" indexVar="index">
                                    <tr>
                                        <td>
                                            <lightning:select
                                                name="{!'budgetSelect_' + index}"
                                                value="{!allocation.budgetId}"
                                                onchange="{!c.onBudgetSelect}"
                                                class="budget-select">
                                                <option value="" text="-- Select a Budget --" />
                                                <aura:iteration items="{!v.availableBudgets}" var="budget">
                                                    <option
                                                        value="{!budget.budgetId}"
                                                        text="{!budget.displayLabel}" />
                                                </aura:iteration>
                                            </lightning:select>
                                        </td>
                                        <td>
                                            <div class="amount-wrapper">
                                                <span class="currency-prefix">$</span>
                                                <lightning:input
                                                    type="number"
                                                    variant="label-hidden"
                                                    label="Amount"
                                                    name="{!'budgetAmount_' + index}"
                                                    min="0"
                                                    step="0.01"
                                                    value="{!allocation.allocatedAmount}"
                                                    onblur="{!c.onAmountChange}"
                                                    class="percentage-input"
                                                    disabled="{!allocation.budgetId == ''}" />
                                            </div>
                                            <aura:if isTrue="{!not(empty(allocation.amountError))}">
                                                <p class="validation-error">{!allocation.amountError}</p>
                                            </aura:if>
                                        </td>
                                        <td>
                                            <lightning:buttonIcon
                                                variant="bare"
                                                iconName="utility:delete"
                                                alternativeText="Remove"
                                                title="Remove"
                                                name="{!'budgetDelete_' + index}"
                                                onclick="{!c.removeBudgetAllocation}"
                                                class="action-button" />
                                        </td>
                                    </tr>
                                </aura:iteration>

                            </tbody>
                        </table>

                        <!-- Global Validation Error -->
                        <aura:if isTrue="{!not(empty(v.budgetValidationError))}">
                            <div class="error-box">
                                <lightning:icon iconName="utility:error" size="x-small"
                                    class="slds-m-right_x-small" />
                                {!v.budgetValidationError}
                            </div>
                        </aura:if>

                        <!-- Max Intel Investment Info Bar -->
                        <aura:if isTrue="{!v.newPFR.Core_MDF_Maximum_Intel_Investment_amt__c > 0}">
                            <div class="info-box">
                                <lightning:layout>
                                    <lightning:layoutItem size="4">
                                        <strong>Max Intel Investment: </strong>
                                        <lightning:formattedNumber
                                            value="{!v.newPFR.Core_MDF_Maximum_Intel_Investment_amt__c}"
                                            style="currency" currencyCode="USD"
                                            minimumFractionDigits="2" maximumFractionDigits="2" />
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="4">
                                        <strong>Total Allocated: </strong>
                                        <lightning:formattedNumber
                                            value="{!v.totalAllocatedAmount}"
                                            style="currency" currencyCode="USD"
                                            minimumFractionDigits="2" maximumFractionDigits="2" />
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="4">
                                        <strong>Remaining: </strong>
                                        <span class="{!v.remainingAmount >= 0 ? 'remaining-positive' : 'remaining-negative'}">
                                            <lightning:formattedNumber
                                                value="{!v.remainingAmount}"
                                                style="currency" currencyCode="USD"
                                                minimumFractionDigits="2" maximumFractionDigits="2" />
                                        </span>
                                    </lightning:layoutItem>
                                </lightning:layout>
                            </div>
                        </aura:if>
                    </div>

                    <!-- Add Budget Row Button -->
                    <lightning:button
                        variant="brand"
                        label="+ Add Budget Row"
                        onclick="{!c.addBudgetAllocation}"
                        class="slds-m-top_small" />
                </aura:if>

                <!-- No Budget Type Selected Message -->
                <aura:if isTrue="{!not(v.showBudgetTable)}">
                    <div class="slds-box slds-theme_shade">
                        <p class="slds-text-color_weak">
                            <lightning:icon iconName="utility:info" size="x-small"
                                class="slds-m-right_x-small" />
                            Please select a Budget Type above to add budget allocations.
                        </p>
                    </div>
                </aura:if>
            </lightning:layoutItem>

            <!-- Additional Review Checkbox -->
            <aura:if isTrue="{!and(v.isLoggedInUserLevelOneApprover, not(empty(v.newPFR.Core_MDF_Budget_Type_nm__c)))}">
                <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                    <aura:if isTrue="{!or(
                        v.newPFR.Core_MDF_Budget_Type_nm__c == $Label.c.Core_MDF_BudgetType_CMP,
                        v.newPFR.Core_MDF_Budget_Type_nm__c == $Label.c.Core_MDF_BudgetType_SP_CMP)}">
                        <lightning:input
                            type="checkbox"
                            name="isAdditionalReviewReqd"
                            label="{!$Label.c.Core_MDF_Field_Review + '?'}"
                            aura:id="NewForm"
                            checked="{!v.isAdditionalReviewReqd}" />
                        <aura:set attribute="else">
                            <aura:if isTrue="{!or(
                                v.newPFR.Core_MDF_Budget_Type_nm__c == $Label.c.Core_MDF_BudgetType_MDF,
                                v.newPFR.Core_MDF_Budget_Type_nm__c == $Label.c.Core_MDF_BudgetType_MDFPlus)}">
                                <lightning:input
                                    type="checkbox"
                                    name="isAdditionalReviewReqd"
                                    label="{!$Label.c.Core_MDF_Marketing_Review + '?'}"
                                    aura:id="NewForm"
                                    checked="{!v.isAdditionalReviewReqd}" />
                            </aura:if>
                        </aura:set>
                    </aura:if>
                </lightning:layoutItem>
            </aura:if>

            <!-- Outcome Based Acc Node -->
            <lightning:layoutItem padding="around-small" flexibility="grow" size="12">
                <c:core_MDF_Outcome_Based_Acc_Node
                    aura:id="activityAccNode"
                    recordId="{!v.recordId}"
                    parentAccountId="{!v.selectedAccount.Id}"
                    totalAmount="{!v.newPFR.Core_MDF_Maximum_Intel_Investment_amt__c}"
                    mode="{!v.mode}"
                    budgetId=""
                    editable="false" />
            </lightning:layoutItem>
        </lightning:layout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: PRIORITY / REGION                              -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <lightning:layout horizontalAlign="spread" multipleRows="true">
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <c:Core_MDF_Picklist
                    aura:id="Priority1Field"
                    objName="PartnerFundRequest"
                    fldName="Core_MDF_Priorities__c"
                    isRequired="true"
                    recTypeName="{!v.recordtypeName}"
                    selectedValue="{!v.SelPriority}"
                    dispLabel="{!$Label.c.Core_MDF_Priority}"
                    recTypeDevName="{!v.recordtypeDeveloperName}"
                    options="{!v.priorityValues}"
                    fetchPicklistValuesFromCampaign="false"
                    labelValueMap="{!v.apitoLabelConvert}" />
            </lightning:layoutItem>

            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <lightning:select
                    aura:id="RegionField"
                    name="Region"
                    label="{!$Label.c.Core_MDF_RegionLabel}"
                    value="{!v.SelRegion}"
                    onchange="{!c.onRegionChange}">
                    <aura:iteration items="{!v.regionvalues}" var="item">
                        <option value="{!item.value}" text="{!item.label}" />
                    </aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
        </lightning:layout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: MARKET / AUDIENCE                              -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <lightning:layout horizontalAlign="spread" multipleRows="true">
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <c:Core_MDF_CountryDropdownMultiSelect
                    aura:id="CountryField"
                    isRequired="true"
                    dispLabel="{!$Label.c.Core_MDF_Market}"
                    availableOptions="{!v.AllCountryOptions}"
                    selectedOptions="{!v.selectedCountryOptions}"
                    showSelectedSection="true"
                    selectedSectionLabel="Selected Markets"
                    availableSectionLabel="Available Markets" />
            </lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <c:Core_MDF_CountryDropdownMultiSelect
                    aura:id="TargetAudienceField"
                    isRequired="true"
                    dispLabel="{!$Label.c.Core_MDF_Target_Audience}"
                    searchPlaceholder="Search target audience"
                    emptyMessage="No target audience values available"
                    requiredMessage="Please select at least one target audience."
                    availableOptions="{!v.AllTargetAudienceOptions}"
                    selectedOptions="{!v.selectedTargetAudienceOptions}"
                    showSelectedSection="true"
                    selectedSectionLabel="Selected Target Audiences"
                    availableSectionLabel="Available Target Audiences" />
            </lightning:layoutItem>
        </lightning:layout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: PRODUCT TYPE / ECOSYSTEM PARTNER               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <lightning:layout horizontalAlign="spread" multipleRows="true">
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <c:Core_MDF_CustomMultiSelectPicklist
                    objName="PartnerFundRequest"
                    fldName="Core_MDF_ProductType__c"
                    isRequired="true"
                    RecId="{!v.recordId}"
                    dispLabel="{!$Label.c.Core_MDF_Product_Type}"
                    availableOptions="{!v.ProductTypeValues}"
                    selectedOptions="{!v.selectedProductTypeOptions}" />
            </lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <c:Core_MDF_CustomMultiSelectPicklist
                    objName="PartnerFundRequest"
                    fldName="Core_MDF_Channel_Partner__c"
                    isRequired="true"
                    RecId="{!v.recordId}"
                    dispLabel="{!$Label.c.Core_MDF_EcoSystem_Partner}"
                    availableOptions="{!v.AllEcosystemPartner}"
                    selectedOptions="{!v.selectedEcosystemPartnerOptions}" />
            </lightning:layoutItem>

            <aura:if isTrue="{!v.showOtherEcosystemPartner}">
                <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                    <lightning:input
                        type="text"
                        label="Other Ecosystem Partner"
                        value="{!v.newPFR.Core_MDF_Other_Channel_Partner__c}" />
                </lightning:layoutItem>
            </aura:if>

            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <c:core_MDF_ecosystemPartnerAllocation
                    aura:id="ecosystemAllocation"
                    selectedEcosystemPartnerOptions="{!v.selectedEcosystemPartnerOptions}"
                    mode="{!v.mode}"
                    recordId="{!v.recordId}"
                    editable="true"
                    onecosystempartnerremove="{!c.handleEcosystemPartnerRemove}" />
            </lightning:layoutItem>

            <lightning:layoutItem padding="around-small" flexibility="grow" size="6">
                <lightning:input
                    aura:id="NewForm"
                    label="{!$Label.c.Core_MDF_Member_Owner}"
                    name="Core_MDF_Member_Owner_txt__c"
                    value="{!v.newPFR.Core_MDF_Member_Owner_txt__c}"
                    required="false" />
            </lightning:layoutItem>
        </lightning:layout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: OUTCOME METRICS                                -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <lightning:layout horizontalAlign="spread" multipleRows="true">
            <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>

            <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5">
                <c:Core_MDF_CustomMultiSelectPicklist
                    objName="PartnerFundRequest"
                    fldName="Core_MDF_Outcomes_nm__c"
                    isRequired="false"
                    RecId="{!v.recordId}"
                    dispLabel="{!$Label.c.Core_MDF_Marketing_Outcome_Metric}"
                    availableOptions="{!v.marketingOutcomeMetricOptions}"
                    selectedOptions="{!v.selectedMarketingOutcomeMetricOptions}" />
            </lightning:layoutItem>

            <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5">
                <c:Core_MDF_CustomMultiSelectPicklist
                    objName="PartnerFundRequest"
                    fldName="Core_MDF_Outcomes_nm__c"
                    isRequired="false"
                    RecId="{!v.recordId}"
                    dispLabel="{!$Label.c.Core_MDF_Business_Outcome_Metric}"
                    availableOptions="{!v.businessOutcomeMetricOptions}"
                    selectedOptions="{!v.selectedBusinessOutcomeMetricOptions}" />
            </lightning:layoutItem>

            <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
        </lightning:layout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: CAMPAIGN PURPOSE                               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <aura:if isTrue="{!or(not(empty(v.selectedMarketingOutcomeMetricOptions)),not(empty(v.selectedBusinessOutcomeMetricOptions)))}">
            <lightning:layout class="slds-page-header slds-page-header--object-home">
                <lightning:layoutItem padding="horizontal-small" size="12">
                    <div class="page-section page-header">
                        <h1 class="header-title">{!$Label.c.Core_MDF_Activity_Purpose_Header}</h1>
                    </div>
                </lightning:layoutItem>
            </lightning:layout>

            <!-- MARKETING PURPOSE -->
            <aura:if isTrue="{!not(empty(v.selectedMarketingOutcomeMetricOptions))}">
                <div class="slds-m-top_medium">
                    <lightning:layout class="slds-page-header slds-page-header--object-home">
                        <lightning:layoutItem padding="horizontal-small" size="12">
                            <div class="page-section page-header">
                                <h1 class="header-title">{!$Label.c.Core_MDF_Marketing_Purpose}</h1>
                            </div>
                        </lightning:layoutItem>
                    </lightning:layout>

                    <lightning:layout horizontalAlign="spread" multipleRows="true">
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="10"
                            mediumDeviceSize="10" largeDeviceSize="10">
                            <c:core_MDF_Activity_Purpose_Comp
                                aura:id="marketingActivityOutcomeCmp"
                                recordId="{!v.recordId}"
                                selectedOutcomeMetricOptions="{!v.selectedMarketingOutcomeMetricOptions}"
                                selectedTechnologyOptions="{!v.selectedMarketingTechnologyOptions}"
                                selectedBrandOptions="{!v.selectedMarketingBrandOptions}"
                                editable="{!false}"
                                isOutcomeBasedActivity="{!v.newPFR.Core_MDF_Is_Outcome_Based_Ind__c}"
                                Activitystatus="{!v.newPFR.Core_MDF_Fund_Request_Status__c}"
                                labelValueMap="{!v.apitoLabelConvert}"
                                mode="{!v.mode}"
                                outcomeType="Marketing"
                                showHeader="{!false}" />
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                    </lightning:layout>

                    <lightning:layout horizontalAlign="spread" multipleRows="true">
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                            smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5">
                            <c:Core_MDF_CustomMultiSelectPicklist
                                objName="PartnerFundRequest"
                                fldName="Core_MDF_Brand_nm__c"
                                isRequired="true"
                                RecId="{!v.recordId}"
                                dispLabel="{!$Label.c.Core_MDF_Brands_for_Outcome_Metric}"
                                availableOptions="{!v.AllBrandOptions}"
                                selectedOptions="{!v.selectedMarketingBrandOptions}" />
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                            smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5">
                            <c:Core_MDF_CustomMultiSelectPicklist
                                objName="PartnerFundRequest"
                                fldName="Core_MDF_Technology_txt__c"
                                isRequired="true"
                                RecId="{!v.recordId}"
                                dispLabel="{!$Label.c.Core_MDF_Technologies_for_Outcome_Metric}"
                                availableOptions="{!v.AllTechnologyOptions}"
                                selectedOptions="{!v.selectedMarketingTechnologyOptions}" />
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                    </lightning:layout>

                    <lightning:layout horizontalAlign="spread" multipleRows="true">
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="10"
                            smallDeviceSize="10" mediumDeviceSize="10" largeDeviceSize="10">
                            <lightning:textarea
                                aura:id="NewForm"
                                label="{!$Label.c.Core_MDF_Activity_Other_OutcomeBrandsTechnologies}"
                                value="{!v.marketingOtherBrandsTechnologies}" />
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                    </lightning:layout>
                </div>
            </aura:if>

            <!-- BUSINESS PURPOSE -->
            <aura:if isTrue="{!not(empty(v.selectedBusinessOutcomeMetricOptions))}">
                <div class="slds-m-top_medium">
                    <lightning:layout class="slds-page-header slds-page-header--object-home">
                        <lightning:layoutItem padding="horizontal-small" size="12">
                            <div class="page-section page-header">
                                <h1 class="header-title">{!$Label.c.Core_MDF_Business_Purpose}</h1>
                            </div>
                        </lightning:layoutItem>
                    </lightning:layout>

                    <lightning:layout horizontalAlign="spread" multipleRows="true">
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="10"
                            mediumDeviceSize="10" largeDeviceSize="10">
                            <c:core_MDF_Activity_Purpose_Comp
                                aura:id="businessActivityOutcomeCmp"
                                recordId="{!v.recordId}"
                                selectedOutcomeMetricOptions="{!v.selectedBusinessOutcomeMetricOptions}"
                                selectedTechnologyOptions="{!v.selectedBusinessTechnologyOptions}"
                                selectedBrandOptions="{!v.selectedBusinessBrandOptions}"
                                editable="{!false}"
                                isOutcomeBasedActivity="{!v.newPFR.Core_MDF_Is_Outcome_Based_Ind__c}"
                                Activitystatus="{!v.newPFR.Core_MDF_Fund_Request_Status__c}"
                                labelValueMap="{!v.apitoLabelConvert}"
                                mode="{!v.mode}"
                                outcomeType="Business"
                                showHeader="{!false}" />
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                    </lightning:layout>

                    <lightning:layout horizontalAlign="spread" multipleRows="true">
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                            smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5">
                            <c:Core_MDF_CustomMultiSelectPicklist
                                objName="PartnerFundRequest"
                                fldName="Core_MDF_Brand_nm__c"
                                isRequired="true"
                                RecId="{!v.recordId}"
                                dispLabel="{!$Label.c.Core_MDF_Brands_for_Outcome_Metric}"
                                availableOptions="{!v.AllBrandOptions}"
                                selectedOptions="{!v.selectedBusinessBrandOptions}" />
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                            smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5">
                            <c:Core_MDF_CustomMultiSelectPicklist
                                objName="PartnerFundRequest"
                                fldName="Core_MDF_Technology_txt__c"
                                isRequired="true"
                                RecId="{!v.recordId}"
                                dispLabel="{!$Label.c.Core_MDF_Technologies_for_Outcome_Metric}"
                                availableOptions="{!v.AllTechnologyOptions}"
                                selectedOptions="{!v.selectedBusinessTechnologyOptions}" />
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                    </lightning:layout>

                    <lightning:layout horizontalAlign="spread" multipleRows="true">
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="10"
                            smallDeviceSize="10" mediumDeviceSize="10" largeDeviceSize="10">
                            <lightning:textarea
                                aura:id="NewForm"
                                label="{!$Label.c.Core_MDF_Activity_Other_OutcomeBrandsTechnologies}"
                                value="{!v.businessOtherBrandsTechnologies}" />
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                            smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                    </lightning:layout>
                </div>
            </aura:if>
        </aura:if>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: TACTICS                                        -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <lightning:layout horizontalAlign="spread" multipleRows="true">
            <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5">
                <c:Core_MDF_CustomMultiSelectPicklist
                    objName="PartnerFundRequest"
                    fldName="Core_MDF_Tactics_nm__c"
                    RecId="{!v.recordId}"
                    dispLabel="{!$Label.c.Core_MDF_Activity_Tactics}"
                    availableOptions="{!v.activityTacticsOptions}"
                    selectedOptions="{!v.selectedTacticsOptions}" />
            </lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5"></lightning:layoutItem>
        </lightning:layout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: SKIP PCT APPROVAL CHECKBOX                     -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <lightning:layout horizontalAlign="spread" multipleRows="true">
            <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5">
                <aura:if isTrue="{!v.showPCTApprovalCheckbox}">
                    <div class="slds-form-element">
                        <lightning:input
                            type="checkbox"
                            label="{!$Label.c.Core_MDF_Activity_Skip_PCT_Approval}"
                            name="pctApprovalCheckbox"
                            checked="{!v.newPFR.Core_MDF_Skip_PCT_Approval_ind__c}"
                            onchange="{!c.handlePCTApprovalChange}"
                            value="{!v.newPFR.Core_MDF_Skip_PCT_Approval_ind__c}"
                            fieldLevelHelp="{!$Label.c.Core_MDF_PCT_HelpText_Value}" />
                    </div>
                </aura:if>
            </lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                smallDeviceSize="1" mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                smallDeviceSize="5" mediumDeviceSize="5" largeDeviceSize="5"></lightning:layoutItem>
        </lightning:layout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: ATTRIBUTION VARIANCE                           -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <aura:if isTrue="{!or(v.mode == 'create', v.mode == 'edit', v.mode == 'clone',
            v.newPFR.Core_MDF_Attribution_Variance_Pos_txt__c != null,
            v.newPFR.Core_MDF_Attribution_Variance_Neg_txt__c != null)}">
            <lightning:layout horizontalAlign="spread" multipleRows="true">
                <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                    mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                    mediumDeviceSize="5" largeDeviceSize="5">
                    <lightning:textarea
                        aura:id="NewForm"
                        label="{!$Label.c.Core_MDF_Attribution_Variance_Pos}"
                        value="{!v.newPFR.Core_MDF_Attribution_Variance_Pos_txt__c}" />
                </lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="5"
                    mediumDeviceSize="5" largeDeviceSize="5">
                    <lightning:textarea
                        aura:id="NewForm"
                        label="{!$Label.c.Core_MDF_Attribution_Variance_Neg}"
                        value="{!v.newPFR.Core_MDF_Attribution_Variance_Neg_txt__c}" />
                </lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                    mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
            </lightning:layout>
        </aura:if>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: INCENTIVE / SPIF DETAILS                       -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <aura:if isTrue="{!v.isSPIFSecAvailable}">
            <lightning:layout horizontalAlign="spread" multipleRows="true">
                <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                    mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="10"
                    mediumDeviceSize="10" largeDeviceSize="10">
                    <aura:if isTrue="{!not(v.checkCloneAttribute)}">
                        <c:core_MDF_ActivitySegments
                            aura:id="segmentComp"
                            activityProgram="{!v.recordtypeName}"
                            recTypeDevName="{!v.recordtypeDeveloperName}"
                            activityType="Outcome-Based"
                            mode="{!v.mode}"
                            recordId="{!v.recordId}"
                            accountId="{!v.selectedAccount}"
                            activityAmount="{!v.newPFR.Core_MDF_Maximum_Intel_Investment_amt__c}"
                            actTactics="{!v.selectedTacticsOptions}"
                            isOutcomeBased="true" />
                    </aura:if>
                </lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                    mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
            </lightning:layout>
        </aura:if>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: TACTIC METRICS                                 -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <aura:if isTrue="{!not(empty(v.selectedTacticsOptions))}">
            <lightning:layout horizontalAlign="spread" multipleRows="true">
                <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                    mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="10"
                    mediumDeviceSize="10" largeDeviceSize="10">
                    <c:core_MDF_Tactics_Form
                        aura:id="tacticMetrics"
                        actTactics="{!v.selectedTacticsOptions}"
                        mode="{!v.mode}"
                        recordId="{!v.recordId}"
                        isProposalBased="false"
                        intelContribution="{!v.newPFR.Core_MDF_Maximum_Intel_Investment_amt__c}"
                        programName="{!v.recordtypeName}"
                        editable="false" />
                </lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="1"
                    mediumDeviceSize="1" largeDeviceSize="1"></lightning:layoutItem>
            </lightning:layout>
        </aura:if>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SECTION: FILE UPLOAD                                    -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <div class="slds-m-top_medium">
            <c:Core_MDF_Activity_Upload_File
                createEditPFRAttr="True"
                contentdocumentids="{!v.ContentDocumentIds}" />
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- FOOTER: ACTION BUTTONS                                      -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="slds-modal__footer">
        <lightning:layout horizontalAlign="spread" multipleRows="true">
            <lightning:layoutItem padding="around-small" flexibility="grow" size="3"
                mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="2"
                mediumDeviceSize="2" largeDeviceSize="2">
                <div align="right">
                    <lightning:button
                        variant="neutral"
                        label="{!$Label.c.Core_MDF_Cancel}"
                        onclick="{!c.handleCancel}" />
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="2"
                mediumDeviceSize="2" largeDeviceSize="2">
                <div align="center">
                    <lightning:button
                        aura:id="SaveandNew"
                        variant="neutral"
                        label="{!$Label.c.Core_MDF_Save_and_New}"
                        onclick="{!c.handleSaveAndNew}"
                        disabled="{!v.showSpinner}" />
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="2"
                mediumDeviceSize="2" largeDeviceSize="2">
                <div align="left">
                    <lightning:button
                        aura:id="Save"
                        variant="brand"
                        label="{!$Label.c.Core_MDF_Save}"
                        onclick="{!c.handleSave}"
                        disabled="{!v.showSpinner}" />
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem padding="around-small" flexibility="grow" size="3"
                mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
        </lightning:layout>
    </div>

</aura:component>