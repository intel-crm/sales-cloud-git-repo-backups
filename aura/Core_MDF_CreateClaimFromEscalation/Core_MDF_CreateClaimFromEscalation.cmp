<aura:component controller="Core_MDF_Escalation_ServiceHandler" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >

	<aura:html tag="style">
		<!--To hide standard quick action pop up-->
		.slds-button.slds-button_icon.slds-modal__close.closeIcon.slds-button_icon-bare.slds-button_icon-inverse{
			visibility: hidden;
		}
	</aura:html>    
    
    <aura:attribute name = "isUserEligible" type = "Boolean" default=""/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="escalationRecord" type="Object"/>
	<aura:attribute name="EscactivityId" type="string" default="" />
    <aura:attribute name="Spinner" type="boolean" default="true"/>  
    <aura:attribute name="renderModal" type="boolean" default="false"/>  
	<force:recordData aura:id="recordLoader"
    recordId="{!v.recordId}"
    fields="Core_MDF_Co_Marketing_Activity_id__c, Core_MDF_Escalation_Type_nm__c, Core_MDF_Escalation_Status_nm__c"
    targetFields="{!v.escalationRecord}"
    targetError="{!v.recordLoadError}"
    />
	 <aura:if isTrue="{!v.Spinner}">
        	<lightning:spinner alternativeText="Loading" size="medium" />
     </aura:if> 
    
    <aura:if isTrue="{!v.renderModal}">
    <aura:if isTrue="{!v.isUserEligible}">
       <aura:if isTrue="{!and(and(v.escalationRecord.Core_MDF_Escalation_Type_nm__c == $Label.c.Core_MDF_Escalation_Status_Type, v.escalationRecord.Core_MDF_Escalation_Status_nm__c == $Label.c.Core_MDF_Status_Approved), v.escalationRecord.Core_MDF_Co_Marketing_Activity_id__c != null) }">
	   <c:Core_MDF_PFC_Create escalationId="{!v.recordId}" escActivityId ="{!v.escalationRecord.Core_MDF_Co_Marketing_Activity_id__c}" recordId= "{!v.recordId}"/>
	   		 <aura:set attribute="else">
			   <div class="slds-notify__content">
					<h5 class="slds-text-heading_small slds-align_absolute-center" >{!$Label.c.Core_MDF_Escalation_Error_Message}</h5>
				</div>
			</aura:set>		   
	   </aura:if> 
       <aura:set attribute="else">
				<div class="slds-notify__content">
					<h5 class="slds-text-heading_small slds-align_absolute-center" >{!$Label.c.Core_MDF_Escalation_Create_Claim_Error_Message}</h5>
				</div>   
	   </aura:set>
	</aura:if> 
    </aura:if>
     
</aura:component>