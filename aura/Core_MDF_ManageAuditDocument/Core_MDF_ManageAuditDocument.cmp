<aura:component  implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,force:hasSObjectName,lightning:isUrlAddressable,lightning:hasPageReference"
    access="global"></aura:component>
                <!--controller="Core_MDF_AuditDocumentHelper"
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,force:hasSObjectName,lightning:isUrlAddressable,lightning:hasPageReference"
    access="global">
    <aura:attribute name="accept" type="List" description="list of file formats which are allowed to upload" />
    <aura:attribute name="sobjectType" type="String" default="{!v.sObjectName}" />
    <aura:attribute name="claimStatus" type="String" description="Holds the status of the claim" />
    <aura:attribute name="caseStatus" type="String" description="Holds the status of the case" default="Under Review" />
    <aura:attribute name="claimRefName" type="string" description="Holds the claim batch record claim name" />
    <aura:attribute name="toggleClaimMessagePopUp" type="boolean" default="false"
        description="Boolean value will be used to open/close the model" />
    <aura:attribute name="claimSubmitterMessage" type="String" description="Holds Claim Submitter Message" />
    <aura:attribute name="DocumentType" type="String" default="Core_MDF_Document_Types__c" access="global" />
    <aura:attribute name="auditDocument" type="Core_MDF_Audit_Document__c[]"
        default="{'sobjectType':'Core_MDF_Audit_Document__c'}" />
    <aura:attribute name="isOpen" type="boolean" default="false"
        description="Boolean value will be used to open/close the model" />
    <aura:attribute name="isInsert" type="boolean" default="false"
        description="Boolean value will be used to display recently uploaded documents" />
    <aura:attribute name="isEnableCancel" type="boolean" default="false"
        description="Boolean value will be used to display conditional Cancel/Close button" />
    <aura:attribute name="isManageDocEnabled" type="boolean" default="false"
        description="Boolean value will be used to display manage button" />
    <aura:attribute name="isSubmitEnabled" type="boolean" default="false"
        description="Boolean value will be used to display submit button" />
    <aura:attribute name="isManageButtonClicked" type="boolean" default="false"
        description="Boolean value will be used to check whether manage button is clicked or not" />
    <aura:attribute name="isSaveAndCloseClicked" type="boolean" default="false"
        description="Boolean value will be used retain modal for performing Save and Close action" />
    <aura:attribute name="sObjectDocumentWrapper" type="object" default="null" />
    <aura:attribute name="isResponseReceived" type="boolean" default="false"
        description="Boolean value will be used to display component once we receive response" />
    <aura:attribute name="disabled" type="Boolean" default="false"
        description="Conditionally disabling the upload functionality" />
    <aura:attribute name="contentdocumentids" type="String[]" default=""
        description="Stores the content document ids of the uploaded files " />
    <aura:attribute name="userInfo" type="string"
        description="Stores the userinfo of logged in user used for dummy storage" />
    <aura:attribute name="filedata" type="Object" />
    <aura:attribute name="iserror" type="Boolean" default="false" />
    <aura:attribute name="errormsg" type="string" default="" />
    <aura:attribute name="selectedDocumentId" type="string" default="" />
    <aura:attribute name="selectedDocumentName" type="string" default="" />
    <aura:attribute name="selectedDocumentIndex" type="string" default="" />
    <aura:attribute name="checkfileuploadcondition" type="Boolean" default="false" />
    <aura:attribute name="documents" type="String[]" default=""
        description="Stores the content documents of the uploaded files " />
    <aura:attribute name="isFileUploadOnClaimCreation" type="Boolean" default="false" />
    <aura:attribute name="docType" type="String[]" default="" />
    <aura:attribute name="checkDocTypeSelected" type="Boolean" default="false" />
    <aura:attribute name="isFileTypeSelected" type="Boolean" default="false" />
    <aura:attribute name="showToast" type="Boolean" default="false" />
    <aura:attribute name="loaded" type="boolean" default="true" />
    <aura:attribute name="diableComponentfromClaim" type="boolean" />

    <aura:attribute name="editClaimId" type="Id" />
    <aura:attribute name="recordIdForPop" type="Id" default="{!v.editClaimId != null ? v.editClaimId : v.recordId}" />
    <aura:attribute name="isSaveEnabled" type="boolean" default="true"
        description="Boolean value will be used to save a claim" />
    <aura:attribute name="recordtypeDeveloperName" type="String" default=""
        description="Stores the recordtypeDeveloperName from the parent component" />
    <aura:attribute name="typeOfDocument" type="List" default="[]"
        description="Stores the concatenated value of document type and Value" />
    <aura:attribute name="docTypeName" type="List"
        description="Stores the Document Types Applicable for the record based on Program/Budget Type" />
    <aura:attribute name="docTypesSelected" type="Map" description="Stores Document Types Selected" />
    <aura:attribute name="budgetType" type="String" default=""
        description="Stores the value of budget type from the parent component" />
    <aura:attribute type="Core_MDF_POP_Document_Types__mdt[]" name="metadataMap" default=""
        description="Stores the metadata values from the server side" />
    <aura:attribute name="reqDocName" type="String" description="Holds the required document types" />
    <aura:attribute name="reqDocNameList" type="List" description="Holds the required document types as List" />
    <aura:attribute name="reqDocTypesForEnablingSubmitBtn" type="List"
        description="Holds the required document types as List used for enabling/disabling submit button" />
    <aura:attribute name="fileOnClaimCreationSide" type="Boolean" default="false"
        description="This is used to decide whether files are uploaded on claim creation or not" />
    <aura:attribute name="existingDocList" type="Core_MDF_Audit_Document__c[]"
        default="{'sobjectType':'Core_MDF_Audit_Document__c'}" />
    <aura:attribute name="isMandateDocsUnchecked" type="boolean" default="false"
        description="Boolean value will be used to save a claim from Details Page" />
    <aura:attribute name="isfileDeleted" type="boolean" default="false"
        description="Boolean value will be used to recalculate the save flag" />
    <aura:attribute name="isSubmitClicked" type="boolean" default="false"
        description="Boolean value will be used to display confirmation message" />
    <aura:attribute name="isDeleteClicked" type="boolean" default="false"
        description="Boolean value will be used to display Delete confirmation message" />
    <aura:attribute name="showConfirmationPopupForPIC" type="boolean" default="false"
        description="Boolean value used to display the PIC confirmation popup" />
    <aura:attribute name="switchClaimStatusToPICPending" type="boolean" default="false"
        description="set to true when yes is selected from PIC confirmation popup" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="simpleNewClaim" type="PartnerFundClaim" />
    <aura:attribute name="is3rdPartyPOP" type="boolean" default="false" description="is3rdPartyPOP" />
    <aura:attribute name="isClaimEdit" type="boolean" default="false" description="Indicates the edit of claim" />
    <aura:attribute name="spinner" type="boolean" default="false" />
    <aura:attribute name="actyPOPDescReq" type="Boolean" default="false" />
    <aura:registerEvent name="Core_MDF_ThirdPartyPOPEvent" type="c:Core_MDF_ThirdPartyPOPEvent" />

    Handler for the checkbox change event is defined below 
    <aura:handler event="c:Core_MDF_checkboxChangeEvent" action="{!c.checkSubmitEnable}" name="checkboxChangeEvent" />
    <p>record id in ManageAudit: {!v.recordId}</p>
    <p>User info in ManageAudit: {!v.userInfo}</p>-->
    <!-- All the buttons which appears on page are placed in this section
    <aura:if isTrue="{!v.spinner}">
        <lightning:spinner alternativeText="Loading" />
    </aura:if>
     <div> <br></br> </div> 
    <div align="center" class="{!v.sObjectDocumentWrapper.isPartner ? 'slds-var-m-top_medium' : ''}">
        <lightning:formattedRichText style="color:red" value="{!$Label.c.Core_MDF_AllClaim_ManditoryVerbiage}">
        </lightning:formattedRichText>
    </div>
    For IPA add POP Descirption Component 
    <aura:if isTrue="{!v.actyPOPDescReq}">
        <c:core_MDF_POP_Details recordIdinput="{!v.simpleNewClaim.RequestId}" objectApiNameinput="PartnerFundRequest"
            displayLabel="POP" />
    </aura:if>
    <div class="slds-modal__header" align="left">
        <h2 id="header43" class="slds-text-headingsmall">
            <aura:if isTrue="{!v.sobjectType=='Core_MDF_Claim_Batch_Stage__c'}">
                <span>{!$Label.c.Core_MDF_Proof_of_Documents_Submission}</span><span>&nbsp; - &nbsp;</span>
                <span>{!v.claimRefName}</span>
                <aura:set attribute="else">
                    {!$Label.c.Core_MDF_Proof_of_Documents_Submission}
                </aura:set>
            </aura:if>
        </h2>
        <div class="c-container">
            <aura:if isTrue="{!v.isResponseReceived}">
                <lightning:layout multipleRows="true">
                    <div>
                        <aura:if isTrue="{!v.checkDocTypeSelected}">
                            <lightning:layoutItem padding="horizontal-small">
                                <div>
                                    <h1>{!$Label.c.Core_MDF_Manage_Document_Error_Message}</h1>
                                </div>
                            </lightning:layoutItem>


                        </aura:if>
                    </div>

                  Upload Document Button-->
                     <!--US1056918 Changes: Updated Below condition to disable Upload Files button when Audit Type is Document Hold
                    <lightning:layoutItem>
                        <aura:if isTrue="{!or(v.sobjectType == 'Case',v.sObjectDocumentWrapper.sObjName == 'Case')}">
                            <aura:if
                                isTrue="{!and(v.sObjectDocumentWrapper.caseStatus==$Label.c.Core_MDF_Case_Status_Pending_Document,and(v.sObjectDocumentWrapper.caseAuditType !='Document Hold',or(v.sObjectDocumentWrapper.isEditable,v.sObjectDocumentWrapper.isPartner)))}">
                                <div Style="position: relative;margin:5px;">
                                    <lightning:fileUpload accept="{!v.accept}" recordId="{!v.recordId}"
                                        onuploadfinished="{!c.handleUploadFinished}" multiple="true"
                                        aura:id="lightningfileUpload" disabled="true" />
                                </div>
                                <aura:set attribute="else">
                                    <div Style="position: relative;margin:5px;">
                                        <lightning:fileUpload accept="{!v.accept}" recordId="{!v.recordId}"
                                            onuploadfinished="{!c.handleUploadFinished}" multiple="true"
                                            aura:id="lightningfileUpload" disabled="true" />
                                    </div>
                                </aura:set>
                            </aura:if>
                        </aura:if>

                        <aura:if
                            isTrue="{!or(v.sobjectType=='PartnerFundClaim',v.sObjectDocumentWrapper.sObjName == 'PartnerFundClaim')}">
                            <aura:if
                                isTrue="{!or((and(v.sObjectDocumentWrapper== 'null',v.isFileUploadOnClaimCreation)),v.sObjectDocumentWrapper.enableComponentOnDetail)}">
                                <div Style="position: relative;margin:5px;" class="upload156">
                                    <lightning:fileUpload accept="{!v.accept}" recordId=""
                                        onuploadfinished="{!c.handleUploadFinished}" multiple="true"
                                        aura:id="lightningfileUpload" />
                                </div>
                                <aura:set attribute="else">
                                    <div Style="position: relative;margin:5px;" class="upload162">
                                        <lightning:fileUpload accept="{!v.accept}" recordId="{!v.userInfo}"
                                            name="upload163" onuploadfinished="{!c.handleUploadFinished}"
                                            multiple="true" aura:id="lightningfileUpload" disabled="true" />
                                    </div>
                                </aura:set>
                            </aura:if>
                        </aura:if>
                        <aura:if
                            isTrue="{!and(v.sobjectType=='Core_MDF_Claim_Batch_Stage__c',v.isFileUploadOnClaimCreation)}">
                            <div Style="position: relative;margin:5px;">
                                <lightning:fileUpload accept="{!v.accept}" recordId="{!v.userInfo}"
                                    onuploadfinished="{!c.handleUploadFinished}" multiple="true"
                                    aura:id="lightningfileUpload" />
                            </div>
                        </aura:if>
                    </lightning:layoutItem>

                    Disabling Manage and Download Documents buttons on Claim Creation page

                    <aura:if isTrue="{!v.isFileUploadOnClaimCreation}">
                        <lightning:layoutItem>
                            or((and(v.isManageDocEnabled, v.isClaimEdit, sObjectDocumentWrapper.enableComponentOnDetail)), v.sObjectDocumentWrapper == 'null') 
                            <div Style="position: relative;top:19px;margin:5px;">
                               Check for any existing docs
                                <aura:if isTrue="{!and(v.sobjectType != 'Case', 
                                    (and(v.isManageDocEnabled, 
                                    (or(v.sObjectDocumentWrapper == 'null', or(and(v.isClaimEdit, v.sObjectDocumentWrapper.enableComponentOnDetail),and(v.sobjectType=='Core_MDF_Claim_Batch_Stage__c', v.sObjectDocumentWrapper.enableComponentOnDetail))))
                                        )))}">
                                    <lightning:button variant="neutral" name="button191"
                                        label="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                        title="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                        onclick="{!c.openModal}" />
                                    <aura:set attribute="else">
                                         Code when is false 
                                        <lightning:button variant="neutral" name="button196"
                                            label="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                            title="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                            onclick="{!c.openModal}" disabled="true" />
                                    </aura:set>
                                </aura:if>
                                <lightning:button variant="neutral"
                                    label="{!$Label.c.Core_MDF_Download_All_Document_Button_Label}"
                                    title="{!$Label.c.Core_MDF_Download_All_Document_Button_Label}"
                                    onclick="{!c.downloadAllDocument}" class="slds-hide" />
                            </div>
                        </lightning:layoutItem>
                        <aura:set attribute="else">

                            Detail Section
                             Manage Document Button
                            <lightning:layoutItem>
                                <div Style="position: relative;top:19px;margin:5px;">
                                   <aura:if isTrue ="{!and(v.isManageDocEnabled,v.caseDocumentWrapper.caseStatus==$Label.c.Core_MDF_Case_Status_Pending_Document,or(v.caseDocumentWrapper.isEdiatable,v.caseDocumentWrapper.isPartner))}">
                                    <aura:if
                                        isTrue="{!or(v.sobjectType == 'Case',v.sObjectDocumentWrapper.sObjName == 'Case')}">
                                         US1056918 Changes: Updated Below condition to disable Manage Documents button when Audit Type is Document Hold
                                        <aura:if
                                            isTrue="{!and(v.sObjectDocumentWrapper.caseStatus==$Label.c.Core_MDF_Case_Status_Pending_Document,
                                                         and(v.sObjectDocumentWrapper.caseAuditType !='Document Hold',
                                                         and(v.isManageDocEnabled,or(v.sObjectDocumentWrapper.isEditable,v.sObjectDocumentWrapper.isPartner))))}">
                                            <lightning:button variant="neutral"
                                                label="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                                title="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                                onclick="{!c.openModal}" disabled="true" />
                                            <aura:set attribute="else">
                                                <lightning:button variant="neutral"
                                                    label="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                                    title="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                                    disabled="true" onclick="{!c.openModal}" />
                                            </aura:set>
                                        </aura:if>
                                    </aura:if>

                                    <aura:if
                                        isTrue="{!or(v.sobjectType == 'PartnerFundClaim',v.sObjectDocumentWrapper.sObjName == 'PartnerFundClaim')}">
                                        <aura:if
                                            isTrue="{!and(v.isManageDocEnabled,v.sObjectDocumentWrapper.enableComponentOnDetail)}">
                                            <lightning:button variant="neutral" name="button240"
                                                label="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                                title="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                                onclick="{!c.openModal}" />

                                            <aura:set attribute="else">
                                                <lightning:button variant="neutral" name="button246"
                                                    label="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                                    title="{!$Label.c.Core_MDF_Manage_Document_Button_Label}"
                                                    disabled="true" onclick="{!c.openModal}" />
                                            </aura:set>
                                        </aura:if>
                                    </aura:if>

                                </div>
                            </lightning:layoutItem>

                            Download All Document
                            <lightning:layoutItem>
                                <div Style="position: relative;top:19px;margin:5px;">
                                     US1056918 Changes: Updated Below condition to disable Download All Documents button when Audit Type is Document Hold
                                    <aura:if
                                        isTrue="{!and(!v.sObjectDocumentWrapper.isPartner, v.sobjectType =='Case')}">
                                        <aura:if
                                            isTrue="{!and(v.isManageDocEnabled,v.sObjectDocumentWrapper.caseAuditType !='Document Hold')}">
                                            <lightning:button variant="neutral"
                                                label="{!$Label.c.Core_MDF_Download_All_Document_Button_Label}"
                                                title="{!$Label.c.Core_MDF_Download_All_Document_Button_Label}"
                                                onclick="{!c.downloadAllDocument}" />

                                            <aura:set attribute="else">
                                                <lightning:button variant="neutral"
                                                    label="{!$Label.c.Core_MDF_Download_All_Document_Button_Label}"
                                                    title="{!$Label.c.Core_MDF_Download_All_Document_Button_Label}"
                                                    disabled="true" onclick="{!c.downloadAllDocument}" />

                                            </aura:set>
                                        </aura:if>
                                    </aura:if>
                                </div>
                            </lightning:layoutItem>
                        </aura:set>
                    </aura:if>
                    Displaying the list of documents attached 
                    <aura:if isTrue="{!v.checkfileuploadcondition}">
                        <lightning:layoutItem size="12"></lightning:layoutItem>
                        <br /><br />
                        <aura:if isTrue="{!not(empty(v.auditDocument))}">
                            <lightning:layoutItem size="12">
                                <tr>
                                    Areefa If will get called after line 483 line.to display message on claim form 
                                    <aura:if isTrue="{!v.is3rdPartyPOP}">
                                        <div class="slds-float_left">
                                            <lightning:icon iconName="utility:warning" alternativeText="Warning!"
                                                title="Warning" variant="warning" size="small" />
                                            <span style="color:red">{!$Label.c.Core_MDF_ThirdPartyPOPMessage}</span>
                                        </div>
                                        Areefa, else added mainly to handle if user go back to claim form and come to POP section will lose the event refference 
                                        <aura:set attribute="else">
                                            <c:core_MDF_PFC_ThirtPartyPOP claimObj="{!v.simpleNewClaim}"
                                                onisThirdPartyPOP="{!c.getThirdPartyPOP}" />
                                        </aura:set>

                                    </aura:if>
                                </tr>
                                <tr>
                                    <aura:if isTrue="{!v.reqDocName.length > 0}">
                                        <div class="slds-float_none">
                                            <p style="color:red">*{!$Label.c.Core_MDF_Mandatory_Document_Types}:
                                                {!v.reqDocName}</p>
                                        </div>
                                    </aura:if>
                                </tr>
                                <br></br>
                                <div class="slds-modal__content slds-p-aroundmedium" id="modal-content-id-1">
                                    <table class="slds-table_bordered table-align" align="left">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <div class="slds-truncate">
                                                        <label>{!$Label.c.Core_MDF_Document_Title}</label>
                                                    </div>
                                                </th>
                                                <aura:iteration items="{!v.typeOfDocument}" var="type" indexVar="index">
                                                    <th>
                                                        <div class="slds-colpadded">
                                                            <center><label>{!type.DocNameLabel}</label></center>
                                                        </div>
                                                    </th>
                                                </aura:iteration>
                                                <th>
                                                    <div class="slds-colpadded">
                                                        <div class="slds-truncate" title="Delete"></div>
                                                    </div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <aura:iteration items="{!v.auditDocument}" var="file" indexVar="indx">
                                                <tr class="slds-hint-parent">
                                                    <td data-label="{!$Label.c.Core_MDF_Document_Title}">

                                                        <div class="slds-cell-wrap truncate-filename"
                                                            title="{!file.Core_MDF_Document_Title__c}">
                                                            <a href="{!'/'+file.Core_MDF_Document_Id__c}"
                                                                target="_blank"
                                                                download="{!file.Core_MDF_Document_Title__c}">
                                                                {!file.Core_MDF_Document_Title__c} </a>
                                                        </div>

                                                    </td>
                                                    <aura:iteration items="{!v.typeOfDocument}" var="item"
                                                        indexVar="indx">
                                                        <td>
                                                            <center><label>
                                                                    <c:Core_MDF_AuraIfAdvanced
                                                                        checkboxName="{!(file.Core_MDF_Document_Id__c+';#'+item.DocName)}"
                                                                        documentTypes="{!file.Core_MDF_Document_Types__c}"
                                                                        element="{!item.DocName}" disabled="true"
                                                                        checkboxvalue="{!item.Value}" />
                                                                </label></center>
                                                        </td>
                                                    </aura:iteration>
                                                    <aura:if isTrue="{!v.editClaimId == null}">
                                                        <th scope="row">
                                                            <div>
                                                                <a onclick="{!c.deleteSelected}"
                                                                    data-Id="{!file.Core_MDF_Document_Id__c}"
                                                                    data-index="{!indx}"
                                                                    name="{!file.Core_MDF_Document_Title__c}">
                                                                    <lightning:buttonIcon variant="info"
                                                                        iconName="utility:delete"
                                                                        class="slds-icon slds-icon_small"
                                                                        iconClass="dark" size="small"
                                                                        alternativeText="Delete" />
                                                                    <span class="slds-assistive-text">Delete
                                                                        Icon</span>
                                                                </a>
                                                            </div>
                                                        </th>
                                                    </aura:if>
                                                </tr>
                                            </aura:iteration>
                                        </tbody>
                                    </table>
                                </div>
                            </lightning:layoutItem>
                        </aura:if>
                    </aura:if>
                    Delete confirmation popup
                    <aura:if isTrue="{!v.isDeleteClicked}">
                        <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true"
                            class="slds-modal slds-fade-in-open">
                            <div class="slds-modal__container deletePopup">
                                <div class="slds-modal__content slds-p-aroundmedium">
                                    <div class="slds-card">
                                        <div class="slds-p-around_medium slds-align_absolute-center">
                                            <lightning:icon iconName="utility:warning" alternativeText="Warning!"
                                                variant="warning" />
                                            {!$Label.c.Core_MDF_Pop_Document_Delete} - {!v.selectedDocumentName}
                                        </div>
                                    </div>
                                    <div class="slds-card">
                                        <div class="slds-p-around_medium slds-align_absolute-center">
                                            <lightning:button aura:id="yesButton" variant="brand"
                                                label="{!$Label.c.Core_MDF_Cancel_Claim_Yes}"
                                                title="{!$Label.c.Core_MDF_Cancel_Claim_Yes}"
                                                onclick="{!c.handleConfirmYes}" />
                                            <lightning:button aura:id="noButton" variant="neutral"
                                                label="{!$Label.c.Core_MDF_Cancel_Claim_No}"
                                                title="{!$Label.c.Core_MDF_Cancel_Claim_No}"
                                                onclick="{!c.handleConfirmNo}" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <div class="slds-backdrop slds-backdrop_open"></div>

                    </aura:if>

                    Claim Submitter Message Button-->
                    <!--US867474: [RMF] - PRC Mystery Shopper to receive Audit Notifications and submit additional POP-->
                    <!-- US1056918 Changes: Added disabled attribute to disable below button when Audit Type is Document Hold
                    <lightning:layoutItem>
                        <div Style="position: relative;top:19px;margin:5px;">
                            <aura:if
                                isTrue="{!and(or(v.sObjectDocumentWrapper.caseStatus==$Label.c.Core_MDF_Case_Status_Pending_Document,v.sObjectDocumentWrapper.caseStatus==$Label.c.Core_MDF_Case_Status_Under_Review),and(or(v.sObjectDocumentWrapper.isPartner,v.sObjectDocumentWrapper.isClaimSubmitter),v.sObjectDocumentWrapper.sObjName == 'Case'))}">
                                <lightning:button variant="neutral" label="{!$Label.c.Core_MDF_SubmitMessage}"
                                    title="{!$Label.c.Core_MDF_SubmitMessage}" onclick="{!c.callClaimSubmitterAction}"
                                    disabled="{!v.sObjectDocumentWrapper.caseAuditType =='Document Hold'}" />

                            </aura:if>
                        </div>
                    </lightning:layoutItem>
                </lightning:layout>
            </aura:if>
        </div>

        Claim SubmitterMessage Popup
        <div class="slds-m-around_xx-medium">

            <aura:if isTrue="{!v.toggleClaimMessagePopUp}">
                <aura:if isTrue="{!v.loaded }">
                    <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true"
                        aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                        <div class="slds-modal__container">
                            <div class="slds-modal__header">
                                 <lightning:buttonIcon iconName="utility:close" class="slds-button slds-modal__close slds-button_icon-border slds-button_icon-large" variant="bare" onclick="{!c.onCancel}" alternativeText="Close" /> 

                                <button class="slds-button slds-modal__close slds-button-icon-inverse" title="Close"
                                    onclick="{!c.onCancel}">
                                    X<span class="slds-assistive-text">{!$Label.c.Core_MDF_Cancel}</span>
                                </button>

                                <h2 id="header43" class="slds-text-headingmedium">
                                    {!$Label.c.Core_MDF_SubmitMessage_ReplacesCurrent}</h2>
                            </div>
                            <div class="slds-modal__content slds-p-aroundmax-small" id="modal-content-id-1">
                                <lightning:layoutItem flexibility="auto" padding="around-large">
                                    <lightning:textarea value="{!v.claimSubmitterMessage}" aura:Id="txtarea" />
                                </lightning:layoutItem>
                            </div>
                            <div class="slds-modal__footer">
                                <div>
                                    <lightning:button variant="neutral" label="{!$Label.c.Core_MDF_Cancel}"
                                        title="{!$Label.c.Core_MDF_Cancel}" onclick="{!c.onCancel}" />
                                    <lightning:button variant="brand" label="{!$Label.c.Core_MDF_Submit_Button_Label}"
                                        title="{!$Label.c.Core_MDF_Submit_Button_Label}" onclick="{!c.onSubmit}" />

                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="slds-backdrop slds-backdrop_open"></div>
                    <aura:set attribute="else">
                        <lightning:spinner alternativeText="Loading" />
                    </aura:set>
                </aura:if>
            </aura:if>
        </div>

        Use "slds-m-around_xx-large" class to add standard X-Large padding to the component-->
        <!--Model begins from here
        <div class="slds-m-around_xx-large">
            <aura:if isTrue="{!v.isOpen}">
                <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true"
                    aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open slds-modal_large">

                    <div class="slds-modal__container">
                        <header class="slds-modal__header">
                            <aura:if isTrue="{!v.isEnableCancel}">
                                <lightning:buttonIcon iconName="utility:close" onclick="{!c.closeModal}"
                                    alternativeText="{!$Label.c.Core_MDF_Close}" variant="bare-inverse"
                                    class="slds-modal__close" />
                            </aura:if>

                            <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">
                                {!$Label.c.Core_MDF_Manage_Document_Header}</h2>
                        </header>
                        <div class="slds-modal__content slds-p-around_large" id="modal-content-id-1">
                            <tr>
                                <aura:if
                                    isTrue="{!and(v.sobjectType=='Core_MDF_Claim_Batch_Stage__c',v.isFileUploadOnClaimCreation)}">
                                    <c:core_MDF_PFC_ThirtPartyPOP claimObj="{!v.simpleNewClaim}"
                                        onisThirdPartyPOP="{!c.getThirdPartyPOP}" />
                                    <aura:set attribute="else">
                                        <c:core_MDF_PFC_ThirtPartyPOP claimObj="{!v.simpleNewClaim}"
                                            onisThirdPartyPOP="{!c.getThirdPartyPOP}" recordId="{!v.recordId}" />
                                    </aura:set>
                                </aura:if>

                            </tr>
                            <tr>
                                <aura:if isTrue="{!v.reqDocName.length > 0}">
                                    <div class="slds-float_none">
                                        <p style="color:red">*{!$Label.c.Core_MDF_Mandatory_Document_Types}:
                                            {!v.reqDocName}</p>
                                    </div>
                                </aura:if>

                            </tr>
                            <br></br>
                            <center>
                                <table class="table-align">
                                    <tr>
                                        <th>
                                            <label>{!$Label.c.Core_MDF_Document_Title}</label>
                                        </th>

                                        <aura:iteration items="{!v.typeOfDocument}" var="type" indexVar="index">
                                            <td>
                                                <center>
                                            <th>
                                                <center><label>{!type.DocNameLabel}</label></center>
                                            </th>
                            </center>
                            </td>
                            </aura:iteration>
                            </tr>
                            <aura:iteration items="{!v.auditDocument}" var="file" indexVar="indx">
                                <tr class="slds-hint-parent">
                                    <td data-label="{!$Label.c.Core_MDF_Document_Title}">

                                        <div class="slds-cell-wrap truncate-filename"
                                            title="{!file.Core_MDF_Document_Title__c}">
                                            {!file.Core_MDF_Document_Title__c}
                                        </div>

                                    </td>
                                    <aura:iteration items="{!v.typeOfDocument}" var="item" indexVar="indx">
                                        <td>
                                            <center><label>
                                                    <c:Core_MDF_AuraIfAdvanced title="edit"
                                                        checkboxName="{!(file.Core_MDF_Document_Id__c+';#'+item.DocName)}"
                                                        documentTypes="{!file.Core_MDF_Document_Types__c}"
                                                        element="{!item.DocName}" checkboxvalue="{!item.Value}" />
                                                </label></center>
                                        </td>
                                    </aura:iteration>
                                </tr>
                            </aura:iteration>
                            </table>
                            </center>
                        </div>

                        <footer class="slds-modal__footer">

                            <aura:if isTrue="{!v.isEnableCancel}">
                                <lightning:button variant="neutral" type="submit" label="{!$Label.c.Core_MDF_Cancel}"
                                    title="{!$Label.c.Core_MDF_Cancel}" onclick="{!c.closeModal }" />

                            </aura:if>


                            <aura:if isTrue="{!!v.isFileUploadOnClaimCreation}">
                                <lightning:button class="slds-button slds-button_brand" type="submit" name="button567"
                                    label="{!$Label.c.Core_MDF_Save}" title="{!$Label.c.Core_MDF_Save}"
                                    onclick="{!c.save}" />

                                <lightning:button class="slds-button slds-button_brand" type="submit"
                                    label="{!$Label.c.Core_MDF_Save_and_Close_Button_Label}"
                                    title="{!$Label.c.Core_MDF_Save_and_Close_Button_Label}"
                                    onclick="{!c.saveAndClose}" />
                                <aura:if isTrue="{!v.sObjectDocumentWrapper.submitButton}">
                                    <lightning:button class="slds-button slds-button_brand" type="submit"
                                        label="{!$Label.c.Core_MDF_Submit_Button_Label}"
                                        title="{!$Label.c.Core_MDF_Submit_Button_Label}" disabled="true"
                                        onclick="{!c.submit}" />
                                    <aura:set attribute="else">
                                        <aura:if isTrue="{!v.isSubmitEnabled}">
                                            <lightning:button class="slds-button slds-button_brand" type="submit"
                                                label="{!$Label.c.Core_MDF_Submit_Button_Label}"
                                                title="{!$Label.c.Core_MDF_Submit_Button_Label}"
                                                onclick="{!c.submit}" />
                                            <aura:set attribute="else">
                                                <lightning:button class="slds-button slds-button_brand" type="submit"
                                                    label="{!$Label.c.Core_MDF_Submit_Button_Label}"
                                                    title="{!$Label.c.Core_MDF_Submit_Button_Label}" disabled="true"
                                                    onclick="{!c.submit}" />
                                            </aura:set>
                                        </aura:if>
                                    </aura:set>
                                </aura:if>
                                <aura:set attribute="else">
                                    <lightning:button class="slds-button slds-button_brand" type="submit"
                                        name="button596" label="{!$Label.c.Core_MDF_Save}"
                                        title="{!$Label.c.Core_MDF_Save}" onclick="{!c.save}" />
                                </aura:set>
                            </aura:if>
                        </footer>
                    </div>
                </section>
                <div class="slds-backdrop slds-backdrop_open"></div>
            </aura:if>
        </div>
    </div>
    US784098: Technical: POP submission Confirmation - All programs 
    <aura:if isTrue="{!v.isSubmitClicked}">
        <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true"
            aria-describedby="modal-content-id-1"
            class="slds-modal slds-fade-in-open slds-modal_large slds-text-align_center">

            <div class="slds-modal__container">
                <header class="slds-modal__header">

                    <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">
                        {!$Label.c.Core_MDF_POP_Confirmation_Header}</h2>
                </header>
                <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                    <aura:if istrue="{!v.sobjectType == 'Case'}">
                        <p>{!$Label.c.Core_MDF_POP_Confirmation_Message} </p>
                        <aura:set attribute="else">
                            <aura:if isTrue="{!v.is3rdPartyPOP}">
                                <aura:unescapedHtml value="{!$Label.c.Core_MDF_Confirm_Modal_Popup_Content1}">
                                </aura:unescapedHtml>
                                <aura:set attribute="else">
                                    <aura:unescapedHtml value="{!$Label.c.Core_MDF_Confirm_Modal_Popup_Content2}">
                                    </aura:unescapedHtml>
                                </aura:set>
                            </aura:if>
                        </aura:set>
                    </aura:if>


                </div>

                <footer class="slds-modal__footer">
                    <lightning:button variant="neutral" label="{!$Label.c.Core_Cancel_Button}"
                        title="{!$Label.c.Core_Cancel_Button}" onclick="{!c.closeConfirmation}" />
                    <lightning:button variant="brand" label="{!$Label.c.Core_MDF_Submit_Button_Label}"
                        title="{!$Label.c.Core_MDF_Submit_Button_Label}" onclick="{!c.confirmForPIC}" />
                </footer>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
    

