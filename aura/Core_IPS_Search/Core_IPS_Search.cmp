<aura:component implements="forceCommunity:availableForAllPageTypes" access="global" controller="Core_IPS_UserInfoCtrl">
    <aura:handler name="init" value="this" action="{!c.doInit}"/>
    <aura:attribute name="userInfo" type="user"/>  
    
    <!--  <ltng:require styles="{!$Resource.Font_Awesome + '/font-awesome/css/all.css'}" />-->
    <div class="Mask">
        <div class="IntelUser">
            Hi {!v.userInfo.FirstName}, Welcome to Intel<sup>&#174;</sup> Premier Support 
        </div>
        <div class="slds-align_absolute-center">
            <input type="text" class="SearchBox" placeholder="Search1 Case comments and projects">
                
            </input>
            
        </div>
    </div> 
    
    
    <div class="slds-grid slds-wrap " style="background:#f7f7f7;">
        <div class="slds-col slds-size_2-of-12">
            
        </div>
        <div class="slds-col slds-size_10-of-12">
            <div class="slds-align_absolute-center slds-p-around_small Notification slds-m-around_small">
                Details on Intel Customer Support services during COVID-19 global response actions.
            </div>
        </div>
    </div>
    
</aura:component>