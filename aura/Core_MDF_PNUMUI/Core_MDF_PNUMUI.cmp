<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride" access="global">
    <!--Style-->
    <aura:html tag="style">
        <!--To remove blue border-->
        .slds-fade-in-open{
        outline:none;
        }
    </aura:html>
    
    <ltng:require styles="{!$Resource.Core_MDF_SLDS262 + '/styles/salesforce-lightning-design-system.css'}" />
    <!--aura:handler name="init" value="{!this}" action="{!c.doInit}" /-->
    <div role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
        <div class="slds-modal__container">
            <c:core_MDF_LWC_AccountUser/>
        </div>
    </div>
    <div class="slds-backdrop slds-backdrop_open"></div>
</aura:component>