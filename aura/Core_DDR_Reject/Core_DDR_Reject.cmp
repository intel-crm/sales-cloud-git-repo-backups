<aura:component controller="Core_DDR_Accept_Approve_Reject_Design" implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader" access="public" >
	<aura:attribute name="alertMessage" type="String" default=""/>
    <aura:attribute name="message" type="String" default=""/>
    <aura:attribute name="designRegisObject" type="Core_Design_Registration__c"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:handler event="aura:waiting" action="{!c.waiting}"/> 
    <aura:handler event="aura:doneWaiting" action="{!c.doneWaiting}"/>
    
  	<span id="Accspinner" style="display:none;height:250px;"><lightning:spinner alternativeText="Loading" size="large"/></span>
    
    <aura:if isTrue="{!(v.alertMessage == 'success')}">
        <ui:inputSelect aura:id="pickList" multiple="false" label="Rejection Reason" value="{!v.designRegisObject.Core_Rejection_Reason_Nm__c}"/>
        <br/>
        <ui:inputTextArea aura:id="commentText" value="{!v.designRegisObject.Core_Rejection_Comment_Txt__c}" label="Rejection Comments"/>
        <br/>
        <div style="float: right;">
            <lightning:button label="Save" variant="brand" onclick="{!c.saveDesignRegistration}"/>
        </div>
        <aura:set attribute="else">
            <aura:if isTrue="{!(v.alertMessage == 'error')}">
            	<div class="slds-text-heading_small" style="padding-top:2%;">{!v.message}</div>
            </aura:if>
            <div style="float: right;padding-top: 20%;">
                <lightning:button label="Cancel" variant="brand" onclick="{!c.cancelPopup}"/>
            </div>
        </aura:set>
    </aura:if>
</aura:component>