<!-- This Component is for storing PFR Record Value on New and Edit Record Creation and is called from RecordTypeSelector Component -->
<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,lightning:actionOverride" 
				access="global" 
				Controller="Core_MDF_PartnerFundRequestCreatePage">
    <!-- Record ID and Country Options for Country Multi Select -->
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="selectedCountryOptions" type="List" default="[]" description="This attribute holds the selected value for Country Multi Select"/>
    <aura:attribute name="AllCountryOptions" type="List" default="[]" description="This attribute holds all Country values for Country Multi Select"/>
    <!-- Attributes for Reimbursement Rate -->
    <aura:attribute name="ReimbursementRateVal" type="String[]" description="Stores the selected Target Audience value from the form"/> 
    <aura:attribute name="SelReimbursementRate" type="String" default = "" description="Stores the selected Target Audience value from the form"/> 
	<!-- Subtype Multiselect -->
    
  <aura:attribute name="rsmActivityReviewerper" type="Boolean" default="false" />
	<aura:attribute name="selectedSubTypeOptions" type="List" default="[]"
				description="This attribute holds the selected value for Sub type Multi Select" />
	<aura:attribute name="activityMultiSubTypeVal" type="List" default="[]"
				description="This attribute holds all values for Sub type Multi Select" />
	<aura:attribute name="activityMultiSelSubType" type="Map" description="to store Multi Sub type values" />
	<aura:attribute name="autoPopulatePOP" type="String" />
    <aura:attribute name="isSaveDisable" type="Boolean" default ="false" />
    <aura:attribute name="isSaveandNewDisable" type="Boolean" default ="false" />
    <aura:attribute name="isSaveandNew" type="Boolean" default ="false" 
                    description="Stores the value on click of Save and New button"/>
    <aura:attribute name="isClosedActivity" type="Boolean" default ="false" />
    <!--<aura:attribute type="String" name="recordId" default=""/>-->
    <aura:attribute type="String" name="communityRecordId" default=""/>
    <aura:attribute name="checkCommunityAttribute" type="Boolean" default ="false" />
    <aura:attribute name="checkNewCommunityAttribute" type="Boolean" default ="false" />
    <aura:attribute name="checkSaveComplete" type="Boolean" default ="false" 
                    description="Stores the value when Save is completed onclick of Save and New"/>
	<aura:attribute name="count" type="Boolean" default="false"/>
	<!-- Attribute Initialization-->
	<aura:attribute type="PartnerFundRequest" name="newPFR" 
					default="{Name:'', 
                             RequestedAmount:0,
                             ChannelPartner:null,
                             Core_MDF_Competitive_Elements__c:'',
                             Core_MDF_Government_Nexus__c:'',
                             Core_MDF_ofPagesEligible__c:'',
                             Core_MDF_pagespayingfor__c:''}"
					description="Stores the field value of PFR object on Create and Edit of the record "></aura:attribute>
    <aura:attribute type="PartnerFundRequest" name="oldPFR" 
					description="Stores the actualy field value of PFR object before Editing the record "></aura:attribute>
	<aura:attribute name="SelMarketValue" type="String" default="" 
					description="Stores the selected market value from the form"/>
    <aura:attribute name="BudgetLocal" type="Integer" default="" 
					description="Stores the local budget from the form"/>
    <aura:attribute name="budgetCurrency" type="String" default="USD"
                    description="The local currency used for budget "/>
    <aura:attribute name="budgetCurrencyOld" type="String" default="USD"
                    description="The local currency used for budget "/>
    
    <aura:attribute name="createdDateClone" type="Boolean" default ="false" />
    <aura:attribute name="BudgetException" type="boolean" default="false" 
                    description="Set to true if any Exception from method called"/>
    <aura:attribute name="JointContent" type="boolean" default="false"
                    description="Joint Content for SPCF RecordType"/>
	<aura:attribute name="SelCategory" type="String" default="" 
					description="Stores the selected Activity Category value from the form"/>
	<aura:attribute name="SelActivityType" type="String" default="" 
					description="Stores the selected Activity Type value from the form"/>
    <!-- subtype single select -->					
  	<aura:attribute name="selActivitySubType" type="String" default=""
    					description="Stores the selected Activity Sub Type value from the form" />
	  <aura:attribute name="activityInApproval" type="Boolean" default=""
	    description="Stores true if Activity in Approval" />
	<aura:attribute name="SelProductType" type="String" default="" 
					description="Stores the selected Product Type value from the form"/>
	<aura:attribute name="SelBrand" type="String" default="" 
					description="Stores the selected Brand value from the form"/>	
	<aura:attribute name="SelTargetAudience" type="String" default="" 
					description="Stores the selected Target Audience value from the form"/> 	
	<aura:attribute name="selectedLookUpRecord" type="Campaign" default="{Id:null, Name:''}" 
					description="Stores the selected Campaign value from the form"/>
	<aura:attribute name="selectedPartner" type="sObject" default="{Id:null, Name:''}" 
					description="Stores the selected Account(Channel Partner) value from the form"/>	
	<aura:attribute name="additionalFilter" type="String" default="" 
					description="To add the constructed filter based on startdate and enddate for displaying the lookup(Account and Campaign) values"/>
     <aura:attribute name="BudgetType" type="String" 
                    description="The Type for budget "/>
     <aura:attribute name="currMap" type="String[]" description="Map used for Global key Map value pair for currency "/>
     <aura:attribute name="currBTMap" type="String[]" description="Map used for Global key Map value pair for Budget Type"/>
     <aura:attribute name="PriorType" type="String[]" description="Map used for Global key Map value pair for Priority Type"/>
    <!-- RecordType Attributes to Store RecordType ID, Name and DeveloperName -->
    
    <aura:attribute name="recordtype" type="String" default="" 
					description="Stores the recordtypeID from the parent component"/>
    <aura:attribute name="campriority" type="String" default=""
                    description="Stores the Priority from campaign"/>
    <aura:attribute name="campriorityValue" type="Boolean" default="false"
                    description="Stores the Priority from campaign"/>
	<aura:attribute name="recordtypeName" type="String" default="" 
					description="Stores the recordtypeName from the parent component"/>
    <aura:attribute name="recordtypeDeveloperName" type="String" default="" 
					description="Stores the recordtypeName from the parent component"/>
	<aura:attribute name="messageType" type="String" default="" 
					description="To fetch the Type of message from custom error message component"/>
	<aura:attribute name="message" type="String" default="" 
					description="To get the message from error message component"/>
	<!-- Below are the attribute defined for the Popups in the component -->
    <aura:attribute name="ShowEventPopup" type="boolean" default="false" 
					description="To diable or enable Event Popup"/>
    <aura:attribute name="ShowELCPopup" type="boolean" default="false" 
					description="To diable or enable ELC Popup"/>
    <aura:attribute name="ShowAttachmentPopup" type="boolean" default="false" 
					description="To diable or enable Attachment Popup"/>
    <aura:attribute name="EventMessage" type="String" default="" 
					description="It contains the content of popup"/>
    <aura:attribute name="AgreeButtonLabel" type="String" default="" 
					description="It contains the button labels"/>
    <aura:attribute name="DisagreeButtonLabel" type="String" default="" 
					description="It contains the button labels"/>
    <aura:attribute name="PopupType" type="String" 
					description="It contains the type of popup"/>
     <aura:attribute name="fieldNameBudgetType" type="String" default="Core_MDF_Budget_Type_nm__c" access="global"  description="Used to fetch the Global Picklist Value in Helper for Budget Type" ></aura:attribute>
    <aura:attribute name="fieldNameCurrency" type="String" default="Core_MDF_Budget_Currency_cd__c" access="global" description="Used to fetch the Global Picklist Value in Controller NZ" />
    <!-- Attribute to control status section in the UI (Status Section Should be shown in Edit Scenario Only) -->
    <aura:attribute name="checkStatusAttribute" type="Boolean" default ="True" />
	
    <!-- Attribute to Store Clone Button Variable -->
    <aura:attribute name="checkCloneAttribute" type="Boolean" default ="false" />
    <aura:attribute name="checkCloneRecordId" type="String" default ="" />

    <aura:attribute name="PopupButtonValue" type="boolean" default="false" 
					description="It stores user input of Event popup"/> 
    <aura:attribute name="ELCPopupButtonValue" type="boolean" default="false" 
					description="It stores user input of ELC popup"/>
    <!-- Below Attributes are defined for the Question Rendering -->
    <aura:attribute name="renderPrintQuestion" type="boolean" default="false" 
					description="To display print releated questions based on Activity Category and type"/>
 <aura:attribute name="renderTechExplorationQuestSection" type="boolean" default="false"
  description="To display Tech Exploration releated questions based on Activity Category and type" />
    <aura:attribute name="renderGovtQuestion" type="boolean" default="false" 
					description="To display Event releated questions based on Activity Category and Amount"/>
   <!--Attribute to dynamically display Activity Sub type -->
   <aura:attribute name="activitySubTypeAvailable" type="boolean" default="false"
   description="To display Activity Sub Type based " />  
	<!-- Below are the attribute defined for the File Upload Fucntionality -->
    <aura:attribute name="Uploadfinished" type="boolean" default="false" 
					description="Verify whether file is uploaded or not"/>
    <aura:attribute name="ContentDocumentIds" type="String[]" default="" 
					description="Stores the Uploaded Document Ids"/>
    <!-- Below attribute is for storing all the metadataMapped Records from the Custom Metadata -->
    <aura:attribute type="CCP_Attributes_Map__mdt[]" name="metadataMap" 
					default="" description="Stores the metadata values from the server side"></aura:attribute>
    <!-- Below attributes to handle the channel partner picklist selection -->
    <aura:attribute name="IsCP" type="boolean" default="false" description="To hold the value whether its a CP by category and type"/>    
    <aura:attribute name="CPLed" type="boolean" default="false" description="To hold the CP led user selected value"/>    
    <aura:attribute name="SelChannelPartner" type="String" default="" 
					description="Stores the selected channel partner value from the form"/>
    <aura:attribute name="SelOtherChannelPartner" type="String" default="" 
					description="Stores the other channel partner value from the form"/>
    <aura:attribute name="IsOtherCP" type="boolean" default="false" description="Check whether its other than regular channel partner"/>    
    <aura:attribute name="Countries" type="String[]" description="to store country/region"/>
    <aura:attribute name="ActivityCategories" type="String[]" description="to store activity categories"/>
    <aura:attribute name="ActivityTypeValues" type="String[]" description="to store activity categories"/>
	<!-- Subtype Single select attrbute -->
	<aura:attribute name="activitySubTypeValues" type="String[]" description="to store activity sub type values" />
    <aura:attribute name="ActivityTypes" type="Map" description="to store activity types"/>
    <aura:attribute name="activitySubTypes" type="Map" description="to store activity types" />
    <aura:attribute name="StatusLabel" type="String[]" description="Captures the status to be displayed for user selection"/>
    <aura:attribute name="SelectedStatus" type="String" description="It holds the status selected by user"/>
    <aura:attribute name="CountryPicklistValues" type="String" description="Stores the Label of current currency of the activity"/>
    <aura:attribute name="countryFilter" type="String" description="Stores the Search text for country filter"/>
    
    <aura:attribute name="CurrentStatus" type="String" description="Stores the api name of current status of the activity" />
	<aura:attribute name="CurrentStatusLabel" type="String" description="Stores the Label of current currency of the activity"/>
    <aura:attribute name="CurrentCurrencyLabel" type="String" description="Stores the Label of current status of the activity" default="USD - U.S.Dollar"/>
    <aura:attribute name="disabledMap" type="Map" description="stores the disable status of all controls"/>
    <aura:attribute name="ApprovalException" type="boolean" default = "false" description="Account manager edit and approval not needed"/>
  <aura:attribute name="isEventFormTemplateVisible" type="boolean" default="false"
    description="Event Form Links visibility control Flag" />
    <aura:attribute name="additionalAccFilter" type="String" default="" 
					description="To add the constructed filter based on record type for displaying the lookup(Account and Campaign) values"/>
    <!--<aura:attribute name="CmpgnSDt" type="Date" description="Stored the actual start date before edit the activity"/>
    <aura:attribute name="CmpgnEDt" type="Date" description="Stored the actual end date before edit the activity"/>
    -->
    <!-- Attributes to defined for checking the old values for defined budget -->
    <aura:attribute name="oldCampaignId" type="String" default=""/>
    <aura:attribute name="oldbudget" type="Decimal" />
    <aura:attribute name="oldcategory" type="String" />
    <aura:attribute name="oldstatus" type="String" />
    <aura:attribute name="oldsdate" type="Date" />
    <aura:attribute name="oldedate" type="Date" />
    <aura:attribute name="ChgndAttach" type="Boolean" default="false" />
    <aura:attribute name="oldActivtyType" type="String" />
    <!-- Variable Reimbursement Rate-->
  	<aura:attribute name="oldProdType" type="String" />
  	<aura:attribute name="oldBrand" type="String" />
    
    <!-- Attributes defined to get or store all the picklist value for PFR custom object -->
	<aura:attribute name="TargetAudience" type="String[]" />
    <aura:attribute name="ProductTypeValues" type="String[]"/>
    <aura:attribute name="ProductTypes" type="Map" />
    <aura:attribute name="BrandValues" type="String[]"/>
    <aura:attribute name="BrandTypes" type="Map" />
    <aura:attribute name="IsCCFBoost" type="Boolean" default="false" />
    <aura:attribute name="showSpinner" type="Boolean" default="false" />
  <!-- Event Format Related Attributes -->
  <aura:attribute name="eventFormatValues" type="String[]" />
  <aura:attribute name="eventFormats" type="Map" />
  <aura:attribute name="enableEventFormat" type="boolean" default="false"
    description="To display Event Format based on Activity Category (Event)and type (not promotion)" />
  <aura:attribute name="setEventFormatOptionOnload" type="boolean" default="false"
    description="To display Event Format based on Activity Category (Event)and type (not promotion)" />
  <aura:attribute name="selectedEventFormat" type="String" default=""
    description="Stores the selected Event Formatvalue from the form" />
  <!-- Event Format Related Attributes Ends-->
    <!-- Attribute holds all the localized picklist value on the load of the page -->
    <aura:attribute name="apitoLabelConvert" type="Map"/>
    <!-- Attribute to check budget condition for popups and question and file upload -->
    <aura:attribute name="recordApplicableForActivityRules" type="Boolean" default ="true" />
    <aura:attribute name="checkbudgetcondition" type="Boolean" default ="false" />
    <aura:attribute name="checkfileuploadcondition" type="Boolean" default ="false" />
	
	<!-- Atrribute to store the userpermissions for AM,CR and External  -->
	<aura:attribute name="userperMap" type="Map" default="{}"/>
	<aura:attribute name="fileexceptionper" type="Boolean" default="false"/>
	<aura:attribute name="auditorper" type="Boolean" default="false"/>
	<aura:attribute name="externalper" type="Boolean" default="false"/>
	<aura:attribute name="accmgrper" type="Boolean" default="false"/>
    <aura:attribute name="retailgeouserper" type="Boolean" default="false"/>
    <aura:attribute name="userWithoutAccess" type="Boolean" default="false"/>
    <aura:attribute name="isActivityReviewRequired" type="Boolean" default="false" />
        <aura:attribute name="isKPIVisible" type="Boolean" default="true"/>
    <!-- Variable Reimbursement Rate changes-->
	<aura:attribute name="incentive" type="String" default="" />
	<aura:attribute name="incentiveCriteriaId" type="String" />
	<aura:attribute name="vrQuestion" type="String" default="" />
	<aura:attribute name="vrOptInQuestion" type="String" default="" />
	<!-- Handler for on change event of above attributes and fields on the form -->
	<aura:handler name="change" value="{!v.recordtypeName}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.SelCategory}" action="{!c.resetActivtyType}" />
	<aura:handler name="change" value="{!v.SelTargetAudience}" action="{!c.resetProdType}" />
    <aura:handler name="change" value="{!v.SelProductType}" action="{!c.resetBrand}" />
    <aura:handler name="change" value="{!v.selectedLookUpRecord}" action="{!c.resetPicklistValues}" />
    <aura:handler name="change" value="{!v.SelActivityType}" action="{!c.resetActTypeDepAttributes}" />
    <aura:handler name="change" value="{!v.selectedPartner}" action="{!c.resetAccountattributes}" />
    <aura:handler name="change" value="{!v.countryFilter}" action="{!c.filterCountry}" />

    <!-- Fetch selected Country values and reset CPLed when a country value is selected or changed-->
    <aura:handler name="change" value="{!v.selectedCountryOptions}" action="{!c.setCtryResetCPLed}"/>
	<!-- Variable Reimbursement Rate changes-->
	<aura:handler name="change" value="{!v.SelBrand}" action="{!c.resetonBrandChange}" />
   
    <!--<aura:handler event="force:refreshView" action="{!c.customSave}" />-->
    <!-- Event Handler For the PickList component values change -->
    <aura:handler name="PicValue" event="c:Core_MDF_PickListChangeEvent" action="{!c.SetOtherCPValue}"/>   
	<!-- Onload of the Page the values to be loaded on New and Edit Scenario -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <!-- Event Handler For the ELC Popup -->
    <aura:handler name="ButtonClickEvent" event="c:Core_MDF_PopupButtonClick" action="{!c.hidePopup}"/>
	<!-- Event Handler For the File Update -->
    <aura:handler name="fileuploadcheck" event="c:Core_MDF_Activity_Upload_File_Event" action="{!c.uploadfile}"/>
    <!-- Event Handler For Question rendering -->
    <aura:handler name="dynamicQuestionEvt" event="c:Core_MDF_DynamicQuestionEvent" action="{!c.questions}"/>
          <!-- <aura:if isTrue="{!and(!(or(empty(v.newPFR.Id),!v.checkCloneAttribute )),
                            (v.selrecordtypeDeveloperName == $Label.c.Core_MDF_PFR_Retail))}">
        <c:Core_MDF_RCF_PFR_Create />
    </aura:if>    -->
	<!-- Variable Reimbursement Rate changes-->
  <aura:attribute name="renderVRQuestion" type="boolean" default="false" />
  <aura:attribute name="vrdata" type="List" default="" description="Stores the PFR VR data from server side" />
    
    <!-- RecordTypeSelectorComp called after save is completed -->
    <aura:if isTrue = "{!v.showSpinner}" >
      <lightning:spinner alternative-text="Loading" size="large"></lightning:spinner>
    </aura:if>
    <aura:if isTrue="{!and(v.isSaveandNew,v.checkSaveComplete)}">
        <c:Core_MDF_PFR_RecordTypeSelectorComp  checkCommunityAttribute = "{!v.checkNewCommunityAttribute}" checkSaveandNew = "{!v.isSaveandNew}"/>
	<aura:set attribute="else">
         
    <div id="pivot"></div>
	<!-- Page Starts Here -->
	<!-- PAGE HEADER -->
    <!-- Popup Message when someone tries to edit the Activity -->
    <aura:if isTrue="{!v.isClosedActivity}">
		<div aura:id="modalIdForCommuntityRecord" role="dialog" tabindex="-1" aria-labelledby="header43" class="slds-modal slds-slide-up-saving slds-modal_small"><!--class="slds-modal slds-fade-in-open slds-modal_large"-->
            <div class="slds-modal__container">
                <!-- Heading (Header of the Modal) -->
                <div class="slds-modal__header">
                    <button class="slds-button slds-modal__close slds-button--icon-inverse" title="Close" onclick="{!c.closeModalClosedActivtiy}">
                        X<span class="slds-assistive-text">{!$Label.c.Core_MDF_Cancel}</span>
                    </button>
                </div>
                <div class="slds-modal__content slds-p-around--medium">
                    <div class="slds-card slds-align_absolute-center"   >
                        <lightning:icon iconName="utility:error" variant="error"/>
                    	<div class="slds-p-around_medium slds-align_absolute-center">{!$Label.c.Core_MDF_Close_Activity_Error}</div>
                	</div>
                </div>
                <div class="slds-modal__footer">
                	<lightning:button variant="neutral" label="{!$Label.c.Core_MDF_Cancel}" onclick="{!c.closeModalClosedActivtiy}"/>
                </div>
            </div>
        </div>
        <div aura:id="backdropIdForNewRecord" class="slds-backdrop slds-backdrop--open"></div>
	</aura:if>

	<lightning:layout class="slds-page-header slds-page-header--object-home" aura:id="header">
		<lightning:layoutItem>
		<lightning:icon iconName="standard:partner_fund_request" class="icn" alternativeText="My Activities"/>
		</lightning:layoutItem>
		<lightning:layoutItem padding="horizontal-small">
		<div class="page-section page-header">
		<h1 class="slds-text-heading--label">{!$Label.c.Core_MDF_Activity_Creation_Page_Header}</h1>
		<h2 class="slds-text-heading--medium">My {!$Label.c.Core_MDF_Activity_Creation_Page_Header}</h2>
		</div>
		</lightning:layoutItem>
	</lightning:layout>
	<!-- / PAGE HEADER -->
	<!--Error Messages-->
	<aura:if isTrue="{!empty(v.message)}">
		<div ></div> 
		<aura:set attribute="else">
               <div align="center"><c:Core_MDF_ErrorMessage type="{!v.messageType}" message="{!v.message}" /></div>   
		</aura:set>
	</aura:if> 
    <!--Event and ELC Popup-->
    <aura:if isTrue="{!v.ShowEventPopup}">
    	<c:Core_MDF_ELCPopup EventMessage="{!v.EventMessage}" AgreeLabel="{!v.AgreeButtonLabel}" DisagreeLabel="{!v.DisagreeButtonLabel}" PopupType="{!v.PopupType}"/>

    </aura:if>
	<div class="slds-card">
		<div class="slds-p-around_large">
			<form class="slds-form--stacked">
                <!-- Status Section -->
                <aura:if isTrue="{!v.checkStatusAttribute}">
                  		<lightning:layout class="slds-page-header slds-page-header--object-home">
                            <lightning:layoutItem padding="horizontal-small">
                                <div class="page-section page-header">
                                    <h1 class="slds-text-heading--label">{!$Label.c.Core_MDF_ActivityStatusSection}</h1>
                                </div>
                            </lightning:layoutItem>
                        </lightning:layout>
                        <!-- Fund Request Status Field-->
                        <lightning:layout horizontalAlign="spread" multipleRows="true">
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>                       
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                                <aura:if isTrue="{!(v.CurrentStatus != $Label.c.Core_MDF_PFRStatus)}">
                                    <lightning:select name="SelectStatus" label="{!$Label.c.Core_MDF_StatusLabelValue}" value="{!v.SelectedStatus}" disabled="{!v.disabledMap.frstatus}">
                                        <option text="{!v.CurrentStatusLabel}" value=""></option>
                                        <aura:iteration items="{!v.StatusLabel}" var="i">
                                            <option text="{!i.label}" value="{!i.value}"></option>
                                        </aura:iteration>
                                    </lightning:select>
                                     <aura:set attribute="else">
                                         <lightning:select name="SelectStatus" label="{!$Label.c.Core_MDF_StatusLabelValue}" value="{!v.SelectedStatus}" disabled="{!v.disabledMap.frstatus}">
                                              <option text="{!v.CurrentStatusLabel}" value=""></option>
                                        </lightning:select>   
                                     </aura:set>
                                </aura:if>    
                            </lightning:layoutItem>
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>                       
                            <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                        </lightning:layout>
                </aura:if>
				<!-- DETAIL SECTION HEADER -->
				<lightning:layout class="slds-page-header slds-page-header--object-home">
					<lightning:layoutItem padding="horizontal-small">
						<div class="page-section page-header">
							<h1 class="slds-text-heading--label">{!$Label.c.Core_MDF_Activity_Creation_Detail_Section}</h1>
						</div>
					</lightning:layoutItem>
				</lightning:layout>
                
				<!-- NAME AND DESCRIPTION FIELD -->	
                <lightning:layout horizontalAlign="spread" multipleRows="true">
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem> 
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
						<lightning:input aura:id="NewForm" label="{!$Label.c.Core_MDF_A_description_of_the_activity_to_be_performed}" name="Title"  value="{!v.newPFR.Title}" required="true" disabled="{!v.disabledMap.name}"/> 
					</lightning:layoutItem>  
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                          <aura:if isTrue = "{!v.recordtypeDeveloperName != $Label.c.Core_MDF_PFR_DescriptionRepositionRequiredRecordType}">
                                <!-- DESCRIPTION FIELD for CCF/DCF/SPCF/CCFB -->                
						<lightning:textarea aura:id="NewForm" label="{!$Label.c.Core_MDF_Activity_Description}" required="true" name="Description" value="{!v.newPFR.Core_MDF_Activity_Description__c}" disabled="{!v.disabledMap.desc}"/>
                            </aura:if>
					</lightning:layoutItem>  
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem> 
				</lightning:layout>
                
				<!-- START DATE AND END DATE FIELD -->		 
				<lightning:layout horizontalAlign="spread" multipleRows="true">
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                        <lightning:input aura:id="NewForm" type="date" label="{!$Label.c.Core_MDF_Start_Date}" required="true" name="startDate" onchange="{!c.createAdditionalfilter}"  value="{!v.newPFR.Core_MDF_Start_Date__c}" disabled="{!v.disabledMap.sdate}"/>           
					</lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
						<lightning:input aura:id="NewForm" type="date" label="{!$Label.c.Core_MDF_End_Date}" required="true" name="endDate" onchange="{!c.createNewAdditionalfilter}" value="{!v.newPFR.Core_MDF_End_Date__c}" disabled="{!v.disabledMap.edate}"/>           
					</lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
				</lightning:layout>
                <!--Retail Related changes-->
                
                <aura:if isTrue = "{!v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_Retail}">
                    <!-- CAMPAIGN LOOKUP AND  PRIORITY FIELD -->                
                    <lightning:layout horizontalAlign="spread" multipleRows="true"> 
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                            <c:Core_Intel_customLookup objectAPIName="campaign" selectedRecord="{!v.selectedLookUpRecord}"
                                                       sAdditionalFilter="{!v.additionalFilter}" label="{!$Label.c.Core_MDF_Campaign}"
                                                       IconName="standard:campaign" disabled="{!v.disabledMap.cmpgn}"/>                    
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                            <lightning:select aura:id="NewForm"  name="priorityType" value="{!v.campriority}" label="{!$Label.c.Core_MDF_Priority}" disabled = "{!v.disabledMap.priority}">
                                <aura:iteration items="{!v.PriorType}" var="item" >
                                    <option  value="{!item.key}" >
                                        {!item.value}
                                    </option>
                                </aura:iteration>
                            </lightning:select>
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                    </lightning:layout>
                 <!-- ACCOUNT and Budget Type -->
                    <lightning:layout horizontalAlign="spread" multipleRows="true"> 
						<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
						<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
							<!--<c:Core_Intel_customLookup objectAPIName="Account" selectedRecord="{!v.selectedPartner}" sAdditionalFilter="{!v.additionalAccFilter}" label="{!$Label.c.Core_MDF_Channel_Partner}" IconName="standard:account" disabled="{!v.disabledMap.acct}"/>         
                            <lightning:input aura:id="NewForm" type="text" label="Budget Type" disabled="true" value="{!v.selectedLookUpRecord.Core_MDF_Account__c}"/> -->
                            <lightning:input aura:id="NewForm" type="text"  label="{!$Label.c.Core_MDF_PFR_Account}" value="{!v.selectedLookUpRecord.Core_MDF_Account__r.Name}" disabled="true" />
                        </lightning:layoutItem> 
						<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                            <lightning:input aura:id="NewForm" type="text" label="{!$Label.c.Core_MDF_Budget_Type}" disabled="true" value="{!v.selectedLookUpRecord.Core_MDF_Budget_Type_txt__c}"  /> 
                        </lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem> 
					</lightning:layout>
				<!-- CHANNEL PARTNER AND BUDGET AMOUNT FIELD -->
				<lightning:layout horizontalAlign="spread" multipleRows="true">
						<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>        
						<!-- Budget Currency Section -->
                    	<lightning:layoutItem padding="around-small" flexibility="grow" size="1.5" mediumDeviceSize="1.5" largeDeviceSize="1.5">
                  <lightning:select aura:id="BudgetCurrency456" name="BudgetCurrency" value="{!v.budgetCurrency}"
                      label="{!$Label.c.Core_MDF_Budget_Currency}" 
                      disabled="{!v.disabledMap.budget}" onchange="{!c.calculateBudgetAmount}">
                      <aura:iteration items="{!v.currMap}" var="item">
                      <aura:if isTrue="{!((not(empty(v.newPFR.Id))) || (v.checkCloneAttribute))}"><!-- Edit and Clone to get the data from PFR  -->
                        <option value="{!item.key}" selected="{!item.key == v.newPFR.Core_MDF_Budget_Currency_cd__c}">
                          {!item.value}
                        </option>
                      <aura:set attribute="else"><!-- For New, USD is default  -->
                        <option value="{!item.key}" selected="{!item.key == 'USD'}">
                          {!item.value}
                        </option>
                      </aura:set>
                      </aura:if>
                      </aura:iteration>
                    </lightning:select></lightning:layoutItem>
						<lightning:layoutItem padding="around-small" flexibility="grow" size="2" mediumDeviceSize="2" largeDeviceSize="2">
                       		<lightning:input aura:id="NewForm" type="number" label="{!$Label.c.Core_MDF_Budget_Amount}" required="true" name="BudgetAmount" onblur = "{!c.calculateBudgetAmount}" value="{!v.BudgetLocal}" min="0" step="any" disabled="{!v.disabledMap.budget}"/>                     </lightning:layoutItem>
					
                    
                    
                     <!-- Reimbursement rate picklist display--> 
                    <!--<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>   -->
                   <!-- <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem> -->
                    <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">                        
                        	 <aura:if isTrue = "{!v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_Retail}">                                                                  
										<c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Reimbursement_Rate_pct__c" ParentId="" 
														recTypeName="{!v.recordtypeName}" ParentfldName="" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                        selectedValue = "{!v.SelReimbursementRate}"
                                                       options="{!v.ReimbursementRateVal}" dispLabel="{!$Label.c.Core_MDF_Reimbursement_Rate}" disabled="{!v.disabledMap.reimbursement}"/>                                                              
                             </aura:if>
                        </lightning:layoutItem>
                       <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>             				                    
                    </lightning:layout>
               <aura:set attribute="else">
				<!-- CAMPAIGN LOOKUP AND  PRIORITY FIELD -->                
				<lightning:layout horizontalAlign="spread" multipleRows="true"> 
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
						<c:Core_Intel_customLookup objectAPIName="campaign" selectedRecord="{!v.selectedLookUpRecord}"
											sAdditionalFilter="{!v.additionalFilter}" label="{!$Label.c.Core_MDF_Campaign}"
                                            IconName="standard:campaign" disabled="{!v.disabledMap.cmpgn}"/>                    
					</lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
						<lightning:input aura:id="NewForm" type="text" label="{!$Label.c.Core_MDF_Priority}" disabled="true"  value="{!v.selectedLookUpRecord.Core_MDF_Priority__c}" />   
					</lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
				</lightning:layout>
				<!-- CHANNEL PARTNER AND BUDGET AMOUNT FIELD -->
				<lightning:layout horizontalAlign="spread" multipleRows="true">
						<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>        
						<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
							<c:Core_Intel_customLookup objectAPIName="Account" selectedRecord="{!v.selectedPartner}" sAdditionalFilter="{!v.additionalAccFilter}" label="{!$Label.c.Core_MDF_Channel_Partner}" IconName="standard:account" disabled="{!v.disabledMap.acct}"/>                    
						</lightning:layoutItem> 		
                     <!-- Budget Currency Section -->
                    	<lightning:layoutItem padding="around-small" flexibility="grow" size="1.5" mediumDeviceSize="1.5" largeDeviceSize="1.5">
                    <lightning:select aura:id="BudgetCurrency456" name="BudgetCurrency" value="{!v.budgetCurrency}"
                      label="{!$Label.c.Core_MDF_Budget_Currency}" 
                      disabled="{!v.disabledMap.budget}" onchange="{!c.calculateBudgetAmount}">
                      <aura:iteration items="{!v.currMap}" var="item">
                      <aura:if isTrue="{!((not(empty(v.newPFR.Id))) || (v.checkCloneAttribute))}"><!-- Edit and Clone to get the data from PFR  -->
                        <option value="{!item.key}" selected="{!item.key == v.newPFR.Core_MDF_Budget_Currency_cd__c}">
                          {!item.value}
                        </option>
                      <aura:set attribute="else"><!-- For New, USD is default  -->
                        <option value="{!item.key}" selected="{!item.key == 'USD'}">
                          {!item.value}
                        </option>
                      </aura:set>
                      </aura:if>
                      </aura:iteration>
                    </lightning:select>
                  </lightning:layoutItem>
						<lightning:layoutItem padding="around-small" flexibility="grow" size="2" mediumDeviceSize="2" largeDeviceSize="2">
                       		<lightning:input aura:id="NewForm" type="number" label="{!$Label.c.Core_MDF_Budget_Amount}" required="true" name="BudgetAmount" onblur = "{!c.calculateBudgetAmount}" value="{!v.BudgetLocal}" min="0" step="any" disabled="{!v.disabledMap.budget}"/>                     </lightning:layoutItem>
						<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                    </lightning:layout>
                    </aura:set>
                </aura:if>
                
               
                
				<!-- ADDITIONAL DETAIL SECTION START -->
				<lightning:layout class="slds-page-header slds-page-header--object-home">
					<lightning:layoutItem padding="horizontal-small">
						<div class="page-section page-header">
							<h1 class="slds-text-heading--label">{!$Label.c.Core_MDF_Activity_Creation_Additional_Section}</h1>
						</div>
					</lightning:layoutItem>
				</lightning:layout>
                    <!--- Country filter and Target Audience-->
                    <lightning:layout horizontalAlign="spread" multipleRows="true"> 
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                            <lightning:input type="text" value="{!v.countryFilter}" label="{!$Label.c.Core_MDF_Country_Filter}" disabled="{!v.disabledMap.country}" />
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                            <aura:if isTrue = "{!empty(v.selectedLookUpRecord.Id)}">
                                <aura:if isTrue = "{!((v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_CCF)||(v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_CCF_Boost))}">
                                <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_TargetAudience__c" ParentId="" 
                                                            recTypeName="{!v.recordtypeName}" ParentfldName="" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                            selectedValue="{!v.SelTargetAudience}" dispLabel="{!$Label.c.Core_MDF_Target_Audience}" disabled="{!v.disabledMap.audience}"
															options = "{!v.TargetAudience}" labelValueMap="{!v.apitoLabelConvert}"/>
									<aura:set attribute="else">
                                        <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_TargetAudience__c" 
                                                             ParentId="" ParentfldName="" recTypeName="{!v.recordtypeName}" 
                                                             selectedValue="{!v.SelTargetAudience}" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                             dispLabel="{!$Label.c.Core_MDF_Target_Audience}"
                                                             disabled="{!v.disabledMap.audience}" labelValueMap="{!v.apitoLabelConvert}" />
                                    </aura:set>
                                </aura:if>
								<aura:set attribute="else"> 
                                    <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_TargetAudience__c" ParentId="{!v.selectedLookUpRecord.Id}" 
                                                            recTypeName="{!v.recordtypeName}" ParentfldName="Core_MDF_Audience__c" 
                                                            selectedValue="{!v.SelTargetAudience}" 
                                                            dispLabel="{!$Label.c.Core_MDF_Target_Audience}" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                            disabled="{!v.disabledMap.audience}"
                                                            options = "{!v.TargetAudience}" labelValueMap="{!v.apitoLabelConvert}" />
                                </aura:set>
                            </aura:if>             
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                     </lightning:layout>
                    <!-- MARKET AND TARGET AUDIENCE FIELDS -->
                    <lightning:layout horizontalAlign="spread" multipleRows="true">  
              <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                largeDeviceSize="3"></lightning:layoutItem>
              <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                largeDeviceSize="3">
                                <!-- Multi-Select Country --> 
                    <c:Core_MDF_CustomMultiSelectPicklist objName="PartnerFundRequest" fldName="Core_MDF_Country_nm__c"
                      RecId="{!v.recordId}" CloneRecId="{!v.checkCloneRecordId}" CommunityRecId="{!v.communityRecordId}"
                      dispLabel="{!$Label.c.Core_MDF_Market}" disabled="{!v.disabledMap.country}"
                                                  availableOptions = "{!v.AllCountryOptions}" selectedOptions = "{!v.selectedCountryOptions}"/> 
                        </lightning:layoutItem>
              <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                largeDeviceSize="3" />
              <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                largeDeviceSize="3" />
                    </lightning:layout>
                    <!-- PRODUCT TYPE AND BRAND FIELDS -->			
                    <lightning:layout horizontalAlign="spread" multipleRows="true"> 
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">   
                            <aura:if isTrue = "{!empty(v.selectedLookUpRecord.Id)}">
								<aura:if isTrue = "{!((v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_CCF)||(v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_CCF_Boost))}">
                                <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_ProductType__c" ParentId="" 
                                                            ParentfldName="" recTypeName="{!v.recordtypeName}" 
                                                            selectedValue="{!v.SelProductType}" dispLabel="{!$Label.c.Core_MDF_Product_Type}" 
                                                            recTypeDevName="{!v.recordtypeDeveloperName}"
                                                            controllingvalue="{!v.SelTargetAudience}" disabled="{!v.disabledMap.prodtype}"
															options = "{!v.ProductTypeValues}" labelValueMap="{!v.apitoLabelConvert}"/>
									<aura:set attribute="else">
                                        <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_ProductType__c" 
                                                             ParentId="" ParentfldName="" recTypeName="{!v.recordtypeName}" 
                                                             selectedValue="{!v.SelProductType}" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                             dispLabel="{!$Label.c.Core_MDF_Product_Type}" controllingvalue="{!v.SelTargetAudience}"
                                                             disabled="{!v.disabledMap.prodtype}" labelValueMap="{!v.apitoLabelConvert}" />
                                    </aura:set>
                                </aura:if>
                                <aura:set attribute="else"> 
                                    <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_ProductType__c" 
                                                            ParentId="{!v.selectedLookUpRecord.Id}" ParentfldName="Core_MDF_Product_Type__c" 
                                                            recTypeName="{!v.recordtypeName}" selectedValue="{!v.SelProductType}" 
                                                            dispLabel="{!$Label.c.Core_MDF_Product_Type}" disabled="{!v.disabledMap.prodtype}"
                                                            controllingvalue="{!v.SelTargetAudience}" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                                 options = "{!v.ProductTypeValues}" labelValueMap="{!v.apitoLabelConvert}" />
                                </aura:set>
                            </aura:if>                    
                        </lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                              	<aura:if isTrue = "{!empty(v.selectedLookUpRecord.Id)}">
								<aura:if isTrue = "{!((v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_CCF)||(v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_CCF_Boost))}">
                                <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Brand__c" 
                                                        ParentId="" ParentfldName="" recTypeName="{!v.recordtypeName}" 
                                                        selectedValue="{!v.SelBrand}" dispLabel="{!$Label.c.Core_MDF_Brand}" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                        controllingvalue="{!v.SelProductType}" disabled="{!v.disabledMap.brand}"
														options = "{!v.BrandValues}" labelValueMap="{!v.apitoLabelConvert}"/>
									<aura:set attribute="else">
                                        <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Brand__c" 
                                                             ParentId="" ParentfldName="" recTypeName="{!v.recordtypeName}" 
                                                             selectedValue="{!v.SelBrand}" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                             dispLabel="{!$Label.c.Core_MDF_Brand}" controllingvalue="{!v.SelProductType}"
                                                             disabled="{!v.disabledMap.brand}" labelValueMap="{!v.apitoLabelConvert}" />
                                    </aura:set>
                                </aura:if>
								<aura:set attribute="else"> 
                                    <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Brand__c" 
															ParentId="{!v.selectedLookUpRecord.Id}" ParentfldName="Core_MDF_Brand__c" 
															recTypeName="{!v.recordtypeName}" selectedValue="{!v.SelBrand}" recTypeDevName="{!v.recordtypeDeveloperName}"
															dispLabel="{!$Label.c.Core_MDF_Brand}" disabled="{!v.disabledMap.brand}"
															controllingvalue="{!v.SelProductType}" options = "{!v.BrandValues}" 
															labelValueMap="{!v.apitoLabelConvert}"/>
								</aura:set>
						</aura:if>                    
					</lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
				</lightning:layout> 
				<!-- ACTIVITY CATEGORY AND ACTIVITY TYPE FIELD -->
                <lightning:layout horizontalAlign="spread" multipleRows="true">  
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">   
						<aura:if isTrue="{!empty(v.selectedLookUpRecord.Id)}">
                           <!-- Activity Category and Type non-dependency on Campaign selection -->
                                <aura:if
                    isTrue="{!((v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_Retail))}">
                           <!--     <aura:if isTrue = "{!v.recordtypeName == $Label.c.Core_MDF_CCF_RecordType}"> -->                                                       
								<c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_ActivityCategory__c" 
														 ParentId="" ParentfldName="" recTypeName="{!v.recordtypeName}" 
                                                         selectedValue="{!v.SelCategory}" 
                                                         dispLabel="{!$Label.c.Core_MDF_Activity_Category}" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                         options = "{!v.ActivityCategories}" disabled="{!v.disabledMap.category}" labelValueMap="{!v.apitoLabelConvert}"/>
                                <aura:set attribute="else">
                                    <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_ActivityCategory__c" 
														 ParentId="" ParentfldName="" recTypeName="{!v.recordtypeName}" 
                                                         selectedValue="{!v.SelCategory}" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                         dispLabel="{!$Label.c.Core_MDF_Activity_Category}"
                                                         disabled="{!v.disabledMap.category}" labelValueMap="{!v.apitoLabelConvert}" />
                                </aura:set>
                            </aura:if>
                            <aura:set attribute="else"> 
                                <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_ActivityCategory__c" 
                                                             ParentId="{!v.selectedLookUpRecord.Id}" ParentfldName="Core_MDF_Activity_Category__c" 
                                                             recTypeName="{!v.recordtypeName}" selectedValue="{!v.SelCategory}" 
                      recTypeDevName="{!v.recordtypeDeveloperName}" dispLabel="{!$Label.c.Core_MDF_Activity_Category}"
                      options="{!v.ActivityCategories}" disabled="{!v.disabledMap.category}"
                      labelValueMap="{!v.apitoLabelConvert}" olPfrStatus="{!v.oldPFR.Core_MDF_Fund_Request_Status__c}" IsClone="{!v.checkCloneAttribute}"/>
							</aura:set>
						</aura:if>                    
					</lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">   
						<aura:if isTrue="{!empty(v.selectedLookUpRecord.Id)}">
                            <!-- Activity Category and Type non-dependency on Campaign selection -->
                                <aura:if
                    isTrue="{!((v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_Retail))}">
                    <!--<aura:if isTrue = "{!v.recordtypeName == $Label.c.Core_MDF_CCF_RecordType}"> -->
                                <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Activity_Types__c" 
                                                            ParentId="" ParentfldName="" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                            recTypeName="{!v.recordtypeName}" selectedValue="{!v.SelActivityType}" 
                                                            dispLabel="{!$Label.c.Core_MDF_Activity_Type}" controllingvalue="{!v.SelCategory}"
                                                            options="{!v.ActivityTypeValues}" disabled="{!v.disabledMap.type}" labelValueMap="{!v.apitoLabelConvert}" />
                                <aura:set attribute="else">
                                    <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Activity_Types__c" 
                                                            ParentId="" ParentfldName="" recTypeDevName="{!v.recordtypeDeveloperName}"
                                                            recTypeName="{!v.recordtypeName}" selectedValue="{!v.SelActivityType}" 
                                                            dispLabel="{!$Label.c.Core_MDF_Activity_Type}" controllingvalue="{!v.SelCategory}"
                                                            disabled="{!v.disabledMap.type}" labelValueMap="{!v.apitoLabelConvert}" />
                                </aura:set>
							</aura:if>
							<aura:set attribute="else"> 
								<c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Activity_Types__c" 
														ParentId="{!v.selectedLookUpRecord.Id}" ParentfldName="Core_MDF_Activity_Type__c" 
                      recTypeDevName="{!v.recordtypeDeveloperName}" recTypeName="{!v.recordtypeName}"
                      selectedValue="{!v.SelActivityType}" dispLabel="{!$Label.c.Core_MDF_Activity_Type}"
                      options="{!v.ActivityTypeValues}" disabled="{!v.disabledMap.type}"
                      controllingvalue="{!v.SelCategory}" labelValueMap="{!v.apitoLabelConvert}" olPfrStatus="{!v.oldPFR.Core_MDF_Fund_Request_Status__c}" IsClone="{!v.checkCloneAttribute}"/>

							</aura:set>
						</aura:if>                    
					</lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                    </lightning:layoutItem>
				</lightning:layout>
      <!-- Showing Activity Sub Type field on the activity create, clone and edit page dependent on the Activity Type field value, 
        only if there is a dependent activity subtype value
        US680463 Dev- Hamza  Date: 06-01-2020 -->
	          <aura:if isTrue="{!v.activitySubTypeAvailable}">
              <lightning:layout horizontalAlign="spread" multipleRows="true">
                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                  largeDeviceSize="3"></lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                  largeDeviceSize="3">
                  <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Activity_SubType_nm__c"
                  recTypeDevName="{!v.recordtypeDeveloperName}" recTypeName="{!v.recordtypeName}"
                  selectedValue="{!v.selActivitySubType}" dispLabel="{!$Label.c.Core_MDF_Activity_Sub_Type_nm}"
                  options="{!v.activitySubTypeValues}" disabled="{!v.disabledMap.type}"
                  controllingvalue="{!v.SelActivityType}" labelValueMap="{!v.apitoLabelConvert}" />
                </lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                  largeDeviceSize="3"></lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                  largeDeviceSize="3"></lightning:layoutItem>
              </lightning:layout>
            </aura:if>
                    <!-- KPI Fields Test Starts --> 
                    <lightning:layout horizontalAlign="spread" multipleRows="true">
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="6" mediumDeviceSize="6" largeDeviceSize="6">
                            <c:core_MDF_KPI_Fields aura:id="kpiFields" />
                        </lightning:layoutItem>                     
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>                     
                    </lightning:layout>
                    <!-- KPI Fields Test Ends -->        
            
			<aura:if isTrue="{!v.enableEventFormat}">
              <lightning:layout horizontalAlign="spread" multipleRows="true">
                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                  largeDeviceSize="3"></lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                  largeDeviceSize="3">
                  <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Event_Format_Nm__c"
                    ParentId="" ParentfldName="" recTypeDevName="{!v.recordtypeDeveloperName}"
                    recTypeName="{!v.recordtypeName}" selectedValue="{!v.selectedEventFormat}" dispLabel="{!$Label.c.Core_MDF_Event_Format_Label}"
                    options="{!v.eventFormatValues}" disabled="{!v.disabledMap.eventFormat}"
                    controllingvalue="{!v.SelActivityType}" labelValueMap="{!v.apitoLabelConvert}" />
                </lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                  largeDeviceSize="3"></lightning:layoutItem>
                <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3"
                  largeDeviceSize="3"></lightning:layoutItem>
              </lightning:layout>
            </aura:if>
                  <!-- Joint Content -->
                <aura:if isTrue ="{!v.recordtypeDeveloperName == $Label.c.Core_MDF_SPCF_Program}">
                <lightning:layout horizontalAlign="spread" multipleRows="true">
                    <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                    <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                        <lightning:input type="checkbox" name="jointContent" label="{!$Label.c.Core_MDF_Joint_Content_Chechbox}" aura:id="NewForm" checked="{!v.JointContent}" disabled="{!v.disabledMap.jointcontent}"/> 
                    </lightning:layoutItem>
                    <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                    <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                 </lightning:layout>
                </aura:if>
                <aura:if isTrue = "{!v.recordtypeDeveloperName != $Label.c.Core_MDF_PFR_Retail}">
                <!-- Channel partner block -->
				<lightning:layout horizontalAlign="spread" multipleRows="true">
                    <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">   
                        <!--<aura:if isTrue ="{!v.recordtypeName != $Label.c.Core_MDF_SPCF_RecordType}">-->
                        <aura:if isTrue ="{!v.recordtypeDeveloperName != $Label.c.Core_MDF_SPCF_Program}">
                        <lightning:input type="checkbox" name="inputCPLed" label="{!$Label.c.Core_MDF_CP_Led}" aura:id="inputCPLed" class="slds-p-vertical_small" checked="{!v.CPLed}" disabled="{!v.disabledMap.cpled}"/> <!-- {!v.disabledMap.cpled} -->
                        </aura:if>
					</lightning:layoutItem>
                    <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">   
						<aura:if isTrue="{!(v.CPLed)}">                           
                            <c:Core_Intel_customPicklist objName="PartnerFundRequest" fldName="Core_MDF_Channel_Partner__c" 
                                                         recTypeDevName="{!v.recordtypeDeveloperName}"
														ParentId="" ParentfldName="" CPLed="{!v.CPLed}" Ctry="{!v.SelMarketValue}"
														recTypeName="{!v.recordtypeName}" selectedValue="{!v.SelChannelPartner}" dispLabel="{!$Label.c.Core_MDF_CP}"
                                                        controllingvalue="{!v.SelMarketValue}" disabled="{!v.disabledMap.cp}"/>							                                                       
						</aura:if>   
                        <aura:if isTrue="{!and(v.IsOtherCP,v.CPLed)}">
                            <lightning:input type="text" name="inputOtherCP" value="{!v.SelOtherChannelPartner}" label="{!$Label.c.Core_MDF_Other_CP}" aura:id="inputOtherCP" class="slds-p-vertical_small" disabled="{!v.disabledMap.ocp}" required="true"/>
						</aura:if> 
					</lightning:layoutItem>
                    <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                    </lightning:layoutItem>
                </lightning:layout>
                </aura:if>
                <!-- QUESTIONS SECTION START -->
				<!-- Variable Reimbursement Rate changes-->
				<aura:if isTrue="{!v.renderVRQuestion}">
				  <lightning:layout class="slds-page-header slds-page-header--object-home">
					<lightning:layoutItem padding="horizontal-small">
					  <div class="page-section page-header">
					    <!--Help Text Start -->
					    <div class="slds-grid">
					      <div class="slds-col topPaddingClass"><h1 class="slds-text-heading--label">{!$Label.c.Core_MDF_VR_Section}</h1></div>
					      <aura:if isTrue="{!v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_CCF}">
						<div class="slds-col"><lightning:helptext content="{!$Label.c.Core_MDF_Activity_VR_Help_Text}" /></div>
					      </aura:if>
					    </div>
					    <!-- Help Text End -->
					  </div>
					</lightning:layoutItem>
				  </lightning:layout>
				  <c:Core_MDF_VRQuestion newPFRq="{!v.newPFR}"
					showVR="{!v.renderVRQuestion}"
					IncentiveQuestionLbl="{!v.vrQuestion}"
					IncentiveOptInLbl="{!v.vrOptInQuestion}"
					disabled="{!v.disabledMap.vrquestions}" />
				</aura:if>
			
            <!-- Print Media, Government Question, Tech Exploration SECTION  -->
            <aura:if isTrue="{!(v.renderPrintQuestion || v.renderGovtQuestion || v.renderTechExplorationQuestSection)}">
                    <lightning:layout class="slds-page-header slds-page-header--object-home">
                        <lightning:layoutItem padding="horizontal-small">
                            <div class="page-section page-header">
                                <h1 class="slds-text-heading--label">{!$Label.c.Core_MDF_Questions_Section}</h1>
                            </div>
                        </lightning:layoutItem>
                    </lightning:layout>
              <c:Core_MDF_DynamicQuestionsComp newPFRq="{!v.newPFR}" renderPrintQuestions="{!v.renderPrintQuestion}"
                renderGovtQuestions="{!v.renderGovtQuestion}" renderTechExplorationQuestSection = "{!v.renderTechExplorationQuestSection}" disabled="{!v.disabledMap.questions}" />
                </aura:if>
                
				<!-- UPLOAD FILE SECTION START -->
            <!--Modified Date : 4-June-2020 Modified By : NZ Description : Display Upload File Section visibilty to Content Creation-->
                <aura:if isTrue="{!v.checkfileuploadcondition}">
              <c:Core_MDF_Activity_Upload_File disabled="{!v.disabledMap.attachement}"  createEditPFRAttr="True" displayEventTemplate="{!v.isEventFormTemplateVisible}"
                contentdocumentids="{!v.ContentDocumentIds}" />
				</aura:if>
		<!--- POP Requirements Information for Retail -->
            <aura:if
              isTrue="{!and(v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_Retail, !v.autoPopulatePOP != null)}">
              <lightning:layout horizontalAlign="spread" multipleRows="true">
                <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                  largeDeviceSize="1" />
                <lightning:layoutItem padding="around-small" flexibility="grow" size="10" mediumDeviceSize="10"
                  largeDeviceSize="10">
                  <lightning:textarea aura:id="NewForm" label="{!$Label.c.Core_MDF_POP_Requirements}"
                    name="{!$Label.c.Core_MDF_POP_Requirements}" value="{!v.autoPopulatePOP}" disabled="true" />
                </lightning:layoutItem>
                <!-- <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1" largeDeviceSize="1"/>-->
                <lightning:layoutItem padding="around-small" flexibility="grow" size="1" mediumDeviceSize="1"
                  largeDeviceSize="1" />
              </lightning:layout>
            </aura:if>
                

				<!-- SAVE AND CANCEL -->			
				<lightning:layout horizontalAlign="spread" multipleRows="true">
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="2" mediumDeviceSize="2" largeDeviceSize="2">
						<div align="right">
                            <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Cancel}" onclick="{!c.closeModal}"/>
						</div>
                    </lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="2" mediumDeviceSize="2" largeDeviceSize="2">
						<div align="center">	
                        	<lightning:button aura:id="SaveandNew" variant="Neutral" disabled="{!v.isSaveandNewDisable}" label="{!$Label.c.Core_MDF_Save_and_New}" onclick="{!c.customSave}"/>
                        </div>
                    </lightning:layoutItem>
                    <lightning:layoutItem padding="around-small" flexibility="grow" size="2" mediumDeviceSize="2" largeDeviceSize="2"> 
                        <div align="left">
							<lightning:button aura:id="Save" variant="brand" disabled="{!v.isSaveDisable}" label="{!$Label.c.Core_MDF_Save}" onclick="{!c.customSave}"/>
                        </div>
                    </lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
				</lightning:layout> 
			</form>
		</div>
	</div>
        </aura:set>       
  </aura:if>
<!-- Page Ends Here -->	
</aura:component>