                    description="This attribute holds all BU Split avaliable values" />
    <aura:attribute name="buSplitSelectedList" type="List" default="[]"
                    description="This attribute holds all BU Split selected values" />
    <aura:attribute name="showBuSplitSection" type="Boolean" default="false" />
    <!--<aura:attribute type="Core_MDF_BU_Splits__mdt" name="metadataBuSplitMap" default=""
                    description="Stores the metadata values from the server side"></aura:attribute>-->
    <aura:attribute name="buSplitList" type="List" default="[]"
                    description="This attribute holds all BU Split selected values" />
   
    <aura:attribute name="isEMEARegion" type="Boolean" default="false" />
    <aura:attribute name="defaultBUPercent" type="String" default="" />
    <aura:attribute name="defaultBU" type="String" default="" />
    <aura:attribute name="busplitTotalPercentage" type="Integer" />
    <aura:attribute name="intelContribution" type="Double" />
        <aura:attribute name="showBUSPlitMultiselect" type="boolean" default="false"/>
