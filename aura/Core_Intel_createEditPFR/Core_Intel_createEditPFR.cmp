<!-- This Component is for storing PFR Record Value on New and Edit Record Creation and is called from RecordTypeSelector Component -->
<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,lightning:actionOverride" 
                access="global" 
                Controller="Core_MDF_PartnerFundRequestCreatePage">
    
    <aura:html tag="style">
        .slds-modal__container{
        max-width: 70rem !important;
        width:90% !important;
        
        }
 <!-- Added By Salesforce Support for testing. -->
 .quick-actions-panel .slds-modal__content {
height: auto !important;
max-height: none !important;
overflow-y: visible !important;
}
        
    </aura:html>
        <aura:html tag="style">.toastMessage.forceActionsText{
			white-space : pre-line !important;}
    </aura:html>

     <!-- [IPA - Budget CAP]  - [OOC - P8] - Internal Account Manager/External - Validation Reimbursement Amount against Budget CAP-->    
    <aura:attribute name="chkBdgtCpExcd" type="boolean" default ="false" />
    <!-- Record ID and Country Options for Country Multi Select -->
    <aura:attribute name="recordId" type="Id" />
     <aura:attribute name="vrQuestionList" type="String[]" />
    <aura:attribute name="selectedCountryOptions" type="List" default="[]" description="This attribute holds the selected value for Country Multi Select"/>
    <!-- Attribute Holds value of Industry values [ww35] -->
    <aura:attribute name="selectedIndustryOptions" type="List" default="[]" description="This attribute holds the selected value for Industry Multi Select"/>
     <aura:attribute name="selectedBrandOptions" type="List" default="[]"
                    description="This attribute holds the selected value for Brand Multi Select" />
    <aura:attribute name="selectedApproverOptions" type="List" default="[]" description="This attribute holds the selected value for Approver Multi Select"/>
    <aura:attribute name="selectedPrimaryApproverOptions" type="List" default="[]" description="This attribute holds the selected value for Approver Multi Select"/>
    <aura:attribute name="selectedExtActSubmitterOptions" type="List" default="[]" description="This attribute holds the selected value for Submitter Multi Select"/>
    <aura:attribute name="AllCountryOptions" type="List" default="[]" description="This attribute holds all Country values for Country Multi Select"/>
    <!-- Declared attribute allIndustryOptions to show values available on Campaign -->
   <aura:attribute name="allIndustryOptions" type="List" default="[]" description="This attribute holds all Industry values for Industry Multi Select"/>
    <aura:attribute name="AllBrandOptions" type="List" default="[]"
                    description="This attribute holds all Country values for Country Multi Select" />
    <aura:attribute name="AllApproverOptions" type="List" default="[]" description="This attribute holds all Country values for Approver Multi Select"/>
   <aura:attribute name="AllPrimaryApproverOptions" type="List" default="[]" description="This attribute holds all Country values for Primary Approver Multi Select"/>
  <aura:attribute name="AllExtActSubmitterOptions" type="List" default="[]" description="This attribute holds all values for Submitter Multi Select"/>
    <aura:attribute name="AllCountryOptionsMain" type="List" default="[]" description="This attribute holds all Country values for Country Multi Select"/>
