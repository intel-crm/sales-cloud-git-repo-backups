    <aura:attribute name="checkCommunityAttribute" type="Boolean" default ="false" />
    <aura:attribute name="checkNewCommunityAttribute" type="Boolean" default ="false" />
    <aura:attribute name="checkSaveComplete" type="Boolean" default ="false" 
