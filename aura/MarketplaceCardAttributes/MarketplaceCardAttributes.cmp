<aura:component >
    
    <aura:attribute name="partnerId" type="String"  />
    <aura:attribute name="typ" type="String" default="partner" /> 
    <aura:attribute name="attributes" type="Object[]" default="[]" description="data array that contains the different card attribute  entries. please see documentation tab for data structure" />
    <aura:attribute name="editEnabled" type="boolean" default="false" />
    <aura:attribute name="enableCountLimit" type="boolean" default="false" />
    <aura:attribute name="countLimit" type="Integer" default="2" />
    <aura:attribute name="mdaId" type="string" default="" />
    <aura:attribute name="isProductCard" type="boolean" default="true" />
    
    <aura:attribute name="isCompanyInformation" type="boolean" default="false"/> <!-- added by kartik as part of defect DE77473 -->
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
     
    
    <div class="{! join(' ', 'cardAttributes', ( v.enableCountLimit ? 'countLimit' : '' )) }">
        
        
        
        <aura:iteration items="{!v.attributes}" var="item">
            
            
            <div class="{! join(' ', 'slds-m-bottom_medium', item.displayOnly == 'mobile' ? 'slds-hide_medium' : '', item.displayOnly == 'desktop' ? 'slds-show_medium' : '') }">
                
                <aura:if isTrue="{! and (item.isEditable,  v.editEnabled ) }">
                    <h4><span class="editLabel">{! item.name}</span><c:MarketplaceEditPencilCmp currentStep="2" partnerId="{!v.partnerId}"></c:MarketplaceEditPencilCmp></h4>
                    <aura:set attribute="else">
                        <h4>{! item.name}</h4>
                    </aura:set>
                </aura:if>
                
                <!-- If there is an edit add it here if authorized -->
                
                
                <aura:if isTrue="{! !empty(item.types) }">
                    <ul>
                        <!-- assumes attributes link to L2 page if type.searchParams are set -->
                        <aura:iteration items="{!item.types}" var="type" indexVar="idx">
                            <aura:if isTrue="{! or (!v.enableCountLimit, v.countLimit >= idx+1 )}">
                                <li class="{!join(' ', (v.countLimit >= idx+1 ? 'beforeLimit' : 'afterLimit'), (idx+1 == v.countLimit ? 'atLimit' : ''))}">
                                <!--    {!type.name}  -->
                                    <aura:if isTrue="{!v.isProductCard}">
                                        <!-- SEO friendly IntelLink for product card -->
                                        
                                        <aura:if isTrue="{!type.searchParams}">
                                            
                                            <c:IntelLink partnerMDAId="{!v.mdaId}" LabelHeader="{!item.name}" title="{!type.name}" url="" recordId="{!type.searchParams.cat}" objectApiName="PMP_Category__c" label="{!type.name}"/>
                                        </aura:if>
                                        <aura:set attribute="else">  
                                            
                                            <aura:if isTrue="{!type.searchParams}">  
                                                
                                                <c:IntelLink partnerMDAId="{!v.mdaId}" LabelHeader="{!item.name}" title="{!type.name}" url="" recordId="{!type.searchParams.specialty}" objectApiName="PMP_Partner_Specialty__c" label="{!type.name}"/>
                                            </aura:if>  
                                        </aura:set>    
                                    </aura:if>
                                    
                                    <aura:if isTrue="{! and(type.page , !type.searchParams) }">
                                        
                                        <c:psMpLink communityPage="{!type.page}" label="{!type.name}"></c:psMpLink>
                                    </aura:if>
                                    <aura:if isTrue="{! and(type.link , !type.searchParams) }">
                                        
                                        <c:IntelLink partnerMDAId="{!v.mdaId}" LabelHeader="{!item.name}" title="{!type.name}" url="{!type.link}" label="{!type.name}" openInBlank="true"/>
                                    </aura:if>
                                                                   
                                    <aura:if isTrue="{! and( and(empty(type.link), empty(type.page)) , empty(type.searchParams)) }">
                                        <span class="staticLabel">{!type.name}</span>
                                    </aura:if>
                                    
                                    <aura:if isTrue="{! v.enableCountLimit }">
                                        
                                        <aura:if isTrue="{! and (idx+1 == v.countLimit, item.types.length > v.countLimit ) }">
                                            <span class="countOver">(+{! item.types.length - v.countLimit})</span>
                                        </aura:if>
                                    </aura:if>
                                    <span class="separator"></span>
                                </li>
                            </aura:if>
                        </aura:iteration>
                    </ul>
                </aura:if>
                
                
                <aura:if isTrue="{! !empty(item.typeGroupings) }">
                    <aura:iteration items="{!item.typeGroupings}" var="typeGroup">
                        <h5>{! typeGroup.name}</h5>
                        <ul>
                            <aura:iteration items="{!typeGroup.types}" var="type" indexVar="idx">
                                <aura:if isTrue="{! or (!v.enableCountLimit, v.countLimit >= idx+1 )}">
                                    <li class="{!join(' ', (v.countLimit >= idx+1 ? 'beforeLimit' : 'afterLimit'), (idx+1 == v.countLimit ? 'atLimit' : ''))}">
                                        <aura:if isTrue="{!type.searchParams.contextualCat}">
                                            
                                            <!--<c:IntelLink page="search" searchParams="{!type.searchParams}">{!type.name}</c:IntelLink> -->
                                            <c:IntelLink pageType="PartnerDetailPage" partnerMDAId="{!v.mdaId}" LabelHeader="{!item.name}" title="{!type.name}" url="" recordId="{!type.searchParams.cat}" objectApiName="PMP_Category__c" label="{!type.name}" />
                                            <aura:set attribute="else">
                                                <!--Region Link changed by Kartik-->
                                                <c:IntelLink pageType="PartnerDetailPage" partnerMDAId="{!v.mdaId}" LabelHeader="{!item.name}" title="{!type.name}" url="" recordId="{!type.searchParams.cat}" objectApiName="PMP_Specification__c" label="{!type.name}" />
                                                
                                            </aura:set>
                                        </aura:if>
                                        <aura:if isTrue="{! and(type.page , !type.searchParams) }">
                                            <c:psMpLink communityPage="{!type.page}" label="{!type.name}"></c:psMpLink>
                                        </aura:if>
                                        <aura:if isTrue="{! and(type.link , !type.searchParams) }">
                                            
                                            <!--<c:IntelLink url="{!type.link}" >{!type.name}</c:IntelLink> -->
                                            <c:IntelLink pageType="PartnerDetailPage" partnerMDAId="{!v.mdaId}" LabelHeader="{!item.name}" title="{!type.name}" url="{!type.link}" label="{!type.name}" />
                                        </aura:if>
                                        <aura:if isTrue="{! and(or(!type.page, !type.link) , !type.searchParams) }">
                                            <span class="staticLabel">{!type.name}</span>
                                        </aura:if>
                                        <aura:if isTrue="{! v.enableCountLimit }">
                                            <aura:if isTrue="{! and (idx+1 == v.countLimit, item.types.length > v.countLimit ) }">
                                                <span class="countOver">(+{! item.types.length - v.countLimit})</span>
                                            </aura:if>
                                        </aura:if>
                                        <span class="separator"></span>
                                    </li>
                                </aura:if>
                            </aura:iteration>
                        </ul>
                    </aura:iteration>
                </aura:if>
                <aura:if isTrue="{! !empty(item.textBlock) }">
                    <lightning:formattedRichText value="{!item.textBlock}"/>
                </aura:if>
                <aura:if isTrue="{! !empty(item.cta) }">
                    <div class="slds-m-top_x-small">
                        <c:IntelLink url="{!item.cta.link}" openInBlank="true">{!item.cta.name} <lightning:icon iconName="utility:chevronright"
                                                                                                                class="cursor icon-xx-small slds-m-left_xxx-small link-caret"
                                                                                                                size="x-small"/></c:IntelLink>
                    </div>
                </aura:if>
            </div>
        </aura:iteration>
        
    </div>
    
</aura:component>