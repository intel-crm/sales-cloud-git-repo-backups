<aura:component>
    <aura:handler name="init" value="{!this}" access="global" action="{!c.doInit}" />
    <aura:attribute name="documentTypes" type="String" />
    <aura:attribute name="element" type="String" />
    <aura:attribute name="checkboxName" type="String" />
    <aura:attribute name="condition" type="Boolean" default="false" />
    <aura:attribute name="disabled" type="Boolean" default="false" />
    <aura:attribute name="checkboxvalue" type="Boolean" default="false" />
    <aura:attribute name="typeOfDocuments" type="List"/>
    <aura:registerEvent name="checkboxChangeEvent" type="c:Core_MDF_checkboxChangeEvent" />
    
    <lightning:input aura:id="testCheckbox" type="checkbox" value="false" checked="{!v.condition}"
        name="{!v.checkboxName}" onchange="{!c.fireParentEvent}" disabled="{!v.disabled}" />

</aura:component>