<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader,lightning:actionOverride,lightning:isUrlAddressable" access="global">
    
    <aura:attribute name="appName" type="String"/>
    <lightning:workspaceAPI aura:id="workspace"/>
    <div>
        <c:core_IPS_AddMembers_Lex aura:id="projEdit" recordId="{!v.recordId}" onappnamedata="{!c.handleClose}"></c:core_IPS_AddMembers_Lex>
    </div>
</aura:component>