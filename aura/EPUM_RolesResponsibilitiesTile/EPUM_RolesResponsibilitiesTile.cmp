<aura:component implements="forceCommunity:availableForAllPageTypes,force:hasRecordId" access="global">
    <aura:attribute name="myRoleDetail" type="sObject"/>
    <aura:attribute name="data" type="Object"/>
    <aura:attribute name="columns" type="List"/>
    <aura:attribute name="totalRecords" type="Integer"/>
        
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <c:EPUM_RolesAndResponsibilityUtility aura:id="child" />
    
    <div class="c-container">
        <div class="spinnerHolder slds-hide" aura:id="mySpinner" >
            <lightning:spinner aura:id="Spinner" alternativeText="Loading" size="medium" variant="brand" />
        </div>
        <lightning:layout multipleRows="true">
            
            <lightning:layoutItem padding="around-small" size="12">
                <div class="slds-text-heading_large">
                    Responsibilities
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem padding="around-small" size="3">
                <div class="page-section page-right">
                    <div class="slds-text-heading_medium">
                        You:
                    </div>
                    <lightning:layout >                        
                        <lightning:layoutItem>
                            <div class="page-section page-main">
                                <c:EPUM_RolesAndResponsibilityCard myRoleDetail="{!v.myRoleDetail}"/>
                            </div>
                        </lightning:layoutItem>
                    </lightning:layout>
                    
                    <lightning:layout>
                        <div>
                            <lightning:button class="slds-button slds-button_brand slds-p-horizontal_none"
                                              label="Manage Roles and Responsibilities"
                                              title="Manage Roles and Responsibilities"
                                              onclick="{!c.goToURL}"/>
                        </div>
                    </lightning:layout>
                    
                    
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem flexibility="auto" padding="around-small" size="9">
                <div class="page-section page-right">
                    <lightning:layoutItem padding="around-small">
                        <div class="slds-text-heading_medium">
                            Company Personnel
                        </div>                    
                    </lightning:layoutItem>
                    <lightning:layout >
                        
                        <lightning:layoutItem>
                            <c:EPUM_RolesAndResponsibilityListView totalRecords="{!v.totalRecords}" 
                                                                   data="{!v.data}" 
                                                                   columns="{!v.columns}"/>
                        </lightning:layoutItem>
                    </lightning:layout>
                </div>
                
            </lightning:layoutItem>
            
            
        </lightning:layout>
        
    </div>
</aura:component>