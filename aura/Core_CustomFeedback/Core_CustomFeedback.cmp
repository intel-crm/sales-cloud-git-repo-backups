<aura:component controller = "Core_FeedbackController" implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId" access="global">
   
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="recordId" type="Id"/>
    <aura:attribute name="objValue" type="String"/>
    <aura:attribute name="userValue" type="String"/>
    <aura:attribute name="feedbackrecId" type="String"/>
    <aura:attribute name="isModalOpen" type="boolean" default="false"/>
    <aura:attribute name="rating" type="string"/>
    <aura:attribute name="userComments" type="string"/>
    <aura:attribute name="popUpHeading" type="string" />
    
    <aura:handler event="force:refreshView" action="{!c.doInit}" />
    <!--<aura:handler name="change" value="{!v.numItems}" action="{!c.doInit}" />-->

    <div class="slds-m-around_xx-large">  
        <aura:if isTrue="{!v.isModalOpen}">
            <!-- Modal/Popup Box starts here-->
            <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                <div class="slds-modal__container">
                    <!-- Modal/Popup Box Header Starts here-->
                    <header class="slds-modal__header">
                        <lightning:buttonIcon iconName="utility:close"
                                              onclick="{! c.closeModel }"
                                              alternativeText="close"
                                              variant="bare-inverse"
                                              class="slds-modal__close"/>
                        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!v.popUpHeading}</h2>
                    </header>
                    <!--Modal/Popup Box Body Starts here-->
                    <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                        
                        <!--<lightning:recordEditForm aura:id="recordEditForm"
                           objectApiName="Core_Custom_Feedback__c" onsuccess="{! c.closeModel}">
                        <lightning:messages />
                            <c:Core_FiveStarRating value="{!v.rating}" readonly="false"/>
                        <lightning:inputField fieldName="Core_Rating__c" />
                        <lightning:inputField fieldName="Core_Comments__c" />    
                        <lightning:button class="slds-m-top_small" variant="brand" type="submit" label="Submit" />
                        <lightning:inputField fieldName="Core_Area_Of_Feedback__c" class="slds-hide" value="{!v.objValue}" />    
                        <lightning:inputField fieldName="Core_User__c" class="slds-hide" value="{!v.userValue}" />
                        <lightning:inputField fieldName="Core_Feedback_Record_Id__c" class="slds-hide" value="{!v.feedbackrecId}" />    
                        
                    </lightning:recordEditForm>-->
                        <div class="slds-p-horizontal_medium">
                            <p>Rating</p>
                            <c:Core_FiveStarRating value="{!v.rating}" readonly="false"/>
                            <lightning:textarea name="userComments" label="Comments(Optional)" value="{!v.userComments}"/>
                            <lightning:button class="slds-m-top_small" variant="brand" onclick="{!c.handleSave}" label="Submit Feedback" /> 
                        </div>
                    </div>
                     
                    <!--Modal/Popup Box Footer Starts here-->
                    <footer class="slds-modal__footer">
                        
                    </footer>
                </div>
            </section>
            <div class="slds-backdrop slds-backdrop_open"></div>
        </aura:if>
    </div>
    
</aura:component>