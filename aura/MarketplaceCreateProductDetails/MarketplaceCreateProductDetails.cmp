<aura:component controller="MarketplaceProductDetailsController">

  <aura:attribute name="details" type="object[]" default="[
    {
      categoryLabel: 'Offering Name',
      value: 'Inspiron 2-in-1 Laptop'
    },
    {
      categoryLabel: 'Offering Details',
      listing: [
        { label: 'Category', value: 'System' },
        { label: 'Sub-Category', value: 'Laptop' },
        { label: 'Industries', value: 'Communication and Networking, Industrial Automation and Energy' },
        { label: 'Application(s)', value: 'Digital Security Surveillance' },
        { label: 'Country', value: 'Rest of Asia Pacific' },
        { label: 'End Customer Type', value: 'Enterprise' },
      ]
    },
    {
      categoryLabel: 'Intel Technologies',
      listing: [
        { label: 'Processor', value: '8th Gen Intel Core' }
      ]
    }]" />
    <!--Added by raj to populate productcard on create offering wizard-->
    <aura:attribute name="offeringName" type="String"/>
    <aura:handler event="c:PMP_OfferingNameEvent" action="{!c.handleNameEntered}"/>
    <aura:attribute name="offeringDetails" type="Map"/>
    <aura:method name="reInit" action="{!c.doInit}"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
	<!--End-->

  <aura:attribute name="isOpen" type="boolean" default="true" />
  <aura:attribute name="percent" type="integer" default="50" />

  <div>
    <div class="bgWhite slds-p-around_medium ">
      <h1 class="heading-20">{!$Label.c.PMP_MyOffering}
        <div onclick="{!c.handleToggleIsOpen}" class="toggleOpenIcon">
          <lightning:icon iconName="{!v.isOpen ? 'utility:chevronup' : 'utility:chevrondown'}" />
        </div>
      </h1>
    </div>

    <aura:if isTrue="{!v.isOpen}">
      <!--<div class="bgWhite slds-p-around_medium slds-m-bottom_xxx-small">
        <div class="slds-p-bottom_small heading-13 uppercase">{!$Label.c.PMP_Offering_Completeness}</div>
        <div class="progressBar slds-m-bottom_small">
          <div class="bar" style="{! 'width:'+ v.percent + '%;'}"></div>
        </div>
        <div>{!v.percent}%</div>
        <div>You’re almost there! You just need to lorem ipsum dolor sit amet.</div>
          <div>{!$Label.c.PMP_OfferingCompletenessMsg}</div>
      </div>-->
      <aura:iteration items="{!v.details}" var="category">
        <div class="bgWhite slds-p-around_medium slds-m-bottom_xxx-small">
          <div class="heading-13 uppercase">{!category.categoryLabel}</div>
          <aura:if isTrue="{! !empty(category.value) }">
            <div class="slds-p-top_xx-small"><b>{!category.value}</b></div>
          </aura:if>
          <aura:if isTrue="{! !empty(category.listing) }">
            <aura:iteration items="{!category.listing}" var="detail">
              <div class="slds-p-vertical_small">
                <div>{!detail.label}</div>
                <div class="slds-p-top_xx-small"><b>{!detail.value}</b></div>
              </div>
            </aura:iteration>
          </aura:if>
        </div>

      </aura:iteration>


    </aura:if>
  </div>

</aura:component>