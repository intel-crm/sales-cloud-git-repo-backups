<aura:component
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction"
    access="global" controller="Core_Intel_customPicklistController">
    <aura:attribute name="objName" type="String" default="" required="true"
        description="This attribute holds the Object name" />
    <aura:attribute name="fldName" type="String" default="" required="true"
        description="This attribute holds the Field name" />
    <aura:attribute name="recTypeName" type="String" default="None" required="true" access="public"
        description="This attribute holds the Record Type name" />
    <aura:attribute name="recTypeDevName" type="String" default="None" required="true" access="public"
        description="This attribute holds the Record Type Dev Name" />
    <aura:attribute name="ParentId" type="String" default="" description="This attribute holds the Id" />
    <aura:attribute name="ParentfldName" type="String" default=""
        description="This attribute holds the Parent Field name" />
    <aura:attribute name="selectedValue" type="String" default=""
        description="This attribute holds the selected value" />
    <aura:attribute name="dispLabel" type="String" default="" description="This attribute holds the display label" />
    <aura:attribute name="options" type="String[]"
        description="This attribute holds the picklist values for activity category and type for CCF record type" />
    <aura:attribute name="ccfoptions" type="String[]"
        description="This attribute holds the picklist values for activity category and type for CCF record type" />
    <aura:attribute name="myoptions" type="String[]"
        description="This attribute holds the picklist values coming from campaign" />
    <aura:attribute name="controllingvalue" type="String" default=""
        description="This attribute holds the controlling value" />
    <aura:attribute name="CPLed" type="boolean" default="false" description="To hold the CP led user selected value" />
    <aura:attribute name="Ctry" type="String" default=""
        description="Stores the selected country at parent component" />
    <aura:attribute name="disabled" type="boolean" default="false" description="Set the picklist disabled" />
    <aura:attribute name="waitForValuesToLoad" type="boolean" default="false" description="Set the picklist disabled" />
    <aura:attribute name="isEdit" type="boolean" default="true" />
    <aura:attribute name="fetchPicklistValuesFromCampaign" type="boolean" default="true" />
    <aura:attribute name="stoploop" type="boolean" default="true" />
    <aura:attribute name="labelValueMap" type="Map"
        description="stores all the picklist values on the load of the page" />
    <aura:attribute name="labelList" type="List" description="stores all the picklist values on the load of the page" />
    <!--Attributes to Store Values of the picklist field from PartnerFundRequest  -->
    <aura:attribute name="optionPFRActCat" type="String[]" default=""
        description="This attribute holds the picklist values for activity category for CCF record type for PFR Object" />
    <aura:attribute name="optionPFRActType" type="String[]" default=""
        description="This attribute holds the picklist values for activity type for CCF record type for PFR Object" />
    <aura:attribute name="optionPFRCountry" type="String[]" default=""
        description="This attribute holds the picklist values for country for CCF record type for PFR Object" />
    <!--OPAL Changes Start-->
    <aura:attribute name="isOpalAct" type="boolean" default="false" />
    <!--OPAL Changes Start-->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.options}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.recTypeName}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.controllingvalue}" action="{!c.doInit}" />

    <aura:attribute name="olPfrStatus" type="String" default=""
        description="This attribute holds the old status of activity" />
    <aura:attribute name="IsClone" type="boolean" default="false" />
    <aura:attribute name="isRequired" type="boolean" default="true" />
    <!--aura:handler name="change" value="{!v.waitForValuesToLoad}" action="{!c.doInit}"/-->

    <aura:registerEvent name="PicValue" type="c:Core_MDF_PickListChangeEvent" />
    <!-- SS - Event to return the values to parent component -->
    <div class="slds-form-element">
        <div class="slds-select_container">
            <aura:if isTrue="{!not(v.fetchPicklistValuesFromCampaign)}">
                <lightning:select name="mySelect" label="{!v.dispLabel}" aura:id="mySelect" value="{!v.selectedValue}"
                                  required="{!v.isRequired}" onchange="{!c.handleChange}" disabled="{!v.disabled}" class="{!if(v.recTypeDevName == $Label.c.Core_MDF_IPA_RecordType,'elementLabel','')}">
                    <!-- onchange="{!c.handleChange}" -->
                    <aura:if isTrue="{!empty(v.ccfoptions)}">
                        <aura:iteration items="{!v.options}" var="item">
                            <aura:if isTrue="{!item.label != null}">
                                <option text="{!item.label}" value="{!item.value}"
                                    selected="{!item.value == v.selectedValue}" /><!-- {!item.value}-options: -->
                                {item.value}
                            </aura:if>
                        </aura:iteration>
                        <aura:set attribute="else">
                            <aura:iteration items="{!v.ccfoptions}" var="item">
                                <aura:if isTrue="{!item.label != null}">
                                    <option text="{!item.label}" value="{!item.value}"
                                        selected="{!item.value == v.selectedValue}" /><!-- {!item.value}->options: -->
                                    {item.value}
                                </aura:if>
                            </aura:iteration>
                        </aura:set>
                    </aura:if>
                </lightning:select>
                <aura:set attribute="else">
                    <lightning:select name="mySelect" label="{!v.dispLabel}" aura:id="mySelect"
                                      value="{!v.selectedValue}" required="true" onchange="{!c.handleChange}"
                                      disabled="{!v.disabled}" class="{!if(v.recTypeDevName == $Label.c.Core_MDF_IPA_RecordType,'elementLabel','')}">
                        <!-- onchange="{!c.handleChange}" -->
                        <aura:if isTrue="{!v.isEdit}">
                            <aura:iteration items="{!v.myoptions}" var="item">
                                <aura:if isTrue="{!item.label != null}">
                                    <!--<option text="{!item.label}" value="{!item.value}" selected="{!item.value == v.selectedValue}"/>-->
                                    <option text="{!item.label}" value="{!item.value}"
                                        selected="{!item.value == v.selectedValue}" />
                                </aura:if>
                            </aura:iteration>
                            <aura:set attribute="else">
                                <aura:iteration items="{!v.myoptions}" var="item">
                                    <aura:if isTrue="{!item.label != null}">
                                        <option text="{!item.label}" value="{!item.value}"
                                            selected="{!item.value == v.selectedValue}" />
                                    </aura:if>
                                </aura:iteration>
                            </aura:set>
                        </aura:if>
                    </lightning:select>
                </aura:set>
            </aura:if>
            <!--</aura:if>-->
        </div>
    </div>
    <aura:method name="validateErrors" action="{!c.validateErrors}" access="PUBLIC" />  
</aura:component>