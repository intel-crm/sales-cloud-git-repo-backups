    </aura:if>	
    
    <aura:if isTrue="{!v.type == 'threeColumnLinks'}">
        <lightning:layout multipleRows="true">
            <lightning:layoutItem size="12" class="slds-p-vertical_small">
                <aura:iteration items="{!v.data}" var="item">
                    <lightning:layoutItem size="12" mediumDeviceSize="6" largeDeviceSize="12" class="slds-p-bottom_small">
                        <c:IntelLink url="{!item.link}" openInBlank="true" PartnerMDAId="{!v.mdaId}" offeringId="{!v.offeringId}" LabelHeader="{!v.Header}">
                            {!item.label}
                        </c:IntelLink>
                    </lightning:layoutItem>
                </aura:iteration>
            </lightning:layoutItem>
        </lightning:layout>
        
    </aura:if>
    
    <aura:if isTrue="{!v.type == 'marketingInfo'}">
        <lightning:layout multipleRows="true">
            <aura:iteration items="{!v.data}" var="item">
                <lightning:layoutItem size="12" class="slds-p-top_small">
                    {!item.label}
                </lightning:layoutItem>
                
            </aura:iteration>
        </lightning:layout>
        
    </aura:if>
    
    <aura:if isTrue="{!v.type == 'fullfillmentPartners'}">
        <aura:iteration items="{!v.data}" var="item">
            <aura:if isTrue="{! v.currentScreenSize == 'desktop'}">
                <lightning:layout >
                    <lightning:layoutItem size="12" mediumDeviceSize="4"  class="slds-p-vertical_small slds-p-right_xx-small">
                        {!item.name}
                    </lightning:layoutItem>
                    <lightning:layoutItem size="12" mediumDeviceSize="4" class="slds-p-vertical_small slds-p-right_xx-small">
                        <c:IntelLink url="{! item.link}" class="break-word" openInBlank="true">{!item.linkTitle}</c:IntelLink>
                    </lightning:layoutItem>
                    <lightning:layoutItem size="12" mediumDeviceSize="4" class="slds-p-vertical_small">
                        <c:IntelButton href="{!item.buyUrl}" class="inline">Buy&nbsp;Now</c:IntelButton>
                    </lightning:layoutItem>
                </lightning:layout >
                <aura:set attribute="else">
                    <lightning:layout class="borderBottom">
                        <lightning:layoutItem size="8" mediumDeviceSize="4"  class="slds-p-vertical_medium slds-p-right_xx-small break-word">
                            {!item.name}<br/>
                            <c:IntelLink url="{! item.link}" openInBlank="true">{!item.linkTitle}</c:IntelLink>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="4" mediumDeviceSize="4" class="slds-p-vertical_medium slds-text-align_right">
                            <c:IntelButton href="{!item.buyUrl}" class="inline">Buy&nbsp;Now</c:IntelButton>
                        </lightning:layoutItem>
                    </lightning:layout>
                    
                </aura:set>
            </aura:if>
        </aura:iteration>
    </aura:if>
    <aura:if isTrue="{!v.type == 'regions'}">
        <lightning:layout multipleRows="true">
            <aura:iteration items="{!v.data}" var="item">
                <lightning:layoutItem size="12" class="slds-p-top_small">
                    {!item.value}
                </lightning:layoutItem> -->
