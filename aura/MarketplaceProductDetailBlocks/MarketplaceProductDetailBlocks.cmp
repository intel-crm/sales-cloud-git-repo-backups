    <aura:if isTrue="{!v.type == 'qualityMetrics'}">
        <aura:iteration items="{!v.data.selectedQualityMetricsMap}" var="item">
            <span class="bold">{!item.masterCategory}:</span><br/><br/>
                    <ul class="specification">
                        <aura:iteration items="{!item.keyList}" var="data"> -->
                            <!-- Scneario Five: Specs below Master Category & No Space betweeen Question and answer-->
