<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader,lightning:isUrlAddressable" controller="PSG_Integration_DPA" access="global" >
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"></aura:handler>
	<!--Attributes-->
    <aura:attribute name="showConfirmDialog" type="boolean" default="false"/>
    <aura:attribute name="alnNo" type="String" />
    <aura:attribute name="orderAvailable" type="boolean" default="false"/>

      <!--Style-->
 <aura:html tag="style">
  .cuf-content {
    padding: 0 0rem !important;
    }
    .slds-p-around--medium {
    padding: 1rem !important;
    }
    .slds-modal__content{
    overflow-y:hidden !important;
    height:unset !important;
    max-height:unset !important;
    overflow-x:hidden !important;
    width:unset !important;
    max-width:unset !important; 
    }
    .slds-col{
    padding:10px;
    }
    </aura:html>
    <!--Component Start-->
	<aura:if isTrue="{!v.showConfirmDialog}">
				<!--Modal Box Start-->
				<div class="slds-border_top slds-border_right slds-border_bottom slds-border_left">
						<!--Modal Box Header Start-->
						<header class="slds-modal__header">
							<h1 class="slds-text-heading--medium">Confirmation</h1>
						</header>
						<!--Modal Box Header End-->
						 
						<!--Modal Box Content Start-->
						<div class="slds-modal__content slds-p-around--medium">
                            <aura:if isTrue="{!v.orderAvailable}">
                                <center><b>Open orders are available for ALN. Are you sure to proceed and put ALN on HOLD?</b></center>
                            	<aura:set attribute="else">
                                	<center><b>Are you sure to put the ALN on HOLD?</b></center>
                                </aura:set>
                            </aura:if>							
						</div>
						<!--Modal Box Content End-->
						 
						<!--Modal Box Button Start-->
						<footer class="slds-modal__footer">
                            <lightning:button variant="destructive" name='No' label='No' onclick='{!c.handleConfirmDialogNo}'/>
                            <lightning:button variant="success" name='Yes' label='Yes' onclick='{!c.handleConfirmDialogYes}'/>
							
						</footer>
        		</div>
						<!--Modal Box Button End-->
		<!--Component End-->
	</aura:if>
	<aura:if isTrue="{!not(v.showConfirmDialog)}">
        <div class="slds-modal__container">
			<lightning:spinner variant="brand"/>
        </div>    
	</aura:if>
</aura:component>