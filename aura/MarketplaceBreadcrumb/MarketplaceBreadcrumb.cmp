<aura:component extends="c:MarketplaceRedux" implements="forceCommunity:availableForAllPageTypes">

  <!-- Breadcrumb Object Structure: { label, data, url } -->
  <!-- If url is supplied, page will redirect -->
  <!-- If onselect is supplied, onselect will be called w/ url -->
  <aura:attribute
    name="breadcrumbData"
    type="Object[]"
    description="
      This is the data array used to generate the breadcrumbs. The format is as follows:
      [{ label: 'Internal link', url: 'XX2342id' }, { label: 'Link to external url', url: 'Link Url' }, ...],
    "/>
  <aura:attribute name="bcData" type="object[]" description="Internal data" />
  <aura:attribute name="onselect" type="object" description="Optional function callback to be called when a breadcrumb link is clicked it will have a parameter of the URL" />
  <aura:attribute name="previewMode" type="boolean" default="false" description="Turning this on will prevent and breadcrumbs from working. This is mainly used on the Offering Preview Mode"/>

  <aura:attribute name="theme" type="String" default="light" description="Used to change the theme colors for the breadcrumb"/>
  <aura:attribute name="modalOpen" type="Boolean" default="false" description="Internal component state"/>
  <aura:attribute name="internalFunction" type="Object"  access="private" description="Internal Function"/>

  <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
  <aura:handler name="change" value="{!v.breadcrumbData}" action="{!c.handleDataChange}" />


  <lightning:navigation aura:id="navService"/>

  <div aura:id="outerElement">
    <lightning:breadcrumbs class="{!v.theme + ' main-breadcrumb'}">
        <aura:iteration items="{! v.bcData }" var="crumb" indexVar="idx">
            <lightning:breadcrumb
              label="{! crumb.label }"
              href="{! crumb.url }"
              class="{!join(' ', (idx == 0 ? '': 'slds-show_medium'), (crumb.class  ? crumb.class : ''))}"
              onclick="{! crumb.class ? null : c.handleBreadCrumbClick}" />
        </aura:iteration>
        <aura:if isTrue="{! and(!empty(v.bcData) ,v.bcData.length > 1)}">
        <li class="slds-breadcrumb__item slds-hide_medium">
          <a class="slds-breadcrumb__item" itemprop="item" href="#breadcrumb-overlay" onclick="{!c.handleOpenMobileOverlay}">
            <span itemprop="name">...</span>
          </a>
        </li>
        </aura:if>
    </lightning:breadcrumbs>

    <!-- Mobile View -->
    <aura:if isTrue="{!v.modalOpen}">
      <div class="breadcrumbOverlay slds-hide_medium">
        <a class="close" href="javascript:void(0);" aria-label="{!$Label.c.Core_PMP_Close}" onclick="{!c.handleCloseMobileOverlay}">
          <lightning:icon class="icn" iconName="utility:close" size="small" />
        </a>
        <div class="">
          <ol class="breadcrumb-list">
            <lightning:breadcrumbs>
                <aura:iteration items="{! v.bcData }" var="crumb">
                    <lightning:breadcrumb
                      label="{! crumb.label }"
                      href="{! crumb.url }"
                      onclick="{!c.handleBreadCrumbClick}"
                      class="{!join(' ', (crumb.class  ? crumb.class : ''))}"
                    />
                </aura:iteration>
            </lightning:breadcrumbs>
          </ol>
        </div>
      </div>
    </aura:if>
  </div>

</aura:component>