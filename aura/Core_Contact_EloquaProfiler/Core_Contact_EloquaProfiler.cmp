<aura:component controller = "Core_EloquaProfilerController" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,force:hasSObjectName" access="global" >
    
    <aura:attribute name="urlParams" type="String"/>
    <aura:attribute name="data" type="object" />
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="email" type="String" />
    <!--<aura:handler event="aura:waiting" action="{!c.showSpinner}"/>
    <aura:handler event="aura:doneWaiting" action="{!c.hideSpinner}"/>-->
    <aura:attribute name="isLoaded" type="boolean" default="false" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>    
    
    <div class= "slds-spinner_container slds-is-relative">
        <aura:if isTrue="{!!v.isLoaded}">
            <lightning:spinner aura:id="mySpinner" alternativeText="Processing.." title="Processing.." variant="brand" size="large"/>
        </aura:if>
        <lightning:card iconName="standard:apex_plugin" title="Eloqua Profiler"> <!--title="Eloqua Profiler" -->
            <aura:set attribute="title">
                <a ><span onclick="{! c.openLink }">Eloqua Profiler </span></a>
            </aura:set>
            <aura:set attribute="actions">
                <lightning:buttonIcon iconName="utility:contract_alt" size="large" variant="bare" onclick="{! c.openLink }" alternativeText="Pop Out"/>
            </aura:set>
            <p class="slds-p-horizontal_small">
                <aura:if isTrue="{!not(empty(v.urlParams))}">
                	<!--<iframe src="{!v.urlParams}" width="100%" height="400px;" />-->
                </aura:if>
            </p>
           </lightning:card>
    </div>
</aura:component>