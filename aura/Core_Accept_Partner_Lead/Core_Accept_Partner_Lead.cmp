<aura:component >
    <aura:attribute name="showMessage" type="String"/>
    <aura:attribute name="listViewUrl" type="String" default=""/>
    
    <div role="dialog" tabindex="-1" aria-labelledby="header99" class="slds-modal slds-fade-in-open ">
        <div class="slds-modal__container">
            <!-- ###### MODAL BOX HEADER Part Start From Here ######-->
            <div class="slds-modal__header" style="border-color: white;">
<button class="slds-button slds-modal__close" title="Close" onclick="{!c.closeModel}">
<lightning:icon iconName="utility:close" size="medium"/>
<span class="slds-assistive-text">Close</span>
</button>
</div>

            <!--###### MODAL BOX BODY Part Start From Here ######-->
            <div class="slds-modal__content slds-p-around--medium" style="text-align: center;">
                <p><b>{!v.showMessage}</b></p>
            </div>
            <!--###### MODAL BOX FOOTER Part Start From Here ######-->
            <div class="slds-modal__footer" style="border-color: white;">
                <button class="slds-button slds-button--brand" onclick="{!c.closeModel}" >Close</button>
            </div>
        </div>
    </div>
    <div class="slds-backdrop slds-backdrop--open"></div>
</aura:component>