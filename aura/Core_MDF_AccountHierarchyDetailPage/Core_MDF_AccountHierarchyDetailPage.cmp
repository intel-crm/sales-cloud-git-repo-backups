<aura:component  controller="Core_MDF_AcctHierarchyDetailController" implements="force:hasRecordId,force:lightningQuickAction,flexipage:availableForRecordHome" >
    <aura:attribute name="ltngcurrentRecId" type="String" />    
	<aura:attribute name="gridColumns" type="list" />
    <aura:attribute name="gridData" type="Object" />
    <aura:attribute name="gridExpandedRows" type="List" access="PRIVATE" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
   
    <h3 class="slds-section-title--divider"><b> <lightning:icon iconName="utility:switch" alternativeText="" size="x-small" /> Account Hierarchy</b></h3>
    
    <lightning:treeGrid 
        columns="{! v.gridColumns }"
        ltngcurrentRecId ="{! v.recordId }"
        data="{! v.gridData }"
        keyField="name"
        expandedRows="{! v.gridExpandedRows}"
        aura:id="mytree" />
</aura:component>