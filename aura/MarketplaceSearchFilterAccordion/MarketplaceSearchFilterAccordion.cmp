<aura:component extends="c:MarketplaceRedux" description="Accordion component for the Marketplace Search Filters">
    
    <aura:attribute name="open" type="boolean" default="false" description="If true, accordion is expanded by default." />
    <aura:attribute name="title" type="string" default="category" description="The text that displays as the accordion title" />
    <aura:attribute name="class" type="string" description="A CSS class for the outer element" />
    
    <div class="{!v.class + ' slds-p-around_small'}">
        
        <div class="slds-p-vertical_small">
            <a href="#" class="toggle darkTheme" onclick="{!c.handleToggleOpen}">
                <span class="iconWrap">
                    <lightning:icon
                                    class="slds-m-right_small cursor"
                                    iconName="{!v.open ? 'utility:chevrondown' : 'utility:chevronright'}"
                                    />
                </span>
                <span class="h5 title">{!v.title}</span>
            </a>
        </div>
        
        <!-- [Hemanta] Display the entire content available between open & close tag of this component -->
        <aura:if isTrue="{!v.open}">
            <div>
                {!v.body}
            </div>
        </aura:if>
        
    </div>
    
</aura:component>