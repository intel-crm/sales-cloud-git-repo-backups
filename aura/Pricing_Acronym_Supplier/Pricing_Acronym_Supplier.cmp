<aura:component controller="Pricing_CommentsController"
	implements="forceCommunity:availableForAllPageTypes,lightning:actionOverride,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome"
	access="global">
	<aura:handler name="init" value="{!this}" action="{!c.doInit}" />
	<aura:attribute name="inputText" type="string" />
	<aura:attribute name="integrationStatus" type="string" />
	<aura:attribute name="errorMessage" type="string" />
	<aura:attribute name="acronym" type="string" default="" />
	<aura:attribute name="programType" type="string" />

	<aura:attribute name="iconName" type="string" default="" />
	<aura:attribute name="alternativeText" type="string" default="" />
	<aura:attribute name="variant" type="string" default="" />
	<aura:attribute name="isRPMUser" type="boolean" default="false" />

	<aura:if isTrue="{!v.isRPMUser}">
		<div style="white-space: nowrap !important;display: inline-block;">
			<aura:if isTrue="{!and(v.integrationStatus != '',v.isRPMUser)}">
				<lightning:icon class="slds-var-p-right_xxx-small" iconName="{!v.iconName}"
					alternativeText="{!v.alternativeText}" title="{!v.alternativeText}" variant="{!v.variant}"
					size="x-small" />
			</aura:if>
		</div>
	</aura:if>
</aura:component>