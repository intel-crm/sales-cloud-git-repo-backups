<aura:component controller="Core_Claim_Lead_Ctrl" implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader" access="public" >
    <aura:attribute name="popupMsg" type="String" default=""/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:handler event="aura:waiting" action="{!c.waiting}"/> 
    <aura:handler event="aura:doneWaiting" action="{!c.doneWaiting}"/>
    
    <span id="Accspinner" style="display:none;height:250px;"><lightning:spinner alternativeText="Loading" size="large"/></span>
    <aura:if isTrue="{!(v.popupMsg != null)}">
        <div class="slds-text-heading_small">{!v.popupMsg}</div>
        <div style="float: right;padding-top: 2%;">
            <lightning:button label="OK" variant="brand" onclick="{!c.cancelPopup}"/>
        </div>
    </aura:if>
</aura:component>