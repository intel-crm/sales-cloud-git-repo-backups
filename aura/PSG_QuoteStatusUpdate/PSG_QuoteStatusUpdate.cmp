<!-- ****************************************************************************************************
*Lightning Component: PSG_QuoteStatusUpdate
*Created Date    : 01/18/2020
*Purpose: Lightning Component to update the Quote Status to the selected value by clicking on the "Change Status" button through Quick Action
*****************************************************************************************************
* Developer                   Date                   Description
* **********************************************************************************************                
* Tushar                      01/18/2020               Created
***************************************************************************************************** -->
<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader,forceCommunity:availableForAllPageTypes" 
                controller="PSG_CreateQuoteController" access="global" >
	    <aura:html tag="style">
    .cuf-content {
    padding: 0 0rem !important;
    }
    .slds-p-around--medium {
    padding: 0rem !important;
    }
    .slds-modal__content{
    overflow-y:hidden !important;
    height:unset !important;
    max-height:unset !important;
    }
    .slds-col{
    padding:10px;
    }
    </aura:html>
    
    <aura:attribute type="Boolean" name="disableSave" default="true"/>
    <aura:attribute type="Boolean" name="showReasonBox" default="false"/>
    <aura:attribute type="String" name="oldStatus"/>
    <aura:attribute type="String" name="quoteType"/>
    <aura:attribute type="String" name="userType"/>
    <aura:attribute type="String" name="lastChangedStatus"/>
    <aura:attribute type="String" name="newStatus"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="Quote" type="SBQQ__Quote__c"/>
    
    <force:recordData aura:id="Quote_Record"
                      recordId="{!v.recordId}"
                      targetFields="{!v.Quote}"
                      fields="SBQQ__Status__c,core_cpq_active_cb__c,core_cpq_quote_type_nm__c"
                      recordUpdated="{!c.doInit}"    /> 
    <!-- <aura:attribute type="Boolean" name="isActive"/> -->
    <aura:attribute type="Boolean" name="noErrors" default = "true"/>
   <!-- <aura:attribute type="String" name="errorMessage"/>
     -->



    <div class="modal-header slds-modal__header slds-size_1-of-1">
    	<h4 class="title slds-text-heading--medium">Change Quote Status</h4>
    </div>
    
    <div class="slds-modal__content slds-size_1-of-1 slds-is-relative">
    <br/>

        <lightning:recordEditForm aura:id="updateStatus"
                recordId="{!v.recordId}"
                objectApiName="SBQQ__Quote__c"
                onload="{!c.recordLoaded}"
                onsuccess="{!c.handleSuccess}"
                onsubmit="{!c.handleSubmit}">
            <lightning:messages/>
            
            <aura:if isTrue="{!v.disableSave}">
                <lightning:spinner alternativeText="Loading" size="medium"/>
            </aura:if>
            <lightning:messages aura:id="errorMessage" />
           
            <div class="slds-grid">
                <div class="slds-col slds-size_1-of-1">
                   <!-- <lightning:inputField aura:id="inputStatus" fieldName="SBQQ__Status__c" 
                                          onchange="{!c.validateStatus}"/> -->
            <lightning:select aura:id="inputStatus" name="status" label="Status" required="true" onchange="{!c.validateStatus}" >
            <option value="" >None</option>
            <option value="In Progress" >In Progress</option>
            <option value="Pending">Pending</option>
            <option value="Rejected">Rejected</option>
            <option value="Cancelled">Cancelled</option>
           <!-- <option value="Contract Pricing">Contract Pricing</option> --> 
        </lightning:select>
                    <lightning:inputField aura:id="isActive" fieldName="core_cpq_active_cb__c" 
                                          disabled="true"/>
                </div>
            </div>
            <aura:if isTrue="{!v.noErrors}">
                <aura:if isTrue="{!v.showReasonBox}">
                    <div class="slds-grid">
                        <div class="slds-col slds-size_1-of-1">
                            <lightning:inputField aura:id="reasonInput" fieldName="core_cpq_status_change_reason_txt__c" required="true"/>
                        </div>
                    </div>
                </aura:if>
                <div class="modal-footer slds-modal__footer">
                    <lightning:button variant="Brand" class="slds-button" label="Cancel" onclick="{!c.handleCancel}"/>
                    <lightning:button variant="Brand" class="slds-button" type="submit" label="Save" onclick="{!getPicklistVal}" disabled="{!v.disableSave}"/>
                </div>   
                
                <aura:set attribute="else">
      				 <div class="modal-footer slds-modal__footer">
                     	<lightning:button variant="Brand" class="slds-button" label="Cancel" onclick="{!c.handleCancel}"/>
         		    </div> 
    			</aura:set>
                
            </aura:if>
			
    	</lightning:recordEditForm>
    </div>
</aura:component>