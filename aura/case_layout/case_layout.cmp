<aura:component implements="lightning:recordHomeTemplate" description="Main column
 and right sidebar. On a phone, the regions are of equal width">
    <aura:attribute name="left" type="Aura.Component[]" />
    <aura:attribute name="right" type="Aura.Component[]" />
   <aura:attribute name="top" type="Aura.Component[]" />
    <div>
        <lightning:layout multipleRows="true">
             <lightning:layoutItem size="12"
                                  >
              {!v.top}
            </lightning:layoutItem>
            <lightning:layoutItem size="8"
                                  >
                <div style="height:50rem;" class="slds-scrollable--y slds-p-top_x-small slds-p-right_x-small">
                {!v.left}
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem size="4"
                                 >
                 <div style="height:50rem;" class="slds-scrollable--y slds-p-around_x-small slds-p-left_x-small">
                {!v.right}
                </div>
            </lightning:layoutItem>
        </lightning:layout>
    </div>
    
</aura:component>