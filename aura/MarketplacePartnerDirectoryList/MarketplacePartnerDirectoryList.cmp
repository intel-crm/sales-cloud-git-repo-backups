<aura:component implements="forceCommunity:availableForAllPageTypes" controller="PMP_SearchMarketplaceController">
    <aura:attribute name="title" type="string" />
    <aura:attribute name="subtitle" type="string" />
    <aura:attribute name="CTA" type="string" />
    <aura:attribute name="CTAUrl" type="string" />
    <aura:attribute name="viewAll" type="boolean" />
    <aura:attribute name="listing" type="Object[]" default="[]" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

     <aura:attribute name="isPartnerPage" type="boolean" default="false" description="For identifying Partner program pages for creating SEO Friendly URL" />
    <!-- commneted as ISG should be replaced with Intel Verion component --> 
    <!--<c:ISGSimpleCardListWrapper title="{!v.title}" subtitle="{!v.subtitle}" CTA="{!v.CTA}" CTAUrl="{!v.CTAUrl}"
    viewAllHeadline="" viewMoreLinkTitle="" listing="{!v.listing}" viewAll="{!v.viewAll}" ctaTop="true" /> -->
  
    <c:MarketplaceSimpleCardListWrapper title="{!v.title}"
                                        subtitle="{!v.subtitle}"
                                        CTA="{!v.CTA}"
                                        CTAUrl="{!v.CTAUrl}"
                                        viewAllHeadline=""
                                        viewMoreLinkTitle=""
                                        listing="{!v.listing}"
                                        viewAll="{!v.viewAll}"
                                        ctaTop="true"
                                        isPartnerPage="true"
                                        isSeoPage="true"
                                        objectApiName="PMP_Partner_Program__c"
                                        />    

</aura:component>