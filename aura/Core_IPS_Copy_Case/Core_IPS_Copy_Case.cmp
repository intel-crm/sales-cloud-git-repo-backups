<aura:component implements="flexipage:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,force:hasRecordId,lightning:isUrlAddressable" access="global">
    <!-- Aura Attributes -->
    <aura:attribute name="pageReference" type="Object"/>
    
    <!--URL Navigation -->
    <lightning:navigation aura:id="navService"/>
    
    <!-- Register Events -->
    <aura:registerEvent name="closeActionModalEvent" type="c:closeactionmodal"/>
    
    <!-- Handlers -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:handler name="closeActionModalEvent" event="c:closeactionmodal" action="{!c.handleCloseEvent}"/>
</aura:component>