<aura:component extends="c:MarketplaceRedux" implements="forceCommunity:availableForAllPageTypes">
  <aura:set attribute="storeName" value="Search" />

  <aura:attribute name="open" type="boolean" default="true" description="Set the container to expand/collapse"/>
  <aura:attribute name="title" type="string" default="category" description="Container heading"/>
  <aura:attribute name="showClearFiltersLink" type="boolean" default="false" description="Show the link to remove all filters" />
  <aura:attribute name="count" type="integer" default="0" description="internal, Container count, shown if it is more than 0" />
  <aura:attribute name="filterName" type="string" default="" description="Filtername that will be checked on the filterGroupCount."/>
  <aura:attribute name="filterGroupCount" type="object" default="" description="Optional filter group object { filterName: count}, where filtername will be matched and the count will be added to the count " />
  <aura:attribute name="filterOpen" type="object" default="" description="Optional filter object { filterName: open}, where filtername will be matched and the open state will be set to its value " />
  <aura:attribute name="class" type="string" description="optional class"/>

  <aura:attribute name="clearFilterLabel" type="string" />

  <!-- Optional Context Filter Rendering for lazy Rendering -->
  <aura:attribute name="tags" type="object[]" default="[]" description="Context Filter Tags Rendering" />
  <aura:attribute name="renderType" type="string" default="contextFilterDesktop" description="optional render type"/>

  <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
  <aura:handler name="change" value="{!v.filterGroupCount}" action="{!c.handleFilterGroupCount}" />
<aura:handler name="change" value="{!v.filterOpen}" action="{!c.handleFilterOpen}" />

  
  <div class="{!v.class + ' slds-p-around_small'}">
    <div class="{!v.open ? 'slds-p-top_xx-small slds-p-bottom_x-small' : 'slds-p-vertical_xx-small'}">
      <a href="#" class="{! join(' ', (v.count > 0 ? 'hasCount' : ''), 'toggle darkTheme')}" onclick="{!c.handleToggleOpen}">
        <span class="iconWrap">
          <lightning:icon
            class="slds-m-right_small cursor"
            iconName="{!v.open ? 'utility:chevrondown' : 'utility:chevronright'}"
            />
        </span>
        <span class="{! join(' ', (v.open ? '' : 'slds-truncate'), 'h5 title')}">{!v.title}</span>
        <aura:if isTrue="{!v.count > 0 }">
          <span class="count">
            {!v.count}
          </span>
        </aura:if>
      </a>
    </div>
    <aura:if isTrue="{!v.open}">
      <aura:if isTrue="{! !empty(v.tags) }">
        <!-- Context Filter Conditional Rendering -->
          <div class="tagTree">
            <aura:if isTrue="{!v.showClearFiltersLink}">
              <div class="slds-p-horizontal_xx-small slds-p-bottom_small">
                <a class="{!v.appState.settings.currentSldsBreakPoint != 'x-large' ? 'color-white text-underline' : ''}" onclick="{!c.handleClearFilter}" href="javascript:void(0);">
                  <span class="{!v.count gt 0 ? 'active' : 'clearLink inactive'}">
                    {!v.clearFilterLabel}
                  </span>
                </a>
              </div>
            </aura:if>
            <div class="level1">
              <aura:iteration items="{!v.tags}" var="item" indexVar="i">
                  <aura:if isTrue="{! v.renderType == 'contextFilterDesktop' }">
                    <c:MarketplaceSearchContextualFilter
                      id="{!item.value}"
                      name="{!item.label}"
                      count="{!item.count}"
                      children="{!item.children}"
                      selectedListId="{!v.filterName}"
                      selectedList="{!v.state.selectedFilters}"
                      display="checkbox"
                    />
                  </aura:if>
                  <aura:if isTrue="{! v.renderType == 'contextFilterMobile' }">
                      <c:MarketplaceSearchContextualFilter 
                      id="{!item.value}" 
                      name="{!item.label}" 
                      count="{!item.count}"
                      children="{!item.children}" 
                      selectedListId="{!v.filterName}" 
                      selectedList="{!v.state.selectedDraftFilters}"
                      display="checkbox" 
                      applyToDraft="true" />
                  </aura:if>
              </aura:iteration>
            </div>
          </div>
        <aura:set attribute="else">
          <div>
            {!v.body}
          </div>
        </aura:set>
    
      </aura:if>
    
    
    </aura:if>
  </div>

</aura:component>