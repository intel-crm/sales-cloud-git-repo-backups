<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader,forceCommunity:availableForAllPageTypes"
                access="global"
                controller="Pricing_Publish_Quote">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="messageNotification" type="String" default=""/>
    <aura:attribute name="isSuccess" type="Boolean" />
    <aura:attribute name="recordId" type="String" />
    <!-- SPINNER -->
    <div aura:id="spinner" class="slds-is-relative">
        <lightning:spinner aura:id="mySpinner" class="slds-hide" size="medium" variant="brand" alternativeText="Please wait..." style="min-height: 20vh;background-color:white;"/>
        
        <!-- SUCCESS -->
       <aura:if isTrue="{!and(v.isSuccess,(v.messageNotification.length > 0))}">
            <div class="slds-p-around_medium">
                <div aura:id="successMessage" style="height:4rem;">
                    <div class="slds-is-relative slds-align_absolute-center">
                        <div class="slds-notify slds-notify_toast slds-theme_success" role="status">
                            <span class="slds-assistive-text">success</span>
                            <div class="slds-notify__content">
                                <!--<h2 class="slds-text-heading_small" style="text-align:center"> {!v.messageNotification} </h2>-->
                                <ul>
                                	<aura:iteration items="{!v.messageNotification}" var="item">
                                        <li class="slds-text-heading_small">• {!item}</li>
                                	</aura:iteration>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
           <div class="slds-p-around_none" style="text-align:center">
                <a href="javascript:void(0)" onclick="{!c.goBackLink}"> 
                    Click here to go back to the previous page 
                </a>
            </div>
        </aura:if>
        <!-- ERROR -->
        <aura:if isTrue="{!and(not(v.isSuccess),(v.messageNotification.length > 0))}">
            <div class="slds-p-around_medium">
                <div aura:id="errorMessage" style="height:4rem;">
                    <div class="slds-is-relative slds-align_absolute-center">
                        <div class="slds-notify slds-notify_toast slds-theme_error" role="status">
                            <span class="slds-assistive-text">error</span>
                            <div class="slds-notify__content">
                                <!--<h2 class="slds-text-heading_small" style="text-align:center"> {!v.messageNotification} </h2>-->
                                <ul>
                                	<aura:iteration items="{!v.messageNotification}" var="item">
                                        <li class="slds-text-heading_small">• {!item}</li>
                                	</aura:iteration>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="slds-p-around_medium" style="text-align:center">
                <a href="javascript:void(0)" onclick="{!c.goBackLink}"> 
                    Click here to go back to the previous page 
                </a>
            </div>
        </aura:if>
    </div>
</aura:component>