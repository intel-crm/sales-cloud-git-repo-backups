<aura:component implements="force:hasRecordId,lightning:isUrlAddressable,lightning:hasPageReference" access="global">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="recordId" type="String" />
    <!-- <aura:registerEvent name="closeActionModalEvent" type="c:closeactionmodal"/> -->
	<c:core_IPS_CreateCase recordId="{!v.recordId}" mode="copy" onclose="{!c.handleClose}" />
</aura:component>