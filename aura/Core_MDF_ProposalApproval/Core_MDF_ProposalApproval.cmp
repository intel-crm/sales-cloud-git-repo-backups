<aura:component
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction"
    access="global" Controller="Core_MDF_CampaignPFR_Controller">
    <aura:attribute name="disablebuttonName" type="Boolean" default="false" />
    <aura:attribute name="externalUser" type="Boolean" default="false" />
    <aura:attribute name="isPriceReviewer" type="Boolean" default="false" />
    <aura:attribute name="isL1Approver" type="Boolean" default="false" />
    <aura:attribute name="isL2MarketingApprover" type="Boolean" default="false" />
    <aura:attribute name="isL2SalesApprover" type="Boolean" default="false" />
    <aura:attribute name="isUserPORApprover" type="Boolean" default="false" />
    <aura:attribute name="isInternalProposalManager" type="Boolean" default="false" />
    <aura:attribute name="isExternalManager" type="Boolean" default="false" />
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="piwitmId" type="Id" />
    <aura:attribute name="buttonToBeVisible" type="Boolean" default="false" />
    <aura:attribute name="showApprovalCommentSection" type="Boolean" default="false" />
    <aura:attribute name="approvalComments" type="String" default="" />
    <aura:attribute name="btnValue" type="String" />
    <aura:attribute name="commentType" type="String" />
    <aura:attribute name="loadSpinner" type="Boolean" default="false" />
    <aura:attribute name="hideApproveButtonForL1orL2" type="Boolean" default="false" />
    <!-- Boolean Attributes to determine terminal rejection-->
    <aura:attribute name="terminalRejectionInd" type="Boolean" default="false" description="" />
    <aura:attribute name="showDeclinePopupInd" type="boolean" default="false"/>
    <aura:attribute name="isActiveClaimExist" type="Boolean" default="false" description="" />
    <aura:attribute name="hasUserClickedOnReject" type="Boolean" default="false" description="" />
    <aura:attribute name="isLegalReviewer" type="Boolean" default="false" />
    <aura:attribute name="isL2Approver" type="Boolean" default="false" />
    <!-- Aditya -->
    <aura:attribute name="isBusinessApprover" type="Boolean" default="false" />
    <aura:attribute name="programName" type="String"/>
    <aura:attribute name="isTechnicalApprover" type="Boolean" default="false" />
    <aura:attribute name="isExternalClaimSubmitter" type="Boolean" default="false" />
    <aura:attribute name="isInternalClaimSubmitter" type="Boolean" default="false" />
    <!--Swati IPA claim-->
    <aura:attribute name="isAccountManagerApprover" type="Boolean" default="false" />


    <!-- Onload of the Page the values to be loaded  -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <!-- To check cogtm program-->
    <aura:attribute name="isCoGtmProgram" type="Boolean" default="false" />
    <aura:if isTrue="{!v.buttonToBeVisible}">
        <lightning:layout horizontalAlign="spread" multipleRows="true">
            <lightning:layoutItem padding="around-small" size="3" mediumDeviceSize="3" largeDeviceSize="3">
            </lightning:layoutItem>

            <lightning:layoutItem padding="around-small" size="6" mediumDeviceSize="6" largeDeviceSize="6">
                <div align="center">
                    <aura:if isTrue="{!v.isInternalProposalManager}">
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Activity_Recall_Nm}"
                            value="{!$Label.c.Core_MDF_Activity_Recall_Nm}" disabled="{!v.disablebuttonName}"
                            onclick="{!c.approvalAction}" />
                        <!-- <aura:if isTrue="{!v.loadSpinner}">
                            <lightning:spinner alternative-text="Loading" size="large"></lightning:spinner>
                        </aura:if> -->
                    </aura:if>
                    <aura:if isTrue="{!v.isExternalManager}">
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Activity_Recall_Nm}"
                            value="{!$Label.c.Core_MDF_Activity_Recall_Nm}" disabled="{!v.disablebuttonName}"
                            onclick="{!c.approvalAction}" />
                        <!-- <aura:if isTrue="{!v.loadSpinner}">
                            <lightning:spinner alternative-text="Loading" size="large"></lightning:spinner>
                        </aura:if> -->
                    </aura:if>
                    <aura:if isTrue="{!v.externalUser}">
                        <p id="header23" class="slds-text-heading--small headings">
                            {!$Label.c.Core_MDF_IPA_CustomerAcceptance}</p>
                        <br></br>
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                            value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>

                    <aura:if isTrue="{!v.isPriceReviewer}">
                        <p class="slds-text-heading--small headings">
                            Price Reviewer Acceptance</p>
                        <br></br>
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                            value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>

                    <!-- Aditya -->
                    <aura:if isTrue="{!v.isBusinessApprover}">
                        <p class="slds-text-heading--small headings">
                            Business Approver Acceptance</p>
                        <br></br>
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                            value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>

                    <aura:if isTrue="{!v.isLegalReviewer}">
                        <p id="header23" class="slds-text-heading--small headings">
                            Legal Reviewer Acceptance</p>
                        <br></br>
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                            value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>

                    <aura:if isTrue="{!v.isL2Approver}">
                        <p id="header23" class="slds-text-heading--small headings">
                            L2 Approver Acceptance</p>
                        <br></br>
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                            value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>

                    <aura:if isTrue="{!v.isTechnicalApprover}">
                        <p id="header23" class="slds-text-heading--small headings">
                            Technical Approver Acceptance</p>
                        <br></br>
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                            value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>
                    <!--Swati IPA Claim-->
                    <aura:if isTrue="{!v.isAccountManagerApprover}">
                        <p id="header23" class="slds-text-heading--small headings">
                            Account Manager Acceptance</p>
                        <br></br>
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                            value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>

                    <aura:if isTrue="{!v.isExternalClaimSubmitter}">
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Activity_Recall_Nm}"
                            value="{!$Label.c.Core_MDF_Activity_Recall_Nm}" disabled="{!v.disablebuttonName}"
                            onclick="{!c.approvalAction}" />
                    </aura:if>

                    <aura:if isTrue="{!v.isInternalClaimSubmitter}">
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Activity_Recall_Nm}"
                            value="{!$Label.c.Core_MDF_Activity_Recall_Nm}" disabled="{!v.disablebuttonName}"
                            onclick="{!c.approvalAction}" />
                    </aura:if>

                    <aura:if isTrue="{!v.isUserPORApprover}">
                        <p id="header23" class="slds-text-heading--small headings">Program Office Reviewer Acceptance
                        </p>
                        <br></br>
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                            value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>

                    <aura:if isTrue="{!v.isL1Approver}">
                        <p id="header23" class="slds-text-heading--small headings">
                            {!$Label.c.Core_MDF_IPA_L1ApproverAcceptance}</p>
                        <br></br>
                        <aura:if isTrue="{!!v.hideApproveButtonForL1orL2}">
                            <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                                value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        </aura:if>
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>

                    <aura:if isTrue="{!v.isL2MarketingApprover}">
                        <p id="header23" class="slds-text-heading--small headings">L2 Regional Marketing Approval</p>
                        <br></br>
                        <aura:if isTrue="{!!v.hideApproveButtonForL1orL2}">
                            <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                                value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        </aura:if>
                        <!--<lightning:button variant="Neutral"
                                          label="{!$Label.c.Core_MDF_Retail_Approve}" value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />-->
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>
                    <aura:if isTrue="{!v.isL2SalesApprover}">
                        <p id="header23" class="slds-text-heading--small headings">L2 Regional Sales Approval</p>
                        <br></br>
                        <aura:if isTrue="{!!v.hideApproveButtonForL1orL2}">
                            <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Approve}"
                                value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />
                        </aura:if>
                        <!--<lightning:button variant="Neutral"
                                          label="{!$Label.c.Core_MDF_Retail_Approve}" value="{!$Label.c.Core_MDF_Retail_Approve}" onclick="{!c.approvalAction}" />-->
                        <lightning:button variant="Neutral" label="{!$Label.c.Core_MDF_Retail_Reject}"
                            value="{!$Label.c.Core_MDF_Retail_Reject}" onclick="{!c.approvalAction}" />
                    </aura:if>
                </div>
            </lightning:layoutItem>

            <lightning:layoutItem padding="around-small headings" size="3" mediumDeviceSize="3" largeDeviceSize="3">
            </lightning:layoutItem>
        </lightning:layout>
    </aura:if>
    
    <aura:if isTrue="{!v.showApprovalCommentSection}">
        <div role="dialog" tabindex="-1" aria-labelledby="header43"
            class="slds-modal slds-modal_small slds-slide-up-saving">
            <div class="slds-modal__container">
                <!-- Heading (Header of the Modal) -->
                <div class="slds-modal__header">
                    <!-- <lightning:buttonIcon iconName="utility:close" class="slds-button slds-modal__close slds-button_icon-border slds-button_icon-large" variant="bare" onclick="{! c.closeModal }" alternativeText="Close" /> -->

                    <button class="slds-button slds-button_icon slds-modal__close" title="Close" onclick="{!c.closeModal}">
                        <lightning:icon iconName="utility:close" alternativeText="Close" size="small" />
                        <span class="slds-assistive-text">{!$Label.c.Core_MDF_Cancel}</span>
                    </button>

                    <h1 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!v.commentType}
                    </h1>
                </div>

                <!-- Added Additional check to support terminal rejection for IPA L1 Approval alone with L2 Sales -->
                <div class="slds-modal__content slds-p-around--medium">
                    <aura:if isTrue="{!v.hasUserClickedOnReject}">
                        <aura:if isTrue="{!and(or(v.isL2SalesApprover,v.isL1Approver), not(v.isActiveClaimExist))}" >
                            <div class="slds-media slds-p-bottom_x-small">
                                <div class="slds-media__figure" style="margin: 0;">
                                    <lightning:input type="checkbox" name="{!v.terminalRejectionInd}"
                                        onchange="{!c.onPermanenetRejectCheck}"/>             
                                </div>
                                <div class="slds-media__body"> 
                                    <h2 id="header20" class="slds-text-heading--small">{!$Label.c.Core_MDF_Terminal_Rejection_Indicator}</h2>
                                </div>
                            </div>   
                        </aura:if>
                    </aura:if>
                    <h2 id="header20" class="slds-text-heading--small">{!$Label.c.Core_MDF_IPA_Comments}</h2>
                    <lightning:textarea required="false" value="{!v.approvalComments}" maxlength="1000"
                        aura:id="approvalComments"/>
                    <p class="slds-text-heading--small comments_charlimit_for_color">
                        {!$Label.c.Core_MDF_Comments_CharLimit}</p>
                    <aura:if isTrue="{!v.showDeclinePopupInd}">
                        <!-- showDeclinePopupInd Box starts here-->
                        <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                            <div class="slds-modal__container">
                                <!-- showDeclinePopupInd Box Header Starts here-->
                                <header class="slds-modal__header">
                                    <lightning:buttonIcon iconName="utility:close"
                                                          onclick="{! c.onClickofNo }"
                                                          alternativeText="close"
                                                          variant="bare"
                                                          size="small"
                                                          class="slds-button slds-button_icon slds-modal__close"/>
                                    <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!$Label.c.Core_MDF_Terminal_Rejection}</h2>
                                </header>
                                    <!--showDeclinePopupInd Box Body Starts here-->
                                    <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1" style="color:rgb(1, 118, 211);font-size:15px;padding-left:2%;padding-bottom:1%">
                                        <p>{!$Label.c.Core_MDF_Terminal_Rejection_Confirmation_Message}</p>
                                    </div>
                                    <!--showDeclinePopupInd Box Footer Starts here-->
                                    <footer class="slds-modal__footer">
                                        <lightning:button variant="neutral"
                                                        label="No"
                                                        title="No"
                                                        onclick="{! c.onClickofNo }"/>
                                        <lightning:button variant="brand"
                                                        label="Yes"
                                                        title="Yes"
                                                        onclick="{!c.onClickOfYes}"/>
                                    </footer>
                            </div>
                            <aura:if isTrue="{!v.loadSpinner}">
                                <lightning:spinner alternative-text="Loading" size="large"></lightning:spinner>
                            </aura:if>
                        </section>
                        <div aura:id="backdropIdForConfirmPopup" class="slds-backdrop slds-backdrop_open"></div>
                    </aura:if>
                </div>
                <div class="slds-modal__footer">
                    <lightning:button class="slds-button slds-button--neutral" onclick="{!c.closeModal}">
                        {!$Label.c.Core_MDF_Cancel}</lightning:button>
                    <lightning:button class="slds-button slds-button--brand"
                        onclick="{!c.callApprovalProcessOrPermDeclinePopup}" disabled="{!v.disablebuttonName}">
                        {!$Label.c.Core_MDF_Save}</lightning:button>
                    <aura:if isTrue="{!v.loadSpinner}">
                        <lightning:spinner alternative-text="Loading" size="large"></lightning:spinner>
                    </aura:if>
                </div>
            </div>
        </div>
        <div aura:id="backdropIdForNewRecord" class="slds-backdrop slds-backdrop--open"></div>
    </aura:if>

</aura:component>