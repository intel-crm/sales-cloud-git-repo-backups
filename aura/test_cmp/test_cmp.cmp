<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:isUrlAddressable" 
                			access="global">
        <aura:attribute name="licneserecordid" type="String"/>
    	<aura:attribute name="activatecodeonload" type="String"/>
    	<aura:attribute name="webdisplayFlag" type="String"/>
    	<aura:handler name="init" value="{!this}" action="{!c.init}"/>    

    <c:sales_GenerateLicense_OnLicenseRecord licneserecordid="{!v.licneserecordid}" 
                                             activatecodeonload="{!v.activatecodeonload}"
                                             webdisplayFlag="{!v.webdisplayFlag}"/>
</aura:component>