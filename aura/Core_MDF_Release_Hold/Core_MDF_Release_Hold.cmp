<aura:component controller="Core_MDF_ReleaseHold" implements="force:hasRecordId,force:lightningQuickAction" access="global" >
    <aura:attribute name = "errorMsg" type = "String"/>
    <aura:attribute name = "isIntManualChecked" type = "Boolean" default="false"/>
    <aura:attribute name = "isMemManualChecked" type = "Boolean" default="false"/>
    <aura:attribute name = "isCriteriaChecked" type = "Boolean" default="false"/>
    <aura:attribute name = "isBankDocumentChecked" type="Boolean" default="false"/>
    <aura:attribute name = "isPartnerUser"  type = "Boolean" default="false"/>
    <aura:attribute name = "isStandardUser"  type = "Boolean" default="false"/>
    <aura:attribute name = "isUserEligibleToReleaseHold" type = "Boolean" default="false"/>
    <aura:attribute name = "isUserEligibleToRelaseBankHold" type="Boolean" default="false"/>
    <aura:attribute name = "pfcRecord" type = "PartnerFundClaim"/>
    <aura:attribute name="Spinner" type="boolean" default="false" />
    <aura:attribute name = "wrapperClassVar"  type = "Core_MDF_ReleaseHold"/>
    <!--Added by VB-->
    <aura:attribute name="isCustomComp" type="boolean" default="false" description="Indicates whether this component is rendered from standard quick action or from custom compact layout"/>

    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <!--This is to fire a component event to close a modal popup-->
    <aura:registerEvent name="closeModalEvent" type="c:Core_MDF_closeModalEvent"/>

    
    <div>
        <aura:if isTrue="{!v.isCustomComp}"> 
            <div class="slds-modal__header custom-header">
                <h2 class="slds-text-heading_medium">Release Hold</h2>
            </div>
        </aura:if>    

        <lightning:layout verticalAlign="center" class="x-large">
            <lightning:layoutItem class="slds-align_absolute-center">
                <aura:if isTrue="{!(v.isUserEligibleToReleaseHold)}">
                    
                    <aura:if isTrue="{!and(v.isPartnerUser,v.wrapperClassVar.isOnMembManualHold)}">
                        <div class="slds-text-align_center slds-p-around_x-large slds-m-around--x-large">
                            <div class="slds-card slds-grid slds-align_absolute-center">
                                <lightning:icon iconName="utility:warning" variant="warning"/>
                                <p class="slds-p-around_medium slds-align_absolute-center">{!$Label.c.Core_MDF_ReleaseHold_ConfirmationMsg}</p>
                            </div>
                            <br/>
                            <div class="slds-p-around_medium slds-align_absolute-center slds-grid slds-wrap">
                                <lightning:button variant="brand" label="{!$Label.c.Core_MDF_Cancel_Claim_Yes}" title="{!$Label.c.Core_MDF_Cancel_Claim_Yes}" onclick="{!c.releaseHold}"/>
                                <lightning:button variant="neutral" label="{!$Label.c.Core_MDF_Cancel_Claim_No}" title="{!$Label.c.Core_MDF_Cancel_Claim_No}" onclick="{!c.closeModel}"/>   
                            </div>
                        </div>
                        
                        <aura:set attribute="else">
                            <!--aura:if isTrue="{!or(and(v.isStandardUser,or(v.wrapperClassVar.isOnCriteriaHold,or(v.wrapperClassVar.isOnIntManualHold,v.wrapperClassVar.isOnMembManualHold))),(and(v.isUserEligibleToRelaseBankHold, and(v.wrapperClassVar.isOnBankDocumentHold,!v.pfcRecord.Core_MDF_Audit_Hold__c))))}" -->     
                            <aura:if isTrue="{!or(and(v.isStandardUser,or(v.wrapperClassVar.isOnCriteriaHold,or(v.wrapperClassVar.isOnIntManualHold,v.wrapperClassVar.isOnMembManualHold))),(and(v.isUserEligibleToRelaseBankHold, v.wrapperClassVar.isOnBankDocumentHold)))}">               
                                <div>
                                    <div class="slds-grid slds-grid--pull-padded slds-p-top_medium">
                                        <div class="slds-col--padded">
                                            <lightning:icon iconName="utility:warning" variant="warning"/>
                                        </div>
                                        <div class="slds-col--padded">{!$Label.c.Core_MDF_ReleaseHold_ClaimOnDifferentHolds}</div>
                                    </div>
                                    <br/>
                                    <div>
                                        <aura:if isTrue="{!and(v.wrapperClassVar.isOnCriteriaHold,v.wrapperClassVar.hasAccess)}">
                                            <lightning:input type="checkbox" label="{!$Label.c.Core_MDF_ReleaseHold_CriteriaHoldCheckbox}" name="{!$Label.c.Core_MDF_ReleaseHold_CriteriaHoldCheckbox}" aura:id="criteriaH" checked="{!v.isCriteriaChecked}" onchange="{!c.toggleReleaseSubmissionButton}"/><br/>
                                        </aura:if>
                                        <aura:if isTrue="{!and(v.wrapperClassVar.isOnIntManualHold,v.wrapperClassVar.hasAccess)}">
                                            <lightning:input type="checkbox" label="{!$Label.c.Core_MDF_ReleaseHold_IntelManualHoldCheckbox}" name="{!$Label.c.Core_MDF_ReleaseHold_IntelManualHoldCheckbox}" aura:id="intManualH" checked="{!v.isIntManualChecked}" onchange="{!c.toggleReleaseSubmissionButton}"/><br/>
                                        </aura:if>
                                        <aura:if isTrue="{!and(v.wrapperClassVar.isOnMembManualHold,v.wrapperClassVar.hasAccess)}">
                                            <lightning:input type="checkbox" label="{!$Label.c.Core_MDF_ReleaseHold_MemberManualHoldCheckbox}" name="{!$Label.c.Core_MDF_ReleaseHold_MemberManualHoldCheckbox}" aura:id="memManualH" checked="{!v.isMemManualChecked}" onchange="{!c.toggleReleaseSubmissionButton}"/><br/>
                                        </aura:if>
                                         <!--aura:if isTrue="{!and(!v.pfcRecord.Core_MDF_Audit_Hold__c, and(v.wrapperClassVar.isOnBankDocumentHold,v.wrapperClassVar.hasAccessForBankDocumentHold))}" -->
                                         <aura:if isTrue="{!and(v.wrapperClassVar.isOnBankDocumentHold,v.wrapperClassVar.hasAccessForBankDocumentHold)}">
                                            <lightning:input type="checkbox" label="{!$Label.c.Core_MDF_ReleaseHold_BankDocumentHold}" name="{!$Label.c.Core_MDF_ReleaseHold_BankDocumentHold}" aura:id="bankDocumentH" checked="{!v.isBankDocumentChecked}" onchange="{!c.toggleReleaseSubmissionButton}"/><br/>
                                        </aura:if>
                                    </div>
                                    <br/>
                                    <div>
                                        <lightning:button variant="brand" label="{!$Label.c.Core_MDF_ReleaseHold_ProceedButton}" title="{!$Label.c.Core_MDF_ReleaseHold_ProceedButton}" aura:id="proceed" disabled="true" onclick="{!c.releaseHold}"/>
                                    </div>
                                </div>
                                <aura:set attribute="else">   
                                    <div class="slds-align_absolute-center slds-text-heading_small">
                                        <p class="slds-p-around_xx-large slds-m-around--xx-large">{!$Label.c.Core_MDF_ReleaseHold_ClaimNotOnHold}</p>
                                    </div>
                                </aura:set>
                            </aura:if>
                        </aura:set>
                    </aura:if>
                    <aura:set attribute="else">
                        <div class="slds-align_absolute-center slds-text-heading_small slds-p-top_x-large">
                            <p class="slds-p-around_x-large slds-m-around--x-large">{!v.errorMsg}</p>
                        </div>
                    </aura:set>

                </aura:if>

                <aura:if isTrue="{!v.Spinner}">
                    <div class="slds-spinner_container">
                        <lightning:spinner alternativeText="Loading" size="medium" variant="brand"/>
                    </div>
                </aura:if>
            </lightning:layoutItem>
        </lightning:layout>
        <aura:if isTrue="{!v.isCustomComp}"> 
            <footer class="slds-modal__footer slds-p-top_x-large">
                <lightning:button variant="brand" label="{!$Label.c.Core_MDF_Cancel_Button}" title="{!$Label.c.Core_MDF_Cancel_Button}" onclick="{!c.closeModel}" class="slds-m-left_x-small"/>
            </footer>
        </aura:if>

    </div>
</aura:component>