<aura:component implements="force:appHostable,flexipage:availableForRecordHome,force:hasRecordId" access="global" >
	<aura:attribute name="recordId" type="Id"/>
    <aura:attribute name="Quote" type="SBQQ__Quote__c"/>
    <aura:attribute name="ParentFields" type="String[]" default="Name,Core_Opportunity_ID__c,Core_Design_Registration_Id__c,CloseDate,Core_First_Customer_Ship_Date__c,Core_Production_End_Date__c,Core_Volume__c,Core_Product_Segment__c,Core_Product_Application__c,Core_Opportunity_Owner__c" />
    <aura:attribute name="ParentFieldsUlti" type="String[]" default="Email" />

  
    <force:recordData aura:id="Quote_Record"
                          recordId="{!v.recordId}"
                          targetFields="{!v.Quote}"
                      fields="SBQQ__Opportunity2__r.OwnerId"
                          layoutType="FULL" />    
    <lightning:card class="slds-p-around_medium" title="Opportunity Details">
        <!-- Using Child attribute to access parent to get final parent field & realatd ID to display parent fileds-->
        <lightning:recordForm
                              recordId="{!v.Quote.SBQQ__Opportunity2__c}"
                              objectApiName="Opportunity"
                              fields="{!v.ParentFields}"
                              columns="2"
                              mode="readonly">
        </lightning:recordForm>
        <lightning:recordForm
                              recordId="{!v.Quote.SBQQ__Opportunity2__r.OwnerId}"
                              objectApiName="User"
                              fields="{!v.ParentFieldsUlti}"
							  columns="2"
                              mode="readonly">
        </lightning:recordForm>
    </lightning:card>
</aura:component>