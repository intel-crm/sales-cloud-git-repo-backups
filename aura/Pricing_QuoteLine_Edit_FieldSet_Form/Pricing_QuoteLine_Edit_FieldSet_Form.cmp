<aura:component controller="Pricing_CommentsController"
  implements="forceCommunity:availableForAllPageTypes,lightning:actionOverride,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction"
  access="global">
  <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="recordId" type="String"/>
  <c:pricing_Edit_FieldSet_Form recordId="{!v.recordId}" />
</aura:component>