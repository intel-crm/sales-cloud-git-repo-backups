<aura:component access="global" implements="flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes" Controller="Core_MDF_PartnerFundRequestCreatePage">
    <!--<aura:handler name="init" value="{!this}" action="{!c.doInit}"/>-->
    <aura:attribute type="PartnerFundRequest" name="newPFRq" default="{Name:'',
                                                                      RequestedAmount:0, 
                                                                      ChannelPartner:null, 
                                                                      Core_MDF_Competitive_Elements__c:'',
                                                                      Core_MDF_Government_Nexus__c:'',
                                                                      Core_MDF_ofPagesEligible__c:'',
                                                                      Core_MDF_pagespayingfor__c:''}"></aura:attribute>	
    <aura:attribute type="boolean" name="renderPrintQuestions" default = "FALSE" />
	<aura:attribute type="boolean" name="renderGovtQuestions" default = "FALSE" />
    <aura:registerEvent name="dynamicQuestionEvt" type="c:Core_MDF_DynamicQuestionEvent"/>
    <aura:attribute name="disabled" type="Boolean" default="false"
                    description="Conditionally disabling the questions functionality"/>
    
    <aura:if isTrue = "{!v.renderGovtQuestions}">
       	<div class="slds-card">
			<div class="slds-p-around_large">
                <lightning:layout horizontalAlign="spread" multipleRows="true">
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                       <!-- <lightning:input aura:id="NewForm" type="checkbox" label="{!$Label.c.Core_MDF_Competitive_Element}" name="Competitive Elements" checked="{!v.newPFRq.Core_MDF_Competitive_Elements__c}" onchange="{!c.loadQuestion}"/> -->
                        <lightning:select value="{!v.newPFRq.Core_MDF_Competitive_Elements__c}" onchange="{!c.loadQuestion}" name="Competitive Elements" label="{!$Label.c.Core_MDF_Competitive_Element}" disabled = "{!v.disabled}">
                            <option value="{!$Label.c.Core_MDF_DQNo}">{!$Label.c.Core_MDF_DQNo}</option>
                            <option value="{!$Label.c.Core_MDF_DQYes}">{!$Label.c.Core_MDF_DQYes}</option>
                        </lightning:select>
                        <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
					</lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
						<!--<lightning:input aura:id="NewForm" type="checkbox" label="{!$Label.c.Core_MDF_Gov_Nexus}" name="Government Nexus" checked="{!v.newPFRq.Core_MDF_Government_Nexus__c}" onchange="{!c.loadQuestion}"/> -->
                        <lightning:select value="{!v.newPFRq.Core_MDF_Government_Nexus__c}" onchange="{!c.loadQuestion}" name="Competitive Elements" label="{!$Label.c.Core_MDF_Gov_Nexus}" disabled = "{!v.disabled}">
                            <option value="{!$Label.c.Core_MDF_DQNo}">{!$Label.c.Core_MDF_DQNo}</option>
                            <option value="{!$Label.c.Core_MDF_DQYes}">{!$Label.c.Core_MDF_DQYes}</option>
                        </lightning:select>
					</lightning:layoutItem>
                      <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                  </lightning:layout>
            </div>
        </div>
        </aura:if>
    
         <aura:if isTrue = "{!v.renderPrintQuestions}">
            <div class="slds-card">
				<div class="slds-p-around_large">                  
                 
                  <lightning:layout horizontalAlign="spread" multipleRows="true">
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
                        <lightning:input aura:id="NewForm" type="number" label="{!$Label.c.Core_MDF_ofPagesEligible}" name="# of pages eligible" value="{!v.newPFRq.Core_MDF_ofPagesEligible__c}" maxlength="10" onchange="{!c.loadQuestion}" required="true" min="0" step="any"/>
					</lightning:layoutItem>
					<lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3">
						<lightning:input aura:id="NewForm" type="number" label="{!$Label.c.Core_MDF_pagespayingfor}" name="# of pages paying for" value="{!v.newPFRq.Core_MDF_pagespayingfor__c}" maxlength="10" onchange="{!c.loadQuestion}" required="true" min="0" step="any"/>
					</lightning:layoutItem>
                      <lightning:layoutItem padding="around-small" flexibility="grow" size="3" mediumDeviceSize="3" largeDeviceSize="3"></lightning:layoutItem>
                  </lightning:layout>
                
              </div>
            </div>				
         </aura:if>
     
</aura:component>