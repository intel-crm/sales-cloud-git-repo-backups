    <aura:attribute name="selectedExtActSubmitterOptions" type="List" default="[]" description="This attribute holds the selected value for Submitter Multi Select"/>
    <aura:attribute name="AllCountryOptions" type="List" default="[]" description="This attribute holds all Country values for Country Multi Select"/>
    <!-- Declared attribute allIndustryOptions to show values available on Campaign -->
   <aura:attribute name="allIndustryOptions" type="List" default="[]" description="This attribute holds all Industry values for Industry Multi Select"/>
    <!--<aura:attribute name="AllBrandOptions" type="List" default="[]"
                    description="This attribute holds all Country values for Country Multi Select" />-->
    <aura:attribute name="AllApproverOptions" type="List" default="[]" description="This attribute holds all Country values for Approver Multi Select"/>
   <aura:attribute name="AllPrimaryApproverOptions" type="List" default="[]" description="This attribute holds all Country values for Primary Approver Multi Select"/>
  <aura:attribute name="AllExtActSubmitterOptions" type="List" default="[]" description="This attribute holds all values for Submitter Multi Select"/>
    <aura:attribute name="AllCountryOptionsMain" type="List" default="[]" description="This attribute holds all Country values for Country Multi Select"/>
