      <aura:attribute name="hasCreateAccess" type="boolean" default="false"
                    description="To check if user has create access " />
    <!-- Attribute Initialization-->
    <aura:attribute type="PartnerFundRequest" name="newPFR" 
                    default="{Name:'', 
                             RequestedAmount:0,
                             ChannelPartner:null,
                             Core_MDF_Competitive_Elements__c:'',
                             Core_MDF_Government_Nexus__c:'',
                             Core_MDF_ofPagesEligible__c:'',
                             Core_MDF_pagespayingfor__c:''}"
                    description="Stores the field value of PFR object on Create and Edit of the record "></aura:attribute>
    <aura:attribute type="PartnerFundRequest" name="oldPFR" 
                    description="Stores the actualy field value of PFR object before Editing the record "></aura:attribute>
