<aura:component controller="Core_MDF_Vat_Utility" implements="flexipage:availableForRecordHome,force:lightningQuickActionWithoutHeader,force:hasRecordId">
    <aura:attribute name="showVatFiles" type="Boolean" default="false"/>
    <aura:attribute name="eligibilityErrorMsg" type="String" default=""/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
   <aura:if isTrue="{!v.showVatFiles}"> 
    <c:core_MDF_VatFiles recordId="{!v.recordId}" onclose="{!c.closeQA}"/>
    <aura:set attribute="else">
        <div class = "slds-align_absolute-center">
            <lightning:card title="" class="{!if(v.eligibilityErrorMsg != '' ,'slds-show slds-text-heading_small','slds-hide')}">
                {!v.eligibilityErrorMsg}
            </lightning:card>
        </div>
    </aura:set> 
    </aura:if>

</aura:component>