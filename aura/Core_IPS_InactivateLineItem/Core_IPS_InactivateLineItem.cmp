<aura:component implements="force:lightningQuickAction,force:hasRecordId" access="global">
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="lineItemRecord1" type="Object" />
    <aura:attribute name="lineItemRecord" type="Object" default="{'sobjectType':'Core_IPS_Map_Par_Line_Item__c', 'Id' : 'Core_Status__c', '':''}"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="recordSaveError" type="String" description="An error message bound to force:recordData"/>
    
    <force:recordData aura:id="lineItemRec"
    recordId="{!v.recordId}"
    fields="Core_Status__c"
	targetRecord="{!v.lineItemRecord1}"
    targetFields="{!v.lineItemRecord}"
    targetError="{!v.recordSaveError}"
    mode="edit"
    />
</aura:component>