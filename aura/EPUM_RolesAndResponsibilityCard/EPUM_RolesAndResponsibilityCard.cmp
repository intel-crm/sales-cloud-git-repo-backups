<aura:component implements="forceCommunity:availableForAllPageTypes,force:hasRecordId" access="global">
    <aura:attribute name="myRoleDetail" type="sObject"/>
    <div>
        <aura:if isTrue="{!v.myRoleDetail.PRM_Relationship_Id__r.PRM_Contact_Relationship_Cd__c == 'PRIMARY'}">
            <div class="slds-text-heading_medium">
                <b>Primary Contact</b>
            </div>
            <br/>
            <div>
                <p> Description:</p>
                <ul class="slds-list_dotted">
                    <li>About PC Point 1</li>
                    <li>About PC Point 2</li>
                    <li>About PC Point 3</li>
                </ul>
            </div>    
        </aura:if>      
        <aura:if isTrue="{!v.myRoleDetail.PRM_Relationship_Id__r.PRM_Contact_Relationship_Cd__c == 'PRIMCONTDEL'}">
            <div> <h2><b>Primary Contact Delegate</b></h2>
                <p> Description:</p>
                <ul class="slds-list_dotted">
                    <li>About PC Point 1</li>
                    <li>About PC Point 2</li>
                    <li>About PC Point 3</li>
                </ul>
            </div>    
        </aura:if>     
    </div>   
</aura:component>