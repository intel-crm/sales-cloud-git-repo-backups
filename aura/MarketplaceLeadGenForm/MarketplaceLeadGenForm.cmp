<aura:component  implements="forceCommunity:availableForAllPageTypes,force:hasRecordId,flexipage:availableForRecordHome" controller="PMP_SearchCompanyLeadGenController" >
    <aura:set attribute="storeName" value="Settings"  />

    
    <!-- attributes -->
    <aura:attribute name="formType" type="String" default="contact" description="Request a Quote/Contact" />
   
    <aura:attribute name="isOpen" type="boolean" default="false" description="Opens the edit storefront modal" />
<!-- IPA2.0 + US TWC4497-1631 -->
    <!-- <aura:attribute name="offeringDetails" type="Object" default="" />
    <aura:attribute name="offeringName" type="string" default="" />
    <aura:attribute name="offeringLink" type="string" default="" /> -->
    <aura:attribute name="partnerName" type="String" default="" />
    <aura:attribute name="partnerLink" type="string" default="" />
    <aura:attribute name="partnerId" type="string" default="" description="Partner's Id" />
    <aura:attribute name="productId" type="string" default="" description="Product's auto number Id"/>
    <aura:attribute name="productRecId" type="string" default="" description = "Product's record Id" />
    <aura:attribute name="partnerRecId" type="string" default="" description= "Partner's record Id" />
    <!-- other internal attributes -->
    <aura:attribute name="languageLabel" type="String" />
    <aura:attribute name="prefLanguage" type="Object[]" />
    <aura:attribute name="modalHeading" type="String" description="Internal" />
    <aura:attribute name="closeModalCallback" type="Object" description="Internal" />
    <aura:attribute name="showSpinner" type="String" default="true" description="Internal" />
    <aura:attribute name="readOnly" type="Boolean" default="false" description="Internal"/>
    <aura:attribute name="formCompleted" type="boolean" default="false" description="Internal" />
    <aura:attribute name="agreeCheckboxError" type="boolean" default="false" description="Internal" />
    <aura:attribute name="localUserDetails" type="object" description="Internal"  />
    <aura:attribute name="userDetails" type="object"  description="Internal"  />
    <aura:attribute name="dateValidationError" type="boolean" default="false"  />
    <aura:attribute name="phoneValidationError" type="boolean" default="false"  />
    <aura:attribute name="emailValidationError" type="boolean" default="false"  />
    <aura:attribute name="phoneEmptyValidationError" type="boolean" default="false"  />
    <aura:attribute name="emailEmptyValidationError" type="boolean" default="false"  />
    <aura:attribute name="recordId" type="string"/>
    
    
    <aura:attribute name="partnerProfession" type="Object[]" />
	<!-- Country & State related Attributes -->
    <aura:attribute name="countries" type="list" default="[]" />
    <aura:attribute name="states" type="list" default="[]" />
    <aura:attribute name="dependantFieldMap" type="Object[]" description="map to store dependent values with controlling value"/>
    <aura:attribute name="isStateDisabled" type="boolean" default="false"/>
    <aura:attribute name="toggleStateError" type="boolean" default="true" />
    <aura:attribute name="isStateRequired" type="boolean" default="true" />    
    <!-- change and event handlers -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.isOpen}" action="{!c.handleFormOpen}" />

   <c:MarketplaceAnalyticsData aura:id="analyticsData" />
    <aura:method name="handlePageEvent" action="{!c.handlePageEvent}" />		
 
    <aura:handler event="c:MarketplacePageEvent" action="{!c.handlePageEvent}" />
   
    <div>
        <aura:if isTrue="{!v.isOpen}">
            <c:MarketplaceModal aura:id="modal" heading="{!v.modalHeading}" isOpen="{!v.isOpen}" useSlimMobileHeader="true"
                closeModalCallback="{!v.closeModalCallback}">
                <div class="{!join(' ', 'fullHeight', v.state.currentScreenSize == 'mobile' ? 'bgWhite' : 'bgWhite')}">
                    <div class="modalContainer">
                        <aura:if isTrue="{!v.showSpinner}">
                            <lightning:spinner alternativeText="Loading..." />
                        </aura:if>
                        <aura:if isTrue="{! !v.formCompleted }">
                        
                            <form aura:id="form" onsubmit="{!c.handleFormSubmit}">
                                <lightning:layout multipleRows="true" class="slds-p-top_medium">
                                    
                                    <aura:if isTrue="{!v.formType == 'quote'}">
                                        <lightning:layoutItem size="12" class="slds-p-horizontal_small slds-p-bottom_x-small slds-p-top_large requestQuoteTop">
                                            {!$Label.c.PMP_LeadGen_ThankYouQuoteNote1}&nbsp;<c:IntelLink  label="{!v.partnerName }"  recordId="{!v.partnerRecId}" objectApiName="PMP_Company__c"/>
                                            &nbsp;{!$Label.c.PMP_LeadGen_ThankYouQuoteNote2}&nbsp;
                                          <!--  <c:IntelLink  label="{!v.offeringName }"  recordId="{!v.productRecId}" objectApiName="PMP_Partner_Offering__c"/> -->
                                          <!-- IPA2.0 + US TWC4497-1631      -->
                                          <!-- <c:IntelLink  label="{!v.offeringName }"  recordId="{!v.productRecId}" objectApiName="Partner_Offering_Detail__c"/> -->

                                            <p><i>{!v.languageLabel}</i></p>  <!--lang prefrence-US443556-->
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="12" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                            <span
                                                class="color-red slds-m-right_xxx-small">*&nbsp;{!$Label.c.PMP_LeadGen_Required}</span>
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                            
                                        <lightning:input aura:id="inputField" type="number" name="volume" value="{!v.localUserDetails.volume}" required="true" min="1"
                                                label="{!$Label.c.PMP_LeadGen_Volume}" messageWhenValueMissing ="{!$Label.c.PMP_LeadGen_CompleteThisField}" maxlength="35" />
                                        <p class="disclaimer-text slds-p slds-text-body_small">{!format($Label.c.PMP_Maximum_Character_Limit_Msg,35)}</p>
                                        </lightning:layoutItem>
       
                                        <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                            <lightning:input aura:id="deliveryDate" type="date" name="deliveryDate"  value="{!v.localUserDetails.deliveryDate}"   label="{!$Label.c.PMP_LeadGen_DeliveryDate}" onchange="{!c.dateUpdate}"  
                                                />
                                            
                                           <!-- <div class="color-gray heading-11">{!$Label.c.PMP_CTA_Date}</div>--><!--Removed example date as part of DE70669-->
                                            <aura:if isTrue="{!v.dateValidationError}">
                                                    <div role="alert" class="color-red slds-form-element__help">
                                                        {!$Label.c.PMP_CTA_Delivery_Date}
                                                    </div>
                                                </aura:if>
                                            <span></span>
                                        </lightning:layoutItem>
                        
                                        <lightning:layoutItem size="12" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                            <lightning:textarea aura:id="leadgendesc" name="description" value="{!v.localUserDetails.description}" required="true" 
                                                label="{!$Label.c.PMP_LeadGen_Description}"
                                                maxlength="500" onchange="{!c.leaddescValidity}" onblur="{!c.leaddescValidity}"/>
                                             <aura:if isTrue="{!v.localUserDetails.description.length lt 501}">
                                                   <p class="disclaimer-text slds-p slds-text-body_small"><b>{!format($Label.c.PMP_Description_Characters_Remaining,500-v.localUserDetails.description.length)}</b></p>
                                             </aura:if>
                                        </lightning:layoutItem>
                                    </aura:if>
                                    <aura:if isTrue="{!v.formType == 'contact'}">
                                        <lightning:layoutItem size="12" class="slds-p-around_small contactTop">
                                            <span
                                                class="color-red slds-m-right_xxx-small">*&nbsp;{!$Label.c.PMP_LeadGen_Required}</span>
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="12" class="slds-p-horizontal_small slds-p-top_small slds-p-bottom_xx-small">
                                                {!$Label.c.PMP_LeadGen_YourAreContacting}&nbsp; 
                                            <!--<c:IntelLink  label="{!v.partnerName }"  recordId="{!v.partnerRecId}" objectApiName="PMP_Company__c"/> -->
                                                <c:IntelLink  label="{!v.partnerName }"  recordId="{!v.partnerRecId}" objectApiName="Company_Information_Detail__c"/>

           <!-- Language Pref markup-->                                 <p><i>{!v.languageLabel}</i></p>
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="12" class="slds-p-horizontal_small slds-p-bottom_small">
                                            <lightning:textarea aura:id="leadnotce" name="description" value="{!v.localUserDetails.description}" required="true"
                                                label="{!$Label.c.PMP_LeadGen_WhatWouldYouLikeToKnow}" maxlength="500" onchange="{!c.leadnotceValidity}" onblur="{!c.leadnotceValidity}"/>
                                            <aura:if isTrue="{!v.localUserDetails.description.length lt 501}">
                                                   <p class="disclaimer-text slds-p slds-text-body_small"><b>{!format($Label.c.PMP_Description_Characters_Remaining,500-v.localUserDetails.description.length)}</b></p>
                                             </aura:if>
                                        </lightning:layoutItem>
                                    </aura:if>

                                    <lightning:layoutItem size="12" class="slds-p-around_small">
                                        <h5 class="heading-16 color-darkgray non-bold">{!$Label.c.PMP_LeadGen_TellUsAboutYou}</h5>
                                        <aura:if isTrue="{!v.readOnly}">
                                            <p class="heading-14 intel-clear-light-italic">{!$Label.c.PMP_LeadGen_FieldsArePopulated}</p>
                                        </aura:if>
                                    </lightning:layoutItem>

                                    <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                        <lightning:input aura:id="fname" type="text" name="firstName" label="{!$Label.c.PMP_LeadGen_FirstName}" value="{!v.localUserDetails.firstName}"
                                                         required="true" disabled="{!v.readOnly}" maxlength="100" onchange="{!c.firstNameValidity}" onblur="{!c.firstNameValidity}"/>
                                        <p class="disclaimer-text slds-p slds-text-body_small">{!format($Label.c.PMP_Maximum_Character_Limit_Msg,100)}</p>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                        <lightning:input aura:id="lname" type="text" name="lastName" label="{!$Label.c.PMP_LeadGen_LastName}" value="{!v.localUserDetails.lastName}" 
                                                         required="true" disabled="{!v.readOnly}" maxlength="100" onchange="{!c.lastNameValidity}" onblur="{!c.lastNameValidity}"/>
                                        <p class="disclaimer-text slds-p slds-text-body_small">{!format($Label.c.PMP_Maximum_Character_Limit_Msg,100)}</p>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                       <!-- <lightning:input aura:id="inputField" type="text" name="jobTitle" label="{!$Label.c.PMP_LeadGen_JobTitle}" value="{!v.localUserDetails.jobTitle}"  disabled="{!v.readOnly}" />-->
                                        <lightning:select class="select" aura:id="inputField" name="profession" label="{!$Label.c.PMP_LeadGen_PartnerProfession}"  value="{!v.localUserDetails.profession}" >
                                            <option value="">{!$Label.c.PMP_LeadGen_ChooseOne}</option>
                                            <aura:iteration items="{!v.partnerProfession}" var="option">
                                                <option text="{!option.label}" value="{!option.value}" selected="{!option.label == v.localUserDetails.profession}"  />
                                            </aura:iteration>
                                        </lightning:select>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                        <lightning:input aura:id="cmpnyName" type="text" name="companyName" label="{!$Label.c.PMP_LeadGen_CompanyName}" value="{!v.localUserDetails.companyName}" maxlength="100"
                                            required="true"  disabled="{!v.readOnly}" onchange="{!c.companyValidity}" onblur="{!c.companyValidity}"/>
                                        <p class="disclaimer-text slds-p slds-text-body_small">{!format($Label.c.PMP_Maximum_Character_Limit_Msg,100)}</p>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                        <lightning:select aura:id="inputField" name="country" label="{!$Label.c.PMP_LeadGen_Country}" messageWhenValueMissing="{!$Label.c.PMP_LeadGen_CompleteThisField}" required="true"  onchange="{!c.onCountryChange}">
                                            <option value="">{!$Label.c.PMP_LeadGen_ChooseOne}</option>
                                            <aura:iteration items="{!v.countries}" var="option">
                                                <option text="{!option.label}" value="{!option.label}" selected="{!option.label == v.localUserDetails.country}" />
                                            </aura:iteration>
                                        </lightning:select>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                        <aura:if isTrue="{!v.toggleStateError}">
                                        	<lightning:select aura:id="inputField" name="state" label="{!$Label.c.PMP_LeadGen_State}" messageWhenValueMissing="{!$Label.c.PMP_LeadGen_CompleteThisField}" required="{!v.isStateRequired}"  disabled="{!v.isStateDisabled}" onchange="{!c.onStateChange}">
                                            <option value="">{!$Label.c.PMP_LeadGen_ChooseOne}</option>
                                            <aura:iteration items="{!v.states}" var="option">
                                                <option text="{!option.label}" value="{!option.label}" selected="{!option.label == v.localUserDetails.state}"/>
                                            </aura:iteration>
                                        </lightning:select>
                                        </aura:if>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                        <lightning:layout>
                                            <lightning:layoutItem size="6" class="slds-p-right_small">
                                                <lightning:input aura:id="leadPhone" type="text" name="phone" label="{!$Label.c.PMP_LeadGen_Phone}" messageWhenValueMissing="{!$Label.c.PMP_LeadGen_CompleteThisField}" messageWhenPatternMismatch="{!$Label.c.PMP_Phone_NumberCheck}" required="true" value="{!v.localUserDetails.phone}" pattern="[0-9\(\)\+\- ]*" onchange="{!c.Phonevalidity}"/>
                                             
                                                <aura:if isTrue="{!v.phoneValidationError}">
                                                    <div role="alert" class="color-red slds-form-element__help">
                                                        {!$Label.c.PMP_CTA_Phone_Number_Check}
                                                    </div>
                                                </aura:if>
                                               
                                            
                                            </lightning:layoutItem>
                                          <!--  <lightning:layoutItem size="6">
                                                <lightning:input aura:id="inputField" type="text" name="timetocall" label="{!$Label.c.PMP_LeadGen_BestTimeToCall}"  value="{!v.localUserDetails.bestTimeToCall}"  maxlength="255" />
                                            </lightning:layoutItem>	-->
                                        </lightning:layout>
                                      <!--  <div>
                                                 value="{!v.localUserDetails.preferredContact == 'phone'}" 
                                            <ui:inputRadio aura:id="preferredContact" name="preferredContact"  text="phone"
                                                label="{!$Label.c.PMP_LeadGen_PreferredContactMethod}"     change="{!c.handleRadioChange}" value="true"/>
                                        </div>	-->
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="12" mediumDeviceSize="6" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                        <lightning:input aura:id="leadEmail" type="text" name="email" label="{!$Label.c.PMP_LeadGen_Email}" messageWhenValueMissing ="{!$Label.c.PMP_LeadGen_CompleteThisField}" required="true" value="{!v.localUserDetails.email}"  disabled="{!v.readOnly}" onchange="{!c.emailUpdate}" maxlength="100"/>
                                     <!--   <aura:if isTrue="{!v.emailEmptyValidationError}">
                                                    <div role="alert" class="color-red slds-form-element__help">
                                                        Complete this field.
                                                    </div>
                                                </aura:if>	-->
                                        <aura:if isTrue="{!v.emailValidationError}">
                                                    <div role="alert" class="color-red slds-form-element__help">
                                                        {!$Label.c.PMP_CTA_Email_Validation}
                                                    </div>
                                                </aura:if>
                                        
                                        
                                       <!-- <div>
                                            <ui:inputRadio  aura:id="preferredContact" name="preferredContact"   text="email"
                                                label="{!$Label.c.PMP_LeadGen_PreferredContactMethod}"  change="{!c.handleRadioChange}"/>
                                        </div>	-->

                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="12" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                        <!-- <ui:inputCheckbox aura:id="inputCheckbox" 
                                            label="I Agree to the Terms and conditions of this site" required="true" /> -->
                                        <div class="{! v.agreeCheckboxError ? 'slds-form-element slds-has-error': ''}">
                                            <div class="uiInput uiInputCheckbox uiInput--default uiInput--checkbox">
                                                <label class="uiLabel-left form-element__label uiLabel">
                                                    <input title="{!$Label.c.PMP_CTA_Checkbox_Hover_Msg}" type="checkbox" name="termsandconditions" aura:id="inputTermsAndCondition" onchange="{! c.handleCheckboxChange}" required="true"/>
                                                    <!--<span class="text bold heading-13">{!$Label.c.PMP_LeadGen_TermsNote1}&nbsp; <a href="#">{!$Label.c.PMP_LeadGen_TermsAndConditions}</a>&nbsp; {!$Label.c.PMP_LeadGen_TermsNote2}</span>-->
                                    
                                                    <span class="text bold heading-13"><lightning:formattedRichText value="{!$Label.c.PMP_LeadGen_TermsNote}"/></span>
                                                    <span class="required " data-aura-rendered-by="1660:0">*</span>
                                                </label>
                                                <aura:if isTrue="{! v.agreeCheckboxError}">
                                                    <div  role="alert" class="slds-form-element__help">{!$Label.c.PMP_LeadGen_CompleteThisField}</div>
                                                </aura:if>
                                            </div>
                                        </div>
                                    </lightning:layoutItem>
                                    <lightning:layoutItem size="12" class="slds-p-around_small notice">
                                        <p><lightning:formattedRichText value="{!$Label.c.PMP_LeadGen_PrivacyNotice}"/></p> <!-- New CTA PrivacyNotice Changes-->
                                       <!-- <p>{!$Label.c.PMP_LeadGen_PrivacyNotice}</p>-->
                                       <p>{!$Label.c.PMP_LeadGen_TermsNotice}</p>
                                        
                                    </lightning:layoutItem>
                                   <!-- <lightning:layoutItem size="12" class="slds-p-horizontal_small slds-p-vertical_medium rightAlign">-->
                                    <lightning:layoutItem size="12" class="slds-p-around_small slds-m-bottom_medium rightAlign"><!--Merge Changes[10/30] ID-4317-->
                                        <button class="slds-float_right blue" onclick="{!c.handleFormSubmitClick}">{!$Label.c.PMP_LeadGen_Submit}</button> <!--DE89587 Fix-->
                                    </lightning:layoutItem>
                                    
                                </lightning:layout>
                               
                            </form>
                            <aura:set attribute="else">
                                <lightning:layout multipleRows="true">
                                    <aura:if isTrue="{!v.formType == 'quote'}">
                                    <lightning:layoutItem size="12" class="slds-p-around_small">
                                            {!$Label.c.PMP_LeadGen_SubmittedMessage}&nbsp;<c:IntelLink  label="{!v.partnerName }"  recordId="{!v.partnerRecId}" objectApiName="PMP_Company__c"/>
                                    </lightning:layoutItem>
                                    </aura:if>
                                    
                                   <aura:if isTrue="{!v.formType == 'contact'}">
                                    <lightning:layoutItem size="12" class="slds-p-around_small">
                                            {!$Label.c.PMP_LeadGen_SubmittedMessage}&nbsp;<c:IntelLink  label="{!v.partnerName }"  recordId="{!v.partnerRecId}" objectApiName="PMP_Company__c"/>
                                    </lightning:layoutItem>
                                    </aura:if>
                                    
                                    <lightning:layoutItem size="12" class="slds-p-around_small">
                                        <c:MarketplaceLeadGenProgressIndicator />
                                    </lightning:layoutItem>
                                   <!-- <lightning:layoutItem size="12" class="slds-p-around_small rightAlign">-->
                                    <lightning:layoutItem size="12" class="slds-p-around_small slds-m-bottom_medium rightAlign"><!--Merge changes[10/30]-ID-4317-->
                                        <button class="slds-float_right blue" onclick="{! c.handleCloseModal }">{!$Label.c.PMP_LeadGen_Close}</button><!--DE89587 Fix-->
                                    </lightning:layoutItem>
                                </lightning:layout>
                            </aura:set>
                        </aura:if>
                    </div>
                </div>

            </c:MarketplaceModal>
        </aura:if>

    </div>
	
</aura:component>