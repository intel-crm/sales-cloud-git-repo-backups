<aura:component access="global" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,lightning:actionOverride,force:lightningQuickActionWithoutHeader"
                controller ="Core_MDF_checkSObjectCRUDPermission">
    <!--Style-->
    <aura:html tag="style">
        .slds-modal__container{
        height : 90%;
        width: 90%;
        max-width: 90rem;
        }
        .modal-body{
        height : 600px !important;
        max-height: 600px !important;
        }
        
        .customFooter{
        display: inline !important;
        }
    </aura:html>
    
    <!-- To Check whether User Can Clone a record -->
    <aura:handler name="init" value="{!this}" action="{!c.checkObjectPermission}"/>
    <aura:handler name="change" value="{!v.recordInfoLoaded}" action="{!c.checkForEditAccess}" />
    <aura:attribute name="showSpinner" type="Boolean" default="false" />
    <aura:attribute name="recordtypeDeveloperName" type="String" default=""
                    description="Stores the recordtypeName from the parent component" />
    <aura:attribute name="activityStatus" type="String" default="" />
    <aura:attribute name="proposalBasedIndicator" type="Boolean" default="false"/>
    <aura:attribute name="startDate" type="date"/>
    <aura:attribute name="isOutcomeBased" type="Boolean" default="false"/>
    <aura:attribute name="mode" type="String" default="" />
    <aura:attribute name="recordInfoLoaded" type="Boolean" default="false"/>
    <aura:attribute name="hasEditAccess" type="Boolean" default="false"/>
    <!-- <aura:attribute type="Boolean" name="showErrorOnIPAClone" Default="false" 
                    description="IPA Activity cannot clone" /> -->
    
    <!-- <aura:if isTrue ="{!v.showErrorOnIPAClone}" >
        <div align="center"><c:Core_MDF_ErrorMessage type="error" message="{!$Label.c.Core_MDF_IPACloneErrMsg}" /></div>
        <aura:set attribute="else"> -->
            <!-- Component Starting If User Has Read Access -->
    <aura:if isTrue = "{!v.showSpinner}" >
        <div>
        <lightning:spinner alternativeText="Loading" size="large"></lightning:spinner>
        </div>
    </aura:if>  
                <div class="divCss">
                      <aura:if isTrue="{!(v.recordtypeDeveloperName == $Label.c.Core_MDF_IPA_RecordType)}">
                        <aura:if isTrue="{!v.hasEditAccess}">
                            <aura:if isTrue="{!not(v.isOutcomeBased)}">
                                <c:Core_MDF_CreateEditActivity recordId ="{!v.recordId}"/>
                            </aura:if>
                            <aura:if isTrue="{!v.isOutcomeBased}">
                                <c:Core_MDF_CreateEditOutcomeBasedActivity recordId ="{!v.recordId}"/>
                            </aura:if>
                         <aura:set attribute="else"> 
                             <aura:if isTrue="{!not(empty(v.message))}">
                    			<div class="slds-box slds-theme- -error">
                        			<h5 class="slds-text-heading_small slds-align_absolute-center">{!v.message}</h5>
                    			</div>
                			</aura:if> 
                         </aura:set> 
                        </aura:if> 
                     
                    </aura:if>
                   <aura:if isTrue="{!or(or(v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_CCF,v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_DCF),or(v.recordtypeDeveloperName == $Label.c.Core_MDF_EEF_RecordType, v.recordtypeDeveloperName == $Label.c.Core_MDF_PFR_Retail))}">
                   <c:Core_Intel_createEditPFR recordId ="{!v.recordId}"/>
                  </aura:if>
                  <aura:if isTrue="{!(v.recordtypeDeveloperName == $Label.c.Core_MDF_Co_GTM_RecordType)}">
                        <c:Core_MDF_Create_Activity recordId ="{!v.recordId}"/>
                    </aura:if>
                </div>
</aura:component>