<aura:component implements="forceCommunity:availableForAllPageTypes" controller="PMP_SearchMarketplaceController" >
    <aura:attribute name="title" type="string" />
    <aura:attribute name="subtitle" type="string" />
    <aura:attribute name="CTA" type="string" />
    <aura:attribute name="CTAUrl" type="string" />
    <aura:attribute name="viewAll" type="boolean" />
    <aura:attribute name="listing" type="Object[]" default="[]" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <!-- SEO Friendly URL attribute -->
  <aura:attribute name="isCategoryPage" type="boolean" default="false" description="For identifying Category pages for creating SEO Friendly URL" />
    <aura:attribute name="isSeoPage" type="boolean" default="false" />	
    <c:MarketplaceSimpleCardListWrapper title="{!v.title}"
                                        subtitle="{!v.subtitle}"
                                        CTA="{!v.CTA}"
                                        CTAUrl="{!v.CTAUrl}"
                                        viewAllHeadline=""
                                        viewMoreLinkTitle=""
                                        listing="{!v.listing}"
                                        viewAll="{!v.viewAll}"
                                        ctaTop="true"
                                        isCategoryPage="true"
                                        isSeoPage="true"
                                        objectApiName="PMP_Category__c"/>

</aura:component>