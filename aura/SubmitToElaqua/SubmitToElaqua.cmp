<aura:component implements="flexipage:availableForAllPageTypes,force:lightningQuickActionwithoutHeader,force:hasRecordId" controller="PMP_SearchCompanyLeadGenFromRegistration">
 	
    <aura:attribute name="NewRegistration" type="PRM_Registration_Request__c" />
    <aura:attribute name="recordId" type="Id"/>
   	<!--<aura:handler name="init" value="{!this}" action="{!c.leadCreation}"/> -->
     <aura:attribute name="regDetails" type="List" />
    
     <div class="modal-header slds-modal__header">
        <h2 class="title slds-text-heading--medium" >Confirm Lead Action</h2>
    </div>
    <div class="scrollable slds-modal__content slds-p-around--medium">
   <!-- <aura:iteration items="{!v.regDetails}" var="item">
        {!item.Name} <br/>
    </aura:iteration> -->
        <center>Do you want to create a Lead for current User/Contact ? </center>
    </div>
    
   <div style='Float:right; '>
     
    <lightning:button variant="brand" label="Submit to Elaqua" onclick="{!c.leadCreation}"/>
	</div>

</aura:component>