<aura:component extends="c:MarketplaceRedux" controller="PMP_SearchMarketplaceController">
    
    <aura:attribute name="storeName" type="string" default="Search" />
    <aura:attribute name="searchCategory" type="string" />
    <aura:attribute name="searchType" type="String" />
    <aura:attribute name="selectedFilters" type="object" />
    <aura:attribute name="hasSelectedFilter" type="boolean" default="false"/>
    <aura:attribute name="urlParams" type="string" />
    <aura:attribute name="contextualCat" type="string" />
    
    <aura:attribute name="defaultPageSize" type="integer" default="9" />
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.urlParams}" action="{!c.handleChangeUrlParams}" />
    
    
</aura:component>