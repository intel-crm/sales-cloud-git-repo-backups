<aura:component controller="Core_MDF_PartnerFundClaim_Edit"
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,lightning:actionOverride,force:lightningQuickActionWithoutHeader"
    access="global">
    <!-- This component acts as a Switch between CoMarketing Edit functionality and Standard Edit Functionality-->

    <!-- Check the record type of the Incoming  Record Id -->
    <aura:attribute name="simpleNewClaim" type="PartnerFundClaim" />
    <aura:attribute name="claimDetailsOnLoad" type="PartnerFundClaim" />
    <aura:attribute name="recordId" type="String" default="" />
    <aura:attribute name="activityCountriesMap" type="Map" />
    <aura:attribute name="activitySubTypesMap" type="Map" />
    <aura:attribute name="activityBudgetType" type="String" default="" />
    <!-- Attribute to Store Clone Button value and pass to "Core_MDF_PFC_Create" to component -->
    <aura:attribute name="isClone" type="Boolean"/>
    <!-- Attribute to Store the error message when user clicks on edit on a CRR Positive claim -->
    <aura:attribute name="accessErrorMsg" type="String" default="" />
    <aura:attribute name="isEdit" type="Boolean" default="true" /><!-- Naveen-SubClaim -->

    
    <aura:attribute name="isValidCloneOrEditUser" type="Boolean" default="false" />
    <aura:attribute name="showErrorModalOnEditClaim" type="Boolean" default="false" />
    <aura:attribute name="kpiPLValueToFieldAPIName" type="Object" description="To hold the object of values where Key is the Picklist value and value is the quantity field API Name"/>
    <aura:attribute name="kpiPLValueToFieldLabel" type="Object" description="To hold the object of values where Key is the Picklist value and value is the localized field label"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <aura:if isTrue="{!not(empty(v.simpleNewClaim.Id))}">
        <c:Core_MDF_PFC_Create simpleNewClaim="{!v.simpleNewClaim}" isCloneClaim="{!v.isClone}"
            activityCountriesMap="{!v.activityCountriesMap}" activitySubTypesMap="{!v.activitySubTypesMap}"
            activityBudgetType="{!v.activityBudgetType}" kpiPLValueToFieldLabel="{!v.kpiPLValueToFieldLabel}"
            kpiPLValueToFieldAPIName="{!v.kpiPLValueToFieldAPIName}" claimDataOnLoad="{!v.claimDetailsOnLoad}" 
            isEdit="{!v.isEdit}"/>
    </aura:if>
