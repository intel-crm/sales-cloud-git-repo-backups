<aura:component controller="PMP_BreadcrumbController" implements="forceCommunity:availableForAllPageTypes" access="global">
    
    <aura:attribute name="buttons" type="Array" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <div class="slds-grid slds-wrap">
        <div class="slds-col slds-size_1-of-6"/>
        <div class="slds-col slds-size_4-of-6 slds-text-align_center">
            <p class="slds-p-around_medium"><aura:unescapedHtml value="{!$Label.c.PMP_PageNotFound_Content}"/></p>
            <p class="slds-p-around_medium">
                This link is no longer active, as support for the Offerings/Solutions has been discontinued.
                Please <a href="https://crmdevipa-intelcloudcrm.cs45.force.com/imp/s/" class="slds-text-link">click here</a> to visit the Partner Showcase homepage.
            </p>
            <lightning:layout multipleRows="true">
                <aura:iteration items="{!v.buttons}" var="btn">
                    <lightning:layoutItem size="12" largeDeviceSize="4" padding="around-small">
                        <c:IntelButton communityLink="{!btn.url}" buttonClass="white slds-size_full"> {!btn.name} </c:IntelButton>
                    </lightning:layoutItem>
                </aura:iteration>
            </lightning:layout>
        </div>
        <div class="slds-col slds-size_1-of-6"/>
    </div>        
</aura:component>