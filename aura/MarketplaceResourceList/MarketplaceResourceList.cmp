<aura:component >
	<aura:attribute name="resouceList" type="Object[]" required="true" default="[]"  />
    <aura:attribute name="mdaId" type="string" default="" />
    <aura:attribute name="Header" type="string" default="" />
    <aura:attribute name="offeringId" type="Id"/>
    
    <ul class="resourceList">
       
	<aura:iteration items="{!v.resouceList}" var="item" indexVar="idx">
			<li class="slds-p-around_medium">
					<h4 class="heading-14">{! item.title} </h4> 
               	<p class="resource-wrap"><c:IntelLink openInBlank="true" partnerMDAId="{!v.mdaId}" offeringId="{!v.offeringId}" LabelHeader="{!v.Header}" title="{! item.title}" url="{!item.linkUrl}" >{! item.linkUrl}</c:IntelLink></p>
			</li>
	</aura:iteration>
	</ul>

</aura:component>