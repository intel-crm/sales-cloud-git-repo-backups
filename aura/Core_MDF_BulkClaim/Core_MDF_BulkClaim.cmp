<aura:component controller="Core_MDF_BulkClaimServerController" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes"
                access="global">
    <!--Style-->
    <aura:html tag="style">
        <!--To remove blue border-->
        .toastMessage.forceActionsText{
        white-space : pre-line !important;
        }
    </aura:html>
    <aura:attribute name="programSearchString" type="string" default="" />
    <aura:attribute name="fileId" type="String" />
    <aura:attribute name="isPortal" type="boolean" default="false"/>
    <aura:attribute name="fileToBeUploaded" type="Object[]" />
    <aura:attribute name="file" type="Object" />
    <aura:attribute name="content" type="String" />
    <aura:attribute name="programId" type="String" default="" />
    <aura:attribute name="programLabel" type="String" default="" />
    <aura:attribute name="fileInputValue" type="String" default="" />
    <aura:attribute name="recordTypeMap" type="Map" default="" />
    <aura:attribute name="showGuidelines" type="Boolean" default="false" />
    <aura:attribute name="loadSpinner" type="Boolean" default="false" />
    <aura:attribute name="activitySubTypes" type="List" description="to store activity sub types" />
    <aura:attribute name="countryList" type="List" description="to store Country values" />
    <aura:attribute name="currencyData" type="String" />
    <aura:attribute name="currencyColumns" type="List" />
    <aura:attribute name="mandatoryClaimFields" type="List" />
    <aura:attribute name="showMetricsGuideline" type="Boolean" default="false"
        description="Boolean flag to show metrics guideline based on program" />
    <aura:attribute name="showVatOptinAsMandatoryField" type="Boolean" default="false"
        description="Boolean flag to show Vat Opt-In under mandatory fields based on program" />
    <aura:attribute name="showTaxAsMandatoryField" type="Boolean" default="false"
        description="Boolean flag to show Tax under mandatory fields based on program" />
    <aura:attribute name="vatOptInMandatory" type="String" />
    <aura:attribute name="bankMandatory" type="String" />
    <!--to display the info message-->
    <aura:attribute name="infoMessageInd" type="Boolean" default="false"/>
    <aura:attribute name="taxMandatory" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <!--Handler event for the lookup component to clear and handle selection-->
    <aura:handler name="updateLookupIdEvent" event="c:Core_MDF_UpdateLookupId" action="{!c.updateLookUpId}" />
    <aura:handler name="clearLookupIdEvent" event="c:Core_MDF_ClearLookupId" action="{!c.clearLookUpId}" />
    <lightning:spinner aura:id="fileprogressBar" class="slds-hide" />
    <lightning:card title="{!$Label.c.Core_MDF_Upload_Bulk_Claims}"> 
        <aura:if isTrue="{!v.infoMessageInd}">
                <p class="informativeText slds-var-p-around_medium">{!$Label.c.Core_MDF_DisplayMessage}</p>
        </aura:if>
        <lightning:layout multipleRows="true">
            <lightning:layoutItem size="6" flexibility="auto" padding="around-small">
                <!-- Program -->
                <c:Core_MDF_LightningSObjectLookUp aura:id="programId" label="{! $Label.c.Core_MDF_Bulk_Claim_Program}" pluralLabel="Programs"
                                                   sObjectAPIName="ChannelProgram" instanceId="programId" helpText="{! $Label.c.Core_MDF_Enter_program}"
                                                   searchString="{!v.programSearchString}" returnFields="Name"
                                                   required="true" filterCriteria="{!'(IsActive = true AND Name LIKE @quote;%' + v.programSearchString +'%@quote;)'}" />
                <div aura:id="programInputHelpMsg" data-help-message="true" role="alert" class="errorMsg slds-hide">{!$Label.c.Core_MDF_Enter_program}</div>
            </lightning:layoutItem>
            <lightning:layoutItem size="6" flexibility="auto" padding="around-small">
                <!-- Download Template Link-->
                <lightning:input name="fileUploader" aura:id="fieldId" type="File" label="{! $Label.c.Core_MDF_Bulk_Claim_Upload_Template}"
                                 files="{!v.fileToBeUploaded}" accept=".csv" onchange="{! c.handleUploadFinished }" multiple="false" />
                <div aura:id="fileInputHelpMsg" data-help-message="true" role="alert" class="errorMsg slds-hide">{!$Label.c.Core_MDF_Upload_file}</div>
            </lightning:layoutItem>
            <lightning:layoutItem size="6" flexibility="auto" padding="around-large" >
                <div aura:id="downloadTemplate" class="slds-hide">
                    <aura:if isTrue="{!!v.isPortal}">
                        <!--Internal User : Bulk Claim Excel templet download link-->
                        <lightning:formattedUrl value="{! $Label.c.Core_MDF_PFRDetailLink + $Label.c.Core_MDF_FileURLInternal +v.fileId}" tooltip="Template"
                                                label="{!$Label.c.Core_MDF_Download_template_here}" target="_self" class="slds-button slds-button_brand"/>
                        <aura:set attribute="else">
                            <!--External User : Bulk Claim Excel templet download link-->
                            <lightning:button label="Download" iconName="utility:download" iconPosition="left" onclick="{!c.getTemplate}">
                                <lightning:formattedUrl value="{! $Label.c.Core_MDF_PFRCommunityLink +$Label.c.Core_MDF_FileURLInternal +v.fileId}" tooltip="Template"
                                                        label="{!$Label.c.Core_MDF_Download_template_here}" target="_self" aura:id="templateURL">
                                </lightning:formattedUrl>
                            </lightning:button>                            
                        </aura:set>
                    </aura:if>
                </div>
                <div aura:id="noTemplateAvailable" class="slds-hide">
                    {!$Label.c.Core_MDF_BulkClaimTemplateNotFound}
                </div>
            </lightning:layoutItem>
            
            <lightning:layoutItem size="6" flexibility="auto" padding="around-large">
                <!-- Import Button -->
                <lightning:button aura:id="importButtonCmp"  variant="brand" label="{!$Label.c.Core_MDF_Import_Claims}" title="{!$Label.c.Core_MDF_Import_Claims}" 
                                  onclick="{! c.handleClick }"  />
                <aura:if isTrue="{!v.loadSpinner}">
                    <lightning:spinner alternativeText="Loading" />
                </aura:if>
            </lightning:layoutItem>
            <aura:if isTrue="{!v.showGuidelines}">
                <lightning:layoutItem size="12" flexibility="auto" padding="around-large" >                    
                    <div class="slds-box">
                        <lightning:accordion allowMultipleSectionsOpen="true">
                            <lightning:accordionSection name="Guidelines" label="{!$Label.c.Core_MDF_BulkClaimGuidelines}">   
                                <p><ul class="slds-list_dotted">
                                    <li>{!$Label.c.Core_MDF_BulkClaimGuidelines1}</li>
                                    <li>{!$Label.c.Core_MDF_BulkClaimGuidelines2}</li>
                                    <ul class="slds-list_dotted">
                                        <aura:if isTrue="{!v.programLabel == 'Retail Marketing Funds'}">
                                            <li>{!$Label.c.Core_MDF_Title}</li>
                                            <li>{!$Label.c.Core_MDF_ActivityNumber}</li>
                                            <li>{!$Label.c.Core_MDF_ExecutionStartDate}</li>
                                            <li>{!$Label.c.Core_MDF_ExecutionEndDate}</li>
                                            <li>{!v.bankMandatory}</li>
                                            <li>{!$Label.c.Core_MDF_Core_MDF_Currency}</li>
                                            <li>{!$Label.c.Core_MDF_Total_Invoice_Amount_Local}</li>
                                            <li>{!$Label.c.Core_MDF_OtherCostsnotReimbursable_Local}</li>
                                            <li>{!v.vatOptInMandatory}</li>
                                           <!-- <li>{!$Label.c.Core_MDF_RMF_Applicable_VAT_Percentage_Required}</li> -->
                                            <aura:set attribute="else">
                                                <li>{!$Label.c.Core_MDF_Title}</li>
                                                <li>{!$Label.c.Core_MDF_ActivityNumber}</li>
                                                <li>{!$Label.c.Core_MDF_ExecutionStartDate}</li>
                                                <li>{!$Label.c.Core_MDF_ExecutionEndDate}</li>
                                                <li>{!v.bankMandatory}</li>
                                                <li>{!$Label.c.Core_MDF_InvoiceDate}</li>
                                                <li>{!$Label.c.Core_MDF_Invoice_Number}</li>
                                                <li>{!$Label.c.Core_MDF_Core_MDF_Currency}</li>
                                                <li>{!$Label.c.Core_MDF_Total_Invoice_Amount_Local}</li>
                                                <li>{!$Label.c.Core_MDF_OtherCostsnotReimbursable_Local}</li>
                                                <aura:if isTrue="{!v.showTaxAsMandatoryField}">
                                                    <li>{!v.taxMandatory}</li>
                                                </aura:if>
                                            </aura:set>
                                        </aura:if>
                                        <!-- <li>{!$Label.c.Core_MDF_Title}</li>
                                        <li>{!$Label.c.Core_MDF_ActivityNumber}</li>
                                        <li>{!$Label.c.Core_MDF_ExecutionStartDate}</li>
                                        <li>{!$Label.c.Core_MDF_ExecutionEndDate}</li>
                                        <li>{!$Label.c.Core_MDF_InvoiceDate}</li>
                                        <li>{!$Label.c.Core_MDF_Invoice_Number}</li>
                                        <li>{!$Label.c.Core_MDF_Core_MDF_Currency}</li>
                                        <li>{!$Label.c.Core_MDF_Total_Invoice_Amount_Local}</li>
                                        <li>{!$Label.c.Core_MDF_OtherCostsnotReimbursable_Local}</li> -->
                                    </ul>
                                    <aura:if isTrue="{!v.programLabel != 'Retail Marketing Funds'}">
                                    <li>{!$Label.c.Core_MDF_Required_Bank_Account_Number}</li>
                                    <li>{!$Label.c.Core_MDF_BulkClaimGuidelines3}</li>
                                    <li>{!$Label.c.Core_MDF_BulkClaimGuidelines4}</li>
                                    <li>{!$Label.c.Core_MDF_BulkClaimGuidelines5}</li>
                                        <aura:set attribute="else">
                                            <li>{!$Label.c.Core_MDF_Required_Bank_Account_Number}</li>
                                            <li>{!$Label.c.Core_MDF_BulkClaimGuidelines3_RMF}</li>
                                        </aura:set>
                                    </aura:if>
                                    <li>{!$Label.c.Core_MDF_BulkClaimGuidelines6}</li>
                                    <li>{!$Label.c.Core_MDF_BulkClaimGuidelines7}</li>
                                    <aura:if isTrue="{!v.showMetricsGuideline}">
                                        <li>{!$Label.c.Core_MDF_RMF_IPA_Metrics_Message}</li>
                                    </aura:if>
                                </ul>
                                </p>
                                <div class="slds-var-p-around_medium"/>
                                <lightning:tabset variant="scoped" >
                                    <aura:if isTrue="{!v.programLabel != 'Retail Marketing Funds'}">
                                    <lightning:tab label="{!$Label.c.Core_MDF_SupportedActSubtypeValues}">
                                        <div class="slds-scrollable_y" style="height:17.08rem;">
                                            <div class="slds-grid slds-wrap">
                                                <aura:iteration items="{!v.activitySubTypes}" var="activitySubTypes" indexVar="indx">                                        
                                                    <div class="slds-col slds-size_1-of-1 slds-medium-size_1-of-3 slds-large-size_1-of-4 slds-var-p-horizontal_x-small">
                                                        <div class="slds-float_left">
                                                            <label>{!activitySubTypes}</label>
                                                        </div>
                                                    </div>
                                                </aura:iteration>
                                            </div>  
                                        </div>
                                    </lightning:tab>
                                    </aura:if>
                                    <lightning:tab label="{!$Label.c.Core_MDF_SupportedCountryValues}">
                                        <div class="slds-scrollable_y" style="height:24rem;">
                                            <div class="slds-modal__content">  
                                                <div class="slds-grid slds-wrap">
                                                    <aura:iteration items="{!v.countryList}" var="countryList" indexVar="indx">                                        
                                                        <div class="slds-col slds-size_1-of-1 slds-medium-size_1-of-3 slds-large-size_1-of-4 slds-var-p-horizontal_x-small">
                                                            <div class="slds-float_left">
                                                                <label>{!countryList}</label>           
                                                            </div>
                                                        </div>
                                                    </aura:iteration>
                                                </div>                                            
                                            </div>
                                        </div>
                                    </lightning:tab>
                                    <lightning:tab label="{!$Label.c.Core_MDF_SupportedCurrencyValues}">
                                        <div class="slds-scrollable_y" style="height:24rem;">
                                            <div class="slds-modal__content slds-var-p-around_xxx-small" id="modal-content-id-1">
                                                <div class="slds-align_absolute-center">
                                                    <lightning:layoutItem size="12.5" smallDeviceSize="12.5" mediumDeviceSize="12.5" largeDeviceSize="10" padding="around-small" flexibility="grow">                                                    
                                                        <div class="slds-box">
                                                            <lightning:datatable
                                                                                 keyField="id"
                                                                                 data="{!v.currencyData}"
                                                                                 columns="{!v.currencyColumns}"
                                                                                 hideCheckboxColumn="true"/>
                                                        </div>
                                                    </lightning:layoutItem>
                                                </div>
                                            </div>
                                        </div>
                                    </lightning:tab>
                                </lightning:tabset> 
                            </lightning:accordionSection>
                        </lightning:accordion> 
                    </div>
                </lightning:layoutItem>
            </aura:if>
        </lightning:layout>
    </lightning:card>
</aura:component>