<aura:component controller="Core_DR_Zero_Quantity_msg_Ctrl" implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    <aura:attribute name="hasZeroQnty" type="boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:handler event="force:showToast" action="{!c.doInit}"/>
    
    <div style="padding-top: 2px">
        <aura:if isTrue="{!v.hasZeroQnty}">
             <div style="text-align:center; padding-bottom: -9px;">
                <div class="slds-notify slds-notify_toast slds-theme_warning" role="status">
                    <lightning:icon iconName="utility:warning" alternativeText="Information"/>
                    <div class="slds-notify__content" style="padding-left:3%;width: fit-content;">
                        <h2 class="slds-text-heading_medium" style="font-weight:bold;font-size:x-large;font-size: 21px;font-family:intel-clear;">{!$Label.c.Core_Zero_Quantity_Msg}</h2>
                    </div>
                </div>
            </div>
        </aura:if>
    </div>
</aura:component>