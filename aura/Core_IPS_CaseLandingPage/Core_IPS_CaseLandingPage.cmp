<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable" access="global" controller="Core_IPS_CaseLandingPageController" >
	<lightning:navigation aura:id="navService"/>
    <aura:attribute name="id" type="String"/>
    <aura:attribute name="url" type="String"/>
    <aura:attribute name="pageReference" type="Object"/>
    <aura:attribute name="InternalCaseCreate" type="boolean" default="false"/>
    <aura:attribute name="retURL" type="String"/>
    <aura:attribute name="recTypeId" type="String"/>
    <aura:attribute name="recTypeName" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <!--<aura:handler name="render" value="{!this}" action="{!c.doInit}"/>-->
    
    <aura:if isTrue="{!v.InternalCaseCreate}">
        <div>
            <c:core_IPS_CreateCase returnURL="{!v.retURL}" recordTypeId="{!v.recTypeId}" recordTypeName="{!v.recTypeName}" />
        </div>
	</aura:if>
    
</aura:component>