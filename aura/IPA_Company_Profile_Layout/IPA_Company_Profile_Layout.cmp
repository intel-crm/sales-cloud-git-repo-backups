<aura:component implements="forceCommunity:layout" description="IPA Web Company Profile Layout with built in sticky tabs" access="global">
	<aura:attribute name="marquee" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="mainFullWidth" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="main" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="tab1" type="Aura.Component[]" required="false"></aura:attribute>
        <aura:attribute name="tab01" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="tab2" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="tab3" type="Aura.Component[]" required="false"></aura:attribute>

	<aura:attribute name="blade1" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="blade1white" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="blade2" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="blade3" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="blade4" type="Aura.Component[]" required="false"></aura:attribute>
	<aura:attribute name="blade5" type="Aura.Component[]" required="false" />

	<div>
		<div class="marquee">
			{!v.marquee}
		</div>
		<div class="bg-blade-even">
			<c:IPAStickyTabset aura:id="partnertabs">
                <div>
                  <br></br><p>{!$Label.c.PRM_CompanyProfMessage}</p>                    
                </div>
				<c:IPAStickyTab label="{!$Label.c.PRM_CompanyInformation}">
					{!v.tab1}
				</c:IPAStickyTab>
				<c:IPAStickyTab label="{!$Label.c.PRM_LA_Header}">
					{!v.tab2}
				</c:IPAStickyTab>
				<c:IPAStickyTab label="{!$Label.c.PRM_Responsibilities_Header}">
					{!v.tab3}
				</c:IPAStickyTab>
                 <div class="profileMessages"> </div>
			</c:IPAStickyTabset>
		</div>
		<div class="container">
        <div class="contentPanel">
            {!v.main}
        </div>
    </div>
		<div class="bg-blade-even alignWidth">
			{!v.mainFullWidth}
		</div>
		<div class="bg-blade-odd">
          <div class="container">
              {!v.blade1}
          </div>
      </div>
      <div class="bg-white">
          <div class="container">
              {!v.blade1white}
          </div>
      </div>
      <div class="bg-blade-even">
          <div class="container">
              {!v.blade2}
          </div>
      </div>
      <div class="bg-blade-odd">
          <div class="container">
              {!v.blade3}
          </div>
      </div>
      <div class="bg-blade-even">
          <div class="container">
              {!v.blade4}
          </div>
      </div>
      <div class="bg-white">
        <div class="container">
            {!v.blade5}
        </div>
    </div>
	</div>
</aura:component>