<?xml version="1.0" encoding="UTF-8"?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <flowApiName>Design_Registration_Product_Automation</flowApiName>
    <label>test1</label>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{&quot;Core_Design_Product_Status_Nm__c&quot;:&quot;Approved&quot;,&quot;Core_Full_Year_Qty__c&quot;:3,&quot;Core_Locked_Ind__c&quot;:true,&quot;Core_Opportunity_Product_Id__c&quot;:&quot;00kDf000005m96FIAQ&quot;,&quot;Core_Product_Id__c&quot;:&quot;01t1J00000Bdqo9QAB&quot;,&quot;Core_Product_List_Price_Amt__c&quot;:2214,&quot;Core_Target_Resale_Amt__c&quot;:200,&quot;DDR_Target_Resale_Price_Note__c&quot;:&quot;Intel will review Target Resale Price as part of the design registration review process, in order to accurately calculate the value of the design registration. Intel will not provide input or guidance on the Target Resale Price, which will/must be inputted by the Distributor registering the design. Submission of the Target Resale Price does not constitute agreement on or endorsement of that price by Intel, and it will not affect the price offered by Intel to the Distributor.&quot;,&quot;Product_Selection_information_Message__c&quot;:&quot;Please select Product or MMID or Ordering code&quot;,&quot;RecordTypeId&quot;:&quot;0121J000000qpETQAY&quot;}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <assertions>
            <conditions>
                <leftValueReference>CheckALL.Core_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
        </assertions>
        <elementApiName>Finish</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
    </testPoints>
    <testType>WithAssertion</testType>
</FlowTest>
