<?xml version="1.0" encoding="UTF-8"?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <flowApiName>Core_AAQ_Email_Alert_Based_On_Status</flowApiName>
    <label>Test support</label>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{&quot;Core_Functional_Area__c&quot;:&quot;Accounts&quot;,&quot;Core_Geo__c&quot;:&quot;ASMO&quot;,&quot;Core_I_Need_Assistance_With__c&quot;:&quot;System Access&quot;,&quot;Core_Resolution_Type__c&quot;:&quot;&quot;,&quot;Core_Severity_Level__c&quot;:&quot;Medium&quot;,&quot;Core_Status__c&quot;:&quot;New&quot;,&quot;Core_Subcategory__c&quot;:&quot;&quot;,&quot;Core_Support_Owner__c&quot;:&quot;005D3000006GVNEIA4&quot;,&quot;OwnerId&quot;:&quot;005D3000006GVNEIA4&quot;}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <assertions>
            <conditions>
                <leftValueReference>New_Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
        </assertions>
        <elementApiName>Finish</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
    </testPoints>
    <testType>WithAssertion</testType>
</FlowTest>
