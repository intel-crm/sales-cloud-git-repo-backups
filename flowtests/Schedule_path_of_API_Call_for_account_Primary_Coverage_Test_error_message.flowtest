<?xml version="1.0" encoding="UTF-8"?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <flowApiName>Schedule_path_of_API_Call_for_account_Primary_Coverage</flowApiName>
    <label>Test error message</label>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{&quot;Content_Type__c&quot;:&quot;AccountId&quot;,&quot;Content__c&quot;:&quot;001D300000pcozrIAA&quot;,&quot;Custom_Filter__c&quot;:&quot;001D300000pcozrIAA&quot;,&quot;Message_Status__c&quot;:&quot;New&quot;,&quot;Module_Name__c&quot;:&quot;COVERAGE_UPDATE&quot;,&quot;OwnerId&quot;:&quot;005D30000071i5MIAQ&quot;,&quot;Queue_Type__c&quot;:&quot;Outbound&quot;,&quot;Retry_Count__c&quot;:0,&quot;Source_System__c&quot;:&quot;SLSCLD_ACM&quot;}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <assertions>
            <conditions>
                <leftValueReference>$Record.Error_Description__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Provided crosswalk was not found within the entity</stringValue>
                </rightValue>
            </conditions>
        </assertions>
        <elementApiName>Finish</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
    </testPoints>
    <testType>WithAssertion</testType>
</FlowTest>
