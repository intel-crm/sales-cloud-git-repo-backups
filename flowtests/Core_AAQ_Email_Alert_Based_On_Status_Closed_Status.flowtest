<?xml version="1.0" encoding="UTF-8"?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <flowApiName>Core_AAQ_Email_Alert_Based_On_Status</flowApiName>
    <label>Closed Status</label>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{&quot;Core_Description__c&quot;:&quot;&lt;p&gt;Test111&lt;/p&gt;&quot;,&quot;Core_Geo__c&quot;:&quot;APJ&quot;,&quot;Core_I_Need_Assistance_With__c&quot;:&quot;System Access&quot;,&quot;Core_Severity_Level__c&quot;:&quot;Medium&quot;,&quot;Core_Status__c&quot;:&quot;In Progress&quot;,&quot;Core_Subject__c&quot;:&quot;Test11&quot;,&quot;Core_Support_Owner__c&quot;:&quot;0052D000008JRlLQAW&quot;,&quot;OwnerId&quot;:&quot;005Df000009EzETIA0&quot;,&quot;RecordTypeId&quot;:&quot;012o00000019P1hAAE&quot;}</sobjectValue>
            </value>
        </parameters>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordUpdated</type>
            <value>
                <sobjectValue>{&quot;Core_Description__c&quot;:&quot;&lt;p&gt;Test111&lt;/p&gt;&quot;,&quot;Core_Geo__c&quot;:&quot;APJ&quot;,&quot;Core_I_Need_Assistance_With__c&quot;:&quot;System Access&quot;,&quot;Core_Resolution_Type__c&quot;:&quot;Unanswered&quot;,&quot;Core_Resolution__c&quot;:&quot;&lt;p&gt;NA&lt;/p&gt;&quot;,&quot;Core_Severity_Level__c&quot;:&quot;Medium&quot;,&quot;Core_Status__c&quot;:&quot;Closed&quot;,&quot;Core_Subject__c&quot;:&quot;Test11&quot;,&quot;Core_Support_Owner__c&quot;:&quot;0052D000008JRlLQAW&quot;,&quot;OwnerId&quot;:&quot;005Df000009EzETIA0&quot;,&quot;RecordTypeId&quot;:&quot;012o00000019P1hAAE&quot;}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <assertions>
            <conditions>
                <leftValueReference>Closed_status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
        </assertions>
        <elementApiName>Finish</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
    </testPoints>
    <testType>WithAssertion</testType>
</FlowTest>
