<apex:component access="global" controller="PMP_EmailTemplateController">
    <html>
        <style>
            /* Regular */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: normal;
            font-weight: 400;
            font-style: normal;
            }
            
            /* Light */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: 200;
            font-style: normal;
            }
            
            /* Bold */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: bold;
            font-weight: 700;
            font-style: normal;
            }
            
            table {
            font-family: sans-serif; /*arial, sans-serif;*/
            border-collapse: collapse;
            border-left: 1px solid #dddddd;
            border-right: 1px solid #dddddd;
            border-top: 0px;
            border-bottom: 1px solid #dddddd;
            }
            
            td, th {
            padding: 8px;
            }
            
            .intelBlue{
            color:#0071c5;
            }
            
            <!--h1{
            font-family: Intel Clear Pro !important;  
            } -->
            
            
        </style>
        <apex:attribute name="partnerRecordId" type="Id" description="Partner Record Id" assignTo="{!partnerId}"/>
        <body>
            <!-- Header Banner -->
            <c:PMP_Global_Header message="Please make edit(s) to your Showcase storefront"/>
            <!-- Header Banner -->
            
            <!-- Email content -->
            <table width="75%">    
                <!-- Email Body -->
                <tr>
                    <td style="padding-left:50px;">
                        <br/>Hello<br/><br/>
                        <apex:outputText rendered="{!IF(AND(partnerData.PMP_Partner_Submitter_UserId__c != null, partnerData.PMP_Partner_Submitter_UserId__r.IsActive==false,partnerData.PMP_Partner_Submitter_UserId__r.Partner_License_Reclaimed__c==false),true,false)}" > {!$Label.PMP_Inactive_User_Message}<br/><br/> </apex:outputText>
                        Thank you again for submitting your storefront. Before we can publish it, your action is required.<br/><br/> 
                        Please use the link and follow the instructions below.<br/> 
                    </td>
                </tr>
                <!-- Email Body -->
                <!-- CTA -->
                <tr>
                    <td style="padding-left:50px;">
                        
                        <p><apex:outputLink value="{!$Label.PMP_PartnerURL}{!partnerData.PMP_Published_Copy_Id__c}" styleClass="intelBlue">Edit &amp; re-submit</apex:outputLink></p>
                        
                        
                        <b>INSTRUCTIONS</b>
                        <br/><br/>
                        <b>NOTE:</b>&nbsp;Your storefront page may take a few seconds to load.
                        <br/>
                        <ol>
                            <li>Click the ‘pencil icon’</li>
                            <li>Review the message from your Showcase Admin about the edit(s) required to your storefront. <b>NOTE:</b> This messaging system can also be used to communicate additional questions and/or concerns you have about your Storefront. </li>
                            <li>Use the ‘Logo’; ‘Company Description’; ‘Company Details’; ‘Company Resources’ horizontal blue tabs to insert required information and check all boxes that apply to your storefront.</li>
                            <li>Click ‘Next’ at the bottom right of each dialog box to proceed to the next tab.</li>
                            <li>Re-submit your storefront to Intel for review.</li>
                        </ol><br/>
                        Thanks for your prompt attention,<br/><br/>
                        The Intel® Partner Showcase Team <br/> <br/>
                    </td>
                </tr>
               
                <tr>
                    <td style="padding-left:50px;">
                        
                        <p><apex:outputLink value="{!$Label.PMP_PartnerURL}{!partnerData.PMP_Published_Copy_Id__c}" styleClass="intelBlue">Edit &amp; re-submit</apex:outputLink></p>
                   </td>
                </tr> 
                
               
                <!-- Next Best Step -->
                <!-- Questions/Contact -->
                <tr>
                    <td style="padding-left:50px;">  
                        Questions? Reach out to Showcase Admin Team at <br/>
                        <apex:outputLink value="mailto:{!$Label.PMP_MailTo}" styleClass="intelBlue">
                            {!$Label.PMP_MailTo}
                        </apex:outputLink><br/><br/>
                    </td>
                </tr>
                
            </table>                 
            <!-- Email content -->
            
            <!-- Global Footer -->
            <c:PMP_Global_Footer />
            <!-- <c:PMP_PartnerFooterComponent /> -->
            <!-- Global Footer -->
            
        </body>
    </html>
</apex:component>