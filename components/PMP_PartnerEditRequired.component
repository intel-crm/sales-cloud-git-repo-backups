<apex:component access="global" controller="PMP_EmailTemplateController">
    <html>
        <style>
            /* Regular */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: normal;
            font-weight: 400;
            font-style: normal;
            }
            
            /* Light */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: 200;
            font-style: normal;
            }
            
            /* Bold */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: bold;
            font-weight: 700;
            font-style: normal;
            }
            
            table {
            font-family: Intel Clear; /*arial, sans-serif;*/
            border-collapse: collapse;
            border-left: 1px solid #dddddd;
            border-right: 1px solid #dddddd;
            border-top: 0px;
            border-bottom: 1px solid #dddddd;
            }
            
            td, th {
            padding: 8px;
            }
            
            .intelBlue{
            color:#0071c5;
            }
            
            h1{
            font-family: Intel Clear Pro !important;  
            }
        </style>
        <apex:attribute name="partnerRecordId" type="Id" description="Partner Record Id" assignTo="{!partnerId}"/>
        <body>
            <!-- Header Banner -->
                <c:PMP_Global_Header message="PLEASE MAKE THESE EDIT(S) TO YOUR MARKETPLACE STOREFRONT"/>
            <!-- Header Banner -->
            
            <!-- Email content -->
            <table width="75%">    
                <!-- Email Body -->
               <tr>
            <td style="padding-left:50px;">
                <br/>Hello<br/><br/>
                Thank you again for submitting your storefront. Before we can publish it, your action is required.&nbsp;Please follow the link below for instructions from your Intel Representative.<br/><br/>         
                Thanks for your prompt attention<br/><br/>
                The Intel® Solutions Marketplace Team <br/> <br/>
            </td>
          </tr>
                <!-- Email Body -->
            <!-- CTA -->
          <tr>
            <td style="padding-left:50px;">
                
                <p><apex:outputLink value="{!$Label.PMP_PartnerURL}{!partnerData.PMP_Published_Copy_Id__c}" styleClass="intelBlue">Edit &amp; Re-Submit</apex:outputLink></p>
                
                Can't access the link above?<br/>
                <apex:outputLink value="{!$Label.PMP_PartnerURL}{!partnerData.PMP_Published_Copy_Id__c}" styleClass="intelBlue">
                 {!$Label.PMP_PartnerURL}{!partnerData.PMP_Published_Copy_Id__c}
                </apex:outputLink> <br/><br/>
                
            </td>
         </tr>
        <!-- CTA -->
        <!-- Progress Indication 
        <tr>
            <td style="height:50; text-align:center;">
                <apex:image id="bodyImageId" url="{!bodyURL}"/>
            </td>
        </tr>
        <!-- Progress Indication -->
         <!-- Next Best Step -->
       <!-- <tr>    
            <td style="padding-left:50px;">
                Would you like to create an Offering ?
                <apex:outputLink value="https://crmqa2-intelcloudcrm.cs93.force.com//imp/s/pmp-partner-offering/PMP_Partner_Offering__c/00B0n000000zKq0EAE?language=en_US" styleClass="intelBlue">
                Get Started
                </apex:outputLink><br/><br/>
            </td>
        </tr>-->
        <!-- Next Best Step -->
                <!-- Questions/Contact -->
                        <tr>
                            <td style="padding-left:50px;">  
                                Questions? Reach out to Marketplace Admin Team at <br/>
                                <apex:outputLink value="mailto:{!$Label.PMP_MailTo}" styleClass="intelBlue">
                                {!$Label.PMP_MailTo}
                                </apex:outputLink><br/><br/>
                            </td>
                         </tr>
                 <!-- Questions/Contact -->
                <!-- Marketplace Help & FAQ -->
                <!-- <tr>    
                    <td style="text-align:center">
                    For FAQs and pro-tips on using Intel Solutions Marketplace, please visit 
                    <apex:outputLink value="www.intel.com" styleClass="intelBlue">
                    Marketplace Help
                    </apex:outputLink><br/><br/>
                    </td>
                    </tr>-->
                <!-- Marketplace Help & FAQ -->
            </table>                 
            <!-- Email content -->
            
            <!-- Global Footer -->
            	<c:PMP_Global_Footer />
            	<!-- <c:PMP_PartnerFooterComponent /> -->
            <!-- Global Footer -->
            
        </body>
    </html>
</apex:component>