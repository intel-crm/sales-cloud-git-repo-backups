 <script>
  
  var flagToAppendText = true;
  var HiddenProductValue = "{!JSENCODE(hiddenProdIdField)}";
function Init()
    {    
  $(document).on("keydown", function (e) {
    /*if (e.which === 8 && $(e.target).is("input, textarea") && $(e.target).val().length==1) {
        /$(e.target).val('');
        $(e.target).focus();
        e.preventDefault();
    }*/
});
    $( document ).ready(function() {

    

  $("input[id*='{!JSENCODE(autocomplete_textbox)}'").on("blur",function(e){return  false;});
   $("input[id*='{!JSENCODE(autocomplete_textbox)}'").on('keydown',function(e){
    
   if(e.which==13)
   {
   return false;
  
   }
   
    if (e.which == 8 && $(this).val().length==0) {
        e.preventDefault();
        
        //$(this).focus();
    
    }
   });
   
   $("input[id*='{!JSENCODE(autocomplete_textbox)}']").on('keyup change',function(e){
   
  
  $("div[id*='{!JSENCODE(Section_title)}']").find('.pbSubsection').html('');
  $("div[id*='{!JSENCODE(Section_title)}']").find('.pbSubsection').append("<span><img src=\'{!$Resource.Core_IPS_Typehead_Loader}\' alt=\'In progress\' /><span style='color:blue;font-size:15px;'>Please enter 3 or more characters of the product name or refer to the full list of products in the Intel Products tab. Wildcard search is not supported.</span>");
    
   if($(this).val().length > 2)
   {            
  if(e.type=='keyup')
  {
    $(this).off('change');  
  }
  if(e.type=='change')
  {
   $(this).off('keyup');
  }
    
      CallRemoteAction(true);
                        
   }else if($(this).val().length ==0){
       $("input[id*='{!JSENCODE(hiddenProductIdField)}'").val('');    
       $("div[id*='{!JSENCODE(Section_title)}']").find('.pbSubsection').html('');
       try
       {
          if(e.type=='keyup')
          {
            $(this).off('change');  
          }
          if(e.type=='change')
          {
           $(this).off('keyup');
          }
         RefreshData(this);
       }
       catch(err) {
            console.log('>>>>>>>>>>>>>>>err' + err);
        }
   }
   
   });
     
});
    }
function createTable(result)
    {
       //$("div[id*='{!JSENCODE(Section_title)}']").show();
    var cols = [{!ColumnsName}];
    //console.log(cols);
    $("div[id*='{!JSENCODE(Section_title)}']").find('.pbSubsection').html('');
               var  strFinalTable ="";
               
               $("div[id*='{!JSENCODE(Section_title)}']").find(".pbSubsection").append("<table id='tblResult{!JSENCODE(objectname)}' class='productTable' width='100%'><thead></thead><tbody></tbody></table>");
              
               
               $("#"+"tblResult{!JSENCODE(objectname)}").DataTable({
               "bDestroy": true,
               "bFilter": false, 
               "bInfo": false,
               "responsive": true,
               "aaData": result,
               "bPaginate": true,
               "paging": false,
               "aoColumns": cols
               /*"fnDrawCallback" : function( oSettings ) {
     BindDataEvent();
    }*/
               
               });
   //console.log($( "input[name='{!objectname}_group']" ) + '>>>>>>>>>>>>>>>>>>>>>>>>>>>>');  
var  tblObj=$("#tblResult{!JSENCODE(objectname)}");   
   BindDataEvent();
               
    }
    
function UpdateIdiNHidden(itm)
{
 console.log('@@@@@id only@@@@' + $(itm).find('td').eq(0).find('input').val());     
 console.log('@@@@@name only@@@@' + $(itm).find('td').eq(0).find('input').attr('title'));
 //$("input[type='hidden'][id*='{!hiddenProductIdField}']").val($(itm).find('td').eq(0).find('input').val());
 //$("input[type='text'][id*='{!prodName}']").val($(itm).find('td').eq(1).html());
 HiddenProductValue = $(itm).find('td').eq(0).find('input').val();
 try
 {
