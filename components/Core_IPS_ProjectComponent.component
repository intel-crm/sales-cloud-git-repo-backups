<apex:component controller="autoCompleteController">
<apex:includeScript value="{!$Resource.Core_IPS_Jquery11}"/>
<apex:includeScript value="{!Urlfor($Resource.Core_IPS_DataTable,'jquery-ui.js')}"/>
<apex:includeScript value="{!URLFOR($Resource.Core_IPS_DataTable,'jquery.dataTables.js')}"/>
<apex:stylesheet value="{!URLFOR($Resource.Core_IPS_DataTable,'jquery.dataTables.css')}" />
<apex:stylesheet value="{!URLFOR($Resource.Core_IPS_DataTable,'jquery-ui.css')}" />


 <apex:attribute name="object_name" description="The object name you want to look for." assignTo="{!objectname}"  type="String" required="true"/>
 <apex:attribute name="autocomplete_textbox" description="The ID for the Autocomplete List Textbox." assignTo="{!prodName}" type="String" required="true"/>
  <apex:attribute name="additional_field" description="Any additional fields you'd like to search and include in the display." assignTo="{!additionalfield}" type="String" required="false"/>
  <apex:attribute name="Section_title" description="fieldset Option in the table."  required="true"   type="String" />
  <apex:attribute name="hiddenProductIdField" description="Assignment for Product Id." assignTo="{!hiddenProdIdField}" required="true" type="String" />
  <apex:attribute name="fieldSet_Name" description="Field Set" assignTo="{!fieldSetName}" type="String" />
  <apex:attribute name="related_Id" description="Field Set" assignTo="{!relatedId}" type="String" />
   
 <style>
    .errorM4 .msgIcon, .errorSmall {
        background-image: url(/img/samples/flag_red.gif) !important;
    }
    
    .myCustomMessage .message {
        background: none  !important;
        border: none !important;
