}
 $(document).ready(function() {
 
Init();
});

function CallRemoteAction(Flag)
{

 if(Flag)
 {
 
  
   autoCompleteController.findSObjects('{!JSENCODE(objectname)}',$("input[id*='{!JSENCODE(autocomplete_textbox)}'").val() , '{!JSENCODE(fieldSetName)}', '{!JSENCODE(relatedId)}', function(result, event){
                            console.log(JSON.stringify(result));
                            if(event.type == 'exception') {
                                  alert(event.message);
                            } else { 
                              
                                    //sObjects = result;
                                 
                                 //setTimeout(responseHandler(sObjects),1);
                                 createTable(result);
                                 
                            }
                        });
  }
  else
  {
  
     
     autoCompleteController.findSObjects('{!JSENCODE(objectname)}','', '{!JSENCODE(fieldSetName)}', '{!JSENCODE(relatedId)}', function(result, event){
                            console.log(JSON.stringify(result));
                            if(event.type == 'exception') {
                                  alert(event.message);
                            } else { 
                              
                                    //sObjects = result;
                                 
                                 //setTimeout(responseHandler(sObjects),1);
                                 createTable(result);
                                 
                            }
                        });
  }
} 
function BindDataEvent()
{
$("#tblResult{!JSENCODE(objectname)}").find("tr").each(function(){
console.log($(this).find('td').eq(0).find('input').val());
if($(this).find('td').eq(0).find('input').val()!= HiddenProductValue)
{
 $(this).find('td').eq(0).find('input').prop('checked',false);
}

});
    $("input[name='{!JSENCODE(objectname)}_group']" ).click(function(){  
            UpdateIdiNHidden($(this).parent().parent());   
    });

}
     </script>
 
</apex:component>