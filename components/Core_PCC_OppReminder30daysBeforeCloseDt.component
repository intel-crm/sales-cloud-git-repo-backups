<apex:component access="global" controller="Core_OppEmailAlertController">
    <html>
        <style>
            /* Regular */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: normal;
            font-weight: 400;
            font-style: normal;
            }
            
            /* Light */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: 200;
            font-style: normal;
            }
            
            /* Bold */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: bold;
            font-weight: 700;
            font-style: normal;
            }
            
            table {
            font-family: Intel Clear; /*arial, sans-serif;*/
            border-collapse: collapse;
            border-left: 1px solid #dddddd;
            border-right: 1px solid #dddddd;
            border-top: 0px;
            border-bottom: 1px solid #dddddd;
            }
            
            td, th {
            padding: 8px;
            }
            
            .intelBlue{
            color:#0071c5;
            }
            
            h1{
            font-family: Intel Clear Pro !important; 
            }
        </style>
        
        <apex:attribute name="oppRecordId" type="Id" description="Opportunity Id" assignTo="{!oppId}"/>
        <body>
            
            <!-- Header Banner -->    
            <table style="background-color:#0168B5;" width="75%">
                <tr>
                    <td style="padding-left:50px;border: 0px;border:none;">
                        <div style="color:white;"><h1>Opportunity Decision Date Approaching</h1></div>
                    </td>
                    <td style="border:none;padding-right:20px;" align="right">
                        <apex:image url="{!headerURL}" width="100" height="80" alt="Intel Logo"/>
                    </td>
                </tr>
            </table>
            <!-- Header Banner -->
            <!-- Email Body -->
            
            <table width="75%">    
                <tr>
                    <td style="padding-left:50px;">
                       Hello {!oppData.Core_Technical_Owner__r.Name}<br/>
                        
                        <br/>The following <b>Opportunity</b> has a decision date approaching <b>within 30 days</b>.<br/><br/>
                        
                        <b>Opportunity Number:</b>&nbsp;<apex:outputLink value="{!dealRegExternalDomainName}/s/opportunity/{!oppData.Id}" >{!oppData.Id}</apex:outputLink><b> (External) </b> <apex:outputLink value="{!domainName}/{!oppData.Id}" >{!oppData.Id}</apex:outputLink><b> (Internal)</b><br/>
                        <b>Opportunity Name:</b>&nbsp;{!oppData.Name}<br/>
                        <b>External ID:</b>&nbsp;{!oppData.Core_External_ID__c}<br/>
                        <b>End Customer Account:</b>&nbsp;{!oppData.Account.Name}<br/>                        
                        <!--<b>Decision Date:</b>&nbsp;{!oppData.CloseDate}<br/>-->
                        <b>Decision Date:</b>&nbsp;<apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!oppData.CloseDate}" /></apex:outputText><br/>
                        <!--<b>Created Date:</b>&nbsp;{!oppData.CreatedDate}<br/><br/> --> 
                        <b>Created Date:</b>&nbsp;<apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!oppData.CreatedDate}" /></apex:outputText><br/><br/>                       
                        
                        <table style="border: 1px solid black;">
                            <thead>
                                <tr style="border: 1px solid black;">
                                    <th style="border: 1px solid black;">Id</th>
                                    <th style="border: 1px solid black;">Product Name</th>
                                    <th style="border: 1px solid black;">Quantity</th>
                                    <th style="border: 1px solid black;">Product Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <apex:repeat value="{!oppProdData}" var="oppProd">
                                    <tr style="border: 1px solid black;">
                                        <td style="border: 1px solid black;">{!oppProd.Id}</td>
                                        <td style="border: 1px solid black;">{!oppProd.Name}</td>
                                        <td style="border: 1px solid black;">{!oppProd.Quantity}</td>
                                        <td style="border: 1px solid black;">{!oppProd.Core_Status__c}</td>
                                    </tr>
                                </apex:repeat>
                            </tbody>
                        </table>
                        <br/>
                        If you need to make changes to the Opportunity Decision Date, please utilize the Chatter feature on the opportunity to submit a change request. Please click&nbsp;<apex:outputLink value="{!dealRegExternalDomainName}/s/opportunity/{!oppData.Id}" >here</apex:outputLink><b> (External) </b>
                        <br/><br/>
                        This email was sent from an unmonitored mailbox. For questions, please contact your Intel Partner Sales Account Manager or utilize the Chatter feature on the Opportunity.<br/><br/>
                        
                    </td>
                </tr>             
            </table>
            <!-- Email Body -->  
            <!-- Global Footer -->
            <table style="background-color:#0168B5;" width="75%">
                <tr>    
                    <td style="text-align:center">
                        <div style="color:white;font-size:10px">
                            This message was sent to you as an important business communication related to your current relationship with Intel® Partner Alliance<br/>
                            ©{!year(today())} Intel Corporation <br/>
                            Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054 USA.
                            <apex:outputLink value="www.intel.com" style="color:white;"> www.intel.com</apex:outputLink><br/>
                            <apex:outputLink value="www.intel.com/privacy" style="color:white;">Privacy</apex:outputLink> | &nbsp;
                            <apex:outputLink value="www.intel.com/cookies" style="color:white;">Cookies</apex:outputLink>
                        </div>
                    </td>
                </tr>
            </table>
            <!-- Global Footer -->
        </body>
    </html>
</apex:component>