<apex:component ><div id="search" class="CoveoBox" data-design="new">
  <div class="CoveoFolding"></div>
  <div class="CoveoAnalytics" data-search-hub="Core_IPS_CustomCoveoPanel"></div>
  <div class="coveo-box-query-section">
  </div>
  <div class="CoveoBoxHeader" data-include-search-box="true" data-open-sub-section-by-default="false" data-allow-non-contextual-search="true">
    <div class="CoveoShareQuery">
    </div>
    <div class="CoveoPreferencesPanel">
      <div class="CoveoResultsPreferences">
      </div>
      <div class="CoveoResultsFiltersPreferences">
      </div>
    </div>
    <div class="coveo-box-popups-section">
      <div class="coveo-tab-section coveo-inline-tab-section">
        <a class="CoveoTab" data-id="SalesforceCase" data-caption="Results"></a>
        <div class="CoveoBoxPopup" data-full-height="true" data-full-width="true" data-title="Filters">
          <div class="coveo-box-facet-column">
            <div class="CoveoDynamicFacetManager">
              <div class="CoveoDynamicFacet" data-title="Source" data-field="@datasource" data-tab="SalesforceCase" data-sort-criteria="occurrences"></div>
              <div class="CoveoDynamicFacet" data-title="Last Assigned Queue" data-id="sfcoreipsassignedqueuec" data-field="@sfcoreipsassignedqueuec" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Case Priority" data-id="sfcase-sfcasespriority" data-field="@sfpriority" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Case Status" data-id="sfcase-sfcasestatus" data-field="@sfcasestatus" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Contact Name" data-id="sfcontactname" data-field="@sfcontactname" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Account Name" data-id="sfcase-sfaccountname" data-field="@sfaccountname" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Product Organization" data-id="sfcoreproductorganizationc" data-field="@sfcoreproductorganizationc" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Product Name" data-id="sfcoreipsproductnamec" data-field="@sfcoreipsproductnamec" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Owner" data-id="sfcase-sfownername" data-field="@sfownername" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Year" data-id="Year" data-field="@year" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Month" data-id="Month" data-field="@month" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Sub Status" data-id="sfcoresubstatusc" data-field="@sfcoresubstatusc" data-tab="SalesforceCase"></div>
              <div class="CoveoDynamicFacet" data-title="Project" data-id="sfcoreipsprojectcasername" data-field="@sfcoreipsprojectcasername" data-tab="SalesforceCase"></div>
            </div>
          </div>
        </div>
        <div class="CoveoBoxPopup" data-hidden="true" data-title="Relevance">
          <div class="CoveoBoxCurrentSort"></div>
          <div class="coveo-sort-section">
            <span class="CoveoSort" data-sort-criteria="relevancy" data-caption="Relevance"></span>
            <span class="CoveoSort" data-sort-criteria="date descending,date ascending" data-caption="Date"></span>
          </div>
        </div>
      </div>
      <div class="coveo-box-settings">
        <a class="CoveoBoxEditLink" target="_top"></a>
        <a class="CoveoBoxCreateArticle" target="_blank"></a>
      </div>
      <div class="CoveoBoxQuerySummary"></div>
    </div>
  </div>
  <div class="CoveoTriggers"></div>
  <div class="CoveoBreadcrumb"></div>
  <div class="CoveoDidYouMean"></div>
  <div class="CoveoErrorReport"></div>
  <div class="CoveoBoxBody" data-infinite-scroll-page-size="1">
    <script class="result-template" id="paeportal" type="text/underscore" data-layout="list" data-field-source="paeportal-sitemap">
      <div class="coveo-result-frame item-wrap">
        <div class="content-main">
            <div class="coveo-result-cell content-wrap">
                <div class="coveo-result-row">
                    {{ if(raw.ipsid !== undefined) { }}
                      <div class="coveo-result-cell is-locked">
                        <span class="CoveoIcon" data-small="true"></span>
                        <a class="CoveoResultLink" data-title-template="${raw.codename} IPS # (${raw.ipsid})"></a>
                      </div>
                    {{ } }}
                </div>
                <div class="coveo-result-row">
                  <div class="coveo-result-cell">
                    <span class="CoveoFieldValue" data-field="@question"></span><br>
                    <span class="CoveoFieldValue" data-field="@answer"></span>
                  </div>
                </div>
        </div>
    </div>
</script>
    <script id="Default" class="result-template" type="text/html">
      <div class="coveo-result-frame">
        <div class="coveo-result-row">
          <div class="coveo-result-cell coveo-no-wrap" style="vertical-align: middle;">
            <span class="CoveoIcon" data-small="true"></span>
            <a class="CoveoResultLink" data-always-open-in-new-window="true" data-title-template="${raw.title}"></a>
          </div>
          <div class="coveo-result-cell" style="text-align: right; padding-right: 5px; width: 124px; vertical-align: middle; font-size: 12px;">
            <span class="CoveoFieldValue" data-field="@date" data-helper="dateTime"></span>
          </div>
          <div class="coveo-result-cell" style="width: 20px; vertical-align: middle; text-align: right;">
            <div class="CoveoBoxResultAction">
              <div class="CoveoBoxQuickview">
              </div>
            </div>
          </div>
        </div>
        <div class="coveo-result-row">
          <div class="coveo-result-cell coveo-no-wrap">
            <span class="CoveoFieldValue" data-field="@sfcasenumber" data-text-caption="Case Number:"></span>
            <span class="CoveoFieldValue" data-field="@sfstatus" data-text-caption="Status:"></span> 
          </div>
        </div>
        <div class="coveo-result-row">
          <div class="coveo-result-cell coveo-no-wrap" style="">
            <span class="CoveoFieldValue" data-field="@sfcorecaseresolutionreasonc" data-text-caption="Case Closure Detail:" data-field-source="ips-devcase"></span> 
          </div>
        </div>
        <div class="coveo-result-row">
          <div class="coveo-result-cell">
            <span class="CoveoFieldValue" data-field="@sfbody"></span>
            <span class="CoveoFieldValue" data-field="@sfcoreipscommentc"></span>
            <span class="CoveoFieldValue" data-field="@description"></span>
            <span class="CoveoFieldValue" data-field="@sfcoreissuedescriptionc"></span>
          </div>
        </div>
        <div class="coveo-result-row">
          <div class="coveo-result-cell">
            <span class="CoveoFieldValue" data-field="@answer"></span>
          </div>
        </div>
      </div>
    </script>
  </div>
  <div class="CoveoBoxQuerySome"  data-include="Subject" data-disable-on-non-contextual-search="true" data-include-current-record="true" data-use-some-q-r-e="false"></div>
</div></apex:component>