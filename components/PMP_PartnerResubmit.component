<apex:component access="global" controller="PMP_EmailTemplateController">
    <html>
        <style>
        table {
          font-family: arial, sans-serif;
          border-collapse: collapse;
          border-left: 1px solid #dddddd;
          border-right: 1px solid #dddddd;
          border-top: 0px;
          border-bottom: 0px;
        }
        
        
        
        .intelBlue{
            color:#0071c5;
        }

        </style>
        <apex:attribute name="partnerRecordId" type="Id" description="Partner Record Id" assignTo="{!partnerId}"/>
        <body>
            <!-- Header Banner -->
                <c:PMP_Global_Header message="AN EDIT TO YOUR MARKETPLACE STOREFRONT WAS SUCCESSFULLY SUBMITTED."/>
            <!-- Header Banner -->
            
            <!-- Email content -->
            <table width="75%">    
                <!-- Email Body -->
               <tr>
            <td style="padding-left:50px;">
                <br/>Hello<br/><br/>
                Thanks for submitting your edit to your Intel® Solutions Marketplace Storefront—we’ll review it and send you a response within 3–5 business days.	<br/><br/>
                Thank you again<br/><br/>
                The Intel® Solutions Marketplace Team<br/> <br/>
                
                
            </td>
          </tr>
                <!-- Email Body -->
            <!-- CTA -->
          <tr>
            <td style="padding-left:50px;"> 
                <u><b>Storefront Name : {!partnerData.Name}</b></u><br/>
                <p><apex:outputLink value="{!$Label.PMP_PartnerURL}{!partnerData.PMP_Published_Copy_Id__c}" styleClass="intelBlue">View Storefront Preview	</apex:outputLink></p>
                
                Can't access the link above?<br/>
                <apex:outputLink value="{!$Label.PMP_PartnerURL}{!partnerData.PMP_Published_Copy_Id__c}" styleClass="intelBlue">
                 {!$Label.PMP_PartnerURL}{!partnerData.PMP_Published_Copy_Id__c}
                </apex:outputLink> <br/><br/>
                
            </td>
         </tr>
        <!-- CTA -->
        <!-- Progress Indication 
        <tr>
            <td style="height:50; text-align:center;">
                <apex:image id="bodyImageId" url="{!bodyURL}"/>
            </td>
        </tr>
        <!-- Progress Indication -->
         <!-- Next Best Step -->
        <tr>    
            <td style="padding-left:50px;">
                Would you like to create an Offering ?&nbsp;&nbsp;
                <apex:outputLink value="{!$Label.PMP_CreateOfferingURL}" styleClass="intelBlue">
                Get Started
                </apex:outputLink><br/><br/>
            </td>
        </tr>
        <!-- Next Best Step -->
        <!-- Questions/Contact -->
        <tr>
            <td style="padding-left:50px;">  
                Questions? Reach out to Marketplace Admin Team at <br/>
                <apex:outputLink value="mailto:{!$Label.PMP_MailTo}" styleClass="intelBlue">
                {!$Label.PMP_MailTo}
                </apex:outputLink><br/><br/>
            </td>
         </tr>
         <!-- Questions/Contact -->
         <!-- Marketplace Help & FAQ -->
       <!-- <tr>    
            <td style="text-align:center">
            For FAQs and pro-tips on using Intel Solutions Marketplace, please visit 
            <apex:outputLink value="www.intel.com" styleClass="intelBlue">
            Marketplace Help
            </apex:outputLink><br/><br/>
            </td>
        </tr>-->
          <!-- Marketplace Help & FAQ -->
        </table>                 
            <!-- Email content -->
            
            <!-- Global Footer -->
               <!-- <c:PMP_Global_Footer />-->
            <c:PMP_Global_Footer />
            <!-- Global Footer -->
            
        </body>
    </html>
</apex:component>