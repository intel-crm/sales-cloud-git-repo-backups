<apex:component access="global" controller="PCC_RebateClaimEmailAlertController">
    <html>
        <style>
            /* Regular */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: normal;
            font-weight: 400;
            font-style: normal;
            }
            
            /* Light */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: 200;
            font-style: normal;
            }
            
            /* Bold */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: bold;
            font-weight: 700;
            font-style: normal;
            }
            
            table {
            font-family: Intel Clear; /*arial, sans-serif;*/
            border-collapse: collapse;
            border-left: 1px solid #dddddd;
            border-right: 1px solid #dddddd;
            border-top: 0px;
            border-bottom: 1px solid #dddddd;
            }
            
            td, th {
            padding: 8px;
            }
            
            .intelBlue{
            color:#0071c5;
            }
            
            h1{
            font-family: Intel Clear Pro !important; 
            }
        </style>
        <apex:attribute name="rebateClaimRecordId" type="Id" description="rebateClaimId" assignTo="{!rebateClaimId}"/>
        <body>
            <!-- Header Banner -->    
            <table width="75%">
                <tr style="background-color:#0168B5;">
                    <td style="padding-left:50px;border: 0px;border:none;">
                        <div style="color:white;"><h1>New Rebate Claim Submitted for Review</h1></div>
                    </td>
                    <td style="border:none;padding-right:20px;" align="right">
                        <apex:image url="{!headerURL}" width="100" height="80" alt="Intel Logo"/>
                    </td>
                </tr>
            </table>            
            <!-- Header Banner -->
            <!-- Email Body -->
            <table width="75%">  
                <tr>
                    <td style="padding-left:50px;">
                        Hello,<br/>
                        <br/>The following Rebate Claim has been <b>Assigned</b> to you. <br/><br/>                                
                        <b>Partner Account Name:</b>&nbsp; {!RebateClaimData.PCC_Partner__r.Name }<br/>
                        <b>Claim Number:</b>&nbsp;<apex:outputLink value="{!domainName}/{!RebateClaimData.Id}" >{!RebateClaimData.Name}</apex:outputLink><br/> 
                        <b>Total Claimed Rebate:</b>&nbsp; {!RebateClaimData.PCC_Total_Claimed_Rebate__c}
                        <br/><br/>
                        For more details, you can access the rebate claim record&nbsp;<apex:outputLink value="{!domainName}/{!RebateClaimData.Id}" >here</apex:outputLink>. 
                        <br/><br/>
                    </td>
                </tr>  
            </table>
            <!-- Email Body -->  
            <!-- Global Footer -->
            <table style="background-color:#0168B5;" width="75%">
                <tr style="background-color:#0168B5;">    
                    <td style="text-align:center">
                        <div style="color:white;font-size:10px">
                            This message was sent to you as an important business communication related to your current relationship with Intel® Partner Alliance<br/>
                            ©{!year(today())} Intel Corporation <br/>
                            Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054 USA.
                            <apex:outputLink value="www.intel.com" style="color:white;"> www.intel.com</apex:outputLink><br/>
                            <apex:outputLink value="www.intel.com/privacy" style="color:white;">Privacy</apex:outputLink> | &nbsp;
                            <apex:outputLink value="www.intel.com/cookies" style="color:white;">Cookies</apex:outputLink>
                        </div>
                    </td>
                </tr>
            </table>
            <!-- Global Footer -->
        </body>
    </html>
</apex:component>