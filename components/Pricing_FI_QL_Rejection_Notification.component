<apex:component access="global" controller="Pricing_QuoteEmailAlertController">
    
    <html>
        <style>
            /* Regular */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: normal;
            font-weight: 400;
            font-style: normal;
            }
            
            /* Light */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: 200;
            font-style: normal;
            }
            
            /* Bold */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: bold;
            font-weight: 700;
            font-style: normal;
            }
            
            table {
            font-family: Intel Clear; /*arial, sans-serif;*/
            border-collapse: collapse;
            border-left: 1px solid #dddddd;
            border-right: 1px solid #dddddd;
            border-top: 0px;
            border-bottom: 1px solid #dddddd;
            }
            
            td, th {
            padding: 8px;
            }
            
            .intelBlue{
            color:#0071c5;
            }
            
            h1{
            font-family: Intel Clear Pro !important; 
            }
        </style>
        
        <apex:attribute name="quoteLineRecordId" type="Id" description="Tender Quote Line Id" assignTo="{!quoteLineId}"/>
        
        <body>
            
            <!-- Header Banner -->    
            <table style="background-color:#0168B5;" width="75%">
                <tr>
                    <td style="padding-left:50px;border: 0px;border:none;">
                        <div style="color:white;"><h1>Quote Line Rejected</h1></div>
                    </td>
                    <td style="border:none;padding-right:20px;" align="right">
                        <apex:image url="{!headerURL}" width="100" height="80" alt="Intel Logo"/>
                    </td>
                </tr>
            </table>
            <!-- Header Banner -->
            <!-- Email Body -->
            
            <table width="75%">    
                <tr>
                    <td style="padding-left:50px;">
                        Hello {!quoteLineData.SBQQ__Quote__r.SBQQ__PrimaryContact__r.Name}<br/><br/>
                        
                        <br/>The Quote Line&nbsp;{!quoteLineData.Pricing_Quote_Line_Number__c}&nbsp;has been reviewed, and we are not offering a discount for this request at this time.<br/><br/>
                        
                        <b>Quote:</b>&nbsp;{!quoteLineData.SBQQ__Quote__r.Name}<br/>
                        <b>Quote Line:</b>&nbsp;{!quoteLineData.Pricing_Quote_Line_Number__c}:&nbsp;{!quoteLineData.Pricing_Product_Nm__r.Name}<br/>
                        <b>End Customer Account:</b>&nbsp;{!quoteLineData.SBQQ__Quote__r.Pricing_End_Customer_Name__c}<br/>
                        <b>Project:</b>&nbsp;{!quoteLineData.Pricing_Project_Nm__c}<br/>
                        <b>Opportunity Number:</b>&nbsp;<apex:outputLink value="{!dealRegExternalDomainName}/s/opportunity/{!quoteLineData.SBQQ__Quote__r.SBQQ__Opportunity2__c}" >{!quoteLineData.SBQQ__Quote__r.SBQQ__Opportunity2__c}</apex:outputLink><b> (External) </b> <apex:outputLink value="{!domainName}/{!quoteLineData.SBQQ__Quote__r.SBQQ__Opportunity2__c}" >{!quoteLineData.SBQQ__Quote__r.SBQQ__Opportunity2__c}</apex:outputLink><b> (Internal)</b><br/>
                        <b>Opportunity Name:</b>&nbsp;{!quoteLineData.SBQQ__Quote__r.SBQQ__Opportunity2__r.Name}<br/>
                        <b>Change Request:</b>&nbsp;{!IF(quoteLineData.Pricing_New_Change_Request_cb__c == true, 'Yes', 'No')}<br/>
                        <b>External ID:</b>&nbsp;{!quoteLineData.SBQQ__Quote__r.Pricing_Customer_Reference_Id__c}<br/>
                        <b>Comments:</b>&nbsp;{!quoteLineData.Pricing_Rejection_Reason__c}&nbsp;{!IF(quoteLineData.Pricing_Rejection_Comments_nm__c == '', '', ': '+ quoteLineData.Pricing_Rejection_Comments_nm__c)}<br/><br/>
                        
                        This email was sent from an unmonitored mailbox. For questions, please contact your Intel Partner Sales Account Manager or utilize the Chatter feature on the Opportunity.
                        
                        
                        
                    </td>
                </tr>             
            </table>
            <!-- Email Body -->  
            <!-- Global Footer -->
            <table style="background-color:#0168B5;" width="75%">
                <tr>    
                    <td style="text-align:center;padding-left:50px;border:0px;border:none;">
                        <div style="font-size:10px">
                            <div style="color:white;">
                                This message was sent to you as an important business communication related to your current relationship with Intel® Partner Alliance.<br/>
                                ©{!year(today())} Intel Corporation <br/>
                                Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054 USA.<br/>
                                
                                
                                <apex:outputLink value="www.intel.com" style="color:white;"> www.intel.com</apex:outputLink><br/>
                                <apex:outputLink value="www.intel.com/privacy" style="color:white;">Privacy</apex:outputLink> | &nbsp;
                                <apex:outputLink value="www.intel.com/cookies" style="color:white;">Cookies</apex:outputLink>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
            <!-- Global Footer -->
        </body>
        
    </html>
    
</apex:component>