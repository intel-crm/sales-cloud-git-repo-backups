<apex:component access="global" controller="PMP_OfferingEmailAlertsController"> 
    <html>
        <style>
            /* Regular */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: normal;
            font-weight: 400;
            font-style: normal;
            }
            
            /* Light */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: 200;
            font-style: normal;
            }
            
            /* Bold */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: bold;
            font-weight: 700;
            font-style: normal;
            }
            
            table {
            font-family: Intel Clear; /*arial, sans-serif;*/
            border-collapse: collapse;
            border-left: 1px solid #dddddd;
            border-right: 1px solid #dddddd;
            border-top: 0px;
            border-bottom: 1px solid #dddddd;
            }
            
            td, th {
            padding: 8px;
            }
            
            .intelBlue{
            color:#0071c5;
            }
            
            h1{
            font-family: Intel Clear Pro !important;  
            }
        </style>
        <apex:attribute name="offeringRecordId" type="Id" description="Offering Record Id" assignTo="{!offeringId}"/>
        <body>
            <!-- Header Banner -->
            <c:PMP_Global_Header message="Notification: Edit the publish date of your Marketplace Offering "/>
            <!-- Header Banner -->
            
            <!-- Email content -->
            <table width="75%">    
                <!-- Email Body -->
                <tr>
                    <td style="padding-left:50px;">
                        <br/>Hello <br/><br/>
                        The pre-release product/s for your Marketplace offering, {!offeringData.Name}, are released. To publish this offering in Marketplace, please click on the link below and edit the publish date.
                        
                        <br/><br/>                        
                        Thanks for being part of our solutions community<br/>
                        <b>The Intel® Solutions Marketplace Team</b>  
                        
                    </td>
                </tr>
                <!-- Email Body -->
                <!-- CTA -->
                <tr>
                    <td style="padding-left:50px;">      
                        <p><apex:outputLink value="{!communityURL}{!offeringData.Id}" styleClass="intelBlue">Edit the publish date</apex:outputLink></p>
                    </td>
                </tr>
                <!-- CTA -->
                
                <!-- Progress Indication -->
                <!-- Next Best Step -->
                <!-- <tr>    
<td style="padding-left:50px;">
Would you like to create another Offering ?<br/>
<apex:outputLink value="{!createOfferingURL}" styleClass="intelBlue">
Create Another Offering
</apex:outputLink><br/>
</td>
</tr> -->
                <!-- Next Best Step -->
                <!-- Questions/Contact -->
                <tr>
                    <td style="padding-left:50px;">  
                        Questions? Reach out to Marketplace Admin Team at <br/>
                        <apex:outputLink value="mailto:{!$Label.PMP_MailTo}" styleClass="intelBlue">
                            {!$Label.PMP_MailTo}
                        </apex:outputLink><br/><br/>
                    </td>
                </tr>
                <!-- Questions/Contact -->
            </table>                 
            <!-- Email content -->
            
            <!-- Global Footer -->
            <c:PMP_Global_Footer />
            <!-- Global Footer -->
            
        </body>
    </html>
</apex:component>