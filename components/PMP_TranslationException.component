<apex:component access="global" controller="PMP_SendTranslationExceptionEmail">
    <html>
        <head>
            <style>
                table, th {
                  border: 1px solid black;
                }
            </style>
        </head>
        <body>  
            
            <p>Hi Team</p>
            <p>This is to inform that an Exception has been ocurred during Translation Process.</p>
            <p>The Partners/Offerings Translations are stuck in Translation Queue.</p>
            <p>Kindly check the status of Failed/Terminated Partners/Offerings Translations below: </p>
             <table width="75%">
                <tr>
                    <th>Outbound Message Id</th>
                    <th>Inbound Message Id</th>
                    <th>Status</th>
                    <th>Exception</th>
                </tr>
               
                
                <apex:repeat var="cx" value="{!tableData}">

                
                    <tr>
                        <th>{!cx.Core_Outbound_Message__c}</th>
                        <th>{!cx.id}</th>
                        <th>{!cx.Core_Processing_Status__c}</th>
                        <th>{!cx.Core_Exception_Message__c}</th>
                    </tr>
                  </apex:repeat>
            </table> 
            
            
            
            <p>Thank You</p>
        </body>
    </html>
</apex:component>