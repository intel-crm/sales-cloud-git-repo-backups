<apex:component access="global" controller="PMP_EmailTemplateController">
    <html>
        <style>
            /* Regular */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: normal;
            font-weight: 400;
            font-style: normal;
            }
            
            /* Light */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: 200;
            font-style: normal;
            }
            
            /* Bold */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: bold;
            font-weight: 700;
            font-style: normal;
            }
            
            table {
            font-family: sans-serif; /*arial, sans-serif, Intel Clear;*/
            border-collapse: collapse;
            border-left: 1px solid #dddddd;
            border-right: 1px solid #dddddd;
            border-top: 0px;
            border-bottom: 1px solid #dddddd;
            }
            
            td, th {
            padding: 8px;
            }
            
            .intelBlue{
            color:#0071c5;
            }
            
            <!--h1{
            font-family: Intel Clear !important;  
            }-->
        </style>
        
        <apex:attribute name="partnerRecordId" type="Id" description="Partner Record Id" assignTo="{!partnerId}"/>
       
        <apex:attribute name="partnerType" type="String" description="type of the partner in company"/>
        <body>
            <!-- Header Banner -->
            <c:PMP_Global_Header message="Review and update your Showcase {!partnerType}"/>
            <!-- Header Banner -->
            
            <!-- Email content -->
            <table width="75%">    
                <!-- Email Body -->
                <tr>
                    <td style="padding-left:50px;">
                        <br/>Hello<br/><br/>
                        We want to ensure your Intel® Partner Showcase {!partnerType} gets the attention it deserves from our global audience.<br/><br/>
                        We’ve noticed you haven’t updated your <span style ="text-transform:lowercase">{!partnerType} </span> in the past six months.
                        Please take a moment to review and update your company information <!--and offerings--><!--IPA 2.0-->with any necessary updates, revisions, or additions. 
                        <br/>
                    </td>
                </tr>
                      <!-- CTA -->
                <tr>
                    <td style="padding-left:50px;">
                        <p><apex:outputLink value="{!$Label.PMP_PartnerURL}{!partnerRecordId}" styleClass="intelBlue">Update your {!partnerType}</apex:outputLink></p>
                        
                    </td>
                </tr>
                <!-- CTA -->
                    <tr>
                    <td style="padding-left:50px;">     
                       
                        Thanks for your prompt attention,<br/><br/>
                        The Intel® Partner Showcase Team <br/><br/>
                       <!-- <b>{!partnerType} Name: {!partnerData.Name}</b><br/> -->
                        
                        
                    </td>
                </tr>
                <!-- Email Body -->
                
                <!-- Progress Indication 

                <!-- Progress Indication -->
                <!-- Next Best Step -->
               
                <!-- Next Best Step -->
                <!-- Questions/Contact -->
                <tr>
                    <td style="padding-left:50px;">  
                        Questions? Reach out to Showcase Admin Team at:<br/>
                        <apex:outputLink value="mailto:{!$Label.PMP_MailTo}" styleClass="intelBlue">
                            {!$Label.PMP_MailTo}
                        </apex:outputLink><br/><br/>
                    </td>
                </tr>
                <!-- Questions/Contact -->
                <!-- Marketplace Help & FAQ -->
                <!-- <tr>    
<td style="text-align:center">
For FAQs and pro-tips on using Intel® Partner Showcase, please visit 
<apex:outputLink value="www.intel.com" styleClass="intelBlue">
Showcase Help
</apex:outputLink><br/><br/>
</td>
</tr>-->
                <!-- Marketplace Help & FAQ -->
            </table>                 
            <!-- Email content -->
            
            <!-- Global Footer -->
            <c:PMP_Global_Footer />
            <!-- <c:PMP_PartnerFooterComponent /> -->
            <!-- Global Footer -->
            
        </body>
    </html>
</apex:component>