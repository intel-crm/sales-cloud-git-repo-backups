<apex:component selfClosing="true">
    <apex:attribute name="selectedProductId" description="Product Id" type="String"/>
    <apex:attribute name="selectedSAProductId" description="Supported Product Id" type="String"/>    
    <apex:attribute name="subCategorySelected" description="Sub Category Id" type="String" />
    <!--apex:attribute name="caseId" description="Sub Category Id" type="Id" assignTo="{!selectedProductId}"/-->
    <apex:attribute name="envDetails" type="Core_IPS_EnvironmentDetailQuestion_KS[]" description="List of Env Detais"/>
    <apex:attribute name="subCatenvDetList" type="Core_IPS_EnvironmentDetailQuestion_KS[]" description="List of Env Detais"/>
    <apex:attribute name="displayEnvDetails" type="Boolean" description="Boolean to display environment detais"/>
    
    <apex:outputPanel id="environment1">
        <apex:actionRegion >
        <apex:outputPanel rendered="{!displayEnvDetails && (selectedProductId!=null ||selectedSAProductId!=null)}">
            <apex:pageblockSection title="Environment Details" columns="1">  
                <apex:outputPanel >
                    
                <!-- Sub Category Environment Details Section -->
                <apex:pageblockSection id="subCatEDQSection" rendered="{!subCatenvDetList!=null}">   
                    <apex:repeat value="{!subCatenvDetList}" var="env" rendered="{!subCategorySelected!=null}" id="EnvironmentDetails1">
                        <apex:pageblockSectionItem id="section" rendered="{!if(CONTAINS(env.type,'Text Area'),false,true)}">
                            <apex:outputLabel value="{!env.label}" escape="true"></apex:outputLabel>
                            <apex:outputPanel id="panel">
                                <!-- Text -->
                                <apex:outputPanel rendered="{!if(env.type=='Text',true,false)}" id="panel1">
                                    <apex:outputPanel styleClass="{!IF(env.required,'requiredInput','')}" layout="block">
                                        <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!env.required}"/>
                                        <apex:inputText value="{!env.sPlaceHolder}">
                                        </apex:inputText>
                                    </apex:outputPanel>
                                    <br/>
                                </apex:outputPanel>
                                <!-- Picklist -->
                                <apex:outputPanel rendered="{!if(env.type=='Picklist', true,false)}">                                    
                                        <apex:outputPanel styleClass="{!IF(env.required,'requiredInput','')}" layout="block">
                                            <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!env.required}"/>
                                            <apex:selectList value="{!env.selectedValue}" size="1" id="targetId" styleClass="cust-combobox">
                                                <!--<apex:selectList value="{!env.selectedValue}" size="1" required="true" id="targetId" onchange="changeSelection('{!$Component.targetId}')" >-->
                                                <apex:selectOptions value="{!env.pPlaceHolder}"/>
                                                <apex:actionSupport event="onchange" action="{!env.renderDependentQuestions}" rendered="{!env.hasChildQuestions}" reRender="environment1" status="status1" oncomplete="renderCombobox()"/>
                                            </apex:selectList>
                                        </apex:outputPanel>                                     
                                    <br/>
                                </apex:outputPanel>
                                <!-- MultiSelect Pickist -->
                                <apex:outputPanel rendered="{!if(env.type=='Multiselect Picklist', true,false)}">
                                    <apex:outputPanel styleClass="custom-multiselect {!IF(env.required,'requiredInput','')}" layout="block">
                                        <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!env.required}"/>                                        
                                        <!--Start of user story- changes made for user story-US61129 width was need to be increased-->                                        
                                        <apex:selectList value="{!env.selectedMValue}" size="3" styleClass="envClass" multiselect="true">                                           
                                            <apex:selectOptions value="{!env.pPlaceHolder}"/>
                                        </apex:selectList>
                                    </apex:outputPanel>                                    
                                    <br/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!if(env.type=='check',true,false)}">
                                    <apex:inputcheckbox value="{!env.cPlaceHolder}"/><br/>
                                </apex:outputPanel>
                            </apex:outputPanel>
                        </apex:pageblockSectionItem>
                        
                        <!-- Dependent Details Section -->
                        <apex:repeat value="{!env.childQuestions}" var="envDetail" id="dependentDetails">
                            <apex:pageblockSectionItem id="dependentsection" rendered="{!envDetail.isVisible}">
                                <apex:outputLabel value="{!envDetail.label}" escape="true"></apex:outputLabel>
                                <apex:outputPanel id="datapanel">  
                                    
                                    <apex:outputPanel rendered="{!if(envDetail.type=='Text',true,false)}" id="panel1">
                                        <apex:outputPanel styleClass="{!IF(envDetail.required,'requiredInput','')}" layout="block">
                                            <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!envDetail.required}"/>
                                            <apex:inputText value="{!envDetail.sPlaceHolder}">
                                            </apex:inputText>
                                        </apex:outputPanel>
                                        <br/>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(envDetail.type=='Text Area',true,false)}" >
                                        <apex:outputPanel styleClass="{!IF(envDetail.required,'requiredInput','')}" layout="block">
                                            <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!envDetail.required}"/>
                                            <apex:inputtextarea rows="5" cols="150" style="width:100%;" value="{!envDetail.tPlaceHolder}" />
                                        </apex:outputPanel>                                    
                                        <br/>
                                    </apex:outputPanel>
                                
                                    <apex:outputPanel rendered="{!if(envDetail.type=='Picklist', true,false)}">
                                        <apex:outputPanel styleClass="{!IF(envDetail.required,'requiredInput','')}" layout="block">
                                            <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!envDetail.required}"/>
                                            <apex:selectList value="{!envDetail.selectedValue}" size="1" id="targetId" styleClass="cust-combobox">
                                                <apex:selectOptions value="{!envDetail.pPlaceHolder}" />                                                
                                            </apex:selectList>
                                        </apex:outputPanel>                                        
                                        <br/>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(envDetail.type=='Multiselect Picklist', true,false)}">
                                        <apex:outputPanel styleClass="custom-multiselect {!IF(envDetail.required,'requiredInput','')}" layout="block">
                                            <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!envDetail.required}"/>                                       
                                            <apex:selectList value="{!envDetail.selectedMValue}" size="3" styleClass="envClass" multiselect="true">
                                                <apex:selectOptions value="{!envDetail.pPlaceHolder}"/>
                                            </apex:selectList>
                                        </apex:outputPanel>                                        
                                        <br/>
                                    </apex:outputPanel>                                    
                                </apex:outputPanel>
                            </apex:pageblockSectionItem>
                        </apex:repeat>
                    </apex:repeat>
                </apex:pageblockSection>
                
                <!-- To display SubCategory Env Questions of Type Rich Text Area as part of US60820 IPS Evolve -->
                <apex:pageblockSection columns="1">
                    <apex:repeat value="{!subCatenvDetList}" var="env" rendered="{!subCategorySelected!=null && subCategorySelected!=''}">
                        <apex:pageblockSectionItem id="section" rendered="{!if(CONTAINS(env.type,'Text Area'),true,false)}">
                            <apex:outputLabel value="{!env.label}" escape="true"></apex:outputLabel>
                            <apex:outputPanel id="panel">
                                <apex:outputPanel >
                                    <apex:outputPanel styleClass="{!IF(env.required,'requiredInput','')}" layout="block">
                                        <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!env.required}"/>
                                        <apex:inputtextarea rows="10" cols="150" style="width:100%;" value="{!env.tPlaceHolder}" /><br/>
                                    </apex:outputPanel>                                    
                                </apex:outputPanel>
                            </apex:outputPanel>
                        </apex:pageblockSectionItem>
                    </apex:repeat>  
                </apex:pageblockSection>
                
                <!-- Environment Details for Supported Product -->
                <apex:pageblockSection id="suppProductEDQSection">
                    <apex:repeat value="{!envDetails}" var="env" id="EnvironmentDetails">
                        <apex:pageblockSectionItem id="section" rendered="{!if(CONTAINS(env.type,'Text Area'),false,true)}">
                            <apex:outputLabel value="{!env.label}" escape="true"></apex:outputLabel>
                            <apex:outputPanel id="panel">
                                <!-- Text -->
                                <apex:outputPanel rendered="{!if(env.type=='Text',true,false)}" id="panel1">
                                    <apex:outputPanel styleClass="{!IF(env.required,'requiredInput','')}" layout="block">
                                        <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!env.required}"/>
                                        <apex:inputText value="{!env.sPlaceHolder}">
                                        </apex:inputText>
                                    </apex:outputPanel>                                    
                                    <br/>
                                </apex:outputPanel>
                                <!-- Pickist -->
                                <apex:outputPanel rendered="{!if(env.type=='Picklist', true,false)}">
                                    
                                    <apex:outputPanel styleClass="{!IF(env.required,'requiredInput','')}" layout="block">
                                        <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!env.required}"/>
                                        
                                            <apex:selectList value="{!env.selectedValue}" size="1" id="targetId" styleClass="cust-combobox">
                                                <!--<apex:selectList value="{!env.selectedValue}" size="1" required="true" id="targetId" onchange="changeSelection('{!$Component.targetId}')" >-->
                                                <apex:selectOptions value="{!env.pPlaceHolder}"/>
                                                <apex:actionSupport event="onchange" action="{!env.renderDependentQuestions}" rendered="{!env.hasChildQuestions}" reRender="environment1" status="status1" oncomplete="renderCombobox()"/>
                                            </apex:selectList>
                                    </apex:outputPanel>                                                                        
                                    <br/>
                                </apex:outputPanel>
                                <!-- MultiSelect Pickist -->
                                <apex:outputPanel rendered="{!if(env.type=='Multiselect Picklist', true,false)}">
                                    <apex:outputPanel styleClass="custom-multiselect {!IF(env.required,'requiredInput','')}" layout="block">
                                        <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!env.required}"/>                                       
                                        <!--Start of user story- changes made for user story-US61129 width was need to be increased-->                                        
                                        <apex:selectList value="{!env.selectedMValue}" size="3" styleClass="envClass" multiselect="true">                                           
                                            <apex:selectOptions value="{!env.pPlaceHolder}"/>
                                        </apex:selectList>
                                    </apex:outputPanel>                                    
                                    <br/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!if(env.type=='check',true,false)}">
                                    <apex:inputcheckbox value="{!env.cPlaceHolder}"/><br/>
                                </apex:outputPanel>
                            </apex:outputPanel>
                        </apex:pageblockSectionItem>
                        
                        <!-- Dependent Details Section -->
                        <apex:repeat value="{!env.childQuestions}" var="envDetail" id="dependentDetails">
                            <apex:pageblockSectionItem id="dependentsection" rendered="{!envDetail.isVisible}">
                                <apex:outputLabel value="{!envDetail.label}" escape="true"></apex:outputLabel>
                                <apex:outputPanel id="datapanel"> 

                                    <apex:outputPanel rendered="{!if(envDetail.type=='Text',true,false)}" id="panel1">
                                        <apex:outputPanel styleClass="{!IF(envDetail.required,'requiredInput','')}" layout="block">
                                            <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!envDetail.required}"/>
                                            <apex:inputText value="{!envDetail.sPlaceHolder}">
                                            </apex:inputText>
                                        </apex:outputPanel>                                    
                                        <br/>
                                    </apex:outputPanel> 
                                    <apex:outputPanel rendered="{!if(envDetail.type=='Text Area',true,false)}" >
                                        <apex:outputPanel styleClass="{!IF(envDetail.required,'requiredInput','')}" layout="block">
                                            <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!envDetail.required}"/>
                                            <apex:inputtextarea rows="5" cols="150" style="width:100%;" value="{!envDetail.tPlaceHolder}" />
                                        </apex:outputPanel>                                    
                                        <br/>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(envDetail.type=='Picklist', true,false)}">
                                        <apex:outputPanel styleClass="{!IF(envDetail.required,'requiredInput','')}" layout="block">
                                            <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!envDetail.required}"/>
                                            <apex:selectList value="{!envDetail.selectedValue}" size="1" id="targetId" styleClass="cust-combobox">
                                                <apex:selectOptions value="{!envDetail.pPlaceHolder}" />                                                
                                            </apex:selectList>
                                        </apex:outputPanel>                                        
                                        <br/>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(envDetail.type=='Multiselect Picklist', true,false)}">
                                        <apex:outputPanel styleClass="custom-multiselect {!IF(envDetail.required,'requiredInput','')}" layout="block">
                                            <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!envDetail.required}"/>                                       
                                            <apex:selectList value="{!envDetail.selectedMValue}" size="3" styleClass="envClass" multiselect="true">
                                                <apex:selectOptions value="{!envDetail.pPlaceHolder}"/>
                                            </apex:selectList>
                                        </apex:outputPanel>                                        
                                        <br/>
                                    </apex:outputPanel>                                    
                                </apex:outputPanel>
                            </apex:pageblockSectionItem>
                        </apex:repeat>
                    </apex:repeat>
                </apex:pageblockSection>
                
                <!-- Section for Text Area - Supported Product Environment Details -->
                <apex:pageblockSection columns="1">
                    <apex:repeat value="{!envDetails}" var="env">
                        <apex:pageblockSectionItem id="section" rendered="{!if(CONTAINS(env.type,'Text Area'),true,false)}">
                            <apex:outputLabel value="{!env.label}" escape="true" ></apex:outputLabel>
                            <apex:outputPanel id="panel">
                                <apex:outputPanel styleClass="{!IF(env.required,'requiredInput','')}" layout="block">
                                    <apex:outputPanel styleClass="requiredBlock" layout="block" rendered="{!env.required}"/>
                                    <!--<apex:inputtextarea value="{!env.tPlaceHolder}" required="true"/><br/>-->
                                    <apex:inputtextarea rows="10" cols="150" style="width:100%;"   value="{!env.tPlaceHolder}" /><br/>
                                </apex:outputPanel>                                
                            </apex:outputPanel>
                        </apex:pageblockSectionItem>
                    </apex:repeat>                      
                </apex:pageblockSection>
                
                </apex:outputPanel>
            </apex:pageblockSection>
        </apex:outputPanel>
        </apex:actionRegion>
    </apex:outputPanel>
    
</apex:component>