        <table class="t">
            <tr>
                <th class="t1">Quote #</th>
                <td class="t1">{!dpa.core_cpq_active_quote__r.name}</td>
            </tr>
            <tr>
                <th class="t1">SAP #</th>
                <td class="t1">{!dpa.core_cpq_dpa_aln_no_nbr__c}</td>
