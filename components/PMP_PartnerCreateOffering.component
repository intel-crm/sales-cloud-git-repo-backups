<apex:component access="global" controller="PMP_EmailTemplateController">
    <html>
        <style>
            /* Regular */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Regular-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: normal;
            font-weight: 400;
            font-style: normal;
            }
            
            /* Light */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Light-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: 200;
            font-style: normal;
            }
            
            /* Bold */
            @font-face{
            font-family: 'Intel Clear','Intel Clear Pro';
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot')}");  /* IE9*/
            src: url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.eot?#iefix')}") format('embedded-opentype'), /* IE6-IE8 */
            url("{!URLFOR($Resource.IntelClearFonts, '/fonts/IntelClear-Bold-webfont.woff')}") format('woff');  /* Modern browsers*/
            font-weight: bold;
            font-weight: 700;
            font-style: normal;
            }
            
            table {
            font-family: Intel Clear; /*arial, sans-serif;*/
            border-collapse: collapse;
            border-left: 1px solid #dddddd;
            border-right: 1px solid #dddddd;
            border-top: 0px;
            border-bottom: 1px solid #dddddd;
            }
            
            td, th {
            padding: 8px;
            }
            
            .intelBlue{
            color:#0071c5;
            }
            
            h1{
            font-family: Intel Clear Pro !important;  
            }
        </style>
        
        <apex:attribute name="partnerRecordId" type="Id" description="Partner Record Id" assignTo="{!partnerId}"/>
        
        <apex:attribute name="partnerType" type="String" description="type of the partner in company"/>
        <body>
            <!-- Header Banner -->
            <c:PMP_Global_Header message="Action Required: Please create offerings for your published storefront"/>
            <!-- Header Banner -->
            
            <!-- Email content -->
            <table width="75%">    
                <!-- Email Body -->
                <tr>
                    <td style="padding-left:50px;">
                        <br/>Hello<br/><br/>
                        We recently let you know that your Intel® Solutions Marketplace storefront has been published. This means you can now list your offerings to heighten your storefront with customers, and Intel Partners.
                        
                        <br/><br/>
                        Please use the link below to create offerings for your storefront and submit them for Intel review and publishing.  You will find a video within the Intel® Solutions Marketplace Help that guides you through creating an offering.
                        <br/><br/>
                        <p><apex:outputLink value="{!$Label.PMP_PartnerURL}{!partnerData.PMP_Published_Copy_Id__c}" styleClass="intelBlue">Create Offerings</apex:outputLink></p>
                        <br/>
                        Thanks for your prompt attention,<br/><br/>
                        The Intel® Solutions Marketplace Team <br/> <br/>
               
                    </td>
                </tr>
             
                <tr>
                    <td style="padding-left:50px;">  
                        Questions? Reach out to the Marketplace Admin Team at <br/>
                        <apex:outputLink value="mailto:{!$Label.PMP_MailTo}" styleClass="intelBlue">
                            {!$Label.PMP_MailTo}
                        </apex:outputLink><br/><br/>
                    </td>
                </tr>
                <!-- Questions/Contact -->
               
            </table>                 
            <!-- Email content -->
            
            <!-- Global Footer -->
            <c:PMP_Global_Footer />
            <!-- Global Footer -->
            
        </body>
    </html>
</apex:component>