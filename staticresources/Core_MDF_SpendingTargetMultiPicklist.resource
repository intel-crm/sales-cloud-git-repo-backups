.slds-grid .slds-hyphenate {
    width: 100%
}

.slds-grid .slds-truncate {
    width: 100%
}


.picklist-section{
    margin-top: -1rem;
    margin-left: -0.5rem;
    position: absolute !important;
    min-width: 10%;
	z-index: 9001;
}

.picklist-section .slds-dropdown{
    max-height: 180px;
    max-width: fit-content;
    overflow: auto;
    z-index: 10000;
}

.slds-listbox{
    z-index: 9001!important;
}