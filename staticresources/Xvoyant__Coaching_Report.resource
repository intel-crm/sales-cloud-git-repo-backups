<html xmlns="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/1999/xhtml" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; margin: 0; padding: 0;">
	<head>
		<meta charset="utf-8"> <!-- utf-8 works for most cases -->
		<meta name="viewport" content="width=device-width"> <!-- Forcing initial-scale shouldn't be necessary -->
		<meta http-equiv="X-UA-Compatible" content="IE=edge"> <!-- Use the latest (edge) version of IE rendering engine -->
		<meta name="x-apple-disable-message-reformatting">  <!-- Disable auto-scale in iOS 10 Mail entirely -->
		<title>Your Monthly Xvoyant Sales Coaching Report</title>
		<style type="text/css">
			@media only screen and (max-width: 480px){
				#templateColumns{
				width: 100% !important;
				min-width: 0 !important;
				}
				.templateColumnContainer{
				width: 100% !important;
				max-width: 100% !important;
				margin-bottom: 12px;
				}
				.txt-sm {
				font-size: 14px !important;
				}
				.btn {
				width: 100% !important;
				padding: 18px 0 !important;
				}
				.hide-mobile {
				display: none !important;
				}
			}
		</style>
	</head>
	<body bgcolor="#F3F3F3" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; width: 100% !important; height: 100%; margin: 0; padding: 0;">
		<div class="body" bgcolor="#F3F3F3" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; width: 100% !important; height: 100%; margin: 0; padding: 0;">
			<table class="body" bgcolor="#F3F3F3" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; width: 100% !important; height: 100%; margin: 0; padding: 0;">
				<tr>
					<td class="center" align="center" valign="top">
						<center>
							<table class="container">
								<tr>
									<td>
										<!-- START EMAIL CONTENT -->

										<!-- LOGO -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#FFFFFF" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 0; padding: 12px 12px 0 12px;">
											<tr>
												<td align="center" valign="top">
													<table border="0" cellpadding="0" cellspacing="0" align="left" width="100%">
														<tr>
															<td align="left" valign="top">
																<a href="http://www.xvoyant.com/" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; margin: 0; padding: 0; max-width: 120px; display: block;">
																	<img src="https://www.xvoyant.com/images/app/email-logo.png" alt="Xvoyant Logo" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; max-width: 100%; margin: 6px; padding: 0; width: 100%;" />
																</a>
															</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>


										<!-- GREETING -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#FFFFFF" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 0; padding: 0 12px 12px 12px;">
											<tr>
												<td align="left" valign="top">
													<table border="0" cellpadding="0" cellspacing="0" align="left" width="100%">
														<tr>
															<td align="left" valign="top">
																<p style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #101010; text-decoration: none; margin: 6px; padding: 0; line-height: 24px;">Hi {!Recipient.Name},</p>
																<p style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #101010; text-decoration: none; margin: 6px; padding: 0; line-height: 24px;">Here is your monthly Sales Coaching update from Xvoyant.</p>
															</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>



										<!-- TITLE -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#FFFFFF" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 0; padding: 12px;">
											<tr>
												<td align="left" valign="top">
													<table border="0" cellpadding="0" cellspacing="0" align="left" width="100%">
														<tr>
															<td align="left" valign="top">
																<h1 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; margin: 0; padding: 0; font-size: 24px; text-align: center;">{!reportTitle}</h1>
															</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>


										<!-- METRICS -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#FFFFFF" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 0; padding: 0 12px;">
											<tr>
												<td align="center" valign="top">
													<div style="width: 200px; display: inline-block; text-align: center; {!display_coachability}" class="templateColumnContainer">
														<div style="color: #29407B; border: 2px solid #D4D4D4; margin: 6px; {!display_coachability_highlight}">
															<h2 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; margin: 0; padding: 6px 6px 2px; font-size: 18px; text-align: center;">Coachability</h2>
															<span style="font-size: 28px;">{!currentCoachingScore}</span>
															<br />
															<span class="txt-sm" style="font-size: 10px;">Average Coachability<br />Score</span>

															<table border="0" cellpadding="10" cellspacing="1" width="100%" style="padding-top: 8px;">
																<tr>
																	<td width="50%" bgcolor={!coachingScoreChangeColor} align="center" valign="top" style="padding: 6px; color: #FFFFFF;">
																		<span style="font-size: 18px;"><span style="font-size: 15px; vertical-align: top; margin-top: 2px;">{!coachingScoreArrow}</span>{!coachingScoreChange}</span>
																		<br />
																		<span class="txt-sm" style="font-size: 10px">From Last Month</span>
																	</td>
																	<td width="50%" bgcolor={!goalCoachingScoreColor} align="center" valign="top" style="padding: 6px; color: #FFFFFF;">
																		<span style="font-size: 18px;">{!goalCoachingScore}</span>
																		<br />
																		<span class="txt-sm" style="font-size: 10px">Target Value</span>
																	</td>
																</tr>
															</table>
														</div>
													</div>
													<div style="width: 200px; display: inline-block; text-align: center; {!display_coaching11s}" class="templateColumnContainer">
														<div style="color: #29407B; border: 2px solid #D4D4D4; margin: 6px; {!display_coaching11s_highlight}">
															<h2 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; margin: 0; padding: 6px 6px 2px; font-size: 18px; text-align: center;">Coaching 1:1s</h2>
															<span style="font-size: 28px;">{!percentOfTeamWithSession}%</span>
															<br />
															<span class="txt-sm" style="font-size: 10px;">Reps Have Scheduled 1:1s<br />(<strong>{!totalSessions}</strong> Total 1:1s Scheduled)</span>

															<table border="0" cellpadding="10" cellspacing="1" width="100%" style="padding-top: 8px;">
																<tr>
																	<td width="50%" bgcolor={!percentOfTeamWithSessionChangeColor} align="center" valign="top" style="padding: 6px; color: #FFFFFF;">
																		<span style="font-size: 18px;"><span style="font-size: 15px; vertical-align: top; margin-top: 2px;">{!percentOfTeamWithSessionChangeArrow}</span>{!percentOfTeamWithSessionChange}%</span>
																		<br />
																		<span class="txt-sm" style="font-size: 10px">From Last Month</span>
																	</td>
																	<td width="50%" bgcolor={!targetSessionColor} align="center" valign="top" style="padding: 6px; color: #FFFFFF;">
																		<span style="font-size: 18px;">{!targetSessionPercent}%</span>
																		<br />
																		<span class="txt-sm" style="font-size: 10px">Target Value</span>
																	</td>
																</tr>
															</table>
														</div>
													</div>
													<div style="width: 200px; display: inline-block; text-align: center; {!display_coachingGoals}" class="templateColumnContainer">
														<div style="color: #29407B; border: 2px solid #D4D4D4; margin: 6px;{!display_coachingGoals_highlight}">
															<h2 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; margin: 0; padding: 6px 6px 2px; font-size: 18px; text-align: center;">Coaching Goals</h2>
															<span style="font-size: 28px;">{!percentOfTeamWithCoachingGoal}%</span>
															<br />
															<span class="txt-sm" style="font-size: 10px;">Reps Have Coaching Goals<br />(<strong>{!totalCoachingGoals}</strong> Total Goals Set)</span>

															<table border="0" cellpadding="10" cellspacing="1" width="100%" style="padding-top: 8px;">
																<tr>
																	<td width="50%" bgcolor={!percentOfTeamWithCoachingGoalColor} align="center" valign="top" style="padding: 6px; color: #FFFFFF;">
																		<span style="font-size: 18px;"><span style="font-size: 15px; vertical-align: top; margin-top: 2px;">{!percentOfTeamWithCoachingGoalArrow}</span>{!percentOfTeamWithCoachingGoalChange}%</span>
																		<br />
																		<span class="txt-sm" style="font-size: 10px">From Last Month</span>
																	</td>
																	<td width="50%" bgcolor={!targetGoalColor} align="center" valign="top" style="padding: 6px; color: #FFFFFF;">
																		<span style="font-size: 18px;">{!targetGoalPecent}%</span>
																		<br />
																		<span class="txt-sm" style="font-size: 10px">Target Value</span>
																	</td>
																</tr>
															</table>
														</div>
													</div>
													<div style="width: 200px; display: inline-block; text-align: center; {!display_p2g}" class="templateColumnContainer">
														<div style="color: #29407B; border: 2px solid #D4D4D4; margin: 6px; {!display_p2g_highlight}">
															<h2 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; margin: 0; padding: 6px 6px 2px; font-size: 18px; text-align: center;">Progress to Goal</h2>
															<span style="font-size: 28px;">{!currentProgressToGoal}%</span>
															<br />
															<span class="txt-sm" style="font-size: 10px;">Team Progress Toward<br />Aggregate Sales Goal</span>

															<table border="0" cellpadding="10" cellspacing="1" width="100%" style="padding-top: 8px;">
																	<tr>
																		<td width="50%" bgcolor={!changeProgressToGoalColor} align="center" valign="top" style="padding: 6px; color: #FFFFFF;">
																			<span style="font-size: 18px;"><span style="font-size: 15px; vertical-align: top; margin-top: 2px;">{!changeProgressToGoalArrow}</span>{!changeProgressToGoal}%</span>
																			<br />
																			<span class="txt-sm" style="font-size: 10px">From Last Month</span>
																		</td>
																	</tr>
															</table>
														</div>
													</div>
													<div style="width: 200px; display: inline-block; text-align: center; {!display_rpr}" class="templateColumnContainer">
														<div style="color: #29407B; border: 2px solid #D4D4D4; margin: 6px;{!display_rpr_highlight}">
															<h2 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; margin: 0; padding: 6px 6px 2px; font-size: 18px; text-align: center;">Revenue Per Rep</h2>
															<span style="font-size: 28px;">{!currentRPR}</span>
															<br />
															<span class="txt-sm" style="font-size: 10px;">Average Revenue Per Rep<br />This Month</span>

															<table border="0" cellpadding="10" cellspacing="1" width="100%" style="padding-top: 8px;">
																<tr>
																	<td width="50%" bgcolor={!changeRPRColor} align="center" valign="top" style="padding: 6px; color: #FFFFFF;">
																		<span style="font-size: 18px;"><span style="font-size: 15px; vertical-align: top; margin-top: 2px;">{!changeRPRArrow}</span>{!changeRPR}%</span>
																		<br />
																		<span class="txt-sm" style="font-size: 10px">From Last Month</span>
																	</td>
																</tr>
															</table>
														</div>
													</div>
												</td>
											</tr>
										</table>



										<!-- ACTIVITIES -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#FFFFFF" style="{!display_topActivities}font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 0; padding: 12px;">
											<tr>
												<td align="left" valign="top">
													<table border="0" cellpadding="0" cellspacing="0" align="left" width="100%">
														<tr>
															<td align="left" valign="top">
																<h2 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; padding: 0; font-size: 18px; text-align: center;">Top Activities Coached on in {!reportMonth}</h2>
															</td>
														</tr>
														<tr>
															<td align="center" valign="top" style="padding-top: 0;">{!topActivities}</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>



										<!-- SKILLS -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#FFFFFF" style="{!display_topSkills}font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 0; padding: 12px;">
											<tr>
												<td align="left" valign="top">
													<table border="0" cellpadding="0" cellspacing="0" align="left" width="100%">
														<tr>
															<td align="left" valign="top">
																<h2 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; padding: 0; font-size: 18px; text-align: center;">Top Skills Coached on in {!reportMonth}</h2>
															</td>
														</tr>
														<tr>
															<td align="center" valign="top" style="padding-top: 0;">{!topSkills}</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>



										<!-- RANKED BY COACHABILITY TABLE -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#FFFFFF" style="{!display_coachabilityTeam}font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 0; padding: 12px 18px;">
											<tr>
												<td align="left" valign="top">
													<table border="0" cellpadding="0" cellspacing="0" align="left" width="100%">
														<tr>
															<td align="center" valign="top">
																<h2 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; padding: 0; font-size: 18px; text-align: center;">{!teamTableTitle}</h2>
															</td>
														</tr>
														<tr>
															<td align="left" valign="top">
																<table border="0" cellpadding="10" cellspacing="0" width="100%" class="txt-sm" style="font-size: 12px; color: #29407B; border: 2px solid #D4D4D4;">
																	<tr>
																		<th align="left" valign="top">
																			{!userTeamHeader}
																		</th>
																		<th align="center" valign="top">
																			Coachability
																		</th>
																		<th align="center" valign="top">
																			Goals
																		</th>
																		<th align="center" valign="top">
																			1:1s
																		</th>
																		<th align="center" valign="top">
																			P2G
																		</th>{!rprColumnHeader}
																	</tr>
																	{!teamByCoachability}
																</table>
															</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>



										<!-- REPS NEEDING COACHING TABLE -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#FFFFFF" style="{!display_needCoaching}font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 0; padding: 12px 18px 18px;">
											<tr>
												<td align="left" valign="top">
													<table border="0" cellpadding="0" cellspacing="0" align="left" width="100%">
														<tr>
															<td align="center" valign="top">
																<h2 style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #29407B; text-decoration: none; padding: 0; font-size: 18px; text-align: center;">Individuals Needing Coaching This Month</h2>
															</td>
														</tr>
														<tr>
															<td align="center" valign="top" style="padding-top: 0;">
																<table border="0" cellpadding="10" cellspacing="0" width="100%" class="txt-sm" style="font-size: 12px; color: #29407B; border: 2px solid #D4D4D4;">
																	<tr>
																		<th align="left" valign="top">
																			Team Member
																		</th>
																		<th align="center" valign="top">
																			Coachability
																		</th>
																		<th align="center" valign="top">
																			Goals
																		</th>
																		<th align="center" valign="top">
																			Last Session
																		</th>
																		<th align="center" valign="top">
																			P2G
																		</th>
																	</tr>
																	{!teamNeedsCoaching}
																</table>
															</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>



										<!-- LOGIN BUTTON -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#FFFFFF" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 24px 0; padding: 18px;">
											<tr>
												<td align="center" valign="top">
													<table border="0" cellpadding="0" cellspacing="0" align="center" width="100%">
														<tr>
															<td align="center" valign="top">
																<p style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #101010; text-decoration: none; padding: 0; text-align: center; line-height: 24px;">Want to go deeper? See something you like?</p>
																<a href="{!SiteAddress_Details}" class="btn" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #FFF; text-decoration: none; text-transform: uppercase; font-weight: bold; text-align: center; cursor: pointer; display: inline-block; -moz-border-radius: 5px; -webkit-border-radius: 5px; border-radius: 3px; background-color: #29407b; padding: 18px; text-align: center;">Login to Xvoyant</a>
															</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>



										<!-- COPYRIGHT -->
										<table border="0" cellpadding="0" cellspacing="0" width="640" id="templateColumns" bgcolor="#F3F3F3" style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; height: 100%; margin: 24px 0 0; padding: 18px 0 0;">
											<tr>
												<td align="center" valign="top">
													<table border="0" cellpadding="0" cellspacing="0" align="center" width="100%">
														<tr>
															<td align="center" valign="top">
																<p style="font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #a9a9a9; text-decoration: none; padding: 0; text-align: center; font-size: 12px; line-height: 24px;">Copyright Xvoyant 2019</p>
															</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>

										<div id="jsonData" style="display: none;">__xvoyantdata__{!JSON.data}__endxvoyantdata__</div>

										<!-- END EMAIL CONTENT -->
									</td>
								</tr>
							</table>
						</center>
					</td>
				</tr>
			</table>
		</div>
	</body>
</html>
