.slds-rich-text-editor__output {
        line-height: var(--lwc-lineHeightText,1.5);
        overflow-wrap: break-word !important;
        word-wrap: break-word !important;
        white-space: pre-line !important;
        -webkit-hyphens: manual;
        -ms-hyphens: manual;
        hyphens: manual;
    }