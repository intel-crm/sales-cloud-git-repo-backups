.datatable-orange{
  color:#fff;
  background-color:#e06000;
}
.datatable-orange:hover{
  color:#000;
  background-color:#e06000;
}
.portalTable table>thead .slds-cell-fixed.slds-has-button-menu, .portalTable table>thead .slds-cell-fixed.slds-has-button-menu:hover{
	background-color: #e9e9e9;
}
.showRequired .slds-form-element__control{
border:2px solid #cc0000;
border-radius:5px;
}
