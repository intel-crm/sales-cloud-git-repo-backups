.slds-cell-fixed {
    background-color: #f7f7f7;
}

.slds-table_header-fixed_container, .slds-table--header-fixed_container {
    border: 1px solid #d4d4d4;
    word-break: break-word;
}

.slds-table th, .slds-table td {
    border-right: 1px solid #d4d4d4;
}
.slds-nav-vertical_shade .slds-is-active .slds-nav-vertical__action {
    border: none;
}
.slds-nav-vertical_shade .slds-is-active .slds-nav-vertical__action:focus{
    outline:auto !important;
}
.slds-nav-vertical__item {
    border-bottom: 1px solid #d4d4d4;
}
label {
    display: inline-block !important;
}
.slds-select_container:after {
    top: 9px;
}

.backButton {
    color: #0068b5 !important;
}
/* .slds-button:focus, .slds-accordion__summary-heading .slds-button:focus {
    outline: none !important;
} */
.slds-form-element .slds-input[type=search] {
    padding: 0 0.2rem 0 1.9rem !important;
    font-size: 14px !important;
}
body {
    font-size: 0.8125rem !important;
}
.slds-form-element .slds-input {
    padding-left: 10px !important;
    padding-right: 10px !important;
}
.button-secondary:disabled, .button:disabled, .button:disabled:focus, .button:disabled:hover, a.button.button-disabled, a:focus .button:disabled, a:focus lightning-button .slds-button:disabled, lightning-button .slds-button:disabled, lightning-button .slds-button:disabled:focus, lightning-button .slds-button:disabled:hover, lightning-button .slds-button_neutral:disabled {
    border: none !important;
}
.slds-nav-vertical__action:focus{
    outline:auto !important;
}
.link-text:focus, a:focus{
    outline:auto !important;
}
.iconcolor svg{
    fill: #747474;
    width: 14px;
    position: relative;
    top: -4px;
}
.inputs .slds-input{
    border-radius: 5px;
}
.fix-slds-input_faux[lwc-4kb6kaqheak] {
    line-height: max(2.5rem, calc(1.2em - 2px)) !important;
}