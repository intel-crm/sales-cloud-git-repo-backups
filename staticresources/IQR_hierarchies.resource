        {
            "id": "194690",
            "parentId": "98836",
            "sourceId": "Intel® Agilex™ FPGAs and SoC FPGAs",
            "name": "Intel® Agilex™ FPGAs and SoC FPGAs",
            "rawName": "Intel Agilex FPGAs and SoC FPGAs",
            "localizedName": "Intel® Agilex™ FPGAs and SoC FPGAs",
            "description": "Intel® Agilex™ FPGA family, built on 10nm technology, enables customized acceleration and connectivity for a wide range of compute and bandwidth intensive applications while providing an improvement in performance and reduction in power.",
