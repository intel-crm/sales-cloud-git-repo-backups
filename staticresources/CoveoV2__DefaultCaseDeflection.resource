<[[tag]] id="search" class="CoveoSearchInterface coveo-case-deflection" data-enable-history="false" data-design="new">
  [[foldings]]
  <div class="CoveoCaseDeflection"></div>
  <div class="CoveoAnalytics"></div>

  <div class="coveo-tab-section">
    [[tabs]]
  </div>

  <div class="coveo-main-section">
    <div class="coveo-facet-column">
      [[facets]]
      <div class="CoveoDynamicFacetManager">
        [[dynamicFacets]]
      </div>
    </div>
    <div class="coveo-results-column">
      <div class="CoveoErrorReport"></div>
      <div class="CoveoResultList" data-layout="list">
        <div class="coveo-show-if-no-results">No information related to your case.</div>
        [[templates]]
      </div>
    </div>
  </div>
  <div class="CoveoPager"></div>
</[[tag]]>
