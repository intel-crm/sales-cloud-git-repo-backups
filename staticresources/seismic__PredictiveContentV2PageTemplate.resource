<apex:page standardController="[%SObjectType]" docType="html-5.0" applyHtmlTag="false" applyBodyTag="false" showHeader="false" sidebar="false" standardStylesheets="false" html-style="height:100%; width:100%;">
<head>
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta http-equiv="Content-type" content="text/html; charset=UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Seismic Content Viewer</title>

	<style type="text/css">
		BODY, HTML, IFRAME { width: 100%; height: 100%; margin: 0; padding: 0; }
	</style>
</head>
<body>
	<div style="text-align: center">
		<p>This component/feature has been retired. Please contact your administrator to update your page layouts.</p>
	</div>
</body>
</apex:page>
