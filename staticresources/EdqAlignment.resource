.slds-form-element_horizontal .slds-form-element__control, .slds-form_horizontal .slds-form-element .slds-form-element__control, .slds-form_stacked .slds-form-element_horizontal .slds-form-element__control{
    padding-left: 31% !important;
    }
    .slds-form-element .slds-form-element__label {
        font-weight: 600 !important;
        padding-top: 10px;
    }
    .slds-progress__item.slds-is-active {
        padding: 3px;
        border: 1px solid #fff;
        border-radius: 50%;
        background: #653171;
    }
    .slds-progress__item.slds-is-active .slds-progress__marker{
        box-shadow: none;
    }
    .slds-progress__marker {
        border: 1px solid #fff;
        background: #653171;
    }
    .slds-progress__item.slds-is-completed {
        background: #fff;
        border-radius: 50%;
        padding: 3px;
    }
    .slds-nav-vertical__action:focus{
        outline:auto !important;
    }

.showRequiredProducts .slds-dueling-list__column_responsive .slds-dueling-list__options{
border: 2px solid #cc0000;
}
.showRequired .slds-form-element__control{
border:2px solid #cc0000;
}
.fix-slds-input_faux[lwc-4kb6kaqheak] {
    line-height: max(2.5rem, calc(1.2em - 2px)) !important;
}