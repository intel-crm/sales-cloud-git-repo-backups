[
    {
       "title":"Tender Requests General",
       "key":"1",
       "questions":[
          {
             "question":"What is the Intel Tender Requests Project?",
             "answer":"In response to an increasingly competitive environment, driving increased tender requests, Intel has developed a tender request automation capability using a Sales CRM (Salesforce) portal, called Intel Quote Request Tool (IQR)",
             "key":"11"
          },
          {
             "question":"What is changing?",
             "answer":"We will be moving the Tender Request submissions from Excel™ to a web portal in Salesforce. Enabling visibility of status of each tender request. Providing the ability to access electronic T&Cs. Decreasing overall response / decision time through improvements to tender request process.",
             "key":"12"
          },
          {
             "question":"How am I going to be impacted by this change?",
             "answer":"For Client, Data Center Xeon CPU, Optane SSD, Optane Persistent Memory & Ethernet products only, we will require you to submit your Tender Requests through the Intel Quote Request Tool.",
             "key":"13"
          },
          {
             "question":"How will I be able to find out further information about the Tender Requests project?",
             "answer":"Further information can be gathered from your Intel Sales Representative.",
             "key":"14"
          },
          {
             "question":"I have questions about how the new process will work, who do I ask?",
             "answer":"Further information can be gathered from your Intel Sales Representative.",
             "key":"15"
          },
          {
             "question":"What are the deployment plans for the project?",
             "answer":"In 2020/21 we implemented Intel Quote Request (IQR) globally for Data Center Xeon CPUs, Optane SSDs, Optane PMem & Ethernet ECAP Tenders with huge success. 2022 focuses on expanding to Client, delivering the benefits felt both to Intel & to our Direct Customers.",
             "key":"16"
          },
          {
             "question":"How are we communicating the status of the project?",
             "answer":"Further information can be gathered from your Intel Sales Representative.",
             "key":"17"
          }
       ]
    },
    {
       "title":"Tool",
       "key":"2",
       "questions":[
          {
             "question":"How do I gain access to the Intel Quote Request Tool?",
             "answer":"Access to the Intel Quote Request Tool will be given via your Intel Sales Rep.",
             "key":"21"
          },
          {
             "question":"How do I access the T&Cs?",
             "answer":"Terms and Conditions can be found in the Quote Request form.",
             "key":"22"
          },
          {
             "question":"How do I submit a Tender Request?",
             "answer":"For Client, Data Center Xeon CPU, Optane SSD, Optane Persistent Memory & Ethernet products only, we will require you to submit your Tender Requests through the Intel Quote Request Tool. https://quoterequest.intel.com/",
             "key":"23"
          },
          {
             "question":"Where can I find the definitions of all the field names?",
             "answer":"Definitions of all the fields in the Tender Request form can be found through the use of tool tips on the IQR form and in the IQR Training site: https://www.intel.com/content/www/us/en/design/support/quote-request/training/welcome.html",
             "key":"24"
          },
          {
             "question":"Once I have submitted a request, how will I know if it has been approved or rejected?",
             "answer":"Once a tender request has been submitted through the Intel Quote Request (IQR) tool, to view the status of the request, you will be required to log into IQR and go into that request.",
             "key":"25"
          },
          {
             "question":"How will the Customers be able to see the T&Cs?",
             "answer":"Terms and Conditions can be found in the Quote Request form. You can access where T&Cs will be displayed in the training material: https://www.intel.com/content/www/us/en/design/support/quote-request/training/request-submit.html",
             "key":"26"
          },
          {
             "question":"What do the different statuses of the Tender Request mean?",
             "answer":"Status definitions can be found in the training material: https://www.intel.com/content/www/us/en/design/support/quote-request/training/review-status.html",
             "key":"27"
          },
          {
             "question":"Are there any changes for Quote Letters?",
             "answer":"There are no changes to the Quote Letter. Quote letters for each quote are stored in the Quotes Document section. If your Account / End Customer Region has been enabled, you will be notified and sent the Quote letter once the quote has been approved.",
             "key":"28"
          },
          {
             "question":"What reports are available?",
             "answer":"External customers will have multiple reports available - reporting details can be found on the training site: https://www.intel.com/content/www/us/en/design/support/quote-request/training/reporting.html",
             "key":"29"
          },
          {
             "question":"What do I do if I have an issue with the tool?",
             "answer":"If you experience an issue, you can raise your issue, through the support page.",
             "key":"210"
          },
          {
             "question":"What notifications will be sent?",
             "answer":"As an OEM, you can receive the quote letter notification and the rejection notification if the End Customer Country / Region is enabled for your account. Note. Notifications will be sent to the primary contact only.",
             "key":"211"
          },
          {
             "question":"When can we use Chatter?",
             "answer":"Chatter can be used throughout the Tender Request Process to communicate with the relevant Intel contact e.g. Pricing Manager, Intel Field",
             "key":"212"
          },
          {
             "question":"Once a Tender Request has been submitted can I change the data?",
             "answer":"When a Tender Request has been submitted for the Sales Rep to review (Status: Field Review), you will not be able to make any changes, we recommend you use Chatter to state what is needed to change.",
             "key":"213"
          },
          {
             "question":"Once the Tender Request has been approved by Intel Pricing, can I change the data specific to that quote line?",
             "answer":"Yes, you are able to submit a Change Request. Refer to the IQR Training Site for the Change Request Process (https://www.intel.com/content/www/us/en/design/support/quote-request/training/change-request.html)",
             "key":"214"
          },
          {
             "question":"Why am I getting an error clicking on the support links?",
             "answer":"To contact / raise an issue to Intel, you have to be using a email program that is installed on your laptop/PC for the links to work e.g. Microsoft Outlook. We do not support any other communication method at this time.",
             "key":"215"
          },
          {
             "question":"In the excel form there was a field called, Total Net IA Bid, where has this gone in the online IQR form?",
             "answer":"Total Bid Price will be auto calculated and will appear on the screen under the name Total Bid without discount once the quote line is submitted. You will also see another auto calculated field Net Intel Bid price, which deducts additional discount if any.",
             "key":"216"
          }
       ]
    },
    {
       "title":"Process",
       "key":"3",
       "questions":[
          {
             "question":"What is a Tender Request?",
             "answer":"“Tender Requests” refers to the process of requesting exception pricing for specific products to win a particular bid with a specific end customer.",
             "key":"31"
          },
          {
             "question":"When a Tender Request is submitted, what happens next?",
             "answer":"When a Tender Request has been submitted, this will then be set to a status of “Field Review” where the Intel Field Sales rep will either approve or deny the request. If approved, it will escalate to the Intel Pricing Manager for review and an approval decision.",
             "key":"32"
          },
          {
             "question":"When a Pricing Manager or an Intel Field Rep would like to discuss the Tender Request or require more information, how will this be done?",
             "answer":"We will be using the Chatter functionality within Salesforce as the main communication channel for each Tender Request.",
             "key":"33"
          }
       ]
    },
    {
       "title":"Change Management",
       "key":"4",
       "questions":[
          {
             "question":"How will I be trained on the new Intel Quote Request Tool?",
             "answer":"For each launch, the Tender Requests project team provided live webinars. In the event you were not able to attend, a step by step guide has been created. Refer to the Intel Quote Request Training site. https://www.intel.com/content/www/us/en/design/support/quote-request/training/welcome.html",
             "key":"41"
          }
       ]
    },
    {
       "title":"Reporting",
       "key":"5",
       "questions":[
          {
             "question":"When will the data be available for reporting?",
             "answer":"As data is being pulled from Salesforce, the data will be available real time.",
             "key":"51"
          }
       ]
    }
