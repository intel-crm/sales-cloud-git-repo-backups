.marquee-outer-container {
  background-color: #183544 !important;
}
/* .marquee-inner-container{
  padding: 2rem 2rem !important;
} */
a.slds-th__action {
  font-size: 1em;
  color: white;
  background-color: #0e63ac;
  text-decoration: none;
  transition: color 0.1s linear;
}



.slds-is-sortable .slds-th__action:hover, 
.slds-is-sortable .slds-th__action:focus, 
.slds-is-sortable.slds-has-focus .slds-th__action,
.slds-is-sortable.slds-has-focus .slds-th__action:hover, 
.slds-is-sortable.slds-has-focus .slds-th__action:focus {
color: black;
}
a.slds-has-focus.slds-is-resizable .slds-th__action, .slds-has-focus.slds-is-resizable 
.slds-th__action:focus, .slds-has-focus.slds-is-resizable .slds-th__action:hover, 
.slds-has-focus.slds-is-resizable .slds-th__action:focus:hover, 
.slds-is-resizable .slds-th__action:focus, .slds-is-resizable .slds-th__action:focus:hover{
  color: black;
}

.marketplaceTheme .h1, .marketplaceTheme h1 {
  /* font-size: 2rem; */
  font-weight: 200;
}

.button.button-arrow:after, lightning-button.button-arrow .slds-button:after{

  content: "\e8d2";
  font-family: site-global-icons;
  font-size: .6875rem;
  padding-left: 0.3rem;
  }


  .button, lightning-button .slds-button {
    border: 1px solid transparent;
    border-radius: 0px;
    color: var(--white,#fff);
    display: inline-block;
    font-size: 1rem;
    line-height: 1.25rem;
    padding: 0.625rem 1.5rem;
    transition: color .1s linear,background-color .1s linear!important;
    }
    
