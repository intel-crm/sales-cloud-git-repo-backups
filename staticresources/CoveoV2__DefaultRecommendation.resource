<div class="coveo-recommendation-column">
  <div id="recommendation" class="CoveoRecommendation" data-design="new" data-results-per-page="5" data-main-search-interface="#search">
    <div class="CoveoAnalytics"></div>
    <script class="CoveoRecommendationQuery" type="text/x-query-generic"></script>
    <div class="coveo-recommendation-header">
      <div class="CoveoText" data-value="Recommendations" data-text-align="center" data-weight="bold" data-size="14px"></div>
    </div>
    <div class="coveo-recommendation-body">
      <div class="CoveoResultList" data-wait-animation="fade">
        <script id="DefaultRecommendation" class="result-template" type="text/html">
          <div class="coveo-result-frame">
            <div class="coveo-result-frame">
              <div class="coveo-result-row">
                <div class="coveo-result-cell" style="width:40px;text-align:center;vertical-align:middle;">
                  <span class="CoveoIcon" data-small="true">
                  </span>
                </div>
                <div class="coveo-result-cell" style="padding:0 0 3px 5px;vertical-align:middle">
                  <a class="CoveoResultLink" style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                  </a>
                </div>
              </div>
            </div>
          </div>
        </script>
      </div>
    </div>
  </div>
</div>
