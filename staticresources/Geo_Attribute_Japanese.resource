{
"ParentIdentifier" :  "etm-8fac0b2757154ef2b020341aa7d5634a",
"ParentName" : 		"アジア、太平洋および日本",
"Level" : 1,
"Sequence" : "1",
"Definition" : "アジア、太平洋、および日本（APJ）は、アジア、太平洋、および日本を含む地理上の地域です。",
"Is_Active" : "Yes",
	"ChildCategories" : [
				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-28ab99b0c7854631800bdf26391b9133",		"SpecDisplayValue" : "南アジア",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "南アジア（SA）は、アジアの南部を指す地理上の地域です。",		"SpecIsActive" : "Yes"	},
				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-7af8d38326c1434b9bd0c97f6cea3566",		"SpecDisplayValue" : "東南アジア",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "東南アジア（SEA）はアジアの小地域を指し、地理的に中国より南、インドより東、オーストラリアより北に位置する国々で構成されています。これらの国には、ブルネイ、インドネシア、マレーシア、ミャンマー、フィリピン、シンガポール、タイ、東ティモール、ベトナムが含まれます。",		"SpecIsActive" : "Yes"	},
