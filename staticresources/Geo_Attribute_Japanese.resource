				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-4c16e8ebcd1f474fad386545d97b61f8",		"SpecDisplayValue" : "日本",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "日本は、日本列島を含む地理上の小地域です。",		"SpecIsActive" : "Yes"	},
				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-805939fe2787464ea19608346232c2f3",		"SpecDisplayValue" : "韓国",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "韓国は、北朝鮮と韓国の両方を含む地理上の小地域です。",		"SpecIsActive" : "Yes"	},
				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-7cc8cdf7e2f14337bab40ee9ed6644c2",		"SpecDisplayValue" : "オーストラリア、ニュージーランド",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "オーストラリアとニュージーランド（ANZ）は、オーストラリア、ニュージーランド、ハード島とマクドナルド諸島（ANZ）を含む地理上の地域です。",		"SpecIsActive" : "Yes"	},
				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-a06716d540eb434682d24f0770973c19",		"SpecDisplayValue" : "その他のアジア",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "その他のアジア（ROA）は、韓国、台湾、南アジア、東南アジアを除くアジアを指す地理上の地域です。",		"SpecIsActive" : "Yes"	},
				{	}]
