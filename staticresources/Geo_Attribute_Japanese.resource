				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-9b800fefe4964aa28d176d4868425839",		"SpecDisplayValue" : "中南米",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "ラテンアメリカ地域（LAR）は、48カ国を包括するラテンアメリカを指す地理上の地域です。",		"SpecIsActive" : "Yes"	},
				{	}]
},
{
