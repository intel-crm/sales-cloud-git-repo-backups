				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-e7fe2b5f174f48cb8662c8b4688f2920",		"SpecDisplayValue" : "中欧地域",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "中央ヨーロッパ地域（CER）は、ドイツとオーストリアを含む地理上の地域です。",		"SpecIsActive" : "Yes"	},
				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-5a45479dba2640378bdca3de5482e39f",		"SpecDisplayValue" : "中東、トルコ、アフリカ",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "中東、トルコ、およびアフリカ（META）は、トルコ、アフリカ、および中東を指す地理上の地域です。",		"SpecIsActive" : "Yes"	},
				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-2ef042557cd24adcad40e8654b56c450",		"SpecDisplayValue" : "ロシアと独立国家共同体",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "ロシアおよび独立国家共同体（RCIS）は、ロシアとソビエト連邦（RCIS）の一部であった他の国々を指す地理上の地域です。",		"SpecIsActive" : "Yes"	},
				{ "SpecKey" : "Geo_Sub_Region",		"SpecRawValue" : "etm-5019ab2f131047019faac3838e7d3348",		"SpecDisplayValue" : "北 EU 地域",		"SpecValueSequence" : "2,147,483,647",		"SpecDefinition" : "北ヨーロッパ連合地域（NEUR）は、欧州連合の北部地域を指す地理上の地域です。",		"SpecIsActive" : "Yes"	},
				{	}]
},
{
