                "TechnologyIndicatorList": {
                    "label": "Technology Indicators",
                    "value": "Intel® Run Sure Technology, Intel® Transactional Synchronization Extensions (Intel® TSX), Intel® Volume Management Device (Intel® VMD), Intel® Virtualization Technology (Intel® VT) for Directed I/O (Intel® VT-d), Intel® Virtualization Technology (Intel® VT)",
                    "rawValue": "204663, 202696, 122481, 63296, 63295"
