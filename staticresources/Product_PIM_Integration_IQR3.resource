                },
                "InstructionSetExtensions": {
                    "label": "Instruction Set Extensions",
                    "value": "Intel® AVX-512",
                    "rawValue": "Intel® AVX-512",
                    "toolTip": "Instruction Set Extensions are additional instructions which can increase performance when the same operations are performed on multiple data objects.  These can include SSE (Streaming SIMD Extensions) and AVX (Advanced Vector Extensions)."
                },
                "RunSureTechnologyVersion": {
                    "label": "Intel® Run Sure Technology",
                    "value": "Yes",
                    "rawValue": true,
                    "toolTip": "Intel® Run Sure Technology, includes advanced RAS (reliability, availability and serviceability) features that deliver high reliability and platform resiliency, to maximize uptime of servers running mission-critical workloads."
                },
                "TurboBoostMaxTechVersion": {
                    "label": "Intel® Turbo Boost Max Technology 3.0 <small><sup>‡</sup></small>",
                    "value": "No",
                    "rawValue": false,
                    "toolTip": "Intel® Turbo Boost Max Technology 3.0 identifies the best performing core(s) on a processor and provides increased performance on those cores through increasing frequency as needed by taking advantage of power and thermal headroom.",
                    "disclaimer": "Max Turbo Frequency refers to the maximum single-core processor frequency that can be achieved with Intel® Turbo Boost Technology.  See <a href=\"http://www.intel.com/technology/turboboost/\">www.intel.com/technology/turboboost/</a> for more information and applicability of this technology."
                },
                "UltraPathInterconnectLinks": {
                    "label": "Max # of UPI Links",
                    "value": "3",
                    "rawValue": 3,
                    "toolTip": "Intel® Ultra Path Interconnect (UPI) links are a high speed, point-to-point interconnect bus between the processors, delivering increased bandwidth and performance over Intel® QPI."
                },
                "AVX512FusedMultiplyAddUnits": {
                    "label": "# of AVX-512 FMA Units",
                    "value": "2",
                    "rawValue": 2,
                    "toolTip": "Intel® Advanced Vector Extensions 512 (AVX-512), new instruction set extensions, delivering ultra-wide (512-bit) vector operations capabilities, with up to 2 FMAs (Fused Multiply Add instructions), to accelerate performance for your most demanding computational tasks."
                },
                "VolumeManagementDeviceVersion": {
                    "label": "Intel® Volume Management Device (VMD)",
                    "value": "Yes",
                    "rawValue": true,
                    "toolTip": "Intel® Volume Management Device (VMD) provides a common, robust method of hot plug and LED management for NVMe-based solid state drives."
                },
                "Filter-InstructionSetExtensions": {
                    "label": "Filter-InstructionSetExtensions",
                    "value": "Intel® AVX-512",
                    "rawValue": "3533"
                },
                "PublicOrderingandComplianceFlag": {
                    "label": "Public Ordering and Compliance Flag",
                    "value": "Yes",
                    "rawValue": "Yes"
                },
                "ModeBasedExecutionControlVersion": {
                    "label": "Mode-based Execute Control (MBEC)",
                    "value": "Yes",
                    "rawValue": true,
                    "toolTip": "Mode-based Execute Control can more reliably verify and enforce the integrity of kernel level code."
                },
                "TransactionalSynchronizationExtensionVersion": {
                    "label": "Intel® Transactional Synchronization Extensions",
                    "value": "Yes",
                    "rawValue": true,
                    "toolTip": "Intel® Transactional Synchronization Extensions (Intel® TSX) are a set of instructions that add hardware transactional memory support to improve performance of multi-threaded software."
                }
