@page {
    size:landscape; /* Landscape orientation */
    margin: 1px;
} 

.row {
    display: table;
    width: 100%;
    margin-bottom: 10px;
    
    
}

.cell {
    display: table-cell;
    width: 33.33%;
    
    border: 1px solid #4a79c9;
    vertical-align: top;    
}

.custom-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #4a79c9; /* border blue */
}

.custom-table th {
    background-color: #4a79c9; /* blue header */
    color: white;
    padding: 5px;
    text-align: center;
}

.custom-table td {
    width:50%;
    padding: 5px;
    border: 1px solid #c6d4f2;
    text-align: right;
}

.custom-table2 {
    margin-top:5px;
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #4a79c9; /* border blue */
}

.custom-table2 th {
    background-color: #4a79c9; /* blue header */
    color: white;
    padding: 5px;
    text-align: center;
    border: 1px solid white;
}

.custom-table2 td {
    width:50%;
    padding: 5px;
    border: 1px solid #c6d4f2;
    text-align: right;
}


.bgcolor1 {
    background-color: #e8effc;
}

.bgcolor2 {
    background-color: #ffffff;
}