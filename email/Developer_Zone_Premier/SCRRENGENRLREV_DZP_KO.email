    <title>인텔 등록 확인</title>
    <link rel="themeData" href="English%20Intel®%20Registration%20Confirmation_files/themedata.thmx" />
    <link rel="colorSchemeMapping" href="English%20Intel®%20Registration%20Confirmation_files/colorschememapping.xml" />
    <style type="text/css"> <!--
 /* Font Definitions */
  @font-face
	{font-family:Tahoma;
	panose-1:2 11 6 4 3 5 4 4 2 4;
	mso-font-charset:0;
