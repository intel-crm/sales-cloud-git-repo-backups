<!DOCTYPE html>
<html>
<head>
	<title>Intel Resource and Design Center Registration Email Template</title>
	<meta charset="UTF-8">
	<style type ="text/css"> 
	
	
	/* IE8 COMPENSATE FOR HTML5 COMPATIBILITY */
	article, aside, figure, caption, figcaption, footer, header, main, nav, section, summary {
	display: block;
	}

	
	/* STRUCTURE */
	body {
	-webkit-text-size-adjust: none;
	background-color:#f9f9f9;
	background: url('https://tstcqcontent-ssl.cps.intel.com/etc/designs/intel/us/en/images/gradiantbg-body.png') repeat-x scroll left top #f9f9f9;
	height: 100%;      
	outline: medium none;
	}
	
	#container { /* "Container" contains all the layout code, sets page width in (pixels), and easily centers page. */
	width: 600px;  /* Good width of the vast majority of computer screens - 960px is standard because most users have 1024×768 resolution or higher */
	margin-top: 10px; /* Outside the container line */ 
	margin-right: auto; /* "auto" centers horizontally: tells the web browser to automatically calculate the space that is left over at the left and right of the #container */
	margin-bottom: 10px;
	margin-left: auto;  /* "auto" centers horizontally: tells the web browser to automatically calculate the space that is left over at the left and right of the #container */
	position: relative;  /* "relative" because using things called floats */  /* position options {"relative", "absolute"} */
	background-color: #FFFFFF;
	border-color: #E5E5E5;
	border-style: solid;
	padding: 25px 50px 0px 50px; /*top right bottom left  -- Inside the container line */ 
	border-width: 1px;
	overflow: hidden;   
	line-height: 1.5em;
	}
	
	
	hr {
	background-color: #E5E5E5;
	color:#E5E5E5;
	border: 0 none;
	height: 1px;
	}	


	img.floating {  /* image with text around it */ 
	float: right;
	padding: 4px 0px 0px 50px;  /** top right bottom left **/ 
	}


	/* TEXT STYLES */
	body {
	font-family: "Intel Clear", Verdana, Helvetica, sans-serif; 
	font-weight: normal;
	font-size: 10pt;
	color: #666666;
	}
	
	header {
	font-family: "Intel Clear Pro", Verdana, Helvetica, sans-serif;
	font-weight: normal;
	font-size: 1.1em;
	color: #003C71;
	line-height: 2em;
	}
	
	section  {
	font-size: 0.8em;	
	font-style: italic;
	color: black;
	line-height: 1.4em;
	}
	
	footer  {
	font-size: 0.9em;
	line-height: 1.4em;
	}
	
	footer a {
	text-decoration: none;
	}
	
	a {
	color: #086DB6;
	}
	
	.intelBlueTextStyle {
	color: #086DB6;
	}
	
	.subjectTextStyle {
	font-size: 1.2em;
	font-weight: bold;
	color: #086DB6;
	line-height: 1.4em;
	}
	</style>
</head>


<body>
<div id="container"><header>
<h1><span style="font-family: 'intel clear', sans-serif; color: #086db6;">Welcome to Intel Premier Support</span></h1>
</header><main><br /></main>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>Your request of Intel® Premier Support access has been entitled.</span></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span> </span></span><span></span></p>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>Click here to visit Intel® Premier Support web<span> </span></span></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>portal: </span></span><a href="https://intel--crmqa3.sandbox.my.site.com/IPS/s/"><span data-scheme-color="@0071C5,," data-usefontface="true" data-contrast="none"><span>premiersupport.intel.com</span></span></a>.</p>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span> </span></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>If you have any<span> </span></span></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>questions</span></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>, please contact us </span></span><a href="http://www.intel.com/p/en_US/support"><span data-scheme-color="@0071C5,," data-usefontface="true" data-contrast="none"><span>here</span></span></a><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>. </span></span><span></span></p>
<main><main><main><main>
<p></p>
</main></main></main></main>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>Please DO NOT reply to this e-mail message. This is an automated </span></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>response.</span></span><span></span></p>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>To ensure that you continue receiving our e-mails, please add us to<span> </span></span></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"><span>your address book. </span></span></p>
<section>
<p style="text-align: right;"></p>
</section>
<footer><span style="font-family: 'intel clear', sans-serif;"><img class="floating" src="https://www.intel.com/content/dam/logos/intel-logo.png" alt="Intel logo" height="42" width="64" /></span></footer></div>
</body>
</html>