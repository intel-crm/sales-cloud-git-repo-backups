<tr valign="top">
<td styleinsert="1" height="300" style="background-color: #ffffff; beditid: r3st1; color: #000000; blabel: main; font-size: 12pt; font-family: arial;">
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">We appreciate your interest in Intel® Premier Support.</span></span></p>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">However, upon review of your application we regret to </span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">inform you that your request of Intel Premier Support for FPGAs access </span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">has been declined. </span></span></p>
<table border="0" cellpadding="5" cellspacing="5" height="400" style="width: 550px;">
<tbody>
<tr valign="top" height="400">
<td teditid="c1r1" style="background-color: #ffffff; color: #000000; font-size: 12pt; font-family: arial; width: 546px;" aeditid="c1r1" locked="0">
<p class="MsoNoSpacing"></p>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">Some reasons for denial may include: </span></span></p>
<ol type="I">
<li data-charcodes="8226" data-font="Arial,Sans-Serif" data-buautonum="8" data-margin="270" data-aria-posinset="1" data-aria-level="1"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"> The application does not meet the company validation criteria. </span></span>
<p class="MsoNoSpacing"></p>
<ul style="font-weight: 400; list-style-type: circle;">
<li data-charcodes="8226" data-font="Arial,Sans-Serif" data-buautonum="8" data-margin="270" data-aria-posinset="3" data-aria-level="1"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">To provide you with a better support experience, please visit the Intel® FPGA Community </span><span style="color: #086db6;"><a href="https://community.intel.com/t5/FPGA/ct-p/fpga" style="color: #086db6;"><span data-scheme-color="@0071C5,," data-usefontface="true" data-contrast="none">here</span></a></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"> and the user guidance </span><span style="color: #086db6;"><a href="https://intel-my.sharepoint.com/:b:/r/personal/milly_joo_lee_yeap_intel_com/Documents/Shared Documents/psg-ips-support-org-025/intel-premier-support-org-info/Intel Community Forums Guide 2024.pdf?csf=1&web=1&e=0VKNX6" style="color: #086db6;"><span data-scheme-color="@0071C5,," data-usefontface="true" data-contrast="none">here</span></a></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"> for your next technical support inquiry. </span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"> </span></span></li>
</ul>
</li>

<li data-charcodes="8226" data-font="Arial,Sans-Serif" data-buautonum="8" data-margin="270" data-aria-posinset="2" data-aria-level="1"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">Intel Premier Support access requests do not permit </span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">the use of personal emails addresses. Please re-submit your request </span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">using your company email address. </span></span>
<p class="MsoNoSpacing"></p>
<ul style="font-weight: 400; list-style-type: circle;">
<li data-charcodes="8226" data-font="Arial,Sans-Serif" data-buautonum="8" data-margin="270" data-aria-posinset="3" data-aria-level="1"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">Register for Intel® Premier Support for Intel® FPGAs </span><span style="color: #086db6;"><a href="https://www.intel.com/content/www/us/en/support/programmable/support-resources/overview.html" style="color: #086db6;"><span data-scheme-color="@0071C5,," data-usefontface="true" data-contrast="none">here</span></a></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"> </span></span></li>
</ul>
</li>
</ol>
<p class="MsoNoSpacing"></p>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">If you have any questions, please refer other support resources and tools </span><span style="color: #086db6;"><a href="http://www.intel.com/p/en_US/support" style="color: #086db6;"><span data-scheme-color="@0071C5,," data-usefontface="true" data-contrast="none">here</span></a></span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none"> </span></span></p>
<p class="MsoNoSpacing"><span style="font-family: Arial, sans-serif;"> <o:p></o:p></span></p>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">Please DO NOT reply to this e-mail message. This is an </span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">automated response.</span></span></p>
<p data-ccp-props="{&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:2,&quot;335562767&quot;:0,&quot;335562768&quot;:2,&quot;335562769&quot;:0}"><span style="color: #666666;"><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">To ensure that you continue receiving our e-mails, please add </span><span data-scheme-color="@000000,," data-usefontface="true" data-contrast="none">us to your address book.</span></span></p>
<p class="MsoNoSpacing"><span style="font-family: Arial, sans-serif;"> </span><span style="font-family: 'intel clear', sans-serif;">                                                                                                                  <img class="floating" src="https://www.intel.com/content/dam/logos/intel-logo.png" alt="Intel logo" height="42" width="64" /></span></p>
<p class="MsoNoSpacing"><span style="font-size: 7.5pt; font-family: Arial, sans-serif;"></span></p>
<p class="MsoNoSpacing"></p>
</td>
</tr>
