<td style="background-color: #ffffff; beditid: r1st1; blabel: header; vertical-align: top; height: 96; text-align: left;"><img border="0" beditid="r1sp1" blabel="headerImage" id="r1sp1" src="https://shnintel7crm.intel.myshn.net/servlet/servlet.ImageServer?id=015o0000001vQ3m&amp;oid=00Do0000000aRcf" /></td>
