<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2">{!Case.Core_IPS_email_text__c } {!Case.CaseNumber}&nbsp;</font></b><br><font face="Arial, sans-serif" size="2"><br></font><b style="font-size: 12pt; background-color: rgb(255, 255, 255); font-family: arial;"><font face="Arial, sans-serif" size="2">To view the case please:&nbsp;<a href="https://intel--crmdevcase.cs92.my.salesforce.com/p/email/template/EmailTemplateEditorUi/{!$Label.Core_IPS_Notification_Internal_URL}/{!Case.Id}">Click Here</a>&nbsp;</font></b><br><font face="Arial, sans-serif" size="2"><b><br></b></font><span style="background-color: rgb(255, 255, 255); font-family: arial; color: rgb(127, 140, 141); font-size: 12px;">To update this Case with a comment by email use&nbsp;'</span><strong style="background-color: rgb(255, 255, 255); font-family: arial; color: rgb(127, 140, 141); font-size: 12px;">Reply</strong><span style="background-color: rgb(255, 255, 255); font-family: arial; color: rgb(127, 140, 141); font-size: 12px;">' only,&nbsp;not 'Reply All', and do not change the email subject line;&nbsp;replies to&nbsp;Closed Cases will be ignored&nbsp;as well as any&nbsp;email file attachments.</span><br><font color="#c0392b" face="Arial, sans-serif" size="2"><br></font><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Latest Case Comment Submitted By:</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">&nbsp;{!Case.Core_Last_Case_Comment_Submitter__c}&nbsp;</span><br><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!Case.Core_Last_Case_Comment__c}</span><br><div style="text-align: left;"><b style="font-size: 12pt; background-color: rgb(255, 255, 255); font-family: arial; text-align: center;"><font color="#666666" face="Arial, sans-serif" size="2">_______________________________________________________________</font></b></div><b style="font-size: 12pt; background-color: rgb(255, 255, 255); font-family: arial; text-align: center;"><div style="text-align: left;"><b style="font-size: 12pt;"><font face="Arial, sans-serif" size="2">Case Detail</font></b></div></b><font face="Arial, sans-serif" size="2"><b><br></b></font><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Subject: ")}</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Subject)}</span><b style="font-size: 12pt; background-color: rgb(255, 255, 255); font-family: arial;"><font face="Arial, sans-serif" size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Description: ")}</font></b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Issue_Description__c)}</span><br><font face="Arial, sans-serif" size="2"><b><br></b></font><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Case:&nbsp;</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!Case.CaseNumber}</span><div><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Status:</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">&nbsp;{!Case.Status}{!if(ispickval(Case.Core_Sub_Status__c,""),"",".")}{!Case.Core_Sub_Status__c}</span></div><div><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Account:&nbsp;</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!Case.Account}</span></div><div><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Contact</b><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">:&nbsp;</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!Case.Contact}</span></div><div><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Severity:&nbsp;</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!Case.Core_Severity__c}</span></div><div><font face="Arial, sans-serif" size="2" style="background-color: rgb(255, 255, 255);"><b>Project:</b>&nbsp;</font><font face="Arial, sans-serif" style="font-size: 12pt; background-color: rgb(255, 255, 255);"><font size="2">{!Case.Core_IPS_Project_Case__c}</font></font><br><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Product:&nbsp;</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!Case.Core_IPS_Product_name__c}</span></div><div><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Category</b><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">:</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">&nbsp;{!Case.Core_External_Issue_Category__c}{!IF(ISBLANK(Case.Core_External_Issue_Subcategory__c),"","&gt;")} {!Case.Core_External_Issue_Subcategory__c}</span><br><font face="Arial, sans-serif" size="2"><br></font><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Owner:</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">&nbsp;{!Case.OwnerFullName}</span></div><div><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Co-Owner:&nbsp;</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!Case.Core_Case_Co_Owner__c}</span><br><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Priority:&nbsp;</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!Case.Priority}</span></div><div><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Last Assigned Queue:</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">&nbsp;{!Case.Core_IPS_Assigned_Queue__c}</span></div><div><b style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">Organization:&nbsp;</b><span style="font-family: Arial, sans-serif; font-size: small; background-color: rgb(255, 255, 255);">{!Case.Core_Product_Organization__c}&nbsp;</span><br><div style="text-align: left;"><b style="font-size: 12pt; background-color: rgb(255, 255, 255); font-family: arial; text-align: center;"><font color="#666666" face="Arial, sans-serif" size="2">_______________________________________________________________</font></b></div><b style="color: rgb(102, 102, 102); font-family: Arial, sans-serif; font-size: small; text-align: center; background-color: rgb(255, 255, 255);"><div style="text-align: left;"><b><div style="text-align: left; display: inline !important;"><div style="font-size: 12pt; font-family: arial; color: rgb(0, 0, 0); text-align: center; display: inline !important;"><span style="font-size: 12pt;"><font face="arial" color="#666666" size="1"><b><div style="text-align: left; display: inline !important;"><span style="color: rgb(0, 0, 0); font-size: 12pt; text-align: center;"><span style="font-size: 7.5pt; font-family: Arial, sans-serif; color: rgb(102, 102, 102);">* Inline images have been removed from this email. 