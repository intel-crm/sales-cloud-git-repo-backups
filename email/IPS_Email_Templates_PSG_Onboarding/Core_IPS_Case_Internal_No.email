<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><h1 style="font-family: &quot;Times New Roman&quot;; background-color: rgb(255, 255, 255);"><span style="font-size: 14px;"><strong style="font-family: arial, helvetica, sans-serif;">{!Case.Core_IPS_email_text__c } {!Case.CaseNumber}&nbsp; &nbsp;</strong></span><span style="font-size: 14px;">&nbsp;<a href="{!$Label.Core_IPS_Notification_Internal_URL}/{!Case.Id}">Click Here</a>&nbsp;to view</span></h1></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="1"><span style="color: rgb(127, 140, 141);">To update this Case with a comment by email use&nbsp;'</span><strong style="color: rgb(127, 140, 141);">Reply</strong><span style="color: rgb(127, 140, 141);">' only,&nbsp;not 'Reply All', and do not change the email subject line;&nbsp;replies to&nbsp;Closed Cases will be ignored&nbsp;as well as any&nbsp;email file attachments.</span></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><span style="color: rgb(192, 57, 43);"><br></span></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-family: &quot;Times New Roman&quot;;"><div style="font-family: arial; background-color: rgb(255, 255, 255);"><b style="font-family: Arial, sans-serif;"><font size="2" style="">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Latest 'Public to Customers' Case Comment Submitted By: ")}</font></b><span style="font-family: Arial, sans-serif;"><font size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Last_Case_Comment_Submitter__c)}</font></span></div><div style="font-family: arial; background-color: rgb(255, 255, 255);"><span style="font-family: Arial, sans-serif;"><font size="2" style="">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Last_Case_Comment__c)}</font></span></div></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b style="text-align: center;"><font color="#666666" face="Arial, sans-serif" size="2">_______________________________________________________________</font></b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b style="text-align: center; background-color: rgb(255, 255, 255);">Case Details</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Arial, sans-serif"><b><br></b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Subject: ")}</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Subject)}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b><font face="Arial, sans-serif" size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Description: ")}</font></b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Issue_Description__c)}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Arial, sans-serif"><b><br></b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><b>Case:&nbsp;</b>{!Case.CaseNumber}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><b>Status:</b>&nbsp;{!Case.Status}{!if(ispickval(Case.Core_Sub_Status__c,""),"",".")}{!Case.Core_Sub_Status__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2" style=""><b>Account:</b>&nbsp;{!Case.core_Account_Name__c}</font></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2"><b>Contact</b></font><font style="font-size: 12pt;">:&nbsp;</font><font face="Arial, sans-serif" size="2">{!Case.Core_IPS_Supported_Contact__c}</font></div><div style="background-color: rgb(255, 255, 255);"><font size="2" face="Arial, sans-serif" style=""><b>Severity:</b> {!Case.Core_Severity__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2"><b>Project:</b>&nbsp;</font><font face="Arial, sans-serif" style="font-size: 12pt;"><font size="2">{!Case.Core_IPS_Project_Case__c}</font></font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><b>Product:&nbsp;</b>{!Case.Core_IPS_Product_name__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><b>Category</b><b>:</b>&nbsp;{!Case.Core_External_Issue_Category__c} {!IF(ISBLANK(Case.Core_External_Issue_Subcategory__c),"",">")} {!Case.Core_External_Issue_Subcategory__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><b>Owner:</b>&nbsp;{!Case.OwnerFullName}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><b>Co-Owner:&nbsp;</b>{!Case.Core_Case_Co_Owner__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><b>Priority:&nbsp;</b><span style="background-color: rgb(255, 255, 255);">{!Case.Priority}&nbsp;&nbsp;</span></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: 12pt;"><div><font face="Arial, sans-serif" size="2"><b>Last Assigned Queue:</b>&nbsp;{!Case.Core_IPS_Assigned_Queue__c}</font></div><div><div></div></div></div><div style="font-size: 12pt;"><font face="Arial, sans-serif" size="2"><b>Organization:&nbsp;</b>{!Case.Core_Product_Organization__c}&nbsp;</font></div><div style="font-size: 12pt;"><font face="Arial, sans-serif" size="2"><br></font></div><div style=""><font size="1"><span style="color: rgb(153, 153, 153); font-family: Arial, sans-serif;">Click&nbsp;</span><font face="Arial, sans-serif" style=""><a href="{!$Label.Core_IPS_Notification_External_URL}/{!Case.Id}">link</a></font><span style="color: rgb(153, 153, 153); font-family: Arial, sans-serif;">&nbsp;to external portal</span></font></div><div style="font-size: 12pt;"><b style="text-align: center;"><font color="#666666" face="Arial, sans-serif" size="2">_______________________________________________________________</font></b></div><div style="font-size: 12pt;"><b style="font-size: 10px; text-align: center; color: rgb(102, 102, 102); font-family: Arial, sans-serif;">* Inline images have been removed from this email.&nbsp; Please open in Intel® Premier Support to view all&nbsp;</b></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; text-align: center;"><font face="Arial, sans-serif" color="#666666"><div style="text-align: left;"><div style="text-align: center;"><font color="#666666"><div style="text-align: left;"><div><b style="font-size: 10px; text-align: center;">images.</b></div><div style="text-align: center;"><b style="font-size: 10px;"><br></b></div><div><b style="font-size: 10px;">This message contains Intel Confidential information and should be handled in accordance with your Non-Disclosure Agreement (NDA) with Intel. Access to this e-mail by anyone other than the intended recipient is unauthorized. If you are not the intended recipient (or responsible for delivery of the message to such person), you may not use, copy, distribute, or deliver this message or any part of its contents or take any action in reliance on it, and in such case, you should destroy this message.</b></div><div><span style="font-size: 10px; background-color: rgb(255, 255, 255);"><b>Copyright ©Intel Corporation. All rights reserved. Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054-1549 USA www.intel.com (408) 765-8080</b></span></div><div><span style="font-size: 10px; background-color: rgb(255, 255, 255);"><b><br></b></span></div></div></font></div></div></font></div></div>]]></td>
</tr>
