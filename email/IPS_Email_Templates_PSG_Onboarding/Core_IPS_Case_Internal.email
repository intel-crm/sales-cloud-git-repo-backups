<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style=""><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><h1 style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial; background-color: rgb(255, 255, 255);"><strong style="font-size: 14px; font-family: arial, helvetica, sans-serif;">{!Case.Core_IPS_email_text__c } {!Case.CaseNumber}&nbsp;&nbsp;</strong><font size="2"><font face="Arial, sans-serif"><a href="{!$Label.Core_IPS_Notification_Internal_URL}{!Case.Id}">Click Here</a>&nbsp;</font></font><span style="font-size: 14px; font-family: &quot;Times New Roman&quot;;">to view</span></h1><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font size="1" face="Arial, sans-serif" color="#999999">To update this Case with a comment by email use 'Reply' only, not 'Reply All', and do not change the email subject line; replies to Closed Cases will be ignored as well as any email file attachments. Replies will have the same visibility type as the comment below.</font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="arial"><br></font></div><div style=""><div style=""><div style=""><b style="font-size: 12pt; font-family: Arial, sans-serif; background-color: rgb(255, 255, 255);"><font size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Latest 'Public to Customers' Case Comment Submitted By: ")}</font></b><span style="color: rgb(0, 0, 0); font-family: Arial, sans-serif;"><font size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Last_Case_Comment_Submitter__c)}</font></span></div><div style=""><font size="2"><span style="font-family: Arial, sans-serif;"><font size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Last_Case_Comment__c)}</font></span></font></div></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font size="2"><b style="font-size: 12pt; text-align: center;"><font color="#666666" face="Arial, sans-serif" size="2"><br></font></b></font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font size="2"><b style="font-size: 12pt; text-align: center;"><font color="#666666" face="Arial, sans-serif" size="2">_______________________________________________________________</font></b></font></div></div></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><b style="text-align: center; background-color: rgb(255, 255, 255);">Case Details</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font size="2" face="Arial, sans-serif"><b><br></b></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Subject: ")}</b></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Subject)}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><b><font face="Arial, sans-serif" size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Description: ")}</font></b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Issue_Description__c)}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font size="2" face="Arial, sans-serif"><b><br></b></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Case:&nbsp;</b>{!Case.CaseNumber}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Status:</b>&nbsp;{!Case.Status}{!if(ispickval(Case.Core_Sub_Status__c,""),"",".")}{!Case.Core_Sub_Status__c}</font></font></div><div style=""><font size="2"><font face="Arial, sans-serif" size="2" style=""><b>Account:</b> {!Case.core_Account_Name__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Contact</b></font><font style="font-family: arial; font-size: 12pt;">:&nbsp;</font><font face="Arial, sans-serif" size="2">{!Case.Core_IPS_Supported_Contact__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Severity:&nbsp;</b><span style="background-color: rgb(255, 255, 255);">{!Case.Core_Severity__c}</span></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Project:</b>&nbsp;</font><font face="Arial, sans-serif"><font size="2">{!Case.Core_IPS_Project_Case__c}</font></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Product:&nbsp;</b>{!Case.Core_IPS_Product_name__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Category</b><b>:</b>&nbsp;{!Case.Core_External_Issue_Category__c} {!IF(ISBLANK(Case.Core_External_Issue_Subcategory__c),"",">")} {!Case.Core_External_Issue_Subcategory__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><br></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Owner:</b>&nbsp;{!Case.OwnerFullName}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Co-Owner:&nbsp;</b>{!Case.Core_Case_Co_Owner__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Priority:&nbsp;</b><span style="background-color: rgb(255, 255, 255);">{!Case.Priority}&nbsp;&nbsp;</span></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div><font size="2"><font face="Arial, sans-serif" size="2"><b>Last Assigned Queue:</b>&nbsp;{!Case.Core_IPS_Assigned_Queue__c}</font></font></div><div><div></div></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><b>Organization:&nbsp;</b>{!Case.Core_Product_Organization__c}&nbsp;</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="Arial, sans-serif" size="2"><br></font></font></div><div style=""><font size="2"><font color="#999999" face="Arial, sans-serif" size="1">Click <a href="{!$Label.Core_IPS_Notification_External_URL}/{!Case.Id}">link</a> to external portal</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><b style="text-align: center;"><font color="#666666" face="Arial, sans-serif" size="2">_______________________________________________________________</font></b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><b style="font-size: 10px; text-align: center; color: rgb(102, 102, 102); font-family: Arial, sans-serif;">* Inline images have been removed from this email.&nbsp; Please open in Intel® Premier Support to view all&nbsp;</b></font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; text-align: center;"><font size="2"><font face="Arial, sans-serif" color="#666666"><div style="text-align: left;"><div style="text-align: center;"><font color="#666666"><div style="text-align: left;"><div><b style="font-size: 10px; text-align: center;">images.</b></div><div style="text-align: center;"><b style="font-size: 10px;"><br></b></div><div><b style="font-size: 10px;">This message contains Intel Confidential information and should be handled in accordance with your Non-Disclosure Agreement (NDA) with Intel. Access to this e-mail by anyone other than the intended recipient is unauthorized. If you are not the intended recipient (or responsible for delivery of the message to such person), you may not use, copy, distribute, or deliver this message or any part of its contents or take any action in reliance on it, and in such case, you should destroy this message.</b></div><div><span style="font-size: 10px; background-color: rgb(255, 255, 255);"><b>Copyright ©Intel Corporation. All rights reserved. Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054-1549 USA www.intel.com (408) 765-8080</b></span></div><div><span style="font-size: 10px; background-color: rgb(255, 255, 255);"><b><br></b></span></div></div></font></div></div></font></font></div></div></div></div>]]></td>
</tr>
</table>