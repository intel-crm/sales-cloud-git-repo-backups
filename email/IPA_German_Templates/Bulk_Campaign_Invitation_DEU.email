                                                               <th style="line-height:24px;font-size:24px;" height="24">&nbsp;</th>
                                                            </tr>
                                                         </tbody>
                                                      </table>
                                                      <img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{9fe13c0f-6051-4353-9666-41b69885ff6c}_hero_%281%29.jpg" alt="" class="responsive" style="display:block;height:210px;width:210px;" height="210" valign="top" width="210">
                                                   </th>
                                                   <th class="small-12 columns" style="background:#000000;width:310px;" valign="middle">
                                                      <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" class="collapse" width="100%">
                                                         <tbody>
                                                            <tr>
                                                               <th class="small-12 columns pad-bottom-24 pad-top-24" style="padding:0;padding-bottom:32px;padding-top:32px;padding-left:36px;padding-right:36px;">
                                                                  <h1 style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:24px;font-weight:400;hyphens:none;line-height:30px;margin:0;margin-bottom:24.5px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Profitieren Sie neben den Vorzügen der Developer Zone Premier von weiteren Vorteilen!</h1>
                                                                  <!-- OPTIONAL NON-BUTTON LINK - UNCOMMENT TO USE <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> <a href="https://www.intel.com" target="_blank" style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;text-decoration:none;"><span style="text-decoration:underline;">Call to action</span><img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{0230aada-0914-45c2-8d44-ea2c5ae34e04}_arrow_email_white.png" valign="middle" alt=""></a> </p> -->
                                                                  <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                                                     <tr>
                                                                        <th style="min-width:200px;">
                                                                           <!-- START BUTTON -->
                                                                           <table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" width="auto">
                                                                              <tbody>
                                                                                 <tr>
                                                                                    <th style="background:#ffffff;padding:10px 24px 10px 24px;"><a href="https://www.intel.com/content/www/de/de/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#006ABB;display:block;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Werden Sie Teil der<br>Intel&reg; Partner Alliance<img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{d10a0171-9566-461e-b39d-83894db2af31}_arrow_email_blue.png" valign="middle" alt=""></a></th>
                                                                                 </tr>
                                                                              </tbody>
                                                                           </table>
                                                                           <!-- END BUTTON -->
                                                                        </th>
                                                                     </tr>
                                                                  </table>
                                                               </th>
                                                            </tr>
                                                         </tbody>
                                                      </table>
                                                   </th>
                                                </tr>
                                             </table>
                                          </th>
                                       </tr>
                                    </tbody>
                                 </table>
                                 <!-- END HEADER --> <!-- START ACCOUNT INFO -->
                                 <table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" width="100%">
                                    <tbody>
                                       <tr>
                                          <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-top:48px;width:510px;">
                                             <table role="presentation" border="0" cellspacing="0" cellpadding="0" class="collapse" valign="top" width="100%">
                                                <tbody>
                                                   <tr>
                                                      <th class="small-12 columns" style="text-align:left;width:255px">
                                                         <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:0px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Vorname: {!Contact.FirstName} </p>
                                                         <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:0px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Nachname: {!Contact.LastName}</p>
                                                         <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:0px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Benutzername (E-Mail-Adresse): {!Contact.Email}</p>
                                                      </th>
                                                   </tr>
                                                </tbody>
                                             </table>
                                             <!-- START SPACER -->
                                             <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                                <tbody>
                                                   <tr>
                                                      <th style="font-size:32px;line-height:32px;width:100%" height="32"></th>
                                                   </tr>
                                                </tbody>
                                             </table>
                                             <!-- END SPACER -->
                                          </th>
                                       </tr>
                                    </tbody>
                                 </table>
                                 <!-- END ACCOUNT INFO --> <!-- START LEFT ALIGNED CONTENT -->
                                 <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                    <tbody>
                                       <tr>
                                          <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:24px;width:510px;">
                                             <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Die Berechtigung der Developer Zone Premier ermöglicht den Zugang zu vertraulichen Ressourcen und sicheren Inhalten von Intel und ist jetzt ein Vorteil der Intel&reg;&nbsp;Partner Alliance. Als geschätzter Nutzer der Developer Zone Premier sind Sie jetzt berechtigt, dem Intel&reg;&nbsp;Partner Alliance-Programm beizutreten.</p>
                                             <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Ihr Unternehmen ist bereits ein geschätztes Mitglied der Intel&reg;&nbsp;Partner Alliance. Dies ist eine Möglichkeit für Sie, sich Ihren Kollegen anzuschließen, die bereits am Programm teilnehmen, und Zugang zu exklusiven, hochgeschätzten Vorteilen zu erhalten. Ein paar Beispiele:</p>
                                             <ul style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;text-align:left;word-break:keep-all;word-wrap:none">
                                                <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">Sie erhalten Zugang zu über 800 erstklassigen Kursen und mehr als 30&nbsp;Kompetenzen und Zertifizierungen, Einblicke in die Branche und Geschäftsprognosen&nbsp;– wertvolles Wissen dank der <strong>Intel&reg;&nbsp;Partner University</strong>.</li>
                                                <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">Sammeln Sie <strong>Prämienpunkte</strong> durch qualifizierende Intel Käufe und geschäftsfördernde Aktivitäten. Lösen Sie Prämienpunkte für wertvolle Geschäftszwecke ein.</li>
                                                <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">Speziell zusammengestellte, branchenspezifische und aufgabenorientierte <strong>Aktivierungszonen</strong> mit den Ressourcen, um Produkte und Lösungen basierend auf Intel&reg;&nbsp;Technik zu entwickeln, zu vermarkten und zu verkaufen.</li>
                                                <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">Bewerben Sie Ihre Lösungen in unserem <strong>Intel&reg;&nbsp;Partner Showcase</strong> über Ihre personalisierte Ladenfront, um sich mit Tausenden von Partnern und Ihren Endkunden im gesamten Technologieumfeld zu verbinden.</li>
                                             </ul>
                                             <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin-top:20px;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Wenn Sie sich jetzt als Ansprechpartner anmelden, erhalten Sie 100&nbsp;Prämienpunkte* für Ihr Unternehmen und können direkt von sämtlichen Vorteilen der Intel&reg;&nbsp;Partner Alliance und der Developer Zone Premier profitieren.</p>
                                             <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Führen Sie diese kurzen und einfachen Schritte aus:</p>
                                             <ol style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;text-align:left;word-break:normal;word-wrap:normal">
                                                <li style="margin-bottom:20px;">Klicken Sie auf <a href="https://www.intel.com/content/www/de/de/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:underline;word-break:keep-all;word-wrap:none">Jetzt teilnehmen</a> und folgen Sie den Anweisungen**, um sich mit dem Konto Ihres Unternehmens zu verbinden.</li>
                                                <li style="margin-bottom:20px;">Nach der Bestätigung erhalten Sie eine E-Mail, um sich bei der Intel&reg;&nbsp;Partner Alliance anzumelden.</li>
                                             </ol>
                                             <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Entdecken Sie alle Vorteile des Programms. Werden Sie jetzt Teil der Intel&reg;&nbsp;Partner Alliance.</p>
                                             <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" valign="top" width="100%">
                                                <tbody>
                                                   <tr>
                                                      <th style="padding-top:32px;">
                                                         <!-- START BUTTON -->
                                                         <table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" valign="top" width="auto">
                                                            <tbody>
                                                               <tr>
                                                                  <th style="background:#00C7FD ;padding:10px 24px 10px 24px;"><a href="https://www.intel.com/content/www/de/de/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#262626;display:block;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Jetzt teilnehmen<img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{3c6395e2-a99d-4d56-af68-36b36f3ef629}_arrow_email_black.png" valign="middle" alt=""></a></th>
                                                               </tr>
                                                            </tbody>
                                                         </table>
                                                         <!-- END BUTTON -->
                                                      </th>
                                                   </tr>
                                                </tbody>
                                             </table>
                                             <br>
                                             <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-top:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Benötigen Sie Hilfe bei der Registrierung als Partner? <a href="https://www.intel.com/content/www/de/de/support.html?elqTrackId=e8aebb5fa57546dab808d4902c25087c&elqTrack=true" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:underline;word-break:keep-all;word-wrap:none">Support kontaktieren</a>.</p>
                                             <br>
                                             <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:24px;margin:0;padding:0;text-align:left;word-break:keep-all;word-wrap:none">*Muss für Prämienpunkte qualifiziert sein. Siehe Zulassungsbedingungen.</p>
                                             <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:24px;margin-top:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none"><a href="https://www.intel.com/content/www/de/de/support/articles/000092340/programs/access-entitlement-for-myintel-users.html?wapkw=azure%20mfa%20help&elqTrackId=0f654af1184b4c4a9c97cb0ecda4c3c0&elqTrack=true" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">*<u>Hilfe für Azure Multi-Faktor-Authentifizierung (MFA)</u></a></p>
                                          </th>
                                       </tr>
                                    </tbody>
                                 </table>
                                 <!-- END LEFT ALIGNED CONTENT --> <!-- START IPA SOCIAL RIBBON - UPDATE THE BACKGROUND COLOR ON THE BLADE BY CHANGING THIS TABLE BACKGROUND -->
                                 <table role="presentation" align="center" bgcolor="#0095CA" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                    <tbody>
                                       <tr>
                                          <th>
                                             <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" valign="middle" width="100%">
                                                <tbody>
                                                   <tr>
                                                      <th align="center" style="padding:10px;">
                                                         <div style="vertical-align: middle"><img alt="" height="30" src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{04d8272d-eac1-4a18-8060-873796cf5819}_icon_ipa_linkedin.png" style="display:inline-block;vertical-align:middle;" valign="middle" width="39" /> <a href="https://www.linkedin.com/groups/2965079/?elqTrackId=37baac48d4f24cba9407883e64b74cee&elqTrack=true" style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:30px;font-weight:400;text-decoration:none;" target="_blank">Werden Sie Mitglied der Intel&reg;&nbsp;Partner Alliance Gruppe auf <span style="text-decoration:underline">LinkedIn</span></a><img alt="" src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{0230aada-0914-45c2-8d44-ea2c5ae34e04}_arrow_email_white.png" style="display:inline-block;vertical-align:middle;" valign="middle" /></div>
                                                      </th>
                                                   </tr>
                                                </tbody>
                                             </table>
