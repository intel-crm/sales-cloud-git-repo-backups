<messaging:emailTemplate subject="{!relatedTo.Name} - {!relatedTo.Core_Executive_Meeting_Brief_Name__c} - Ready for Review"  recipientType="User" relatedToType="Executive_Meeting_Brief__c" >
<messaging:htmlEmailBody >
 <table style="background-color: #0071c5;" width="100%">
   <tbody>
    <tr>
      <td style="padding-left: 50px; border: none;">
        <div style="color: white;">
           <h3> {!relatedTo.Name} - {!relatedTo.Core_Executive_Meeting_Brief_Name__c} - Ready for Review</h3>
         </div>
        </td>
        <td style="border: none; padding-right: 20px;" align="right">
       <apex:image url="{!$Label.CRM_IntelLogo}" width="100" height="80" /> 
        </td>
        </tr>
        </tbody>
 </table>
<p>Hello {!relatedTo.CRM_Brief_Reviewer__r.Name},</p>

<p>The executive brief for {!relatedTo.Core_Executive_Meeting_Brief_Name__c} on&nbsp;
<apex:outputField value="{!relatedTo.CRM_Start_Date__c}" />&nbsp;
<apex:outputField value="{!relatedTo.CRM_Start_Time__c}" />&nbsp;
{!relatedTo.CRM_Time_Zone__c} for {!relatedTo.Account__r.Name} has been drafted and is now ready for your review.</p>

<p>The generated PDF document is attached to this email. Please review the document and share any
updates or approvals as needed: <br/>
        {!relatedTo.CRM_PDF_URL__c}

       <br /></p>
       
       Thank you for your time and support in finalizing this brief.<br /><br />
       
 <p>Sales Excellence</p>
     </messaging:htmlEmailBody>
</messaging:emailTemplate>