<messaging:emailTemplate subject="{!relatedTo.Name}-{!relatedTo.Core_Executive_Meeting_Brief_Name__c}" relatedToType="Executive_Meeting_Brief__c">
<messaging:htmlEmailBody >
 <table style="background-color: #0071c5;" width="100%">
   <tbody>
    <tr>
      <td style="padding-left: 50px; border: none;">
        <div style="color: white;">
           <h3> {!relatedTo.Name} - {!relatedTo.Core_Executive_Meeting_Brief_Name__c} </h3>
         </div>
        </td>
        <td style="border: none; padding-right: 20px;" align="right">
        <apex:image url="{!$Label.CRM_IntelLogo}" width="100" height="80" /> 
        </td>
        </tr>
        </tbody>
 </table>
<p>Hello,</p>

<p>The executive brief required for {!relatedTo.Core_Executive_Meeting_Brief_Name__c} on&nbsp;
<apex:outputField value="{!relatedTo.CRM_Start_Date__c}" />&nbsp;
<apex:outputField value="{!relatedTo.CRM_Start_Time__c}" />&nbsp;
{!relatedTo.CRM_Time_Zone__c} for {!relatedTo.Account__r.Name} has been completed. </p><br/>

       <p>The finalized PDF document is attached to this email. You may also access it directly in Salesforce via the following link:<br/>
        {!relatedTo.CRM_PDF_URL__c}

      <br /><br /></p>

<p>SMG Sales Excellence</p>
     </messaging:htmlEmailBody>
</messaging:emailTemplate>