<messaging:emailTemplate subject="Notification: You Have Been Added to an Opportunity Team" recipientType="User" relatedToType="opportunityteammember">   <messaging:htmlEmailBody >   <font face="arial" size="2.5">       <img src="https://{!$Label.core_Domain_URL}/servlet/servlet.ImageServer?id=0151J000002ZLNd&oid=00Do0000000aRcf" height="90" width="600"/>    <br></br>   <big><br>You have been added to the Team for the following Opportunity:</br>       <br><b>Opportunity Name:</b> {!relatedTo.Opportunity.Name}</br>  <br><b>Account Name:</b> {!relatedTo.Opportunity.Account.Name}</br>  <br><b>Decision Date: </b> <apex:outputText value="{0,date,MM'/'dd'/'yyyy}"> <apex:param value="{!relatedTo.Opportunity.CloseDate}" /> </apex:outputText></br>      <br><b>Stage:</b> {!relatedTo.Opportunity.StageName}</br>         <br><b>Member Role:</b> {!relatedTo.TeamMemberRole}</br>    <br><b>Access Level:</b> {!relatedTo.OpportunityAccessLevel}</br>    <br>Click <a href ="https://{!$Label.core_Domain_URL}/{!relatedTo.Opportunity.Id}"><b>HERE</b></a>&nbsp;to go directly to this Opporunity in Sales CRM.</br></big>    <br></br>    <br></br>    <br></br>    <font size="1" color="#A9A9A9">     <p>     This message contains Intel Confidential information and should be handled in accordance with your Non-<br></br>     Disclosure Agreement (NDA) with Intel. Access to this e-mail by anyone other than the intended recipient is<br></br>     unauthorized. If you are not the intended recipient (or responsible for delivery of the message to such person), you<br></br>     may not use, copy, distribute, or deliver this message or any part of its contents or take any action in reliance on it,<br></br>     and in such case, you should destroy this message.</p>         Copyright ©Intel Corporation. All rights reserved. Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145,<br></br>      Santa Clara, CA95054-1549 USA <a href="http://www.intel.com/">www.intel.com</a> (408) 765-8080    </font>    </font>    </messaging:htmlEmailBody></messaging:emailTemplate>