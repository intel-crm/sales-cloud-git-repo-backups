<messaging:emailTemplate subject="{!'Assigned Opportunity Support Request ('+IF(relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_CSA_RecordType' ,'CSA',IF(relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_TSS_Request', LEFT(relatedTo.Core_Opportunity_Support__r.Core_TSS_Support_Type__c, LEN(relatedTo.Core_Opportunity_Support__r.Core_TSS_Support_Type__c) - 8),IF(relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_Center_of_Excellence_Request','COE','')))+') :' +relatedTo.Core_Opportunity_Support__r.Opportunity__r.Account.Name+'-'+relatedTo.Core_Opportunity_Support__r.Opportunity__r.name}" recipientType="User" relatedToType="Core_Opportunity_Support_Team__c">
<messaging:htmlEmailBody >
 <table style="background-color: #0071c5;" width="100%">
   <tbody>
    <tr>
      <td style="padding-left: 50px; border: none;">
        <div style="color: white;">
          <h1>Assigned Opportunity Support Request <apex:outputPanel rendered="{!relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_CSA_RecordType'}">
            CSA
            </apex:outputPanel>
           <apex:outputPanel rendered="{!relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_TSS_Request'}">
            {!LEFT(relatedTo.Core_Opportunity_Support__r.Core_TSS_Support_Type__c, LEN(relatedTo.Core_Opportunity_Support__r.Core_TSS_Support_Type__c) - 8)}
            </apex:outputPanel>
           <apex:outputPanel rendered="{!relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_Center_of_Excellence_Request'}">
           COE
           </apex:outputPanel></h1>
         </div>
        </td>
        <td style="border: none; padding-right: 20px;" align="right">
        <apex:image url="https://intel--c.na104.content.force.com/servlet/servlet.ImageServer?id=0153b000004Pg4i&amp;oid=00Do0000000aRcf" /> 
        </td>
        </tr>
        </tbody>
 </table>
 
  
  <table style="font-family:intel clear;border: 1px solid #d3d3d3;padding-left:50px;padding-top:5px;padding-bottom:5px;font-size: 14px;" width="100%">
  <tr>
    <td>
     Dear <apex:outputPanel rendered="{!relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_CSA_RecordType'}">
            CSA ,
            </apex:outputPanel>
           <apex:outputPanel rendered="{!relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_TSS_Request'}">
            TSS ,
            </apex:outputPanel>
           <apex:outputPanel rendered="{!relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_Center_of_Excellence_Request'}">
           COE ,
           </apex:outputPanel> <br/><br/>
     You have been assigned to support the Opportunity below. Please Accept or Reject the assignment by clicking the link to the Opportunity Support Request below. 
     <br/>
     <br/>
     </td>
    </tr> 
  </table>
   <table style="border: 1px solid #d3d3d3;font-size: 14px;font-family:intel clear;padding-left:50px" width="100%">
  <tr>
    <td>
       <p>
       <a href="{!LEFT($Api.Partner_Server_URL_290,FIND('services',$Api.Partner_Server_URL_290)-1)}" style="font-size: 14px"> Click Here</a>

       to see additional information on this Opportunity Support Request.<br /><br /></p>
     </td>
    </tr> 
   
  </table>
  
    <table style="border: 1px solid #d3d3d3;padding-left:50px;padding-top:5px;padding-bottom:5px;font-size: 20px;" width="100%">
  <tr>
    <td>
    Opportunity  Information
     </td>
    </tr> 
  </table>
  
   
   <table style="font-family:intel clear;border: 1px solid #d3d3d3;padding-left:50px;padding-top:5px;padding-bottom:5px;font-size: 14px;" width="100%">
     <tbody>
   <tr>
    <td style="font-family:intel clear;" width="40%">Account Name : {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Account.Name}</td>
    <td style="font-family:intel clear;" width="40%"> Opportunity Name : {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Name}</td>
   </tr>
   
   <tr>
     <td style="font-family:intel clear;" width="40%">Stage : {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.StageName}</td>
     <td style="font-family:intel clear;" width="40%"> Decision Date : 
     <apex:outputText value="{0, date, d'/'MM'/'yyyy}">
     <apex:param value="{!relatedTo.Core_Opportunity_Support__r.Opportunity__r.CloseDate}" /> 
     </apex:outputText></td>
   </tr>
   
   <tr>
     <td style="font-family:intel clear;" width="40%">SalesGroup : {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Core_Sales_Groups__c}</td>
     <td style="font-family:intel clear;" width="40%"> Opportunity Type : {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Core_Opportunity_Type__c}</td>
   </tr>
   
    <tr>
     <td style="font-family:intel clear;" width="40%">Opportunity Owner :  {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Owner.Name}</td>
     <td style="font-family:intel clear;" width="40%"> Product Segment :  {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Core_Product_Segment__c}</td>
   </tr>
   
    <tr>
     <td style="font-family:intel clear;" width="40%">Technical Owner :  {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Core_Technical_Owner__r.Name}</td>
     <td style="font-family:intel clear;" width="40%"> Product Application :  {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Core_Product_Application__c}</td>
   </tr>
    <tr>
     <td style="font-family:intel clear;" width="40%">Amount : {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Amount}</td>
     <td style="font-family:intel clear;" width="40%"> Vertical Market : {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Core_Consumption_Market__c}</td>
   </tr>
   
   <tr>
     <td style="font-family:intel clear;" width="40%">Competitive Architecture: {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Core_Competitive_Architecture__c}</td>
     <td style="font-family:intel clear;" width="40%"> Probability(%) : {!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Probability}</td>
   </tr>
   </tbody>
   </table>
   <c:Core_oppty_fetchLineItems opportunityIDForController="{!relatedTo.Core_Opportunity_Support__r.Opportunity__r.Id}"/>

    <table style="border: 1px solid #d3d3d3;padding-left:50px;padding-top:5px;padding-bottom:5px;font-size: 20px;" width="100%">
  <tr>
    <td>
    Opportunity Support Request Details
     </td>
    </tr> 
  </table> 
      
      <table style="border-collapse: seperate;font-family:intel clear;border: 1px solid #d3d3d3;padding-left:50px;padding-top:5px;padding-bottom:5px;font-size: 14px;" width="100%">

     <tbody>
    
            <apex:outputPanel rendered="{!relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_TSS_Request'}">

    <tr>
        <td style="border: 1px solid #cecfd5;width:10%;" width="30%">TSS Support Type</td>
        <td style="border: 1px solid #cecfd5;width:25%;"  width="70%">{!relatedTo.Core_Opportunity_Support__r.Core_TSS_Support_Type__c}</td>
    </tr>

    </apex:outputPanel>
     <tr>
      <td style="border: 1px solid #cecfd5;width:10%;" width="30%">Requestor </td> 
      <td style="border: 1px solid #cecfd5;width:25%;"  width="70%">{!relatedTo.Core_Opportunity_Support__r.CreatedBy.Name}</td>
     </tr>
     <tr>
      <td style="border: 1px solid #cecfd5;width:5%;"> Opportunity Description </td>
      <td style="border: 1px solid #cecfd5;width:15%;">{!relatedTo.Core_Opportunity_Support__r.Core_Opportunity_Description__c}</td>
     </tr>
     <apex:outputPanel rendered="{!relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName != 'Core_Center_of_Excellence_Request'}">
     <tr>
      <td style="border: 1px solid #cecfd5;width:12%;"> Primary Blockers </td>
      <td style="border: 1px solid #cecfd5;width:15%;">{!relatedTo.Core_Opportunity_Support__r.Core_PrimaryBlockers__c}</td>
     </tr>
     <tr>
      <td style="border: 1px solid #cecfd5;width:15%;"> Additional Support Needed </td>
      <td style="border: 1px solid #cecfd5;width:15%;">{!relatedTo.Core_Opportunity_Support__r.Core_Additional_Support_Needed__c}</td>
     </tr>
     <tr>
      <td style="border: 1px solid #cecfd5;width:15%;"> Background Information on Current Architecture </td>
      <td style="border: 1px solid #cecfd5;width:15%;">{!relatedTo.Core_Opportunity_Support__r.Core_background_info_on_architecture__c}</td>
     </tr>
     </apex:outputPanel>
      <apex:outputPanel rendered="{!relatedTo.Core_Opportunity_Support__r.RecordType.DeveloperName = 'Core_Center_of_Excellence_Request'}">
      <tr>
      <td style="border: 1px solid #cecfd5;width:15%;"> Center of Excellence </td>
      <td style="border: 1px solid #cecfd5;width:15%;">{!relatedTo.Core_Opportunity_Support__r.Center_of_Excellence__c}</td>
     </tr>
     <tr>
      <td style="border: 1px solid #cecfd5;width:15%;"> CoE Request Detail </td>
      <td style="border: 1px solid #cecfd5;width:15%;">{!relatedTo.Core_Opportunity_Support__r.Core_CoE_Request_Detail__c}</td>
     </tr>
      </apex:outputPanel>
  </tbody>    
     
</table>
  
     
    <table style="border: 1px solid #d3d3d3;padding-left:50px;padding-top:5px;padding-bottom:5px;font-size: 20px;" width="100%">
      <tr>
    <td>
    
     <p style="text-align: center;font-size: 12px;">This message was sent to you as an important business communication related to your current relationship with Intel Corporation<br/>&copy;
 {! YEAR( TODAY() )} Intel Corporation<br />
 Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054 USA.<br/>
 <a href="http://www.intel.com">www.intel.com</a><br/>
 <a href="http://www.intel.com/privacy">Privacy</a> | <a href="http://www.intel.com/cookies">Cookies</a></p>
 
      </td>
     </tr>
     </table>
     
    
</messaging:htmlEmailBody>
</messaging:emailTemplate>