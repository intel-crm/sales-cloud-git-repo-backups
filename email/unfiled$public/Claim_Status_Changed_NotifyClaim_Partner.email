<messaging:emailTemplate subject="Claim Case Score for Claim {!relatedTo.Core_MDF_Claim_Ref_Number__c} is {!FLOOR(relatedTo.Core_MDF_Claim_Review_Case__r.Core_MDF_Scorecard_Score_Nbr__c)}" 
                         recipientType="User" 
                         relatedToType="PartnerFundClaim"
                         language="{!relatedTo.createdby.LanguageLocaleKey}" renderUsingSystemContextWithoutSharing="True">
    <messaging:htmlEmailBody >
        <html>
            <body>
                <div style="font-size:14px;font-family:Calibri"> 
                
                 
                    <p>{!$Label.Core_MDF_ClaimNumber}: 
                        <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner',true,false)}"
                            value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}">&nbsp;{!relatedTo.Core_MDF_Claim_Ref_Number__c} 
                        </apex:outputLink>
                        <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Owner_UserType_Txt__c != 'PowerPartner',true,false)}"
                             value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">&nbsp;{!relatedTo.Core_MDF_Claim_Ref_Number__c}
                        </apex:outputLink>   
                    </p>
                    <!--<li>{!$Label.Core_MDF_ClaimNumber} : <a href="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}"> {!relatedTo.Core_MDF_Claim_Ref_Number__c}</a></li><br/> -->
                
                    <p>{!$Label.Core_MDF_ClaimName}: {!relatedTo.Title}</p>
                  
                    <p>{!$Label.Core_MDF_Case_Cancelled_Body_CaseField}: 
                    <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Core_MDF_Claim_Review_Case__r.Id}">&nbsp;{!relatedTo.Core_MDF_Claim_Review_Case__r.CaseNumber} 
                    </apex:outputLink>
                    <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Owner_UserType_Txt__c != 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Core_MDF_Claim_Review_Case__r.Id}">&nbsp;{!relatedTo.Core_MDF_Claim_Review_Case__r.CaseNumber} 
                    </apex:outputLink>
                    </p>
                    <!-- <li>{!$Label.Core_MDF_Case_Cancelled_Body_CaseField} : <a href="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Core_MDF_Claim_Review_Case__r.Id}"> {!relatedTo.Core_MDF_Claim_Ref_Number__c}</a></li><br/> -->
                
                    <p>{!$Label.Core_MDF_Case_Score}: {!FLOOR(relatedTo.Core_MDF_Claim_Review_Case__r.Core_MDF_Scorecard_Score_Nbr__c)}</p>
                
                    <p>{!$Label.Core_MDF_Manual_Recovery}: {!FLOOR(relatedTo.Core_MDF_Claim_Review_Case__r.Core_MDF_Manual_Recovery_Amount_USD_Amt__c)}</p>
                    
                    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                    <p>{!$Label.Core_MDF_Email_Signature}</p> 
                </div>
                
                
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>