<messaging:emailTemplate subject="{!$Label.Core_MDF_ClaimNumber}{!RelatedTo.Core_MDF_Claim_Ref_Number__c} {!IF(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c, $Label.Core_MDF_ScreeningPassedEmailSub, $Label.Core_MDF_Set_To_PaymentDue)}" 
                                 recipientType="User"
                                 relatedToType="PartnerFundClaim"
                                 renderUsingSystemContextWithoutSharing="True"
                                 language="{!RelatedTo.Core_MDF_Owner_Language_Locale_Key_txt__c}">
<messaging:htmlEmailBody >
    <html>
        <body>
                <div style="font-size:14px;font-family:Calibri">              
                    <p>
                        {!IF(RelatedTo.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner', 
                              $Label.Core_MDF_EmailTemp_DearIntelPartner, 
                              IF(RelatedTo.Core_MDF_Owner_UserType_Txt__c == 'Standard', 
                                 $Label.Core_MDF_EmailTemp_DearIntelemployee, 
                                  ''))}<br/>
                    </p>
                    <p>{!IF(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c, $Label.Core_MDF_ScreeningPassedEmailBody, $Label.Core_MDF_PICPassEmailBody)}<br/></p>
                    <ul>
                    <li>{!$Label.Core_MDF_ClaimNumber}&nbsp;:&nbsp;  
                         <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner',true,false)}"
                            value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}">{!relatedTo.Core_MDF_Claim_Ref_Number__c}
                         </apex:outputLink>
                         <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Owner_UserType_Txt__c=='Standard',true,false)}"
                             value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">{!relatedTo.Core_MDF_Claim_Ref_Number__c}
                        </apex:outputLink>   
                    </li>
                    <li>{!IF(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c,$Label.Core_MDF_OutcomeBasedCampaign_Name & ' :',$Label.Core_MDF_EmailTemp_Claim_Activity_Name)}&nbsp;{!RelatedTo.Request.Title}<br/></li>
                    <apex:outputPanel rendered="{!NOT(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c)}">
                        <li>{!$Label.Core_MDF_EmailTemp_Activity_Type}&nbsp;{!RelatedTo.Core_MDF_Activity_Types__c}<br/></li>
                    </apex:outputPanel>
                    <li>{!IF(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c,$Label.Core_MDF_OutcomeBasedCampaign_StartDate,$Label.Core_MDF_Activity_Start_Date)}&nbsp;:
                    <apex:outputText value="{0, date, MMMM d','  yyyy}">
                        <apex:param value="{!RelatedTo.Core_MDF_Activity_Start_Date__c}"/>
                    </apex:outputText><br/></li>
                    <li>{!IF(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c,$Label.Core_MDF_OutcomeBasedCampaign_EndDate,$Label.Core_MDF_Activity_End_Date)}&nbsp;:
                    <apex:outputText value="{0, date, MMMM d','  yyyy}">
                        <apex:param value="{!RelatedTo.Core_MDF_Activity_End_Date__c}"/>
                    </apex:outputText><br/></li>
                    <li>{!$Label.Core_MDF_EmailTemp_Claim_Country}&nbsp;{!RelatedTo.Core_MDF_Country_Location_nm__c}<br/></li>
                    <li>{!$Label.Core_MDF_EmailTemp_Program}&nbsp;{!RelatedTo.Core_MDF_Program__c}<br/></li>
                    <apex:outputPanel rendered="{!IF(RelatedTo.Core_MDF_Budget_Type_Options_Nm__c != null,true,false)}">
                    <li>{!$Label.Core_MDF_EmailTemp_Budget_Type}&nbsp;{!RelatedTo.Core_MDF_Budget_Type_Options_Nm__c}<br/></li>                                                    
                    </apex:outputPanel>
                    </ul>
                    <p> 
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}<br/><br/>
                        {!$Label.Core_MDF_Email_Signature}<br/>                       
                    </p>
                        <img src="https://intel.file.force.com/servlet/servlet.ImageServer?id=015Ho000003gyPd&oid=00Do0000000aRcf&lastMod=1720070041000" alt="Intel Logo" width="120" height="48"> </img>
                  </div>
                  <div style="font-size:11px;font-family:Calibri">
                                   <p>
                                     <i>  {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                                           <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/></i>
                                            {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                                           {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                            </p>         
                    
                    </div> 
        </body>
     </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>