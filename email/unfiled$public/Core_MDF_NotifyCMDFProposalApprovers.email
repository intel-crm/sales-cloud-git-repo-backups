<messaging:emailTemplate renderUsingSystemContextWithoutSharing="true"
                         subject="Proposal Status Updated"    
                         relatedToType="Campaign">
<messaging:htmlEmailBody >
<html>
<body>
     <p> <span style="color: #ff0000;"><strong>Action Required</strong></span></p>
     <p>Dear Intel employee,</p>
     <p>The following activity has been submitted and requires Intel review:</p>
        <p><span>&nbsp; &nbsp; &nbsp; Member Name:</span> {!relatedTo.Core_MDF_Account__r.Name}</p>
        <p>&nbsp; &nbsp; &nbsp; Proposal Name: {!relatedTo.Name}</p>
        <p>&nbsp; &nbsp; &nbsp; Status History:&nbsp;{!relatedTo.Status}</p>
        <p><span>&nbsp; &nbsp; &nbsp; Countries/locations:&nbsp;{!relatedTo.Core_MDF_Market__c}</span></p>
     <p>{!relatedTo.CreatedBy.Name}&nbsp;has requested your approval for the following item:<span>&nbsp;</span></p>
     <p><apex:outputLink value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">Click here                    
      </apex:outputLink></p>
      <p>Please click this link to approve or reject this record.</p>
      <p></p>
      <p>Thank you,</p>
      <!--<p>Channel Marketing Fund Program Team</p>-->
      <p>{!$Label.Core_MDF_Email_Signature}</p> 
      <div style="font-family: Calibri;font-size: 12px;">
      <p><em>Messages to this mailbox are not monitored.</em>&nbsp;<em>Contact&nbsp;<strong><a href="https://intelinside.intel.com/Support?AppSignOn=Yes">customer service</a>&nbsp;</strong>if you have additional questions.</em></p>
      <p>This message and any attachments are for the sole use of the intended recipient(s). If you are not the intended recipient, contact&nbsp;<strong><a href="https://intelinside.intel.com/Support?AppSignOn=Yes">customer service</a>&nbsp;</strong>immediately and confirm you have deleted all copies.</p>
      <p>Intel Corporation, 2111 NE 25th Avenue, Mailstop HF3-17, Hillsboro, OR 97124&nbsp;<br /><br/> <a href="https://www.intel.com/content/www/us/en/homepage.html">Intel Corporation</a>&nbsp;|&nbsp;<a href="https://www.intel.com/content/www/us/en/legal/trademarks.html">Trademarks&nbsp;</a>|&nbsp;<a href="https://www.intel.com/content/www/us/en/privacy/intel-privacy-notice.html?elqTrackId=d66a216e5b8b472c80e421c11f79cbc2&amp;amp;elqaid=13991&amp;amp;elqat=2">Privacy Policy</a>&nbsp;|&nbsp;<a href="http://www.intel.com/cookies">Cookies</a>&nbsp;</p>
      <p></p>
      </div>
</body>
    
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>