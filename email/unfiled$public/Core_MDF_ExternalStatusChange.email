<messaging:emailTemplate recipientType="User"
                         relatedToType="PartnerFundRequest"
                         language="{!CASE(relatedTo.CreatedBy.LanguageLocaleKey,'it','it','ja','ja','de','de','es','es','fr','fr','ru','ru','es_MX','es_MX','ko','ko','zh_TW','zh_TW','zh_CN','zh_CN','pt_BR','pt_BR','en')}"
                         subject="{!$Label.Core_MDF_EmailTemp_Subject}{!RelatedTo.Core_MDF_Activity_Number__c}{!$Label.Core_MDF_EmailTemp_Subject1}">
                          
                         
    <messaging:htmlEmailBody >
        <html>
            <body>  <div style="font-size:14px;font-family:Calibri">                 
                    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Alert} <br/><br/> {!$Label.Core_MDF_EmailTemp_StatusUpdate_DearMember} <br/><br/>
                    {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body1}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="RecType"/> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body2} {!RelatedTo.Core_MDF_Activity_Number__c}
                    {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body3}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="PriorStatus"/>&nbsp;{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body4}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="Status"/> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body4a}
                    
                    {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body5} <a href="{!RelatedTo.Core_MDF_PFRRecordCommunityLink__c}"> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body9}</a>
                    {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body6}<br/></p>
                    <p>{!$Label.Core_MDF_Member} {!RelatedTo.Core_MDF_Ultimate_Account_Name__c}
                    <br/>{!$Label.Core_MDF_Activity} {!RelatedTo.Core_MDF_Activity_Number__c}
                    <br/>{!$Label.Core_MDF_Country_Location} {!RelatedTo.Core_MDF_Country_nm__c}
                    <br/>{!$Label.Core_MDF_EmailTemp_Campaign} {!RelatedTo.Core_MDF_UpdateCampaign__c}
                    <br/>{!$Label.Core_MDF_EmailTemp_Activity_Type} <c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="ActType"/></p>
                    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}<br/>
                    <c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="RecType"/>&nbsp;{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body8}</p>
                    </div>
                    <div style="font-size:11px;font-family:Calibri">
                    <p>{!$Label.Core_MDF_Email_template_footer}<br/>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Address}<br/>
                    <a href = "https://www.intel.com/content/www/us/en/homepage.html" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                    <a href = "https://www.intel.com/content/www/us/en/legal/trademarks.html"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                    <a href = "https://www.intel.com/content/www/us/en/privacy/intel-privacy-notice.html?elqTrackId=d66a216e5b8b472c80e421c11f79cbc2&elqaid=13991&elqat=2"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                    <a href = "http://www.intel.com/"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                    </p>         
                    
                    </div>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>