<messaging:emailTemplate recipientType="User"
                         renderUsingSystemContextWithoutSharing="true"
                         relatedToType="PartnerFundRequest"
                         language="{!CASE(relatedTo.CreatedBy.LanguageLocaleKey,'it','it','ja','ja','de','de','es','es','fr','fr','ru','ru','es_MX','es_MX','ko','ko','zh_TW','zh_TW','zh_CN','zh_CN','pt_BR','pt_BR','en')}"
                         subject="{!if(OR(RelatedTo.Core_MDF_Fund_Request_Status__c='Planned',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Cancelled',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Closed'),$Label.Core_MDF_EmailTemp_Status_Change_NoAction_Subject +' '+ RelatedTo.Title ,$Label.Core_MDF_EmailTemp_Status_Change_Subject+' '+ RelatedTo.Title)}">   
                          
                         
    <messaging:htmlEmailBody >
        <html>
            <body>  <div style="font-size:14px;font-family:Calibri">  
                                <p>
                   
                    
                    <apex:outputLabel rendered="{!if(OR(RelatedTo.Core_MDF_Fund_Request_Status__c='Planned',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Cancelled',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Closed'),true,false)}">
                        <strong><span style="color:red">{!$Label.Core_MDF_Approved_Information_template}</span></strong>
                    </apex:outputLabel>
                    <apex:outputLabel rendered="{!if(NOT(OR(RelatedTo.Core_MDF_Fund_Request_Status__c='Planned',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Cancelled',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Closed')),true,false)}">
                        <strong><span style="color:red">{!$Label.Core_MDF_IPA_EmailTemp_ActionReq}</span></strong>
                    </apex:outputLabel>
            
                   
                    <p>{!$Label.Core_MDF_EmailTemp_DearIntelPartner} <br/></p>
                    
                    <apex:outputPanel rendered="{!if(OR(RelatedTo.Core_MDF_Fund_Request_Status__c = 'Planned',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Cancelled',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Closed'),true,false)}">
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body1}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="RecType"/> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body2} {!RelatedTo.Core_MDF_Activity_Number__c}
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body3}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="PriorStatus"/>&nbsp;{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body4}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="Status"/> .
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body5} 
                        
                        <apex:outputLink rendered="{!AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance', RelatedTo.Core_MDF_Is_Outcome_Based_Ind__c)}"
                                       value="{!$Label.Core_MDF_Outcome_Community_Link + RelatedTo.Id}">
                            {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body9}
                        </apex:outputLink>
                        <apex:outputLink rendered="{!NOT(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance', RelatedTo.Core_MDF_Is_Outcome_Based_Ind__c))}"
                                       value="{!RelatedTo.Core_MDF_PFRRecordCommunityLink__c}">
                            {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body9}
                        </apex:outputLink>
                        
                        {!$Label.Core_MDF_EmailTemp_Activity_Details}
                    </apex:outputPanel>
                    
                     <apex:outputPanel rendered="{!if(RelatedTo.Core_MDF_Fund_Request_Status__c = 'Pending Approval',true,false)}">
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body1}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="RecType"/> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body2} {!RelatedTo.Core_MDF_Activity_Number__c}
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body3}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="PriorStatus"/>&nbsp;{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body4}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="Status"/> .
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body5} 
                        
                        <apex:outputLink rendered="{!AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance', RelatedTo.Core_MDF_Is_Outcome_Based_Ind__c)}"
                                       value="{!$Label.Core_MDF_Outcome_Community_Link + RelatedTo.Id}">
                            {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body9}
                        </apex:outputLink>
                        <apex:outputLink rendered="{!NOT(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance', RelatedTo.Core_MDF_Is_Outcome_Based_Ind__c))}"
                                       value="{!RelatedTo.Core_MDF_PFRRecordCommunityLink__c}">
                            {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body9}
                        </apex:outputLink>
                        
                        {!$Label.Core_MDF_EmailTemp_Activity_Details}
                    </apex:outputPanel>
                    
                    <apex:outputPanel rendered="{!if(NOT(OR(RelatedTo.Core_MDF_Fund_Request_Status__c = 'Planned',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Cancelled',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Closed',RelatedTo.Core_MDF_Fund_Request_Status__c = 'Pending Approval')),true,false)}">
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body1}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="RecType"/> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body2} {!RelatedTo.Core_MDF_Activity_Number__c}
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body3}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="PriorStatus"/>&nbsp;{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body4}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="Status"/> {!$Label.Core_MDF_EmailTemp_Ext_StatusChange}
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body5} 
                        
                        <apex:outputLink rendered="{!AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance', RelatedTo.Core_MDF_Is_Outcome_Based_Ind__c)}"
                                       value="{!$Label.Core_MDF_Outcome_Community_Link + RelatedTo.Id}">
                            {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body9}
                        </apex:outputLink>
                        <apex:outputLink rendered="{!NOT(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance', RelatedTo.Core_MDF_Is_Outcome_Based_Ind__c))}"
                                       value="{!RelatedTo.Core_MDF_PFRRecordCommunityLink__c}">
                            {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body9}
                        </apex:outputLink>
                        
                        {!$Label.Core_MDF_EmailTemp_Activity_Details}
                    </apex:outputPanel>
                    
                  
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_IPA_EmailTemp_Field1} {!if(RelatedTo.Core_MDF_Program__c =='Intel Partner Alliance',RelatedTo.ChannelPartner.Name,RelatedTo.Core_MDF_Ultimate_Account_Name__c)}</p>
                    <apex:outputPanel rendered="{!AND(NOT(ISBLANK(RelatedTo.Core_MDF_Program__c)), NOT(ISBLANK(RelatedTo.Core_MDF_UpdateCampaign__c)))}">
                        <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_Audit_Creation_Field3} {!RelatedTo.Core_MDF_UpdateCampaign__c}</p>
                    </apex:outputPanel>
                    <p>&nbsp; &nbsp; &nbsp;{!IF(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance'), 'Outcome-Based Campaign Name:', $Label.Core_MDF_EmailTemp_Claim_Activity_Name)} {!RelatedTo.Title}</p>
                    <p>&nbsp; &nbsp; &nbsp;{!IF(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance'), 'Outcome-Based Campaign Number:', $Label.Core_MDF_EmailTemp_Activity_Number)} {!RelatedTo.Core_MDF_Activity_Number__c}</p>
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_EmailTemp_Budget_Type} {!RelatedTo.Core_MDF_Budget_Type_nm__c}</p>
                    <apex:outputPanel rendered="{!if(RelatedTo.Core_MDF_Program__c =='Intel Partner Alliance',true,false)}">
                        <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_EmailTemp_Focus_Area} {!RelatedTo.Core_MDF_Focus_Area_nm__c}</p>
                        <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_EmailTemplate_Budget_Amount} ${!RelatedTo.Core_MDF_Activity_Reimbursement_Amt_nbr__c}</p>
                    </apex:outputPanel> 
                    <apex:outputPanel rendered="{!NOT(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance'))}">
                        <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_EmailTemp_Activity_Type} <c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="ActType"/></p>
                    </apex:outputPanel>
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_Country_Location} {!RelatedTo.Core_MDF_Country_nm__c}</p>
                    </p>
       
                    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                    <p><span>{!$Label.Core_MDF_Email_Signature}</span></p>
                </div>
                <div style="font-size:11px;font-family:Calibri">
                    <p>
                        <i> 
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/>
                        </i>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                    </p>
                </div>    
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>