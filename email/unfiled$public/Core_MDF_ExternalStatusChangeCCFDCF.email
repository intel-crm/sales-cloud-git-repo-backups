<messaging:emailTemplate renderUsingSystemContextWithoutSharing="true"
                         subject="{!$Label.Core_MDF_Request} # {!RelatedTo.Core_MDF_Activity_Number__c} {!$Label.Core_MDF_Pending_Approval_subject}"
                         relatedToType="PartnerFundRequest" language="{!recipient.LanguageLocaleKey}" recipientType="User">
                         
    <messaging:htmlEmailBody >
        <html>
            <body>
                <div style="font-size:14px;font-family:Calibri">  
                    <p>
                        <span style="color: #ff0000;">
                            <strong>
                                {!$Label.Core_MDF_IPA_EmailTemp_ActionReq}
                            </strong>
                        </span>
                    </p>
                 
               
                    <p><span>{!$Label.Core_MDF_EmailTemp_DearIntelPartner}</span></p>
                    
                    <p><span>
                       {!RelatedTo.CreatedBy.Name}&nbsp;{!$Label.Core_MDF_Email_Template_Appr_Req}:&nbsp;
                    </span></p>
                    
                    
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_IPA_EmailTemp_Field1} {!RelatedTo.Core_MDF_Ultimate_Account_Name__c}</p>
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_Audit_Creation_Field3} {!RelatedTo.Core_MDF_UpdateCampaign__c}</p>
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemp_Claim_Activity_Name} {!RelatedTo.Title}</p>
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemp_Activity_Number} {!RelatedTo.Core_MDF_Activity_Number__c}</p>
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemp_Budget_Type} {!RelatedTo.Core_MDF_Budget_Type_nm__c}</p> 
                    <p>&nbsp; &nbsp; &nbsp;<span> {!$Label.Core_MDF_EmailTemp_Activity_Type}&nbsp;<apex:outputField value="{!RelatedTo.Core_MDF_Activity_Types__c}" /></span></p>
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_IPA_EmailTemp_Field3} {!RelatedTo.Core_MDF_Fund_Request_Status__c}</p>
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_Country_Location}&nbsp;<apex:outputField value="{!RelatedTo.Core_MDF_Country_nm__c}" /></p>
             
                    <p><span>
                        {!$Label.Core_MDF_RMF_EmailTemp_StatusUpdate_Body5} 
                    <apex:outputText value="{0, date, MMMM d','  yyyy}"> <apex:param value="{!RelatedTo.Core_MDF_ToBeClosedDate__c}" /> </apex:outputText> .
                    </span></p>  
                    
                    <p><strong><a href="{!RelatedTo.Core_MDF_PFRRecordCommunityLink__c}">{!$Label.Core_MDF_IPA_EmailTemp_Link1}</a>&nbsp;</strong> </p>
                    <p>{!$Label.Core_MDF_IPA_EmailTemp_Body7} </p> 
                    
                    <p></p>
                    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                    <p><span>{!$Label.Core_MDF_Email_Signature}</span></p>
                </div>
                <div style="font-size:11px;font-family:Calibri">
                    <p>
                        <i> 
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/>
                        </i>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                    </p>
                </div>    
            </body>
        </html>    
    </messaging:htmlEmailBody>
</messaging:emailTemplate>