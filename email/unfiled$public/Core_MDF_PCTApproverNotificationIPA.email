<messaging:emailTemplate renderUsingSystemContextWithoutSharing="true"
                   subject="Activity #{!RelatedTo.Core_MDF_Activity_Number__c} is in {!RelatedTo.Core_MDF_Fund_Request_Status__c} status {!IF((RelatedTo.Core_MDF_Fund_Request_Status__c == 'Pending Review'),'and is ready for your review','')}"   
                                 
                     relatedToType="PartnerFundRequest" language="{!recipient.LanguageLocaleKey}" recipientType="User">
<messaging:htmlEmailBody >
<html>
    <body>
        <div style="font-size:14px;font-family:Calibri">  
                <p>
                    <span style="color: #ff0000;">
                        <strong>
                               {!$Label.Core_MDF_IPA_EmailTemp_ActionReq}
                                 
                        </strong>
                     </span>
                 </p>
                 
               
                    <p><span>{!$Label.Core_MDF_EmailTemp_DearIntelemployee} </span></p>
                    
                    <p><span>
                       {!RelatedTo.LastModifiedBy.Name} {!$Label.Core_MDF_Email_Template_Appr_Req}. 
                       

                       </span>
                    </p>
                    
                    <p><strong><a href="{!RelatedTo.Core_MDF_PFRDetailLink__c}">{!$Label.Core_MDF_IPA_EmailTemp_Link1}</a> &nbsp;</strong>to approve or reject this record.</p> 
             
             
                 <p>&nbsp; &nbsp; &nbsp; Member: {!RelatedTo.Core_MDF_Ultimate_Account_Name__c}</p>
                 <p>&nbsp; &nbsp; &nbsp; Campaign: {!RelatedTo.Campaign.Name}</p>
                 <p>&nbsp; &nbsp; &nbsp; Activity Name: {!RelatedTo.Title}</p>
                 <p>&nbsp; &nbsp; &nbsp; Activity #: {!RelatedTo.Core_MDF_Activity_Number__c}</p>
                 <p>&nbsp; &nbsp; &nbsp; Activity Type: {!RelatedTo.Core_MDF_Activity_Types__c}</p>
                 <p>&nbsp; &nbsp; &nbsp; Activity Budget:&nbsp;
                 <apex:outputText value="{0, Number,#,##0.00}">
                    <apex:param value="{!RelatedTo.Core_MDF_Budget_Amount_Local_amt__c}"/>
                 </apex:outputText> <br/></p>
                 <p>&nbsp; &nbsp; &nbsp; Activity Budget Type: {!RelatedTo.Core_MDF_Budget_Type_nm__c}</p>
                 <p>&nbsp; &nbsp; &nbsp; Countries/Locations:  {!RelatedTo.Core_MDF_Country_nm__c}</p>
                 <p>&nbsp; &nbsp; &nbsp; Activity status step:  Price Review</p>
                 
                 <p><span>
                       All claims must be submitted for this activity no later than 
                        <apex:outputText value="{0, date, MMMM d','  yyyy}"> <apex:param value="{!RelatedTo.Core_MDF_ToBeClosedDate__c}" /> </apex:outputText>.
                        </span>
                    </p><br/>   
            
   
    <p>Thank you,</p>
       <p><span>{!RelatedTo.RecordType.Name}&nbsp;Program</span></p>
    <p><span>&nbsp;</span></p>
    
    <div style="font-family: Calibri;font-size: 11px;">
    <p><em>{!$Label.Core_MDF_IPA_EmailTemp_Footer1}</em>&nbsp;<em>{!$Label.Core_MDF_IPA_EmailTemp_Footer2}&nbsp;<strong><a href="https://intelinside.intel.com/Support?AppSignOn=Yes">{!$Label.Core_MDF_IPA_EmailTemp_Footer3}</a>&nbsp;</strong>{!$Label.Core_MDF_IPA_EmailTemp_Footer4}</em></p>
    <p>{!$Label.Core_MDF_EmailTemp_Claim_Footer3}&nbsp;<strong><a href="https://intelinside.intel.com/Support?AppSignOn=Yes">{!$Label.Core_MDF_IPA_EmailTemp_Footer3}</a>&nbsp;</strong>{!$Label.Core_MDF_EmailTemp_Claim_Footer4}</p>
    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Address}&nbsp;<br /><a href="https://www.intel.com/content/www/us/en/homepage.html">{!$Label.Core_MDF_EmailTemp_Footer3}</a>&nbsp;|&nbsp;<a href="https://www.intel.com/content/www/us/en/legal/trademarks.html">{!$Label.Core_MDF_EmailTemp_Footer4}&nbsp;</a>|&nbsp;<a href="https://www.intel.com/content/www/us/en/privacy/intel-privacy-notice.html?elqTrackId=d66a216e5b8b472c80e421c11f79cbc2&amp;amp;elqaid=13991&amp;amp;elqat=2">{!$Label.Core_MDF_EmailTemp_Footer5}</a>&nbsp;|&nbsp;<a href="http://www.intel.com/cookies">{!$Label.Core_MDF_EmailTemp_Footer6}</a>&nbsp;</p>
    <p></p>

             </div>
             </div>
        </body>
    </html>    
    </messaging:htmlEmailBody>
</messaging:emailTemplate>