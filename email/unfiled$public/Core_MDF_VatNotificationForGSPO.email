<messaging:emailTemplate subject="{!IF(ISBLANK(relatedTo.Core_MDF_Sub_Claim_Id__c), '', relatedTo.Core_MDF_Sub_Claim_Id__r.ChannelPartner.Name & ': ')}{!$Label.Core_MDF_EmailTemp_Subj1} {!relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Claim_Ref_Number__c}: {!relatedTo.Core_MDF_Claim_Id__r.Title} - {!$Label.Core_MDF_VAT_EmailSubject_Invoice}" 
                         recipientType="User"
                         relatedToType="Core_MDF_Claim_VAT_Info__c"
                         language="en_US" renderUsingSystemContextWithoutSharing="True">
    <messaging:htmlEmailBody >
        <html>
            <body>
                <div style="font-size:14px;font-family:Calibri"> 
                    <p>      
                        {!$Label.Core_MDF_EmailTemp_DearIntelemployee} <br/>
                    </p>
                    <p> <apex:outputText value="{!$Label.Core_MDF_VATGSPOEmailBody}">
                        <apex:param value="{!IF(relatedTo.Core_MDF_Claim_Id__r.Core_MDF_C_Type_Ind__c, $Label.Core_MDF_Credit_Memo, $Label.Core_MDF_VAT_Invoice)}" />
                        <apex:param value="{!relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Claim_Ref_Number__c}" />
                        </apex:outputText>
                        <ul>
                            <li>{!$Label.Core_MDF_EmailTemp_AdjReq_Create_Body3}&nbsp;{!relatedTo.Core_MDF_Claim_Id__r.Title}<br/></li>    
                            <li>{!$Label.Core_MDF_EmailTemp_AdjReq_Create_Body4}&nbsp;{!IF(ISBLANK(relatedTo.Core_MDF_Sub_Claim_Id__c),relatedTo.Core_MDF_Claim_Id__r.Core_MDF_AccountCompany__c,relatedTo.Core_MDF_Sub_Claim_Id__r.ChannelPartner.Name)}<br/></li>
                            <li>{!IF(relatedTo.Core_MDF_Claim_Id__r.Request.Core_MDF_Is_Outcome_Based_Ind__c,$Label.Core_MDF_OutcomeBasedCampaign_Name & ' :',$Label.Core_MDF_EmailTemp_Claim_Activity_Name)}&nbsp;{!relatedTo.Core_MDF_Claim_Id__r.Request.Title}<br/></li>  
                            <apex:outputPanel rendered="{!NOT(relatedTo.Core_MDF_Claim_Id__r.Request.Core_MDF_Is_Outcome_Based_Ind__c)}">
                                <li>{!$Label.Core_MDF_EmailTemp_Activity_Type}&nbsp;{!relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Activity_Types__c}</li>   
                            </apex:outputPanel>                       
                            <li>{!$Label.Core_MDF_Legal_Entity}&nbsp;: {!IF(ISBLANK(relatedTo.Core_MDF_Sub_Claim_Id__c), relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Bank__r.Core_MDF_Intel_Company_Code__c, relatedTo.Core_MDF_Sub_Claim_Id__r.Core_MDF_Bank__r.Core_MDF_Intel_Company_Code__c)}</li>
                            <li>{!$Label.Core_MDF_Payment_Run_Number}&nbsp;: {!IF(ISBLANK(relatedTo.Core_MDF_Sub_Claim_Id__c), relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Payment_Id__r.Core_MDF_Payment_Run_Id__r.Name, relatedTo.Core_MDF_Sub_Claim_Id__r.Core_MDF_Payment_Id__r.Core_MDF_Payment_Run_Id__r.Name)}</li>
                            <li>{!$Label.Core_MDF_Payment_Run_Date}&nbsp;: 
                              <apex:outputText rendered="{!IF(ISBLANK(relatedTo.Core_MDF_Sub_Claim_Id__c), relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Payment_Id__r.Core_MDF_Payment_Run_Id__r.Core_MDF_Run_Now_Ind__c, relatedTo.Core_MDF_Sub_Claim_Id__r.Core_MDF_Payment_Id__r.Core_MDF_Payment_Run_Id__r.Core_MDF_Run_Now_Ind__c)}" value="{0,date,yyyy/MM/dd}"> 
                               &nbsp;<apex:param value="{!IF(ISBLANK(relatedTo.Core_MDF_Sub_Claim_Id__c), relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Payment_Id__r.Core_MDF_Payment_Run_Id__r.CreatedDate, relatedTo.Core_MDF_Sub_Claim_Id__r.Core_MDF_Payment_Id__r.Core_MDF_Payment_Run_Id__r.CreatedDate)}"/>
                              </apex:outputText>
                             <apex:outputText value="{0,date,yyyy/MM/dd}"> 
                               &nbsp;<apex:param value="{!IF(ISBLANK(relatedTo.Core_MDF_Sub_Claim_Id__c), relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Payment_Id__r.Core_MDF_Payment_Run_Id__r.Core_MDF_ScheduleRun_Dtm__c, relatedTo.Core_MDF_Sub_Claim_Id__r.Core_MDF_Payment_Id__r.Core_MDF_Payment_Run_Id__r.Core_MDF_ScheduleRun_Dtm__c)}"/>
                             </apex:outputText>
                             </li>
                            <li>{!$Label.Core_MDF_VAT_Invoice_Number}&nbsp;: {!relatedTo.Core_MDF_VAT_Invoice_Number_Txt__c}</li>
                            <apex:outputPanel rendered="{!IF(relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Country_Location_nm__c != null,true,false)}">
                            <li>{!$Label.Core_MDF_CountryLocation}&nbsp;: {!relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Country_Location_nm__c}</li>
                            </apex:outputPanel>
                            <li>{!$Label.Core_MDF_EmailTemp_Program}&nbsp;{!relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Program__c}</li>
                            <apex:outputPanel rendered="{!IF(relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Budget_Type_Options_Nm__c != null,true,false)}">
                            <li>{!$Label.Core_MDF_EmailTemp_Budget_Type}&nbsp;{!relatedTo.Core_MDF_Claim_Id__r.Core_MDF_Budget_Type_Options_Nm__c }  <br/></li>
                            </apex:outputPanel> 
                        </ul>
                    </p>   
                    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                    <p>{!$Label.Core_MDF_Email_Signature}</p> 
                      
               
                <div style="font-size:11px;font-family:Calibri">
                                   <p>
                                     <i>  {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                                           <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/></i>
                                            {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                                           {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                            </p>         
                    
                    </div> 
                </div>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>