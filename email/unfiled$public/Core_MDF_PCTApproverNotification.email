<messaging:emailTemplate renderUsingSystemContextWithoutSharing="true"
                         subject="{!IF(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance'), 'Outcome-Based Campaign #', 'Activity #')} {!RelatedTo.Core_MDF_Activity_Number__c} is in {!RelatedTo.Core_MDF_Fund_Request_Status__c} status and is ready for your review"
                         relatedToType="PartnerFundRequest" language="{!recipient.LanguageLocaleKey}" recipientType="User">
                         
    <messaging:htmlEmailBody >
        <html>
            <body>
                <div style="font-size:14px;font-family:Calibri">  
                    <p>
                        <span style="color: #ff0000;">
                            <strong>
                                {!$Label.Core_MDF_IPA_EmailTemp_ActionReq}
                            </strong>
                        </span>
                    </p>
                     
                   
                    <p><span>{!$Label.Core_MDF_EmailTemp_DearIntelemployee}</span></p>
                        
                    <p><span>
                        {!RelatedTo.LastModifiedBy.Name} {!$Label.Core_MDF_Email_Template_Appr_Req}:
                    </span></p>
                  
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_IPA_EmailTemp_Field1} {!if(RelatedTo.Core_MDF_Program__c =='Intel Partner Alliance',RelatedTo.ChannelPartner.Name,RelatedTo.Core_MDF_Ultimate_Account_Name__c)}</p>
                    <apex:outputPanel rendered="{!NOT(ISBLANK(RelatedTo.Campaign.Name))}">
                        <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_Audit_Creation_Field3} {!if(RelatedTo.Core_MDF_Program__c =='Intel Partner Alliance',RelatedTo.Campaign.Name,RelatedTo.Core_MDF_UpdateCampaign__c)}</p>
                    </apex:outputPanel>
                    <p>&nbsp; &nbsp; &nbsp; {!IF(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance'), 'Outcome-Based Campaign Name:', $Label.Core_MDF_EmailTemp_Claim_Activity_Name)} {!RelatedTo.Title}</p>
                    <p>&nbsp; &nbsp; &nbsp; {!IF(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance'), 'Outcome-Based Campaign Number:', $Label.Core_MDF_EmailTemp_Activity_Number)} {!RelatedTo.Core_MDF_Activity_Number__c}</p>
                    <p>&nbsp; &nbsp; &nbsp; Start Date: {!RelatedTo.Core_MDF_Start_Date__c}</p>
                    <p>&nbsp; &nbsp; &nbsp; End Date: {!RelatedTo.Core_MDF_End_Date__c}</p> 
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemp_Budget_Type} {!RelatedTo.Core_MDF_Budget_Type_nm__c}</p> 
                    <apex:outputPanel rendered="{!if(RelatedTo.Core_MDF_Program__c =='Intel Partner Alliance',true,false)}">
                        <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemp_Focus_Area} {!RelatedTo.Core_MDF_Focus_Area_nm__c}</p>
                         <p>&nbsp; &nbsp; &nbsp; Maximum Intel Investment: 
                                    <apex:outputText value="{0, Number,#,##0.00}">
                                    $<apex:param value="{!RelatedTo.Core_MDF_Maximum_Intel_Investment_amt__c}"/>
                                    </apex:outputText></p>
                                <p>&nbsp; &nbsp; &nbsp; Tactics: {!RelatedTo.Core_MDF_Tactics_nm__c}</p>
                        <apex:outputPanel rendered="{!NOT(RelatedTo.Core_MDF_Is_Outcome_Based_Ind__c)}">
                        <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemplate_Budget_Amount} ${!RelatedTo.Core_MDF_Activity_Reimbursement_Amt_nbr__c}</p>
                         </apex:outputPanel>
                    </apex:outputPanel>            
                    <apex:outputPanel rendered="{!NOT(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance'))}">
                        <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_Audit_Creation_Field4} {!RelatedTo.Core_MDF_Activity_Types__c}</p>
                    </apex:outputPanel>
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_IPA_EmailTemp_Field3} {!RelatedTo.Core_MDF_Fund_Request_Status__c}</p>
                    <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_Country_Location} {!RelatedTo.Core_MDF_Country_nm__c}</p>
                    <apex:outputPanel rendered="{!if(AND(RelatedTo.Core_MDF_Program__c =='Intel Partner Alliance',NOT(ISBLANK(relatedTo.Core_MDF_IPA_Int_Approver_Comment_txt__c))),true,false)}">
                        <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_IPA_Approver_Comment} {!RelatedTo.Core_MDF_IPA_Int_Approver_Comment_txt__c}</p>
                    </apex:outputPanel>    
                        
                    <p><span>
                        {!$Label.Core_MDF_RMF_EmailTemp_StatusUpdate_Body5} 
                        <apex:outputText value="{0, date, MMMM d','  yyyy}"> <apex:param value="{!RelatedTo.Core_MDF_ToBeClosedDate__c}" /> </apex:outputText> .
                    </span></p>
                    
                    <p>
                        <strong>
                            <apex:outputLink rendered="{!AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance', RelatedTo.Core_MDF_Is_Outcome_Based_Ind__c)}"
                                           value="{!$Label.Core_MDF_Outcome_Internal_Link + RelatedTo.Id}">
                                {!$Label.Core_MDF_IPA_EmailTemp_Link1}
                            </apex:outputLink>
                            <apex:outputLink rendered="{!NOT(AND(ISNULL(RelatedTo.Campaign), RelatedTo.Core_MDF_Program__c = 'Intel Partner Alliance', RelatedTo.Core_MDF_Is_Outcome_Based_Ind__c))}"
                                           value="{!RelatedTo.Core_MDF_PFRDetailLink__c}">
                                {!$Label.Core_MDF_IPA_EmailTemp_Link1}
                            </apex:outputLink>
                        </strong> 
                    </p>
                    
                    <p>{!$Label.Core_MDF_IPA_EmailTemp_Body7} </p>
             
  

                    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                    <p>
                        <span>Intel® Partner Investment Center</span>
                    </p>
                </div>
                <div style="font-size:11px;font-family:Calibri">
                    <p>
                        <i> 
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/>
                        </i>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                    </p>
                </div>        
            </body>
        </html>    
    </messaging:htmlEmailBody>
</messaging:emailTemplate>