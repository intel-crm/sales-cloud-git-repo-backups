<td tEditID="c1r2" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<div style=""><div style="background-color: rgb(255, 255, 255);"><div style=""><div style=""><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><p class="rally-rte-class-00f225fc8e1e03" style=""><font face="Arial, sans-serif" size="2" style=""><strong style="">Action May Be Required</strong></font></p><p class="rally-rte-class-00f225fc8e1e03" style=""><font size="2"><br></font></p><p class="rally-rte-class-00f225fc8e1e03" style=""><font size="2">Dear Intel employee,</font></p><p class="rally-rte-class-00f225fc8e1e03" style=""><font face="arial" size="2"><br></font></p><p class="rally-rte-class-00f225fc8e1e03" style=""><font size="2"><span class="rally-rte-class-0dfeaa2989006a" style="font-family: Arial, sans-serif;"><span class="rally-rte-class-08fab63c0981ad">The status for&nbsp;</span></span><span style="font-family: Arial, sans-serif;">{!PartnerFundRequest.RecordType}</span><span class="rally-rte-class-0dfeaa2989006a" style="font-family: Arial, sans-serif;"><span class="rally-rte-class-08fab63c0981ad">&nbsp;program Activity #{!PartnerFundRequest.Core_MDF_Activity_Number__c} has been updated&nbsp;</span></span><font face="Arial, sans-serif">{!IF(NOT(ISBLANK(PartnerFundRequest.Core_MDF_PriorValueOfStatus__c)),"from "+PartnerFundRequest.Core_MDF_PriorValueOfStatus__c+" ","")}</font><font face="Arial, sans-serif"><span class="rally-rte-class-0dfeaa2989006a"><span class="rally-rte-class-08fab63c0981ad">to&nbsp;{!PartnerFundRequest.Core_MDF_Fund_Request_Status__c}. Click&nbsp;</span></span></font><span class="rally-rte-class-0dfeaa2989006a" style="font-family: Arial, sans-serif;"><span class="rally-rte-class-08fab63c0981ad"><a href="{!PartnerFundRequest.Core_MDF_PFRDetailLink__c}">here</a>&nbsp;</span><span class="rally-rte-class-0bd24be9664735">to view the activity status details and to determine if any action is required.</span></span><span class="rally-rte-class-0b7a3094df3781" style="font-family: Arial, sans-serif;">&nbsp;</span></font></p><p class="rally-rte-class-06399c687866b4" style=""><font face="Arial, sans-serif" size="2"><br></font></p><p class="rally-rte-class-06399c687866b4" style=""><font size="2"><br></font></p></div><blockquote style="margin: 0px 0px 0px 40px; border: none; padding: 0px;"><div style=""><p class="rally-rte-class-06399c687866b4" style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="Arial, sans-serif" size="2">Member :&nbsp;{!PartnerFundRequest.Core_MDF_Ultimate_Account_Name__c}&nbsp;</font></p><p class="rally-rte-class-06399c687866b4" style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="Arial, sans-serif" size="2"><br></font></p><p class="rally-rte-class-06399c687866b4" style=""><font size="2"><span style="font-family: Arial, sans-serif;">Activity Name </span><span style="font-family: Arial, sans-serif;">:&nbsp;{!PartnerFundRequest.Title}</span></font><span style="font-size: small; font-family: Arial, sans-serif;">&nbsp;</span></p><p class="rally-rte-class-06399c687866b4" style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="Arial, sans-serif" size="2"><br></font></p><p class="rally-rte-class-06399c687866b4" style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font size="2" face="Arial, sans-serif">Campaign :&nbsp;{!PartnerFundRequest.Core_MDF_UpdateCampaign__c}</font></p><p class="rally-rte-class-06399c687866b4" style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="Arial, sans-serif" size="2"><br></font></p></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><p class="rally-rte-class-06399c687866b4" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2">Activity # :&nbsp;{!PartnerFundRequest.Core_MDF_Activity_Number__c}</font></p><p class="rally-rte-class-06399c687866b4" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><br></font></p><p class="rally-rte-class-06399c687866b4" style=""><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial;" size="2">Budget Type </font><font face="Arial, sans-serif" size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">:&nbsp;</font><font face="Arial, sans-serif" size="2">{!PartnerFundRequest.Core_MDF_Budget_Type_nm__c}</font></p><p class="rally-rte-class-06399c687866b4" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2"><br></font></p></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><p class="rally-rte-class-06399c687866b4"><font face="Arial, sans-serif" size="2">Activity Type :&nbsp;{!PartnerFundRequest.Core_MDF_Activity_Types__c}&nbsp;</font></p></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><p class="rally-rte-class-06399c687866b4"><font face="Arial, sans-serif" size="2"><br></font></p><p class="rally-rte-class-06399c687866b4"><font face="Arial, sans-serif" size="2">Countries/Locations :&nbsp;{!PartnerFundRequest.Core_MDF_Country_nm__c}</font></p><p class="rally-rte-class-06399c687866b4"><font face="Arial, sans-serif" size="2"><br></font></p></div></blockquote><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><p class="rally-rte-class-0916fc7bf04abc" style=""><span class="rally-rte-class-0d13d46715f37e"><font face="Arial, sans-serif" size="2">&nbsp;</font></span></p><p class="rally-rte-class-0916fc7bf04abc" style=""><span class="rally-rte-class-0dfeaa2989006a" style=""><font face="Arial, sans-serif" size="2" style=""><span class="rally-rte-class-08fab63c0981ad" style="">Thank you,</span><br>{!PartnerFundRequest.RecordType}&nbsp;Program Team</font></span></p></div></div></div></div></div>]]></td>
</tr>
