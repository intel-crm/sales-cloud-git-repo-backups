<messaging:emailTemplate recipientType="User" 
                         renderUsingSystemContextWithoutSharing="true"
                         relatedToType="Campaign"
                         language="{!recipient.LanguageLocaleKey}"
                         subject="{!$Label.Core_MDF_RMF_Budget_Inc} {!RelatedTo.Core_MDF_Opal_Budget_Type_Txt__c}">
                          
                         
    <messaging:htmlEmailBody >
        <html>
            <body>  
                    <div style="font-size:14px;font-family:Calibri">
                    <p><p><span>{!$Label.Core_MDF_EmailTemp_DearIntelemployee} </span></p>
                    {!$Label.Core_Email_Template_RMF_Notification}&nbsp;
                    <p>{!$Label.Core_MDF_RMF_Notification_Requestor} {!RelatedTo.LastModifiedBy.name}
                    <br/>{!$Label.Core_Email_Template_RMF_Notification_field}
                     <apex:outputText value="{0, number, 00.00}">
                    <apex:param value="{!relatedTo.Core_MDF_RMF_Delta_Budget_Amt__c}" />
                    </apex:outputText>
                    <br/>{!$Label.Core_Email_Template_RMF_Notification_field_Budget} {!RelatedTo.Core_MDF_Opal_Budget_Type_Txt__c}
                    <br/>{!$Label.Core_MDF_Member} {!RelatedTo.Core_MDF_Account__r.Name} 
                    <br/>{!$Label.Core_MDF_EmailTemp_Campaign} {!RelatedTo.Name}                  
                    </p>
                    </p>
                    <p> 
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}<br/>
                        {!$Label.Core_MDF_Email_Signature}
                      <br/>         
                    </p>
                    </div>
                     <div style="font-size:11px;font-family:Calibri">
                    <p>
                        <i>  {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/>
                        </i>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                    </p>
                </div>    


                   
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>