<messaging:emailTemplate subject="{!RelatedTo.ChannelPartner.Name} {!$Label.Core_MDF_RecoveryClaimStatus}: {!$Label.Core_MDF_PendingClarification}"
                         recipientType="User"
                         relatedToType="PartnerFundClaim"
                         renderUsingSystemContextWithoutSharing="true"
                         language="{!RelatedTo.Core_MDF_Owner_Language_Locale_Key_txt__c}">
    <messaging:htmlEmailBody >
        <html>
            <body>
                <div style="font-size:14px; font-family:Calibri">
                    <p><span style="color: #ff0000;"><strong>{!$Label.Core_MDF_IPA_EmailTemp_ActionReq}</strong></span></p>
                    <p>{!IF(RelatedTo.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner', $Label.Core_MDF_EmailTemp_DearIntelPartner, IF(RelatedTo.Core_MDF_Owner_UserType_Txt__c == 'Standard', $Label.Core_MDF_EmailTemp_DearIntelemployee, ''))}<br/></p>
                    <p>{!$Label.Core_MDF_IPA_EmailTemp_Body12} </p>
                    <ul>
                        <li>{!$Label.Core_MDF_IPA_EmailTemp_Field1} {!RelatedTo.ChannelPartner.Name}</li>
                        <li>{!$Label.Core_MDF_EmailTemp_Subj1}: {!RelatedTo.Core_MDF_Claim_Ref_Number__c}</li>
                        <li>{!$Label.Core_MDF_ClaimName}:&nbsp;
                            <apex:outputLink rendered="{!relatedTo.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner'}"
                                value="{!$Label.Core_MDF_PFRCommunityLink + RelatedTo.Id}">{!relatedTo.Title}
                            </apex:outputLink>
                            <apex:outputLink rendered="{!relatedTo.Core_MDF_Owner_UserType_Txt__c == 'Standard'}"
                                value="{!$Label.Core_MDF_PFRDetailLink + RelatedTo.Id}">{!relatedTo.Title}
                            </apex:outputLink>
                        </li>
                        <li>{!$Label.Core_MDF_ClaimStartDate}:
                            <apex:outputText value="{0, date, MMMM d',' yyyy}">
                                <apex:param value="{!RelatedTo.Core_MDF_Ad_Run_Start_Date__c}" />
                            </apex:outputText>
                        </li>
                        <li>{!$Label.Core_MDF_ClaimEndDate}:
                            <apex:outputText value="{0, date, MMMM d',' yyyy}">
                                <apex:param value="{!RelatedTo.Core_MDF_Ad_Run_End_Date__c}" />
                            </apex:outputText>
                        </li>
                        <li>{!$Label.Core_MDF_Reimbursement_Amount_email}:&nbsp;<apex:outputText value="{0,number,$#,##0.00}"><apex:param value="{!relatedTo.Core_MDF_Requested_Reimbursement_Amt__c}" /></apex:outputText></li>
                        <li>{!IF(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c,$Label.Core_MDF_OutcomeBasedCampaign_Number & ':',$Label.Core_MDF_Activity)}&nbsp;{!RelatedTo.Request.Core_MDF_Activity_Number__c}</li>
                        <li>{!IF(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c,$Label.Core_MDF_OutcomeBasedCampaign_Name & ':',$Label.Core_MDF_EmailTemp_Claim_Activity_Name)}
                            <apex:outputLink rendered="{!relatedTo.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner'}"
                                value="{!IF(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c,
                                            $Label.Core_MDF_Outcome_Community_Link + RelatedTo.RequestId,
                                            $Label.Core_MDF_PFRCommunityLink + RelatedTo.RequestId)}">
                                {!RelatedTo.Request.Title}
                            </apex:outputLink>
                            <apex:outputLink rendered="{!relatedTo.Core_MDF_Owner_UserType_Txt__c == 'Standard'}"
                                value="{!IF(RelatedTo.Request.Core_MDF_Is_Outcome_Based_Ind__c,
                                            $Label.Core_MDF_Outcome_Internal_Link + RelatedTo.RequestId,
                                            $Label.Core_MDF_PFRDetailLink + RelatedTo.RequestId)}">
                                {!RelatedTo.Request.Title}
                            </apex:outputLink>
                        </li>
                            
                        <li>{!$Label.Core_MDF_EmailTemp_Budget_Type} {!RelatedTo.Core_MDF_Budget_Type_Options_Nm__c}</li>
                        <li>{!$Label.Core_MDF_IPA_Comments}: {!RelatedTo.Core_MDF_Comments_Appvr_Only_txt__c}</li>
                    </ul>
                                           
                    <p><apex:outputLink value="{!IF(relatedTo.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner', $Label.Core_MDF_PFRCommunityLink + RelatedTo.Id, $Label.Core_MDF_PFRDetailLink + RelatedTo.Id)}">{!$Label.Core_MDF_Click_here}
                    </apex:outputLink> {!$Label.Core_MDF_Claim_EmailTemp_Body2}</p>

                    <p> 
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}<br/><br/>
                        {!$Label.Core_MDF_Email_Signature}<br/>                       
                    </p>
                    <img src="https://intel.file.force.com/servlet/servlet.ImageServer?id=015Ho000003gyPd&oid=00Do0000000aRcf&lastMod=1720070041000" alt="Intel Logo" width="120" height="48"> </img>
                    <div style="font-size:11px;font-family:Calibri">
                        <p>
                            <i>  {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/></i>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                         </p>
                   </div> 
                </div>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>