<messaging:emailTemplate recipientType="User" 
                         relatedToType="Case"
                         language="{!relatedTo.Core_MDF_Claim_Submitter__r.LanguageLocaleKey}" 
                         subject="{!$Label.Core_MDF_Claim_Case_Score} {!relatedTo.Core_MDF_Claim_Number__c}: {!relatedTo.Core_MDF_Claim_Lookup_Id__r.Title} : {!FLOOR(relatedTo.Core_MDF_Scorecard_Score_Nbr__c)}"  renderUsingSystemContextWithoutSharing="True">
    <messaging:htmlEmailBody >
        <html>
            <body>
                <div style="font-size:14px;font-family:Calibri"> 
                
                    <p>{!$Label.Core_MDF_EmailTemp_DearIntelPartner_New}</p>
                    <p>{!$Label.Core_MDF_Claim_Has_Been_Scored_New}</p>      
                      
                    <p><u>{!$Label.Core_MDF_ClaimNumber}</u>: 
                        <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Claim_Submitter__r.UserType == 'PowerPartner',true,false)}"
                            value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Core_MDF_Claim_Lookup_Id__r.Id}"> {!relatedTo.Core_MDF_Claim_Number__c} 
                        </apex:outputLink>
                        <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Claim_Submitter__r.UserType != 'PowerPartner',true,false)}"
                             value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Core_MDF_Claim_Lookup_Id__r.Id}"> {!relatedTo.Core_MDF_Claim_Number__c}
                        </apex:outputLink>   
                    </p>
                
                    <p><u>{!$Label.Core_MDF_ClaimName}</u>: {!relatedTo.Core_MDF_Claim_Lookup_Id__r.Title}</p>
                  
                    <p><u>{!$Label.Core_MDF_Case_Cancelled_Body_CaseField}</u>: 
                    <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Claim_Submitter__r.UserType == 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}"> {!relatedTo.CaseNumber} 
                    </apex:outputLink>
                    <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Claim_Submitter__r.UserType != 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}"> {!relatedTo.CaseNumber} 
                    </apex:outputLink>
                    </p>
                    
                    <p><u>{!$Label.Core_MDF_Case_Score}</u>:
                        <apex:outputText rendered="{!FLOOR(relatedTo.Core_MDF_Scorecard_Score_Nbr__c) == 8}">
                             {!$Label.Core_MDF_Scorecard_Explanation1_PV8} <b>{!$Label.Core_MDF_Scorecard_Explanation_Bold_PV8}</b> {!$Label.Core_MDF_Scorecard_Explanation2_PV8}.
                        </apex:outputText>
                        <apex:outputText rendered="{!FLOOR(relatedTo.Core_MDF_Scorecard_Score_Nbr__c) == 4}">
                             {!$Label.Core_MDF_Scorecard_Explanation1_PV4} <b>{!$Label.Core_MDF_Scorecard_Explanation_Bold_PV1}</b> {!$Label.Core_MDF_Scorecard_Explanation3_PV4}.
                        </apex:outputText>
                        <apex:outputText rendered="{!FLOOR(relatedTo.Core_MDF_Scorecard_Score_Nbr__c) == 2}">
                             {!$Label.Core_MDF_Scorecard_Explanation1_PV2} <b>{!$Label.Core_MDF_Scorecard_Explanation_Bold_PV1}</b> {!$Label.Core_MDF_Scorecard_Explanation2_PV1}.
                        </apex:outputText>
                        <apex:outputText rendered="{!FLOOR(relatedTo.Core_MDF_Scorecard_Score_Nbr__c) == 1}">
                             {!$Label.Core_MDF_Scorecard_Explanation1_PV1} <b>{!$Label.Core_MDF_Scorecard_Explanation_Bold_PV1}</b> {!$Label.Core_MDF_Scorecard_Explanation5_PV1}.
                        </apex:outputText>
                        <apex:outputText rendered="{!FLOOR(relatedTo.Core_MDF_Scorecard_Score_Nbr__c) == 0}">
                             {!$Label.Core_MDF_Scorecard_Explanation1_PV0} <b>{!$Label.Core_MDF_Scorecard_Explanation_Bold_PV0}</b> {!$Label.Core_MDF_Scorecard_Explanation2_PV0}.
                        </apex:outputText>
                    </p> 
                    
                    <apex:outputText rendered="{!IF(relatedTo.Core_MDF_Manual_Recovery_Amount_USD_Amt__c != null,true,false)}">
                    <p><u>{!$Label.Core_MDF_Manual_Recovery_New}</u>: <apex:outputText value="{0, number, $0.00}"><apex:param value="{!relatedTo.Core_MDF_Manual_Recovery_Amount_USD_Amt__c}"/></apex:outputText> - <b>{!$Label.Core_MDF_Scorecard_Recovery_Exp_Bold}</b> {!$Label.Core_MDF_Scorecard_Recovery_Exp_New}</p>
                    </apex:outputText>
            
            <p>{!$Label.Core_MDF_Notes_On_Scoring_And_Recovery_Title}</p>
                    <ul>
                    <li>{!$Label.Core_MDF_Scoring_Explanation_1} <a href="{!$Label.Core_MDF_Scoring_Explanation_URL}">{!$Label.Core_MDF_Scoring_Explanation_2}</a>.</li>
                    <li><b>{!$Label.Core_MDF_Scoring_Explanation_3}</b></li>
                    </ul>
                    
                    <p>{!$Label.Core_MDF_Case_Template_Queries_New}</p>
                    
                    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                    <p>{!$Label.Core_MDF_Email_Signature}</p>
                </div> 

               <img src="https://intel.file.force.com/servlet/servlet.ImageServer?id=015Ho000003gyPd&oid=00Do0000000aRcf&lastMod=1720070041000" alt="Intel Logo" width="120" height="48"> </img>
                   
                <div style="font-size:11px;font-family:Calibri">
                    <p>
                        <i>{!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                            <a href="{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/></i>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                        <a href="{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                        <a href="{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}"> {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                        <a href="{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                        <a href="{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                        <a href="{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                    </p>         
                </div> 
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>