<messaging:emailTemplate recipientType="User"
                     relatedToType="PartnerFundClaim"
                     language="en_US"
                     subject="The Audit process for the {!$Label.Core_MDF_EmailSubj1} # {!relatedTo.Core_MDF_Claim_Ref_Number__c} which was on Bank Document Hold has been completed" renderUsingSystemContextWithoutSharing="True">
                      
                     
<messaging:htmlEmailBody >
    <html>
        <body>  <div style="font-size:14px;font-family:Calibri">    
                     
                               <p>      
                                            {!$Label.Core_MDF_EmailTemp_DearIntelemployee} <br/>
                              </p>  
                               <p>          The Audit process for the {!$Label.Core_MDF_EmailSubj1} #&nbsp;
                                            <apex:outputLink value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">{!RelatedTo.Core_MDF_Claim_Ref_Number__c}</apex:outputLink>
                                            which was on Bank Document Hold has been completed{!IF(relatedTo.Core_MDF_Audit_Adjustment_Amount__c>0 , ' with amount change,',
                                            ',')}
                                            please resume the Bank Document process after reviewing the claim.
                                            
                                            
                                            <ul>
                                                <li>{!$Label.Core_MDF_Audit_Creation_Field1}&nbsp;: {!relatedTo.Core_MDF_Claim_Ref_Number__c}</li>
                                                <li>{!$Label.Core_MDF_VATEmailCustomField2}&nbsp;: {!RelatedTo.Core_MDF_AccountCompany__c}</li>                                               
                                                <li>{!$Label.Core_MDF_EmailTemp_Claim_Activity_Name} {!RelatedTo.Request.Title}<br/></li>
                                                <li>{!$Label.Core_MDF_EmailTemp_Activity_Type} {!relatedTo.Core_MDF_Activity_Types__c}</li>
                                                <li>{!$Label.Core_MDF_EmailTemp_Claim_Country} {!RelatedTo.Core_MDF_Country_Location_nm__c}  <br/></li>
                                                <li>{!$Label.Core_MDF_VATEmailCustomField1}&nbsp;: {!relatedTo.Core_MDF_Program__c}</li>
                                                <apex:outputPanel rendered="{!IF(RelatedTo.Core_MDF_Budget_Type_Options_Nm__c != null,true,false)}">
                                                <li>{!$Label.Core_MDF_EmailTemp_Budget_Type}  &nbsp; {!RelatedTo.Core_MDF_Budget_Type_Options_Nm__c }  <br/></li>
                                                </apex:outputPanel>
                                            </ul>
                                </p>
                                           <!-- <p> 
                                            {!$Label.Core_MDF_EmailContent1} &nbsp;
                                            <apex:outputLink value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">{!RelatedTo.Core_MDF_Claim_Ref_Number__c}</apex:outputLink>
                                                  
                                            {!$Label.Core_MDF_EmailContent2}.<br/></p>-->
                                            <p> 
                                            {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7} <br/> <br/>
                                            <!--{!IF(relatedTo.Core_MDF_Program__c == 'Retail Marketing Funds',$Label.Core_MDF_RMF_Program_Team,
                                            IF(relatedTo.Core_MDF_Program__c == 'Intel Partner Alliance',$Label.Core_MDF_IPA_Program_Team,'Program Team'))} -->
                                            {!$Label.Core_MDF_Email_Signature} <br/>                       
            
                               <br/></p>
                               </div>
                               
        </body>
    </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>