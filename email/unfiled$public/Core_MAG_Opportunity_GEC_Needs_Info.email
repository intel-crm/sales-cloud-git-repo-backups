<o:shapelayout v:ext="edit">
<o:idmap v:ext="edit" data="1" />
</o:shapelayout></xml><![endif]--></head><body lang=EN-US link="#0563C1" vlink="#954F72"><div class=WordSection1><p class=MsoNormal>Hello {!Opportunity.OwnerFullName},<o:p></o:p></p><p class=MsoNormal><o:p>&nbsp;</o:p></p><p class=MsoNormal style='line-height:14.65pt;vertical-align:baseline'>Thank you for completing the MAG Questionnaire for your MAG opportunity referenced in the subject line. &nbsp;GEC (Global Export Compliance) has completed the initial review and has additional questions.&nbsp; Please provide your response in SFDC: <a href="{!Opportunity.Core_Org_URL__c}apex/Core_MAGQuestionnaire?OpportunityID={!Opportunity.Id}">{!Opportunity.Core_Org_URL__c}apex/Core_MAGQuestionnaire?OpportunityID={!Opportunity.Id}</a>.<o:p></o:p></p><p class=MsoNormal style='line-height:14.65pt;vertical-align:baseline'><o:p>&nbsp;</o:p></p><p class=MsoNormal style='line-height:14.65pt;vertical-align:baseline'><span style='color:black'>Global Export Compliance / GTT<o:p></o:p></span></p><p class=MsoNormal><span style='color:black'><a href="mailto:Export.customer@intel.com">Export.customer@intel.com</a> <o:p></o:p></span></p><p class=MsoNormal><o:p>&nbsp;</o:p></p><p class=MsoNormal><o:p>&nbsp;</o:p></p></div></body></html>