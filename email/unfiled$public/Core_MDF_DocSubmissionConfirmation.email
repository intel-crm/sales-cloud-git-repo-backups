<messaging:emailTemplate subject="{!$Label.Core_MDF_DocHoldClosureNotificationSubject}{!RelatedTo.Core_MDF_Claim_Ref_Number__c}" 
                         recipientType="User" 
                         relatedToType="PartnerFundClaim" 
                         language="{!relatedTo.Core_MDF_Owner_Language_Locale_Key_txt__c}" 
                         renderUsingSystemContextWithoutSharing="True">
<messaging:htmlEmailBody >
<html>
<body>
     <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Alert}</p>
     <p>{!IF(relatedTo.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner',$Label.Core_MDF_EmailTemp_StatusUpdate_DearMember,$Label.Core_MDF_EmailTemp_DearIntelemployee)}<br/><br/>
     {!$Label.Core_MDF_DocHold_EmailTemplate_Body3}<br/><br/>
     {!$Label.Core_MDF_DocHold_EmailTemplate_Field1}&nbsp;<apex:outputField value="{!RelatedTo.Core_MDF_Status__c}" />.<br/>      
     <br/>{!$Label.Core_MDF_Audit_Creation_Field1}: {!RelatedTo.Core_MDF_Claim_Ref_Number__c}
     <br/>{!$Label.Core_MDF_Audit_Creation_Field2} {!RelatedTo.Request.Title} 
     <br/>{!$Label.Core_MDF_Audit_Creation_Field3} {!RelatedTo.Core_MDF_Campaign_Id__r.Name} 
     <br/>{!$Label.Core_MDF_Audit_Creation_Field4} {!RelatedTo.Core_MDF_Activity_Types__c}
     <br/>{!$Label.Core_MDF_Audit_Creation_Field5}&nbsp;<apex:outputField value="{!RelatedTo.Core_MDF_Country_Location_nm__c}" />
     <br/>{!$Label.Core_MDF_Amount}: ${!RelatedTo.Core_MDF_Requested_Reimbursement_Amt__c}</P>
     
     <p> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}<br/>
     <!--{!$Label.Core_MDF_Audit_Creation_Body8}-->
     {!$Label.Core_MDF_Email_Signature}</p>
</body>   
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>