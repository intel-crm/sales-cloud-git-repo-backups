<messaging:emailTemplate renderUsingSystemContextWithoutSharing="true"
                         subject="{!relatedTo.Core_MDF_Account__r.Name} {!IF(relatedTo.Core_MDF_Program__c == $Label.Core_MDF_Co_GTM_Technical_program_name, 
                                 $Label.Core_MDF_Project_Status_Approved, 
                                 $Label.Core_MDF_Proposal_Status_Approved)}"
                         recipientType="User"  
                         relatedToType="Campaign"
                         language="{!relatedTo.Owner.LanguageLocaleKey}">
    <messaging:htmlEmailBody >
        <html>
            <body>     
                <p>{!IF(relatedTo.Owner.UserType == 'PowerPartner',$Label.Core_MDF_EmailTemp_DearIntelPartner,$Label.Core_MDF_EmailTemp_DearIntelemployee)}</p>
                
                <p>{!IF(relatedTo.Core_MDF_Program__c == $Label.Core_MDF_Co_GTM_Technical_program_name,IF(relatedTo.Owner.UserType == 'PowerPartner',$Label.Core_MDF_CoGTM_EmailTemp_Body1,$Label.Core_MDF_CoGTM_EmailTemp_Body2),
                    IF(relatedTo.Owner.UserType == 'PowerPartner',$Label.Core_MDF_IPA_EmailTemp_Body1,$Label.Core_MDF_IPA_EmailTemp_Body2))}</p>

                <apex:outputPanel rendered="{!IF(RelatedTo.CreatedBy.UserType != 'PowerPartner',true,false)}">   
                    <p><span>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_IPA_EmailTemp_Field1} </span>{!relatedTo.Core_MDF_Account__r.Name}</p>
                </apex:outputPanel> 
                <p>&nbsp; &nbsp; &nbsp; {!IF(relatedTo.Core_MDF_Program__c == $Label.Core_MDF_Co_GTM_Technical_program_name,$Label.Core_MDF_CoGTM_EmailTemp_Field2+ ' ',$Label.Core_MDF_IPA_EmailTemp_Field2+ ' ')} 
                    <apex:outputLink rendered="{!IF(relatedTo.Owner.UserType == 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}">{!relatedTo.Name}
                    </apex:outputLink>
                    <apex:outputLink rendered="{!IF(relatedTo.Owner.UserType != 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">{!relatedTo.Name}                  
                    </apex:outputLink>
                </p>
                <p>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemp_Status}&nbsp;<apex:outputText value="{!IF(relatedTo.Status = 'Planned',
                      $Label.Core_MDF_CampaignStatus_Planned,
                      IF(relatedTo.Status = 'In Progress',$Label.Core_MDF_CampaignStatus_InProgress,relatedTo.Status))}" />
                </p>     
                <apex:outputPanel rendered="{!relatedTo.Core_MDF_Program__c != $Label.Core_MDF_Co_GTM_Technical_program_name}">
                    <p><span>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_Country_Location}&nbsp;{!relatedTo.Core_MDF_Market__c}</span></p>
                </apex:outputPanel>
                <p><span>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemplateField_StartDate}</span>
                    <apex:outputText value=" {0, date, MMMM d','  yyyy}">
                        <apex:param value="{!relatedTo.StartDate}"/>
                    </apex:outputText>
                </p>
                <p><span>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemplateField_EndDate}</span>
                    <apex:outputText value=" {0, date, MMMM d','  yyyy}">
                        <apex:param value="{!relatedTo.EndDate}"/>
                    </apex:outputText>
                </p>
                <p><span>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemplateField_Priority}&nbsp;{!IF(relatedTo.Core_MDF_Program__c == $Label.Core_MDF_Co_GTM_Technical_program_name, relatedTo.Core_MDF_Priority__c, relatedTo.Core_MDF_IPA_Priority_nm__c)}</span></p>
                <apex:outputPanel rendered="{!relatedTo.Core_MDF_Program__c != $Label.Core_MDF_Co_GTM_Technical_program_name}">
                    <p><span>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemp_Focus_Area}&nbsp;{!relatedTo.Core_MDF_Focus_Area_nm__c}</span></p>
                </apex:outputPanel>
                <p><span>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_EmailTemp_Budget_amount}&nbsp;<apex:outputText value="{0,number,$#,##0.00}"><apex:param value="{!relatedTo.Core_MDF_Reimbursement_Amt__c}" /></apex:outputText></span></p>
                <p><span>&nbsp; &nbsp; &nbsp; {!$Label.Core_MDF_IPA_Comments}:&nbsp;{!IF(relatedto.Core_MDF_Comments_Appvr_Only_txt__c != null,relatedto.Core_MDF_Comments_Appvr_Only_txt__c, "")}</span></p>
     
                <p>
                    <apex:outputLink rendered="{!IF(relatedTo.Owner.UserType == 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}">{!$Label.Core_MDF_IPA_EmailTemp_Link1} 
                    </apex:outputLink>
                    <apex:outputLink rendered="{!IF(relatedTo.Owner.UserType != 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">{!$Label.Core_MDF_IPA_EmailTemp_Link1}                    
                    </apex:outputLink>&nbsp;{!IF(relatedTo.Core_MDF_Program__c = $Label.Core_MDF_Co_GTM_Technical_program_name,$Label.Core_MDF_CoGTM_EmailTemp_Link4,$Label.Core_MDF_IPA_EmailTemp_Link4)}                  
                </p>
                <p></p>

                <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                <p>{!$Label.Core_MDF_Email_Signature}</p>
                <img src="https://intel.file.force.com/servlet/servlet.ImageServer?id=015Ho000003gyPd&oid=00Do0000000aRcf&lastMod=1720070041000" alt="Intel Logo" width="120" height="48"> </img>        
                <div style="font-size:11px;font-family:Calibri">
                    <p>
                        <i>  {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/></i>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                    </p>         
                </div> 
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>