<messaging:emailTemplate subject="{!RelatedTo.ChannelPartner.Name} {!$Label.Core_MDF_Claim_Approved_email}"
                         recipientType="User"
                         relatedToType="PartnerFundClaim"
                         renderUsingSystemContextWithoutSharing="true"
                         language="{!RelatedTo.Core_MDF_Owner_Language_Locale_Key_txt__c}">
    <messaging:htmlEmailBody >
        <html>
            <body>
                <div style="font-size:14px; font-family:Calibri">
                    <p><span style="color: #ff0000;"><strong>{!$Label.Core_MDF_IPA_EmailTemp_ActionReq}</strong></span></p>
                    <p>{!$Label.Core_MDF_EmailTemp_DearIntelPartner}</p>
                    <p>The following claim has been approved:</p>
                    <ul>
                        <li>{!$Label.Core_MDF_IPA_EmailTemp_Field1} {!RelatedTo.ChannelPartner.Name}</li>
                        <li>{!$Label.Core_MDF_EmailTemp_Subj1}: {!RelatedTo.Core_MDF_Claim_Ref_Number__c}</li>
                        <li>{!$Label.Core_MDF_ClaimName}: <a href="{!$Label.Core_MDF_PFRDetailLink}{!RelatedTo.Id}">{!RelatedTo.Title}</a></li>
                        <li>{!$Label.Core_MDF_ClaimStartDate}:
                            <apex:outputText value="{0, date, MMMM d',' yyyy}">
                                <apex:param value="{!RelatedTo.Core_MDF_Ad_Run_Start_Date__c}" />
                            </apex:outputText>
                        </li>
                        <li>{!$Label.Core_MDF_ClaimEndDate}:
                            <apex:outputText value="{0, date, MMMM d',' yyyy}">
                                <apex:param value="{!RelatedTo.Core_MDF_Ad_Run_End_Date__c}" />
                            </apex:outputText>
                        </li>
                        <li>{!$Label.Core_MDF_Reimbursement_Amount_email}:&nbsp;<apex:outputText value="{0,number,$#,##0.00}"><apex:param value="{!relatedTo.Core_MDF_Requested_Reimbursement_Amt__c}" /></apex:outputText></li>
                        <li>Activity #: {!RelatedTo.Request.Core_MDF_Activity_Number__c}</li>
                        <li>Activity Name: <a href="{!$Label.Core_MDF_PFRDetailLink}{!RelatedTo.RequestId}">{!RelatedTo.Request.Title}</a></li>
                        <li>Budget Type: {!RelatedTo.Core_MDF_Budget_Type_Nm__c}</li>
                        <li>{!$Label.Core_MDF_IPA_Approver_Comment} {!RelatedTo.Core_MDF_Comments_Appvr_Only_txt__c}</li>
                    </ul>

                    <p> 
                        {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}<br/><br/>
                        {!$Label.Core_MDF_Email_Signature}<br/>                       
                    </p>
                    <img src="https://intel--crmdevccp.sandbox.my.salesforce.com/servlet/servlet.ImageServer?id=015Dz000001d315&oid=00Dg0000006V1T1&lastMod=1716872609000" alt="Intel Logo" width="120" height="48"> </img>
                    <div style="font-size:11px;font-family:Calibri">
                        <p>
                            <i>  {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/></i>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                         </p>
                   </div> 
                </div>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>