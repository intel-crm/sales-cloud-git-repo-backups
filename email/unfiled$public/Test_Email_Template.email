<messaging:emailTemplate recipientType="User" 
                         relatedToType="Case"
                         language="{!relatedTo.createdby.LanguageLocaleKey}" 
                         subject="Claim Case Score for Claim # {!relatedTo.Core_MDF_Claim_Number__c} {!$Label.Core_MDF_Email_Is} {!FLOOR(relatedTo.Core_MDF_Scorecard_Score_Nbr__c)}"  renderUsingSystemContextWithoutSharing="True">
    <messaging:htmlEmailBody >
        <html>
            <body>
                <div style="font-size:14px;font-family:Calibri">        
                      
                    <p>{!$Label.Core_MDF_ClaimNumber}: 
                        <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Claim_Lookup_Id__r.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner',true,false)}"
                            value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Core_MDF_Claim_Lookup_Id__r.Id}">&nbsp;{!relatedTo.Core_MDF_Claim_Number__c} 
                        </apex:outputLink>
                        <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Claim_Lookup_Id__r.Core_MDF_Owner_UserType_Txt__c != 'PowerPartner',true,false)}"
                             value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Core_MDF_Claim_Lookup_Id__r.Id}">&nbsp;{!relatedTo.Core_MDF_Claim_Number__c}
                        </apex:outputLink>   
                    </p>
                    <!--<li>{!$Label.Core_MDF_ClaimNumber} : <a href="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}"> {!relatedTo.Core_MDF_Claim_Ref_Number__c}</a></li><br/> -->
                
                    <p>{!$Label.Core_MDF_ClaimName}: {!relatedTo.Core_MDF_Claim_Lookup_Id__r.Title}</p>
                  
                    <p>{!$Label.Core_MDF_Case_Cancelled_Body_CaseField}: 
                    <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Claim_Lookup_Id__r.Core_MDF_Owner_UserType_Txt__c == 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}">&nbsp;{!relatedTo.CaseNumber} 
                    </apex:outputLink>
                    <apex:outputLink rendered="{!IF(relatedTo.Core_MDF_Claim_Lookup_Id__r.Core_MDF_Owner_UserType_Txt__c != 'PowerPartner',true,false)}"
                        value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">&nbsp;{!relatedTo.CaseNumber} 
                    </apex:outputLink>
                    </p>
                    <!-- <li>{!$Label.Core_MDF_Case_Cancelled_Body_CaseField} : <a href="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}"> {!relatedTo.Core_MDF_Claim_Ref_Number__c}</a></li><br/> -->
                
                    <p>Case Score: {!FLOOR(relatedTo.Core_MDF_Scorecard_Score_Nbr__c)}</p>
                
                    <p>Manual Recovery: {!relatedTo.Core_MDF_Manual_Recovery_Amount_USD_Amt__c}</p>
                    <p>If you have any questions, please reach out to your Intel Account Representative or Program Support.</p>
                    <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                    <p>{!$Label.Core_MDF_Email_Signature}</p> 
                      
                </div>
                <div style="font-size:11px;font-family:Calibri">
                                   <p>
                                     <i>  {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                                           <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/></i>
                                            {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                                           {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                            </p>         
                    
                    </div> 
                  
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>