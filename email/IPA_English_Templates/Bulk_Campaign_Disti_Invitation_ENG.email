<!DOCTYPE html> <html xmlns=http://www.w3.org/1999/xhtml lang="en" xml:lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office"><head> <meta http-equiv="Content-Type" content="text/html; charset=utf-8"> <meta name="viewport" content="width=device-width"> <link rel="icon" type="image/png" sizes="32x32" href=https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{cbee19c7-84da-4759-aac0-9d3ea9f86b7f}_TemplateFavicon-32x32.png> <title>As a Developer Zone Premier user, you are now eligible to join Intel® Partner Alliance!</title> <!--[if gte mso 9]> <xml> <o:OfficeDocumentSettings> <o:AllowPNG/> <o:PixelsPerInch>96</o:PixelsPerInch> </o:OfficeDocumentSettings> </xml> <![endif]--> <!--[if gte mso 9]> <style> sup { font-size: 100% !important; } a {text-decoration: none;} </style> <![endif]--> </head> <body style="background:#efefef;-moz-box-sizing:border-box;-ms-text-size-adjust:100%;-webkit-box-sizing:border-box;-webkit-text-size-adjust:100%;box-sizing:border-box;color:#262626;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;line-height:24px;margin:0;min-width:100%;padding:0;text-align:left;width:100%!important"> <table role="presentation" bgcolor="#efefef" border="0" cellspacing="0" cellpadding="0" class="body" valign="top" width="100%"> <tbody> <tr> <th align="center" valign="top" style="padding-top:24px;width:670px;"> <center style="min-width:0!important;width:100%"> <!-- BEGIN EMAIL BODY --> <table role="presentation" align="center" style = "background-color:#262626;" border="0" class="container" cellspacing="0" cellpadding="0" width="670"> <tbody> <tr> <th> <!-- START HEADER --> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody><tr> <th class="small-12 columns pad-bottom-24" style="padding-left:80px;padding-top:40px;text-align:left;width:100%"> <img src=https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{1ea7a4b0-77fb-4bf8-8fca-195a2ccec135}_347x108-Intel-IPA-logo.png alt="" style="display:block;height:54px;width:174px;" height="54" valign="top" width="174"> </th> </tr> </tbody></table> <table role="presentation" align="right" border="0" cellpadding="0" cellspacing="0" class="show-for-large" valign="top" width="80"> </table> <!-- END HEADER --> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th class="small-12 columns" style="padding-left:80px;padding-right:80px;width:510px;"> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="middle" width="100%"> <tbody><tr> <th class="small-12" style="width:210px;" valign="bottom"> <table role="presentation" border="0" cellspacing="0" cellpadding="0" class="show-for-large" valign="top" width="100%"> <tbody> <tr> <th style="line-height:24px;font-size:24px;" height="24">&nbsp;</th> </tr> </tbody> </table> <img src=https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{9fe13c0f-6051-4353-9666-41b69885ff6c}_hero_%281%29.jpg alt="" class="responsive" style="display:block;height:210px;width:210px;" height="210" valign="top" width="210"> </th> <th class="small-12 columns" style="background:#000000;width:310px;" valign="middle"> <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" class="collapse" width="100%"> <tbody> <tr> <th class="small-12 columns pad-bottom-24 pad-top-24" style="padding:0;padding-bottom:32px;padding-top:32px;padding-left:36px;padding-right:36px;"> <h1 style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:30px;font-weight:400;hyphens:none;line-height:36px;margin:0;margin-bottom:24.5px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Gain extra benefits in addition to the value of Developer Zone Premier!</h1> <!-- OPTIONAL NON-BUTTON LINK - UNCOMMENT TO USE <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> <a href=https://www.intel.com target="_blank" style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;text-decoration:none;"><span style="text-decoration:underline;">Call to action</span><img src=https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{0230aada-0914-45c2-8d44-ea2c5ae34e04}_arrow_email_white.png valign="middle" alt=""></a> </p> --> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody><tr> <th style="min-width:200px;"> <!-- START BUTTON --> <table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" width="auto"> <tbody> <tr> <th style="background:#ffffff;padding:10px 24px 10px 24px;"> <a href="https://www.intel.com/content/www/us/en/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#006ABB;display:block;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Join Intel® <br>Partner Alliance<img src=https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{d10a0171-9566-461e-b39d-83894db2af31}_arrow_email_blue.png valign="middle" alt=""></a> </th> </tr> </tbody> </table> <!-- END BUTTON --> </th> </tr> </tbody></table> </th> </tr> </tbody> </table> </th> </tr> </tbody></table> </th> </tr> </tbody> </table> <!-- START CONTENT --> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody><tr> <th class="small-12 columns pad-top-24" style="padding-bottom:48px;padding-left:80px;padding-right:80px;width:510px;"> <br><br> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:16px;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> First Name: {!Contact.FirstName}<br> Last Name: {!Contact.LastName}<br> Username (Email Address):<a href={!Contact.Email} style="color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-weight:400;text-decoration:none" target="_blank">{!Contact.Email}</a> <br> <br><br> The Developer Zone Premier entitlement enables access to Intel Confidential resources and secure content and is now a benefit of the Intel® Partner Alliance. As a valued Developer Zone Premier user, you are now eligible to join the Intel Partner Alliance program immediately. <br><br> Your company is already a valued member of Intel Partner Alliance. This is an opportunity for you to join your colleagues, who are already part of the program and gain access to exclusive, highly valued benefits. A few examples include: <br></p> <ul style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none;list-style-type:disc"> <li style ="margin-left:40px;margin-bottom:20px;">Access to over 800 world-class courses and 30+ competencies and certifications, industry insights, and business forecasts - vital knowledge through <b>Intel® Partner University</b>.</li> <li style ="margin-left:40px;margin-bottom:20px;">Curated, industry-topic, task-focused <b>Activation Zones</b> with the resources to build, market, and sell products and solutions based on Intel® technology.</li> <li style ="margin-left:40px;margin-bottom:20px;">Promote your solutions on our <b>Partner Showcase</b> through your personalized storefront allowing you to connect with thousands of partners and your end-customers throughout the ecosystem.</li> </ul> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> Join now by enrolling as a contact and begin experiencing everything Intel Partner Alliance and Developer Zone Premier have to offer.</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:16px;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> Follow these quick and easy steps:</p> <ol style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> <li style ="margin-left:40px;margin-bottom:20px;">Click <a href="https://www.intel.com/content/www/us/en/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff"><u>Join now</u></a> and follow the prompts* to link you to your company’s account.</li> <li style ="margin-left:40px">Once confirmed you’ll receive an email to log into Intel Partner Alliance.</li> </ol> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> Discover all the benefits the program offers, join Intel Partner Alliance now. </p><br> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody><tr> <th style="min-width:200px;"> <!-- START BUTTON --> <table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" class="small-float-center" width="auto"> <tbody><tr> <th style="background-color:#00C7FD;padding:10px 24px 10px 24px;"> <a href="https://www.intel.com/content/www/us/en/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#262626;display:block;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Click to join<img src=https://intel--crmqa7.sandbox.lightning.force.com/servlet/servlet.ImageServer?id=0153b000005vLic&oid=00DD4000000I0gl valign="middle" alt=""></a> </th> </tr> </tbody></table> <!-- END BUTTON --> <br><br> <br><p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> Need help signing up to be a partner? <a href=https://www.intel.com/content/www/us/en/support.html?elqTrackId=e8aebb5fa57546dab808d4902c25087c&amp;elqTrack=true target="_blank" style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;"><span style="text-decoration:underline;">Contact support</span></a> </p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-top:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> <a href=https://www.intel.com/content/www/us/en/support/articles/000092340/programs/access-entitlement-for-myintel-users.html?wapkw=azure%20mfa%20help&amp;elqTrackId=0f654af1184b4c4a9c97cb0ecda4c3c0&amp;elqTrack=true style="color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-weight:400;text-decoration:none" target="_blank">*<u>Azure Multi-Factor Authentication (MFA) Help</u> </a> </p> </th> </tr> </tbody></table> </th> </tr> </tbody></table> <!-- END CONTENT --> <table role="presentation" align="center" bgcolor="#0095CA" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th> <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" valign="middle" width="100%"> <tbody> <tr> <th align="center" style="padding:10px;"> <div style="vertical-align: middle"><img alt="" height="30" src=https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{04d8272d-eac1-4a18-8060-873796cf5819}_icon_ipa_linkedin.png style="display:inline-block;vertical-align:middle;" valign="middle" width="39"> <a href=https://www.linkedin.com/groups/2965079/?elqTrackId=37baac48d4f24cba9407883e64b74cee&amp;elqTrack=true style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:30px;font-weight:400;text-decoration:none;" target="_blank">Join the Intel® Partner Alliance group on&nbsp;<span style="text-decoration:underline">LinkedIn</span></a><img alt="" src=https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{0230aada-0914-45c2-8d44-ea2c5ae34e04}_arrow_email_white.png style="display:inline-block;vertical-align:middle;" valign="middle"></div> </th> </tr> </tbody> </table> </th> </tr> </tbody> </table> <!-- START SIGNOFF BLADE - UPDATE THE BACKGROUND COLOR ON THE BLADE BY CHANGING THIS TABLE BACKGROUND --> <table role="presentation" align="center" bgcolor="#0068B5" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th> <center> <div style="display:block;"><img align="middle" alt="Connect. Innovate. Grow." src=https://intel--crmqa7.sandbox.lightning.force.com/servlet/servlet.ImageServer?id=0153b000005vLiX&oid=00DD4000000I0gl&lastMod=1687176760000></div> </center> </th> </tr> </tbody> </table> <!-- END SIGNOFF BLADE --> </th> </tr> </tbody> </table> </center> </th> </tr> </tbody> </table> <table class="body footer_elq" style="Margin:0;background-color:transparent;border-colla