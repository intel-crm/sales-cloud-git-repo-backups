                        <!-- END HEADER -->
  
                        <!-- START LEFT ALIGNED CONTENT -->
                        <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                          <tbody>
                            <tr>
                              <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:24px;padding-top:48px;width:510px;">
                                <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">
                                    Dear: {!Contact.FirstName}  {!Contact.LastName} ({!Contact.Email}):<br>
                                    <span style="font-size:14px">Note: Your email address is your username</span>
                                    <br><br>
                                    When you join Intel® Partner Alliance, you will receive access to advanced training, developer resources, marketing and sales tools and support by providing instant access to: 
                                  </p>
                                <ul style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;text-align:left;word-break:keep-all;word-wrap:none">
                                  <li style="margin-bottom:16px;">Thought leadership from Intel® and industry experts transforming businesses with technology, strategies, and best practices 
                                  </li>
                                  <li style="margin-bottom:16px;">Sales and technology training for all levels to showcase expertise 
                                  </li>
                                  <li style="margin-bottom:16px;">Regular webinars with technology leaders and Tech Talks with Intel® Solution Architects 
                                  </li>
                                  <li style="margin-bottom:16px;">Forums to participate in discussions centered on innovation, business and technology opportunities 
                                  </li>
                                  <li style="margin-bottom:16px;">Access to a robust network of ecosystem partners and cloud system architects 
                                  </li>                                  
                              </ul> 
                              <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">
                                Become a part of our growing partner ecosystem.<br><br>Take a few moments to complete your registration and get started today. 
                              </p>                               
                                <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                    <tbody><tr>
                                        <th style="min-width:200px;">
                                            <!-- START BUTTON -->
                                            <table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" valign="top" width="auto">
                                            <tbody>
                                                <tr>
                                                <td style="background:#00C7FD;padding:10px 24px 10px 24px;">
                                                    <a href="{{EVLINK}}" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;mso-hyphenate:none;color:#262626;display:block;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Click to join&sup1;<img src="{!$Label.Core_MDF_PFRDetailLink}/servlet/servlet.ImageServer?id=0153b000005vLic&oid=00Do0000000aRcf&lastMod=1687176913000" valign="middle" alt=""></a>
                                                </td>
                                                </tr>
                                            </tbody>
                                            </table>
                                            <!-- END BUTTON -->
                                        </th>
                                    </tr>
                                </tbody>
                            </table>
                            <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:16px;margin:0;margin-bottom:24px;margin-top:24px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">
                              &sup1;Enter your email address and then 'Continue', do not choose 'Create an Account'</p> 
                              </th>
                            </tr>
                          </tbody>
                        </table>
