                                                                    <td style="background:#00C7FD;padding:10px 24px 10px 24px;">
                                                                      <a href="{{EVLINK}}" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;mso-hyphenate:none;color:#262626;display:block;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Click to join&sup1;<img src="{!$Label.Core_MDF_PFRDetailLink}/servlet/servlet.ImageServer?id=0153b000005vLic&oid=00Do0000000aRcf&lastMod=1687176913000" valign="middle" alt=""></a>
