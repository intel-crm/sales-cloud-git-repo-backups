                        <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                          <tbody><tr>
                            <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:48px;">
                              <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tbody>
                                  <tr>
                                    <th class="small-12 columns" style="background:#0054AE;padding:32px;">
                                        
                                        <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:center;word-break:keep-all;word-wrap:none">
                                          Please click <a href="https://www.intel.com/content/www/us/en/support/topics/azure-sign-in.html" target="_blank" style="color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;text-decoration:underline;">here</a> to read about Intel's new login process.</p>

                                        <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-top:32px;padding:0;text-align:center;word-break:keep-all;word-wrap:none">
                                            Need help signing up to be a partner?<br><a href="https://supporttickets.intel.com/s/supportrequest?language=en_US" target="_blank" style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;"><span style="text-decoration:underline;">Contact support</span></a>
                                        </p>
                                    </th>
                                  </tr>
