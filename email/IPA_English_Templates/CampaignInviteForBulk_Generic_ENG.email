                                                <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%" class="collapse no-mobile-border" style="border-left:3px solid #00C7FD;border-bottom:3px solid #00C7FD;">
                                                  <tbody><tr>
                                                    <th align="left" class="small-12 columns" style="padding:0 32px;width:290px" valign="top">
                                                      <img src="{!$Label.Core_MDF_PFRDetailLink}/servlet/servlet.ImageServer?id=0153b000005vLj1&oid=00Do0000000aRcf&lastMod=1687177298000" alt="" style="display:block;height:54px;width:174px;" height="54" valign="top" width="174">
                                                      <h1 style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;mso-hyphenate:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:25px;font-weight:400;hyphens:none;line-height:32px;margin:0;margin-bottom:24px;margin-top:24px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">
                                                        Get Started Today</h1>
                                                      <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" valign="top" width="100%">
                                                        <tbody>
                                                          <tr>
                                                            <th style="padding-bottom:24px;">
                                                              <!-- START BUTTON -->
                                                              <table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" valign="top" width="auto">
