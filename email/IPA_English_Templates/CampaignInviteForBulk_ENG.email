                                            <tbody><tr>
                                                <th class="show-for-large" style="padding:0;vertical-align:top;width:80px;" valign="top" width="80">&nbsp;</th>
                                                <th class="small-12 columns" style="vertical-align:top;width:510px" valign="top" width="510">
                                                    <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                                        <tbody><tr>
                                                            <th class="bottom"   style="background-color:#000000;padding-left:24px;padding-right:24px;width:50%" valign="middle">
                                                                <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                                                    <tbody><tr>
                                                                        <th class="columns pad-top-24 pad-bottom-24">
                                                                             <h2 style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:25px;font-weight:400;hyphens:none;line-height:32px;margin:0;margin-bottom:10px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">
                                                                                Act Now to Retain Your Access to Developer Zone</h2>
                                                                           

                                                                        </th>
                                                                    </tr>
                                                                </tbody></table>
                                                                <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                                                    <tbody><tr>
                                                                        <th style="min-width:200px;">
                                                                            <!-- START BUTTON -->
                                                                            <table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0"  width="auto">
            
                                                                                    <tbody><tr>
                                                                                        <th style=" background-color:#00C7FD;padding:10px 24px 10px 24px;">
                                                                                            <a href="{{EVLINK}}" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#262626;display:block;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Join Intel<sup>&reg;</sup>   Partner Alliance now<img src=https://intel--crmqa7.sandbox.lightning.force.com/servlet/servlet.ImageServer?id=0153b000005vLic&oid=00DD4000000I0gl valign="middle" alt=""></a>
                                                                                        </th>
                                                                                    </tr>
            
                                                                            </tbody></table>
                                                                            <!-- END BUTTON -->
                                                                        </th>
