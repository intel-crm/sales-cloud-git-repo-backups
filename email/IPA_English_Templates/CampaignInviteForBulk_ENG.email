                                                                    <tbody><tr>
                                                                        <th class="small-12 columns" style="vertical-align:bottom;width:100%;">
                                                                            <!-- START SPACER -->
                                                                            <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" class="show-for-large" width="100%">
                                                                                <tbody>
                                                                                    <tr>
                                                                                        <th align="center" style="font-size:40px;line-height:40px;width:100%" height="40">
                                                                                        </th>
                                                                                    </tr>
                                                                                </tbody>
                                                                            </table>
                                                                            <!-- END SPACER -->
                                                                            <img src=https://intel.file.force.com/servlet/servlet.ImageServer?id=0153b000005vLiw&oid=00Do0000000aRcf&lastMod=1687177231000 alt="" class="responsive" style="display:block;height:255px;vertical-align:bottom;width:255px;" height="255" valign="bottom" width="255">
                                                                        </th>
