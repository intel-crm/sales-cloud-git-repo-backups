                    <table width="100%" border="0" cellpadding="0" cellspacing="0" class="full-width" style="font-size:1px; line-height:1%; mso-line-height-rule: exactly; max-width:670px;"><tr><td><a href="https://www-ssl.intel.com/content/www/us/en/technology-provider/cloud-specialty-benefits.html" target="_blank"><img src="images/header-cloud-new.jpg" alt="Congratulations on qualifying for Specialty Benefits!" style="width: 100%; display:block; border:none;"/></a></td></tr></table>

