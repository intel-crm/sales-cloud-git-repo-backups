                                                        <img src="{!$Label.Core_MDF_PFRDetailLink}/servlet/servlet.ImageServer?id=0158A000000yytQ&oid=00D8A0000005uU8&lastMod=1653040057000" alt="" class="show-for-large" style="display:block;height:48px;width:48px;" valign="top" height="48" width="48">
