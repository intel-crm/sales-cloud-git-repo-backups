                                        <!-- START CONTENT -->
                                        <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                            <tbody><tr>
                                                <th class="small-12 columns pad-top-24" style="padding-bottom:48px;padding-left:80px;padding-right:80px;width:510px;">
                                                    
                                                    <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">
                                                        First Name: {!Contact.FirstName}<br>
                                                        Last Name: {!Contact.LastName}<br>
                                                        Username (Email Address): {!Contact.Email} <br>
                                                        <span style="font-size:14px">Note your email address is your username. </span>
                                                        <br><br>
                                                        Partner with us to maximize your opportunities, accelerate innovation and grow your business when you join the Intel®  Partner Alliance Program. 
                                                        <br><br>
                                                        Partners receive access to advanced training, developer and marketing resources, technical support, the partner showcase, and an exclusive network of ecosystem partners.
                                                        <br><br>
                                                        Become a part of our growing partner ecosystem.
                                                        <br><br>
                                                       Take a few moments to complete your registration and get started today. 
                                                       
                                                    </p>
                                                    <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                                        <tbody><tr>
                                                            <th style="min-width:200px;">
                                                                <!-- START BUTTON -->
                                                                <table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" class="small-float-center" width="auto">

                                                                        <tbody><tr>
                                                                            <th style="background:#00C7FD ;padding:10px 24px 10px 24px;">
                                                                                <a href="{{EVLINK}}" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#262626;display:block;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Click to join<img src="{!$Label.Core_MDF_PFRDetailLink}/servlet/servlet.ImageServer?id=0158A000000yyta&oid=00D8A0000005uU8&lastMod=1653040816000" valign="middle" alt=""></a>
                                                                            </th>
                                                                        </tr>

                                                                </tbody></table>
                                                                <!-- END BUTTON -->
                                                            </th>
                                                        </tr>
                                                    </tbody></table>
                                                   
                                                    <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-top:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">
                                                        This link will expire in 24 hours – click the existing ‘Click to Join’ link to get a refreshed link.
                                                    </p>
                                                </th>
                                            </tr>
                                        </tbody></table>
                                        <!-- END CONTENT -->
                                        <!-- START POINTS -->
                                        <table border="0" cellspacing="0" cellpadding="0" class="row collapse" width="100%">
                                            <tbody>
                                                <tr>
                                                    <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:80px;width:510px">
                                                        <table role="presentation" align="center" bgcolor="#0068B5" border="0" cellspacing="0" cellpadding="0" width="100%">
                                                            <tbody>
                                                                <tr>
                                                                    <th>
                                                                        <table border="0" cellspacing="0" cellpadding="0" class="row collapse">
                                                                            <tbody>
                                                                                <tr>
                                                                                    <th class="small-12 columns" style="margin:0 auto;padding:0;">
                                                                                        <table role="presentation" border="0" cellspacing="0" cellpadding="0" width="100%">
                                                                                            <tbody>
                                                                                                <tr>
                                                                                                    <th class="callout-inner" style="padding-left:30px;padding-right:30px;padding-top:50px;padding-bottom:50px;width:100%">
                                                                                                        <h3 style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:21px;font-weight:700;hyphens:none;line-height:24px;margin:0;margin-bottom:24px;padding:0;text-align:center;word-break:keep-all;word-wrap:none">
                                                                                                            Reap the benefits of being an Intel partner, register for Intel® Partner Alliance and start with 1,000 points&sup1;</h3>
                                                                                                        <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:center;word-break:keep-all;word-wrap:none">
                                                                                                            Not only does Intel® Partner Alliance offer a large variety of tools to help grow your business, but it also offers Points Benefits, with multiple opportunities to earn &amp; redeem points for eligible purchases, training, and other activities. If you haven’t registered, now is the perfect time. <a href="https://www.intel.com/content/www/us/en/partner-alliance/legal/program-terms-and-conditions.html" target="_blank" style="color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;text-decoration:underline;">See the points terms and conditions</a>.</p>

                                                                                                        <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-top:32px;padding:0;text-align:center;word-break:keep-all;word-wrap:none">
                                                                                                            Need help signing up to be a partner?<br><a href="{{SUPPORTLINK}}" target="_blank" style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;"><span style="text-decoration:underline;">Contact support</span><img src="{!$Label.Core_MDF_PFRDetailLink}/servlet/servlet.ImageServer?id=0158A000000yytf&oid=00D8A0000005uU8&lastMod=1653041447000" valign="middle" alt=""></a>
                                                                                                        
                                                                                                            
                                                                                                        </p>
                                                                                                    </th>
                                                                                                </tr>
                                                                                            </tbody>
                                                                                        </table>
                                                                                    </th>
                                                                                </tr>
                                                                            </tbody>
                                                                        </table>
                                                                    </th>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </th>
                                                </tr>
                                            </tbody>
                                        </table>                                        
                                        <!-- END POINTS -->



