ges/clients/IntelCorporation/{1ea7a4b0-77fb-4bf8-8fca-195a2ccec135}_347x108-Intel-IPA-logo.png" alt="" style="display:block;height:54px;width:174px;" height="54" valign="top" width="174"></th> </tr> </table> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th class="small-12 columns" style="padding-left:80px;padding-right:80px;width:510px;"> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="middle" width="100%"> <tr> <th class="small-12" style="width:210px;" valign="bottom"> <table role="presentation" border="0" cellspacing="0" cellpadding="0" class="show-for-large" valign="top" width="100%"> <tbody> <tr> <th style="line-height:24px;font-size:24px;" height="24">&nbsp;</th> </tr> </tbody> </table><img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{9fe13c0f-6051-4353-9666-41b69885ff6c}_hero_%281%29.jpg" alt="" class="responsive" style="display:block;height:210px;width:210px;" height="210" valign="top" width="210"></th> <th class="small-12 columns" style="background:#000000;width:310px;" valign="middle"> <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" class="collapse" width="100%"> <tbody> <tr> <th class="small-12 columns pad-bottom-24 pad-top-24" style="padding:0;padding-bottom:32px;padding-top:32px;padding-left:36px;padding-right:36px;"> <h1 style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:30px;font-weight:400;hyphens:none;line-height:36px;margin:0;margin-bottom:24.5px;padding:0;text-align:left;word-break:normal;word-wrap:normal">加入英特尔&#xfeff;&reg; 合作伙伴联盟，全面赋能开发人员，解锁更多权益 ！</h1><!-- OPTIONAL NON-BUTTON LINK - UNCOMMENT TO USE <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;padding:0;text-align:left;word-break:normal;word-wrap:normal"> <a href="https://www.intel.com" target="_blank" style="color:#fff;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;text-decoration:none;"><span style="text-decoration:underline;">Call to action</span><img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{0230aada-0914-45c2-8d44-ea2c5ae34e04}_arrow_email_white.png" valign="middle" alt=""></a> </p> --><table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tr> <th style="min-width:200px;"><!-- START BUTTON --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" width="auto"> <tbody> <tr> <th style="background:#ffffff;padding:10px 24px 10px 24px;"><a href="https://www.intel.com/content/www/cn/zh/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#006ABB;display:block;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:normal;word-wrap:normal">加入英&#xfeff;特&#xfeff;尔&#xfeff;&reg;<br>合作伙伴联盟<img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{d10a0171-9566-461e-b39d-83894db2af31}_arrow_email_blue.png" valign="middle" alt=""></a></th> </tr> </tbody> </table><!-- END BUTTON --></th> </tr> </table> </th> </tr> </tbody> </table> </th> </tr> </table> </th> </tr> </tbody> </table><!-- END HEADER --> <!-- START ACCOUNT INFO --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" width="100%"> <tbody> <tr> <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-top:48px;width:510px;"> <table role="presentation" border="0" cellspacing="0" cellpadding="0" class="collapse" valign="top" width="100%"> <tbody> <tr> <th class="small-12 columns" style="text-align:left;width:255px"> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:0px;padding:0;text-align:left;word-break:normal;word-wrap:normal">尊敬的: {!Contact.FirstName}</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:0px;padding:0;text-align:left;word-break:normal;word-wrap:normal">姓： 名字： {!Contact.LastName} </p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:0px;padding:0;text-align:left;word-break:normal;word-wrap:normal">用户名： {!Contact.Email}</p> </th> </tr> </tbody> </table><br></th> </tr> </tbody> </table><!-- END ACCOUNT INFO --> <!-- START LEFT ALIGNED CONTENT --><table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:24px;width:510px;"> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:normal;word-wrap:normal">开发人员专区高级帐户权益允许用户访问英特尔的机密资源和安全内容，现在也是英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 合作伙伴联盟的一项权益。作为尊贵的开发人员专区高级用户，您现在有资格立即加入英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 合作伙伴联盟计划。</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:normal;word-wrap:normal">贵公司已经是英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 合作伙伴联盟的尊贵会员。这是您与已经加入该计划的同事一起享受独家和高价值权益的机会。下面是几个示例：</p> <ul style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;text-align:left;word-break:normal;word-wrap:normal"> <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">通过<strong>英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 合作伙伴培训计划</strong>获取 800 多门世界领先课程和 30 多种能力认证、以及行业见解，业务预测等重要的知识。</li> <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">通过符合条件的英特尔产品购买和活动参与赚取<strong>积分</strong>，并兑换积分以满足有价值的业务需求。</li> <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">精心策划、以行业为主题、的 <strong>激活专区 </strong>，为您提供有助于构建、推广和销售基于英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 技术的产品和解决方案的资源。</li> <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">通过您的个性化店面在我们的<strong>英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 合作伙伴展厅</strong>上推广您的解决方案，让您能够与整个生态系统中数以千计的合作伙伴和最终客户建立联系。</li> </ul> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin-top:20px;margin-bottom:20px;padding:0;text-align:left;word-break:normal;word-wrap:normal">立即注册，您将为您的公司赢得 100 积分*，并开始体验英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 合作伙伴联盟和开发人员专区高级帐户所提供的一切资源。</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:normal;word-wrap:normal">请按照以下快速简单的步骤操作：</p> <ol style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;text-align:left;word-break:normal;word-wrap:normal"> <li style="margin-bottom:20px;">单击<a href="https://www.intel.com/content/www/cn/zh/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:underline;word-break:normal;word-wrap:normal">&ldquo;立即加入&rdquo;</a>并按照提示**将您链接到您公司的帐户。</li> <li style="margin-bottom:20px;">确认后，您将收到一封用于登录英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 合作伙伴联盟的电子邮&#xfeff;件。</li> </ol> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:normal;word-wrap:normal">了解该计划提供的所有权益，立即加入英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 合作伙伴联盟。</p> <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" valign="top" width="100%"> <tbody> <tr> <th style="padding-top:32px;"><!-- START BUTTON --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" valign="top" width="auto"> <tbody> <tr> <th style="background:#00C7FD ;padding:10px 24px 10px 24px;"><a href="https://www.intel.com/content/www/cn/zh/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#262626;display:block;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:normal;word-wrap:normal">立即加入<img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{3c6395e2-a99d-4d56-af68-36b36f3ef629}_arrow_email_black.png" valign="middle" alt=""></a></th> </tr> </tbody> </table><!-- END BUTTON --></th> </tr> </tbody> </table><br><p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-top:32px;padding:0;text-align:left;word-break:normal;word-wrap:normal">需要帮助以注册成为合作伙伴？<a href="https://www.intel.com/content/www/cn/zh/support.html?elqTrackId=e8aebb5fa57546dab808d4902c25087c&elqTrack=true" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:underline;word-break:normal;word-wrap:normal">请联系客服人&#xfeff;员</a>。</p><br><p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:12px;font-weight:400;hyphens:none;line-height:24px;margin:0;padding:0;text-align:left;word-break:normal;word-wrap:normal">*必须是符合条件的积分。查看资格要求。</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:12px;font-weight:400;hyphens:none;line-height:24px;margin-top:20px;padding:0;text-align:left;word-break:normal;word-wrap:normal"><a href="https://www.intel.com/content/www/cn/zh/support/articles/000092340/programs/access-entitlement-for-myintel-users.html?wapkw=azure%20mfa%20help&elqTrackId=0f654af1184b4c4a9c97cb0ecda4c3c0&elqTrack=true" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:12px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:normal;word-wrap:normal">*<u>Azure 多因素身份验证 (MFA) 帮助</u></a></p> </th> </tr> </tbody> </table><!-- END LEFT ALIGNED CONTENT --> <!-- START IPA SOCIAL RIBBON - UPDATE THE BACKGROUND COLOR ON THE BLADE BY CHANGING THIS TABLE BACKGROUND --><table role="presentation" align="center" bgcolor="#0095CA" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th> <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" valign="middle" width="100%"> <tbody> <tr> <th align="center" style="padding:10px;"> <div style="vertical-align: middle"><img alt="" height="30" src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{04d8272d-eac1-4a18-8060-873796cf5819}_icon_ipa_linkedin.png" style="display:inline-block;vertical-align:middle;" valign="middle" width="39" /> <a href="https://www.linkedin.com/groups/2965079/?elqTrackId=37baac48d4f24cba9407883e64b74cee&elqTrack=true" style="color:#fff;font-family:'Microsoft YaHei','SimHei','Tahoma','Arial','Helvetica','sans-serif';font-size:18px;line-height:30px;font-weight:400;text-decoration:none;" target="_blank">在 <span style="text-decoration:underline">LinkedIn</span> 加入英&#xfeff;特&#xfeff;尔&#xfeff;&reg; 合作伙伴联盟小组</a><img alt="" src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{0230aada-0914-45c2-8d44-ea2c5ae34e04}_arrow_email_white.png" style="display:inline-block;vertical-align:middle;" valign="middle" /></div> </th> </tr> </tbody> </table> </th> </tr> </tbody> </table><!-- END IPA SOCIAL RIBBON --> <!-- START SIGNOFF BLADE - UPDATE THE BACKGROUND COLOR ON THE BLADE BY CHANGING THIS TABLE BACKGROUND --><table role="presentation" valign="top" width="100%" cellspac