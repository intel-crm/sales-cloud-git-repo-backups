<body lang="EN-US" link="blue" vlink="purple" style='tab-interval: .5in'>
<div class="WordSection1">
<table class="MsoNormalTable" border="1" cellpadding="0" width="720" style="width: 7.5in; mso-cellspacing: 1.5pt; background: white; border: solid #E5E5E5 1.0pt; mso-border-alt: solid #E5E5E5 .75pt; mso-yfti-tbllook: 1184; mso-padding-alt: 10.5pt 5.4pt 0in 5.4pt;">
<tbody>
<tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes;">
<td style="border: none; padding: 9.0pt .75pt 3.75pt 35.25pt;">
<p class="MsoNormal"><span style="font-size: 24.0pt; font-family: 'Tahoma','sans-serif'; color: #086db6;"><span> Verify your email address</span></span></p>
</td>
</tr>
<tr>
<td style="border: none; padding: 10.5pt 30.0pt .75pt 27.75pt;"></td>
</tr>
<tr>
<td style="border: none; padding: 10.5pt .75pt .75pt 33.0pt;" id="emailMainDiv">
<table width="720">
<tbody>
<tr style="height: 53px;">
<td style="height: 53px;">
<p><span style="font-size: 11pt; color: #666666;">Hello {!Contact.Name},</span><br /><br /><span style="font-size: 11pt;"><span style="color: #666666;">We are delighted to welcome you to Direct Customer Return Portal! <br/><br/> To activate your account, please click the link: </span> <span style="color: #086db6;"><a href="https://consumerint.intel.com/intelcorpintb2c.onmicrosoft.com/B2C_1A_UnifiedLogin_SISU_PSC_SAML/generic/login?entityId=https://saml.salesforce.com.isvcqa25.returnforcredit"
style="color: #086db6;">link</a></span> </span></p>
</td>
</tr>
<tr style="height: 53px;">
<td style="height: 53px;">
<p><span style="font-size: 11pt; color: #666666;"><strong>Email ID: </strong><span> </span>{!Contact.Email}</span></p>
</td>
</tr>
<tr style="height: 53px;">
<td style="height: 53px;">
<p><span style="font-size: 11pt;"><span style="color: #666666;">If you have any questions, please contact </span> <span style="color: #086db6;"><a href="
https://www-ssl.intel.com/content/www/us/en/company-overview/contact-us.html"
style="color: #086db6;">contact Intel Customer Support</a></span>.</span></p>
</td>
<tr style="height: 53px;">
<td style="height: 53px;">
<p><span style="font-size: 11pt;"><span style="color: #666666;">Thanks.</span></p>
</td>
</tr>
<tr style="height: 53px;">
<td style="height: 53px;">
<p><span style="font-size: 11pt;"><span style="color: #666666;">Please DO NOT reply to this e-mail message. This is an automated response.</span>    </span><br /><span style="font-size: 11pt; color: #666666;">To ensure that you continue receiving our e-mails, please add us to your address book.</span><br /><span style="font-size: 11pt;"><span style="color: #666666;">Visit</span> <span style="color: #086db6;"><a href="
https://www-ssl.intel.com/content/www/us/en/my-intel/manage-profile.html"
style="color: #086db6;">My Intel</a></span> <span style="color: #666666;">any time to manage your profile.                                                  <span> </span></span></span></p>
</td>
</tr>
</tbody>
</table>
</td>
</tr>
<tr>
<td style="border: none; text-align: right;"><footer><p class="MsoNormal" style="line-height: 15.0pt;"><img alt="IntelLogo" src="
https://www.intel.com/content/dam/logos/intel-logo.png"
align="right" height="42" width="64" /><span style="font-family: 'Tahoma','sans-serif'; color: #666666;"></p></footer></td>
</tr>
</tbody>
</table>
