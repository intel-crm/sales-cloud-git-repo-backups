            </tr>
            <tr>
                <td>Organization URL</td>
                <td>{!Organization.instance}</td>
            </tr>
            <tr>
                <td>Installer Email</td>
                <td>{!User.Email}</td>
            </tr>
            <tr>
                <td>Error Messages</td>
