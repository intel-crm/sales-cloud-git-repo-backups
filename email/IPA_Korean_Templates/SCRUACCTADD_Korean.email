                      <tr>
                          <th class="small-12 large-12 columns" style="padding:0;padding-bottom:20px;padding-top:20px;padding-left:0;padding-right:0;width:670px">
                          
  
                          <p class="text-center" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;border-collapse:collapse!important;color:#262626;font-family:'Malgun Gothic','Dotum','Verdana','Tahoma','Arial','Helvetica','sans-serif';font-size:12px;font-weight:400;hyphens:none;line-height:18px;margin:0;margin-bottom:10px;padding:0;text-align:center;word-break:keep-all">&copy; {!$Label.PRM_CurrentYear} Intel&nbsp;Corporation<br>Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054 USA. <a href="http://www.intel.co.kr/content/www/kr/ko/homepage.html" style="color:#0068B5;font-family:'Malgun Gothic','Dotum','Verdana','Tahoma','Arial','Helvetica','sans-serif';font-weight:400;text-decoration:none" target="_blank">www.intel.com</a></p>
  
                          <p class="text-center" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;border-collapse:collapse!important;color:#262626;font-family:'Malgun Gothic','Dotum','Verdana','Tahoma','Arial','Helvetica','sans-serif';font-size:12px;font-weight:400;hyphens:none;line-height:18px;margin:0;margin-bottom:10px;padding:0;text-align:center;word-break:keep-all"><a href="https://www.intel.com/content/www/kr/ko/privacy/intel-privacy-notice.html" style="color:#0068B5;font-family:'Malgun Gothic','Dotum','Verdana','Tahoma','Arial','Helvetica','sans-serif';font-weight:400;line-height:1.3;margin:0;padding:0;text-align:center;text-decoration:none" target="_blank">개인정보처리방침</a>&verbar;<a href="https://www.intel.com/content/www/kr/ko/privacy/intel-cookie-notice.html" style="color:#0068B5;font-family:'Malgun Gothic','Dotum','Verdana','Tahoma','Arial','Helvetica','sans-serif';font-weight:400;line-height:1.3;margin:0;padding:0;text-align:center;text-decoration:none" target="_blank">쿠키</a>&verbar;<a href="http://www.intel.com/content/www/kr/ko/legal/trademarks.html" style="color:#0068B5;font-family:'Malgun Gothic','Dotum','Verdana','Tahoma','Arial','Helvetica','sans-serif';font-weight:400;line-height:1.3;margin:0;padding:0;text-align:center;text-decoration:none" target="_blank">*상표</a> &verbar; <a href="https://plan.seek.intel.com/Eloqua-Global-Unsub-Privacy" style="color:#0068B5;font-family:'Malgun Gothic','Dotum','Verdana','Tahoma','Arial','Helvetica','sans-serif';font-weight:400;line-height:1.3;margin:0;padding:0;text-align:left;text-decoration:none" target="_blank">수신 거부</a></p>
  
