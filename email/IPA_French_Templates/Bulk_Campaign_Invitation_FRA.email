://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{1ea7a4b0-77fb-4bf8-8fca-195a2ccec135}_347x108-Intel-IPA-logo.png" alt="" style="display:block;height:54px;width:174px;" height="54" valign="top" width="174"></th> </tr> </table> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th class="small-12 columns" style="padding-left:80px;padding-right:80px;width:510px;"> <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="middle" width="100%"> <tr> <th class="small-12" style="width:210px;" valign="bottom"> <table role="presentation" border="0" cellspacing="0" cellpadding="0" class="show-for-large" valign="top" width="100%"> <tbody> <tr> <th style="line-height:24px;font-size:24px;" height="24">&nbsp;</th> </tr> </tbody> </table><img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{9fe13c0f-6051-4353-9666-41b69885ff6c}_hero_%281%29.jpg" alt="" class="responsive" style="display:block;height:210px;width:210px;" height="210" valign="top" width="210"></th> <th class="small-12 columns" style="background:#000000;width:310px;" valign="middle"> <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" class="collapse" width="100%"> <tbody> <tr> <th class="small-12 columns pad-bottom-24 pad-top-24" style="padding:0;padding-bottom:32px;padding-top:32px;padding-left:36px;padding-right:36px;"> <h1 style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:22px;font-weight:400;hyphens:none;line-height:28px;margin:0;margin-bottom:24.5px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Bénéficiez d'avantages supplémentaires en plus de ceux offerts aux utilisateurs Premier de la Zone des développeurs&nbsp;!</h1><!-- OPTIONAL NON-BUTTON LINK - UNCOMMENT TO USE <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;padding:0;text-align:left;word-break:keep-all;word-wrap:none"> <a href="https://www.intel.com" target="_blank" style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;text-decoration:none;"><span style="text-decoration:underline;">Call to action</span><img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{0230aada-0914-45c2-8d44-ea2c5ae34e04}_arrow_email_white.png" valign="middle" alt=""></a> </p> --><table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tr> <th style="min-width:200px;"><!-- START BUTTON --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" width="auto"> <tbody> <tr> <th style="background:#ffffff;padding:10px 24px 10px 24px;"><a href="https://www.intel.com/content/www/fr/fr/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#006ABB;display:block;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Rejoindre l'Alliance<br>partenaire Intel&reg;<img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{d10a0171-9566-461e-b39d-83894db2af31}_arrow_email_blue.png" valign="middle" alt=""></a></th> </tr> </tbody> </table><!-- END BUTTON --></th> </tr> </table> </th> </tr> </tbody> </table> </th> </tr> </table> </th> </tr> </tbody> </table><!-- END HEADER --> <!-- START ACCOUNT INFO --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" width="100%"> <tbody> <tr> <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-top:48px;width:510px;"> <table role="presentation" border="0" cellspacing="0" cellpadding="0" class="collapse" valign="top" width="100%"> <tbody> <tr> <th class="small-12 columns" style="text-align:left;width:255px"> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:0px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Prénom&nbsp;:</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:0px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Nom&nbsp;:</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:0px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Nom d'utilisateur (adresse e-mail)&nbsp;:</p> </th> </tr> </tbody> </table><!-- START SPACER --><table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th style="font-size:32px;line-height:32px;width:100%" height="32"></th> </tr> </tbody> </table><!-- END SPACER --></th> </tr> </tbody> </table><!-- END ACCOUNT INFO --> <!-- START LEFT ALIGNED CONTENT --><table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:24px;width:510px;"> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Les utilisateurs Premier de la Zone des développeurs ont accès aux ressources classées Confidentiel Intel et à des contenus sécurisés. Cela fait désormais partie des avantages offerts par l'Alliance partenaire Intel&reg;. En tant qu'utilisateur Premier de la Zone des développeurs, vous êtes désormais éligible à rejoindre le programme Alliance partenaire Intel&reg;.</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Votre entreprise est déjà un membre important de l'Alliance partenaire Intel&reg;. C'est l'occasion pour vous de rejoindre vos collègues membres du programme et d'accéder à des avantages exclusifs de grande valeur. En voici quelques exemples&nbsp;:</p> <ul style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;text-align:left;word-break:keep-all;word-wrap:none"> <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">Accédez à plus de 800&nbsp;cours de classe mondiale, à plus de 30&nbsp;compétences et certifications, à des informations sur le secteur et à des prévisions commerciales, autant de connaissances indispensables fournies par l'<strong>Université partenaire Intel&reg;</strong>.</li> <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">Gagnez des <strong>points</strong> grâce à des achats de produits Intel éligibles et à des activités pour vous aider à développer votre activité. Échangez des points contre des services utiles à votre entreprise.</li> <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">Profitez de <strong>Zones d'activation</strong> organisées et axées sur des thèmes et des tâches spécifiques au secteur contenant toutes les ressources nécessaires pour créer, commercialiser et vendre des produits et des solutions basés sur la technologie Intel&reg;.</li> <li style="list-style:disc outside; mso-special-format:bullet;margin-bottom:20px;">Faites la promotion de vos solutions sur notre <strong>Vitrine des partenaires Intel&reg;</strong> grâce à votre vitrine personnalisée qui vous permet d'entrer en contact avec des milliers de partenaires et vos clients dans tout l'écosystème.</li> </ul> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin-top:20px;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Rejoignez-nous dès maintenant en vous inscrivant en tant que contact et gagnez 100&nbsp;points* pour votre entreprise afin de découvrir tout ce que l'Alliance partenaire Intel&reg;&nbsp;et la Zone des développeurs Premier ont à offrir.</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Suivez ces étapes rapides et simples&nbsp;:</p> <ol style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;text-align:left;word-break:keep-all;word-wrap:none"> <li style="margin-bottom:20px;">Cliquez sur <a href="https://www.intel.com/content/www/fr/fr/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:underline;word-break:keep-all;word-wrap:none">S'inscrire</a> et suivez les instructions** pour être rattaché(e) au compte de votre entreprise.</li> <li style="margin-bottom:20px;">Vous recevrez ensuite un e-mail vous permettant de vous connecter à l'Alliance partenaire Intel&reg;.</li> </ol> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Découvrez tous les avantages de notre programme en rejoignant l'Alliance partenaire Intel&reg;&nbsp;dès maintenant.</p> <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" valign="top" width="100%"> <tbody> <tr> <th style="padding-top:32px;"><!-- START BUTTON --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" valign="top" width="auto"> <tbody> <tr> <th style="background:#00C7FD ;padding:10px 24px 10px 24px;"><a href="https://www.intel.com/content/www/fr/fr/secure/forms/ipa-secondary.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#262626;display:block;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">S'inscrire<img src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{3c6395e2-a99d-4d56-af68-36b36f3ef629}_arrow_email_black.png" valign="middle" alt=""></a></th> </tr> </tbody> </table><!-- END BUTTON --></th> </tr> </tbody> </table><br><p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-top:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Avez-vous besoin d'aide pour vous inscrire en tant que partenaire&nbsp;? <a href="https://www.intel.com/content/www/fr/fr/support.html?elqTrackId=e8aebb5fa57546dab808d4902c25087c&elqTrack=true" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:underline;word-break:keep-all;word-wrap:none">Contacter l'assistance</a>.</p><br><p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:24px;margin:0;padding:0;text-align:left;word-break:keep-all;word-wrap:none">*Vous devez être éligible aux points. Voir les conditions d'éligibilité.</p> <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:24px;margin-top:20px;padding:0;text-align:left;word-break:keep-all;word-wrap:none"><a href="https://www.intel.com/content/www/fr/fr/support/articles/000092340/programs/access-entitlement-for-myintel-users.html?wapkw=azure%20mfa%20help&elqTrackId=0f654af1184b4c4a9c97cb0ecda4c3c0&elqTrack=true" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:20px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">*<u>Aide sur l'authentification multi-facteurs (MFA) Azure</u></a></p> </th> </tr> </tbody> </table><!-- END LEFT ALIGNED CONTENT --> <!-- START IPA SOCIAL RIBBON - UPDATE THE BACKGROUND COLOR ON THE BLADE BY CHANGING THIS TABLE BACKGROUND --><table role="presentation" align="center" bgcolor="#0095CA" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%"> <tbody> <tr> <th> <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" valign="middle" width="100%"> <tbody> <tr> <th align="center" style="padding:10px;"> <div style="vertical-align: middle"><img alt="" height="30" src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{04d8272d-eac1-4a18-8060-873796cf5819}_icon_ipa_linkedin.png" style="display:inline-block;vertical-align:middle;" valign="middle" width="39" /> <a href="https://www.linkedin.com/groups/2965079/?elqTrackId=37baac48d4f24cba9407883e64b74cee&elqTrack=true" style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:30px;font-weight:400;text-decoration:none;" target="_blank">Rejoignez le groupe de l'Alliance partenaire Intel&reg;&nbsp;sur&nbsp;<span style="text-decoration:underline">LinkedIn</span></a><img alt="" src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{0230aada-0914-45c2-8d44-ea2c5ae34e04}_arrow_email_white.png" style="display:inline-block;vertical-align:middle;" valign="middle" /></div> </th> </tr> </tbody> </table> </th> </tr> </tbody> </table><!-- END IPA SOCIAL RIBBON --> <!-- START SIGNOFF BLADE - UPDATE THE BACKGROUND COLOR ON THE BLADE BY CHANGING THIS TABLE BACKGROUND --><table role="presentation" valign="top" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#0054AE" align="center"> <tbody> <tr> <th> <center><img align="middle" alt="Connectez. Innovez. Développez." class="responsive" height="80" src="https://images.plan.intel.com/EloquaImages/clients/IntelCorporation/{be004823-ae1a-496e-8231-060c2c1fed92}_ipa-signoff-us-en.png" style="-ms-interpolation-mode:bicubic;display:block;outline:0;width:670px;height:80px;" width="670" /></center> </th> </tr> </tbody> </table><!-- END SIGNOFF BLADE --></th> </tr> </tbody> </table><!-- START VIEW IN BROWSER --><table role="presentation" align="center" border="0" cellspacing="0" cellpadding="0" class="container" width="670"> <tbody> <tr> <th class="small-12 columns" style="width:670px"> <center> </center> </th> </tr> </tbody> </table><!-- END VIEW IN BROWSER --><table align="center" border="0" cellpadding="0" cellspacing="0" class="container" width="670"> <tbody> <tr> <th class="small-12 columns" style="padding:0"> <p style="color:#262626;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;l