                                              </th>
                                              <th align="left" style="width:80px" valign="top"></th>
                                            </tr>
                                          </tbody>
                                        </table><!-- END SPACER --><table role="presentation" align="center" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%" class="collapse" style="">
                                          <tbody>
                                            <tr>
                                              <th class="pad-top-24 small-12 columns" valign="top">
                                                <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%" class="collapse no-mobile-border" style="border-left:3px solid #00C7FD;border-bottom:3px solid #00C7FD;">
                                                  <tbody><tr>
                                                    <th align="left" class="small-12 columns" style="padding:0 32px;width:290px" valign="top"><img src="https://intel--crmdevint3.sandbox.file.force.com/servlet/servlet.ImageServer?id=015D300000087oH&oid=00D2i0000008d6j&lastMod=1686835196000" alt="" style="display:block;height:54px;width:174px;" height="54" valign="top" width="174"><h1 style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;mso-hyphenate:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:25px;font-weight:400;hyphens:none;line-height:32px;margin:0;margin-bottom:24px;margin-top:24px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Lancez-vous</h1>
                                                      <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" valign="top" width="100%">
                                                        <tbody>
                                                          <tr>
                                                            <th style="padding-bottom:24px;"><!-- START BUTTON --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" valign="top" width="auto">
                                                                <tbody>
                                                                  <tr>
                                                                    <td style="background-color:#00C7FD;padding:10px 24px 10px 24px;"><a href="https://wcm-stg.intel.com/content/www/us/en/secure/forms/ipa-admin.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;mso-hyphenate:none;color:#262626;display:block;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Cliquez pour nous rejoindre&sup1;&rarr;</a></td>
                                                                  </tr>
                                                                </tbody>
                                                              </table><!-- END BUTTON --></th>
                                                          </tr>
                                                        </tbody>
                                                      </table>
                                                      <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:16px;margin:0;margin-bottom:24px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">&sup1;Saisissez votre adresse e-mail, puis cliquez sur &laquo;&nbsp;Continuer&nbsp;&raquo;, ne choisissez pas &laquo;&nbsp;Créer un compte&nbsp;&raquo;</p> 
                                                    </th>
                                                  </tr>
                                                </tbody></table>
  
  
                                              </th>
                                              <th class="pad-top-24 small-12 columns" style="width:300px;"><img src="https://intel--crmdevint3.sandbox.file.force.com/servlet/servlet.ImageServer?id=015D300000087oM&oid=00D2i0000008d6j&lastMod=1686835196000" alt="" class="responsive" style="display:block;height:300px;vertical-align:bottom;width:300px;" height="300" valign="bottom" width="300"> <!-- START SPACER --><table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" class="show-for-small" style="display:none;mso-hide:all" width="100%">
                                                  <tbody>
                                                    <tr>
                                                      <th align="center" style="font-size:16px;line-height:16px;width:100%" height="16">
                                                        &nbsp;
                                                      </th>
                                                    </tr>
                                                  </tbody>
                                                </table><!-- END SPACER --></th>
                                            </tr>
                                          </tbody>
                                        </table>
                                      </th>
                                    </tr>
                                  </tbody>
                                </table>
                              </th>
  
                            </tr>
                          </tbody>
                        </table><!-- END HEADER --> <!-- START LEFT ALIGNED CONTENT --><table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                          <tbody>
                            <tr>
                              <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:24px;padding-top:48px;width:510px;">
                                <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Cher/Chère&nbsp;: {!Contact.FirstName} {!Contact.LastName} ({!Contact.Email})&nbsp;:<br><span style="font-size:14px">Remarque&nbsp;: votre adresse e-mail est votre nom d'utilisateur</span><br><br>En rejoignant l'Alliance partenaire Intel&reg;, vous bénéficierez d'un accès à des formations avancées, à des ressources pour les développeurs, à des outils de marketing et de vente, ainsi qu'à une assistance grâce à un accès instantané&nbsp;à&nbsp;:</p>
                                <ul style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;text-align:left;word-break:keep-all;word-wrap:none">
                                  <li style="margin-bottom:16px;">Un leadership éclairé d'Intel&reg;&nbsp;et d'experts du secteur transformant les entreprises avec de la technologie, des stratégies et des bonnes pratiques</li>
                                  <li style="margin-bottom:16px;">Une formation en matière de ventes et de technologie pour tous les niveaux afin de consolider vos connaissances</li>
                                  <li style="margin-bottom:16px;">Des webinaires réguliers avec des leaders de la Tech et des entretiens sur les technologies avec les architectes des solutions Intel&reg;</li>
                                  <li style="margin-bottom:16px;">Des forums pour participer à des discussions centrées sur l'innovation, les opportunités commerciales et la technologie</li>
                                  <li style="margin-bottom:16px;">L'accès à un réseau robuste de partenaires de l'écosystème et d'architectes de systèmes Cloud</li>                                  
                              </ul> 
                              <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">Rejoignez notre écosystème de partenaires en pleine&nbsp;croissance.<br><br>Prenez quelques minutes pour terminer votre inscription et vous lancer dès aujourd'hui.</p>                               
                                <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                    <tbody><tr>
                                        <th style="min-width:200px;"><!-- START BUTTON --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" valign="top" width="auto">
                                            <tbody>
                                                <tr>
                                                <td style="background-color:#00C7FD;padding:10px 24px 10px 24px;"><a href="https://wcm-stg.intel.com/content/www/us/en/secure/forms/ipa-admin.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;mso-hyphenate:none;color:#262626;display:block;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;text-align:center;text-decoration:none;word-break:keep-all;word-wrap:none">Cliquez pour nous rejoindre&sup1;&rarr;</a></td>
                                                </tr>
                                            </tbody>
                                            </table><!-- END BUTTON --></th>
                                    </tr>
                                </tbody>
                            </table>
                            <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:400;hyphens:none;line-height:16px;margin:0;margin-bottom:24px;margin-top:24px;padding:0;text-align:left;word-break:keep-all;word-wrap:none">&sup1;Saisissez votre adresse e-mail, puis cliquez sur &laquo;&nbsp;Continuer&nbsp;&raquo;, ne choisissez pas &laquo;&nbsp;Créer un compte&nbsp;&raquo;</p> 
                              </th>
                            </tr>
                          </tbody>
                        </table><!-- END LEFT ALIGNED CONTENT --> <!-- START POINTS INFO --><table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                          <tbody><tr>
                            <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:48px;">
                              <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tbody>
                                  <tr>
                                    <th class="small-12 columns" style="background-color:#0054AE;padding:32px;">
                                        
                                        <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:center;word-break:keep-all;word-wrap:none">Cliquez <a href="https://www.intel.fr/content/www/fr/fr/support/topics/azure-sign-in.html" target="_blank" style="color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:400;text-decoration:underline;">ici</a> pour en savoir plus sur le nouveau processus de connexion d'Intel.</p>
  
                                        <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-top:32px;padding:0;text-align:center;word-break:keep-all;word-wrap:none">Vous avez besoin d'aide pour vous inscrire en tant que partenaire&nbsp;?<br><a href="https://supporttickets.intel.com/s/supportrequest?language=en_US" target="_blank" style="color:#fff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:400;"><span style="text-decoration:underline;">Contacter l'assistance</span></a></p>
                                    </th>
                                  </tr>
                                </tbody>
                              </table>
                            </th>
                          </tr>
                        </tbody></table><!-- END POINTS INFO --> <!-- START SIGNOFF BLADE - UPDATE THE BACKGROUND COLOR ON THE BLADE BY CHANGING THIS TABLE BACKGROUND --><table role="presentation" align="center" style="background-color:#0054AE;" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                          <tbody>
                            <tr>
                              <th>
                            
                                <center><img align="middle" alt="Connectez. Innovez. Développez." class="responsive" height="80" src="https://intel--crmdevint3.sandbox.file.force.com/servlet/servlet.ImageServer?id=015D300000087oI&oid=00D2i0000008d6j&lastMod=1686835196000" style="-ms-interpolation-mode:bicubic;display:block;outline:0;width:670px;height:80px;" width="670"></center>
                              </th>
                            </tr>
                          </tbody>
                        </table><!-- END SIGNOFF BLADE --></th>
                    </tr>
  
                  </tbody>
                </table>
  
              </center>
            </th>
          </tr>
        </tbody>
      </table>
      <table role="presentation" bgcolor="#efefef" border="0" cellspacing="0" cellpadding="0" class="body" valign="top" width="100%">
        <tbody>
          <tr>
            <th align="center" valign="top">
              <table align="center" border="0" cellpadding="0" cellspacing="0" class="container" width="670">
                  <tbody>
                      <tr>
