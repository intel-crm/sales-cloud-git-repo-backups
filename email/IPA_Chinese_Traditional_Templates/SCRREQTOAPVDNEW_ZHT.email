<th class="mobile-padding small-12 large-12 columns first last" style="margin: 0px auto; padding: 0px 20px; width: 100%; text-align: left; color: #555554; line-height: 20px; font-family: Microsoft JhengHei, Tahoma, Arial, Helvetica, Verdana, sans-serif; font-size: 12px; font-weight: 400;">
