                                        <tbody>
                                          <tr>
                                            <th class="pad-top-24 small-12 columns" valign="top">
                                              <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%" class="collapse no-mobile-border" style="border-left:3px solid #00C7FD;border-bottom:3px solid #00C7FD;">
                                                <tbody><tr>
                                                  <th align="left" class="small-12 columns" style="padding:0 32px;width:290px" valign="top"><img src="https://intel--crmdevipa.sandbox.file.force.com/servlet/servlet.ImageServer?id=0158A000001B4cT&oid=00D8A0000005uU8&lastMod=1686721695000" alt="" style="display:block;height:54px;width:174px;" height="54" valign="top" width="174"><h1 style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;mso-hyphenate:none;color:#FFFFFF;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:25px;font-weight:400;hyphens:none;line-height:32px;margin:0;margin-bottom:24px;margin-top:24px;padding:0;text-align:left;word-break:normal;word-wrap:normal">馬上開始</h1>
                                                    <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" valign="top" width="100%">
                                                      <tbody>
                                                        <tr>
                                                          <th style="padding-bottom:24px;"><!-- START BUTTON --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" valign="top" width="auto">
                                                              <tbody>
                                                                <tr>
                                                                  <td style="background-color:#00C7FD;padding:10px 24px 10px 24px;"><a href="https://wcm-stg.intel.com/content/www/us/en/secure/forms/ipa-admin.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;mso-hyphenate:none;color:#262626;display:block;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;text-align:center;text-decoration:none;word-break:normal;word-wrap:normal">按一下加入&sup1;&rarr;</a></td>
                                                                </tr>
                                                              </tbody>
                                                            </table><!-- END BUTTON --></th>
                                                        </tr>
                                                      </tbody>
                                                    </table>
                                                    <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:12px;font-weight:400;hyphens:none;line-height:16px;margin:0;margin-bottom:24px;padding:0;text-align:left;word-break:normal;word-wrap:normal">&sup1;輸入您的電子郵件地址，然後「繼續」，請勿選擇「&#xfeff;建&#xfeff;立&#xfeff;帳&#xfeff;戶&#xfeff;」</p> 
                                                  </th>
                                                </tr>
                                              </tbody></table>


                                            </th>
                                            <th class="pad-top-24 small-12 columns" style="width:300px;"><img src="https://intel--crmdevipa.sandbox.file.force.com/servlet/servlet.ImageServer?id=0158A000001B4dM&oid=00D8A0000005uU8&lastMod=1686832767000" alt="" class="responsive" style="display:block;height:300px;vertical-align:bottom;width:300px;" height="300" valign="bottom" width="300"> <!-- START SPACER --><table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" class="show-for-small" style="display:none;mso-hide:all" width="100%">
                                                <tbody>
                                                  <tr>
                                                    <th align="center" style="font-size:16px;line-height:16px;width:100%" height="16">
                                                      &nbsp;
                                                    </th>
                                                  </tr>
                                                </tbody>
                                              </table><!-- END SPACER --></th>
                                          </tr>
                                        </tbody>
                                      </table>
                                    </th>
                                  </tr>
                                </tbody>
                              </table>
                            </th>

                          </tr>
                        </tbody>
                      </table><!-- END HEADER --> <!-- START LEFT ALIGNED CONTENT --><table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                        <tbody>
                          <tr>
                            <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:24px;padding-top:48px;width:510px;">
                              <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:normal;word-wrap:normal">親愛的：{!Contact.LastName}{!Contact.FirstName} ({!Contact.Email})：<br><span style="font-size:14px">注意：電子郵件地址是您的使用者名稱</span><br><br>加入 Intel&reg;&nbsp;夥伴聯盟後，即可立刻取得進階訓練、開發者資源、行銷與銷售工具以及支援：</p>
                              <ul style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;text-align:left;word-break:normal;word-wrap:normal">
                                <li style="margin-bottom:16px;">Intel&reg;&nbsp;和產業專家的思想領導力，透過技術、策略和最佳做法實現業務轉型</li>
                                <li style="margin-bottom:16px;">各個等級的銷售與技術訓練，展現專業知識</li>
                                <li style="margin-bottom:16px;">定期與技術領導者在網路研討會交換意見，以及與 Intel&reg;&nbsp;解決方案架構師在技術講座進行交流</li>
                                <li style="margin-bottom:16px;">加入論壇，參與以創新技術、商業和科技機會為中心的討論</li>
                                <li style="margin-bottom:16px;">接觸強大的生態系統合作夥伴與雲端系統架構設計師網路</li>                                  
                            </ul> 
                            <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:left;word-break:normal;word-wrap:normal">成為我們不斷壯大的合作夥伴生態系統的&#xfeff;一&#xfeff;環。<br><br>花幾分鐘完成註冊，馬上開始。</p>                               
                              <table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                                  <tbody><tr>
                                      <th style="min-width:200px;"><!-- START BUTTON --><table role="presentation" align="left" border="0" cellspacing="0" cellpadding="0" valign="top" width="auto">
                                          <tbody>
                                              <tr>
                                              <td style="background-color:#00C7FD;padding:10px 24px 10px 24px;"><a href="https://wcm-stg.intel.com/content/www/us/en/secure/forms/ipa-admin.html" target="_blank" style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;mso-hyphenate:none;color:#262626;display:block;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;text-align:center;text-decoration:none;word-break:normal;word-wrap:normal">按一下加入&sup1;&rarr;</a></td>
                                              </tr>
                                          </tbody>
                                          </table><!-- END BUTTON --></th>
                                  </tr>
                              </tbody>
                          </table>
                          <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#FFFFFF;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:12px;font-weight:400;hyphens:none;line-height:16px;margin:0;margin-bottom:24px;margin-top:24px;padding:0;text-align:left;word-break:normal;word-wrap:normal">&sup1;輸入您的電子郵件地址，然後「繼續」，請勿選擇「&#xfeff;建&#xfeff;立&#xfeff;帳&#xfeff;戶&#xfeff;」</p> 
                            </th>
                          </tr>
                        </tbody>
                      </table><!-- END LEFT ALIGNED CONTENT --> <!-- START POINTS INFO --><table role="presentation" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                        <tbody><tr>
                          <th class="small-12 columns" style="padding-left:80px;padding-right:80px;padding-bottom:48px;">
                            <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" width="100%">
                              <tbody>
                                <tr>
                                  <th class="small-12 columns" style="background-color:#0054AE;padding:32px;">
                                      
                                      <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:18px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-bottom:32px;padding:0;text-align:center;word-break:normal;word-wrap:normal">請按一下<a href="https://www.intel.com.tw/content/www/tw/zh/support/topics/azure-sign-in.html" target="_blank" style="color:#ffffff;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:18px;font-weight:400;text-decoration:underline;">這裡</a>，瞭解 Intel 的新登入流程。</p>

                                      <p style="-moz-hyphens:none;-ms-hyphens:none;-webkit-hyphens:none;color:#ffffff;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:16px;font-weight:400;hyphens:none;line-height:24px;margin:0;margin-top:32px;padding:0;text-align:center;word-break:normal;word-wrap:normal">需要註冊成為夥伴方面的協助？<br><a href="https://supporttickets.intel.com/s/supportrequest?language=en_US" target="_blank" style="color:#fff;font-family:'Microsoft JhengHei','Tahoma','Arial','Helvetica','Verdana','sans-serif';font-size:16px;font-weight:400;"><span style="text-decoration:underline;">聯絡支援部門</span></a></p>
                                  </th>
                                </tr>
                              </tbody>
                            </table>
                          </th>
                        </tr>
                      </tbody></table><!-- END POINTS INFO --> <!-- START SIGNOFF BLADE - UPDATE THE BACKGROUND COLOR ON THE BLADE BY CHANGING THIS TABLE BACKGROUND --><table role="presentation" align="center" style="background-color:#0054AE;" border="0" cellspacing="0" cellpadding="0" valign="top" width="100%">
                        <tbody>
                          <tr>
                            <th>
                          
                              <center><img align="middle" alt="連接 創新 成長" class="responsive" height="80" src="https://intel--crmdevipa.sandbox.file.force.com/servlet/servlet.ImageServer?id=0158A000001B4dW&oid=00D8A0000005uU8&lastMod=1686832744000" style="-ms-interpolation-mode:bicubic;display:block;outline:0;width:670px;height:80px;" width="670"></center>
                            </th>
                          </tr>
                        </tbody>
                      </table><!-- END SIGNOFF BLADE --></th>
                  </tr>

                </tbody>
              </table>

            </center>
          </th>
        </tr>
      </tbody>
    </table>
    <table role="presentation" bgcolor="#efefef" border="0" cellspacing="0" cellpadding="0" class="body" valign="top" width="100%">
      <tbody>
        <tr>
          <th align="center" valign="top">
            <table align="center" border="0" cellpadding="0" cellspacing="0" class="container" width="670">
                <tbody>
                    <tr>
