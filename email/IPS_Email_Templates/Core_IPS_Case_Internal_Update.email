<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font face="arial"><b><br>Case {!Case.CaseNumber}, has been updated.<br><br>To view the case please: <a href="{!$Label.Core_IPS_Notification_Internal_URL}{!Case.Id}">Click Here</a></b></font><br><br><b>{!Case(Case.Core_IPS_Notif_Case_Comment__c,1, "This message was designed such that it contains no information which may be considered confidential.",2, "No comments have been added to this case.",3, "Latest Public Comment*",4, "Latest Private Comment*","")}</b><br>{!Case(Case.Core_IPS_Notif_Case_Comment__c,1, "",2, "",3, Case.Core_Last_Case_Comment__c,4, Case.Core_Last_Private_Case_Comment__c,"")}<br><b>{!Case(Case.Core_IPS_Notif_Case_Comment__c,1, "",2, "",3, "Submitted by: ",4, "Submitted by: ","")}</b>{!Case(Case.Core_IPS_Notif_Case_Comment__c,1, "",2, "",3, Case.Core_Last_Case_Comment_Submitter__c,4, Case.Core_Last_Private_Case_Comment_Submitter__c,"")}<br><br><span style="font-size: 12pt;"><span style="font-size: 12pt;"><span style="font-size: 12pt;"><span style="font-size: 12pt;"><span style="font-size: 12pt;"><span style="font-size: 12pt;"></span></span></span></span></span></span><span style="font-size: 12pt;"></span><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div align="center"><font face="arial" color="#666666"><b>_______________________________________________________________</b></font><br></div><font face="arial"><b><br></b></font><div align="center"><font face="arial"><b>Case Details</b></font><br></div><font face="arial"><b><br>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Subject:")}<br></b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Subject)}<b><br>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Description: ")}<br></b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Issue_Description__c)}<b><br><br><font size="2">Case Number: </font></b><font size="2">{!Case.CaseNumber}</font><b><font size="2"><br>Status{!if(ispickval(Case.Core_Sub_Status__c,""),": "," - Sub Status: ")}</font></b><