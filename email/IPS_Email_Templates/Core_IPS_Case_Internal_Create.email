<![CDATA[<div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b style="font-size: 12pt;">Case #{!Case.CaseNumber}, has been created.</b></div><div style=""><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">email text:</b><font face="arial"><b>{!Case.Core_IPS_email_text__c}</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br><div><div style="font-size: 12pt;"><b>To view the case please: <a href="{!$Label.Core_IPS_Notification_Internal_URL}/{!Case.Id}">Click Here</a></b><b><br></b><br><b>{!Case(Case.Core_IPS_Notif_Case_Comment__c,1, "This message was designed such that it contains no information which may be considered confidential.",2, "No comments have been added to this case.",3, "Latest Public Comment*",4, "Latest Private Comment*","")}</b><br>{!Case(Case.Core_IPS_Notif_Case_Comment__c,1, "",2, "",3, Case.Core_Last_Case_Comment__c,4, Case.Core_Last_Private_Case_Comment__c,"")}<br><b>{!Case(Case.Core_IPS_Notif_Case_Comment__c,1, "",2, "",3, "Submitted by: ",4, "Submitted by: ","")}</b>{!Case(Case.Core_IPS_Notif_Case_Comment__c,1, "",2, "",3, Case.Core_Last_Case_Comment_Submitter__c,4, Case.Core_Last_Private_Case_Comment_Submitter__c,"")}<br><br></div><div style="color: rgb(0, 0, 0); font-size: 12pt; text-align: center;"><b><font color="#666666">_______________________________________________________________</font></b></div><div style="color: rgb(0, 0, 0); font-size: 12pt; text-align: center;"><b><br></b></div><div style="color: rgb(0, 0, 0); font-size: 12pt; text-align: center;"><b>Case Details</b></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="arial" size="2"><b><br></b></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Arial, sans-serif"><b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Subject:")}</b></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="arial">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Subject)}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="arial"><b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,""," ")}</b></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="arial"><b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Description: ")}</b></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="arial">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Issue_Description__c)}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font size="2"><font face="arial"><b><br></b></font></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="arial" size="2"><b>Case Number:&nbsp;</b></font><font size="2">{!Case.CaseNumber}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font size="2"><b>Status{!if(ispickval(Case.Core_Sub_Status__c,""),": "," - Sub Status: ")}</b><font face="arial">{!Case.Status}</font>{!if(ispickval(Case.Core_Sub_Status__c,""),""," - ")}{!Case.Core_Sub_Status__c}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font size="2"><b style="font-family: Arial, sans-serif;">Case Owner:</b><span style="font-family: Arial, sans-serif;">&nbsp;{!Case.OwnerFullName}</span></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font size="2"><b style="font-family: Arial, sans-serif;">Last Assigned Queue:</b><span style="font-family: Arial, sans-serif;">&nbsp;{!Case.Core_IPS_Assigned_Queue__c}</span></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><div style="font-size: 12pt;"><div><font face="arial" size="2"><b>Priority - Severity:&nbsp;</b></font><font size="2"><span style="background-color: rgb(255, 255, 255);">{!Case.Priority} -&nbsp; {!Case.Core_Severity__c}<br></span></font></div></div><div><font size="2"><b style="font-family: Arial, sans-serif;">Product - Organization:</b><span style="font-family: Arial, sans-serif;">&nbsp;{!Case.Core_IPS_Product_name__c} - {!Case.Core_Product_Organization__c}&nbsp;</span></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="arial" size="2"><b>Contact - Account:&nbsp;</b></font><font size="2">{!Case.Contact} - {!Case.Account}<br><b>{!if(isblank(Case.Core_Case_Issue_Category__c),"",if(isblank(Case.Core_External_Issue_Subcategory__c),"Category:
