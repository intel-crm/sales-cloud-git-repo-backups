ace="arial"><b>Account CIM ID</b></font><b style="font-size: 12pt;">:&nbsp;</b><font face="arial">&nbsp;{!Account.Core_CIM_ID__c}</font></div><div><br><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Address:</b><br><font face="arial"><span style="font-size: 12pt;">{!Account.BillingAddress}</span></font><br><br><br><br></div>]]></td>
