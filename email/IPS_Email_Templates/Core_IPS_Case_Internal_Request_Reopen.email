<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="arial"><b>Case #{!Case.CaseNumber}, has been requested to reopen.</b></font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="arial"><br></font></div><div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><b>To view the case please: <a href="{!$Label.Core_IPS_Notification_External_URL}/{!Case.Id}">Click Here</a></b></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><b style="font-family: Arial, sans-serif;">{!if(isblank(Case.Core_Last_Case_Comment__c),"",if(Case.Core_IPS_Restricted_Secret_Content__c,"This message was designed such that it contains no information which may be considered confidential.","Latest Case Communication*:"))}</b></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="Arial, sans-serif">{!if(isblank(Case.Core_Last_Case_Comment__c),"",if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Last_Case_Comment__c))}</font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="Arial, sans-serif"><br></font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial; text-align: center;"><b><font color="#666666">_______________________________________________________________</font></b></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial; text-align: center;"><b><br></b></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial; text-align: center;"><b>Case Details</b></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="arial" size="2"><b><br></b></font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="Arial, sans-serif"><b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Subject:")}</b></font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="arial">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Subject)}</font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="arial"><b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,""," ")}</b></font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="arial"><b>{!if(Case.Core_IPS_Restricted_Secret_Content__c,"","Description: ")}</b></font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font face="arial">{!if(Case.Core_IPS_Restricted_Secret_Content__c,"",Case.Core_Issue_Description__c)}</font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font size="2"><font face="arial"><b><br></b></font></font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font size="2"><font face="arial"><b>Case Number:&nbsp;</b></font>{!Case.CaseNumber}</font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font size="2"><b>Status{!if(ispickval(Case.Core_Sub_Status__c,""),": "," - Sub Status: ")}</b></font><font size="2"><font face="arial">{!Case.Status}</font>{!if(ispickval(Case.Core_Sub_Status__c,""),""," - ")}{!Case.Core_Sub_Status__c}</font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font size="2"><b style="font-family: Arial, sans-serif;">Case Owner:</b><span style="font-family: Arial, sans-serif;">&nbsp;{!Case.OwnerFullName}</span></font></div><div style="font-size: 12pt;"><font size="2" style="color: rgb(0, 0, 0); font-family: arial;"><span style="font-family: Arial, sans-serif;"><b>Case Co Owner:</b>&nbsp;</span></font><font face="Arial, sans-serif" size="2">{!Case.Core_Case_Co_Owner__c}</font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><font size="2"><b style="font-family: Arial, sans-serif;">Last Assigned Queue:</b><span style="font-family: Arial, sans-serif;">&nbsp;{!Case.Core_IPS_Assigned_Queue__c}</span></font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><div style="font-size: 12pt;"><div><font size="2"><font face="arial"><b>Priority:&nbsp;</b></font><span style="background-color: rgb(255, 255, 255);">{!Case.Priority}</span></font></div></div><div><font size="2"><b style="font-family: Arial, sans-serif;">Product - Organization:</b><span style="font-family: Arial, sans-serif;">&nbsp;{!Case.Core_IPS_Product_name__c} - {!Case.Core_Product_Organization__c}&nbsp;</span></font></div><div style="font-size: 12pt;"><font size="2"><font face="arial"><b>Contact - Account:&nbsp;</b></font>{!Case.Contact} - {!Case.Account}</font></div></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="2"><b>{!if(isblank(Case.00N21000000OAlU),"",if(isblank(Case.00N21000000OAlW),"Category: ","Category - Sub Category: "))}</b>{!if(isblank(Case.00N21000000OAlU),"",Case.00N21000000OAlU)}{!if(isblank(Case.00N21000000OAlU),"",if(isblank(Case.00N21000000OAlW),""," - "))}{!if(isblank(Case.00N21000000OAlW),"",Case.00N21000000OAlW)}</font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="2"><b>{!if(isblank(Case.Core_IPS_Project_Case__c),"","Project: ")}</b>{!Case.Core_IPS_Project_Case__c}</font></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial; text-align: center;"><b><font color="#666666"><br></font></b></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial; text-align: center;"><b><font color="#666666">_______________________________________________________________</font></b></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><p class="MsoNormal" style="font-size: 12pt; background-color: rgb(255, 255, 255);"><b><span style="font-size: 12pt; text-align: center;"><span style="font-size: 7.5pt; font-family: Arial, sans-serif; color: rgb(102, 102, 102);">* Inline images have been removed from this email. &nbsp;Please open in&nbsp;</span></span><span style="color: rgb(102, 102, 102); font-family: Arial, sans-serif; font-size: x-small;">Intel®&nbsp;Premier Support to view all images.</span></b></p><p class="MsoNormal" style="font-size: 12pt; background-color: rgb(255, 255, 255);"><span style="font-size: 12pt;"><font face="arial" size="1" color="#666666"><b><br></b></font></span></p><p class="MsoNormal" style="font-size: 12pt; background-color: rgb(255, 255, 255);"><span style="font-size: 12pt;"><font face="arial" size="1" color="#666666"><b>This message contains Intel Confidential information and should be handled in accordance with your Non-Disclosure Agreement (NDA) with Intel. Access to this e-mail by anyone other than the intended recipient is unauthorized. If you are not the intended recipient (or responsible for delivery of the message to such person), you may not use, copy, distribute, or deliver this message or any part of its contents or take any action in reliance on it, and in such case, you should destroy this message.</b></font></span></p><p class="MsoNormal" style="font-size: 12pt; background-color: rgb(255, 255, 255);"><span style="font-size: 12pt;"><font face="arial" size="1" color="#666666"><b><br></b></font></span></p><p class="MsoNormal" style="font-size: 12pt; background-color: rgb(255, 255, 255);"><b style="color: rgb(102, 102, 102); font-size: x-small; text-align: center;"></b></p><div style="background-color: rgb(255, 255, 255);"><font size="1" color="#666666"><b>Copyright ©Intel Corporation. All rights reserved. Intel Corporation, 2200 Mission College Blvd., M/S RNB4-145, Santa Clara, CA 95054-1549 USA www.intel.com (408) 765-8080</b></font></div></div></div>]]></td>
