<body lang="EN-US" link="blue" vlink="purple" style='tab-interval: .5in'>
<div class="WordSection1">
<table class="MsoNormalTable" border="1" cellpadding="0" width="720" style="width: 7.5in; mso-cellspacing: 1.5pt; background: white; border: solid #E5E5E5 1.0pt; mso-border-alt: solid #E5E5E5 .75pt; mso-yfti-tbllook: 1184; mso-padding-alt: 10.5pt 5.4pt 0in 5.4pt;">
<tbody>
<tr>
<td style="border: none; padding: 9.0pt .75pt 3.75pt 35.25pt;">
<p class="MsoNormal"><span style="font-size: 24pt; color: #086db6;">        Verify your email address</span></p>
</td>
</tr>
<tr>
<td style="border: none; padding: 10.5pt 30.0pt .75pt 27.75pt;"></td>
</tr>
<tr>
<td style="border: none; padding: 10.5pt 45.0pt .75pt 33.0pt;" id="emailMainDiv">
<table width="720">
<tbody>
<tr style="height: 40px;">
<td style="height: 40px;">
<p><span style="font-size: 12pt; color: #666666;"><strong>Action Required</strong></span></p>
</td>
</tr>
<tr style="height: 89px;">
<td style="height: 89px;">
<p><span style="font-size: 11pt; color: #666666;">Welcome !%UserFirstName%! !%UserLastName%!,</span><br /><br /><span style="font-size: 11pt;"><span style="color: #666666;">Thank you for your interest! Please follow this</span> <span style="color: #086db6;"><a href="
https://www.intel.com/content/www/us/en/secure/my-intel/dashboard.html"
style="color: #086db6;">link</a></span> <span style="color: #666666;">to complete your set up.</span></span></p>
</td>
</tr>
<tr style="height: 53px;">
<td style="height: 53px;">
<p><span style="font-size: 11pt; color: #666666;"><strong>Email ID: </strong><span> </span>!%UserEmailAddr%!</span></p>
</td>
</tr>
<tr style="height: 53px;">
<td style="height: 53px;">
<p><span style="font-size: 11pt;"><span style="color: #666666;">If you have questions,</span> <span style="color: #086db6;"><a href="
https://www-ssl.intel.com/content/www/us/en/company-overview/contact-us.html"
style="color: #086db6;">contact Intel Customer Support</a></span>.</span></p>
</td>
</tr>
<tr style="height: 89px;">
<td style="height: 89px; text-align: right;">
<p style="text-align: left;"><span style="font-size: 11pt;"><span style="color: #666666;">Please DO NOT reply to this e-mail message. This is an automated response.</span>    </span><br /><span style="font-size: 11pt; color: #666666;">To ensure that you continue receiving our e-mails, please add us to your address book.</span><br /><span style="font-size: 11pt;"><span style="color: #666666;">Visit</span> <span style="color: #086db6;"><a href="
https://www-ssl.intel.com/content/www/us/en/my-intel/manage-profile.html"
style="color: #086db6;">My Intel</a></span> <span style="color: #666666;">any time to manage your profile.                                  </span></span></p>
<footer><span style="font-family: 'intel clear', sans-serif;"></span></footer></td>
</tr>
<td style="border: none; text-align: left;"><span style="font-family: 'intel clear', sans-serif;"> <img class="floating" src="
https://www.intel.com/content/dam/logos/intel-logo.png"
   height="42" width="64" /></span>
</tbody>
</table>
</td>
</tr>
</tbody>
</table>
<p class="MsoNormal"><span style="mso-fareast-font-family: 'Times New Roman';"> </span></p>
