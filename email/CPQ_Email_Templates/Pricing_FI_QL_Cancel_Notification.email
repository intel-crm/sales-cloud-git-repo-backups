<messaging:emailTemplate subject="Status for {!relatedTo.SBQQ__Quote__r.Name}/{!relatedTo.Pricing_EndCustomer_Nm__c}/{!relatedTo.Pricing_Project_Nm__c}/{!relatedTo.Pricing_End_Customer_Country__c}{!IF(relatedTo.Pricing_Customer_Reference_txt__c != Null, '/', '')}{!relatedTo.Pricing_Customer_Reference_txt__c}" recipientType="User" relatedToType="SBQQ__QuoteLine__c"
renderUsingSystemContextWithoutSharing="True">
    <messaging:htmlEmailBody >
        <c:Pricing_FI_QL_Cancel_Notification quoteLineRecordId="{!relatedTo.Id}"/>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>