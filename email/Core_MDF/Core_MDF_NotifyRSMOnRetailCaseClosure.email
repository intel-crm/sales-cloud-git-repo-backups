<messaging:emailTemplate subject="{!$Label.Core_MDF_Audit_Closure_SubjectForRSM} {!RelatedTo.Core_MDF_Claim_Number__c}" 
                         recipientType="User" 
                         relatedToType="Case" 
                         language="{!relatedTo.Core_MDF_Claim_Submitter_Language__c}">
  <messaging:htmlEmailBody >
    <html>
        <body>
             <p> 
                {!$Label.Core_MDF_EmailTemp_StatusUpdate_DearMember}<br/><br/>
                {!$Label.Core_MDF_Audit_Closure_Part1}<br/>   
             </p>                   
      
                {!$Label.Core_MDF_Audit_Creation_Field1} {!RelatedTo.Core_MDF_Claim_Number__c}<br/>
                {!$Label.Core_MDF_Audit_Creation_Field2} {!RelatedTo.Core_MDF_ActivityName__c}<br/>
                {!$Label.Core_MDF_Audit_Creation_Field3} {!RelatedTo.Core_MDF_CampaignName__c }<br/>
                {!$Label.Core_MDF_Audit_Creation_Field4} {!RelatedTo.Core_MDF_Activity_Type__c}<br/>
                {!$Label.Core_MDF_Audit_Creation_Field5} {!RelatedTo.Core_MDF_Country_Region__c}<br/>
                {!$Label.Core_MDF_Audit_Creation_Field7}
                <apex:outputText value="{0, Number, Currency}">
                <apex:param value="{!RelatedTo.Core_MDF_Requested_Amount_USD_Amt__c}"/>
                </apex:outputText><br/>
                {!$Label.Core_MDF_Audit_Creation_Field8}
                <apex:outputText value="{0, Number, Currency}">
                <apex:param value="{!RelatedTo.Core_MDF_Adjustment_Amount_USD_Amt__c}"/>
                </apex:outputText><br/>
                <br/><br/>
                
                
                {!$Label.Core_MDF_Audit_Creation_PartLink+' '}  
                <a href="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}"> {!$Label.Core_MDF_Audit_Creation_PartLink1}</a> 
             
             <p> 
                 {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}<br/>
                 <!--{!$Label.Core_MDF_Audit_Creation_Retail_Body_2}-->
                 {!$Label.Core_MDF_Email_Signature}
             </p>
        </body>
    </html>
  </messaging:htmlEmailBody>
</messaging:emailTemplate>