<messaging:emailTemplate subject="{!$Label.Core_MDF_Case_Cancelled_Subject}{!RelatedTo.Core_MDF_Claim_Number__c}" 
                         recipientType="User" 
                         relatedToType="Case" 
                         language="{!relatedTo.Core_MDF_Claim_Submitter__r.LanguageLocaleKey}">
  <messaging:htmlEmailBody >
     <html>
       <body>
             <p> 
                {!$Label.Core_MDF_EmailTemp_StatusUpdate_DearMember}<br/><br/>
                {!$Label.Core_MDF_Case_Cancelled_Body}<br/><br/>   
              </p>
        
                {!$Label.Core_MDF_Audit_Creation_Field1} &nbsp; <apex:outputLink value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Core_MDF_Claim_ID__c}">{!RelatedTo.Core_MDF_Claim_Number__c}</apex:outputLink> <br/>
                {!$Label.Core_MDF_Case_Cancelled_Body_CaseField} &nbsp; <apex:outputLink value="{!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}">{!RelatedTo.CaseNumber}</apex:outputLink> <br/>
                {!$Label.Core_MDF_Audit_Creation_Field2} {!RelatedTo.Core_MDF_ActivityName__c} <br/>
                {!$Label.Core_MDF_Audit_Creation_Field3} {!RelatedTo.Core_MDF_CampaignName__c } <br/>
                {!$Label.Core_MDF_Audit_Creation_Field4} {!RelatedTo.Core_MDF_Activity_Type__c} <br/>
                {!$Label.Core_MDF_Audit_Creation_Field5} {!RelatedTo.Core_MDF_Country_Region__c}         
             
             <p>
                 {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}<br/>
                 {!$Label.Core_MDF_Audit_Creation_Body8}
             </p>
       </body>
     </html>
  </messaging:htmlEmailBody>
</messaging:emailTemplate>