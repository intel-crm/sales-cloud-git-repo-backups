<messaging:emailTemplate renderUsingSystemContextWithoutSharing="true"
                     subject="Bulk Proposal Approval Completed"        
                     relatedToType="PartnerFundRequest" language="{!recipient.LanguageLocaleKey}" recipientType="User">
<messaging:htmlEmailBody >
<html>
    <body>
        <div style="font-size:14px;font-family:Calibri">  
                    <p><span>{!$Label.Core_MDF_EmailTemp_DearIntelemployee}</span></p>
                    <p><span>
                          <!--{!$Label.Core_MDF_EmailTemp_Body}-->
                          Your bulk proposal approvals have been completed successfully. Items that have been successfully approved will not be visible in the "Internal Approvals Page" anymore and the ones that failed would continue to be visible in the "Internal Approvals Page".
                       </span>
                    </p> 
                    <p><span> Click
                   <apex:outputLink value="{!$Label.Core_MDF_PFRDetailLink+$Label.Core_MDF_Internal_Bulk_Approvals_Tab_Link}"> {!$Label.Core_MDF_EmailTemp_Claim_URL1}</apex:outputLink>
                   to access the "Internal Approvals Page"
                    </span>
                    </p>  
                    <!-- <apex:outputLink value="Click {!$Label.Core_MDF_PFRCommunityLink+RelatedTo.Id}">{!$Label.Core_MDF_EmailTemp_Claim_URL1} to access the "Internal Approvals Page"</apex:outputLink>-->
<p></p>
<p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}<br></br>
{!RelatedTo.RecordType.Name}{!$Label.Core_MDF_Audit_Creation_IPA_Body_3}
</p>
