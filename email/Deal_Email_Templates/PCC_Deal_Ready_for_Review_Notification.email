<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Hello<o:p></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><o:p>&nbsp;</o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">The following Deal Registration has been&nbsp;<b>Assigned</b>&nbsp;to you.<b><o:p></o:p></b></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>&nbsp;</b></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Registration Number:&nbsp;</b>{!Core_Design_Registration__c.Name}<o:p></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Deal Registration Name:</b>&nbsp;{!Core_Design_Registration__c.Core_Design_Registration_Nm__c}<b><o:p></o:p></b></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Partner Account:&nbsp;</b>{!Core_Design_Registration__c.Core_Partner_Account_Id__c}</p><p class="MsoNormal" style=""><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">End Customer Account:&nbsp;</b><span style="font-size: 12pt;">{!CASE(Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c,'Submitted',Core_Design_Registration__c.Core_End_Customer_Nm__c,</span><span style="font-size: 12pt;">Core_Design_Registration__c.Core_End_Customer_Account_Id__c)}</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;"><br></span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">For more details, you can access the deal registration record </span><a href="{!Core_Design_Registration__c.Link}" style="font-size: 12pt;">here</a><span style="font-size: 12pt;">.</span></p>

<p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><o:p>&nbsp;</o:p></p>]]></td>
