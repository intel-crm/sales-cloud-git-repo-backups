<messaging:emailTemplate recipientType="User" 
                         renderUsingSystemContextWithoutSharing="true"
                         relatedToType="PartnerFundRequest"
                         language="{!recipient.LanguageLocaleKey}"
                         subject="{!$Label.Core_MDF_EmailTemp_Status_Change_Subject} {!RelatedTo.Title}">
                          
                         
    <messaging:htmlEmailBody >
        <html>
            <body>  
                <div style="font-size:14px;font-family:Calibri">
                    <div><span style="color:red"><strong>{!$Label.Core_MDF_IPA_EmailTemp_ActionReq}</strong></span></div>
           
                    <br></br>
                    
                    Dear Intel employee, <br/><br/>
                    
                    {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body1}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="RecType"/> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body2} {!RelatedTo.Core_MDF_Activity_Number__c}
                    {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body3}&nbsp;{!RelatedTo.Core_MDF_PriorValueOfStatus__c}&nbsp;{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body4}&nbsp;<c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="Status"/> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body4a}
                    
                    {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body5} <a href="{!RelatedTo.Core_MDF_PFRDetailLink__c}"> {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body9} </a>
                    {!$Label.Core_MDF_EmailTemp_StatusUpdate_Body10}<br/>
                    
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_IPA_EmailTemp_Field1} {!RelatedTo.Core_MDF_Ultimate_Account_Name__c}</p>
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_Audit_Creation_Field3} {!RelatedTo.Core_MDF_UpdateCampaign__c}</p>
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_EmailTemp_Claim_Activity_Name} {!RelatedTo.Title}</p>
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_EmailTemp_Activity_Number} {!RelatedTo.Core_MDF_Activity_Number__c} </p>
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_EmailTemp_Budget_Type} {!RelatedTo.Core_MDF_Budget_Type_nm__c}</p>
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_EmailTemplate_Budget_Amount} ${!RelatedTo.Core_MDF_Activity_Reimbursement_Amt_nbr__c}</p>
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_EmailTemp_Activity_Type} &nbsp; <c:Core_MDF_EmailTemplateDataComponent actId="{!RelatedTo.Id}" flag="ActType"/></p>
                    <p>&nbsp; &nbsp; &nbsp;{!$Label.Core_MDF_Country_Location} {!RelatedTo.Core_MDF_Country_nm__c}</p>
                    
                    
                    <p>
                       <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                       <p><span>{!$Label.Core_MDF_Email_Signature}</span></p>
                            
                    </p>
                </div>
                <div style="font-size:11px;font-family:Calibri">
                    <p>
                        <i>  
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/>
                        </i>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                        {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                        <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                    </p>
                </div>   
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>