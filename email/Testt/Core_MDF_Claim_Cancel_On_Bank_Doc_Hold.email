<messaging:emailTemplate recipientType="User"
                     relatedToType="PartnerFundClaim"
                     language="en_US"
                     subject="{!$Label.Core_MDF_EmailSubj1} # {!relatedTo.Core_MDF_Claim_Ref_Number__c}: {!relatedTo.Title} - which was on Bank Document Hold has been {!relatedTo.Core_MDF_Status__c}" renderUsingSystemContextWithoutSharing="True">
                      
                     
<messaging:htmlEmailBody >
    <html>
        <body>  <div style="font-size:14px;font-family:Calibri">    
                     
                               <p>      
                                            {!$Label.Core_MDF_EmailTemp_DearIntelemployee} <br/>
                              </p>  
                               <p>          {!$Label.Core_MDF_EmailSubj1} #&nbsp;
                                           <apex:outputLink value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">{!RelatedTo.Core_MDF_Claim_Ref_Number__c}</apex:outputLink>
                                            which was on Bank Document Hold has been {!relatedTo.Core_MDF_Status__c}. 
                                            
                                            <ul>
                                                <li>{!$Label.Core_MDF_EmailTemp_AdjReq_Create_Body4}&nbsp; {!RelatedTo.Core_MDF_AccountCompany__c}</li>
                                                <li>{!$Label.Core_MDF_Audit_Creation_Field1}&nbsp;: {!relatedTo.Core_MDF_Claim_Ref_Number__c}</li>                                                                                                
                                                <li>{!$Label.Core_MDF_EmailTemp_Claim_Activity_Name} {!RelatedTo.Request.Title}<br/></li>
                                                <li>{!$Label.Core_MDF_EmailTemp_Activity_Type} {!relatedTo.Core_MDF_Activity_Types__c}</li>
                                                <li>{!$Label.Core_MDF_EmailTemp_Claim_Country} {!RelatedTo.Core_MDF_Country_Location_nm__c}  <br/></li> 
                                                <li>{!$Label.Core_MDF_EmailTemp_Program}&nbsp; {!relatedTo.Core_MDF_Program__c}</li>
                                                <apex:outputPanel rendered="{!IF(RelatedTo.Core_MDF_Budget_Type_Options_Nm__c != null,true,false)}">
                                                <li>{!$Label.Core_MDF_EmailTemp_Budget_Type}  &nbsp; {!RelatedTo.Core_MDF_Budget_Type_Options_Nm__c }  <br/></li>
                                                </apex:outputPanel>                                               
                                            </ul> 
                                </p>
                                           <!-- <p> 
                                            {!$Label.Core_MDF_EmailContent1} &nbsp;
                                            <apex:outputLink value="{!$Label.Core_MDF_PFRDetailLink+RelatedTo.Id}">{!RelatedTo.Core_MDF_Claim_Ref_Number__c}</apex:outputLink>
                                                  
                                            {!$Label.Core_MDF_EmailContent2}.<br/></p>-->
                                            <p>{!$Label.Core_MDF_EmailTemp_StatusUpdate_Body7}</p>
                    <p>{!$Label.Core_MDF_Email_Signature}</p> 
                      
               
                <div style="font-size:11px;font-family:Calibri">
                                   <p>
                                     <i>  {!$Label.Core_MDF_EmailTemp_Claim_Footer1}
                                           <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                                            {!$Label.Core_MDF_EmailTemp_Claim_Footer2}<br/><br/></i>
                                            {!$Label.Core_MDF_EmailTemp_Claim_Footer3}
                                            <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Customer_Support}"> {!$Label.Core_MDF_EmailTemp_Claim_URL2} </a>
                                           {!$Label.Core_MDF_EmailTemp_Claim_Footer4}<br/><br/>
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Home}" > {!$Label.Core_MDF_EmailTemp_Footer3} </a> | 
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Trademarks}"> {!$Label.Core_MDF_EmailTemp_Footer4} </a> | 
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Privacy}"> {!$Label.Core_MDF_EmailTemp_Footer5} </a> |
                                    <a href = "{!$Label.Core_MDF_EmailTemp_Claim_HyperLink_Cookies}"> {!$Label.Core_MDF_EmailTemp_Footer6} </a>
                            </p>         
                    
                    </div> 
                               </div>
                               
        </body>
    </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>