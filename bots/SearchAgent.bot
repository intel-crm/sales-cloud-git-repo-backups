            </botSteps>
            <botSteps>
                <stepIdentifier>5a2b4065-6c28-42b1-806b-4e6050dd9339</stepIdentifier>
                <type>Wait</type>
            </botSteps>
            <developerName>Welcome</developerName>
            <isPlaceholderDialog>false</isPlaceholderDialog>
            <label>Welcome</label>
            <showInFooterMenu>false</showInFooterMenu>
        </botDialogs>
        <botDialogs>
            <botSteps>
                <botMessages>
                    <message>Something went wrong. Try again.</message>
                    <messageIdentifier>034e30ee-ed45-4f77-b83f-d66dbde0f660</messageIdentifier>
