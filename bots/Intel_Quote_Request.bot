                <stepIdentifier>f23743a6-f1f4-46d0-a5e4-1bb49a4355d6</stepIdentifier>
                <type>VariableOperation</type>
            </botSteps>
            <botSteps>
                <botStepConditions>
                    <leftOperandName>Is_Valid_User</leftOperandName>
                    <leftOperandType>ConversationVariable</leftOperandType>
                    <operatorType>Equals</operatorType>
                    <rightOperandValue>Active</rightOperandValue>
                </botStepConditions>
                <botSteps>
                    <botMessages>
                        <message>Looks like you have Intel Quote Request Access!! Please use https://quoterequest.intel.com/ , instead of https://signin.intel.com/</message>
                        <messageIdentifier>3091ab83-77e0-4a11-ae10-dc07db16ab3e</messageIdentifier>
                    </botMessages>
                    <stepIdentifier>b7fb86d1-5197-4775-999c-56a9d7bb0a07</stepIdentifier>
                    <type>Message</type>
                </botSteps>
                <conditionLogicType>And</conditionLogicType>
                <stepIdentifier>7f7a0283-76e1-484f-adf0-bcc0d519f808</stepIdentifier>
                <type>Group</type>
            </botSteps>
            <botSteps>
                <botStepConditions>
                    <leftOperandName>Is_Valid_User</leftOperandName>
                    <leftOperandType>ConversationVariable</leftOperandType>
                    <operatorType>Equals</operatorType>
                    <rightOperandValue>NoAccess</rightOperandValue>
                </botStepConditions>
                <botSteps>
                    <botMessages>
                        <message>Looks like you do not have Intel Quote Request Access!! Pleae follow below steps to request access.</message>
