        <botDialogs>
            <botSteps>
                <botVariableOperation>
                    <askCollectIfSet>false</askCollectIfSet>
                    <botMessages>
                        <message>Please enter your email.</message>
                        <messageIdentifier>f2351c8b-25d7-4474-8b8e-27aa4ad6c7e6</messageIdentifier>
