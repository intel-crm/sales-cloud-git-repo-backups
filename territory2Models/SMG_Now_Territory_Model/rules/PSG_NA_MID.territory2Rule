<?xml version="1.0" encoding="UTF-8"?>
<Territory2Rule xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <booleanFilter>(1 AND 2 AND 3 AND 6) OR (1 AND 2 AND 4 AND 5 AND 6)</booleanFilter>
    <name>PSG-NA-MID</name>
    <objectType>Account</objectType>
    <ruleItems>
        <field>Account.Core_PSG_Account__c</field>
        <operation>equals</operation>
        <value>True</value>
    </ruleItems>
    <ruleItems>
        <field>Account.BillingCountryCode</field>
        <operation>equals</operation>
        <value>USA</value>
    </ruleItems>
    <ruleItems>
        <field>Account.BillingPostalCode</field>
        <operation>startsWith</operation>
        <value>07,08,10,11,124,125,126,127</value>
    </ruleItems>
    <ruleItems>
        <field>Account.BillingPostalCode</field>
        <operation>greaterOrEqual</operation>
        <value>15000</value>
    </ruleItems>
    <ruleItems>
        <field>Account.BillingPostalCode</field>
        <operation>lessOrEqual</operation>
        <value>19699</value>
    </ruleItems>
    <ruleItems>
        <field>Account.Core_Deactivated__c</field>
        <operation>equals</operation>
        <value>False</value>
    </ruleItems>
</Territory2Rule>
