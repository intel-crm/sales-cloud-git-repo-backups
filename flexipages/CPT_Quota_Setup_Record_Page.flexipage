                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style=&quot;color: rgb(237, 12, 12); font-size: 14px;&quot;&gt;Note: &lt;/strong&gt;&lt;span style=&quot;color: rgb(237, 12, 12); font-size: 14px;&quot;&gt;Next Gen DCG and Margin DCG must be selected together. Also, if any Next Gen CCG (LNL, PTL, WCL) is selected, Margin CCG must also be selected.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-family: IntelOneTextNormal, system-ui, &amp;quot;Segoe UI&amp;quot;, Helvetica, sans-serif; color: rgb(231, 19, 19); font-size: 14px;&quot;&gt;Note:&lt;/strong&gt;&lt;span style=&quot;font-family: IntelOneTextNormal, system-ui, &amp;quot;Segoe UI&amp;quot;, Helvetica, sans-serif; color: rgb(231, 19, 19); font-size: 14px;&quot;&gt; The assignment % is equally distributed among all selected MarginVolume Sub-Elements.&lt;/span&gt;&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
