                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;&lt;strong&gt;Training &amp;amp; Resources&lt;/strong&gt;&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://salescrm.intel.com/intel-quote-request-home/tenders-iqr-home/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Tenders IQR Training&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrm.intel.com/intel-quote-request-home/tenders-iqr-home/tenders-iqr-access/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Requesting/Granting IQR Access&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrm.intel.com/intel-quote-request-home/tenders-iqr-home/tenders-iqr-overview/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Quote Request Overview&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrm.intel.com/intel-quote-request-home/tenders-iqr-home/tenders-iqr-glossary/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Tenders IQR Glossary&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrm.intel.com/intel-quote-request-home/tenders-iqr-home/tenders-iqr-reporting/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Tenders IQR Reporting&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrm.intel.com/intel-quote-request-home/tenders-iqr-home/tenders-iqr-support/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Support &amp;amp; FAQs&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://goto/DirectPPG&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Direct and Indirect Price Process Guidelines&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://goto/OpsSPGs&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Operational Requirements of the Sales Process Guidelines&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;mailto:IntelQuoteRequest@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Email the Tenders IQR Inbox&lt;/a&gt;&lt;/li&gt;&lt;li&gt;Regional Leads&lt;ul&gt;&lt;li&gt;Global/EMEA - &lt;a href=&quot;mailto:nuria.galceran@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Nuria Galceran&lt;/a&gt;&lt;/li&gt;&lt;li&gt;AMR - &lt;a href=&quot;mailto:loren.belcher@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Loren Belcher&lt;/a&gt;&lt;/li&gt;&lt;li&gt;APJ - &lt;a href=&quot;mailto:baoru.lu@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Baoru Lu&lt;/a&gt;&lt;/li&gt;&lt;li&gt;PRC - &lt;a href=&quot;mailto:siying.lin@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Siying Lin&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;</value>
                </componentInstanceProperties>
