                        </valueListItems>
                        <valueListItems>
                            <value>Core_Design_Registration_Product__c.PCC_Cancel_Product</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Core_Design_Product_Status_Nm__c}</leftValue>
                                    <operator>EQUAL</operator>
