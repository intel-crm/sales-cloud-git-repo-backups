                                <criteria>
                                    <leftValue>{!Record.Core_Design_Product_Status_Nm__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Pending</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>IT Admin</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.PCC_Deal_Reg_Internal_Admin_Custom}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Deal accepted</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Re-Submitted</rightValue>
                                </criteria>
                                <criteria>
