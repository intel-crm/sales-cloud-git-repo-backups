                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.PCC_Deal_Reg_Internal_Admin_Custom}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
