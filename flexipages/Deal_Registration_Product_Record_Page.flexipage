                                    <operator>EQUAL</operator>
                                    <rightValue>Re-Submitted</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Core_Design_Registration_Id__r.Core_Design_Registration_Status_Nm__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Pre-Approved</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
