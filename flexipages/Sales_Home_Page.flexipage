                <componentInstanceProperties>
                    <name>ReportId</name>
                    <value>342701e8-bf36-4a59-9152-4610a941ea92</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>WorkspaceId</name>
                    <value>3cbd5a25-bdbe-4f0c-bd52-29644fba9ca9</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>configName</name>
                    <value>AutoSignIn_for_PowerBI_Report</value>
