                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Trainings&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/training-and-help/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Home&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/training-and-help/account-and-contact-management/access-and-entitlement-2/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Access &amp;amp; Entitlement&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrm.intel.com/training-and-help/account-and-contact-management/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Account &amp;amp; Contact Management&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/training-and-help/commissions-2/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Commissions&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://intel.sharepoint.com/sites/ccptrainingandcommunications&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Co-Marketing&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/training-and-help/salescrm-functionality/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;General Salesforce Functionality&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/training-and-help/intel-premier-support-ips/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;IPS Training&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://saleskpi.intel.com/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Sales KPI Resources&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/training-and-help/lead-management/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Lead Management&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/training-and-help/opportunity-management/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Opportunity Management&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/training-and-help/pipeline-management/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Pipeline Management&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/training-and-help/reporting/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Reporting&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/lightning-update-2/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: rgb(0, 95, 178);&quot;&gt;Introduction to Lightning Experience&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;</value>
                </componentInstanceProperties>
