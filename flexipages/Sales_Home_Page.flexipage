    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Custom Links&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;http://salescrm.intel.com/whats-new-2/&quot; target=&quot;_blank&quot;&gt;Sales CRM What’s New&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://soco.intel.com/groups/cloud-crm&quot; target=&quot;_blank&quot;&gt;SMG Sales CRM Inside Blue Group&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://intel--c.na74.visual.force.com/apex/showMAGquestionaire?id=005o0000001faAE&quot; target=&quot;_blank&quot; style=&quot;color: rgb(0, 95, 178);&quot;&gt;MAG Questionnaire&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText4</identifier>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;NEW Salesforce Lightning Experience (LEX)&lt;/h2&gt;&lt;p&gt;We updated our Sales CRM to the current new user interface on September 10th, 2018 :&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Lightning Experience (LEX) is a more modern and intuitive interface, designed to maximize your productivity and allow you to find what you need faster. It provides a significant improvement over the 15 year old “Classic” user interface that we are using today.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please find an introduction video, as well as, BKMs, FAQs, and further LEX training at &lt;a href=&quot;http://goto/LEX&quot; target=&quot;_blank&quot;&gt;goto/LEX&lt;/a&gt;.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText5</identifier>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Co-Marketing&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://sqlbi-dev.intel.com/Reports/browse/Co-Marketing/CCP&quot; target=&quot;_blank&quot;&gt;Co-Marketing Power BI Reports&lt;/a&gt; &lt;a href=&quot;https://soco.intel.com/docs/DOC-2613307&quot; target=&quot;_blank&quot;&gt;(request access)&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText6</identifier>
                <visibilityRule>
                    <booleanFilter>1 OR 2</booleanFilter>
                    <criteria>
                        <leftValue>{!$Permission.CustomPermission.Core_MDF_CoMarketingPowerBIDashboardLink}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>true</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!$User.Profile.Name}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>System Administrator</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
