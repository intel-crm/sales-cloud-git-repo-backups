<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Xvoyant Admins can use this page to build. modify and verify Xvoyant hierarchies.</description>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>Xvoyant:hierarchy</componentName>
                <identifier>hierarchy</identifier>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>Xvoyant Hierarchy Tool</masterLabel>
    <template>
        <name>flexipage:defaultAppHomeTemplate</name>
    </template>
    <type>AppPage</type>
</FlexiPage>
