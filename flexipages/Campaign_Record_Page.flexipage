<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Edit</value>
                        </valueListItems>
                        <valueListItems>
                            <value>Campaign.Create_Activity</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Core_MDF_Client_CoMarketing_Fund_Boost</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Core_MDF_Service_Provider_CoMarketing_Fund</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Campaign.Core_MDF_Submit_For_Approval</value>
                            <visibilityRule>
                                <booleanFilter>(1 OR 5) AND (2 OR 3 OR 4)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Core_MDF_Intel_Partner_Alliance</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Core_MDF_Intel_Partner_Alliance_Closed</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.RecordType.DeveloperName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Core_MDF_Channel_MDF</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Revision Required</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Campaign.Core_MDF_Cancel_Campaign</value>
                        </valueListItems>
                        <valueListItems>
                            <value>Campaign.Core_MDF_CampaignClone</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
