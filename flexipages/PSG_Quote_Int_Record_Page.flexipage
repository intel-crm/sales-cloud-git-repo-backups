    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style=&quot;font-size: 16px; color: rgb(254, 3, 3);&quot;&gt;Important for Altera/PSG Users:&amp;nbsp;Starting July 28, 2025, use the new Altera Salesforce for accounts, contacts, leads, design registration, opportunities, quotes (except corporate tool quotes) and DPAs. Exception:&amp;nbsp;Use Intel Salesforce (IQR) for corporate tool quotes, orders, licensing, and IPS. For details, visit the &lt;/strong&gt;&lt;a href=&quot;https://altera.sharepoint.com/sites/AlteraBusinessEnablementSalesforce/SitePages/FAQs.aspx?csf=1&amp;amp;web=1&amp;amp;e=8DrWLE&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 16px; color: rgb(254, 3, 3); background-color: rgb(255, 255, 255);&quot;&gt;&lt;strong&gt;&lt;u&gt;Altera CRM FAQ&lt;/u&gt;&lt;/strong&gt;&lt;/a&gt;&lt;strong style=&quot;font-size: 16px; color: rgb(254, 3, 3);&quot;&gt;.&lt;/strong&gt;&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText5</identifier>
                <visibilityRule>
                    <criteria>
                        <leftValue>{!Record.Pricing_Quote_Program_Nm__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>PSG</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style=&quot;color: rgb(240, 9, 9);&quot;&gt;PRID De-activation/Revision Alert! Approving the Quote will de-activate/Revise the PRIDs and impact the DPAs/ALNs&lt;/strong&gt;&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText</identifier>
                <visibilityRule>
                    <booleanFilter>1 AND 2</booleanFilter>
                    <criteria>
                        <leftValue>{!Record.core_cpq_ql_with_prid_deactivation__c}</leftValue>
                        <operator>GE</operator>
                        <rightValue>1</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.core_cpq_quote_type_nm__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>Design Win</rightValue>
                    </criteria>
