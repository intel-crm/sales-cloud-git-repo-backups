                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.core_cpq_quote_type_nm__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Tools</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.core_cpq_record_type__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>PSG Quote - Inactive Quotes</rightValue>
                                </criteria>
