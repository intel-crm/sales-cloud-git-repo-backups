                                    <leftValue>{!Record.core_cpq_record_type__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>PSG Quote - Submitted</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.core_cpq_record_type__c}</leftValue>
                                    <operator>EQUAL</operator>
