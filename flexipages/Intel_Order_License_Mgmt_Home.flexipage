                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style=&quot;color: rgb(50, 50, 50); font-size: 18px; font-family: sans-serif;&quot;&gt;PSG Order &amp;amp; Licensing Dashboards&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;For Dashboards related to Order Management and Licensing - Click on below links&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://sqlbiprd.intel.com/Reports/powerbi/PSG%20Sales/PSG%20License%20renewals&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 12px; color: rgb(13, 161, 224);&quot;&gt;&lt;u&gt;PSG License Renewals Power BI Dashboard&lt;/u&gt;&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://intel.lightning.force.com/lightning/r/Folder/00l3b000001jmD3AAI/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 12px; color: rgb(13, 161, 224);&quot;&gt;&lt;u&gt;PSG Order and License related Salesforce Dashboard&lt;/u&gt;&lt;/a&gt;&lt;a href=&quot;https://intel.lightning.force.com/lightning/r/Folder/00l3b000001jmD3AAI/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: rgb(13, 161, 224);&quot;&gt;&lt;u&gt;s&lt;/u&gt;&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText3</identifier>
            </componentInstance>
        </itemInstances>
        <itemInstances>
