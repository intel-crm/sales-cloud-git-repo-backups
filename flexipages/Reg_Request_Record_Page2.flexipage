        <itemInstances>
            <componentInstance>
                <componentName>pRM_MatchingAccountList</componentName>
                <identifier>c_pRM_MatchingAccountList</identifier>
                <visibilityRule>
                    <booleanFilter>(1 OR (2 AND (3 OR 6))) AND 4 AND 5 AND 7</booleanFilter>
                    <criteria>
                        <leftValue>{!Record.PRM_Status__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>New</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.PRM_Status__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>Pending</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.PRM_Rejected_By__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>MDM</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.PRM_Record_Type_Name_rpt_txt__c}</leftValue>
                        <operator>NE</operator>
                        <rightValue>Email Verification Request</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.PRM_Channel_Program_Level_txt__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>Intel Partner Alliance</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.PRM_Rejected_By__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>Data Ops</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.PRM_Salesforce_ID__r.Name}</leftValue>
                        <operator>EQUAL</operator>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
