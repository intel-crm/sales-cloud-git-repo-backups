                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;&lt;strong&gt;Training &amp;amp; Resources&lt;/strong&gt;&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://salescrmtraining.intel.com/sales-tools/sales-crm/intel-quote-request-iqr-for-tenders/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Tenders IQR Training&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrmtraining.intel.com/sales-tools/sales-crm/intel-quote-request-iqr-for-tenders/requesting-internal-access-to-iqr-for-tenders/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Requesting/Granting IQR Access&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrmtraining.intel.com/sales-tools/sales-crm/intel-quote-request-iqr-for-tenders/tenders-iqr-overview/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Quote Request Overview&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrmtraining.intel.com/sales-tools/sales-crm/intel-quote-request-iqr-for-tenders/iqr-for-tenders-glossary/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Tenders IQR Glossary&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrmtraining.intel.com/sales-tools/sales-crm/intel-quote-request-iqr-for-tenders/tenders-iqr-reporting/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Tenders IQR Reporting&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://salescrmtraining.intel.com/sales-tools/intel-quote-request-home/tenders-iqr-home/tenders-iqr-support/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Support &amp;amp; FAQs&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://goto/DirectPPG&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Direct and Indirect Price Process Guidelines&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;http://goto/OpsSPGs&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Operational Requirements of the Sales Process Guidelines&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;mailto:IntelQuoteRequest@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Email the Tenders IQR Inbox&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Regional Leads&lt;/strong&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Global &lt;/strong&gt;- &lt;a href=&quot;mailto:gemma.waters@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Gemma Water&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;AMR - &lt;/strong&gt;&lt;a href=&quot;mailto:loren.belcher@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Loren Belcher&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;APJ - &lt;/strong&gt;&lt;a href=&quot;mailto:jen.chen@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Jen Chen&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;PRC - &lt;/strong&gt;&lt;a href=&quot;mailto:siying.lin@intel.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Siying Lin&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;</value>
