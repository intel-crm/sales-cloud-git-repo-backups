<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong&gt;﻿Welcome to Intel Quote Request!&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Tenders IQR is going live for CCG on Tuesday, September 20th! Recordings from the training sessions are available on the &lt;a href=&quot;https://intel.sharepoint.com/sites/MeetComp/SitePages/Tenders-IQR-Training.aspx&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Tenders IQR Training SharePoint&lt;/a&gt;. Office Hours sessions will be held WW39 – WW41 to provide support and address any questions/concerns that arise as Client tender requests start flowing through IQR.&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;p&gt;To help you quickly access the information you need, this homepage can be customized. The intent of the sections below is for you to select list views that contain quotes you can collaborate on, quotes that are missing an Opportunity ID, and quotes with a Proposal Due Date in the Past 30 Days. To get started, these list views have already been created for you, and you can select them from the lists in the sections below. If you have questions, reach out to your Regional Lead.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>flexipage_richText</identifier>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>listOfItemTitle</name>
                    <value>IQR Quotes</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>objectAPI</name>
                    <value>SBQQ__Quote__c</value>
                </componentInstanceProperties>
                <componentName>pricing_listViewComp</componentName>
                <identifier>c_pricing_listViewComp</identifier>
            </componentInstance>
        </itemInstances>
        <itemInstances>
