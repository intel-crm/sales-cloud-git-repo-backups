                        </valueListItems>
                        <valueListItems>
                            <value>Share</value>
                        </valueListItems>
                        <valueListItems>
                            <value>RecordShareHierarchy</value>
                        </valueListItems>
                        <valueListItems>
                            <value>IsotopeSubscription</value>
                        </valueListItems>
                    </valueList>
                </componentInstanceProperties>
