<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>FeedItem.TextPost</value>
                        </valueListItems>
                        <valueListItems>
                            <value>FeedItem.ContentPost</value>
                        </valueListItems>
                        <valueListItems>
