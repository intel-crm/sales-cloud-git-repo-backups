    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Edit</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.DDR_Read_Only}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Clone</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.DDR_Read_Only}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Core_Design_Registration__c.Core_Accept_Design_Lex</value>
                            <visibilityRule>
                                <booleanFilter>(1 AND 4 ) OR 3 OR 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.DDR_Internal_Users}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>IT Admin</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Core_Design_Registration_Status_Nm__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Pre-Approved</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Core_Design_Registration__c.Core_Reject_Design_Lex</value>
                            <visibilityRule>
                                <booleanFilter>1 OR 2  OR (3 AND 4 AND 5 AND 6)</booleanFilter>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>IT Admin</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.DDR_Internal_Users}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Workflow_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Pre-Approved</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Core_Design_Registration_Status_Nm__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Rejected</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Core_Design_Registration_Status_Nm__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Re-Submitted</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Core_Design_Registration__c.Core_Approve_Design_Lex</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.Core_Approve_High_Touch_Button_Visible__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Core_Design_Registration__c.PCC_Approve_Low_Touch_Design</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.Core_Approve_Low_Touch_Button_Visible__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Core_Design_Registration__c.PCC_Set_as_Expired</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Core_Design_Registration_Status_Nm__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Approved</rightValue>
                                </criteria>
