                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;a href=&quot;https://intel.lightning.force.com/lightning/r/sObject/00O3b000007QxSEEA0/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Archived Data&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://intel.lightning.force.com/lightning/r/sObject/00O3b000007RX0lEAG/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Request Pending Approvals&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://intel.lightning.force.com/lightning/r/sObject/00O3b000007RX0kEAG/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Self Registration Requests Status&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;1PID DQ Reports:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://intel--crmqa8.sandbox.lightning.force.com/lightning/r/Report/00OHo0000063hYVMAY/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;1PID Accounts Created This Month&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://intel--crmqa8.sandbox.lightning.force.com/lightning/r/Report/00OHo0000063hYRMAY/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Active 1PID with No Intel Account Association&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://intel--crmqa8.sandbox.lightning.force.com/lightning/r/Report/00OHo0000063hYSMAY/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Active 1PID Association with Inactive Intel Account&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://intel--crmqa8.sandbox.lightning.force.com/lightning/r/Report/00OHo0000063hYWMAY/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;1PID with Inactive UCD Primary Account&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://intel--crmqa8.sandbox.lightning.force.com/lightning/r/Report/00OHo0000063hYTMAY/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Intel Accounts without 1PID Association&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://intel--crmqa8.sandbox.lightning.force.com/lightning/r/Report/00ODw000000nj8cMAA/view?queryScope=userFolders&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Active 1PID without UCD Primary Account&lt;/a&gt;&lt;/p&gt;</value>
