<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>SBQQ__Quote__c.Pricing_Submit_Tender_Quote</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_Tender_Regional_Pricing_Manager}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Tender_Account_Executive}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_Tender_IT_Specialist}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>SBQQ__Quote__c.PSG_Clone</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3</booleanFilter>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_Tender_Regional_Pricing_Manager}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Tender_Read_Only}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_Tender_Divisional_Pricing_Manager}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>CustomButton.SBQQ__Quote__c.Pricing_Create_Quote_Letter</value>
                            <visibilityRule>
                                <booleanFilter>1 OR 2 OR 3</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Approved</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Won</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Lost</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
