<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Pricing Software Quote - Edit Record Type for Software &amp; Services Quote in Draft Status.</description>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Edit</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>CustomButton.SBQQ__Quote__c.SBQQ__EditLines</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>CustomButton.SBQQ__Quote__c.Recall_Approval</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>In Review</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>CustomButton.SBQQ__Quote__c.Preview_Approval</value>
                            <visibilityRule>
                                <booleanFilter>(1 OR 2) AND 3</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>In Review</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>CustomButton.SBQQ__Quote__c.Submit_for_Approval</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Pricing_SW_Custom_Product__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Pricing_SW_Expiry_Less_Than_14_days__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Pricing_SW_Opportunity_Submit_Or_Approve__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__LineItemCount__c}</leftValue>
                                    <operator>GE</operator>
                                    <rightValue>1</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>SBQQ__Quote__c.Pricing_SW_Submit_for_Approval</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND (3 OR 4 OR 5 OR 6)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Pricing_SW_Custom_Product__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Pricing_SW_Expiry_Less_Than_14_days__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Pricing_SW_Opportunity_Submit_Or_Approve__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__LineItemCount__c}</leftValue>
                                    <operator>LT</operator>
                                    <rightValue>1</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>CustomButton.SBQQ__Quote__c.SBQQ__PreviewDocument</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>CustomButton.SBQQ__Quote__c.SBQQ__GenerateDocument</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>CustomButton.SBQQ__Quote__c.SBQQ__CloneWithRelated</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Accepted</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>SBQQ__Quote__c.Pricing_SW_Clone</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Accepted</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Delete</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.SBQQ__Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Pricing_SW_CPQ_User}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                    </valueList>
                </componentInstanceProperties>
