                                    <leftValue>{!Record.PRM_Channel_Program_Level_txt__c}</leftValue>
                                    <operator>CONTAINS</operator>
                                    <rightValue>PSG</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Email_Verification_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
