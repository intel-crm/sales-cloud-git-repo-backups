<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>PRM_Registration_Request__c.Create_Lead</value>
                            <visibilityRule>
                                <booleanFilter>1 AND (2 OR 3) AND 4</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.PRM_Record_Type_Name_rpt_txt__c}</leftValue>
                                    <operator>CONTAINS</operator>
                                    <rightValue>Account Create Request</rightValue>
                                </criteria>
