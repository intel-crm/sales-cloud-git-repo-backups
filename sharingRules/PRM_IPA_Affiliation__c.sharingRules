<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>IPA_Internal_Intel_Admin_Users_Account_IPA_Affiliation</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share all Account IPA Affiliation records to all IPA Internal Admin Users</description>
        <label>IPA Internal - Intel Admin Users - Account IPA Affiliation</label>
        <sharedTo>
            <group>IPA_All_Intel_Admin_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
