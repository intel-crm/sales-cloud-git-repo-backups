<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_MDF_UGMLog_All_Contingent_Workers_Group_Read_Write</fullName>
        <accessLevel>Edit</accessLevel>
        <label>UGMLog All Contingent Workers Group Read Write</label>
        <sharedTo>
            <group>Core_All_Contingent_Workers_Group</group>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>[empty]</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_MDF_UGMLog_All_Employee_Read_Write</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This User Group Mapping Log Sharing Rule would provide  READ/WRITE Access to All Active Users to all Intel Employees</description>
        <label>UGMLog All Employee Read Write</label>
        <sharedTo>
            <group>Core_All_Employees_Group</group>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>[empty]</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
