<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>PMP_External_Coveo_User_Category</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Category records to Coveo Integration User</description>
        <label>PMP External - Coveo User - Category</label>
        <sharedTo>
            <group>Core_PG_Coveo_Integrator</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
