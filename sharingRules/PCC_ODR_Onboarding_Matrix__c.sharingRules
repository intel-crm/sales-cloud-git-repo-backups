<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>PCC_ODR_Onboarding_Matrix_Sharing_Rule</fullName>
        <accessLevel>Read</accessLevel>
        <description>to share ODR records with external PCC users</description>
        <label>ODR_Onboarding_Matrix_Sharing_Rule</label>
        <sharedTo>
            <group>Core_DDR_Partner_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
