<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>PCC_Product_MM_Attribute_Mapping_Sharing</fullName>
        <accessLevel>Read</accessLevel>
        <description>Sharing rule to share Product MM Attribute Mapping records with PCC external users</description>
        <label>Product MM Attribute Mapping Sharing</label>
        <sharedTo>
            <group>Core_DDR_Partner_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>IsActive__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
