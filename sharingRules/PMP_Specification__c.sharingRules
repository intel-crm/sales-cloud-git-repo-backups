<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>PMP_External_Anonymous_Users_Specification</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Specification records to all Anonymous Users</description>
        <label>PMP External - Anonymous Users - Specification</label>
        <sharedTo>
            <group>PMP_All_Anonymous_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <criteriaItems>
            <field>PMP_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_External_Partner_Users_Specification</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Specification records to all Partner Users</description>
        <label>PMP External - Partner Users - Specification</label>
        <sharedTo>
            <group>PMP_All_Partner_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_Internal_Intel_CW_Users_Specification</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Specification records to all Intel CW Users</description>
        <label>PMP Internal - Intel CW Users - Specification</label>
        <sharedTo>
            <group>Core_All_Contingent_Workers_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_Internal_Intel_Users_Specification</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Specification records to all Intel Users</description>
        <label>PMP Internal - Intel Users - Specification</label>
        <sharedTo>
            <group>Core_All_Employees_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_Internal_Intel_Vendor_Users_Specification</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Specification records to all Intel Vendor Users</description>
        <label>PMP Internal - Intel Vendor Users - Specification</label>
        <sharedTo>
            <group>PMP_All_IOT_Vendor_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingGuestRules>
        <fullName>PMP_External_Guest_User_Specification</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Specification records to Guest User</description>
        <label>PMP External - Guest User - Specification</label>
        <sharedTo>
            <guestUser>Intel_Solutions_Marketplace</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <criteriaItems>
            <field>PMP_Active_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
