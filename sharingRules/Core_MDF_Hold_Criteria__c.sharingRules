<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_MDF_Criteria_Hold_All_Users_CCP_Internal_Read_Write</fullName>
        <accessLevel>Edit</accessLevel>
        <description>To Share all the Hold Criteria List Records with All Users CCP Internal Group</description>
        <label>Criteria Hold All Users - CCP Internal Read Write</label>
        <sharedTo>
            <group>Core_All_Users_CCP_Internal</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>[empty]</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
