<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_MDF_Exception_Case_Mapping_All_Internal</fullName>
        <accessLevel>Read</accessLevel>
        <description>This Sharing rules shares all Exception Case Mapping records with Internal users</description>
        <label>Exception Case Mapping All Internal</label>
        <sharedTo>
            <group>Core_All_Users_CCP_Internal</group>
        </sharedTo>
        <booleanFilter>1 OR 2 OR 3 OR 4</booleanFilter>
        <criteriaItems>
            <field>Core_MDF_Program_txt__c</field>
            <operation>equals</operation>
            <value>Core_MDF_Client_CoMarketing_Fund</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_MDF_Program_txt__c</field>
            <operation>equals</operation>
            <value>Core_MDF_Data_Center_CoMarketing_Fund</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_MDF_Program_txt__c</field>
            <operation>equals</operation>
            <value>Core_MDF_Service_Provider_CoMarketing_Fund</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_MDF_Program_txt__c</field>
            <operation>equals</operation>
            <value>Core_MDF_Client_CoMarketing_Fund_Boost</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
