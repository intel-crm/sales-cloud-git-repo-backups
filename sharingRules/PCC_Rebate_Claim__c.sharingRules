<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>PCC_Share_APJ_RC_to_APJ_PSAM</fullName>
        <accessLevel>Read</accessLevel>
        <label>Share APJ RC to APJ PSAM</label>
        <sharedTo>
            <group>AGS_Deal_Reg_Access_APJ</group>
        </sharedTo>
        <criteriaItems>
            <field>PCC_Partner_Account_Region__c</field>
            <operation>equals</operation>
            <value>APJ</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PCC_Share_ASMO_RC_to_ASMO_PSAM</fullName>
