        <accessLevel>Read</accessLevel>
        <label>Share All Rebate Claim Records with LegalFinance</label>
        <sharedTo>
            <group>Pricing_Fin_Incntv_Read_Only_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
