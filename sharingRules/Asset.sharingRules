<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_IPS_Asset_Share_R_for_IPS_ReadOnly_Users</fullName>
        <accessLevel>Read</accessLevel>
        <description>This would provide Read Access to all IN Public Group &quot;Group: IPS Read Only&quot;  that includes Dual, sales Ops, Data Ops etc</description>
        <label>IPS Asset Share R for IPS ReadOnly Users</label>
        <sharedTo>
            <group>Core_IPS_Read_Only</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS Asset</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private_Project__c</field>
            <operation>notEqual</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_Asset_Share_R_for_IPS_Users</fullName>
        <accessLevel>Read</accessLevel>
        <description>TME/ADMIN access for Assets</description>
        <label>IPS Asset Share R for IPS Users</label>
        <sharedTo>
            <roleAndSubordinatesInternal>IPS_Product_Org_Admin</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS Asset</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private_Project__c</field>
            <operation>notEqual</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_Public_Product_Sharing</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share Public Supported Product to all Internal and Community Users</description>
        <label>Core IPS Public Product Sharing</label>
        <sharedTo>
            <roleAndSubordinates>SMG</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS Public Product</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_Public_Read_Asset</fullName>
        <accessLevel>Read</accessLevel>
        <label>IPS Public Read Asset</label>
        <sharedTo>
            <group>Core_IPS_Public_Read</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_IPS_Private_Project__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
