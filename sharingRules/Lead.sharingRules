    <sharingCriteriaRules>
        <fullName>Cvent_Integration_User_Leads</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share all Intel leads to Cvent Integration user.</description>
        <label>Cvent - Integration User - Leads</label>
        <sharedTo>
            <group>Cvent_Integration_User</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Sales Lead</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Marketo_User_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Marketo User Sharing</label>
        <sharedTo>
            <group>Marketo_Access_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>CreatedById</field>
            <operation>equals</operation>
            <value>005D3000006z7ilIAA</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>SWS_6Sense_Lead_Sharing</fullName>
