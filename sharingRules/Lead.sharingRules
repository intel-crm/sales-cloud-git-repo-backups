    <sharingCriteriaRules>
        <fullName>Share_with_IDC_Users</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share IDC created Lead with IDC Group</description>
        <label>Share with IDC Users</label>
        <sharedTo>
            <group>AGS_SWS_IDC_Business_Ops</group>
        </sharedTo>
        <criteriaItems>
