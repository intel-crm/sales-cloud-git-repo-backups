<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_Lead_APJ_APJSalesOps_ReadWrite</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This Lead  Sharing Rule would provide READ/WRITE Access to All Lead for APJ Geo to Sales Ops in the APJ Geo</description>
        <label>Lead_APJ_APJSalesOps_ReadWrite</label>
        <sharedTo>
            <group>Core_Sales_Ops_APJ</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_Geo__c</field>
            <operation>equals</operation>
            <value>APJ</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_Lead_ASMO_ASMOSalesOps_ReadWrite</fullName>
