<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_User_Snapshot_APJ</fullName>
        <accessLevel>Read</accessLevel>
        <description>Read access to all users records in the User Snapshot object  that are from APJ Geo</description>
        <label>User Snapshot APJ</label>
        <sharedTo>
            <group>Core_User_Snapshot_APJ</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_Geo__c</field>
            <operation>equals</operation>
            <value>APJ</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
