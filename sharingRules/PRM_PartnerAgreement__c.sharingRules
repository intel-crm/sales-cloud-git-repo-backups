<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>PCC_Partner_Sharing_Setting</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Deal Registration record sharing settings for partners.</description>
        <label>Partner Sharing Setting</label>
        <sharedTo>
            <group>PCC_Deal_Reg_Partner_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>equals</operation>
            <value>Deal_Registration_Terms_and_Conditions</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
