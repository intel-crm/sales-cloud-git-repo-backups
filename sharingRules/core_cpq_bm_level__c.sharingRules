<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>psg_manage_bm_level_for_business_admin</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Giving access for all BM Level object records to PSG Business Admin group.</description>
        <label>Manage BM Level for Business Admin</label>
        <sharedTo>
            <group>ags_business_admin</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
