<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Case_Review_Document_PIC_Reviewer</fullName>
        <accessLevel>Read</accessLevel>
        <description>Sharing for PIC Reviewer as Read</description>
        <label>Case Review Document - PIC Reviewer</label>
        <sharedTo>
            <group>Core_MDF_AGS_CCP_PIC_Reviewer</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_MDF_Case_Review_Document_Share</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Core MDF Case Review Document Share</label>
        <sharedTo>
            <group>Core_MDF_CCP_Claim_Case_Reviewer_Q_Group</group>
        </sharedTo>
        <booleanFilter>1</booleanFilter>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>{empty}</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_MDF_Case_Review_Document_Share_L2_Support_users</fullName>
        <accessLevel>Read</accessLevel>
        <label>Case Review Document Share - L2 Support Users</label>
        <sharedTo>
            <group>Core_MDF_AGS_CCP_L2_Maintenance_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>{empty}</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_MDF_Case_Review_Document_Share_L3_Support_users</fullName>
        <accessLevel>Read</accessLevel>
        <label>Case Review Document Share - L3 Support Users</label>
        <sharedTo>
            <group>Core_MDF_AGS_CCP_L3_Maintenance_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>{empty}</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_MDF_Case_Review_Document_Share_Support_users</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share Audit Document Records with CCP Support User Group</description>
        <label>Case Review Document Share - Support Users</label>
        <sharedTo>
            <group>Core_MDF_AGS_CCP_Support_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>{empty}</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_MDF_Share_Documents_To_CDB_Intg_User</fullName>
        <accessLevel>Read</accessLevel>
        <description>This rule is to share the Case review Documents to CDB Integration User</description>
        <label>Core_MDF_Share_Documents_To_CDB_Intg_User</label>
        <sharedTo>
            <group>Core_AI_CDB_Integrations_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>{empty}</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_MDF_SFT_File_Download_Ind__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
