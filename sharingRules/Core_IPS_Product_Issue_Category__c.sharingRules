            <role>IPS_Product_Org_Admin</role>
        </sharedTo>
        <sharedFrom>
            <roleAndSubordinatesInternal>IPS_Product_Org_Admin</roleAndSubordinatesInternal>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
