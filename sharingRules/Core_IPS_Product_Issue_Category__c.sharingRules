<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingOwnerRules>
        <fullName>Core_IPS_All_CaseCat_RW_to_AllOrgAdmins</fullName>
