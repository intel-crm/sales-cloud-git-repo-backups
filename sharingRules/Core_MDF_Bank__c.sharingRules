<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>CORE_MDF_BANK_ALL_INTERNAL</fullName>
        <accessLevel>Edit</accessLevel>
        <label>BANK ALL INTERNAL</label>
        <sharedTo>
            <group>Core_All_Users_CCP_Internal</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_MDF_Bank_Name__c</field>
            <operation>notEqual</operation>
            <value>[empty]</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>CORE_MDF_BANK_CCF</fullName>
        <accessLevel>Edit</accessLevel>
        <label>BANK CCF</label>
