<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>CRM_VBS_AMR_SOAR_Committee_Share</fullName>
        <accessLevel>Edit</accessLevel>
        <label>AMR SOAR Committee Share</label>
        <sharedTo>
            <group>CRM_VBS_AMR_SOAR_Committee</group>
        </sharedTo>
        <criteriaItems>
            <field>CRM_VBS_Opportunity_Region__c</field>
            <operation>equals</operation>
            <value>ASMO</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
