<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_Share_Account_Plan_records_with_ELT_group</fullName>
        <accessLevel>Read</accessLevel>
        <description>To share all the Account plan records in read-only mode with group - Intel ELT group</description>
        <label>Share Account Plan records with ELT group</label>
        <sharedTo>
            <group>Core_Intel_ELT_group</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
