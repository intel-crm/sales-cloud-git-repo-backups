<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_IPS_ProjectAccess_RW_to_AllIPSUsers</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This would give all IPS folks (Agent + Admin )read access to all Projects</description>
        <label>Core IPS ProjectAccess RW to AllIPSUsers</label>
        <sharedTo>
            <roleAndSubordinatesInternal>IPS_Product_Org_Admin</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Active</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private__c</field>
            <operation>notEqual</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_ProjectAccess_R_to_IPS_ReadOnly_Users</fullName>
        <accessLevel>Read</accessLevel>
        <description>this would provide Read Access to all IN Public Group &quot;Group: IPS Read Only&quot;  that includes Dual, sales Ops, Data Ops etc</description>
        <label>IPS ProjectAccess R to IPS_ReadOnly_Users</label>
        <sharedTo>
            <group>Core_IPS_Read_Only</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Active</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private__c</field>
            <operation>notEqual</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_Public_Read_Project</fullName>
        <accessLevel>Read</accessLevel>
        <label>IPS Public Read Project</label>
        <sharedTo>
            <group>Core_IPS_Public_Read</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_IPS_Private__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
