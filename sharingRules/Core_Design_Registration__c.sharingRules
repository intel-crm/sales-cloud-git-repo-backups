<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_Design_Reviewer_APJ</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Design Reviewer - APJ</label>
        <sharedTo>
            <group>Core_DDR_Access_APJ</group>
        </sharedTo>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>Core_Partner_Account_Region_Cd__c</field>
            <operation>equals</operation>
            <value>APJ</value>
        </criteriaItems>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Design Registration - Locked,Design Registration - Intel,Design Registration - Partner,Design Registration - Partner Draft</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
