    <sharingCriteriaRules>
        <fullName>SWS_Account_6Sense_sharing</fullName>
        <accessLevel>Read</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Read</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <label>SWS Account 6Sense sharing</label>
        <sharedTo>
            <group>SWS_6Sense_Admin_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_Deactivated__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Account_Primary_Coverage__c</field>
            <operation>equals</operation>
            <value>Intel Covered</value>
        </criteriaItems>
        <criteriaItems>
            <field>Industry</field>
            <operation>notEqual</operation>
            <value>Government,Defense and Space</value>
        </criteriaItems>
        <criteriaItems>
            <field>Is_6Sense_Integration_Enabled__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Export_Compliance_Block__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>SWS_Marketo_Account_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <label>SWS Marketo Account Access</label>
        <sharedTo>
            <group>Marketo_Access_Group</group>
        </sharedTo>
        <booleanFilter>1 OR (2 AND 3)</booleanFilter>
        <criteriaItems>
            <field>Core_Intel_Partner_Alliance_PartnerGroup__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Account_Level__c</field>
            <operation>equals</operation>
            <value>Level 1,Level 2</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Account_Primary_Coverage__c</field>
            <operation>equals</operation>
            <value>Intel Covered</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
