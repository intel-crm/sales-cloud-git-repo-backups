<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Approval_Criteria_Sharing_for_Boost_Users</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing of Approval Criteria to Boost users</description>
        <label>Approval Criteria Sharing for Boost Users</label>
        <sharedTo>
            <group>CORE_MDF_CCP_CCFB_All</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_MDF_Sub_Type__c</field>
            <operation>contains</operation>
            <value>Boost</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
