<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_MDF_Approval_Criteria_Sharing_to_CCP_Claim_Case_Reviewer_Internal</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Approval Criteria Sharing to CCP Claim Case Reviewer Internal</description>
        <label>Approval Criteria Sharing to CCP Claim Case Reviewer Internal</label>
        <sharedTo>
            <group>Core_MDF_CCP_Claim_Case_Reviewer_Q_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>NULL</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_MDF_L2_CCP_Objects_Maintenance_Group_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This shares all the Approval Criteria records to L2 CCP Objects Maintenance group members</description>
        <label>L2 CCP Objects Maintenance Group Sharing</label>
        <sharedTo>
            <group>Core_MDF_CCP_Objects_Maintenance_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>NULL</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
