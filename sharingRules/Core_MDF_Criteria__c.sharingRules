    <sharingCriteriaRules>
        <fullName>Core_MDF_Approval_Criteria_Sharing_to_All_Users_CCP_Internal</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This shares all the Approval Criteria Records to All Users CCP Internal group members.</description>
        <label>Approval Criteria Sharing to All Users CCP Internal</label>
        <sharedTo>
            <group>Core_All_Users_CCP_Internal</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
