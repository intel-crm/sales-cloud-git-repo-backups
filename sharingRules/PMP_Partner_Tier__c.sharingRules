<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>PMP_External_Anonymous_Users_Partner_Tier</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Partner Tier records to all Anonymous Users</description>
        <label>PMP External - Anonymous Users - Partner Tier</label>
        <sharedTo>
            <group>PMP_All_Anonymous_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_External_Partner_Users_Partner_Tier</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Partner Tier records to all Partner Users</description>
        <label>PMP External - Partner Users - Partner Tier</label>
        <sharedTo>
            <group>PMP_All_Partner_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingGuestRules>
        <fullName>PMP_External_Guest_User_Partner_Tier</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Partner Tier records to Guest User</description>
        <label>PMP External - Guest User - Partner Tier</label>
        <sharedTo>
            <guestUser>Intel_Solutions_Marketplace</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
