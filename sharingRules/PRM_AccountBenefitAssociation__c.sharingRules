<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>ABA_rule_for_dataops</fullName>
        <accessLevel>Edit</accessLevel>
        <label>ABA rule for dataops</label>
        <sharedTo>
            <group>Core_Data_Ops_All</group>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>PRM_Status_Nm__c</field>
            <operation>equals</operation>
            <value>Active</value>
        </criteriaItems>
        <criteriaItems>
            <field>PRM_Status_Nm__c</field>
            <operation>equals</operation>
            <value>Inactive</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Data_Ops_User_Role_Account_Benefit_Association</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share Account Benefit Association records to all Data Ops Users</description>
        <label>Data Ops User Role - Account Benefit Association</label>
        <sharedTo>
            <role>Data_Ops_test01</role>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>IPA_Internal_Intel_Admin_Users_Account_Benefit_Association</fullName>
