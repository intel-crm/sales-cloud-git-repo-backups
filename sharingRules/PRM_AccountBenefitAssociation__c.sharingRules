            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_External_Anonymous_Users_Account_Benefit_Association</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Account Benefit Association records to all Anonymous Users</description>
        <label>PMP External - Anonymous Users - Account Benefit Association</label>
        <sharedTo>
            <group>PMP_All_Anonymous_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_External_Partner_Users_Account_Benefit_Association</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Account Benefit Association records to all Partner Users</description>
        <label>PMP External - Partner Users - Account Benefit Association</label>
        <sharedTo>
            <group>PMP_All_Partner_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_Internal_Intel_Admin_Users_Account_Benefit_Association</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share all Account Benefit Association records to all MP Internal Admin Users</description>
        <label>PMP Internal - Intel Admin Users - Account Benefit Association</label>
        <sharedTo>
            <group>PMP_All_Intel_Admin_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
