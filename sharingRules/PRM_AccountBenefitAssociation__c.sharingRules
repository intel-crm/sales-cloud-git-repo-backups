    <sharingGuestRules>
        <fullName>PMP_External_Guest_User_Account_Benefit_Association</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Account Benefit Association records to Guest User</description>
        <label>PMP External - Guest User - Account Benefit Association</label>
        <sharedTo>
            <guestUser>Intel_Solutions_Marketplace</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
