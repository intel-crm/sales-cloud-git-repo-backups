<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_IPS_All_SupportOrg_R_to_AllIPSUsers</fullName>
        <accessLevel>Read</accessLevel>
        <description>Provide Read Access to all Product Support Org to all IPS Users( TME/Admin)</description>
        <label>Core IPS All SupportOrg R to AllIPSUsers</label>
        <sharedTo>
            <roleAndSubordinatesInternal>IPS_Product_Org_Admin</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS Support Org</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_All_SupportOrg_R_to_AllSalesUser</fullName>
        <accessLevel>Read</accessLevel>
        <description>Provide Read Access to all Product Support Org to all Sales Users</description>
        <label>Core IPS All SupportOrg R to AllSalesUser</label>
        <sharedTo>
            <roleAndSubordinatesInternal>Admin</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS Support Org</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_All_SupportOrg_R_to_IPS_Agent</fullName>
        <accessLevel>Read</accessLevel>
        <description>This rule has been specially added to provide Read Access to IPS Agent to Support Org as IPS Agent Role is no longer a subordinate to IPS Product Org Admin Role</description>
        <label>Core IPS All SupportOrg R to IPS Agent</label>
        <sharedTo>
            <role>IPS_Agent</role>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS Support Org</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
