<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_DRD_User_Access</fullName>
        <accessLevel>Read</accessLevel>
        <description>Rule to share Users with DRD System.</description>
        <label>DRD User Access</label>
        <sharedTo>
            <group>Core_PG_DRD_Integrator</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_Employee_Type_Code__c</field>
            <operation>equals</operation>
            <value>CTW,EMP</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_User_All_AllContingent_Workers_Read</fullName>
        <accessLevel>Read</accessLevel>
        <description>This User Sharing Rule would provide READ Access to All Active Users to all CWs</description>
        <label>User All AllContingent Workers Read</label>
        <sharedTo>
            <group>Core_All_Contingent_Workers_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>IsActive</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_User_All_AllEmployee_Read</fullName>
        <accessLevel>Read</accessLevel>
        <description>This User Sharing Rule would provide READ Access to All Active Users to all Intel Employees</description>
        <label>User All AllEmployee Read</label>
        <sharedTo>
            <group>Core_All_Employees_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>IsActive</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_User_All_VSC_Read</fullName>
        <accessLevel>Read</accessLevel>
        <description>This User Sharing Rule would provide READ Access to All Active Users to all VSC&apos;s</description>
        <label>User All VSC Read</label>
        <sharedTo>
            <group>Core_All_VSC_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>IsActive</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>IPS_Agent_Partner_User_Read_Access</fullName>
        <accessLevel>Read</accessLevel>
        <description>Rule to provide Intel  users Access to IPS Agent Partner Users</description>
        <label>IPS Agent Partner User Read Access</label>
        <sharedTo>
            <group>Core_PG_IPS_Partner_AE</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_Employee_Type_Code__c</field>
            <operation>equals</operation>
            <value>CTW,EMP</value>
        </criteriaItems>
        <criteriaItems>
            <field>IsActive</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
