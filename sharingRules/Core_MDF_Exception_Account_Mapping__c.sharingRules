    <sharingCriteriaRules>
        <fullName>Core_MDF_Exception_Acc_Map_Claim_Case_Group</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing rule to share exception account mapping to claim case reviewer group</description>
        <label>Exception Acc Map - Claim Case Group</label>
        <sharedTo>
            <group>Core_MDF_CCP_Claim_Case_Reviewer_Q_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_MDF_Program_nm__c</field>
            <operation>equals</operation>
            <value>Client,Datacenter,Retail Marketing Funds,Intel Partner Alliance,Ecosystem Extension Fund,Client Co-Marketing Fund Boost,Service Provider Co-Marketing Fund,Co-GTM</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
