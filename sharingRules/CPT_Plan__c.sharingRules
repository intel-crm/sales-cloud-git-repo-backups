<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>CPT_Sales_Compensation_Plan_Admin</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share all records with Read/Write access.</description>
        <label>CPT Sales Compensation Plan - Admin</label>
        <sharedTo>
            <group>CPT_PG_Commission_Admin</group>
        </sharedTo>
        <criteriaItems>
            <field>CreatedById</field>
            <operation>notEqual</operation>
            <value>NULL</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
