    <sharingCriteriaRules>
        <fullName>AGS_CCP_All_Programs</fullName>
        <accessLevel>Edit</accessLevel>
        <label>AGS_CCP All Programs</label>
        <sharedTo>
            <group>AGS_CCP_Payment_Admin_Manager</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_MDF_Payment_Run_Id__c</field>
            <operation>notEqual</operation>
