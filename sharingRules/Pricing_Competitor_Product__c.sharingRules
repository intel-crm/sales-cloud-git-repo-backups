<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>All_Internal_Read</fullName>
        <accessLevel>Read</accessLevel>
        <label>All Internal Read</label>
        <sharedTo>
            <group>Pricing_All_Internal_Tender_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PCC_Deal_Competitor_Product_External</fullName>
        <accessLevel>Read</accessLevel>
        <label>Deal Competitor Product External</label>
        <sharedTo>
            <group>PCC_Deal_Reg_Partner_Group</group>
        </sharedTo>
        <booleanFilter>1 OR ( 2 AND 3 )</booleanFilter>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Client</value>
        </criteriaItems>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <field>Name</field>
            <operation>equals</operation>
            <value>Write In Product</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
