<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>IPA_Internal_Intel_Admin_Users_Partner_Benefit</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share all Partner Benefit records to all IPA Internal Admin Users</description>
        <label>IPA Internal - Intel Admin Users - Partner Benefit</label>
        <sharedTo>
            <group>IPA_All_Intel_Admin_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_External_Anonymous_Users_Partner_Benefit</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Partner Benefit records to all Anonymous Users</description>
        <label>PMP External - Anonymous Users - Partner Benefit</label>
        <sharedTo>
            <group>PMP_All_Anonymous_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_External_Partner_Users_Partner_Benefit</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Partner Benefit  records to all Partner Users</description>
        <label>PMP External - Partner Users - Partner Benefit</label>
        <sharedTo>
            <group>PMP_All_Partner_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_Internal_Intel_Admin_Users_Partner_Benefit</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share all Partner Benefit records to all MP Internal Admin Users</description>
        <label>PMP Internal - Intel Admin Users - Partner Benefit</label>
        <sharedTo>
            <group>PMP_All_Intel_Admin_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingGuestRules>
        <fullName>PMP_External_Guest_User_Partner_Benefit</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Partner Benefit records to Guest User</description>
        <label>PMP External - Guest User - Partner Benefit</label>
        <sharedTo>
            <guestUser>Intel_Solutions_Marketplace</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
