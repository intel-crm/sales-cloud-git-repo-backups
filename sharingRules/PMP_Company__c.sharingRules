<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Access_to_Company_Profile_For_IPA_Admins</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Access to Company Profile For IPA Admins</label>
        <sharedTo>
            <group>IPA_All_Intel_Admin_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>PMP_Marketing_Profile_Id__c</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Access_to_assign_topic</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Access to assign topic</label>
        <sharedTo>
            <group>Topic_Assignment_Access</group>
        </sharedTo>
        <criteriaItems>
            <field>PMP_Marketing_Profile_Id__c</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>L2_IPA_Support_Users_Company_Information_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share all Marketing Profile Information (aka Company Information) records to all members of  L2 IPA Support public group</description>
        <label>L2 IPA Support Users - Company Information Sharing</label>
        <sharedTo>
            <group>Core_L2_IPA_Support</group>
        </sharedTo>
        <criteriaItems>
            <field>PMP_Marketing_Profile_Id__c</field>
            <operation>notEqual</operation>
            <value>null</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>PMP_External_Anonymous_Users_Company_Information</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share all Published and Active Marketing Profile Information (aka Company Information) records to all Anonymous Users</description>
        <label>PMP External - Anonymous Users - Company Information</label>
        <sharedTo>
            <group>PMP_All_Anonymous_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>PMP_Company_Lifecycle_Status_Nm__c</field>
            <operation>equals</operation>
            <value>Published</value>
        </criteriaItems>
        <criteriaItems>
            <field>PMP_Partner_Inactive_Ind__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
