<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_AAQC_Ask_Commisions_RW_Access_to_Admins</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Using this role based on Record type condition to share case Record to Admin users as R/W permission</description>
        <label>Ask Commisions RW Access to Admins</label>
        <sharedTo>
            <group>Core_AAQC_Admin_Group_for_All_Admins</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Ask Commissions Case</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_AAQC_Ask_Commisions_RW_Access_to_Non_Admins</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Using this role based on Record type condition to share case Record to Non Admin users as R/W permission</description>
        <label>Ask Commisions RW Access to Non Admins</label>
        <sharedTo>
            <group>Core_AAQC_Ask_Commissions_Elevated_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Ask Commissions Case</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_ALLCases_R_to_GEC</fullName>
        <accessLevel>Read</accessLevel>
        <description>Read access to all cases for GEC folks</description>
        <label>IPS ALLCases R to GEC</label>
        <sharedTo>
            <group>Core_All_Global_Export_Compliance</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS GEC ReadOnly,IPS Case Create,IPS Closed Case</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private_Project__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_AllCases_R_Only_to_Sales</fullName>
        <accessLevel>Read</accessLevel>
        <description>This will provide anyone in the Public Group to have All IPS Case Read Access</description>
        <label>Core IPS AllCases R Only to Sales</label>
        <sharedTo>
            <group>Core_IPS_Read_Only</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS No Assigned Contact Case,IPS Case Create,IPS GEC ReadOnly,IPS Closed Case</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private_Project__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_Case_RW_to_AllDataOps</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This one generic Rule gives R/W ACCESS to all IPS Cases to all Data Ops</description>
        <label>Core IPS Case RW to AllDataOps</label>
        <sharedTo>
            <group>Core_PG_Data_Ops</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS Case Create,IPS Closed Case</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private_Project__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_Case_RW_to_AllIPSAgents</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This rule has been specially added to provide R/W Access to IPS Agent to Case as IPS Agent Role is no longer a subordinate to IPS Product Org Admin Role</description>
        <label>Core IPS Case RW to AllIPSAgents</label>
        <sharedTo>
            <role>IPS_Agent</role>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS No Assigned Contact Case,IPS Case Create,IPS GEC ReadOnly,IPS Closed Case</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private_Project__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_Case_RW_to_AllIPSUsers</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This one generic Rule gives R/W ACCESS to all IPS Cases to all internal IPS users</description>
        <label>Core IPS Case RW to AllIPSUsers</label>
        <sharedTo>
            <roleAndSubordinatesInternal>IPS_Product_Org_Admin</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS No Assigned Contact Case,IPS Case Create,IPS GEC ReadOnly,IPS Closed Case</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private_Project__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_Case_RW_to_Sales_Rep_Dual</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This provides the few specific people in the Public Group &quot;Core_IPS_Case_RW_to_Sales_Rep_Dual&quot; R/W access to all cases in the system</description>
        <label>Core IPS Case RW to Sales Rep Dual</label>
        <sharedTo>
            <group>Core_PG_Sales_Rep_BB_Dual_IPS</group>
        </sharedTo>
        <criteriaItems>
