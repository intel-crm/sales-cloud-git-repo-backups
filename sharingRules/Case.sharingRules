    <sharingCriteriaRules>
        <fullName>Core_IPS_GEC_Approved_Case_RW_to_GEC</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This would provide only the GEC folks to have R/W access to the following scenario
a.	Rec Type GEC status = “Approved” and Case Status &lt;&gt; “Closed”.</description>
        <label>IPS GEC Approved Case RW to GEC</label>
        <sharedTo>
            <group>Core_All_Global_Export_Compliance</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IPS Case Create</value>
        </criteriaItems>
        <criteriaItems>
            <field>IsClosed</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Private_Project__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_IPS_Public_Read_Case</fullName>
        <accessLevel>Read</accessLevel>
