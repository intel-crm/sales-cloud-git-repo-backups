<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>ER_Source_as_DZP</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Source as DZP</label>
        <sharedTo>
            <group>ER_DZP_Admin</group>
        </sharedTo>
        <criteriaItems>
            <field>PRM_Source__c</field>
            <operation>equals</operation>
            <value>DZP</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>ER_Source_as_IQR</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Source as IQR</label>
        <sharedTo>
            <group>ER_IQR_Admin</group>
        </sharedTo>
        <criteriaItems>
            <field>PRM_Source__c</field>
            <operation>equals</operation>
            <value>IQR</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>ER_Source_as_PSG</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Source as PSG</label>
        <sharedTo>
            <group>ER_PSG_Admin</group>
        </sharedTo>
        <criteriaItems>
            <field>PRM_Source__c</field>
            <operation>equals</operation>
            <value>PSG</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Entitlement_Based_Reg</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Entitlement Based Reg</label>
        <sharedTo>
            <role>EBR_Admin</role>
        </sharedTo>
        <criteriaItems>
            <field>Is_Entitlement_Record__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>notEqual</operation>
            <value>Add Membership Request,Admin Registration,Bulk Contact Upload,Registration Request Page,Add Contact Request,PSG Registration</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
