<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Core_All_Question_All_WW_RW</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This Question Sharing Rule would provide READ/WRITE Access to All WW folks related to any Questions</description>
        <label>All Question All Training RW</label>
        <sharedTo>
            <group>Core_Question_WW</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_I_Need_Assistance_With__c</field>
            <operation>equals</operation>
            <value>Data/ Visibility,Permission,Training,Bug/Issue,Reporting,System Access,Enhancement,Other</value>
        </criteriaItems>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>notEqual</operation>
            <value>Ask A Question Intel Premier Support</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
