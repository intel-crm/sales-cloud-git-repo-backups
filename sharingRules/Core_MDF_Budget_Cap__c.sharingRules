    <sharingCriteriaRules>
        <fullName>Budget_Cap_CCP_CCFB_ALL_RO</fullName>
        <accessLevel>Read</accessLevel>
        <description>CCFB Budget CAP sharing to Read Only Group</description>
        <label>Budget Cap CCP CCFB ALL RO</label>
        <sharedTo>
            <group>Core_MDF_CCFB_Internal_All_Geo_Read_Only</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_MDF_Program_txt__c</field>
            <operation>contains</operation>
            <value>0Pkg00000008PW9</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
