    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>CORE_MDF_ACCOUNT_BANK_MAPPING_CCP_CLAIM_CASE_REVIEWER</fullName>
        <accessLevel>Read</accessLevel>
        <description>ACCOUNT BANK MAPPING - CCP CLAIM CASE REVIEWER</description>
        <label>ACCOUNT BANK MAPPING - CCP CLAIM CASE REVIEWER</label>
        <sharedTo>
            <group>Core_MDF_CCP_Claim_Case_Reviewer_Q_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>[empty]</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_MDF_Program__c</field>
            <operation>equals</operation>
            <value>Client CoMarketing Fund,Client CoMarketing Fund Boost,Data Center CoMarketing Fund,Service Provider CoMarketing Fund,Retail Marketing Funds</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
