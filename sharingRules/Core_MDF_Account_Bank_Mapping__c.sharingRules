<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>CORE_MDF_ACCOUNT_BANK_MAPPING_ALL_INTERNAL</fullName>
        <accessLevel>Read</accessLevel>
        <label>ACCOUNT BANK MAPPING ALL INTERNAL</label>
        <sharedTo>
            <group>Core_All_Users_CCP_Internal</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value>[empty]</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>CORE_MDF_ACCOUNT_BANK_MAPPING_CCF</fullName>
        <accessLevel>Read</accessLevel>
        <label>ACCOUNT BANK MAPPING CCF</label>
        <sharedTo>
            <group>CORE_MDF_CCP_CCF_ALL</group>
        </sharedTo>
        <criteriaItems>
            <field>Core_MDF_Program__c</field>
            <operation>equals</operation>
            <value>Client CoMarketing Fund</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>CORE_MDF_ACCOUNT_BANK_MAPPING_CCFB</fullName>
