<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>CCP_SPCF_All</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share to all SPCF All users which includes Payment Admins</description>
        <label>CCP SPCF All</label>
        <sharedTo>
            <group>Core_MDF_CCP_SPCF_All</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Service Provider Co-Marketing Fund</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Core_MDF_All_Users_CCP_Internal</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share to all internal user</description>
        <label>All Users - CCP Internal</label>
        <sharedTo>
            <group>Core_All_Users_CCP_Internal</group>
        </sharedTo>
        <criteriaItems>
            <field>Title</field>
            <operation>notEqual</operation>
            <value>[empty]</value>
        </criteriaItems>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Client Co-Marketing Fund,Service Provider Co-Marketing Fund,Data Center Co-Marketing Fund,Client Co-Marketing Fund Boost</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
