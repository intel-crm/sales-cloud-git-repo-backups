    <sharingCriteriaRules>
        <fullName>PSG_Transfer_Pricing_Quote_Sharing_with_SOS</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share Transfer Pricing Quote with APJ and PRC SOS user as Read/Write access</description>
        <label>PSG Transfer Pricing Quote Sharing with SOS</label>
        <sharedTo>
            <group>ags_sos_transfer_pricing</group>
        </sharedTo>
        <booleanFilter>1 AND 2 AND (3 OR 4)</booleanFilter>
        <criteriaItems>
            <field>Pricing_Quote_Program_Nm__c</field>
            <operation>equals</operation>
            <value>PSG</value>
        </criteriaItems>
        <criteriaItems>
            <field>core_cpq_quote_type_nm__c</field>
            <operation>equals</operation>
            <value>Transfer Pricing</value>
