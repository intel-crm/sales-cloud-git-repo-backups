    <sharingCriteriaRules>
        <fullName>Pricing_Share_Quotes_To_CDB_Intg_User</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This rule is to share the Quotes to CDB Integration User</description>
        <label>Pricing_Share_Quotes_To_CDB_Intg_User</label>
        <sharedTo>
            <group>Core_AI_CDB_Integrations_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>Pricing_Quote_Program_Nm__c</field>
            <operation>equals</operation>
            <value>Tender</value>
        </criteriaItems>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Pricing Tender Quote - ReadOnly,Pricing Tender Client Quote - Submitted,Pricing Tender Quote - Submitted,Pricing Tender Quote - Edit,Pricing Tender Client Quote - Edit,Pricing Tender Client Quote - ReadOnly</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Status__c</field>
            <operation>equals</operation>
            <value>Submitted,Won,Draft,Approved,Lost</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
