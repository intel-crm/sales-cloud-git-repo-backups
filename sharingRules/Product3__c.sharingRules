<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>Sharing_Prod_for_guest_user</fullName>
        <accessLevel>Read</accessLevel>
        <label>Sharing Prod for guest user</label>
        <sharedTo>
            <guestUser>Intel_FPGA_SSLC</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>CreatedById</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
