<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>

    <targets>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__Tab</target>
    </targets>

    <targetConfigs>

        <!-- Internal Salesforce -->
        <targetConfig targets="lightning__RecordPage">

            <property name="childObjectApi" type="String" label="Child Object API Name"/>
            <property name="relationshipField" type="String" label="Relationship Field API Name"/>
            <property name="fields" type="String" label="Fields (comma separated)"/>
            <property name="title" type="String" label="Card Title"/>
        </targetConfig>

        <!-- Experience Cloud -->
        <targetConfig targets="lightningCommunity__Default">
                        <property name="recordId" type="String" default="{!recordId}"/>
            <property name="childObjectApi" type="String" label="Child Object API Name"/>
            <property name="relationshipField" type="String" label="Relationship Field API Name"/>
            <property name="fields" type="String" label="Fields (comma separated)"/>
            <property name="title" type="String" label="Card Title"/>
        </targetConfig>

    </targetConfigs>
</LightningComponentBundle>