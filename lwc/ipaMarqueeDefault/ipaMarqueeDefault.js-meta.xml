            <property name="title" type="String" default="Lorem Ipsum Title" label="Title"/>
            <property name="alignment" type="String" default="left" label="Marquee Alignment" datasource="left,center"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>