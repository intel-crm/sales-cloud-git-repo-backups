<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Core MDF Program Rename Selector</masterLabel>
    <description
  >Previews workbook-scoped metadata replacements, exports occurrence paths, selects components, and displays update results.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property
        name="items"
        type="apex://Core_MDF_Program_Rename_Item[]"
        label="Metadata Components"
        role="inputOnly"
      />
            <property
        name="occurrences"
        type="apex://Core_MDF_Program_Rename_Occurrence[]"
        label="Metadata Path Occurrences"
        role="inputOnly"
      />
            <property
        name="selectedItems"
        type="apex://Core_MDF_Program_Rename_Item[]"
        label="Selected Metadata Components"
      />
            <property
        name="readOnly"
        type="Boolean"
        label="Read-only Results Mode"
        default="false"
        role="inputOnly"
      />
            <property
        name="errorMessage"
        type="String"
        label="Error Message"
        role="inputOnly"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>