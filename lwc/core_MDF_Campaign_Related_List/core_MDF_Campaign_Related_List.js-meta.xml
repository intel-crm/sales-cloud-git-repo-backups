            <property name="sharingFlag" label="Sharing Flag" type="String" default="true"/>   
            <property name="restrictFieldVisiblityFieldAPIName" label="Restrict Field Visiblity" type="String"  /> 
            <property name="restrictFieldVisiblityCriteriaFieldAPIName " label="Restrict Field Visiblity Criteria " type="String" /> 
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>