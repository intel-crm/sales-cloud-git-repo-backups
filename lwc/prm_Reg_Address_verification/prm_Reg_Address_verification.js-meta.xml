<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>

    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>

        <targetConfig targets="lightning__FlowScreen">

            <property name="organizationName"
                type="String"
                role="inputOnly"/>

            <property name="streetName"
                type="String"
                role="inputOnly"/>

            <property name="cityName"
                type="String"
                role="inputOnly"/>

            <property name="stateCode"
                type="String"
                role="inputOnly"/>

            <property name="countryCode"
                type="String"
                role="inputOnly"/>

            <property name="postalCode"
                type="String"
                role="inputOnly"/>

            <property name="verifiedStreet"
                type="String"
                role="outputOnly"/>

            <property name="verifiedCity"
                type="String"
                role="outputOnly"/>

            <property name="verifiedStateCode"
                type="String"
                role="outputOnly"/>

            <property name="verifiedCountryCode"
                type="String"
                role="outputOnly"/>

            <property name="verifiedPostalCode"
                type="String"
                role="outputOnly"/>

            <property name="isAddressVerified"
                type="Boolean"
                role="outputOnly"/>

        </targetConfig>

    </targetConfigs>
</LightningComponentBundle>