<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Flow Navigation Buttons</masterLabel>
    <description>Custom Back and Next navigation buttons for a Flow screen.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="backLabel" type="String" label="Back Button Label" />
            <property name="nextLabel" type="String" label="Next Button Label" />
            <property name="showBack" type="Boolean" label="Show Back Button" />
            <property name="showNext" type="Boolean" label="Show Next Button" />
            <property name="disableNext" type="Boolean" label="Disable Next Button" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>