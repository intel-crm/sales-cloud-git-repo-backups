  },\n};\n\n// This function is called after the coreIntcCommunity script has been loaded\nfunction callCommunityCore() {\n  // This top block of code is only relevant if you are using analytics\n  const urlStr = window.location.href;\n  // Change the match parameter to your production URL\n    \n  if (urlStr.match(/marketplace.intel.com/) != null) {\n   communityCoreConfig.analytics.digitalData.environment = 'prod';\n  }\n\n  // Call the init method to render the IGHF\n  window.CoreIntcCommunity.init(communityCoreConfig);\n}\n\n// This function is called after the loadCommunityCore event has been caught by the processEvent method\nfunction insertCoreScript() {\n  const scr = document.createElement('script');\n  scr.type = 'text/javascript';\n  scr.onload = callCommunityCore;\n  scr.src = `${$A.get('$Resource.Core_INTC')}/general/coreIntcCommunityMin.js`;\n  document.body.appendChild(scr);\n \n}\n\n// Handle window messages, including the 'intel.loadCommunityCore' message fired by the IntelCoreCommunity component (see HTML example below)\nfunction processEvent(evt) {\n  const port = (window.location.port ? `:${window.location.port}` : '');\n  const fullLocation = `${window.location.protocol}//${window.location.hostname}${port}`;\n  if (evt.origin === fullLocation && evt.data && evt.data.type === 'intel.loadCommunityCore' && !CoreCommunityLoaded) {\n    CoreCommunityLoaded = true;\n    insertCoreScript();\n  }\n}\n\n// Set up an event listener for when the page has loaded. This is done to manage async behavior and control the availability\n// of the Salesforce API.\nwindow.addEventListener('message', processEvent, false);\n    \n    \n</script>\n<script> \n//function displayChatBot() {\n//alert('+++++');\n//document.getElementsByClassName(\"helpButtonLabel\")[0].click();\n//}    \n//setTimeout(displayChatBot, 12000);\n /*\nfunction checkAndToggleChannelMenu() {\ndocument.getElementsByClassName(\"helpButtonLabel\")[0].click();\nconsole.log('alert');\nesw = document.ge