\nAnalyticsHits.push(evt);\n}\nif (TimeoutCounter < 30) {\nif (RootAnalyticsLoaded) {\nTimeoutCounter++;\nTimeoutId = setTimeout(function(){\ntestForAnalytics();\n}, 1000);\n}\n} else {\nMaxTimeouts = true;\n}\n}\nif (evt && evt.data && evt.data.analyticsType === 'pageview') {\nsetAddressTrackingCookie();\n}\n}\nfunction processEvent(evt) {\nconst port = (window.location.port ? `:${window.location.port}` : '');\nconst fullLocation = `${window.location.protocol}//${window.location.hostname}${port}`;\nif (evt.origin === fullLocation && evt.data && evt.data.type === 'intel.loadCommunityCore' && !CoreCommunityLoaded) {\nCoreCommunityLoaded = true;\ninsertCoreScript();\n}\n}// Set up an event listener for when the page has loaded. This is done to manage async behavior and control the availability\n// of the Salesforce API.\nwindow.focus = function(dataName) {\nif (dataName) {\nvar windowData;\nswitch (dataName) {\ncase 'cookie':\nwindowData = document.cookie;\nbreak;\ncase 'errorGet':\nwindowData = MarketplaceErrorEncountered;\nbreak;\ncase 'errorSet':\nMarketplaceErrorEncountered = true;\nbreak;\ncase 'meta':\nwindowData = {\npageType: getMeta('pageType') || '',\ntitle: getMeta('title') || ''\n};\nbreak;\ncase 'utag':\nwindowData = window.utag;\nbreak;\n}\nreturn windowData;\n} else {\nWindowFocus();\n}\n};\nwindow.addEventListener('message', processEvent, false);\nwindow.addEventListener(\"message\", function(evt) {\nvar fullLocation = window.location.protocol + '//' + window.location.hostname + (window.location.port ? ':' + window.location.port : '');\nif (evt.origin === fullLocation && evt.data) {\nswitch (evt.data.type) {\ncase 'intel.analyticsLoaded':\nRootAnalyticsLoaded = true;\ntestForAnalytics();\nbreak;\ncase 'intel.loadCommunityCore':\nif (!CoreCommunityLoaded) {\nCoreCommunityLoaded = true;\ninsertCoreScript();\n}\nbreak;\ncase 'intel.renderBreadcrumbs':\nif (CommunityCoreConfig.ighf.breadcrumbs.available) {\nwindow.CoreIntcCommunity.renderIghfBreadcrumbs(evt.data.data);\n} else {\nCommunityCoreConfig.ighf.breadcrumbs.waitingData = evt.data.data;\n}\nbreak;\ncase 'intel.salesForceHit':\nif (!MaxTimeouts) {\ntestForAnalytics(evt);\n}\nbreak;\n}\n}\n}, false);\nsetAddressTrackingCookie();</script>",
