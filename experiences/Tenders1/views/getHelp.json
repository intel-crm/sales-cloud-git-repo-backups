          "componentAttributes" : {
            "richTextValue" : "<h1><b style=\"background-color: inherit; color: rgb(68, 68, 68);\">Need Help?</b><b style=\"color: rgb(68, 68, 68);\">&nbsp;</b></h1><p><img src=\"data:image/png;base64,\" alt=\"Shape\">&nbsp;</p><p><span style=\"background-color: inherit;\">Answers to many of your questions may be found in the FAQ below. If your question isn’t answered, please feel free to contact your Intel representative or to contact the&nbsp;Intel Quote Request Support&nbsp;team </span>using the Contact Intel link below<span style=\"background-color: inherit;\">.</span>&nbsp;</p>"
