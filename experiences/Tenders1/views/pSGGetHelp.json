        "richTextValue" : "<h1><b style=\"color: rgb(68, 68, 68); background-color: inherit;\">Need Help?</b><b style=\"color: rgb(68, 68, 68);\">&nbsp;</b></h1><p><img src=\"data:image/png;base64,\" alt=\"Shape\">&nbsp;&nbsp;</p><p><span style=\"color: rgb(64, 64, 64);\"> Answers to many of your questions may be found in the Training tab above</span></p><p><br></p><ul><li><span style=\"color: rgb(64, 64, 64);\">For business related questions, please contact your local Intel representative:</span></li><li class=\"ql-indent-1\"><span style=\"color: rgb(64, 64, 64);\">APJ:&nbsp;</span><a href=\"mailto:apssd@intel.com\" rel=\"noopener noreferrer\" target=\"null\" style=\"color: rgb(64, 64, 64);\">apssd@intel.com</a></li><li class=\"ql-indent-1\">Japan: <a href=\"mailto:japanssd@intel.com\" rel=\"noopener noreferrer\" target=\"null\" style=\"color: rgb(64, 64, 64);\">japanssd@intel.com</a></li><li class=\"ql-indent-1\"><span style=\"color: rgb(64, 64, 64);\">ASMO:&nbsp;</span><a href=\"mailto:cmquotes@intel.com\" rel=\"noopener noreferrer\" target=\"null\" style=\"color: rgb(64, 64, 64);\">cmquotes@intel.com</a></li><li class=\"ql-indent-1\"><span style=\"color: rgb(64, 64, 64);\">EMEA:&nbsp;</span><a href=\"mailto:eurossd@intel.com\" rel=\"noopener noreferrer\" target=\"null\" style=\"color: rgb(64, 64, 64);\">eurossd@intel.com</a></li><li class=\"ql-indent-1\"><span style=\"color: rgb(64, 64, 64);\">PRC:&nbsp;</span><a href=\"mailto:apssd@intel.com\" rel=\"noopener noreferrer\" target=\"null\" style=\"color: rgb(64, 64, 64);\">apssd@intel.com</a></li></ul><p><br></p><ul><li><span style=\"color: rgb(64, 64, 64);\">For IT related support, please contact the Intel Quote Request support team by clicking below link:</span></li></ul><p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href=\"https://intelinside.intel.com/support?appgroup=IQR\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"color: rgb(102, 163, 224);\">https://intelinsid