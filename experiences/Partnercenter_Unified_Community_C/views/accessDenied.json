        "richTextValue" : "<p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><b style=\"color: rgb(102, 163, 224); font-size: 48px;\">ACCESS DENIED</b></p><p><br></p><p><b style=\"font-size: 18px;\">Reason</b><span style=\"font-size: 18px;\">: </span>Your account does not have appropriate access rights to https://partnercenter.intel.com</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><span style=\"font-size: 36px; color: rgb(102, 163, 224);\">Suggestions</span></p><p style=\"text-align: center;\"><br></p><p><b style=\"font-size: 18px;\">External Users:</b></p><ul><li>Please contact your Account Manager or Sales Rep to get access</li></ul><p><br></p><p><br></p><p><b style=\"font-size: 18px;\">Internal Users:</b></p><ul><li>Please use <a href=\"http://goto/partnercenter\" target=\"_self\">goto/partnercenter</a></li></ul><p>&nbsp;</p>"
