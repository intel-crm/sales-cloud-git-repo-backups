      }, {
        "id" : "757c2e56-cb6a-4346-885e-7e40be40fbbf",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><b style=\"color: rgb(102, 163, 224); font-size: 48px;\">ДОСТУП ЗАПРЕЩЕН</b></p><p><br></p><p><b style=\"font-size: 18px;\">Причина</b><span style=\"font-size: 18px;\">: </span>Ваша учетная запись не имеет прав доступа к https://partnercenter.intel.com</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><span style=\"font-size: 36px; color: rgb(102, 163, 224);\">Предложения</span></p><p style=\"text-align: center;\"><br></p><p><b style=\"font-size: 18px;\">Внешние пользователи:</b></p><ul><li>Пожалуйста, обратитесь к своему менеджеру или торговому представителю, чтобы получить доступ</li></ul><p><br></p><p><br></p><p><b style=\"font-size: 18px;\">Сотрудники:</b></p><ul><li>Пожалуйста, используйте <a href=\"http://goto/partnercenter\" target=\"_self\">перейти/партнерский центр</a></li></ul><p>&nbsp;</p>"
          }
        },
        "type" : "renditionComponent"
      }, {
        "id" : "89de95ef-a9ae-4153-8c66-d679f756e587",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><b style=\"color: rgb(102, 163, 224); font-size: 48px;\">ACESSO NEGADO</b></p><p><br></p><p><b style=\"font-size: 18px;\">Raz&atilde;o</b><span style=\"font-size: 18px;\">: sua conta n&atilde;o tem direitos de acesso apropriados para usar INTEL DATA CENTER BLOCKS</span></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><span style=\"font-size: 36px; color: rgb(102, 163, 224);\">Sugest&otilde;es</span></p><p style=\"text-align: center;\"><br></p><p><b style=\"font-size: 18px;\">Usu&aacute;rios internos:</b></p><ul><li><span style=\"font-size: 18px;\">V&aacute; para </span><a href=\"http://ags.intel.com\" target=\"null\" style=\"font-size: 18px;\">http://ags.intel.com</a><span style=\"font-size: 18px;\">e solicite acesso</span></li><li><span style=\"font-size: 18px;\">Pesquise fun&ccedil;&otilde;es de CTO e solicite acesso para a fun&ccedil;&atilde;o apropriado</span></li></ul><p><br></p><p><br></p><p><b style=\"font-size: 18px;\">Usu&aacute;rios externos:</b></p><ul><li><span style=\"font-size: 18px;\">Contate seu gerente de conta ou representante de vendas</span></li></ul><p><br></p><p><br></p><p>&nbsp;</p>"
          }
        },
        "type" : "renditionComponent"
      }, {
        "id" : "1ac3ecc7-bc5a-4aca-9a30-fce30ddc0626",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><b style=\"color: rgb(102, 163, 224); font-size: 48px;\">アクセスが拒否されました</b></p><p><br></p><p><b style=\"font-size: 18px;\">理由</b><span style=\"font-size: 18px;\">: </span>このアカウントには https://partnercenter.intel.com のアクセスに必要な権限がありません。</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><span style=\"font-size: 36px; color: rgb(102, 163, 224);\">提案</span></p><p style=\"text-align: center;\"><br></p><p><b style=\"font-size: 18px;\">外部ユーザー:</b></p><ul><li>アクセスするには、アカウント・マネージャーまたは販売担当者までお問い合わせください。</li></ul><p><br></p><p><br></p><p><b style=\"font-size: 18px;\">内部ユーザー:</b></p><ul><li><a href=\"http://goto/partnercenter\" target=\"_self\">goto/partnercenter</a> をご活用ください</li></ul><p>&nbsp;</p>"
          }
