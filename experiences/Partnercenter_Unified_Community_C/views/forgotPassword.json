        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<div style=\"text-align: center;\">Insira o endere&ccedil;o de e-mail que voc&ecirc; usou ao criar a conta. Um e-mail ser&aacute; enviado para esse endere&ccedil;o com mais instru&ccedil;&otilde;es sobre como redefinir sua senha.</div>"
