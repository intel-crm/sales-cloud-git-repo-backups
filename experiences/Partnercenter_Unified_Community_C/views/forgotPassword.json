        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<div style=\"text-align: center;\">請輸入您建立帳戶時所使用的電子郵件位址。我們會寄一封電子郵件到該位址，郵件會包含如何重設密碼的指示。</div>"
