<?xml version="1.0" encoding="UTF-8"?>
<CustomApplication xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOverrides>
        <actionName>Tab</actionName>
        <content>TheLimitsApp__Homepage_Limits_App</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
        <pageOrSobjectType>standard-home</pageOrSobjectType>
    </actionOverrides>
    <brand>
        <headerColor>#0070D2</headerColor>
        <shouldOverrideOrgTheme>true</shouldOverrideOrgTheme>
    </brand>
    <description>This app helps Salesforce customers monitor their Salesforce org limits without having to make manual API calls. Limits are stored in a custom object called Limit. Prebuilt reports and dashboards provide visuals.</description>
    <formFactors>Small</formFactors>
    <formFactors>Large</formFactors>
    <isNavAutoTempTabsDisabled>false</isNavAutoTempTabsDisabled>
    <isNavPersonalizationDisabled>false</isNavPersonalizationDisabled>
    <isNavTabPersistenceDisabled>false</isNavTabPersistenceDisabled>
    <isOmniPinnedViewEnabled>false</isOmniPinnedViewEnabled>
    <label>The Limits App</label>
    <navType>Standard</navType>
    <tabs>standard-home</tabs>
    <tabs>TheLimitsApp__Limit_LimitsApp__c</tabs>
    <tabs>standard-report</tabs>
    <tabs>standard-Dashboard</tabs>
    <tabs>TheLimitsApp__Email_LimitsApp</tabs>
    <tabs>TheLimitsApp__Standard_APIs_LimitsApp</tabs>
    <tabs>TheLimitsApp__Streaming_API_LimitsApp</tabs>
    <tabs>TheLimitsApp__PE_and_CDC_LimitsApp</tabs>
    <tabs>TheLimitsApp__SF_Connect_and_Private_Connect_LimitsApp</tabs>
    <tabs>TheLimitsApp__Data_and_File_Storage_LimitsApp</tabs>
    <tabs>TheLimitsApp__Developer_Experience_LimitsApp</tabs>
    <tabs>TheLimitsApp__Analytics_LimitsApp</tabs>
    <tabs>TheLimitsApp__Functions_and_Workflows_LimitsApp</tabs>
    <uiType>Lightning</uiType>
</CustomApplication>
