<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_Claim_Case_Reviewer_Mgr_Grp</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_Claim_Case_Reviewer_Q_Group</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_IPA_ALL</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_IPA_EXTERNAL_ALL</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_IPA_INTERNAL_ALL</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Core_MDF_PIC_Pending</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Reset_Approval_Stage</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Step_Counter_to_0</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Update_Claim_Approval_Date</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Update_Eligible_for_PIC_to_true</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Core_MDF_Account_Manager_Queue</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Account Manager</label>
        <name>Account_Manager</name>
        <rejectionActions>
            <action>
                <name>Core_MDF_Empty_Claim_Approval_Date</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Reset_Approval_Stage</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Step_Counter_to_0</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Approval process for outcome based claims.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>(1 OR 2) AND 3</booleanFilter>
        <criteriaItems>
            <field>PartnerFundClaim.RecordType</field>
            <operation>equals</operation>
            <value>Intel Partner Alliance Proposal Based</value>
        </criteriaItems>
        <criteriaItems>
            <field>PartnerFundClaim.RecordType</field>
            <operation>equals</operation>
            <value>Intel Partner Alliance Account Based</value>
        </criteriaItems>
        <criteriaItems>
            <field>PartnerFundClaim.Core_MDF_Status__c</field>
            <operation>equals</operation>
            <value>Pending Review</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Core_MDF_Outcome_Based_Claim_AP</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
