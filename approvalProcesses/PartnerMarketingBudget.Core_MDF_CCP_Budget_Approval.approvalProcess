<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_All_Users_CCP_Internal</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_Internal_Retail_All</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Core_MDF_Budget_Partner__c</field>
        <field>StartDate</field>
        <field>EndDate</field>
        <field>Amount</field>
        <field>Core_MDF_Budget_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Core_MDF_Status_Change_to_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>CCP_Finance_Manager_Queue</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Step for Co-marketing Budget</description>
        <entryCriteria>
            <formula>RecordType.DeveloperName = $Label.Core_MDF_CoMarketing_Budget_Record_type</formula>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Step for Co-marketing Budget</label>
        <name>Core_MDF_Step_for_Co_marketing_Budget</name>
        <rejectionActions>
            <action>
                <name>Core_MDF_Status_Change_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
