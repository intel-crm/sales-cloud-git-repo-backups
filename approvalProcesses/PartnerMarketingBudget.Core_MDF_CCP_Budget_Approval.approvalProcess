            <approver>
                <name>Core_MDF_CCP_ASMO_LAR_RetailBudget_Queue</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Step for ASMO LAR Retail Budget</description>
        <entryCriteria>
            <formula>AND(RecordType.DeveloperName = $Label.Core_MDF_Retail_Budget_Record_type,
ISPICKVAL(Core_MDF_Budget_Partner__r.Core_Geo__c, &apos;ASMO&apos;),
ISPICKVAL(Core_MDF_Budget_Partner__r.Core_Sub_Geo__c, &apos;LAR&apos;))</formula>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Step for ASMO LAR Retail Budget</label>
        <name>Core_MDF_Step_for_ASMO_LAR_Retail_Budget</name>
