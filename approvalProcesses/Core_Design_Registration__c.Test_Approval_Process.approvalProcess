<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Core_Design_Registration_Nm__c</field>
        <field>Core_Product_Group_Nm__c</field>
        <field>RecordType</field>
        <field>Core_Design_Registration_Status_Nm__c</field>
        <field>Workflow_Status__c</field>
        <field>Core_Partner_Account_Id__c</field>
        <field>Partner_Account_Region__c</field>
        <field>Core_Partner_Account_Region_Cd__c</field>
        <field>Core_Accepted_By_Id__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_status_to_Precheck_completed</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>PCC_Channel_Ops_Approver_Group</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>This step is called when partners submit deal for approval</description>
        <label>Deal Submission</label>
        <name>PCC_Deal_Submission</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_the_Status_Deal_Accepted</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>L2_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Accept the Deal</description>
        <entryCriteria>
            <criteriaItems>
                <field>Core_Design_Registration__c.RecordType</field>
                <operation>equals</operation>
                <value>Deal Registration - Partner</value>
            </criteriaItems>
            <criteriaItems>
                <field>Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c</field>
                <operation>equals</operation>
                <value>Pre-Approved</value>
            </criteriaItems>
            <criteriaItems>
                <field>Core_Design_Registration__c.Core_End_Customer_Account_Nm__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Accept the Deal</label>
        <name>Accept_the_Deal</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>L2_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Approve the Deal</description>
        <entryCriteria>
            <criteriaItems>
                <field>Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c</field>
                <operation>equals</operation>
                <value>Design accepted</value>
            </criteriaItems>
            <criteriaItems>
                <field>Core_Design_Registration__c.Core_End_Customer_Account_Nm__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Core_Design_Registration__c.RecordType</field>
                <operation>equals</operation>
                <value>Deal Registration - Partner</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Approve the Deal</label>
        <name>Approve_the_Deal</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>UpdateStatus</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>L2_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>This step will call when first level of approval is done and PSAM is covered.</description>
        <entryCriteria>
            <criteriaItems>
                <field>Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c</field>
                <operation>equals</operation>
                <value>Pre-Approved</value>
            </criteriaItems>
            <criteriaItems>
                <field>Core_Design_Registration__c.PCC_CoveredPartnerAccount__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
        </entryCriteria>
        <label>SecondLevelApprover</label>
        <name>SecondLevelApprover</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>This Approval process is for Deal registration submission</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Approve_the_Deal</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Record_Type</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Update_Record_Type_Lock</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_the_Record_status</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>PCC_Change_Record_Type</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>PCC_Change_Status_to_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Test Approval Process</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Recall_the_Deal</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_the_staus</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
