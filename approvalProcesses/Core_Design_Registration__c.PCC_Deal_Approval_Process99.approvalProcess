<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Core_Design_Registration_Nm__c</field>
        <field>Core_Product_Group_Nm__c</field>
        <field>RecordType</field>
        <field>Core_Design_Registration_Status_Nm__c</field>
        <field>Workflow_Status__c</field>
        <field>Core_Partner_Account_Id__c</field>
        <field>Partner_Account_Region__c</field>
        <field>Core_Partner_Account_Region_Cd__c</field>
        <field>Core_Accepted_By_Id__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>PCC_Channel_Ops_Approver_Group</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>This step is called when partners submit deal for approval</description>
        <label>Deal Submission</label>
        <name>PCC_Deal_Submission</name>
    </approvalStep>
    <description>This Approval process is for Deal registration submission</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Core_Design_Registration__c.PCC_Registration_Type__c</field>
            <operation>equals</operation>
            <value>Deal Registration</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Design_Registration__c.Core_Design_Registration_Status_Nm__c</field>
            <operation>equals</operation>
            <value>Draft</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>PCC_Change_Record_Type</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>PCC_Change_Status_to_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Deal Approval Process</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
