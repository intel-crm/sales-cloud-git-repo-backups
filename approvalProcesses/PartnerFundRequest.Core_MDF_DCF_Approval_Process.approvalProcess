<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>ChannelPartner</field>
        <field>Campaign</field>
        <field>Core_MDF_Budget_Type_nm__c</field>
        <field>Core_MDF_Fund_Request_Status__c</field>
        <field>Core_MDF_Activity_Types__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Core_MDF_CCP_Program_Office_Queue</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Program Office Review</label>
        <name>Core_MDF_Program_Office_Review</name>
    </approvalStep>
    <emailTemplate>unfiled$public/Core_MDF_Activity_Approval_Notification</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>PartnerFundRequest.RecordType</field>
            <operation>equals</operation>
            <value>Data Center Co-Marketing Fund</value>
        </criteriaItems>
        <criteriaItems>
            <field>PartnerFundRequest.Core_MDF_Budget_Type_nm__c</field>
            <operation>equals</operation>
            <value>OEM CMP,Service Provider CMP</value>
        </criteriaItems>
        <criteriaItems>
            <field>PartnerFundRequest.Core_MDF_Activity_Types__c</field>
            <operation>equals</operation>
            <value>Other (Broadcast),Other (Event),Other (OOH),Other (Out Of Home),Other (Sales Readiness),Other (Tech Exploration)</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>DCF Approval Process</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
