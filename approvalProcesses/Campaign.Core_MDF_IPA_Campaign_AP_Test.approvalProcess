<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Core_MDF_Account__c</field>
        <field>Core_MDF_Channel_Program__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Core_MDF_Step_Count_to_One</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
        </assignedApprover>
        <label>IPA Campaign Approval Process Level 1</label>
        <name>Core_MDF_IPA_Campaign_Approval_Process_Level_1</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1 AND (2 OR 3 OR 4 OR 5) AND 6</booleanFilter>
            <criteriaItems>
                <field>Campaign.Core_MDF_Activity_Category__c</field>
                <operation>includes</operation>
                <value>Incentive</value>
            </criteriaItems>
            <criteriaItems>
                <field>Campaign.Core_MDF_Activity_Type__c</field>
                <operation>includes</operation>
                <value>Buyer - Bundle/Offer</value>
            </criteriaItems>
            <criteriaItems>
                <field>Campaign.Core_MDF_Activity_Type__c</field>
                <operation>includes</operation>
                <value>Seller - Contest SPIF</value>
            </criteriaItems>
            <criteriaItems>
                <field>Campaign.Core_MDF_Activity_Type__c</field>
                <operation>includes</operation>
                <value>Seller - Per Unit SPIF</value>
            </criteriaItems>
            <criteriaItems>
                <field>Campaign.Core_MDF_Activity_Type__c</field>
                <operation>includes</operation>
                <value>Seller - Target SPIF</value>
            </criteriaItems>
            <criteriaItems>
                <field>Campaign.Core_MDF_Approval_Step_Counter_nbr__c</field>
                <operation>equals</operation>
                <value>1</value>
            </criteriaItems>
        </entryCriteria>
        <label>IPA Campaign Approval Process Level 2</label>
        <name>Core_MDF_IPA_Campaign_Approval_Process_Level_2</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Campaign.RecordType</field>
            <operation>equals</operation>
            <value>Intel Partner Alliance MDF,Intel® Partner Alliance MDF</value>
        </criteriaItems>
        <criteriaItems>
            <field>Campaign.Status</field>
            <operation>equals</operation>
            <value>Pending Review</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Core_MDF_Remove_Submitted_Status</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_MDF_Update_Status_to_Accepted</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Core_MDF_Remove_Submitted_Status</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_MDF_Update_Status_to_Denied</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Core_MDF_IPA_Campaign_AP_Test</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
