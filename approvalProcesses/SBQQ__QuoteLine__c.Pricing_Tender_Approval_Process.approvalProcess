<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Pricing_All_External_Tender_Partners</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Pricing_All_Internal_Tender_Users</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Pricing_Manager_Group</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Pricing_Quote_Line_Number__c</field>
        <field>Pricing_OEM_Account_Nm__c</field>
        <field>Pricing_End_Customer_Country__c</field>
        <field>Pricing_EndCustomer_Nm__c</field>
        <field>Pricing_Region_Nm__c</field>
        <field>Pricing_Primary_Contact_Nm__c</field>
        <field>Pricing_Project_Nm__c</field>
        <field>Pricing_Sales_Rep__c</field>
        <field>Pricing_Server_Deal_Type_Nm__c</field>
        <field>SBQQ__Quote__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Pending_Further_Intel_Review_Status_UPD</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
        </assignedApprover>
        <description>Field Level Approval</description>
        <label>Field Level Approval</label>
        <name>Field_Level_Approval</name>
        <rejectionActions>
            <action>
                <name>Pricing_Update_Status_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Pricing Tender Approval Process - Handles all Tender Quote line approvals which are in &apos;Pending Intel Field Review&apos;.</description>
    <emailTemplate>CPQ_Email_Templates/Pricing_QuoteLineApprovalNotification</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND (2 OR 3 OR 4 OR 5)</booleanFilter>
        <criteriaItems>
            <field>SBQQ__QuoteLine__c.Pricing_Status_Nm__c</field>
            <operation>equals</operation>
            <value>Pending Intel Field Review</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__QuoteLine__c.RecordType</field>
            <operation>equals</operation>
            <value>Pricing Tender Quote Line - Edit</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__QuoteLine__c.RecordType</field>
            <operation>equals</operation>
            <value>Pricing Tender Quote Line - Submitted</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__QuoteLine__c.RecordType</field>
            <operation>equals</operation>
            <value>Pricing SVD Quote Line - Edit</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__QuoteLine__c.RecordType</field>
            <operation>equals</operation>
            <value>Pricing SVD Quote Line - Submitted</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Pricing Tender Approval Process</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
