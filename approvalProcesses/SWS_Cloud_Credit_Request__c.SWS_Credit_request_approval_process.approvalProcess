<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>AGS_SWS_IDC_Business_Ops</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>SWS_Full_Name__c</field>
        <field>SWS_Request_Type__c</field>
        <field>SWS_Email__c</field>
        <field>SWS_Job_Title__c</field>
        <field>SWS_Cost_Center__c</field>
        <field>SWS_Submitter_Name__c</field>
        <field>SWS_Submitter_Email__c</field>
        <field>SWS_HW_Compute_Platform_PL__c</field>
        <field>SWS_HW_Compute_Quantity__c</field>
        <field>SWS_Coupon_Type__c</field>
        <field>SWS_Compute_Service_Requirements__c</field>
        <field>SWS_Coupon_Value__c</field>
        <field>SWS_Expiry_Date__c</field>
        <field>SWS_No_Of_User__c</field>
        <field>CreatedBy</field>
        <field>Owner</field>
        <field>SWS_Is_Standard__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Approval_Status_to_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>SWS_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <formula>$User.Id  &lt;&gt;  SWS_Approver__r.Id</formula>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Credit request approval</label>
        <name>Credit_request_approval</name>
        <rejectionActions>
            <action>
                <name>Update_Approval_Status_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Request_Status_To_Reject</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>This is design to request for approval for specific HW Compute platform products.</description>
    <emailTemplate>SWS_Email_Template/SWS_Initial_Submission_for_Approval</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>IF(FIND(TEXT(SWS_HW_Compute_Platform_PL__c), $Label.SWS_NeedApprovalForProduct) = 0, false, true)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>SWS_Send_Approved_Rejection_email_to_Submitter</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Update_Request_Status_To_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>SWS_Send_Approved_Rejection_email_to_Submitter</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_Approval_Status_to_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Credit request approval process</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>SWS_Send_recalled_email_to_approver</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Update_Approval_Status_to_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
