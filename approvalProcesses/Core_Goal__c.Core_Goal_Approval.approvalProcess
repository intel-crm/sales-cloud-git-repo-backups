<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Core_Goal_BU_Focus_Area__c</field>
        <field>Core_Goal_Claim_Date__c</field>
        <field>Core_Goal_Status__c</field>
        <field>Core_Goal_Oppty_Account_Name__c</field>
        <field>Core_Opportunity__c</field>
        <field>Core_Goal_Oppty_Owner__c</field>
        <field>Core_Goal_Oppty_Technical_Owner__c</field>
        <field>Core_Goal_Oppty_Sales_Group__c</field>
        <field>Core_Goal_Oppty_Stage__c</field>
        <field>Core_Goal_Oppty_Approval_Status__c</field>
        <field>Core_Goal_Commissionable__c</field>
        <field>Core_Goal_Oppty_Solution_Area__c</field>
        <field>Core_Goal_Oppty_Amount__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Core_Goal_Set_Status_to_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Core_Goal_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approve Goal</label>
        <name>Approve_Goal</name>
    </approvalStep>
    <emailTemplate>unfiled$public/Core_Goal_Approval_Email</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>ISPICKVAL(Core_Goal_Status__c, &apos;Accepted&apos;) &amp;&amp; Core_Goal_Opportunity_Identified__c = TRUE &amp;&amp; 
(Core_Bypass_Submission__c=TRUE || (Core_Goal_KPI_Achieved_Flag__c = TRUE &amp;&amp;
Core_Goal_KPI_Match_Flag__c = TRUE)
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Core_Goal_Set_Approved_By_to_CurrentUser</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Approved_Date_to_Today</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Approved_KPI_Revenue</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Approved_KPI_Type</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Status_to_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Core_Goal_CleanOppAtApproval</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_MakeClaimDateBlank</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Rejection_Notification</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Core_Goal_Set_Approved_By_to_Null</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Approved_Date_to_Null</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Status_to_Accepted</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Core_Goal_Clear_Approved_KPI_Type</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Approved_By_to_Null</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Approved_Date_to_Null</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Status_to_Submitted</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Update_Claim_Date</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Goal Approval</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Core_Goal_CleanOppAtApproval</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_MakeClaimDateBlank</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Approved_By_to_Null</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Approved_Date_to_Null</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Goal_Set_Status_to_Accepted</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
