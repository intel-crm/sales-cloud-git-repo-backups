<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>RecordType</field>
        <field>Core_Approving_Product_Organization__c</field>
        <field>Core_Support_Org_Name__c</field>
        <field>Core_Supported_Product__c</field>
        <field>Core_Supported_Product_Name__c</field>
        <field>Core_Line_Item_Approval_Status__c</field>
        <field>Core_Status__c</field>
        <field>Core_Approval_Type__c</field>
        <field>Core_LI_Approver__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
        </assignedApprover>
        <label>Step 1</label>
        <name>Step_1</name>
    </approvalStep>
    <description>Approval process that fires when a MAP Line Item is generated that requires Support Org Admin approval based on Product access flag</description>
    <emailTemplate>IPS_Email_Templates/Core_IPS_MAP_Item_Internal_Assigned</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND (2 OR 3) AND (4 OR 5 OR 6) AND 7</booleanFilter>
        <criteriaItems>
            <field>Core_IPS_Map_Par_Line_Item__c.RecordType</field>
            <operation>equals</operation>
            <value>MAP</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Map_Par_Line_Item__c.Core_Approval_Type__c</field>
            <operation>equals</operation>
            <value>Approval Required</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Map_Par_Line_Item__c.Core_Approval_Type__c</field>
            <operation>contains</operation>
            <value>Par Hidden</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Map_Par_Line_Item__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>PENDING</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Map_Par_Line_Item__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>INACTIVE</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_Map_Par_Line_Item__c.Core_Line_Item_Approval_Status__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_IPS_MAP_PAR__c.Core_IPS_MAP_Access_Flag__c</field>
            <operation>equals</operation>
            <value>Approval Required</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Core_IPS_Set_LI_Approver</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_IPS_Set_LI_ApprvalStatus_to_Apprved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_IPS_Set_LI_Decision_Date</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_IPS_Update_Line_Item_Status_Active</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Notify_email_requestor_that_line_item_status_has_changed</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Core_IPS_Set_LI_Approver</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_IPS_Set_LI_ApprvlStatus_to_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_IPS_Set_LI_Decision_Date</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_IPS_Update_LineItem_Status_Inactive</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Notify_email_requestor_that_line_item_status_has_changed</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Core_IPS_Set_LI_ApprvalStatus_to_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Core_IPS_MAP Request-Line Item</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
