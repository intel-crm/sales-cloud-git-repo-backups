<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>CreatedBy</field>
        <field>LastModifiedBy</field>
        <field>Core_Age__c</field>
        <field>Core_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved_By</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_Approval_Status_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Core_Approver_9__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_3__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_7__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_2__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_8__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_1__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_10__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_6__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_5__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_4__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1</booleanFilter>
            <criteriaItems>
                <field>Core_Opportunity_Support__c.Core_Status__c</field>
                <operation>equals</operation>
                <value>Submitted</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>RejectRecord</ifCriteriaNotMet>
        <label>Approver to Approve/Reject</label>
        <name>Approver_to_Approve_Reject</name>
        <rejectionActions>
            <action>
                <name>Core_Approval_Status_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Rejected_By</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Approval Process for Opportunity Support</description>
    <emailTemplate>Core_Opportunity_Management/Core_Oppty_Support_Submit</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Core_Opportunity_Support__c.Core_Status__c</field>
            <operation>equals</operation>
            <value>Submitted</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_Opportunity_Support__c.RecordType</field>
            <operation>notEqual</operation>
            <value>Marketing Support</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_Approved_Date_Null</name>
