    <label>Core_Opportunity_Support_Approval</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Core_RecallFieldUpdate</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Update_End_Date</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Approve_date_and_time</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
