<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Account</field>
        <field>Core_Product_Segment__c</field>
        <field>Core_Product_Application__c</field>
        <field>TotalOpportunityQuantity</field>
        <field>Amount</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Core_Opp_Approved_By</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_Opp_Approved_Date</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Core_Approver_5__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_2__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_1__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_4__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>Core_Approver_3__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Opportunity Approved</label>
        <name>Opportunity_Approved</name>
    </approvalStep>
    <description>Opportunity approval process. Allows submission for approval if all of the following are true: Submitter is Owner/Technical Owner/Creator or System Admin/Data Ops, Record Type is Opportunity, Compliance Status is not On Hold (any reason) or Not Approved, Stage is not Lost/Cancelled, and there&apos;s either at least one Pending product or no products at all and if opportunity doesn&apos;t have a &quot;Write In product&quot;  associated.</description>
    <emailTemplate>unfiled$public/Core_Opportunity_Approval_Email</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(OR($User.Username = Core_Technical_Owner__r.Username, $User.Username = Owner.Username, $User.Username = CreatedBy.Username, $Profile.Name = &apos;System Administrator&apos;, $Profile.Name = &apos;Data Ops&apos;),
RecordType.Name = &apos;Opportunity&apos;,
NOT(OR(ISPICKVAL(Core_Compliance_Status__c, &apos;On Hold – Review in Progress&apos;), ISPICKVAL(Core_Compliance_Status__c, &apos;On Hold – Government Authorization Needed&apos;), ISPICKVAL(Core_Compliance_Status__c, &apos;Not Approved&apos;))),
NOT(OR(ISPICKVAL(StageName, &apos;Lost&apos;), ISPICKVAL(StageName, &apos;Production Lost&apos;), ISPICKVAL(StageName, &apos;Production Cancelled&apos;), ISPICKVAL(StageName, &apos;Cancelled&apos;))),
Core_Write_In_Product_Count__c = 0,
OR(Core_Pending_Product_Count__c &gt; 0, Core_Product_Count__c = 0),
Core_Oppty_Check_BU_Short_Name__c = 0,
NOT(AND(CONTAINS( TEXT(Core_Opportunity_Type__c) , &quot;Deal&quot;),OR(ISBLANK(Core_Solution_Type__c),ISBLANK(Core_Combined_Solution_Detail__c)))))</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Core_Opp_Approval_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Opp_Set_Approved_Sales_Group</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Core_Opp_Approval_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Opp_Notify_Submitter_On_Rejection</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Core_Opp_Approval_Status_Submitted</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Opp_Store_Submitter_Email</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Core_Opp_Update_Date_Submitted_for_Appro</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Core Opp Approval</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Core_Opp_Approval_Status_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
