<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_Channel_MDF_EXTERNAL_All</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_IPA_EXTERNAL_ALL</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_Retail_EXTERNAL_ALL</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Core_MDF_Status_Txt__c</field>
        <field>Core_MDF_Claim_Id__c</field>
        <field>Name</field>
        <field>Core_MDF_VAT_Amt__c</field>
        <field>Core_MDF_VAT_Invoice_Number_Txt__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Core_MDF_CCP_Retail_Pay_Admin_EMEA</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Approval step for RMF Payment Admin</description>
        <entryCriteria>
            <criteriaItems>
                <field>PartnerFundClaim.Core_MDF_Program__c</field>
                <operation>equals</operation>
                <value>Retail Marketing Funds</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Payment Doc Approval Process RMF</label>
        <name>Payment_Doc_Approval_Process_RMF</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Core_MDF_CCP_IPA_Payment_Admin</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Approval step for IPA Payment Admin</description>
        <entryCriteria>
            <booleanFilter>1</booleanFilter>
            <criteriaItems>
                <field>PartnerFundClaim.Core_MDF_Program__c</field>
                <operation>equals</operation>
                <value>Intel Partner Alliance</value>
            </criteriaItems>
        </entryCriteria>
        <label>Payment Doc Approval Process IPA</label>
        <name>Payment_Doc_Approval_Process_IPA</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>This approval process to approve the payment document records by payment admins for all Geos</description>
    <emailTemplate>unfiled$public/Core_MDF_NotifyPaymentAdminsOnVATInvoice</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>(1 OR 2) AND (3 OR 4 OR 5)</booleanFilter>
        <criteriaItems>
            <field>Core_MDF_Claim_VAT_Info__c.Core_MDF_Status_Txt__c</field>
            <operation>equals</operation>
            <value>Pending Documents</value>
        </criteriaItems>
        <criteriaItems>
            <field>Core_MDF_Claim_VAT_Info__c.Core_MDF_Status_Txt__c</field>
            <operation>equals</operation>
            <value>Revision Required</value>
        </criteriaItems>
        <criteriaItems>
            <field>PartnerFundClaim.Core_MDF_Program__c</field>
            <operation>equals</operation>
            <value>Retail Marketing Funds</value>
        </criteriaItems>
        <criteriaItems>
            <field>PartnerFundClaim.Core_MDF_Program__c</field>
            <operation>equals</operation>
            <value>Intel Partner Alliance</value>
        </criteriaItems>
        <criteriaItems>
            <field>PartnerFundClaim.Core_MDF_Program__c</field>
            <operation>equals</operation>
            <value>Channel MDF</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Core_MDF_Claim_VAT_Approve_Status_Update</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Core_MDF_Claim_VAT_Reject_Status_Update</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Core_MDF_Claim_VAT_Review_Status</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Claim Payment Document Approval</label>
    <processOrder>2</processOrder>
    <recallActions>
        <action>
            <name>Core_MDF_VAT_Recall_Status_Update</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
