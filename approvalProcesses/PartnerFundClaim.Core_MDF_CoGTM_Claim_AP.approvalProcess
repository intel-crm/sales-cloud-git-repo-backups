<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_Co_GTM_EXTERNAL_ALL</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>Core_MDF_CCP_Co_GTM_INTERNAL_ALL</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Core_MDF_Status__c</field>
        <field>Core_MDF_Campaign_Id__c</field>
        <field>Request</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Core_MDF_Reset_Approval_Stage</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Step_Counter_to_0</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Update_Claim_Approval_Date</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Update_Claim_Eval_to_False</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Update_Claim_Status_Submitted</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Core_MDF_Technical_Approver_Queue</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Technical Approver</label>
        <name>Technical_Approver</name>
        <rejectionActions>
            <action>
                <name>Core_MDF_Empty_Claim_Approval_Date</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Reset_Approval_Stage</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Step_Counter_to_0</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Core_MDF_Update_Status_to_Resub_Required</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Approval Process for CoGTM claims.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3</booleanFilter>
        <criteriaItems>
            <field>PartnerFundClaim.Core_MDF_Status__c</field>
            <operation>equals</operation>
            <value>Pending Review</value>
        </criteriaItems>
        <criteriaItems>
            <field>PartnerFundClaim.RecordType</field>
            <operation>equals</operation>
            <value>Co-GTM</value>
        </criteriaItems>
        <criteriaItems>
            <field>PartnerFundClaim.Core_MDF_Proposal_Based_Ind__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Core_MDF_CoGTM_Claim_AP</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
