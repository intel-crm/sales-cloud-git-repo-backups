<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>PRM_Email_ID__c</field>
        <field>PRM_Account_Name__c</field>
        <field>PRM_Job_Function__c</field>
        <field>PRM_Profession__c</field>
        <field>PRM_Partner_Type__c</field>
        <field>PRM_First_Name__c</field>
        <field>PRM_Last_Name__c</field>
        <field>PRM_Account_URL__c</field>
        <field>PRM_Person_Phone_Number__c</field>
        <field>PRM_Company_Size__c</field>
        <field>PRM_Matching_Contact__c</field>
        <field>PRM_Account_Phone__c</field>
        <field>PRM_Dup_Status__c</field>
        <field>PRM_Address_Line_1__c</field>
        <field>PRM_Preferred_Language__c</field>
        <field>PRM_Address_Line_2__c</field>
        <field>PRM_Subscriptions__c</field>
        <field>PRM_State_Province__c</field>
        <field>PRM_Salesforce_ID__c</field>
        <field>PRM_Country__c</field>
        <field>PRM_Email_Log__c</field>
        <field>PRM_Contact_Salesforce_Id__c</field>
        <field>CreatedBy</field>
        <field>PRM_Zip_Postal_Code__c</field>
        <field>Owner</field>
        <field>PRM_Wechat_Union_Id__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>PRM_Manual_Approval_Members</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Registration Request Steps</label>
        <name>PRM_Registration_Request_Steps</name>
    </approvalStep>
    <description>Based On Field Values regRequest Record  will be submitted For approval</description>
    <emailTemplate>unfiled$public/Registration_Request_Requested_Approval</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>PRM_Registration_Request__c.PRM_Auto_Approve_rpt_txt__c</field>
            <operation>equals</operation>
            <value>false</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>PRM_Approve_Registration_Request</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>PRM_Reject_Registration_Request</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>true</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>PRM_Update_Record_Lock</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>PRM_Update_Submit_Request</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>PRM_RegRequestManualAppoval</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
