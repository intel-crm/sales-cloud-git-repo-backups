<?xml version="1.0" encoding="UTF-8"?>
<RestrictionRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <description>Restriction Rule to show only Approved Exception to Partner user</description>
    <enforcementType>Restrict</enforcementType>
    <masterLabel>Core_MDF_Share_Only_Approved_Exceptions_to_Partner</masterLabel>
    <recordFilter>ISPICKVAL(Core_MDF_Exception_Status_nm__c, &apos;Approved&apos;)=true</recordFilter>
    <targetEntity>Core_MDF_Exception__c</targetEntity>
    <userCriteria>CASE($User.UserType, &apos;PowerPartner&apos;, 1, 0)=1</userCriteria>
    <version>1</version>
</RestrictionRule>
